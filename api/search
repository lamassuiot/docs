-device","content":"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID."},"1563":{"id":"/docs/platform/iot-fleets/quickstarts/register-device-51","page_id":"/docs/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","content":"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain."},"1564":{"id":"/docs/platform/overview","page_id":"/docs/platform/overview","type":"page","content":"Lamassu IoT Platform","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/platform/overview"},"1565":{"id":"/docs/platform/overview-0","page_id":"/docs/platform/overview","tags":[],"type":"text","url":"/docs/platform/overview","content":"Build a PKI and apply its certificates to your devices' lifecycle."},"1566":{"id":"/docs/platform/overview-1","page_id":"/docs/platform/overview","type":"heading","tags":[],"url":"/docs/platform/overview#start-here","content":"Start here"},"1567":{"id":"/docs/platform/overview-2","page_id":"/docs/platform/overview","type":"heading","tags":[],"url":"/docs/platform/overview#choose-your-path","content":"Choose your path"},"1568":{"id":"/docs/platform/overview-3","page_id":"/docs/platform/overview","type":"heading","tags":[],"url":"/docs/platform/overview#architecture-at-a-glance","content":"Architecture at a glance"},"1569":{"id":"/docs/platform/overview-4","page_id":"/docs/platform/overview","type":"heading","tags":[],"url":"/docs/platform/overview#core-capabilities","content":"Core capabilities"},"1570":{"id":"/docs/platform/overview-5","page_id":"/docs/platform/overview","type":"heading","tags":[],"url":"/docs/platform/overview#build-your-trust-hierarchy","content":"Build your trust hierarchy"},"1571":{"id":"/docs/platform/overview-6","page_id":"/docs/platform/overview"