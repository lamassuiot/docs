/pki/quickstarts/overview-13","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#recommended-path","content":"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect."},"2244":{"id":"/docs/platform/pki/quickstarts/overview-14","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#recommended-path","content":"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy."},"2245":{"id":"/docs/platform/pki/quickstarts/overview-15","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"File or resource"},"2246":{"id":"/docs/platform/pki/quickstarts/overview-16","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"Check"},"2247":{"id":"/docs/platform/pki/quickstarts/overview-17","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"Active root CA and `ca.pem`"},"2248":{"id":"/docs/platform/pki/quickstarts/overview-18","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"It is a CA certificate, is currently valid and its self-signature verifies."},"2249":{"id":"/docs/platform/pki/quickstarts/overview-19","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"End-entity certificate and `device.crt`"},"2250":{"id":"/docs/platform/pki/quickstarts/overview-20","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"It identifies `device-001`, supports client authentication and verifies against `ca.pem`."},"2251":{"id":"/docs/platform/pki/quickstarts/overview-21","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"Private key `device.key`"},"2252":{"id":"/docs/platform/pki/quickstarts/overview-22","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"Its public key matches the one included in `device.crt`."},"2253":{"id":"/docs/platform/pki/quickstarts/overview-23","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration."},"2254":{"id":"/docs/platform/pki/quickstarts/overview-24","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2255":{"id":"/docs/platform/pki/quickstarts/overview-25","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2256":{"id":"/docs/platform/pki/quickstarts/overview-26","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2257":{"id":"/docs/platform/pki/troubleshooting","page_id":"/docs/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/platform/pki/troubleshooting"},"2258":{"id":"/docs/platform/pki/troubleshooting-0","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2259":{"id":"/docs/platform/pki/troubleshooting-1","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2260":{"id":"/docs/platform/pki/troubleshooting-2","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2261":{"id":"/docs/platform/pki/troubleshooting-3","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2262":{"id":"/docs/platform/pki/troubleshooting-4","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2263":{"id":"/docs/platform/pki/troubleshooting-5","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2264":{"id":"/docs/platform/pki/troubleshooting-6","page