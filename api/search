ent/self-hosted/overview#what-the-lamassu-chart-provides","content":"PostgreSQL data"},"331":{"id":"/docs/deployment/self-hosted/overview-25","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap"},"332":{"id":"/docs/deployment/self-hosted/overview-26","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations"},"333":{"id":"/docs/deployment/self-hosted/overview-27","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Messaging"},"334":{"id":"/docs/deployment/self-hosted/overview-28","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"RabbitMQ connection configuration for the Lamassu services"},"335":{"id":"/docs/deployment/self-hosted/overview-29","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A reachable RabbitMQ broker, credentials and its lifecycle"},"336":{"id":"/docs/deployment/self-hosted/overview-30","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Identity"},"337":{"id":"/docs/deployment/self-hosted/overview-31","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals"},"338":{"id":"/docs/deployment/self-hosted/overview-32","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"An OIDC provider, realm/tenant, client, users, groups and roles"},"339":{"id":"/docs/deployment/self-hosted/overview-33","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"External routing"},"340":{"id":"/docs/deployment/self-hosted/overview-34","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies"},"341":{"id":"/docs/deployment/self-hosted/overview-35","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path"},"342":{"id":"/docs/deployment/self-hosted/overview-36","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"TLS"},"343":{"id":"/docs/deployment/self-hosted/overview-37","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret"},"344":{"id":"/docs/deployment/self-hosted/overview-38","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret"},"345":{"id":"/docs/deployment/self-hosted/overview-39","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Persistent application data"},"346":{"id":"/docs/deployment/self-hosted/overview-40","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"PersistentVolumeClaims required by the default local KMS and VA storage"},"347":{"id":"/docs/deployment/self-hosted/overview-41","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one"},"348":{"id":"/docs/deployment/self-hosted/overview-42","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Optional integrations"},"349":{"id":"/docs/deployment/self-hosted/overview-43","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity"},"350":{"id":"/docs/deployment/self-hosted/overview-44","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The observability backends, cloud credentials and production HSM or external key service"},"351":{"id":"/docs/deployment/self-hosted/overview-45","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network."},"352":{"id":"/docs/deployment/self-hosted/overview-46","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service."},"353":{"id":"/docs/deployment/self-hosted/overview-47","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway."},"354":{"id":"/docs/deployment/self-hosted/overview-48","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"355":{"id":"/docs/deployment/self-hosted/overview-49","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"356":{"id":"/docs/deployment/self-hosted/overview-50","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"357":{"id":"/docs/deployment/self-hosted/overview-51","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"358":{"id":"/docs/deployment/self-hosted/overview-52","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources"},"359":{"id":"/docs/deployment/self-hosted/overview-53","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"360":{"id":"/docs/deployment/self-hosted/overview-54","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"a load-balancer implementation or another deliberate path from clients to the Gateway"},"361":{"id":"/docs/deployment/self-hosted/overview-55","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer."},"362":{"id":"/docs/deployment/self-hosted/overview-56","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />"},"363":{"id":"/docs/deployment/self-hosted/overview-57","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />"},"364":{"id":"/docs/deployment/self-hosted/overview-58","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />"},"365":{"id":"/docs/deployment/troubleshooting","page_id":"/docs/deployment/troubleshooting","type":"page","content":"Deployment troubleshooting","breadcrumbs":["Docs","Deployment","Operations"],"tags":[],"url":"/docs/deployment/troubleshooting"},"366":{"id":"/docs/deployment/troubleshooting-0","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting","content":"Diagnose access, service health and infrastructure dependencies."},"367":{"id":"/docs/deployment/troubleshooting-1","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#diagnostic-sequence","content":"Diagnostic sequence"},"368":{"id":"/docs/deployment/troubleshooting-2","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#reproduce-a-single-operation","content":"Reproduce a single operation"},"369":{"id":"/docs/deployment/troubleshooting-3","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#separate-client-gateway-and-service","content":"Separate client, Gateway and service"},"370":{"id":"/docs/deployment/troubleshooting-4","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#review-kubernetes-status","content":"Review Kubernetes status"},"371":{"id":"/docs/deployment/troubleshooting-5","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#query-the-affected-service","content":"Query the affected service"},"372":{"id":"/docs/deployment/troubleshooting-6","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#validate-the-result-from-outside","content":"Validate the result from outside"},"373":{"id":"/docs/deployment/troubleshooting-7","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#minimal-evidence-collection","content":"Minimal evidence collection"},"374":{"id":"/docs/deployment/troubleshooting-8","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"I cannot sign in"},"375":{"id":"/docs/deployment/troubleshooting-9","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Everything returns 403 or 5xx"},"376":{"id":"/docs/deployment/troubleshooting-10","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"A pod is not Ready"},"377":{"id":"/docs/deployment/troubleshooting-11","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"Events are not arriving"},"378":{"id":"/docs/deployment/troubleshooting-12","page_id":"/docs/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/deployment/troubleshooting#observability","content":"Observability"},"379":{"id":"/docs/deployment/troubleshooting-13","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting","content":"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics."},"380":{"id":"/docs/deployment/troubleshooting-14","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#reproduce-a-single-operation","content":"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion."},"381":{"id":"/docs/deployment/troubleshooting-15","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#separate-client-gateway-and-service","content":"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency."},"382":{"id":"/docs/deployment/troubleshooting-16","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#review-kubernetes-status","content":"Locate unready pods, restarts, recent events and the state of the release."},"383":{"id":"/docs/deployment/troubleshooting-17","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#query-the-affected-service","content":"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine."},"384":{"id":"/docs/deployment/troubleshooting-18","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#validate-the-result-from-outside","content":"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses."},"385":{"id":"/docs/deployment/troubleshooting-19","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#minimal-evidence-collection","content":"Replace the placeholders with your real release, namespace and deployment."},"386":{"id":"/docs/deployment/troubleshooting-20","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#minimal-evidence-collection","content":"Also run the chart's connectivity test:"},"387":{"id":"/docs/deployment/troubleshooting-21","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#minimal-evidence-collection","content":"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow."},"388":{"id":"/docs/deployment/troubleshooting-22","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#minimal-evidence-collection","content":"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails."},"389":{"id":"/docs/deployment/troubleshooting-23","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"If you receive a 401:"},"390":{"id":"/docs/deployment/troubleshooting-24","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"check that the UI's OIDC authority is reachable from the browser;"},"391":{"id":"/docs/deployment/troubleshooting-25","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"verify issuer, audience and expiration of the token;"},"392":{"id":"/docs/deployment/troubleshooting-26","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"confirm the Gateway can fetch the keys from the JWKS URI;"},"393":{"id":"/docs/deployment/troubleshooting-27","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"check that the provider's public and internal routes point to the same realm."},"394":{"id":"/docs/deployment/troubleshooting-28","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"If login succeeds but the APIs return 403:"},"395":{"id":"/docs/deployment/troubleshooting-29","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"inspect the token's real claims;"},"396":{"id":"/docs/deployment/troubleshooting-30","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"confirm they match an active principal;"},"397":{"id":"/docs/deployment/troubleshooting-31","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"review the policies granted to that principal;"},"398":{"id":"/docs/deployment/troubleshooting-32","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"verify that authz reaches PostgreSQL and its JWKS."},"399":{"id":"/docs/deployment/troubleshooting-33","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#i-cannot-sign-in","content":"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap."},"400":{"id":"/docs/deployment/troubleshooting-34","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"External authorization fails closed by default. If authz is unavailable, protected routes are blocked."},"401":{"id":"/docs/deployment/troubleshooting-35","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Locate the authz pod and Service."},"402":{"id":"/docs/deployment/troubleshooting-36","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check /health, logs and its database connection."},"403":{"id":"/docs/deployment/troubleshooting-37","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Verify the DNS and port configured in externalAuthorization."},"404":{"id":"/docs/deployment/troubleshooting-38","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check the check route is /v1/ext\\_authz/check."},"405":{"id":"/docs/deployment/troubleshooting-39","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage."},"406":{"id":"/docs/deployment/troubleshooting-40","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"Review kubectl describe pod first. Common causes are:"},"407":{"id":"/docs/deployment/troubleshooting-41","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"wrong credentials or DNS for PostgreSQL or RabbitMQ;"},"408":{"id":"/docs/deployment/troubleshooting-42","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"unbound persistent volume;"},"409":{"id":"/docs/deployment/troubleshooting-43","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"inaccessible image or incorrect pull policy;"},"410":{"id":"/docs/deployment/troubleshooting-44","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"invalid cryptographic engine configuration;"},"411":{"id":"/docs/deployment/troubleshooting-45","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"CPU or memory limits set too low;"},"412":{"id":"/docs/deployment/troubleshooting-46","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"an incomplete prior migration."},"413":{"id":"/docs/deployment/troubleshooting-47","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups."},"414":{"id":"/docs/deployment/troubleshooting-48","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling."},"415":{"id":"/docs/deployment/troubleshooting-49","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"Domain and audit events depend on the bus publisher:"},"416":{"id":"/docs/deployment/troubleshooting-50","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"verify it is enabled in the emitting service;"},"417":{"id":"/docs/deployment/troubleshooting-51","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"check AMQP connectivity and credentials;"},"418":{"id":"/docs/deployment/troubleshooting-52","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"review exchange, routing key, queues and consumers;"},"419":{"id":"/docs/deployment/troubleshooting-53","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"inspect dead-letter queues;"},"420":{"id":"/docs/deployment/troubleshooting-54","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"alert on orphan durable queues and backlog growth."},"421":{"id":"/docs/deployment/troubleshooting-55","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs."},"422":{"id":"/docs/deployment/troubleshooting-56","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency."},"423":{"id":"/docs/deployment/troubleshooting-57","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"Before closing an incident, record:"},"424":{"id":"/docs/deployment/troubleshooting-58","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"the confirmed cause;"},"425":{"id":"/docs/deployment/troubleshooting-59","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"the time scope and affected resources;"},"426":{"id":"/docs/deployment/troubleshooting-60","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"the commands or queries used;"},"427":{"id":"/docs/deployment/troubleshooting-61","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"the applied change and how to revert it;"},"428":{"id":"/docs/deployment/troubleshooting-62","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"validation from a consumer;"},"429":{"id":"/docs/deployment/troubleshooting-63","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#observability","content":"the preventive action and its owner."},"430":{"id":"/docs/platform/administration/access-control","page_id":"/docs/platform/administration/access-control","type":"page","content":"Access control","breadcrumbs":["Docs","Platform","Administration"],"tags":[],"url":"/docs/platform/administration/access-control"},"431":{"id":"/docs/platform/administration/access-control-0","page_id":"/docs/platform/administration/access-control","tags":[],"type":"text","url":"/docs/platform/administration/access-control","content":"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization."},"432":{"id":"/docs/platform/administration/access-control-1","page_id":"/docs/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/platform/administration/access-control#essential-concepts","content":"Essential concepts"},"433":{"id":"/docs/platform/administration/access-control-2","page_id":"/docs/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/platform/administration/access-control#two-decision-systems","content":"Two decision systems"},"434":{"id":"/docs/platform/administration/access-control-3","page_id":"/docs/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/platform/administration/access-control#integrated-or-external-http-services","content":"Integrated or external HTTP services"},"435":{"id":"/docs/platform/administration/access-control-4","page_id":"/docs/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"Authentication-only routes and unmapped paths"},"436":{"id":"/docs/platform/administration/access-control-5","page_id":"/docs/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/platform/administration/access-control#services-developed-by-lamassu","content":"Services developed by Lamassu"},"437":{"id":"/docs/platform/administration/access-control-6","page_id":"/docs/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/platform/administration/access-control#how-the-two-paths-relate","content":"How the two paths relate"},"438":{"