rm/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2273":{"id":"/docs/platform/pki/quickstarts/overview-25","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2274":{"id":"/docs/platform/pki/quickstarts/overview-26","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2275":{"id":"/docs/platform/pki/troubleshooting","page_id":"/docs/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/platform/pki/troubleshooting"},"2276":{"id":"/docs/platform/pki/troubleshooting-0","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2277":{"id":"/docs/platform/pki/troubleshooting-1","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2278":{"id":"/docs/platform/pki/troubleshooting-2","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2279":{"id":"/docs/platform/pki/troubleshooting-3","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2280":{"id":"/docs/platform/pki/troubleshooting-4","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2281":{"id":"/docs/platform/pki/troubleshooting-5","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2282":{"id":"/docs/platform/pki/troubleshooting-6","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Check"},"2283":{"id":"/docs/platform/pki/troubleshooting-7","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"What to inspect"},"2284":{"id":"/docs/platform/pki/troubleshooting-8","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Next step"},"2285":{"id":"/docs/platform/pki/troubleshooting-9","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"CA"},"2286":{"id":"/docs/platform/pki/troubleshooting-10","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Exists, is active and has usable dates."},"2287":{"id":"/docs/platform/pki/troubleshooting-11","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Authorities."},"2288":{"id":"/docs/platform/pki/troubleshooting-12","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Key"},"2289":{"id":"/docs/platform/pki/troubleshooting-13","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"The record has a usable private key and the engine can sign."},"2290":{"id":"/docs/platform/pki/troubleshooting-14","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Try **Sign / Verify** in KMS; check provider permissions and availability."},"2291":{"id":"/docs/platform/pki/troubleshooting-15","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2292":{"id":"/docs/platform/pki/troubleshooting-16","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2293":{"id":"/docs/platform/pki/troubleshooting-17","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2294":{"id":"/docs/platform/pki/troubleshooting-18","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2295":{"id":"/docs/platform/pki/troubleshooting-19","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2296":{"id":"/docs/platform/pki/troubleshooting-20","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2297":{"id":"/docs/platform/pki/troubleshooting-21","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2298":{"id":"/docs/platform/pki/troubleshooting-22","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2299":{"id":"/docs/platform/pki/troubleshooting-23","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2300":{"id":"/docs/platform/pki/troubleshooting-24","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2301":{"id":"/docs/platform/pki/troubleshooting-25","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2302":{"id":"/docs/platform/pki/troubleshooting-26","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2303":{"id":"/docs/platform/pki/troubleshooting-27","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2304":{"id":"/docs/platform/pki/troubleshooting-28","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2305":{"id":"/docs/platform/pki/troubleshooting-29","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2306":{"id":"/docs/platform/pki/troubleshooting-30","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2307":{"id":"/docs/platform/pki/troubleshooting-31","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2308":{"id":"/docs/platform/pki/troubleshooting-32","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/d