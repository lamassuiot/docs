/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector."},"1193":{"id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core-55","page_id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Parámetro"},"1194":{"id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core-56","page_id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Tipo"},"1195":{"id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core-57","page_id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Requerido"},"1196":{"id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core-58","page_id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Descripción"},"1197":{"id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core-59","page_id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"`connector_id`"},"1198":{"id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core-60","page_id":"/docs/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/integrations/aws-iot-