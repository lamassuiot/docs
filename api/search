atform/pki/key-management-12","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"Import an existing pair"},"1969":{"id":"/docs/platform/pki/key-management-13","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#operations-on-a-key","content":"Operations on a key"},"1970":{"id":"/docs/platform/pki/key-management-14","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#view-details","content":"View details"},"1971":{"id":"/docs/platform/pki/key-management-15","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#sign-and-verify","content":"Sign and verify"},"1972":{"id":"/docs/platform/pki/key-management-16","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#sign","content":"Sign"},"1973":{"id":"/docs/platform/pki/key-management-17","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#verify","content":"Verify"},"1974":{"id":"/docs/platform/pki/key-management-18","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#generate-a-csr","content":"Generate a CSR"},"1975":{"id":"/docs/platform/pki/key-management-19","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#sign-locally-with-pkcs11","content":"Sign locally with PKCS#11"},"1976":{"id":"/docs/platform/pki/key-management-20","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#before-deleting-a-key","content":"Before deleting a key"},"1977":{"id":"/docs/platform/pki/key-management-21","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management","content":"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI."},"1978":{"id":"/docs/platform/pki/key-management-22","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management","content":"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system."},"1979":{"id":"/docs/platform/pki/key-management-23","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider."},"1980":{"id":"/docs/platform/pki/key-management-24","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"In practice, it lets you:"},"1981":{"id":"/docs/platform/pki/key-management-25","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Generate new key pairs from Lamassu IoT."},"1982":{"id":"/docs/platform/pki/key-management-26","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Import keys created externally."},"1983":{"id":"/docs/platform/pki/key-management-27","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Delegate custody and cryptographic operations to external engines."},"1984":{"id":"/docs/platform/pki/key-management-28","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Reuse existing keys for CAs, CSRs and signing or verification tasks."},"1985":{"id":"/docs/platform/pki/key-management-29","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-engines","content":"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform."},"1986":{"id":"/docs/platform/pki/key-management-30","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-engines","content":"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements."},"1987":{"id":"/docs/platform/pki/key-management-31","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-engines","content":"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration."},"1988":{"id":"/docs/platform/pki/key-management-32","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#file-system","content":"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files."},"1989":{"id":"/docs/platform/pki/key-management-33","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#hashicorp-vault","content":"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner."},"1990":{"id":"/docs/platform/pki/key-management-34","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#aws-secrets-manager","content":"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM."},"1991":{"id":"/docs/platform/pki/key-management-35","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#aws-kms","content":"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations."},"1992":{"id":"/docs/platform/pki/key-management-36","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#pkcs11","content":"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody."},"1993":{"id":"/docs/platform/pki/key-management-37","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#azure-key-vault","content":"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations."},"1994":{"id":"/docs/platform/pki/key-management-38","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#azure-key-vault","content":"Lamassu shows the enabled engines in the console."},"1995":{"id":"/docs/platform/pki/key-management-39","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#azure-key-vault","content":"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate."},"1996":{"id":"/docs/platform/pki/key-management-40","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#azure-key-vault","content":"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA."},"1997":{"id":"/docs/platform/pki/key-management-41","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to."},"1998":{"id":"/docs/platform/pki/key-management-42","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"The table includes the following fields:"},"1999":{"id":"/docs/platform/pki/key-management-43","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Name**: descriptive name of the key."},"2000":{"id":"/docs/platform/pki/key-management-44","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Type**: algorithm and key size, for example RSA 2048 or EC P-256."},"2001":{"id":"/docs/platform/pki/key-management-45","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Strength**: visual indicator of cryptographic strength."},"2002":{"id":"/docs/platform/pki/key-management-46","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Public/Private**: whether Lamassu manages the full pair or only the public key."},"2003":{"id":"/docs/platform/pki/key-management-47","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Crypto Engine**: cryptographic engine keeping the key."},"2004":{"id":"/docs/platform/pki/key-management-48","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Aliases**: alternative names associated with the key."},"2005":{"id":"/docs/platform/pki/key-management-49","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Tags**: labels for classification and search."},"2006":{"id":"/docs/platform/pki/key-management-50","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Related Entities**: certificates or other entities linked to that key."},"2007":{"id":"/docs/platform/pki/key-management-51","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"From this view you also reach the most common actions:"},"2008":{"id":"/docs/platform/pki/key-management-52","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**View Details** to inspect metadata, identifiers and relationships."},"2009":{"id":"/docs/platform/pki/key-management-53","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Generate CSR** to create a PKCS#10 request with the selected key."},"2010":{"id":"/docs/platform/pki/key-management-54","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Sign / Verify** to test cryptographic operations on the key."},"2011":{"id":"/docs/platform/pki/key-management-55","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Delete Key** to remove the key from the system."},"2012":{"id":"/docs/platform/pki/key-management-56","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#create-or-import-keys","content":"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import."},"2013":{"id":"/docs/platform/pki/key-management-57","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines."},"2014":{"id":"/docs/platform/pki/key-management-58","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:"},"2015":{"id":"/docs/platform/pki/key-management-59","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Name**: unique and descriptive name."},"2016":{"id":"/docs/platform/pki/key-management-60","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Crypto Engine**: engine that will keep the key."},"2017":{"id":"/docs/platform/pki/key-management-61","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Type** and **Key Size**: algorithm and size or curve."},"2018":{"id":"/docs/platform/pki/key-management-62","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Tags**: metadata to classify the key."},"2019":{"id":"/docs/platform/pki/key-management-63","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Metadata**: additional information for advanced uses."},"2020":{"id":"/docs/platform/pki/key-management-64","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production."},"2021":{"id":"/docs/platform/pki/key-management-65","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"When you have an exportable private key and the destination engine supports import."},"2022":{"id":"/docs/platform/pki/key-management-66","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"When an existing PKI needs to be migrated without reissuing certificates."},"2023":{"id":"/docs/platform/pki/key-management-67","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"When Lamassu must operate with a root of trust created by a third party."},"2024":{"id":"/docs/platform/pki/key-management-68","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:"},"2025":{"id":"/docs/platform/pki/key-management-69","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Key Name**: descriptive name within Lamassu IoT."},"2026":{"id":"/docs/platform/pki/key-management-70","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Crypto Engine**: engine that will keep the imported key."},"2027":{"id":"/docs/platform/pki/key-management-71","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Tags**: labels for organization and search."},"2028":{"id":"/docs/platform/pki/key-management-72","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Metadata**: additional optional information."},"2029":{"id":"/docs/platform/pki/key-management-73","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Private Key (PEM)**: private key in PEM format."},"2030":{"id":"/docs/platform/pki/key-management-74","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through."},"2031":{"id":"/docs/platform/pki/key-management-75","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#operations-on-a-key","content":"Each registered key has a detail view and several operational actions."},"2032":{"id":"/docs/platform/pki/key-management-76","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"The **View Details** screen concentrates the technical and administrative information of the key."},"2033":{"id":"/docs/platform/pki/key-management-77","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"The **Overview** tab shows, among others, these fields:"},"2034":{"id":"/docs/platform/pki/key-management-78","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Key Name**: descriptive name."},"2035":{"id":"/docs/platform/pki/key-management-79","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats."},"2036":{"id":"/docs/platform/pki/key-management-80","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Tags**: associated labels."},"2037":{"id":"/docs/platform/pki/key-management-81","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Aliases**: alternative names."},"2038":{"id":"/docs/platform/pki/key-management-82","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Crypto Engine**: engine where the key resides."},"2039":{"id":"/docs/platform/pki/key-management-83","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level."},"2040":{"id":"/docs/platform/pki/key-management-84","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"The **Related Entities** section shows which Lamassu objects depend on that key."},"2041":{"id":"/docs/platform/pki/key-management-85","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it."},"2042":{"id":"/docs/platform/pki/key-management-86","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign-and-verify","content":"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly."},"2043":{"id":"/docs/platform/pki/key-management-87","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign-and-verify","content":"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain."},"2044":{"id":"/docs/platform/pki/key-management-88","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign-and-verify","content":"When you open it, two areas appear: **Sign** and **Verify**."},"2045":{"id":"/docs/platform/pki/key-management-89","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"This tab uses the private key to generate a digital signature over a message or an already computed *digest*."},"2046":{"id":"/docs/platform/pki/key-management-90","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"Main fields:"},"2047":{"id":"/docs/platform/pki/key-management-91","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"**Algorithm**: signing algorithm available for the key type."},"2048":{"id":"/docs/platform/pki/key-management-92","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash."},"2049":{"id":"/docs/platform/pki/key-management-93","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64."},"2050":{"id":"/docs/platform/pki/key-management-94","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"**Message**: content to sign."},"2051":{"id":"/docs/platform/pki/key-management-95","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign","content":"**Signature**: result of the operation, shown in hexadecimal."},"2052":{"id":"/docs/platform/pki/key-management-96","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"This tab checks whether a signature corresponds to the associated public key."},"2053":{"id":"/docs/platform/pki/key-management-97","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"Main fields:"},"2054":{"id":"/docs/platform/pki/key-management-98","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"**Algorithm**: must match the algorithm used for the signature."},"2055":{"id":"/docs/platform/pki/key-management-99","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"**Message Type**: `Raw` or `Digest`."},"2056":{"id":"/docs/platform/pki/key-management-100","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"**Payload Encoding**: encoding of the message."},"2057":{"id":"/docs/platform/pki/key-management-101","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"**Message**: original message or hash."},"2058":{"id":"/docs/platform/pki/key-management-102","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"**Signature**: signature to check."},"2059":{"id":"/docs/platform/pki/key-management-103","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#verify","content":"**Result**: indicator of the validation result."},"2060":{"id":"/docs/platform/pki/key-management-104","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine."},"2061":{"id":"/docs/platform/pki/key-management-105","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"This flow is useful for:"},"2062":{"id":"/docs/platform/pki/key-management-106","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"Requesting certificates from an external CA."},"2063":{"id":"/docs/platform/pki/key-management-107","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"Renewing an identity while keeping the same key."},"2064":{"id":"/docs/platform/pki/key-management-108","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"When you open the form, it asks for the subject data and the main certificate attributes:"},"2065":{"id":"/docs/platform/pki/key-management-109","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Common Name (CN)**: main name of the identity."},"2066":{"id":"/docs/platform/pki/key-management-110","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Organization (O)**: organization or company."},"2067":{"id":"/docs/platform/pki/key-management-111","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Organizational Unit (OU)**: department or unit."},"2068":{"id":"/docs/platform/pki/key-management-112","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Country (C)**: two-letter country code."},"2069":{"id":"/docs/platform/pki/key-management-113","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**State / Province (ST)**: state or province."},"2070":{"id":"/docs/platform/pki/key-management-114","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Locality (L)**: city or locality."},"2071":{"id":"/docs/platform/pki/key-management-115","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Email Address**: contact email."},"2072":{"id":"/docs/platform/pki/key-management-116","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP."},"2073":{"id":"/docs/platform/pki/key-management-117","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-csr","content":"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields."},"2074":{"id":"/docs/platform/pki/key-management-118","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign-locally-with-pkcs11","content":"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**."},"2075":{"id":"/docs/platform/pki/key-management-119","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#sign-locally-with-pkcs11","content":"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue."},"2076":{"id":"/docs/platform/pki/key-management-120","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#before-deleting-a-key","content":"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine."},"2077":{"id":"/docs/platform/pki/ocsp","page_id":"/docs/platform/pki/ocsp","type":"page","content":"Online validation with OCSP","breadcrumbs":["Docs","Platform","PKI","Validation"],"tags":[],"url":"/docs/platform/pki/ocsp"},"2078":{"id":"/docs/platform/pki/ocsp-0","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp","content":"Query signed status and verify the responder’s response."},"2079":{"id":"/docs/platform/pki/ocsp-1","page_id":"/docs/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"How the responder works in Lamassu"},"2080":{"id":"/docs/platform/pki/ocsp-2","page_id":"/docs/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/platform/pki/ocsp#embedding-in-issued-certificates","content":"Embedding in issued certificates"},"2081":{"id":"/docs/platform/pki/ocsp-3","page_id":"/docs/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/platform/pki/ocsp#http-endpoints","content":"HTTP endpoints"},"2082":{"id":"/docs/platform/pki/ocsp-4","page_id":"/docs/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"Generate and verify a query"},"2083":{"id":"/docs/platform/pki/ocsp-5","page_id":"/docs/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/platform/pki/ocsp#check-from-the-interface","content":"Check from the interface"},"2084":{"id":"/docs/platform/pki/ocsp-6","page_id":"/docs/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/platform/pki/ocsp#references","content":"References"},"2085":{"id":"/docs/platform/pki/ocsp-7","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp","content":"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation."},"2086":{"id":"/docs/platform/pki/ocsp-8","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:"},"2087":{"id":"/docs/platform/pki/ocsp-9","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Record status"},"2088":{"id":"/docs/platform/pki/ocsp-10","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Signed response"},"2089":{"id":"/docs/platform/pki/ocsp-11","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`ACTIVE`"},"2090":{"id":"/docs/platform/pki/ocsp-12","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`Good`."},"2091":{"id":"/docs/platform/pki/ocsp-13","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`REVOKED`"},"2092":{"id":"/docs/platform/pki/ocsp-14","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`Revoked`, with revocation reason and timestamp."},"2093":{"id":"/docs/platform/pki/ocsp-15","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Other states, including `INACTIVE` and `EXPIRED`"},"2094":{"id":"/docs/platform/pki/ocsp-16","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`Unknown` if the certificate and issuer can be retrieved."},"2095":{"id":"/docs/platform/pki/ocsp-17","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy."},"2096":{"id":"/docs/platform/pki/ocsp-18","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses."},"2097":{"id":"/docs/platform/pki/ocsp-19","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation."},"2098":{"id":"/docs/platform/pki/ocsp-20","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#embedding-in-issued-certificates","content":"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:"},"2099":{"id":"/docs/platform/pki/ocsp-21","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#embedding-in-issued-certificates","content":"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates."},"2100":{"id":"/docs/platform/pki/ocsp-22","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"The service accepts:"},"2101":{"id":"/docs/platform/pki/ocsp-23","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"Method"},"2102":{"id":"/docs/platform/pki/ocsp-24","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"VA service path"},"2103":{"id":"/docs/platform/pki/ocsp-25","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"Format"},"2104":{"id":"/docs/platform/pki/ocsp-26","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"`POST`"},"2105":{"id":"/docs/platform/pki/ocsp-27","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"`/ocsp`"},"2106":{"id":"/docs/platform/pki/ocsp-28","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"DER request, `Content-Type: application/ocsp-request`."},"2107":{"id":"/docs/platform/pki/ocsp-29","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"`GET`"},"2108":{"id":"/docs/platform/pki/ocsp-30","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"`/ocsp/{ocsp_request}`"},"2109":{"id":"/docs/platform/pki/ocsp-31","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"DER request encoded using padded URL Base64."},"2110":{"id":"/docs/platform/pki/ocsp-32","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#http-endpoints","content":"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator."},"2111":{"id":"/docs/platform/pki/ocsp-33","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs."},"2112":{"id":"/docs/platform/pki/ocsp-34","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"Generate the request:"},"2113":{"id":"/docs/platform/pki/ocsp-35","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce."},"2114":{"id":"/docs/platform/pki/ocsp-36","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"Replace the example URL with the inspected endpoint:"},"2115":{"id":"/docs/platform/pki/ocsp-37","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"Verify the returned DER:"},"2116":{"id":"/docs/platform/pki/ocsp-38","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#generate-and-verify-a-query","content":"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code."},"2117":{"id":"/docs/platform/pki/ocsp-39","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#check-from-the-interface","content":"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration."},"2118":{"id":"/docs/platform/pki/ocsp-40","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#check-from-the-interface","content":"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting."},"2119":{"id":"/docs/platform/pki/ocsp-41","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#references","content":"RFC 6960: OCSP."},"2120":{"id":"/docs/platform/pki/ocsp-42","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#references","content":"OpenSSL: openssl-ocsp."},"2121":{"id":"/docs/platform/pki/ocsp-43","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#references","content":"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />"},"2122":{"id":"/docs/platform/pki/ocsp-44","page_id":"/docs/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/platform/pki/ocsp#references","content":"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />"},"2123":{"id":"/docs/platform/pki/overview","page_id":"/docs/platform/pki/overview","type":"page","content":"PKI","breadcrumbs":["Docs","Platform","PKI"],"tags":[],"url":"/docs/platform/pki/overview"},"2124":{"id":"/docs/platform/pki/overview-0","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview","content":"Administer keys and authorities, define issuance and verify the resulting certificates."},"2125":{"id":"/docs/platform/pki/overview-1","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#start-here","content":"Start here"},"2126":{"id":"/docs/platform/pki/overview-2","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#what-you-need","content":"What you need"},"2127":{"id":"/docs/platform/pki/overview-3","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#core-capabilities","content":"Core capabilities"},"2128":{"id":"/docs/platform/pki/overview-4","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#build-your-trust-hierarchy","content":"Build your trust hierarchy"},"2129":{"id":"/docs/platform/pki/overview-5","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#protect-cryptographic-keys","content":"Protect cryptographic keys"},"2130":{"id":"/docs/platform/pki/overview-6","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#issue-and-control-certificates","content":"Issue and control certificates"},"2131":{"id":"/docs/platform/pki/overview-7","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#publish-validation-status","content":"Publish validation status"},"2132":{"id":"/docs/platform/pki/overview-8","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#how-to-check-the-result","content":"How to check the result"},"2133":{"id":"/docs/platform/pki/overview-9","page_id":"/docs/platform/pki/overview","type":"heading","tags":[],"url":"/docs/platform/pki/overview#continue","content":"Continue"},"2134":{"id":"/docs/platform/pki/overview-10","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview","content":"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system."},"2135":{"id":"/docs/platform/pki/overview-11","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#start-here","content":"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain."},"2136":{"id":"/docs/platform/pki/overview-12","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#start-here","content":"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets."},"2137":{"id":"/docs/platform/pki/overview-13","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#what-you-need","content":"An accessible instance and permission to manage the keys, CAs and certificates you will use."},"2138":{"id":"/docs/platform/pki/overview-14","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#what-you-need","content":"An available cryptographic engine to keep the authority's key."},"2139":{"id":"/docs/platform/pki/overview-15","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#what-you-need","content":"The certificate's purpose, such as authenticating a client through mTLS."},"2140":{"id":"/docs/platform/pki/overview-16","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#what-you-need","content":"Consumer requirements: accepted issuers, algorithms, names and permitted usages."},"2141":{"id":"/docs/platform/pki/overview-17","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#what-you-need","content":"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices."},"2142":{"id":"/docs/platform/pki/overview-18","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#build-your-trust-hierarchy","content":"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority."},"2143":{"id":"/docs/platform/pki/overview-19","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#protect-cryptographic-keys","content":"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method."},"2144":{"id":"/docs/platform/pki/overview-20","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#issue-and-control-certificates","content":"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status."},"2145":{"id":"/docs/platform/pki/overview-21","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#publish-validation-status","content":"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status."},"2146":{"id":"/docs/platform/pki/overview-22","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"An active certificate in the console is one part of the check. Also verify that:"},"2147":{"id":"/docs/platform/pki/overview-23","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"its subject and extensions identify the expected client;"},"2148":{"id":"/docs/platform/pki/overview-24","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"its public key matches the client's private key;"},"2149":{"id":"/docs/platform/pki/overview-25","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"its chain reaches a root trusted by the consumer;"},"2150":{"id":"/docs/platform/pki/overview-26","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"its dates and usages allow the operation;"},"2151":{"id":"/docs/platform/pki/overview-27","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"the consumer applies revocation checks and authorization."},"2152":{"id":"/docs/platform/pki/overview-28","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#how-to-check-the-result","content":"The issuance path includes the first independent checks."},"2153":{"id":"/docs/platform/pki/overview-29","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#continue","content":"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />"},"2154":{"id":"/docs/platform/pki/overview-30","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#continue","content":"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />"},"2155":{"id":"/docs/platform/pki/overview-31","page_id":"/docs/platform/pki/overview","tags":[],"type":"text","url":"/docs/platform/pki/overview#continue","content":"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />"},"2156":{"id":"/docs/platfor