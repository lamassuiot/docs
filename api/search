/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2274":{"id":"/docs/platform/pki/troubleshooting-16","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2275":{"id":"/docs/platform/pki/troubleshooting-17","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2276":{"id":"/docs/platform/pki/troubleshooting-18","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2277":{"id":"/docs/platform/pki/troubleshooting-19","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2278":{"id":"/docs/platform/pki/troubleshooting-20","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2279":{"id":"/docs/platform/pki/troubleshooting-21","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2280":{"id":"/docs/platform/pki/troubleshooting-22","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2281":{"id":"/docs/platform/pki/troubleshooting-23","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2282":{"id":"/docs/platform/pki/troubleshooting-24","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2283":{"id":"/docs/platform/pki/troubleshooting-25","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2284":{"id":"/docs/platform/pki/troubleshooting-26","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2285":{"id":"/docs/platform/pki/troubleshooting-27","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2286":{"id":"/docs/platform/pki/troubleshooting-28","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2287":{"id":"/docs/platform/pki/troubleshooting-29","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2288":{"id":"/docs/platform/pki/troubleshooting-30","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2289":{"id":"/docs/platform/pki/troubleshooting-31","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2290":{"id":"/docs/platform/pki/troubleshooting-32","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2291":{"id":"/docs/platform/pki/troubleshooting-33","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2292":{"id":"/docs/platform/pki/troubleshooting-34","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."}},"count":2292},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":830,"2":1724,"3":544,"4":1199,"5":1449,"6":704,"7":1339,"8":1337,"9":1388,"10":1886,"11":1493,"12":407,"13":396,"14":38,"15":139,"16":102,"17":1088,"18":1749,"19":706,"20":1809,"21":741,"22":831,"23":674,"24":656,"25":1279,"26":429,"27":2269,"28":1379,"29":1605,"30":2245,"31":1815,"32":1307,"33":1560,"34":2290,"35":1093,"36":524,"37":960,"38":2291,"39":1526,"40":1728,"41":1843,"42":1309,"43":1363,"44":334,"45":314,"46":335,"47":2144,"48":1423,"49":2148,"50":726,"51":2214,"52":1510,"53":1656,"54":1328,"55":1512,"56":514,"57":2195,"58":1844,"59":1507,"60":861,"61":1838,"62":1800,"63":1814,"64":2129,"65":916,"66":358,"67":1561,"68":2130,"69":917,"70":359,"71":943,"72":2128,"73":813,"74":360,"75":733,"76":2241,"77":990,"78":555,"79":832,"80":2205,"81":545,"82":1591,"83":1068,"84":685,"85":2213,"86":2102,"87":788,"88":2186,"89":1000,"90":1047,"91":993,"92":998,"93":2285,"94":1523,"95":1999,"96":946,"97":584,"98":397,"99":680,"100":1473,"101":1559,"102":996,"103":2282,"104":465,"105":265,"106":309,"107":579,"108":264,"109":1058,"110":994,"111":999,"112":1727,"113":760,"114":563,"115":1418,"116":2050,"117":1739,"118":1469,"119":814,"120":1582,"121":173,"122":0,"123":1787,"124":171,"125":801,"126":1761,"127":176,"128":986,"129":1799,"130":177,"131":267,"132":1385,"133":172,"134":228,"135":899,"136":178,"137":1336,"138":1315,"139":164,"140":188,"141":1071,"142":163,"143":189,"144":1070,"145":168,"146":1,"14