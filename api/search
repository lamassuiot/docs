s/deployment/troubleshooting-47","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups."},"414":{"id":"/docs/deployment/troubleshooting-48","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#a-pod-is-not-ready","content":"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling."},"415":{"id":"/docs/deployment/troubleshooting-49","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"Domain and audit events depend on the bus publisher:"},"416":{"id":"/docs/deployment/troubleshooting-50","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"verify it is enabled in the emitting service;"},"417":{"id":"/docs/deployment/troubleshooting-51","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"check AMQP connectivity and credentials;"},"418":{"id":"/docs/deployment/troubleshooting-52","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"review exchange, routing key, queues and consumers;"},"419":{"id":"/docs/deployment/troubleshooting-53","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting#events-are-not-arriving","content":"inspect dead-letter queues;"},"420":{"id":"/docs/deployment/troubleshooting-54","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text",