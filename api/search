tform/pki/device-management#decommission-a-device","content":"Decommission a device"},"1046":{"id":"/docs/platform/pki/device-management-11","page_id":"/docs/platform/pki/device-management","type":"heading","tags":[],"url":"/docs/platform/pki/device-management#automate-enrollment","content":"Automate enrollment"},"1047":{"id":"/docs/platform/pki/device-management-12","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management","content":"A managed device represents an entity in your fleet and keeps the history of the certificates it has used. Lamassu separates the device from its current identity so you can renew or replace certificates without losing traceability."},"1048":{"id":"/docs/platform/pki/device-management-13","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**Active** indicates the device has a valid identity."},"1049":{"id":"/docs/platform/pki/device-management-14","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**No Identity** appears when it is registered but does not yet have an associated certificate."},"1050":{"id":"/docs/platform/pki/device-management-15","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**Renewal Pending** signals that it has entered the renewal window."},"1051":{"id":"/docs/platform/pki/device-management-16","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**Expiring Soon** warns that the certificate is close to expiring."},"1052":{"id":"/docs/platform/pki/device-management-17","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**Expired** indicates the identity has passed its validity date."},"1053":{"id":"/docs/platform/pki/device-management-18","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**Revoked** identifies a certificate invalidated before its expiration."},"1054":{"id":"/docs/platform/pki/device-management-19","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"**Decommissioned** corresponds to a device permanently retired."},"1055":{"id":"/docs/platform/pki/device-management-20","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#device-states","content":"The inventory lets you filter by `Device ID`, tags and status."},"1056":{"id":"/docs/platform/pki/device-management-21","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#inspect-a-device","content":"The detail view separates two perspectives:"},"1057":{"id":"/docs/platform/pki/device-management-22","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#inspect-a-device","content":"**Certificate History** keeps every certificate associated with the device, with its serial number, issuer, status and validity period."},"1058":{"id":"/docs/platform/pki/device-management-23","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#inspect-a-device","content":"**Device Event Timeline** orders registrations, enrollments, renewals and status changes chronologically."},"1059":{"id":"/docs/platform/pki/device-management-24","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#inspect-a-device","content":"Use the history for audit and the timeline to reconstruct an incident or diagnose an unexpected transition."},"1060":{"id":"/docs/platform/pki/device-management-25","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#register-a-device-manually","content":"Pre-registration is useful when policy requires the device to exist before requesting its first certificate."},"1061":{"id":"/docs/platform/pki/device-management-26","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#create-the-device","content":"From **Managed Devices**, open the registration form."},"1062":{"id":"/docs/platform/pki/device-management-27","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#define-its-membership","content":"Enter a unique **Device ID** and select the DMS that will apply the enrollment and renewal policies."},"1063":{"id":"/docs/platform/pki/device-management-28","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#classify-the-device","content":"Add an icon and tags if you need to group devices by model, location, environment or another operational criterion."},"1064":{"id":"/docs/platform/pki/device-management-29","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#verify-the-registration","content":"The device should appear with status **No Identity** until it completes enrollment or receives a manually assigned identity."},"1065":{"id":"/docs/platform/pki/device-management-30","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#assign-an-identity-manually","content":"The **Assign Identity** action is available while the device remains in **No Identity**."},"1066":{"id":"/docs/platform/pki/device-management-31","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#assign-an-identity-manually","content":"Open the device and select **Assign Identity**."},"1067":{"id":"/docs/platform/pki/device-management-32","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#assign-an-identity-manually","content":"Choose an active certificate whose `Common Name` matches the `Device ID`."},"1068":{"id":"/docs/platform/pki/device-management-33","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#assign-an-identity-manually","content":"If none exists, select **Issue New Instead** and choose a CA linked to the DMS."},"1069":{"id":"/docs/platform/pki/device-management-34","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#assign-an-identity-manually","content":"Confirm the assignment."},"1070":{"id":"/docs/platform/pki/device-management-35","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#assign-an-identity-manually","content":"The device should change to **Active** and the certificate should appear in its history."},"1071":{"id":"/docs/platform/pki/device-management-36","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#revoke-the-current-identity","content":"In **Device Event Timeline**, locate the latest active certificate and select **Revoke**. Choose a reason consistent with your policy and confirm the operation."},"1072":{"id":"/docs/platform/pki/device-management-37","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#revoke-the-current-identity","content":"Revocation invalidates the certificate but does not delete the device. You can restore its operation by assigning it a new identity. `CertificateHold` allows reactivating the retained certificate; all other reasons are final."},"1073":{"id":"/docs/platform/pki/device-management-38","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#decommission-a-device","content":"This action revokes all the device's certificates and prevents it from obtaining an identity again."},"1074":{"id":"/docs/platform/pki/device-management-39","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#decommission-a-device","content":"Use **Decommission** only when the device has stopped operating or is no longer trustworthy. After confirming, Lamassu revokes the active identity with `CessationOfOperation` and changes the status to **Decommissioned**."},"1075":{"id":"/docs/platform/pki/device-management-40","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#automate-enrollment","content":"<Card title=\"Configure a DMS\" description=\"Define the CA, trust and policies of the fleet.\" href=\"/docs/platform/pki/device-enrollment\" />"},"1076":{"id":"/docs/platform/pki/device-management-41","page_id":"/docs/platform/pki/device-management","tags":[],"type":"text","url":"/docs/platform/pki/device-management#automate-enrollment","content":"<Card title=\"Integrate EST\" description=\"Let the device request and renew its identity.\" href=\"/docs/platform/pki/est-enrollment\" />"},"1077":{"id":"/docs/platform/pki/est-enrollment","page_id":"/docs/platform/pki/est-enrollment","type":"page","content":"Device enrollment with EST","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/platform/pki/est-enrollment"},"1078":{"id":"/docs/platform/pki/est-enrollment-0","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment","content":"EST protocol guide for Lamassu IoT, with DMS configuration for the PKI administrator and the endpoint reference for device integrators."},"1079":{"id":"/docs/platform/pki/est-enrollment-1","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"EST: Enrollment over Secure Transport"},"1080":{"id":"/docs/platform/pki/est-enrollment-2","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#dms-configuration","content":"DMS configuration"},"1081":{"id":"/docs/platform/pki/est-enrollment-3","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#prerequisites","content":"Prerequisites"},"1082":{"id":"/docs/platform/pki/est-enrollment-4","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#enrollment-configuration","content":"Enrollment configuration"},"1083":{"id":"/docs/platform/pki/est-enrollment-5","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#enrollment-device-registration","content":"Enrollment Device Registration"},"1084":{"id":"/docs/platform/pki/est-enrollment-6","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"Enrollment Settings"},"1085":{"id":"/docs/platform/pki/est-enrollment-7","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"Issuance profile"},"1086":{"id":"/docs/platform/pki/est-enrollment-8","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"Re-enrollment configuration"},"1087":{"id":"/docs/platform/pki/est-enrollment-9","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#serverkeygen-configuration","content":"ServerKeyGen configuration"},"1088":{"id":"/docs/platform/pki/est-enrollment-10","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#verify-the-configuration","content":"Verify the configuration"},"1089":{"id":"/docs/platform/pki/est-enrollment-11","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#device-integration","content":"Device integration"},"1090":{"id":"/docs/platform/pki/est-enrollment-12","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"Before you begin"},"1091":{"id":"/docs/platform/pki/est-enrollment-13","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#flow-overview","content":"Flow overview"},"1092":{"id":"/docs/platform/pki/est-enrollment-14","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Client authentication model"},"1093":{"id":"/docs/platform/pki/est-enrollment-15","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#endpoint-reference","content":"Endpoint reference"},"1094":{"id":"/docs/platform/pki/est-enrollment-16","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#cacerts","content":"`/cacerts`"},"1095":{"id":"/docs/platform/pki/est-enrollment-17","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"`/simpleenroll`"},"1096":{"id":"/docs/platform/pki/est-enrollment-18","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"`/simplereenroll`"},"1097":{"id":"/docs/platform/pki/est-enrollment-19","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"`/serverkeygen`"},"1098":{"id":"/docs/platform/pki/est-enrollment-20","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#full-flows","content":"Full flows"},"1099":{"id":"/docs/platform/pki/est-enrollment-21","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#end-to-end-example-enroll","content":"End-to-end example: enroll"},"1100":{"id":"/docs/platform/pki/est-enrollment-22","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#end-to-end-example-reenroll","content":"End-to-end example: reenroll"},"1101":{"id":"/docs/platform/pki/est-enrollment-23","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","content":"Next steps after enrollment"},"1102":{"id":"/docs/platform/pki/est-enrollment-24","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#diagnostics-and-compatibility","content":"Diagnostics and compatibility"},"1103":{"id":"/docs/platform/pki/est-enrollment-25","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Error codes and diagnostics"},"1104":{"id":"/docs/platform/pki/est-enrollment-26","page_id":"/docs/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"Compatibility notes"},"1105":{"id":"/docs/platform/pki/est-enrollment-27","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Lamassu IoT implements the &#x2A;*EST (Enrollment over Secure Transport)** protocol described in RFC 7030 as its only certificate enrollment mechanism for devices. Each DMS exposes the EST endpoints, validates the device and applies its own authentication, registration and renewal policies. In doing so, it acts as the Registration Authority (RA) facing the client."},"1106":{"id":"/docs/platform/pki/est-enrollment-28","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"The entity that issues and cryptographically signs the certificate is always the **CA associated with the DMS**, not the DMS. The DMS coordinates the process: it receives the CSR, authenticates the device and applies the issuance policy. This distinction matters for the PKI administrator when selecting the `EnrollmentCA` and for the integrator when interpreting the chain of trust received from `/cacerts`."},"1107":{"id":"/docs/platform/pki/est-enrollment-29","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"This guide is split in two parts:"},"1108":{"id":"/docs/platform/pki/est-enrollment-30","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"DMS configuration, for the PKI administrator."},"1109":{"id":"/docs/platform/pki/est-enrollment-31","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Device integration, for anyone consuming the EST endpoints from firmware, scripts or provisioning services."},"1110":{"id":"/docs/platform/pki/est-enrollment-32","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"If you only need a quick orientation, this is the recommended route:"},"1111":{"id":"/docs/platform/pki/est-enrollment-33","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"**PKI administrator:** start with DMS configuration and finish with Diagnostics and compatibility."},"1112":{"id":"/docs/platform/pki/est-enrollment-34","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"**Device integrator:** start with Before you begin and continue with `/cacerts`, `/simpleenroll`, `/simplereenroll` or `/serverkeygen`, depending on the flow you will implement."},"1113":{"id":"/docs/platform/pki/est-enrollment-35","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"Before configuring a DMS for EST, the following resources must exist on the platform:"},"1114":{"id":"/docs/platform/pki/est-enrollment-36","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"**An available CA**: the CA acting as `EnrollmentCA` must be created and active in Lamassu. If the authentication mode is `CLIENT_CERTIFICATE`, the validation CAs for the bootstrap certificate must also have been created."},"1115":{"id":"/docs/platform/pki/est-enrollment-37","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"**A created DMS**: the DMS this configuration applies to must already exist. The EST configuration is applied over an existing DMS, it does not create one."},"1116":{"id":"/docs/platform/pki/est-enrollment-38","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"It is worth separating four configuration blocks:"},"1117":{"id":"/docs/platform/pki/est-enrollment-39","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"How the initial enrollment will be performed, including the registration mode and client authentication."},"1118":{"id":"/docs/platform/pki/est-enrollment-40","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"How the re-enrollment of already-issued certificates will be handled."},"1119":{"id":"/docs/platform/pki/est-enrollment-41","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"How the cacerts endpoint will be configured to distribute the CAs devices use as trust anchors."},"1120":{"id":"/docs/platform/pki/est-enrollment-42","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#prerequisites","content":"Whether server-side key generation through `ServerKeyGen` will be enabled."},"1121":{"id":"/docs/platform/pki/est-enrollment-43","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-device-registration","content":"This section defines how new devices are registered and with which credentials they authenticate."},"1122":{"id":"/docs/platform/pki/est-enrollment-44","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-device-registration","content":"**Registration Mode**: determines the behavior when receiving an initial enrollment. In `JITP` (*Just-In-Time Provisioning*) mode, the device is created automatically the first time it presents itself, applying the tags, metadata and icon defined in the provisioning profile. In `PRE_REGISTRATION` mode, the device must already exist on the platform; if it does not, the request is rejected with `device not preregistered`. JITP mode suits large fleets where the inventory is built during deployment; `PRE_REGISTRATION` fits high-security environments where each device is explicitly approved before receiving a certificate."},"1123":{"id":"/docs/platform/pki/est-enrollment-45","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-device-registration","content":"**Tags**: applied to each device automatically created by this DMS. They are optional and only take effect in JITP mode. Tags improve device search."},"1124":{"id":"/docs/platform/pki/est-enrollment-46","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-device-registration","content":"**Icon**: applied to each device automatically created by this DMS. It is optional and only takes effect in JITP mode. Purely visual."},"1125":{"id":"/docs/platform/pki/est-enrollment-47","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Enrollment CA**: identifies the CA that will sign the identity certificates issued through this DMS. Its choice determines the chain of trust the device will receive and the root against which backend systems will validate fleet certificates."},"1126":{"id":"/docs/platform/pki/est-enrollment-48","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Allow Override Enrollment** (`enable_replaceable_enrollment`): allows an already-enrolled device to enroll again through `/simpleenroll`. When active, the previous certificate is revoked with the reason `superseded` and the identity slot is updated. When inactive, a second `simpleenroll` attempt is rejected with `forbiddenNewEnrollment`. This option must be enabled with care in production environments, since it lets you replace a device's identity without going through the re-enrollment flow."},"1127":{"id":"/docs/platform/pki/est-enrollment-49","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Verify CSR Signature** (`verify_csr_signature`): controls whether the server validates the CSR signature against the public key declared in it (PKCS#10 proof of possession). When inactive, a requester could submit a CSR with a public key it does not control and obtain a certificate bound to it. For IoT fleets on open networks it must be enabled."},"1128":{"id":"/docs/platform/pki/est-enrollment-50","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Authentication Mode**: defines how the DMS validates the device identity during enrollment. It can require an mTLS certificate (`CLIENT_CERTIFICATE`), delegate authorization to a webhook (`EXTERNAL_WEBHOOK`), combine both controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) or accept unauthenticated requests (`NO_AUTH`). The latter must be limited to isolated labs or provisioning networks."},"1129":{"id":"/docs/platform/pki/est-enrollment-51","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"When the mode is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, these parameters are also configured:"},"1130":{"id":"/docs/platform/pki/est-enrollment-52","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Validation CAs**: list of trusted CAs to validate the bootstrap certificate presented by the device."},"1131":{"id":"/docs/platform/pki/est-enrollment-53","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Chain Validation Level**: maximum depth of the validation chain. The value `-1` validates the full chain up to the root CA."},"1132":{"id":"/docs/platform/pki/est-enrollment-54","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Allow Authenticating Expired Certificates**: if active, accepts expired client certificates. Useful in recovery scenarios where the device could not renew its certificate in time."},"1133":{"id":"/docs/platform/pki/est-enrollment-55","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"When the mode includes `EXTERNAL_WEBHOOK`, these parameters are also configured:"},"1134":{"id":"/docs/platform/pki/est-enrollment-56","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Webhook URL**: address of the external service that will decide authorization."},"1135":{"id":"/docs/platform/pki/est-enrollment-57","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**HTTP Method**: HTTP method used to invoke the webhook. Supports `POST` (default) or `PUT`; both are equivalent for the webhook, only the verb Lamassu uses changes."},"1136":{"id":"/docs/platform/pki/est-enrollment-58","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Timeout**: maximum wait time for the webhook call. If not specified, the default is **10 seconds**; after that without a response, Lamassu denies the operation."},"1137":{"id":"/docs/platform/pki/est-enrollment-59","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"**Webhook Authentication Mode**: authentication mode of the webhook toward the external service, for example `ApiKey`, `OIDC` or `mTLS`."},"1138":{"id":"/docs/platform/pki/est-enrollment-60","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#enrollment-settings","content":"The exact contract the webhook service must implement (request and response schema, examples) is published as an OpenAPI specification: authorization webhook reference."},"1139":{"id":"/docs/platform/pki/est-enrollment-61","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"The behavior of the issued certificate is not determined solely by the device's CSR, but by the **issuance profile** (`IssuanceProfile`) associated with the DMS. The integrator does not configure this profile, but its rules affect the content of the final certificate:"},"1140":{"id":"/docs/platform/pki/est-enrollment-62","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"**`HonorSubject`** controls whether the CSR's subject is copied verbatim into the certificate. If disabled, the CA applies the profile's template and ignores the received subject."},"1141":{"id":"/docs/platform/pki/est-enrollment-63","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"**`HonorKeyUsage`** decides whether the CSR's `KeyUsage` is respected or replaced by the one defined in the template."},"1142":{"id":"/docs/platform/pki/est-enrollment-64","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"**`HonorExtendedKeyUsages`** applies the same rule to `ExtKeyUsage`."},"1143":{"id":"/docs/platform/pki/est-enrollment-65","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"**`HonorExtensions`** controls whether the rest of the CSR's extensions, such as SAN or CDP, are included in the certificate."},"1144":{"id":"/docs/platform/pki/est-enrollment-66","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#issuance-profile","content":"This matters for the integrator: the `KeyUsage`, `ExtKeyUsage` and SANs declared in the CSR may not appear as-is in the final certificate if the profile decides otherwise. Check with the PKI administrator if the issued certificate does not contain the expected extensions."},"1145":{"id":"/docs/platform/pki/est-enrollment-67","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"The **Re-Enrollment Settings** section controls the certificate renewal process. Re-enrollment can only be performed while the certificate is within the configured window, and optionally also when the certificate has already expired."},"1146":{"id":"/docs/platform/pki/est-enrollment-68","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"**Revoke On Re-Enroll**: if active, the previous certificate is automatically revoked with the reason `superseded` once the new one is issued."},"1147":{"id":"/docs/platform/pki/est-enrollment-69","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"**Allow Expired Renewal**: allows renewing an already-expired certificate. Useful when a device has been offline and could not renew within the window."},"1148":{"id":"/docs/platform/pki/est-enrollment-70","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"**Allowed Renewal Delta**: time window before expiration during which re-enrollment is allowed. Before this window opens, the request is rejected with `invalid reenroll window`."},"1149":{"id":"/docs/platform/pki/est-enrollment-71","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"**Preventive Renewal Delta**: time before expiration from which preventive renewal alerts are raised."},"1150":{"id":"/docs/platform/pki/est-enrollment-72","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"**Critical Renewal Delta**: threshold closest to expiration that triggers critical status alerts."},"1151":{"id":"/docs/platform/pki/est-enrollment-73","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#re-enrollment-configuration","content":"**Additional Validation CAs**: additional CAs accepted as issuers of the active certificate during re-enrollment. It allows migrating to a new enrollment CA without interrupting the renewal of devices already enrolled with the previous CA."},"1152":{"id":"/docs/platform/pki/est-enrollment-74","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen-configuration","content":"The **Server Key Generation** section lets Lamassu generate the device's key pair on the server and return it together with the issued certificate. It is useful for devices with limited cryptographic capability."},"1153":{"id":"/docs/platform/pki/est-enrollment-75","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen-configuration","content":"The **Enable Server-Side Key Generation** option activates the `/serverkeygen` endpoint. When inactive, any call to that endpoint is rejected with `server key generation not enabled`."},"1154":{"id":"/docs/platform/pki/est-enrollment-76","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen-configuration","content":"**Key Type** selects the algorithm: `RSA` or `ECDSA`. The &#x2A;*Key Size (bits)** field determines the key size. For ECDSA, the size in bits also determines the curve: 256 corresponds to P-256, 384 to P-384 and 521 to P-521."},"1155":{"id":"/docs/platform/pki/est-enrollment-77","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen-configuration","content":"The key is generated in the server's software engine, not in a hardware Crypto Engine such as AWS KMS or PKCS#11. The only protection of the key in transit is the TLS channel; no additional encryption (CMS EnvelopedData) is applied to the key before sending it to the device. See the `/serverkeygen` section of the integrator reference for the exact response format and security considerations."},"1156":{"id":"/docs/platform/pki/est-enrollment-78","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#verify-the-configuration","content":"Once the enrollment, re-enrollment and ServerKeyGen settings are applied, you can confirm the DMS is operational as follows:"},"1157":{"id":"/docs/platform/pki/est-enrollment-79","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#verify-the-configuration","content":"**From the console**: open the DMS detail and check that the EST section shows the assigned enrollment CA and the configured authentication mode."},"1158":{"id":"/docs/platform/pki/est-enrollment-80","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#verify-the-configuration","content":"**With a test request**: invoke the DMS's `/cacerts` endpoint from a `curl` client with server trust. A `200 OK` response with base64 content confirms the DMS is active and the enrollment CA is reachable."},"1159":{"id":"/docs/platform/pki/est-enrollment-81","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#verify-the-configuration","content":"If the DMS does not exist or the CA is not available, the server responds with `DMS not found` or another error message. See the Diagnostics and compatibility section to interpret error messages."},"1160":{"id":"/docs/platform/pki/est-enrollment-82","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#device-integration","content":"*This section is aimed at device integrators.*"},"1161":{"id":"/docs/platform/pki/est-enrollment-83","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#device-integration","content":"Lamassu's EST endpoints are published under the `/.well-known/est` prefix and always require the presence of the `{aps}` path segment, interpreted as the identifier of the DMS the operation targets. The association is direct: the `{aps}` value received in the URL is used as the DMS ID when querying the internal store. Variants registered without `{aps}` (for example `/.well-known/est/cacerts`) are routed in the code, but their handler requires the `APS` field and returns `400 Bad Request` with the message `Field validation for 'APS' failed` when the segment is not provided."},"1162":{"id":"/docs/platform/pki/est-enrollment-84","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#device-integration","content":"This part follows the integrator's usual working order: first the prerequisites and the authentication model, then the reference for each endpoint and, finally, complete examples and diagnostic material."},"1163":{"id":"/docs/platform/pki/est-enrollment-85","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"The PKI administrator must have configured a DMS with the `EST_RFC7030` protocol, an assigned enrollment CA and at least one authentication mode. Without that prior configuration, Lamassu rejects any enrollment request. The details of that configuration are in the DMS configuration section of this same page."},"1164":{"id":"/docs/platform/pki/est-enrollment-86","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"Before making the first call, make sure you have:"},"1165":{"id":"/docs/platform/pki/est-enrollment-87","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"**The EST host URL**, for example `https://est.lamassu.example`, provided by the PKI administrator."},"1166":{"id":"/docs/platform/pki/est-enrollment-88","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"**The server trust anchor** (`lamassu-trust.pem`), root or intermediate, with which the client will validate Lamassu's TLS."},"1167":{"id":"/docs/platform/pki/est-enrollment-89","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"**The bootstrap certificate and its private key** if the DMS uses `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. This identity must come from one of the configured `ValidationCAs`, usually a provisioning CA different from the enrollment CA."},"1168":{"id":"/docs/platform/pki/est-enrollment-90","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#before-you-begin","content":"**The DMS ID** (`{aps}`), which must appear in every EST route."},"1169":{"id":"/docs/platform/pki/est-enrollment-91","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#flow-overview","content":"**Download trust with `/cacerts`:** the client validates the server's TLS and receives the certificates in PKCS#7 or PEM."},"1170":{"id":"/docs/platform/pki/est-enrollment-92","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#flow-overview","content":"**Perform initial enrollment with `/simpleenroll`:** present the bootstrap certificate or the credential defined by `AuthMode` to obtain the device certificate."},"1171":{"id":"/docs/platform/pki/est-enrollment-93","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#flow-overview","content":"**Renew with `/simplereenroll`:** authenticate with the device's current certificate to obtain a new one."},"1172":{"id":"/docs/platform/pki/est-enrollment-94","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#flow-overview","content":"**Use `/serverkeygen` only if you need server-side key generation:** it applies the same authentication as `/simpleenroll` and returns the PKCS#8 private key together with the certificate."},"1173":{"id":"/docs/platform/pki/est-enrollment-95","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Lamassu's implementation recognizes four authentication configurations for `/simpleenroll`, expressed through the DMS's `EnrollmentOptionsESTRFC7030.AuthMode` field. Three are simple modes (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) and one combines two controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). The client must present itself in the mode the DMS expects; any other combination fails the enrollment."},"1174":{"id":"/docs/platform/pki/est-enrollment-96","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Mode (`AuthMode`)"},"1175":{"id":"/docs/platform/pki/est-enrollment-97","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Description"},"1176":{"id":"/docs/platform/pki/est-enrollment-98","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Expected credential"},"1177":{"id":"/docs/platform/pki/est-enrollment-99","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Applies in enroll"},"1178":{"id":"/docs/platform/pki/est-enrollment-100","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Applies in reenroll"},"1179":{"id":"/docs/platform/pki/est-enrollment-101","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"`CLIENT_CERTIFICATE`"},"1180":{"id":"/docs/platform/pki/est-enrollment-102","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"mTLS with X.509 certificate"},"1181":{"id":"/docs/platform/pki/est-enrollment-103","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Client certificate and private key"},"1182":{"id":"/docs/platform/pki/est-enrollment-104","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Yes"},"1183":{"id":"/docs/platform/pki/est-enrollment-105","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Yes (with the active certificate)"},"1184":{"id":"/docs/platform/pki/est-enrollment-106","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"1185":{"id":"/docs/platform/pki/est-enrollment-107","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"mTLS plus webhook validation"},"1186":{"id":"/docs/platform/pki/est-enrollment-108","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Client certificate and private key, plus webhook approval"},"1187":{"id":"/docs/platform/pki/est-enrollment-109","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Yes"},"1188":{"id":"/docs/platform/pki/est-enrollment-110","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Not as a combination; in reenroll both controls are not kept"},"1189":{"id":"/docs/platform/pki/est-enrollment-111","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"`EXTERNAL_WEBHOOK`"},"1190":{"id":"/docs/platform/pki/est-enrollment-112","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"External authorization webhook"},"1191":{"id":"/docs/platform/pki/est-enrollment-113","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"None on the TLS channel"},"1192":{"id":"/docs/platform/pki/est-enrollment-114","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Yes"},"1193":{"id":"/docs/platform/pki/est-enrollment-115","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"No, degrades to `NO_AUTH`"},"1194":{"id":"/docs/platform/pki/est-enrollment-116","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"`NO_AUTH`"},"1195":{"id":"/docs/platform/pki/est-enrollment-117","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"No authentication"},"1196":{"id":"/docs/platform/pki/est-enrollment-118","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"None"},"1197":{"id":"/docs/platform/pki/est-enrollment-119","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Yes (restricted use)"},"1198":{"id":"/docs/platform/pki/est-enrollment-120","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Yes (restricted use)"},"1199":{"id":"/docs/platform/pki/est-enrollment-121","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"JWT **is not a valid authentication mode in EST**. The JWT identity extractor exists in the code but is only evaluated in Lamassu's administration API. Any *Bearer token* sent to `/.well-known/est/...` is silently ignored. When the DMS is configured with `AuthMode: CLIENT_CERTIFICATE`, a request carrying only a JWT is rejected for lack of a client certificate. When the DMS is in `AuthMode: NO_AUTH`, the request is processed as such and the JWT neither adds nor removes authorization."},"1200":{"id":"/docs/platform/pki/est-enrollment-122","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"**`CLIENT_CERTIFICATE`**: the client presents an X.509 certificate issued by one of the CAs declared in `AuthOptionsMTLS.ValidationCAs`. The process validates the certificate chain against those CAs through the `ValidationCAs`, `AllowExpired` and `ChainLevelValidation` parameters. In addition, the service checks the revocation status in three steps: first it looks up the cert in Lamassu's local database; if not found, it queries the OCSP responders listed in the AIA extension; if OCSP fails, it tries the CRL Distribution Points (CDP). A revoked certificate interrupts the enrollment with `certificate is revoked`."},"1201":{"id":"/docs/platform/pki/est-enrollment-123","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"Its main parameters are `ValidationCAs`, the list of CAs that can validate the bootstrap certificate or the active certificate; `AllowExpired`, which allows accepting expired client certificates; and `ChainLevelValidation`, which limits the chain depth when its value is greater than zero."},"1202":{"id":"/docs/platform/pki/est-enrollment-124","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"**`EXTERNAL_WEBHOOK`**: Lamassu delegates the authorization decision to an external HTTP service. The EST server builds a `POST` request to the configured webhook with a JSON body reproducing the enrollment context."},"1203":{"id":"/docs/platform/pki/est-enrollment-125","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"The value of the `csr` field is the **base64 encoding of the CSR's PEM** (not the DER, and not the plain PEM). The webhook must respond with `2xx` and a JSON body `{\"authorized\": true}` to continue; any other response aborts the enrollment with `external webhook denied enrollment`. A `204 No Content` **is not a valid response** even though it is a `2xx` code: Lamassu requires a JSON body with the `authorized` field, so a webhook responding without a body denies the operation just like an error."},"1204":{"id":"/docs/platform/pki/est-enrollment-126","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combines the two previous modes during `/simpleenroll`. The client must present a valid mTLS certificate and the webhook must return `authorized: true`. In `/simplereenroll` the combination is not preserved: the joint mTLS + webhook check is not maintained, so the integrator must not assume the same guarantees of the initial enrollment apply in reenroll."},"1205":{"id":"/docs/platform/pki/est-enrollment-127","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#client-authentication-model","content":"**`NO_AUTH`**: the DMS accepts any CSR without validating the client's identity. Lamassu logs a warning (`DMS is configured with NoAuth, allowing enrollment`) and proceeds with the registration. It must be restricted to controlled environments (an isolated provisioning network); any network exposed to the internet with a DMS in `NO_AUTH` is open to certificate issuance by unauthorized third parties."},"1206":{"id":"/docs/platform/pki/est-enrollment-128","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#endpoint-reference","content":"The following sections describe the endpoints in the usual order of use within the device lifecycle:"},"1207":{"id":"/docs/platform/pki/est-enrollment-129","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#endpoint-reference","content":"`/cacerts`: download of the trust chain."},"1208":{"id":"/docs/platform/pki/est-enrollment-130","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#endpoint-reference","content":"`/simpleenroll`: initial certificate enrollment."},"1209":{"id":"/docs/platform/pki/est-enrollment-131","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#endpoint-reference","content":"`/simplereenroll`: renewal of an already-issued certificate."},"1210":{"id":"/docs/platform/pki/est-enrollment-132","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#endpoint-reference","content":"`/serverkeygen`: enrollment with server-side key generation."},"1211":{"id":"/docs/platform/pki/est-enrollment-133","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"The endpoint `GET /.well-known/est/{aps}/cacerts` distributes the certificates the device needs to validate the EST server and the rest of the CAs managed by the DMS. Lamassu inserts the certificates in this order: first the **downstream** certificate of the Lamassu server, which is the server's TLS leaf and not a CA, useful for pinning if `IncludeLamassuSystemCA` is enabled; then the `ManagedCAs` list declared in the DMS; and last the enrollment CA, if `IncludeEnrollmentCA` is enabled."},"1212":{"id":"/docs/platform/pki/est-enrollment-134","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"`CADistributionSettings` lets you decide what is published:"},"1213":{"id":"/docs/platform/pki/est-enrollment-135","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"**`IncludeLamassuSystemCA`** adds the *downstream* certificate of the Lamassu server. It is the TLS leaf the client can use to pin the connection, not a CA."},"1214":{"id":"/docs/platform/pki/est-enrollment-136","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"**`IncludeEnrollmentCA`** adds the DMS's issuing CA, responsible for signing device certificates."},"1215":{"id":"/docs/platform/pki/est-enrollment-137","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"**`ManagedCAs`** publishes additional CAs as trust anchors."},"1216":{"id":"/docs/platform/pki/est-enrollment-138","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"The default format is *degenerate* PKCS#7 (certificates only) base64-encoded. The response declares `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The base64 is wrapped in lines of **76 characters** terminated with CRLF, a width compliant with S/MIME (RFC 5751), not the 64 that some RFC 7030 guides suggest. This wrapping applies only to `/cacerts` and `/simpleenroll`; the internal parts of `/serverkeygen` carry no wrap, as explained below."},"1217":{"id":"/docs/platform/pki/est-enrollment-139","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"*Degenerate* PKCS#7 is a **set** of certificates with no defined semantic order. Although Lamassu inserts them in the order stated, the integrator must not assume that order when validating chains: the chain must be built by `Subject`/`Issuer` matching (or by AKI/SKI), not by position in the response."},"1218":{"id":"/docs/platform/pki/est-enrollment-140","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"The `-i` flag (ignore garbage) helps tolerate the CRLF Lamassu adds and is necessary on some `base64` implementations (BusyBox, BSD); on GNU coreutils it is ignored."},"1219":{"id":"/docs/platform/pki/est-enrollment-141","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#cacerts","content":"Lamassu additionally adds an extension over the RFC: if the client sends the `Accept: application/x-pem-file` header, the server responds with the PEM concatenation of the same certificates, without the PKCS#7 wrapper. This makes consumption from scripts easier. The extension also works on `/simpleenroll` and `/simplereenroll`."},"1220":{"id":"/docs/platform/pki/est-enrollment-142","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"The endpoint `POST /.well-known/est/{aps}/simpleenroll` receives a CSR and returns the issued certificate. The request body must be the **PKCS#10 (CSR) in DER, base64-encoded** without line breaks. The base64 wraps the DER directly, not a PEM. The `Content-Type` header must be `application/pkcs10`. If the `Content-Type` is different, the server responds `400` with `content-type must be application/pkcs10`; if the body is not valid base64, it responds `400` with `body payload must be base64 encoded`."},"1221":{"id":"/docs/platform/pki/est-enrollment-143","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"The response follows the same wrapper as `/cacerts`: *degenerate* PKCS#7 in base64, with `Content-Type: application/pkcs7-mime; smime-type=certs-only`. The PKCS#7 contains **only the newly issued leaf certificate**; it does not include the issuing CA or intermediates. This complies with RFC 7030 §4.2.3 (where the chain is optional) but implies the integrator must combine this certificate with the chain obtained from `/cacerts` before presenting it to any relying party that validates the full chain (for example, an MQTT broker with strict mTLS)."},"1222":{"id":"/docs/platform/pki/est-enrollment-144","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"Several DMS fields govern the behavior of `/simpleenroll`. The integrator does not configure them, but it helps to know them to interpret rejections:"},"1223":{"id":"/docs/platform/pki/est-enrollment-145","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"**`EnrollmentSettings.RegistrationMode`** decides whether the device is created during the first enrollment (`JITP`) or must exist beforehand (`PRE_REGISTRATION`)."},"1224":{"id":"/docs/platform/pki/est-enrollment-146","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"**`EnrollmentSettings.EnableReplaceableEnrollment`** allows repeating `/simpleenroll` for an already-enrolled device. When doing so, it revokes the previous certificate as `superseded`; if disabled, the server responds with `forbiddenNewEnrollment`."},"1225":{"id":"/docs/platform/pki/est-enrollment-147","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"**`EnrollmentSettings.VerifyCSRSignature`** validates that whoever submits the CSR controls the declared private key. For IoT fleets on open networks it must be enabled."},"1226":{"id":"/docs/platform/pki/est-enrollment-148","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simpleenroll","content":"In `JITP` mode, the first `simpleenroll` with a `CommonName` that does not yet exist in Lamassu creates the device automatically. In `PRE_REGISTRATION` mode, the device must exist beforehand; an unknown `CommonName` is rejected with `device not preregistered`. See Enrollment configuration for more details on both modes and the behavior of the issuance profile."},"1227":{"id":"/docs/platform/pki/est-enrollment-149","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"The endpoint `POST /.well-known/est/{aps}/simplereenroll` renews the certificate of an already-enrolled device. The body format is identical to `/simpleenroll` (DER base64 without line breaks, `Content-Type: application/pkcs10`). The difference lies in authentication: the client must present **the device's active certificate** (not the bootstrap) as the mTLS credential."},"1228":{"id":"/docs/platform/pki/est-enrollment-150","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"If the DMS is configured with `AuthMode: EXTERNAL_WEBHOOK`, the webhook is **not invoked** during `/simplereenroll`. The renewal flow silently degrades to `NO_AUTH`: any client that knows a valid `CommonName` can request reenroll for that device without authentication (`allowing reenroll: using NO AUTH mode` in the log). A DMS with `EXTERNAL_WEBHOOK` must not be used in production for reenroll flows unless access to the endpoint is network-controlled."},"1229":{"id":"/docs/platform/pki/est-enrollment-151","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"The behavior of reenroll is governed by several `ReEnrollmentSettings` fields:"},"1230":{"id":"/docs/platform/pki/est-enrollment-152","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"**`ReEnrollmentDelta`** opens the renewal window at `NotAfter - ReEnrollmentDelta`. Before that instant, the server responds with `invalid reenroll window`."},"1231":{"id":"/docs/platform/pki/est-enrollment-153","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"**`EnableExpiredRenewal`** allows using an already-expired certificate as proof of identity; if disabled, the server responds with `expired certificate`."},"1232":{"id":"/docs/platform/pki/est-enrollment-154","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"**`RevokeOnReEnrollment`** revokes the previous certificate as `superseded` after issuing the new one."},"1233":{"id":"/docs/platform/pki/est-enrollment-155","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"**`AdditionalValidationCAs`** adds valid issuers for the current certificate, in addition to the DMS's enrollment CA."},"1234":{"id":"/docs/platform/pki/est-enrollment-156","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"**Subject immutability**: the renewal CSR must have exactly the same subject as the active certificate. Lamassu compares, byte by byte, the `RawSubject` of the CSR with the certificate's (`slices.Compare`). If the bytes differ, the server falls back to a semantic comparison over the `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` and `Country` attributes. If all those attributes match, the reenroll continues despite the byte difference (rescuing cases where only the encoding changes, `PrintableString` versus `UTF8String`). If any attribute differs, the reenroll aborts with `invalid RawSubject bytes`. The integrator must regenerate the CSR with exactly the same subject as in the initial enrollment to avoid depending on fallback behavior."},"1235":{"id":"/docs/platform/pki/est-enrollment-157","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#simplereenroll","content":"**Validation of the presented certificate's chain**: validation is first attempted against the DMS's enrollment CA; if it fails, it walks the `AdditionalValidationCAs`. Validation is \"shallow\": each CA is tested as an anchor, no multi-level chain is composed. The client must present the complete chain in the mTLS handshake. A revoked certificate aborts the reenroll with `certificate is revoked`."},"1236":{"id":"/docs/platform/pki/est-enrollment-158","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"The endpoint `POST /.well-known/est/{aps}/serverkeygen` lets Lamassu generate the device's key pair on the server and return, in the same response, the private key and the issued certificate. It is useful for devices with limited cryptographic capability or flows where the key is provisioned during manufacturing."},"1237":{"id":"/docs/platform/pki/est-enrollment-159","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"This endpoint requires `ServerKeyGen.Enabled` to be `true` in the DMS. If it is not enabled, the server responds with `server key generation not enabled`. Authentication applies the same way as in `/simpleenroll`: the integrator presents the credential matching the DMS's `AuthMode`."},"1238":{"id":"/docs/platform/pki/est-enrollment-160","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"The algorithm and size of the generated key are decided by the DMS, not by the client."},"1239":{"id":"/docs/platform/pki/est-enrollment-161","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"**RSA** supports any size accepted by `crypto/rsa`; common values are 2048, 3072 and 4096 bits. An invalid value fails generation with a `500` error."},"1240":{"id":"/docs/platform/pki/est-enrollment-162","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"**ECDSA** supports 224, 256, 384 and 521 bits, equivalent to P-224, P-256 (`prime256v1`), P-384 and P-521. Any other value **silently** degrades to P-256 and only leaves a warning in the log: the client receives no error and may obtain a curve different from the expected one."},"1241":{"id":"/docs/platform/pki/est-enrollment-163","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"The CSR sent by the client serves only to carry the subject and extensions; the PKCS#10 proof of possession does not apply here because the client is not the one who generated the key. Lamassu discards the original CSR's public key, generates a new key pair with its internal entropy, in a software engine and not in a hardware Crypto Engine such as AWS KMS or PKCS#11, builds a new CSR with that key and proceeds with an internal enrollment equivalent to `/simpleenroll`."},"1242":{"id":"/docs/platform/pki/est-enrollment-164","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"The response is a `multipart/mixed` with the literal boundary `estServerLamassuBoundary`. It contains two parts:"},"1243":{"id":"/docs/platform/pki/est-enrollment-165","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"The private key in **unencrypted PKCS#8** format, base64-encoded inside a part with `Content-Type: application/pkcs8`."},"1244":{"id":"/docs/platform/pki/est-enrollment-166","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"The issued certificate in *degenerate* PKCS#7 base64, inside a part with `Content-Type: application/pkcs7-mime; smime-type=certs-only`."},"1245":{"id":"/docs/platform/pki/est-enrollment-167","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"Unlike `/cacerts` and `/simpleenroll`, where the base64 is wrapped in 76-character lines, each part of `/serverkeygen` travels as **a single base64 line without breaks**. Any reverse proxy that rewrites the body (for example, normalizing line endings) can break the parsing."},"1246":{"id":"/docs/platform/pki/est-enrollment-168","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"This endpoint reverses the PKI principle whereby the subscriber controls its own private key. The key is serialized as unencrypted PKCS#8 (`PrivateKeyInfo`, without `EncryptedPrivateKeyInfo`). The CMS `EnvelopedData` wrapper contemplated in RFC 7030 §4.4.2 is not applied; no AES key wrap or password-based symmetric encryption is used. The only protection is the channel's TLS. The integrator must guarantee that: (a) no reverse proxy terminates TLS and logs the response body; (b) the key is encrypted at rest immediately after receipt; (c) the audit account on the Lamassu server remains the single point of origin of the key."},"1247":{"id":"/docs/platform/pki/est-enrollment-169","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#serverkeygen","content":"To separate the two parts, the following snippet uses `awk` with the literal boundary. It works with Lamassu's exact structure (each part = headers + blank line + a single base64 line); any intermediate proxy rewriting the body will break it."},"1248":{"id":"/docs/platform/pki/est-enrollment-170","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#full-flows","content":"Once the endpoints have been reviewed individually, these examples show how to chain them in two common scenarios: the initial enrollment of a device and the renewal of an already-issued certificate."},"1249":{"id":"/docs/platform/pki/est-enrollment-171","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#end-to-end-example-enroll","content":"The following script illustrates the complete process of enrolling a device with a locally generated EC P-256 key and mTLS authentication against a bootstrap certificate."},"1250":{"id":"/docs/platform/pki/est-enrollment-172","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#end-to-end-example-reenroll","content":"The following script reproduces a renewal process: it detects the expiration of the current certificate, regenerates the CSR with the **same subject** and authenticates with the active certificate."},"1251":{"id":"/docs/platform/pki/est-enrollment-173","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","content":"Once the device has obtained its identity certificate, the usual steps are:"},"1252":{"id":"/docs/platform/pki/est-enrollment-174","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","content":"**Install the trust chain** (`cacerts.pem`) into the device's trust store. The MQTT broker, the HTTPS server or any relying party validating mTLS will need this chain."},"1253":{"id":"/docs/platform/pki/est-enrollment-175","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","content":"**Combine the leaf certificate with the chain** before presenting it in mTLS connections. The `/simpleenroll` response contains only the leaf certificate; the relying party may reject the connection if it does not receive the full chain."},"1254":{"id":"/docs/platform/pki/est-enrollment-176","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","content":"**Plan renewal**: configure a timer on the device that invokes `/simplereenroll` within the `ReEnrollmentDelta` window before the certificate expires. Do not wait for expiry unless `EnableExpiredRenewal` is enabled."},"1255":{"id":"/docs/platform/pki/est-enrollment-177","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Lamassu maps almost every business error to `500 Internal Server Error`, not to `4xx`. The HTTP status code is not enough to distinguish a network error from a policy error. The integrator must inspect the `err` field of the JSON body (`{\"err\": \"<message>\"}`) to determine the exact cause of the failure."},"1256":{"id":"/docs/platform/pki/est-enrollment-178","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"HTTP"},"1257":{"id":"/docs/platform/pki/est-enrollment-179","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Message"},"1258":{"id":"/docs/platform/pki/est-enrollment-180","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Cause"},"1259":{"id":"/docs/platform/pki/est-enrollment-181","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Integrator action"},"1260":{"id":"/docs/platform/pki/est-enrollment-182","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"400"},"1261":{"id":"/docs/platform/pki/est-enrollment-183","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`Field validation for 'APS' failed`"},"1262":{"id":"/docs/platform/pki/est-enrollment-184","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The `{aps}` segment is missing from the URL."},"1263":{"id":"/docs/platform/pki/est-enrollment-185","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Include the DMS ID in the path."},"1264":{"id":"/docs/platform/pki/est-enrollment-186","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"400"},"1265":{"id":"/docs/platform/pki/est-enrollment-187","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`content-type must be application/pkcs10`"},"1266":{"id":"/docs/platform/pki/est-enrollment-188","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`Content-Type` header missing or incorrect."},"1267":{"id":"/docs/platform/pki/est-enrollment-189","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Set `Content-Type: application/pkcs10`."},"1268":{"id":"/docs/platform/pki/est-enrollment-190","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"400"},"1269":{"id":"/docs/platform/pki/est-enrollment-191","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`body payload must be base64 encoded`"},"1270":{"id":"/docs/platform/pki/est-enrollment-192","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The body is not valid base64."},"1271":{"id":"/docs/platform/pki/est-enrollment-193","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Use `base64 -w 0` to avoid line breaks."},"1272":{"id":"/docs/platform/pki/est-enrollment-194","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1273":{"id":"/docs/platform/pki/est-enrollment-195","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`DMS not found`"},"1274":{"id":"/docs/platform/pki/est-enrollment-196","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The `{aps}` value does not match any DMS."},"1275":{"id":"/docs/platform/pki/est-enrollment-197","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Verify the identifier with the PKI administrator."},"1276":{"id":"/docs/platform/pki/est-enrollment-198","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1277":{"id":"/docs/platform/pki/est-enrollment-199","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`invalid certificate`"},"1278":{"id":"/docs/platform/pki/est-enrollment-200","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The client certificate is not valid against `ValidationCAs`."},"1279":{"id":"/docs/platform/pki/est-enrollment-201","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Check the bootstrap certificate chain."},"1280":{"id":"/docs/platform/pki/est-enrollment-202","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1281":{"id":"/docs/platform/pki/est-enrollment-203","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`certificate is