-hosted/overview#what-the-lamassu-chart-provides","content":"Optional integrations"},"349":{"id":"/docs/deployment/self-hosted/overview-43","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity"},"350":{"id":"/docs/deployment/self-hosted/overview-44","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The observability backends, cloud credentials and production HSM or external key service"},"351":{"id":"/docs/deployment/self-hosted/overview-45","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network."},"352":{"id":"/docs/deployment/self-hosted/overview-46","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service."},"353":{"id":"/docs/deployment/self-hosted/overview-47","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway."},"354":{"id":"/docs/deployment/self-hosted/overview-48","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"355":{"id":"/docs/deployment/self-hosted/overview-49","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"356":{"id":"/docs/deployment/self-hosted/overview-50","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"357":{"id":"/docs/deployment/self-hosted/overview-51","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"358":{"id":"/docs/deployment/self-hosted/overview-52","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources"},"359":{"id":"/docs/deployment/self-hosted/overview-53","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"360":{"id":"/docs/deployment/self-hosted/overview-54","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirement