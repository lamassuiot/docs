gs":[],"type":"text","url":"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"355":{"id":"/docs/deployment/self-hosted/overview-49","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"356":{"id":"/docs/deployment/self-hosted/overview-50","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"357":{"id":"/docs/deployment/self-hosted/overview-51","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"358":{"id":"/docs/deployment/self-hosted/overview-52","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources"},"359":{"id":"/docs/deployment/self-hosted/overview-53","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"360":{"id":"/docs/deployment/self-hosted/overview-54","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"a load-balancer implementation or another deliberate path from clients to the Gateway"},"361":{"id":"/docs/deployment/self-hosted/overview-55","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#platform-requirements","content":"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer."},"362":{"id":"/docs/deployment/self-hosted/overview-56","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />"},"363":{"id":"/docs/deployment/self-hosted/overview-57","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />"},"364":{"id":"/docs/deployment/self-hosted/overview-58","page_id":"/docs/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />"},"365":{"id":"/docs/deployment/troubleshooting","page_id":"/docs/deployment/troubleshooting","type":"page","content":"Deployment troubleshooting","breadcrumbs":["Docs","Deployment","Operations"],"tags":[],"url":"/docs/deployment/troubleshooting"},"366":{"id":"/docs/deployment/troubleshooting-0","page_id":"/docs/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/deployment/troubleshooting","content":"Diagnose access, service health and infrastructure dependencies."},"367":{"id":"/docs/deployment/troubleshooting-1","page_id":"/docs/deployment/troubleshooting","type":"heading"