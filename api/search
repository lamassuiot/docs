"},"2181":{"id":"/docs/platform/pki/quickstarts/issue-certificate-5","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","content":"Configure key and uses"},"2182":{"id":"/docs/platform/pki/quickstarts/issue-certificate-6","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","content":"Issue and download"},"2183":{"id":"/docs/platform/pki/quickstarts/issue-certificate-7","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","content":"Verify the result"},"2184":{"id":"/docs/platform/pki/quickstarts/issue-certificate-8","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","content":"Inspect content and dates"},"2185":{"id":"/docs/platform/pki/quickstarts/issue-certificate-9","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","content":"Verify the chain"},"2186":{"id":"/docs/platform/pki/quickstarts/issue-certificate-10","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","content":"Check that the key matches"},"2187":{"id":"/docs/platform/pki/quickstarts/issue-certificate-11","page_id":"/docs/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"If the result fails"},"2188":{"id":"/docs/platform/pki/quickstarts/issue-certificate-12","page_id":"/docs/platform/pki/quickstarts/issue-certificate"