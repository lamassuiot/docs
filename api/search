configuration-parameters","content":"`aws_config.session_token`"},"1272":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-80","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1273":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-81","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"No"},"1274":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-82","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Session token (with `auth_method=static`)."},"1275":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-83","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.role_arn`"},"1276":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-84","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1277":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-85","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Only with `auth_method=role`"},"1278":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-86","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"ARN of the role to assume."},"1279":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-87","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.endpoint_url`"},"1280":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-88","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1281":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-89","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"No"},"1282":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-90","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Alternative URL for all AWS services (useful with LocalStack in tests)."},"1283":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-91","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`subscriber_event_bus`"},"1284":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-92","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"object"},"1285":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-93","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1286":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-94","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS)."},"1287":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-95","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`dms_manager_client`"},"1288":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-96","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1289":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-97","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1290":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-98","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's DMS Manager service."},"1291":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-99","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`device_manager_client`"},"1292":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-100","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1293":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-101","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1294":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-102","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's Device Manager."},"1295":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-103","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`ca_client`"},"1296":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-104","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1297":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-105","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1298":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-106","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's CA service."},"1299":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-107","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","content":"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field."},"1300":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-108","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","content":"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API."},"1301":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-109","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","content":"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes."},"1302":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-110","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:"},"1303":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-111","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"It calls `iot:GetRegistrationCode` to obtain AWS's verification code."},"1304":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-112","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS."},"1305":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-113","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`."},"1306":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-114","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step."},"1307":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-115","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`."},"1308":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-116","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","content":"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously."},"1309":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-117","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","content":"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS."},"1310":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-118","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","content":"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy."},"1311":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-119","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","content":"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date."},"1312":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-120","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:"},"1313":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-121","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Creates or updates the IoT policies configured in the DMS."},"1314":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-122","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent."},"1315":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-123","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate."},"1316":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-124","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies."},"1317":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-125","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager."},"1318":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-126","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core."},"1319":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-127","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it."},"1320":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-128","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode."},"1321":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-129","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode."},"1322":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-130","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step."},"1323":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-131","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"The full flow from the device's perspective is:"},"1324":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-132","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN."},"1325":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-133","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection."},"1326":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-134","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection."},"1327":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-135","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"For the JITP flow to work correctly:"},"1328":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-136","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP)."},"1329":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-137","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account."},"1330":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-138","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core."},"1331":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-139","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section."},"1332":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-140","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:"},"1333":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-141","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in Lamassu"},"1334":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-142","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Revocation reason"},"1335":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-143","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in AWS IoT Core"},"1336":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-144","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`Active`"},"1337":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-145","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"None"},"1338":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-146","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`ACTIVE`"},"1339":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-147","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"1340":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-148","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`certificateHold`"},"1341":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-149","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`INACTIVE`"},"1342":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-150","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"1343":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-151","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Any other reason"},"1344":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-152","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`REVOKED`"},"1345":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-153","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`."},"1346":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-154","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment."},"1347":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-155","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`."},"1348":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-156","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key."},"1349":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-157","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","content":"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`."},"1350":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-158","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","content":"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow)."},"1351":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-159","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly."},"1352":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-160","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"There are two action types:"},"1353":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-161","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires."},"1354":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-162","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store."},"1355":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-163","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared."},"1356":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-164","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:"},"1357":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-165","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints."},"1358":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-166","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector)."},"1359":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-167","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The CA registration stays in `REQUESTED` indefinitely."},"1360":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-168","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`."},"1361":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-169","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata."},"1362":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-170","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** A certificate's status is not synced to AWS after a revocation."},"1363":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-171","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata."},"1364":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-172","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning."},"1365":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-173","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation."},"1366":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-174","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session."},"1367":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-175","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core."},"1368":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-176","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core."},"1369":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-177","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu."},"1370":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-178","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier."},"1371":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-179","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device's first MQTT connection in JITP mode fails or times out."},"1372":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-180","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection."},"1373":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-181","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies."},"1374":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-182","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The Device Shadow is not updated when it should be."},"1375":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-183","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one."},"1376":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-184","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions."},"1377":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-185","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1378":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-186","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />"},"1379":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-187","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />"},"1380":{"id":"/docs/platform/iot-fleets/overview","page_id":"/docs/platform/iot-fleets/overview","type":"page","content":"IoT Fleets","breadcrumbs":["Docs","Platform","IoT Fleets"],"tags":[],"url":"/docs/platform/iot-fleets/overview"},"1381":{"id":"/docs/platform/iot-fleets/overview-0","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview","content":"Organize devices and their identities, prepare enrollment and integrate consumers."},"1382":{"id":"/docs/platform/iot-fleets/overview-1","page_id":"/docs/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/overview#start-here","content":"Start here"},"1383":{"id":"/docs/platform/iot-fleets/overview-2","page_id":"/docs/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"Devices and identities"},"1384":{"id":"/docs/platform/iot-fleets/overview-3","page_id":"/docs/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"Enrollment with PKI"},"1385":{"id":"/docs/platform/iot-fleets/overview-4","page_id":"/docs/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/overview#integrations","content":"Integrations"},"1386":{"id":"/docs/platform/iot-fleets/overview-5","page_id":"/docs/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Who prepares each part"},"1387":{"id":"/docs/platform/iot-fleets/overview-6","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview","content":"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it."},"1388":{"id":"/docs/platform/iot-fleets/overview-7","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#start-here","content":"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks."},"1389":{"id":"/docs/platform/iot-fleets/overview-8","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#start-here","content":"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device."},"1390":{"id":"/docs/platform/iot-fleets/overview-9","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"Resource"},"1391":{"id":"/docs/platform/iot-fleets/overview-10","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"What it represents"},"1392":{"id":"/docs/platform/iot-fleets/overview-11","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"**Device**"},"1393":{"id":"/docs/platform/iot-fleets/overview-12","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"An inventory entry with an identifier, owning DMS and classification."},"1394":{"id":"/docs/platform/iot-fleets/overview-13","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"**Identity**"},"1395":{"id":"/docs/platform/iot-fleets/overview-14","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"The device's association with its certificates: an active version and a history."},"1396":{"id":"/docs/platform/iot-fleets/overview-15","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"**DMS**"},"1397":{"id":"/docs/platform/iot-fleets/overview-16","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"The service that configures admission, enrollment, renewal and trust distribution."},"1398":{"id":"/docs/platform/iot-fleets/overview-17","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"**Fleet**"},"1399":{"id":"/docs/platform/iot-fleets/overview-18","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"The population you operate, represented through devices, DMSs, tags and metadata."},"1400":{"id":"/docs/platform/iot-fleets/overview-19","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices."},"1401":{"id":"/docs/platform/iot-fleets/overview-20","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#devices-and-identities","content":"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity."},"1402":{"id":"/docs/platform/iot-fleets/overview-21","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"This section connects PKI rules to the device client. Preparation follows this order:"},"1403":{"id":"/docs/platform/iot-fleets/overview-22","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"**CA and profile:** prepare the issuer and certificate rules in PKI."},"1404":{"id":"/docs/platform/iot-fleets/overview-23","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed."},"1405":{"id":"/docs/platform/iot-fleets/overview-24","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"**Client:** prepare the initial credential, server trust, and key generation or custody."},"1406":{"id":"/docs/platform/iot-fleets/overview-25","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"**Result:** request the certificate, install it and check its association with the device."},"1407":{"id":"/docs/platform/iot-fleets/overview-26","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"**Continuity:** configure renewal, successor installation and recovery according to DMS policy."},"1408":{"id":"/docs/platform/iot-fleets/overview-27","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1409":{"id":"/docs/platform/iot-fleets/overview-28","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#enrollment-with-pki","content":"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1410":{"id":"/docs/platform/iot-fleets/overview-29","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#integrations","content":"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device."},"1411":{"id":"/docs/platform/iot-fleets/overview-30","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#integrations","content":"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization."},"1412":{"id":"/docs/platform/iot-fleets/overview-31","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Participant"},"1413":{"id":"/docs/platform/iot-fleets/overview-32","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Responsibility"},"1414":{"id":"/docs/platform/iot-fleets/overview-33","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"PKI administrator"},"1415":{"id":"/docs/platform/iot-fleets/overview-34","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"CA, issuance profile, chain and revocation publication."},"1416":{"id":"/docs/platform/iot-fleets/overview-35","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Provisioning administrator"},"1417":{"id":"/docs/platform/iot-fleets/overview-36","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"DMS, admission, authentication per operation and inventory."},"1418":{"id":"/docs/platform/iot-fleets/overview-37","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Device integrator"},"1419":{"id":"/docs/platform/iot-fleets/overview-38","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Initial credential, key, EST client, trust and certificate installation."},"1420":{"id":"/docs/platform/iot-fleets/overview-39","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Consumer integrator"},"1421":{"id":"/docs/platform/iot-fleets/overview-40","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Trusted issuers, validation and device permissions in the destination."},"1422":{"id":"/docs/platform/iot-fleets/overview-41","page_id":"/docs/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/platform/iot-fleets/overview#who-prepares-each-part","content":"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment."},"1423":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"page","content":"Enroll and connect your first device","breadcrumbs":["Docs","Platform","IoT Fleets","Getting started"],"tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device"},"1424":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-0","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device","content":"Obtain an identity through EST, verify its association and use it in an mTLS connection."},"1425":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-1","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"Before you begin"},"1426":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-2","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","content":"Prepare the bootstrap credential"},"1427":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-3","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Configure the evaluation DMS"},"1428":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-4","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","content":"Prepare the client and check cacerts"},"1429":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-5","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","content":"Enroll the device"},"1430":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-6","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","content":"Verify the obtained identity"},"1431":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-7","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"Demonstrate an mTLS connection"},"1432":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-8","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Result and continuity"},"1433":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-9","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device","content":"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs."},"1434":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-10","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates."},"1435":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-11","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access."},"1436":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-12","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`."},"1437":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-13","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first."},"1438":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-14","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment."},"1439":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-15","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","content":"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain."},"1440":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-16","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","content":"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population."},"1441":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-17","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles."},"1442":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-18","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Create the `Acme EST Evaluation` DMS with this configuration:"},"1443":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-19","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Setting"},"1444":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-20","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Evaluation value"},"1445":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-21","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Enrollment CA"},"1446":{"id":"/docs/platform/iot-fleets/quickstarts/enroll-device-22","page_id":"/docs/platform/iot-fleets/quickstarts/enroll-devi