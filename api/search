:[],"url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"Continue according to your goal"},"2253":{"id":"/docs/platform/pki/quickstarts/overview-5","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview","content":"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key."},"2254":{"id":"/docs/platform/pki/quickstarts/overview-6","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#before-you-begin","content":"A Lamassu instance accessible from your browser. To prepare one, see Deployment."},"2255":{"id":"/docs/platform/pki/quickstarts/overview-7","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#before-you-begin","content":"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked."},"2256":{"id":"/docs/platform/pki/quickstarts/overview-8","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2257":{"id":"/docs/platform/pki/quickstarts/overview-9","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2258":{"id":"/docs/platform/pki/quickstarts/overview-10","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2259":{"id":"/docs/platform/pki/quickstarts/overview-11","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />"},"2260":{"id":"/docs/platform/pki/quickstarts/overview-12","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />"},"2261":{"id":"/docs/platform/pki/quickstarts/overview-13","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#recommended-path","content":"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect."},"2262":{"id":"/docs/platform/pki/quickstarts/overview-14","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#recommended-path","content":"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy."},"2263":{"id":"/docs/platform/pki/quickstarts/overview-15","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"File or resource"},"2264":{"id":"/docs/platform/pki/quickstarts/overview-16","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#expected-result","content":"Check"},"2265":{"i