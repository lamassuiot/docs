ado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu."},"891":{"id":"/docs/manual/servicios-core/cas-72","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Abre una CA desde el inventario para consultar:"},"892":{"id":"/docs/manual/servicios-core/cas-73","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Estado y periodo de validez."},"893":{"id":"/docs/manual/servicios-core/cas-74","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Certificado y cadena en formato PEM."},"894":{"id":"/docs/manual/servicios-core/cas-75","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Número de certificados activos, expirados y revocados."},"895":{"id":"/docs/manual/servicios-core/cas-76","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Certificados emitidos en **Issued Certificates**."},"896":{"id":"/docs/manual/servicios-core/cas-77","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"CRL vinculada a la autoridad."},"897":{"id":"/docs/manual/servicios-core/cas-78","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Metadatos y motor criptográfico asociado."},"898":{"id":"/docs/manual/servicios-core/cas-79","page_id":"/docs/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","content":"Puede