","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`."},"1201":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-63","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.region`"},"1202":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-64","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1203":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-65","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1204":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-66","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"AWS region where the connector operates."},"1205":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-67","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.auth_method`"},"1206":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-68","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1207":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-69","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1208":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-70","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Authentication method: `static`, `role` or empty (SDK default credential chain)."},"1209":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-71","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.access_key_id`"},"1210":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-72","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"string"},"1211":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-73","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Only with `auth_method=static`"},"1212":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-74","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"AWS access key."},"1213":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-75","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.secret_access_key`"},"1214":{"id":"/docs/platform/iot-fleets/integrations/aws-iot-core-76","page_id":"/docs/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","u