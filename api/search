":{"id":"/docs/platform/pki/integrations/aws-iot-core-55","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Parámetro"},"957":{"id":"/docs/platform/pki/integrations/aws-iot-core-56","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Tipo"},"958":{"id":"/docs/platform/pki/integrations/aws-iot-core-57","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Requerido"},"959":{"id":"/docs/platform/pki/integrations/aws-iot-core-58","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Descripción"},"960":{"id":"/docs/platform/pki/integrations/aws-iot-core-59","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`connector_id`"},"961":{"id":"/docs/platform/pki/integrations/aws-iot-core-60","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"962":{"id":"/docs/platform/pki/integrations/aws-iot-core-61","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"963":{"id":"/docs/platform/pki/integrations/aws-iot-core-62","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`."},"964":{"id":"/docs/platform/pki/integrations/aws-iot-core-63","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`aws_config.region`"},"965":{"id":"/docs/platform/pki/integrations/aws-iot-core-64","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"966":{"id":"/docs/platform/pki/integrations/aws-iot-core-65","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"967":{"id":"/docs/platform/pki/integrations/aws-iot-core-66","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Región AWS donde opera el conector."},"968":{"id":"/docs/platform/pki/integrations/aws-iot-core-67","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`aws_config.auth_method`"},"969":{"id":"/docs/platform/pki/integrations/aws-iot-core-68","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"970":{"id":"/docs/platform/pki/integrations/aws-iot-core-69","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"971":{"id":"/docs/platform/pki/integrations/aws-iot-core-70","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"