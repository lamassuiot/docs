onnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials."},"1383":{"id":"/docs/platform/pki/integrations/aws-iot-core-55","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Parameter"},"1384":{"id":"/docs/platform/pki/integrations/aws-iot-core-56","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Type"},"1385":{"id":"/docs/platform/pki/integrations/aws-iot-core-57","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Required"},"1386":{"id":"/docs/platform/pki/integrations/aws-iot-core-58","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Description"},"1387":{"id":"/docs/platform/pki/integrations/aws-iot-core-59","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`connector_id`"},"1388":{"id":"/docs/platform/pki/integrations/aws-iot-core-60","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1389":{"id":"/docs/platform/pki/integrations/aws-iot-core-61","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1390":{"id":"/docs/platform/pki/integrations/aws-iot-core-62","page_id":"/docs/platform/pki/integrations/a