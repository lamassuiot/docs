cado final y `device.crt`"],[147,"Certificado PEM para TLS downstream"],[860,"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión."],[1027,"Certificado vencido, clave disponible"],[1025,"Certificado vigente, fuera de ventana"],[1642,"Certificado y cadena en formato PEM."],[1762,"Certificados"],[864,"Certificados de las CAs elegidas explícitamente."],[1644,"Certificados emitidos en **Issued Certificates**."],[1080,"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir."],[1831,"Certificados que entran en la ventana preventiva o crítica de renovación."],[152,"chart del repositorio"],[1796,"Ciclo de vida de un certificado"],[1543,"Cierra el solapamiento"],[652,"cifrar en tránsito y en reposo;"],[708,"Clasifica el dispositivo"],[2269,"Clave"],[1194,"Clave de acceso AWS."],[998,"Clave generada por el dispositivo"],[1031,"Clave perdida o inaccesible"],[2250,"Clave privada `device.key`"],[150,"Clave privada PEM para TLS downstream"],[932,"Clave privada PKCS#8 DER sin cifrar."],[1003,"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS."],[1198,"Clave secreta AWS."],[1467,"Clave y certificado"],[1000,"Clave ya disponible en el dispositivo"],[1936,"Claves y motores criptográficos"],[640,"claves y motores KMS;"],[1498,"Claves, autoridades, perfiles, certificados y publicación del estado de revocación."],[1416,"CN, perfil, serie y clave verificados."],[1068,"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto."],[620,"Cobertura"],[1046,"Códigos de error y diagnóstico"],[426,"comandos o consultas utilizados;"],[2113,"Cómo comprobar el resultado"],[310,"Cómo encaja el despliegue"],[440,"Cómo expresan acceso las políticas"],[581,"Cómo funciona"],[2060,"Cómo funciona el respondedor en Lamassu"],[684,"Cómo funciona Lamassu"],[436,"Cómo se relacionan ambos caminos"],[1126,"Cómo solicitar el registro"],[2280,"Compara CSR, perfil y certificado; emitir correctamente no demuestra