-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#distribución-de-confianza","content":"Autoridad configurada para emitir las identidades del DMS."},"1526":{"id":"/docs/manual/servicios-core/ra-28","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#distribución-de-confianza","content":"**Managed CAs**"},"1527":{"id":"/docs/manual/servicios-core/ra-29","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#distribución-de-confianza","content":"Autoridades adicionales que el dispositivo debe confiar."},"1528":{"id":"/docs/manual/servicios-core/ra-30","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","content":"Acción"},"1529":{"id":"/docs/manual/servicios-core/ra-31","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","content":"Resultado"},"1530":{"id":"/docs/manual/servicios-core/ra-32","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","content":"**Edit**"},"1531":{"id":"/docs/manual/servicios-core/ra-33","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","content":"Modifica la política del DMS."},"1532":{"id":"/docs/manual/servicios-core/ra-34","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","content":"**Go to DMS owned devices**"},"1533":{"id":"/docs/manual/servicios-core/ra-35","page_id":"/docs/manual/servicios-core/ra","tags":[],"type":"text","url":"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","content":"Abre únicamente los dispositivos de esa flota."},"1534":{"id":"/docs/manual/servicios-core/ra-36","page_id":"/docs/m