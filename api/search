"id":"/docs/platform/pki/integrations/aws-iot-core-70","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Authentication method: `static`, `role` or empty (SDK default credential chain)."},"1399":{"id":"/docs/platform/pki/integrations/aws-iot-core-71","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.access_key_id`"},"1400":{"id":"/docs/platform/pki/integrations/aws-iot-core-72","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1401":{"id":"/docs/platform/pki/integrations/aws-iot-core-73","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Only with `auth_method=static`"},"1402":{"id":"/docs/platform/pki/integrations/aws-iot-core-74","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"AWS access key."},"1403":{"id":"/docs/platform/pki/integrations/aws-iot-core-75","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.secret_access_key`"},"1404":{"id":"/docs/platform/pki/integrations/aws-iot-core-76","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1405":{"id":"/docs/platform/pki/integrations/aws-iot-core-77","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platfo