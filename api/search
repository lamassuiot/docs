eshooting-38","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","content":"Localiza el pod y Service de authz."},"1692":{"id":"/docs/platform/pki/troubleshooting-39","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","content":"Comprueba /health, logs y conexión a su base de datos."},"1693":{"id":"/docs/platform/pki/troubleshooting-40","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","content":"Verifica el DNS y puerto configurados en externalAuthorization."},"1694":{"id":"/docs/platform/pki/troubleshooting-41","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","content":"Comprueba que la ruta del check es /v1/ext\\_authz/check."},"1695":{"id":"/docs/platform/pki/troubleshooting-42","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","content":"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída."},"1696":{"id":"/docs/platform/pki/troubleshooting-43","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#un-pod-no-está-ready","content":"Revisa primero kubectl describe pod. Las causas habituales son:"},"1697":{"id":"/docs/platform/pki/troubleshooting-44","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#un-pod-no-está-ready","content":"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;"},"1698":{"id":"/docs/platform/pki/troubleshooting-45","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#un-pod-