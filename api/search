figura-el-dms-de-evaluación","content":"Perfil final de 1 hora que acabas de preparar."},"1394":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-25","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Protocol / Registration Mode"},"1395":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-26","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"`EST_RFC7030` / `JITP`."},"1396":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-27","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Verify CSR Signature"},"1397":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-28","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Habilitado."},"1398":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-29","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Enable Replaceable Enrollment"},"1399":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-30","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado; el ID debe ser nuevo."},"1400":{"id":"/docs/es/platform/iot-fleets/quickstarts/enroll-device-31","page_id":"/docs/es/platform/iot-fleets/quickstarts/enroll-