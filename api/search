latform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","content":"Review and create the CA"},"2163":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-6","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","content":"Verify the result"},"2164":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-7","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"Check the CA certificate"},"2165":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-8","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If the result fails"},"2166":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-9","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/platform/pki/quickstarts/create-certificate-authority#next-step","content":"Next step"},"2167":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-10","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority","content":"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path."},"2168":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-11","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"Console access and permission to create keys and authorities."},"2169":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-12","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"An available cryptographic engine that supports the chosen algorithm."},"2170":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-13","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"OpenSSL 3.x to check the downloaded certificate."},"2171":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-14","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation."},"2172":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-15","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","content":"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair."},"2173":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-16","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","content":"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide."},"2174":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-17","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","content":"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available."},"2175":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-18","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","content":"The CA private key is used through the engine. In this path, you will download only the authority's public certificate."},"2176":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-19","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"Select **Root CA** and complete:"},"2177":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-20","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"**CA Name**: `Acme Evaluation Root CA`."},"2178":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-21","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"**Subject**: organization and country details for your evaluation."},"2179":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-22","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"**CA Certificate Expiration**: for example, one year from creation."},"2180":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-23","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime."},"2181":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-24","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","content":"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs."},"2182":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-25","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","content":"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API."},"2183":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-26","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","content":"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**."},"2184":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-27","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","content":"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`."},"2185":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-28","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"Run from the directory where you saved `ca.pem`:"},"2186":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-29","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`."},"2187":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-30","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","content":"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options."},"2188":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-31","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If creation fails, check permissions, engine availability and the selected algorithm."},"2189":{"id":"/docs/platform/pki/quickstarts/create-certificate-authority-32","page_id":"/docs/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","