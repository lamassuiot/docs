os de plataforma de los que dependen."},"324":{"id":"/docs/es/deployment/self-hosted/overview-18","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"Área"},"325":{"id":"/docs/es/deployment/self-hosted/overview-19","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"El chart de Lamassu proporciona"},"326":{"id":"/docs/es/deployment/self-hosted/overview-20","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"Tú proporcionas"},"327":{"id":"/docs/es/deployment/self-hosted/overview-21","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"Aplicaciones Lamassu"},"328":{"id":"/docs/es/deployment/self-hosted/overview-22","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales"},"329":{"id":"/docs/es/deployment/self-hosted/overview-23","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes"},"330":{"id":"/docs/es/deployment/self-hosted/overview-24","page_id":"/docs/es/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","content":"Datos PostgreSQL"},"331":{"id":"/docs/es/deployment/self-h