i/quickstarts/overview-25","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2418":{"id":"/docs/platform/pki/quickstarts/overview-26","page_id":"/docs/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2419":{"id":"/docs/platform/pki/troubleshooting","page_id":"/docs/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/platform/pki/troubleshooting"},"2420":{"id":"/docs/platform/pki/troubleshooting-0","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2421":{"id":"/docs/platform/pki/troubleshooting-1","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2422":{"id":"/docs/platform/pki/troubleshooting-2","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2423":{"id":"/docs/platform/pki/troubleshooting-3","page_id":"/docs/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2424":{"id":"/docs/platform/pki/troubleshooting-4","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2425":{"id":"/docs/platform/pki/troubleshooting-5","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2426":{"id":"/docs/platform/pki/troubleshooting-6","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Check"},"2427":{"id":"/docs/platform/pki/troubleshooting-7","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"What to inspect"},"2428":{"id":"/docs/platform/pki/troubleshooting-8","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Next step"},"2429":{"id":"/docs/platform/pki/troubleshooting-9","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"CA"},"2430":{"id":"/docs/platform/pki/troubleshooting-10","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Exists, is active and has usable dates."},"2431":{"id":"/docs/platform/pki/troubleshooting-11","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Authorities."},"2432":{"id":"/docs/platform/pki/troubleshooting-12","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Key"},"2433":{"id":"/docs/platform/pki/troubleshooting-13","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"The record has a usable private key and the engine can sign."},"2434":{"id":"/docs/platform/pki/troubleshooting-14","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Try **Sign / Verify** in KMS; check provider permissions and availability."},"2435":{"id":"/docs/platform/pki/troubleshooting-15","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2436":{"id":"/docs/platform/pki/troubleshooting-16","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2437":{"id":"/docs/platform/pki/troubleshooting-17","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2438":{"id":"/docs/platform/pki/troubleshooting-18","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2439":{"id":"/docs/platform/pki/troubleshooting-19","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2440":{"id":"/docs/platform/pki/troubleshooting-20","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2441":{"id":"/docs/platform/pki/troubleshooting-21","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2442":{"id":"/docs/platform/pki/troubleshooting-22","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2443":{"id":"/docs/platform/pki/troubleshooting-23","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2444":{"id":"/docs/platform/pki/troubleshooting-24","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2445":{"id":"/docs/platform/pki/troubleshooting-25","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2446":{"id":"/docs/platform/pki/troubleshooting-26","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2447":{"id":"/docs/platform/pki/troubleshooting-27","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2448":{"id":"/docs/platform/pki/troubleshooting-28","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2449":{"id":"/docs/platform/pki/troubleshooting-29","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2450":{"id":"/docs/platform/pki/troubleshooting-30","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2451":{"id":"/docs/platform/pki/troubleshooting-31","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2452":{"id":"/docs/platform/pki/troubleshooting-32","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2453":{"id":"/docs/platform/pki/troubleshooting-33","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2454":{"id":"/docs/platform/pki/troubleshooting-34","page_id":"/docs/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."},"2455":{"id":"/docs/upgrades/3-8-0-to-4-0-0","page_id":"/docs/upgrades/3-8-0-to-4-0-0","type":"page","content":"3.8.0 to 4.0.0","breadcrumbs":["Docs","Upgrades"],"tags":[],"url":"/docs/upgrades/3-8-0-to-4-0-0"},"2456":{"id":"/docs/upgrades/3-8-0-to-4-0-0-0","page_id":"/docs/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/upgrades/3-8-0-to-4-0-0","content":"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result."},"2457":{"id":"/docs/upgrades/3-8-0-to-4-0-0-1","page_id":"/docs/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","content":"Architecture changes"},"2458":{"id":"/docs/upgrades/3-8-0-to-4-0-0-2","page_id":"/docs/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","content":"One PostgreSQL database with schemas"},"2459":{"id":"/docs/upgrades/3-8-0-to-4-0-0-3","page_id":"/docs/upgrades/3-8-0-to-4-0-0","type