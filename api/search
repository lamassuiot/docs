enrollment#error-codes-and-diagnostics","content":"`expired certificate`"},"1290":{"id":"/docs/platform/pki/est-enrollment-212","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The presented certificate has expired and the DMS does not allow `AllowExpired`/`EnableExpiredRenewal`."},"1291":{"id":"/docs/platform/pki/est-enrollment-213","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Renew before expiration or request `EnableExpiredRenewal` to be enabled."},"1292":{"id":"/docs/platform/pki/est-enrollment-214","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1293":{"id":"/docs/platform/pki/est-enrollment-215","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`forbiddenNewEnrollment`"},"1294":{"id":"/docs/platform/pki/est-enrollment-216","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The device is already enrolled and `EnableReplaceableEnrollment` is `false`."},"1295":{"id":"/docs/platform/pki/est-enrollment-217","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Use `/simplereenroll` or ask the administrator to enable the flag."},"1296":{"id":"/docs/platform/pki/est-enrollment-218","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1297":{"id":"/docs/platform/pki/est-enrollment-219","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`device not preregistered`"},"1298":{"id":"/docs/platform/pki/est-enrollment-220","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The DMS is in `PRE_REGISTRATION` and the device does not exist."},"1299":{"id":"/docs/platform/pki/est-enrollment-221","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Register the device before enrolling it."},"1300":{"id":"/docs/platform/pki/est-enrollment-222","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1301":{"id":"/docs/platform/pki/est-enrollment-223","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`invalid reenroll window`"},"1302":{"id":"/docs/platform/pki/est-enrollment-224","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Renewal attempted before `NotAfter - ReEnrollmentDelta`."},"1303":{"id":"/docs/platform/pki/est-enrollment-225","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Wait for the window to open or request a larger `ReEnrollmentDelta`."},"1304":{"id":"/docs/platform/pki/est-enrollment-226","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1305":{"id":"/docs/platform/pki/est-enrollment-227","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`invalid RawSubject bytes`"},"1306":{"id":"/docs/platform/pki/est-enrollment-228","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The renewal CSR's subject does not match the active certificate's."},"1307":{"id":"/docs/platform/pki/est-enrollment-229","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Regenerate the CSR with the exact subject of the previous cert."},"1308":{"id":"/docs/platform/pki/est-enrollment-230","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1309":{"id":"/docs/platform/pki/est-enrollment-231","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`external webhook denied enrollment`"},"1310":{"id":"/docs/platform/pki/est-enrollment-232","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"The webhook returned a non-`2xx` code or `authorized != true`."},"1311":{"id":"/docs/platform/pki/est-enrollment-233","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Review the webhook service logs."},"1312":{"id":"/docs/platform/pki/est-enrollment-234","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"500"},"1313":{"id":"/docs/platform/pki/est-enrollment-235","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`server key generation not enabled`"},"1314":{"id":"/docs/platform/pki/est-enrollment-236","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"`/serverkeygen` is disabled on the DMS."},"1315":{"id":"/docs/platform/pki/est-enrollment-237","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"Ask the administrator to enable `ServerKeyGen.Enabled`."},"1316":{"id":"/docs/platform/pki/est-enrollment-238","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","content":"For messages not listed in this table, the Lamassu server logs (with the fields `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) are the first place to look for the cause."},"1317":{"id":"/docs/platform/pki/est-enrollment-239","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"Lamassu's implementation follows RFC 7030 in its essentials but introduces several quirks that can affect strict EST clients or third-party libraries:"},"1318":{"id":"/docs/platform/pki/est-enrollment-240","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"The `/csrattrs` and `/fullcmc` endpoints of RFC 7030 are **not implemented** in Lamassu. A client invoking `/.well-known/est/<DMS_ID>/csrattrs` receives `404 Not Found` instead of the `204 No Content` the RFC suggests for \"no attributes\". Strict EST libraries must be configured not to attempt `csrattrs`."},"1319":{"id":"/docs/platform/pki/est-enrollment-241","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"The base64 of the `/cacerts` and `/simpleenroll` responses is wrapped in lines of **76 characters** terminated with CRLF (S/MIME compliant, RFC 5751). The parts of `/serverkeygen` apply no wrap."},"1320":{"id":"/docs/platform/pki/est-enrollment-242","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"The `multipart/mixed` boundary in `/serverkeygen` is fixed and cannot be negotiated."},"1321":{"id":"/docs/platform/pki/est-enrollment-243","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"The `{aps}` segment is **mandatory** in all EST routes. Routes registered without `{aps}` are in the code but respond `400`."},"1322":{"id":"/docs/platform/pki/est-enrollment-244","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"The body of `/cacerts`, `/simpleenroll` and `/simplereenroll` can be returned as concatenated PEM if the client sends `Accept: application/x-pem-file`. This is a Lamassu-specific extension and does not appear in the RFC."},"1323":{"id":"/docs/platform/pki/est-enrollment-245","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"The server does not explicitly reject CSRs signed with SHA-1 or MD5; the integrator must generate the CSR with SHA-256 or higher."},"1324":{"id":"/docs/platform/pki/est-enrollment-246","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />"},"1325":{"id":"/docs/platform/pki/est-enrollment-247","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"<Card title=\"OCSP validation\" href=\"/docs/platform/pki/ocsp\" />"},"1326":{"id":"/docs/platform/pki/est-enrollment-248","page_id":"/docs/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/platform/pki/est-enrollment#compatibility-notes","content":"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />"},"1327":{"id":"/docs/platform/pki/integrations/aws-iot-core","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"page","content":"AWS IoT Core","breadcrumbs":["Docs","Platform","Integrations"],"tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core"},"1328":{"id":"/docs/platform/pki/integrations/aws-iot-core-0","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core","content":"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven."},"1329":{"id":"/docs/platform/pki/integrations/aws-iot-core-1","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","content":"Connector architecture"},"1330":{"id":"/docs/platform/pki/integrations/aws-iot-core-2","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#prerequisites","content":"Prerequisites"},"1331":{"id":"/docs/platform/pki/integrations/aws-iot-core-3","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"Required IAM permissions"},"1332":{"id":"/docs/platform/pki/integrations/aws-iot-core-4","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Configuration parameters"},"1333":{"id":"/docs/platform/pki/integrations/aws-iot-core-5","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","content":"CA registration in AWS IoT Core"},"1334":{"id":"/docs/platform/pki/integrations/aws-iot-core-6","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#how-to-request-registration","content":"How to request registration"},"1335":{"id":"/docs/platform/pki/integrations/aws-iot-core-7","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"Primary Account"},"1336":{"id":"/docs/platform/pki/integrations/aws-iot-core-8","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","content":"Secondary Account (SNI-only)"},"1337":{"id":"/docs/platform/pki/integrations/aws-iot-core-9","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#dms-configuration","content":"DMS configuration"},"1338":{"id":"/docs/platform/pki/integrations/aws-iot-core-10","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#none-mode","content":"`none` mode"},"1339":{"id":"/docs/platform/pki/integrations/aws-iot-core-11","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"`auto` mode"},"1340":{"id":"/docs/platform/pki/integrations/aws-iot-core-12","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#jitp-mode","content":"`jitp` mode"},"1341":{"id":"/docs/platform/pki/integrations/aws-iot-core-13","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"Device provisioning (automatic mode)"},"1342":{"id":"/docs/platform/pki/integrations/aws-iot-core-14","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"Device provisioning (JITP mode)"},"1343":{"id":"/docs/platform/pki/integrations/aws-iot-core-15","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Certificate status synchronization"},"1344":{"id":"/docs/platform/pki/integrations/aws-iot-core-16","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"Forced disconnect on revocation"},"1345":{"id":"/docs/platform/pki/integrations/aws-iot-core-17","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","content":"Device Shadow and automation"},"1346":{"id":"/docs/platform/pki/integrations/aws-iot-core-18","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"What the connector writes to the shadow"},"1347":{"id":"/docs/platform/pki/integrations/aws-iot-core-19","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"AWS IoT policies"},"1348":{"id":"/docs/platform/pki/integrations/aws-iot-core-20","page_id":"/docs/platform/pki/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"Troubleshooting"},"1349":{"id":"/docs/platform/pki/integrations/aws-iot-core-21","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core","content":"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued."},"1350":{"id":"/docs/platform/pki/integrations/aws-iot-core-22","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core","content":"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode)."},"1351":{"id":"/docs/platform/pki/integrations/aws-iot-core-23","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core","content":"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode."},"1352":{"id":"/docs/platform/pki/integrations/aws-iot-core-24","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","content":"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP."},"1353":{"id":"/docs/platform/pki/integrations/aws-iot-core-25","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","content":"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load."},"1354":{"id":"/docs/platform/pki/integrations/aws-iot-core-26","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","content":"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow."},"1355":{"id":"/docs/platform/pki/integrations/aws-iot-core-27","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","content":"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions."},"1356":{"id":"/docs/platform/pki/integrations/aws-iot-core-28","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#prerequisites","content":"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation."},"1357":{"id":"/docs/platform/pki/integrations/aws-iot-core-29","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:"},"1358":{"id":"/docs/platform/pki/integrations/aws-iot-core-30","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"IAM action"},"1359":{"id":"/docs/platform/pki/integrations/aws-iot-core-31","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"Purpose"},"1360":{"id":"/docs/platform/pki/integrations/aws-iot-core-32","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"`iot:GetRegistrationCode`"},"1361":{"id":"/docs/platform/pki/integrations/aws-iot-core-33","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"Obtain the verification code for CA registration in the Primary Account"},"1362":{"id":"/docs/platform/pki/integrations/aws-iot-core-34","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"`iot:RegisterCACertificate`"},"1363":{"id":"/docs/platform/pki/integrations/aws-iot-core-35","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"Register the CA in AWS IoT"},"1364":{"id":"/docs/platform/pki/integrations/aws-iot-core-36","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"`iot:DescribeCACertificate`"},"1365":{"id":"/docs/platform/pki/integrations/aws-iot-core-37","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"Check the CA registration status"},"1366":{"id":"/docs/platform/pki/integrations/aws-iot-core-38","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"`iot:CreateThing` / `iot:UpdateThing`"},"1367":{"id":"/docs/platform/pki/integrations/aws-iot-core-39","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","content":"Create or update Things in IoT Core"},"1368":{"id":"/docs