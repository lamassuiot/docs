[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Only with `auth_method=role`"},"1414":{"id":"/docs/platform/pki/integrations/aws-iot-core-86","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"ARN of the role to assume."},"1415":{"id":"/docs/platform/pki/integrations/aws-iot-core-87","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`aws_config.endpoint_url`"},"1416":{"id":"/docs/platform/pki/integrations/aws-iot-core-88","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1417":{"id":"/docs/platform/pki/integrations/aws-iot-core-89","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"No"},"1418":{"id":"/docs/platform/pki/integrations/aws-iot-core-90","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Alternative URL for all AWS services (useful with LocalStack in tests)."},"1419":{"id":"/docs/platform/pki/integrations/aws-iot-core-91","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`subscriber_event_bus`"},"1420":{"id":"/docs/platform/pki/integrations/aws-iot-core-92","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"object"},"1421":{"id":"/docs/platform/pki/integrations/aws-iot-core-93","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1422":{"id":"/docs/platform/pki/integrations/aws-iot-core-94","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS)."},"1423":{"id":"/docs/platform/pki/integrations/aws-iot-core-95","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`dms_manager_client`"},"1424":{"id":"/docs/platform/pki/integrations/aws-iot-core-96","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1425":{"id":"/docs/platform/pki/integrations/aws-iot-core-97","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1426":{"id":"/docs/platform/pki/integrations/aws-iot-core-98","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's DMS Manager service."},"1427":{"id":"/docs/platform/pki/integrations/aws-iot-core-99","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`device_manager_client`"},"1428":{"id":"/docs/platform/pki/integrations/aws-iot-core-100","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1429":{"id":"/docs/platform/pki/integrations/aws-iot-core-101","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1430":{"id":"/docs/platform/pki/integrations/aws-iot-core-102","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's Device Manager."},"1431":{"id":"/docs/platform/pki/integrations/aws-iot-core-103","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"`ca_client`"},"1432":{"id":"/docs/platform/pki/integrations/aws-iot-core-104","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"string"},"1433":{"id":"/docs/platform/pki/integrations/aws-iot-core-105","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"Yes"},"1434":{"id":"/docs/platform/pki/integrations/aws-iot-core-106","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","content":"HTTP URL of Lamassu's CA service."},"1435":{"id":"/docs/platform/pki/integrations/aws-iot-core-107","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","content":"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field."},"1436":{"id":"/docs/platform/pki/integrations/aws-iot-core-108","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#how-to-request-registration","content":"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API."},"1437":{"id":"/docs/platform/pki/integrations/aws-iot-core-109","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#how-to-request-registration","content":"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes."},"1438":{"id":"/docs/platform/pki/integrations/aws-iot-core-110","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:"},"1439":{"id":"/docs/platform/pki/integrations/aws-iot-core-111","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"It calls `iot:GetRegistrationCode` to obtain AWS's verification code."},"1440":{"id":"/docs/platform/pki/integrations/aws-iot-core-112","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS."},"1441":{"id":"/docs/platform/pki/integrations/aws-iot-core-113","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`."},"1442":{"id":"/docs/platform/pki/integrations/aws-iot-core-114","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step."},"1443":{"id":"/docs/platform/pki/integrations/aws-iot-core-115","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#primary-account","content":"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`."},"1444":{"id":"/docs/platform/pki/integrations/aws-iot-core-116","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","content":"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously."},"1445":{"id":"/docs/platform/pki/integrations/aws-iot-core-117","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#dms-configuration","content":"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS."},"1446":{"id":"/docs/platform/pki/integrations/aws-iot-core-118","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#dms-configuration","content":"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy."},"1447":{"id":"/docs/platform/pki/integrations/aws-iot-core-119","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#none-mode","content":"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date."},"1448":{"id":"/docs/platform/pki/integrations/aws-iot-core-120","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:"},"1449":{"id":"/docs/platform/pki/integrations/aws-iot-core-121","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"Creates or updates the IoT policies configured in the DMS."},"1450":{"id":"/docs/platform/pki/integrations/aws-iot-core-122","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent."},"1451":{"id":"/docs/platform/pki/integrations/aws-iot-core-123","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate."},"1452":{"id":"/docs/platform/pki/integrations/aws-iot-core-124","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies."},"1453":{"id":"/docs/platform/pki/integrations/aws-iot-core-125","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager."},"1454":{"id":"/docs/platform/pki/integrations/aws-iot-core-126","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#auto-mode","content":"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core."},"1455":{"id":"/docs/platform/pki/integrations/aws-iot-core-127","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#jitp-mode","content":"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it."},"1456":{"id":"/docs/platform/pki/integrations/aws-iot-core-128","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#jitp-mode","content":"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode."},"1457":{"id":"/docs/platform/pki/integrations/aws-iot-core-129","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#jitp-mode","content":"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode."},"1458":{"id":"/docs/platform/pki/integrations/aws-iot-core-130","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step."},"1459":{"id":"/docs/platform/pki/integrations/aws-iot-core-131","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"The full flow from the device's perspective is:"},"1460":{"id":"/docs/platform/pki/integrations/aws-iot-core-132","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN."},"1461":{"id":"/docs/platform/pki/integrations/aws-iot-core-133","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection."},"1462":{"id":"/docs/platform/pki/integrations/aws-iot-core-134","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection."},"1463":{"id":"/docs/platform/pki/integrations/aws-iot-core-135","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"For the JITP flow to work correctly:"},"1464":{"id":"/docs/platform/pki/integrations/aws-iot-core-136","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP)."},"1465":{"id":"/docs/platform/pki/integrations/aws-iot-core-137","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account."},"1466":{"id":"/docs/platform/pki/integrations/aws-iot-core-138","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core."},"1467":{"id":"/docs/platform/pki/integrations/aws-iot-core-139","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section."},"1468":{"id":"/docs/platform/pki/integrations/aws-iot-core-140","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:"},"1469":{"id":"/docs/platform/pki/integrations/aws-iot-core-141","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in Lamassu"},"1470":{"id":"/docs/platform/pki/integrations/aws-iot-core-142","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Revocation reason"},"1471":{"id":"/docs/platform/pki/integrations/aws-iot-core-143","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in AWS IoT Core"},"1472":{"id":"/docs/platform/pki/integrations/aws-iot-core-144","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`Active`"},"1473":{"id":"/docs/platform/pki/integrations/aws-iot-core-145","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"None"},"1474":{"id":"/docs/platform/pki/integrations/aws-iot-core-146","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`ACTIVE`"},"1475":{"id":"/docs/platform/pki/integrations/aws-iot-core-147","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"1476":{"id":"/docs/platform/pki/integrations/aws-iot-core-148","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`certificateHold`"},"1477":{"id":"/docs/platform/pki/integrations/aws-iot-core-149","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`INACTIVE`"},"1478":{"id":"/docs/platform/pki/integrations/aws-iot-core-150","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"1479":{"id":"/docs/platform/pki/integrations/aws-iot-core-151","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Any other reason"},"1480":{"id":"/docs/platform/pki/integrations/aws-iot-core-152","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"`REVOKED`"},"1481":{"id":"/docs/platform/pki/integrations/aws-iot-core-153","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","content":"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`."},"1482":{"id":"/docs/platform/pki/integrations/aws-iot-core-154","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment."},"1483":{"id":"/docs/platform/pki/integrations/aws-iot-core-155","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`."},"1484":{"id":"/docs/platform/pki/integrations/aws-iot-core-156","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key."},"1485":{"id":"/docs/platform/pki/integrations/aws-iot-core-157","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","content":"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`."},"1486":{"id":"/docs/platform/pki/integrations/aws-iot-core-158","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","content":"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow)."},"1487":{"id":"/docs/platform/pki/integrations/aws-iot-core-159","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly."},"1488":{"id":"/docs/platform/pki/integrations/aws-iot-core-160","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"There are two action types:"},"1489":{"id":"/docs/platform/pki/integrations/aws-iot-core-161","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires."},"1490":{"id":"/docs/platform/pki/integrations/aws-iot-core-162","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store."},"1491":{"id":"/docs/platform/pki/integrations/aws-iot-core-163","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared."},"1492":{"id":"/docs/platform/pki/integrations/aws-iot-core-164","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:"},"1493":{"id":"/docs/platform/pki/integrations/aws-iot-core-165","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints."},"1494":{"id":"/docs/platform/pki/integrations/aws-iot-core-166","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#aws-iot-policies","content":"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector)."},"1495":{"id":"/docs/platform/pki/integrations/aws-iot-core-167","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The CA registration stays in `REQUESTED` indefinitely."},"1496":{"id":"/docs/platform/pki/integrations/aws-iot-core-168","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`."},"1497":{"id":"/docs/platform/pki/integrations/aws-iot-core-169","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata."},"1498":{"id":"/docs/platform/pki/integrations/aws-iot-core-170","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** A certificate's status is not synced to AWS after a revocation."},"1499":{"id":"/docs/platform/pki/integrations/aws-iot-core-171","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata."},"1500":{"id":"/docs/platform/pki/integrations/aws-iot-core-172","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning."},"1501":{"id":"/docs/platform/pki/integrations/aws-iot-core-173","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation."},"1502":{"id":"/docs/platform/pki/integrations/aws-iot-core-174","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session."},"1503":{"id":"/docs/platform/pki/integrations/aws-iot-core-175","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core."},"1504":{"id":"/docs/platform/pki/integrations/aws-iot-core-176","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core."},"1505":{"id":"/docs/platform/pki/integrations/aws-iot-core-177","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu."},"1506":{"id":"/docs/platform/pki/integrations/aws-iot-core-178","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier."},"1507":{"id":"/docs/platform/pki/integrations/aws-iot-core-179","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device's first MQTT connection in JITP mode fails or times out."},"1508":{"id":"/docs/platform/pki/integrations/aws-iot-core-180","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection."},"1509":{"id":"/docs/platform/pki/integrations/aws-iot-core-181","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies."},"1510":{"id":"/docs/platform/pki/integrations/aws-iot-core-182","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The Device Shadow is not updated when it should be."},"1511":{"id":"/docs/platform/pki/integrations/aws-iot-core-183","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one."},"1512":{"id":"/docs/platform/pki/integrations/aws-iot-core-184","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions."},"1513":{"id":"/docs/platform/pki/integrations/aws-iot-core-185","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />"},"1514":{"id":"/docs/platform/pki/integrations/aws-iot-core-186","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />"},"1515":{"id":"/docs/platform/pki/integrations/aws-iot-core-187","page_id":"/docs/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />"},"1516":{"id":"/docs/platform/pki/key-management","page_id":"/docs/platform/pki/key-management","type":"page","content":"Keys and cryptographic engines","breadcrumbs":["Docs","Platform","Operate Lamassu"],"tags":[],"url":"/docs/platform/pki/key-management"},"1517":{"id":"/docs/platform/pki/key-management-0","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management","content":"Generate, import and operate keys without coupling the PKI to a specific provider."},"1518":{"id":"/docs/platform/pki/key-management-1","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#cryptographic-key-management","content":"Cryptographic key management"},"1519":{"id":"/docs/platform/pki/key-management-2","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"What the KMS solves"},"1520":{"id":"/docs/platform/pki/key-management-3","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#cryptographic-engines","content":"Cryptographic engines"},"1521":{"id":"/docs/platform/pki/key-management-4","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#file-system","content":"File System"},"1522":{"id":"/docs/platform/pki/key-management-5","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"1523":{"id":"/docs/platform/pki/key-management-6","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"1524":{"id":"/docs/platform/pki/key-management-7","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#aws-kms","content":"AWS KMS"},"1525":{"id":"/docs/platform/pki/key-management-8","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#pkcs11","content":"PKCS#11"},"1526":{"id":"/docs/platform/pki/key-management-9","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#key-inventory","content":"Key inventory"},"1527":{"id":"/docs/platform/pki/key-management-10","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#create-or-import-keys","content":"Create or import keys"},"1528":{"id":"/docs/platform/pki/key-management-11","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"Generate a new key pair"},"1529":{"id":"/docs/platform/pki/key-management-12","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"Import an existing pair"},"1530":{"id":"/docs/platform/pki/key-management-13","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#operations-on-a-key","content":"Operations on a key"},"1531":{"id":"/docs/platform/pki/key-management-14","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#view-details","content":"View details"},"1532":{"id":"/docs/platform/pki/key-management-15","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#sign-and-verify","content":"Sign and verify"},"1533":{"id":"/docs/platform/pki/key-management-16","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#sign","content":"Sign"},"1534":{"id":"/docs/platform/pki/key-management-17","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#verify","content":"Verify"},"1535":{"id":"/docs/platform/pki/key-management-18","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#generate-a-csr","content":"Generate a CSR"},"1536":{"id":"/docs/platform/pki/key-management-19","page_id":"/docs/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/platform/pki/key-management#sign-locally-with-pkcs11","content":"Sign locally with PKCS#11"},"1537":{"id":"/docs/platform/pki/key-management-20","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-key-management","content":"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI."},"1538":{"id":"/docs/platform/pki/key-management-21","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-key-management","content":"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system."},"1539":{"id":"/docs/platform/pki/key-management-22","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider."},"1540":{"id":"/docs/platform/pki/key-management-23","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"In practice, it lets you:"},"1541":{"id":"/docs/platform/pki/key-management-24","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Generate new key pairs from Lamassu IoT."},"1542":{"id":"/docs/platform/pki/key-management-25","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Import keys created externally."},"1543":{"id":"/docs/platform/pki/key-management-26","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Delegate custody and cryptographic operations to external engines."},"1544":{"id":"/docs/platform/pki/key-management-27","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#what-the-kms-solves","content":"Reuse existing keys for CAs, CSRs and signing or verification tasks."},"1545":{"id":"/docs/platform/pki/key-management-28","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-engines","content":"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform."},"1546":{"id":"/docs/platform/pki/key-management-29","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-engines","content":"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements."},"1547":{"id":"/docs/platform/pki/key-management-30","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#cryptographic-engines","content":"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material."},"1548":{"id":"/docs/platform/pki/key-management-31","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#file-system","content":"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production."},"1549":{"id":"/docs/platform/pki/key-management-32","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#hashicorp-vault","content":"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys."},"1550":{"id":"/docs/platform/pki/key-management-33","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#aws-secrets-manager","content":"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM."},"1551":{"id":"/docs/platform/pki/key-management-34","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#aws-kms","content":"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical."},"1552":{"id":"/docs/platform/pki/key-management-35","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#pkcs11","content":"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody."},"1553":{"id":"/docs/platform/pki/key-management-36","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#pkcs11","content":"Lamassu shows the full list of enabled engines in the console."},"1554":{"id":"/docs/platform/pki/key-management-37","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#pkcs11","content":"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate."},"1555":{"id":"/docs/platform/pki/key-management-38","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#pkcs11","content":"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA."},"1556":{"id":"/docs/platform/pki/key-management-39","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to."},"1557":{"id":"/docs/platform/pki/key-management-40","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"The table includes the following fields:"},"1558":{"id":"/docs/platform/pki/key-management-41","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Name**: descriptive name of the key."},"1559":{"id":"/docs/platform/pki/key-management-42","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Type**: algorithm and key size, for example RSA 2048 or EC P-256."},"1560":{"id":"/docs/platform/pki/key-management-43","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Strength**: visual indicator of cryptographic strength."},"1561":{"id":"/docs/platform/pki/key-management-44","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Public/Private**: whether Lamassu manages the full pair or only the public key."},"1562":{"id":"/docs/platform/pki/key-management-45","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Crypto Engine**: cryptographic engine keeping the key."},"1563":{"id":"/docs/platform/pki/key-management-46","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Aliases**: alternative names associated with the key."},"1564":{"id":"/docs/platform/pki/key-management-47","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Tags**: labels for classification and search."},"1565":{"id":"/docs/platform/pki/key-management-48","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Related Entities**: certificates or other entities linked to that key."},"1566":{"id":"/docs/platform/pki/key-management-49","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"From this view you also reach the most common actions:"},"1567":{"id":"/docs/platform/pki/key-management-50","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**View Details** to inspect metadata, identifiers and relationships."},"1568":{"id":"/docs/platform/pki/key-management-51","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Generate CSR** to create a PKCS#10 request with the selected key."},"1569":{"id":"/docs/platform/pki/key-management-52","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Sign / Verify** to test cryptographic operations on the key."},"1570":{"id":"/docs/platform/pki/key-management-53","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#key-inventory","content":"**Delete Key** to remove the key from the system."},"1571":{"id":"/docs/platform/pki/key-management-54","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#create-or-import-keys","content":"Keys are registered from the wizard opened with **Create New Key**."},"1572":{"id":"/docs/platform/pki/key-management-55","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines."},"1573":{"id":"/docs/platform/pki/key-management-56","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:"},"1574":{"id":"/docs/platform/pki/key-management-57","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Name**: unique and descriptive name."},"1575":{"id":"/docs/platform/pki/key-management-58","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Crypto Engine**: engine that will keep the key."},"1576":{"id":"/docs/platform/pki/key-management-59","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Type** and **Key Size**: algorithm and size or curve."},"1577":{"id":"/docs/platform/pki/key-management-60","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Tags**: metadata to classify the key."},"1578":{"id":"/docs/platform/pki/key-management-61","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#generate-a-new-key-pair","content":"**Metadata**: additional information for advanced uses."},"1579":{"id":"/docs/platform/pki/key-management-62","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production."},"1580":{"id":"/docs/platform/pki/key-management-63","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"When the key was generated in an isolated environment or an external HSM."},"1581":{"id":"/docs/platform/pki/key-management-64","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"When an existing PKI needs to be migrated without reissuing certificates."},"1582":{"id":"/docs/platform/pki/key-management-65","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"When Lamassu must operate with a root of trust created by a third party."},"1583":{"id":"/docs/platform/pki/key-management-66","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:"},"1584":{"id":"/docs/platform/pki/key-management-67","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Key Name**: descriptive name within Lamassu IoT."},"1585":{"id":"/docs/platform/pki/key-management-68","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Crypto Engine**: engine that will keep the imported key."},"1586":{"id":"/docs/platform/pki/key-management-69","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Tags**: labels for organization and search."},"1587":{"id":"/docs/platform/pki/key-management-70","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Metadata**: additional optional information."},"1588":{"id":"/docs/platform/pki/key-management-71","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"**Private Key (PEM)**: private key in PEM format."},"1589":{"id":"/docs/platform/pki/key-management-72","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#import-an-existing-pair","content":"Once the wizard is complete, the key is stored in the selected engine and can be used for signing, CSR generation and the rest of the operations supported by the KMS."},"1590":{"id":"/docs/platform/pki/key-management-73","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#operations-on-a-key","content":"Each registered key has a detail view and several operational actions."},"1591":{"id":"/docs/platform/pki/key-management-74","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"The **View Details** screen concentrates the technical and administrative information of the key."},"1592":{"id":"/docs/platform/pki/key-management-75","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"The **Overview** tab shows, among others, these fields:"},"1593":{"id":"/docs/platform/pki/key-management-76","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Key Name**: descriptive name."},"1594":{"id":"/docs/platform/pki/key-management-77","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats."},"1595":{"id":"/docs/platform/pki/key-management-78","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pki/key-management#view-details","content":"**Tags**: associated labels."},"1596":{"id":"/docs/platform/pki/key-management-79","page_id":"/docs/platform/pki/key-management","tags":[],"type":"text","url":"/docs/platform/pk