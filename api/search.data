_31685":42485,"_31687":42488,"_31689":42491,"_31691":42494,"_31693":42497,"_31695":42500,"_31697":42503,"_31699":42506,"_31701":42509,"_31703":42512,"_31705":42515,"_31707":42518,"_31709":42521,"_31711":42524,"_31713":42527,"_31715":42530,"_31717":42533,"_31719":42536,"_31721":42539,"_31723":42542,"_31725":42545,"_31727":42548,"_31729":42551,"_31731":42554,"_31733":42557,"_31735":42560,"_31737":42563,"_31739":42566,"_31741":42569,"_31743":42572,"_31745":42575,"_31747":42578,"_31749":42581,"_31751":42584,"_31753":42587,"_31755":42590,"_31757":42593,"_31759":42596,"_31761":42599,"_31763":42602,"_31765":42605,"_31767":42608,"_31769":42611,"_31771":42615,"_31773":42619,"_31775":42623,"_31777":42626,"_31779":42629,"_31781":42632,"_31783":42635},{"_4557":11,"_25012":11,"_5":25251,"_1768":37102,"_25264":37103,"_21207":37107,"_9967":11},"Despliega desde AWS Marketplace",[37104,37105,37106],"Docs","Despliegue","Otros modelos",[],{"_4557":12,"_25012":11,"_21207":37109,"_5":25256,"_9967":11,"_1768":37110},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_4557":13,"_25012":11,"_5":25261,"_21207":37112,"_9967":37113,"_1768":37114},[],"/docs/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_4557":14,"_25012":11,"_5":25261,"_21207":37116,"_9967":37117,"_1768":37118},[],"/docs/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_4557":15,"_25012":11,"_5":25261,"_21207":37120,"_9967":37121,"_1768":37122},[],"/docs/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_4557":16,"_25012":11,"_5":25261,"_21207":37124,"_9967":37125,"_1768":37126},[],"/docs/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_4557":17,"_25012":11,"_5":25261,"_21207":37128,"_9967":37129,"_1768":37130},[],"/docs/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_4557":18,"_25012":11,"_5":25261,"_21207":37132,"_9967":37133,"_1768":37134},[],"/docs/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_4557":19,"_25012":11,"_5":25261,"_21207":37136,"_9967":37137,"_1768":37138},[],"/docs/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_4557":20,"_25012":11,"_21207":37140,"_5":25256,"_9967":11,"_1768":37141},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_4557":21,"_25012":11,"_21207":37143,"_5":25256,"_9967":37113,"_1768":37144},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_4557":22,"_25012":11,"_21207":37146,"_5":25256,"_9967":37113,"_1768":37147},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_4557":23,"_25012":11,"_21207":37149,"_5":25256,"_9967":37113,"_1768":37150},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_4557":24,"_25012":11,"_21207":37152,"_5":25256,"_9967":37117,"_1768":37153},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_4557":25,"_25012":11,"_21207":37155,"_5":25256,"_9967":37117,"_1768":37156},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_4557":26,"_25012":11,"_21207":37158,"_5":25256,"_9967":37117,"_1768":37159},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_4557":27,"_25012":11,"_21207":37161,"_5":25256,"_9967":37121,"_1768":37162},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_4557":28,"_25012":11,"_21207":37164,"_5":25256,"_9967":37125,"_1768":37165},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_4557":29,"_25012":11,"_21207":37167,"_5":25256,"_9967":37129,"_1768":37168},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_4557":30,"_25012":11,"_21207":37170,"_5":25256,"_9967":37133,"_1768":37171},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_4557":31,"_25012":11,"_21207":37173,"_5":25256,"_9967":37137,"_1768":37174},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_4557":32,"_25012":32,"_5":25251,"_1768":37176,"_25264":37177,"_21207":37178,"_9967":32},"Despliega Lamassu",[37104,37105],[],{"_4557":33,"_25012":32,"_21207":37180,"_5":25256,"_9967":32,"_1768":37181},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_4557":34,"_25012":32,"_5":25261,"_21207":37183,"_9967":37184,"_1768":37185},[],"/docs/deployment/overview#elige-un-modelo","Elige un modelo",{"_4557":35,"_25012":32,"_5":25261,"_21207":37187,"_9967":37188,"_1768":37189},[],"/docs/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_4557":36,"_25012":32,"_5":25261,"_21207":37191,"_9967":37192,"_1768":37193},[],"/docs/deployment/overview#después-del-despliegue","Después del despliegue",{"_4557":37,"_25012":32,"_21207":37195,"_5":25256,"_9967":32,"_1768":37196},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_4557":38,"_25012":32,"_21207":37198,"_5":25256,"_9967":37184,"_1768":37199},[],"Modelo",{"_4557":39,"_25012":32,"_21207":37201,"_5":25256,"_9967":37184,"_1768":37202},[],"Recomendado para",{"_4557":40,"_25012":32,"_21207":37204,"_5":25256,"_9967":37184,"_1768":37205},[],"Quién opera la infraestructura",{"_4557":41,"_25012":32,"_21207":37207,"_5":25256,"_9967":37184,"_1768":37208},[],"Punto de partida",{"_4557":42,"_25012":32,"_21207":37210,"_5":25256,"_9967":37184,"_1768":37211},[],"Kubernetes self-managed",{"_4557":43,"_25012":32,"_21207":37213,"_5":25256,"_9967":37184,"_1768":37214},[],"Producción, entornos regulados y despliegues personalizados",{"_4557":44,"_25012":32,"_21207":37216,"_5":25256,"_9967":37184,"_1768":37217},[],"Tu equipo",{"_4557":45,"_25012":32,"_21207":37219,"_5":25256,"_9967":37184,"_1768":37220},[],"Helm o Fastlane",{"_4557":46,"_25012":32,"_21207":37222,"_5":25256,"_9967":37184,"_1768":37223},[],"AWS Marketplace",{"_4557":47,"_25012":32,"_21207":37225,"_5":25256,"_9967":37184,"_1768":37226},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_4557":48,"_25012":32,"_21207":37228,"_5":25256,"_9967":37184,"_1768":37217},[],{"_4557":49,"_25012":32,"_21207":37230,"_5":25256,"_9967":37184,"_1768":37231},[],"Imagen preconfigurada en EC2",{"_4557":50,"_25012":32,"_21207":37233,"_5":25256,"_9967":37184,"_1768":37234},[],"SaaS",{"_4557":51,"_25012":32,"_21207":37236,"_5":25256,"_9967":37184,"_1768":37237},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_4557":52,"_25012":32,"_21207":37239,"_5":25256,"_9967":37184,"_1768":37240},[],"Lamassu",{"_4557":53,"_25012":32,"_21207":37242,"_5":25256,"_9967":37184,"_1768":37243},[],"Suscripción gestionada",{"_4557":54,"_25012":32,"_21207":37245,"_5":25256,"_9967":37184,"_1768":37246},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4557":55,"_25012":32,"_21207":37248,"_5":25256,"_9967":37184,"_1768":37249},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4557":56,"_25012":32,"_21207":37251,"_5":25256,"_9967":37184,"_1768":37252},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_4557":57,"_25012":32,"_21207":37254,"_5":25256,"_9967":37188,"_1768":37255},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_4557":58,"_25012":32,"_21207":37257,"_5":25256,"_9967":37192,"_1768":37258},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_4557":59,"_25012":59,"_5":25251,"_1768":37260,"_25264":37261,"_21207":37262,"_9967":59},"Utiliza Lamassu como SaaS",[37104,37105,37106],[],{"_4557":60,"_25012":59,"_21207":37264,"_5":25256,"_9967":59,"_1768":37265},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_4557":61,"_25012":59,"_5":25261,"_21207":37267,"_9967":37268,"_1768":37269},[],"/docs/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_4557":62,"_25012":59,"_5":25261,"_21207":37271,"_9967":37272,"_1768":37273},[],"/docs/deployment/saas#planes","Planes",{"_4557":63,"_25012":59,"_5":25261,"_21207":37275,"_9967":37276,"_1768":37277},[],"/docs/deployment/saas#solicita-acceso","Solicita acceso",{"_4557":64,"_25012":59,"_21207":37279,"_5":25256,"_9967":59,"_1768":37280},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_4557":65,"_25012":59,"_21207":37282,"_5":25256,"_9967":37268,"_1768":37283},[],"Disponibilidad y mantenimiento de la plataforma.",{"_4557":66,"_25012":59,"_21207":37285,"_5":25256,"_9967":37268,"_1768":37286},[],"Copias de seguridad automáticas.",{"_4557":67,"_25012":59,"_21207":37288,"_5":25256,"_9967":37268,"_1768":37289},[],"Actualizaciones de versión.",{"_4557":68,"_25012":59,"_21207":37291,"_5":25256,"_9967":37268,"_1768":37292},[],"Soporte técnico y SLA según el plan contratado.",{"_4557":69,"_25012":59,"_21207":37294,"_5":25256,"_9967":37272,"_1768":37295},[],"Plan",{"_4557":70,"_25012":59,"_21207":37297,"_5":25256,"_9967":37272,"_1768":37298},[],"Dispositivos",{"_4557":71,"_25012":59,"_21207":37300,"_5":25256,"_9967":37272,"_1768":37301},[],"Soporte",{"_4557":72,"_25012":59,"_21207":37303,"_5":25256,"_9967":37272,"_1768":37304},[],"SLA",{"_4557":73,"_25012":59,"_21207":37306,"_5":25256,"_9967":37272,"_1768":37307},[],"Starter",{"_4557":74,"_25012":59,"_21207":37309,"_5":25256,"_9967":37272,"_1768":37310},[],"Hasta 1.000",{"_4557":75,"_25012":59,"_21207":37312,"_5":25256,"_9967":37272,"_1768":37313},[],"Email",{"_4557":76,"_25012":59,"_21207":37315,"_5":25256,"_9967":37272,"_1768":37316},[],"99,5 %",{"_4557":77,"_25012":59,"_21207":37318,"_5":25256,"_9967":37272,"_1768":37319},[],"Professional",{"_4557":78,"_25012":59,"_21207":37321,"_5":25256,"_9967":37272,"_1768":37322},[],"Hasta 10.000",{"_4557":79,"_25012":59,"_21207":37324,"_5":25256,"_9967":37272,"_1768":37325},[],"Email y chat",{"_4557":80,"_25012":59,"_21207":37327,"_5":25256,"_9967":37272,"_1768":37328},[],"99,9 %",{"_4557":81,"_25012":59,"_21207":37330,"_5":25256,"_9967":37272,"_1768":37331},[],"Enterprise",{"_4557":82,"_25012":59,"_21207":37333,"_5":25256,"_9967":37272,"_1768":37334},[],"Ilimitados",{"_4557":83,"_25012":59,"_21207":37336,"_5":25256,"_9967":37272,"_1768":37337},[],"Dedicado",{"_4557":84,"_25012":59,"_21207":37339,"_5":25256,"_9967":37272,"_1768":37340},[],"99,99 %",{"_4557":85,"_25012":59,"_21207":37342,"_5":25256,"_9967":37276,"_1768":37343},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_4557":86,"_25012":59,"_21207":37345,"_5":25256,"_9967":37276,"_1768":37346},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_4557":87,"_25012":87,"_5":25251,"_1768":37348,"_25264":37349,"_21207":37350,"_9967":87},"Fastlane",[37104,37105,37211],[],{"_4557":88,"_25012":87,"_21207":37352,"_5":25256,"_9967":87,"_1768":37353},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_4557":89,"_25012":87,"_5":25261,"_21207":37355,"_9967":37356,"_1768":37357},[],"/docs/deployment/self-hosted/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_4557":90,"_25012":87,"_5":25261,"_21207":37359,"_9967":37360,"_1768":37361},[],"/docs/deployment/self-hosted/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_4557":91,"_25012":87,"_5":25261,"_21207":37363,"_9967":37364,"_1768":37365},[],"/docs/deployment/self-hosted/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_4557":92,"_25012":87,"_5":25261,"_21207":37367,"_9967":37368,"_1768":37369},[],"/docs/deployment/self-hosted/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_4557":93,"_25012":87,"_5":25261,"_21207":37371,"_9967":37372,"_1768":37373},[],"/docs/deployment/self-hosted/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_4557":94,"_25012":87,"_5":25261,"_21207":37375,"_9967":37376,"_1768":37377},[],"/docs/deployment/self-hosted/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_4557":95,"_25012":87,"_5":25261,"_21207":37379,"_9967":37380,"_1768":37381},[],"/docs/deployment/self-hosted/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_4557":96,"_25012":87,"_5":25261,"_21207":37383,"_9967":37384,"_1768":37385},[],"/docs/deployment/self-hosted/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_4557":97,"_25012":87,"_5":25261,"_21207":37387,"_9967":37388,"_1768":37389},[],"/docs/deployment/self-hosted/fastlane#modo-online-vs-offline","Modo online vs offline",{"_4557":98,"_25012":87,"_5":25261,"_21207":37391,"_9967":37392,"_1768":37393},[],"/docs/deployment/self-hosted/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_4557":99,"_25012":87,"_5":25261,"_21207":37395,"_9967":37396,"_1768":37397},[],"/docs/deployment/self-hosted/fastlane#modo-offline","Modo offline",{"_4557":100,"_25012":87,"_5":25261,"_21207":37399,"_9967":37400,"_1768":37401},[],"/docs/deployment/self-hosted/fastlane#instalación-de-componentes","Instalación de componentes",{"_4557":101,"_25012":87,"_5":25261,"_21207":37403,"_9967":37404,"_1768":37405},[],"/docs/deployment/self-hosted/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_4557":102,"_25012":87,"_5":25261,"_21207":37407,"_9967":37408,"_1768":37409},[],"/docs/deployment/self-hosted/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_4557":103,"_25012":87,"_5":25261,"_21207":37411,"_9967":37412,"_1768":37413},[],"/docs/deployment/self-hosted/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_4557":104,"_25012":87,"_5":25261,"_21207":37415,"_9967":37416,"_1768":37417},[],"/docs/deployment/self-hosted/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_4557":105,"_25012":87,"_5":25261,"_21207":37419,"_9967":37420,"_1768":37421},[],"/docs/deployment/self-hosted/fastlane#configuración-tls","Configuración TLS",{"_4557":106,"_25012":87,"_5":25261,"_21207":37423,"_9967":37424,"_1768":37425},[],"/docs/deployment/self-hosted/fastlane#certificado-externo","Certificado externo",{"_4557":107,"_25012":87,"_5":25261,"_21207":37427,"_9967":37428,"_1768":37429},[],"/docs/deployment/self-hosted/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_4557":108,"_25012":87,"_5":25261,"_21207":37431,"_9967":37432,"_1768":37433},[],"/docs/deployment/self-hosted/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_4557":109,"_25012":87,"_5":25261,"_21207":37435,"_9967":37436,"_1768":37437},[],"/docs/deployment/self-hosted/fastlane#uso-en-ci","Uso en CI",{"_4557":110,"_25012":87,"_5":25261,"_21207":37439,"_9967":37440,"_1768":37441},[],"/docs/deployment/self-hosted/fastlane#ejemplo-rápido","Ejemplo rápido",{"_4557":111,"_25012":87,"_5":25261,"_21207":37443,"_9967":37444,"_1768":37445},[],"/docs/deployment/self-hosted/fastlane#resumen","Resumen",{"_4557":112,"_25012":87,"_21207":37447,"_5":25256,"_9967":37356,"_1768":37448},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_4557":113,"_25012":87,"_21207":37450,"_5":25256,"_9967":37356,"_1768":37451},[],"La instalación incluye:",{"_4557":114,"_25012":87,"_21207":37453,"_5":25256,"_9967":37356,"_1768":37454},[],"PostgreSQL",{"_4557":115,"_25012":87,"_21207":37456,"_5":25256,"_9967":37356,"_1768":37457},[],"Keycloak",{"_4557":116,"_25012":87,"_21207":37459,"_5":25256,"_9967":37356,"_1768":37460},[],"RabbitMQ",{"_4557":117,"_25012":87,"_21207":37462,"_5":25256,"_9967":37356,"_1768":37463},[],"Chart Helm de Lamassu",{"_4557":118,"_25012":87,"_21207":37465,"_5":25256,"_9967":37360,"_1768":37466},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_4557":119,"_25012":87,"_21207":37468,"_5":25256,"_9967":37360,"_1768":37469},[],"Flag",{"_4557":120,"_25012":87,"_21207":37471,"_5":25256,"_9967":37360,"_1768":37472},[],"Valor por defecto",{"_4557":121,"_25012":87,"_21207":37474,"_5":25256,"_9967":37360,"_1768":37475},[],"Descripción",{"_4557":122,"_25012":87,"_21207":37477,"_5":25256,"_9967":37360,"_1768":37478},[],"`-h`, `--help`",{"_4557":123,"_25012":87,"_21207":37480,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":124,"_25012":87,"_21207":37482,"_5":25256,"_9967":37360,"_1768":37483},[],"Muestra la ayuda y finaliza",{"_4557":125,"_25012":87,"_21207":37485,"_5":25256,"_9967":37360,"_1768":37486},[],"`-n`, `--non-interactive`",{"_4557":126,"_25012":87,"_21207":37488,"_5":25256,"_9967":37360,"_1768":37489},[],"`false`",{"_4557":127,"_25012":87,"_21207":37491,"_5":25256,"_9967":37360,"_1768":37492},[],"Omite prompts y genera/usa credenciales por defecto",{"_4557":128,"_25012":87,"_21207":37494,"_5":25256,"_9967":37360,"_1768":37495},[],"`-ns`, `--namespace`",{"_4557":129,"_25012":87,"_21207":37497,"_5":25256,"_9967":37360,"_1768":37498},[],"`lamassu-dev`",{"_4557":130,"_25012":87,"_21207":37500,"_5":25256,"_9967":37360,"_1768":37501},[],"Namespace Kubernetes donde se despliegan los recursos",{"_4557":131,"_25012":87,"_21207":37503,"_5":25256,"_9967":37360,"_1768":37504},[],"`-d`, `--domain`",{"_4557":132,"_25012":87,"_21207":37506,"_5":25256,"_9967":37360,"_1768":37507},[],"`dev.lamassu.io`",{"_4557":133,"_25012":87,"_21207":37509,"_5":25256,"_9967":37360,"_1768":37510},[],"Dominio usado para endpoint y certificados TLS",{"_4557":134,"_25012":87,"_21207":37512,"_5":25256,"_9967":37360,"_1768":37513},[],"`-v`, `--version`",{"_4557":135,"_25012":87,"_21207":37515,"_5":25256,"_9967":37360,"_1768":37516},[],"`latest`",{"_4557":136,"_25012":87,"_21207":37518,"_5":25256,"_9967":37360,"_1768":37519},[],"Versión del chart Helm de Lamassu",{"_4557":137,"_25012":87,"_21207":37521,"_5":25256,"_9967":37360,"_1768":37522},[],"`--https-port`",{"_4557":138,"_25012":87,"_21207":37524,"_5":25256,"_9967":37360,"_1768":37525},[],"`443`",{"_4557":139,"_25012":87,"_21207":37527,"_5":25256,"_9967":37360,"_1768":37528},[],"Puerto HTTPS del gateway",{"_4557":140,"_25012":87,"_21207":37530,"_5":25256,"_9967":37360,"_1768":37531},[],"`--http-port`",{"_4557":141,"_25012":87,"_21207":37533,"_5":25256,"_9967":37360,"_1768":37534},[],"`80`",{"_4557":142,"_25012":87,"_21207":37536,"_5":25256,"_9967":37360,"_1768":37537},[],"Puerto HTTP del gateway",{"_4557":143,"_25012":87,"_21207":37539,"_5":25256,"_9967":37360,"_1768":37540},[],"`--offline`",{"_4557":144,"_25012":87,"_21207":37542,"_5":25256,"_9967":37360,"_1768":37489},[],{"_4557":145,"_25012":87,"_21207":37544,"_5":25256,"_9967":37360,"_1768":37545},[],"Activa modo offline",{"_4557":146,"_25012":87,"_21207":37547,"_5":25256,"_9967":37360,"_1768":37548},[],"`--tls-crt`",{"_4557":147,"_25012":87,"_21207":37550,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":148,"_25012":87,"_21207":37552,"_5":25256,"_9967":37360,"_1768":37553},[],"Ruta al certificado TLS (PEM)",{"_4557":149,"_25012":87,"_21207":37555,"_5":25256,"_9967":37360,"_1768":37556},[],"`--tls-key`",{"_4557":150,"_25012":87,"_21207":37558,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":151,"_25012":87,"_21207":37560,"_5":25256,"_9967":37360,"_1768":37561},[],"Ruta a la clave privada TLS (PEM)",{"_4557":152,"_25012":87,"_21207":37563,"_5":25256,"_9967":37360,"_1768":37564},[],"`--helm-chart-lamassu`",{"_4557":153,"_25012":87,"_21207":37566,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":154,"_25012":87,"_21207":37568,"_5":25256,"_9967":37360,"_1768":37569},[],"Ruta a chart local Lamassu (`.tgz`)",{"_4557":155,"_25012":87,"_21207":37571,"_5":25256,"_9967":37360,"_1768":37572},[],"`--helm-chart-postgres`",{"_4557":156,"_25012":87,"_21207":37574,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":157,"_25012":87,"_21207":37576,"_5":25256,"_9967":37360,"_1768":37577},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_4557":158,"_25012":87,"_21207":37579,"_5":25256,"_9967":37360,"_1768":37580},[],"`--helm-chart-keycloak`",{"_4557":159,"_25012":87,"_21207":37582,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":160,"_25012":87,"_21207":37584,"_5":25256,"_9967":37360,"_1768":37585},[],"Ruta a chart local Keycloak (`.tgz`)",{"_4557":161,"_25012":87,"_21207":37587,"_5":25256,"_9967":37360,"_1768":37588},[],"`--helm-chart-rabbitmq`",{"_4557":162,"_25012":87,"_21207":37590,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":163,"_25012":87,"_21207":37592,"_5":25256,"_9967":37360,"_1768":37593},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_4557":164,"_25012":87,"_21207":37595,"_5":25256,"_9967":37360,"_1768":37596},[],"`-l`, `--local-chart-path`",{"_4557":165,"_25012":87,"_21207":37598,"_5":25256,"_9967":37360,"_1768":3551},[],{"_4557":166,"_25012":87,"_21207":37600,"_5":25256,"_9967":37360,"_1768":37601},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_4557":167,"_25012":87,"_21207":37603,"_5":25256,"_9967":37364,"_1768":37604},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_4557":168,"_25012":87,"_21207":37606,"_5":25256,"_9967":37364,"_1768":37607},[],"`microk8s`",{"_4557":169,"_25012":87,"_21207":37609,"_5":25256,"_9967":37364,"_1768":37610},[],"`k3s`",{"_4557":170,"_25012":87,"_21207":37612,"_5":25256,"_9967":37364,"_1768":37613},[],"`kind`",{"_4557":171,"_25012":87,"_21207":37615,"_5":25256,"_9967":37364,"_1768":37616},[],"Kubernetes estándar",{"_4557":172,"_25012":87,"_21207":37618,"_5":25256,"_9967":37364,"_1768":37619},[],"Comportamientos específicos:",{"_4557":173,"_25012":87,"_21207":37621,"_5":25256,"_9967":37364,"_1768":37622},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_4557":174,"_25012":87,"_21207":37624,"_5":25256,"_9967":37364,"_1768":37625},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_4557":175,"_25012":87,"_21207":37627,"_5":25256,"_9967":37368,"_1768":37628},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_4557":176,"_25012":87,"_21207":37630,"_5":25256,"_9967":37368,"_1768":37631},[],"Requisitos generales:",{"_4557":177,"_25012":87,"_21207":37633,"_5":25256,"_9967":37368,"_1768":37634},[],"`yq`",{"_4557":178,"_25012":87,"_21207":37636,"_5":25256,"_9967":37368,"_1768":37637},[],"CLI de la distribución detectada",{"_4557":179,"_25012":87,"_21207":37639,"_5":25256,"_9967":37368,"_1768":37640},[],"Los requisitos específicos dependen de la distribución: `k3s` necesita `kubectl` y `helm`, mientras que `microk8s` utiliza `microk8s kubectl` y `microk8s helm`.",{"_4557":180,"_25012":87,"_21207":37642,"_5":25256,"_9967":37372,"_1768":37643},[],"Se valida que estén habilitados:",{"_4557":181,"_25012":87,"_21207":37645,"_5":25256,"_9967":37372,"_1768":37646},[],"`helm`",{"_4557":182,"_25012":87,"_21207":37648,"_5":25256,"_9967":37372,"_1768":37649},[],"`hostpath-storage`",{"_4557":183,"_25012":87,"_21207":37651,"_5":25256,"_9967":37372,"_1768":37652},[],"`dns`",{"_4557":184,"_25012":87,"_21207":37654,"_5":25256,"_9967":37372,"_1768":37655},[],"`cert-manager`",{"_4557":185,"_25012":87,"_21207":37657,"_5":25256,"_9967":37372,"_1768":37658},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_4557":186,"_25012":87,"_21207":37660,"_5":25256,"_9967":37380,"_1768":37661},[],"La función `request_config_data` solicita:",{"_4557":187,"_25012":87,"_21207":37663,"_5":25256,"_9967":37380,"_1768":37664},[],"Dominio Lamassu",{"_4557":188,"_25012":87,"_21207":37666,"_5":25256,"_9967":37380,"_1768":37667},[],"Usuario y contraseña admin PostgreSQL",{"_4557":189,"_25012":87,"_21207":37669,"_5":25256,"_9967":37380,"_1768":37670},[],"Usuario y contraseña admin RabbitMQ",{"_4557":190,"_25012":87,"_21207":37672,"_5":25256,"_9967":37380,"_1768":37673},[],"Usuario y contraseña admin Keycloak",{"_4557":191,"_25012":87,"_21207":37675,"_5":25256,"_9967":37380,"_1768":37676},[],"Namespace Kubernetes",{"_4557":192,"_25012":87,"_21207":37678,"_5":25256,"_9967":37384,"_1768":37679},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_4557":193,"_25012":87,"_21207":37681,"_5":25256,"_9967":37384,"_1768":37682},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_4557":194,"_25012":87,"_21207":37684,"_5":25256,"_9967":37388,"_1768":37685},[],"El script admite dos estrategias para obtener charts Helm.",{"_4557":195,"_25012":87,"_21207":37687,"_5":25256,"_9967":37392,"_1768":37688},[],"Los charts se descargan desde repositorios remotos.",{"_4557":196,"_25012":87,"_21207":37690,"_5":25256,"_9967":37396,"_1768":37691},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_4557":197,"_25012":87,"_21207":37693,"_5":25256,"_9967":37396,"_1768":37564},[],{"_4557":198,"_25012":87,"_21207":37695,"_5":25256,"_9967":37396,"_1768":37572},[],{"_4557":199,"_25012":87,"_21207":37697,"_5":25256,"_9967":37396,"_1768":37580},[],{"_4557":200,"_25012":87,"_21207":37699,"_5":25256,"_9967":37396,"_1768":37588},[],{"_4557":201,"_25012":87,"_21207":37701,"_5":25256,"_9967":37396,"_1768":37702},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_4557":202,"_25012":87,"_21207":37704,"_5":25256,"_9967":37396,"_1768":37705},[],"En este modo se fuerza:",{"_4557":203,"_25012":87,"_21207":37707,"_5":25256,"_9967":37404,"_1768":37708},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_4557":204,"_25012":87,"_21207":37710,"_5":25256,"_9967":37404,"_1768":37711},[],"Versión del chart: `0.19.0`",{"_4557":205,"_25012":87,"_21207":37713,"_5":25256,"_9967":37404,"_1768":37714},[],"Release: `postgres`",{"_4557":206,"_25012":87,"_21207":37716,"_5":25256,"_9967":37404,"_1768":37717},[],"`fullnameOverride: \"postgresql\"`",{"_4557":207,"_25012":87,"_21207":37719,"_5":25256,"_9967":37404,"_1768":37720},[],"El script SQL de inicialización crea una base de datos por servicio: `auth` para Keycloak, `alerts` para Alerts, `ca` para CA, `va` para VA, `cloudproxy` para Cloud Proxy, `devicemanager` para Device Manager, `dmsmanager` para DMS Manager y `kms` para KMS.",{"_4557":208,"_25012":87,"_21207":37722,"_5":25256,"_9967":37408,"_1768":37723},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_4557":209,"_25012":87,"_21207":37725,"_5":25256,"_9967":37408,"_1768":37726},[],"Versión del chart: `0.20.0`",{"_4557":210,"_25012":87,"_21207":37728,"_5":25256,"_9967":37408,"_1768":37729},[],"Release: `auth`",{"_4557":211,"_25012":87,"_21207":37731,"_5":25256,"_9967":37408,"_1768":37732},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_4557":212,"_25012":87,"_21207":37734,"_5":25256,"_9967":37408,"_1768":37735},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_4557":213,"_25012":87,"_21207":37737,"_5":25256,"_9967":37408,"_1768":37738},[],"`httpRelativePath: /auth/`",{"_4557":214,"_25012":87,"_21207":37740,"_5":25256,"_9967":37408,"_1768":37741},[],"`proxyHeaders: xforwarded`",{"_4557":215,"_25012":87,"_21207":37743,"_5":25256,"_9967":37408,"_1768":37744},[],"Configuración automática del realm `lamassu`:",{"_4557":216,"_25012":87,"_21207":37746,"_5":25256,"_9967":37408,"_1768":37747},[],"Rol: `pki-admin`",{"_4557":217,"_25012":87,"_21207":37749,"_5":25256,"_9967":37408,"_1768":37750},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_4557":218,"_25012":87,"_21207":37752,"_5":25256,"_9967":37408,"_1768":37753},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_4557":219,"_25012":87,"_21207":37755,"_5":25256,"_9967":37408,"_1768":37756},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_4557":220,"_25012":87,"_21207":37758,"_5":25256,"_9967":37408,"_1768":37759},[],"`github.com/lamassuiot/keycloak-theme`",{"_4557":221,"_25012":87,"_21207":37761,"_5":25256,"_9967":37412,"_1768":37762},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_4557":222,"_25012":87,"_21207":37764,"_5":25256,"_9967":37412,"_1768":37726},[],{"_4557":223,"_25012":87,"_21207":37766,"_5":25256,"_9967":37412,"_1768":37767},[],"Release: `rabbitmq`",{"_4557":224,"_25012":87,"_21207":37769,"_5":25256,"_9967":37412,"_1768":37770},[],"`fullnameOverride: \"rabbitmq\"`",{"_4557":225,"_25012":87,"_21207":37772,"_5":25256,"_9967":37412,"_1768":37773},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_4557":226,"_25012":87,"_21207":37775,"_5":25256,"_9967":37416,"_1768":37776},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_4557":227,"_25012":87,"_21207":37778,"_5":25256,"_9967":37416,"_1768":37779},[],"Configuraciones principales:",{"_4557":228,"_25012":87,"_21207":37781,"_5":25256,"_9967":37416,"_1768":37782},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_4557":229,"_25012":87,"_21207":37784,"_5":25256,"_9967":37416,"_1768":37785},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_4557":230,"_25012":87,"_21207":37787,"_5":25256,"_9967":37416,"_1768":37788},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_4557":231,"_25012":87,"_21207":37790,"_5":25256,"_9967":37416,"_1768":37791},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_4557":232,"_25012":87,"_21207":37793,"_5":25256,"_9967":37416,"_1768":37794},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_4557":233,"_25012":87,"_21207":37796,"_5":25256,"_9967":37416,"_1768":37797},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_4557":234,"_25012":87,"_21207":37799,"_5":25256,"_9967":37416,"_1768":37800},[],"Dominios CA: valor de `--domain`",{"_4557":235,"_25012":87,"_21207":37802,"_5":25256,"_9967":37416,"_1768":37803},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_4557":236,"_25012":87,"_21207":37805,"_5":25256,"_9967":37416,"_1768":37806},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_4557":237,"_25012":87,"_21207":37808,"_5":25256,"_9967":37416,"_1768":37809},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_4557":238,"_25012":87,"_21207":37811,"_5":25256,"_9967":37424,"_1768":37812},[],"Si se proporcionan:",{"_4557":239,"_25012":87,"_21207":37814,"_5":25256,"_9967":37424,"_1768":37548},[],{"_4557":240,"_25012":87,"_21207":37816,"_5":25256,"_9967":37424,"_1768":37556},[],{"_4557":241,"_25012":87,"_21207":37818,"_5":25256,"_9967":37424,"_1768":37819},[],"Se crea un secret Kubernetes:",{"_4557":242,"_25012":87,"_21207":37821,"_5":25256,"_9967":37424,"_1768":37822},[],"`downstream-provided-crt`",{"_4557":243,"_25012":87,"_21207":37824,"_5":25256,"_9967":37424,"_1768":37825},[],"Y se configura:",{"_4557":244,"_25012":87,"_21207":37827,"_5":25256,"_9967":37428,"_1768":37828},[],"Si no se proporciona certificado:",{"_4557":245,"_25012":87,"_21207":37830,"_5":25256,"_9967":37428,"_1768":37831},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_4557":246,"_25012":87,"_21207":37833,"_5":25256,"_9967":37428,"_1768":37834},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_4557":247,"_25012":87,"_21207":37836,"_5":25256,"_9967":37432,"_1768":37837},[],"En caso de éxito, se muestra:",{"_4557":248,"_25012":87,"_21207":37839,"_5":25256,"_9967":37432,"_1768":37840},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_4557":249,"_25012":87,"_21207":37842,"_5":25256,"_9967":37432,"_1768":37843},[],"Credenciales iniciales: `lamassu / lamassu`",{"_4557":250,"_25012":87,"_21207":37845,"_5":25256,"_9967":37432,"_1768":37846},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_4557":251,"_25012":87,"_21207":37848,"_5":25256,"_9967":37432,"_1768":37849},[],"Credenciales admin de Keycloak",{"_4557":252,"_25012":87,"_21207":37851,"_5":25256,"_9967":37432,"_1768":37852},[],"El usuario `lamassu` se crea con:",{"_4557":253,"_25012":87,"_21207":37854,"_5":25256,"_9967":37432,"_1768":37855},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_4557":254,"_25012":87,"_21207":37857,"_5":25256,"_9967":37432,"_1768":37858},[],"Fastlane también provisiona un principal de autorización `oidc:lamassu` que coincide con el claim `preferred_username=lamassu` y le concede la política `SUPER ADMIN`. Si activas los datos de ejemplo, crea además un principal independiente para la cuenta de servicio correspondiente.",{"_4557":255,"_25012":87,"_21207":37860,"_5":25256,"_9967":37432,"_1768":37861},[],"Este bootstrap está pensado para laboratorio, demos y CI. En producción, sustituye el principal por un rol o grupo administrado en tu proveedor OIDC y sigue Control de acceso.",{"_4557":256,"_25012":87,"_21207":37863,"_5":25256,"_9967":37436,"_1768":37864},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_4557":257,"_25012":87,"_21207":37866,"_5":25256,"_9967":37436,"_1768":37867},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_4557":258,"_25012":87,"_21207":37869,"_5":25256,"_9967":37436,"_1768":37870},[],"Ejemplo:",{"_4557":259,"_25012":87,"_21207":37872,"_5":25256,"_9967":37436,"_1768":37873},[],"En este escenario:",{"_4557":260,"_25012":87,"_21207":37875,"_5":25256,"_9967":37436,"_1768":37876},[],"`-n`: modo no interactivo",{"_4557":261,"_25012":87,"_21207":37878,"_5":25256,"_9967":37436,"_1768":37879},[],"`-ns`: namespace específico",{"_4557":262,"_25012":87,"_21207":37881,"_5":25256,"_9967":37436,"_1768":37882},[],"`-d`: dominio de CI",{"_4557":263,"_25012":87,"_21207":37884,"_5":25256,"_9967":37436,"_1768":37885},[],"`-l`: chart local",{"_4557":264,"_25012":87,"_21207":37887,"_5":25256,"_9967":37444,"_1768":37888},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_4557":265,"_25012":87,"_21207":37890,"_5":25256,"_9967":37444,"_1768":37891},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_4557":266,"_25012":266,"_5":25251,"_1768":37211,"_25264":37893,"_21207":37894,"_9967":266},[37104,37105,37211],[],{"_4557":267,"_25012":266,"_21207":37896,"_5":25256,"_9967":266,"_1768":37897},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_4557":268,"_25012":266,"_5":25261,"_21207":37899,"_9967":37900,"_1768":37901},[],"/docs/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_4557":269,"_25012":266,"_5":25261,"_21207":37903,"_9967":37904,"_1768":37905},[],"/docs/deployment/self-hosted/overview#quickstart","Quickstart",{"_4557":270,"_25012":266,"_5":25261,"_21207":37907,"_9967":37908,"_1768":37909},[],"/docs/deployment/self-hosted/overview#qué-se-despliega","Qué se despliega",{"_4557":271,"_25012":266,"_5":25261,"_21207":37911,"_9967":37912,"_1768":37913},[],"/docs/deployment/self-hosted/overview#requisitos-previos","Requisitos previos",{"_4557":272,"_25012":266,"_5":25261,"_21207":37915,"_9967":37916,"_1768":37917},[],"/docs/deployment/self-hosted/overview#opciones-de-despliegue","Opciones de despliegue",{"_4557":273,"_25012":266,"_5":25261,"_21207":37919,"_9967":37920,"_1768":37921},[],"/docs/deployment/self-hosted/overview#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_4557":274,"_25012":266,"_5":25261,"_21207":37923,"_9967":37924,"_1768":37925},[],"/docs/deployment/self-hosted/overview#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_4557":275,"_25012":266,"_5":25261,"_21207":37927,"_9967":37928,"_1768":37929},[],"/docs/deployment/self-hosted/overview#arquitectura","Arquitectura",{"_4557":276,"_25012":266,"_5":25261,"_21207":37931,"_9967":37932,"_1768":37933},[],"/docs/deployment/self-hosted/overview#instalación-manual-con-helm","Instalación manual con Helm",{"_4557":277,"_25012":266,"_5":25261,"_21207":37935,"_9967":37936,"_1768":37937},[],"/docs/deployment/self-hosted/overview#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_4557":278,"_25012":266,"_5":25261,"_21207":37939,"_9967":37940,"_1768":37941},[],"/docs/deployment/self-hosted/overview#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_4557":279,"_25012":266,"_5":25261,"_21207":37943,"_9967":37944,"_1768":37945},[],"/docs/deployment/self-hosted/overview#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_4557":280,"_25012":266,"_5":25261,"_21207":37947,"_9967":37948,"_1768":37949},[],"/docs/deployment/self-hosted/overview#verificación-del-despliegue","Verificación del despliegue",{"_4557":281,"_25012":266,"_5":25261,"_21207":37951,"_9967":37952,"_1768":37953},[],"/docs/deployment/self-hosted/overview#repositorio-helm","Repositorio Helm",{"_4557":282,"_25012":266,"_5":25261,"_21207":37955,"_9967":37956,"_1768":37957},[],"/docs/deployment/self-hosted/overview#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_4557":283,"_25012":266,"_5":25261,"_21207":37959,"_9967":37960,"_1768":37961},[],"/docs/deployment/self-hosted/overview#versionado-y-migraciones","Versionado y migraciones",{"_4557":284,"_25012":266,"_21207":37963,"_5":25256,"_9967":37900,"_1768":37964},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_4557":285,"_25012":266,"_21207":37966,"_5":25256,"_9967":37900,"_1768":37967},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_4557":286,"_25012":266,"_21207":37969,"_5":25256,"_9967":37900,"_1768":37970},[],"el chart principal de Lamassu",{"_4557":287,"_25012":266,"_21207":37972,"_5":25256,"_9967":37900,"_1768":37973},[],"un chart auxiliar de SoftHSM",{"_4557":288,"_25012":266,"_21207":37975,"_5":25256,"_9967":37900,"_1768":37976},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_4557":289,"_25012":266,"_21207":37978,"_5":25256,"_9967":37904,"_1768":37979},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_4557":290,"_25012":266,"_21207":37981,"_5":25256,"_9967":37904,"_1768":37982},[],"Ese flujo:",{"_4557":291,"_25012":266,"_21207":37984,"_5":25256,"_9967":37904,"_1768":37985},[],"crea o reutiliza el namespace indicado",{"_4557":292,"_25012":266,"_21207":37987,"_5":25256,"_9967":37904,"_1768":37988},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_4557":293,"_25012":266,"_21207":37990,"_5":25256,"_9967":37904,"_1768":37991},[],"despliega el chart de Lamassu",{"_4557":294,"_25012":266,"_21207":37993,"_5":25256,"_9967":37904,"_1768":37994},[],"deja la UI expuesta en `https://<dominio>`",{"_4557":295,"_25012":266,"_21207":37996,"_5":25256,"_9967":37904,"_1768":37997},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_4557":296,"_25012":266,"_21207":37999,"_5":25256,"_9967":37908,"_1768":38000},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_4557":297,"_25012":266,"_21207":38002,"_5":25256,"_9967":37908,"_1768":38003},[],"`ui`",{"_4557":298,"_25012":266,"_21207":38005,"_5":25256,"_9967":37908,"_1768":38006},[],"`ca`",{"_4557":299,"_25012":266,"_21207":38008,"_5":25256,"_9967":37908,"_1768":38009},[],"`va`",{"_4557":300,"_25012":266,"_21207":38011,"_5":25256,"_9967":37908,"_1768":38012},[],"`kms`",{"_4557":301,"_25012":266,"_21207":38014,"_5":25256,"_9967":37908,"_1768":38015},[],"`device-manager`",{"_4557":302,"_25012":266,"_21207":38017,"_5":25256,"_9967":37908,"_1768":38018},[],"`dms-manager`",{"_4557":303,"_25012":266,"_21207":38020,"_5":25256,"_9967":37908,"_1768":38021},[],"`alerts`",{"_4557":304,"_25012":266,"_21207":38023,"_5":25256,"_9967":37908,"_1768":38024},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_4557":305,"_25012":266,"_21207":38026,"_5":25256,"_9967":37908,"_1768":38027},[],"job de migraciones de base de datos",{"_4557":306,"_25012":266,"_21207":38029,"_5":25256,"_9967":37912,"_1768":38030},[],"Clúster Kubernetes `1.19+`",{"_4557":307,"_25012":266,"_21207":38032,"_5":25256,"_9967":37912,"_1768":38033},[],"`kubectl` configurado con acceso al clúster",{"_4557":308,"_25012":266,"_21207":38035,"_5":25256,"_9967":37912,"_1768":38036},[],"Helm `3.2.0+`",{"_4557":309,"_25012":266,"_21207":38038,"_5":25256,"_9967":37912,"_1768":38039},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_4557":310,"_25012":266,"_21207":38041,"_5":25256,"_9967":37912,"_1768":38042},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_4557":311,"_25012":266,"_21207":38044,"_5":25256,"_9967":37912,"_1768":38045},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_4557":312,"_25012":266,"_21207":38047,"_5":25256,"_9967":37912,"_1768":38048},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_4557":313,"_25012":266,"_21207":38050,"_5":25256,"_9967":37916,"_1768":38051},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_4557":314,"_25012":266,"_21207":38053,"_5":25256,"_9967":37920,"_1768":38054},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_4557":315,"_25012":266,"_21207":38056,"_5":25256,"_9967":37924,"_1768":38057},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_4557":316,"_25012":266,"_21207":38059,"_5":25256,"_9967":37928,"_1768":38060},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_4557":317,"_25012":266,"_21207":38062,"_5":25256,"_9967":37928,"_1768":38063},[],"Dependencias externas requeridas por el chart principal:",{"_4557":318,"_25012":266,"_21207":38065,"_5":25256,"_9967":37928,"_1768":37454},[],{"_4557":319,"_25012":266,"_21207":38067,"_5":25256,"_9967":37928,"_1768":37460},[],{"_4557":320,"_25012":266,"_21207":38069,"_5":25256,"_9967":37928,"_1768":38070},[],"proveedor OIDC, típicamente Keycloak",{"_4557":321,"_25012":266,"_21207":38072,"_5":25256,"_9967":37928,"_1768":38073},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_4557":322,"_25012":266,"_21207":38075,"_5":25256,"_9967":37932,"_1768":38076},[],"Agregar el repositorio Helm:",{"_4557":323,"_25012":266,"_21207":38078,"_5":25256,"_9967":37932,"_1768":38079},[],"O instalar desde una copia local del repositorio:",{"_4557":324,"_25012":266,"_21207":38081,"_5":25256,"_9967":37936,"_1768":38082},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_4557":325,"_25012":266,"_21207":38084,"_5":25256,"_9967":37936,"_1768":38085},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_4557":326,"_25012":266,"_21207":38087,"_5":25256,"_9967":37936,"_1768":38088},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_4557":327,"_25012":266,"_21207":38090,"_5":25256,"_9967":37936,"_1768":38091},[],"`auth.oidc.frontend.authority`",{"_4557":328,"_25012":266,"_21207":38093,"_5":25256,"_9967":37936,"_1768":38094},[],"`auth.oidc.apiGateway.jwks`",{"_4557":329,"_25012":266,"_21207":38096,"_5":25256,"_9967":37936,"_1768":38097},[],"`services.authz.jwkUrl` y un principal de bootstrap que coincida con un administrador real",{"_4557":330,"_25012":266,"_21207":38099,"_5":25256,"_9967":37936,"_1768":38100},[],"`services.ca.domains`",{"_4557":331,"_25012":266,"_21207":38102,"_5":25256,"_9967":37936,"_1768":38103},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_4557":332,"_25012":266,"_21207":38105,"_5":25256,"_9967":37936,"_1768":38106},[],"`tls.*` según se use `certManager` o certificado externo",{"_4557":333,"_25012":266,"_21207":38108,"_5":25256,"_9967":37936,"_1768":38109},[],"Ejemplo base:",{"_4557":334,"_25012":266,"_21207":38111,"_5":25256,"_9967":37940,"_1768":38112},[],"No hay un superusuario implícito. Antes de instalar, crea el rol `pki-admin` en el proveedor OIDC y asígnalo al grupo que administrará Lamassu. El principal del ejemplo concede la política `SUPER ADMIN` a cualquier token que contenga ese rol.",{"_4557":335,"_25012":266,"_21207":38114,"_5":25256,"_9967":37940,"_1768":38115},[],"El Job `pre-install` y `pre-upgrade` prepara las bases de datos, ejecuta las migraciones de authz, precarga las políticas y aplica `services.authz.bootstrap` antes de que arranquen los Deployments. El bootstrap es idempotente: conserva los principales existentes y añade únicamente los grants que falten.",{"_4557":336,"_25012":266,"_21207":38117,"_5":25256,"_9967":37940,"_1768":38118},[],"Si ningún token coincide con un principal activo, nadie podrá administrar la PKI. Prueba una identidad autorizada y otra denegada, y conserva un procedimiento de recuperación.",{"_4557":337,"_25012":266,"_21207":38120,"_5":25256,"_9967":37940,"_1768":38121},[],"Consulta Control de acceso para diseñar principales y políticas.",{"_4557":338,"_25012":266,"_21207":38123,"_5":25256,"_9967":37944,"_1768":38124},[],"**TLS:** `tls.type`, `tls.certManagerOptions.*` y `tls.externalOptions.secretName` controlan el certificado *downstream* del Gateway.",{"_4557":339,"_25012":266,"_21207":38126,"_5":25256,"_9967":37944,"_1768":38127},[],"**Gateway:** `gateway.addresses`, `gateway.ports.*` y `gateway.extraRouting` publican la UI y las APIs mediante Envoy Gateway.",{"_4557":340,"_25012":266,"_21207":38129,"_5":25256,"_9967":37944,"_1768":38130},[],"**Persistencia:** `postgres.*` define la conexión a PostgreSQL.",{"_4557":341,"_25012":266,"_21207":38132,"_5":25256,"_9967":37944,"_1768":38133},[],"**Mensajería:** `amqp.*` configura la conexión a RabbitMQ.",{"_4557":342,"_25012":266,"_21207":38135,"_5":25256,"_9967":37944,"_1768":38136},[],"**Identidad y autorización:** `auth.oidc.*`, `services.authz.jwkUrl` y `services.authz.bootstrap` configuran login, validación JWT y permisos iniciales.",{"_4557":343,"_25012":266,"_21207":38138,"_5":25256,"_9967":37944,"_1768":38139},[],"**Autoridades:** `services.ca.domains` establece los dominios autorizados para CA y certificados.",{"_4557":344,"_25012":266,"_21207":38141,"_5":25256,"_9967":37944,"_1768":38142},[],"**Claves:** `services.kms.cryptoEngines.*` configura los motores criptográficos y su almacenamiento.",{"_4557":345,"_25012":266,"_21207":38144,"_5":25256,"_9967":37944,"_1768":38145},[],"**Alertas:** `services.alerts.smtp_server.*` prepara el envío de correo.",{"_4557":346,"_25012":266,"_21207":38147,"_5":25256,"_9967":37948,"_1768":38148},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_4557":347,"_25012":266,"_21207":38150,"_5":25256,"_9967":37948,"_1768":38151},[],"La prueba comprueba al menos:",{"_4557":348,"_25012":266,"_21207":38153,"_5":25256,"_9967":37948,"_1768":38154},[],"salud de `ca`",{"_4557":349,"_25012":266,"_21207":38156,"_5":25256,"_9967":37948,"_1768":38157},[],"salud de `dms-manager`",{"_4557":350,"_25012":266,"_21207":38159,"_5":25256,"_9967":37948,"_1768":38160},[],"salud de `device-manager`",{"_4557":351,"_25012":266,"_21207":38162,"_5":25256,"_9967":37948,"_1768":38163},[],"salud de `va`",{"_4557":352,"_25012":266,"_21207":38165,"_5":25256,"_9967":37948,"_1768":38166},[],"respuesta HTML esperada del servicio `ui`",{"_4557":353,"_25012":266,"_21207":38168,"_5":25256,"_9967":37952,"_1768":38169},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_4557":354,"_25012":266,"_21207":38171,"_5":25256,"_9967":37952,"_1768":38172},[],"`charts/lamassu`: chart principal de Lamassu",{"_4557":355,"_25012":266,"_21207":38174,"_5":25256,"_9967":37952,"_1768":38175},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_4557":356,"_25012":266,"_21207":38177,"_5":25256,"_9967":37952,"_1768":38178},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_4557":357,"_25012":266,"_21207":38180,"_5":25256,"_9967":37956,"_1768":38181},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_4557":358,"_25012":266,"_21207":38183,"_5":25256,"_9967":37960,"_1768":38184},[],"La versión actual del chart en el repositorio es `3.8.0`. Para upgrades entre versiones, consulta las guías de `charts/lamassu/CHANGELOG/` y revisa especialmente las migraciones de base de datos y el bootstrap de authz.",{"_4557":359,"_25012":359,"_5":25251,"_1768":38186,"_25264":38187,"_21207":38190,"_9967":359},"Control de acceso",[37104,38188,38189],"Plataforma","Administrar Lamassu",[],{"_4557":360,"_25012":359,"_21207":38192,"_5":25256,"_9967":359,"_1768":38193},[],"Conecta una identidad OIDC o X.509 con principales, políticas y permisos de Lamassu.",{"_4557":361,"_25012":359,"_5":25261,"_21207":38195,"_9967":38196,"_1768":38197},[],"/docs/platform/pki/access-control#cómo-se-toma-una-decisión","Cómo se toma una decisión",{"_4557":362,"_25012":359,"_5":25261,"_21207":38199,"_9967":38200,"_1768":38201},[],"/docs/platform/pki/access-control#principales","Principales",{"_4557":363,"_25012":359,"_5":25261,"_21207":38203,"_9967":38204,"_1768":38205},[],"/docs/platform/pki/access-control#políticas","Políticas",{"_4557":364,"_25012":359,"_5":25261,"_21207":38207,"_9967":38208,"_1768":37941},[],"/docs/platform/pki/access-control#provisiona-el-primer-administrador",{"_4557":365,"_25012":359,"_5":25261,"_21207":38210,"_9967":38211,"_1768":38212},[],"/docs/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_4557":366,"_25012":359,"_5":25261,"_21207":38214,"_9967":38215,"_1768":38216},[],"/docs/platform/pki/access-control#operación-segura","Operación segura",{"_4557":367,"_25012":359,"_5":25261,"_21207":38218,"_9967":38219,"_1768":38220},[],"/docs/platform/pki/access-control#diagnóstico-rápido","Diagnóstico rápido",{"_4557":368,"_25012":359,"_21207":38222,"_5":25256,"_9967":359,"_1768":38223},[],"Lamassu separa autenticación y autorización. El proveedor OIDC o el certificado cliente demuestra quién realiza la petición; el servicio authz relaciona esa identidad con uno o varios principales y decide qué acciones están permitidas.",{"_4557":369,"_25012":359,"_21207":38225,"_5":25256,"_9967":38196,"_1768":38226},[],"El Gateway valida la autenticación configurada, normalmente un JWT mediante JWKS.",{"_4557":370,"_25012":359,"_21207":38228,"_5":25256,"_9967":38196,"_1768":38229},[],"Envoy envía la petición al endpoint de autorización externa /v1/ext\\_authz/check.",{"_4557":371,"_25012":359,"_21207":38231,"_5":25256,"_9967":38196,"_1768":38232},[],"authz compara las credenciales con principales activos.",{"_4557":372,"_25012":359,"_21207":38234,"_5":25256,"_9967":38196,"_1768":38235},[],"Reúne las políticas concedidas a los principales coincidentes.",{"_4557":373,"_25012":359,"_21207":38237,"_5":25256,"_9967":38196,"_1768":38238},[],"Evalúa la acción HTTP o el recurso solicitado y permite o deniega.",{"_4557":374,"_25012":359,"_21207":38240,"_5":25256,"_9967":38196,"_1768":38241},[],"Por defecto, auth.externalAuthorization.failOpen es false. Si authz no responde, el Gateway bloquea la petición protegida.",{"_4557":375,"_25012":359,"_21207":38243,"_5":25256,"_9967":38200,"_1768":38244},[],"Un principal representa una identidad autorizable, no necesariamente una persona individual. Tiene un identificador estable, nombre, tipo, configuración de coincidencia, estado activo y políticas concedidas.",{"_4557":376,"_25012":359,"_21207":38246,"_5":25256,"_9967":38200,"_1768":38247},[],"Lamassu admite dos tipos:",{"_4557":377,"_25012":359,"_21207":38249,"_5":25256,"_9967":38200,"_1768":38250},[],"**oidc**: coincide con claims de un token, por ejemplo un rol, grupo o preferred\\_username.",{"_4557":378,"_25012":359,"_21207":38252,"_5":25256,"_9967":38200,"_1768":38253},[],"**x509**: coincide con una identidad autenticada mediante certificado y su configuración de confianza.",{"_4557":379,"_25012":359,"_21207":38255,"_5":25256,"_9967":38200,"_1768":38256},[],"Diseña los principales alrededor de identidades estables del proveedor. Para administración humana suele ser preferible un grupo o rol gestionado centralmente; para automatización, usa una identidad técnica independiente.",{"_4557":380,"_25012":359,"_21207":38258,"_5":25256,"_9967":38204,"_1768":38259},[],"Una política agrupa reglas reutilizables. Las reglas pueden:",{"_4557":381,"_25012":359,"_21207":38261,"_5":25256,"_9967":38204,"_1768":38262},[],"permitir acciones sobre un tipo de entidad;",{"_4557":382,"_25012":359,"_21207":38264,"_5":25256,"_9967":38204,"_1768":38265},[],"limitar el acceso a identificadores concretos;",{"_4557":383,"_25012":359,"_21207":38267,"_5":25256,"_9967":38204,"_1768":38268},[],"seguir relaciones entre entidades;",{"_4557":384,"_25012":359,"_21207":38270,"_5":25256,"_9967":38204,"_1768":38271},[],"aplicar filtros por atributos;",{"_4557":385,"_25012":359,"_21207":38273,"_5":25256,"_9967":38204,"_1768":38274},[],"conceder acciones HTTP lógicas definidas por el esquema de una API.",{"_4557":386,"_25012":359,"_21207":38276,"_5":25256,"_9967":38204,"_1768":38277},[],"La acción \\* en una regla HTTP concede todas las acciones definidas por ese esquema. Resérvala para roles administrativos controlados.",{"_4557":387,"_25012":359,"_21207":38279,"_5":25256,"_9967":38208,"_1768":38280},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la PKI. Define el bootstrap y configura el IdP antes de exponer la plataforma.",{"_4557":388,"_25012":359,"_21207":38282,"_5":25256,"_9967":38208,"_1768":38283},[],"El chart crea por defecto un principal que busca el rol OIDC pki-admin en realm\\_access.roles y le concede las políticas de administración incluidas. El Job Helm de preinstalación y preactualización ejecuta las migraciones de authz, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios.",{"_4557":389,"_25012":359,"_21207":38285,"_5":25256,"_9967":38208,"_1768":38286},[],"Antes de instalar:",{"_4557":390,"_25012":359,"_21207":38288,"_5":25256,"_9967":38208,"_1768":38289},[],"Crea el rol pki-admin en tu proveedor OIDC.",{"_4557":391,"_25012":359,"_21207":38291,"_5":25256,"_9967":38208,"_1768":38292},[],"Asígnalo a un grupo administrativo pequeño y verificable.",{"_4557":392,"_25012":359,"_21207":38294,"_5":25256,"_9967":38208,"_1768":38295},[],"Configura la URL JWKS interna que alcanzará authz.",{"_4557":393,"_25012":359,"_21207":38297,"_5":25256,"_9967":38208,"_1768":38298},[],"Mantén al menos dos identidades humanas de recuperación.",{"_4557":394,"_25012":359,"_21207":38300,"_5":25256,"_9967":38208,"_1768":38301},[],"Prueba acceso permitido y denegado con usuarios distintos.",{"_4557":395,"_25012":359,"_21207":38303,"_5":25256,"_9967":38208,"_1768":38304},[],"El bootstrap es idempotente: si el principal ya existe, no lo reemplaza; solo añade las políticas configuradas que todavía falten. Por eso puedes mantenerlo en values.yaml durante las actualizaciones.",{"_4557":396,"_25012":359,"_21207":38306,"_5":25256,"_9967":38211,"_1768":38307},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario lamassu con contraseña temporal lamassu, rol pki-admin y acción obligatoria de cambio de contraseña. Su principal de bootstrap coincide por preferred\\_username=lamassu.",{"_4557":397,"_25012":359,"_21207":38309,"_5":25256,"_9967":38211,"_1768":38310},[],"Cambia la contraseña en el primer acceso. No reutilices este usuario ni el IdP de ejemplo como diseño de producción.",{"_4557":398,"_25012":359,"_21207":38312,"_5":25256,"_9967":38215,"_1768":38313},[],"Concede políticas a grupos o identidades técnicas, no a claims ambiguos.",{"_4557":399,"_25012":359,"_21207":38315,"_5":25256,"_9967":38215,"_1768":38316},[],"Desactiva un principal cuando deba perder acceso de inmediato.",{"_4557":400,"_25012":359,"_21207":38318,"_5":25256,"_9967":38215,"_1768":38319},[],"Separa administración de PKI, operación de dispositivos y automatizaciones.",{"_4557":401,"_25012":359,"_21207":38321,"_5":25256,"_9967":38215,"_1768":38322},[],"Revisa los grants tras cambios en el proveedor OIDC.",{"_4557":402,"_25012":359,"_21207":38324,"_5":25256,"_9967":38215,"_1768":38325},[],"Mantén failOpen: false salvo una decisión de riesgo explícita.",{"_4557":403,"_25012":359,"_21207":38327,"_5":25256,"_9967":38215,"_1768":38328},[],"Conserva un procedimiento probado para recuperar acceso sin desactivar autorización.",{"_4557":404,"_25012":359,"_21207":38330,"_5":25256,"_9967":38219,"_1768":38331},[],"Un 401 suele indicar que el Gateway no pudo validar la autenticación. Revisa emisor, audiencia, expiración y JWKS.",{"_4557":405,"_25012":359,"_21207":38333,"_5":25256,"_9967":38219,"_1768":38334},[],"Un 403 indica normalmente que la identidad se autenticó, pero ningún principal activo y sus políticas autorizaron la acción. Comprueba claims reales del token, regla de coincidencia, grants y acción solicitada.",{"_4557":406,"_25012":359,"_21207":38336,"_5":25256,"_9967":38219,"_1768":38337},[],"Si todas las rutas protegidas fallan, verifica la salud y conectividad de authz, su acceso a PostgreSQL y la URL JWKS. Continúa con Resolución de problemas.",{"_4557":407,"_25012":407,"_5":25251,"_1768":38339,"_25264":38340,"_21207":38342,"_9967":407},"Alertas y suscripciones",[37104,38188,38341],"Operar Lamassu",[],{"_4557":408,"_25012":407,"_21207":38344,"_5":25256,"_9967":407,"_1768":38345},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_4557":409,"_25012":407,"_5":25261,"_21207":38347,"_9967":38348,"_1768":38349},[],"/docs/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_4557":410,"_25012":407,"_5":25261,"_21207":38351,"_9967":38352,"_1768":38353},[],"/docs/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_4557":411,"_25012":407,"_5":25261,"_21207":38355,"_9967":38356,"_1768":38357},[],"/docs/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_4557":412,"_25012":407,"_5":25261,"_21207":38359,"_9967":38360,"_1768":38361},[],"/docs/platform/pki/alerts#elige-el-evento","Elige el evento",{"_4557":413,"_25012":407,"_5":25261,"_21207":38363,"_9967":38364,"_1768":38365},[],"/docs/platform/pki/alerts#configura-el-destino","Configura el destino",{"_4557":414,"_25012":407,"_5":25261,"_21207":38367,"_9967":38368,"_1768":38369},[],"/docs/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_4557":415,"_25012":407,"_5":25261,"_21207":38371,"_9967":38372,"_1768":38373},[],"/docs/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_4557":416,"_25012":407,"_5":25261,"_21207":38375,"_9967":38376,"_1768":38377},[],"/docs/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_4557":417,"_25012":407,"_5":25261,"_21207":38379,"_9967":38380,"_1768":38381},[],"/docs/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_4557":418,"_25012":407,"_21207":38383,"_5":25256,"_9967":407,"_1768":38384},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_4557":419,"_25012":407,"_21207":38386,"_5":25256,"_9967":38348,"_1768":38387},[],"Un servicio publica un evento de dominio.",{"_4557":420,"_25012":407,"_21207":38389,"_5":25256,"_9967":38348,"_1768":38390},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_4557":421,"_25012":407,"_21207":38392,"_5":25256,"_9967":38348,"_1768":38393},[],"El filtro de cada suscripción decide si debe notificarse.",{"_4557":422,"_25012":407,"_21207":38395,"_5":25256,"_9967":38348,"_1768":38396},[],"Lamassu entrega el evento al canal configurado.",{"_4557":423,"_25012":407,"_21207":38398,"_5":25256,"_9967":38348,"_1768":38399},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_4557":424,"_25012":407,"_21207":38401,"_5":25256,"_9967":38352,"_1768":38402},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_4557":425,"_25012":407,"_21207":38404,"_5":25256,"_9967":38352,"_1768":38405},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_4557":426,"_25012":407,"_21207":38407,"_5":25256,"_9967":38352,"_1768":38408},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_4557":427,"_25012":407,"_21207":38410,"_5":25256,"_9967":38360,"_1768":38411},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_4557":428,"_25012":407,"_21207":38413,"_5":25256,"_9967":38364,"_1768":38414},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_4557":429,"_25012":407,"_21207":38416,"_5":25256,"_9967":38368,"_1768":38417},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_4557":430,"_25012":407,"_21207":38419,"_5":25256,"_9967":38368,"_1768":38420},[],"**None** notifica todas las instancias del evento.",{"_4557":431,"_25012":407,"_21207":38422,"_5":25256,"_9967":38368,"_1768":38423},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_4557":432,"_25012":407,"_21207":38425,"_5":25256,"_9967":38368,"_1768":38426},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_4557":433,"_25012":407,"_21207":38428,"_5":25256,"_9967":38368,"_1768":38429},[],"**JavaScript** permite expresar lógica personalizada.",{"_4557":434,"_25012":407,"_21207":38431,"_5":25256,"_9967":38368,"_1768":38432},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_4557":435,"_25012":407,"_21207":38434,"_5":25256,"_9967":38372,"_1768":38435},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_4557":436,"_25012":407,"_21207":38437,"_5":25256,"_9967":38376,"_1768":38438},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_4557":437,"_25012":407,"_21207":38440,"_5":25256,"_9967":38380,"_1768":38441},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_4557":438,"_25012":407,"_21207":38443,"_5":25256,"_9967":38380,"_1768":38444},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_4557":439,"_25012":407,"_21207":38446,"_5":25256,"_9967":38380,"_1768":38447},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_4557":440,"_25012":407,"_21207":38449,"_5":25256,"_9967":38380,"_1768":38450},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_4557":441,"_25012":407,"_21207":38452,"_5":25256,"_9967":38380,"_1768":38453},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_4557":442,"_25012":407,"_21207":38455,"_5":25256,"_9967":38380,"_1768":38456},[],"**Validación:** `va.role.crl.create`.",{"_4557":443,"_25012":407,"_21207":38458,"_5":25256,"_9967":38380,"_1768":38459},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_4557":444,"_25012":407,"_21207":38461,"_5":25256,"_9967":38380,"_1768":38462},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_4557":445,"_25012":445,"_5":25251,"_1768":38464,"_25264":38465,"_21207":38466,"_9967":445},"Registros de auditoría",[37104,38188,38189],[],{"_4557":446,"_25012":445,"_21207":38468,"_5":25256,"_9967":445,"_1768":38469},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_4557":447,"_25012":445,"_5":25261,"_21207":38471,"_9967":38472,"_1768":38473},[],"/docs/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_4557":448,"_25012":445,"_5":25261,"_21207":38475,"_9967":38476,"_1768":38477},[],"/docs/platform/pki/audit-logs#cobertura","Cobertura",{"_4557":449,"_25012":445,"_5":25261,"_21207":38479,"_9967":38480,"_1768":38481},[],"/docs/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_4557":450,"_25012":445,"_5":25261,"_21207":38483,"_9967":38484,"_1768":38485},[],"/docs/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_4557":451,"_25012":445,"_5":25261,"_21207":38487,"_9967":38488,"_1768":38489},[],"/docs/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_4557":452,"_25012":445,"_5":25261,"_21207":38491,"_9967":38492,"_1768":38493},[],"/docs/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_4557":453,"_25012":445,"_5":25261,"_21207":38495,"_9967":38496,"_1768":38497},[],"/docs/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_4557":454,"_25012":445,"_5":25261,"_21207":38499,"_9967":38500,"_1768":38501},[],"/docs/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_4557":455,"_25012":445,"_5":25261,"_21207":38503,"_9967":38504,"_1768":38505},[],"/docs/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_4557":456,"_25012":445,"_5":25261,"_21207":38507,"_9967":38508,"_1768":38509},[],"/docs/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_4557":457,"_25012":445,"_5":25261,"_21207":38511,"_9967":38512,"_1768":38513},[],"/docs/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_4557":458,"_25012":445,"_21207":38515,"_5":25256,"_9967":445,"_1768":38516},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_4557":459,"_25012":445,"_21207":38518,"_5":25256,"_9967":38472,"_1768":38519},[],"El cuerpo de auditoría incluye:",{"_4557":460,"_25012":445,"_21207":38521,"_5":25256,"_9967":38472,"_1768":38522},[],"input: datos recibidos por la operación;",{"_4557":461,"_25012":445,"_21207":38524,"_5":25256,"_9967":38472,"_1768":38525},[],"has\\_error: indica si el servicio devolvió un error;",{"_4557":462,"_25012":445,"_21207":38527,"_5":25256,"_9967":38472,"_1768":38528},[],"output: resultado producido o mensaje de error;",{"_4557":463,"_25012":445,"_21207":38530,"_5":25256,"_9967":38472,"_1768":38531},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_4557":464,"_25012":445,"_21207":38533,"_5":25256,"_9967":38472,"_1768":38534},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_4557":465,"_25012":445,"_21207":38536,"_5":25256,"_9967":38472,"_1768":38537},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_4557":466,"_25012":445,"_21207":38539,"_5":25256,"_9967":38476,"_1768":38540},[],"El backend aplica auditoría a mutaciones de:",{"_4557":467,"_25012":445,"_21207":38542,"_5":25256,"_9967":38476,"_1768":38543},[],"autoridades, certificados y perfiles de emisión;",{"_4557":468,"_25012":445,"_21207":38545,"_5":25256,"_9967":38476,"_1768":38546},[],"claves y motores KMS;",{"_4557":469,"_25012":445,"_21207":38548,"_5":25256,"_9967":38476,"_1768":38549},[],"dispositivos e identidades;",{"_4557":470,"_25012":445,"_21207":38551,"_5":25256,"_9967":38476,"_1768":38552},[],"DMS y operaciones de enrolamiento;",{"_4557":471,"_25012":445,"_21207":38554,"_5":25256,"_9967":38476,"_1768":38555},[],"funciones de validación y CRL;",{"_4557":472,"_25012":445,"_21207":38557,"_5":25256,"_9967":38476,"_1768":38558},[],"principales, políticas y concesiones de autorización.",{"_4557":473,"_25012":445,"_21207":38560,"_5":25256,"_9967":38476,"_1768":38561},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_4557":474,"_25012":445,"_21207":38563,"_5":25256,"_9967":38480,"_1768":38564},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_4557":475,"_25012":445,"_21207":38566,"_5":25256,"_9967":38480,"_1768":38567},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_4557":476,"_25012":445,"_21207":38569,"_5":25256,"_9967":38480,"_1768":38570},[],"Diseña el consumidor para:",{"_4557":477,"_25012":445,"_21207":38572,"_5":25256,"_9967":38480,"_1768":38573},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_4557":478,"_25012":445,"_21207":38575,"_5":25256,"_9967":38480,"_1768":38576},[],"conservar el CloudEvent completo sin modificar;",{"_4557":479,"_25012":445,"_21207":38578,"_5":25256,"_9967":38480,"_1768":38579},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_4557":480,"_25012":445,"_21207":38581,"_5":25256,"_9967":38480,"_1768":38582},[],"cifrar en tránsito y en reposo;",{"_4557":481,"_25012":445,"_21207":38584,"_5":25256,"_9967":38480,"_1768":38585},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_4557":482,"_25012":445,"_21207":38587,"_5":25256,"_9967":38480,"_1768":38588},[],"aplicar una política explícita de retención y legal hold;",{"_4557":483,"_25012":445,"_21207":38590,"_5":25256,"_9967":38480,"_1768":38591},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_4557":484,"_25012":445,"_21207":38593,"_5":25256,"_9967":38484,"_1768":38594},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_4557":485,"_25012":445,"_21207":38596,"_5":25256,"_9967":38484,"_1768":38597},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_4557":486,"_25012":445,"_21207":38599,"_5":25256,"_9967":38492,"_1768":38600},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_4557":487,"_25012":445,"_21207":38602,"_5":25256,"_9967":38496,"_1768":38603},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_4557":488,"_25012":445,"_21207":38605,"_5":25256,"_9967":38500,"_1768":38606},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_4557":489,"_25012":445,"_21207":38608,"_5":25256,"_9967":38504,"_1768":38609},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_4557":490,"_25012":445,"_21207":38611,"_5":25256,"_9967":38508,"_1768":38612},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_4557":491,"_25012":445,"_21207":38614,"_5":25256,"_9967":38512,"_1768":38615},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_4557":492,"_25012":445,"_21207":38617,"_5":25256,"_9967":38512,"_1768":38618},[],"aparece un evento de auditoría correcto;",{"_4557":493,"_25012":445,"_21207":38620,"_5":25256,"_9967":38512,"_1768":38621},[],"el principal coincide con la identidad utilizada;",{"_4557":494,"_25012":445,"_21207":38623,"_5":25256,"_9967":38512,"_1768":38624},[],"el consumidor lo persiste una sola vez;",{"_4557":495,"_25012":445,"_21207":38626,"_5":25256,"_9967":38512,"_1768":38627},[],"puede recuperarse por recurso, actor y periodo;",{"_4557":496,"_25012":445,"_21207":38629,"_5":25256,"_9967":38512,"_1768":38630},[],"una interrupción del consumidor produce una alerta.",{"_4557":497,"_25012":445,"_21207":38632,"_5":25256,"_9967":38512,"_1768":38633},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_4557":498,"_25012":498,"_5":25251,"_1768":38635,"_25264":38636,"_21207":38637,"_9967":498},"Jerarquía y rotación de CAs",[37104,38188,38341],[],{"_4557":499,"_25012":498,"_21207":38639,"_5":25256,"_9967":498,"_1768":38640},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_4557":500,"_25012":498,"_5":25261,"_21207":38642,"_9967":38643,"_1768":38644},[],"/docs/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_4557":501,"_25012":498,"_5":25261,"_21207":38646,"_9967":38647,"_1768":38648},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_4557":502,"_25012":498,"_5":25261,"_21207":38650,"_9967":38651,"_1768":38652},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_4557":503,"_25012":498,"_5":25261,"_21207":38654,"_9967":38655,"_1768":38656},[],"/docs/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_4557":504,"_25012":498,"_5":25261,"_21207":38658,"_9967":38659,"_1768":38660},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_4557":505,"_25012":498,"_5":25261,"_21207":38662,"_9967":38663,"_1768":38664},[],"/docs/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_4557":506,"_25012":498,"_5":25261,"_21207":38666,"_9967":38667,"_1768":38668},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_4557":507,"_25012":498,"_5":25261,"_21207":38670,"_9967":38671,"_1768":38672},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_4557":508,"_25012":498,"_5":25261,"_21207":38674,"_9967":38675,"_1768":38676},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_4557":509,"_25012":498,"_5":25261,"_21207":38678,"_9967":38679,"_1768":38680},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_4557":510,"_25012":498,"_5":25261,"_21207":38682,"_9967":38683,"_1768":38684},[],"/docs/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_4557":511,"_25012":498,"_5":25261,"_21207":38686,"_9967":38687,"_1768":38688},[],"/docs/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_4557":512,"_25012":498,"_21207":38690,"_5":25256,"_9967":498,"_1768":38691},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_4557":513,"_25012":498,"_21207":38693,"_5":25256,"_9967":38643,"_1768":38694},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_4557":514,"_25012":498,"_21207":38696,"_5":25256,"_9967":38643,"_1768":38697},[],"entorno, como producción y preproducción;",{"_4557":515,"_25012":498,"_21207":38699,"_5":25256,"_9967":38643,"_1768":38700},[],"propietario o equipo operador;",{"_4557":516,"_25012":498,"_21207":38702,"_5":25256,"_9967":38643,"_1768":38703},[],"familia de dispositivos o proceso de fabricación;",{"_4557":517,"_25012":498,"_21207":38705,"_5":25256,"_9967":38643,"_1768":38706},[],"región o requisito regulatorio;",{"_4557":518,"_25012":498,"_21207":38708,"_5":25256,"_9967":38643,"_1768":38709},[],"motor criptográfico o política de clave;",{"_4557":519,"_25012":498,"_21207":38711,"_5":25256,"_9967":38643,"_1768":38712},[],"ventana de mantenimiento y ritmo de renovación.",{"_4557":520,"_25012":498,"_21207":38714,"_5":25256,"_9967":38643,"_1768":38715},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_4557":521,"_25012":498,"_21207":38717,"_5":25256,"_9967":38643,"_1768":38718},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_4557":522,"_25012":498,"_21207":38720,"_5":25256,"_9967":38647,"_1768":38721},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_4557":523,"_25012":498,"_21207":38723,"_5":25256,"_9967":38647,"_1768":38724},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_4557":524,"_25012":498,"_21207":38726,"_5":25256,"_9967":38647,"_1768":38727},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_4557":525,"_25012":498,"_21207":38729,"_5":25256,"_9967":38651,"_1768":38730},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_4557":526,"_25012":498,"_21207":38732,"_5":25256,"_9967":38651,"_1768":38733},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_4557":527,"_25012":498,"_21207":38735,"_5":25256,"_9967":38651,"_1768":38736},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_4557":528,"_25012":498,"_21207":38738,"_5":25256,"_9967":38651,"_1768":38739},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_4557":529,"_25012":498,"_21207":38741,"_5":25256,"_9967":38659,"_1768":38742},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_4557":530,"_25012":498,"_21207":38744,"_5":25256,"_9967":38663,"_1768":38745},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_4557":531,"_25012":498,"_21207":38747,"_5":25256,"_9967":38667,"_1768":38748},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_4557":532,"_25012":498,"_21207":38750,"_5":25256,"_9967":38671,"_1768":38751},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_4557":533,"_25012":498,"_21207":38753,"_5":25256,"_9967":38675,"_1768":38754},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_4557":534,"_25012":498,"_21207":38756,"_5":25256,"_9967":38679,"_1768":38757},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_4557":535,"_25012":498,"_21207":38759,"_5":25256,"_9967":38683,"_1768":38760},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_4557":536,"_25012":498,"_21207":38762,"_5":25256,"_9967":38683,"_1768":38763},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_4557":537,"_25012":498,"_21207":38765,"_5":25256,"_9967":38687,"_1768":38766},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_4557":538,"_25012":498,"_21207":38768,"_5":25256,"_9967":38687,"_1768":38769},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_4557":539,"_25012":498,"_21207":38771,"_5":25256,"_9967":38687,"_1768":38772},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_4557":540,"_25012":498,"_21207":38774,"_5":25256,"_9967":38687,"_1768":38775},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_4557":541,"_25012":498,"_21207":38777,"_5":25256,"_9967":38687,"_1768":38778},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_4557":542,"_25012":498,"_21207":38780,"_5":25256,"_9967":38687,"_1768":38781},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_4557":543,"_25012":498,"_21207":38783,"_5":25256,"_9967":38687,"_1768":38784},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_4557":544,"_25012":544,"_5":25251,"_1768":38786,"_25264":38787,"_21207":38788,"_9967":544},"Autoridades de certificación",[37104,38188,38341],[],{"_4557":545,"_25012":544,"_21207":38790,"_5":25256,"_9967":544,"_1768":38791},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_4557":546,"_25012":544,"_5":25261,"_21207":38793,"_9967":38794,"_1768":38795},[],"/docs/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_4557":547,"_25012":544,"_5":25261,"_21207":38797,"_9967":38798,"_1768":38799},[],"/docs/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_4557":548,"_25012":544,"_5":25261,"_21207":38801,"_9967":38802,"_1768":37114},[],"/docs/platform/pki/certificate-authorities#antes-de-empezar",{"_4557":549,"_25012":544,"_5":25261,"_21207":38804,"_9967":38805,"_1768":38806},[],"/docs/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_4557":550,"_25012":544,"_5":25261,"_21207":38808,"_9967":38809,"_1768":38810},[],"/docs/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_4557":551,"_25012":544,"_5":25261,"_21207":38812,"_9967":38813,"_1768":38814},[],"/docs/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_4557":552,"_25012":544,"_5":25261,"_21207":38816,"_9967":38817,"_1768":38818},[],"/docs/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_4557":553,"_25012":544,"_5":25261,"_21207":38820,"_9967":38821,"_1768":38822},[],"/docs/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_4557":554,"_25012":544,"_5":25261,"_21207":38824,"_9967":38825,"_1768":38826},[],"/docs/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_4557":555,"_25012":544,"_5":25261,"_21207":38828,"_9967":38829,"_1768":38830},[],"/docs/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_4557":556,"_25012":544,"_5":25261,"_21207":38832,"_9967":38833,"_1768":38834},[],"/docs/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_4557":557,"_25012":544,"_5":25261,"_21207":38836,"_9967":38837,"_1768":38838},[],"/docs/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_4557":558,"_25012":544,"_5":25261,"_21207":38840,"_9967":38841,"_1768":38842},[],"/docs/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_4557":559,"_25012":544,"_5":25261,"_21207":38844,"_9967":38845,"_1768":38846},[],"/docs/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_4557":560,"_25012":544,"_5":25261,"_21207":38848,"_9967":38849,"_1768":38850},[],"/docs/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_4557":561,"_25012":544,"_5":25261,"_21207":38852,"_9967":38853,"_1768":38854},[],"/docs/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_4557":562,"_25012":544,"_5":25261,"_21207":38856,"_9967":38857,"_1768":38858},[],"/docs/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_4557":563,"_25012":544,"_5":25261,"_21207":38860,"_9967":38861,"_1768":38862},[],"/docs/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_4557":564,"_25012":544,"_5":25261,"_21207":38864,"_9967":38865,"_1768":38866},[],"/docs/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_4557":565,"_25012":544,"_5":25261,"_21207":38868,"_9967":38869,"_1768":38870},[],"/docs/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_4557":566,"_25012":544,"_5":25261,"_21207":38872,"_9967":38873,"_1768":38874},[],"/docs/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_4557":567,"_25012":544,"_5":25261,"_21207":38876,"_9967":38877,"_1768":38878},[],"/docs/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_4557":568,"_25012":544,"_21207":38880,"_5":25256,"_9967":544,"_1768":38881},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_4557":569,"_25012":544,"_21207":38883,"_5":25256,"_9967":544,"_1768":38884},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_4557":570,"_25012":544,"_21207":38886,"_5":25256,"_9967":38794,"_1768":38887},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_4557":571,"_25012":544,"_21207":38889,"_5":25256,"_9967":38794,"_1768":38890},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_4557":572,"_25012":544,"_21207":38892,"_5":25256,"_9967":38794,"_1768":38893},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_4557":573,"_25012":544,"_21207":38895,"_5":25256,"_9967":38794,"_1768":38896},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_4557":574,"_25012":544,"_21207":38898,"_5":25256,"_9967":38794,"_1768":38899},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_4557":575,"_25012":544,"_21207":38901,"_5":25256,"_9967":38802,"_1768":38902},[],"Decide si la CA será raíz o intermedia.",{"_4557":576,"_25012":544,"_21207":38904,"_5":25256,"_9967":38802,"_1768":38905},[],"Elige el motor que custodiará la clave.",{"_4557":577,"_25012":544,"_21207":38907,"_5":25256,"_9967":38802,"_1768":38908},[],"Define una validez superior a la de los certificados que emitirá.",{"_4557":578,"_25012":544,"_21207":38910,"_5":25256,"_9967":38802,"_1768":38911},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_4557":579,"_25012":544,"_21207":38913,"_5":25256,"_9967":38805,"_1768":38914},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_4557":580,"_25012":544,"_21207":38916,"_5":25256,"_9967":38809,"_1768":38917},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_4557":581,"_25012":544,"_21207":38919,"_5":25256,"_9967":38809,"_1768":38920},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_4557":582,"_25012":544,"_21207":38922,"_5":25256,"_9967":38813,"_1768":38923},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_4557":583,"_25012":544,"_21207":38925,"_5":25256,"_9967":38817,"_1768":38926},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_4557":584,"_25012":544,"_21207":38928,"_5":25256,"_9967":38817,"_1768":38929},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_4557":585,"_25012":544,"_21207":38931,"_5":25256,"_9967":38817,"_1768":38932},[],"`ST`: estado o provincia.",{"_4557":586,"_25012":544,"_21207":38934,"_5":25256,"_9967":38817,"_1768":38935},[],"`L`: localidad.",{"_4557":587,"_25012":544,"_21207":38937,"_5":25256,"_9967":38817,"_1768":38938},[],"`O`: organización.",{"_4557":588,"_25012":544,"_21207":38940,"_5":25256,"_9967":38817,"_1768":38941},[],"`OU`: unidad organizativa.",{"_4557":589,"_25012":544,"_21207":38943,"_5":25256,"_9967":38817,"_1768":38944},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_4557":590,"_25012":544,"_21207":38946,"_5":25256,"_9967":38821,"_1768":38947},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_4557":591,"_25012":544,"_21207":38949,"_5":25256,"_9967":38821,"_1768":38950},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_4557":592,"_25012":544,"_21207":38952,"_5":25256,"_9967":38825,"_1768":38953},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_4557":593,"_25012":544,"_21207":38955,"_5":25256,"_9967":38825,"_1768":38956},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_4557":594,"_25012":544,"_21207":38958,"_5":25256,"_9967":38829,"_1768":38959},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_4557":595,"_25012":544,"_21207":38961,"_5":25256,"_9967":38829,"_1768":38962},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_4557":596,"_25012":544,"_21207":38964,"_5":25256,"_9967":38833,"_1768":38965},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_4557":597,"_25012":544,"_21207":38967,"_5":25256,"_9967":38837,"_1768":38968},[],"Elige el motor que custodiará la clave importada.",{"_4557":598,"_25012":544,"_21207":38970,"_5":25256,"_9967":38841,"_1768":38971},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_4557":599,"_25012":544,"_21207":38973,"_5":25256,"_9967":38845,"_1768":38974},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_4557":600,"_25012":544,"_21207":38976,"_5":25256,"_9967":38849,"_1768":38977},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_4557":601,"_25012":544,"_21207":38979,"_5":25256,"_9967":38849,"_1768":38980},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_4557":602,"_25012":544,"_21207":38982,"_5":25256,"_9967":38853,"_1768":38983},[],"Abre una CA desde el inventario para consultar:",{"_4557":603,"_25012":544,"_21207":38985,"_5":25256,"_9967":38853,"_1768":38986},[],"Estado y periodo de validez.",{"_4557":604,"_25012":544,"_21207":38988,"_5":25256,"_9967":38853,"_1768":38989},[],"Certificado y cadena en formato PEM.",{"_4557":605,"_25012":544,"_21207":38991,"_5":25256,"_9967":38853,"_1768":38992},[],"Número de certificados activos, expirados y revocados.",{"_4557":606,"_25012":544,"_21207":38994,"_5":25256,"_9967":38853,"_1768":38995},[],"Certificados emitidos en **Issued Certificates**.",{"_4557":607,"_25012":544,"_21207":38997,"_5":25256,"_9967":38853,"_1768":38998},[],"CRL vinculada a la autoridad.",{"_4557":608,"_25012":544,"_21207":39000,"_5":25256,"_9967":38853,"_1768":39001},[],"Metadatos y motor criptográfico asociado.",{"_4557":609,"_25012":544,"_21207":39003,"_5":25256,"_9967":38853,"_1768":39004},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_4557":610,"_25012":544,"_21207":39006,"_5":25256,"_9967":38857,"_1768":39007},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_4557":611,"_25012":544,"_21207":39009,"_5":25256,"_9967":38857,"_1768":39010},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_4557":612,"_25012":544,"_21207":39012,"_5":25256,"_9967":38857,"_1768":39013},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_4557":613,"_25012":544,"_21207":39015,"_5":25256,"_9967":38857,"_1768":39016},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_4557":614,"_25012":544,"_21207":39018,"_5":25256,"_9967":38861,"_1768":39019},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_4557":615,"_25012":544,"_21207":39021,"_5":25256,"_9967":38865,"_1768":39022},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_4557":616,"_25012":544,"_21207":39024,"_5":25256,"_9967":38869,"_1768":39025},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_4557":617,"_25012":544,"_21207":39027,"_5":25256,"_9967":38873,"_1768":39028},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_4557":618,"_25012":544,"_21207":39030,"_5":25256,"_9967":38877,"_1768":39031},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_4557":619,"_25012":544,"_21207":39033,"_5":25256,"_9967":38877,"_1768":39034},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_4557":620,"_25012":620,"_5":25251,"_1768":39036,"_25264":39037,"_21207":39038,"_9967":620},"Perfiles de certificado",[37104,38188,38341],[],{"_4557":621,"_25012":620,"_21207":39040,"_5":25256,"_9967":620,"_1768":39041},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_4557":622,"_25012":620,"_5":25261,"_21207":39043,"_9967":39044,"_1768":39045},[],"/docs/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_4557":623,"_25012":620,"_5":25261,"_21207":39047,"_9967":39048,"_1768":39049},[],"/docs/platform/pki/certificate-profiles#validez","Validez",{"_4557":624,"_25012":620,"_5":25261,"_21207":39051,"_9967":39052,"_1768":39053},[],"/docs/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_4557":625,"_25012":620,"_5":25261,"_21207":39055,"_9967":39056,"_1768":39057},[],"/docs/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_4557":626,"_25012":620,"_5":25261,"_21207":39059,"_9967":39060,"_1768":39061},[],"/docs/platform/pki/certificate-profiles#sujeto","Sujeto",{"_4557":627,"_25012":620,"_5":25261,"_21207":39063,"_9967":39064,"_1768":39065},[],"/docs/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_4557":628,"_25012":620,"_5":25261,"_21207":39067,"_9967":39068,"_1768":39069},[],"/docs/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_4557":629,"_25012":620,"_5":25261,"_21207":39071,"_9967":39072,"_1768":39073},[],"/docs/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_4557":630,"_25012":620,"_5":25261,"_21207":39075,"_9967":39076,"_1768":39077},[],"/docs/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_4557":631,"_25012":620,"_5":25261,"_21207":39079,"_9967":39080,"_1768":39081},[],"/docs/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_4557":632,"_25012":620,"_5":25261,"_21207":39083,"_9967":39084,"_1768":39085},[],"/docs/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_4557":633,"_25012":620,"_5":25261,"_21207":39087,"_9967":39088,"_1768":39089},[],"/docs/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_4557":634,"_25012":620,"_5":25261,"_21207":39091,"_9967":39092,"_1768":39093},[],"/docs/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_4557":635,"_25012":620,"_5":25261,"_21207":39095,"_9967":39096,"_1768":39097},[],"/docs/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_4557":636,"_25012":620,"_5":25261,"_21207":39099,"_9967":39100,"_1768":39101},[],"/docs/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_4557":637,"_25012":620,"_5":25261,"_21207":39103,"_9967":39104,"_1768":39105},[],"/docs/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_4557":638,"_25012":620,"_21207":39107,"_5":25256,"_9967":620,"_1768":39108},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_4557":639,"_25012":620,"_21207":39110,"_5":25256,"_9967":39048,"_1768":39111},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_4557":640,"_25012":620,"_21207":39113,"_5":25256,"_9967":39048,"_1768":39114},[],"La fecha final nunca debe superar la de la CA emisora.",{"_4557":641,"_25012":620,"_21207":39116,"_5":25256,"_9967":39052,"_1768":39117},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_4557":642,"_25012":620,"_21207":39119,"_5":25256,"_9967":39056,"_1768":39120},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_4557":643,"_25012":620,"_21207":39122,"_5":25256,"_9967":39056,"_1768":39123},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_4557":644,"_25012":620,"_21207":39125,"_5":25256,"_9967":39056,"_1768":39126},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_4557":645,"_25012":620,"_21207":39128,"_5":25256,"_9967":39060,"_1768":39129},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_4557":646,"_25012":620,"_21207":39131,"_5":25256,"_9967":39064,"_1768":39132},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_4557":647,"_25012":620,"_21207":39134,"_5":25256,"_9967":39064,"_1768":39135},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_4557":648,"_25012":620,"_21207":39137,"_5":25256,"_9967":39068,"_1768":39138},[],"La aplicación criptográfica puede:",{"_4557":649,"_25012":620,"_21207":39140,"_5":25256,"_9967":39068,"_1768":39141},[],"permitir o bloquear claves RSA;",{"_4557":650,"_25012":620,"_21207":39143,"_5":25256,"_9967":39068,"_1768":39144},[],"limitar los tamaños RSA admitidos;",{"_4557":651,"_25012":620,"_21207":39146,"_5":25256,"_9967":39068,"_1768":39147},[],"permitir o bloquear claves ECDSA;",{"_4557":652,"_25012":620,"_21207":39149,"_5":25256,"_9967":39068,"_1768":39150},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_4557":653,"_25012":620,"_21207":39152,"_5":25256,"_9967":39068,"_1768":39153},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_4557":654,"_25012":620,"_21207":39155,"_5":25256,"_9967":39072,"_1768":39156},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_4557":655,"_25012":620,"_21207":39158,"_5":25256,"_9967":39072,"_1768":39159},[],"Perfil enviado dentro de la operación.",{"_4557":656,"_25012":620,"_21207":39161,"_5":25256,"_9967":39072,"_1768":39162},[],"Identificador de perfil enviado en la operación.",{"_4557":657,"_25012":620,"_21207":39164,"_5":25256,"_9967":39072,"_1768":39165},[],"Perfil predeterminado asociado a la CA.",{"_4557":658,"_25012":620,"_21207":39167,"_5":25256,"_9967":39072,"_1768":39168},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_4557":659,"_25012":620,"_21207":39170,"_5":25256,"_9967":39080,"_1768":39171},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_4557":660,"_25012":620,"_21207":39173,"_5":25256,"_9967":39084,"_1768":39174},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_4557":661,"_25012":620,"_21207":39176,"_5":25256,"_9967":39088,"_1768":39177},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_4557":662,"_25012":620,"_21207":39179,"_5":25256,"_9967":39092,"_1768":39180},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_4557":663,"_25012":620,"_21207":39182,"_5":25256,"_9967":39096,"_1768":39183},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_4557":664,"_25012":620,"_21207":39185,"_5":25256,"_9967":39100,"_1768":39186},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_4557":665,"_25012":620,"_21207":39188,"_5":25256,"_9967":39100,"_1768":39189},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_4557":666,"_25012":620,"_21207":39191,"_5":25256,"_9967":39100,"_1768":39192},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_4557":667,"_25012":620,"_21207":39194,"_5":25256,"_9967":39100,"_1768":39195},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_4557":668,"_25012":620,"_21207":39197,"_5":25256,"_9967":39104,"_1768":39198},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_4557":669,"_25012":620,"_21207":39200,"_5":25256,"_9967":39104,"_1768":39201},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_4557":670,"_25012":670,"_5":25251,"_1768":39203,"_25264":39204,"_21207":39205,"_9967":670},"Validación de certificados",[37104,38188,38341],[],{"_4557":671,"_25012":670,"_21207":39207,"_5":25256,"_9967":670,"_1768":39208},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_4557":672,"_25012":670,"_5":25261,"_21207":39210,"_9967":39211,"_1768":39212},[],"/docs/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_4557":673,"_25012":670,"_21207":39214,"_5":25256,"_9967":670,"_1768":39215},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_4557":674,"_25012":670,"_21207":39217,"_5":25256,"_9967":39211,"_1768":39218},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_4557":675,"_25012":670,"_21207":39220,"_5":25256,"_9967":39211,"_1768":39221},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_4557":676,"_25012":670,"_21207":39223,"_5":25256,"_9967":39211,"_1768":39224},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_4557":677,"_25012":670,"_21207":39226,"_5":25256,"_9967":39211,"_1768":39227},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_4557":678,"_25012":670,"_21207":39229,"_5":25256,"_9967":39211,"_1768":39230},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_4557":679,"_25012":679,"_5":25251,"_1768":39232,"_25264":39233,"_21207":39234,"_9967":679},"Certificados",[37104,38188,38341],[],{"_4557":680,"_25012":679,"_21207":39236,"_5":25256,"_9967":679,"_1768":39237},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_4557":681,"_25012":679,"_5":25261,"_21207":39239,"_9967":39240,"_1768":39241},[],"/docs/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_4557":682,"_25012":679,"_5":25261,"_21207":39243,"_9967":39244,"_1768":39245},[],"/docs/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_4557":683,"_25012":679,"_5":25261,"_21207":39247,"_9967":39248,"_1768":39249},[],"/docs/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_4557":684,"_25012":679,"_5":25261,"_21207":39251,"_9967":39252,"_1768":39253},[],"/docs/platform/pki/certificates#abre-la-acción","Abre la acción",{"_4557":685,"_25012":679,"_5":25261,"_21207":39255,"_9967":39256,"_1768":39257},[],"/docs/platform/pki/certificates#elige-una-razón","Elige una razón",{"_4557":686,"_25012":679,"_5":25261,"_21207":39259,"_9967":39260,"_1768":39261},[],"/docs/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_4557":687,"_25012":679,"_5":25261,"_21207":39263,"_9967":39264,"_1768":39265},[],"/docs/platform/pki/certificates#continúa","Continúa",{"_4557":688,"_25012":679,"_21207":39267,"_5":25256,"_9967":679,"_1768":39268},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_4557":689,"_25012":679,"_21207":39270,"_5":25256,"_9967":39240,"_1768":39271},[],"Abre **Certificates** y filtra por:",{"_4557":690,"_25012":679,"_21207":39273,"_5":25256,"_9967":39240,"_1768":39274},[],"`Common Name` del sujeto.",{"_4557":691,"_25012":679,"_21207":39276,"_5":25256,"_9967":39240,"_1768":39277},[],"Número de serie.",{"_4557":692,"_25012":679,"_21207":39279,"_5":25256,"_9967":39240,"_1768":39280},[],"Estado.",{"_4557":693,"_25012":679,"_21207":39282,"_5":25256,"_9967":39240,"_1768":39283},[],"Autoridad emisora.",{"_4557":694,"_25012":679,"_21207":39285,"_5":25256,"_9967":39240,"_1768":39286},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_4557":695,"_25012":679,"_21207":39288,"_5":25256,"_9967":39244,"_1768":39289},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_4557":696,"_25012":679,"_21207":39291,"_5":25256,"_9967":39248,"_1768":39292},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_4557":697,"_25012":679,"_21207":39294,"_5":25256,"_9967":39252,"_1768":39295},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_4557":698,"_25012":679,"_21207":39297,"_5":25256,"_9967":39256,"_1768":39298},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_4557":699,"_25012":679,"_21207":39300,"_5":25256,"_9967":39260,"_1768":39301},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_4557":700,"_25012":679,"_21207":39303,"_5":25256,"_9967":39260,"_1768":39304},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_4557":701,"_25012":679,"_21207":39306,"_5":25256,"_9967":39264,"_1768":39307},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_4557":702,"_25012":679,"_21207":39309,"_5":25256,"_9967":39264,"_1768":39310},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_4557":703,"_25012":703,"_5":25251,"_1768":39312,"_25264":39313,"_21207":39315,"_9967":703},"Arquitectura de la plataforma",[37104,38188,39314],"Conceptos",[],{"_4557":704,"_25012":703,"_21207":39317,"_5":25256,"_9967":703,"_1768":39318},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_4557":705,"_25012":703,"_5":25261,"_21207":39320,"_9967":39321,"_1768":39322},[],"/docs/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_4557":706,"_25012":703,"_5":25261,"_21207":39324,"_9967":39325,"_1768":39326},[],"/docs/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_4557":707,"_25012":703,"_5":25261,"_21207":39328,"_9967":39329,"_1768":39330},[],"/docs/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_4557":708,"_25012":703,"_5":25261,"_21207":39332,"_9967":39333,"_1768":39334},[],"/docs/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_4557":709,"_25012":703,"_5":25261,"_21207":39336,"_9967":39337,"_1768":39338},[],"/docs/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_4557":710,"_25012":703,"_21207":39340,"_5":25256,"_9967":703,"_1768":39341},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_4557":711,"_25012":703,"_21207":39343,"_5":25256,"_9967":39321,"_1768":39344},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_4557":712,"_25012":703,"_21207":39346,"_5":25256,"_9967":39325,"_1768":39347},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_4557":713,"_25012":703,"_21207":39349,"_5":25256,"_9967":39329,"_1768":39350},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_4557":714,"_25012":703,"_21207":39352,"_5":25256,"_9967":39333,"_1768":39353},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_4557":715,"_25012":703,"_21207":39355,"_5":25256,"_9967":39337,"_1768":39356},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_4557":716,"_25012":716,"_5":25251,"_1768":39358,"_25264":39359,"_21207":39360,"_9967":716},"Ciclo de vida de un certificado",[37104,38188,39314],[],{"_4557":717,"_25012":716,"_21207":39362,"_5":25256,"_9967":716,"_1768":39363},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_4557":718,"_25012":716,"_5":25261,"_21207":39365,"_9967":39366,"_1768":39367},[],"/docs/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_4557":719,"_25012":716,"_5":25261,"_21207":39369,"_9967":39370,"_1768":39371},[],"/docs/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_4557":720,"_25012":716,"_5":25261,"_21207":39373,"_9967":39374,"_1768":39375},[],"/docs/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_4557":721,"_25012":716,"_5":25261,"_21207":39377,"_9967":39378,"_1768":39379},[],"/docs/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_4557":722,"_25012":716,"_5":25261,"_21207":39381,"_9967":39382,"_1768":39383},[],"/docs/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_4557":723,"_25012":716,"_5":25261,"_21207":39385,"_9967":39386,"_1768":39387},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_4557":724,"_25012":716,"_5":25261,"_21207":39389,"_9967":39390,"_1768":39391},[],"/docs/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_4557":725,"_25012":716,"_5":25261,"_21207":39393,"_9967":39394,"_1768":39395},[],"/docs/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_4557":726,"_25012":716,"_5":25261,"_21207":39397,"_9967":39398,"_1768":39399},[],"/docs/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_4557":727,"_25012":716,"_5":25261,"_21207":39401,"_9967":39402,"_1768":39403},[],"/docs/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_4557":728,"_25012":716,"_21207":39405,"_5":25256,"_9967":716,"_1768":39406},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_4557":729,"_25012":716,"_21207":39408,"_5":25256,"_9967":39370,"_1768":39409},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_4557":730,"_25012":716,"_21207":39411,"_5":25256,"_9967":39374,"_1768":39412},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_4557":731,"_25012":716,"_21207":39414,"_5":25256,"_9967":39378,"_1768":39415},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_4557":732,"_25012":716,"_21207":39417,"_5":25256,"_9967":39382,"_1768":39418},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_4557":733,"_25012":716,"_21207":39420,"_5":25256,"_9967":39386,"_1768":39421},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_4557":734,"_25012":716,"_21207":39423,"_5":25256,"_9967":39390,"_1768":39424},[],"Lamassu persiste cuatro estados X.509:",{"_4557":735,"_25012":716,"_21207":39426,"_5":25256,"_9967":39390,"_1768":39427},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_4557":736,"_25012":716,"_21207":39429,"_5":25256,"_9967":39390,"_1768":39430},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_4557":737,"_25012":716,"_21207":39432,"_5":25256,"_9967":39390,"_1768":39433},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_4557":738,"_25012":716,"_21207":39435,"_5":25256,"_9967":39390,"_1768":39436},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_4557":739,"_25012":716,"_21207":39438,"_5":25256,"_9967":39390,"_1768":39439},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_4557":740,"_25012":716,"_21207":39441,"_5":25256,"_9967":39394,"_1768":39442},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_4557":741,"_25012":716,"_21207":39444,"_5":25256,"_9967":39394,"_1768":39445},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_4557":742,"_25012":716,"_21207":39447,"_5":25256,"_9967":39394,"_1768":39448},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_4557":743,"_25012":716,"_21207":39450,"_5":25256,"_9967":39398,"_1768":39451},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_4557":744,"_25012":716,"_21207":39453,"_5":25256,"_9967":39398,"_1768":39454},[],"Antes de confirmar:",{"_4557":745,"_25012":716,"_21207":39456,"_5":25256,"_9967":39398,"_1768":39457},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_4557":746,"_25012":716,"_21207":39459,"_5":25256,"_9967":39398,"_1768":39460},[],"Distribuye la nueva cadena de confianza.",{"_4557":747,"_25012":716,"_21207":39462,"_5":25256,"_9967":39398,"_1768":39463},[],"Reemite las identidades necesarias.",{"_4557":748,"_25012":716,"_21207":39465,"_5":25256,"_9967":39398,"_1768":39466},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_4557":749,"_25012":716,"_21207":39468,"_5":25256,"_9967":39398,"_1768":39469},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_4557":750,"_25012":716,"_21207":39471,"_5":25256,"_9967":39398,"_1768":39472},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_4557":751,"_25012":716,"_21207":39474,"_5":25256,"_9967":39402,"_1768":39475},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_4557":752,"_25012":716,"_21207":39477,"_5":25256,"_9967":39402,"_1768":39478},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_4557":753,"_25012":716,"_21207":39480,"_5":25256,"_9967":39402,"_1768":39481},[],"Cambios de estado y razones de revocación.",{"_4557":754,"_25012":716,"_21207":39483,"_5":25256,"_9967":39402,"_1768":39484},[],"Publicación y vigencia de OCSP y CRLs.",{"_4557":755,"_25012":716,"_21207":39486,"_5":25256,"_9967":39402,"_1768":39487},[],"Dependencias que todavía presentan un certificado sustituido.",{"_4557":756,"_25012":716,"_21207":39489,"_5":25256,"_9967":39402,"_1768":39490},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_4557":757,"_25012":757,"_5":25251,"_1768":39492,"_25264":39493,"_21207":39494,"_9967":757},"Glosario",[37104,38188,39314],[],{"_4557":758,"_25012":757,"_21207":39496,"_5":25256,"_9967":757,"_1768":39497},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_4557":759,"_25012":757,"_5":25261,"_21207":39499,"_9967":39500,"_1768":39501},[],"/docs/platform/pki/concepts/glossary#ac","A–C",{"_4557":760,"_25012":757,"_5":25261,"_21207":39503,"_9967":39504,"_1768":39505},[],"/docs/platform/pki/concepts/glossary#dk","D–K",{"_4557":761,"_25012":757,"_5":25261,"_21207":39507,"_9967":39508,"_1768":39509},[],"/docs/platform/pki/concepts/glossary#mr","M–R",{"_4557":762,"_25012":757,"_5":25261,"_21207":39511,"_9967":39512,"_1768":39513},[],"/docs/platform/pki/concepts/glossary#sz","S–Z",{"_4557":763,"_25012":757,"_21207":39515,"_5":25256,"_9967":39500,"_1768":39516},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_4557":764,"_25012":757,"_21207":39518,"_5":25256,"_9967":39500,"_1768":39519},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_4557":765,"_25012":757,"_21207":39521,"_5":25256,"_9967":39500,"_1768":39522},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_4557":766,"_25012":757,"_21207":39524,"_5":25256,"_9967":39500,"_1768":39525},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_4557":767,"_25012":757,"_21207":39527,"_5":25256,"_9967":39500,"_1768":39528},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_4557":768,"_25012":757,"_21207":39530,"_5":25256,"_9967":39500,"_1768":39531},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_4557":769,"_25012":757,"_21207":39533,"_5":25256,"_9967":39500,"_1768":39534},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_4557":770,"_25012":757,"_21207":39536,"_5":25256,"_9967":39500,"_1768":39537},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_4557":771,"_25012":757,"_21207":39539,"_5":25256,"_9967":39504,"_1768":39540},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_4557":772,"_25012":757,"_21207":39542,"_5":25256,"_9967":39504,"_1768":39543},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_4557":773,"_25012":757,"_21207":39545,"_5":25256,"_9967":39504,"_1768":39546},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_4557":774,"_25012":757,"_21207":39548,"_5":25256,"_9967":39504,"_1768":39549},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_4557":775,"_25012":757,"_21207":39551,"_5":25256,"_9967":39504,"_1768":39552},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_4557":776,"_25012":757,"_21207":39554,"_5":25256,"_9967":39504,"_1768":39555},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_4557":777,"_25012":757,"_21207":39557,"_5":25256,"_9967":39504,"_1768":39558},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_4557":778,"_25012":757,"_21207":39560,"_5":25256,"_9967":39504,"_1768":39561},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_4557":779,"_25012":757,"_21207":39563,"_5":25256,"_9967":39504,"_1768":39564},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_4557":780,"_25012":757,"_21207":39566,"_5":25256,"_9967":39508,"_1768":39567},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_4557":781,"_25012":757,"_21207":39569,"_5":25256,"_9967":39508,"_1768":39570},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_4557":782,"_25012":757,"_21207":39572,"_5":25256,"_9967":39508,"_1768":39573},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_4557":783,"_25012":757,"_21207":39575,"_5":25256,"_9967":39508,"_1768":39576},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_4557":784,"_25012":757,"_21207":39578,"_5":25256,"_9967":39508,"_1768":39579},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_4557":785,"_25012":757,"_21207":39581,"_5":25256,"_9967":39508,"_1768":39582},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_4557":786,"_25012":757,"_21207":39584,"_5":25256,"_9967":39508,"_1768":39585},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_4557":787,"_25012":757,"_21207":39587,"_5":25256,"_9967":39508,"_1768":39588},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_4557":788,"_25012":757,"_21207":39590,"_5":25256,"_9967":39512,"_1768":39591},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_4557":789,"_25012":757,"_21207":39593,"_5":25256,"_9967":39512,"_1768":39594},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_4557":790,"_25012":757,"_21207":39596,"_5":25256,"_9967":39512,"_1768":39597},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_4557":791,"_25012":757,"_21207":39599,"_5":25256,"_9967":39512,"_1768":39600},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_4557":792,"_25012":757,"_21207":39602,"_5":25256,"_9967":39512,"_1768":39603},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_4557":793,"_25012":793,"_5":25251,"_1768":39605,"_25264":39606,"_21207":39607,"_9967":793},"Cómo funciona Lamassu",[37104,38188,39314],[],{"_4557":794,"_25012":793,"_21207":39609,"_5":25256,"_9967":793,"_1768":39610},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_4557":795,"_25012":793,"_5":25261,"_21207":39612,"_9967":39613,"_1768":39614},[],"/docs/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_4557":796,"_25012":793,"_5":25261,"_21207":39616,"_9967":39617,"_1768":39618},[],"/docs/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_4557":797,"_25012":793,"_21207":39620,"_5":25256,"_9967":793,"_1768":39621},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_4557":798,"_25012":793,"_21207":39623,"_5":25256,"_9967":39613,"_1768":39624},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_4557":799,"_25012":793,"_21207":39626,"_5":25256,"_9967":39613,"_1768":39627},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_4557":800,"_25012":793,"_21207":39629,"_5":25256,"_9967":39613,"_1768":39630},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_4557":801,"_25012":793,"_21207":39632,"_5":25256,"_9967":39613,"_1768":39633},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_4557":802,"_25012":793,"_21207":39635,"_5":25256,"_9967":39613,"_1768":39636},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_4557":803,"_25012":793,"_21207":39638,"_5":25256,"_9967":39617,"_1768":39639},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_4557":804,"_25012":793,"_21207":39641,"_5":25256,"_9967":39617,"_1768":39642},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_4557":805,"_25012":793,"_21207":39644,"_5":25256,"_9967":39617,"_1768":39645},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_4557":806,"_25012":793,"_21207":39647,"_5":25256,"_9967":39617,"_1768":39648},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_4557":807,"_25012":793,"_21207":39650,"_5":25256,"_9967":39617,"_1768":39651},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_4557":808,"_25012":793,"_21207":39653,"_5":25256,"_9967":39617,"_1768":39654},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_4557":809,"_25012":793,"_21207":39656,"_5":25256,"_9967":39617,"_1768":39657},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4557":810,"_25012":810,"_5":25251,"_1768":39659,"_25264":39660,"_21207":39661,"_9967":810},"Modelo de confianza",[37104,38188,39314],[],{"_4557":811,"_25012":810,"_21207":39663,"_5":25256,"_9967":810,"_1768":39664},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_4557":812,"_25012":810,"_5":25261,"_21207":39666,"_9967":39667,"_1768":39668},[],"/docs/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_4557":813,"_25012":810,"_5":25261,"_21207":39670,"_9967":39671,"_1768":39672},[],"/docs/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_4557":814,"_25012":810,"_5":25261,"_21207":39674,"_9967":39675,"_1768":39676},[],"/docs/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_4557":815,"_25012":810,"_5":25261,"_21207":39678,"_9967":39679,"_1768":39680},[],"/docs/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_4557":816,"_25012":810,"_5":25261,"_21207":39682,"_9967":39683,"_1768":39684},[],"/docs/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_4557":817,"_25012":810,"_5":25261,"_21207":39686,"_9967":39687,"_1768":39688},[],"/docs/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_4557":818,"_25012":810,"_5":25261,"_21207":39690,"_9967":39691,"_1768":39692},[],"/docs/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_4557":819,"_25012":810,"_5":25261,"_21207":39694,"_9967":39695,"_1768":39696},[],"/docs/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_4557":820,"_25012":810,"_5":25261,"_21207":39698,"_9967":39699,"_1768":39700},[],"/docs/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_4557":821,"_25012":810,"_5":25261,"_21207":39702,"_9967":39703,"_1768":39704},[],"/docs/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_4557":822,"_25012":810,"_21207":39706,"_5":25256,"_9967":810,"_1768":39707},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_4557":823,"_25012":810,"_21207":39709,"_5":25256,"_9967":39671,"_1768":39710},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_4557":824,"_25012":810,"_21207":39712,"_5":25256,"_9967":39675,"_1768":39713},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_4557":825,"_25012":810,"_21207":39715,"_5":25256,"_9967":39679,"_1768":39716},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_4557":826,"_25012":810,"_21207":39718,"_5":25256,"_9967":39683,"_1768":39719},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_4557":827,"_25012":810,"_21207":39721,"_5":25256,"_9967":39687,"_1768":39722},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_4557":828,"_25012":810,"_21207":39724,"_5":25256,"_9967":39687,"_1768":39725},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_4557":829,"_25012":810,"_21207":39727,"_5":25256,"_9967":39687,"_1768":39728},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_4557":830,"_25012":810,"_21207":39730,"_5":25256,"_9967":39687,"_1768":39731},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_4557":831,"_25012":810,"_21207":39733,"_5":25256,"_9967":39687,"_1768":39734},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_4557":832,"_25012":810,"_21207":39736,"_5":25256,"_9967":39687,"_1768":39737},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_4557":833,"_25012":810,"_21207":39739,"_5":25256,"_9967":39691,"_1768":39740},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_4557":834,"_25012":810,"_21207":39742,"_5":25256,"_9967":39691,"_1768":39743},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_4557":835,"_25012":810,"_21207":39745,"_5":25256,"_9967":39691,"_1768":39746},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_4557":836,"_25012":810,"_21207":39748,"_5":25256,"_9967":39691,"_1768":39749},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_4557":837,"_25012":810,"_21207":39751,"_5":25256,"_9967":39691,"_1768":39752},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_4557":838,"_25012":810,"_21207":39754,"_5":25256,"_9967":39695,"_1768":39755},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_4557":839,"_25012":810,"_21207":39757,"_5":25256,"_9967":39695,"_1768":39758},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_4557":840,"_25012":810,"_21207":39760,"_5":25256,"_9967":39695,"_1768":39761},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_4557":841,"_25012":810,"_21207":39763,"_5":25256,"_9967":39695,"_1768":39764},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_4557":842,"_25012":810,"_21207":39766,"_5":25256,"_9967":39695,"_1768":39767},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_4557":843,"_25012":810,"_21207":39769,"_5":25256,"_9967":39695,"_1768":39770},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_4557":844,"_25012":810,"_21207":39772,"_5":25256,"_9967":39699,"_1768":39773},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_4557":845,"_25012":810,"_21207":39775,"_5":25256,"_9967":39703,"_1768":39776},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_4557":846,"_25012":810,"_21207":39778,"_5":25256,"_9967":39703,"_1768":39779},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_4557":847,"_25012":810,"_21207":39781,"_5":25256,"_9967":39703,"_1768":39782},[],"Asigna perfiles explícitos a cada caso de uso.",{"_4557":848,"_25012":810,"_21207":39784,"_5":25256,"_9967":39703,"_1768":39785},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_4557":849,"_25012":810,"_21207":39787,"_5":25256,"_9967":39703,"_1768":39788},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_4557":850,"_25012":810,"_21207":39790,"_5":25256,"_9967":39703,"_1768":39791},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_4557":851,"_25012":810,"_21207":39793,"_5":25256,"_9967":39703,"_1768":39794},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_4557":852,"_25012":852,"_5":25251,"_1768":39796,"_25264":39797,"_21207":39798,"_9967":852},"Listas de revocación (CRL)",[37104,38188,38341],[],{"_4557":853,"_25012":852,"_21207":39800,"_5":25256,"_9967":852,"_1768":39801},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_4557":854,"_25012":852,"_5":25261,"_21207":39803,"_9967":39804,"_1768":39805},[],"/docs/platform/pki/crl#servicio-crl","Servicio CRL",{"_4557":855,"_25012":852,"_5":25261,"_21207":39807,"_9967":39808,"_1768":39809},[],"/docs/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_4557":856,"_25012":852,"_5":25261,"_21207":39811,"_9967":39812,"_1768":39813},[],"/docs/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_4557":857,"_25012":852,"_5":25261,"_21207":39815,"_9967":39816,"_1768":39817},[],"/docs/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_4557":858,"_25012":852,"_5":25261,"_21207":39819,"_9967":39820,"_1768":39821},[],"/docs/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_4557":859,"_25012":852,"_5":25261,"_21207":39823,"_9967":39824,"_1768":39825},[],"/docs/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_4557":860,"_25012":852,"_5":25261,"_21207":39827,"_9967":39828,"_1768":39829},[],"/docs/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_4557":861,"_25012":852,"_5":25261,"_21207":39831,"_9967":39832,"_1768":39833},[],"/docs/platform/pki/crl#referencias","Referencias",{"_4557":862,"_25012":852,"_21207":39835,"_5":25256,"_9967":39804,"_1768":39836},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_4557":863,"_25012":852,"_21207":39838,"_5":25256,"_9967":39804,"_1768":39839},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_4557":864,"_25012":852,"_21207":39841,"_5":25256,"_9967":39808,"_1768":39842},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_4557":865,"_25012":852,"_21207":39844,"_5":25256,"_9967":39808,"_1768":39845},[],"Los parámetros principales son:",{"_4557":866,"_25012":852,"_21207":39847,"_5":25256,"_9967":39808,"_1768":39848},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_4557":867,"_25012":852,"_21207":39850,"_5":25256,"_9967":39808,"_1768":39851},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_4557":868,"_25012":852,"_21207":39853,"_5":25256,"_9967":39808,"_1768":39854},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_4557":869,"_25012":852,"_21207":39856,"_5":25256,"_9967":39808,"_1768":39857},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_4557":870,"_25012":852,"_21207":39859,"_5":25256,"_9967":39808,"_1768":39860},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_4557":871,"_25012":852,"_21207":39862,"_5":25256,"_9967":39812,"_1768":39863},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_4557":872,"_25012":852,"_21207":39865,"_5":25256,"_9967":39812,"_1768":39866},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_4557":873,"_25012":852,"_21207":39868,"_5":25256,"_9967":39816,"_1768":39869},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_4557":874,"_25012":852,"_21207":39871,"_5":25256,"_9967":39816,"_1768":39872},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_4557":875,"_25012":852,"_21207":39874,"_5":25256,"_9967":39820,"_1768":39875},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_4557":876,"_25012":852,"_21207":39877,"_5":25256,"_9967":39820,"_1768":39878},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_4557":877,"_25012":852,"_21207":39880,"_5":25256,"_9967":39824,"_1768":39881},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_4557":878,"_25012":852,"_21207":39883,"_5":25256,"_9967":39824,"_1768":39884},[],"Método",{"_4557":879,"_25012":852,"_21207":39886,"_5":25256,"_9967":39824,"_1768":39887},[],"Ruta",{"_4557":880,"_25012":852,"_21207":39889,"_5":25256,"_9967":39824,"_1768":37475},[],{"_4557":881,"_25012":852,"_21207":39891,"_5":25256,"_9967":39824,"_1768":39892},[],"`GET`",{"_4557":882,"_25012":852,"_21207":39894,"_5":25256,"_9967":39824,"_1768":39895},[],"`/v1/roles/{ca-ski}`",{"_4557":883,"_25012":852,"_21207":39897,"_5":25256,"_9967":39824,"_1768":39898},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_4557":884,"_25012":852,"_21207":39900,"_5":25256,"_9967":39824,"_1768":39901},[],"`PUT`",{"_4557":885,"_25012":852,"_21207":39903,"_5":25256,"_9967":39824,"_1768":39895},[],{"_4557":886,"_25012":852,"_21207":39905,"_5":25256,"_9967":39824,"_1768":39906},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_4557":887,"_25012":852,"_21207":39908,"_5":25256,"_9967":39824,"_1768":39909},[],"Ejemplo de consulta del rol VA:",{"_4557":888,"_25012":852,"_21207":39911,"_5":25256,"_9967":39824,"_1768":39912},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_4557":889,"_25012":852,"_21207":39914,"_5":25256,"_9967":39828,"_1768":39915},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_4557":890,"_25012":852,"_21207":39917,"_5":25256,"_9967":39832,"_1768":39918},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_4557":891,"_25012":852,"_21207":39920,"_5":25256,"_9967":39832,"_1768":39921},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4557":892,"_25012":852,"_21207":39923,"_5":25256,"_9967":39832,"_1768":39924},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4557":893,"_25012":893,"_5":25251,"_1768":39926,"_25264":39927,"_21207":39928,"_9967":893},"Device Management Service",[37104,38188,38341],[],{"_4557":894,"_25012":893,"_21207":39930,"_5":25256,"_9967":893,"_1768":39931},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_4557":895,"_25012":893,"_5":25261,"_21207":39933,"_9967":39934,"_1768":37114},[],"/docs/platform/pki/device-enrollment#antes-de-empezar",{"_4557":896,"_25012":893,"_5":25261,"_21207":39936,"_9967":39937,"_1768":39938},[],"/docs/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_4557":897,"_25012":893,"_5":25261,"_21207":39940,"_9967":39941,"_1768":39942},[],"/docs/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_4557":898,"_25012":893,"_5":25261,"_21207":39944,"_9967":39945,"_1768":39946},[],"/docs/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_4557":899,"_25012":893,"_5":25261,"_21207":39948,"_9967":39949,"_1768":39950},[],"/docs/platform/pki/device-enrollment#configura-est","Configura EST",{"_4557":900,"_25012":893,"_5":25261,"_21207":39952,"_9967":39953,"_1768":39954},[],"/docs/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_4557":901,"_25012":893,"_5":25261,"_21207":39956,"_9967":39957,"_1768":39958},[],"/docs/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_4557":902,"_25012":893,"_5":25261,"_21207":39960,"_9967":39961,"_1768":39962},[],"/docs/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_4557":903,"_25012":893,"_5":25261,"_21207":39964,"_9967":39965,"_1768":39966},[],"/docs/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_4557":904,"_25012":893,"_5":25261,"_21207":39968,"_9967":39969,"_1768":39970},[],"/docs/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_4557":905,"_25012":893,"_21207":39972,"_5":25256,"_9967":893,"_1768":39973},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_4557":906,"_25012":893,"_21207":39975,"_5":25256,"_9967":893,"_1768":39976},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_4557":907,"_25012":893,"_21207":39978,"_5":25256,"_9967":39934,"_1768":39979},[],"Crea o importa al menos una CA activa.",{"_4557":908,"_25012":893,"_21207":39981,"_5":25256,"_9967":39934,"_1768":39982},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_4557":909,"_25012":893,"_21207":39984,"_5":25256,"_9967":39934,"_1768":39985},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_4557":910,"_25012":893,"_21207":39987,"_5":25256,"_9967":39934,"_1768":39988},[],"Asegúrate de tener permisos para administrar DMS.",{"_4557":911,"_25012":893,"_21207":39990,"_5":25256,"_9967":39941,"_1768":39991},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_4557":912,"_25012":893,"_21207":39993,"_5":25256,"_9967":39945,"_1768":39994},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_4557":913,"_25012":893,"_21207":39996,"_5":25256,"_9967":39949,"_1768":39997},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_4557":914,"_25012":893,"_21207":39999,"_5":25256,"_9967":39953,"_1768":40000},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_4557":915,"_25012":893,"_21207":40002,"_5":25256,"_9967":39957,"_1768":40003},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_4557":916,"_25012":893,"_21207":40005,"_5":25256,"_9967":39961,"_1768":40006},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_4557":917,"_25012":893,"_21207":40008,"_5":25256,"_9967":39961,"_1768":40009},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_4557":918,"_25012":893,"_21207":40011,"_5":25256,"_9967":39961,"_1768":40012},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_4557":919,"_25012":893,"_21207":40014,"_5":25256,"_9967":39965,"_1768":40015},[],"**Edit** modifica la política del DMS.",{"_4557":920,"_25012":893,"_21207":40017,"_5":25256,"_9967":39965,"_1768":40018},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_4557":921,"_25012":893,"_21207":40020,"_5":25256,"_9967":39965,"_1768":40021},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_4557":922,"_25012":893,"_21207":40023,"_5":25256,"_9967":39965,"_1768":40024},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_4557":923,"_25012":893,"_21207":40026,"_5":25256,"_9967":39965,"_1768":40027},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_4557":924,"_25012":893,"_21207":40029,"_5":25256,"_9967":39969,"_1768":40030},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_4557":925,"_25012":893,"_21207":40032,"_5":25256,"_9967":39969,"_1768":40033},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_4557":926,"_25012":926,"_5":25251,"_1768":40035,"_25264":40036,"_21207":40037,"_9967":926},"Dispositivos e identidades",[37104,38188,38341],[],{"_4557":927,"_25012":926,"_21207":40039,"_5":25256,"_9967":926,"_1768":40040},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_4557":928,"_25012":926,"_5":25261,"_21207":40042,"_9967":40043,"_1768":40044},[],"/docs/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_4557":929,"_25012":926,"_5":25261,"_21207":40046,"_9967":40047,"_1768":40048},[],"/docs/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_4557":930,"_25012":926,"_5":25261,"_21207":40050,"_9967":40051,"_1768":40052},[],"/docs/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_4557":931,"_25012":926,"_5":25261,"_21207":40054,"_9967":40055,"_1768":40056},[],"/docs/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_4557":932,"_25012":926,"_5":25261,"_21207":40058,"_9967":40059,"_1768":40060},[],"/docs/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_4557":933,"_25012":926,"_5":25261,"_21207":40062,"_9967":40063,"_1768":40064},[],"/docs/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_4557":934,"_25012":926,"_5":25261,"_21207":40066,"_9967":40067,"_1768":40068},[],"/docs/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_4557":935,"_25012":926,"_5":25261,"_21207":40070,"_9967":40071,"_1768":40072},[],"/docs/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_4557":936,"_25012":926,"_5":25261,"_21207":40074,"_9967":40075,"_1768":40076},[],"/docs/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_4557":937,"_25012":926,"_5":25261,"_21207":40078,"_9967":40079,"_1768":40080},[],"/docs/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_4557":938,"_25012":926,"_5":25261,"_21207":40082,"_9967":40083,"_1768":40084},[],"/docs/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_4557":939,"_25012":926,"_21207":40086,"_5":25256,"_9967":926,"_1768":40087},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_4557":940,"_25012":926,"_21207":40089,"_5":25256,"_9967":40043,"_1768":40090},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_4557":941,"_25012":926,"_21207":40092,"_5":25256,"_9967":40043,"_1768":40093},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_4557":942,"_25012":926,"_21207":40095,"_5":25256,"_9967":40043,"_1768":40096},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_4557":943,"_25012":926,"_21207":40098,"_5":25256,"_9967":40043,"_1768":40099},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_4557":944,"_25012":926,"_21207":40101,"_5":25256,"_9967":40043,"_1768":40102},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_4557":945,"_25012":926,"_21207":40104,"_5":25256,"_9967":40043,"_1768":40105},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_4557":946,"_25012":926,"_21207":40107,"_5":25256,"_9967":40043,"_1768":40108},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_4557":947,"_25012":926,"_21207":40110,"_5":25256,"_9967":40043,"_1768":40111},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_4557":948,"_25012":926,"_21207":40113,"_5":25256,"_9967":40047,"_1768":40114},[],"La vista de detalle separa dos perspectivas:",{"_4557":949,"_25012":926,"_21207":40116,"_5":25256,"_9967":40047,"_1768":40117},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_4557":950,"_25012":926,"_21207":40119,"_5":25256,"_9967":40047,"_1768":40120},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_4557":951,"_25012":926,"_21207":40122,"_5":25256,"_9967":40047,"_1768":40123},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_4557":952,"_25012":926,"_21207":40125,"_5":25256,"_9967":40051,"_1768":40126},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_4557":953,"_25012":926,"_21207":40128,"_5":25256,"_9967":40055,"_1768":40129},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_4557":954,"_25012":926,"_21207":40131,"_5":25256,"_9967":40059,"_1768":40132},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_4557":955,"_25012":926,"_21207":40134,"_5":25256,"_9967":40063,"_1768":40135},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_4557":956,"_25012":926,"_21207":40137,"_5":25256,"_9967":40067,"_1768":40138},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_4557":957,"_25012":926,"_21207":40140,"_5":25256,"_9967":40071,"_1768":40141},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_4557":958,"_25012":926,"_21207":40143,"_5":25256,"_9967":40071,"_1768":40144},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_4557":959,"_25012":926,"_21207":40146,"_5":25256,"_9967":40071,"_1768":40147},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_4557":960,"_25012":926,"_21207":40149,"_5":25256,"_9967":40071,"_1768":40150},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_4557":961,"_25012":926,"_21207":40152,"_5":25256,"_9967":40071,"_1768":40153},[],"Confirma la asignación.",{"_4557":962,"_25012":926,"_21207":40155,"_5":25256,"_9967":40071,"_1768":40156},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_4557":963,"_25012":926,"_21207":40158,"_5":25256,"_9967":40075,"_1768":40159},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_4557":964,"_25012":926,"_21207":40161,"_5":25256,"_9967":40075,"_1768":40162},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_4557":965,"_25012":926,"_21207":40164,"_5":25256,"_9967":40079,"_1768":40165},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_4557":966,"_25012":926,"_21207":40167,"_5":25256,"_9967":40079,"_1768":40168},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_4557":967,"_25012":926,"_21207":40170,"_5":25256,"_9967":40083,"_1768":40171},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4557":968,"_25012":926,"_21207":40173,"_5":25256,"_9967":40083,"_1768":40174},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_4557":969,"_25012":969,"_5":25251,"_1768":40176,"_25264":40177,"_21207":40178,"_9967":969},"Enrolamiento de dispositivos con EST",[37104,38188,38341],[],{"_4557":970,"_25012":969,"_21207":40180,"_5":25256,"_9967":969,"_1768":40181},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_4557":971,"_25012":969,"_5":25261,"_21207":40183,"_9967":40184,"_1768":40185},[],"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_4557":972,"_25012":969,"_5":25261,"_21207":40187,"_9967":40188,"_1768":40189},[],"/docs/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_4557":973,"_25012":969,"_5":25261,"_21207":40191,"_9967":40192,"_1768":37913},[],"/docs/platform/pki/est-enrollment#requisitos-previos",{"_4557":974,"_25012":969,"_5":25261,"_21207":40194,"_9967":40195,"_1768":40196},[],"/docs/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_4557":975,"_25012":969,"_5":25261,"_21207":40198,"_9967":40199,"_1768":40200},[],"/docs/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_4557":976,"_25012":969,"_5":25261,"_21207":40202,"_9967":40203,"_1768":40204},[],"/docs/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_4557":977,"_25012":969,"_5":25261,"_21207":40206,"_9967":40207,"_1768":40208},[],"/docs/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_4557":978,"_25012":969,"_5":25261,"_21207":40210,"_9967":40211,"_1768":40212},[],"/docs/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_4557":979,"_25012":969,"_5":25261,"_21207":40214,"_9967":40215,"_1768":40216},[],"/docs/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_4557":980,"_25012":969,"_5":25261,"_21207":40218,"_9967":40219,"_1768":40220},[],"/docs/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_4557":981,"_25012":969,"_5":25261,"_21207":40222,"_9967":40223,"_1768":40224},[],"/docs/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_4557":982,"_25012":969,"_5":25261,"_21207":40226,"_9967":40227,"_1768":37114},[],"/docs/platform/pki/est-enrollment#antes-de-empezar",{"_4557":983,"_25012":969,"_5":25261,"_21207":40229,"_9967":40230,"_1768":40231},[],"/docs/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_4557":984,"_25012":969,"_5":25261,"_21207":40233,"_9967":40234,"_1768":40235},[],"/docs/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_4557":985,"_25012":969,"_5":25261,"_21207":40237,"_9967":40238,"_1768":40239},[],"/docs/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_4557":986,"_25012":969,"_5":25261,"_21207":40241,"_9967":40242,"_1768":40243},[],"/docs/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_4557":987,"_25012":969,"_5":25261,"_21207":40245,"_9967":40246,"_1768":40247},[],"/docs/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_4557":988,"_25012":969,"_5":25261,"_21207":40249,"_9967":40250,"_1768":40251},[],"/docs/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_4557":989,"_25012":969,"_5":25261,"_21207":40253,"_9967":40254,"_1768":40255},[],"/docs/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_4557":990,"_25012":969,"_5":25261,"_21207":40257,"_9967":40258,"_1768":40259},[],"/docs/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_4557":991,"_25012":969,"_5":25261,"_21207":40261,"_9967":40262,"_1768":40263},[],"/docs/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_4557":992,"_25012":969,"_5":25261,"_21207":40265,"_9967":40266,"_1768":40267},[],"/docs/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_4557":993,"_25012":969,"_5":25261,"_21207":40269,"_9967":40270,"_1768":40271},[],"/docs/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_4557":994,"_25012":969,"_5":25261,"_21207":40273,"_9967":40274,"_1768":40275},[],"/docs/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_4557":995,"_25012":969,"_5":25261,"_21207":40277,"_9967":40278,"_1768":40279},[],"/docs/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_4557":996,"_25012":969,"_5":25261,"_21207":40281,"_9967":40282,"_1768":40283},[],"/docs/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_4557":997,"_25012":969,"_21207":40285,"_5":25256,"_9967":40184,"_1768":40286},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_4557":998,"_25012":969,"_21207":40288,"_5":25256,"_9967":40184,"_1768":40289},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_4557":999,"_25012":969,"_21207":40291,"_5":25256,"_9967":40184,"_1768":40292},[],"Esta guía está dividida en dos partes:",{"_4557":1000,"_25012":969,"_21207":40294,"_5":25256,"_9967":40184,"_1768":40295},[],"Configuración del DMS, para el administrador PKI.",{"_4557":1001,"_25012":969,"_21207":40297,"_5":25256,"_9967":40184,"_1768":40298},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_4557":1002,"_25012":969,"_21207":40300,"_5":25256,"_9967":40184,"_1768":40301},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_4557":1003,"_25012":969,"_21207":40303,"_5":25256,"_9967":40184,"_1768":40304},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_4557":1004,"_25012":969,"_21207":40306,"_5":25256,"_9967":40184,"_1768":40307},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_4557":1005,"_25012":969,"_21207":40309,"_5":25256,"_9967":40192,"_1768":40310},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_4557":1006,"_25012":969,"_21207":40312,"_5":25256,"_9967":40192,"_1768":40313},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_4557":1007,"_25012":969,"_21207":40315,"_5":25256,"_9967":40192,"_1768":40316},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_4557":1008,"_25012":969,"_21207":40318,"_5":25256,"_9967":40192,"_1768":40319},[],"Conviene separar cuatro bloques de configuración:",{"_4557":1009,"_25012":969,"_21207":40321,"_5":25256,"_9967":40192,"_1768":40322},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_4557":1010,"_25012":969,"_21207":40324,"_5":25256,"_9967":40192,"_1768":40325},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_4557":1011,"_25012":969,"_21207":40327,"_5":25256,"_9967":40192,"_1768":40328},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_4557":1012,"_25012":969,"_21207":40330,"_5":25256,"_9967":40192,"_1768":40331},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_4557":1013,"_25012":969,"_21207":40333,"_5":25256,"_9967":40199,"_1768":40334},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_4557":1014,"_25012":969,"_21207":40336,"_5":25256,"_9967":40199,"_1768":40337},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_4557":1015,"_25012":969,"_21207":40339,"_5":25256,"_9967":40199,"_1768":40340},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_4557":1016,"_25012":969,"_21207":40342,"_5":25256,"_9967":40199,"_1768":40343},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_4557":1017,"_25012":969,"_21207":40345,"_5":25256,"_9967":40203,"_1768":40346},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_4557":1018,"_25012":969,"_21207":40348,"_5":25256,"_9967":40203,"_1768":40349},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_4557":1019,"_25012":969,"_21207":40351,"_5":25256,"_9967":40203,"_1768":40352},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_4557":1020,"_25012":969,"_21207":40354,"_5":25256,"_9967":40203,"_1768":40355},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_4557":1021,"_25012":969,"_21207":40357,"_5":25256,"_9967":40203,"_1768":40358},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_4557":1022,"_25012":969,"_21207":40360,"_5":25256,"_9967":40203,"_1768":40361},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_4557":1023,"_25012":969,"_21207":40363,"_5":25256,"_9967":40203,"_1768":40364},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_4557":1024,"_25012":969,"_21207":40366,"_5":25256,"_9967":40203,"_1768":40367},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_4557":1025,"_25012":969,"_21207":40369,"_5":25256,"_9967":40203,"_1768":40370},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_4557":1026,"_25012":969,"_21207":40372,"_5":25256,"_9967":40203,"_1768":40373},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_4557":1027,"_25012":969,"_21207":40375,"_5":25256,"_9967":40203,"_1768":40376},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_4557":1028,"_25012":969,"_21207":40378,"_5":25256,"_9967":40203,"_1768":40379},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_4557":1029,"_25012":969,"_21207":40381,"_5":25256,"_9967":40203,"_1768":40382},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_4557":1030,"_25012":969,"_21207":40384,"_5":25256,"_9967":40203,"_1768":40385},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_4557":1031,"_25012":969,"_21207":40387,"_5":25256,"_9967":40207,"_1768":40388},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_4557":1032,"_25012":969,"_21207":40390,"_5":25256,"_9967":40207,"_1768":40391},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_4557":1033,"_25012":969,"_21207":40393,"_5":25256,"_9967":40207,"_1768":40394},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_4557":1034,"_25012":969,"_21207":40396,"_5":25256,"_9967":40207,"_1768":40397},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_4557":1035,"_25012":969,"_21207":40399,"_5":25256,"_9967":40207,"_1768":40400},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_4557":1036,"_25012":969,"_21207":40402,"_5":25256,"_9967":40207,"_1768":40403},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_4557":1037,"_25012":969,"_21207":40405,"_5":25256,"_9967":40211,"_1768":40406},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_4557":1038,"_25012":969,"_21207":40408,"_5":25256,"_9967":40211,"_1768":40409},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_4557":1039,"_25012":969,"_21207":40411,"_5":25256,"_9967":40211,"_1768":40412},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_4557":1040,"_25012":969,"_21207":40414,"_5":25256,"_9967":40211,"_1768":40415},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_4557":1041,"_25012":969,"_21207":40417,"_5":25256,"_9967":40211,"_1768":40418},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_4557":1042,"_25012":969,"_21207":40420,"_5":25256,"_9967":40211,"_1768":40421},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_4557":1043,"_25012":969,"_21207":40423,"_5":25256,"_9967":40211,"_1768":40424},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_4557":1044,"_25012":969,"_21207":40426,"_5":25256,"_9967":40215,"_1768":40427},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_4557":1045,"_25012":969,"_21207":40429,"_5":25256,"_9967":40215,"_1768":40430},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_4557":1046,"_25012":969,"_21207":40432,"_5":25256,"_9967":40215,"_1768":40433},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_4557":1047,"_25012":969,"_21207":40435,"_5":25256,"_9967":40215,"_1768":40436},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_4557":1048,"_25012":969,"_21207":40438,"_5":25256,"_9967":40219,"_1768":40439},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_4557":1049,"_25012":969,"_21207":40441,"_5":25256,"_9967":40219,"_1768":40442},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_4557":1050,"_25012":969,"_21207":40444,"_5":25256,"_9967":40219,"_1768":40445},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_4557":1051,"_25012":969,"_21207":40447,"_5":25256,"_9967":40219,"_1768":40448},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_4557":1052,"_25012":969,"_21207":40450,"_5":25256,"_9967":40223,"_1768":40451},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_4557":1053,"_25012":969,"_21207":40453,"_5":25256,"_9967":40223,"_1768":40454},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_4557":1054,"_25012":969,"_21207":40456,"_5":25256,"_9967":40223,"_1768":40457},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_4557":1055,"_25012":969,"_21207":40459,"_5":25256,"_9967":40227,"_1768":40460},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_4557":1056,"_25012":969,"_21207":40462,"_5":25256,"_9967":40227,"_1768":40463},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_4557":1057,"_25012":969,"_21207":40465,"_5":25256,"_9967":40227,"_1768":40466},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_4557":1058,"_25012":969,"_21207":40468,"_5":25256,"_9967":40227,"_1768":40469},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_4557":1059,"_25012":969,"_21207":40471,"_5":25256,"_9967":40227,"_1768":40472},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_4557":1060,"_25012":969,"_21207":40474,"_5":25256,"_9967":40227,"_1768":40475},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_4557":1061,"_25012":969,"_21207":40477,"_5":25256,"_9967":40230,"_1768":40478},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_4557":1062,"_25012":969,"_21207":40480,"_5":25256,"_9967":40230,"_1768":40481},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_4557":1063,"_25012":969,"_21207":40483,"_5":25256,"_9967":40230,"_1768":40484},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_4557":1064,"_25012":969,"_21207":40486,"_5":25256,"_9967":40230,"_1768":40487},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_4557":1065,"_25012":969,"_21207":40489,"_5":25256,"_9967":40234,"_1768":40490},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_4557":1066,"_25012":969,"_21207":40492,"_5":25256,"_9967":40234,"_1768":40493},[],"Modo (`AuthMode`)",{"_4557":1067,"_25012":969,"_21207":40495,"_5":25256,"_9967":40234,"_1768":37475},[],{"_4557":1068,"_25012":969,"_21207":40497,"_5":25256,"_9967":40234,"_1768":40498},[],"Credencial esperada",{"_4557":1069,"_25012":969,"_21207":40500,"_5":25256,"_9967":40234,"_1768":40501},[],"Aplica en enroll",{"_4557":1070,"_25012":969,"_21207":40503,"_5":25256,"_9967":40234,"_1768":40504},[],"Aplica en reenroll",{"_4557":1071,"_25012":969,"_21207":40506,"_5":25256,"_9967":40234,"_1768":40507},[],"`CLIENT_CERTIFICATE`",{"_4557":1072,"_25012":969,"_21207":40509,"_5":25256,"_9967":40234,"_1768":40510},[],"mTLS con certificado X.509",{"_4557":1073,"_25012":969,"_21207":40512,"_5":25256,"_9967":40234,"_1768":40513},[],"Certificado y clave privada cliente",{"_4557":1074,"_25012":969,"_21207":40515,"_5":25256,"_9967":40234,"_1768":40516},[],"Sí",{"_4557":1075,"_25012":969,"_21207":40518,"_5":25256,"_9967":40234,"_1768":40519},[],"Sí (con el certificado en vigor)",{"_4557":1076,"_25012":969,"_21207":40521,"_5":25256,"_9967":40234,"_1768":40522},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_4557":1077,"_25012":969,"_21207":40524,"_5":25256,"_9967":40234,"_1768":40525},[],"mTLS más validación por webhook",{"_4557":1078,"_25012":969,"_21207":40527,"_5":25256,"_9967":40234,"_1768":40528},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_4557":1079,"_25012":969,"_21207":40530,"_5":25256,"_9967":40234,"_1768":40516},[],{"_4557":1080,"_25012":969,"_21207":40532,"_5":25256,"_9967":40234,"_1768":40533},[],"No como combinación; en reenroll no mantiene ambos controles",{"_4557":1081,"_25012":969,"_21207":40535,"_5":25256,"_9967":40234,"_1768":40536},[],"`EXTERNAL_WEBHOOK`",{"_4557":1082,"_25012":969,"_21207":40538,"_5":25256,"_9967":40234,"_1768":40539},[],"Webhook externo de autorización",{"_4557":1083,"_25012":969,"_21207":40541,"_5":25256,"_9967":40234,"_1768":40542},[],"Ninguna en el canal TLS",{"_4557":1084,"_25012":969,"_21207":40544,"_5":25256,"_9967":40234,"_1768":40516},[],{"_4557":1085,"_25012":969,"_21207":40546,"_5":25256,"_9967":40234,"_1768":40547},[],"No, degrada a `NO_AUTH`",{"_4557":1086,"_25012":969,"_21207":40549,"_5":25256,"_9967":40234,"_1768":40550},[],"`NO_AUTH`",{"_4557":1087,"_25012":969,"_21207":40552,"_5":25256,"_9967":40234,"_1768":40553},[],"Sin autenticación",{"_4557":1088,"_25012":969,"_21207":40555,"_5":25256,"_9967":40234,"_1768":40556},[],"Ninguna",{"_4557":1089,"_25012":969,"_21207":40558,"_5":25256,"_9967":40234,"_1768":40559},[],"Sí (uso restringido)",{"_4557":1090,"_25012":969,"_21207":40561,"_5":25256,"_9967":40234,"_1768":40559},[],{"_4557":1091,"_25012":969,"_21207":40563,"_5":25256,"_9967":40234,"_1768":40564},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_4557":1092,"_25012":969,"_21207":40566,"_5":25256,"_9967":40234,"_1768":40567},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_4557":1093,"_25012":969,"_21207":40569,"_5":25256,"_9967":40234,"_1768":40570},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_4557":1094,"_25012":969,"_21207":40572,"_5":25256,"_9967":40234,"_1768":40573},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_4557":1095,"_25012":969,"_21207":40575,"_5":25256,"_9967":40234,"_1768":40576},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_4557":1096,"_25012":969,"_21207":40578,"_5":25256,"_9967":40234,"_1768":40579},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_4557":1097,"_25012":969,"_21207":40581,"_5":25256,"_9967":40234,"_1768":40582},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_4557":1098,"_25012":969,"_21207":40584,"_5":25256,"_9967":40238,"_1768":40585},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_4557":1099,"_25012":969,"_21207":40587,"_5":25256,"_9967":40238,"_1768":40588},[],"`/cacerts`: descarga de la cadena de confianza.",{"_4557":1100,"_25012":969,"_21207":40590,"_5":25256,"_9967":40238,"_1768":40591},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_4557":1101,"_25012":969,"_21207":40593,"_5":25256,"_9967":40238,"_1768":40594},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_4557":1102,"_25012":969,"_21207":40596,"_5":25256,"_9967":40238,"_1768":40597},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_4557":1103,"_25012":969,"_21207":40599,"_5":25256,"_9967":40242,"_1768":40600},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_4557":1104,"_25012":969,"_21207":40602,"_5":25256,"_9967":40242,"_1768":40603},[],"`CADistributionSettings` permite decidir qué se publica:",{"_4557":1105,"_25012":969,"_21207":40605,"_5":25256,"_9967":40242,"_1768":40606},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_4557":1106,"_25012":969,"_21207":40608,"_5":25256,"_9967":40242,"_1768":40609},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_4557":1107,"_25012":969,"_21207":40611,"_5":25256,"_9967":40242,"_1768":40612},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_4557":1108,"_25012":969,"_21207":40614,"_5":25256,"_9967":40242,"_1768":40615},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_4557":1109,"_25012":969,"_21207":40617,"_5":25256,"_9967":40242,"_1768":40618},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_4557":1110,"_25012":969,"_21207":40620,"_5":25256,"_9967":40242,"_1768":40621},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_4557":1111,"_25012":969,"_21207":40623,"_5":25256,"_9967":40242,"_1768":40624},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_4557":1112,"_25012":969,"_21207":40626,"_5":25256,"_9967":40246,"_1768":40627},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_4557":1113,"_25012":969,"_21207":40629,"_5":25256,"_9967":40246,"_1768":40630},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_4557":1114,"_25012":969,"_21207":40632,"_5":25256,"_9967":40246,"_1768":40633},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_4557":1115,"_25012":969,"_21207":40635,"_5":25256,"_9967":40246,"_1768":40636},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_4557":1116,"_25012":969,"_21207":40638,"_5":25256,"_9967":40246,"_1768":40639},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_4557":1117,"_25012":969,"_21207":40641,"_5":25256,"_9967":40246,"_1768":40642},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_4557":1118,"_25012":969,"_21207":40644,"_5":25256,"_9967":40246,"_1768":40645},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_4557":1119,"_25012":969,"_21207":40647,"_5":25256,"_9967":40250,"_1768":40648},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_4557":1120,"_25012":969,"_21207":40650,"_5":25256,"_9967":40250,"_1768":40651},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_4557":1121,"_25012":969,"_21207":40653,"_5":25256,"_9967":40250,"_1768":40654},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_4557":1122,"_25012":969,"_21207":40656,"_5":25256,"_9967":40250,"_1768":40657},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_4557":1123,"_25012":969,"_21207":40659,"_5":25256,"_9967":40250,"_1768":40660},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_4557":1124,"_25012":969,"_21207":40662,"_5":25256,"_9967":40250,"_1768":40663},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_4557":1125,"_25012":969,"_21207":40665,"_5":25256,"_9967":40250,"_1768":40666},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_4557":1126,"_25012":969,"_21207":40668,"_5":25256,"_9967":40250,"_1768":40669},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_4557":1127,"_25012":969,"_21207":40671,"_5":25256,"_9967":40250,"_1768":40672},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_4557":1128,"_25012":969,"_21207":40674,"_5":25256,"_9967":40254,"_1768":40675},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_4557":1129,"_25012":969,"_21207":40677,"_5":25256,"_9967":40254,"_1768":40678},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_4557":1130,"_25012":969,"_21207":40680,"_5":25256,"_9967":40254,"_1768":40681},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_4557":1131,"_25012":969,"_21207":40683,"_5":25256,"_9967":40254,"_1768":40684},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_4557":1132,"_25012":969,"_21207":40686,"_5":25256,"_9967":40254,"_1768":40687},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_4557":1133,"_25012":969,"_21207":40689,"_5":25256,"_9967":40254,"_1768":40690},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_4557":1134,"_25012":969,"_21207":40692,"_5":25256,"_9967":40254,"_1768":40693},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_4557":1135,"_25012":969,"_21207":40695,"_5":25256,"_9967":40254,"_1768":40696},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_4557":1136,"_25012":969,"_21207":40698,"_5":25256,"_9967":40254,"_1768":40699},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_4557":1137,"_25012":969,"_21207":40701,"_5":25256,"_9967":40254,"_1768":40702},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_4557":1138,"_25012":969,"_21207":40704,"_5":25256,"_9967":40254,"_1768":40705},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_4557":1139,"_25012":969,"_21207":40707,"_5":25256,"_9967":40254,"_1768":40708},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_4557":1140,"_25012":969,"_21207":40710,"_5":25256,"_9967":40258,"_1768":40711},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_4557":1141,"_25012":969,"_21207":40713,"_5":25256,"_9967":40262,"_1768":40714},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_4557":1142,"_25012":969,"_21207":40716,"_5":25256,"_9967":40266,"_1768":40717},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_4557":1143,"_25012":969,"_21207":40719,"_5":25256,"_9967":40270,"_1768":40720},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_4557":1144,"_25012":969,"_21207":40722,"_5":25256,"_9967":40270,"_1768":40723},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_4557":1145,"_25012":969,"_21207":40725,"_5":25256,"_9967":40270,"_1768":40726},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_4557":1146,"_25012":969,"_21207":40728,"_5":25256,"_9967":40270,"_1768":40729},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_4557":1147,"_25012":969,"_21207":40731,"_5":25256,"_9967":40278,"_1768":40732},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_4557":1148,"_25012":969,"_21207":40734,"_5":25256,"_9967":40278,"_1768":40735},[],"HTTP",{"_4557":1149,"_25012":969,"_21207":40737,"_5":25256,"_9967":40278,"_1768":40738},[],"Mensaje",{"_4557":1150,"_25012":969,"_21207":40740,"_5":25256,"_9967":40278,"_1768":40741},[],"Causa",{"_4557":1151,"_25012":969,"_21207":40743,"_5":25256,"_9967":40278,"_1768":40744},[],"Acción del integrador",{"_4557":1152,"_25012":969,"_21207":40746,"_5":25256,"_9967":40278,"_1768":23359},[],{"_4557":1153,"_25012":969,"_21207":40748,"_5":25256,"_9967":40278,"_1768":40749},[],"`Field validation for 'APS' failed`",{"_4557":1154,"_25012":969,"_21207":40751,"_5":25256,"_9967":40278,"_1768":40752},[],"El segmento `{aps}` falta en la URL.",{"_4557":1155,"_25012":969,"_21207":40754,"_5":25256,"_9967":40278,"_1768":40755},[],"Incluir el ID del DMS en la ruta.",{"_4557":1156,"_25012":969,"_21207":40757,"_5":25256,"_9967":40278,"_1768":23359},[],{"_4557":1157,"_25012":969,"_21207":40759,"_5":25256,"_9967":40278,"_1768":40760},[],"`content-type must be application/pkcs10`",{"_4557":1158,"_25012":969,"_21207":40762,"_5":25256,"_9967":40278,"_1768":40763},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_4557":1159,"_25012":969,"_21207":40765,"_5":25256,"_9967":40278,"_1768":40766},[],"Fijar `Content-Type: application/pkcs10`.",{"_4557":1160,"_25012":969,"_21207":40768,"_5":25256,"_9967":40278,"_1768":23359},[],{"_4557":1161,"_25012":969,"_21207":40770,"_5":25256,"_9967":40278,"_1768":40771},[],"`body payload must be base64 encoded`",{"_4557":1162,"_25012":969,"_21207":40773,"_5":25256,"_9967":40278,"_1768":40774},[],"El cuerpo no es base64 válido.",{"_4557":1163,"_25012":969,"_21207":40776,"_5":25256,"_9967":40278,"_1768":40777},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_4557":1164,"_25012":969,"_21207":40779,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1165,"_25012":969,"_21207":40781,"_5":25256,"_9967":40278,"_1768":40782},[],"`DMS not found`",{"_4557":1166,"_25012":969,"_21207":40784,"_5":25256,"_9967":40278,"_1768":40785},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_4557":1167,"_25012":969,"_21207":40787,"_5":25256,"_9967":40278,"_1768":40788},[],"Verificar el identificador con el administrador PKI.",{"_4557":1168,"_25012":969,"_21207":40790,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1169,"_25012":969,"_21207":40792,"_5":25256,"_9967":40278,"_1768":40793},[],"`invalid certificate`",{"_4557":1170,"_25012":969,"_21207":40795,"_5":25256,"_9967":40278,"_1768":40796},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_4557":1171,"_25012":969,"_21207":40798,"_5":25256,"_9967":40278,"_1768":40799},[],"Comprobar la cadena del certificado bootstrap.",{"_4557":1172,"_25012":969,"_21207":40801,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1173,"_25012":969,"_21207":40803,"_5":25256,"_9967":40278,"_1768":40804},[],"`certificate is revoked`",{"_4557":1174,"_25012":969,"_21207":40806,"_5":25256,"_9967":40278,"_1768":40807},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_4557":1175,"_25012":969,"_21207":40809,"_5":25256,"_9967":40278,"_1768":40810},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_4557":1176,"_25012":969,"_21207":40812,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1177,"_25012":969,"_21207":40814,"_5":25256,"_9967":40278,"_1768":40815},[],"`revoked certificate`",{"_4557":1178,"_25012":969,"_21207":40817,"_5":25256,"_9967":40278,"_1768":40818},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_4557":1179,"_25012":969,"_21207":40820,"_5":25256,"_9967":40278,"_1768":40821},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_4557":1180,"_25012":969,"_21207":40823,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1181,"_25012":969,"_21207":40825,"_5":25256,"_9967":40278,"_1768":40826},[],"`expired certificate`",{"_4557":1182,"_25012":969,"_21207":40828,"_5":25256,"_9967":40278,"_1768":40829},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_4557":1183,"_25012":969,"_21207":40831,"_5":25256,"_9967":40278,"_1768":40832},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_4557":1184,"_25012":969,"_21207":40834,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1185,"_25012":969,"_21207":40836,"_5":25256,"_9967":40278,"_1768":40837},[],"`forbiddenNewEnrollment`",{"_4557":1186,"_25012":969,"_21207":40839,"_5":25256,"_9967":40278,"_1768":40840},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_4557":1187,"_25012":969,"_21207":40842,"_5":25256,"_9967":40278,"_1768":40843},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_4557":1188,"_25012":969,"_21207":40845,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1189,"_25012":969,"_21207":40847,"_5":25256,"_9967":40278,"_1768":40848},[],"`device not preregistered`",{"_4557":1190,"_25012":969,"_21207":40850,"_5":25256,"_9967":40278,"_1768":40851},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_4557":1191,"_25012":969,"_21207":40853,"_5":25256,"_9967":40278,"_1768":40854},[],"Registrar el dispositivo antes de inscribirlo.",{"_4557":1192,"_25012":969,"_21207":40856,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1193,"_25012":969,"_21207":40858,"_5":25256,"_9967":40278,"_1768":40859},[],"`invalid reenroll window`",{"_4557":1194,"_25012":969,"_21207":40861,"_5":25256,"_9967":40278,"_1768":40862},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_4557":1195,"_25012":969,"_21207":40864,"_5":25256,"_9967":40278,"_1768":40865},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_4557":1196,"_25012":969,"_21207":40867,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1197,"_25012":969,"_21207":40869,"_5":25256,"_9967":40278,"_1768":40870},[],"`invalid RawSubject bytes`",{"_4557":1198,"_25012":969,"_21207":40872,"_5":25256,"_9967":40278,"_1768":40873},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_4557":1199,"_25012":969,"_21207":40875,"_5":25256,"_9967":40278,"_1768":40876},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_4557":1200,"_25012":969,"_21207":40878,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1201,"_25012":969,"_21207":40880,"_5":25256,"_9967":40278,"_1768":40881},[],"`external webhook denied enrollment`",{"_4557":1202,"_25012":969,"_21207":40883,"_5":25256,"_9967":40278,"_1768":40884},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_4557":1203,"_25012":969,"_21207":40886,"_5":25256,"_9967":40278,"_1768":40887},[],"Revisar los logs del servicio webhook.",{"_4557":1204,"_25012":969,"_21207":40889,"_5":25256,"_9967":40278,"_1768":22830},[],{"_4557":1205,"_25012":969,"_21207":40891,"_5":25256,"_9967":40278,"_1768":40892},[],"`server key generation not enabled`",{"_4557":1206,"_25012":969,"_21207":40894,"_5":25256,"_9967":40278,"_1768":40895},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_4557":1207,"_25012":969,"_21207":40897,"_5":25256,"_9967":40278,"_1768":40898},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_4557":1208,"_25012":969,"_21207":40900,"_5":25256,"_9967":40278,"_1768":40901},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_4557":1209,"_25012":969,"_21207":40903,"_5":25256,"_9967":40282,"_1768":40904},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_4557":1210,"_25012":969,"_21207":40906,"_5":25256,"_9967":40282,"_1768":40907},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_4557":1211,"_25012":969,"_21207":40909,"_5":25256,"_9967":40282,"_1768":40910},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_4557":1212,"_25012":969,"_21207":40912,"_5":25256,"_9967":40282,"_1768":40913},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_4557":1213,"_25012":969,"_21207":40915,"_5":25256,"_9967":40282,"_1768":40916},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_4557":1214,"_25012":969,"_21207":40918,"_5":25256,"_9967":40282,"_1768":40919},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_4557":1215,"_25012":969,"_21207":40921,"_5":25256,"_9967":40282,"_1768":40922},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_4557":1216,"_25012":969,"_21207":40924,"_5":25256,"_9967":40282,"_1768":40925},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4557":1217,"_25012":969,"_21207":40927,"_5":25256,"_9967":40282,"_1768":40928},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4557":1218,"_25012":969,"_21207":40930,"_5":25256,"_9967":40282,"_1768":40931},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_4557":1219,"_25012":1219,"_5":25251,"_1768":40933,"_25264":40934,"_21207":40936,"_9967":1219},"AWS IoT Core",[37104,38188,40935],"Integraciones",[],{"_4557":1220,"_25012":1219,"_21207":40938,"_5":25256,"_9967":1219,"_1768":40939},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_4557":1221,"_25012":1219,"_5":25261,"_21207":40941,"_9967":40942,"_1768":40943},[],"/docs/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_4557":1222,"_25012":1219,"_5":25261,"_21207":40945,"_9967":40946,"_1768":40947},[],"/docs/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_4557":1223,"_25012":1219,"_5":25261,"_21207":40949,"_9967":40950,"_1768":40951},[],"/docs/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_4557":1224,"_25012":1219,"_5":25261,"_21207":40953,"_9967":40954,"_1768":40955},[],"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_4557":1225,"_25012":1219,"_5":25261,"_21207":40957,"_9967":40958,"_1768":40959},[],"/docs/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_4557":1226,"_25012":1219,"_5":25261,"_21207":40961,"_9967":40962,"_1768":40963},[],"/docs/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_4557":1227,"_25012":1219,"_5":25261,"_21207":40965,"_9967":40966,"_1768":40967},[],"/docs/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_4557":1228,"_25012":1219,"_5":25261,"_21207":40969,"_9967":40970,"_1768":40971},[],"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_4557":1229,"_25012":1219,"_5":25261,"_21207":40973,"_9967":40974,"_1768":40189},[],"/docs/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_4557":1230,"_25012":1219,"_5":25261,"_21207":40976,"_9967":40977,"_1768":40978},[],"/docs/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_4557":1231,"_25012":1219,"_5":25261,"_21207":40980,"_9967":40981,"_1768":40982},[],"/docs/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_4557":1232,"_25012":1219,"_5":25261,"_21207":40984,"_9967":40985,"_1768":40986},[],"/docs/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_4557":1233,"_25012":1219,"_5":25261,"_21207":40988,"_9967":40989,"_1768":40990},[],"/docs/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_4557":1234,"_25012":1219,"_5":25261,"_21207":40992,"_9967":40993,"_1768":40994},[],"/docs/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_4557":1235,"_25012":1219,"_5":25261,"_21207":40996,"_9967":40997,"_1768":40998},[],"/docs/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_4557":1236,"_25012":1219,"_5":25261,"_21207":41000,"_9967":41001,"_1768":41002},[],"/docs/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_4557":1237,"_25012":1219,"_5":25261,"_21207":41004,"_9967":41005,"_1768":41006},[],"/docs/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_4557":1238,"_25012":1219,"_5":25261,"_21207":41008,"_9967":41009,"_1768":41010},[],"/docs/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_4557":1239,"_25012":1219,"_5":25261,"_21207":41012,"_9967":41013,"_1768":41014},[],"/docs/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_4557":1240,"_25012":1219,"_5":25261,"_21207":41016,"_9967":41017,"_1768":41018},[],"/docs/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_4557":1241,"_25012":1219,"_21207":41020,"_5":25256,"_9967":1219,"_1768":41021},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_4557":1242,"_25012":1219,"_21207":41023,"_5":25256,"_9967":1219,"_1768":41024},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_4557":1243,"_25012":1219,"_21207":41026,"_5":25256,"_9967":1219,"_1768":41027},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_4557":1244,"_25012":1219,"_21207":41029,"_5":25256,"_9967":40942,"_1768":41030},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_4557":1245,"_25012":1219,"_21207":41032,"_5":25256,"_9967":40942,"_1768":41033},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_4557":1246,"_25012":1219,"_21207":41035,"_5":25256,"_9967":40942,"_1768":41036},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_4557":1247,"_25012":1219,"_21207":41038,"_5":25256,"_9967":40942,"_1768":41039},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_4557":1248,"_25012":1219,"_21207":41041,"_5":25256,"_9967":40946,"_1768":41042},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_4557":1249,"_25012":1219,"_21207":41044,"_5":25256,"_9967":40950,"_1768":41045},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_4557":1250,"_25012":1219,"_21207":41047,"_5":25256,"_9967":40950,"_1768":41048},[],"Acción IAM",{"_4557":1251,"_25012":1219,"_21207":41050,"_5":25256,"_9967":40950,"_1768":41051},[],"Propósito",{"_4557":1252,"_25012":1219,"_21207":41053,"_5":25256,"_9967":40950,"_1768":41054},[],"`iot:GetRegistrationCode`",{"_4557":1253,"_25012":1219,"_21207":41056,"_5":25256,"_9967":40950,"_1768":41057},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_4557":1254,"_25012":1219,"_21207":41059,"_5":25256,"_9967":40950,"_1768":41060},[],"`iot:RegisterCACertificate`",{"_4557":1255,"_25012":1219,"_21207":41062,"_5":25256,"_9967":40950,"_1768":41063},[],"Registrar la CA en AWS IoT",{"_4557":1256,"_25012":1219,"_21207":41065,"_5":25256,"_9967":40950,"_1768":41066},[],"`iot:DescribeCACertificate`",{"_4557":1257,"_25012":1219,"_21207":41068,"_5":25256,"_9967":40950,"_1768":41069},[],"Consultar el estado del registro de la CA",{"_4557":1258,"_25012":1219,"_21207":41071,"_5":25256,"_9967":40950,"_1768":41072},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_4557":1259,"_25012":1219,"_21207":41074,"_5":25256,"_9967":40950,"_1768":41075},[],"Crear o actualizar Things en IoT Core",{"_4557":1260,"_25012":1219,"_21207":41077,"_5":25256,"_9967":40950,"_1768":41078},[],"`iot:RegisterThing`",{"_4557":1261,"_25012":1219,"_21207":41080,"_5":25256,"_9967":40950,"_1768":41081},[],"Aprovisionar Things mediante plantilla",{"_4557":1262,"_25012":1219,"_21207":41083,"_5":25256,"_9967":40950,"_1768":41084},[],"`iot:RegisterCertificate`",{"_4557":1263,"_25012":1219,"_21207":41086,"_5":25256,"_9967":40950,"_1768":41087},[],"Registrar certificados de dispositivo",{"_4557":1264,"_25012":1219,"_21207":41089,"_5":25256,"_9967":40950,"_1768":41090},[],"`iot:UpdateCertificate`",{"_4557":1265,"_25012":1219,"_21207":41092,"_5":25256,"_9967":40950,"_1768":41093},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_4557":1266,"_25012":1219,"_21207":41095,"_5":25256,"_9967":40950,"_1768":41096},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_4557":1267,"_25012":1219,"_21207":41098,"_5":25256,"_9967":40950,"_1768":41099},[],"Crear y adjuntar políticas IoT",{"_4557":1268,"_25012":1219,"_21207":41101,"_5":25256,"_9967":40950,"_1768":41102},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_4557":1269,"_25012":1219,"_21207":41104,"_5":25256,"_9967":40950,"_1768":41105},[],"Gestionar grupos de Things",{"_4557":1270,"_25012":1219,"_21207":41107,"_5":25256,"_9967":40950,"_1768":41108},[],"`iot:CreateProvisioningTemplate`",{"_4557":1271,"_25012":1219,"_21207":41110,"_5":25256,"_9967":40950,"_1768":41111},[],"Crear plantillas JITP",{"_4557":1272,"_25012":1219,"_21207":41113,"_5":25256,"_9967":40950,"_1768":41114},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_4557":1273,"_25012":1219,"_21207":41116,"_5":25256,"_9967":40950,"_1768":41117},[],"Leer y escribir el Device Shadow",{"_4557":1274,"_25012":1219,"_21207":41119,"_5":25256,"_9967":40950,"_1768":41120},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_4557":1275,"_25012":1219,"_21207":41122,"_5":25256,"_9967":40954,"_1768":41123},[],"Parámetro",{"_4557":1276,"_25012":1219,"_21207":41125,"_5":25256,"_9967":40954,"_1768":41126},[],"Tipo",{"_4557":1277,"_25012":1219,"_21207":41128,"_5":25256,"_9967":40954,"_1768":41129},[],"Requerido",{"_4557":1278,"_25012":1219,"_21207":41131,"_5":25256,"_9967":40954,"_1768":37475},[],{"_4557":1279,"_25012":1219,"_21207":41133,"_5":25256,"_9967":40954,"_1768":41134},[],"`connector_id`",{"_4557":1280,"_25012":1219,"_21207":41136,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1281,"_25012":1219,"_21207":41138,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1282,"_25012":1219,"_21207":41140,"_5":25256,"_9967":40954,"_1768":41141},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_4557":1283,"_25012":1219,"_21207":41143,"_5":25256,"_9967":40954,"_1768":41144},[],"`aws_config.region`",{"_4557":1284,"_25012":1219,"_21207":41146,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1285,"_25012":1219,"_21207":41148,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1286,"_25012":1219,"_21207":41150,"_5":25256,"_9967":40954,"_1768":41151},[],"Región AWS donde opera el conector.",{"_4557":1287,"_25012":1219,"_21207":41153,"_5":25256,"_9967":40954,"_1768":41154},[],"`aws_config.auth_method`",{"_4557":1288,"_25012":1219,"_21207":41156,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1289,"_25012":1219,"_21207":41158,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1290,"_25012":1219,"_21207":41160,"_5":25256,"_9967":40954,"_1768":41161},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_4557":1291,"_25012":1219,"_21207":41163,"_5":25256,"_9967":40954,"_1768":41164},[],"`aws_config.access_key_id`",{"_4557":1292,"_25012":1219,"_21207":41166,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1293,"_25012":1219,"_21207":41168,"_5":25256,"_9967":40954,"_1768":41169},[],"Solo con `auth_method=static`",{"_4557":1294,"_25012":1219,"_21207":41171,"_5":25256,"_9967":40954,"_1768":41172},[],"Clave de acceso AWS.",{"_4557":1295,"_25012":1219,"_21207":41174,"_5":25256,"_9967":40954,"_1768":41175},[],"`aws_config.secret_access_key`",{"_4557":1296,"_25012":1219,"_21207":41177,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1297,"_25012":1219,"_21207":41179,"_5":25256,"_9967":40954,"_1768":41169},[],{"_4557":1298,"_25012":1219,"_21207":41181,"_5":25256,"_9967":40954,"_1768":41182},[],"Clave secreta AWS.",{"_4557":1299,"_25012":1219,"_21207":41184,"_5":25256,"_9967":40954,"_1768":41185},[],"`aws_config.session_token`",{"_4557":1300,"_25012":1219,"_21207":41187,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1301,"_25012":1219,"_21207":41189,"_5":25256,"_9967":40954,"_1768":41190},[],"No",{"_4557":1302,"_25012":1219,"_21207":41192,"_5":25256,"_9967":40954,"_1768":41193},[],"Token de sesión (con `auth_method=static`).",{"_4557":1303,"_25012":1219,"_21207":41195,"_5":25256,"_9967":40954,"_1768":41196},[],"`aws_config.role_arn`",{"_4557":1304,"_25012":1219,"_21207":41198,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1305,"_25012":1219,"_21207":41200,"_5":25256,"_9967":40954,"_1768":41201},[],"Solo con `auth_method=role`",{"_4557":1306,"_25012":1219,"_21207":41203,"_5":25256,"_9967":40954,"_1768":41204},[],"ARN del rol a asumir.",{"_4557":1307,"_25012":1219,"_21207":41206,"_5":25256,"_9967":40954,"_1768":41207},[],"`aws_config.endpoint_url`",{"_4557":1308,"_25012":1219,"_21207":41209,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1309,"_25012":1219,"_21207":41211,"_5":25256,"_9967":40954,"_1768":41190},[],{"_4557":1310,"_25012":1219,"_21207":41213,"_5":25256,"_9967":40954,"_1768":41214},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_4557":1311,"_25012":1219,"_21207":41216,"_5":25256,"_9967":40954,"_1768":41217},[],"`subscriber_event_bus`",{"_4557":1312,"_25012":1219,"_21207":41219,"_5":25256,"_9967":40954,"_1768":16214},[],{"_4557":1313,"_25012":1219,"_21207":41221,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1314,"_25012":1219,"_21207":41223,"_5":25256,"_9967":40954,"_1768":41224},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_4557":1315,"_25012":1219,"_21207":41226,"_5":25256,"_9967":40954,"_1768":41227},[],"`dms_manager_client`",{"_4557":1316,"_25012":1219,"_21207":41229,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1317,"_25012":1219,"_21207":41231,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1318,"_25012":1219,"_21207":41233,"_5":25256,"_9967":40954,"_1768":41234},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_4557":1319,"_25012":1219,"_21207":41236,"_5":25256,"_9967":40954,"_1768":41237},[],"`device_manager_client`",{"_4557":1320,"_25012":1219,"_21207":41239,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1321,"_25012":1219,"_21207":41241,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1322,"_25012":1219,"_21207":41243,"_5":25256,"_9967":40954,"_1768":41244},[],"URL HTTP del Device Manager de Lamassu.",{"_4557":1323,"_25012":1219,"_21207":41246,"_5":25256,"_9967":40954,"_1768":41247},[],"`ca_client`",{"_4557":1324,"_25012":1219,"_21207":41249,"_5":25256,"_9967":40954,"_1768":20888},[],{"_4557":1325,"_25012":1219,"_21207":41251,"_5":25256,"_9967":40954,"_1768":40516},[],{"_4557":1326,"_25012":1219,"_21207":41253,"_5":25256,"_9967":40954,"_1768":41254},[],"URL HTTP del servicio de CA de Lamassu.",{"_4557":1327,"_25012":1219,"_21207":41256,"_5":25256,"_9967":40958,"_1768":41257},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_4557":1328,"_25012":1219,"_21207":41259,"_5":25256,"_9967":40962,"_1768":41260},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_4557":1329,"_25012":1219,"_21207":41262,"_5":25256,"_9967":40962,"_1768":41263},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_4557":1330,"_25012":1219,"_21207":41265,"_5":25256,"_9967":40966,"_1768":41266},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_4557":1331,"_25012":1219,"_21207":41268,"_5":25256,"_9967":40966,"_1768":41269},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_4557":1332,"_25012":1219,"_21207":41271,"_5":25256,"_9967":40966,"_1768":41272},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_4557":1333,"_25012":1219,"_21207":41274,"_5":25256,"_9967":40966,"_1768":41275},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_4557":1334,"_25012":1219,"_21207":41277,"_5":25256,"_9967":40966,"_1768":41278},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_4557":1335,"_25012":1219,"_21207":41280,"_5":25256,"_9967":40966,"_1768":41281},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_4557":1336,"_25012":1219,"_21207":41283,"_5":25256,"_9967":40970,"_1768":41284},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_4557":1337,"_25012":1219,"_21207":41286,"_5":25256,"_9967":40974,"_1768":41287},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_4557":1338,"_25012":1219,"_21207":41289,"_5":25256,"_9967":40974,"_1768":41290},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_4557":1339,"_25012":1219,"_21207":41292,"_5":25256,"_9967":40977,"_1768":41293},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_4557":1340,"_25012":1219,"_21207":41295,"_5":25256,"_9967":40981,"_1768":41296},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_4557":1341,"_25012":1219,"_21207":41298,"_5":25256,"_9967":40981,"_1768":41299},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_4557":1342,"_25012":1219,"_21207":41301,"_5":25256,"_9967":40981,"_1768":41302},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_4557":1343,"_25012":1219,"_21207":41304,"_5":25256,"_9967":40981,"_1768":41305},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_4557":1344,"_25012":1219,"_21207":41307,"_5":25256,"_9967":40981,"_1768":41308},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_4557":1345,"_25012":1219,"_21207":41310,"_5":25256,"_9967":40981,"_1768":41311},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_4557":1346,"_25012":1219,"_21207":41313,"_5":25256,"_9967":40985,"_1768":41314},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_4557":1347,"_25012":1219,"_21207":41316,"_5":25256,"_9967":40985,"_1768":41317},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_4557":1348,"_25012":1219,"_21207":41319,"_5":25256,"_9967":40985,"_1768":41320},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_4557":1349,"_25012":1219,"_21207":41322,"_5":25256,"_9967":40989,"_1768":41323},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_4557":1350,"_25012":1219,"_21207":41325,"_5":25256,"_9967":40989,"_1768":41326},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_4557":1351,"_25012":1219,"_21207":41328,"_5":25256,"_9967":40989,"_1768":41329},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_4557":1352,"_25012":1219,"_21207":41331,"_5":25256,"_9967":40993,"_1768":41332},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_4557":1353,"_25012":1219,"_21207":41334,"_5":25256,"_9967":40993,"_1768":41335},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_4557":1354,"_25012":1219,"_21207":41337,"_5":25256,"_9967":40993,"_1768":41338},[],"Para que el flujo JITP funcione correctamente:",{"_4557":1355,"_25012":1219,"_21207":41340,"_5":25256,"_9967":40993,"_1768":41341},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_4557":1356,"_25012":1219,"_21207":41343,"_5":25256,"_9967":40993,"_1768":41344},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_4557":1357,"_25012":1219,"_21207":41346,"_5":25256,"_9967":40993,"_1768":41347},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_4557":1358,"_25012":1219,"_21207":41349,"_5":25256,"_9967":40993,"_1768":41350},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_4557":1359,"_25012":1219,"_21207":41352,"_5":25256,"_9967":40997,"_1768":41353},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_4557":1360,"_25012":1219,"_21207":41355,"_5":25256,"_9967":40997,"_1768":41356},[],"Estado en Lamassu",{"_4557":1361,"_25012":1219,"_21207":41358,"_5":25256,"_9967":40997,"_1768":41359},[],"Razón de revocación",{"_4557":1362,"_25012":1219,"_21207":41361,"_5":25256,"_9967":40997,"_1768":41362},[],"Estado en AWS IoT Core",{"_4557":1363,"_25012":1219,"_21207":41364,"_5":25256,"_9967":40997,"_1768":41365},[],"`Active`",{"_4557":1364,"_25012":1219,"_21207":41367,"_5":25256,"_9967":40997,"_1768":40556},[],{"_4557":1365,"_25012":1219,"_21207":41369,"_5":25256,"_9967":40997,"_1768":41370},[],"`ACTIVE`",{"_4557":1366,"_25012":1219,"_21207":41372,"_5":25256,"_9967":40997,"_1768":41373},[],"`Revoked`",{"_4557":1367,"_25012":1219,"_21207":41375,"_5":25256,"_9967":40997,"_1768":41376},[],"`certificateHold`",{"_4557":1368,"_25012":1219,"_21207":41378,"_5":25256,"_9967":40997,"_1768":41379},[],"`INACTIVE`",{"_4557":1369,"_25012":1219,"_21207":41381,"_5":25256,"_9967":40997,"_1768":41373},[],{"_4557":1370,"_25012":1219,"_21207":41383,"_5":25256,"_9967":40997,"_1768":41384},[],"Cualquier otra razón",{"_4557":1371,"_25012":1219,"_21207":41386,"_5":25256,"_9967":40997,"_1768":41387},[],"`REVOKED`",{"_4557":1372,"_25012":1219,"_21207":41389,"_5":25256,"_9967":40997,"_1768":41390},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_4557":1373,"_25012":1219,"_21207":41392,"_5":25256,"_9967":41001,"_1768":41393},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_4557":1374,"_25012":1219,"_21207":41395,"_5":25256,"_9967":41001,"_1768":41396},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_4557":1375,"_25012":1219,"_21207":41398,"_5":25256,"_9967":41001,"_1768":41399},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_4557":1376,"_25012":1219,"_21207":41401,"_5":25256,"_9967":41005,"_1768":41402},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_4557":1377,"_25012":1219,"_21207":41404,"_5":25256,"_9967":41005,"_1768":41405},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_4557":1378,"_25012":1219,"_21207":41407,"_5":25256,"_9967":41009,"_1768":41408},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_4557":1379,"_25012":1219,"_21207":41410,"_5":25256,"_9967":41009,"_1768":41411},[],"Existen dos tipos de acciones:",{"_4557":1380,"_25012":1219,"_21207":41413,"_5":25256,"_9967":41009,"_1768":41414},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_4557":1381,"_25012":1219,"_21207":41416,"_5":25256,"_9967":41009,"_1768":41417},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_4557":1382,"_25012":1219,"_21207":41419,"_5":25256,"_9967":41009,"_1768":41420},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_4557":1383,"_25012":1219,"_21207":41422,"_5":25256,"_9967":41013,"_1768":41423},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_4557":1384,"_25012":1219,"_21207":41425,"_5":25256,"_9967":41013,"_1768":41426},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_4557":1385,"_25012":1219,"_21207":41428,"_5":25256,"_9967":41013,"_1768":41429},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_4557":1386,"_25012":1219,"_21207":41431,"_5":25256,"_9967":41017,"_1768":41432},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_4557":1387,"_25012":1219,"_21207":41434,"_5":25256,"_9967":41017,"_1768":41435},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_4557":1388,"_25012":1219,"_21207":41437,"_5":25256,"_9967":41017,"_1768":41438},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_4557":1389,"_25012":1219,"_21207":41440,"_5":25256,"_9967":41017,"_1768":41441},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_4557":1390,"_25012":1219,"_21207":41443,"_5":25256,"_9967":41017,"_1768":41444},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_4557":1391,"_25012":1219,"_21207":41446,"_5":25256,"_9967":41017,"_1768":41447},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_4557":1392,"_25012":1219,"_21207":41449,"_5":25256,"_9967":41017,"_1768":41450},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_4557":1393,"_25012":1219,"_21207":41452,"_5":25256,"_9967":41017,"_1768":41453},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_4557":1394,"_25012":1219,"_21207":41455,"_5":25256,"_9967":41017,"_1768":41456},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_4557":1395,"_25012":1219,"_21207":41458,"_5":25256,"_9967":41017,"_1768":41459},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_4557":1396,"_25012":1219,"_21207":41461,"_5":25256,"_9967":41017,"_1768":41462},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_4557":1397,"_25012":1219,"_21207":41464,"_5":25256,"_9967":41017,"_1768":41465},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_4557":1398,"_25012":1219,"_21207":41467,"_5":25256,"_9967":41017,"_1768":41468},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_4557":1399,"_25012":1219,"_21207":41470,"_5":25256,"_9967":41017,"_1768":41471},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_4557":1400,"_25012":1219,"_21207":41473,"_5":25256,"_9967":41017,"_1768":41474},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_4557":1401,"_25012":1219,"_21207":41476,"_5":25256,"_9967":41017,"_1768":41477},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_4557":1402,"_25012":1219,"_21207":41479,"_5":25256,"_9967":41017,"_1768":41480},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_4557":1403,"_25012":1219,"_21207":41482,"_5":25256,"_9967":41017,"_1768":41483},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_4557":1404,"_25012":1219,"_21207":41485,"_5":25256,"_9967":41017,"_1768":41486},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4557":1405,"_25012":1219,"_21207":41488,"_5":25256,"_9967":41017,"_1768":41489},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_4557":1406,"_25012":1219,"_21207":41491,"_5":25256,"_9967":41017,"_1768":41492},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_4557":1407,"_25012":1407,"_5":25251,"_1768":41494,"_25264":41495,"_21207":41496,"_9967":1407},"Claves y motores criptográficos",[37104,38188,38341],[],{"_4557":1408,"_25012":1407,"_21207":41498,"_5":25256,"_9967":1407,"_1768":41499},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_4557":1409,"_25012":1407,"_5":25261,"_21207":41501,"_9967":41502,"_1768":41503},[],"/docs/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_4557":1410,"_25012":1407,"_5":25261,"_21207":41505,"_9967":41506,"_1768":41507},[],"/docs/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_4557":1411,"_25012":1407,"_5":25261,"_21207":41509,"_9967":41510,"_1768":41511},[],"/docs/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_4557":1412,"_25012":1407,"_5":25261,"_21207":41513,"_9967":41514,"_1768":41515},[],"/docs/platform/pki/key-management#file-system","File System",{"_4557":1413,"_25012":1407,"_5":25261,"_21207":41517,"_9967":41518,"_1768":41519},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_4557":1414,"_25012":1407,"_5":25261,"_21207":41521,"_9967":41522,"_1768":41523},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_4557":1415,"_25012":1407,"_5":25261,"_21207":41525,"_9967":41526,"_1768":41527},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_4557":1416,"_25012":1407,"_5":25261,"_21207":41529,"_9967":41530,"_1768":41531},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_4557":1417,"_25012":1407,"_5":25261,"_21207":41533,"_9967":41534,"_1768":41535},[],"/docs/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_4557":1418,"_25012":1407,"_5":25261,"_21207":41537,"_9967":41538,"_1768":41539},[],"/docs/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_4557":1419,"_25012":1407,"_5":25261,"_21207":41541,"_9967":41542,"_1768":41543},[],"/docs/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_4557":1420,"_25012":1407,"_5":25261,"_21207":41545,"_9967":41546,"_1768":41547},[],"/docs/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_4557":1421,"_25012":1407,"_5":25261,"_21207":41549,"_9967":41550,"_1768":41551},[],"/docs/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_4557":1422,"_25012":1407,"_5":25261,"_21207":41553,"_9967":41554,"_1768":41555},[],"/docs/platform/pki/key-management#ver-detalles","Ver detalles",{"_4557":1423,"_25012":1407,"_5":25261,"_21207":41557,"_9967":41558,"_1768":41559},[],"/docs/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_4557":1424,"_25012":1407,"_5":25261,"_21207":41561,"_9967":41562,"_1768":41563},[],"/docs/platform/pki/key-management#sign","Sign",{"_4557":1425,"_25012":1407,"_5":25261,"_21207":41565,"_9967":41566,"_1768":41567},[],"/docs/platform/pki/key-management#verify","Verify",{"_4557":1426,"_25012":1407,"_5":25261,"_21207":41569,"_9967":41570,"_1768":41571},[],"/docs/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_4557":1427,"_25012":1407,"_5":25261,"_21207":41573,"_9967":41574,"_1768":41575},[],"/docs/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_4557":1428,"_25012":1407,"_21207":41577,"_5":25256,"_9967":41502,"_1768":41578},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_4557":1429,"_25012":1407,"_21207":41580,"_5":25256,"_9967":41502,"_1768":41581},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_4557":1430,"_25012":1407,"_21207":41583,"_5":25256,"_9967":41506,"_1768":41584},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_4557":1431,"_25012":1407,"_21207":41586,"_5":25256,"_9967":41506,"_1768":41587},[],"En la práctica, permite:",{"_4557":1432,"_25012":1407,"_21207":41589,"_5":25256,"_9967":41506,"_1768":41590},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_4557":1433,"_25012":1407,"_21207":41592,"_5":25256,"_9967":41506,"_1768":41593},[],"Importar claves creadas externamente.",{"_4557":1434,"_25012":1407,"_21207":41595,"_5":25256,"_9967":41506,"_1768":41596},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_4557":1435,"_25012":1407,"_21207":41598,"_5":25256,"_9967":41506,"_1768":41599},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_4557":1436,"_25012":1407,"_21207":41601,"_5":25256,"_9967":41510,"_1768":41602},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_4557":1437,"_25012":1407,"_21207":41604,"_5":25256,"_9967":41510,"_1768":41605},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_4557":1438,"_25012":1407,"_21207":41607,"_5":25256,"_9967":41510,"_1768":41608},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_4557":1439,"_25012":1407,"_21207":41610,"_5":25256,"_9967":41514,"_1768":41611},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_4557":1440,"_25012":1407,"_21207":41613,"_5":25256,"_9967":41518,"_1768":41614},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_4557":1441,"_25012":1407,"_21207":41616,"_5":25256,"_9967":41522,"_1768":41617},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_4557":1442,"_25012":1407,"_21207":41619,"_5":25256,"_9967":41526,"_1768":41620},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_4557":1443,"_25012":1407,"_21207":41622,"_5":25256,"_9967":41530,"_1768":41623},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_4557":1444,"_25012":1407,"_21207":41625,"_5":25256,"_9967":41530,"_1768":41626},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_4557":1445,"_25012":1407,"_21207":41628,"_5":25256,"_9967":41530,"_1768":41629},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_4557":1446,"_25012":1407,"_21207":41631,"_5":25256,"_9967":41530,"_1768":41632},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_4557":1447,"_25012":1407,"_21207":41634,"_5":25256,"_9967":41534,"_1768":41635},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_4557":1448,"_25012":1407,"_21207":41637,"_5":25256,"_9967":41534,"_1768":41638},[],"La tabla incluye los siguientes campos:",{"_4557":1449,"_25012":1407,"_21207":41640,"_5":25256,"_9967":41534,"_1768":41641},[],"**Name**: nombre descriptivo de la clave.",{"_4557":1450,"_25012":1407,"_21207":41643,"_5":25256,"_9967":41534,"_1768":41644},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_4557":1451,"_25012":1407,"_21207":41646,"_5":25256,"_9967":41534,"_1768":41647},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_4557":1452,"_25012":1407,"_21207":41649,"_5":25256,"_9967":41534,"_1768":41650},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_4557":1453,"_25012":1407,"_21207":41652,"_5":25256,"_9967":41534,"_1768":41653},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_4557":1454,"_25012":1407,"_21207":41655,"_5":25256,"_9967":41534,"_1768":41656},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_4557":1455,"_25012":1407,"_21207":41658,"_5":25256,"_9967":41534,"_1768":41659},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_4557":1456,"_25012":1407,"_21207":41661,"_5":25256,"_9967":41534,"_1768":41662},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_4557":1457,"_25012":1407,"_21207":41664,"_5":25256,"_9967":41534,"_1768":41665},[],"Desde esta vista también se accede a las acciones más habituales:",{"_4557":1458,"_25012":1407,"_21207":41667,"_5":25256,"_9967":41534,"_1768":41668},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_4557":1459,"_25012":1407,"_21207":41670,"_5":25256,"_9967":41534,"_1768":41671},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_4557":1460,"_25012":1407,"_21207":41673,"_5":25256,"_9967":41534,"_1768":41674},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_4557":1461,"_25012":1407,"_21207":41676,"_5":25256,"_9967":41534,"_1768":41677},[],"**Delete Key** para eliminar la clave del sistema.",{"_4557":1462,"_25012":1407,"_21207":41679,"_5":25256,"_9967":41538,"_1768":41680},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_4557":1463,"_25012":1407,"_21207":41682,"_5":25256,"_9967":41542,"_1768":41683},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_4557":1464,"_25012":1407,"_21207":41685,"_5":25256,"_9967":41542,"_1768":41686},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_4557":1465,"_25012":1407,"_21207":41688,"_5":25256,"_9967":41542,"_1768":41689},[],"**Key Name**: nombre único y descriptivo.",{"_4557":1466,"_25012":1407,"_21207":41691,"_5":25256,"_9967":41542,"_1768":41692},[],"**Crypto Engine**: motor que custodiará la clave.",{"_4557":1467,"_25012":1407,"_21207":41694,"_5":25256,"_9967":41542,"_1768":41695},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_4557":1468,"_25012":1407,"_21207":41697,"_5":25256,"_9967":41542,"_1768":41698},[],"**Tags**: metadatos para clasificar la clave.",{"_4557":1469,"_25012":1407,"_21207":41700,"_5":25256,"_9967":41542,"_1768":41701},[],"**Metadata**: información adicional para usos avanzados.",{"_4557":1470,"_25012":1407,"_21207":41703,"_5":25256,"_9967":41546,"_1768":41704},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_4557":1471,"_25012":1407,"_21207":41706,"_5":25256,"_9967":41546,"_1768":41707},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_4557":1472,"_25012":1407,"_21207":41709,"_5":25256,"_9967":41546,"_1768":41710},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_4557":1473,"_25012":1407,"_21207":41712,"_5":25256,"_9967":41546,"_1768":41713},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_4557":1474,"_25012":1407,"_21207":41715,"_5":25256,"_9967":41546,"_1768":41716},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_4557":1475,"_25012":1407,"_21207":41718,"_5":25256,"_9967":41546,"_1768":41719},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_4557":1476,"_25012":1407,"_21207":41721,"_5":25256,"_9967":41546,"_1768":41722},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_4557":1477,"_25012":1407,"_21207":41724,"_5":25256,"_9967":41546,"_1768":41725},[],"**Tags**: etiquetas para organización y búsqueda.",{"_4557":1478,"_25012":1407,"_21207":41727,"_5":25256,"_9967":41546,"_1768":41728},[],"**Metadata**: información adicional opcional.",{"_4557":1479,"_25012":1407,"_21207":41730,"_5":25256,"_9967":41546,"_1768":41731},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_4557":1480,"_25012":1407,"_21207":41733,"_5":25256,"_9967":41546,"_1768":41734},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_4557":1481,"_25012":1407,"_21207":41736,"_5":25256,"_9967":41550,"_1768":41737},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_4557":1482,"_25012":1407,"_21207":41739,"_5":25256,"_9967":41554,"_1768":41740},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_4557":1483,"_25012":1407,"_21207":41742,"_5":25256,"_9967":41554,"_1768":41743},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_4557":1484,"_25012":1407,"_21207":41745,"_5":25256,"_9967":41554,"_1768":41746},[],"**Key Name**: nombre descriptivo.",{"_4557":1485,"_25012":1407,"_21207":41748,"_5":25256,"_9967":41554,"_1768":41749},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_4557":1486,"_25012":1407,"_21207":41751,"_5":25256,"_9967":41554,"_1768":41752},[],"**Tags**: etiquetas asociadas.",{"_4557":1487,"_25012":1407,"_21207":41754,"_5":25256,"_9967":41554,"_1768":41755},[],"**Aliases**: nombres alternativos.",{"_4557":1488,"_25012":1407,"_21207":41757,"_5":25256,"_9967":41554,"_1768":41758},[],"**Crypto Engine**: motor en el que reside la clave.",{"_4557":1489,"_25012":1407,"_21207":41760,"_5":25256,"_9967":41554,"_1768":41761},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_4557":1490,"_25012":1407,"_21207":41763,"_5":25256,"_9967":41554,"_1768":41764},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_4557":1491,"_25012":1407,"_21207":41766,"_5":25256,"_9967":41554,"_1768":41767},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_4557":1492,"_25012":1407,"_21207":41769,"_5":25256,"_9967":41558,"_1768":41770},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_4557":1493,"_25012":1407,"_21207":41772,"_5":25256,"_9967":41558,"_1768":41773},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_4557":1494,"_25012":1407,"_21207":41775,"_5":25256,"_9967":41562,"_1768":41776},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_4557":1495,"_25012":1407,"_21207":41778,"_5":25256,"_9967":41562,"_1768":41779},[],"Campos principales:",{"_4557":1496,"_25012":1407,"_21207":41781,"_5":25256,"_9967":41562,"_1768":41782},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_4557":1497,"_25012":1407,"_21207":41784,"_5":25256,"_9967":41562,"_1768":41785},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_4557":1498,"_25012":1407,"_21207":41787,"_5":25256,"_9967":41562,"_1768":41788},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_4557":1499,"_25012":1407,"_21207":41790,"_5":25256,"_9967":41562,"_1768":41791},[],"**Message**: contenido que se va a firmar.",{"_4557":1500,"_25012":1407,"_21207":41793,"_5":25256,"_9967":41562,"_1768":41794},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_4557":1501,"_25012":1407,"_21207":41796,"_5":25256,"_9967":41566,"_1768":41797},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_4557":1502,"_25012":1407,"_21207":41799,"_5":25256,"_9967":41566,"_1768":41779},[],{"_4557":1503,"_25012":1407,"_21207":41801,"_5":25256,"_9967":41566,"_1768":41802},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_4557":1504,"_25012":1407,"_21207":41804,"_5":25256,"_9967":41566,"_1768":41805},[],"**Message Type**: `Raw` o `Digest`.",{"_4557":1505,"_25012":1407,"_21207":41807,"_5":25256,"_9967":41566,"_1768":41808},[],"**Payload Encoding**: codificación del mensaje.",{"_4557":1506,"_25012":1407,"_21207":41810,"_5":25256,"_9967":41566,"_1768":41811},[],"**Message**: mensaje original o hash.",{"_4557":1507,"_25012":1407,"_21207":41813,"_5":25256,"_9967":41566,"_1768":41814},[],"**Signature**: firma que se desea comprobar.",{"_4557":1508,"_25012":1407,"_21207":41816,"_5":25256,"_9967":41566,"_1768":41817},[],"**Result**: indicador del resultado de la validación.",{"_4557":1509,"_25012":1407,"_21207":41819,"_5":25256,"_9967":41570,"_1768":41820},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_4557":1510,"_25012":1407,"_21207":41822,"_5":25256,"_9967":41570,"_1768":41823},[],"Este flujo es útil para:",{"_4557":1511,"_25012":1407,"_21207":41825,"_5":25256,"_9967":41570,"_1768":41826},[],"Solicitar certificados a una CA externa.",{"_4557":1512,"_25012":1407,"_21207":41828,"_5":25256,"_9967":41570,"_1768":41829},[],"Renovar una identidad manteniendo la misma clave.",{"_4557":1513,"_25012":1407,"_21207":41831,"_5":25256,"_9967":41570,"_1768":41832},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_4557":1514,"_25012":1407,"_21207":41834,"_5":25256,"_9967":41570,"_1768":41835},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_4557":1515,"_25012":1407,"_21207":41837,"_5":25256,"_9967":41570,"_1768":41838},[],"**Organization (O)**: organización o empresa.",{"_4557":1516,"_25012":1407,"_21207":41840,"_5":25256,"_9967":41570,"_1768":41841},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_4557":1517,"_25012":1407,"_21207":41843,"_5":25256,"_9967":41570,"_1768":41844},[],"**Country (C)**: código de país de dos letras.",{"_4557":1518,"_25012":1407,"_21207":41846,"_5":25256,"_9967":41570,"_1768":41847},[],"**State / Province (ST)**: estado o provincia.",{"_4557":1519,"_25012":1407,"_21207":41849,"_5":25256,"_9967":41570,"_1768":41850},[],"**Locality (L)**: ciudad o localidad.",{"_4557":1520,"_25012":1407,"_21207":41852,"_5":25256,"_9967":41570,"_1768":41853},[],"**Email Address**: correo de contacto.",{"_4557":1521,"_25012":1407,"_21207":41855,"_5":25256,"_9967":41570,"_1768":41856},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_4557":1522,"_25012":1407,"_21207":41858,"_5":25256,"_9967":41570,"_1768":41859},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_4557":1523,"_25012":1407,"_21207":41861,"_5":25256,"_9967":41574,"_1768":41862},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_4557":1524,"_25012":1407,"_21207":41864,"_5":25256,"_9967":41574,"_1768":41865},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_4557":1525,"_25012":1525,"_5":25251,"_1768":41867,"_25264":41868,"_21207":41869,"_9967":1525},"Validación online con OCSP",[37104,38188,38341],[],{"_4557":1526,"_25012":1525,"_21207":41871,"_5":25256,"_9967":1525,"_1768":41872},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_4557":1527,"_25012":1525,"_5":25261,"_21207":41874,"_9967":41875,"_1768":41876},[],"/docs/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_4557":1528,"_25012":1525,"_5":25261,"_21207":41878,"_9967":41879,"_1768":41880},[],"/docs/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_4557":1529,"_25012":1525,"_5":25261,"_21207":41882,"_9967":41883,"_1768":41884},[],"/docs/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_4557":1530,"_25012":1525,"_5":25261,"_21207":41886,"_9967":41887,"_1768":41888},[],"/docs/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_4557":1531,"_25012":1525,"_5":25261,"_21207":41890,"_9967":41891,"_1768":41892},[],"/docs/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_4557":1532,"_25012":1525,"_5":25261,"_21207":41894,"_9967":41895,"_1768":39833},[],"/docs/platform/pki/ocsp#referencias",{"_4557":1533,"_25012":1525,"_21207":41897,"_5":25256,"_9967":41875,"_1768":41898},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_4557":1534,"_25012":1525,"_21207":41900,"_5":25256,"_9967":41875,"_1768":41901},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_4557":1535,"_25012":1525,"_21207":41903,"_5":25256,"_9967":41879,"_1768":41904},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_4557":1536,"_25012":1525,"_21207":41906,"_5":25256,"_9967":41879,"_1768":41907},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_4557":1537,"_25012":1525,"_21207":41909,"_5":25256,"_9967":41879,"_1768":41910},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_4557":1538,"_25012":1525,"_21207":41912,"_5":25256,"_9967":41879,"_1768":41913},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_4557":1539,"_25012":1525,"_21207":41915,"_5":25256,"_9967":41879,"_1768":41916},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_4557":1540,"_25012":1525,"_21207":41918,"_5":25256,"_9967":41879,"_1768":41919},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_4557":1541,"_25012":1525,"_21207":41921,"_5":25256,"_9967":41883,"_1768":41922},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_4557":1542,"_25012":1525,"_21207":41924,"_5":25256,"_9967":41887,"_1768":41925},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_4557":1543,"_25012":1525,"_21207":41927,"_5":25256,"_9967":41887,"_1768":41928},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_4557":1544,"_25012":1525,"_21207":41930,"_5":25256,"_9967":41887,"_1768":41931},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_4557":1545,"_25012":1525,"_21207":41933,"_5":25256,"_9967":41887,"_1768":41934},[],"Ejemplo de consulta con `curl` mediante POST:",{"_4557":1546,"_25012":1525,"_21207":41936,"_5":25256,"_9967":41887,"_1768":41937},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_4557":1547,"_25012":1525,"_21207":41939,"_5":25256,"_9967":41891,"_1768":41940},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_4557":1548,"_25012":1525,"_21207":41942,"_5":25256,"_9967":41895,"_1768":41943},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_4557":1549,"_25012":1525,"_21207":41945,"_5":25256,"_9967":41895,"_1768":41946},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_4557":1550,"_25012":1525,"_21207":41948,"_5":25256,"_9967":41895,"_1768":41949},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_4557":1551,"_25012":1525,"_21207":41951,"_5":25256,"_9967":41895,"_1768":39924},[],{"_4557":1552,"_25012":1552,"_5":25251,"_1768":41953,"_25264":41954,"_21207":41955,"_9967":1552},"Plataforma Lamassu IoT",[37104,38188],[],{"_4557":1553,"_25012":1552,"_21207":41957,"_5":25256,"_9967":1552,"_1768":41958},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_4557":1554,"_25012":1552,"_5":25261,"_21207":41960,"_9967":41961,"_1768":41962},[],"/docs/platform/pki/overview#empieza-aquí","Empieza aquí",{"_4557":1555,"_25012":1552,"_5":25261,"_21207":41964,"_9967":41965,"_1768":41966},[],"/docs/platform/pki/overview#capacidades-principales","Capacidades principales",{"_4557":1556,"_25012":1552,"_5":25261,"_21207":41968,"_9967":41969,"_1768":41970},[],"/docs/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_4557":1557,"_25012":1552,"_5":25261,"_21207":41972,"_9967":41973,"_1768":41974},[],"/docs/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_4557":1558,"_25012":1552,"_5":25261,"_21207":41976,"_9967":41977,"_1768":41978},[],"/docs/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_4557":1559,"_25012":1552,"_5":25261,"_21207":41980,"_9967":41981,"_1768":41982},[],"/docs/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_4557":1560,"_25012":1552,"_5":25261,"_21207":41984,"_9967":41985,"_1768":41986},[],"/docs/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_4557":1561,"_25012":1552,"_5":25261,"_21207":41988,"_9967":41989,"_1768":41990},[],"/docs/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_4557":1562,"_25012":1552,"_5":25261,"_21207":41992,"_9967":41993,"_1768":41994},[],"/docs/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_4557":1563,"_25012":1552,"_5":25261,"_21207":41996,"_9967":41997,"_1768":41998},[],"/docs/platform/pki/overview#referencia-operativa","Referencia operativa",{"_4557":1564,"_25012":1552,"_21207":42000,"_5":25256,"_9967":1552,"_1768":42001},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_4557":1565,"_25012":1552,"_21207":42003,"_5":25256,"_9967":41961,"_1768":42004},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4557":1566,"_25012":1552,"_21207":42006,"_5":25256,"_9967":41961,"_1768":42007},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_4557":1567,"_25012":1552,"_21207":42009,"_5":25256,"_9967":41969,"_1768":42010},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_4557":1568,"_25012":1552,"_21207":42012,"_5":25256,"_9967":41973,"_1768":42013},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_4557":1569,"_25012":1552,"_21207":42015,"_5":25256,"_9967":41977,"_1768":42016},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_4557":1570,"_25012":1552,"_21207":42018,"_5":25256,"_9967":41981,"_1768":42019},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_4557":1571,"_25012":1552,"_21207":42021,"_5":25256,"_9967":41985,"_1768":42022},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_4557":1572,"_25012":1552,"_21207":42024,"_5":25256,"_9967":41989,"_1768":42025},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_4557":1573,"_25012":1552,"_21207":42027,"_5":25256,"_9967":41993,"_1768":42028},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_4557":1574,"_25012":1552,"_21207":42030,"_5":25256,"_9967":41993,"_1768":42031},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4557":1575,"_25012":1552,"_21207":42033,"_5":25256,"_9967":41993,"_1768":42034},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_4557":1576,"_25012":1552,"_21207":42036,"_5":25256,"_9967":41993,"_1768":42037},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_4557":1577,"_25012":1552,"_21207":42039,"_5":25256,"_9967":41997,"_1768":42040},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_4557":1578,"_25012":1552,"_21207":42042,"_5":25256,"_9967":41997,"_1768":42043},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_4557":1579,"_25012":1552,"_21207":42045,"_5":25256,"_9967":41997,"_1768":42046},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_4557":1580,"_25012":1552,"_21207":42048,"_5":25256,"_9967":41997,"_1768":42049},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4557":1581,"_25012":1581,"_5":25251,"_1768":42051,"_25264":42052,"_21207":42054,"_9967":1581},"Crea tu primera CA",[37104,38188,42053],"Primeros pasos",[],{"_4557":1582,"_25012":1581,"_21207":42056,"_5":25256,"_9967":1581,"_1768":42057},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_4557":1583,"_25012":1581,"_5":25261,"_21207":42059,"_9967":42060,"_1768":37114},[],"/docs/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_4557":1584,"_25012":1581,"_5":25261,"_21207":42062,"_9967":42063,"_1768":42064},[],"/docs/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_4557":1585,"_25012":1581,"_5":25261,"_21207":42066,"_9967":42067,"_1768":42068},[],"/docs/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_4557":1586,"_25012":1581,"_5":25261,"_21207":42070,"_9967":42071,"_1768":42072},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_4557":1587,"_25012":1581,"_5":25261,"_21207":42074,"_9967":42075,"_1768":42076},[],"/docs/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_4557":1588,"_25012":1581,"_5":25261,"_21207":42078,"_9967":42079,"_1768":42080},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_4557":1589,"_25012":1581,"_5":25261,"_21207":42082,"_9967":42083,"_1768":37138},[],"/docs/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_4557":1590,"_25012":1581,"_21207":42085,"_5":25256,"_9967":1581,"_1768":42086},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_4557":1591,"_25012":1581,"_21207":42088,"_5":25256,"_9967":42060,"_1768":42089},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_4557":1592,"_25012":1581,"_21207":42091,"_5":25256,"_9967":42060,"_1768":42092},[],"Al menos un motor criptográfico disponible.",{"_4557":1593,"_25012":1581,"_21207":42094,"_5":25256,"_9967":42060,"_1768":42095},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_4557":1594,"_25012":1581,"_21207":42097,"_5":25256,"_9967":42060,"_1768":42098},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_4557":1595,"_25012":1581,"_21207":42100,"_5":25256,"_9967":42063,"_1768":42101},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_4557":1596,"_25012":1581,"_21207":42103,"_5":25256,"_9967":42063,"_1768":42104},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_4557":1597,"_25012":1581,"_21207":42106,"_5":25256,"_9967":42067,"_1768":42107},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_4557":1598,"_25012":1581,"_21207":42109,"_5":25256,"_9967":42067,"_1768":42110},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_4557":1599,"_25012":1581,"_21207":42112,"_5":25256,"_9967":42071,"_1768":42113},[],"Selecciona **Root CA** y completa:",{"_4557":1600,"_25012":1581,"_21207":42115,"_5":25256,"_9967":42071,"_1768":42116},[],"**CA Name**: un nombre único y reconocible.",{"_4557":1601,"_25012":1581,"_21207":42118,"_5":25256,"_9967":42071,"_1768":42119},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_4557":1602,"_25012":1581,"_21207":42121,"_5":25256,"_9967":42071,"_1768":42122},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_4557":1603,"_25012":1581,"_21207":42124,"_5":25256,"_9967":42071,"_1768":42125},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_4557":1604,"_25012":1581,"_21207":42127,"_5":25256,"_9967":42071,"_1768":42128},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_4557":1605,"_25012":1581,"_21207":42130,"_5":25256,"_9967":42075,"_1768":42131},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_4557":1606,"_25012":1581,"_21207":42133,"_5":25256,"_9967":42079,"_1768":42134},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_4557":1607,"_25012":1581,"_21207":42136,"_5":25256,"_9967":42083,"_1768":42137},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_4557":1608,"_25012":1608,"_5":25251,"_1768":42139,"_25264":42140,"_21207":42141,"_9967":1608},"Emite tu primer certificado",[37104,38188,42053],[],{"_4557":1609,"_25012":1608,"_21207":42143,"_5":25256,"_9967":1608,"_1768":42144},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_4557":1610,"_25012":1608,"_5":25261,"_21207":42146,"_9967":42147,"_1768":37114},[],"/docs/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_4557":1611,"_25012":1608,"_5":25261,"_21207":42149,"_9967":42150,"_1768":42151},[],"/docs/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_4557":1612,"_25012":1608,"_5":25261,"_21207":42153,"_9967":42154,"_1768":42155},[],"/docs/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_4557":1613,"_25012":1608,"_5":25261,"_21207":42157,"_9967":42158,"_1768":42159},[],"/docs/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_4557":1614,"_25012":1608,"_5":25261,"_21207":42161,"_9967":42162,"_1768":42163},[],"/docs/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_4557":1615,"_25012":1608,"_5":25261,"_21207":42165,"_9967":42166,"_1768":42167},[],"/docs/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_4557":1616,"_25012":1608,"_5":25261,"_21207":42169,"_9967":42170,"_1768":42080},[],"/docs/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_4557":1617,"_25012":1608,"_5":25261,"_21207":42172,"_9967":42173,"_1768":37138},[],"/docs/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_4557":1618,"_25012":1608,"_21207":42175,"_5":25256,"_9967":1608,"_1768":42176},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_4557":1619,"_25012":1608,"_21207":42178,"_5":25256,"_9967":42147,"_1768":42179},[],"Una CA activa con permiso para emitir certificados.",{"_4557":1620,"_25012":1608,"_21207":42181,"_5":25256,"_9967":42147,"_1768":42182},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_4557":1621,"_25012":1608,"_21207":42184,"_5":25256,"_9967":42147,"_1768":42185},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_4557":1622,"_25012":1608,"_21207":42187,"_5":25256,"_9967":42147,"_1768":42188},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_4557":1623,"_25012":1608,"_21207":42190,"_5":25256,"_9967":42150,"_1768":42191},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_4557":1624,"_25012":1608,"_21207":42193,"_5":25256,"_9967":42154,"_1768":42194},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_4557":1625,"_25012":1608,"_21207":42196,"_5":25256,"_9967":42158,"_1768":42197},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_4557":1626,"_25012":1608,"_21207":42199,"_5":25256,"_9967":42162,"_1768":42200},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_4557":1627,"_25012":1608,"_21207":42202,"_5":25256,"_9967":42162,"_1768":42203},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_4557":1628,"_25012":1608,"_21207":42205,"_5":25256,"_9967":42166,"_1768":42206},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_4557":1629,"_25012":1608,"_21207":42208,"_5":25256,"_9967":42170,"_1768":42209},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_4557":1630,"_25012":1608,"_21207":42211,"_5":25256,"_9967":42173,"_1768":42212},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_4557":1631,"_25012":1631,"_5":25251,"_1768":42053,"_25264":42214,"_21207":42215,"_9967":1631},[37104,38188,42053],[],{"_4557":1632,"_25012":1631,"_21207":42217,"_5":25256,"_9967":1631,"_1768":42218},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_4557":1633,"_25012":1631,"_5":25261,"_21207":42220,"_9967":42221,"_1768":42222},[],"/docs/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_4557":1634,"_25012":1631,"_5":25261,"_21207":42224,"_9967":42225,"_1768":37114},[],"/docs/platform/pki/quickstarts/overview#antes-de-empezar",{"_4557":1635,"_25012":1631,"_21207":42227,"_5":25256,"_9967":1631,"_1768":42228},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_4557":1636,"_25012":1631,"_21207":42230,"_5":25256,"_9967":42221,"_1768":42231},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4557":1637,"_25012":1631,"_21207":42233,"_5":25256,"_9967":42221,"_1768":42234},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4557":1638,"_25012":1631,"_21207":42236,"_5":25256,"_9967":42221,"_1768":42237},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_4557":1639,"_25012":1631,"_21207":42239,"_5":25256,"_9967":42225,"_1768":42240},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_4557":1640,"_25012":1631,"_21207":42242,"_5":25256,"_9967":42225,"_1768":42243},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_4557":1641,"_25012":1641,"_5":25251,"_1768":42245,"_25264":42246,"_21207":42247,"_9967":1641},"Registra tu primer dispositivo",[37104,38188,42053],[],{"_4557":1642,"_25012":1641,"_21207":42249,"_5":25256,"_9967":1641,"_1768":42250},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_4557":1643,"_25012":1641,"_5":25261,"_21207":42252,"_9967":42253,"_1768":37114},[],"/docs/platform/pki/quickstarts/register-device#antes-de-empezar",{"_4557":1644,"_25012":1641,"_5":25261,"_21207":42255,"_9967":42256,"_1768":42257},[],"/docs/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_4557":1645,"_25012":1641,"_5":25261,"_21207":42259,"_9967":42260,"_1768":42261},[],"/docs/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_4557":1646,"_25012":1641,"_5":25261,"_21207":42263,"_9967":42264,"_1768":42265},[],"/docs/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_4557":1647,"_25012":1641,"_5":25261,"_21207":42267,"_9967":42268,"_1768":42269},[],"/docs/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_4557":1648,"_25012":1641,"_5":25261,"_21207":42271,"_9967":42272,"_1768":42273},[],"/docs/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_4557":1649,"_25012":1641,"_21207":42275,"_5":25256,"_9967":1641,"_1768":42276},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_4557":1650,"_25012":1641,"_21207":42278,"_5":25256,"_9967":42253,"_1768":42279},[],"Un DMS configurado.",{"_4557":1651,"_25012":1641,"_21207":42281,"_5":25256,"_9967":42253,"_1768":42282},[],"Una CA asociada al DMS.",{"_4557":1652,"_25012":1641,"_21207":42284,"_5":25256,"_9967":42253,"_1768":42285},[],"Un identificador único para el dispositivo.",{"_4557":1653,"_25012":1641,"_21207":42287,"_5":25256,"_9967":42256,"_1768":42288},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_4557":1654,"_25012":1641,"_21207":42290,"_5":25256,"_9967":42256,"_1768":42291},[],"**Device ID**: identificador único del dispositivo.",{"_4557":1655,"_25012":1641,"_21207":42293,"_5":25256,"_9967":42256,"_1768":42294},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_4557":1656,"_25012":1641,"_21207":42296,"_5":25256,"_9967":42256,"_1768":42297},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_4557":1657,"_25012":1641,"_21207":42299,"_5":25256,"_9967":42260,"_1768":42300},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_4557":1658,"_25012":1641,"_21207":42302,"_5":25256,"_9967":42264,"_1768":42303},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_4557":1659,"_25012":1641,"_21207":42305,"_5":25256,"_9967":42264,"_1768":42306},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_4557":1660,"_25012":1641,"_21207":42308,"_5":25256,"_9967":42268,"_1768":42309},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_4557":1661,"_25012":1641,"_21207":42311,"_5":25256,"_9967":42272,"_1768":42312},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_4557":1662,"_25012":1662,"_5":25251,"_1768":42314,"_25264":42315,"_21207":42316,"_9967":1662},"Resolución de problemas",[37104,38188,38189],[],{"_4557":1663,"_25012":1662,"_21207":42318,"_5":25256,"_9967":1662,"_1768":42319},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_4557":1664,"_25012":1662,"_5":25261,"_21207":42321,"_9967":42322,"_1768":42323},[],"/docs/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_4557":1665,"_25012":1662,"_5":25261,"_21207":42325,"_9967":42326,"_1768":42327},[],"/docs/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_4557":1666,"_25012":1662,"_5":25261,"_21207":42329,"_9967":42330,"_1768":42331},[],"/docs/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_4557":1667,"_25012":1662,"_5":25261,"_21207":42333,"_9967":42334,"_1768":42335},[],"/docs/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_4557":1668,"_25012":1662,"_5":25261,"_21207":42337,"_9967":42338,"_1768":42339},[],"/docs/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_4557":1669,"_25012":1662,"_5":25261,"_21207":42341,"_9967":42342,"_1768":42343},[],"/docs/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_4557":1670,"_25012":1662,"_5":25261,"_21207":42345,"_9967":42346,"_1768":42347},[],"/docs/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_4557":1671,"_25012":1662,"_5":25261,"_21207":42349,"_9967":42350,"_1768":42351},[],"/docs/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_4557":1672,"_25012":1662,"_5":25261,"_21207":42353,"_9967":42354,"_1768":42355},[],"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_4557":1673,"_25012":1662,"_5":25261,"_21207":42357,"_9967":42358,"_1768":42359},[],"/docs/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_4557":1674,"_25012":1662,"_5":25261,"_21207":42361,"_9967":42362,"_1768":42363},[],"/docs/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_4557":1675,"_25012":1662,"_5":25261,"_21207":42365,"_9967":42366,"_1768":42367},[],"/docs/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_4557":1676,"_25012":1662,"_5":25261,"_21207":42369,"_9967":42370,"_1768":42371},[],"/docs/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_4557":1677,"_25012":1662,"_5":25261,"_21207":42373,"_9967":42374,"_1768":42375},[],"/docs/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_4557":1678,"_25012":1662,"_5":25261,"_21207":42377,"_9967":42378,"_1768":42379},[],"/docs/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_4557":1679,"_25012":1662,"_21207":42381,"_5":25256,"_9967":1662,"_1768":42382},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_4557":1680,"_25012":1662,"_21207":42384,"_5":25256,"_9967":42326,"_1768":42385},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_4557":1681,"_25012":1662,"_21207":42387,"_5":25256,"_9967":42330,"_1768":42388},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_4557":1682,"_25012":1662,"_21207":42390,"_5":25256,"_9967":42334,"_1768":42391},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_4557":1683,"_25012":1662,"_21207":42393,"_5":25256,"_9967":42338,"_1768":42394},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_4557":1684,"_25012":1662,"_21207":42396,"_5":25256,"_9967":42342,"_1768":42397},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_4557":1685,"_25012":1662,"_21207":42399,"_5":25256,"_9967":42346,"_1768":42400},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_4557":1686,"_25012":1662,"_21207":42402,"_5":25256,"_9967":42346,"_1768":42403},[],"Ejecuta también la prueba de conectividad del chart:",{"_4557":1687,"_25012":1662,"_21207":42405,"_5":25256,"_9967":42346,"_1768":42406},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_4557":1688,"_25012":1662,"_21207":42408,"_5":25256,"_9967":42346,"_1768":42409},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_4557":1689,"_25012":1662,"_21207":42411,"_5":25256,"_9967":42350,"_1768":42412},[],"Si recibes un 401:",{"_4557":1690,"_25012":1662,"_21207":42414,"_5":25256,"_9967":42350,"_1768":42415},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_4557":1691,"_25012":1662,"_21207":42417,"_5":25256,"_9967":42350,"_1768":42418},[],"verifica emisor, audiencia y expiración del token;",{"_4557":1692,"_25012":1662,"_21207":42420,"_5":25256,"_9967":42350,"_1768":42421},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_4557":1693,"_25012":1662,"_21207":42423,"_5":25256,"_9967":42350,"_1768":42424},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_4557":1694,"_25012":1662,"_21207":42426,"_5":25256,"_9967":42350,"_1768":42427},[],"Si el login termina pero las APIs devuelven 403:",{"_4557":1695,"_25012":1662,"_21207":42429,"_5":25256,"_9967":42350,"_1768":42430},[],"inspecciona los claims reales del token;",{"_4557":1696,"_25012":1662,"_21207":42432,"_5":25256,"_9967":42350,"_1768":42433},[],"confirma que coinciden con un principal activo;",{"_4557":1697,"_25012":1662,"_21207":42435,"_5":25256,"_9967":42350,"_1768":42436},[],"revisa las políticas concedidas al principal;",{"_4557":1698,"_25012":1662,"_21207":42438,"_5":25256,"_9967":42350,"_1768":42439},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_4557":1699,"_25012":1662,"_21207":42441,"_5":25256,"_9967":42350,"_1768":42442},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_4557":1700,"_25012":1662,"_21207":42444,"_5":25256,"_9967":42354,"_1768":42445},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_4557":1701,"_25012":1662,"_21207":42447,"_5":25256,"_9967":42354,"_1768":42448},[],"Localiza el pod y Service de authz.",{"_4557":1702,"_25012":1662,"_21207":42450,"_5":25256,"_9967":42354,"_1768":42451},[],"Comprueba /health, logs y conexión a su base de datos.",{"_4557":1703,"_25012":1662,"_21207":42453,"_5":25256,"_9967":42354,"_1768":42454},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_4557":1704,"_25012":1662,"_21207":42456,"_5":25256,"_9967":42354,"_1768":42457},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_4557":1705,"_25012":1662,"_21207":42459,"_5":25256,"_9967":42354,"_1768":42460},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_4557":1706,"_25012":1662,"_21207":42462,"_5":25256,"_9967":42358,"_1768":42463},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_4557":1707,"_25012":1662,"_21207":42465,"_5":25256,"_9967":42358,"_1768":42466},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_4557":1708,"_25012":1662,"_21207":42468,"_5":25256,"_9967":42358,"_1768":42469},[],"volumen persistente sin enlazar;",{"_4557":1709,"_25012":1662,"_21207":42471,"_5":25256,"_9967":42358,"_1768":42472},[],"imagen inaccesible o política de pull incorrecta;",{"_4557":1710,"_25012":1662,"_21207":42474,"_5":25256,"_9967":42358,"_1768":42475},[],"configuración inválida del motor criptográfico;",{"_4557":1711,"_25012":1662,"_21207":42477,"_5":25256,"_9967":42358,"_1768":42478},[],"límites de CPU o memoria demasiado bajos;",{"_4557":1712,"_25012":1662,"_21207":42480,"_5":25256,"_9967":42358,"_1768":42481},[],"migración previa incompleta.",{"_4557":1713,"_25012":1662,"_21207":42483,"_5":25256,"_9967":42358,"_1768":42484},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_4557":1714,"_25012":1662,"_21207":42486,"_5":25256,"_9967":42358,"_1768":42487},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_4557":1715,"_25012":1662,"_21207":42489,"_5":25256,"_9967":42362,"_1768":42490},[],"Acota el error siguiendo este orden:",{"_4557":1716,"_25012":1662,"_21207":42492,"_5":25256,"_9967":42362,"_1768":42493},[],"La CA existe, está activa y no ha expirado.",{"_4557":1717,"_25012":1662,"_21207":42495,"_5":25256,"_9967":42362,"_1768":42496},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_4557":1718,"_25012":1662,"_21207":42498,"_5":25256,"_9967":42362,"_1768":42499},[],"La CSR tiene una firma válida.",{"_4557":1719,"_25012":1662,"_21207":42501,"_5":25256,"_9967":42362,"_1768":42502},[],"El perfil permite el tipo y tamaño de clave.",{"_4557":1720,"_25012":1662,"_21207":42504,"_5":25256,"_9967":42362,"_1768":42505},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_4557":1721,"_25012":1662,"_21207":42507,"_5":25256,"_9967":42362,"_1768":42508},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_4557":1722,"_25012":1662,"_21207":42510,"_5":25256,"_9967":42362,"_1768":42511},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_4557":1723,"_25012":1662,"_21207":42513,"_5":25256,"_9967":42366,"_1768":42514},[],"Comprueba:",{"_4557":1724,"_25012":1662,"_21207":42516,"_5":25256,"_9967":42366,"_1768":42517},[],"el identificador del DMS en el path EST;",{"_4557":1725,"_25012":1662,"_21207":42519,"_5":25256,"_9967":42366,"_1768":42520},[],"el método de autenticación configurado;",{"_4557":1726,"_25012":1662,"_21207":42522,"_5":25256,"_9967":42366,"_1768":42523},[],"la cadena presentada por el cliente;",{"_4557":1727,"_25012":1662,"_21207":42525,"_5":25256,"_9967":42366,"_1768":42526},[],"las CAs de validación y el límite de niveles;",{"_4557":1728,"_25012":1662,"_21207":42528,"_5":25256,"_9967":42366,"_1768":42529},[],"el estado de revocación del certificado cliente;",{"_4557":1729,"_25012":1662,"_21207":42531,"_5":25256,"_9967":42366,"_1768":42532},[],"la firma de la CSR;",{"_4557":1730,"_25012":1662,"_21207":42534,"_5":25256,"_9967":42366,"_1768":42535},[],"la CA y el perfil usados para emitir;",{"_4557":1731,"_25012":1662,"_21207":42537,"_5":25256,"_9967":42366,"_1768":42538},[],"la ventana de re-enrolamiento.",{"_4557":1732,"_25012":1662,"_21207":42540,"_5":25256,"_9967":42366,"_1768":42541},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_4557":1733,"_25012":1662,"_21207":42543,"_5":25256,"_9967":42370,"_1768":42544},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_4557":1734,"_25012":1662,"_21207":42546,"_5":25256,"_9967":42370,"_1768":42547},[],"Revisa la configuración y logs de VA.",{"_4557":1735,"_25012":1662,"_21207":42549,"_5":25256,"_9967":42370,"_1768":42550},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_4557":1736,"_25012":1662,"_21207":42552,"_5":25256,"_9967":42370,"_1768":42553},[],"Descarta cachés intermedias en proxy y cliente.",{"_4557":1737,"_25012":1662,"_21207":42555,"_5":25256,"_9967":42370,"_1768":42556},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_4557":1738,"_25012":1662,"_21207":42558,"_5":25256,"_9967":42370,"_1768":42559},[],"Consulta por número de serie y emisor correctos.",{"_4557":1739,"_25012":1662,"_21207":42561,"_5":25256,"_9967":42374,"_1768":42562},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_4557":1740,"_25012":1662,"_21207":42564,"_5":25256,"_9967":42374,"_1768":42565},[],"verifica que esté habilitado en el servicio emisor;",{"_4557":1741,"_25012":1662,"_21207":42567,"_5":25256,"_9967":42374,"_1768":42568},[],"comprueba conectividad y credenciales AMQP;",{"_4557":1742,"_25012":1662,"_21207":42570,"_5":25256,"_9967":42374,"_1768":42571},[],"revisa exchange, routing key, colas y consumidores;",{"_4557":1743,"_25012":1662,"_21207":42573,"_5":25256,"_9967":42374,"_1768":42574},[],"inspecciona dead-letter queues;",{"_4557":1744,"_25012":1662,"_21207":42576,"_5":25256,"_9967":42374,"_1768":42577},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_4557":1745,"_25012":1662,"_21207":42579,"_5":25256,"_9967":42374,"_1768":42580},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_4557":1746,"_25012":1662,"_21207":42582,"_5":25256,"_9967":42378,"_1768":42583},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_4557":1747,"_25012":1662,"_21207":42585,"_5":25256,"_9967":42378,"_1768":42586},[],"Antes de cerrar una incidencia, guarda:",{"_4557":1748,"_25012":1662,"_21207":42588,"_5":25256,"_9967":42378,"_1768":42589},[],"causa confirmada;",{"_4557":1749,"_25012":1662,"_21207":42591,"_5":25256,"_9967":42378,"_1768":42592},[],"alcance temporal y recursos afectados;",{"_4557":1750,"_25012":1662,"_21207":42594,"_5":25256,"_9967":42378,"_1768":42595},[],"comandos o consultas utilizados;",{"_4557":1751,"_25012":1662,"_21207":42597,"_5":25256,"_9967":42378,"_1768":42598},[],"cambio aplicado y forma de revertirlo;",{"_4557":1752,"_25012":1662,"_21207":42600,"_5":25256,"_9967":42378,"_1768":42601},[],"validación desde un consumidor;",{"_4557":1753,"_25012":1662,"_21207":42603,"_5":25256,"_9967":42378,"_1768":42604},[],"acción preventiva y propietario.",{"_4557":1754,"_25012":1754,"_5":25251,"_1768":42606,"_21207":42607,"_9967":1754},"Test",[],{"_4557":1755,"_25012":1754,"_21207":42609,"_5":25256,"_9967":1754,"_1768":42610},[],"A document to test Fumadocs",{"_4557":1756,"_25012":1754,"_5":25261,"_21207":42612,"_9967":42613,"_1768":42614},[],"/docs/test#cards","Cards",{"_4557":1757,"_25012":1754,"_5":25261,"_21207":42616,"_9967":42617,"_1768":42618},[],"/docs/test#codeblock","CodeBlock",{"_4557":1758,"_25012":1754,"_5":25261,"_21207":42620,"_9967":42621,"_1768":42622},[],"/docs/test#list","List",{"_4557":1759,"_25012":1754,"_21207":42624,"_5":25256,"_996