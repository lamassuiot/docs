380":58385},{"_3464":15,"_30209":15,"_5":14725,"_2948":49242,"_30541":49243,"_20922":49247,"_27447":15},"Deploy from AWS Marketplace",[49244,49245,49246],"Docs","Deployment","Other models",[],{"_3464":16,"_30209":15,"_20922":49249,"_5":14373,"_27447":15,"_2948":49250},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3464":17,"_30209":15,"_5":30538,"_20922":49252,"_27447":49253,"_2948":49254},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3464":18,"_30209":15,"_5":30538,"_20922":49256,"_27447":49257,"_2948":49258},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3464":19,"_30209":15,"_5":30538,"_20922":49260,"_27447":49261,"_2948":49262},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3464":20,"_30209":15,"_5":30538,"_20922":49264,"_27447":49265,"_2948":49266},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3464":21,"_30209":15,"_5":30538,"_20922":49268,"_27447":49269,"_2948":49270},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3464":22,"_30209":15,"_5":30538,"_20922":49272,"_27447":49273,"_2948":49274},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3464":23,"_30209":15,"_5":30538,"_20922":49276,"_27447":49277,"_2948":49278},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3464":24,"_30209":15,"_20922":49280,"_5":14373,"_27447":15,"_2948":49281},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3464":25,"_30209":15,"_20922":49283,"_5":14373,"_27447":49253,"_2948":49284},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3464":26,"_30209":15,"_20922":49286,"_5":14373,"_27447":49253,"_2948":49287},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3464":27,"_30209":15,"_20922":49289,"_5":14373,"_27447":49253,"_2948":49290},[],"A security group allowing the necessary endpoints.",{"_3464":28,"_30209":15,"_20922":49292,"_5":14373,"_27447":49257,"_2948":49293},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3464":29,"_30209":15,"_20922":49295,"_5":14373,"_27447":49257,"_2948":49296},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3464":30,"_30209":15,"_20922":49298,"_5":14373,"_27447":49257,"_2948":49299},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3464":31,"_30209":15,"_20922":49301,"_5":14373,"_27447":49261,"_2948":49302},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3464":32,"_30209":15,"_20922":49304,"_5":14373,"_27447":49265,"_2948":49305},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3464":33,"_30209":15,"_20922":49307,"_5":14373,"_27447":49269,"_2948":49308},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3464":34,"_30209":15,"_20922":49310,"_5":14373,"_27447":49273,"_2948":49311},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3464":35,"_30209":15,"_20922":49313,"_5":14373,"_27447":49277,"_2948":49314},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3464":36,"_30209":36,"_5":14725,"_2948":49316,"_30541":49317,"_20922":49318,"_27447":36},"Deploy Lamassu",[49244,49245],[],{"_3464":37,"_30209":36,"_20922":49320,"_5":14373,"_27447":36,"_2948":49321},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3464":38,"_30209":36,"_5":30538,"_20922":49323,"_27447":49324,"_2948":49325},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3464":39,"_30209":36,"_5":30538,"_20922":49327,"_27447":49328,"_2948":49329},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3464":40,"_30209":36,"_5":30538,"_20922":49331,"_27447":49332,"_2948":49333},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3464":41,"_30209":36,"_20922":49335,"_5":14373,"_27447":36,"_2948":49336},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3464":42,"_30209":36,"_20922":49338,"_5":14373,"_27447":49324,"_2948":49339},[],"Model",{"_3464":43,"_30209":36,"_20922":49341,"_5":14373,"_27447":49324,"_2948":49342},[],"Recommended for",{"_3464":44,"_30209":36,"_20922":49344,"_5":14373,"_27447":49324,"_2948":49345},[],"Who operates the infrastructure",{"_3464":45,"_30209":36,"_20922":49347,"_5":14373,"_27447":49324,"_2948":49348},[],"Starting point",{"_3464":46,"_30209":36,"_20922":49350,"_5":14373,"_27447":49324,"_2948":49351},[],"Kubernetes self-managed",{"_3464":47,"_30209":36,"_20922":49353,"_5":14373,"_27447":49324,"_2948":49354},[],"Production, regulated environments and custom deployments",{"_3464":48,"_30209":36,"_20922":49356,"_5":14373,"_27447":49324,"_2948":49357},[],"Your team",{"_3464":49,"_30209":36,"_20922":49359,"_5":14373,"_27447":49324,"_2948":49360},[],"Helm or Fastlane",{"_3464":50,"_30209":36,"_20922":49362,"_5":14373,"_27447":49324,"_2948":49363},[],"AWS Marketplace",{"_3464":51,"_30209":36,"_20922":49365,"_5":14373,"_27447":49324,"_2948":49366},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3464":52,"_30209":36,"_20922":49368,"_5":14373,"_27447":49324,"_2948":49357},[],{"_3464":53,"_30209":36,"_20922":49370,"_5":14373,"_27447":49324,"_2948":49371},[],"Preconfigured image on EC2",{"_3464":54,"_30209":36,"_20922":49373,"_5":14373,"_27447":49324,"_2948":49374},[],"SaaS",{"_3464":55,"_30209":36,"_20922":49376,"_5":14373,"_27447":49324,"_2948":49377},[],"Teams that want to use the platform without operating it",{"_3464":56,"_30209":36,"_20922":49379,"_5":14373,"_27447":49324,"_2948":49380},[],"Lamassu",{"_3464":57,"_30209":36,"_20922":49382,"_5":14373,"_27447":49324,"_2948":49383},[],"Managed subscription",{"_3464":58,"_30209":36,"_20922":49385,"_5":14373,"_27447":49324,"_2948":49386},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3464":59,"_30209":36,"_20922":49388,"_5":14373,"_27447":49324,"_2948":49389},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3464":60,"_30209":36,"_20922":49391,"_5":14373,"_27447":49324,"_2948":49392},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3464":61,"_30209":36,"_20922":49394,"_5":14373,"_27447":49328,"_2948":49395},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3464":62,"_30209":36,"_20922":49397,"_5":14373,"_27447":49332,"_2948":49398},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3464":63,"_30209":63,"_5":14725,"_2948":49400,"_30541":49401,"_20922":49402,"_27447":63},"Use Lamassu as SaaS",[49244,49245,49246],[],{"_3464":64,"_30209":63,"_20922":49404,"_5":14373,"_27447":63,"_2948":49405},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3464":65,"_30209":63,"_5":30538,"_20922":49407,"_27447":49408,"_2948":49409},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3464":66,"_30209":63,"_5":30538,"_20922":49411,"_27447":49412,"_2948":49413},[],"/docs/deployment/saas#plans","Plans",{"_3464":67,"_30209":63,"_5":30538,"_20922":49415,"_27447":49416,"_2948":49417},[],"/docs/deployment/saas#request-access","Request access",{"_3464":68,"_30209":63,"_20922":49419,"_5":14373,"_27447":63,"_2948":49420},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3464":69,"_30209":63,"_20922":49422,"_5":14373,"_27447":49408,"_2948":49423},[],"Platform availability and maintenance.",{"_3464":70,"_30209":63,"_20922":49425,"_5":14373,"_27447":49408,"_2948":49426},[],"Automatic backups.",{"_3464":71,"_30209":63,"_20922":49428,"_5":14373,"_27447":49408,"_2948":49429},[],"Version upgrades.",{"_3464":72,"_30209":63,"_20922":49431,"_5":14373,"_27447":49408,"_2948":49432},[],"Technical support and SLA according to your plan.",{"_3464":73,"_30209":63,"_20922":49434,"_5":14373,"_27447":49412,"_2948":49435},[],"Plan",{"_3464":74,"_30209":63,"_20922":49437,"_5":14373,"_27447":49412,"_2948":49438},[],"Devices",{"_3464":75,"_30209":63,"_20922":49440,"_5":14373,"_27447":49412,"_2948":49441},[],"Support",{"_3464":76,"_30209":63,"_20922":49443,"_5":14373,"_27447":49412,"_2948":49444},[],"SLA",{"_3464":77,"_30209":63,"_20922":49446,"_5":14373,"_27447":49412,"_2948":49447},[],"Starter",{"_3464":78,"_30209":63,"_20922":49449,"_5":14373,"_27447":49412,"_2948":49450},[],"Up to 1,000",{"_3464":79,"_30209":63,"_20922":49452,"_5":14373,"_27447":49412,"_2948":49453},[],"Email",{"_3464":80,"_30209":63,"_20922":49455,"_5":14373,"_27447":49412,"_2948":49456},[],"99.5 %",{"_3464":81,"_30209":63,"_20922":49458,"_5":14373,"_27447":49412,"_2948":49459},[],"Professional",{"_3464":82,"_30209":63,"_20922":49461,"_5":14373,"_27447":49412,"_2948":49462},[],"Up to 10,000",{"_3464":83,"_30209":63,"_20922":49464,"_5":14373,"_27447":49412,"_2948":49465},[],"Email and chat",{"_3464":84,"_30209":63,"_20922":49467,"_5":14373,"_27447":49412,"_2948":49468},[],"99.9 %",{"_3464":85,"_30209":63,"_20922":49470,"_5":14373,"_27447":49412,"_2948":49471},[],"Enterprise",{"_3464":86,"_30209":63,"_20922":49473,"_5":14373,"_27447":49412,"_2948":49474},[],"Unlimited",{"_3464":87,"_30209":63,"_20922":49476,"_5":14373,"_27447":49412,"_2948":49477},[],"Dedicated",{"_3464":88,"_30209":63,"_20922":49479,"_5":14373,"_27447":49412,"_2948":49480},[],"99.99 %",{"_3464":89,"_30209":63,"_20922":49482,"_5":14373,"_27447":49416,"_2948":49483},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3464":90,"_30209":63,"_20922":49485,"_5":14373,"_27447":49416,"_2948":49486},[],"When you receive your instance's credentials, continue with Get started.",{"_3464":91,"_30209":91,"_5":14725,"_2948":49488,"_30541":49489,"_20922":49490,"_27447":91},"Fastlane",[49244,49245,49351],[],{"_3464":92,"_30209":91,"_20922":49492,"_5":14373,"_27447":91,"_2948":49493},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3464":93,"_30209":91,"_5":30538,"_20922":49495,"_27447":49496,"_2948":49497},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3464":94,"_30209":91,"_5":30538,"_20922":49499,"_27447":49500,"_2948":49501},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3464":95,"_30209":91,"_5":30538,"_20922":49503,"_27447":49504,"_2948":49254},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3464":96,"_30209":91,"_5":30538,"_20922":49506,"_27447":49507,"_2948":49508},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3464":97,"_30209":91,"_5":30538,"_20922":49510,"_27447":49511,"_2948":49512},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3464":98,"_30209":91,"_5":30538,"_20922":49514,"_27447":49515,"_2948":49516},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3464":99,"_30209":91,"_5":30538,"_20922":49518,"_27447":49519,"_2948":49520},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3464":100,"_30209":91,"_5":30538,"_20922":49522,"_27447":49523,"_2948":49524},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3464":101,"_30209":91,"_5":30538,"_20922":49526,"_27447":49527,"_2948":49528},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3464":102,"_30209":91,"_5":30538,"_20922":49530,"_27447":49531,"_2948":49532},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3464":103,"_30209":91,"_5":30538,"_20922":49534,"_27447":49535,"_2948":49536},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3464":104,"_30209":91,"_20922":49538,"_5":14373,"_27447":49496,"_2948":49539},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3464":105,"_30209":91,"_20922":49541,"_5":14373,"_27447":49496,"_2948":49542},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3464":106,"_30209":91,"_20922":49544,"_5":14373,"_27447":49500,"_2948":49545},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3464":107,"_30209":91,"_20922":49547,"_5":14373,"_27447":49500,"_2948":49548},[],"Fastlane installs or configures",{"_3464":108,"_30209":91,"_20922":49550,"_5":14373,"_27447":49500,"_2948":49551},[],"You still provide",{"_3464":109,"_30209":91,"_20922":49553,"_5":14373,"_27447":49500,"_2948":49554},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3464":110,"_30209":91,"_20922":49556,"_5":14373,"_27447":49500,"_2948":49557},[],"The Kubernetes cluster, nodes and persistent storage",{"_3464":111,"_30209":91,"_20922":49559,"_5":14373,"_27447":49500,"_2948":49560},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3464":112,"_30209":91,"_20922":49562,"_5":14373,"_27447":49500,"_2948":49563},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3464":113,"_30209":91,"_20922":49565,"_5":14373,"_27447":49500,"_2948":49566},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3464":114,"_30209":91,"_20922":49568,"_5":14373,"_27447":49500,"_2948":49569},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3464":115,"_30209":91,"_20922":49571,"_5":14373,"_27447":49500,"_2948":49572},[],"Optional observability and lab HSM components",{"_3464":116,"_30209":91,"_20922":49574,"_5":14373,"_27447":49500,"_2948":49575},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3464":117,"_30209":91,"_20922":49577,"_5":14373,"_27447":49500,"_2948":49578},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3464":118,"_30209":91,"_20922":49580,"_5":14373,"_27447":49504,"_2948":49581},[],"You need:",{"_3464":119,"_30209":91,"_20922":49583,"_5":14373,"_27447":49504,"_2948":49584},[],"an existing Kubernetes cluster",{"_3464":120,"_30209":91,"_20922":49586,"_5":14373,"_27447":49504,"_2948":49587},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3464":121,"_30209":91,"_20922":49589,"_5":14373,"_27447":49504,"_2948":49590},[],"`yq`",{"_3464":122,"_30209":91,"_20922":49592,"_5":14373,"_27447":49504,"_2948":23655},[],{"_3464":123,"_30209":91,"_20922":49594,"_5":14373,"_27447":49504,"_2948":49595},[],"`jq` only when using `--sample-data` or `--development`",{"_3464":124,"_30209":91,"_20922":49597,"_5":14373,"_27447":49504,"_2948":49598},[],"`ssh-keygen` only when using `--with-hsm`",{"_3464":125,"_30209":91,"_20922":49600,"_5":14373,"_27447":49504,"_2948":49601},[],"free external ports 80 and 443 on a single-node K3s host",{"_3464":126,"_30209":91,"_20922":49603,"_5":14373,"_27447":49504,"_2948":49604},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3464":127,"_30209":91,"_20922":49606,"_5":14373,"_27447":49504,"_2948":49607},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3464":128,"_30209":91,"_20922":49609,"_5":14373,"_27447":49507,"_2948":49610},[],"Run the script from a clone of the Helm repository:",{"_3464":129,"_30209":91,"_20922":49612,"_5":14373,"_27447":49507,"_2948":49613},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3464":130,"_30209":91,"_20922":49615,"_5":14373,"_27447":49511,"_2948":49616},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3464":131,"_30209":91,"_20922":49618,"_5":14373,"_27447":49511,"_2948":49619},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3464":132,"_30209":91,"_20922":49621,"_5":14373,"_27447":49511,"_2948":49622},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3464":133,"_30209":91,"_20922":49624,"_5":14373,"_27447":49511,"_2948":49625},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3464":134,"_30209":91,"_20922":49627,"_5":14373,"_27447":49515,"_2948":49628},[],"Option",{"_3464":135,"_30209":91,"_20922":49630,"_5":14373,"_27447":49515,"_2948":49631},[],"Default",{"_3464":136,"_30209":91,"_20922":49633,"_5":14373,"_27447":49515,"_2948":49634},[],"Purpose",{"_3464":137,"_30209":91,"_20922":49636,"_5":14373,"_27447":49515,"_2948":49637},[],"`-h`, `--help`",{"_3464":138,"_30209":91,"_20922":49639,"_5":14373,"_27447":49515,"_2948":49640},[],"—",{"_3464":139,"_30209":91,"_20922":49642,"_5":14373,"_27447":49515,"_2948":49643},[],"Show help",{"_3464":140,"_30209":91,"_20922":49645,"_5":14373,"_27447":49515,"_2948":49646},[],"`-c`, `--context`",{"_3464":141,"_30209":91,"_20922":49648,"_5":14373,"_27447":49515,"_2948":49649},[],"current context",{"_3464":142,"_30209":91,"_20922":49651,"_5":14373,"_27447":49515,"_2948":49652},[],"Select the kubeconfig context for kubectl and Helm",{"_3464":143,"_30209":91,"_20922":49654,"_5":14373,"_27447":49515,"_2948":49655},[],"`-n`, `--non-interactive`",{"_3464":144,"_30209":91,"_20922":49657,"_5":14373,"_27447":49515,"_2948":6533},[],{"_3464":145,"_30209":91,"_20922":49659,"_5":14373,"_27447":49515,"_2948":49660},[],"Skip prompts and generate dependency credentials",{"_3464":146,"_30209":91,"_20922":49662,"_5":14373,"_27447":49515,"_2948":49663},[],"`-ns`, `--namespace`",{"_3464":147,"_30209":91,"_20922":49665,"_5":14373,"_27447":49515,"_2948":49666},[],"`lamassu-dev`",{"_3464":148,"_30209":91,"_20922":49668,"_5":14373,"_27447":49515,"_2948":49669},[],"Namespace for the installation",{"_3464":149,"_30209":91,"_20922":49671,"_5":14373,"_27447":49515,"_2948":49672},[],"`-d`, `--domain`",{"_3464":150,"_30209":91,"_20922":49674,"_5":14373,"_27447":49515,"_2948":49675},[],"`dev.lamassu.io`",{"_3464":151,"_30209":91,"_20922":49677,"_5":14373,"_27447":49515,"_2948":49678},[],"Domain used by the UI, OIDC and certificate",{"_3464":152,"_30209":91,"_20922":49680,"_5":14373,"_27447":49515,"_2948":49681},[],"`-v`, `--version`",{"_3464":153,"_30209":91,"_20922":49683,"_5":14373,"_27447":49515,"_2948":15070},[],{"_3464":154,"_30209":91,"_20922":49685,"_5":14373,"_27447":49515,"_2948":49686},[],"Lamassu chart version",{"_3464":155,"_30209":91,"_20922":49688,"_5":14373,"_27447":49515,"_2948":49689},[],"`--https-port`",{"_3464":156,"_30209":91,"_20922":49691,"_5":14373,"_27447":49515,"_2948":49692},[],"`443`",{"_3464":157,"_30209":91,"_20922":49694,"_5":14373,"_27447":49515,"_2948":49695},[],"Gateway HTTPS listener port",{"_3464":158,"_30209":91,"_20922":49697,"_5":14373,"_27447":49515,"_2948":49698},[],"`--http-port`",{"_3464":159,"_30209":91,"_20922":49700,"_5":14373,"_27447":49515,"_2948":49701},[],"`80`",{"_3464":160,"_30209":91,"_20922":49703,"_5":14373,"_27447":49515,"_2948":49704},[],"Gateway HTTP listener port",{"_3464":161,"_30209":91,"_20922":49706,"_5":14373,"_27447":49515,"_2948":49707},[],"`--tls-crt`",{"_3464":162,"_30209":91,"_20922":49709,"_5":14373,"_27447":49515,"_2948":49640},[],{"_3464":163,"_30209":91,"_20922":49711,"_5":14373,"_27447":49515,"_2948":49712},[],"PEM certificate for downstream TLS",{"_3464":164,"_30209":91,"_20922":49714,"_5":14373,"_27447":49515,"_2948":49715},[],"`--tls-key`",{"_3464":165,"_30209":91,"_20922":49717,"_5":14373,"_27447":49515,"_2948":49640},[],{"_3464":166,"_30209":91,"_20922":49719,"_5":14373,"_27447":49515,"_2948":49720},[],"PEM private key for downstream TLS",{"_3464":167,"_30209":91,"_20922":49722,"_5":14373,"_27447":49515,"_2948":49723},[],"`-l`, `--local-chart-path`",{"_3464":168,"_30209":91,"_20922":49725,"_5":14373,"_27447":49515,"_2948":49726},[],"repository chart",{"_3464":169,"_30209":91,"_20922":49728,"_5":14373,"_27447":49515,"_2948":49729},[],"Use an unpacked local Lamassu chart",{"_3464":170,"_30209":91,"_20922":49731,"_5":14373,"_27447":49515,"_2948":49732},[],"`-ip`, `--gateway-ip`",{"_3464":171,"_30209":91,"_20922":49734,"_5":14373,"_27447":49515,"_2948":8734},[],{"_3464":172,"_30209":91,"_20922":49736,"_5":14373,"_27447":49515,"_2948":49737},[],"Override the address written to `gateway.addresses`",{"_3464":173,"_30209":91,"_20922":49739,"_5":14373,"_27447":49515,"_2948":49740},[],"`--otel`",{"_3464":174,"_30209":91,"_20922":49742,"_5":14373,"_27447":49515,"_2948":6533},[],{"_3464":175,"_30209":91,"_20922":49744,"_5":14373,"_27447":49515,"_2948":49745},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3464":176,"_30209":91,"_20922":49747,"_5":14373,"_27447":49515,"_2948":49748},[],"`--development`",{"_3464":177,"_30209":91,"_20922":49750,"_5":14373,"_27447":49515,"_2948":6533},[],{"_3464":178,"_30209":91,"_20922":49752,"_5":14373,"_27447":49515,"_2948":49753},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3464":179,"_30209":91,"_20922":49755,"_5":14373,"_27447":49515,"_2948":49756},[],"`--sample-data`",{"_3464":180,"_30209":91,"_20922":49758,"_5":14373,"_27447":49515,"_2948":6533},[],{"_3464":181,"_30209":91,"_20922":49760,"_5":14373,"_27447":49515,"_2948":49761},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3464":182,"_30209":91,"_20922":49763,"_5":14373,"_27447":49515,"_2948":49764},[],"`--with-hsm`",{"_3464":183,"_30209":91,"_20922":49766,"_5":14373,"_27447":49515,"_2948":6533},[],{"_3464":184,"_30209":91,"_20922":49768,"_5":14373,"_27447":49515,"_2948":49769},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3464":185,"_30209":91,"_20922":49771,"_5":14373,"_27447":49515,"_2948":49772},[],"`--softhsm-chart-path`",{"_3464":186,"_30209":91,"_20922":49774,"_5":14373,"_27447":49515,"_2948":49775},[],"`./charts/softhsm`",{"_3464":187,"_30209":91,"_20922":49777,"_5":14373,"_27447":49515,"_2948":49778},[],"Use a different local SoftHSM chart",{"_3464":188,"_30209":91,"_20922":49780,"_5":14373,"_27447":49515,"_2948":49781},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3464":189,"_30209":91,"_20922":49783,"_5":14373,"_27447":49519,"_2948":49784},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3464":190,"_30209":91,"_20922":49786,"_5":14373,"_27447":49519,"_2948":49787},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3464":191,"_30209":91,"_20922":49789,"_5":14373,"_27447":49519,"_2948":49790},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3464":192,"_30209":91,"_20922":49792,"_5":14373,"_27447":49519,"_2948":49793},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3464":193,"_30209":91,"_20922":49795,"_5":14373,"_27447":49519,"_2948":49796},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3464":194,"_30209":91,"_20922":49798,"_5":14373,"_27447":49519,"_2948":49799},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3464":195,"_30209":91,"_20922":49801,"_5":14373,"_27447":49523,"_2948":49802},[],"Fastlane:",{"_3464":196,"_30209":91,"_20922":49804,"_5":14373,"_27447":49523,"_2948":49805},[],"validates local tools and the selected cluster",{"_3464":197,"_30209":91,"_20922":49807,"_5":14373,"_27447":49523,"_2948":49808},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3464":198,"_30209":91,"_20922":49810,"_5":14373,"_27447":49523,"_2948":49811},[],"creates the namespace",{"_3464":199,"_30209":91,"_20922":49813,"_5":14373,"_27447":49523,"_2948":49814},[],"installs PostgreSQL and creates the required databases",{"_3464":200,"_30209":91,"_20922":49816,"_5":14373,"_27447":49523,"_2948":49817},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3464":201,"_30209":91,"_20922":49819,"_5":14373,"_27447":49523,"_2948":49820},[],"installs RabbitMQ",{"_3464":202,"_30209":91,"_20922":49822,"_5":14373,"_27447":49523,"_2948":49823},[],"optionally installs observability and lab HSM components",{"_3464":203,"_30209":91,"_20922":49825,"_5":14373,"_27447":49523,"_2948":49826},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3464":204,"_30209":91,"_20922":49828,"_5":14373,"_27447":49523,"_2948":49829},[],"optionally loads sample data",{"_3464":205,"_30209":91,"_20922":49831,"_5":14373,"_27447":49523,"_2948":49832},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3464":206,"_30209":91,"_20922":49834,"_5":14373,"_27447":49527,"_2948":49835},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3464":207,"_30209":91,"_20922":49837,"_5":14373,"_27447":49527,"_2948":49838},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3464":208,"_30209":91,"_20922":49840,"_5":14373,"_27447":49531,"_2948":49841},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3464":209,"_30209":91,"_20922":49843,"_5":14373,"_27447":49531,"_2948":49844},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3464":210,"_30209":91,"_20922":49846,"_5":14373,"_27447":49531,"_2948":49847},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3464":211,"_30209":91,"_20922":49849,"_5":14373,"_27447":49535,"_2948":49850},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3464":212,"_30209":212,"_5":14725,"_2948":49852,"_30541":49853,"_20922":49854,"_27447":212},"Install with Helm",[49244,49245,49351],[],{"_3464":213,"_30209":212,"_20922":49856,"_5":14373,"_27447":212,"_2948":49857},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3464":214,"_30209":212,"_5":30538,"_20922":49859,"_27447":49860,"_2948":49861},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3464":215,"_30209":212,"_5":30538,"_20922":49863,"_27447":49864,"_2948":49254},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3464":216,"_30209":212,"_5":30538,"_20922":49866,"_27447":49867,"_2948":49868},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3464":217,"_30209":212,"_5":30538,"_20922":49870,"_27447":49871,"_2948":49872},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3464":218,"_30209":212,"_5":30538,"_20922":49874,"_27447":49875,"_2948":49876},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3464":219,"_30209":212,"_5":30538,"_20922":49878,"_27447":49879,"_2948":49880},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3464":220,"_30209":212,"_5":30538,"_20922":49882,"_27447":49883,"_2948":49884},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3464":221,"_30209":212,"_5":30538,"_20922":49886,"_27447":49887,"_2948":49888},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3464":222,"_30209":212,"_5":30538,"_20922":49890,"_27447":49891,"_2948":49892},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3464":223,"_30209":212,"_5":30538,"_20922":49894,"_27447":49895,"_2948":49896},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3464":224,"_30209":212,"_5":30538,"_20922":49898,"_27447":49899,"_2948":49900},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3464":225,"_30209":212,"_20922":49902,"_5":14373,"_27447":49860,"_2948":49903},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3464":226,"_30209":212,"_20922":49905,"_5":14373,"_27447":49864,"_2948":49906},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3464":227,"_30209":212,"_20922":49908,"_5":14373,"_27447":49864,"_2948":49909},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3464":228,"_30209":212,"_20922":49911,"_5":14373,"_27447":49864,"_2948":49912},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3464":229,"_30209":212,"_20922":49914,"_5":14373,"_27447":49864,"_2948":49915},[],"a reachable RabbitMQ broker and credentials",{"_3464":230,"_30209":212,"_20922":49917,"_5":14373,"_27447":49864,"_2948":49918},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3464":231,"_30209":212,"_20922":49920,"_5":14373,"_27447":49864,"_2948":49921},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3464":232,"_30209":212,"_20922":49923,"_5":14373,"_27447":49864,"_2948":49924},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3464":233,"_30209":212,"_20922":49926,"_5":14373,"_27447":49864,"_2948":49927},[],"a StorageClass and an external traffic design",{"_3464":234,"_30209":212,"_20922":49929,"_5":14373,"_27447":49864,"_2948":49930},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3464":235,"_30209":212,"_20922":49932,"_5":14373,"_27447":49864,"_2948":49933},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3464":236,"_30209":212,"_20922":49935,"_5":14373,"_27447":49864,"_2948":49936},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3464":237,"_30209":212,"_20922":49938,"_5":14373,"_27447":49867,"_2948":49939},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3464":238,"_30209":212,"_20922":49941,"_5":14373,"_27447":49867,"_2948":49942},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3464":239,"_30209":212,"_20922":49944,"_5":14373,"_27447":49867,"_2948":49945},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3464":240,"_30209":212,"_20922":49947,"_5":14373,"_27447":49871,"_2948":49948},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3464":241,"_30209":212,"_20922":49950,"_5":14373,"_27447":49871,"_2948":49951},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3464":242,"_30209":212,"_20922":49953,"_5":14373,"_27447":49871,"_2948":49954},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3464":243,"_30209":212,"_20922":49956,"_5":14373,"_27447":49871,"_2948":49957},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3464":244,"_30209":212,"_20922":49959,"_5":14373,"_27447":49875,"_2948":49960},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3464":245,"_30209":212,"_20922":49962,"_5":14373,"_27447":49879,"_2948":49963},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3464":246,"_30209":212,"_20922":49965,"_5":14373,"_27447":49879,"_2948":49966},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3464":247,"_30209":212,"_20922":49968,"_5":14373,"_27447":49879,"_2948":49969},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3464":248,"_30209":212,"_20922":49971,"_5":14373,"_27447":49879,"_2948":49972},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3464":249,"_30209":212,"_20922":49974,"_5":14373,"_27447":49879,"_2948":49975},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3464":250,"_30209":212,"_20922":49977,"_5":14373,"_27447":49879,"_2948":49978},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3464":251,"_30209":212,"_20922":49980,"_5":14373,"_27447":49879,"_2948":49981},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3464":252,"_30209":212,"_20922":49983,"_5":14373,"_27447":49883,"_2948":49984},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3464":253,"_30209":212,"_20922":49986,"_5":14373,"_27447":49883,"_2948":49987},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3464":254,"_30209":212,"_20922":49989,"_5":14373,"_27447":49883,"_2948":49990},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3464":255,"_30209":212,"_20922":49992,"_5":14373,"_27447":49883,"_2948":49993},[],"See Access control for the principal and policy model.",{"_3464":256,"_30209":212,"_20922":49995,"_5":14373,"_27447":49887,"_2948":49996},[],"To install a local checkout instead:",{"_3464":257,"_30209":212,"_20922":49998,"_5":14373,"_27447":49891,"_2948":49999},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3464":258,"_30209":212,"_20922":50001,"_5":14373,"_27447":49891,"_2948":50002},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3464":259,"_30209":212,"_20922":50004,"_5":14373,"_27447":49895,"_2948":50005},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3464":260,"_30209":212,"_20922":50007,"_5":14373,"_27447":49895,"_2948":50008},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3464":261,"_30209":212,"_20922":50010,"_5":14373,"_27447":49895,"_2948":50011},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3464":262,"_30209":212,"_20922":50013,"_5":14373,"_27447":49895,"_2948":50014},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3464":263,"_30209":212,"_20922":50016,"_5":14373,"_27447":49895,"_2948":50017},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3464":264,"_30209":212,"_20922":50019,"_5":14373,"_27447":49899,"_2948":50020},[],"Before going live, review:",{"_3464":265,"_30209":212,"_20922":50022,"_5":14373,"_27447":49899,"_2948":50023},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3464":266,"_30209":212,"_20922":50025,"_5":14373,"_27447":49899,"_2948":50026},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3464":267,"_30209":212,"_20922":50028,"_5":14373,"_27447":49899,"_2948":50029},[],"shared VA storage before increasing VA replicas",{"_3464":268,"_30209":212,"_20922":50031,"_5":14373,"_27447":49899,"_2948":50032},[],"managed OIDC roles and removal of evaluation credentials",{"_3464":269,"_30209":212,"_20922":50034,"_5":14373,"_27447":49899,"_2948":50035},[],"a trusted TLS issuer or externally managed certificate",{"_3464":270,"_30209":212,"_20922":50037,"_5":14373,"_27447":49899,"_2948":50038},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3464":271,"_30209":212,"_20922":50040,"_5":14373,"_27447":49899,"_2948":50041},[],"SMTP, observability and alert delivery",{"_3464":272,"_30209":212,"_20922":50043,"_5":14373,"_27447":49899,"_2948":50044},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3464":273,"_30209":212,"_20922":50046,"_5":14373,"_27447":49899,"_2948":50047},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3464":274,"_30209":274,"_5":14725,"_2948":50049,"_30541":50050,"_20922":50051,"_27447":274},"Expose the Gateway",[49244,49245,49351],[],{"_3464":275,"_30209":274,"_20922":50053,"_5":14373,"_27447":274,"_2948":50054},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3464":276,"_30209":274,"_5":30538,"_20922":50056,"_27447":50057,"_2948":50058},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3464":277,"_30209":274,"_5":30538,"_20922":50060,"_27447":50061,"_2948":50062},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3464":278,"_30209":274,"_5":30538,"_20922":50064,"_27447":50065,"_2948":50066},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3464":279,"_30209":274,"_5":30538,"_20922":50068,"_27447":50069,"_2948":50070},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3464":280,"_30209":274,"_5":30538,"_20922":50072,"_27447":50073,"_2948":50074},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3464":281,"_30209":274,"_5":30538,"_20922":50076,"_27447":50077,"_2948":50078},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3464":282,"_30209":274,"_5":30538,"_20922":50080,"_27447":50081,"_2948":50082},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3464":283,"_30209":274,"_5":30538,"_20922":50084,"_27447":50085,"_2948":50086},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3464":284,"_30209":274,"_5":30538,"_20922":50088,"_27447":50089,"_2948":50090},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3464":285,"_30209":274,"_5":30538,"_20922":50092,"_27447":50093,"_2948":50094},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3464":286,"_30209":274,"_5":30538,"_20922":50096,"_27447":50097,"_2948":50098},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3464":287,"_30209":274,"_20922":50100,"_5":14373,"_27447":50057,"_2948":50101},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3464":288,"_30209":274,"_20922":50103,"_5":14373,"_27447":50057,"_2948":50104},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3464":289,"_30209":274,"_20922":50106,"_5":14373,"_27447":50061,"_2948":50107},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3464":290,"_30209":274,"_20922":50109,"_5":14373,"_27447":50061,"_2948":50110},[],"Set it only when:",{"_3464":291,"_30209":274,"_20922":50112,"_5":14373,"_27447":50061,"_2948":50113},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3464":292,"_30209":274,"_20922":50115,"_5":14373,"_27447":50061,"_2948":50116},[],"that address is allocated to this Gateway",{"_3464":293,"_30209":274,"_20922":50118,"_5":14373,"_27447":50061,"_2948":50119},[],"the surrounding network already routes traffic for it to the cluster",{"_3464":294,"_30209":274,"_20922":50121,"_5":14373,"_27447":50061,"_2948":50122},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3464":295,"_30209":274,"_20922":50124,"_5":14373,"_27447":50061,"_2948":50125},[],"Keep these two settings separate:",{"_3464":296,"_30209":274,"_20922":50127,"_5":14373,"_27447":50061,"_2948":50128},[],"`gateway.addresses` requests an address for the Gateway.",{"_3464":297,"_30209":274,"_20922":50130,"_5":14373,"_27447":50061,"_2948":50131},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3464":298,"_30209":274,"_20922":50133,"_5":14373,"_27447":50061,"_2948":50134},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3464":299,"_30209":274,"_20922":50136,"_5":14373,"_27447":50065,"_2948":50137},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3464":300,"_30209":274,"_20922":50139,"_5":14373,"_27447":50065,"_2948":50140},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3464":301,"_30209":274,"_20922":50142,"_5":14373,"_27447":50069,"_2948":50143},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3464":302,"_30209":274,"_20922":50145,"_5":14373,"_27447":50069,"_2948":50146},[],"For the recommended design:",{"_3464":303,"_30209":274,"_20922":50148,"_5":14373,"_27447":50069,"_2948":50149},[],"Use only one externally exposed Lamassu Gateway.",{"_3464":304,"_30209":274,"_20922":50151,"_5":14373,"_27447":50069,"_2948":50152},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3464":305,"_30209":274,"_20922":50154,"_5":14373,"_27447":50069,"_2948":50155},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3464":306,"_30209":274,"_20922":50157,"_5":14373,"_27447":50069,"_2948":50158},[],"Point DNS at the VM's reachable address.",{"_3464":307,"_30209":274,"_20922":50160,"_5":14373,"_27447":50069,"_2948":50161},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3464":308,"_30209":274,"_20922":50163,"_5":14373,"_27447":50073,"_2948":50164},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3464":309,"_30209":274,"_20922":50166,"_5":14373,"_27447":50077,"_2948":50167},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3464":310,"_30209":274,"_20922":50169,"_5":14373,"_27447":50077,"_2948":50170},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3464":311,"_30209":274,"_20922":50172,"_5":14373,"_27447":50081,"_2948":50173},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3464":312,"_30209":274,"_20922":50175,"_5":14373,"_27447":50081,"_2948":50176},[],"Requirement",{"_3464":313,"_30209":274,"_20922":50178,"_5":14373,"_27447":50081,"_2948":50179},[],"Recommended design",{"_3464":314,"_30209":274,"_20922":50181,"_5":14373,"_27447":50081,"_2948":50182},[],"Consequence",{"_3464":315,"_30209":274,"_20922":50184,"_5":14373,"_27447":50081,"_2948":50185},[],"Several Lamassu URLs or services",{"_3464":316,"_30209":274,"_20922":50187,"_5":14373,"_27447":50081,"_2948":50188},[],"One Gateway with multiple routes",{"_3464":317,"_30209":274,"_20922":50190,"_5":14373,"_27447":50081,"_2948":50191},[],"One IP and one proxy fleet; this is the chart default",{"_3464":318,"_30209":274,"_20922":50193,"_5":14373,"_27447":50081,"_2948":50194},[],"Independent Gateways and separate external IPs",{"_3464":319,"_30209":274,"_20922":50196,"_5":14373,"_27447":50081,"_2948":50197},[],"One VIP per Gateway",{"_3464":320,"_30209":274,"_20922":50199,"_5":14373,"_27447":50081,"_2948":50200},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3464":321,"_30209":274,"_20922":50202,"_5":14373,"_27447":50081,"_2948":50203},[],"Independent Gateways on one node and one IP",{"_3464":322,"_30209":274,"_20922":50205,"_5":14373,"_27447":50081,"_2948":50206},[],"Use different external ports",{"_3464":323,"_30209":274,"_20922":50208,"_5":14373,"_27447":50081,"_2948":50209},[],"Clients must include non-standard ports",{"_3464":324,"_30209":274,"_20922":50211,"_5":14373,"_27447":50081,"_2948":50212},[],"Separate TLS/mTLS termination behind one IP",{"_3464":325,"_30209":274,"_20922":50214,"_5":14373,"_27447":50081,"_2948":50215},[],"Front-door SNI routing to internal Gateways",{"_3464":326,"_30209":274,"_20922":50217,"_5":14373,"_27447":50081,"_2948":50218},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3464":327,"_30209":274,"_20922":50220,"_5":14373,"_27447":50081,"_2948":50221},[],"Separate Gateway resources but shared proxy infrastructure",{"_3464":328,"_30209":274,"_20922":50223,"_5":14373,"_27447":50081,"_2948":50224},[],"Envoy merged-Gateway mode",{"_3464":329,"_30209":274,"_20922":50226,"_5":14373,"_27447":50081,"_2948":50227},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3464":330,"_30209":274,"_20922":50229,"_5":14373,"_27447":50081,"_2948":50230},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3464":331,"_30209":274,"_20922":50232,"_5":14373,"_27447":50081,"_2948":50233},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3464":332,"_30209":274,"_20922":50235,"_5":14373,"_27447":50081,"_2948":50236},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3464":333,"_30209":274,"_20922":50238,"_5":14373,"_27447":50081,"_2948":50239},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3464":334,"_30209":274,"_20922":50241,"_5":14373,"_27447":50085,"_2948":50242},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3464":335,"_30209":274,"_20922":50244,"_5":14373,"_27447":50089,"_2948":50245},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3464":336,"_30209":274,"_20922":50247,"_5":14373,"_27447":50089,"_2948":50248},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3464":337,"_30209":274,"_20922":50250,"_5":14373,"_27447":50089,"_2948":50251},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3464":338,"_30209":274,"_20922":50253,"_5":14373,"_27447":50089,"_2948":50254},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3464":339,"_30209":274,"_20922":50256,"_5":14373,"_27447":50089,"_2948":50257},[],"If none of those are possible, use different external ports or change the external network design.",{"_3464":340,"_30209":274,"_20922":50259,"_5":14373,"_27447":50093,"_2948":50260},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3464":341,"_30209":274,"_20922":50262,"_5":14373,"_27447":50093,"_2948":50263},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3464":342,"_30209":274,"_20922":50265,"_5":14373,"_27447":50097,"_2948":50266},[],"Check, in order:",{"_3464":343,"_30209":274,"_20922":50268,"_5":14373,"_27447":50097,"_2948":50269},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3464":344,"_30209":274,"_20922":50271,"_5":14373,"_27447":50097,"_2948":50272},[],"Its status contains the expected address.",{"_3464":345,"_30209":274,"_20922":50274,"_5":14373,"_27447":50097,"_2948":50275},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3464":346,"_30209":274,"_20922":50277,"_5":14373,"_27447":50097,"_2948":50278},[],"Port 443 reaches that address from the client network.",{"_3464":347,"_30209":274,"_20922":50280,"_5":14373,"_27447":50097,"_2948":50281},[],"DNS resolves to the externally reachable endpoint.",{"_3464":348,"_30209":274,"_20922":50283,"_5":14373,"_27447":50097,"_2948":50284},[],"The certificate contains the DNS name or IP used by the client.",{"_3464":349,"_30209":274,"_20922":50286,"_5":14373,"_27447":50097,"_2948":50287},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3464":350,"_30209":350,"_5":14725,"_2948":49351,"_30541":50289,"_20922":50290,"_27447":350},[49244,49245,49351],[],{"_3464":351,"_30209":350,"_20922":50292,"_5":14373,"_27447":350,"_2948":50293},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3464":352,"_30209":350,"_5":30538,"_20922":50295,"_27447":50296,"_2948":50297},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3464":353,"_30209":350,"_5":30538,"_20922":50299,"_27447":50300,"_2948":50301},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3464":354,"_30209":350,"_5":30538,"_20922":50303,"_27447":50304,"_2948":50305},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3464":355,"_30209":350,"_5":30538,"_20922":50307,"_27447":50308,"_2948":50309},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3464":356,"_30209":350,"_5":30538,"_20922":50311,"_27447":50312,"_2948":50313},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3464":357,"_30209":350,"_5":30538,"_20922":50315,"_27447":50316,"_2948":50317},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3464":358,"_30209":350,"_20922":50319,"_5":14373,"_27447":50296,"_2948":50320},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3464":359,"_30209":350,"_20922":50322,"_5":14373,"_27447":50300,"_2948":50323},[],"Workflow",{"_3464":360,"_30209":350,"_20922":50325,"_5":14373,"_27447":50300,"_2948":50326},[],"Use it for",{"_3464":361,"_30209":350,"_20922":50328,"_5":14373,"_27447":50300,"_2948":50329},[],"What it installs",{"_3464":362,"_30209":350,"_20922":50331,"_5":14373,"_27447":50300,"_2948":50332},[],"Helm",{"_3464":363,"_30209":350,"_20922":50334,"_5":14373,"_27447":50300,"_2948":50335},[],"Production and controlled environments",{"_3464":364,"_30209":350,"_20922":50337,"_5":14373,"_27447":50300,"_2948":50338},[],"Lamassu services and Gateway API resources",{"_3464":365,"_30209":350,"_20922":50340,"_5":14373,"_27447":50300,"_2948":49488},[],{"_3464":366,"_30209":350,"_20922":50342,"_5":14373,"_27447":50300,"_2948":50343},[],"Evaluation, demos, CI and small lab clusters",{"_3464":367,"_30209":350,"_20922":50345,"_5":14373,"_27447":50300,"_2948":50346},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3464":368,"_30209":350,"_20922":50348,"_5":14373,"_27447":50304,"_2948":50349},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3464":369,"_30209":350,"_20922":50351,"_5":14373,"_27447":50304,"_2948":50352},[],"Area",{"_3464":370,"_30209":350,"_20922":50354,"_5":14373,"_27447":50304,"_2948":50355},[],"The Lamassu chart provides",{"_3464":371,"_30209":350,"_20922":50357,"_5":14373,"_27447":50304,"_2948":50358},[],"You provide",{"_3464":372,"_30209":350,"_20922":50360,"_5":14373,"_27447":50304,"_2948":50361},[],"Lamassu applications",{"_3464":373,"_30209":350,"_20922":50363,"_5":14373,"_27447":50304,"_2948":50364},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3464":374,"_30209":350,"_20922":50366,"_5":14373,"_27447":50304,"_2948":50367},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3464":375,"_30209":350,"_20922":50369,"_5":14373,"_27447":50304,"_2948":50370},[],"PostgreSQL data",{"_3464":376,"_30209":350,"_20922":50372,"_5":14373,"_27447":50304,"_2948":50373},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3464":377,"_30209":350,"_20922":50375,"_5":14373,"_27447":50304,"_2948":50376},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3464":378,"_30209":350,"_20922":50378,"_5":14373,"_27447":50304,"_2948":50379},[],"Messaging",{"_3464":379,"_30209":350,"_20922":50381,"_5":14373,"_27447":50304,"_2948":50382},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3464":380,"_30209":350,"_20922":50384,"_5":14373,"_27447":50304,"_2948":50385},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3464":381,"_30209":350,"_20922":50387,"_5":14373,"_27447":50304,"_2948":50388},[],"Identity",{"_3464":382,"_30209":350,"_20922":50390,"_5":14373,"_27447":50304,"_2948":50391},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3464":383,"_30209":350,"_20922":50393,"_5":14373,"_27447":50304,"_2948":50394},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3464":384,"_30209":350,"_20922":50396,"_5":14373,"_27447":50304,"_2948":50397},[],"External routing",{"_3464":385,"_30209":350,"_20922":50399,"_5":14373,"_27447":50304,"_2948":50400},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3464":386,"_30209":350,"_20922":50402,"_5":14373,"_27447":50304,"_2948":50403},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3464":387,"_30209":350,"_20922":50405,"_5":14373,"_27447":50304,"_2948":50406},[],"TLS",{"_3464":388,"_30209":350,"_20922":50408,"_5":14373,"_27447":50304,"_2948":50409},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3464":389,"_30209":350,"_20922":50411,"_5":14373,"_27447":50304,"_2948":50412},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3464":390,"_30209":350,"_20922":50414,"_5":14373,"_27447":50304,"_2948":50415},[],"Persistent application data",{"_3464":391,"_30209":350,"_20922":50417,"_5":14373,"_27447":50304,"_2948":50418},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3464":392,"_30209":350,"_20922":50420,"_5":14373,"_27447":50304,"_2948":50421},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3464":393,"_30209":350,"_20922":50423,"_5":14373,"_27447":50304,"_2948":50424},[],"Optional integrations",{"_3464":394,"_30209":350,"_20922":50426,"_5":14373,"_27447":50304,"_2948":50427},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3464":395,"_30209":350,"_20922":50429,"_5":14373,"_27447":50304,"_2948":50430},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3464":396,"_30209":350,"_20922":50432,"_5":14373,"_27447":50304,"_2948":50433},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3464":397,"_30209":350,"_20922":50435,"_5":14373,"_27447":50304,"_2948":50436},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3464":398,"_30209":350,"_20922":50438,"_5":14373,"_27447":50308,"_2948":50439},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3464":399,"_30209":350,"_20922":50441,"_5":14373,"_27447":50308,"_2948":50442},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3464":400,"_30209":350,"_20922":50444,"_5":14373,"_27447":50312,"_2948":50445},[],"Kubernetes 1.24 or newer",{"_3464":401,"_30209":350,"_20922":50447,"_5":14373,"_27447":50312,"_2948":50448},[],"Helm 3.2 or newer",{"_3464":402,"_30209":350,"_20922":50450,"_5":14373,"_27447":50312,"_2948":50451},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3464":403,"_30209":350,"_20922":50453,"_5":14373,"_27447":50312,"_2948":50454},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3464":404,"_30209":350,"_20922":50456,"_5":14373,"_27447":50312,"_2948":50457},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3464":405,"_30209":350,"_20922":50459,"_5":14373,"_27447":50312,"_2948":50460},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3464":406,"_30209":350,"_20922":50462,"_5":14373,"_27447":50312,"_2948":50463},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3464":407,"_30209":350,"_20922":50465,"_5":14373,"_27447":50316,"_2948":50466},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":408,"_30209":350,"_20922":50468,"_5":14373,"_27447":50316,"_2948":50469},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3464":409,"_30209":350,"_20922":50471,"_5":14373,"_27447":50316,"_2948":50472},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3464":410,"_30209":350,"_20922":50474,"_5":14373,"_27447":50316,"_2948":50475},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3464":411,"_30209":411,"_5":14725,"_2948":50477,"_30541":50478,"_20922":50480,"_27447":411},"Deployment troubleshooting",[49244,49245,50479],"Operations",[],{"_3464":412,"_30209":411,"_20922":50482,"_5":14373,"_27447":411,"_2948":50483},[],"Diagnose access, service health and infrastructure dependencies.",{"_3464":413,"_30209":411,"_5":30538,"_20922":50485,"_27447":50486,"_2948":50487},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3464":414,"_30209":411,"_5":30538,"_20922":50489,"_27447":50490,"_2948":50491},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3464":415,"_30209":411,"_5":30538,"_20922":50493,"_27447":50494,"_2948":50495},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3464":416,"_30209":411,"_5":30538,"_20922":50497,"_27447":50498,"_2948":50499},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3464":417,"_30209":411,"_5":30538,"_20922":50501,"_27447":50502,"_2948":50503},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3464":418,"_30209":411,"_5":30538,"_20922":50505,"_27447":50506,"_2948":50507},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3464":419,"_30209":411,"_5":30538,"_20922":50509,"_27447":50510,"_2948":50511},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3464":420,"_30209":411,"_5":30538,"_20922":50513,"_27447":50514,"_2948":50515},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3464":421,"_30209":411,"_5":30538,"_20922":50517,"_27447":50518,"_2948":50519},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3464":422,"_30209":411,"_5":30538,"_20922":50521,"_27447":50522,"_2948":50523},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3464":423,"_30209":411,"_5":30538,"_20922":50525,"_27447":50526,"_2948":50527},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3464":424,"_30209":411,"_5":30538,"_20922":50529,"_27447":50530,"_2948":50531},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3464":425,"_30209":411,"_5":30538,"_20922":50533,"_27447":50534,"_2948":50535},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3464":426,"_30209":411,"_20922":50537,"_5":14373,"_27447":411,"_2948":50538},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3464":427,"_30209":411,"_20922":50540,"_5":14373,"_27447":50490,"_2948":50541},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3464":428,"_30209":411,"_20922":50543,"_5":14373,"_27447":50494,"_2948":50544},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3464":429,"_30209":411,"_20922":50546,"_5":14373,"_27447":50498,"_2948":50547},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3464":430,"_30209":411,"_20922":50549,"_5":14373,"_27447":50502,"_2948":50550},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3464":431,"_30209":411,"_20922":50552,"_5":14373,"_27447":50506,"_2948":50553},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3464":432,"_30209":411,"_20922":50555,"_5":14373,"_27447":50510,"_2948":50556},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3464":433,"_30209":411,"_20922":50558,"_5":14373,"_27447":50510,"_2948":50559},[],"Also run the chart's connectivity test:",{"_3464":434,"_30209":411,"_20922":50561,"_5":14373,"_27447":50510,"_2948":50562},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3464":435,"_30209":411,"_20922":50564,"_5":14373,"_27447":50510,"_2948":50565},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3464":436,"_30209":411,"_20922":50567,"_5":14373,"_27447":50514,"_2948":50568},[],"If you receive a 401:",{"_3464":437,"_30209":411,"_20922":50570,"_5":14373,"_27447":50514,"_2948":50571},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3464":438,"_30209":411,"_20922":50573,"_5":14373,"_27447":50514,"_2948":50574},[],"verify issuer, audience and expiration of the token;",{"_3464":439,"_30209":411,"_20922":50576,"_5":14373,"_27447":50514,"_2948":50577},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3464":440,"_30209":411,"_20922":50579,"_5":14373,"_27447":50514,"_2948":50580},[],"check that the provider's public and internal routes point to the same realm.",{"_3464":441,"_30209":411,"_20922":50582,"_5":14373,"_27447":50514,"_2948":50583},[],"If login succeeds but the APIs return 403:",{"_3464":442,"_30209":411,"_20922":50585,"_5":14373,"_27447":50514,"_2948":50586},[],"inspect the token's real claims;",{"_3464":443,"_30209":411,"_20922":50588,"_5":14373,"_27447":50514,"_2948":50589},[],"confirm they match an active principal;",{"_3464":444,"_30209":411,"_20922":50591,"_5":14373,"_27447":50514,"_2948":50592},[],"review the policies granted to that principal;",{"_3464":445,"_30209":411,"_20922":50594,"_5":14373,"_27447":50514,"_2948":50595},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3464":446,"_30209":411,"_20922":50597,"_5":14373,"_27447":50514,"_2948":50598},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3464":447,"_30209":411,"_20922":50600,"_5":14373,"_27447":50518,"_2948":50601},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3464":448,"_30209":411,"_20922":50603,"_5":14373,"_27447":50518,"_2948":50604},[],"Locate the authz pod and Service.",{"_3464":449,"_30209":411,"_20922":50606,"_5":14373,"_27447":50518,"_2948":50607},[],"Check /health, logs and its database connection.",{"_3464":450,"_30209":411,"_20922":50609,"_5":14373,"_27447":50518,"_2948":50610},[],"Verify the DNS and port configured in externalAuthorization.",{"_3464":451,"_30209":411,"_20922":50612,"_5":14373,"_27447":50518,"_2948":50613},[],"Check the check route is /v1/ext\\_authz/check.",{"_3464":452,"_30209":411,"_20922":50615,"_5":14373,"_27447":50518,"_2948":50616},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3464":453,"_30209":411,"_20922":50618,"_5":14373,"_27447":50522,"_2948":50619},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3464":454,"_30209":411,"_20922":50621,"_5":14373,"_27447":50526,"_2948":50622},[],"Review kubectl describe pod first. Common causes are:",{"_3464":455,"_30209":411,"_20922":50624,"_5":14373,"_27447":50526,"_2948":50625},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3464":456,"_30209":411,"_20922":50627,"_5":14373,"_27447":50526,"_2948":50628},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3464":457,"_30209":411,"_20922":50630,"_5":14373,"_27447":50526,"_2948":50631},[],"unbound persistent volume;",{"_3464":458,"_30209":411,"_20922":50633,"_5":14373,"_27447":50526,"_2948":50634},[],"inaccessible image or incorrect pull policy;",{"_3464":459,"_30209":411,"_20922":50636,"_5":14373,"_27447":50526,"_2948":50637},[],"invalid cryptographic engine configuration;",{"_3464":460,"_30209":411,"_20922":50639,"_5":14373,"_27447":50526,"_2948":50640},[],"CPU or memory limits set too low;",{"_3464":461,"_30209":411,"_20922":50642,"_5":14373,"_27447":50526,"_2948":50643},[],"an incomplete prior migration.",{"_3464":462,"_30209":411,"_20922":50645,"_5":14373,"_27447":50526,"_2948":50646},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3464":463,"_30209":411,"_20922":50648,"_5":14373,"_27447":50526,"_2948":50649},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3464":464,"_30209":411,"_20922":50651,"_5":14373,"_27447":50526,"_2948":50652},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3464":465,"_30209":411,"_20922":50654,"_5":14373,"_27447":50530,"_2948":50655},[],"Domain and audit events depend on the bus publisher:",{"_3464":466,"_30209":411,"_20922":50657,"_5":14373,"_27447":50530,"_2948":50658},[],"verify it is enabled in the emitting service;",{"_3464":467,"_30209":411,"_20922":50660,"_5":14373,"_27447":50530,"_2948":50661},[],"check AMQP connectivity and credentials;",{"_3464":468,"_30209":411,"_20922":50663,"_5":14373,"_27447":50530,"_2948":50664},[],"review exchange, routing key, queues and consumers;",{"_3464":469,"_30209":411,"_20922":50666,"_5":14373,"_27447":50530,"_2948":50667},[],"inspect dead-letter queues;",{"_3464":470,"_30209":411,"_20922":50669,"_5":14373,"_27447":50530,"_2948":50670},[],"alert on orphan durable queues and backlog growth.",{"_3464":471,"_30209":411,"_20922":50672,"_5":14373,"_27447":50530,"_2948":50673},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3464":472,"_30209":411,"_20922":50675,"_5":14373,"_27447":50530,"_2948":50676},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3464":473,"_30209":411,"_20922":50678,"_5":14373,"_27447":50530,"_2948":50679},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3464":474,"_30209":411,"_20922":50681,"_5":14373,"_27447":50530,"_2948":50682},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3464":475,"_30209":411,"_20922":50684,"_5":14373,"_27447":50530,"_2948":50685},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3464":476,"_30209":411,"_20922":50687,"_5":14373,"_27447":50530,"_2948":50688},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3464":477,"_30209":411,"_20922":50690,"_5":14373,"_27447":50530,"_2948":50691},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3464":478,"_30209":411,"_20922":50693,"_5":14373,"_27447":50534,"_2948":50694},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3464":479,"_30209":411,"_20922":50696,"_5":14373,"_27447":50534,"_2948":50697},[],"Before closing an incident, record:",{"_3464":480,"_30209":411,"_20922":50699,"_5":14373,"_27447":50534,"_2948":50700},[],"the confirmed cause;",{"_3464":481,"_30209":411,"_20922":50702,"_5":14373,"_27447":50534,"_2948":50703},[],"the time scope and affected resources;",{"_3464":482,"_30209":411,"_20922":50705,"_5":14373,"_27447":50534,"_2948":50706},[],"the commands or queries used;",{"_3464":483,"_30209":411,"_20922":50708,"_5":14373,"_27447":50534,"_2948":50709},[],"the applied change and how to revert it;",{"_3464":484,"_30209":411,"_20922":50711,"_5":14373,"_27447":50534,"_2948":50712},[],"validation from a consumer;",{"_3464":485,"_30209":411,"_20922":50714,"_5":14373,"_27447":50534,"_2948":50715},[],"the preventive action and its owner.",{"_3464":486,"_30209":486,"_5":14725,"_2948":50717,"_30541":50718,"_20922":50721,"_27447":486},"Access control",[49244,50719,50720],"Platform","Administration",[],{"_3464":487,"_30209":486,"_20922":50723,"_5":14373,"_27447":486,"_2948":50724},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3464":488,"_30209":486,"_5":30538,"_20922":50726,"_27447":50727,"_2948":50728},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3464":489,"_30209":486,"_5":30538,"_20922":50730,"_27447":50731,"_2948":50732},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3464":490,"_30209":486,"_5":30538,"_20922":50734,"_27447":50735,"_2948":50736},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3464":491,"_30209":486,"_5":30538,"_20922":50738,"_27447":50739,"_2948":50740},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3464":492,"_30209":486,"_5":30538,"_20922":50742,"_27447":50743,"_2948":50744},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3464":493,"_30209":486,"_5":30538,"_20922":50746,"_27447":50747,"_2948":50748},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3464":494,"_30209":486,"_5":30538,"_20922":50750,"_27447":50751,"_2948":50752},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3464":495,"_30209":486,"_5":30538,"_20922":50754,"_27447":50755,"_2948":50756},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3464":496,"_30209":486,"_5":30538,"_20922":50758,"_27447":50759,"_2948":50760},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3464":497,"_30209":486,"_5":30538,"_20922":50762,"_27447":50763,"_2948":50764},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3464":498,"_30209":486,"_5":30538,"_20922":50766,"_27447":50767,"_2948":50768},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3464":499,"_30209":486,"_5":30538,"_20922":50770,"_27447":50771,"_2948":50772},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3464":500,"_30209":486,"_5":30538,"_20922":50774,"_27447":50775,"_2948":50776},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3464":501,"_30209":486,"_5":30538,"_20922":50778,"_27447":50779,"_2948":50780},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3464":502,"_30209":486,"_5":30538,"_20922":50782,"_27447":50783,"_2948":50784},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3464":503,"_30209":486,"_5":30538,"_20922":50786,"_27447":50787,"_2948":49884},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3464":504,"_30209":486,"_5":30538,"_20922":50789,"_27447":50790,"_2948":50791},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3464":505,"_30209":486,"_5":30538,"_20922":50793,"_27447":50794,"_2948":50795},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3464":506,"_30209":486,"_5":30538,"_20922":50797,"_27447":50798,"_2948":50799},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3464":507,"_30209":486,"_5":30538,"_20922":50801,"_27447":50802,"_2948":50803},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3464":508,"_30209":486,"_5":30538,"_20922":50805,"_27447":50806,"_2948":50807},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3464":509,"_30209":486,"_5":30538,"_20922":50809,"_27447":50810,"_2948":50811},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3464":510,"_30209":486,"_5":30538,"_20922":50813,"_27447":50814,"_2948":50815},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3464":511,"_30209":486,"_5":30538,"_20922":50817,"_27447":50818,"_2948":50819},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3464":512,"_30209":486,"_5":30538,"_20922":50821,"_27447":50822,"_2948":50823},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3464":513,"_30209":486,"_5":30538,"_20922":50825,"_27447":50826,"_2948":50827},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3464":514,"_30209":486,"_5":30538,"_20922":50829,"_27447":50830,"_2948":50831},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3464":515,"_30209":486,"_5":30538,"_20922":50833,"_27447":50834,"_2948":50835},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3464":516,"_30209":486,"_5":30538,"_20922":50837,"_27447":50838,"_2948":50839},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3464":517,"_30209":486,"_5":30538,"_20922":50841,"_27447":50842,"_2948":50843},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3464":518,"_30209":486,"_5":30538,"_20922":50845,"_27447":50846,"_2948":50847},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3464":519,"_30209":486,"_20922":50849,"_5":14373,"_27447":486,"_2948":50850},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3464":520,"_30209":486,"_20922":50852,"_5":14373,"_27447":486,"_2948":50853},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3464":521,"_30209":486,"_20922":50855,"_5":14373,"_27447":486,"_2948":50856},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3464":522,"_30209":486,"_20922":50858,"_5":14373,"_27447":50727,"_2948":50859},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3464":523,"_30209":486,"_20922":50861,"_5":14373,"_27447":50727,"_2948":50862},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3464":524,"_30209":486,"_20922":50864,"_5":14373,"_27447":50727,"_2948":50865},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3464":525,"_30209":486,"_20922":50867,"_5":14373,"_27447":50727,"_2948":50868},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3464":526,"_30209":486,"_20922":50870,"_5":14373,"_27447":50727,"_2948":50871},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3464":527,"_30209":486,"_20922":50873,"_5":14373,"_27447":50727,"_2948":50874},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3464":528,"_30209":486,"_20922":50876,"_5":14373,"_27447":50731,"_2948":50877},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3464":529,"_30209":486,"_20922":50879,"_5":14373,"_27447":50731,"_2948":50880},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3464":530,"_30209":486,"_20922":50882,"_5":14373,"_27447":50735,"_2948":50883},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3464":531,"_30209":486,"_20922":50885,"_5":14373,"_27447":50735,"_2948":50886},[],"The decision is made **before forwarding the request to the service**:",{"_3464":532,"_30209":486,"_20922":50888,"_5":14373,"_27447":50735,"_2948":50889},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3464":533,"_30209":486,"_20922":50891,"_5":14373,"_27447":50735,"_2948":50892},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3464":534,"_30209":486,"_20922":50894,"_5":14373,"_27447":50735,"_2948":50895},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3464":535,"_30209":486,"_20922":50897,"_5":14373,"_27447":50735,"_2948":50898},[],"It separately loads the policies granted to each principal.",{"_3464":536,"_30209":486,"_20922":50900,"_5":14373,"_27447":50735,"_2948":50901},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3464":537,"_30209":486,"_20922":50903,"_5":14373,"_27447":50735,"_2948":50904},[],"`authz` looks for an HTTP rule granting that action.",{"_3464":538,"_30209":486,"_20922":50906,"_5":14373,"_27447":50735,"_2948":50907},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3464":539,"_30209":486,"_20922":50909,"_5":14373,"_27447":50735,"_2948":50910},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3464":540,"_30209":486,"_20922":50912,"_5":14373,"_27447":50735,"_2948":50913},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3464":541,"_30209":486,"_20922":50915,"_5":14373,"_27447":50735,"_2948":50916},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3464":542,"_30209":486,"_20922":50918,"_5":14373,"_27447":50739,"_2948":50919},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3464":543,"_30209":486,"_20922":50921,"_5":14373,"_27447":50739,"_2948":50922},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3464":544,"_30209":486,"_20922":50924,"_5":14373,"_27447":50739,"_2948":50925},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3464":545,"_30209":486,"_20922":50927,"_5":14373,"_27447":50739,"_2948":50928},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3464":546,"_30209":486,"_20922":50930,"_5":14373,"_27447":50739,"_2948":50931},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3464":547,"_30209":486,"_20922":50933,"_5":14373,"_27447":50739,"_2948":50934},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3464":548,"_30209":486,"_20922":50936,"_5":14373,"_27447":50739,"_2948":50937},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3464":549,"_30209":486,"_20922":50939,"_5":14373,"_27447":50739,"_2948":50940},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3464":550,"_30209":486,"_20922":50942,"_5":14373,"_27447":50743,"_2948":50943},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3464":551,"_30209":486,"_20922":50945,"_5":14373,"_27447":50743,"_2948":50946},[],"The decision is made with the domain operation context:",{"_3464":552,"_30209":486,"_20922":50948,"_5":14373,"_27447":50743,"_2948":50949},[],"The middleware extracts the credential and resolves the matching principals.",{"_3464":553,"_30209":486,"_20922":50951,"_5":14373,"_27447":50743,"_2948":50952},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3464":554,"_30209":486,"_20922":50954,"_5":14373,"_27447":50743,"_2948":50955},[],"`authz` gathers the entity rules of the granted policies.",{"_3464":555,"_30209":486,"_20922":50957,"_5":14373,"_27447":50743,"_2948":50958},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3464":556,"_30209":486,"_20922":50960,"_5":14373,"_27447":50743,"_2948":50961},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3464":557,"_30209":486,"_20922":50963,"_5":14373,"_27447":50743,"_2948":50964},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3464":558,"_30209":486,"_20922":50966,"_5":14373,"_27447":50743,"_2948":50967},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3464":559,"_30209":486,"_20922":50969,"_5":14373,"_27447":50743,"_2948":50970},[],"Actions fall into two groups:",{"_3464":560,"_30209":486,"_20922":50972,"_5":14373,"_27447":50743,"_2948":50973},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3464":561,"_30209":486,"_20922":50975,"_5":14373,"_27447":50743,"_2948":50976},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3464":562,"_30209":486,"_20922":50978,"_5":14373,"_27447":50743,"_2948":50979},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3464":563,"_30209":486,"_20922":50981,"_5":14373,"_27447":50747,"_2948":50982},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3464":564,"_30209":486,"_20922":50984,"_5":14373,"_27447":50747,"_2948":50985},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3464":565,"_30209":486,"_20922":50987,"_5":14373,"_27447":50747,"_2948":50988},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3464":566,"_30209":486,"_20922":50990,"_5":14373,"_27447":50751,"_2948":50991},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3464":567,"_30209":486,"_20922":50993,"_5":14373,"_27447":50751,"_2948":50994},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3464":568,"_30209":486,"_20922":50996,"_5":14373,"_27447":50751,"_2948":50997},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3464":569,"_30209":486,"_20922":50999,"_5":14373,"_27447":50751,"_2948":51000},[],"The implemented operators are:",{"_3464":570,"_30209":486,"_20922":51002,"_5":14373,"_27447":50751,"_2948":51003},[],"`equals`, for exact equality;",{"_3464":571,"_30209":486,"_20922":51005,"_5":14373,"_27447":50751,"_2948":51006},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3464":572,"_30209":486,"_20922":51008,"_5":14373,"_27447":50751,"_2948":51009},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3464":573,"_30209":486,"_20922":51011,"_5":14373,"_27447":50751,"_2948":51012},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3464":574,"_30209":486,"_20922":51014,"_5":14373,"_27447":50755,"_2948":51015},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3464":575,"_30209":486,"_20922":51017,"_5":14373,"_27447":50755,"_2948":51018},[],"The available modes are:",{"_3464":576,"_30209":486,"_20922":51020,"_5":14373,"_27447":50755,"_2948":51021},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3464":577,"_30209":486,"_20922":51023,"_5":14373,"_27447":50755,"_2948":51024},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3464":578,"_30209":486,"_20922":51026,"_5":14373,"_27447":50755,"_2948":51027},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3464":579,"_30209":486,"_20922":51029,"_5":14373,"_27447":50755,"_2948":51030},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3464":580,"_30209":486,"_20922":51032,"_5":14373,"_27447":50755,"_2948":51033},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3464":581,"_30209":486,"_20922":51035,"_5":14373,"_27447":50755,"_2948":51036},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3464":582,"_30209":486,"_20922":51038,"_5":14373,"_27447":50759,"_2948":51039},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3464":583,"_30209":486,"_20922":51041,"_5":14373,"_27447":50759,"_2948":51042},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3464":584,"_30209":486,"_20922":51044,"_5":14373,"_27447":50759,"_2948":51045},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3464":585,"_30209":486,"_20922":51047,"_5":14373,"_27447":50759,"_2948":51048},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3464":586,"_30209":486,"_20922":51050,"_5":14373,"_27447":50767,"_2948":51051},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3464":587,"_30209":486,"_20922":51053,"_5":14373,"_27447":50767,"_2948":51054},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3464":588,"_30209":486,"_20922":51056,"_5":14373,"_27447":50771,"_2948":51057},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3464":589,"_30209":486,"_20922":51059,"_5":14373,"_27447":50771,"_2948":51060},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3464":590,"_30209":486,"_20922":51062,"_5":14373,"_27447":50775,"_2948":51063},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3464":591,"_30209":486,"_20922":51065,"_5":14373,"_27447":50775,"_2948":51066},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3464":592,"_30209":486,"_20922":51068,"_5":14373,"_27447":50775,"_2948":51069},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3464":593,"_30209":486,"_20922":51071,"_5":14373,"_27447":50779,"_2948":51072},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3464":594,"_30209":486,"_20922":51074,"_5":14373,"_27447":50779,"_2948":51075},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3464":595,"_30209":486,"_20922":51077,"_5":14373,"_27447":50779,"_2948":51078},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3464":596,"_30209":486,"_20922":51080,"_5":14373,"_27447":50779,"_2948":51081},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3464":597,"_30209":486,"_20922":51083,"_5":14373,"_27447":50779,"_2948":51084},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3464":598,"_30209":486,"_20922":51086,"_5":14373,"_27447":50779,"_2948":51087},[],"Note that:",{"_3464":599,"_30209":486,"_20922":51089,"_5":14373,"_27447":50779,"_2948":51090},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3464":600,"_30209":486,"_20922":51092,"_5":14373,"_27447":50779,"_2948":51093},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3464":601,"_30209":486,"_20922":51095,"_5":14373,"_27447":50779,"_2948":51096},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3464":602,"_30209":486,"_20922":51098,"_5":14373,"_27447":50783,"_2948":51099},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3464":603,"_30209":486,"_20922":51101,"_5":14373,"_27447":50783,"_2948":51102},[],"full and read-only access to certificates and authorities;",{"_3464":604,"_30209":486,"_20922":51104,"_5":14373,"_27447":50783,"_2948":51105},[],"full and read-only access to the KMS;",{"_3464":605,"_30209":486,"_20922":51107,"_5":14373,"_27447":50783,"_2948":51108},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3464":606,"_30209":486,"_20922":51110,"_5":14373,"_27447":50783,"_2948":51111},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3464":607,"_30209":486,"_20922":51113,"_5":14373,"_27447":50783,"_2948":51114},[],"console access;",{"_3464":608,"_30209":486,"_20922":51116,"_5":14373,"_27447":50783,"_2948":51117},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3464":609,"_30209":486,"_20922":51119,"_5":14373,"_27447":50783,"_2948":51120},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3464":610,"_30209":486,"_20922":51122,"_5":14373,"_27447":50783,"_2948":51123},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3464":611,"_30209":486,"_20922":51125,"_5":14373,"_27447":50787,"_2948":51126},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3464":612,"_30209":486,"_20922":51128,"_5":14373,"_27447":50787,"_2948":51129},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3464":613,"_30209":486,"_20922":51131,"_5":14373,"_27447":50787,"_2948":51132},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3464":614,"_30209":486,"_20922":51134,"_5":14373,"_27447":50790,"_2948":51135},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3464":615,"_30209":486,"_20922":51137,"_5":14373,"_27447":50794,"_2948":51138},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3464":616,"_30209":486,"_20922":51140,"_5":14373,"_27447":50794,"_2948":51141},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3464":617,"_30209":486,"_20922":51143,"_5":14373,"_27447":50798,"_2948":51144},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3464":618,"_30209":486,"_20922":51146,"_5":14373,"_27447":50802,"_2948":51147},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3464":619,"_30209":486,"_20922":51149,"_5":14373,"_27447":50806,"_2948":51150},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3464":620,"_30209":486,"_20922":51152,"_5":14373,"_27447":50810,"_2948":51153},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3464":621,"_30209":486,"_20922":51155,"_5":14373,"_27447":50810,"_2948":51156},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3464":622,"_30209":486,"_20922":51158,"_5":14373,"_27447":50814,"_2948":51159},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3464":623,"_30209":486,"_20922":51161,"_5":14373,"_27447":50814,"_2948":51162},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3464":624,"_30209":486,"_20922":51164,"_5":14373,"_27447":50814,"_2948":51165},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3464":625,"_30209":486,"_20922":51167,"_5":14373,"_27447":50814,"_2948":51168},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3464":626,"_30209":486,"_20922":51170,"_5":14373,"_27447":50814,"_2948":51171},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3464":627,"_30209":486,"_20922":51173,"_5":14373,"_27447":50814,"_2948":51174},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3464":628,"_30209":486,"_20922":51176,"_5":14373,"_27447":50814,"_2948":51177},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3464":629,"_30209":486,"_20922":51179,"_5":14373,"_27447":50814,"_2948":51180},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3464":630,"_30209":486,"_20922":51182,"_5":14373,"_27447":50818,"_2948":51183},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3464":631,"_30209":486,"_20922":51185,"_5":14373,"_27447":50818,"_2948":51186},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3464":632,"_30209":486,"_20922":51188,"_5":14373,"_27447":50818,"_2948":51189},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3464":633,"_30209":486,"_20922":51191,"_5":14373,"_27447":50822,"_2948":51192},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3464":634,"_30209":486,"_20922":51194,"_5":14373,"_27447":50822,"_2948":51195},[],"Use groups or stable roles for people and independent identities for automations.",{"_3464":635,"_30209":486,"_20922":51197,"_5":14373,"_27447":50822,"_2948":51198},[],"Keep at least two recovery administrators and test their access periodically.",{"_3464":636,"_30209":486,"_20922":51200,"_5":14373,"_27447":50822,"_2948":51201},[],"Review active principals, their matches and their grants after IdP changes.",{"_3464":637,"_30209":486,"_20922":51203,"_5":14373,"_27447":50822,"_2948":51204},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3464":638,"_30209":486,"_20922":51206,"_5":14373,"_27447":50822,"_2948":51207},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3464":639,"_30209":486,"_20922":51209,"_5":14373,"_27447":50822,"_2948":51210},[],"Always test one allowed and one denied operation for each role.",{"_3464":640,"_30209":486,"_20922":51212,"_5":14373,"_27447":50822,"_2948":51213},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3464":641,"_30209":486,"_20922":51215,"_5":14373,"_27447":50830,"_2948":51216},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3464":642,"_30209":486,"_20922":51218,"_5":14373,"_27447":50834,"_2948":51219},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3464":643,"_30209":486,"_20922":51221,"_5":14373,"_27447":50834,"_2948":51222},[],"that an active principal of the correct type exists;",{"_3464":644,"_30209":486,"_20922":51224,"_5":14373,"_27447":50834,"_2948":51225},[],"that the claim paths and values match the real token exactly;",{"_3464":645,"_30209":486,"_20922":51227,"_5":14373,"_27447":50834,"_2948":51228},[],"that all of the principal's conditions hold;",{"_3464":646,"_30209":486,"_20922":51230,"_5":14373,"_27447":50834,"_2948":51231},[],"that the principal has the expected policy granted;",{"_3464":647,"_30209":486,"_20922":51233,"_5":14373,"_27447":50834,"_2948":51234},[],"that the policy includes the action and the requested resource type or route;",{"_3464":648,"_30209":486,"_20922":51236,"_5":14373,"_27447":50834,"_2948":51237},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3464":649,"_30209":486,"_20922":51239,"_5":14373,"_27447":50834,"_2948":51240},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3464":650,"_30209":486,"_20922":51242,"_5":14373,"_27447":50838,"_2948":51243},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3464":651,"_30209":486,"_20922":51245,"_5":14373,"_27447":50842,"_2948":51246},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3464":652,"_30209":486,"_20922":51248,"_5":14373,"_27447":50846,"_2948":51249},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3464":653,"_30209":486,"_20922":51251,"_5":14373,"_27447":50846,"_2948":51252},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3464":654,"_30209":654,"_5":14725,"_2948":51254,"_30541":51255,"_20922":51256,"_27447":654},"Alerts and subscriptions",[49244,50719,50720],[],{"_3464":655,"_30209":654,"_20922":51258,"_5":14373,"_27447":654,"_2948":51259},[],"Send PKI events to people and external systems.",{"_3464":656,"_30209":654,"_5":30538,"_20922":51261,"_27447":51262,"_2948":51263},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3464":657,"_30209":654,"_5":30538,"_20922":51265,"_27447":51266,"_2948":51267},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3464":658,"_30209":654,"_5":30538,"_20922":51269,"_27447":51270,"_2948":51271},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3464":659,"_30209":654,"_5":30538,"_20922":51273,"_27447":51274,"_2948":51275},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3464":660,"_30209":654,"_5":30538,"_20922":51277,"_27447":51278,"_2948":51279},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3464":661,"_30209":654,"_5":30538,"_20922":51281,"_27447":51282,"_2948":51283},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3464":662,"_30209":654,"_5":30538,"_20922":51285,"_27447":51286,"_2948":51287},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3464":663,"_30209":654,"_5":30538,"_20922":51289,"_27447":51290,"_2948":51291},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3464":664,"_30209":654,"_5":30538,"_20922":51293,"_27447":51294,"_2948":51295},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3464":665,"_30209":654,"_5":30538,"_20922":51297,"_27447":51298,"_2948":51299},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3464":666,"_30209":654,"_5":30538,"_20922":51301,"_27447":51302,"_2948":51303},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3464":667,"_30209":654,"_20922":51305,"_5":14373,"_27447":654,"_2948":51306},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3464":668,"_30209":654,"_20922":51308,"_5":14373,"_27447":51262,"_2948":51309},[],"A service publishes a domain event.",{"_3464":669,"_30209":654,"_20922":51311,"_5":14373,"_27447":51262,"_2948":51312},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3464":670,"_30209":654,"_20922":51314,"_5":14373,"_27447":51262,"_2948":51315},[],"Each subscription's filter decides whether it should be notified.",{"_3464":671,"_30209":654,"_20922":51317,"_5":14373,"_27447":51262,"_2948":51318},[],"Lamassu delivers the event to the configured channel.",{"_3464":672,"_30209":654,"_20922":51320,"_5":14373,"_27447":51262,"_2948":51321},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3464":673,"_30209":654,"_20922":51323,"_5":14373,"_27447":51266,"_2948":51324},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3464":674,"_30209":654,"_20922":51326,"_5":14373,"_27447":51266,"_2948":51327},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3464":675,"_30209":654,"_20922":51329,"_5":14373,"_27447":51266,"_2948":51330},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3464":676,"_30209":654,"_20922":51332,"_5":14373,"_27447":51266,"_2948":51333},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3464":677,"_30209":654,"_20922":51335,"_5":14373,"_27447":51266,"_2948":51336},[],"`apikey_options` requires `header` and `key`.",{"_3464":678,"_30209":654,"_20922":51338,"_5":14373,"_27447":51266,"_2948":51339},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3464":679,"_30209":654,"_20922":51341,"_5":14373,"_27447":51266,"_2948":51342},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3464":680,"_30209":654,"_20922":51344,"_5":14373,"_27447":51266,"_2948":51345},[],"The alerts API reference documents the full `http_client` schema.",{"_3464":681,"_30209":654,"_20922":51347,"_5":14373,"_27447":51274,"_2948":51348},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3464":682,"_30209":654,"_20922":51350,"_5":14373,"_27447":51278,"_2948":51351},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3464":683,"_30209":654,"_20922":51353,"_5":14373,"_27447":51282,"_2948":51354},[],"Add a filter if you don't want to receive every instance of the event.",{"_3464":684,"_30209":654,"_20922":51356,"_5":14373,"_27447":51282,"_2948":51357},[],"**None** notifies all instances of the event.",{"_3464":685,"_30209":654,"_20922":51359,"_5":14373,"_27447":51282,"_2948":51360},[],"**JSON Path** evaluates one or more specific fields.",{"_3464":686,"_30209":654,"_20922":51362,"_5":14373,"_27447":51282,"_2948":51363},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3464":687,"_30209":654,"_20922":51365,"_5":14373,"_27447":51282,"_2948":51366},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3464":688,"_30209":654,"_20922":51368,"_5":14373,"_27447":51282,"_2948":51369},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3464":689,"_30209":654,"_20922":51371,"_5":14373,"_27447":51282,"_2948":51372},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3464":690,"_30209":654,"_20922":51374,"_5":14373,"_27447":51286,"_2948":51375},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3464":691,"_30209":654,"_20922":51377,"_5":14373,"_27447":51290,"_2948":51378},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3464":692,"_30209":654,"_20922":51380,"_5":14373,"_27447":51290,"_2948":51381},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3464":693,"_30209":654,"_20922":51383,"_5":14373,"_27447":51290,"_2948":51384},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3464":694,"_30209":654,"_20922":51386,"_5":14373,"_27447":51290,"_2948":51387},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3464":695,"_30209":654,"_20922":51389,"_5":14373,"_27447":51290,"_2948":51390},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3464":696,"_30209":654,"_20922":51392,"_5":14373,"_27447":51290,"_2948":51393},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3464":697,"_30209":654,"_20922":51395,"_5":14373,"_27447":51290,"_2948":51396},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3464":698,"_30209":654,"_20922":51398,"_5":14373,"_27447":51290,"_2948":51399},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3464":699,"_30209":654,"_20922":51401,"_5":14373,"_27447":51294,"_2948":51402},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3464":700,"_30209":654,"_20922":51404,"_5":14373,"_27447":51294,"_2948":51405},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3464":701,"_30209":654,"_20922":51407,"_5":14373,"_27447":51294,"_2948":51408},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3464":702,"_30209":654,"_20922":51410,"_5":14373,"_27447":51294,"_2948":51411},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3464":703,"_30209":654,"_20922":51413,"_5":14373,"_27447":51294,"_2948":51414},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3464":704,"_30209":654,"_20922":51416,"_5":14373,"_27447":51294,"_2948":51417},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3464":705,"_30209":654,"_20922":51419,"_5":14373,"_27447":51294,"_2948":51420},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3464":706,"_30209":654,"_20922":51422,"_5":14373,"_27447":51294,"_2948":51423},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3464":707,"_30209":654,"_20922":51425,"_5":14373,"_27447":51298,"_2948":51426},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3464":708,"_30209":654,"_20922":51428,"_5":14373,"_27447":51298,"_2948":51429},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3464":709,"_30209":654,"_20922":51431,"_5":14373,"_27447":51302,"_2948":51432},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3464":710,"_30209":654,"_20922":51434,"_5":14373,"_27447":51302,"_2948":51435},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3464":711,"_30209":654,"_20922":51437,"_5":14373,"_27447":51302,"_2948":51438},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3464":712,"_30209":654,"_20922":51440,"_5":14373,"_27447":51302,"_2948":51441},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3464":713,"_30209":654,"_20922":51443,"_5":14373,"_27447":51302,"_2948":51444},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3464":714,"_30209":654,"_20922":51446,"_5":14373,"_27447":51302,"_2948":51447},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3464":715,"_30209":654,"_20922":51449,"_5":14373,"_27447":51302,"_2948":51450},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3464":716,"_30209":654,"_20922":51452,"_5":14373,"_27447":51302,"_2948":51453},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3464":717,"_30209":654,"_20922":51455,"_5":14373,"_27447":51302,"_2948":51456},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3464":718,"_30209":718,"_5":14725,"_2948":51458,"_30541":51459,"_20922":51460,"_27447":718},"Audit logs",[49244,50719,50720],[],{"_3464":719,"_30209":718,"_20922":51462,"_5":14373,"_27447":718,"_2948":51463},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3464":720,"_30209":718,"_5":30538,"_20922":51465,"_27447":51466,"_2948":51467},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3464":721,"_30209":718,"_5":30538,"_20922":51469,"_27447":51470,"_2948":51471},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3464":722,"_30209":718,"_5":30538,"_20922":51473,"_27447":51474,"_2948":51475},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3464":723,"_30209":718,"_5":30538,"_20922":51477,"_27447":51478,"_2948":51479},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3464":724,"_30209":718,"_5":30538,"_20922":51481,"_27447":51482,"_2948":51483},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3464":725,"_30209":718,"_5":30538,"_20922":51485,"_27447":51486,"_2948":51487},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3464":726,"_30209":718,"_5":30538,"_20922":51489,"_27447":51490,"_2948":51491},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3464":727,"_30209":718,"_5":30538,"_20922":51493,"_27447":51494,"_2948":51495},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3464":728,"_30209":718,"_5":30538,"_20922":51497,"_27447":51498,"_2948":51499},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3464":729,"_30209":718,"_5":30538,"_20922":51501,"_27447":51502,"_2948":51503},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3464":730,"_30209":718,"_5":30538,"_20922":51505,"_27447":51506,"_2948":51507},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3464":731,"_30209":718,"_20922":51509,"_5":14373,"_27447":718,"_2948":51510},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3464":732,"_30209":718,"_20922":51512,"_5":14373,"_27447":51466,"_2948":51513},[],"The audit body includes:",{"_3464":733,"_30209":718,"_20922":51515,"_5":14373,"_27447":51466,"_2948":51516},[],"input: data received by the operation;",{"_3464":734,"_30209":718,"_20922":51518,"_5":14373,"_27447":51466,"_2948":51519},[],"has\\_error: whether the service returned an error;",{"_3464":735,"_30209":718,"_20922":51521,"_5":14373,"_27447":51466,"_2948":51522},[],"output: produced result or error message;",{"_3464":736,"_30209":718,"_20922":51524,"_5":14373,"_27447":51466,"_2948":51525},[],"principals: identifiers of the principals that matched the request.",{"_3464":737,"_30209":718,"_20922":51527,"_5":14373,"_27447":51466,"_2948":51528},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3464":738,"_30209":718,"_20922":51530,"_5":14373,"_27447":51466,"_2948":51531},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3464":739,"_30209":718,"_20922":51533,"_5":14373,"_27447":51470,"_2948":51534},[],"The backend applies auditing to mutations of:",{"_3464":740,"_30209":718,"_20922":51536,"_5":14373,"_27447":51470,"_2948":51537},[],"authorities, certificates and issuance profiles;",{"_3464":741,"_30209":718,"_20922":51539,"_5":14373,"_27447":51470,"_2948":51540},[],"keys and KMS engines;",{"_3464":742,"_30209":718,"_20922":51542,"_5":14373,"_27447":51470,"_2948":51543},[],"devices and identities;",{"_3464":743,"_30209":718,"_20922":51545,"_5":14373,"_27447":51470,"_2948":51546},[],"DMSs and enrollment operations;",{"_3464":744,"_30209":718,"_20922":51548,"_5":14373,"_27447":51470,"_2948":51549},[],"validation functions and CRL;",{"_3464":745,"_30209":718,"_20922":51551,"_5":14373,"_27447":51470,"_2948":51552},[],"principals, policies and authorization grants.",{"_3464":746,"_30209":718,"_20922":51554,"_5":14373,"_27447":51470,"_2948":51555},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3464":747,"_30209":718,"_20922":51557,"_5":14373,"_27447":51474,"_2948":51558},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3464":748,"_30209":718,"_20922":51560,"_5":14373,"_27447":51474,"_2948":51561},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3464":749,"_30209":718,"_20922":51563,"_5":14373,"_27447":51474,"_2948":51564},[],"Design the consumer to:",{"_3464":750,"_30209":718,"_20922":51566,"_5":14373,"_27447":51474,"_2948":51567},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3464":751,"_30209":718,"_20922":51569,"_5":14373,"_27447":51474,"_2948":51570},[],"keep the complete CloudEvent unmodified;",{"_3464":752,"_30209":718,"_20922":51572,"_5":14373,"_27447":51474,"_2948":51573},[],"record the ingestion time and detect duplicates by ID;",{"_3464":753,"_30209":718,"_20922":51575,"_5":14373,"_27447":51474,"_2948":51576},[],"encrypt in transit and at rest;",{"_3464":754,"_30209":718,"_20922":51578,"_5":14373,"_27447":51474,"_2948":51579},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3464":755,"_30209":718,"_20922":51581,"_5":14373,"_27447":51474,"_2948":51582},[],"apply an explicit retention and legal hold policy;",{"_3464":756,"_30209":718,"_20922":51584,"_5":14373,"_27447":51474,"_2948":51585},[],"alert if it stops consuming or the pending queue grows.",{"_3464":757,"_30209":718,"_20922":51587,"_5":14373,"_27447":51478,"_2948":51588},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3464":758,"_30209":718,"_20922":51590,"_5":14373,"_27447":51478,"_2948":51591},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3464":759,"_30209":718,"_20922":51593,"_5":14373,"_27447":51486,"_2948":51594},[],"Start from the reported time and normalize every source to UTC.",{"_3464":760,"_30209":718,"_20922":51596,"_5":14373,"_27447":51490,"_2948":51597},[],"Filter by event type, service source and resource identifier.",{"_3464":761,"_30209":718,"_20922":51599,"_5":14373,"_27447":51494,"_2948":51600},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3464":762,"_30209":718,"_20922":51602,"_5":14373,"_27447":51498,"_2948":51603},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3464":763,"_30209":718,"_20922":51605,"_5":14373,"_27447":51502,"_2948":51606},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3464":764,"_30209":718,"_20922":51608,"_5":14373,"_27447":51506,"_2948":51609},[],"Generate a controlled mutation in a test environment and check that:",{"_3464":765,"_30209":718,"_20922":51611,"_5":14373,"_27447":51506,"_2948":51612},[],"a successful audit event appears;",{"_3464":766,"_30209":718,"_20922":51614,"_5":14373,"_27447":51506,"_2948":51615},[],"the principal matches the identity used;",{"_3464":767,"_30209":718,"_20922":51617,"_5":14373,"_27447":51506,"_2948":51618},[],"the consumer persists it exactly once;",{"_3464":768,"_30209":718,"_20922":51620,"_5":14373,"_27447":51506,"_2948":51621},[],"it can be retrieved by resource, actor and period;",{"_3464":769,"_30209":718,"_20922":51623,"_5":14373,"_27447":51506,"_2948":51624},[],"a consumer outage raises an alert.",{"_3464":770,"_30209":718,"_20922":51626,"_5":14373,"_27447":51506,"_2948":51627},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3464":771,"_30209":771,"_5":14725,"_2948":51629,"_30541":51630,"_20922":51631,"_27447":771},"Platform architecture",[49244,50719],[],{"_3464":772,"_30209":771,"_20922":51633,"_5":14373,"_27447":771,"_2948":51634},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3464":773,"_30209":771,"_5":30538,"_20922":51636,"_27447":51637,"_2948":51638},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3464":774,"_30209":771,"_5":30538,"_20922":51640,"_27447":51641,"_2948":51642},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3464":775,"_30209":771,"_5":30538,"_20922":51644,"_27447":51645,"_2948":51646},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3464":776,"_30209":771,"_5":30538,"_20922":51648,"_27447":51649,"_2948":51650},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3464":777,"_30209":771,"_5":30538,"_20922":51652,"_27447":51653,"_2948":51654},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3464":778,"_30209":771,"_20922":51656,"_5":14373,"_27447":771,"_2948":51657},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3464":779,"_30209":771,"_20922":51659,"_5":14373,"_27447":771,"_2948":51660},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3464":780,"_30209":771,"_20922":51662,"_5":14373,"_27447":51637,"_2948":51663},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3464":781,"_30209":771,"_20922":51665,"_5":14373,"_27447":51641,"_2948":51666},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3464":782,"_30209":771,"_20922":51668,"_5":14373,"_27447":51645,"_2948":51669},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3464":783,"_30209":771,"_20922":51671,"_5":14373,"_27447":51649,"_2948":51672},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3464":784,"_30209":771,"_20922":51674,"_5":14373,"_27447":51653,"_2948":51675},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3464":785,"_30209":785,"_5":14725,"_2948":51677,"_30541":51678,"_20922":51679,"_27447":785},"How Lamassu works",[49244,50719],[],{"_3464":786,"_30209":785,"_20922":51681,"_5":14373,"_27447":785,"_2948":51682},[],"The mental model of trust, keys, certificates and devices.",{"_3464":787,"_30209":785,"_5":30538,"_20922":51684,"_27447":51685,"_2948":51686},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3464":788,"_30209":785,"_5":30538,"_20922":51688,"_27447":51689,"_2948":51690},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3464":789,"_30209":785,"_20922":51692,"_5":14373,"_27447":785,"_2948":51693},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3464":790,"_30209":785,"_20922":51695,"_5":14373,"_27447":51685,"_2948":51696},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3464":791,"_30209":785,"_20922":51698,"_5":14373,"_27447":51685,"_2948":51699},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3464":792,"_30209":785,"_20922":51701,"_5":14373,"_27447":51685,"_2948":51702},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3464":793,"_30209":785,"_20922":51704,"_5":14373,"_27447":51685,"_2948":51705},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3464":794,"_30209":785,"_20922":51707,"_5":14373,"_27447":51685,"_2948":51708},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3464":795,"_30209":785,"_20922":51710,"_5":14373,"_27447":51689,"_2948":51711},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3464":796,"_30209":785,"_20922":51713,"_5":14373,"_27447":51689,"_2948":51714},[],"A DMS relates that CA to an enrollment policy.",{"_3464":797,"_30209":785,"_20922":51716,"_5":14373,"_27447":51689,"_2948":51717},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3464":798,"_30209":785,"_20922":51719,"_5":14373,"_27447":51689,"_2948":51720},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3464":799,"_30209":785,"_20922":51722,"_5":14373,"_27447":51689,"_2948":51723},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3464":800,"_30209":785,"_20922":51725,"_5":14373,"_27447":51689,"_2948":51726},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3464":801,"_30209":785,"_20922":51728,"_5":14373,"_27447":51689,"_2948":51729},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3464":802,"_30209":802,"_5":14725,"_2948":51731,"_30541":51732,"_20922":51734,"_27447":802},"Devices and identities",[49244,50719,51733,51731],"IoT Fleets",[],{"_3464":803,"_30209":802,"_20922":51736,"_5":14373,"_27447":802,"_2948":51737},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3464":804,"_30209":802,"_5":30538,"_20922":51739,"_27447":51740,"_2948":51741},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3464":805,"_30209":802,"_5":30538,"_20922":51743,"_27447":51744,"_2948":51745},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3464":806,"_30209":802,"_5":30538,"_20922":51747,"_27447":51748,"_2948":51749},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3464":807,"_30209":802,"_5":30538,"_20922":51751,"_27447":51752,"_2948":51753},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3464":808,"_30209":802,"_5":30538,"_20922":51755,"_27447":51756,"_2948":51757},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3464":809,"_30209":802,"_5":30538,"_20922":51759,"_27447":51760,"_2948":51761},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3464":810,"_30209":802,"_5":30538,"_20922":51763,"_27447":51764,"_2948":51765},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3464":811,"_30209":802,"_5":30538,"_20922":51767,"_27447":51768,"_2948":51769},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3464":812,"_30209":802,"_5":30538,"_20922":51771,"_27447":51772,"_2948":51773},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3464":813,"_30209":802,"_5":30538,"_20922":51775,"_27447":51776,"_2948":51777},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3464":814,"_30209":802,"_5":30538,"_20922":51779,"_27447":51780,"_2948":51781},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3464":815,"_30209":802,"_20922":51783,"_5":14373,"_27447":802,"_2948":51784},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3464":816,"_30209":802,"_20922":51786,"_5":14373,"_27447":802,"_2948":51787},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3464":817,"_30209":802,"_20922":51789,"_5":14373,"_27447":51740,"_2948":51790},[],"Operational view",{"_3464":818,"_30209":802,"_20922":51792,"_5":14373,"_27447":51740,"_2948":51793},[],"Meaning",{"_3464":819,"_30209":802,"_20922":51795,"_5":14373,"_27447":51740,"_2948":51796},[],"**No Identity**",{"_3464":820,"_30209":802,"_20922":51798,"_5":14373,"_27447":51740,"_2948":51799},[],"A record exists without an associated identity.",{"_3464":821,"_30209":802,"_20922":51801,"_5":14373,"_27447":51740,"_2948":51802},[],"**Active**",{"_3464":822,"_30209":802,"_20922":51804,"_5":14373,"_27447":51740,"_2948":51805},[],"The slot is active; also check certificate dates, status and usages.",{"_3464":823,"_30209":802,"_20922":51807,"_5":14373,"_27447":51740,"_2948":51808},[],"**Renewal Pending**",{"_3464":824,"_30209":802,"_20922":51810,"_5":14373,"_27447":51740,"_2948":51811},[],"The identity is in the operational renewal window.",{"_3464":825,"_30209":802,"_20922":51813,"_5":14373,"_27447":51740,"_2948":51814},[],"**Expiring Soon**",{"_3464":826,"_30209":802,"_20922":51816,"_5":14373,"_27447":51740,"_2948":51817},[],"Expiration is approaching according to configured thresholds.",{"_3464":827,"_30209":802,"_20922":51819,"_5":14373,"_27447":51740,"_2948":51820},[],"**Expired**",{"_3464":828,"_30209":802,"_20922":51822,"_5":14373,"_27447":51740,"_2948":51823},[],"The identity has expired.",{"_3464":829,"_30209":802,"_20922":51825,"_5":14373,"_27447":51740,"_2948":51826},[],"**Revoked**",{"_3464":830,"_30209":802,"_20922":51828,"_5":14373,"_27447":51740,"_2948":51829},[],"The identity is marked revoked.",{"_3464":831,"_30209":802,"_20922":51831,"_5":14373,"_27447":51740,"_2948":51832},[],"**Decommissioned**",{"_3464":832,"_30209":802,"_20922":51834,"_5":14373,"_27447":51740,"_2948":51835},[],"The record is retired and ordinary updates do not restore operation.",{"_3464":833,"_30209":802,"_20922":51837,"_5":14373,"_27447":51740,"_2948":51838},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3464":834,"_30209":802,"_20922":51840,"_5":14373,"_27447":51744,"_2948":51841},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3464":835,"_30209":802,"_20922":51843,"_5":14373,"_27447":51744,"_2948":51844},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3464":836,"_30209":802,"_20922":51846,"_5":14373,"_27447":51744,"_2948":51847},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3464":837,"_30209":802,"_20922":51849,"_5":14373,"_27447":51744,"_2948":51850},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3464":838,"_30209":802,"_20922":51852,"_5":14373,"_27447":51748,"_2948":51853},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3464":839,"_30209":802,"_20922":51855,"_5":14373,"_27447":51752,"_2948":51856},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3464":840,"_30209":802,"_20922":51858,"_5":14373,"_27447":51756,"_2948":51859},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3464":841,"_30209":802,"_20922":51861,"_5":14373,"_27447":51760,"_2948":51862},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3464":842,"_30209":802,"_20922":51864,"_5":14373,"_27447":51764,"_2948":51865},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3464":843,"_30209":802,"_20922":51867,"_5":14373,"_27447":51764,"_2948":51868},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3464":844,"_30209":802,"_20922":51870,"_5":14373,"_27447":51768,"_2948":51871},[],"From **No Identity**, use **Assign Identity**:",{"_3464":845,"_30209":802,"_20922":51873,"_5":14373,"_27447":51768,"_2948":51874},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3464":846,"_30209":802,"_20922":51876,"_5":14373,"_27447":51768,"_2948":51877},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3464":847,"_30209":802,"_20922":51879,"_5":14373,"_27447":51768,"_2948":51880},[],"Confirm and read the serial, active version and history again.",{"_3464":848,"_30209":802,"_20922":51882,"_5":14373,"_27447":51768,"_2948":51883},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3464":849,"_30209":802,"_20922":51885,"_5":14373,"_27447":51768,"_2948":51886},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3464":850,"_30209":802,"_20922":51888,"_5":14373,"_27447":51772,"_2948":51889},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3464":851,"_30209":802,"_20922":51891,"_5":14373,"_27447":51772,"_2948":51892},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3464":852,"_30209":802,"_20922":51894,"_5":14373,"_27447":51776,"_2948":51895},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3464":853,"_30209":802,"_20922":51897,"_5":14373,"_27447":51776,"_2948":51898},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3464":854,"_30209":802,"_20922":51900,"_5":14373,"_27447":51776,"_2948":51901},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3464":855,"_30209":802,"_20922":51903,"_5":14373,"_27447":51776,"_2948":51904},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3464":856,"_30209":802,"_20922":51906,"_5":14373,"_27447":51780,"_2948":51907},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":857,"_30209":802,"_20922":51909,"_5":14373,"_27447":51780,"_2948":51910},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":858,"_30209":858,"_5":14725,"_2948":51912,"_30541":51913,"_20922":51915,"_27447":858},"Bootstrap identity and authentication",[49244,50719,51733,51731,51914],"Enrollment with PKI",[],{"_3464":859,"_30209":858,"_20922":51917,"_5":14373,"_27447":858,"_2948":51918},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3464":860,"_30209":858,"_5":30538,"_20922":51920,"_27447":51921,"_2948":51922},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3464":861,"_30209":858,"_5":30538,"_20922":51924,"_27447":51925,"_2948":51926},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3464":862,"_30209":858,"_5":30538,"_20922":51928,"_27447":51929,"_2948":51930},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3464":863,"_30209":858,"_5":30538,"_20922":51932,"_27447":51933,"_2948":51934},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3464":864,"_30209":858,"_5":30538,"_20922":51936,"_27447":51937,"_2948":51938},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3464":865,"_30209":858,"_20922":51940,"_5":14373,"_27447":858,"_2948":51941},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3464":866,"_30209":858,"_20922":51943,"_5":14373,"_27447":51921,"_2948":51944},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3464":867,"_30209":858,"_20922":51946,"_5":14373,"_27447":51921,"_2948":51947},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3464":868,"_30209":858,"_20922":51949,"_5":14373,"_27447":51925,"_2948":51950},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3464":869,"_30209":858,"_20922":51952,"_5":14373,"_27447":51925,"_2948":51953},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3464":870,"_30209":858,"_20922":51955,"_5":14373,"_27447":51925,"_2948":51956},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3464":871,"_30209":858,"_20922":51958,"_5":14373,"_27447":51929,"_2948":51959},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3464":872,"_30209":858,"_20922":51961,"_5":14373,"_27447":51929,"_2948":51962},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3464":873,"_30209":858,"_20922":51964,"_5":14373,"_27447":51933,"_2948":51965},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3464":874,"_30209":858,"_20922":51967,"_5":14373,"_27447":51933,"_2948":51968},[],"Example body:",{"_3464":875,"_30209":858,"_20922":51970,"_5":14373,"_27447":51933,"_2948":51971},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3464":876,"_30209":858,"_20922":51973,"_5":14373,"_27447":51933,"_2948":51974},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3464":877,"_30209":858,"_20922":51976,"_5":14373,"_27447":51933,"_2948":51977},[],"Continuation requires a successful HTTP response and JSON:",{"_3464":878,"_30209":858,"_20922":51979,"_5":14373,"_27447":51933,"_2948":51980},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3464":879,"_30209":858,"_20922":51982,"_5":14373,"_27447":51937,"_2948":51983},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3464":880,"_30209":858,"_20922":51985,"_5":14373,"_27447":51937,"_2948":51986},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3464":881,"_30209":881,"_5":14725,"_2948":51988,"_30541":51989,"_20922":51990,"_27447":881},"Configure and operate the DMS",[49244,50719,51733,51731,51914],[],{"_3464":882,"_30209":881,"_20922":51992,"_5":14373,"_27447":881,"_2948":51993},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3464":883,"_30209":881,"_5":30538,"_20922":51995,"_27447":51996,"_2948":49254},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3464":884,"_30209":881,"_5":30538,"_20922":51998,"_27447":51999,"_2948":52000},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3464":885,"_30209":881,"_5":30538,"_20922":52002,"_27447":52003,"_2948":52004},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3464":886,"_30209":881,"_5":30538,"_20922":52006,"_27447":52007,"_2948":52008},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3464":887,"_30209":881,"_5":30538,"_20922":52010,"_27447":52011,"_2948":52012},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3464":888,"_30209":881,"_5":30538,"_20922":52014,"_27447":52015,"_2948":52016},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3464":889,"_30209":881,"_5":30538,"_20922":52018,"_27447":52019,"_2948":52020},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3464":890,"_30209":881,"_5":30538,"_20922":52022,"_27447":52023,"_2948":52024},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3464":891,"_30209":881,"_5":30538,"_20922":52026,"_27447":52027,"_2948":52028},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3464":892,"_30209":881,"_5":30538,"_20922":52030,"_27447":52031,"_2948":52032},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3464":893,"_30209":881,"_5":30538,"_20922":52034,"_27447":52035,"_2948":52036},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3464":894,"_30209":881,"_5":30538,"_20922":52038,"_27447":52039,"_2948":52040},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3464":895,"_30209":881,"_5":30538,"_20922":52042,"_27447":52043,"_2948":52044},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3464":896,"_30209":881,"_5":30538,"_20922":52046,"_27447":52047,"_2948":52048},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3464":897,"_30209":881,"_5":30538,"_20922":52050,"_27447":52051,"_2948":52052},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3464":898,"_30209":881,"_5":30538,"_20922":52054,"_27447":52055,"_2948":52056},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3464":899,"_30209":881,"_5":30538,"_20922":52058,"_27447":52059,"_2948":52060},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3464":900,"_30209":881,"_5":30538,"_20922":52062,"_27447":52063,"_2948":52064},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3464":901,"_30209":881,"_20922":52066,"_5":14373,"_27447":881,"_2948":52067},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3464":902,"_30209":881,"_20922":52069,"_5":14373,"_27447":51996,"_2948":52070},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3464":903,"_30209":881,"_20922":52072,"_5":14373,"_27447":51996,"_2948":52073},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3464":904,"_30209":881,"_20922":52075,"_5":14373,"_27447":52003,"_2948":52076},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3464":905,"_30209":881,"_20922":52078,"_5":14373,"_27447":52007,"_2948":52079},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3464":906,"_30209":881,"_20922":52081,"_5":14373,"_27447":52011,"_2948":52082},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3464":907,"_30209":881,"_20922":52084,"_5":14373,"_27447":52015,"_2948":52085},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3464":908,"_30209":881,"_20922":52087,"_5":14373,"_27447":52019,"_2948":52088},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3464":909,"_30209":881,"_20922":52090,"_5":14373,"_27447":52027,"_2948":52091},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3464":910,"_30209":881,"_20922":52093,"_5":14373,"_27447":52027,"_2948":52094},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3464":911,"_30209":881,"_20922":52096,"_5":14373,"_27447":52031,"_2948":52097},[],"`settings.enrollment_settings` field",{"_3464":912,"_30209":881,"_20922":52099,"_5":14373,"_27447":52031,"_2948":52100},[],"Decision",{"_3464":913,"_30209":881,"_20922":52102,"_5":14373,"_27447":52031,"_2948":52103},[],"`protocol`",{"_3464":914,"_30209":881,"_20922":52105,"_5":14373,"_27447":52031,"_2948":52106},[],"`EST_RFC7030` for these operations.",{"_3464":915,"_30209":881,"_20922":52108,"_5":14373,"_27447":52031,"_2948":52109},[],"`enrollment_ca`",{"_3464":916,"_30209":881,"_20922":52111,"_5":14373,"_27447":52031,"_2948":52112},[],"ID of the signing CA.",{"_3464":917,"_30209":881,"_20922":52114,"_5":14373,"_27447":52031,"_2948":52115},[],"`verify_csr_signature`",{"_3464":918,"_30209":881,"_20922":52117,"_5":14373,"_27447":52031,"_2948":52118},[],"Keep `true` to verify CSR key possession.",{"_3464":919,"_30209":881,"_20922":52120,"_5":14373,"_27447":52031,"_2948":52121},[],"`enable_replaceable_enrollment`",{"_3464":920,"_30209":881,"_20922":52123,"_5":14373,"_27447":52031,"_2948":52124},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3464":921,"_30209":881,"_20922":52126,"_5":14373,"_27447":52031,"_2948":52127},[],"`est_rfc7030_settings.auth_mode`",{"_3464":922,"_30209":881,"_20922":52129,"_5":14373,"_27447":52031,"_2948":52130},[],"One of the four authentication modes.",{"_3464":923,"_30209":881,"_20922":52132,"_5":14373,"_27447":52031,"_2948":52133},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3464":924,"_30209":881,"_20922":52135,"_5":14373,"_27447":52035,"_2948":52136},[],"The blocks are independent:",{"_3464":925,"_30209":881,"_20922":52138,"_5":14373,"_27447":52035,"_2948":52139},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3464":926,"_30209":881,"_20922":52141,"_5":14373,"_27447":52035,"_2948":52142},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3464":927,"_30209":881,"_20922":52144,"_5":14373,"_27447":52035,"_2948":52145},[],"`auth_mode`",{"_3464":928,"_30209":881,"_20922":52147,"_5":14373,"_27447":52035,"_2948":52148},[],"Control applied in the configured operation",{"_3464":929,"_30209":881,"_20922":52150,"_5":14373,"_27447":52035,"_2948":52151},[],"`CLIENT_CERTIFICATE`",{"_3464":930,"_30209":881,"_20922":52153,"_5":14373,"_27447":52035,"_2948":52154},[],"Presented certificate validation.",{"_3464":931,"_30209":881,"_20922":52156,"_5":14373,"_27447":52035,"_2948":52157},[],"`EXTERNAL_WEBHOOK`",{"_3464":932,"_30209":881,"_20922":52159,"_5":14373,"_27447":52035,"_2948":52160},[],"Configured webhook authorization.",{"_3464":933,"_30209":881,"_20922":52162,"_5":14373,"_27447":52035,"_2948":52163},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3464":934,"_30209":881,"_20922":52165,"_5":14373,"_27447":52035,"_2948":52166},[],"Certificate validation followed by webhook approval.",{"_3464":935,"_30209":881,"_20922":52168,"_5":14373,"_27447":52035,"_2948":52169},[],"`NO_AUTH`",{"_3464":936,"_30209":881,"_20922":52171,"_5":14373,"_27447":52035,"_2948":52172},[],"No DMS requester authentication.",{"_3464":937,"_30209":881,"_20922":52174,"_5":14373,"_27447":52035,"_2948":52175},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3464":938,"_30209":881,"_20922":52177,"_5":14373,"_27447":52035,"_2948":52178},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3464":939,"_30209":881,"_20922":52180,"_5":14373,"_27447":52035,"_2948":52181},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3464":940,"_30209":881,"_20922":52183,"_5":14373,"_27447":52035,"_2948":52184},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3464":941,"_30209":881,"_20922":52186,"_5":14373,"_27447":52039,"_2948":52187},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3464":942,"_30209":881,"_20922":52189,"_5":14373,"_27447":52039,"_2948":52190},[],"`external_webhook_settings` field",{"_3464":943,"_30209":881,"_20922":52192,"_5":14373,"_27447":52039,"_2948":52100},[],{"_3464":944,"_30209":881,"_20922":52194,"_5":14373,"_27447":52039,"_2948":52195},[],"`url`",{"_3464":945,"_30209":881,"_20922":52197,"_5":14373,"_27447":52039,"_2948":52198},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3464":946,"_30209":881,"_20922":52200,"_5":14373,"_27447":52039,"_2948":52201},[],"`method`",{"_3464":947,"_30209":881,"_20922":52203,"_5":14373,"_27447":52039,"_2948":52204},[],"`POST` or `PUT`; `POST` by default.",{"_3464":948,"_30209":881,"_20922":52206,"_5":14373,"_27447":52039,"_2948":52207},[],"`name`",{"_3464":949,"_30209":881,"_20922":52209,"_5":14373,"_27447":52039,"_2948":52210},[],"Label used in service logs.",{"_3464":950,"_30209":881,"_20922":52212,"_5":14373,"_27447":52039,"_2948":52213},[],"`config.auth_mode`",{"_3464":951,"_30209":881,"_20922":52215,"_5":14373,"_27447":52039,"_2948":52216},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3464":952,"_30209":881,"_20922":52218,"_5":14373,"_27447":52039,"_2948":52219},[],"`config.log_level`",{"_3464":953,"_30209":881,"_20922":52221,"_5":14373,"_27447":52039,"_2948":52222},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3464":954,"_30209":881,"_20922":52224,"_5":14373,"_27447":52039,"_2948":52225},[],"`config.apikey_options`",{"_3464":955,"_30209":881,"_20922":52227,"_5":14373,"_27447":52039,"_2948":52228},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3464":956,"_30209":881,"_20922":52230,"_5":14373,"_27447":52039,"_2948":52231},[],"`config.jwt_options`",{"_3464":957,"_30209":881,"_20922":52233,"_5":14373,"_27447":52039,"_2948":52234},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3464":958,"_30209":881,"_20922":52236,"_5":14373,"_27447":52039,"_2948":52237},[],"`config.mtls_options`",{"_3464":959,"_30209":881,"_20922":52239,"_5":14373,"_27447":52039,"_2948":52240},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3464":960,"_30209":881,"_20922":52242,"_5":14373,"_27447":52039,"_2948":52243},[],"`config.insecure_skip_verify`",{"_3464":961,"_30209":881,"_20922":52245,"_5":14373,"_27447":52039,"_2948":52246},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3464":962,"_30209":881,"_20922":52248,"_5":14373,"_27447":52039,"_2948":52249},[],"`config.call_timeout`",{"_3464":963,"_30209":881,"_20922":52251,"_5":14373,"_27447":52039,"_2948":52252},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3464":964,"_30209":881,"_20922":52254,"_5":14373,"_27447":52039,"_2948":52255},[],"Rules for that configuration:",{"_3464":965,"_30209":881,"_20922":52257,"_5":14373,"_27447":52039,"_2948":52258},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3464":966,"_30209":881,"_20922":52260,"_5":14373,"_27447":52039,"_2948":52261},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3464":967,"_30209":881,"_20922":52263,"_5":14373,"_27447":52039,"_2948":52264},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3464":968,"_30209":881,"_20922":52266,"_5":14373,"_27447":52039,"_2948":52267},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3464":969,"_30209":881,"_20922":52269,"_5":14373,"_27447":52039,"_2948":52270},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3464":970,"_30209":881,"_20922":52272,"_5":14373,"_27447":52039,"_2948":52273},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3464":971,"_30209":881,"_20922":52275,"_5":14373,"_27447":52039,"_2948":52276},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3464":972,"_30209":881,"_20922":52278,"_5":14373,"_27447":52039,"_2948":52279},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3464":973,"_30209":881,"_20922":52281,"_5":14373,"_27447":52039,"_2948":52282},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3464":974,"_30209":881,"_20922":52284,"_5":14373,"_27447":52043,"_2948":52285},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3464":975,"_30209":881,"_20922":52287,"_5":14373,"_27447":52047,"_2948":52288},[],"`settings.reenrollment_settings` field",{"_3464":976,"_30209":881,"_20922":52290,"_5":14373,"_27447":52047,"_2948":49634},[],{"_3464":977,"_30209":881,"_20922":52292,"_5":14373,"_27447":52047,"_2948":52293},[],"`reenrollment_delta`",{"_3464":978,"_30209":881,"_20922":52295,"_5":14373,"_27447":52047,"_2948":52296},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3464":979,"_30209":881,"_20922":52298,"_5":14373,"_27447":52047,"_2948":52299},[],"`preventive_delta`",{"_3464":980,"_30209":881,"_20922":52301,"_5":14373,"_27447":52047,"_2948":52302},[],"Preventive operational monitoring threshold.",{"_3464":981,"_30209":881,"_20922":52304,"_5":14373,"_27447":52047,"_2948":52305},[],"`critical_delta`",{"_3464":982,"_30209":881,"_20922":52307,"_5":14373,"_27447":52047,"_2948":52308},[],"Critical operational monitoring threshold.",{"_3464":983,"_30209":881,"_20922":52310,"_5":14373,"_27447":52047,"_2948":52311},[],"`enable_expired_renewal`",{"_3464":984,"_30209":881,"_20922":52313,"_5":14373,"_27447":52047,"_2948":52314},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3464":985,"_30209":881,"_20922":52316,"_5":14373,"_27447":52047,"_2948":52317},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3464":986,"_30209":881,"_20922":52319,"_5":14373,"_27447":52047,"_2948":52320},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3464":987,"_30209":881,"_20922":52322,"_5":14373,"_27447":52047,"_2948":52323},[],"`revoke_on_reenrollment`",{"_3464":988,"_30209":881,"_20922":52325,"_5":14373,"_27447":52047,"_2948":52326},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3464":989,"_30209":881,"_20922":52328,"_5":14373,"_27447":52047,"_2948":52329},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3464":990,"_30209":881,"_20922":52331,"_5":14373,"_27447":52051,"_2948":52332},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3464":991,"_30209":881,"_20922":52334,"_5":14373,"_27447":52055,"_2948":49628},[],{"_3464":992,"_30209":881,"_20922":52336,"_5":14373,"_27447":52055,"_2948":52337},[],"Published material",{"_3464":993,"_30209":881,"_20922":52339,"_5":14373,"_27447":52055,"_2948":52340},[],"**Include Lamassu System CA**",{"_3464":994,"_30209":881,"_20922":52342,"_5":14373,"_27447":52055,"_2948":52343},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3464":995,"_30209":881,"_20922":52345,"_5":14373,"_27447":52055,"_2948":52346},[],"**Include Enrollment CA**",{"_3464":996,"_30209":881,"_20922":52348,"_5":14373,"_27447":52055,"_2948":52349},[],"Selected issuing CA certificate.",{"_3464":997,"_30209":881,"_20922":52351,"_5":14373,"_27447":52055,"_2948":52352},[],"**Managed CAs**",{"_3464":998,"_30209":881,"_20922":52354,"_5":14373,"_27447":52055,"_2948":52355},[],"Explicitly selected CA certificates.",{"_3464":999,"_30209":881,"_20922":52357,"_5":14373,"_27447":52055,"_2948":52358},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3464":1000,"_30209":881,"_20922":52360,"_5":14373,"_27447":52059,"_2948":52361},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3464":1001,"_30209":881,"_20922":52363,"_5":14373,"_27447":52059,"_2948":52364},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3464":1002,"_30209":881,"_20922":52366,"_5":14373,"_27447":52059,"_2948":52367},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3464":1003,"_30209":881,"_20922":52369,"_5":14373,"_27447":52063,"_2948":52370},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3464":1004,"_30209":1004,"_5":14725,"_2948":52372,"_30541":52373,"_20922":52374,"_27447":1004},"Integrate the EST client",[49244,50719,51733,51731,51914],[],{"_3464":1005,"_30209":1004,"_20922":52376,"_5":14373,"_27447":1004,"_2948":52377},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3464":1006,"_30209":1004,"_5":30538,"_20922":52379,"_27447":52380,"_2948":49254},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3464":1007,"_30209":1004,"_5":30538,"_20922":52382,"_27447":52383,"_2948":52384},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3464":1008,"_30209":1004,"_5":30538,"_20922":52386,"_27447":52387,"_2948":52388},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3464":1009,"_30209":1004,"_5":30538,"_20922":52390,"_27447":52391,"_2948":52392},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3464":1010,"_30209":1004,"_5":30538,"_20922":52394,"_27447":52395,"_2948":52396},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3464":1011,"_30209":1004,"_5":30538,"_20922":52398,"_27447":52399,"_2948":52400},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3464":1012,"_30209":1004,"_20922":52402,"_5":14373,"_27447":1004,"_2948":52403},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3464":1013,"_30209":1004,"_20922":52405,"_5":14373,"_27447":52380,"_2948":52406},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3464":1014,"_30209":1004,"_20922":52408,"_5":14373,"_27447":52380,"_2948":52409},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3464":1015,"_30209":1004,"_20922":52411,"_5":14373,"_27447":52380,"_2948":52412},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3464":1016,"_30209":1004,"_20922":52414,"_5":14373,"_27447":52383,"_2948":52415},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3464":1017,"_30209":1004,"_20922":52417,"_5":14373,"_27447":52383,"_2948":52418},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3464":1018,"_30209":1004,"_20922":52420,"_5":14373,"_27447":52387,"_2948":52421},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3464":1019,"_30209":1004,"_20922":52423,"_5":14373,"_27447":52387,"_2948":52424},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3464":1020,"_30209":1004,"_20922":52426,"_5":14373,"_27447":52391,"_2948":52427},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3464":1021,"_30209":1004,"_20922":52429,"_5":14373,"_27447":52391,"_2948":52430},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3464":1022,"_30209":1004,"_20922":52432,"_5":14373,"_27447":52395,"_2948":52433},[],"For a root that issues directly:",{"_3464":1023,"_30209":1004,"_20922":52435,"_5":14373,"_27447":52395,"_2948":52436},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3464":1024,"_30209":1004,"_20922":52438,"_5":14373,"_27447":52395,"_2948":52439},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3464":1025,"_30209":1004,"_20922":52441,"_5":14373,"_27447":52399,"_2948":52442},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3464":1026,"_30209":1026,"_5":14725,"_2948":52444,"_30541":52445,"_20922":52446,"_27447":1026},"EST reference",[49244,50719,51733,51731,51914],[],{"_3464":1027,"_30209":1026,"_20922":52448,"_5":14373,"_27447":1026,"_2948":52449},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3464":1028,"_30209":1026,"_5":30538,"_20922":52451,"_27447":52452,"_2948":52453},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3464":1029,"_30209":1026,"_5":30538,"_20922":52455,"_27447":52456,"_2948":22673},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3464":1030,"_30209":1026,"_5":30538,"_20922":52458,"_27447":52459,"_2948":26050},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3464":1031,"_30209":1026,"_5":30538,"_20922":52461,"_27447":52462,"_2948":26057},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3464":1032,"_30209":1026,"_5":30538,"_20922":52464,"_27447":52465,"_2948":25376},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3464":1033,"_30209":1026,"_5":30538,"_20922":52467,"_27447":52468,"_2948":52469},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3464":1034,"_30209":1026,"_5":30538,"_20922":52471,"_27447":52472,"_2948":52473},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3464":1035,"_30209":1026,"_5":30538,"_20922":52475,"_27447":52476,"_2948":52477},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3464":1036,"_30209":1026,"_20922":52479,"_5":14373,"_27447":1026,"_2948":52480},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3464":1037,"_30209":1026,"_20922":52482,"_5":14373,"_27447":52452,"_2948":52483},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3464":1038,"_30209":1026,"_20922":52485,"_5":14373,"_27447":52452,"_2948":52486},[],"Operation",{"_3464":1039,"_30209":1026,"_20922":52488,"_5":14373,"_27447":52452,"_2948":52489},[],"Method",{"_3464":1040,"_30209":1026,"_20922":52491,"_5":14373,"_27447":52452,"_2948":52492},[],"Authentication and condition",{"_3464":1041,"_30209":1026,"_20922":52494,"_5":14373,"_27447":52452,"_2948":52495},[],"`/cacerts`",{"_3464":1042,"_30209":1026,"_20922":52497,"_5":14373,"_27447":52452,"_2948":52498},[],"GET",{"_3464":1043,"_30209":1026,"_20922":52500,"_5":14373,"_27447":52452,"_2948":52501},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3464":1044,"_30209":1026,"_20922":52503,"_5":14373,"_27447":52452,"_2948":52504},[],"`/simpleenroll`",{"_3464":1045,"_30209":1026,"_20922":52506,"_5":14373,"_27447":52452,"_2948":52507},[],"POST",{"_3464":1046,"_30209":1026,"_20922":52509,"_5":14373,"_27447":52452,"_2948":52510},[],"Initial authentication and DMS registration/replacement policy.",{"_3464":1047,"_30209":1026,"_20922":52512,"_5":14373,"_27447":52452,"_2948":52513},[],"`/simplereenroll`",{"_3464":1048,"_30209":1026,"_20922":52515,"_5":14373,"_27447":52452,"_2948":52507},[],{"_3464":1049,"_30209":1026,"_20922":52517,"_5":14373,"_27447":52452,"_2948":52518},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3464":1050,"_30209":1026,"_20922":52520,"_5":14373,"_27447":52452,"_2948":52521},[],"`/serverkeygen`",{"_3464":1051,"_30209":1026,"_20922":52523,"_5":14373,"_27447":52452,"_2948":52507},[],{"_3464":1052,"_30209":1026,"_20922":52525,"_5":14373,"_27447":52452,"_2948":52526},[],"Initial authentication and admission; server generation enabled.",{"_3464":1053,"_30209":1026,"_20922":52528,"_5":14373,"_27447":52452,"_2948":52529},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3464":1054,"_30209":1026,"_20922":52531,"_5":14373,"_27447":52456,"_2948":52532},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3464":1055,"_30209":1026,"_20922":52534,"_5":14373,"_27447":52456,"_2948":52535},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3464":1056,"_30209":1026,"_20922":52537,"_5":14373,"_27447":52459,"_2948":52538},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3464":1057,"_30209":1026,"_20922":52540,"_5":14373,"_27447":52459,"_2948":52541},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3464":1058,"_30209":1026,"_20922":52543,"_5":14373,"_27447":52462,"_2948":52544},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3464":1059,"_30209":1026,"_20922":52546,"_5":14373,"_27447":52462,"_2948":52547},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3464":1060,"_30209":1026,"_20922":52549,"_5":14373,"_27447":52465,"_2948":52550},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3464":1061,"_30209":1026,"_20922":52552,"_5":14373,"_27447":52465,"_2948":52553},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3464":1062,"_30209":1026,"_20922":52555,"_5":14373,"_27447":52468,"_2948":52556},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3464":1063,"_30209":1026,"_20922":52558,"_5":14373,"_27447":52468,"_2948":52559},[],"Part",{"_3464":1064,"_30209":1026,"_20922":52561,"_5":14373,"_27447":52468,"_2948":52562},[],"Content after decoding its Base64",{"_3464":1065,"_30209":1026,"_20922":52564,"_5":14373,"_27447":52468,"_2948":52565},[],"`application/pkcs8`",{"_3464":1066,"_30209":1026,"_20922":52567,"_5":14373,"_27447":52468,"_2948":52568},[],"Unencrypted DER PKCS#8 private key.",{"_3464":1067,"_30209":1026,"_20922":52570,"_5":14373,"_27447":52468,"_2948":52571},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3464":1068,"_30209":1026,"_20922":52573,"_5":14373,"_27447":52468,"_2948":52574},[],"DER PKCS#7 containing the issued certificate.",{"_3464":1069,"_30209":1026,"_20922":52576,"_5":14373,"_27447":52468,"_2948":52577},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3464":1070,"_30209":1026,"_20922":52579,"_5":14373,"_27447":52472,"_2948":52580},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3464":1071,"_30209":1026,"_20922":52582,"_5":14373,"_27447":52472,"_2948":52583},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3464":1072,"_30209":1026,"_20922":52585,"_5":14373,"_27447":52472,"_2948":52586},[],"Convert and check the result:",{"_3464":1073,"_30209":1026,"_20922":52588,"_5":14373,"_27447":52472,"_2948":52589},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3464":1074,"_30209":1026,"_20922":52591,"_5":14373,"_27447":52476,"_2948":52592},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3464":1075,"_30209":1026,"_20922":52594,"_5":14373,"_27447":52476,"_2948":52595},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3464":1076,"_30209":1076,"_5":14725,"_2948":51914,"_30541":52597,"_20922":52598,"_27447":1076},[49244,50719,51733,51731,51914],[],{"_3464":1077,"_30209":1076,"_20922":52600,"_5":14373,"_27447":1076,"_2948":52601},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3464":1078,"_30209":1076,"_5":30538,"_20922":52603,"_27447":52604,"_2948":52605},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3464":1079,"_30209":1076,"_5":30538,"_20922":52607,"_27447":52608,"_2948":52609},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3464":1080,"_30209":1076,"_5":30538,"_20922":52611,"_27447":52612,"_2948":52613},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3464":1081,"_30209":1076,"_5":30538,"_20922":52615,"_27447":52616,"_2948":52617},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3464":1082,"_30209":1076,"_20922":52619,"_5":14373,"_27447":1076,"_2948":52620},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3464":1083,"_30209":1076,"_20922":52622,"_5":14373,"_27447":52604,"_2948":52623},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3464":1084,"_30209":1076,"_20922":52625,"_5":14373,"_27447":52604,"_2948":52626},[],"The integrator installs initial EST server trust and an admission credential.",{"_3464":1085,"_30209":1076,"_20922":52628,"_5":14373,"_27447":52604,"_2948":52629},[],"The client requests an identity for its `Device ID` through EST.",{"_3464":1086,"_30209":1076,"_20922":52631,"_5":14373,"_27447":52604,"_2948":52632},[],"Certificate, device binding and key/certificate installation are checked.",{"_3464":1087,"_30209":1076,"_20922":52634,"_5":14373,"_27447":52604,"_2948":52635},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3464":1088,"_30209":1076,"_20922":52637,"_5":14373,"_27447":52604,"_2948":52638},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3464":1089,"_30209":1076,"_20922":52640,"_5":14373,"_27447":52608,"_2948":52641},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3464":1090,"_30209":1076,"_20922":52643,"_5":14373,"_27447":52608,"_2948":52644},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":1091,"_30209":1076,"_20922":52646,"_5":14373,"_27447":52608,"_2948":52647},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3464":1092,"_30209":1076,"_20922":52649,"_5":14373,"_27447":52608,"_2948":52650},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3464":1093,"_30209":1076,"_20922":52652,"_5":14373,"_27447":52612,"_2948":52653},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":1094,"_30209":1076,"_20922":52655,"_5":14373,"_27447":52612,"_2948":52656},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":1095,"_30209":1076,"_20922":52658,"_5":14373,"_27447":52612,"_2948":52659},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3464":1096,"_30209":1076,"_20922":52661,"_5":14373,"_27447":52612,"_2948":52662},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3464":1097,"_30209":1076,"_20922":52664,"_5":14373,"_27447":52616,"_2948":52665},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3464":1098,"_30209":1076,"_20922":52667,"_5":14373,"_27447":52616,"_2948":52668},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3464":1099,"_30209":1099,"_5":14725,"_2948":52670,"_30541":52671,"_20922":52672,"_27447":1099},"Provisioning strategies",[49244,50719,51733,51731,51914],[],{"_3464":1100,"_30209":1099,"_20922":52674,"_5":14373,"_27447":1099,"_2948":52675},[],"Choose device registration, identity authorization and key generation.",{"_3464":1101,"_30209":1099,"_5":30538,"_20922":52677,"_27447":52678,"_2948":52679},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3464":1102,"_30209":1099,"_5":30538,"_20922":52681,"_27447":52682,"_2948":52683},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3464":1103,"_30209":1099,"_5":30538,"_20922":52685,"_27447":52686,"_2948":52687},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3464":1104,"_30209":1099,"_5":30538,"_20922":52689,"_27447":52690,"_2948":52691},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3464":1105,"_30209":1099,"_5":30538,"_20922":52693,"_27447":52694,"_2948":52695},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3464":1106,"_30209":1099,"_20922":52697,"_5":14373,"_27447":1099,"_2948":52698},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3464":1107,"_30209":1099,"_20922":52700,"_5":14373,"_27447":52678,"_2948":52701},[],"Path",{"_3464":1108,"_30209":1099,"_20922":52703,"_5":14373,"_27447":52678,"_2948":52704},[],"When the device exists",{"_3464":1109,"_30209":1099,"_20922":52706,"_5":14373,"_27447":52678,"_2948":52707},[],"What to check",{"_3464":1110,"_30209":1099,"_20922":52709,"_5":14373,"_27447":52678,"_2948":52710},[],"Manual assignment",{"_3464":1111,"_30209":1099,"_20922":52712,"_5":14373,"_27447":52678,"_2948":52713},[],"An operator creates it before associating a certificate.",{"_3464":1112,"_30209":1099,"_20922":52715,"_5":14373,"_27447":52678,"_2948":52716},[],"ID, owning DMS, certificate CN and bound serial.",{"_3464":1113,"_30209":1099,"_20922":52718,"_5":14373,"_27447":52678,"_2948":52719},[],"EST with `JITP`",{"_3464":1114,"_30209":1099,"_20922":52721,"_5":14373,"_27447":52678,"_2948":52722},[],"Created for an unknown CN during `/simpleenroll`.",{"_3464":1115,"_30209":1099,"_20922":52724,"_5":14373,"_27447":52678,"_2948":52725},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3464":1116,"_30209":1099,"_20922":52727,"_5":14373,"_27447":52678,"_2948":52728},[],"EST with `PRE_REGISTRATION`",{"_3464":1117,"_30209":1099,"_20922":52730,"_5":14373,"_27447":52678,"_2948":52731},[],"Must exist before `/simpleenroll`.",{"_3464":1118,"_30209":1099,"_20922":52733,"_5":14373,"_27447":52678,"_2948":52734},[],"Approved record, same DMS and replacement conditions for your version.",{"_3464":1119,"_30209":1099,"_20922":52736,"_5":14373,"_27447":52678,"_2948":52737},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3464":1120,"_30209":1099,"_20922":52739,"_5":14373,"_27447":52678,"_2948":52740},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3464":1121,"_30209":1099,"_20922":52742,"_5":14373,"_27447":52682,"_2948":52743},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3464":1122,"_30209":1099,"_20922":52745,"_5":14373,"_27447":52682,"_2948":52746},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3464":1123,"_30209":1099,"_20922":52748,"_5":14373,"_27447":52682,"_2948":52749},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3464":1124,"_30209":1099,"_20922":52751,"_5":14373,"_27447":52686,"_2948":52752},[],"Decide initial enrollment and re-enrollment separately:",{"_3464":1125,"_30209":1099,"_20922":52754,"_5":14373,"_27447":52686,"_2948":52755},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3464":1126,"_30209":1099,"_20922":52757,"_5":14373,"_27447":52686,"_2948":52758},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3464":1127,"_30209":1099,"_20922":52760,"_5":14373,"_27447":52686,"_2948":52761},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3464":1128,"_30209":1099,"_20922":52763,"_5":14373,"_27447":52686,"_2948":52764},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3464":1129,"_30209":1099,"_20922":52766,"_5":14373,"_27447":52686,"_2948":52767},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3464":1130,"_30209":1099,"_20922":52769,"_5":14373,"_27447":52690,"_2948":49628},[],{"_3464":1131,"_30209":1099,"_20922":52771,"_5":14373,"_27447":52690,"_2948":52772},[],"Material crossing EST",{"_3464":1132,"_30209":1099,"_20922":52774,"_5":14373,"_27447":52690,"_2948":52775},[],"Device-generated key",{"_3464":1133,"_30209":1099,"_20922":52777,"_5":14373,"_27447":52690,"_2948":52778},[],"Public CSR and certificate; the key stays on the client.",{"_3464":1134,"_30209":1099,"_20922":52780,"_5":14373,"_27447":52690,"_2948":52781},[],"Existing device key",{"_3464":1135,"_30209":1099,"_20922":52783,"_5":14373,"_27447":52690,"_2948":52784},[],"CSR signed with that key and a new certificate.",{"_3464":1136,"_30209":1099,"_20922":52786,"_5":14373,"_27447":52690,"_2948":52052},[],{"_3464":1137,"_30209":1099,"_20922":52788,"_5":14373,"_27447":52690,"_2948":52789},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3464":1138,"_30209":1099,"_20922":52791,"_5":14373,"_27447":52690,"_2948":52792},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3464":1139,"_30209":1099,"_20922":52794,"_5":14373,"_27447":52694,"_2948":52795},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3464":1140,"_30209":1140,"_5":14725,"_2948":52797,"_30541":52798,"_20922":52799,"_27447":1140},"Renewal and recovery",[49244,50719,51733,51731,51914],[],{"_3464":1141,"_30209":1140,"_20922":52801,"_5":14373,"_27447":1140,"_2948":52802},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3464":1142,"_30209":1140,"_5":30538,"_20922":52804,"_27447":52805,"_2948":52806},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3464":1143,"_30209":1140,"_5":30538,"_20922":52808,"_27447":52809,"_2948":52810},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3464":1144,"_30209":1140,"_5":30538,"_20922":52812,"_27447":52813,"_2948":52814},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3464":1145,"_30209":1140,"_5":30538,"_20922":52816,"_27447":52817,"_2948":52818},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3464":1146,"_30209":1140,"_5":30538,"_20922":52820,"_27447":52821,"_2948":52822},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3464":1147,"_30209":1140,"_20922":52824,"_5":14373,"_27447":1140,"_2948":52825},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3464":1148,"_30209":1140,"_20922":52827,"_5":14373,"_27447":52805,"_2948":52828},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3464":1149,"_30209":1140,"_20922":52830,"_5":14373,"_27447":52805,"_2948":52831},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3464":1150,"_30209":1140,"_20922":52833,"_5":14373,"_27447":52805,"_2948":52834},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3464":1151,"_30209":1140,"_20922":52836,"_5":14373,"_27447":52805,"_2948":52837},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3464":1152,"_30209":1140,"_20922":52839,"_5":14373,"_27447":52809,"_2948":52840},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3464":1153,"_30209":1140,"_20922":52842,"_5":14373,"_27447":52809,"_2948":52843},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3464":1154,"_30209":1140,"_20922":52845,"_5":14373,"_27447":52813,"_2948":52846},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3464":1155,"_30209":1140,"_20922":52848,"_5":14373,"_27447":52813,"_2948":52849},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3464":1156,"_30209":1140,"_20922":52851,"_5":14373,"_27447":52813,"_2948":52852},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3464":1157,"_30209":1140,"_20922":52854,"_5":14373,"_27447":52817,"_2948":52855},[],"Situation",{"_3464":1158,"_30209":1140,"_20922":52857,"_5":14373,"_27447":52817,"_2948":52858},[],"Procedure",{"_3464":1159,"_30209":1140,"_20922":52860,"_5":14373,"_27447":52817,"_2948":52861},[],"Valid certificate, outside the window",{"_3464":1160,"_30209":1140,"_20922":52863,"_5":14373,"_27447":52817,"_2948":52864},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3464":1161,"_30209":1140,"_20922":52866,"_5":14373,"_27447":52817,"_2948":52867},[],"Expired certificate, key available",{"_3464":1162,"_30209":1140,"_20922":52869,"_5":14373,"_27447":52817,"_2948":52870},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3464":1163,"_30209":1140,"_20922":52872,"_5":14373,"_27447":52817,"_2948":52873},[],"Renewal through webhook or `NO_AUTH`",{"_3464":1164,"_30209":1140,"_20922":52875,"_5":14373,"_27447":52817,"_2948":52876},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3464":1165,"_30209":1140,"_20922":52878,"_5":14373,"_27447":52817,"_2948":52879},[],"Lost or inaccessible key",{"_3464":1166,"_30209":1140,"_20922":52881,"_5":14373,"_27447":52817,"_2948":52882},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3464":1167,"_30209":1140,"_20922":52884,"_5":14373,"_27447":52817,"_2948":52885},[],"Current identity revoked",{"_3464":1168,"_30209":1140,"_20922":52887,"_5":14373,"_27447":52817,"_2948":52888},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3464":1169,"_30209":1140,"_20922":52890,"_5":14373,"_27447":52817,"_2948":52891},[],"Device without an identity",{"_3464":1170,"_30209":1140,"_20922":52893,"_5":14373,"_27447":52817,"_2948":52894},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3464":1171,"_30209":1140,"_20922":52896,"_5":14373,"_27447":52817,"_2948":52897},[],"Retired device",{"_3464":1172,"_30209":1140,"_20922":52899,"_5":14373,"_27447":52817,"_2948":52900},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3464":1173,"_30209":1140,"_20922":52902,"_5":14373,"_27447":52817,"_2948":52903},[],"Timeout, HTTP 500 or installation failure",{"_3464":1174,"_30209":1140,"_20922":52905,"_5":14373,"_27447":52817,"_2948":52906},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3464":1175,"_30209":1140,"_20922":52908,"_5":14373,"_27447":52821,"_2948":52909},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3464":1176,"_30209":1140,"_20922":52911,"_5":14373,"_27447":52821,"_2948":52912},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3464":1177,"_30209":1177,"_5":14725,"_2948":52914,"_30541":52915,"_20922":52916,"_27447":1177},"Enrollment troubleshooting",[49244,50719,51733,51731,51914],[],{"_3464":1178,"_30209":1177,"_20922":52918,"_5":14373,"_27447":1177,"_2948":52919},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3464":1179,"_30209":1177,"_5":30538,"_20922":52921,"_27447":52922,"_2948":52923},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3464":1180,"_30209":1177,"_5":30538,"_20922":52925,"_27447":52926,"_2948":52927},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3464":1181,"_30209":1177,"_5":30538,"_20922":52929,"_27447":52930,"_2948":52477},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3464":1182,"_30209":1177,"_5":30538,"_20922":52932,"_27447":52933,"_2948":52934},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3464":1183,"_30209":1177,"_20922":52936,"_5":14373,"_27447":1177,"_2948":52937},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3464":1184,"_30209":1177,"_20922":52939,"_5":14373,"_27447":52926,"_2948":52940},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3464":1185,"_30209":1177,"_20922":52942,"_5":14373,"_27447":52926,"_2948":52943},[],"Symptom or message",{"_3464":1186,"_30209":1177,"_20922":52945,"_5":14373,"_27447":52926,"_2948":52707},[],{"_3464":1187,"_30209":1177,"_20922":52947,"_5":14373,"_27447":52926,"_2948":52948},[],"curl rejects TLS, name or issuer",{"_3464":1188,"_30209":1177,"_20922":52950,"_5":14373,"_27447":52926,"_2948":52951},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3464":1189,"_30209":1177,"_20922":52953,"_5":14373,"_27447":52926,"_2948":52954},[],"404 or missing APS",{"_3464":1190,"_30209":1177,"_20922":52956,"_5":14373,"_27447":52926,"_2948":52957},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3464":1191,"_30209":1177,"_20922":52959,"_5":14373,"_27447":52926,"_2948":52960},[],"400, CSR or format error",{"_3464":1192,"_30209":1177,"_20922":52962,"_5":14373,"_27447":52926,"_2948":52963},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3464":1193,"_30209":1177,"_20922":52965,"_5":14373,"_27447":52926,"_2948":52966},[],"Missing credential or invalid certificate",{"_3464":1194,"_30209":1177,"_20922":52968,"_5":14373,"_27447":52926,"_2948":52969},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3464":1195,"_30209":1177,"_20922":52971,"_5":14373,"_27447":52926,"_2948":52972},[],"Webhook denies, times out or responds without authorization",{"_3464":1196,"_30209":1177,"_20922":52974,"_5":14373,"_27447":52926,"_2948":52975},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3464":1197,"_30209":1177,"_20922":52977,"_5":14373,"_27447":52926,"_2948":52978},[],"`unexpected status code: <n>: redirects are not followed`",{"_3464":1198,"_30209":1177,"_20922":52980,"_5":14373,"_27447":52926,"_2948":52981},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3464":1199,"_30209":1177,"_20922":52983,"_5":14373,"_27447":52926,"_2948":52984},[],"`webhook response exceeds 1048576 bytes`",{"_3464":1200,"_30209":1177,"_20922":52986,"_5":14373,"_27447":52926,"_2948":52987},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3464":1201,"_30209":1177,"_20922":52989,"_5":14373,"_27447":52926,"_2948":52990},[],"`webhook config must not reference files`",{"_3464":1202,"_30209":1177,"_20922":52992,"_5":14373,"_27447":52926,"_2948":52993},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3464":1203,"_30209":1177,"_20922":52995,"_5":14373,"_27447":52926,"_2948":52996},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3464":1204,"_30209":1177,"_20922":52998,"_5":14373,"_27447":52926,"_2948":52999},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3464":1205,"_30209":1177,"_20922":53001,"_5":14373,"_27447":52926,"_2948":53002},[],"`webhook mTLS certificate and key are invalid: …`",{"_3464":1206,"_30209":1177,"_20922":53004,"_5":14373,"_27447":52926,"_2948":53005},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3464":1207,"_30209":1177,"_20922":53007,"_5":14373,"_27447":52926,"_2948":53008},[],"400 `struct validation error` creating or updating a DMS",{"_3464":1208,"_30209":1177,"_20922":53010,"_5":14373,"_27447":52926,"_2948":53011},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3464":1209,"_30209":1177,"_20922":53013,"_5":14373,"_27447":52926,"_2948":53014},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3464":1210,"_30209":1177,"_20922":53016,"_5":14373,"_27447":52926,"_2948":53017},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3464":1211,"_30209":1177,"_20922":53019,"_5":14373,"_27447":52926,"_2948":53020},[],"`device not preregistered`",{"_3464":1212,"_30209":1177,"_20922":53022,"_5":14373,"_27447":52926,"_2948":53023},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3464":1213,"_30209":1177,"_20922":53025,"_5":14373,"_27447":52926,"_2948":53026},[],"`forbiddenNewEnrollment`",{"_3464":1214,"_30209":1177,"_20922":53028,"_5":14373,"_27447":52926,"_2948":53029},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3464":1215,"_30209":1177,"_20922":53031,"_5":14373,"_27447":52926,"_2948":53032},[],"Different owning DMS",{"_3464":1216,"_30209":1177,"_20922":53034,"_5":14373,"_27447":52926,"_2948":53035},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3464":1217,"_30209":1177,"_20922":53037,"_5":14373,"_27447":52926,"_2948":53038},[],"`invalid RawSubject bytes`",{"_3464":1218,"_30209":1177,"_20922":53040,"_5":14373,"_27447":52926,"_2948":53041},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3464":1219,"_30209":1177,"_20922":53043,"_5":14373,"_27447":52926,"_2948":53044},[],"`invalid reenroll window`",{"_3464":1220,"_30209":1177,"_20922":53046,"_5":14373,"_27447":52926,"_2948":53047},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3464":1221,"_30209":1177,"_20922":53049,"_5":14373,"_27447":52926,"_2948":53050},[],"Current certificate revoked",{"_3464":1222,"_30209":1177,"_20922":53052,"_5":14373,"_27447":52926,"_2948":53053},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3464":1223,"_30209":1177,"_20922":53055,"_5":14373,"_27447":52926,"_2948":53056},[],"CA, profile or signing error",{"_3464":1224,"_30209":1177,"_20922":53058,"_5":14373,"_27447":52926,"_2948":53059},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3464":1225,"_30209":1177,"_20922":53061,"_5":14373,"_27447":52926,"_2948":53062},[],"HTTP 200 without a device connection",{"_3464":1226,"_30209":1177,"_20922":53064,"_5":14373,"_27447":52926,"_2948":53065},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3464":1227,"_30209":1177,"_20922":53067,"_5":14373,"_27447":52926,"_2948":53068},[],"Timeout or error after issuance",{"_3464":1228,"_30209":1177,"_20922":53070,"_5":14373,"_27447":52926,"_2948":53071},[],"New certificates, current slot and previous identity's state before retrying.",{"_3464":1229,"_30209":1177,"_20922":53073,"_5":14373,"_27447":52930,"_2948":53074},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3464":1230,"_30209":1177,"_20922":53076,"_5":14373,"_27447":52930,"_2948":53077},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3464":1231,"_30209":1177,"_20922":53079,"_5":14373,"_27447":52933,"_2948":53080},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3464":1232,"_30209":1177,"_20922":53082,"_5":14373,"_27447":52933,"_2948":53083},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3464":1233,"_30209":1177,"_20922":53085,"_5":14373,"_27447":52933,"_2948":53086},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3464":1234,"_30209":1177,"_20922":53088,"_5":14373,"_27447":52933,"_2948":53089},[],"Make one request, save headers/body and query the device and certificates.",{"_3464":1235,"_30209":1177,"_20922":53091,"_5":14373,"_27447":52933,"_2948":53092},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3464":1236,"_30209":1177,"_20922":53094,"_5":14373,"_27447":52933,"_2948":53095},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3464":1237,"_30209":1177,"_20922":53097,"_5":14373,"_27447":52933,"_2948":53098},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3464":1238,"_30209":1238,"_5":14725,"_2948":53100,"_30541":53101,"_20922":53102,"_27447":1238},"Trust distribution and updates",[49244,50719,51733,51731,51914],[],{"_3464":1239,"_30209":1238,"_20922":53104,"_5":14373,"_27447":1238,"_2948":53105},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3464":1240,"_30209":1238,"_5":30538,"_20922":53107,"_27447":53108,"_2948":53109},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3464":1241,"_30209":1238,"_5":30538,"_20922":53111,"_27447":53112,"_2948":53113},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3464":1242,"_30209":1238,"_5":30538,"_20922":53115,"_27447":53116,"_2948":53117},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3464":1243,"_30209":1238,"_5":30538,"_20922":53119,"_27447":53120,"_2948":53121},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3464":1244,"_30209":1238,"_5":30538,"_20922":53123,"_27447":53124,"_2948":53125},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3464":1245,"_30209":1238,"_20922":53127,"_5":14373,"_27447":1238,"_2948":53128},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3464":1246,"_30209":1238,"_20922":53130,"_5":14373,"_27447":53108,"_2948":53131},[],"Relationship",{"_3464":1247,"_30209":1238,"_20922":53133,"_5":14373,"_27447":53108,"_2948":53134},[],"Material prepared by its owner",{"_3464":1248,"_30209":1238,"_20922":53136,"_5":14373,"_27447":53108,"_2948":53137},[],"Device → EST server",{"_3464":1249,"_30209":1238,"_20922":53139,"_5":14373,"_27447":53108,"_2948":53140},[],"Previously verified server root, chain or pin and TLS name.",{"_3464":1250,"_30209":1238,"_20922":53142,"_5":14373,"_27447":53108,"_2948":53143},[],"DMS → requester",{"_3464":1251,"_30209":1238,"_20922":53145,"_5":14373,"_27447":53108,"_2948":53146},[],"CAs and rules authorizing initial or renewal credentials.",{"_3464":1252,"_30209":1238,"_20922":53148,"_5":14373,"_27447":53108,"_2948":53149},[],"Consumer → device",{"_3464":1253,"_30209":1238,"_20922":53151,"_5":14373,"_27447":53108,"_2948":53152},[],"Operational identity roots, intermediates, validation and permissions.",{"_3464":1254,"_30209":1238,"_20922":53154,"_5":14373,"_27447":53108,"_2948":53155},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3464":1255,"_30209":1238,"_20922":53157,"_5":14373,"_27447":53112,"_2948":53158},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3464":1256,"_30209":1238,"_20922":53160,"_5":14373,"_27447":53112,"_2948":53161},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3464":1257,"_30209":1238,"_20922":53163,"_5":14373,"_27447":53116,"_2948":53164},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3464":1258,"_30209":1238,"_20922":53166,"_5":14373,"_27447":53116,"_2948":53167},[],"Select policy-approved roots as anchors.",{"_3464":1259,"_30209":1238,"_20922":53169,"_5":14373,"_27447":53116,"_2948":53170},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3464":1260,"_30209":1238,"_20922":53172,"_5":14373,"_27447":53116,"_2948":53173},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3464":1261,"_30209":1238,"_20922":53175,"_5":14373,"_27447":53116,"_2948":53176},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3464":1262,"_30209":1238,"_20922":53178,"_5":14373,"_27447":53116,"_2948":53179},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3464":1263,"_30209":1238,"_20922":53181,"_5":14373,"_27447":53120,"_2948":53182},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3464":1264,"_30209":1238,"_20922":53184,"_5":14373,"_27447":53120,"_2948":53185},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3464":1265,"_30209":1238,"_20922":53187,"_5":14373,"_27447":53120,"_2948":53188},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3464":1266,"_30209":1238,"_20922":53190,"_5":14373,"_27447":53124,"_2948":53191},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3464":1267,"_30209":1267,"_5":14725,"_2948":53193,"_30541":53194,"_20922":53196,"_27447":1267},"AWS IoT Core",[49244,50719,51733,51731,53195],"Integrations",[],{"_3464":1268,"_30209":1267,"_20922":53198,"_5":14373,"_27447":1267,"_2948":53199},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3464":1269,"_30209":1267,"_5":30538,"_20922":53201,"_27447":53202,"_2948":53203},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3464":1270,"_30209":1267,"_5":30538,"_20922":53205,"_27447":53206,"_2948":53207},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3464":1271,"_30209":1267,"_5":30538,"_20922":53209,"_27447":53210,"_2948":53211},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3464":1272,"_30209":1267,"_5":30538,"_20922":53213,"_27447":53214,"_2948":53215},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3464":1273,"_30209":1267,"_5":30538,"_20922":53217,"_27447":53218,"_2948":53219},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3464":1274,"_30209":1267,"_5":30538,"_20922":53221,"_27447":53222,"_2948":53223},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3464":1275,"_30209":1267,"_5":30538,"_20922":53225,"_27447":53226,"_2948":53227},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3464":1276,"_30209":1267,"_5":30538,"_20922":53229,"_27447":53230,"_2948":53231},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3464":1277,"_30209":1267,"_5":30538,"_20922":53233,"_27447":53234,"_2948":53235},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3464":1278,"_30209":1267,"_5":30538,"_20922":53237,"_27447":53238,"_2948":53239},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3464":1279,"_30209":1267,"_5":30538,"_20922":53241,"_27447":53242,"_2948":53243},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3464":1280,"_30209":1267,"_5":30538,"_20922":53245,"_27447":53246,"_2948":53247},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3464":1281,"_30209":1267,"_5":30538,"_20922":53249,"_27447":53250,"_2948":53251},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3464":1282,"_30209":1267,"_5":30538,"_20922":53253,"_27447":53254,"_2948":53255},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3464":1283,"_30209":1267,"_5":30538,"_20922":53257,"_27447":53258,"_2948":53259},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3464":1284,"_30209":1267,"_5":30538,"_20922":53261,"_27447":53262,"_2948":53263},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3464":1285,"_30209":1267,"_5":30538,"_20922":53265,"_27447":53266,"_2948":53267},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3464":1286,"_30209":1267,"_5":30538,"_20922":53269,"_27447":53270,"_2948":53271},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3464":1287,"_30209":1267,"_5":30538,"_20922":53273,"_27447":53274,"_2948":53275},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3464":1288,"_30209":1267,"_5":30538,"_20922":53277,"_27447":53278,"_2948":53279},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3464":1289,"_30209":1267,"_5":30538,"_20922":53281,"_27447":53282,"_2948":53283},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3464":1290,"_30209":1267,"_5":30538,"_20922":53285,"_27447":53286,"_2948":53287},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3464":1291,"_30209":1267,"_5":30538,"_20922":53289,"_27447":53290,"_2948":53291},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3464":1292,"_30209":1267,"_5":30538,"_20922":53293,"_27447":53294,"_2948":53295},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3464":1293,"_30209":1267,"_5":30538,"_20922":53297,"_27447":53298,"_2948":53299},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3464":1294,"_30209":1267,"_20922":53301,"_5":14373,"_27447":1267,"_2948":53302},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3464":1295,"_30209":1267,"_20922":53304,"_5":14373,"_27447":1267,"_2948":53305},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3464":1296,"_30209":1267,"_20922":53307,"_5":14373,"_27447":1267,"_2948":53308},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3464":1297,"_30209":1267,"_20922":53310,"_5":14373,"_27447":53202,"_2948":53311},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3464":1298,"_30209":1267,"_20922":53313,"_5":14373,"_27447":53202,"_2948":53314},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3464":1299,"_30209":1267,"_20922":53316,"_5":14373,"_27447":53202,"_2948":53317},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3464":1300,"_30209":1267,"_20922":53319,"_5":14373,"_27447":53202,"_2948":53320},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3464":1301,"_30209":1267,"_20922":53322,"_5":14373,"_27447":53206,"_2948":53323},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3464":1302,"_30209":1267,"_20922":53325,"_5":14373,"_27447":53210,"_2948":53326},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3464":1303,"_30209":1267,"_20922":53328,"_5":14373,"_27447":53210,"_2948":53329},[],"IAM action",{"_3464":1304,"_30209":1267,"_20922":53331,"_5":14373,"_27447":53210,"_2948":49634},[],{"_3464":1305,"_30209":1267,"_20922":53333,"_5":14373,"_27447":53210,"_2948":53334},[],"`iot:GetRegistrationCode`",{"_3464":1306,"_30209":1267,"_20922":53336,"_5":14373,"_27447":53210,"_2948":53337},[],"Obtain the verification code for CA registration in the Primary Account",{"_3464":1307,"_30209":1267,"_20922":53339,"_5":14373,"_27447":53210,"_2948":53340},[],"`iot:RegisterCACertificate`",{"_3464":1308,"_30209":1267,"_20922":53342,"_5":14373,"_27447":53210,"_2948":53343},[],"Register the CA in AWS IoT",{"_3464":1309,"_30209":1267,"_20922":53345,"_5":14373,"_27447":53210,"_2948":53346},[],"`iot:DescribeCACertificate`",{"_3464":1310,"_30209":1267,"_20922":53348,"_5":14373,"_27447":53210,"_2948":53349},[],"Check the CA registration status",{"_3464":1311,"_30209":1267,"_20922":53351,"_5":14373,"_27447":53210,"_2948":53352},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3464":1312,"_30209":1267,"_20922":53354,"_5":14373,"_27447":53210,"_2948":53355},[],"Create or update Things in IoT Core",{"_3464":1313,"_30209":1267,"_20922":53357,"_5":14373,"_27447":53210,"_2948":53358},[],"`iot:RegisterThing`",{"_3464":1314,"_30209":1267,"_20922":53360,"_5":14373,"_27447":53210,"_2948":53361},[],"Provision Things through a template",{"_3464":1315,"_30209":1267,"_20922":53363,"_5":14373,"_27447":53210,"_2948":53364},[],"`iot:RegisterCertificate`",{"_3464":1316,"_30209":1267,"_20922":53366,"_5":14373,"_27447":53210,"_2948":53367},[],"Register device certificates",{"_3464":1317,"_30209":1267,"_20922":53369,"_5":14373,"_27447":53210,"_2948":53370},[],"`iot:UpdateCertificate`",{"_3464":1318,"_30209":1267,"_20922":53372,"_5":14373,"_27447":53210,"_2948":53373},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3464":1319,"_30209":1267,"_20922":53375,"_5":14373,"_27447":53210,"_2948":53376},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3464":1320,"_30209":1267,"_20922":53378,"_5":14373,"_27447":53210,"_2948":53379},[],"Create and attach IoT policies",{"_3464":1321,"_30209":1267,"_20922":53381,"_5":14373,"_27447":53210,"_2948":53382},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3464":1322,"_30209":1267,"_20922":53384,"_5":14373,"_27447":53210,"_2948":53385},[],"Manage Thing groups",{"_3464":1323,"_30209":1267,"_20922":53387,"_5":14373,"_27447":53210,"_2948":53388},[],"`iot:CreateProvisioningTemplate`",{"_3464":1324,"_30209":1267,"_20922":53390,"_5":14373,"_27447":53210,"_2948":53391},[],"Create JITP templates",{"_3464":1325,"_30209":1267,"_20922":53393,"_5":14373,"_27447":53210,"_2948":53394},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3464":1326,"_30209":1267,"_20922":53396,"_5":14373,"_27447":53210,"_2948":53397},[],"Read and write the Device Shadow",{"_3464":1327,"_30209":1267,"_20922":53399,"_5":14373,"_27447":53210,"_2948":53400},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3464":1328,"_30209":1267,"_20922":53402,"_5":14373,"_27447":53214,"_2948":53403},[],"Parameter",{"_3464":1329,"_30209":1267,"_20922":53405,"_5":14373,"_27447":53214,"_2948":53406},[],"Type",{"_3464":1330,"_30209":1267,"_20922":53408,"_5":14373,"_27447":53214,"_2948":53409},[],"Required",{"_3464":1331,"_30209":1267,"_20922":53411,"_5":14373,"_27447":53214,"_2948":53412},[],"Description",{"_3464":1332,"_30209":1267,"_20922":53414,"_5":14373,"_27447":53214,"_2948":53415},[],"`connector_id`",{"_3464":1333,"_30209":1267,"_20922":53417,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1334,"_30209":1267,"_20922":53419,"_5":14373,"_27447":53214,"_2948":53420},[],"Yes",{"_3464":1335,"_30209":1267,"_20922":53422,"_5":14373,"_27447":53214,"_2948":53423},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3464":1336,"_30209":1267,"_20922":53425,"_5":14373,"_27447":53214,"_2948":53426},[],"`aws_config.region`",{"_3464":1337,"_30209":1267,"_20922":53428,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1338,"_30209":1267,"_20922":53430,"_5":14373,"_27447":53214,"_2948":53420},[],{"_3464":1339,"_30209":1267,"_20922":53432,"_5":14373,"_27447":53214,"_2948":53433},[],"AWS region where the connector operates.",{"_3464":1340,"_30209":1267,"_20922":53435,"_5":14373,"_27447":53214,"_2948":53436},[],"`aws_config.auth_method`",{"_3464":1341,"_30209":1267,"_20922":53438,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1342,"_30209":1267,"_20922":53440,"_5":14373,"_27447":53214,"_2948":53420},[],{"_3464":1343,"_30209":1267,"_20922":53442,"_5":14373,"_27447":53214,"_2948":53443},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3464":1344,"_30209":1267,"_20922":53445,"_5":14373,"_27447":53214,"_2948":53446},[],"`aws_config.access_key_id`",{"_3464":1345,"_30209":1267,"_20922":53448,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1346,"_30209":1267,"_20922":53450,"_5":14373,"_27447":53214,"_2948":53451},[],"Only with `auth_method=static`",{"_3464":1347,"_30209":1267,"_20922":53453,"_5":14373,"_27447":53214,"_2948":53454},[],"AWS access key.",{"_3464":1348,"_30209":1267,"_20922":53456,"_5":14373,"_27447":53214,"_2948":53457},[],"`aws_config.secret_access_key`",{"_3464":1349,"_30209":1267,"_20922":53459,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1350,"_30209":1267,"_20922":53461,"_5":14373,"_27447":53214,"_2948":53451},[],{"_3464":1351,"_30209":1267,"_20922":53463,"_5":14373,"_27447":53214,"_2948":53464},[],"AWS secret key.",{"_3464":1352,"_30209":1267,"_20922":53466,"_5":14373,"_27447":53214,"_2948":53467},[],"`aws_config.session_token`",{"_3464":1353,"_30209":1267,"_20922":53469,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1354,"_30209":1267,"_20922":53471,"_5":14373,"_27447":53214,"_2948":53472},[],"No",{"_3464":1355,"_30209":1267,"_20922":53474,"_5":14373,"_27447":53214,"_2948":53475},[],"Session token (with `auth_method=static`).",{"_3464":1356,"_30209":1267,"_20922":53477,"_5":14373,"_27447":53214,"_2948":53478},[],"`aws_config.role_arn`",{"_3464":1357,"_30209":1267,"_20922":53480,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1358,"_30209":1267,"_20922":53482,"_5":14373,"_27447":53214,"_2948":53483},[],"Only with `auth_method=role`",{"_3464":1359,"_30209":1267,"_20922":53485,"_5":14373,"_27447":53214,"_2948":53486},[],"ARN of the role to assume.",{"_3464":1360,"_30209":1267,"_20922":53488,"_5":14373,"_27447":53214,"_2948":53489},[],"`aws_config.endpoint_url`",{"_3464":1361,"_30209":1267,"_20922":53491,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1362,"_30209":1267,"_20922":53493,"_5":14373,"_27447":53214,"_2948":53472},[],{"_3464":1363,"_30209":1267,"_20922":53495,"_5":14373,"_27447":53214,"_2948":53496},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3464":1364,"_30209":1267,"_20922":53498,"_5":14373,"_27447":53214,"_2948":53499},[],"`subscriber_event_bus`",{"_3464":1365,"_30209":1267,"_20922":53501,"_5":14373,"_27447":53214,"_2948":17611},[],{"_3464":1366,"_30209":1267,"_20922":53503,"_5":14373,"_27447":53214,"_2948":53420},[],{"_3464":1367,"_30209":1267,"_20922":53505,"_5":14373,"_27447":53214,"_2948":53506},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3464":1368,"_30209":1267,"_20922":53508,"_5":14373,"_27447":53214,"_2948":53509},[],"`dms_manager_client`",{"_3464":1369,"_30209":1267,"_20922":53511,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1370,"_30209":1267,"_20922":53513,"_5":14373,"_27447":53214,"_2948":53420},[],{"_3464":1371,"_30209":1267,"_20922":53515,"_5":14373,"_27447":53214,"_2948":53516},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3464":1372,"_30209":1267,"_20922":53518,"_5":14373,"_27447":53214,"_2948":53519},[],"`device_manager_client`",{"_3464":1373,"_30209":1267,"_20922":53521,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1374,"_30209":1267,"_20922":53523,"_5":14373,"_27447":53214,"_2948":53420},[],{"_3464":1375,"_30209":1267,"_20922":53525,"_5":14373,"_27447":53214,"_2948":53526},[],"HTTP URL of Lamassu's Device Manager.",{"_3464":1376,"_30209":1267,"_20922":53528,"_5":14373,"_27447":53214,"_2948":53529},[],"`ca_client`",{"_3464":1377,"_30209":1267,"_20922":53531,"_5":14373,"_27447":53214,"_2948":25016},[],{"_3464":1378,"_30209":1267,"_20922":53533,"_5":14373,"_27447":53214,"_2948":53420},[],{"_3464":1379,"_30209":1267,"_20922":53535,"_5":14373,"_27447":53214,"_2948":53536},[],"HTTP URL of Lamassu's CA service.",{"_3464":1380,"_30209":1267,"_20922":53538,"_5":14373,"_27447":53218,"_2948":53539},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3464":1381,"_30209":1267,"_20922":53541,"_5":14373,"_27447":53218,"_2948":53542},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3464":1382,"_30209":1267,"_20922":53544,"_5":14373,"_27447":53218,"_2948":53545},[],"CloudEvent type",{"_3464":1383,"_30209":1267,"_20922":53547,"_5":14373,"_27447":53218,"_2948":53548},[],"Lamassu resource",{"_3464":1384,"_30209":1267,"_20922":53550,"_5":14373,"_27447":53218,"_2948":53551},[],"AWS Resource",{"_3464":1385,"_30209":1267,"_20922":53553,"_5":14373,"_27447":53218,"_2948":53554},[],"IAM actions",{"_3464":1386,"_30209":1267,"_20922":53556,"_5":14373,"_27447":53218,"_2948":53557},[],"AWS calls and effect",{"_3464":1387,"_30209":1267,"_20922":53559,"_5":14373,"_27447":53218,"_2948":53560},[],"Where in this page",{"_3464":1388,"_30209":1267,"_20922":53562,"_5":14373,"_27447":53218,"_2948":53563},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3464":1389,"_30209":1267,"_20922":53565,"_5":14373,"_27447":53218,"_2948":53566},[],"CA",{"_3464":1390,"_30209":1267,"_20922":53568,"_5":14373,"_27447":53218,"_2948":53569},[],"`IoTCore/CACertificate`",{"_3464":1391,"_30209":1267,"_20922":53571,"_5":14373,"_27447":53218,"_2948":53572},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3464":1392,"_30209":1267,"_20922":53574,"_5":14373,"_27447":53218,"_2948":53575},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3464":1393,"_30209":1267,"_20922":53577,"_5":14373,"_27447":53218,"_2948":53231},[],{"_3464":1394,"_30209":1267,"_20922":53579,"_5":14373,"_27447":53218,"_2948":53580},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3464":1395,"_30209":1267,"_20922":53582,"_5":14373,"_27447":53218,"_2948":53583},[],"DMS",{"_3464":1396,"_30209":1267,"_20922":53585,"_5":14373,"_27447":53218,"_2948":53586},[],"`IoTCore/ProvisioningTemplate`",{"_3464":1397,"_30209":1267,"_20922":53588,"_5":14373,"_27447":53218,"_2948":53589},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3464":1398,"_30209":1267,"_20922":53591,"_5":14373,"_27447":53218,"_2948":53592},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3464":1399,"_30209":1267,"_20922":53594,"_5":14373,"_27447":53218,"_2948":53259},[],{"_3464":1400,"_30209":1267,"_20922":53596,"_5":14373,"_27447":53218,"_2948":53597},[],"`EventBindDeviceIdentityKey`",{"_3464":1401,"_30209":1267,"_20922":53599,"_5":14373,"_27447":53218,"_2948":53600},[],"Device",{"_3464":1402,"_30209":1267,"_20922":53602,"_5":14373,"_27447":53218,"_2948":53603},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3464":1403,"_30209":1267,"_20922":53605,"_5":14373,"_27447":53218,"_2948":53606},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3464":1404,"_30209":1267,"_20922":53608,"_5":14373,"_27447":53218,"_2948":53609},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3464":1405,"_30209":1267,"_20922":53611,"_5":14373,"_27447":53218,"_2948":53267},[],{"_3464":1406,"_30209":1267,"_20922":53613,"_5":14373,"_27447":53218,"_2948":53614},[],"`EventUpdateCertificateStatusKey`",{"_3464":1407,"_30209":1267,"_20922":53616,"_5":14373,"_27447":53218,"_2948":53617},[],"Certificate",{"_3464":1408,"_30209":1267,"_20922":53619,"_5":14373,"_27447":53218,"_2948":53620},[],"`IoTCore/Certificate`",{"_3464":1409,"_30209":1267,"_20922":53622,"_5":14373,"_27447":53218,"_2948":53623},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3464":1410,"_30209":1267,"_20922":53625,"_5":14373,"_27447":53218,"_2948":53626},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3464":1411,"_30209":1267,"_20922":53628,"_5":14373,"_27447":53218,"_2948":53279},[],{"_3464":1412,"_30209":1267,"_20922":53630,"_5":14373,"_27447":53218,"_2948":53631},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3464":1413,"_30209":1267,"_20922":53633,"_5":14373,"_27447":53218,"_2948":53634},[],"Certificate / Device",{"_3464":1414,"_30209":1267,"_20922":53636,"_5":14373,"_27447":53218,"_2948":53637},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3464":1415,"_30209":1267,"_20922":53639,"_5":14373,"_27447":53218,"_2948":49640},[],{"_3464":1416,"_30209":1267,"_20922":53641,"_5":14373,"_27447":53218,"_2948":53642},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3464":1417,"_30209":1267,"_20922":53644,"_5":14373,"_27447":53218,"_2948":53287},[],{"_3464":1418,"_30209":1267,"_20922":53646,"_5":14373,"_27447":53222,"_2948":53647},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3464":1419,"_30209":1267,"_20922":53649,"_5":14373,"_27447":53226,"_2948":53650},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3464":1420,"_30209":1267,"_20922":53652,"_5":14373,"_27447":53226,"_2948":53653},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3464":1421,"_30209":1267,"_20922":53655,"_5":14373,"_27447":53230,"_2948":53656},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3464":1422,"_30209":1267,"_20922":53658,"_5":14373,"_27447":53230,"_2948":53659},[],"Transition",{"_3464":1423,"_30209":1267,"_20922":53661,"_5":14373,"_27447":53230,"_2948":53662},[],"AWS calls",{"_3464":1424,"_30209":1267,"_20922":53664,"_5":14373,"_27447":53230,"_2948":53665},[],"`NotRegistered` → `Requested`",{"_3464":1425,"_30209":1267,"_20922":53667,"_5":14373,"_27447":53230,"_2948":53668},[],"none (metadata write only)",{"_3464":1426,"_30209":1267,"_20922":53670,"_5":14373,"_27447":53230,"_2948":53671},[],"`Requested` → `Registering`",{"_3464":1427,"_30209":1267,"_20922":53673,"_5":14373,"_27447":53230,"_2948":53674},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3464":1428,"_30209":1267,"_20922":53676,"_5":14373,"_27447":53230,"_2948":53677},[],"`Registering` → `Succeeded`",{"_3464":1429,"_30209":1267,"_20922":53679,"_5":14373,"_27447":53230,"_2948":53680},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3464":1430,"_30209":1267,"_20922":53682,"_5":14373,"_27447":53230,"_2948":53683},[],"`Registering` → `Failed`",{"_3464":1431,"_30209":1267,"_20922":53685,"_5":14373,"_27447":53230,"_2948":53686},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3464":1432,"_30209":1267,"_20922":53688,"_5":14373,"_27447":53230,"_2948":53689},[],"`Failed` / `Succeeded` → `Requested`",{"_3464":1433,"_30209":1267,"_20922":53691,"_5":14373,"_27447":53230,"_2948":53692},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3464":1434,"_30209":1267,"_20922":53694,"_5":14373,"_27447":53234,"_2948":53695},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3464":1435,"_30209":1267,"_20922":53697,"_5":14373,"_27447":53234,"_2948":53698},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3464":1436,"_30209":1267,"_20922":53700,"_5":14373,"_27447":53234,"_2948":53701},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3464":1437,"_30209":1267,"_20922":53703,"_5":14373,"_27447":53234,"_2948":53704},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3464":1438,"_30209":1267,"_20922":53706,"_5":14373,"_27447":53234,"_2948":53707},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3464":1439,"_30209":1267,"_20922":53709,"_5":14373,"_27447":53234,"_2948":53710},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3464":1440,"_30209":1267,"_20922":53712,"_5":14373,"_27447":53238,"_2948":53713},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3464":1441,"_30209":1267,"_20922":53715,"_5":14373,"_27447":53242,"_2948":53716},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3464":1442,"_30209":1267,"_20922":53718,"_5":14373,"_27447":53242,"_2948":53719},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3464":1443,"_30209":1267,"_20922":53721,"_5":14373,"_27447":53246,"_2948":53722},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3464":1444,"_30209":1267,"_20922":53724,"_5":14373,"_27447":53250,"_2948":53725},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3464":1445,"_30209":1267,"_20922":53727,"_5":14373,"_27447":53250,"_2948":53728},[],"Creates or updates the IoT policies configured in the DMS.",{"_3464":1446,"_30209":1267,"_20922":53730,"_5":14373,"_27447":53250,"_2948":53731},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3464":1447,"_30209":1267,"_20922":53733,"_5":14373,"_27447":53250,"_2948":53734},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3464":1448,"_30209":1267,"_20922":53736,"_5":14373,"_27447":53250,"_2948":53737},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3464":1449,"_30209":1267,"_20922":53739,"_5":14373,"_27447":53250,"_2948":53740},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3464":1450,"_30209":1267,"_20922":53742,"_5":14373,"_27447":53250,"_2948":53743},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3464":1451,"_30209":1267,"_20922":53745,"_5":14373,"_27447":53254,"_2948":53746},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3464":1452,"_30209":1267,"_20922":53748,"_5":14373,"_27447":53254,"_2948":53749},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3464":1453,"_30209":1267,"_20922":53751,"_5":14373,"_27447":53254,"_2948":53752},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3464":1454,"_30209":1267,"_20922":53754,"_5":14373,"_27447":53254,"_2948":53755},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3464":1455,"_30209":1267,"_20922":53757,"_5":14373,"_27447":53254,"_2948":53758},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3464":1456,"_30209":1267,"_20922":53760,"_5":14373,"_27447":53258,"_2948":53761},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3464":1457,"_30209":1267,"_20922":53763,"_5":14373,"_27447":53258,"_2948":53659},[],{"_3464":1458,"_30209":1267,"_20922":53765,"_5":14373,"_27447":53258,"_2948":53662},[],{"_3464":1459,"_30209":1267,"_20922":53767,"_5":14373,"_27447":53258,"_2948":53768},[],"`Unconfigured` → `None` / `Auto`",{"_3464":1460,"_30209":1267,"_20922":53770,"_5":14373,"_27447":53258,"_2948":53771},[],"none (configuration only)",{"_3464":1461,"_30209":1267,"_20922":53773,"_5":14373,"_27447":53258,"_2948":53774},[],"`None` ↔ `Auto`",{"_3464":1462,"_30209":1267,"_20922":53776,"_5":14373,"_27447":53258,"_2948":53771},[],{"_3464":1463,"_30209":1267,"_20922":53778,"_5":14373,"_27447":53258,"_2948":53779},[],"Any → `Jitp`",{"_3464":1464,"_30209":1267,"_20922":53781,"_5":14373,"_27447":53258,"_2948":53782},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3464":1465,"_30209":1267,"_20922":53784,"_5":14373,"_27447":53258,"_2948":53785},[],"`Jitp` → `None` / `Auto`",{"_3464":1466,"_30209":1267,"_20922":53787,"_5":14373,"_27447":53258,"_2948":53788},[],"none (the template stays in the AWS account)",{"_3464":1467,"_30209":1267,"_20922":53790,"_5":14373,"_27447":53262,"_2948":53791},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3464":1468,"_30209":1267,"_20922":53793,"_5":14373,"_27447":53262,"_2948":53794},[],"The full flow from the device's perspective is:",{"_3464":1469,"_30209":1267,"_20922":53796,"_5":14373,"_27447":53262,"_2948":53797},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3464":1470,"_30209":1267,"_20922":53799,"_5":14373,"_27447":53266,"_2948":53800},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3464":1471,"_30209":1267,"_20922":53802,"_5":14373,"_27447":53266,"_2948":53659},[],{"_3464":1472,"_30209":1267,"_20922":53804,"_5":14373,"_27447":53266,"_2948":53662},[],{"_3464":1473,"_30209":1267,"_20922":53806,"_5":14373,"_27447":53266,"_2948":53807},[],"`Absent` → `Provisioned`",{"_3464":1474,"_30209":1267,"_20922":53809,"_5":14373,"_27447":53266,"_2948":53810},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3464":1475,"_30209":1267,"_20922":53812,"_5":14373,"_27447":53266,"_2948":53813},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3464":1476,"_30209":1267,"_20922":53815,"_5":14373,"_27447":53266,"_2948":53816},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3464":1477,"_30209":1267,"_20922":53818,"_5":14373,"_27447":53266,"_2948":53819},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3464":1478,"_30209":1267,"_20922":53821,"_5":14373,"_27447":53270,"_2948":53822},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3464":1479,"_30209":1267,"_20922":53824,"_5":14373,"_27447":53270,"_2948":53825},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3464":1480,"_30209":1267,"_20922":53827,"_5":14373,"_27447":53270,"_2948":53828},[],"For the JITP flow to work correctly:",{"_3464":1481,"_30209":1267,"_20922":53830,"_5":14373,"_27447":53270,"_2948":53831},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3464":1482,"_30209":1267,"_20922":53833,"_5":14373,"_27447":53270,"_2948":53834},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3464":1483,"_30209":1267,"_20922":53836,"_5":14373,"_27447":53270,"_2948":53837},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3464":1484,"_30209":1267,"_20922":53839,"_5":14373,"_27447":53270,"_2948":53840},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3464":1485,"_30209":1267,"_20922":53842,"_5":14373,"_27447":53274,"_2948":53843},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3464":1486,"_30209":1267,"_20922":53845,"_5":14373,"_27447":53274,"_2948":53846},[],"Status in Lamassu",{"_3464":1487,"_30209":1267,"_20922":53848,"_5":14373,"_27447":53274,"_2948":53849},[],"Revocation reason",{"_3464":1488,"_30209":1267,"_20922":53851,"_5":14373,"_27447":53274,"_2948":53852},[],"Status in AWS IoT Core",{"_3464":1489,"_30209":1267,"_20922":53854,"_5":14373,"_27447":53274,"_2948":53855},[],"`Active`",{"_3464":1490,"_30209":1267,"_20922":53857,"_5":14373,"_27447":53274,"_2948":53858},[],"None",{"_3464":1491,"_30209":1267,"_20922":53860,"_5":14373,"_27447":53274,"_2948":53861},[],"`ACTIVE`",{"_3464":1492,"_30209":1267,"_20922":53863,"_5":14373,"_27447":53274,"_2948":53864},[],"`Revoked`",{"_3464":1493,"_30209":1267,"_20922":53866,"_5":14373,"_27447":53274,"_2948":53867},[],"`certificateHold`",{"_3464":1494,"_30209":1267,"_20922":53869,"_5":14373,"_27447":53274,"_2948":53870},[],"`INACTIVE`",{"_3464":1495,"_30209":1267,"_20922":53872,"_5":14373,"_27447":53274,"_2948":53864},[],{"_3464":1496,"_30209":1267,"_20922":53874,"_5":14373,"_27447":53274,"_2948":53875},[],"Any other reason",{"_3464":1497,"_30209":1267,"_20922":53877,"_5":14373,"_27447":53274,"_2948":53878},[],"`REVOKED`",{"_3464":1498,"_30209":1267,"_20922":53880,"_5":14373,"_27447":53274,"_2948":53881},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3464":1499,"_30209":1267,"_20922":53883,"_5":14373,"_27447":53278,"_2948":53884},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3464":1500,"_30209":1267,"_20922":53886,"_5":14373,"_27447":53278,"_2948":53659},[],{"_3464":1501,"_30209":1267,"_20922":53888,"_5":14373,"_27447":53278,"_2948":53662},[],{"_3464":1502,"_30209":1267,"_20922":53890,"_5":14373,"_27447":53278,"_2948":53891},[],"`NotSynced` → `Active`",{"_3464":1503,"_30209":1267,"_20922":53893,"_5":14373,"_27447":53278,"_2948":53370},[],{"_3464":1504,"_30209":1267,"_20922":53895,"_5":14373,"_27447":53278,"_2948":53896},[],"`Active` → `Inactive`",{"_3464":1505,"_30209":1267,"_20922":53898,"_5":14373,"_27447":53278,"_2948":53899},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3464":1506,"_30209":1267,"_20922":53901,"_5":14373,"_27447":53278,"_2948":53902},[],"`Active` → `Revoked`",{"_3464":1507,"_30209":1267,"_20922":53904,"_5":14373,"_27447":53278,"_2948":53899},[],{"_3464":1508,"_30209":1267,"_20922":53906,"_5":14373,"_27447":53278,"_2948":53907},[],"`Inactive` / `Revoked` → `Active`",{"_3464":1509,"_30209":1267,"_20922":53909,"_5":14373,"_27447":53278,"_2948":53370},[],{"_3464":1510,"_30209":1267,"_20922":53911,"_5":14373,"_27447":53278,"_2948":53912},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3464":1511,"_30209":1267,"_20922":53914,"_5":14373,"_27447":53278,"_2948":53915},[],"none (these states are not synced to AWS)",{"_3464":1512,"_30209":1267,"_20922":53917,"_5":14373,"_27447":53282,"_2948":53918},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3464":1513,"_30209":1267,"_20922":53920,"_5":14373,"_27447":53282,"_2948":53921},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3464":1514,"_30209":1267,"_20922":53923,"_5":14373,"_27447":53282,"_2948":53924},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3464":1515,"_30209":1267,"_20922":53926,"_5":14373,"_27447":53286,"_2948":53927},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3464":1516,"_30209":1267,"_20922":53929,"_5":14373,"_27447":53286,"_2948":53930},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3464":1517,"_30209":1267,"_20922":53932,"_5":14373,"_27447":53290,"_2948":53933},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3464":1518,"_30209":1267,"_20922":53935,"_5":14373,"_27447":53290,"_2948":53936},[],"There are two action types:",{"_3464":1519,"_30209":1267,"_20922":53938,"_5":14373,"_27447":53290,"_2948":53939},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3464":1520,"_30209":1267,"_20922":53941,"_5":14373,"_27447":53290,"_2948":53942},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3464":1521,"_30209":1267,"_20922":53944,"_5":14373,"_27447":53290,"_2948":53945},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3464":1522,"_30209":1267,"_20922":53947,"_5":14373,"_27447":53294,"_2948":53948},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3464":1523,"_30209":1267,"_20922":53950,"_5":14373,"_27447":53294,"_2948":53951},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3464":1524,"_30209":1267,"_20922":53953,"_5":14373,"_27447":53294,"_2948":53954},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3464":1525,"_30209":1267,"_20922":53956,"_5":14373,"_27447":53298,"_2948":53957},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3464":1526,"_30209":1267,"_20922":53959,"_5":14373,"_27447":53298,"_2948":53960},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3464":1527,"_30209":1267,"_20922":53962,"_5":14373,"_27447":53298,"_2948":53963},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3464":1528,"_30209":1267,"_20922":53965,"_5":14373,"_27447":53298,"_2948":53966},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3464":1529,"_30209":1267,"_20922":53968,"_5":14373,"_27447":53298,"_2948":53969},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3464":1530,"_30209":1267,"_20922":53971,"_5":14373,"_27447":53298,"_2948":53972},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3464":1531,"_30209":1267,"_20922":53974,"_5":14373,"_27447":53298,"_2948":53975},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3464":1532,"_30209":1267,"_20922":53977,"_5":14373,"_27447":53298,"_2948":53978},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3464":1533,"_30209":1267,"_20922":53980,"_5":14373,"_27447":53298,"_2948":53981},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3464":1534,"_30209":1267,"_20922":53983,"_5":14373,"_27447":53298,"_2948":53984},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3464":1535,"_30209":1267,"_20922":53986,"_5":14373,"_27447":53298,"_2948":53987},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3464":1536,"_30209":1267,"_20922":53989,"_5":14373,"_27447":53298,"_2948":53990},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3464":1537,"_30209":1267,"_20922":53992,"_5":14373,"_27447":53298,"_2948":53993},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3464":1538,"_30209":1267,"_20922":53995,"_5":14373,"_27447":53298,"_2948":53996},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3464":1539,"_30209":1267,"_20922":53998,"_5":14373,"_27447":53298,"_2948":53999},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3464":1540,"_30209":1267,"_20922":54001,"_5":14373,"_27447":53298,"_2948":54002},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3464":1541,"_30209":1267,"_20922":54004,"_5":14373,"_27447":53298,"_2948":54005},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3464":1542,"_30209":1267,"_20922":54007,"_5":14373,"_27447":53298,"_2948":54008},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3464":1543,"_30209":1267,"_20922":54010,"_5":14373,"_27447":53298,"_2948":54011},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3464":1544,"_30209":1267,"_20922":54013,"_5":14373,"_27447":53298,"_2948":54014},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3464":1545,"_30209":1267,"_20922":54016,"_5":14373,"_27447":53298,"_2948":54017},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3464":1546,"_30209":1267,"_20922":54019,"_5":14373,"_27447":53298,"_2948":54020},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":1547,"_30209":1267,"_20922":54022,"_5":14373,"_27447":53298,"_2948":54023},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3464":1548,"_30209":1267,"_20922":54025,"_5":14373,"_27447":53298,"_2948":54026},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3464":1549,"_30209":1549,"_5":14725,"_2948":51733,"_30541":54028,"_20922":54029,"_27447":1549},[49244,50719,51733],[],{"_3464":1550,"_30209":1549,"_20922":54031,"_5":14373,"_27447":1549,"_2948":54032},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3464":1551,"_30209":1549,"_5":30538,"_20922":54034,"_27447":54035,"_2948":54036},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3464":1552,"_30209":1549,"_5":30538,"_20922":54038,"_27447":54039,"_2948":51731},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3464":1553,"_30209":1549,"_5":30538,"_20922":54041,"_27447":54042,"_2948":51914},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3464":1554,"_30209":1549,"_5":30538,"_20922":54044,"_27447":54045,"_2948":53195},[],"/docs/platform/iot-fleets/overview#integrations",{"_3464":1555,"_30209":1549,"_5":30538,"_20922":54047,"_27447":54048,"_2948":54049},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3464":1556,"_30209":1549,"_20922":54051,"_5":14373,"_27447":1549,"_2948":54052},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3464":1557,"_30209":1549,"_20922":54054,"_5":14373,"_27447":54035,"_2948":54055},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3464":1558,"_30209":1549,"_20922":54057,"_5":14373,"_27447":54035,"_2948":54058},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3464":1559,"_30209":1549,"_20922":54060,"_5":14373,"_27447":54039,"_2948":54061},[],"Resource",{"_3464":1560,"_30209":1549,"_20922":54063,"_5":14373,"_27447":54039,"_2948":54064},[],"What it represents",{"_3464":1561,"_30209":1549,"_20922":54066,"_5":14373,"_27447":54039,"_2948":54067},[],"**Device**",{"_3464":1562,"_30209":1549,"_20922":54069,"_5":14373,"_27447":54039,"_2948":54070},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3464":1563,"_30209":1549,"_20922":54072,"_5":14373,"_27447":54039,"_2948":54073},[],"**Identity**",{"_3464":1564,"_30209":1549,"_20922":54075,"_5":14373,"_27447":54039,"_2948":54076},[],"The device's association with its certificates: an active version and a history.",{"_3464":1565,"_30209":1549,"_20922":54078,"_5":14373,"_27447":54039,"_2948":54079},[],"**DMS**",{"_3464":1566,"_30209":1549,"_20922":54081,"_5":14373,"_27447":54039,"_2948":54082},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3464":1567,"_30209":1549,"_20922":54084,"_5":14373,"_27447":54039,"_2948":54085},[],"**Fleet**",{"_3464":1568,"_30209":1549,"_20922":54087,"_5":14373,"_27447":54039,"_2948":54088},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3464":1569,"_30209":1549,"_20922":54090,"_5":14373,"_27447":54039,"_2948":54091},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3464":1570,"_30209":1549,"_20922":54093,"_5":14373,"_27447":54039,"_2948":54094},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3464":1571,"_30209":1549,"_20922":54096,"_5":14373,"_27447":54042,"_2948":54097},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3464":1572,"_30209":1549,"_20922":54099,"_5":14373,"_27447":54042,"_2948":54100},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3464":1573,"_30209":1549,"_20922":54102,"_5":14373,"_27447":54042,"_2948":54103},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3464":1574,"_30209":1549,"_20922":54105,"_5":14373,"_27447":54042,"_2948":54106},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3464":1575,"_30209":1549,"_20922":54108,"_5":14373,"_27447":54042,"_2948":54109},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3464":1576,"_30209":1549,"_20922":54111,"_5":14373,"_27447":54042,"_2948":54112},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3464":1577,"_30209":1549,"_20922":54114,"_5":14373,"_27447":54042,"_2948":54115},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":1578,"_30209":1549,"_20922":54117,"_5":14373,"_27447":54042,"_2948":54118},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":1579,"_30209":1549,"_20922":54120,"_5":14373,"_27447":54045,"_2948":54121},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3464":1580,"_30209":1549,"_20922":54123,"_5":14373,"_27447":54045,"_2948":54124},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3464":1581,"_30209":1549,"_20922":54126,"_5":14373,"_27447":54048,"_2948":54127},[],"Participant",{"_3464":1582,"_30209":1549,"_20922":54129,"_5":14373,"_27447":54048,"_2948":54130},[],"Responsibility",{"_3464":1583,"_30209":1549,"_20922":54132,"_5":14373,"_27447":54048,"_2948":54133},[],"PKI administrator",{"_3464":1584,"_30209":1549,"_20922":54135,"_5":14373,"_27447":54048,"_2948":54136},[],"CA, issuance profile, chain and revocation publication.",{"_3464":1585,"_30209":1549,"_20922":54138,"_5":14373,"_27447":54048,"_2948":54139},[],"Provisioning administrator",{"_3464":1586,"_30209":1549,"_20922":54141,"_5":14373,"_27447":54048,"_2948":54142},[],"DMS, admission, authentication per operation and inventory.",{"_3464":1587,"_30209":1549,"_20922":54144,"_5":14373,"_27447":54048,"_2948":54145},[],"Device integrator",{"_3464":1588,"_30209":1549,"_20922":54147,"_5":14373,"_27447":54048,"_2948":54148},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3464":1589,"_30209":1549,"_20922":54150,"_5":14373,"_27447":54048,"_2948":54151},[],"Consumer integrator",{"_3464":1590,"_30209":1549,"_20922":54153,"_5":14373,"_27447":54048,"_2948":54154},[],"Trusted issuers, validation and device permissions in the destination.",{"_3464":1591,"_30209":1549,"_20922":54156,"_5":14373,"_27447":54048,"_2948":54157},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3464":1592,"_30209":1592,"_5":14725,"_2948":54159,"_30541":54160,"_20922":54162,"_27447":1592},"Enroll and connect your first device",[49244,50719,51733,54161],"Getting started",[],{"_3464":1593,"_30209":1592,"_20922":54164,"_5":14373,"_27447":1592,"_2948":54165},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3464":1594,"_30209":1592,"_5":30538,"_20922":54167,"_27447":54168,"_2948":49254},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3464":1595,"_30209":1592,"_5":30538,"_20922":54170,"_27447":54171,"_2948":54172},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3464":1596,"_30209":1592,"_5":30538,"_20922":54174,"_27447":54175,"_2948":54176},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3464":1597,"_30209":1592,"_5":30538,"_20922":54178,"_27447":54179,"_2948":54180},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3464":1598,"_30209":1592,"_5":30538,"_20922":54182,"_27447":54183,"_2948":54184},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3464":1599,"_30209":1592,"_5":30538,"_20922":54186,"_27447":54187,"_2948":54188},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3464":1600,"_30209":1592,"_5":30538,"_20922":54190,"_27447":54191,"_2948":54192},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3464":1601,"_30209":1592,"_5":30538,"_20922":54194,"_27447":54195,"_2948":54196},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3464":1602,"_30209":1592,"_20922":54198,"_5":14373,"_27447":1592,"_2948":54199},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3464":1603,"_30209":1592,"_20922":54201,"_5":14373,"_27447":54168,"_2948":54202},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3464":1604,"_30209":1592,"_20922":54204,"_5":14373,"_27447":54168,"_2948":54205},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3464":1605,"_30209":1592,"_20922":54207,"_5":14373,"_27447":54168,"_2948":54208},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3464":1606,"_30209":1592,"_20922":54210,"_5":14373,"_27447":54168,"_2948":54211},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3464":1607,"_30209":1592,"_20922":54213,"_5":14373,"_27447":54168,"_2948":54214},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3464":1608,"_30209":1592,"_20922":54216,"_5":14373,"_27447":54171,"_2948":54217},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3464":1609,"_30209":1592,"_20922":54219,"_5":14373,"_27447":54171,"_2948":54220},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3464":1610,"_30209":1592,"_20922":54222,"_5":14373,"_27447":54175,"_2948":54223},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3464":1611,"_30209":1592,"_20922":54225,"_5":14373,"_27447":54175,"_2948":54226},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3464":1612,"_30209":1592,"_20922":54228,"_5":14373,"_27447":54175,"_2948":54229},[],"Setting",{"_3464":1613,"_30209":1592,"_20922":54231,"_5":14373,"_27447":54175,"_2948":54232},[],"Evaluation value",{"_3464":1614,"_30209":1592,"_20922":54234,"_5":14373,"_27447":54175,"_2948":54235},[],"Enrollment CA",{"_3464":1615,"_30209":1592,"_20922":54237,"_5":14373,"_27447":54175,"_2948":54238},[],"Issuing root from `device-root.pem`.",{"_3464":1616,"_30209":1592,"_20922":54240,"_5":14373,"_27447":54175,"_2948":52044},[],{"_3464":1617,"_30209":1592,"_20922":54242,"_5":14373,"_27447":54175,"_2948":54243},[],"The 1-hour leaf profile you just prepared.",{"_3464":1618,"_30209":1592,"_20922":54245,"_5":14373,"_27447":54175,"_2948":54246},[],"Protocol / Registration Mode",{"_3464":1619,"_30209":1592,"_20922":54248,"_5":14373,"_27447":54175,"_2948":54249},[],"`EST_RFC7030` / `JITP`.",{"_3464":1620,"_30209":1592,"_20922":54251,"_5":14373,"_27447":54175,"_2948":54252},[],"Verify CSR Signature",{"_3464":1621,"_30209":1592,"_20922":54254,"_5":14373,"_27447":54175,"_2948":54255},[],"Enabled.",{"_3464":1622,"_30209":1592,"_20922":54257,"_5":14373,"_27447":54175,"_2948":54258},[],"Enable Replaceable Enrollment",{"_3464":1623,"_30209":1592,"_20922":54260,"_5":14373,"_27447":54175,"_2948":54261},[],"Disabled; the ID must be new.",{"_3464":1624,"_30209":1592,"_20922":54263,"_5":14373,"_27447":54175,"_2948":54264},[],"Initial authentication",{"_3464":1625,"_30209":1592,"_20922":54266,"_5":14373,"_27447":54175,"_2948":54267},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3464":1626,"_30209":1592,"_20922":54269,"_5":14373,"_27447":54175,"_2948":54270},[],"Renewal authentication",{"_3464":1627,"_30209":1592,"_20922":54272,"_5":14373,"_27447":54175,"_2948":54273},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3464":1628,"_30209":1592,"_20922":54275,"_5":14373,"_27447":54175,"_2948":54276},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3464":1629,"_30209":1592,"_20922":54278,"_5":14373,"_27447":54175,"_2948":54279},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3464":1630,"_30209":1592,"_20922":54281,"_5":14373,"_27447":54175,"_2948":54282},[],"Re-enrollment Delta",{"_3464":1631,"_30209":1592,"_20922":54284,"_5":14373,"_27447":54175,"_2948":54285},[],"1 hour.",{"_3464":1632,"_30209":1592,"_20922":54287,"_5":14373,"_27447":54175,"_2948":54288},[],"Preventive / Critical Delta",{"_3464":1633,"_30209":1592,"_20922":54290,"_5":14373,"_27447":54175,"_2948":54291},[],"30 minutes / 10 minutes.",{"_3464":1634,"_30209":1592,"_20922":54293,"_5":14373,"_27447":54175,"_2948":54294},[],"Revoke on Re-enrollment",{"_3464":1635,"_30209":1592,"_20922":54296,"_5":14373,"_27447":54175,"_2948":54297},[],"Disabled to test the successor before retiring the previous identity.",{"_3464":1636,"_30209":1592,"_20922":54299,"_5":14373,"_27447":54175,"_2948":52052},[],{"_3464":1637,"_30209":1592,"_20922":54301,"_5":14373,"_27447":54175,"_2948":54302},[],"Disabled; the operational key is generated in the client.",{"_3464":1638,"_30209":1592,"_20922":54304,"_5":14373,"_27447":54175,"_2948":54305},[],"CA Distribution",{"_3464":1639,"_30209":1592,"_20922":54307,"_5":14373,"_27447":54175,"_2948":54308},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3464":1640,"_30209":1592,"_20922":54310,"_5":14373,"_27447":54175,"_2948":54311},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3464":1641,"_30209":1592,"_20922":54313,"_5":14373,"_27447":54179,"_2948":54314},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3464":1642,"_30209":1592,"_20922":54316,"_5":14373,"_27447":54179,"_2948":54317},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3464":1643,"_30209":1592,"_20922":54319,"_5":14373,"_27447":54183,"_2948":54320},[],"Generate a new key and CSR with the selected identifier:",{"_3464":1644,"_30209":1592,"_20922":54322,"_5":14373,"_27447":54183,"_2948":54323},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3464":1645,"_30209":1592,"_20922":54325,"_5":14373,"_27447":54183,"_2948":54326},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3464":1646,"_30209":1592,"_20922":54328,"_5":14373,"_27447":54187,"_2948":54329},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3464":1647,"_30209":1592,"_20922":54331,"_5":14373,"_27447":54187,"_2948":54332},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3464":1648,"_30209":1592,"_20922":54334,"_5":14373,"_27447":54191,"_2948":54335},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3464":1649,"_30209":1592,"_20922":54337,"_5":14373,"_27447":54191,"_2948":54338},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3464":1650,"_30209":1592,"_20922":54340,"_5":14373,"_27447":54191,"_2948":54341},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3464":1651,"_30209":1592,"_20922":54343,"_5":14373,"_27447":54191,"_2948":54344},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3464":1652,"_30209":1592,"_20922":54346,"_5":14373,"_27447":54191,"_2948":54347},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3464":1653,"_30209":1592,"_20922":54349,"_5":14373,"_27447":54195,"_2948":54350},[],"Check",{"_3464":1654,"_30209":1592,"_20922":54352,"_5":14373,"_27447":54195,"_2948":54353},[],"Expected result",{"_3464":1655,"_30209":1592,"_20922":54355,"_5":14373,"_27447":54195,"_2948":54356},[],"Registration",{"_3464":1656,"_30209":1592,"_20922":54358,"_5":14373,"_27447":54195,"_2948":54359},[],"ID created automatically and correct DMS.",{"_3464":1657,"_30209":1592,"_20922":54361,"_5":14373,"_27447":54195,"_2948":53617},[],{"_3464":1658,"_30209":1592,"_20922":54363,"_5":14373,"_27447":54195,"_2948":54364},[],"CN, profile, serial and key verified.",{"_3464":1659,"_30209":1592,"_20922":54366,"_5":14373,"_27447":54195,"_2948":54367},[],"Inventory",{"_3464":1660,"_30209":1592,"_20922":54369,"_5":14373,"_27447":54195,"_2948":54370},[],"Received serial visible as the current identity and in history.",{"_3464":1661,"_30209":1592,"_20922":54372,"_5":14373,"_27447":54195,"_2948":54373},[],"Consumer",{"_3464":1662,"_30209":1592,"_20922":54375,"_5":14373,"_27447":54195,"_2948":54376},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3464":1663,"_30209":1592,"_20922":54378,"_5":14373,"_27447":54195,"_2948":54379},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3464":1664,"_30209":1592,"_20922":54381,"_5":14373,"_27447":54195,"_2948":54382},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3464":1665,"_30209":1665,"_5":14725,"_2948":51749,"_30541":54384,"_20922":54385,"_27447":1665},[49244,50719,51733,54161],[],{"_3464":1666,"_30209":1665,"_20922":54387,"_5":14373,"_27447":1665,"_2948":54388},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3464":1667,"_30209":1665,"_5":30538,"_20922":54390,"_27447":54391,"_2948":49254},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3464":1668,"_30209":1665,"_5":30538,"_20922":54393,"_27447":54394,"_2948":54395},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3464":1669,"_30209":1665,"_5":30538,"_20922":54397,"_27447":54398,"_2948":54399},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3464":1670,"_30209":1665,"_5":30538,"_20922":54401,"_27447":54402,"_2948":54403},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3464":1671,"_30209":1665,"_5":30538,"_20922":54405,"_27447":54406,"_2948":54407},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3464":1672,"_30209":1665,"_5":30538,"_20922":54409,"_27447":54410,"_2948":54411},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3464":1673,"_30209":1665,"_5":30538,"_20922":54413,"_27447":54414,"_2948":54353},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3464":1674,"_30209":1665,"_5":30538,"_20922":54416,"_27447":54417,"_2948":54418},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3464":1675,"_30209":1665,"_5":30538,"_20922":54420,"_27447":54421,"_2948":54422},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3464":1676,"_30209":1665,"_20922":54424,"_5":14373,"_27447":1665,"_2948":54425},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3464":1677,"_30209":1665,"_20922":54427,"_5":14373,"_27447":1665,"_2948":54428},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3464":1678,"_30209":1665,"_20922":54430,"_5":14373,"_27447":54391,"_2948":54431},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3464":1679,"_30209":1665,"_20922":54433,"_5":14373,"_27447":54391,"_2948":54434},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3464":1680,"_30209":1665,"_20922":54436,"_5":14373,"_27447":54391,"_2948":54437},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3464":1681,"_30209":1665,"_20922":54439,"_5":14373,"_27447":54391,"_2948":54440},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3464":1682,"_30209":1665,"_20922":54442,"_5":14373,"_27447":54394,"_2948":54443},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3464":1683,"_30209":1665,"_20922":54445,"_5":14373,"_27447":54394,"_2948":54446},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3464":1684,"_30209":1665,"_20922":54448,"_5":14373,"_27447":54394,"_2948":54449},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3464":1685,"_30209":1665,"_20922":54451,"_5":14373,"_27447":54394,"_2948":54452},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3464":1686,"_30209":1665,"_20922":54454,"_5":14373,"_27447":54394,"_2948":54455},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3464":1687,"_30209":1665,"_20922":54457,"_5":14373,"_27447":54394,"_2948":54458},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3464":1688,"_30209":1665,"_20922":54460,"_5":14373,"_27447":54394,"_2948":54461},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3464":1689,"_30209":1665,"_20922":54463,"_5":14373,"_27447":54394,"_2948":54464},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3464":1690,"_30209":1665,"_20922":54466,"_5":14373,"_27447":54398,"_2948":54467},[],"Open **Managed Devices** and the registration action. Complete:",{"_3464":1691,"_30209":1665,"_20922":54469,"_5":14373,"_27447":54398,"_2948":54470},[],"**Device ID**: `device-001`.",{"_3464":1692,"_30209":1665,"_20922":54472,"_5":14373,"_27447":54398,"_2948":54473},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3464":1693,"_30209":1665,"_20922":54475,"_5":14373,"_27447":54398,"_2948":54476},[],"**Icon** and **Tags**: optional classification.",{"_3464":1694,"_30209":1665,"_20922":54478,"_5":14373,"_27447":54398,"_2948":54479},[],"Confirm registration.",{"_3464":1695,"_30209":1665,"_20922":54481,"_5":14373,"_27447":54402,"_2948":54482},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3464":1696,"_30209":1665,"_20922":54484,"_5":14373,"_27447":54402,"_2948":54485},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3464":1697,"_30209":1665,"_20922":54487,"_5":14373,"_27447":54406,"_2948":54488},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3464":1698,"_30209":1665,"_20922":54490,"_5":14373,"_27447":54406,"_2948":54491},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3464":1699,"_30209":1665,"_20922":54493,"_5":14373,"_27447":54410,"_2948":54494},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3464":1700,"_30209":1665,"_20922":54496,"_5":14373,"_27447":54410,"_2948":54497},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3464":1701,"_30209":1665,"_20922":54499,"_5":14373,"_27447":54414,"_2948":54350},[],{"_3464":1702,"_30209":1665,"_20922":54501,"_5":14373,"_27447":54414,"_2948":54502},[],"Result",{"_3464":1703,"_30209":1665,"_20922":54504,"_5":14373,"_27447":54414,"_2948":53600},[],{"_3464":1704,"_30209":1665,"_20922":54506,"_5":14373,"_27447":54414,"_2948":54507},[],"`device-001` appears in inventory with the expected DMS.",{"_3464":1705,"_30209":1665,"_20922":54509,"_5":14373,"_27447":54414,"_2948":54510},[],"Current identity",{"_3464":1706,"_30209":1665,"_20922":54512,"_5":14373,"_27447":54414,"_2948":54513},[],"The associated certificate matches the one you verified in PKI.",{"_3464":1707,"_30209":1665,"_20922":54515,"_5":14373,"_27447":54414,"_2948":54516},[],"History",{"_3464":1708,"_30209":1665,"_20922":54518,"_5":14373,"_27447":54414,"_2948":54519},[],"The associated issuance appears with its serial number and dates.",{"_3464":1709,"_30209":1665,"_20922":54521,"_5":14373,"_27447":54414,"_2948":54522},[],"Key and certificate",{"_3464":1710,"_30209":1665,"_20922":54524,"_5":14373,"_27447":54414,"_2948":54525},[],"You have the verified pair ready to install on the device.",{"_3464":1711,"_30209":1665,"_20922":54527,"_5":14373,"_27447":54417,"_2948":54528},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3464":1712,"_30209":1665,"_20922":54530,"_5":14373,"_27447":54417,"_2948":54531},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3464":1713,"_30209":1665,"_20922":54533,"_5":14373,"_27447":54417,"_2948":54534},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3464":1714,"_30209":1665,"_20922":54536,"_5":14373,"_27447":54417,"_2948":54537},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3464":1715,"_30209":1665,"_20922":54539,"_5":14373,"_27447":54421,"_2948":54540},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3464":1716,"_30209":1665,"_20922":54542,"_5":14373,"_27447":54421,"_2948":54543},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3464":1717,"_30209":1665,"_20922":54545,"_5":14373,"_27447":54421,"_2948":54546},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3464":1718,"_30209":1718,"_5":14725,"_2948":54548,"_30541":54549,"_20922":54550,"_27447":1718},"Lamassu IoT Platform",[49244,50719],[],{"_3464":1719,"_30209":1718,"_20922":54552,"_5":14373,"_27447":1718,"_2948":54553},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3464":1720,"_30209":1718,"_5":30538,"_20922":54555,"_27447":54556,"_2948":54036},[],"/docs/platform/overview#start-here",{"_3464":1721,"_30209":1718,"_5":30538,"_20922":54558,"_27447":54559,"_2948":54560},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3464":1722,"_30209":1718,"_5":30538,"_20922":54562,"_27447":54563,"_2948":54564},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3464":1723,"_30209":1718,"_5":30538,"_20922":54566,"_27447":54567,"_2948":54568},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3464":1724,"_30209":1718,"_5":30538,"_20922":54570,"_27447":54571,"_2948":54572},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3464":1725,"_30209":1718,"_5":30538,"_20922":54574,"_27447":54575,"_2948":54576},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3464":1726,"_30209":1718,"_5":30538,"_20922":54578,"_27447":54579,"_2948":54580},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3464":1727,"_30209":1718,"_5":30538,"_20922":54582,"_27447":54583,"_2948":54584},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3464":1728,"_30209":1718,"_5":30538,"_20922":54586,"_27447":54587,"_2948":54588},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3464":1729,"_30209":1718,"_5":30538,"_20922":54590,"_27447":54591,"_2948":54592},[],"/docs/platform/overview#react-to-events","React to events",{"_3464":1730,"_30209":1718,"_5":30538,"_20922":54594,"_27447":54595,"_2948":54596},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3464":1731,"_30209":1718,"_20922":54598,"_5":14373,"_27447":1718,"_2948":54599},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3464":1732,"_30209":1718,"_20922":54601,"_5":14373,"_27447":54556,"_2948":54602},[],"Choose the result you need:",{"_3464":1733,"_30209":1718,"_20922":54604,"_5":14373,"_27447":54556,"_2948":54605},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":1734,"_30209":1718,"_20922":54607,"_5":14373,"_27447":54556,"_2948":54608},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":1735,"_30209":1718,"_20922":54610,"_5":14373,"_27447":54556,"_2948":54611},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3464":1736,"_30209":1718,"_20922":54613,"_5":14373,"_27447":54559,"_2948":54614},[],"Section",{"_3464":1737,"_30209":1718,"_20922":54616,"_5":14373,"_27447":54559,"_2948":54617},[],"What you manage",{"_3464":1738,"_30209":1718,"_20922":54619,"_5":14373,"_27447":54559,"_2948":54620},[],"Entry point",{"_3464":1739,"_30209":1718,"_20922":54622,"_5":14373,"_27447":54559,"_2948":54623},[],"**PKI**",{"_3464":1740,"_30209":1718,"_20922":54625,"_5":14373,"_27447":54559,"_2948":54626},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3464":1741,"_30209":1718,"_20922":54628,"_5":14373,"_27447":54559,"_2948":54629},[],"PKI overview",{"_3464":1742,"_30209":1718,"_20922":54631,"_5":14373,"_27447":54559,"_2948":54632},[],"**IoT Fleets**",{"_3464":1743,"_30209":1718,"_20922":54634,"_5":14373,"_27447":54559,"_2948":54635},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3464":1744,"_30209":1718,"_20922":54637,"_5":14373,"_27447":54559,"_2948":54638},[],"IoT Fleets overview",{"_3464":1745,"_30209":1718,"_20922":54640,"_5":14373,"_27447":54559,"_2948":54641},[],"**Administration**",{"_3464":1746,"_30209":1718,"_20922":54643,"_5":14373,"_27447":54559,"_2948":54644},[],"Operator permissions, audit and event subscriptions.",{"_3464":1747,"_30209":1718,"_20922":54646,"_5":14373,"_27447":54559,"_2948":50717},[],{"_3464":1748,"_30209":1718,"_20922":54648,"_5":14373,"_27447":54559,"_2948":54649},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3464":1749,"_30209":1718,"_20922":54651,"_5":14373,"_27447":54563,"_2948":54652},[],"An identity's journey connects four responsibilities:",{"_3464":1750,"_30209":1718,"_20922":54654,"_5":14373,"_27447":54563,"_2948":54655},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3464":1751,"_30209":1718,"_20922":54657,"_5":14373,"_27447":54563,"_2948":54658},[],"The provisioning administrator configures the DMS and initial trust.",{"_3464":1752,"_30209":1718,"_20922":54660,"_5":14373,"_27447":54563,"_2948":54661},[],"The device client requests a certificate and installs it with the matching key.",{"_3464":1753,"_30209":1718,"_20922":54663,"_5":14373,"_27447":54563,"_2948":54664},[],"The consumer validates the identity and applies its access permissions.",{"_3464":1754,"_30209":1718,"_20922":54666,"_5":14373,"_27447":54563,"_2948":54667},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3464":1755,"_30209":1718,"_20922":54669,"_5":14373,"_27447":54571,"_2948":54670},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3464":1756,"_30209":1718,"_20922":54672,"_5":14373,"_27447":54575,"_2948":54673},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3464":1757,"_30209":1718,"_20922":54675,"_5":14373,"_27447":54579,"_2948":54676},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3464":1758,"_30209":1718,"_20922":54678,"_5":14373,"_27447":54583,"_2948":54679},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3464":1759,"_30209":1718,"_20922":54681,"_5":14373,"_27447":54587,"_2948":54682},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3464":1760,"_30209":1718,"_20922":54684,"_5":14373,"_27447":54591,"_2948":54685},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3464":1761,"_30209":1718,"_20922":54687,"_5":14373,"_27447":54595,"_2948":54130},[],{"_3464":1762,"_30209":1718,"_20922":54689,"_5":14373,"_27447":54595,"_2948":54690},[],"What it prepares or checks",{"_3464":1763,"_30209":1718,"_20922":54692,"_5":14373,"_27447":54595,"_2948":54133},[],{"_3464":1764,"_30209":1718,"_20922":54694,"_5":14373,"_27447":54595,"_2948":54695},[],"Key custody, CA hierarchy, profiles and validation.",{"_3464":1765,"_30209":1718,"_20922":54697,"_5":14373,"_27447":54595,"_2948":54698},[],"Fleet administrator",{"_3464":1766,"_30209":1718,"_20922":54700,"_5":14373,"_27447":54595,"_2948":54701},[],"DMS, device admission, renewal policy and inventory.",{"_3464":1767,"_30209":1718,"_20922":54703,"_5":14373,"_27447":54595,"_2948":54145},[],{"_3464":1768,"_30209":1718,"_20922":54705,"_5":14373,"_27447":54595,"_2948":54706},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3464":1769,"_30209":1718,"_20922":54708,"_5":14373,"_27447":54595,"_2948":54151},[],{"_3464":1770,"_30209":1718,"_20922":54710,"_5":14373,"_27447":54595,"_2948":54711},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3464":1771,"_30209":1718,"_20922":54713,"_5":14373,"_27447":54595,"_2948":54714},[],"Infrastructure operator",{"_3464":1772,"_30209":1718,"_20922":54716,"_5":14373,"_27447":54595,"_2948":54717},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3464":1773,"_30209":1718,"_20922":54719,"_5":14373,"_27447":54595,"_2948":54720},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3464":1774,"_30209":1774,"_5":14725,"_2948":54722,"_30541":54723,"_20922":54726,"_27447":1774},"CA hierarchy and rotation",[49244,50719,54724,54725],"PKI","Keys, authorities and certificates",[],{"_3464":1775,"_30209":1774,"_20922":54728,"_5":14373,"_27447":1774,"_2948":54729},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3464":1776,"_30209":1774,"_5":30538,"_20922":54731,"_27447":54732,"_2948":54733},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3464":1777,"_30209":1774,"_5":30538,"_20922":54735,"_27447":54736,"_2948":54737},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3464":1778,"_30209":1774,"_5":30538,"_20922":54739,"_27447":54740,"_2948":54741},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3464":1779,"_30209":1774,"_5":30538,"_20922":54743,"_27447":54744,"_2948":54745},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3464":1780,"_30209":1774,"_5":30538,"_20922":54747,"_27447":54748,"_2948":54749},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3464":1781,"_30209":1774,"_5":30538,"_20922":54751,"_27447":54752,"_2948":54753},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3464":1782,"_30209":1774,"_5":30538,"_20922":54755,"_27447":54756,"_2948":54757},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3464":1783,"_30209":1774,"_5":30538,"_20922":54759,"_27447":54760,"_2948":54761},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3464":1784,"_30209":1774,"_5":30538,"_20922":54763,"_27447":54764,"_2948":54765},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3464":1785,"_30209":1774,"_5":30538,"_20922":54767,"_27447":54768,"_2948":54769},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3464":1786,"_30209":1774,"_5":30538,"_20922":54771,"_27447":54772,"_2948":54773},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3464":1787,"_30209":1774,"_5":30538,"_20922":54775,"_27447":54776,"_2948":54777},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3464":1788,"_30209":1774,"_20922":54779,"_5":14373,"_27447":1774,"_2948":54780},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3464":1789,"_30209":1774,"_20922":54782,"_5":14373,"_27447":1774,"_2948":54783},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3464":1790,"_30209":1774,"_20922":54785,"_5":14373,"_27447":54732,"_2948":54786},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3464":1791,"_30209":1774,"_20922":54788,"_5":14373,"_27447":54732,"_2948":54789},[],"environment, such as production and preproduction;",{"_3464":1792,"_30209":1774,"_20922":54791,"_5":14373,"_27447":54732,"_2948":54792},[],"owner or operating team;",{"_3464":1793,"_30209":1774,"_20922":54794,"_5":14373,"_27447":54732,"_2948":54795},[],"device family or manufacturing process;",{"_3464":1794,"_30209":1774,"_20922":54797,"_5":14373,"_27447":54732,"_2948":54798},[],"region or regulatory requirement;",{"_3464":1795,"_30209":1774,"_20922":54800,"_5":14373,"_27447":54732,"_2948":54801},[],"cryptographic engine or key policy;",{"_3464":1796,"_30209":1774,"_20922":54803,"_5":14373,"_27447":54732,"_2948":54804},[],"maintenance window and renewal cadence.",{"_3464":1797,"_30209":1774,"_20922":54806,"_5":14373,"_27447":54732,"_2948":54807},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3464":1798,"_30209":1774,"_20922":54809,"_5":14373,"_27447":54732,"_2948":54810},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3464":1799,"_30209":1774,"_20922":54812,"_5":14373,"_27447":54736,"_2948":54813},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3464":1800,"_30209":1774,"_20922":54815,"_5":14373,"_27447":54736,"_2948":54816},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3464":1801,"_30209":1774,"_20922":54818,"_5":14373,"_27447":54736,"_2948":54819},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3464":1802,"_30209":1774,"_20922":54821,"_5":14373,"_27447":54736,"_2948":54822},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3464":1803,"_30209":1774,"_20922":54824,"_5":14373,"_27447":54740,"_2948":54825},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3464":1804,"_30209":1774,"_20922":54827,"_5":14373,"_27447":54740,"_2948":54828},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3464":1805,"_30209":1774,"_20922":54830,"_5":14373,"_27447":54740,"_2948":54831},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3464":1806,"_30209":1774,"_20922":54833,"_5":14373,"_27447":54740,"_2948":54834},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3464":1807,"_30209":1774,"_20922":54836,"_5":14373,"_27447":54748,"_2948":54837},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3464":1808,"_30209":1774,"_20922":54839,"_5":14373,"_27447":54752,"_2948":54840},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3464":1809,"_30209":1774,"_20922":54842,"_5":14373,"_27447":54756,"_2948":54843},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3464":1810,"_30209":1774,"_20922":54845,"_5":14373,"_27447":54760,"_2948":54846},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3464":1811,"_30209":1774,"_20922":54848,"_5":14373,"_27447":54764,"_2948":54849},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3464":1812,"_30209":1774,"_20922":54851,"_5":14373,"_27447":54768,"_2948":54852},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3464":1813,"_30209":1774,"_20922":54854,"_5":14373,"_27447":54772,"_2948":54855},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3464":1814,"_30209":1774,"_20922":54857,"_5":14373,"_27447":54772,"_2948":54858},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3464":1815,"_30209":1774,"_20922":54860,"_5":14373,"_27447":54772,"_2948":54861},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3464":1816,"_30209":1774,"_20922":54863,"_5":14373,"_27447":54772,"_2948":54864},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3464":1817,"_30209":1774,"_20922":54866,"_5":14373,"_27447":54776,"_2948":54867},[],"The new chain ends in an anchor installed by the consumer.",{"_3464":1818,"_30209":1774,"_20922":54869,"_5":14373,"_27447":54776,"_2948":54870},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3464":1819,"_30209":1774,"_20922":54872,"_5":14373,"_27447":54776,"_2948":54873},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3464":1820,"_30209":1774,"_20922":54875,"_5":14373,"_27447":54776,"_2948":54876},[],"Re-enrollment accepts the old identity during the planned period.",{"_3464":1821,"_30209":1774,"_20922":54878,"_5":14373,"_27447":54776,"_2948":54879},[],"OCSP and CRL respond for the authorities that remain active.",{"_3464":1822,"_30209":1774,"_20922":54881,"_5":14373,"_27447":54776,"_2948":54882},[],"No DMS is left accidentally issuing from the old CA.",{"_3464":1823,"_30209":1774,"_20922":54884,"_5":14373,"_27447":54776,"_2948":54885},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3464":1824,"_30209":1824,"_5":14725,"_2948":54887,"_30541":54888,"_20922":54889,"_27447":1824},"Certification authorities",[49244,50719,54724,54725],[],{"_3464":1825,"_30209":1824,"_20922":54891,"_5":14373,"_27447":1824,"_2948":54892},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3464":1826,"_30209":1824,"_5":30538,"_20922":54894,"_27447":54895,"_2948":54896},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3464":1827,"_30209":1824,"_5":30538,"_20922":54898,"_27447":54899,"_2948":54900},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3464":1828,"_30209":1824,"_5":30538,"_20922":54902,"_27447":54903,"_2948":49254},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3464":1829,"_30209":1824,"_5":30538,"_20922":54905,"_27447":54906,"_2948":54907},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3464":1830,"_30209":1824,"_5":30538,"_20922":54909,"_27447":54910,"_2948":54911},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3464":1831,"_30209":1824,"_5":30538,"_20922":54913,"_27447":54914,"_2948":54915},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3464":1832,"_30209":1824,"_5":30538,"_20922":54917,"_27447":54918,"_2948":54919},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3464":1833,"_30209":1824,"_5":30538,"_20922":54921,"_27447":54922,"_2948":54923},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3464":1834,"_30209":1824,"_5":30538,"_20922":54925,"_27447":54926,"_2948":54927},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3464":1835,"_30209":1824,"_5":30538,"_20922":54929,"_27447":54930,"_2948":54931},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3464":1836,"_30209":1824,"_5":30538,"_20922":54933,"_27447":54934,"_2948":54935},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3464":1837,"_30209":1824,"_5":30538,"_20922":54937,"_27447":54938,"_2948":54939},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3464":1838,"_30209":1824,"_5":30538,"_20922":54941,"_27447":54942,"_2948":54943},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3464":1839,"_30209":1824,"_5":30538,"_20922":54945,"_27447":54946,"_2948":54947},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3464":1840,"_30209":1824,"_5":30538,"_20922":54949,"_27447":54950,"_2948":54951},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3464":1841,"_30209":1824,"_5":30538,"_20922":54953,"_27447":54954,"_2948":54955},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3464":1842,"_30209":1824,"_5":30538,"_20922":54957,"_27447":54958,"_2948":54959},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3464":1843,"_30209":1824,"_5":30538,"_20922":54961,"_27447":54962,"_2948":54963},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3464":1844,"_30209":1824,"_5":30538,"_20922":54965,"_27447":54966,"_2948":54967},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3464":1845,"_30209":1824,"_5":30538,"_20922":54969,"_27447":54970,"_2948":54971},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3464":1846,"_30209":1824,"_5":30538,"_20922":54973,"_27447":54974,"_2948":54975},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3464":1847,"_30209":1824,"_5":30538,"_20922":54977,"_27447":54978,"_2948":54979},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3464":1848,"_30209":1824,"_5":30538,"_20922":54981,"_27447":54982,"_2948":54983},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3464":1849,"_30209":1824,"_20922":54985,"_5":14373,"_27447":1824,"_2948":54986},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3464":1850,"_30209":1824,"_20922":54988,"_5":14373,"_27447":1824,"_2948":54989},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3464":1851,"_30209":1824,"_20922":54991,"_5":14373,"_27447":1824,"_2948":54992},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3464":1852,"_30209":1824,"_20922":54994,"_5":14373,"_27447":54895,"_2948":54995},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3464":1853,"_30209":1824,"_20922":54997,"_5":14373,"_27447":54895,"_2948":54998},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3464":1854,"_30209":1824,"_20922":55000,"_5":14373,"_27447":54895,"_2948":55001},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3464":1855,"_30209":1824,"_20922":55003,"_5":14373,"_27447":54895,"_2948":55004},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3464":1856,"_30209":1824,"_20922":55006,"_5":14373,"_27447":54895,"_2948":55007},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3464":1857,"_30209":1824,"_20922":55009,"_5":14373,"_27447":54903,"_2948":55010},[],"Decide whether the CA will be a root or an intermediate.",{"_3464":1858,"_30209":1824,"_20922":55012,"_5":14373,"_27447":54903,"_2948":55013},[],"Choose the engine that will keep the key.",{"_3464":1859,"_30209":1824,"_20922":55015,"_5":14373,"_27447":54903,"_2948":55016},[],"Define a validity longer than that of the certificates it will issue.",{"_3464":1860,"_30209":1824,"_20922":55018,"_5":14373,"_27447":54903,"_2948":55019},[],"For an intermediate CA, make sure the parent CA is active.",{"_3464":1861,"_30209":1824,"_20922":55021,"_5":14373,"_27447":54906,"_2948":55022},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3464":1862,"_30209":1824,"_20922":55024,"_5":14373,"_27447":54910,"_2948":55025},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3464":1863,"_30209":1824,"_20922":55027,"_5":14373,"_27447":54910,"_2948":55028},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3464":1864,"_30209":1824,"_20922":55030,"_5":14373,"_27447":54914,"_2948":55031},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3464":1865,"_30209":1824,"_20922":55033,"_5":14373,"_27447":54918,"_2948":55034},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3464":1866,"_30209":1824,"_20922":55036,"_5":14373,"_27447":54918,"_2948":55037},[],"`C`: two-letter ISO 3166-1 country code.",{"_3464":1867,"_30209":1824,"_20922":55039,"_5":14373,"_27447":54918,"_2948":55040},[],"`ST`: state or province.",{"_3464":1868,"_30209":1824,"_20922":55042,"_5":14373,"_27447":54918,"_2948":55043},[],"`L`: locality.",{"_3464":1869,"_30209":1824,"_20922":55045,"_5":14373,"_27447":54918,"_2948":55046},[],"`O`: organization.",{"_3464":1870,"_30209":1824,"_20922":55048,"_5":14373,"_27447":54918,"_2948":55049},[],"`OU`: organizational unit.",{"_3464":1871,"_30209":1824,"_20922":55051,"_5":14373,"_27447":54918,"_2948":55052},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3464":1872,"_30209":1824,"_20922":55054,"_5":14373,"_27447":54922,"_2948":55055},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3464":1873,"_30209":1824,"_20922":55057,"_5":14373,"_27447":54922,"_2948":55058},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3464":1874,"_30209":1824,"_20922":55060,"_5":14373,"_27447":54926,"_2948":55061},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3464":1875,"_30209":1824,"_20922":55063,"_5":14373,"_27447":54926,"_2948":55064},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3464":1876,"_30209":1824,"_20922":55066,"_5":14373,"_27447":54930,"_2948":55067},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3464":1877,"_30209":1824,"_20922":55069,"_5":14373,"_27447":54930,"_2948":55070},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3464":1878,"_30209":1824,"_20922":55072,"_5":14373,"_27447":54934,"_2948":55073},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3464":1879,"_30209":1824,"_20922":55075,"_5":14373,"_27447":54934,"_2948":55076},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3464":1880,"_30209":1824,"_20922":55078,"_5":14373,"_27447":54934,"_2948":55079},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3464":1881,"_30209":1824,"_20922":55081,"_5":14373,"_27447":54938,"_2948":55082},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3464":1882,"_30209":1824,"_20922":55084,"_5":14373,"_27447":54942,"_2948":55085},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3464":1883,"_30209":1824,"_20922":55087,"_5":14373,"_27447":54942,"_2948":55088},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3464":1884,"_30209":1824,"_20922":55090,"_5":14373,"_27447":54946,"_2948":55091},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3464":1885,"_30209":1824,"_20922":55093,"_5":14373,"_27447":54950,"_2948":55094},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3464":1886,"_30209":1824,"_20922":55096,"_5":14373,"_27447":54950,"_2948":55097},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3464":1887,"_30209":1824,"_20922":55099,"_5":14373,"_27447":54954,"_2948":55100},[],"Open a CA from the inventory to review:",{"_3464":1888,"_30209":1824,"_20922":55102,"_5":14373,"_27447":54954,"_2948":55103},[],"Status and validity period.",{"_3464":1889,"_30209":1824,"_20922":55105,"_5":14373,"_27447":54954,"_2948":55106},[],"Certificate and chain in PEM format.",{"_3464":1890,"_30209":1824,"_20922":55108,"_5":14373,"_27447":54954,"_2948":55109},[],"Number of active, expired and revoked certificates.",{"_3464":1891,"_30209":1824,"_20922":55111,"_5":14373,"_27447":54954,"_2948":55112},[],"Certificates issued in **Issued Certificates**.",{"_3464":1892,"_30209":1824,"_20922":55114,"_5":14373,"_27447":54954,"_2948":55115},[],"The CRL linked to the authority.",{"_3464":1893,"_30209":1824,"_20922":55117,"_5":14373,"_27447":54954,"_2948":55118},[],"Metadata and the associated cryptographic engine.",{"_3464":1894,"_30209":1824,"_20922":55120,"_5":14373,"_27447":54954,"_2948":55121},[],"You can filter the inventory by name, status and CA type.",{"_3464":1895,"_30209":1824,"_20922":55123,"_5":14373,"_27447":54958,"_2948":55124},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3464":1896,"_30209":1824,"_20922":55126,"_5":14373,"_27447":54958,"_2948":55127},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3464":1897,"_30209":1824,"_20922":55129,"_5":14373,"_27447":54958,"_2948":55130},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3464":1898,"_30209":1824,"_20922":55132,"_5":14373,"_27447":54958,"_2948":55133},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3464":1899,"_30209":1824,"_20922":55135,"_5":14373,"_27447":54962,"_2948":55136},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3464":1900,"_30209":1824,"_20922":55138,"_5":14373,"_27447":54966,"_2948":55139},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3464":1901,"_30209":1824,"_20922":55141,"_5":14373,"_27447":54970,"_2948":55142},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3464":1902,"_30209":1824,"_20922":55144,"_5":14373,"_27447":54974,"_2948":55145},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3464":1903,"_30209":1824,"_20922":55147,"_5":14373,"_27447":54978,"_2948":55148},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3464":1904,"_30209":1824,"_20922":55150,"_5":14373,"_27447":54982,"_2948":55151},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3464":1905,"_30209":1824,"_20922":55153,"_5":14373,"_27447":54982,"_2948":55154},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3464":1906,"_30209":1824,"_20922":55156,"_5":14373,"_27447":54982,"_2948":55157},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3464":1907,"_30209":1907,"_5":14725,"_2948":55159,"_30541":55160,"_20922":55161,"_27447":1907},"Certificate profiles",[49244,50719,54724,54725],[],{"_3464":1908,"_30209":1907,"_20922":55163,"_5":14373,"_27447":1907,"_2948":55164},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3464":1909,"_30209":1907,"_5":30538,"_20922":55166,"_27447":55167,"_2948":55168},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3464":1910,"_30209":1907,"_5":30538,"_20922":55170,"_27447":55171,"_2948":55172},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3464":1911,"_30209":1907,"_5":30538,"_20922":55174,"_27447":55175,"_2948":55176},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3464":1912,"_30209":1907,"_5":30538,"_20922":55178,"_27447":55179,"_2948":55180},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3464":1913,"_30209":1907,"_5":30538,"_20922":55182,"_27447":55183,"_2948":55184},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3464":1914,"_30209":1907,"_5":30538,"_20922":55186,"_27447":55187,"_2948":55188},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3464":1915,"_30209":1907,"_5":30538,"_20922":55190,"_27447":55191,"_2948":55192},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3464":1916,"_30209":1907,"_5":30538,"_20922":55194,"_27447":55195,"_2948":55196},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3464":1917,"_30209":1907,"_5":30538,"_20922":55198,"_27447":55199,"_2948":55200},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3464":1918,"_30209":1907,"_5":30538,"_20922":55202,"_27447":55203,"_2948":55204},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3464":1919,"_30209":1907,"_5":30538,"_20922":55206,"_27447":55207,"_2948":55208},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3464":1920,"_30209":1907,"_5":30538,"_20922":55210,"_27447":55211,"_2948":55212},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3464":1921,"_30209":1907,"_5":30538,"_20922":55214,"_27447":55215,"_2948":55216},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3464":1922,"_30209":1907,"_5":30538,"_20922":55218,"_27447":55219,"_2948":55220},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3464":1923,"_30209":1907,"_5":30538,"_20922":55222,"_27447":55223,"_2948":55224},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3464":1924,"_30209":1907,"_5":30538,"_20922":55226,"_27447":55227,"_2948":55228},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3464":1925,"_30209":1907,"_20922":55230,"_5":14373,"_27447":1907,"_2948":55231},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3464":1926,"_30209":1907,"_20922":55233,"_5":14373,"_27447":1907,"_2948":55234},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3464":1927,"_30209":1907,"_20922":55236,"_5":14373,"_27447":55171,"_2948":55237},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3464":1928,"_30209":1907,"_20922":55239,"_5":14373,"_27447":55171,"_2948":55240},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3464":1929,"_30209":1907,"_20922":55242,"_5":14373,"_27447":55175,"_2948":55243},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3464":1930,"_30209":1907,"_20922":55245,"_5":14373,"_27447":55179,"_2948":55246},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3464":1931,"_30209":1907,"_20922":55248,"_5":14373,"_27447":55179,"_2948":55249},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3464":1932,"_30209":1907,"_20922":55251,"_5":14373,"_27447":55179,"_2948":55252},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3464":1933,"_30209":1907,"_20922":55254,"_5":14373,"_27447":55183,"_2948":55255},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3464":1934,"_30209":1907,"_20922":55257,"_5":14373,"_27447":55187,"_2948":55258},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3464":1935,"_30209":1907,"_20922":55260,"_5":14373,"_27447":55187,"_2948":55261},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3464":1936,"_30209":1907,"_20922":55263,"_5":14373,"_27447":55191,"_2948":55264},[],"The cryptographic enforcement can:",{"_3464":1937,"_30209":1907,"_20922":55266,"_5":14373,"_27447":55191,"_2948":55267},[],"allow or block RSA keys;",{"_3464":1938,"_30209":1907,"_20922":55269,"_5":14373,"_27447":55191,"_2948":55270},[],"limit the supported RSA sizes;",{"_3464":1939,"_30209":1907,"_20922":55272,"_5":14373,"_27447":55191,"_2948":55273},[],"allow or block ECDSA keys;",{"_3464":1940,"_30209":1907,"_20922":55275,"_5":14373,"_27447":55191,"_2948":55276},[],"limit the supported ECDSA sizes or curves.",{"_3464":1941,"_30209":1907,"_20922":55278,"_5":14373,"_27447":55191,"_2948":55279},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3464":1942,"_30209":1907,"_20922":55281,"_5":14373,"_27447":55195,"_2948":55282},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3464":1943,"_30209":1907,"_20922":55284,"_5":14373,"_27447":55195,"_2948":52486},[],{"_3464":1944,"_30209":1907,"_20922":55286,"_5":14373,"_27447":55195,"_2948":55287},[],"First choice",{"_3464":1945,"_30209":1907,"_20922":55289,"_5":14373,"_27447":55195,"_2948":55290},[],"Second choice",{"_3464":1946,"_30209":1907,"_20922":55292,"_5":14373,"_27447":55195,"_2948":55293},[],"If neither is supplied",{"_3464":1947,"_30209":1907,"_20922":55295,"_5":14373,"_27447":55195,"_2948":55296},[],"Direct signing with a CA",{"_3464":1948,"_30209":1907,"_20922":55298,"_5":14373,"_27447":55195,"_2948":55299},[],"`issuance_profile` embedded in the request",{"_3464":1949,"_30209":1907,"_20922":55301,"_5":14373,"_27447":55195,"_2948":55302},[],"Request `issuance_profile_id`",{"_3464":1950,"_30209":1907,"_20922":55304,"_5":14373,"_27447":55195,"_2948":55305},[],"CA default profile (`profile_id`).",{"_3464":1951,"_30209":1907,"_20922":55307,"_5":14373,"_27447":55195,"_2948":55308},[],"Issuance through a DMS",{"_3464":1952,"_30209":1907,"_20922":55310,"_5":14373,"_27447":55195,"_2948":55311},[],"`settings.issuance_profile_id`",{"_3464":1953,"_30209":1907,"_20922":55313,"_5":14373,"_27447":55195,"_2948":55314},[],"`settings.issuance_profile` embedded in the DMS",{"_3464":1954,"_30209":1907,"_20922":55316,"_5":14373,"_27447":55195,"_2948":55317},[],"Enrollment CA default profile.",{"_3464":1955,"_30209":1907,"_20922":55319,"_5":14373,"_27447":55195,"_2948":55320},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3464":1956,"_30209":1907,"_20922":55322,"_5":14373,"_27447":55195,"_2948":55323},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3464":1957,"_30209":1907,"_20922":55325,"_5":14373,"_27447":55203,"_2948":55326},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3464":1958,"_30209":1907,"_20922":55328,"_5":14373,"_27447":55207,"_2948":55329},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3464":1959,"_30209":1907,"_20922":55331,"_5":14373,"_27447":55211,"_2948":55332},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3464":1960,"_30209":1907,"_20922":55334,"_5":14373,"_27447":55215,"_2948":55335},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3464":1961,"_30209":1907,"_20922":55337,"_5":14373,"_27447":55219,"_2948":55338},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3464":1962,"_30209":1907,"_20922":55340,"_5":14373,"_27447":55219,"_2948":55341},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3464":1963,"_30209":1907,"_20922":55343,"_5":14373,"_27447":55223,"_2948":55344},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3464":1964,"_30209":1907,"_20922":55346,"_5":14373,"_27447":55223,"_2948":55347},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3464":1965,"_30209":1907,"_20922":55349,"_5":14373,"_27447":55223,"_2948":55350},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3464":1966,"_30209":1907,"_20922":55352,"_5":14373,"_27447":55223,"_2948":55353},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3464":1967,"_30209":1907,"_20922":55355,"_5":14373,"_27447":55227,"_2948":55356},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3464":1968,"_30209":1907,"_20922":55358,"_5":14373,"_27447":55227,"_2948":55359},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3464":1969,"_30209":1969,"_5":14725,"_2948":55361,"_30541":55362,"_20922":55364,"_27447":1969},"Certificate validation",[49244,50719,54724,55363],"Validation",[],{"_3464":1970,"_30209":1969,"_20922":55366,"_5":14373,"_27447":1969,"_2948":55367},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3464":1971,"_30209":1969,"_5":30538,"_20922":55369,"_27447":55370,"_2948":55371},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3464":1972,"_30209":1969,"_5":30538,"_20922":55373,"_27447":55374,"_2948":55375},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3464":1973,"_30209":1969,"_5":30538,"_20922":55377,"_27447":55378,"_2948":55379},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3464":1974,"_30209":1969,"_20922":55381,"_5":14373,"_27447":1969,"_2948":55382},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3464":1975,"_30209":1969,"_20922":55384,"_5":14373,"_27447":55370,"_2948":55385},[],"Verify these criteria together:",{"_3464":1976,"_30209":1969,"_20922":55387,"_5":14373,"_27447":55370,"_2948":54350},[],{"_3464":1977,"_30209":1969,"_20922":55389,"_5":14373,"_27447":55370,"_2948":55390},[],"Required result",{"_3464":1978,"_30209":1969,"_20922":55392,"_5":14373,"_27447":55370,"_2948":55393},[],"Chain and signature",{"_3464":1979,"_30209":1969,"_20922":55395,"_5":14373,"_27447":55370,"_2948":55396},[],"Valid chain to a root deliberately installed in the consumer.",{"_3464":1980,"_30209":1969,"_20922":55398,"_5":14373,"_27447":55370,"_2948":55399},[],"Dates",{"_3464":1981,"_30209":1969,"_20922":55401,"_5":14373,"_27447":55370,"_2948":55402},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3464":1982,"_30209":1969,"_20922":55404,"_5":14373,"_27447":55370,"_2948":50388},[],{"_3464":1983,"_30209":1969,"_20922":55406,"_5":14373,"_27447":55370,"_2948":55407},[],"Name, SAN or identifier matches the expected peer.",{"_3464":1984,"_30209":1969,"_20922":55409,"_5":14373,"_27447":55370,"_2948":49634},[],{"_3464":1985,"_30209":1969,"_20922":55411,"_5":14373,"_27447":55370,"_2948":55412},[],"KU, EKU and constraints permit the specific operation.",{"_3464":1986,"_30209":1969,"_20922":55414,"_5":14373,"_27447":55370,"_2948":55415},[],"Revocation",{"_3464":1987,"_30209":1969,"_20922":55417,"_5":14373,"_27447":55370,"_2948":55418},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3464":1988,"_30209":1969,"_20922":55420,"_5":14373,"_27447":55370,"_2948":55421},[],"Authorization",{"_3464":1989,"_30209":1969,"_20922":55423,"_5":14373,"_27447":55370,"_2948":55424},[],"The application permits that identity to perform the action.",{"_3464":1990,"_30209":1969,"_20922":55426,"_5":14373,"_27447":55370,"_2948":55427},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3464":1991,"_30209":1969,"_20922":55429,"_5":14373,"_27447":55374,"_2948":55430},[],"Mechanism",{"_3464":1992,"_30209":1969,"_20922":55432,"_5":14373,"_27447":55374,"_2948":55433},[],"When to use it",{"_3464":1993,"_30209":1969,"_20922":55435,"_5":14373,"_27447":55374,"_2948":55436},[],"What you must maintain",{"_3464":1994,"_30209":1969,"_20922":55438,"_5":14373,"_27447":55374,"_2948":55439},[],"OCSP",{"_3464":1995,"_30209":1969,"_20922":55441,"_5":14373,"_27447":55374,"_2948":55442},[],"Status query for a specific certificate.",{"_3464":1996,"_30209":1969,"_20922":55444,"_5":14373,"_27447":55374,"_2948":55445},[],"Responder access, signature verification and cache/freshness policy.",{"_3464":1997,"_30209":1969,"_20922":55447,"_5":14373,"_27447":55374,"_2948":55448},[],"CRL",{"_3464":1998,"_30209":1969,"_20922":55450,"_5":14373,"_27447":55374,"_2948":55451},[],"Local checks for many certificates or offline operation.",{"_3464":1999,"_30209":1969,"_20922":55453,"_5":14373,"_27447":55374,"_2948":55454},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3464":2000,"_30209":1969,"_20922":55456,"_5":14373,"_27447":55374,"_2948":55457},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3464":2001,"_30209":1969,"_20922":55459,"_5":14373,"_27447":55374,"_2948":55460},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3464":2002,"_30209":1969,"_20922":55462,"_5":14373,"_27447":55378,"_2948":55463},[],"Accept a current, authorized certificate with a known chain.",{"_3464":2003,"_30209":1969,"_20922":55465,"_5":14373,"_27447":55378,"_2948":55466},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3464":2004,"_30209":1969,"_20922":55468,"_5":14373,"_27447":55378,"_2948":55469},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3464":2005,"_30209":1969,"_20922":55471,"_5":14373,"_27447":55378,"_2948":55472},[],"Check that a new connection with that identity is rejected.",{"_3464":2006,"_30209":1969,"_20922":55474,"_5":14373,"_27447":55378,"_2948":55475},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3464":2007,"_30209":1969,"_20922":55477,"_5":14373,"_27447":55378,"_2948":55478},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3464":2008,"_30209":1969,"_20922":55480,"_5":14373,"_27447":55378,"_2948":55481},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3464":2009,"_30209":1969,"_20922":55483,"_5":14373,"_27447":55378,"_2948":55484},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":2010,"_30209":1969,"_20922":55486,"_5":14373,"_27447":55378,"_2948":55487},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3464":2011,"_30209":2011,"_5":14725,"_2948":55489,"_30541":55490,"_20922":55491,"_27447":2011},"Certificates",[49244,50719,54724,54725],[],{"_3464":2012,"_30209":2011,"_20922":55493,"_5":14373,"_27447":2011,"_2948":55494},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3464":2013,"_30209":2011,"_5":30538,"_20922":55496,"_27447":55497,"_2948":55498},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3464":2014,"_30209":2011,"_5":30538,"_20922":55500,"_27447":55501,"_2948":55502},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3464":2015,"_30209":2011,"_5":30538,"_20922":55504,"_27447":55505,"_2948":55506},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3464":2016,"_30209":2011,"_5":30538,"_20922":55508,"_27447":55509,"_2948":55510},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3464":2017,"_30209":2011,"_5":30538,"_20922":55512,"_27447":55513,"_2948":55514},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3464":2018,"_30209":2011,"_5":30538,"_20922":55516,"_27447":55517,"_2948":55518},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3464":2019,"_30209":2011,"_5":30538,"_20922":55520,"_27447":55521,"_2948":55522},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3464":2020,"_30209":2011,"_5":30538,"_20922":55524,"_27447":55525,"_2948":55526},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3464":2021,"_30209":2011,"_5":30538,"_20922":55528,"_27447":55529,"_2948":55530},[],"/docs/platform/pki/certificates#continue","Continue",{"_3464":2022,"_30209":2011,"_20922":55532,"_5":14373,"_27447":2011,"_2948":55533},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3464":2023,"_30209":2011,"_20922":55535,"_5":14373,"_27447":55497,"_2948":55536},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3464":2024,"_30209":2011,"_20922":55538,"_5":14373,"_27447":55497,"_2948":55539},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3464":2025,"_30209":2011,"_20922":55541,"_5":14373,"_27447":55497,"_2948":55542},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3464":2026,"_30209":2011,"_20922":55544,"_5":14373,"_27447":55497,"_2948":55545},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3464":2027,"_30209":2011,"_20922":55547,"_5":14373,"_27447":55497,"_2948":55548},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3464":2028,"_30209":2011,"_20922":55550,"_5":14373,"_27447":55497,"_2948":55551},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3464":2029,"_30209":2011,"_20922":55553,"_5":14373,"_27447":55497,"_2948":55554},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3464":2030,"_30209":2011,"_20922":55556,"_5":14373,"_27447":55501,"_2948":55557},[],"Download the PEM and inspect it:",{"_3464":2031,"_30209":2011,"_20922":55559,"_5":14373,"_27447":55501,"_2948":55560},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3464":2032,"_30209":2011,"_20922":55562,"_5":14373,"_27447":55505,"_2948":55563},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3464":2033,"_30209":2011,"_20922":55565,"_5":14373,"_27447":55505,"_2948":55566},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3464":2034,"_30209":2011,"_20922":55568,"_5":14373,"_27447":55505,"_2948":55569},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3464":2035,"_30209":2011,"_20922":55571,"_5":14373,"_27447":55505,"_2948":55572},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3464":2036,"_30209":2011,"_20922":55574,"_5":14373,"_27447":55505,"_2948":55575},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3464":2037,"_30209":2011,"_20922":55577,"_5":14373,"_27447":55505,"_2948":55578},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3464":2038,"_30209":2011,"_20922":55580,"_5":14373,"_27447":55505,"_2948":55581},[],"For browser key generation, follow Issue your first certificate.",{"_3464":2039,"_30209":2011,"_20922":55583,"_5":14373,"_27447":55509,"_2948":55584},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3464":2040,"_30209":2011,"_20922":55586,"_5":14373,"_27447":55513,"_2948":55587},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3464":2041,"_30209":2011,"_20922":55589,"_5":14373,"_27447":55517,"_2948":55590},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3464":2042,"_30209":2011,"_20922":55592,"_5":14373,"_27447":55521,"_2948":55593},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3464":2043,"_30209":2011,"_20922":55595,"_5":14373,"_27447":55521,"_2948":55596},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3464":2044,"_30209":2011,"_20922":55598,"_5":14373,"_27447":55521,"_2948":55599},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3464":2045,"_30209":2011,"_20922":55601,"_5":14373,"_27447":55525,"_2948":55602},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3464":2046,"_30209":2011,"_20922":55604,"_5":14373,"_27447":55525,"_2948":55605},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3464":2047,"_30209":2011,"_20922":55607,"_5":14373,"_27447":55525,"_2948":55608},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3464":2048,"_30209":2011,"_20922":55610,"_5":14373,"_27447":55529,"_2948":55611},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":2049,"_30209":2011,"_20922":55613,"_5":14373,"_27447":55529,"_2948":55614},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3464":2050,"_30209":2050,"_5":14725,"_2948":55616,"_30541":55617,"_20922":55619,"_27447":2050},"Certificate lifecycle",[49244,50719,54724,55618],"Concepts",[],{"_3464":2051,"_30209":2050,"_20922":55621,"_5":14373,"_27447":2050,"_2948":55622},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3464":2052,"_30209":2050,"_5":30538,"_20922":55624,"_27447":55625,"_2948":55626},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3464":2053,"_30209":2050,"_5":30538,"_20922":55628,"_27447":55629,"_2948":55630},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3464":2054,"_30209":2050,"_5":30538,"_20922":55632,"_27447":55633,"_2948":55634},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3464":2055,"_30209":2050,"_5":30538,"_20922":55636,"_27447":55637,"_2948":55638},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3464":2056,"_30209":2050,"_5":30538,"_20922":55640,"_27447":55641,"_2948":55642},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3464":2057,"_30209":2050,"_5":30538,"_20922":55644,"_27447":55645,"_2948":55646},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3464":2058,"_30209":2050,"_5":30538,"_20922":55648,"_27447":55649,"_2948":55650},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3464":2059,"_30209":2050,"_5":30538,"_20922":55652,"_27447":55653,"_2948":55654},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3464":2060,"_30209":2050,"_5":30538,"_20922":55656,"_27447":55657,"_2948":55658},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3464":2061,"_30209":2050,"_5":30538,"_20922":55660,"_27447":55661,"_2948":55662},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3464":2062,"_30209":2050,"_20922":55664,"_5":14373,"_27447":2050,"_2948":55665},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3464":2063,"_30209":2050,"_20922":55667,"_5":14373,"_27447":55629,"_2948":55668},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3464":2064,"_30209":2050,"_20922":55670,"_5":14373,"_27447":55633,"_2948":55671},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3464":2065,"_30209":2050,"_20922":55673,"_5":14373,"_27447":55637,"_2948":55674},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3464":2066,"_30209":2050,"_20922":55676,"_5":14373,"_27447":55641,"_2948":55677},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3464":2067,"_30209":2050,"_20922":55679,"_5":14373,"_27447":55645,"_2948":55680},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3464":2068,"_30209":2050,"_20922":55682,"_5":14373,"_27447":55649,"_2948":55683},[],"Lamassu persists four X.509 states:",{"_3464":2069,"_30209":2050,"_20922":55685,"_5":14373,"_27447":55649,"_2948":55686},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3464":2070,"_30209":2050,"_20922":55688,"_5":14373,"_27447":55649,"_2948":55689},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3464":2071,"_30209":2050,"_20922":55691,"_5":14373,"_27447":55649,"_2948":55692},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3464":2072,"_30209":2050,"_20922":55694,"_5":14373,"_27447":55649,"_2948":55695},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3464":2073,"_30209":2050,"_20922":55697,"_5":14373,"_27447":55649,"_2948":55698},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3464":2074,"_30209":2050,"_20922":55700,"_5":14373,"_27447":55653,"_2948":55701},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3464":2075,"_30209":2050,"_20922":55703,"_5":14373,"_27447":55653,"_2948":55704},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3464":2076,"_30209":2050,"_20922":55706,"_5":14373,"_27447":55653,"_2948":55707},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3464":2077,"_30209":2050,"_20922":55709,"_5":14373,"_27447":55657,"_2948":55710},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3464":2078,"_30209":2050,"_20922":55712,"_5":14373,"_27447":55657,"_2948":55713},[],"Before confirming:",{"_3464":2079,"_30209":2050,"_20922":55715,"_5":14373,"_27447":55657,"_2948":55716},[],"Identify DMSs, devices and services that trust that chain.",{"_3464":2080,"_30209":2050,"_20922":55718,"_5":14373,"_27447":55657,"_2948":55719},[],"Distribute the new chain of trust.",{"_3464":2081,"_30209":2050,"_20922":55721,"_5":14373,"_27447":55657,"_2948":55722},[],"Reissue the necessary identities.",{"_3464":2082,"_30209":2050,"_20922":55724,"_5":14373,"_27447":55657,"_2948":55725},[],"Check OCSP and CRL from a real consumer.",{"_3464":2083,"_30209":2050,"_20922":55727,"_5":14373,"_27447":55657,"_2948":55728},[],"Revoke the old CA once no legitimate traffic remains.",{"_3464":2084,"_30209":2050,"_20922":55730,"_5":14373,"_27447":55657,"_2948":55731},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3464":2085,"_30209":2050,"_20922":55733,"_5":14373,"_27447":55661,"_2948":55734},[],"Certificates entering the preventive or critical renewal window.",{"_3464":2086,"_30209":2050,"_20922":55736,"_5":14373,"_27447":55661,"_2948":55737},[],"Repeated enrollment or re-enrollment failures.",{"_3464":2087,"_30209":2050,"_20922":55739,"_5":14373,"_27447":55661,"_2948":55740},[],"Status changes and revocation reasons.",{"_3464":2088,"_30209":2050,"_20922":55742,"_5":14373,"_27447":55661,"_2948":55743},[],"OCSP and CRL publication and validity.",{"_3464":2089,"_30209":2050,"_20922":55745,"_5":14373,"_27447":55661,"_2948":55746},[],"Dependencies still presenting a replaced certificate.",{"_3464":2090,"_30209":2050,"_20922":55748,"_5":14373,"_27447":55661,"_2948":55749},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3464":2091,"_30209":2091,"_5":14725,"_2948":55751,"_30541":55752,"_20922":55753,"_27447":2091},"Trust model",[49244,50719,54724,55618],[],{"_3464":2092,"_30209":2091,"_20922":55755,"_5":14373,"_27447":2091,"_2948":55756},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3464":2093,"_30209":2091,"_5":30538,"_20922":55758,"_27447":55759,"_2948":55760},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3464":2094,"_30209":2091,"_5":30538,"_20922":55762,"_27447":55763,"_2948":55764},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3464":2095,"_30209":2091,"_5":30538,"_20922":55766,"_27447":55767,"_2948":55768},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3464":2096,"_30209":2091,"_5":30538,"_20922":55770,"_27447":55771,"_2948":55772},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3464":2097,"_30209":2091,"_5":30538,"_20922":55774,"_27447":55775,"_2948":55776},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3464":2098,"_30209":2091,"_5":30538,"_20922":55778,"_27447":55779,"_2948":55780},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3464":2099,"_30209":2091,"_5":30538,"_20922":55782,"_27447":55783,"_2948":55784},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3464":2100,"_30209":2091,"_5":30538,"_20922":55786,"_27447":55787,"_2948":55788},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3464":2101,"_30209":2091,"_5":30538,"_20922":55790,"_27447":55791,"_2948":55792},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3464":2102,"_30209":2091,"_5":30538,"_20922":55794,"_27447":55795,"_2948":55796},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3464":2103,"_30209":2091,"_20922":55798,"_5":14373,"_27447":2091,"_2948":55799},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3464":2104,"_30209":2091,"_20922":55801,"_5":14373,"_27447":55763,"_2948":55802},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3464":2105,"_30209":2091,"_20922":55804,"_5":14373,"_27447":55767,"_2948":55805},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3464":2106,"_30209":2091,"_20922":55807,"_5":14373,"_27447":55771,"_2948":55808},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3464":2107,"_30209":2091,"_20922":55810,"_5":14373,"_27447":55775,"_2948":55811},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3464":2108,"_30209":2091,"_20922":55813,"_5":14373,"_27447":55779,"_2948":55814},[],"The device proves it can enroll according to the DMS policy.",{"_3464":2109,"_30209":2091,"_20922":55816,"_5":14373,"_27447":55779,"_2948":55817},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3464":2110,"_30209":2091,"_20922":55819,"_5":14373,"_27447":55779,"_2948":55820},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3464":2111,"_30209":2091,"_20922":55822,"_5":14373,"_27447":55779,"_2948":55823},[],"The device installs the certificate and the chain it needs.",{"_3464":2112,"_30209":2091,"_20922":55825,"_5":14373,"_27447":55779,"_2948":55826},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3464":2113,"_30209":2091,"_20922":55828,"_5":14373,"_27447":55779,"_2948":55829},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3464":2114,"_30209":2091,"_20922":55831,"_5":14373,"_27447":55783,"_2948":55832},[],"A DMS relates three sets that are worth designing separately:",{"_3464":2115,"_30209":2091,"_20922":55834,"_5":14373,"_27447":55783,"_2948":55835},[],"**Enrollment CA:** signs the new identities.",{"_3464":2116,"_30209":2091,"_20922":55837,"_5":14373,"_27447":55783,"_2948":55838},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3464":2117,"_30209":2091,"_20922":55840,"_5":14373,"_27447":55783,"_2948":55841},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3464":2118,"_30209":2091,"_20922":55843,"_5":14373,"_27447":55783,"_2948":55844},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3464":2119,"_30209":2091,"_20922":55846,"_5":14373,"_27447":55787,"_2948":55847},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3464":2120,"_30209":2091,"_20922":55849,"_5":14373,"_27447":55787,"_2948":55850},[],"that the current date is between `Not Before` and `Not After`;",{"_3464":2121,"_30209":2091,"_20922":55852,"_5":14373,"_27447":55787,"_2948":55853},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3464":2122,"_30209":2091,"_20922":55855,"_5":14373,"_27447":55787,"_2948":55856},[],"that names, SANs and subject match the expected identity;",{"_3464":2123,"_30209":2091,"_20922":55858,"_5":14373,"_27447":55787,"_2948":55859},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3464":2124,"_30209":2091,"_20922":55861,"_5":14373,"_27447":55787,"_2948":55862},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3464":2125,"_30209":2091,"_20922":55864,"_5":14373,"_27447":55787,"_2948":55865},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3464":2126,"_30209":2091,"_20922":55867,"_5":14373,"_27447":55791,"_2948":55868},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3464":2127,"_30209":2091,"_20922":55870,"_5":14373,"_27447":55795,"_2948":55871},[],"Keep the root out of daily operations, or with very restricted access.",{"_3464":2128,"_30209":2091,"_20922":55873,"_5":14373,"_27447":55795,"_2948":55874},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3464":2129,"_30209":2091,"_20922":55876,"_5":14373,"_27447":55795,"_2948":55877},[],"Assign explicit profiles to every use case.",{"_3464":2130,"_30209":2091,"_20922":55879,"_5":14373,"_27447":55795,"_2948":55880},[],"Distribute the new trust before starting a rotation.",{"_3464":2131,"_30209":2091,"_20922":55882,"_5":14373,"_27447":55795,"_2948":55883},[],"Keep enough overlap to renew a disconnected fleet.",{"_3464":2132,"_30209":2091,"_20922":55885,"_5":14373,"_27447":55795,"_2948":55886},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3464":2133,"_30209":2091,"_20922":55888,"_5":14373,"_27447":55795,"_2948":55889},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3464":2134,"_30209":2134,"_5":14725,"_2948":55891,"_30541":55892,"_20922":55893,"_27447":2134},"Revocation lists (CRL)",[49244,50719,54724,55363],[],{"_3464":2135,"_30209":2134,"_20922":55895,"_5":14373,"_27447":2134,"_2948":55896},[],"Generate and distribute signed lists to validate certificates offline.",{"_3464":2136,"_30209":2134,"_5":30538,"_20922":55898,"_27447":55899,"_2948":55900},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3464":2137,"_30209":2134,"_5":30538,"_20922":55902,"_27447":55903,"_2948":55904},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3464":2138,"_30209":2134,"_5":30538,"_20922":55906,"_27447":55907,"_2948":55908},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3464":2139,"_30209":2134,"_5":30538,"_20922":55910,"_27447":55911,"_2948":55912},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3464":2140,"_30209":2134,"_5":30538,"_20922":55914,"_27447":55915,"_2948":55916},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3464":2141,"_30209":2134,"_5":30538,"_20922":55918,"_27447":55919,"_2948":55920},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3464":2142,"_30209":2134,"_5":30538,"_20922":55922,"_27447":55923,"_2948":55924},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3464":2143,"_30209":2134,"_5":30538,"_20922":55926,"_27447":55927,"_2948":55928},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3464":2144,"_30209":2134,"_5":30538,"_20922":55930,"_27447":55931,"_2948":55932},[],"/docs/platform/pki/crl#references","References",{"_3464":2145,"_30209":2134,"_20922":55934,"_5":14373,"_27447":2134,"_2948":55935},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3464":2146,"_30209":2134,"_20922":55937,"_5":14373,"_27447":55899,"_2948":55938},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3464":2147,"_30209":2134,"_20922":55940,"_5":14373,"_27447":55899,"_2948":55941},[],"Field",{"_3464":2148,"_30209":2134,"_20922":55943,"_5":14373,"_27447":55899,"_2948":49634},[],{"_3464":2149,"_30209":2134,"_20922":55945,"_5":14373,"_27447":55899,"_2948":55946},[],"`ca_id`",{"_3464":2150,"_30209":2134,"_20922":55948,"_5":14373,"_27447":55899,"_2948":55949},[],"ID of the CA the settings belong to.",{"_3464":2151,"_30209":2134,"_20922":55951,"_5":14373,"_27447":55899,"_2948":55952},[],"`status`",{"_3464":2152,"_30209":2134,"_20922":55954,"_5":14373,"_27447":55899,"_2948":55955},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3464":2153,"_30209":2134,"_20922":55957,"_5":14373,"_27447":55899,"_2948":55958},[],"`legacy_ski`",{"_3464":2154,"_30209":2134,"_20922":55960,"_5":14373,"_27447":55899,"_2948":55961},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3464":2155,"_30209":2134,"_20922":55963,"_5":14373,"_27447":55899,"_2948":55964},[],"`latest_crl`",{"_3464":2156,"_30209":2134,"_20922":55966,"_5":14373,"_27447":55899,"_2948":55967},[],"Version, validity start and end of the last published list. Read-only.",{"_3464":2157,"_30209":2134,"_20922":55969,"_5":14373,"_27447":55899,"_2948":55970},[],"`crl_options` field",{"_3464":2158,"_30209":2134,"_20922":55972,"_5":14373,"_27447":55899,"_2948":49634},[],{"_3464":2159,"_30209":2134,"_20922":55974,"_5":14373,"_27447":55899,"_2948":55975},[],"Initial value",{"_3464":2160,"_30209":2134,"_20922":55977,"_5":14373,"_27447":55899,"_2948":55978},[],"`validity`",{"_3464":2161,"_30209":2134,"_20922":55980,"_5":14373,"_27447":55899,"_2948":55981},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3464":2162,"_30209":2134,"_20922":55983,"_5":14373,"_27447":55899,"_2948":55984},[],"7 days.",{"_3464":2163,"_30209":2134,"_20922":55986,"_5":14373,"_27447":55899,"_2948":55987},[],"`refresh_interval`",{"_3464":2164,"_30209":2134,"_20922":55989,"_5":14373,"_27447":55899,"_2948":55990},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3464":2165,"_30209":2134,"_20922":55992,"_5":14373,"_27447":55899,"_2948":55993},[],"6 days and 23 hours.",{"_3464":2166,"_30209":2134,"_20922":55995,"_5":14373,"_27447":55899,"_2948":55996},[],"`regenerate_on_revoke`",{"_3464":2167,"_30209":2134,"_20922":55998,"_5":14373,"_27447":55899,"_2948":55999},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3464":2168,"_30209":2134,"_20922":56001,"_5":14373,"_27447":55899,"_2948":56002},[],"`true`.",{"_3464":2169,"_30209":2134,"_20922":56004,"_5":14373,"_27447":55899,"_2948":56005},[],"`signer_serial_number`",{"_3464":2170,"_30209":2134,"_20922":56007,"_5":14373,"_27447":55899,"_2948":56008},[],"Serial number of the existing certificate that signs the CRL.",{"_3464":2171,"_30209":2134,"_20922":56010,"_5":14373,"_27447":55899,"_2948":56011},[],"Serial number of the CA’s current certificate.",{"_3464":2172,"_30209":2134,"_20922":56013,"_5":14373,"_27447":55899,"_2948":56014},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3464":2173,"_30209":2134,"_20922":56016,"_5":14373,"_27447":55899,"_2948":56017},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3464":2174,"_30209":2134,"_20922":56019,"_5":14373,"_27447":55899,"_2948":56020},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3464":2175,"_30209":2134,"_20922":56022,"_5":14373,"_27447":55899,"_2948":56023},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3464":2176,"_30209":2134,"_20922":56025,"_5":14373,"_27447":55899,"_2948":56026},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3464":2177,"_30209":2134,"_20922":56028,"_5":14373,"_27447":55899,"_2948":56029},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3464":2178,"_30209":2134,"_20922":56031,"_5":14373,"_27447":55899,"_2948":56032},[],"Adjust validity and signer before deleting a CA.",{"_3464":2179,"_30209":2134,"_20922":56034,"_5":14373,"_27447":55899,"_2948":56035},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3464":2180,"_30209":2134,"_20922":56037,"_5":14373,"_27447":55899,"_2948":56038},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3464":2181,"_30209":2134,"_20922":56040,"_5":14373,"_27447":55899,"_2948":56041},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3464":2182,"_30209":2134,"_20922":56043,"_5":14373,"_27447":55903,"_2948":56044},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3464":2183,"_30209":2134,"_20922":56046,"_5":14373,"_27447":55903,"_2948":56047},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3464":2184,"_30209":2134,"_20922":56049,"_5":14373,"_27447":55903,"_2948":56050},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3464":2185,"_30209":2134,"_20922":56052,"_5":14373,"_27447":55903,"_2948":56053},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3464":2186,"_30209":2134,"_20922":56055,"_5":14373,"_27447":55907,"_2948":56056},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3464":2187,"_30209":2134,"_20922":56058,"_5":14373,"_27447":55907,"_2948":56059},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3464":2188,"_30209":2134,"_20922":56061,"_5":14373,"_27447":55907,"_2948":56062},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3464":2189,"_30209":2134,"_20922":56064,"_5":14373,"_27447":55907,"_2948":56065},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3464":2190,"_30209":2134,"_20922":56067,"_5":14373,"_27447":55907,"_2948":56068},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3464":2191,"_30209":2134,"_20922":56070,"_5":14373,"_27447":55907,"_2948":56071},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3464":2192,"_30209":2134,"_20922":56073,"_5":14373,"_27447":55907,"_2948":56074},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3464":2193,"_30209":2134,"_20922":56076,"_5":14373,"_27447":55907,"_2948":56077},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3464":2194,"_30209":2134,"_20922":56079,"_5":14373,"_27447":55907,"_2948":56080},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3464":2195,"_30209":2134,"_20922":56082,"_5":14373,"_27447":55911,"_2948":56083},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3464":2196,"_30209":2134,"_20922":56085,"_5":14373,"_27447":55911,"_2948":56086},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3464":2197,"_30209":2134,"_20922":56088,"_5":14373,"_27447":55915,"_2948":56089},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3464":2198,"_30209":2134,"_20922":56091,"_5":14373,"_27447":55915,"_2948":56092},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3464":2199,"_30209":2134,"_20922":56094,"_5":14373,"_27447":55915,"_2948":56095},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3464":2200,"_30209":2134,"_20922":56097,"_5":14373,"_27447":55915,"_2948":56098},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3464":2201,"_30209":2134,"_20922":56100,"_5":14373,"_27447":55915,"_2948":56101},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3464":2202,"_30209":2134,"_20922":56103,"_5":14373,"_27447":55919,"_2948":56104},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3464":2203,"_30209":2134,"_20922":56106,"_5":14373,"_27447":55919,"_2948":52489},[],{"_3464":2204,"_30209":2134,"_20922":56108,"_5":14373,"_27447":55919,"_2948":56109},[],"Relative path",{"_3464":2205,"_30209":2134,"_20922":56111,"_5":14373,"_27447":55919,"_2948":52486},[],{"_3464":2206,"_30209":2134,"_20922":56113,"_5":14373,"_27447":55919,"_2948":56114},[],"`GET`",{"_3464":2207,"_30209":2134,"_20922":56116,"_5":14373,"_27447":55919,"_2948":56117},[],"`/v1/crl-settings`",{"_3464":2208,"_30209":2134,"_20922":56119,"_5":14373,"_27447":55919,"_2948":56120},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3464":2209,"_30209":2134,"_20922":56122,"_5":14373,"_27447":55919,"_2948":56114},[],{"_3464":2210,"_30209":2134,"_20922":56124,"_5":14373,"_27447":55919,"_2948":56125},[],"`/v1/crl-settings/{ca-id}`",{"_3464":2211,"_30209":2134,"_20922":56127,"_5":14373,"_27447":55919,"_2948":56128},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3464":2212,"_30209":2134,"_20922":56130,"_5":14373,"_27447":55919,"_2948":56131},[],"`PUT`",{"_3464":2213,"_30209":2134,"_20922":56133,"_5":14373,"_27447":55919,"_2948":56125},[],{"_3464":2214,"_30209":2134,"_20922":56135,"_5":14373,"_27447":55919,"_2948":56136},[],"Replace the CRL configuration of a CA.",{"_3464":2215,"_30209":2134,"_20922":56138,"_5":14373,"_27447":55919,"_2948":56139},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3464":2216,"_30209":2134,"_20922":56141,"_5":14373,"_27447":55919,"_2948":56142},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3464":2217,"_30209":2134,"_20922":56144,"_5":14373,"_27447":55923,"_2948":56145},[],"Symptom",{"_3464":2218,"_30209":2134,"_20922":56147,"_5":14373,"_27447":55923,"_2948":56148},[],"Cause",{"_3464":2219,"_30209":2134,"_20922":56150,"_5":14373,"_27447":55923,"_2948":56151},[],"Action",{"_3464":2220,"_30209":2134,"_20922":56153,"_5":14373,"_27447":55923,"_2948":56154},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3464":2221,"_30209":2134,"_20922":56156,"_5":14373,"_27447":55923,"_2948":56157},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3464":2222,"_30209":2134,"_20922":56159,"_5":14373,"_27447":55923,"_2948":56160},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3464":2223,"_30209":2134,"_20922":56162,"_5":14373,"_27447":55923,"_2948":56163},[],"`PUT` returns 400.",{"_3464":2224,"_30209":2134,"_20922":56165,"_5":14373,"_27447":55923,"_2948":56166},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3464":2225,"_30209":2134,"_20922":56168,"_5":14373,"_27447":55923,"_2948":56169},[],"Set the serial number of a valid certificate of that CA.",{"_3464":2226,"_30209":2134,"_20922":56171,"_5":14373,"_27447":55923,"_2948":56172},[],"`PUT` returns 404.",{"_3464":2227,"_30209":2134,"_20922":56174,"_5":14373,"_27447":55923,"_2948":56175},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3464":2228,"_30209":2134,"_20922":56177,"_5":14373,"_27447":55923,"_2948":56178},[],"Check the CA ID and the signer serial number.",{"_3464":2229,"_30209":2134,"_20922":56180,"_5":14373,"_27447":55923,"_2948":56181},[],"`PUT` returns 400 from a 3.x client.",{"_3464":2230,"_30209":2134,"_20922":56183,"_5":14373,"_27447":55923,"_2948":56184},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3464":2231,"_30209":2134,"_20922":56186,"_5":14373,"_27447":55923,"_2948":56187},[],"Update the client to send the new field.",{"_3464":2232,"_30209":2134,"_20922":56189,"_5":14373,"_27447":55923,"_2948":56190},[],"The CRL does not change after revoking a certificate.",{"_3464":2233,"_30209":2134,"_20922":56192,"_5":14373,"_27447":55923,"_2948":56193},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3464":2234,"_30209":2134,"_20922":56195,"_5":14373,"_27447":55923,"_2948":56196},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3464":2235,"_30209":2134,"_20922":56198,"_5":14373,"_27447":55923,"_2948":56199},[],"A verifier rejects the CRL because of the issuer.",{"_3464":2236,"_30209":2134,"_20922":56201,"_5":14373,"_27447":55923,"_2948":56202},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3464":2237,"_30209":2134,"_20922":56204,"_5":14373,"_27447":55923,"_2948":56205},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3464":2238,"_30209":2134,"_20922":56207,"_5":14373,"_27447":55927,"_2948":56208},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3464":2239,"_30209":2134,"_20922":56210,"_5":14373,"_27447":55931,"_2948":56211},[],"RFC 5280: X.509 and CRL profile.",{"_3464":2240,"_30209":2134,"_20922":56213,"_5":14373,"_27447":55931,"_2948":56214},[],"OpenSSL: openssl-crl.",{"_3464":2241,"_30209":2134,"_20922":56216,"_5":14373,"_27447":55931,"_2948":56217},[],"OpenSSL: openssl-verify.",{"_3464":2242,"_30209":2134,"_20922":56219,"_5":14373,"_27447":55931,"_2948":56220},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":2243,"_30209":2134,"_20922":56222,"_5":14373,"_27447":55931,"_2948":56223},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3464":2244,"_30209":2244,"_5":14725,"_2948":56225,"_30541":56226,"_20922":56227,"_27447":2244},"Keys and cryptographic engines",[49244,50719,54724,54725],[],{"_3464":2245,"_30209":2244,"_20922":56229,"_5":14373,"_27447":2244,"_2948":56230},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3464":2246,"_30209":2244,"_5":30538,"_20922":56232,"_27447":56233,"_2948":56234},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3464":2247,"_30209":2244,"_5":30538,"_20922":56236,"_27447":56237,"_2948":56238},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3464":2248,"_30209":2244,"_5":30538,"_20922":56240,"_27447":56241,"_2948":56242},[],"/docs/platform/pki/key-management#file-system","File System",{"_3464":2249,"_30209":2244,"_5":30538,"_20922":56244,"_27447":56245,"_2948":56246},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3464":2250,"_30209":2244,"_5":30538,"_20922":56248,"_27447":56249,"_2948":56250},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3464":2251,"_30209":2244,"_5":30538,"_20922":56252,"_27447":56253,"_2948":56254},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3464":2252,"_30209":2244,"_5":30538,"_20922":56256,"_27447":56257,"_2948":56258},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3464":2253,"_30209":2244,"_5":30538,"_20922":56260,"_27447":56261,"_2948":56262},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3464":2254,"_30209":2244,"_5":30538,"_20922":56264,"_27447":56265,"_2948":56266},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3464":2255,"_30209":2244,"_5":30538,"_20922":56268,"_27447":56269,"_2948":56270},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3464":2256,"_30209":2244,"_5":30538,"_20922":56272,"_27447":56273,"_2948":56274},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3464":2257,"_30209":2244,"_5":30538,"_20922":56276,"_27447":56277,"_2948":56278},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3464":2258,"_30209":2244,"_5":30538,"_20922":56280,"_27447":56281,"_2948":56282},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3464":2259,"_30209":2244,"_5":30538,"_20922":56284,"_27447":56285,"_2948":56286},[],"/docs/platform/pki/key-management#view-details","View details",{"_3464":2260,"_30209":2244,"_5":30538,"_20922":56288,"_27447":56289,"_2948":56290},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3464":2261,"_30209":2244,"_5":30538,"_20922":56292,"_27447":56293,"_2948":56294},[],"/docs/platform/pki/key-management#sign","Sign",{"_3464":2262,"_30209":2244,"_5":30538,"_20922":56296,"_27447":56297,"_2948":56298},[],"/docs/platform/pki/key-management#verify","Verify",{"_3464":2263,"_30209":2244,"_5":30538,"_20922":56300,"_27447":56301,"_2948":56302},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3464":2264,"_30209":2244,"_5":30538,"_20922":56304,"_27447":56305,"_2948":56306},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3464":2265,"_30209":2244,"_5":30538,"_20922":56308,"_27447":56309,"_2948":56310},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3464":2266,"_30209":2244,"_20922":56312,"_5":14373,"_27447":2244,"_2948":56313},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3464":2267,"_30209":2244,"_20922":56315,"_5":14373,"_27447":2244,"_2948":56316},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3464":2268,"_30209":2244,"_20922":56318,"_5":14373,"_27447":56233,"_2948":56319},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3464":2269,"_30209":2244,"_20922":56321,"_5":14373,"_27447":56233,"_2948":56322},[],"In practice, it lets you:",{"_3464":2270,"_30209":2244,"_20922":56324,"_5":14373,"_27447":56233,"_2948":56325},[],"Generate new key pairs from Lamassu IoT.",{"_3464":2271,"_30209":2244,"_20922":56327,"_5":14373,"_27447":56233,"_2948":56328},[],"Import keys created externally.",{"_3464":2272,"_30209":2244,"_20922":56330,"_5":14373,"_27447":56233,"_2948":56331},[],"Delegate custody and cryptographic operations to external engines.",{"_3464":2273,"_30209":2244,"_20922":56333,"_5":14373,"_27447":56233,"_2948":56334},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3464":2274,"_30209":2244,"_20922":56336,"_5":14373,"_27447":56237,"_2948":56337},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3464":2275,"_30209":2244,"_20922":56339,"_5":14373,"_27447":56237,"_2948":56340},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3464":2276,"_30209":2244,"_20922":56342,"_5":14373,"_27447":56237,"_2948":56343},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3464":2277,"_30209":2244,"_20922":56345,"_5":14373,"_27447":56241,"_2948":56346},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3464":2278,"_30209":2244,"_20922":56348,"_5":14373,"_27447":56245,"_2948":56349},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3464":2279,"_30209":2244,"_20922":56351,"_5":14373,"_27447":56245,"_2948":56352},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3464":2280,"_30209":2244,"_20922":56354,"_5":14373,"_27447":56249,"_2948":56355},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3464":2281,"_30209":2244,"_20922":56357,"_5":14373,"_27447":56253,"_2948":56358},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3464":2282,"_30209":2244,"_20922":56360,"_5":14373,"_27447":56257,"_2948":56361},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3464":2283,"_30209":2244,"_20922":56363,"_5":14373,"_27447":56261,"_2948":56364},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3464":2284,"_30209":2244,"_20922":56366,"_5":14373,"_27447":56261,"_2948":56367},[],"Lamassu shows the enabled engines in the console.",{"_3464":2285,"_30209":2244,"_20922":56369,"_5":14373,"_27447":56261,"_2948":56370},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3464":2286,"_30209":2244,"_20922":56372,"_5":14373,"_27447":56261,"_2948":56373},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3464":2287,"_30209":2244,"_20922":56375,"_5":14373,"_27447":56265,"_2948":56376},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3464":2288,"_30209":2244,"_20922":56378,"_5":14373,"_27447":56265,"_2948":56379},[],"The table includes the following fields:",{"_3464":2289,"_30209":2244,"_20922":56381,"_5":14373,"_27447":56265,"_2948":56382},[],"**Name**: descriptive name of the key.",{"_3464":2290,"_30209":2244,"_20922":56384,"_5":14373,"_27447":56265,"_2948":56385},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3464":2291,"_30209":2244,"_20922":56387,"_5":14373,"_27447":56265,"_2948":56388},[],"**Strength**: visual indicator of cryptographic strength.",{"_3464":2292,"_30209":2244,"_20922":56390,"_5":14373,"_27447":56265,"_2948":56391},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3464":2293,"_30209":2244,"_20922":56393,"_5":14373,"_27447":56265,"_2948":56394},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3464":2294,"_30209":2244,"_20922":56396,"_5":14373,"_27447":56265,"_2948":56397},[],"**Aliases**: alternative names associated with the key.",{"_3464":2295,"_30209":2244,"_20922":56399,"_5":14373,"_27447":56265,"_2948":56400},[],"**Tags**: labels for classification and search.",{"_3464":2296,"_30209":2244,"_20922":56402,"_5":14373,"_27447":56265,"_2948":56403},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3464":2297,"_30209":2244,"_20922":56405,"_5":14373,"_27447":56265,"_2948":56406},[],"From this view you also reach the most common actions:",{"_3464":2298,"_30209":2244,"_20922":56408,"_5":14373,"_27447":56265,"_2948":56409},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3464":2299,"_30209":2244,"_20922":56411,"_5":14373,"_27447":56265,"_2948":56412},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3464":2300,"_30209":2244,"_20922":56414,"_5":14373,"_27447":56265,"_2948":56415},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3464":2301,"_30209":2244,"_20922":56417,"_5":14373,"_27447":56265,"_2948":56418},[],"**Delete Key** to remove the key from the system.",{"_3464":2302,"_30209":2244,"_20922":56420,"_5":14373,"_27447":56269,"_2948":56421},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3464":2303,"_30209":2244,"_20922":56423,"_5":14373,"_27447":56273,"_2948":56424},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3464":2304,"_30209":2244,"_20922":56426,"_5":14373,"_27447":56273,"_2948":56427},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3464":2305,"_30209":2244,"_20922":56429,"_5":14373,"_27447":56273,"_2948":56430},[],"**Key Name**: unique and descriptive name.",{"_3464":2306,"_30209":2244,"_20922":56432,"_5":14373,"_27447":56273,"_2948":56433},[],"**Crypto Engine**: engine that will keep the key.",{"_3464":2307,"_30209":2244,"_20922":56435,"_5":14373,"_27447":56273,"_2948":56436},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3464":2308,"_30209":2244,"_20922":56438,"_5":14373,"_27447":56273,"_2948":56439},[],"**Tags**: metadata to classify the key.",{"_3464":2309,"_30209":2244,"_20922":56441,"_5":14373,"_27447":56273,"_2948":56442},[],"**Metadata**: additional information for advanced uses.",{"_3464":2310,"_30209":2244,"_20922":56444,"_5":14373,"_27447":56277,"_2948":56445},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3464":2311,"_30209":2244,"_20922":56447,"_5":14373,"_27447":56277,"_2948":56448},[],"When you have an exportable private key and the destination engine supports import.",{"_3464":2312,"_30209":2244,"_20922":56450,"_5":14373,"_27447":56277,"_2948":56451},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3464":2313,"_30209":2244,"_20922":56453,"_5":14373,"_27447":56277,"_2948":56454},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3464":2314,"_30209":2244,"_20922":56456,"_5":14373,"_27447":56277,"_2948":56457},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3464":2315,"_30209":2244,"_20922":56459,"_5":14373,"_27447":56277,"_2948":56460},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3464":2316,"_30209":2244,"_20922":56462,"_5":14373,"_27447":56277,"_2948":56463},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3464":2317,"_30209":2244,"_20922":56465,"_5":14373,"_27447":56277,"_2948":56466},[],"**Tags**: labels for organization and search.",{"_3464":2318,"_30209":2244,"_20922":56468,"_5":14373,"_27447":56277,"_2948":56469},[],"**Metadata**: additional optional information.",{"_3464":2319,"_30209":2244,"_20922":56471,"_5":14373,"_27447":56277,"_2948":56472},[],"**Private Key (PEM)**: private key in PEM format.",{"_3464":2320,"_30209":2244,"_20922":56474,"_5":14373,"_27447":56277,"_2948":56475},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3464":2321,"_30209":2244,"_20922":56477,"_5":14373,"_27447":56281,"_2948":56478},[],"Each registered key has a detail view and several operational actions.",{"_3464":2322,"_30209":2244,"_20922":56480,"_5":14373,"_27447":56285,"_2948":56481},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3464":2323,"_30209":2244,"_20922":56483,"_5":14373,"_27447":56285,"_2948":56484},[],"The **Overview** tab shows, among others, these fields:",{"_3464":2324,"_30209":2244,"_20922":56486,"_5":14373,"_27447":56285,"_2948":56487},[],"**Key Name**: descriptive name.",{"_3464":2325,"_30209":2244,"_20922":56489,"_5":14373,"_27447":56285,"_2948":56490},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3464":2326,"_30209":2244,"_20922":56492,"_5":14373,"_27447":56285,"_2948":56493},[],"**Tags**: associated labels.",{"_3464":2327,"_30209":2244,"_20922":56495,"_5":14373,"_27447":56285,"_2948":56496},[],"**Aliases**: alternative names.",{"_3464":2328,"_30209":2244,"_20922":56498,"_5":14373,"_27447":56285,"_2948":56499},[],"**Crypto Engine**: engine where the key resides.",{"_3464":2329,"_30209":2244,"_20922":56501,"_5":14373,"_27447":56285,"_2948":56502},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3464":2330,"_30209":2244,"_20922":56504,"_5":14373,"_27447":56285,"_2948":56505},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3464":2331,"_30209":2244,"_20922":56507,"_5":14373,"_27447":56285,"_2948":56508},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3464":2332,"_30209":2244,"_20922":56510,"_5":14373,"_27447":56289,"_2948":56511},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3464":2333,"_30209":2244,"_20922":56513,"_5":14373,"_27447":56289,"_2948":56514},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3464":2334,"_30209":2244,"_20922":56516,"_5":14373,"_27447":56289,"_2948":56517},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3464":2335,"_30209":2244,"_20922":56519,"_5":14373,"_27447":56293,"_2948":56520},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3464":2336,"_30209":2244,"_20922":56522,"_5":14373,"_27447":56293,"_2948":56523},[],"Main fields:",{"_3464":2337,"_30209":2244,"_20922":56525,"_5":14373,"_27447":56293,"_2948":56526},[],"**Algorithm**: signing algorithm available for the key type.",{"_3464":2338,"_30209":2244,"_20922":56528,"_5":14373,"_27447":56293,"_2948":56529},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3464":2339,"_30209":2244,"_20922":56531,"_5":14373,"_27447":56293,"_2948":56532},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3464":2340,"_30209":2244,"_20922":56534,"_5":14373,"_27447":56293,"_2948":56535},[],"**Message**: content to sign.",{"_3464":2341,"_30209":2244,"_20922":56537,"_5":14373,"_27447":56293,"_2948":56538},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3464":2342,"_30209":2244,"_20922":56540,"_5":14373,"_27447":56297,"_2948":56541},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3464":2343,"_30209":2244,"_20922":56543,"_5":14373,"_27447":56297,"_2948":56523},[],{"_3464":2344,"_30209":2244,"_20922":56545,"_5":14373,"_27447":56297,"_2948":56546},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3464":2345,"_30209":2244,"_20922":56548,"_5":14373,"_27447":56297,"_2948":56549},[],"**Message Type**: `Raw` or `Digest`.",{"_3464":2346,"_30209":2244,"_20922":56551,"_5":14373,"_27447":56297,"_2948":56552},[],"**Payload Encoding**: encoding of the message.",{"_3464":2347,"_30209":2244,"_20922":56554,"_5":14373,"_27447":56297,"_2948":56555},[],"**Message**: original message or hash.",{"_3464":2348,"_30209":2244,"_20922":56557,"_5":14373,"_27447":56297,"_2948":56558},[],"**Signature**: signature to check.",{"_3464":2349,"_30209":2244,"_20922":56560,"_5":14373,"_27447":56297,"_2948":56561},[],"**Result**: indicator of the validation result.",{"_3464":2350,"_30209":2244,"_20922":56563,"_5":14373,"_27447":56301,"_2948":56564},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3464":2351,"_30209":2244,"_20922":56566,"_5":14373,"_27447":56301,"_2948":56567},[],"This flow is useful for:",{"_3464":2352,"_30209":2244,"_20922":56569,"_5":14373,"_27447":56301,"_2948":56570},[],"Requesting certificates from an external CA.",{"_3464":2353,"_30209":2244,"_20922":56572,"_5":14373,"_27447":56301,"_2948":56573},[],"Renewing an identity while keeping the same key.",{"_3464":2354,"_30209":2244,"_20922":56575,"_5":14373,"_27447":56301,"_2948":56576},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3464":2355,"_30209":2244,"_20922":56578,"_5":14373,"_27447":56301,"_2948":56579},[],"**Common Name (CN)**: main name of the identity.",{"_3464":2356,"_30209":2244,"_20922":56581,"_5":14373,"_27447":56301,"_2948":56582},[],"**Organization (O)**: organization or company.",{"_3464":2357,"_30209":2244,"_20922":56584,"_5":14373,"_27447":56301,"_2948":56585},[],"**Organizational Unit (OU)**: department or unit.",{"_3464":2358,"_30209":2244,"_20922":56587,"_5":14373,"_27447":56301,"_2948":56588},[],"**Country (C)**: two-letter country code.",{"_3464":2359,"_30209":2244,"_20922":56590,"_5":14373,"_27447":56301,"_2948":56591},[],"**State / Province (ST)**: state or province.",{"_3464":2360,"_30209":2244,"_20922":56593,"_5":14373,"_27447":56301,"_2948":56594},[],"**Locality (L)**: city or locality.",{"_3464":2361,"_30209":2244,"_20922":56596,"_5":14373,"_27447":56301,"_2948":56597},[],"**Email Address**: contact email.",{"_3464":2362,"_30209":2244,"_20922":56599,"_5":14373,"_27447":56301,"_2948":56600},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3464":2363,"_30209":2244,"_20922":56602,"_5":14373,"_27447":56301,"_2948":56603},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3464":2364,"_30209":2244,"_20922":56605,"_5":14373,"_27447":56305,"_2948":56606},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3464":2365,"_30209":2244,"_20922":56608,"_5":14373,"_27447":56305,"_2948":56609},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3464":2366,"_30209":2244,"_20922":56611,"_5":14373,"_27447":56309,"_2948":56612},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3464":2367,"_30209":2244,"_20922":56614,"_5":14373,"_27447":56309,"_2948":56615},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3464":2368,"_30209":2368,"_5":14725,"_2948":56617,"_30541":56618,"_20922":56619,"_27447":2368},"Online validation with OCSP",[49244,50719,54724,55363],[],{"_3464":2369,"_30209":2368,"_20922":56621,"_5":14373,"_27447":2368,"_2948":56622},[],"Query signed status and verify the responder’s response.",{"_3464":2370,"_30209":2368,"_5":30538,"_20922":56624,"_27447":56625,"_2948":56626},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3464":2371,"_30209":2368,"_5":30538,"_20922":56628,"_27447":56629,"_2948":56630},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3464":2372,"_30209":2368,"_5":30538,"_20922":56632,"_27447":56633,"_2948":56634},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3464":2373,"_30209":2368,"_5":30538,"_20922":56636,"_27447":56637,"_2948":56638},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3464":2374,"_30209":2368,"_5":30538,"_20922":56640,"_27447":56641,"_2948":56642},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3464":2375,"_30209":2368,"_5":30538,"_20922":56644,"_27447":56645,"_2948":55932},[],"/docs/platform/pki/ocsp#references",{"_3464":2376,"_30209":2368,"_20922":56647,"_5":14373,"_27447":2368,"_2948":56648},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3464":2377,"_30209":2368,"_20922":56650,"_5":14373,"_27447":56625,"_2948":56651},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3464":2378,"_30209":2368,"_20922":56653,"_5":14373,"_27447":56625,"_2948":56654},[],"Record status",{"_3464":2379,"_30209":2368,"_20922":56656,"_5":14373,"_27447":56625,"_2948":56657},[],"Signed response",{"_3464":2380,"_30209":2368,"_20922":56659,"_5":14373,"_27447":56625,"_2948":53861},[],{"_3464":2381,"_30209":2368,"_20922":56661,"_5":14373,"_27447":56625,"_2948":56662},[],"`Good`.",{"_3464":2382,"_30209":2368,"_20922":56664,"_5":14373,"_27447":56625,"_2948":53878},[],{"_3464":2383,"_30209":2368,"_20922":56666,"_5":14373,"_27447":56625,"_2948":56667},[],"`Revoked`, with revocation reason and timestamp.",{"_3464":2384,"_30209":2368,"_20922":56669,"_5":14373,"_27447":56625,"_2948":56670},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3464":2385,"_30209":2368,"_20922":56672,"_5":14373,"_27447":56625,"_2948":56673},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3464":2386,"_30209":2368,"_20922":56675,"_5":14373,"_27447":56625,"_2948":56676},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3464":2387,"_30209":2368,"_20922":56678,"_5":14373,"_27447":56625,"_2948":56679},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3464":2388,"_30209":2368,"_20922":56681,"_5":14373,"_27447":56625,"_2948":56682},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3464":2389,"_30209":2368,"_20922":56684,"_5":14373,"_27447":56629,"_2948":56685},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3464":2390,"_30209":2368,"_20922":56687,"_5":14373,"_27447":56629,"_2948":56688},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3464":2391,"_30209":2368,"_20922":56690,"_5":14373,"_27447":56633,"_2948":56691},[],"The service accepts:",{"_3464":2392,"_30209":2368,"_20922":56693,"_5":14373,"_27447":56633,"_2948":52489},[],{"_3464":2393,"_30209":2368,"_20922":56695,"_5":14373,"_27447":56633,"_2948":56696},[],"VA service path",{"_3464":2394,"_30209":2368,"_20922":56698,"_5":14373,"_27447":56633,"_2948":56699},[],"Format",{"_3464":2395,"_30209":2368,"_20922":56701,"_5":14373,"_27447":56633,"_2948":56702},[],"`POST`",{"_3464":2396,"_30209":2368,"_20922":56704,"_5":14373,"_27447":56633,"_2948":56705},[],"`/ocsp`",{"_3464":2397,"_30209":2368,"_20922":56707,"_5":14373,"_27447":56633,"_2948":56708},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3464":2398,"_30209":2368,"_20922":56710,"_5":14373,"_27447":56633,"_2948":56114},[],{"_3464":2399,"_30209":2368,"_20922":56712,"_5":14373,"_27447":56633,"_2948":56713},[],"`/ocsp/{ocsp_request}`",{"_3464":2400,"_30209":2368,"_20922":56715,"_5":14373,"_27447":56633,"_2948":56716},[],"DER request encoded using padded URL Base64.",{"_3464":2401,"_30209":2368,"_20922":56718,"_5":14373,"_27447":56633,"_2948":56719},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3464":2402,"_30209":2368,"_20922":56721,"_5":14373,"_27447":56637,"_2948":56722},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3464":2403,"_30209":2368,"_20922":56724,"_5":14373,"_27447":56637,"_2948":56725},[],"Generate the request:",{"_3464":2404,"_30209":2368,"_20922":56727,"_5":14373,"_27447":56637,"_2948":56728},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3464":2405,"_30209":2368,"_20922":56730,"_5":14373,"_27447":56637,"_2948":56731},[],"Replace the example URL with the inspected endpoint:",{"_3464":2406,"_30209":2368,"_20922":56733,"_5":14373,"_27447":56637,"_2948":56734},[],"Verify the returned DER:",{"_3464":2407,"_30209":2368,"_20922":56736,"_5":14373,"_27447":56637,"_2948":56737},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3464":2408,"_30209":2368,"_20922":56739,"_5":14373,"_27447":56641,"_2948":56740},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3464":2409,"_30209":2368,"_20922":56742,"_5":14373,"_27447":56641,"_2948":56743},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3464":2410,"_30209":2368,"_20922":56745,"_5":14373,"_27447":56645,"_2948":56746},[],"RFC 6960: OCSP.",{"_3464":2411,"_30209":2368,"_20922":56748,"_5":14373,"_27447":56645,"_2948":56749},[],"OpenSSL: openssl-ocsp.",{"_3464":2412,"_30209":2368,"_20922":56751,"_5":14373,"_27447":56645,"_2948":56752},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3464":2413,"_30209":2368,"_20922":56754,"_5":14373,"_27447":56645,"_2948":56223},[],{"_3464":2414,"_30209":2414,"_5":14725,"_2948":54724,"_30541":56756,"_20922":56757,"_27447":2414},[49244,50719,54724],[],{"_3464":2415,"_30209":2414,"_20922":56759,"_5":14373,"_27447":2414,"_2948":56760},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3464":2416,"_30209":2414,"_5":30538,"_20922":56762,"_27447":56763,"_2948":54036},[],"/docs/platform/pki/overview#start-here",{"_3464":2417,"_30209":2414,"_5":30538,"_20922":56765,"_27447":56766,"_2948":56767},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3464":2418,"_30209":2414,"_5":30538,"_20922":56769,"_27447":56770,"_2948":54568},[],"/docs/platform/pki/overview#core-capabilities",{"_3464":2419,"_30209":2414,"_5":30538,"_20922":56772,"_27447":56773,"_2948":54572},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3464":2420,"_30209":2414,"_5":30538,"_20922":56775,"_27447":56776,"_2948":54576},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3464":2421,"_30209":2414,"_5":30538,"_20922":56778,"_27447":56779,"_2948":54580},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3464":2422,"_30209":2414,"_5":30538,"_20922":56781,"_27447":56782,"_2948":54588},[],"/docs/platform/pki/overview#publish-validation-status",{"_3464":2423,"_30209":2414,"_5":30538,"_20922":56784,"_27447":56785,"_2948":56786},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3464":2424,"_30209":2414,"_5":30538,"_20922":56788,"_27447":56789,"_2948":55530},[],"/docs/platform/pki/overview#continue",{"_3464":2425,"_30209":2414,"_20922":56791,"_5":14373,"_27447":2414,"_2948":56792},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3464":2426,"_30209":2414,"_20922":56794,"_5":14373,"_27447":56763,"_2948":56795},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3464":2427,"_30209":2414,"_20922":56797,"_5":14373,"_27447":56763,"_2948":56798},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3464":2428,"_30209":2414,"_20922":56800,"_5":14373,"_27447":56766,"_2948":56801},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3464":2429,"_30209":2414,"_20922":56803,"_5":14373,"_27447":56766,"_2948":56804},[],"An available cryptographic engine to keep the authority's key.",{"_3464":2430,"_30209":2414,"_20922":56806,"_5":14373,"_27447":56766,"_2948":56807},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3464":2431,"_30209":2414,"_20922":56809,"_5":14373,"_27447":56766,"_2948":56810},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3464":2432,"_30209":2414,"_20922":56812,"_5":14373,"_27447":56766,"_2948":56813},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3464":2433,"_30209":2414,"_20922":56815,"_5":14373,"_27447":56773,"_2948":56816},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3464":2434,"_30209":2414,"_20922":56818,"_5":14373,"_27447":56776,"_2948":56819},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3464":2435,"_30209":2414,"_20922":56821,"_5":14373,"_27447":56779,"_2948":56822},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3464":2436,"_30209":2414,"_20922":56824,"_5":14373,"_27447":56782,"_2948":56825},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3464":2437,"_30209":2414,"_20922":56827,"_5":14373,"_27447":56785,"_2948":56828},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3464":2438,"_30209":2414,"_20922":56830,"_5":14373,"_27447":56785,"_2948":56831},[],"its subject and extensions identify the expected client;",{"_3464":2439,"_30209":2414,"_20922":56833,"_5":14373,"_27447":56785,"_2948":56834},[],"its public key matches the client's private key;",{"_3464":2440,"_30209":2414,"_20922":56836,"_5":14373,"_27447":56785,"_2948":56837},[],"its chain reaches a root trusted by the consumer;",{"_3464":2441,"_30209":2414,"_20922":56839,"_5":14373,"_27447":56785,"_2948":56840},[],"its dates and usages allow the operation;",{"_3464":2442,"_30209":2414,"_20922":56842,"_5":14373,"_27447":56785,"_2948":56843},[],"the consumer applies revocation checks and authorization.",{"_3464":2443,"_30209":2414,"_20922":56845,"_5":14373,"_27447":56785,"_2948":56846},[],"The issuance path includes the first independent checks.",{"_3464":2444,"_30209":2414,"_20922":56848,"_5":14373,"_27447":56789,"_2948":56849},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":2445,"_30209":2414,"_20922":56851,"_5":14373,"_27447":56789,"_2948":56852},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3464":2446,"_30209":2414,"_20922":56854,"_5":14373,"_27447":56789,"_2948":56855},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3464":2447,"_30209":2447,"_5":14725,"_2948":56857,"_30541":56858,"_20922":56859,"_27447":2447},"Create your first CA",[49244,50719,54724,54161],[],{"_3464":2448,"_30209":2447,"_20922":56861,"_5":14373,"_27447":2447,"_2948":56862},[],"Create an evaluation root and check its certificate before issuing.",{"_3464":2449,"_30209":2447,"_5":30538,"_20922":56864,"_27447":56865,"_2948":49254},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3464":2450,"_30209":2447,"_5":30538,"_20922":56867,"_27447":56868,"_2948":56869},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3464":2451,"_30209":2447,"_5":30538,"_20922":56871,"_27447":56872,"_2948":56873},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3464":2452,"_30209":2447,"_5":30538,"_20922":56875,"_27447":56876,"_2948":56877},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3464":2453,"_30209":2447,"_5":30538,"_20922":56879,"_27447":56880,"_2948":56881},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3464":2454,"_30209":2447,"_5":30538,"_20922":56883,"_27447":56884,"_2948":56885},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3464":2455,"_30209":2447,"_5":30538,"_20922":56887,"_27447":56888,"_2948":56889},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3464":2456,"_30209":2447,"_5":30538,"_20922":56891,"_27447":56892,"_2948":54418},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3464":2457,"_30209":2447,"_5":30538,"_20922":56894,"_27447":56895,"_2948":49278},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3464":2458,"_30209":2447,"_20922":56897,"_5":14373,"_27447":2447,"_2948":56898},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3464":2459,"_30209":2447,"_20922":56900,"_5":14373,"_27447":56865,"_2948":56901},[],"Console access and permission to create keys and authorities.",{"_3464":2460,"_30209":2447,"_20922":56903,"_5":14373,"_27447":56865,"_2948":56904},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3464":2461,"_30209":2447,"_20922":56906,"_5":14373,"_27447":56865,"_2948":56907},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3464":2462,"_30209":2447,"_20922":56909,"_5":14373,"_27447":56865,"_2948":56910},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3464":2463,"_30209":2447,"_20922":56912,"_5":14373,"_27447":56868,"_2948":56913},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3464":2464,"_30209":2447,"_20922":56915,"_5":14373,"_27447":56868,"_2948":56916},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3464":2465,"_30209":2447,"_20922":56918,"_5":14373,"_27447":56872,"_2948":56919},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3464":2466,"_30209":2447,"_20922":56921,"_5":14373,"_27447":56872,"_2948":56922},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3464":2467,"_30209":2447,"_20922":56924,"_5":14373,"_27447":56876,"_2948":56925},[],"Select **Root CA** and complete:",{"_3464":2468,"_30209":2447,"_20922":56927,"_5":14373,"_27447":56876,"_2948":56928},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3464":2469,"_30209":2447,"_20922":56930,"_5":14373,"_27447":56876,"_2948":56931},[],"**Subject**: organization and country details for your evaluation.",{"_3464":2470,"_30209":2447,"_20922":56933,"_5":14373,"_27447":56876,"_2948":56934},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3464":2471,"_30209":2447,"_20922":56936,"_5":14373,"_27447":56876,"_2948":56937},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3464":2472,"_30209":2447,"_20922":56939,"_5":14373,"_27447":56876,"_2948":56940},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3464":2473,"_30209":2447,"_20922":56942,"_5":14373,"_27447":56880,"_2948":56943},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3464":2474,"_30209":2447,"_20922":56945,"_5":14373,"_27447":56884,"_2948":56946},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3464":2475,"_30209":2447,"_20922":56948,"_5":14373,"_27447":56884,"_2948":56949},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3464":2476,"_30209":2447,"_20922":56951,"_5":14373,"_27447":56888,"_2948":56952},[],"Run from the directory where you saved `ca.pem`:",{"_3464":2477,"_30209":2447,"_20922":56954,"_5":14373,"_27447":56888,"_2948":56955},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3464":2478,"_30209":2447,"_20922":56957,"_5":14373,"_27447":56888,"_2948":56958},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3464":2479,"_30209":2447,"_20922":56960,"_5":14373,"_27447":56892,"_2948":56961},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3464":2480,"_30209":2447,"_20922":56963,"_5":14373,"_27447":56892,"_2948":56964},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3464":2481,"_30209":2447,"_20922":56966,"_5":14373,"_27447":56892,"_2948":56967},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3464":2482,"_30209":2447,"_20922":56969,"_5":14373,"_27447":56892,"_2948":56970},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3464":2483,"_30209":2447,"_20922":56972,"_5":14373,"_27447":56895,"_2948":56973},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3464":2484,"_30209":2484,"_5":14725,"_2948":56975,"_30541":56976,"_20922":56977,"_27447":2484},"Issue and verify a certificate",[49244,50719,54724,54161],[],{"_3464":2485,"_30209":2484,"_20922":56979,"_5":14373,"_27447":2484,"_2948":56980},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3464":2486,"_30209":2484,"_5":30538,"_20922":56982,"_27447":56983,"_2948":49254},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3464":2487,"_30209":2484,"_5":30538,"_20922":56985,"_27447":56986,"_2948":56987},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3464":2488,"_30209":2484,"_5":30538,"_20922":56989,"_27447":56990,"_2948":56991},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3464":2489,"_30209":2484,"_5":30538,"_20922":56993,"_27447":56994,"_2948":56995},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3464":2490,"_30209":2484,"_5":30538,"_20922":56997,"_27447":56998,"_2948":56999},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3464":2491,"_30209":2484,"_5":30538,"_20922":57001,"_27447":57002,"_2948":57003},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3464":2492,"_30209":2484,"_5":30538,"_20922":57005,"_27447":57006,"_2948":57007},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3464":2493,"_30209":2484,"_5":30538,"_20922":57009,"_27447":57010,"_2948":57011},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3464":2494,"_30209":2484,"_5":30538,"_20922":57013,"_27447":57014,"_2948":57015},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3464":2495,"_30209":2484,"_5":30538,"_20922":57017,"_27447":57018,"_2948":57019},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3464":2496,"_30209":2484,"_5":30538,"_20922":57021,"_27447":57022,"_2948":54418},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3464":2497,"_30209":2484,"_5":30538,"_20922":57024,"_27447":57025,"_2948":49278},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3464":2498,"_30209":2484,"_20922":57027,"_5":14373,"_27447":2484,"_2948":57028},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3464":2499,"_30209":2484,"_20922":57030,"_5":14373,"_27447":56983,"_2948":57031},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3464":2500,"_30209":2484,"_20922":57033,"_5":14373,"_27447":56983,"_2948":57034},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3464":2501,"_30209":2484,"_20922":57036,"_5":14373,"_27447":56983,"_2948":57037},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3464":2502,"_30209":2484,"_20922":57039,"_5":14373,"_27447":56983,"_2948":57040},[],"A client identifier: here we use `device-001`.",{"_3464":2503,"_30209":2484,"_20922":57042,"_5":14373,"_27447":56983,"_2948":57043},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3464":2504,"_30209":2484,"_20922":57045,"_5":14373,"_27447":56986,"_2948":57046},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3464":2505,"_30209":2484,"_20922":57048,"_5":14373,"_27447":56990,"_2948":57049},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3464":2506,"_30209":2484,"_20922":57051,"_5":14373,"_27447":56990,"_2948":57052},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3464":2507,"_30209":2484,"_20922":57054,"_5":14373,"_27447":56994,"_2948":57055},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3464":2508,"_30209":2484,"_20922":57057,"_5":14373,"_27447":56994,"_2948":57058},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3464":2509,"_30209":2484,"_20922":57060,"_5":14373,"_27447":56998,"_2948":57061},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3464":2510,"_30209":2484,"_20922":57063,"_5":14373,"_27447":56998,"_2948":57064},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3464":2511,"_30209":2484,"_20922":57066,"_5":14373,"_27447":57002,"_2948":57067},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3464":2512,"_30209":2484,"_20922":57069,"_5":14373,"_27447":57006,"_2948":57070},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3464":2513,"_30209":2484,"_20922":57072,"_5":14373,"_27447":57010,"_2948":57073},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3464":2514,"_30209":2484,"_20922":57075,"_5":14373,"_27447":57014,"_2948":57076},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3464":2515,"_30209":2484,"_20922":57078,"_5":14373,"_27447":57014,"_2948":57079},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3464":2516,"_30209":2484,"_20922":57081,"_5":14373,"_27447":57014,"_2948":57082},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3464":2517,"_30209":2484,"_20922":57084,"_5":14373,"_27447":57018,"_2948":57085},[],"In Bash, compare the two public-key digests:",{"_3464":2518,"_30209":2484,"_20922":57087,"_5":14373,"_27447":57018,"_2948":57088},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3464":2519,"_30209":2484,"_20922":57090,"_5":14373,"_27447":57018,"_2948":57091},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3464":2520,"_30209":2484,"_20922":57093,"_5":14373,"_27447":57022,"_2948":54502},[],{"_3464":2521,"_30209":2484,"_20922":57095,"_5":14373,"_27447":57022,"_2948":57096},[],"What to review",{"_3464":2522,"_30209":2484,"_20922":57098,"_5":14373,"_27447":57022,"_2948":57099},[],"The CA rejects issuance",{"_3464":2523,"_30209":2484,"_20922":57101,"_5":14373,"_27447":57022,"_2948":57102},[],"Permissions, CA state and key, algorithm and profile.",{"_3464":2524,"_30209":2484,"_20922":57104,"_5":14373,"_27447":57022,"_2948":57105},[],"Different subject or usages",{"_3464":2525,"_30209":2484,"_20922":57107,"_5":14373,"_27447":57022,"_2948":57108},[],"Applied profile and requested values.",{"_3464":2526,"_30209":2484,"_20922":57110,"_5":14373,"_27447":57022,"_2948":57111},[],"Issuer cannot be found",{"_3464":2527,"_30209":2484,"_20922":57113,"_5":14373,"_27447":57022,"_2948":57114},[],"Downloaded CA and required intermediate chain.",{"_3464":2528,"_30209":2484,"_20922":57116,"_5":14373,"_27447":57022,"_2948":57117},[],"Validity fails",{"_3464":2529,"_30209":2484,"_20922":57119,"_5":14373,"_27447":57022,"_2948":57120},[],"Certificate and CA dates, and the computer's clock.",{"_3464":2530,"_30209":2484,"_20922":57122,"_5":14373,"_27447":57022,"_2948":57123},[],"Public-key digests differ",{"_3464":2531,"_30209":2484,"_20922":57125,"_5":14373,"_27447":57022,"_2948":57126},[],"Certificate and key files from the same issuance.",{"_3464":2532,"_30209":2484,"_20922":57128,"_5":14373,"_27447":57022,"_2948":57129},[],"See PKI diagnostics to narrow an issuance failure.",{"_3464":2533,"_30209":2484,"_20922":57131,"_5":14373,"_27447":57025,"_2948":57132},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3464":2534,"_30209":2484,"_20922":57134,"_5":14373,"_27447":57025,"_2948":57135},[],"Manage certificates for inspection, status and revocation.",{"_3464":2535,"_30209":2484,"_20922":57137,"_5":14373,"_27447":57025,"_2948":57138},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3464":2536,"_30209":2484,"_20922":57140,"_5":14373,"_27447":57025,"_2948":57141},[],"Prepare EST for the device to request its next identities.",{"_3464":2537,"_30209":2484,"_20922":57143,"_5":14373,"_27447":57025,"_2948":57144},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3464":2538,"_30209":2538,"_5":14725,"_2948":57146,"_30541":57147,"_20922":57148,"_27447":2538},"PKI getting started",[49244,50719,54724,54161],[],{"_3464":2539,"_30209":2538,"_20922":57150,"_5":14373,"_27447":2538,"_2948":57151},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3464":2540,"_30209":2538,"_5":30538,"_20922":57153,"_27447":57154,"_2948":49254},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3464":2541,"_30209":2538,"_5":30538,"_20922":57156,"_27447":57157,"_2948":57158},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3464":2542,"_30209":2538,"_5":30538,"_20922":57160,"_27447":57161,"_2948":54353},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3464":2543,"_30209":2538,"_5":30538,"_20922":57163,"_27447":57164,"_2948":57165},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3464":2544,"_30209":2538,"_20922":57167,"_5":14373,"_27447":2538,"_2948":57168},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3464":2545,"_30209":2538,"_20922":57170,"_5":14373,"_27447":57154,"_2948":57171},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3464":2546,"_30209":2538,"_20922":57173,"_5":14373,"_27447":57154,"_2948":57174},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3464":2547,"_30209":2538,"_20922":57176,"_5":14373,"_27447":57154,"_2948":57177},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3464":2548,"_30209":2538,"_20922":57179,"_5":14373,"_27447":57154,"_2948":57180},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3464":2549,"_30209":2538,"_20922":57182,"_5":14373,"_27447":57154,"_2948":57183},[],"A working directory with restricted access for the downloaded key.",{"_3464":2550,"_30209":2538,"_20922":57185,"_5":14373,"_27447":57157,"_2948":57186},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3464":2551,"_30209":2538,"_20922":57188,"_5":14373,"_27447":57157,"_2948":57189},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3464":2552,"_30209":2538,"_20922":57191,"_5":14373,"_27447":57157,"_2948":57192},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3464":2553,"_30209":2538,"_20922":57194,"_5":14373,"_27447":57157,"_2948":57195},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3464":2554,"_30209":2538,"_20922":57197,"_5":14373,"_27447":57161,"_2948":57198},[],"File or resource",{"_3464":2555,"_30209":2538,"_20922":57200,"_5":14373,"_27447":57161,"_2948":54350},[],{"_3464":2556,"_30209":2538,"_20922":57202,"_5":14373,"_27447":57161,"_2948":57203},[],"Active root CA and `ca.pem`",{"_3464":2557,"_30209":2538,"_20922":57205,"_5":14373,"_27447":57161,"_2948":57206},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3464":2558,"_30209":2538,"_20922":57208,"_5":14373,"_27447":57161,"_2948":57209},[],"End-entity certificate and `device.crt`",{"_3464":2559,"_30209":2538,"_20922":57211,"_5":14373,"_27447":57161,"_2948":57212},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3464":2560,"_30209":2538,"_20922":57214,"_5":14373,"_27447":57161,"_2948":57215},[],"Private key `device.key`",{"_3464":2561,"_30209":2538,"_20922":57217,"_5":14373,"_27447":57161,"_2948":57218},[],"Its public key matches the one included in `device.crt`.",{"_3464":2562,"_30209":2538,"_20922":57220,"_5":14373,"_27447":57161,"_2948":57221},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3464":2563,"_30209":2538,"_20922":57223,"_5":14373,"_27447":57164,"_2948":57224},[],"To operate certificates, continue with Certificates and Validation.",{"_3464":2564,"_30209":2538,"_20922":57226,"_5":14373,"_27447":57164,"_2948":57227},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3464":2565,"_30209":2538,"_20922":57229,"_5":14373,"_27447":57164,"_2948":57230},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3464":2566,"_30209":2566,"_5":14725,"_2948":57232,"_30541":57233,"_20922":57234,"_27447":2566},"PKI troubleshooting",[49244,50719,54724,53299],[],{"_3464":2567,"_30209":2566,"_20922":57236,"_5":14373,"_27447":2566,"_2948":57237},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3464":2568,"_30209":2566,"_5":30538,"_20922":57239,"_27447":57240,"_2948":57241},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3464":2569,"_30209":2566,"_5":30538,"_20922":57243,"_27447":57244,"_2948":57245},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3464":2570,"_30209":2566,"_5":30538,"_20922":57247,"_27447":57248,"_2948":57249},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3464":2571,"_30209":2566,"_20922":57251,"_5":14373,"_27447":2566,"_2948":57252},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3464":2572,"_30209":2566,"_20922":57254,"_5":14373,"_27447":2566,"_2948":57255},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3464":2573,"_30209":2566,"_20922":57257,"_5":14373,"_27447":57240,"_2948":54350},[],{"_3464":2574,"_30209":2566,"_20922":57259,"_5":14373,"_27447":57240,"_2948":57260},[],"What to inspect",{"_3464":2575,"_30209":2566,"_20922":57262,"_5":14373,"_27447":57240,"_2948":49278},[],{"_3464":2576,"_30209":2566,"_20922":57264,"_5":14373,"_27447":57240,"_2948":53566},[],{"_3464":2577,"_30209":2566,"_20922":57266,"_5":14373,"_27447":57240,"_2948":57267},[],"Exists, is active and has usable dates.",{"_3464":2578,"_30209":2566,"_20922":57269,"_5":14373,"_27447":57240,"_2948":57270},[],"Authorities.",{"_3464":2579,"_30209":2566,"_20922":57272,"_5":14373,"_27447":57240,"_2948":57273},[],"Key",{"_3464":2580,"_30209":2566,"_20922":57275,"_5":14373,"_27447":57240,"_2948":57276},[],"The record has a usable private key and the engine can sign.",{"_3464":2581,"_30209":2566,"_20922":57278,"_5":14373,"_27447":57240,"_2948":57279},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3464":2582,"_30209":2566,"_20922":57281,"_5":14373,"_27447":57240,"_2948":57282},[],"CSR",{"_3464":2583,"_30209":2566,"_20922":57284,"_5":14373,"_27447":57240,"_2948":57285},[],"Correct PEM and verifiable signature.",{"_3464":2584,"_30209":2566,"_20922":57287,"_5":14373,"_27447":57240,"_2948":57288},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3464":2585,"_30209":2566,"_20922":57290,"_5":14373,"_27447":57240,"_2948":57291},[],"Profile",{"_3464":2586,"_30209":2566,"_20922":57293,"_5":14373,"_27447":57240,"_2948":57294},[],"Selected source, existing ID, allowed algorithm and size.",{"_3464":2587,"_30209":2566,"_20922":57296,"_5":14373,"_27447":57240,"_2948":57297},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3464":2588,"_30209":2566,"_20922":57299,"_5":14373,"_27447":57240,"_2948":54502},[],{"_3464":2589,"_30209":2566,"_20922":57301,"_5":14373,"_27447":57240,"_2948":57302},[],"Appropriate subject, SAN, usages and dates.",{"_3464":2590,"_30209":2566,"_20922":57304,"_5":14373,"_27447":57240,"_2948":57305},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3464":2591,"_30209":2566,"_20922":57307,"_5":14373,"_27447":57240,"_2948":57308},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3464":2592,"_30209":2566,"_20922":57310,"_5":14373,"_27447":57240,"_2948":57311},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3464":2593,"_30209":2566,"_20922":57313,"_5":14373,"_27447":57244,"_2948":57314},[],"Check each boundary independently:",{"_3464":2594,"_30209":2566,"_20922":57316,"_5":14373,"_27447":57244,"_2948":57317},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3464":2595,"_30209":2566,"_20922":57319,"_5":14373,"_27447":57244,"_2948":57320},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3464":2596,"_30209":2566,"_20922":57322,"_5":14373,"_27447":57244,"_2948":57323},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3464":2597,"_30209":2566,"_20922":57325,"_5":14373,"_27447":57244,"_2948":57326},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3464":2598,"_30209":2566,"_20922":57328,"_5":14373,"_27447":57244,"_2948":57329},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3464":2599,"_30209":2566,"_20922":57331,"_5":14373,"_27447":57244,"_2948":57332},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3464":2600,"_30209":2566,"_20922":57334,"_5":14373,"_27447":57248,"_2948":57335},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3464":2601,"_30209":2566,"_20922":57337,"_5":14373,"_27447":57248,"_2948":57338},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3464":2602,"_30209":2602,"_5":14725,"_2948":57340,"_30541":57341,"_20922":57342,"_27447":2602},"Security",[49244],[],{"_3464":2603,"_30209":2602,"_20922":57344,"_5":14373,"_27447":2602,"_2948":57345},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3464":2604,"_30209":2602,"_5":30538,"_20922":57347,"_27447":57348,"_2948":57349},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3464":2605,"_30209":2602,"_5":30538,"_20922":57351,"_27447":57352,"_2948":57353},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3464":2606,"_30209":2602,"_5":30538,"_20922":57355,"_27447":57356,"_2948":57357},[],"/docs/security#supported-versions","Supported versions",{"_3464":2607,"_30209":2602,"_5":30538,"_20922":57359,"_27447":57360,"_2948":57361},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3464":2608,"_30209":2602,"_20922":57363,"_5":14373,"_27447":2602,"_2948":57364},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3464":2609,"_30209":2602,"_20922":57366,"_5":14373,"_27447":57348,"_2948":57367},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3464":2610,"_30209":2602,"_20922":57369,"_5":14373,"_27447":57348,"_2948":57370},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3464":2611,"_30209":2602,"_20922":57372,"_5":14373,"_27447":57348,"_2948":14997},[],{"_3464":2612,"_30209":2602,"_20922":57374,"_5":14373,"_27447":57348,"_2948":14937},[],{"_3464":2613,"_30209":2602,"_20922":57376,"_5":14373,"_27447":57348,"_2948":14984},[],{"_3464":2614,"_30209":2602,"_20922":57378,"_5":14373,"_27447":57348,"_2948":57379},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3464":2615,"_30209":2602,"_20922":57381,"_5":14373,"_27447":57348,"_2948":57382},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3464":2616,"_30209":2602,"_20922":57384,"_5":14373,"_27447":57352,"_2948":57385},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3464":2617,"_30209":2602,"_20922":57387,"_5":14373,"_27447":57352,"_2948":57388},[],"Do not include in the report:",{"_3464":2618,"_30209":2602,"_20922":57390,"_5":14373,"_27447":57352,"_2948":57391},[],"Credentials, tokens, or private keys",{"_3464":2619,"_30209":2602,"_20922":57393,"_5":14373,"_27447":57352,"_2948":57394},[],"Customer data or customer-identifiable information",{"_3464":2620,"_30209":2602,"_20922":57396,"_5":14373,"_27447":57352,"_2948":57397},[],"Confidential architecture or internal infrastructure details",{"_3464":2621,"_30209":2602,"_20922":57399,"_5":14373,"_27447":57356,"_2948":57400},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3464":2622,"_30209":2602,"_20922":57402,"_5":14373,"_27447":57356,"_2948":57403},[],"For upgrade guidance, see Upgrades.",{"_3464":2623,"_30209":2602,"_20922":57405,"_5":14373,"_27447":57360,"_2948":57406},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3464":2624,"_30209":2602,"_20922":57408,"_5":14373,"_27447":57360,"_2948":57409},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3464":2625,"_30209":2602,"_20922":57411,"_5":14373,"_27447":57360,"_2948":57412},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3464":2626,"_30209":2602,"_20922":57414,"_5":14373,"_27447":57360,"_2948":57415},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3464":2627,"_30209":2602,"_20922":57417,"_5":14373,"_27447":57360,"_2948":57418},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3464":2628,"_30209":2628,"_5":14725,"_2948":57420,"_30541":57421,"_20922":57423,"_27447":2628},"3.8.0 to 4.0.0",[49244,57422],"Upgrades",[],{"_3464":2629,"_30209":2628,"_20922":57425,"_5":14373,"_27447":2628,"_2948":57426},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3464":2630,"_30209":2628,"_5":30538,"_20922":57428,"_27447":57429,"_2948":57430},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3464":2631,"_30209":2628,"_5":30538,"_20922":57432,"_27447":57433,"_2948":57434},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3464":2632,"_30209":2628,"_5":30538,"_20922":57436,"_27447":57437,"_2948":57438},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3464":2633,"_30209":2628,"_5":30538,"_20922":57440,"_27447":57441,"_2948":57442},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3464":2634,"_30209":2628,"_5":30538,"_20922":57444,"_27447":57445,"_2948":57446},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3464":2635,"_30209":2628,"_5":30538,"_20922":57448,"_27447":57449,"_2948":57450},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3464":2636,"_30209":2628,"_5":30538,"_20922":57452,"_27447":57453,"_2948":57454},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3464":2637,"_30209":2628,"_5":30538,"_20922":57456,"_27447":57457,"_2948":57458},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3464":2638,"_30209":2628,"_5":30538,"_20922":57460,"_27447":57461,"_2948":57462},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3464":2639,"_30209":2628,"_5":30538,"_20922":57464,"_27447":57465,"_2948":57466},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3464":2640,"_30209":2628,"_5":30538,"_20922":57468,"_27447":57469,"_2948":57470},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3464":2641,"_30209":2628,"_5":30538,"_20922":57472,"_27447":57473,"_2948":57474},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3464":2642,"_30209":2628,"_5":30538,"_20922":57476,"_27447":57477,"_2948":57478},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3464":2643,"_30209":2628,"_5":30538,"_20922":57480,"_27447":57481,"_2948":57482},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3464":2644,"_30209":2628,"_5":30538,"_20922":57484,"_27447":57485,"_2948":57486},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3464":2645,"_30209":2628,"_5":30538,"_20922":57488,"_27447":57489,"_2948":57490},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3464":2646,"_30209":2628,"_5":30538,"_20922":57492,"_27447":57493,"_2948":57494},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3464":2647,"_30209":2628,"_5":30538,"_20922":57496,"_27447":57497,"_2948":57498},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3464":2648,"_30209":2628,"_5":30538,"_20922":57500,"_27447":57501,"_2948":57502},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3464":2649,"_30209":2628,"_5":30538,"_20922":57504,"_27447":57505,"_2948":57506},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3464":2650,"_30209":2628,"_5":30538,"_20922":57508,"_27447":57509,"_2948":57510},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3464":2651,"_30209":2628,"_5":30538,"_20922":57512,"_27447":57513,"_2948":57514},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3464":2652,"_30209":2628,"_5":30538,"_20922":57516,"_27447":57517,"_2948":57518},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3464":2653,"_30209":2628,"_5":30538,"_20922":57520,"_27447":57521,"_2948":57522},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3464":2654,"_30209":2628,"_5":30538,"_20922":57524,"_27447":57525,"_2948":57526},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3464":2655,"_30209":2628,"_5":30538,"_20922":57528,"_27447":57529,"_2948":57530},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3464":2656,"_30209":2628,"_5":30538,"_20922":57532,"_27447":57533,"_2948":57534},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3464":2657,"_30209":2628,"_5":30538,"_20922":57536,"_27447":57537,"_2948":57538},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3464":2658,"_30209":2628,"_5":30538,"_20922":57540,"_27447":57541,"_2948":57542},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3464":2659,"_30209":2628,"_5":30538,"_20922":57544,"_27447":57545,"_2948":57546},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3464":2660,"_30209":2628,"_5":30538,"_20922":57548,"_27447":57549,"_2948":57550},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3464":2661,"_30209":2628,"_5":30538,"_20922":57552,"_27447":57553,"_2948":57554},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3464":2662,"_30209":2628,"_5":30538,"_20922":57556,"_27447":57557,"_2948":57558},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3464":2663,"_30209":2628,"_5":30538,"_20922":57560,"_27447":57561,"_2948":57562},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3464":2664,"_30209":2628,"_5":30538,"_20922":57564,"_27447":57565,"_2948":57566},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3464":2665,"_30209":2628,"_5":30538,"_20922":57568,"_27447":57569,"_2948":57570},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3464":2666,"_30209":2628,"_5":30538,"_20922":57572,"_27447":57573,"_2948":57574},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3464":2667,"_30209":2628,"_5":30538,"_20922":57576,"_27447":57577,"_2948":57578},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3464":2668,"_30209":2628,"_5":30538,"_20922":57580,"_27447":57581,"_2948":57582},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3464":2669,"_30209":2628,"_5":30538,"_20922":57584,"_27447":57585,"_2948":57586},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3464":2670,"_30209":2628,"_5":30538,"_20922":57588,"_27447":57589,"_2948":53299},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3464":2671,"_30209":2628,"_5":30538,"_20922":57591,"_27447":57592,"_2948":57593},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3464":2672,"_30209":2628,"_5":30538,"_20922":57595,"_27447":57596,"_2948":57597},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3464":2673,"_30209":2628,"_20922":57599,"_5":14373,"_27447":2628,"_2948":57600},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3464":2674,"_30209":2628,"_20922":57602,"_5":14373,"_27447":2628,"_2948":57603},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3464":2675,"_30209":2628,"_20922":57605,"_5":14373,"_27447":2628,"_2948":57606},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3464":2676,"_30209":2628,"_20922":57608,"_5":14373,"_27447":2628,"_2948":57609},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3464":2677,"_30209":2628,"_20922":57611,"_5":14373,"_27447":2628,"_2948":57612},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3464":2678,"_30209":2628,"_20922":57614,"_5":14373,"_27447":2628,"_2948":57615},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3464":2679,"_30209":2628,"_20922":57617,"_5":14373,"_27447":2628,"_2948":57618},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3464":2680,"_30209":2628,"_20922":57620,"_5":14373,"_27447":57433,"_2948":57621},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3464":2681,"_30209":2628,"_20922":57623,"_5":14373,"_27447":57433,"_2948":57624},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3464":2682,"_30209":2628,"_20922":57626,"_5":14373,"_27447":57437,"_2948":57627},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3464":2683,"_30209":2628,"_20922":57629,"_5":14373,"_27447":57437,"_2948":57630},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3464":2684,"_30209":2628,"_20922":57632,"_5":14373,"_27447":57441,"_2948":57633},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3464":2685,"_30209":2628,"_20922":57635,"_5":14373,"_27447":57445,"_2948":57636},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3464":2686,"_30209":2628,"_20922":57638,"_5":14373,"_27447":57445,"_2948":57639},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3464":2687,"_30209":2628,"_20922":57641,"_5":14373,"_27447":57445,"_2948":57642},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3464":2688,"_30209":2628,"_20922":57644,"_5":14373,"_27447":57445,"_2948":57645},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3464":2689,"_30209":2628,"_20922":57647,"_5":14373,"_27447":57445,"_2948":57648},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3464":2690,"_30209":2628,"_20922":57650,"_5":14373,"_27447":57449,"_2948":57651},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3464":2691,"_30209":2628,"_20922":57653,"_5":14373,"_27447":57449,"_2948":57654},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3464":2692,"_30209":2628,"_20922":57656,"_5":14373,"_27447":57449,"_2948":57657},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3464":2693,"_30209":2628,"_20922":57659,"_5":14373,"_27447":57449,"_2948":57660},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3464":2694,"_30209":2628,"_20922":57662,"_5":14373,"_27447":57449,"_2948":57663},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3464":2695,"_30209":2628,"_20922":57665,"_5":14373,"_27447":57449,"_2948":57666},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3464":2696,"_30209":2628,"_20922":57668,"_5":14373,"_27447":57453,"_2948":57669},[],"Change",{"_3464":2697,"_30209":2628,"_20922":57671,"_5":14373,"_27447":57453,"_2948":57672},[],"Who is affected",{"_3464":2698,"_30209":2628,"_20922":57674,"_5":14373,"_27447":57453,"_2948":57675},[],"Severity",{"_3464":2699,"_30209":2628,"_20922":57677,"_5":14373,"_27447":57453,"_2948":56151},[],{"_3464":2700,"_30209":2628,"_20922":57679,"_5":14373,"_27447":57453,"_2948":57462},[],{"_3464":2701,"_30209":2628,"_20922":57681,"_5":14373,"_27447":57453,"_2948":57682},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3464":2702,"_30209":2628,"_20922":57684,"_5":14373,"_27447":57453,"_2948":57685},[],"High: KMS and VA start on empty volumes",{"_3464":2703,"_30209":2628,"_20922":57687,"_5":14373,"_27447":57453,"_2948":57688},[],"Copy the data into the new volumes",{"_3464":2704,"_30209":2628,"_20922":57690,"_5":14373,"_27447":57453,"_2948":57466},[],{"_3464":2705,"_30209":2628,"_20922":57692,"_5":14373,"_27447":57453,"_2948":57693},[],"Every Helm release",{"_3464":2706,"_30209":2628,"_20922":57695,"_5":14373,"_27447":57453,"_2948":57696},[],"High: `helm upgrade` fails",{"_3464":2707,"_30209":2628,"_20922":57698,"_5":14373,"_27447":57453,"_2948":57699},[],"Remove or rename legacy keys",{"_3464":2708,"_30209":2628,"_20922":57701,"_5":14373,"_27447":57453,"_2948":57470},[],{"_3464":2709,"_30209":2628,"_20922":57703,"_5":14373,"_27447":57453,"_2948":57704},[],"Every deployment",{"_3464":2710,"_30209":2628,"_20922":57706,"_5":14373,"_27447":57453,"_2948":57707},[],"High: without a bootstrap principal there is no administrator",{"_3464":2711,"_30209":2628,"_20922":57709,"_5":14373,"_27447":57453,"_2948":57710},[],"Configure `services.authz`",{"_3464":2712,"_30209":2628,"_20922":57712,"_5":14373,"_27447":57453,"_2948":57474},[],{"_3464":2713,"_30209":2628,"_20922":57714,"_5":14373,"_27447":57453,"_2948":57693},[],{"_3464":2714,"_30209":2628,"_20922":57716,"_5":14373,"_27447":57453,"_2948":57717},[],"High: `helm upgrade` fails on the old keys",{"_3464":2715,"_30209":2628,"_20922":57719,"_5":14373,"_27447":57453,"_2948":57720},[],"Move JWKS and roles into `services.authz`",{"_3464":2716,"_30209":2628,"_20922":57722,"_5":14373,"_27447":57453,"_2948":57494},[],{"_3464":2717,"_30209":2628,"_20922":57724,"_5":14373,"_27447":57453,"_2948":57725},[],"3.8.0 deployments with per-service databases",{"_3464":2718,"_30209":2628,"_20922":57727,"_5":14373,"_27447":57453,"_2948":57728},[],"High: services find no data, or a migration aborts",{"_3464":2719,"_30209":2628,"_20922":57730,"_5":14373,"_27447":57453,"_2948":57731},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3464":2720,"_30209":2628,"_20922":57733,"_5":14373,"_27447":57453,"_2948":57498},[],{"_3464":2721,"_30209":2628,"_20922":57735,"_5":14373,"_27447":57453,"_2948":57736},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3464":2722,"_30209":2628,"_20922":57738,"_5":14373,"_27447":57453,"_2948":57739},[],"High: the backend no longer starts with them",{"_3464":2723,"_30209":2628,"_20922":57741,"_5":14373,"_27447":57453,"_2948":57742},[],"Move to PostgreSQL before upgrading",{"_3464":2724,"_30209":2628,"_20922":57744,"_5":14373,"_27447":57453,"_2948":57542},[],{"_3464":2725,"_30209":2628,"_20922":57746,"_5":14373,"_27447":57453,"_2948":57747},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3464":2726,"_30209":2628,"_20922":57749,"_5":14373,"_27447":57453,"_2948":57750},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3464":2727,"_30209":2628,"_20922":57752,"_5":14373,"_27447":57453,"_2948":57753},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3464":2728,"_30209":2628,"_20922":57755,"_5":14373,"_27447":57453,"_2948":57756},[],"Webhooks with file references",{"_3464":2729,"_30209":2628,"_20922":57758,"_5":14373,"_27447":57453,"_2948":57759},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3464":2730,"_30209":2628,"_20922":57761,"_5":14373,"_27447":57453,"_2948":57762},[],"High: enrollments calling the webhook fail",{"_3464":2731,"_30209":2628,"_20922":57764,"_5":14373,"_27447":57453,"_2948":57765},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3464":2732,"_30209":2628,"_20922":57767,"_5":14373,"_27447":57453,"_2948":57478},[],{"_3464":2733,"_30209":2628,"_20922":57769,"_5":14373,"_27447":57453,"_2948":57770},[],"Releases with per-service identity overrides or mounted key material",{"_3464":2734,"_30209":2628,"_20922":57772,"_5":14373,"_27447":57453,"_2948":57773},[],"Medium: services cannot read their files",{"_3464":2735,"_30209":2628,"_20922":57775,"_5":14373,"_27447":57453,"_2948":57776},[],"Remove the overrides and fix volume ownership",{"_3464":2736,"_30209":2628,"_20922":57778,"_5":14373,"_27447":57453,"_2948":57482},[],{"_3464":2737,"_30209":2628,"_20922":57780,"_5":14373,"_27447":57453,"_2948":57781},[],"Releases that set `amqp.tls`",{"_3464":2738,"_30209":2628,"_20922":57783,"_5":14373,"_27447":57453,"_2948":57784},[],"Medium: clients connect to the wrong port",{"_3464":2739,"_30209":2628,"_20922":57786,"_5":14373,"_27447":57453,"_2948":57787},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3464":2740,"_30209":2628,"_20922":57789,"_5":14373,"_27447":57453,"_2948":57502},[],{"_3464":2741,"_30209":2628,"_20922":57791,"_5":14373,"_27447":57453,"_2948":57792},[],"Installations whose CA keys predate the KMS",{"_3464":2742,"_30209":2628,"_20922":57794,"_5":14373,"_27447":57453,"_2948":57795},[],"Medium: CA keys stay unmanaged",{"_3464":2743,"_30209":2628,"_20922":57797,"_5":14373,"_27447":57453,"_2948":57798},[],"Run the CA-to-KMS migration",{"_3464":2744,"_30209":2628,"_20922":57800,"_5":14373,"_27447":57453,"_2948":57801},[],"Receiver certificate verification",{"_3464":2745,"_30209":2628,"_20922":57803,"_5":14373,"_27447":57453,"_2948":57804},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3464":2746,"_30209":2628,"_20922":57806,"_5":14373,"_27447":57453,"_2948":57807},[],"Medium: credentials go to an unverified receiver",{"_3464":2747,"_30209":2628,"_20922":57809,"_5":14373,"_27447":57453,"_2948":57810},[],"Set `insecure_skip_verify` to `false`",{"_3464":2748,"_30209":2628,"_20922":57812,"_5":14373,"_27447":57453,"_2948":57518},[],{"_3464":2749,"_30209":2628,"_20922":57814,"_5":14373,"_27447":57453,"_2948":57815},[],"Scripts and consoles that edit DMSs through the API",{"_3464":2750,"_30209":2628,"_20922":57817,"_5":14373,"_27447":57453,"_2948":57818},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3464":2751,"_30209":2628,"_20922":57820,"_5":14373,"_27447":57453,"_2948":57821},[],"Read the DMS before editing and use the new field",{"_3464":2752,"_30209":2628,"_20922":57823,"_5":14373,"_27447":57453,"_2948":57538},[],{"_3464":2753,"_30209":2628,"_20922":57825,"_5":14373,"_27447":57453,"_2948":57826},[],"Clients that create or update CRL settings through the API",{"_3464":2754,"_30209":2628,"_20922":57828,"_5":14373,"_27447":57453,"_2948":57829},[],"Medium: requests with the old field return an error",{"_3464":2755,"_30209":2628,"_20922":57831,"_5":14373,"_27447":57453,"_2948":57832},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3464":2756,"_30209":2628,"_20922":57834,"_5":14373,"_27447":57453,"_2948":57546},[],{"_3464":2757,"_30209":2628,"_20922":57836,"_5":14373,"_27447":57453,"_2948":57837},[],"Alert subscriptions and consumers of the VA events",{"_3464":2758,"_30209":2628,"_20922":57839,"_5":14373,"_27447":57453,"_2948":57840},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3464":2759,"_30209":2628,"_20922":57842,"_5":14373,"_27447":57453,"_2948":57843},[],"Review conditions filtering on the old event payload or subject",{"_3464":2760,"_30209":2628,"_20922":57845,"_5":14373,"_27447":57453,"_2948":57534},[],{"_3464":2761,"_30209":2628,"_20922":57847,"_5":14373,"_27447":57453,"_2948":57848},[],"Consumers that read the device `events` field",{"_3464":2762,"_30209":2628,"_20922":57850,"_5":14373,"_27447":57453,"_2948":57851},[],"Medium: the field disappears",{"_3464":2763,"_30209":2628,"_20922":57853,"_5":14373,"_27447":57453,"_2948":57854},[],"Use the new event endpoints",{"_3464":2764,"_30209":2628,"_20922":57856,"_5":14373,"_27447":57453,"_2948":57554},[],{"_3464":2765,"_30209":2628,"_20922":57858,"_5":14373,"_27447":57453,"_2948":57859},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3464":2766,"_30209":2628,"_20922":57861,"_5":14373,"_27447":57453,"_2948":57862},[],"Medium: the VA migration aborts",{"_3464":2767,"_30209":2628,"_20922":57864,"_5":14373,"_27447":57453,"_2948":57865},[],"Fix the affected roles before upgrading",{"_3464":2768,"_30209":2628,"_20922":57867,"_5":14373,"_27447":57453,"_2948":57486},[],{"_3464":2769,"_30209":2628,"_20922":57869,"_5":14373,"_27447":57453,"_2948":57870},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3464":2770,"_30209":2628,"_20922":57872,"_5":14373,"_27447":57453,"_2948":57873},[],"Low to medium: validation errors or changed defaults",{"_3464":2771,"_30209":2628,"_20922":57875,"_5":14373,"_27447":57453,"_2948":57876},[],"Update the values file",{"_3464":2772,"_30209":2628,"_20922":57878,"_5":14373,"_27447":57453,"_2948":57526},[],{"_3464":2773,"_30209":2628,"_20922":57880,"_5":14373,"_27447":57453,"_2948":57881},[],"Clients that send the DMS ID in the update body",{"_3464":2774,"_30209":2628,"_20922":57883,"_5":14373,"_27447":57453,"_2948":57884},[],"Low: the ID in the URL wins",{"_3464":2775,"_30209":2628,"_20922":57886,"_5":14373,"_27447":57453,"_2948":57887},[],"Send the ID in the URL",{"_3464":2776,"_30209":2628,"_20922":57889,"_5":14373,"_27447":57453,"_2948":57550},[],{"_3464":2777,"_30209":2628,"_20922":57891,"_5":14373,"_27447":57453,"_2948":57892},[],"Clients that send an `id` when creating or importing CAs",{"_3464":2778,"_30209":2628,"_20922":57894,"_5":14373,"_27447":57453,"_2948":57895},[],"Low: the ID in the body is ignored, and the field is removed",{"_3464":2779,"_30209":2628,"_20922":57897,"_5":14373,"_27447":57453,"_2948":57898},[],"Let the backend assign the ID and use the returned one",{"_3464":2780,"_30209":2628,"_20922":57900,"_5":14373,"_27447":57453,"_2948":57530},[],{"_3464":2781,"_30209":2628,"_20922":57902,"_5":14373,"_27447":57453,"_2948":57903},[],"Consumers that match on certificate `type`",{"_3464":2782,"_30209":2628,"_20922":57905,"_5":14373,"_27447":57453,"_2948":57906},[],"Low: two values are renamed",{"_3464":2783,"_30209":2628,"_20922":57908,"_5":14373,"_27447":57453,"_2948":57909},[],"Adapt consumers",{"_3464":2784,"_30209":2628,"_20922":57911,"_5":14373,"_27447":57453,"_2948":57522},[],{"_3464":2785,"_30209":2628,"_20922":57913,"_5":14373,"_27447":57453,"_2948":57914},[],"Any DMS",{"_3464":2786,"_30209":2628,"_20922":57916,"_5":14373,"_27447":57453,"_2948":57917},[],"Low: informational",{"_3464":2787,"_30209":2628,"_20922":57919,"_5":14373,"_27447":57453,"_2948":57920},[],"Read both blocks before editing",{"_3464":2788,"_30209":2628,"_20922":57922,"_5":14373,"_27447":57461,"_2948":57923},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3464":2789,"_30209":2628,"_20922":57925,"_5":14373,"_27447":57461,"_2948":57926},[],"Step 4 of the migration guide copies the data.",{"_3464":2790,"_30209":2628,"_20922":57928,"_5":14373,"_27447":57465,"_2948":57929},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3464":2791,"_30209":2628,"_20922":57931,"_5":14373,"_27447":57469,"_2948":57932},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3464":2792,"_30209":2628,"_20922":57934,"_5":14373,"_27447":57473,"_2948":57935},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3464":2793,"_30209":2628,"_20922":57937,"_5":14373,"_27447":57477,"_2948":57938},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3464":2794,"_30209":2628,"_20922":57940,"_5":14373,"_27447":57477,"_2948":57941},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3464":2795,"_30209":2628,"_20922":57943,"_5":14373,"_27447":57481,"_2948":57944},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3464":2796,"_30209":2628,"_20922":57946,"_5":14373,"_27447":57485,"_2948":57947},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3464":2797,"_30209":2628,"_20922":57949,"_5":14373,"_27447":57485,"_2948":57950},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3464":2798,"_30209":2628,"_20922":57952,"_5":14373,"_27447":57485,"_2948":57953},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3464":2799,"_30209":2628,"_20922":57955,"_5":14373,"_27447":57485,"_2948":57956},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3464":2800,"_30209":2628,"_20922":57958,"_5":14373,"_27447":57485,"_2948":57959},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3464":2801,"_30209":2628,"_20922":57961,"_5":14373,"_27447":57485,"_2948":57962},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3464":2802,"_30209":2628,"_20922":57964,"_5":14373,"_27447":57493,"_2948":57965},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3464":2803,"_30209":2628,"_20922":57967,"_5":14373,"_27447":57493,"_2948":57968},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3464":2804,"_30209":2628,"_20922":57970,"_5":14373,"_27447":57493,"_2948":57971},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3464":2805,"_30209":2628,"_20922":57973,"_5":14373,"_27447":57493,"_2948":57974},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3464":2806,"_30209":2628,"_20922":57976,"_5":14373,"_27447":57493,"_2948":57977},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3464":2807,"_30209":2628,"_20922":57979,"_5":14373,"_27447":57497,"_2948":57980},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3464":2808,"_30209":2628,"_20922":57982,"_5":14373,"_27447":57501,"_2948":57983},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3464":2809,"_30209":2628,"_20922":57985,"_5":14373,"_27447":57501,"_2948":57986},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3464":2810,"_30209":2628,"_20922":57988,"_5":14373,"_27447":57501,"_2948":57989},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3464":2811,"_30209":2628,"_20922":57991,"_5":14373,"_27447":57501,"_2948":57992},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3464":2812,"_30209":2628,"_20922":57994,"_5":14373,"_27447":57501,"_2948":57995},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3464":2813,"_30209":2628,"_20922":57997,"_5":14373,"_27447":57501,"_2948":57998},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3464":2814,"_30209":2628,"_20922":58000,"_5":14373,"_27447":57501,"_2948":58001},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3464":2815,"_30209":2628,"_20922":58003,"_5":14373,"_27447":57501,"_2948":58004},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3464":2816,"_30209":2628,"_20922":58006,"_5":14373,"_27447":57505,"_2948":58007},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3464":2817,"_30209":2628,"_20922":58009,"_5":14373,"_27447":57513,"_2948":58010},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3464":2818,"_30209":2628,"_20922":58012,"_5":14373,"_27447":57513,"_2948":58013},[],"Field in 3.8.0",{"_3464":2819,"_30209":2628,"_20922":58015,"_5":14373,"_27447":57513,"_2948":58016},[],"Field in 4.0.0",{"_3464":2820,"_30209":2628,"_20922":58018,"_5":14373,"_27447":57513,"_2948":58019},[],"`validate_server_cert`",{"_3464":2821,"_30209":2628,"_20922":58021,"_5":14373,"_27447":57513,"_2948":58022},[],"`insecure_skip_verify` (value negated)",{"_3464":2822,"_30209":2628,"_20922":58024,"_5":14373,"_27447":57513,"_2948":58025},[],"`oidc`",{"_3464":2823,"_30209":2628,"_20922":58027,"_5":14373,"_27447":57513,"_2948":58028},[],"`jwt_options`",{"_3464":2824,"_30209":2628,"_20922":58030,"_5":14373,"_27447":57513,"_2948":58031},[],"`apikey`",{"_3464":2825,"_30209":2628,"_20922":58033,"_5":14373,"_27447":57513,"_2948":58034},[],"`apikey_options`",{"_3464":2826,"_30209":2628,"_20922":58036,"_5":14373,"_27447":57513,"_2948":58037},[],"`mtls`",{"_3464":2827,"_30209":2628,"_20922":58039,"_5":14373,"_27447":57513,"_2948":58040},[],"`mtls_options`",{"_3464":2828,"_30209":2628,"_20922":58042,"_5":14373,"_27447":57513,"_2948":58043},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3464":2829,"_30209":2628,"_20922":58045,"_5":14373,"_27447":57513,"_2948":58046},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3464":2830,"_30209":2628,"_20922":58048,"_5":14373,"_27447":57513,"_2948":58049},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3464":2831,"_30209":2628,"_20922":58051,"_5":14373,"_27447":57517,"_2948":58052},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3464":2832,"_30209":2628,"_20922":58054,"_5":14373,"_27447":57517,"_2948":58055},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3464":2833,"_30209":2628,"_20922":58057,"_5":14373,"_27447":57517,"_2948":58058},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3464":2834,"_30209":2628,"_20922":58060,"_5":14373,"_27447":57521,"_2948":58061},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3464":2835,"_30209":2628,"_20922":58063,"_5":14373,"_27447":57525,"_2948":58064},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3464":2836,"_30209":2628,"_20922":58066,"_5":14373,"_27447":57529,"_2948":58067},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3464":2837,"_30209":2628,"_20922":58069,"_5":14373,"_27447":57533,"_2948":58070},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3464":2838,"_30209":2628,"_20922":58072,"_5":14373,"_27447":57533,"_2948":58073},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3464":2839,"_30209":2628,"_20922":58075,"_5":14373,"_27447":57533,"_2948":58076},[],"`POST /v1/devices/:id/events` creates an event.",{"_3464":2840,"_30209":2628,"_20922":58078,"_5":14373,"_27447":57533,"_2948":58079},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3464":2841,"_30209":2628,"_20922":58081,"_5":14373,"_27447":57537,"_2948":58082},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3464":2842,"_30209":2628,"_20922":58084,"_5":14373,"_27447":57541,"_2948":58085},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3464":2843,"_30209":2628,"_20922":58087,"_5":14373,"_27447":57541,"_2948":58088},[],"Route",{"_3464":2844,"_30209":2628,"_20922":58090,"_5":14373,"_27447":57541,"_2948":52486},[],{"_3464":2845,"_30209":2628,"_20922":58092,"_5":14373,"_27447":57541,"_2948":58093},[],"`GET /v1/crl-settings`",{"_3464":2846,"_30209":2628,"_20922":58095,"_5":14373,"_27447":57541,"_2948":58096},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3464":2847,"_30209":2628,"_20922":58098,"_5":14373,"_27447":57541,"_2948":58099},[],"`GET /v1/crl-settings/{ca-id}`",{"_3464":2848,"_30209":2628,"_20922":58101,"_5":14373,"_27447":57541,"_2948":58102},[],"Reads the settings of a CA.",{"_3464":2849,"_30209":2628,"_20922":58104,"_5":14373,"_27447":57541,"_2948":58105},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3464":2850,"_30209":2628,"_20922":58107,"_5":14373,"_27447":57541,"_2948":58108},[],"Replaces `crl_options`.",{"_3464":2851,"_30209":2628,"_20922":58110,"_5":14373,"_27447":57541,"_2948":58111},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3464":2852,"_30209":2628,"_20922":58113,"_5":14373,"_27447":57541,"_2948":58114},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3464":2853,"_30209":2628,"_20922":58116,"_5":14373,"_27447":57541,"_2948":58117},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3464":2854,"_30209":2628,"_20922":58119,"_5":14373,"_27447":57541,"_2948":58120},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3464":2855,"_30209":2628,"_20922":58122,"_5":14373,"_27447":57541,"_2948":58123},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3464":2856,"_30209":2628,"_20922":58125,"_5":14373,"_27447":57541,"_2948":58126},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3464":2857,"_30209":2628,"_20922":58128,"_5":14373,"_27447":57541,"_2948":58129},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3464":2858,"_30209":2628,"_20922":58131,"_5":14373,"_27447":57541,"_2948":58132},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3464":2859,"_30209":2628,"_20922":58134,"_5":14373,"_27447":57541,"_2948":58135},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3464":2860,"_30209":2628,"_20922":58137,"_5":14373,"_27447":57541,"_2948":58138},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3464":2861,"_30209":2628,"_20922":58140,"_5":14373,"_27447":57541,"_2948":58141},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3464":2862,"_30209":2628,"_20922":58143,"_5":14373,"_27447":57545,"_2948":58144},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3464":2863,"_30209":2628,"_20922":58146,"_5":14373,"_27447":57549,"_2948":58147},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3464":2864,"_30209":2628,"_20922":58149,"_5":14373,"_27447":57553,"_2948":58150},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3464":2865,"_30209":2628,"_20922":58152,"_5":14373,"_27447":57557,"_2948":58153},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3464":2866,"_30209":2628,"_20922":58155,"_5":14373,"_27447":57561,"_2948":58156},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3464":2867,"_30209":2628,"_20922":58158,"_5":14373,"_27447":57561,"_2948":58159},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3464":2868,"_30209":2628,"_20922":58161,"_5":14373,"_27447":57561,"_2948":58162},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3464":2869,"_30209":2628,"_20922":58164,"_5":14373,"_27447":57561,"_2948":58165},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3464":2870,"_30209":2628,"_20922":58167,"_5":14373,"_27447":57561,"_2948":58168},[],"Record the names of your local-storage PVCs:",{"_3464":2871,"_30209":2628,"_20922":58170,"_5":14373,"_27447":57561,"_2948":58171},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3464":2872,"_30209":2628,"_20922":58173,"_5":14373,"_27447":57565,"_2948":58174},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3464":2873,"_30209":2628,"_20922":58176,"_5":14373,"_27447":57565,"_2948":58177},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3464":2874,"_30209":2628,"_20922":58179,"_5":14373,"_27447":57565,"_2948":58180},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3464":2875,"_30209":2628,"_20922":58182,"_5":14373,"_27447":57565,"_2948":58183},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3464":2876,"_30209":2628,"_20922":58185,"_5":14373,"_27447":57565,"_2948":58186},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3464":2877,"_30209":2628,"_20922":58188,"_5":14373,"_27447":57569,"_2948":58189},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3464":2878,"_30209":2628,"_20922":58191,"_5":14373,"_27447":57569,"_2948":58192},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3464":2879,"_30209":2628,"_20922":58194,"_5":14373,"_27447":57569,"_2948":58195},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3464":2880,"_30209":2628,"_20922":58197,"_5":14373,"_27447":57569,"_2948":58198},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3464":2881,"_30209":2628,"_20922":58200,"_5":14373,"_27447":57569,"_2948":58201},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3464":2882,"_30209":2628,"_20922":58203,"_5":14373,"_27447":57569,"_2948":58204},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3464":2883,"_30209":2628,"_20922":58206,"_5":14373,"_27447":57569,"_2948":58207},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3464":2884,"_30209":2628,"_20922":58209,"_5":14373,"_27447":57569,"_2948":58210},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3464":2885,"_30209":2628,"_20922":58212,"_5":14373,"_27447":57569,"_2948":58213},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3464":2886,"_30209":2628,"_20922":58215,"_5":14373,"_27447":57569,"_2948":58216},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3464":2887,"_30209":2628,"_20922":58218,"_5":14373,"_27447":57569,"_2948":58219},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3464":2888,"_30209":2628,"_20922":58221,"_5":14373,"_27447":57569,"_2948":58222},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3464":2889,"_30209":2628,"_20922":58224,"_5":14373,"_27447":57573,"_2948":58225},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3464":2890,"_30209":2628,"_20922":58227,"_5":14373,"_27447":57573,"_2948":58228},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3464":2891,"_30209":2628,"_20922":58230,"_5":14373,"_27447":57577,"_2948":58231},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3464":2892,"_30209":2628,"_20922":58233,"_5":14373,"_27447":57577,"_2948":58234},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3464":2893,"_30209":2628,"_20922":58236,"_5":14373,"_27447":57577,"_2948":58237},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3464":2894,"_30209":2628,"_20922":58239,"_5":14373,"_27447":57577,"_2948":58240},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3464":2895,"_30209":2628,"_20922":58242,"_5":14373,"_27447":57577,"_2948":58243},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3464":2896,"_30209":2628,"_20922":58245,"_5":14373,"_27447":57577,"_2948":58246},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3464":2897,"_30209":2628,"_20922":58248,"_5":14373,"_27447":57577,"_2948":58249},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3464":2898,"_30209":2628,"_20922":58251,"_5":14373,"_27447":57577,"_2948":58252},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3464":2899,"_30209":2628,"_20922":58254,"_5":14373,"_27447":57577,"_2948":58255},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3464":2900,"_30209":2628,"_20922":58257,"_5":14373,"_27447":57577,"_2948":58258},[],"**Remove the helper and restore the recorded replica counts:**",{"_3464":2901,"_30209":2628,"_20922":58260,"_5":14373,"_27447":57577,"_2948":58261},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3464":2902,"_30209":2628,"_20922":58263,"_5":14373,"_27447":57581,"_2948":58264},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3464":2903,"_30209":2628,"_20922":58266,"_5":14373,"_27447":57581,"_2948":58267},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3464":2904,"_30209":2628,"_20922":58269,"_5":14373,"_27447":57585,"_2948":58270},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3464":2905,"_30209":2628,"_20922":58272,"_5":14373,"_27447":57585,"_2948":58273},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3464":2906,"_30209":2628,"_20922":58275,"_5":14373,"_27447":57585,"_2948":58276},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3464":2907,"_30209":2628,"_20922":58278,"_5":14373,"_27447":57585,"_2948":58279},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3464":2908,"_30209":2628,"_20922":58281,"_5":14373,"_27447":57585,"_2948":58282},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3464":2909,"_30209":2628,"_20922":58284,"_5":14373,"_27447":57585,"_2948":58285},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3464":2910,"_30209":2628,"_20922":58287,"_5":14373,"_27447":57585,"_2948":58288},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3464":2911,"_30209":2628,"_20922":58290,"_5":14373,"_27447":57585,"_2948":58291},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3464":2912,"_30209":2628,"_20922":58293,"_5":14373,"_27447":57589,"_2948":58294},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3464":2913,"_30209":2628,"_20922":58296,"_5":14373,"_27447":57589,"_2948":58297},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3464":2914,"_30209":2628,"_20922":58299,"_5":14373,"_27447":57589,"_2948":58300},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3464":2915,"_30209":2628,"_20922":58302,"_5":14373,"_27447":57589,"_2948":58303},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3464":2916,"_30209":2628,"_20922":58305,"_5":14373,"_27447":57589,"_2948":58306},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3464":2917,"_30209":2628,"_20922":58308,"_5":14373,"_27447":57589,"_2948":58309},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3464":2918,"_30209":2628,"_20922":58311,"_5":14373,"_27447":57589,"_2948":58312},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3464":2919,"_30209":2628,"_20922":58314,"_5":14373,"_27447":57589,"_2948":58315},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3464":2920,"_30209":2628,"_20922":58317,"_5":14373,"_27447":57589,"_2948":58318},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3464":2921,"_30209":2628,"_20922":58320,"_5":14373,"_27447":57589,"_2948":58321},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3464":2922,"_30209":2628,"_20922":58323,"_5":14373,"_27447":57589,"_2948":58324},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3464":2923,"_30209":2628,"_20922":58326,"_5":14373,"_27447":57592,"_2948":58327},[],"After the upgrade, check in this order:",{"_3464":2924,"_30209":2628,"_20922":58329,"_5":14373,"_27447":57592,"_2948":58330},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3464":2925,"_30209":2628,"_20922":58332,"_5":14373,"_27447":57592,"_2948":58333},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3464":2926,"_30209":2628,"_20922":58335,"_5":14373,"_27447":57592,"_2948":58336},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3464":2927,"_30209":2628,"_20922":58338,"_5":14373,"_27447":57592,"_2948":58339},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3464":2928,"_30209":2628,"_20922":58341,"_5":14373,"_27447":57592,"_2948":58342},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3464":2929,"_30209":2628,"_20922":58344,"_5":14373,"_27447":57592,"_2948":58345},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3464":2930,"_30209":2628,"_20922":58347,"_5":14373,"_27447":57592,"_2948":58348},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3464":2931,"_30209":2628,"_20922":58350,"_5":14373,"_27447":57592,"_2948":58351},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3464":2932,"_30209":2628,"_20922":58353,"_5":14373,"_27447":57592,"_2948":58354},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3464":2933,"_30209":2628,"_20922":58356,"_5":14373,"_27447":57592,"_2948":58357},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3464":2934,"_30209":2628,"_20922":58359,"_5":14373,"_27447":57592,"_2948":58360},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3464":2935,"_30209":2628,"_20922":58362,"_5":14373,"_27447":57592,"_2948":58363},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3464":2936,"_30209":2628,"_20922":58365,"_5":14373,"_27447":57592,"_2948":58366},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3464":2937,"_30209":2628,"_20922":58368,"_5":14373,"_27447":57592,"_2948":58369},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3464":2938,"_30209":2628,"_20922":58371,"_5":14373,"_27447":57592,"_2948":58372},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3464":2939,"_30209":2628,"_20922":58374,"_5":14373,"_27447":57596,"_2948":58375},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3464":2940,"_30209":2628,"_20922":58377,"_5":14373,"_27447":57596,"_2948":58378},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3464":2941,"_30209":2628,"_20922":58380,"_5":14373,"_27447":57596,"_2948":58381},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":2942,"_30209":2628,"_20922":58383,"_5":14373,"_27447":57596,"_2948":58384},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3464":2943,"_30209":2628,"_20922":58386,"_5":14373,"_27447":57596,"_2948":58387},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58390":58391,"_58392":58393,"_58394":58395,"_58396":58397,"_18133":2983,"_70127":2983},"language","english","sortableProperties",[2948,30209,5,27447],"sortablePropertiesWithTypes",{"_2948":25016,"_30209":25016,"_5":25016,"_27447":25016},"sorts",{"_2948":58398,"_30209":61331,"_5":64263,"_27447":67195},{"_4644":58399,"_58400":58401,"_5":25016},{"_14449":5979,"_14829":22535,"_14848":3414,"_29212":3318,"_14835":5053,"_19854":4000,"_14470":25178,"_14477":3350,"_29154":3437,"_29563":3036,"_29584":4621,"_29188":5959,"_34529":6922,"_29291":7502,"_29628":4935,"_34536":4786,"_34539":7053,"_34542":7639,"_34545":14295,"_30035":3666,"_34550":5114,"_34552":4182,"_30065":24213,"_14844":24385,"_34556":4734,"_34559":4055,"_34561":6197,"_29612":7606,"_30030":3365,"_30078":4985,"_34566":3093,"_34568":7593,"_34570":7480,"_29308":3048,"_34573":3932,"_34575":5816,"_34577":7044,"_34579":3654,"_34581":6971,"_29225":10772,"_34584":7000,"_34586":8414,"_29219":3813,"_29649":6577,"_34590":9541,"_34592":4189,"_34595":9181,"_29265":5827,"_34599":4036,"_29145":18537,"_34602":7028,"_29193":10461,"_34605":7482,"_34607":14330,"_34610":5158,"_14838":5177,"_34613":17628,"_34615":5843,"_34618":16706,"_34620":15601,"_34622":3034,"_34624":7484,"_34626":7643,"_19857":6542,"_34629":5981,"_34631":3410,"_29166":4748,"_29606":12465,"_34635":5126,"_34637":41