3460":102765,"_33462":102770,"_33464":102773,"_33466":102777,"_33468":102781,"_33470":102785,"_33472":102788,"_33474":102791,"_33476":102793,"_33478":102795,"_33480":102797,"_33482":102799,"_33484":102802,"_33486":102805,"_33488":102808,"_33490":102811,"_33492":102814,"_33494":102816,"_33496":102819,"_33498":102821,"_33500":102824,"_33502":102827,"_33504":102830,"_33506":102832,"_33508":102835,"_33510":102838,"_33512":102841,"_33514":102844,"_33516":102847,"_33518":102850,"_33520":102853,"_33522":102856,"_33524":102859,"_33526":102862,"_33528":102865,"_33530":102868},{"_2856":57618,"_25059":57618,"_5":12268,"_2383":95609,"_25374":95610,"_17489":95613,"_23720":57618},"Despliega desde AWS Marketplace",[40699,95611,95612],"Despliegue","Otros modelos",[],{"_2856":57619,"_25059":57618,"_17489":95615,"_5":17384,"_23720":57618,"_2383":95616},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2856":57620,"_25059":57618,"_5":25371,"_17489":95618,"_23720":95619,"_2383":95620},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2856":57621,"_25059":57618,"_5":25371,"_17489":95622,"_23720":95623,"_2383":95624},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2856":57622,"_25059":57618,"_5":25371,"_17489":95626,"_23720":95627,"_2383":95628},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2856":57623,"_25059":57618,"_5":25371,"_17489":95630,"_23720":95631,"_2383":95632},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2856":57624,"_25059":57618,"_5":25371,"_17489":95634,"_23720":95635,"_2383":95636},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2856":57625,"_25059":57618,"_5":25371,"_17489":95638,"_23720":95639,"_2383":95640},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2856":57626,"_25059":57618,"_5":25371,"_17489":95642,"_23720":95643,"_2383":95644},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2856":57627,"_25059":57618,"_17489":95646,"_5":17384,"_23720":57618,"_2383":95647},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2856":57628,"_25059":57618,"_17489":95649,"_5":17384,"_23720":95619,"_2383":95650},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2856":57629,"_25059":57618,"_17489":95652,"_5":17384,"_23720":95619,"_2383":95653},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2856":57630,"_25059":57618,"_17489":95655,"_5":17384,"_23720":95619,"_2383":95656},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2856":57631,"_25059":57618,"_17489":95658,"_5":17384,"_23720":95623,"_2383":95659},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2856":57632,"_25059":57618,"_17489":95661,"_5":17384,"_23720":95623,"_2383":95662},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2856":57633,"_25059":57618,"_17489":95664,"_5":17384,"_23720":95623,"_2383":95665},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2856":57634,"_25059":57618,"_17489":95667,"_5":17384,"_23720":95627,"_2383":95668},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2856":57635,"_25059":57618,"_17489":95670,"_5":17384,"_23720":95631,"_2383":95671},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2856":57636,"_25059":57618,"_17489":95673,"_5":17384,"_23720":95635,"_2383":95674},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2856":57637,"_25059":57618,"_17489":95676,"_5":17384,"_23720":95639,"_2383":95677},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2856":57638,"_25059":57618,"_17489":95679,"_5":17384,"_23720":95643,"_2383":95680},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2856":57639,"_25059":57639,"_5":12268,"_2383":95682,"_25374":95683,"_17489":95684,"_23720":57639},"Despliega Lamassu",[40699,95611],[],{"_2856":57640,"_25059":57639,"_17489":95686,"_5":17384,"_23720":57639,"_2383":95687},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2856":57641,"_25059":57639,"_5":25371,"_17489":95689,"_23720":95690,"_2383":95691},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2856":57642,"_25059":57639,"_5":25371,"_17489":95693,"_23720":95694,"_2383":95695},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2856":57643,"_25059":57639,"_5":25371,"_17489":95697,"_23720":95698,"_2383":95699},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2856":57644,"_25059":57639,"_17489":95701,"_5":17384,"_23720":57639,"_2383":95702},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2856":57645,"_25059":57639,"_17489":95704,"_5":17384,"_23720":95690,"_2383":95705},[],"Modelo",{"_2856":57646,"_25059":57639,"_17489":95707,"_5":17384,"_23720":95690,"_2383":95708},[],"Recomendado para",{"_2856":57647,"_25059":57639,"_17489":95710,"_5":17384,"_23720":95690,"_2383":95711},[],"Quién opera la infraestructura",{"_2856":57648,"_25059":57639,"_17489":95713,"_5":17384,"_23720":95690,"_2383":95714},[],"Punto de partida",{"_2856":57649,"_25059":57639,"_17489":95716,"_5":17384,"_23720":95690,"_2383":40806},[],{"_2856":57650,"_25059":57639,"_17489":95718,"_5":17384,"_23720":95690,"_2383":95719},[],"Producción, entornos regulados y despliegues personalizados",{"_2856":57651,"_25059":57639,"_17489":95721,"_5":17384,"_23720":95690,"_2383":95722},[],"Tu equipo",{"_2856":57652,"_25059":57639,"_17489":95724,"_5":17384,"_23720":95690,"_2383":95725},[],"Helm o Fastlane",{"_2856":57653,"_25059":57639,"_17489":95727,"_5":17384,"_23720":95690,"_2383":40818},[],{"_2856":57654,"_25059":57639,"_17489":95729,"_5":17384,"_23720":95690,"_2383":95730},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2856":57655,"_25059":57639,"_17489":95732,"_5":17384,"_23720":95690,"_2383":95722},[],{"_2856":57656,"_25059":57639,"_17489":95734,"_5":17384,"_23720":95690,"_2383":95735},[],"Imagen preconfigurada en EC2",{"_2856":57657,"_25059":57639,"_17489":95737,"_5":17384,"_23720":95690,"_2383":40829},[],{"_2856":57658,"_25059":57639,"_17489":95739,"_5":17384,"_23720":95690,"_2383":95740},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2856":57659,"_25059":57639,"_17489":95742,"_5":17384,"_23720":95690,"_2383":40835},[],{"_2856":57660,"_25059":57639,"_17489":95744,"_5":17384,"_23720":95690,"_2383":95745},[],"Suscripción gestionada",{"_2856":57661,"_25059":57639,"_17489":95747,"_5":17384,"_23720":95690,"_2383":95748},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2856":57662,"_25059":57639,"_17489":95750,"_5":17384,"_23720":95690,"_2383":95751},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2856":57663,"_25059":57639,"_17489":95753,"_5":17384,"_23720":95690,"_2383":95754},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2856":57664,"_25059":57639,"_17489":95756,"_5":17384,"_23720":95694,"_2383":95757},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2856":57665,"_25059":57639,"_17489":95759,"_5":17384,"_23720":95698,"_2383":95760},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2856":57666,"_25059":57666,"_5":12268,"_2383":95762,"_25374":95763,"_17489":95764,"_23720":57666},"Utiliza Lamassu como SaaS",[40699,95611,95612],[],{"_2856":57667,"_25059":57666,"_17489":95766,"_5":17384,"_23720":57666,"_2383":95767},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2856":57668,"_25059":57666,"_5":25371,"_17489":95769,"_23720":95770,"_2383":95771},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2856":57669,"_25059":57666,"_5":25371,"_17489":95773,"_23720":95774,"_2383":95775},[],"/docs/es/deployment/saas#planes","Planes",{"_2856":57670,"_25059":57666,"_5":25371,"_17489":95777,"_23720":95778,"_2383":95779},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2856":57671,"_25059":57666,"_17489":95781,"_5":17384,"_23720":57666,"_2383":95782},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2856":57672,"_25059":57666,"_17489":95784,"_5":17384,"_23720":95770,"_2383":95785},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2856":57673,"_25059":57666,"_17489":95787,"_5":17384,"_23720":95770,"_2383":95788},[],"Copias de seguridad automáticas.",{"_2856":57674,"_25059":57666,"_17489":95790,"_5":17384,"_23720":95770,"_2383":95791},[],"Actualizaciones de versión.",{"_2856":57675,"_25059":57666,"_17489":95793,"_5":17384,"_23720":95770,"_2383":95794},[],"Soporte técnico y SLA según el plan contratado.",{"_2856":57676,"_25059":57666,"_17489":95796,"_5":17384,"_23720":95774,"_2383":40890},[],{"_2856":57677,"_25059":57666,"_17489":95798,"_5":17384,"_23720":95774,"_2383":95799},[],"Dispositivos",{"_2856":57678,"_25059":57666,"_17489":95801,"_5":17384,"_23720":95774,"_2383":95802},[],"Soporte",{"_2856":57679,"_25059":57666,"_17489":95804,"_5":17384,"_23720":95774,"_2383":40899},[],{"_2856":57680,"_25059":57666,"_17489":95806,"_5":17384,"_23720":95774,"_2383":40902},[],{"_2856":57681,"_25059":57666,"_17489":95808,"_5":17384,"_23720":95774,"_2383":95809},[],"Hasta 1.000",{"_2856":57682,"_25059":57666,"_17489":95811,"_5":17384,"_23720":95774,"_2383":40908},[],{"_2856":57683,"_25059":57666,"_17489":95813,"_5":17384,"_23720":95774,"_2383":95814},[],"99,5 %",{"_2856":57684,"_25059":57666,"_17489":95816,"_5":17384,"_23720":95774,"_2383":40914},[],{"_2856":57685,"_25059":57666,"_17489":95818,"_5":17384,"_23720":95774,"_2383":95819},[],"Hasta 10.000",{"_2856":57686,"_25059":57666,"_17489":95821,"_5":17384,"_23720":95774,"_2383":95822},[],"Email y chat",{"_2856":57687,"_25059":57666,"_17489":95824,"_5":17384,"_23720":95774,"_2383":95825},[],"99,9 %",{"_2856":57688,"_25059":57666,"_17489":95827,"_5":17384,"_23720":95774,"_2383":40926},[],{"_2856":57689,"_25059":57666,"_17489":95829,"_5":17384,"_23720":95774,"_2383":95830},[],"Ilimitados",{"_2856":57690,"_25059":57666,"_17489":95832,"_5":17384,"_23720":95774,"_2383":95833},[],"Dedicado",{"_2856":57691,"_25059":57666,"_17489":95835,"_5":17384,"_23720":95774,"_2383":95836},[],"99,99 %",{"_2856":57692,"_25059":57666,"_17489":95838,"_5":17384,"_23720":95778,"_2383":95839},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2856":57693,"_25059":57666,"_17489":95841,"_5":17384,"_23720":95778,"_2383":95842},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2856":57694,"_25059":57694,"_5":12268,"_2383":40943,"_25374":95844,"_17489":95846,"_23720":57694},[40699,95611,95845],"Kubernetes autogestionado",[],{"_2856":57695,"_25059":57694,"_17489":95848,"_5":17384,"_23720":57694,"_2383":95849},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2856":57696,"_25059":57694,"_5":25371,"_17489":95851,"_23720":95852,"_2383":95853},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2856":57697,"_25059":57694,"_5":25371,"_17489":95855,"_23720":95856,"_2383":95857},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2856":57698,"_25059":57694,"_5":25371,"_17489":95859,"_23720":95860,"_2383":95861},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2856":57699,"_25059":57694,"_5":25371,"_17489":95863,"_23720":95864,"_2383":95865},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2856":57700,"_25059":57694,"_5":25371,"_17489":95867,"_23720":95868,"_2383":95869},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2856":57701,"_25059":57694,"_5":25371,"_17489":95871,"_23720":95872,"_2383":95873},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2856":57702,"_25059":57694,"_5":25371,"_17489":95875,"_23720":95876,"_2383":95877},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2856":57703,"_25059":57694,"_5":25371,"_17489":95879,"_23720":95880,"_2383":95881},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2856":57704,"_25059":57694,"_5":25371,"_17489":95883,"_23720":95884,"_2383":95885},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2856":57705,"_25059":57694,"_5":25371,"_17489":95887,"_23720":95888,"_2383":95889},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2856":57706,"_25059":57694,"_17489":95891,"_5":17384,"_23720":95852,"_2383":95892},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2856":57707,"_25059":57694,"_17489":95894,"_5":17384,"_23720":95852,"_2383":95895},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2856":57708,"_25059":57694,"_17489":95897,"_5":17384,"_23720":95856,"_2383":95898},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2856":57709,"_25059":57694,"_17489":95900,"_5":17384,"_23720":95856,"_2383":95901},[],"Fastlane instala o configura",{"_2856":57710,"_25059":57694,"_17489":95903,"_5":17384,"_23720":95856,"_2383":95904},[],"Tú sigues proporcionando",{"_2856":57711,"_25059":57694,"_17489":95906,"_5":17384,"_23720":95856,"_2383":95907},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2856":57712,"_25059":57694,"_17489":95909,"_5":17384,"_23720":95856,"_2383":95910},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2856":57713,"_25059":57694,"_17489":95912,"_5":17384,"_23720":95856,"_2383":95913},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2856":57714,"_25059":57694,"_17489":95915,"_5":17384,"_23720":95856,"_2383":95916},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2856":57715,"_25059":57694,"_17489":95918,"_5":17384,"_23720":95856,"_2383":95919},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2856":57716,"_25059":57694,"_17489":95921,"_5":17384,"_23720":95856,"_2383":95922},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2856":57717,"_25059":57694,"_17489":95924,"_5":17384,"_23720":95856,"_2383":95925},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2856":57718,"_25059":57694,"_17489":95927,"_5":17384,"_23720":95856,"_2383":95928},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2856":57719,"_25059":57694,"_17489":95930,"_5":17384,"_23720":95856,"_2383":95931},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2856":57720,"_25059":57694,"_17489":95933,"_5":17384,"_23720":95860,"_2383":95934},[],"Necesitas:",{"_2856":57721,"_25059":57694,"_17489":95936,"_5":17384,"_23720":95860,"_2383":95937},[],"un clúster Kubernetes existente",{"_2856":57722,"_25059":57694,"_17489":95939,"_5":17384,"_23720":95860,"_2383":95940},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2856":57723,"_25059":57694,"_17489":95942,"_5":17384,"_23720":95860,"_2383":41041},[],{"_2856":57724,"_25059":57694,"_17489":95944,"_5":17384,"_23720":95860,"_2383":19794},[],{"_2856":57725,"_25059":57694,"_17489":95946,"_5":17384,"_23720":95860,"_2383":95947},[],"`jq` solo si usas `--sample-data`",{"_2856":57726,"_25059":57694,"_17489":95949,"_5":17384,"_23720":95860,"_2383":95950},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2856":57727,"_25059":57694,"_17489":95952,"_5":17384,"_23720":95860,"_2383":95953},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2856":57728,"_25059":57694,"_17489":95955,"_5":17384,"_23720":95860,"_2383":95956},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2856":57729,"_25059":57694,"_17489":95958,"_5":17384,"_23720":95864,"_2383":95959},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2856":57730,"_25059":57694,"_17489":95961,"_5":17384,"_23720":95864,"_2383":95962},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2856":57731,"_25059":57694,"_17489":95964,"_5":17384,"_23720":95868,"_2383":95965},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2856":57732,"_25059":57694,"_17489":95967,"_5":17384,"_23720":95868,"_2383":95968},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2856":57733,"_25059":57694,"_17489":95970,"_5":17384,"_23720":95868,"_2383":95971},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2856":57734,"_25059":57694,"_17489":95973,"_5":17384,"_23720":95868,"_2383":95974},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2856":57735,"_25059":57694,"_17489":95976,"_5":17384,"_23720":95872,"_2383":95977},[],"Opción",{"_2856":57736,"_25059":57694,"_17489":95979,"_5":17384,"_23720":95872,"_2383":95980},[],"Valor predeterminado",{"_2856":57737,"_25059":57694,"_17489":95982,"_5":17384,"_23720":95872,"_2383":95983},[],"Propósito",{"_2856":57738,"_25059":57694,"_17489":95985,"_5":17384,"_23720":95872,"_2383":41085},[],{"_2856":57739,"_25059":57694,"_17489":95987,"_5":17384,"_23720":95872,"_2383":41088},[],{"_2856":57740,"_25059":57694,"_17489":95989,"_5":17384,"_23720":95872,"_2383":95990},[],"Muestra la ayuda",{"_2856":57741,"_25059":57694,"_17489":95992,"_5":17384,"_23720":95872,"_2383":41094},[],{"_2856":57742,"_25059":57694,"_17489":95994,"_5":17384,"_23720":95872,"_2383":95995},[],"contexto actual",{"_2856":57743,"_25059":57694,"_17489":95997,"_5":17384,"_23720":95872,"_2383":95998},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2856":57744,"_25059":57694,"_17489":96000,"_5":17384,"_23720":95872,"_2383":41103},[],{"_2856":57745,"_25059":57694,"_17489":96002,"_5":17384,"_23720":95872,"_2383":5347},[],{"_2856":57746,"_25059":57694,"_17489":96004,"_5":17384,"_23720":95872,"_2383":96005},[],"Omite prompts y genera credenciales para las dependencias",{"_2856":57747,"_25059":57694,"_17489":96007,"_5":17384,"_23720":95872,"_2383":41111},[],{"_2856":57748,"_25059":57694,"_17489":96009,"_5":17384,"_23720":95872,"_2383":41114},[],{"_2856":57749,"_25059":57694,"_17489":96011,"_5":17384,"_23720":95872,"_2383":96012},[],"Namespace de la instalación",{"_2856":57750,"_25059":57694,"_17489":96014,"_5":17384,"_23720":95872,"_2383":41120},[],{"_2856":57751,"_25059":57694,"_17489":96016,"_5":17384,"_23720":95872,"_2383":41123},[],{"_2856":57752,"_25059":57694,"_17489":96018,"_5":17384,"_23720":95872,"_2383":96019},[],"Dominio usado por la UI, OIDC y el certificado",{"_2856":57753,"_25059":57694,"_17489":96021,"_5":17384,"_23720":95872,"_2383":41129},[],{"_2856":57754,"_25059":57694,"_17489":96023,"_5":17384,"_23720":95872,"_2383":12494},[],{"_2856":57755,"_25059":57694,"_17489":96025,"_5":17384,"_23720":95872,"_2383":96026},[],"Versión del chart de Lamassu",{"_2856":57756,"_25059":57694,"_17489":96028,"_5":17384,"_23720":95872,"_2383":41137},[],{"_2856":57757,"_25059":57694,"_17489":96030,"_5":17384,"_23720":95872,"_2383":41140},[],{"_2856":57758,"_25059":57694,"_17489":96032,"_5":17384,"_23720":95872,"_2383":96033},[],"Puerto del listener HTTPS",{"_2856":57759,"_25059":57694,"_17489":96035,"_5":17384,"_23720":95872,"_2383":41146},[],{"_2856":57760,"_25059":57694,"_17489":96037,"_5":17384,"_23720":95872,"_2383":41149},[],{"_2856":57761,"_25059":57694,"_17489":96039,"_5":17384,"_23720":95872,"_2383":96040},[],"Puerto del listener HTTP",{"_2856":57762,"_25059":57694,"_17489":96042,"_5":17384,"_23720":95872,"_2383":41155},[],{"_2856":57763,"_25059":57694,"_17489":96044,"_5":17384,"_23720":95872,"_2383":41088},[],{"_2856":57764,"_25059":57694,"_17489":96046,"_5":17384,"_23720":95872,"_2383":96047},[],"Certificado PEM para TLS downstream",{"_2856":57765,"_25059":57694,"_17489":96049,"_5":17384,"_23720":95872,"_2383":41163},[],{"_2856":57766,"_25059":57694,"_17489":96051,"_5":17384,"_23720":95872,"_2383":41088},[],{"_2856":57767,"_25059":57694,"_17489":96053,"_5":17384,"_23720":95872,"_2383":96054},[],"Clave privada PEM para TLS downstream",{"_2856":57768,"_25059":57694,"_17489":96056,"_5":17384,"_23720":95872,"_2383":41171},[],{"_2856":57769,"_25059":57694,"_17489":96058,"_5":17384,"_23720":95872,"_2383":96059},[],"chart del repositorio",{"_2856":57770,"_25059":57694,"_17489":96061,"_5":17384,"_23720":95872,"_2383":96062},[],"Usa un chart local de Lamassu sin empaquetar",{"_2856":57771,"_25059":57694,"_17489":96064,"_5":17384,"_23720":95872,"_2383":41180},[],{"_2856":57772,"_25059":57694,"_17489":96066,"_5":17384,"_23720":95872,"_2383":96067},[],"detección automática",{"_2856":57773,"_25059":57694,"_17489":96069,"_5":17384,"_23720":95872,"_2383":96070},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2856":57774,"_25059":57694,"_17489":96072,"_5":17384,"_23720":95872,"_2383":41188},[],{"_2856":57775,"_25059":57694,"_17489":96074,"_5":17384,"_23720":95872,"_2383":5347},[],{"_2856":57776,"_25059":57694,"_17489":96076,"_5":17384,"_23720":95872,"_2383":96077},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2856":57777,"_25059":57694,"_17489":96079,"_5":17384,"_23720":95872,"_2383":41196},[],{"_2856":57778,"_25059":57694,"_17489":96081,"_5":17384,"_23720":95872,"_2383":5347},[],{"_2856":57779,"_25059":57694,"_17489":96083,"_5":17384,"_23720":95872,"_2383":96084},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2856":57780,"_25059":57694,"_17489":96086,"_5":17384,"_23720":95872,"_2383":41204},[],{"_2856":57781,"_25059":57694,"_17489":96088,"_5":17384,"_23720":95872,"_2383":5347},[],{"_2856":57782,"_25059":57694,"_17489":96090,"_5":17384,"_23720":95872,"_2383":96091},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2856":57783,"_25059":57694,"_17489":96093,"_5":17384,"_23720":95872,"_2383":41212},[],{"_2856":57784,"_25059":57694,"_17489":96095,"_5":17384,"_23720":95872,"_2383":41215},[],{"_2856":57785,"_25059":57694,"_17489":96097,"_5":17384,"_23720":95872,"_2383":96098},[],"Usa otro chart local de SoftHSM",{"_2856":57786,"_25059":57694,"_17489":96100,"_5":17384,"_23720":95872,"_2383":96101},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2856":57787,"_25059":57694,"_17489":96103,"_5":17384,"_23720":95876,"_2383":41224},[],{"_2856":57788,"_25059":57694,"_17489":96105,"_5":17384,"_23720":95876,"_2383":96106},[],"valida las herramientas locales y el clúster seleccionado",{"_2856":57789,"_25059":57694,"_17489":96108,"_5":17384,"_23720":95876,"_2383":96109},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2856":57790,"_25059":57694,"_17489":96111,"_5":17384,"_23720":95876,"_2383":96112},[],"crea el namespace",{"_2856":57791,"_25059":57694,"_17489":96114,"_5":17384,"_23720":95876,"_2383":96115},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2856":57792,"_25059":57694,"_17489":96117,"_5":17384,"_23720":95876,"_2383":96118},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2856":57793,"_25059":57694,"_17489":96120,"_5":17384,"_23720":95876,"_2383":96121},[],"instala RabbitMQ",{"_2856":57794,"_25059":57694,"_17489":96123,"_5":17384,"_23720":95876,"_2383":96124},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2856":57795,"_25059":57694,"_17489":96126,"_5":17384,"_23720":95876,"_2383":96127},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2856":57796,"_25059":57694,"_17489":96129,"_5":17384,"_23720":95876,"_2383":96130},[],"carga datos de ejemplo opcionalmente",{"_2856":57797,"_25059":57694,"_17489":96132,"_5":17384,"_23720":95876,"_2383":96133},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2856":57798,"_25059":57694,"_17489":96135,"_5":17384,"_23720":95880,"_2383":96136},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2856":57799,"_25059":57694,"_17489":96138,"_5":17384,"_23720":95880,"_2383":96139},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2856":57800,"_25059":57694,"_17489":96141,"_5":17384,"_23720":95884,"_2383":96142},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2856":57801,"_25059":57694,"_17489":96144,"_5":17384,"_23720":95884,"_2383":96145},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2856":57802,"_25059":57694,"_17489":96147,"_5":17384,"_23720":95884,"_2383":96148},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2856":57803,"_25059":57694,"_17489":96150,"_5":17384,"_23720":95888,"_2383":96151},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2856":57804,"_25059":57804,"_5":12268,"_2383":96153,"_25374":96154,"_17489":96155,"_23720":57804},"Instala con Helm",[40699,95611,95845],[],{"_2856":57805,"_25059":57804,"_17489":96157,"_5":17384,"_23720":57804,"_2383":96158},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2856":57806,"_25059":57804,"_5":25371,"_17489":96160,"_23720":96161,"_2383":96162},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2856":57807,"_25059":57804,"_5":25371,"_17489":96164,"_23720":96165,"_2383":95861},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2856":57808,"_25059":57804,"_5":25371,"_17489":96167,"_23720":96168,"_2383":96169},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2856":57809,"_25059":57804,"_5":25371,"_17489":96171,"_23720":96172,"_2383":96173},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2856":57810,"_25059":57804,"_5":25371,"_17489":96175,"_23720":96176,"_2383":96177},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2856":57811,"_25059":57804,"_5":25371,"_17489":96179,"_23720":96180,"_2383":96181},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2856":57812,"_25059":57804,"_5":25371,"_17489":96183,"_23720":96184,"_2383":96185},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2856":57813,"_25059":57804,"_5":25371,"_17489":96187,"_23720":96188,"_2383":96189},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2856":57814,"_25059":57804,"_5":25371,"_17489":96191,"_23720":96192,"_2383":96193},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2856":57815,"_25059":57804,"_17489":96195,"_5":17384,"_23720":96161,"_2383":96196},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2856":57816,"_25059":57804,"_17489":96198,"_5":17384,"_23720":96165,"_2383":96199},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2856":57817,"_25059":57804,"_17489":96201,"_5":17384,"_23720":96165,"_2383":96202},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2856":57818,"_25059":57804,"_17489":96204,"_5":17384,"_23720":96165,"_2383":96205},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2856":57819,"_25059":57804,"_17489":96207,"_5":17384,"_23720":96165,"_2383":96208},[],"un broker RabbitMQ accesible y sus credenciales",{"_2856":57820,"_25059":57804,"_17489":96210,"_5":17384,"_23720":96165,"_2383":96211},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2856":57821,"_25059":57804,"_17489":96213,"_5":17384,"_23720":96165,"_2383":96214},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2856":57822,"_25059":57804,"_17489":96216,"_5":17384,"_23720":96165,"_2383":96217},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2856":57823,"_25059":57804,"_17489":96219,"_5":17384,"_23720":96165,"_2383":96220},[],"una StorageClass y un diseño de tráfico externo",{"_2856":57824,"_25059":57804,"_17489":96222,"_5":17384,"_23720":96165,"_2383":96223},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2856":57825,"_25059":57804,"_17489":96225,"_5":17384,"_23720":96165,"_2383":96226},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2856":57826,"_25059":57804,"_17489":96228,"_5":17384,"_23720":96165,"_2383":96229},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2856":57827,"_25059":57804,"_17489":96231,"_5":17384,"_23720":96168,"_2383":96232},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2856":57828,"_25059":57804,"_17489":96234,"_5":17384,"_23720":96168,"_2383":96235},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2856":57829,"_25059":57804,"_17489":96237,"_5":17384,"_23720":96168,"_2383":96238},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2856":57830,"_25059":57804,"_17489":96240,"_5":17384,"_23720":96172,"_2383":96241},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2856":57831,"_25059":57804,"_17489":96243,"_5":17384,"_23720":96172,"_2383":96244},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2856":57832,"_25059":57804,"_17489":96246,"_5":17384,"_23720":96172,"_2383":96247},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2856":57833,"_25059":57804,"_17489":96249,"_5":17384,"_23720":96176,"_2383":96250},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2856":57834,"_25059":57804,"_17489":96252,"_5":17384,"_23720":96180,"_2383":96253},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2856":57835,"_25059":57804,"_17489":96255,"_5":17384,"_23720":96180,"_2383":96256},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2856":57836,"_25059":57804,"_17489":96258,"_5":17384,"_23720":96180,"_2383":96259},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2856":57837,"_25059":57804,"_17489":96261,"_5":17384,"_23720":96180,"_2383":96262},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2856":57838,"_25059":57804,"_17489":96264,"_5":17384,"_23720":96184,"_2383":96265},[],"Para instalar un checkout local:",{"_2856":57839,"_25059":57804,"_17489":96267,"_5":17384,"_23720":96188,"_2383":96268},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2856":57840,"_25059":57804,"_17489":96270,"_5":17384,"_23720":96188,"_2383":96271},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2856":57841,"_25059":57804,"_17489":96273,"_5":17384,"_23720":96192,"_2383":96274},[],"Antes de pasar a producción, revisa:",{"_2856":57842,"_25059":57804,"_17489":96276,"_5":17384,"_23720":96192,"_2383":96277},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2856":57843,"_25059":57804,"_17489":96279,"_5":17384,"_23720":96192,"_2383":96280},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2856":57844,"_25059":57804,"_17489":96282,"_5":17384,"_23720":96192,"_2383":96283},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2856":57845,"_25059":57804,"_17489":96285,"_5":17384,"_23720":96192,"_2383":96286},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2856":57846,"_25059":57804,"_17489":96288,"_5":17384,"_23720":96192,"_2383":96289},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2856":57847,"_25059":57804,"_17489":96291,"_5":17384,"_23720":96192,"_2383":96292},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2856":57848,"_25059":57804,"_17489":96294,"_5":17384,"_23720":96192,"_2383":96295},[],"SMTP, observabilidad y entrega de alertas",{"_2856":57849,"_25059":57804,"_17489":96297,"_5":17384,"_23720":96192,"_2383":96298},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2856":57850,"_25059":57804,"_17489":96300,"_5":17384,"_23720":96192,"_2383":96301},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2856":57851,"_25059":57851,"_5":12268,"_2383":96303,"_25374":96304,"_17489":96305,"_23720":57851},"Expón el Gateway",[40699,95611,95845],[],{"_2856":57852,"_25059":57851,"_17489":96307,"_5":17384,"_23720":57851,"_2383":96308},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2856":57853,"_25059":57851,"_5":25371,"_17489":96310,"_23720":96311,"_2383":96312},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2856":57854,"_25059":57851,"_5":25371,"_17489":96314,"_23720":96315,"_2383":96316},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2856":57855,"_25059":57851,"_5":25371,"_17489":96318,"_23720":96319,"_2383":96320},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2856":57856,"_25059":57851,"_5":25371,"_17489":96322,"_23720":96323,"_2383":41445},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_2856":57857,"_25059":57851,"_5":25371,"_17489":96325,"_23720":96326,"_2383":96327},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2856":57858,"_25059":57851,"_5":25371,"_17489":96329,"_23720":96330,"_2383":96331},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2856":57859,"_25059":57851,"_5":25371,"_17489":96333,"_23720":96334,"_2383":96335},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2856":57860,"_25059":57851,"_5":25371,"_17489":96337,"_23720":96338,"_2383":96339},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2856":57861,"_25059":57851,"_5":25371,"_17489":96341,"_23720":96342,"_2383":96343},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2856":57862,"_25059":57851,"_17489":96345,"_5":17384,"_23720":96311,"_2383":96346},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2856":57863,"_25059":57851,"_17489":96348,"_5":17384,"_23720":96311,"_2383":96349},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2856":57864,"_25059":57851,"_17489":96351,"_5":17384,"_23720":96315,"_2383":96352},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2856":57865,"_25059":57851,"_17489":96354,"_5":17384,"_23720":96315,"_2383":96355},[],"Defínelo únicamente cuando:",{"_2856":57866,"_25059":57851,"_17489":96357,"_5":17384,"_23720":96315,"_2383":96358},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2856":57867,"_25059":57851,"_17489":96360,"_5":17384,"_23720":96315,"_2383":96361},[],"esa dirección está asignada a este Gateway",{"_2856":57868,"_25059":57851,"_17489":96363,"_5":17384,"_23720":96315,"_2383":96364},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2856":57869,"_25059":57851,"_17489":96366,"_5":17384,"_23720":96315,"_2383":96367},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2856":57870,"_25059":57851,"_17489":96369,"_5":17384,"_23720":96315,"_2383":96370},[],"No confundas estos valores:",{"_2856":57871,"_25059":57851,"_17489":96372,"_5":17384,"_23720":96315,"_2383":96373},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2856":57872,"_25059":57851,"_17489":96375,"_5":17384,"_23720":96315,"_2383":96376},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2856":57873,"_25059":57851,"_17489":96378,"_5":17384,"_23720":96315,"_2383":96379},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2856":57874,"_25059":57851,"_17489":96381,"_5":17384,"_23720":96319,"_2383":96382},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2856":57875,"_25059":57851,"_17489":96384,"_5":17384,"_23720":96319,"_2383":96385},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2856":57876,"_25059":57851,"_17489":96387,"_5":17384,"_23720":96323,"_2383":96388},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2856":57877,"_25059":57851,"_17489":96390,"_5":17384,"_23720":96323,"_2383":96391},[],"Para el diseño recomendado:",{"_2856":57878,"_25059":57851,"_17489":96393,"_5":17384,"_23720":96323,"_2383":96394},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2856":57879,"_25059":57851,"_17489":96396,"_5":17384,"_23720":96323,"_2383":96397},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2856":57880,"_25059":57851,"_17489":96399,"_5":17384,"_23720":96323,"_2383":96400},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2856":57881,"_25059":57851,"_17489":96402,"_5":17384,"_23720":96323,"_2383":96403},[],"Apunta DNS a la dirección accesible de la VM.",{"_2856":57882,"_25059":57851,"_17489":96405,"_5":17384,"_23720":96323,"_2383":96406},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2856":57883,"_25059":57851,"_17489":96408,"_5":17384,"_23720":96326,"_2383":96409},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2856":57884,"_25059":57851,"_17489":96411,"_5":17384,"_23720":96330,"_2383":96412},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2856":57885,"_25059":57851,"_17489":96414,"_5":17384,"_23720":96330,"_2383":96415},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2856":57886,"_25059":57851,"_17489":96417,"_5":17384,"_23720":96334,"_2383":96418},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2856":57887,"_25059":57851,"_17489":96420,"_5":17384,"_23720":96334,"_2383":96421},[],"Requisito",{"_2856":57888,"_25059":57851,"_17489":96423,"_5":17384,"_23720":96334,"_2383":96424},[],"Diseño recomendado",{"_2856":57889,"_25059":57851,"_17489":96426,"_5":17384,"_23720":96334,"_2383":96427},[],"Consecuencia",{"_2856":57890,"_25059":57851,"_17489":96429,"_5":17384,"_23720":96334,"_2383":96430},[],"Varias URL o servicios de Lamassu",{"_2856":57891,"_25059":57851,"_17489":96432,"_5":17384,"_23720":96334,"_2383":96433},[],"Un Gateway con varias rutas",{"_2856":57892,"_25059":57851,"_17489":96435,"_5":17384,"_23720":96334,"_2383":96436},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2856":57893,"_25059":57851,"_17489":96438,"_5":17384,"_23720":96334,"_2383":96439},[],"Gateways independientes e IP externas distintas",{"_2856":57894,"_25059":57851,"_17489":96441,"_5":17384,"_23720":96334,"_2383":96442},[],"Una VIP por Gateway",{"_2856":57895,"_25059":57851,"_17489":96444,"_5":17384,"_23720":96334,"_2383":96445},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2856":57896,"_25059":57851,"_17489":96447,"_5":17384,"_23720":96334,"_2383":96448},[],"Gateways independientes, un nodo y una IP",{"_2856":57897,"_25059":57851,"_17489":96450,"_5":17384,"_23720":96334,"_2383":96451},[],"Puertos externos diferentes",{"_2856":57898,"_25059":57851,"_17489":96453,"_5":17384,"_23720":96334,"_2383":96454},[],"Los clientes deben indicar puertos no estándar",{"_2856":57899,"_25059":57851,"_17489":96456,"_5":17384,"_23720":96334,"_2383":96457},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2856":57900,"_25059":57851,"_17489":96459,"_5":17384,"_23720":96334,"_2383":96460},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2856":57901,"_25059":57851,"_17489":96462,"_5":17384,"_23720":96334,"_2383":96463},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2856":57902,"_25059":57851,"_17489":96465,"_5":17384,"_23720":96334,"_2383":96466},[],"Recursos Gateway separados pero proxy compartido",{"_2856":57903,"_25059":57851,"_17489":96468,"_5":17384,"_23720":96334,"_2383":96469},[],"Modo merged Gateway de Envoy",{"_2856":57904,"_25059":57851,"_17489":96471,"_5":17384,"_23720":96334,"_2383":96472},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2856":57905,"_25059":57851,"_17489":96474,"_5":17384,"_23720":96334,"_2383":96475},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2856":57906,"_25059":57851,"_17489":96477,"_5":17384,"_23720":96334,"_2383":96478},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2856":57907,"_25059":57851,"_17489":96480,"_5":17384,"_23720":96334,"_2383":96481},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2856":57908,"_25059":57851,"_17489":96483,"_5":17384,"_23720":96334,"_2383":96484},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2856":57909,"_25059":57851,"_17489":96486,"_5":17384,"_23720":96338,"_2383":96487},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2856":57910,"_25059":57851,"_17489":96489,"_5":17384,"_23720":96338,"_2383":96490},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2856":57911,"_25059":57851,"_17489":96492,"_5":17384,"_23720":96338,"_2383":96493},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2856":57912,"_25059":57851,"_17489":96495,"_5":17384,"_23720":96338,"_2383":96496},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2856":57913,"_25059":57851,"_17489":96498,"_5":17384,"_23720":96338,"_2383":96499},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2856":57914,"_25059":57851,"_17489":96501,"_5":17384,"_23720":96342,"_2383":96502},[],"Comprueba, en orden:",{"_2856":57915,"_25059":57851,"_17489":96504,"_5":17384,"_23720":96342,"_2383":96505},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2856":57916,"_25059":57851,"_17489":96507,"_5":17384,"_23720":96342,"_2383":96508},[],"Su estado contiene la dirección esperada.",{"_2856":57917,"_25059":57851,"_17489":96510,"_5":17384,"_23720":96342,"_2383":96511},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2856":57918,"_25059":57851,"_17489":96513,"_5":17384,"_23720":96342,"_2383":96514},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2856":57919,"_25059":57851,"_17489":96516,"_5":17384,"_23720":96342,"_2383":96517},[],"DNS resuelve al endpoint accesible externamente.",{"_2856":57920,"_25059":57851,"_17489":96519,"_5":17384,"_23720":96342,"_2383":96520},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2856":57921,"_25059":57851,"_17489":96522,"_5":17384,"_23720":96342,"_2383":96523},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2856":57922,"_25059":57922,"_5":12268,"_2383":40806,"_25374":96525,"_17489":96526,"_23720":57922},[40699,95611,95845],[],{"_2856":57923,"_25059":57922,"_17489":96528,"_5":17384,"_23720":57922,"_2383":96529},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2856":57924,"_25059":57922,"_5":25371,"_17489":96531,"_23720":96532,"_2383":96533},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2856":57925,"_25059":57922,"_5":25371,"_17489":96535,"_23720":96536,"_2383":96537},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2856":57926,"_25059":57922,"_5":25371,"_17489":96539,"_23720":96540,"_2383":96541},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2856":57927,"_25059":57922,"_5":25371,"_17489":96543,"_23720":96544,"_2383":96545},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2856":57928,"_25059":57922,"_5":25371,"_17489":96547,"_23720":96548,"_2383":96549},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2856":57929,"_25059":57922,"_5":25371,"_17489":96551,"_23720":96552,"_2383":96553},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2856":57930,"_25059":57922,"_17489":96555,"_5":17384,"_23720":96532,"_2383":96556},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2856":57931,"_25059":57922,"_17489":96558,"_5":17384,"_23720":96536,"_2383":96559},[],"Flujo",{"_2856":57932,"_25059":57922,"_17489":96561,"_5":17384,"_23720":96536,"_2383":96562},[],"Úsalo para",{"_2856":57933,"_25059":57922,"_17489":96564,"_5":17384,"_23720":96536,"_2383":96565},[],"Qué instala",{"_2856":57934,"_25059":57922,"_17489":96567,"_5":17384,"_23720":96536,"_2383":41690},[],{"_2856":57935,"_25059":57922,"_17489":96569,"_5":17384,"_23720":96536,"_2383":96570},[],"Producción y entornos controlados",{"_2856":57936,"_25059":57922,"_17489":96572,"_5":17384,"_23720":96536,"_2383":96573},[],"Servicios de Lamassu y recursos de Gateway API",{"_2856":57937,"_25059":57922,"_17489":96575,"_5":17384,"_23720":96536,"_2383":40943},[],{"_2856":57938,"_25059":57922,"_17489":96577,"_5":17384,"_23720":96536,"_2383":96578},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2856":57939,"_25059":57922,"_17489":96580,"_5":17384,"_23720":96536,"_2383":96581},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2856":57940,"_25059":57922,"_17489":96583,"_5":17384,"_23720":96540,"_2383":96584},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2856":57941,"_25059":57922,"_17489":96586,"_5":17384,"_23720":96540,"_2383":96587},[],"Área",{"_2856":57942,"_25059":57922,"_17489":96589,"_5":17384,"_23720":96540,"_2383":96590},[],"El chart de Lamassu proporciona",{"_2856":57943,"_25059":57922,"_17489":96592,"_5":17384,"_23720":96540,"_2383":96593},[],"Tú proporcionas",{"_2856":57944,"_25059":57922,"_17489":96595,"_5":17384,"_23720":96540,"_2383":96596},[],"Aplicaciones Lamassu",{"_2856":57945,"_25059":57922,"_17489":96598,"_5":17384,"_23720":96540,"_2383":96599},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2856":57946,"_25059":57922,"_17489":96601,"_5":17384,"_23720":96540,"_2383":96602},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2856":57947,"_25059":57922,"_17489":96604,"_5":17384,"_23720":96540,"_2383":96605},[],"Datos PostgreSQL",{"_2856":57948,"_25059":57922,"_17489":96607,"_5":17384,"_23720":96540,"_2383":96608},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2856":57949,"_25059":57922,"_17489":96610,"_5":17384,"_23720":96540,"_2383":96611},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2856":57950,"_25059":57922,"_17489":96613,"_5":17384,"_23720":96540,"_2383":96614},[],"Mensajería",{"_2856":57951,"_25059":57922,"_17489":96616,"_5":17384,"_23720":96540,"_2383":96617},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2856":57952,"_25059":57922,"_17489":96619,"_5":17384,"_23720":96540,"_2383":96620},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2856":57953,"_25059":57922,"_17489":96622,"_5":17384,"_23720":96540,"_2383":96623},[],"Identidad",{"_2856":57954,"_25059":57922,"_17489":96625,"_5":17384,"_23720":96540,"_2383":96626},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2856":57955,"_25059":57922,"_17489":96628,"_5":17384,"_23720":96540,"_2383":96629},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2856":57956,"_25059":57922,"_17489":96631,"_5":17384,"_23720":96540,"_2383":96632},[],"Enrutamiento externo",{"_2856":57957,"_25059":57922,"_17489":96634,"_5":17384,"_23720":96540,"_2383":96635},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2856":57958,"_25059":57922,"_17489":96637,"_5":17384,"_23720":96540,"_2383":96638},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2856":57959,"_25059":57922,"_17489":96640,"_5":17384,"_23720":96540,"_2383":41764},[],{"_2856":57960,"_25059":57922,"_17489":96642,"_5":17384,"_23720":96540,"_2383":96643},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2856":57961,"_25059":57922,"_17489":96645,"_5":17384,"_23720":96540,"_2383":96646},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2856":57962,"_25059":57922,"_17489":96648,"_5":17384,"_23720":96540,"_2383":96649},[],"Datos persistentes de la aplicación",{"_2856":57963,"_25059":57922,"_17489":96651,"_5":17384,"_23720":96540,"_2383":96652},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2856":57964,"_25059":57922,"_17489":96654,"_5":17384,"_23720":96540,"_2383":96655},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2856":57965,"_25059":57922,"_17489":96657,"_5":17384,"_23720":96540,"_2383":96658},[],"Integraciones opcionales",{"_2856":57966,"_25059":57922,"_17489":96660,"_5":17384,"_23720":96540,"_2383":96661},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2856":57967,"_25059":57922,"_17489":96663,"_5":17384,"_23720":96540,"_2383":96664},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2856":57968,"_25059":57922,"_17489":96666,"_5":17384,"_23720":96540,"_2383":96667},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2856":57969,"_25059":57922,"_17489":96669,"_5":17384,"_23720":96540,"_2383":96670},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2856":57970,"_25059":57922,"_17489":96672,"_5":17384,"_23720":96544,"_2383":96673},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2856":57971,"_25059":57922,"_17489":96675,"_5":17384,"_23720":96544,"_2383":96676},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2856":57972,"_25059":57922,"_17489":96678,"_5":17384,"_23720":96548,"_2383":96679},[],"Kubernetes 1.24 o posterior",{"_2856":57973,"_25059":57922,"_17489":96681,"_5":17384,"_23720":96548,"_2383":96682},[],"Helm 3.2 o posterior",{"_2856":57974,"_25059":57922,"_17489":96684,"_5":17384,"_23720":96548,"_2383":96685},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2856":57975,"_25059":57922,"_17489":96687,"_5":17384,"_23720":96548,"_2383":96688},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2856":57976,"_25059":57922,"_17489":96690,"_5":17384,"_23720":96548,"_2383":96691},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2856":57977,"_25059":57922,"_17489":96693,"_5":17384,"_23720":96548,"_2383":96694},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2856":57978,"_25059":57922,"_17489":96696,"_5":17384,"_23720":96548,"_2383":96697},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2856":57979,"_25059":57922,"_17489":96699,"_5":17384,"_23720":96552,"_2383":96700},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2856":57980,"_25059":57922,"_17489":96702,"_5":17384,"_23720":96552,"_2383":96703},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2856":57981,"_25059":57922,"_17489":96705,"_5":17384,"_23720":96552,"_2383":96706},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2856":57982,"_25059":57982,"_5":12268,"_2383":96708,"_25374":96709,"_17489":96711,"_23720":57982},"Resolución de problemas de despliegue",[40699,95611,96710],"Operación",[],{"_2856":57983,"_25059":57982,"_17489":96713,"_5":17384,"_23720":57982,"_2383":96714},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2856":57984,"_25059":57982,"_5":25371,"_17489":96716,"_23720":96717,"_2383":96718},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2856":57985,"_25059":57982,"_5":25371,"_17489":96720,"_23720":96721,"_2383":96722},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2856":57986,"_25059":57982,"_5":25371,"_17489":96724,"_23720":96725,"_2383":96726},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2856":57987,"_25059":57982,"_5":25371,"_17489":96728,"_23720":96729,"_2383":96730},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2856":57988,"_25059":57982,"_5":25371,"_17489":96732,"_23720":96733,"_2383":96734},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2856":57989,"_25059":57982,"_5":25371,"_17489":96736,"_23720":96737,"_2383":96738},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2856":57990,"_25059":57982,"_5":25371,"_17489":96740,"_23720":96741,"_2383":96742},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2856":57991,"_25059":57982,"_5":25371,"_17489":96744,"_23720":96745,"_2383":96746},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2856":57992,"_25059":57982,"_5":25371,"_17489":96748,"_23720":96749,"_2383":96750},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2856":57993,"_25059":57982,"_5":25371,"_17489":96752,"_23720":96753,"_2383":96754},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2856":57994,"_25059":57982,"_5":25371,"_17489":96756,"_23720":96757,"_2383":96758},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2856":57995,"_25059":57982,"_5":25371,"_17489":96760,"_23720":96761,"_2383":96762},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2856":57996,"_25059":57982,"_17489":96764,"_5":17384,"_23720":57982,"_2383":96765},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2856":57997,"_25059":57982,"_17489":96767,"_5":17384,"_23720":96721,"_2383":96768},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2856":57998,"_25059":57982,"_17489":96770,"_5":17384,"_23720":96725,"_2383":96771},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2856":57999,"_25059":57982,"_17489":96773,"_5":17384,"_23720":96729,"_2383":96774},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2856":58000,"_25059":57982,"_17489":96776,"_5":17384,"_23720":96733,"_2383":96777},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2856":58001,"_25059":57982,"_17489":96779,"_5":17384,"_23720":96737,"_2383":96780},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2856":58002,"_25059":57982,"_17489":96782,"_5":17384,"_23720":96741,"_2383":96783},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2856":58003,"_25059":57982,"_17489":96785,"_5":17384,"_23720":96741,"_2383":96786},[],"Ejecuta también la prueba de conectividad del chart:",{"_2856":58004,"_25059":57982,"_17489":96788,"_5":17384,"_23720":96741,"_2383":96789},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2856":58005,"_25059":57982,"_17489":96791,"_5":17384,"_23720":96741,"_2383":96792},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2856":58006,"_25059":57982,"_17489":96794,"_5":17384,"_23720":96745,"_2383":96795},[],"Si recibes un 401:",{"_2856":58007,"_25059":57982,"_17489":96797,"_5":17384,"_23720":96745,"_2383":96798},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2856":58008,"_25059":57982,"_17489":96800,"_5":17384,"_23720":96745,"_2383":96801},[],"verifica emisor, audiencia y expiración del token;",{"_2856":58009,"_25059":57982,"_17489":96803,"_5":17384,"_23720":96745,"_2383":96804},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2856":58010,"_25059":57982,"_17489":96806,"_5":17384,"_23720":96745,"_2383":96807},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2856":58011,"_25059":57982,"_17489":96809,"_5":17384,"_23720":96745,"_2383":96810},[],"Si el login termina pero las APIs devuelven 403:",{"_2856":58012,"_25059":57982,"_17489":96812,"_5":17384,"_23720":96745,"_2383":96813},[],"inspecciona los claims reales del token;",{"_2856":58013,"_25059":57982,"_17489":96815,"_5":17384,"_23720":96745,"_2383":96816},[],"confirma que coinciden con un principal activo;",{"_2856":58014,"_25059":57982,"_17489":96818,"_5":17384,"_23720":96745,"_2383":96819},[],"revisa las políticas concedidas al principal;",{"_2856":58015,"_25059":57982,"_17489":96821,"_5":17384,"_23720":96745,"_2383":96822},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2856":58016,"_25059":57982,"_17489":96824,"_5":17384,"_23720":96745,"_2383":96825},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2856":58017,"_25059":57982,"_17489":96827,"_5":17384,"_23720":96749,"_2383":96828},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2856":58018,"_25059":57982,"_17489":96830,"_5":17384,"_23720":96749,"_2383":96831},[],"Localiza el pod y Service de authz.",{"_2856":58019,"_25059":57982,"_17489":96833,"_5":17384,"_23720":96749,"_2383":96834},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2856":58020,"_25059":57982,"_17489":96836,"_5":17384,"_23720":96749,"_2383":96837},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2856":58021,"_25059":57982,"_17489":96839,"_5":17384,"_23720":96749,"_2383":96840},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2856":58022,"_25059":57982,"_17489":96842,"_5":17384,"_23720":96749,"_2383":96843},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2856":58023,"_25059":57982,"_17489":96845,"_5":17384,"_23720":96753,"_2383":96846},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2856":58024,"_25059":57982,"_17489":96848,"_5":17384,"_23720":96753,"_2383":96849},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2856":58025,"_25059":57982,"_17489":96851,"_5":17384,"_23720":96753,"_2383":96852},[],"volumen persistente sin enlazar;",{"_2856":58026,"_25059":57982,"_17489":96854,"_5":17384,"_23720":96753,"_2383":96855},[],"imagen inaccesible o política de pull incorrecta;",{"_2856":58027,"_25059":57982,"_17489":96857,"_5":17384,"_23720":96753,"_2383":96858},[],"configuración inválida del motor criptográfico;",{"_2856":58028,"_25059":57982,"_17489":96860,"_5":17384,"_23720":96753,"_2383":96861},[],"límites de CPU o memoria demasiado bajos;",{"_2856":58029,"_25059":57982,"_17489":96863,"_5":17384,"_23720":96753,"_2383":96864},[],"migración previa incompleta.",{"_2856":58030,"_25059":57982,"_17489":96866,"_5":17384,"_23720":96753,"_2383":96867},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2856":58031,"_25059":57982,"_17489":96869,"_5":17384,"_23720":96753,"_2383":96870},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2856":58032,"_25059":57982,"_17489":96872,"_5":17384,"_23720":96757,"_2383":96873},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2856":58033,"_25059":57982,"_17489":96875,"_5":17384,"_23720":96757,"_2383":96876},[],"verifica que esté habilitado en el servicio emisor;",{"_2856":58034,"_25059":57982,"_17489":96878,"_5":17384,"_23720":96757,"_2383":96879},[],"comprueba conectividad y credenciales AMQP;",{"_2856":58035,"_25059":57982,"_17489":96881,"_5":17384,"_23720":96757,"_2383":96882},[],"revisa exchange, routing key, colas y consumidores;",{"_2856":58036,"_25059":57982,"_17489":96884,"_5":17384,"_23720":96757,"_2383":96885},[],"inspecciona dead-letter queues;",{"_2856":58037,"_25059":57982,"_17489":96887,"_5":17384,"_23720":96757,"_2383":96888},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2856":58038,"_25059":57982,"_17489":96890,"_5":17384,"_23720":96757,"_2383":96891},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2856":58039,"_25059":57982,"_17489":96893,"_5":17384,"_23720":96761,"_2383":96894},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2856":58040,"_25059":57982,"_17489":96896,"_5":17384,"_23720":96761,"_2383":96897},[],"Antes de cerrar una incidencia, guarda:",{"_2856":58041,"_25059":57982,"_17489":96899,"_5":17384,"_23720":96761,"_2383":96900},[],"causa confirmada;",{"_2856":58042,"_25059":57982,"_17489":96902,"_5":17384,"_23720":96761,"_2383":96903},[],"alcance temporal y recursos afectados;",{"_2856":58043,"_25059":57982,"_17489":96905,"_5":17384,"_23720":96761,"_2383":96906},[],"comandos o consultas utilizados;",{"_2856":58044,"_25059":57982,"_17489":96908,"_5":17384,"_23720":96761,"_2383":96909},[],"cambio aplicado y forma de revertirlo;",{"_2856":58045,"_25059":57982,"_17489":96911,"_5":17384,"_23720":96761,"_2383":96912},[],"validación desde un consumidor;",{"_2856":58046,"_25059":57982,"_17489":96914,"_5":17384,"_23720":96761,"_2383":96915},[],"acción preventiva y propietario.",{"_2856":58047,"_25059":58047,"_5":12268,"_2383":96917,"_25374":96918,"_17489":96921,"_23720":58047},"Control de acceso",[40699,96919,96920],"Plataforma","Administración",[],{"_2856":58048,"_25059":58047,"_17489":96923,"_5":17384,"_23720":58047,"_2383":96924},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2856":58049,"_25059":58047,"_5":25371,"_17489":96926,"_23720":96927,"_2383":96928},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2856":58050,"_25059":58047,"_5":25371,"_17489":96930,"_23720":96931,"_2383":96932},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2856":58051,"_25059":58047,"_5":25371,"_17489":96934,"_23720":96935,"_2383":96936},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2856":58052,"_25059":58047,"_5":25371,"_17489":96938,"_23720":96939,"_2383":96940},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2856":58053,"_25059":58047,"_5":25371,"_17489":96942,"_23720":96943,"_2383":96944},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2856":58054,"_25059":58047,"_5":25371,"_17489":96946,"_23720":96947,"_2383":96948},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2856":58055,"_25059":58047,"_5":25371,"_17489":96950,"_23720":96951,"_2383":96952},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2856":58056,"_25059":58047,"_5":25371,"_17489":96954,"_23720":96955,"_2383":96956},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2856":58057,"_25059":58047,"_5":25371,"_17489":96958,"_23720":96959,"_2383":96960},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2856":58058,"_25059":58047,"_5":25371,"_17489":96962,"_23720":96963,"_2383":96964},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2856":58059,"_25059":58047,"_5":25371,"_17489":96966,"_23720":96967,"_2383":96968},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2856":58060,"_25059":58047,"_5":25371,"_17489":96970,"_23720":96971,"_2383":96972},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2856":58061,"_25059":58047,"_5":25371,"_17489":96974,"_23720":96975,"_2383":96976},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2856":58062,"_25059":58047,"_5":25371,"_17489":96978,"_23720":96979,"_2383":96980},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2856":58063,"_25059":58047,"_5":25371,"_17489":96982,"_23720":96983,"_2383":96984},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2856":58064,"_25059":58047,"_5":25371,"_17489":96986,"_23720":96987,"_2383":96181},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2856":58065,"_25059":58047,"_5":25371,"_17489":96989,"_23720":96990,"_2383":96991},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2856":58066,"_25059":58047,"_5":25371,"_17489":96993,"_23720":96994,"_2383":96995},[],"/docs/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2856":58067,"_25059":58047,"_5":25371,"_17489":96997,"_23720":96998,"_2383":96999},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2856":58068,"_25059":58047,"_5":25371,"_17489":97001,"_23720":97002,"_2383":97003},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2856":58069,"_25059":58047,"_5":25371,"_17489":97005,"_23720":97006,"_2383":97007},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2856":58070,"_25059":58047,"_5":25371,"_17489":97009,"_23720":97010,"_2383":97011},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2856":58071,"_25059":58047,"_5":25371,"_17489":97013,"_23720":97014,"_2383":97015},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2856":58072,"_25059":58047,"_5":25371,"_17489":97017,"_23720":97018,"_2383":97019},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2856":58073,"_25059":58047,"_5":25371,"_17489":97021,"_23720":97022,"_2383":97023},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2856":58074,"_25059":58047,"_5":25371,"_17489":97025,"_23720":97026,"_2383":97027},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2856":58075,"_25059":58047,"_5":25371,"_17489":97029,"_23720":97030,"_2383":97031},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2856":58076,"_25059":58047,"_5":25371,"_17489":97033,"_23720":97034,"_2383":97035},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2856":58077,"_25059":58047,"_5":25371,"_17489":97037,"_23720":97038,"_2383":97039},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2856":58078,"_25059":58047,"_5":25371,"_17489":97041,"_23720":97042,"_2383":97043},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2856":58079,"_25059":58047,"_5":25371,"_17489":97045,"_23720":97046,"_2383":97047},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2856":58080,"_25059":58047,"_17489":97049,"_5":17384,"_23720":58047,"_2383":97050},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2856":58081,"_25059":58047,"_17489":97052,"_5":17384,"_23720":58047,"_2383":97053},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2856":58082,"_25059":58047,"_17489":97055,"_5":17384,"_23720":58047,"_2383":97056},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2856":58083,"_25059":58047,"_17489":97058,"_5":17384,"_23720":96927,"_2383":97059},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2856":58084,"_25059":58047,"_17489":97061,"_5":17384,"_23720":96927,"_2383":97062},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2856":58085,"_25059":58047,"_17489":97064,"_5":17384,"_23720":96927,"_2383":97065},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2856":58086,"_25059":58047,"_17489":97067,"_5":17384,"_23720":96927,"_2383":97068},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2856":58087,"_25059":58047,"_17489":97070,"_5":17384,"_23720":96927,"_2383":97071},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2856":58088,"_25059":58047,"_17489":97073,"_5":17384,"_23720":96927,"_2383":97074},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2856":58089,"_25059":58047,"_17489":97076,"_5":17384,"_23720":96931,"_2383":97077},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2856":58090,"_25059":58047,"_17489":97079,"_5":17384,"_23720":96931,"_2383":97080},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2856":58091,"_25059":58047,"_17489":97082,"_5":17384,"_23720":96935,"_2383":97083},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2856":58092,"_25059":58047,"_17489":97085,"_5":17384,"_23720":96935,"_2383":97086},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2856":58093,"_25059":58047,"_17489":97088,"_5":17384,"_23720":96935,"_2383":97089},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2856":58094,"_25059":58047,"_17489":97091,"_5":17384,"_23720":96935,"_2383":97092},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2856":58095,"_25059":58047,"_17489":97094,"_5":17384,"_23720":96935,"_2383":97095},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2856":58096,"_25059":58047,"_17489":97097,"_5":17384,"_23720":96935,"_2383":97098},[],"Carga por separado las políticas concedidas a cada principal.",{"_2856":58097,"_25059":58047,"_17489":97100,"_5":17384,"_23720":96935,"_2383":97101},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2856":58098,"_25059":58047,"_17489":97103,"_5":17384,"_23720":96935,"_2383":97104},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2856":58099,"_25059":58047,"_17489":97106,"_5":17384,"_23720":96935,"_2383":97107},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2856":58100,"_25059":58047,"_17489":97109,"_5":17384,"_23720":96935,"_2383":97110},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2856":58101,"_25059":58047,"_17489":97112,"_5":17384,"_23720":96935,"_2383":97113},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2856":58102,"_25059":58047,"_17489":97115,"_5":17384,"_23720":96935,"_2383":97116},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2856":58103,"_25059":58047,"_17489":97118,"_5":17384,"_23720":96939,"_2383":97119},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2856":58104,"_25059":58047,"_17489":97121,"_5":17384,"_23720":96939,"_2383":97122},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2856":58105,"_25059":58047,"_17489":97124,"_5":17384,"_23720":96939,"_2383":97125},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2856":58106,"_25059":58047,"_17489":97127,"_5":17384,"_23720":96939,"_2383":97128},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2856":58107,"_25059":58047,"_17489":97130,"_5":17384,"_23720":96939,"_2383":97131},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2856":58108,"_25059":58047,"_17489":97133,"_5":17384,"_23720":96939,"_2383":97134},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2856":58109,"_25059":58047,"_17489":97136,"_5":17384,"_23720":96939,"_2383":97137},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2856":58110,"_25059":58047,"_17489":97139,"_5":17384,"_23720":96939,"_2383":97140},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2856":58111,"_25059":58047,"_17489":97142,"_5":17384,"_23720":96943,"_2383":97143},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2856":58112,"_25059":58047,"_17489":97145,"_5":17384,"_23720":96943,"_2383":97146},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2856":58113,"_25059":58047,"_17489":97148,"_5":17384,"_23720":96943,"_2383":97149},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2856":58114,"_25059":58047,"_17489":97151,"_5":17384,"_23720":96943,"_2383":97152},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2856":58115,"_25059":58047,"_17489":97154,"_5":17384,"_23720":96943,"_2383":97155},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2856":58116,"_25059":58047,"_17489":97157,"_5":17384,"_23720":96943,"_2383":97158},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2856":58117,"_25059":58047,"_17489":97160,"_5":17384,"_23720":96943,"_2383":97161},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2856":58118,"_25059":58047,"_17489":97163,"_5":17384,"_23720":96943,"_2383":97164},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2856":58119,"_25059":58047,"_17489":97166,"_5":17384,"_23720":96943,"_2383":97167},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2856":58120,"_25059":58047,"_17489":97169,"_5":17384,"_23720":96943,"_2383":97170},[],"Las acciones se dividen en dos grupos:",{"_2856":58121,"_25059":58047,"_17489":97172,"_5":17384,"_23720":96943,"_2383":97173},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2856":58122,"_25059":58047,"_17489":97175,"_5":17384,"_23720":96943,"_2383":97176},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2856":58123,"_25059":58047,"_17489":97178,"_5":17384,"_23720":96943,"_2383":97179},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2856":58124,"_25059":58047,"_17489":97181,"_5":17384,"_23720":96947,"_2383":97182},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2856":58125,"_25059":58047,"_17489":97184,"_5":17384,"_23720":96947,"_2383":97185},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2856":58126,"_25059":58047,"_17489":97187,"_5":17384,"_23720":96947,"_2383":97188},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2856":58127,"_25059":58047,"_17489":97190,"_5":17384,"_23720":96951,"_2383":97191},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2856":58128,"_25059":58047,"_17489":97193,"_5":17384,"_23720":96951,"_2383":97194},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2856":58129,"_25059":58047,"_17489":97196,"_5":17384,"_23720":96951,"_2383":97197},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2856":58130,"_25059":58047,"_17489":97199,"_5":17384,"_23720":96951,"_2383":97200},[],"Los operadores implementados son:",{"_2856":58131,"_25059":58047,"_17489":97202,"_5":17384,"_23720":96951,"_2383":97203},[],"`equals`, para igualdad exacta;",{"_2856":58132,"_25059":58047,"_17489":97205,"_5":17384,"_23720":96951,"_2383":97206},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2856":58133,"_25059":58047,"_17489":97208,"_5":17384,"_23720":96951,"_2383":97209},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2856":58134,"_25059":58047,"_17489":97211,"_5":17384,"_23720":96951,"_2383":97212},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2856":58135,"_25059":58047,"_17489":97214,"_5":17384,"_23720":96955,"_2383":97215},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2856":58136,"_25059":58047,"_17489":97217,"_5":17384,"_23720":96955,"_2383":97218},[],"Los modos disponibles son:",{"_2856":58137,"_25059":58047,"_17489":97220,"_5":17384,"_23720":96955,"_2383":97221},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2856":58138,"_25059":58047,"_17489":97223,"_5":17384,"_23720":96955,"_2383":97224},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2856":58139,"_25059":58047,"_17489":97226,"_5":17384,"_23720":96955,"_2383":97227},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2856":58140,"_25059":58047,"_17489":97229,"_5":17384,"_23720":96955,"_2383":97230},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2856":58141,"_25059":58047,"_17489":97232,"_5":17384,"_23720":96955,"_2383":97233},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2856":58142,"_25059":58047,"_17489":97235,"_5":17384,"_23720":96955,"_2383":97236},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2856":58143,"_25059":58047,"_17489":97238,"_5":17384,"_23720":96959,"_2383":97239},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2856":58144,"_25059":58047,"_17489":97241,"_5":17384,"_23720":96959,"_2383":97242},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2856":58145,"_25059":58047,"_17489":97244,"_5":17384,"_23720":96959,"_2383":97245},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2856":58146,"_25059":58047,"_17489":97247,"_5":17384,"_23720":96959,"_2383":97248},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2856":58147,"_25059":58047,"_17489":97250,"_5":17384,"_23720":96967,"_2383":97251},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2856":58148,"_25059":58047,"_17489":97253,"_5":17384,"_23720":96967,"_2383":97254},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2856":58149,"_25059":58047,"_17489":97256,"_5":17384,"_23720":96971,"_2383":97257},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2856":58150,"_25059":58047,"_17489":97259,"_5":17384,"_23720":96971,"_2383":97260},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2856":58151,"_25059":58047,"_17489":97262,"_5":17384,"_23720":96975,"_2383":97263},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2856":58152,"_25059":58047,"_17489":97265,"_5":17384,"_23720":96975,"_2383":97266},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2856":58153,"_25059":58047,"_17489":97268,"_5":17384,"_23720":96975,"_2383":97269},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2856":58154,"_25059":58047,"_17489":97271,"_5":17384,"_23720":96979,"_2383":97272},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2856":58155,"_25059":58047,"_17489":97274,"_5":17384,"_23720":96979,"_2383":97275},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2856":58156,"_25059":58047,"_17489":97277,"_5":17384,"_23720":96979,"_2383":97278},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2856":58157,"_25059":58047,"_17489":97280,"_5":17384,"_23720":96979,"_2383":97281},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2856":58158,"_25059":58047,"_17489":97283,"_5":17384,"_23720":96979,"_2383":97284},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2856":58159,"_25059":58047,"_17489":97286,"_5":17384,"_23720":96979,"_2383":97287},[],"Ten en cuenta que:",{"_2856":58160,"_25059":58047,"_17489":97289,"_5":17384,"_23720":96979,"_2383":97290},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2856":58161,"_25059":58047,"_17489":97292,"_5":17384,"_23720":96979,"_2383":97293},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2856":58162,"_25059":58047,"_17489":97295,"_5":17384,"_23720":96979,"_2383":97296},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2856":58163,"_25059":58047,"_17489":97298,"_5":17384,"_23720":96983,"_2383":97299},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2856":58164,"_25059":58047,"_17489":97301,"_5":17384,"_23720":96983,"_2383":97302},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2856":58165,"_25059":58047,"_17489":97304,"_5":17384,"_23720":96983,"_2383":97305},[],"acceso completo y de solo lectura a KMS;",{"_2856":58166,"_25059":58047,"_17489":97307,"_5":17384,"_23720":96983,"_2383":97308},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2856":58167,"_25059":58047,"_17489":97310,"_5":17384,"_23720":96983,"_2383":97311},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2856":58168,"_25059":58047,"_17489":97313,"_5":17384,"_23720":96983,"_2383":97314},[],"acceso a la interfaz;",{"_2856":58169,"_25059":58047,"_17489":97316,"_5":17384,"_23720":96983,"_2383":97317},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2856":58170,"_25059":58047,"_17489":97319,"_5":17384,"_23720":96983,"_2383":97320},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2856":58171,"_25059":58047,"_17489":97322,"_5":17384,"_23720":96983,"_2383":97323},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2856":58172,"_25059":58047,"_17489":97325,"_5":17384,"_23720":96987,"_2383":97326},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2856":58173,"_25059":58047,"_17489":97328,"_5":17384,"_23720":96987,"_2383":97329},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2856":58174,"_25059":58047,"_17489":97331,"_5":17384,"_23720":96987,"_2383":97332},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2856":58175,"_25059":58047,"_17489":97334,"_5":17384,"_23720":96990,"_2383":97335},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2856":58176,"_25059":58047,"_17489":97337,"_5":17384,"_23720":96994,"_2383":97338},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2856":58177,"_25059":58047,"_17489":97340,"_5":17384,"_23720":96998,"_2383":97341},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2856":58178,"_25059":58047,"_17489":97343,"_5":17384,"_23720":97002,"_2383":97344},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2856":58179,"_25059":58047,"_17489":97346,"_5":17384,"_23720":97006,"_2383":97347},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2856":58180,"_25059":58047,"_17489":97349,"_5":17384,"_23720":97010,"_2383":97350},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2856":58181,"_25059":58047,"_17489":97352,"_5":17384,"_23720":97010,"_2383":97353},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2856":58182,"_25059":58047,"_17489":97355,"_5":17384,"_23720":97014,"_2383":97356},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2856":58183,"_25059":58047,"_17489":97358,"_5":17384,"_23720":97014,"_2383":97359},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2856":58184,"_25059":58047,"_17489":97361,"_5":17384,"_23720":97014,"_2383":97362},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2856":58185,"_25059":58047,"_17489":97364,"_5":17384,"_23720":97014,"_2383":97365},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2856":58186,"_25059":58047,"_17489":97367,"_5":17384,"_23720":97014,"_2383":97368},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2856":58187,"_25059":58047,"_17489":97370,"_5":17384,"_23720":97014,"_2383":97371},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2856":58188,"_25059":58047,"_17489":97373,"_5":17384,"_23720":97014,"_2383":97374},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2856":58189,"_25059":58047,"_17489":97376,"_5":17384,"_23720":97014,"_2383":97377},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2856":58190,"_25059":58047,"_17489":97379,"_5":17384,"_23720":97018,"_2383":97380},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2856":58191,"_25059":58047,"_17489":97382,"_5":17384,"_23720":97018,"_2383":97383},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2856":58192,"_25059":58047,"_17489":97385,"_5":17384,"_23720":97018,"_2383":97386},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2856":58193,"_25059":58047,"_17489":97388,"_5":17384,"_23720":97022,"_2383":97389},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2856":58194,"_25059":58047,"_17489":97391,"_5":17384,"_23720":97022,"_2383":97392},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2856":58195,"_25059":58047,"_17489":97394,"_5":17384,"_23720":97022,"_2383":97395},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2856":58196,"_25059":58047,"_17489":97397,"_5":17384,"_23720":97022,"_2383":97398},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2856":58197,"_25059":58047,"_17489":97400,"_5":17384,"_23720":97022,"_2383":97401},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2856":58198,"_25059":58047,"_17489":97403,"_5":17384,"_23720":97022,"_2383":97404},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2856":58199,"_25059":58047,"_17489":97406,"_5":17384,"_23720":97022,"_2383":97407},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2856":58200,"_25059":58047,"_17489":97409,"_5":17384,"_23720":97022,"_2383":97410},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2856":58201,"_25059":58047,"_17489":97412,"_5":17384,"_23720":97030,"_2383":97413},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2856":58202,"_25059":58047,"_17489":97415,"_5":17384,"_23720":97034,"_2383":97416},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2856":58203,"_25059":58047,"_17489":97418,"_5":17384,"_23720":97034,"_2383":97419},[],"que exista un principal activo del tipo correcto;",{"_2856":58204,"_25059":58047,"_17489":97421,"_5":17384,"_23720":97034,"_2383":97422},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2856":58205,"_25059":58047,"_17489":97424,"_5":17384,"_23720":97034,"_2383":97425},[],"que todas las condiciones del principal se cumplan;",{"_2856":58206,"_25059":58047,"_17489":97427,"_5":17384,"_23720":97034,"_2383":97428},[],"que el principal tenga concedida la política esperada;",{"_2856":58207,"_25059":58047,"_17489":97430,"_5":17384,"_23720":97034,"_2383":97431},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2856":58208,"_25059":58047,"_17489":97433,"_5":17384,"_23720":97034,"_2383":97434},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2856":58209,"_25059":58047,"_17489":97436,"_5":17384,"_23720":97034,"_2383":97437},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2856":58210,"_25059":58047,"_17489":97439,"_5":17384,"_23720":97038,"_2383":97440},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2856":58211,"_25059":58047,"_17489":97442,"_5":17384,"_23720":97042,"_2383":97443},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2856":58212,"_25059":58047,"_17489":97445,"_5":17384,"_23720":97046,"_2383":97446},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2856":58213,"_25059":58047,"_17489":97448,"_5":17384,"_23720":97046,"_2383":97449},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2856":58214,"_25059":58214,"_5":12268,"_2383":97451,"_25374":97452,"_17489":97453,"_23720":58214},"Alertas y suscripciones",[40699,96919,96920],[],{"_2856":58215,"_25059":58214,"_17489":97455,"_5":17384,"_23720":58214,"_2383":97456},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2856":58216,"_25059":58214,"_5":25371,"_17489":97458,"_23720":97459,"_2383":97460},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2856":58217,"_25059":58214,"_5":25371,"_17489":97462,"_23720":97463,"_2383":97464},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2856":58218,"_25059":58214,"_5":25371,"_17489":97466,"_23720":97467,"_2383":97468},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2856":58219,"_25059":58214,"_5":25371,"_17489":97470,"_23720":97471,"_2383":97472},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2856":58220,"_25059":58214,"_5":25371,"_17489":97474,"_23720":97475,"_2383":97476},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2856":58221,"_25059":58214,"_5":25371,"_17489":97478,"_23720":97479,"_2383":97480},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2856":58222,"_25059":58214,"_5":25371,"_17489":97482,"_23720":97483,"_2383":97484},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2856":58223,"_25059":58214,"_5":25371,"_17489":97486,"_23720":97487,"_2383":97488},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2856":58224,"_25059":58214,"_5":25371,"_17489":97490,"_23720":97491,"_2383":97492},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2856":58225,"_25059":58214,"_5":25371,"_17489":97494,"_23720":97495,"_2383":97496},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2856":58226,"_25059":58214,"_17489":97498,"_5":17384,"_23720":58214,"_2383":97499},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2856":58227,"_25059":58214,"_17489":97501,"_5":17384,"_23720":97459,"_2383":97502},[],"Un servicio publica un evento de dominio.",{"_2856":58228,"_25059":58214,"_17489":97504,"_5":17384,"_23720":97459,"_2383":97505},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2856":58229,"_25059":58214,"_17489":97507,"_5":17384,"_23720":97459,"_2383":97508},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2856":58230,"_25059":58214,"_17489":97510,"_5":17384,"_23720":97459,"_2383":97511},[],"Lamassu entrega el evento al canal configurado.",{"_2856":58231,"_25059":58214,"_17489":97513,"_5":17384,"_23720":97459,"_2383":97514},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2856":58232,"_25059":58214,"_17489":97516,"_5":17384,"_23720":97463,"_2383":97517},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2856":58233,"_25059":58214,"_17489":97519,"_5":17384,"_23720":97463,"_2383":97520},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2856":58234,"_25059":58214,"_17489":97522,"_5":17384,"_23720":97463,"_2383":97523},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2856":58235,"_25059":58214,"_17489":97525,"_5":17384,"_23720":97463,"_2383":97526},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2856":58236,"_25059":58214,"_17489":97528,"_5":17384,"_23720":97463,"_2383":97529},[],"`apikey_options` necesita `header` y `key`.",{"_2856":58237,"_25059":58214,"_17489":97531,"_5":17384,"_23720":97463,"_2383":97532},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2856":58238,"_25059":58214,"_17489":97534,"_5":17384,"_23720":97463,"_2383":97535},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2856":58239,"_25059":58214,"_17489":97537,"_5":17384,"_23720":97463,"_2383":97538},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2856":58240,"_25059":58214,"_17489":97540,"_5":17384,"_23720":97471,"_2383":97541},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2856":58241,"_25059":58214,"_17489":97543,"_5":17384,"_23720":97475,"_2383":97544},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2856":58242,"_25059":58214,"_17489":97546,"_5":17384,"_23720":97479,"_2383":97547},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2856":58243,"_25059":58214,"_17489":97549,"_5":17384,"_23720":97479,"_2383":97550},[],"**None** notifica todas las instancias del evento.",{"_2856":58244,"_25059":58214,"_17489":97552,"_5":17384,"_23720":97479,"_2383":97553},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2856":58245,"_25059":58214,"_17489":97555,"_5":17384,"_23720":97479,"_2383":97556},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2856":58246,"_25059":58214,"_17489":97558,"_5":17384,"_23720":97479,"_2383":97559},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2856":58247,"_25059":58214,"_17489":97561,"_5":17384,"_23720":97479,"_2383":97562},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2856":58248,"_25059":58214,"_17489":97564,"_5":17384,"_23720":97483,"_2383":97565},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2856":58249,"_25059":58214,"_17489":97567,"_5":17384,"_23720":97487,"_2383":97568},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2856":58250,"_25059":58214,"_17489":97570,"_5":17384,"_23720":97487,"_2383":97571},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2856":58251,"_25059":58214,"_17489":97573,"_5":17384,"_23720":97487,"_2383":97574},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2856":58252,"_25059":58214,"_17489":97576,"_5":17384,"_23720":97487,"_2383":97577},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2856":58253,"_25059":58214,"_17489":97579,"_5":17384,"_23720":97487,"_2383":97580},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2856":58254,"_25059":58214,"_17489":97582,"_5":17384,"_23720":97487,"_2383":97583},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2856":58255,"_25059":58214,"_17489":97585,"_5":17384,"_23720":97487,"_2383":97586},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2856":58256,"_25059":58214,"_17489":97588,"_5":17384,"_23720":97487,"_2383":97589},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2856":58257,"_25059":58214,"_17489":97591,"_5":17384,"_23720":97491,"_2383":97592},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2856":58258,"_25059":58214,"_17489":97594,"_5":17384,"_23720":97495,"_2383":97595},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2856":58259,"_25059":58214,"_17489":97597,"_5":17384,"_23720":97495,"_2383":97598},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2856":58260,"_25059":58214,"_17489":97600,"_5":17384,"_23720":97495,"_2383":97601},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2856":58261,"_25059":58214,"_17489":97603,"_5":17384,"_23720":97495,"_2383":97604},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2856":58262,"_25059":58214,"_17489":97606,"_5":17384,"_23720":97495,"_2383":97607},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2856":58263,"_25059":58214,"_17489":97609,"_5":17384,"_23720":97495,"_2383":97610},[],"**Validación:** `va.role.crl.create`.",{"_2856":58264,"_25059":58214,"_17489":97612,"_5":17384,"_23720":97495,"_2383":97613},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2856":58265,"_25059":58214,"_17489":97615,"_5":17384,"_23720":97495,"_2383":97616},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2856":58266,"_25059":58266,"_5":12268,"_2383":97618,"_25374":97619,"_17489":97620,"_23720":58266},"Registros de auditoría",[40699,96919,96920],[],{"_2856":58267,"_25059":58266,"_17489":97622,"_5":17384,"_23720":58266,"_2383":97623},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2856":58268,"_25059":58266,"_5":25371,"_17489":97625,"_23720":97626,"_2383":97627},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2856":58269,"_25059":58266,"_5":25371,"_17489":97629,"_23720":97630,"_2383":97631},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2856":58270,"_25059":58266,"_5":25371,"_17489":97633,"_23720":97634,"_2383":97635},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2856":58271,"_25059":58266,"_5":25371,"_17489":97637,"_23720":97638,"_2383":97639},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2856":58272,"_25059":58266,"_5":25371,"_17489":97641,"_23720":97642,"_2383":97643},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2856":58273,"_25059":58266,"_5":25371,"_17489":97645,"_23720":97646,"_2383":97647},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2856":58274,"_25059":58266,"_5":25371,"_17489":97649,"_23720":97650,"_2383":97651},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2856":58275,"_25059":58266,"_5":25371,"_17489":97653,"_23720":97654,"_2383":97655},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2856":58276,"_25059":58266,"_5":25371,"_17489":97657,"_23720":97658,"_2383":97659},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2856":58277,"_25059":58266,"_5":25371,"_17489":97661,"_23720":97662,"_2383":97663},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2856":58278,"_25059":58266,"_5":25371,"_17489":97665,"_23720":97666,"_2383":97667},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2856":58279,"_25059":58266,"_17489":97669,"_5":17384,"_23720":58266,"_2383":97670},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2856":58280,"_25059":58266,"_17489":97672,"_5":17384,"_23720":97626,"_2383":97673},[],"El cuerpo de auditoría incluye:",{"_2856":58281,"_25059":58266,"_17489":97675,"_5":17384,"_23720":97626,"_2383":97676},[],"input: datos recibidos por la operación;",{"_2856":58282,"_25059":58266,"_17489":97678,"_5":17384,"_23720":97626,"_2383":97679},[],"has\\_error: indica si el servicio devolvió un error;",{"_2856":58283,"_25059":58266,"_17489":97681,"_5":17384,"_23720":97626,"_2383":97682},[],"output: resultado producido o mensaje de error;",{"_2856":58284,"_25059":58266,"_17489":97684,"_5":17384,"_23720":97626,"_2383":97685},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2856":58285,"_25059":58266,"_17489":97687,"_5":17384,"_23720":97626,"_2383":97688},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2856":58286,"_25059":58266,"_17489":97690,"_5":17384,"_23720":97626,"_2383":97691},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2856":58287,"_25059":58266,"_17489":97693,"_5":17384,"_23720":97630,"_2383":97694},[],"El backend aplica auditoría a mutaciones de:",{"_2856":58288,"_25059":58266,"_17489":97696,"_5":17384,"_23720":97630,"_2383":97697},[],"autoridades, certificados y perfiles de emisión;",{"_2856":58289,"_25059":58266,"_17489":97699,"_5":17384,"_23720":97630,"_2383":97700},[],"claves y motores KMS;",{"_2856":58290,"_25059":58266,"_17489":97702,"_5":17384,"_23720":97630,"_2383":97703},[],"dispositivos e identidades;",{"_2856":58291,"_25059":58266,"_17489":97705,"_5":17384,"_23720":97630,"_2383":97706},[],"DMS y operaciones de enrolamiento;",{"_2856":58292,"_25059":58266,"_17489":97708,"_5":17384,"_23720":97630,"_2383":97709},[],"funciones de validación y CRL;",{"_2856":58293,"_25059":58266,"_17489":97711,"_5":17384,"_23720":97630,"_2383":97712},[],"principales, políticas y concesiones de autorización.",{"_2856":58294,"_25059":58266,"_17489":97714,"_5":17384,"_23720":97630,"_2383":97715},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2856":58295,"_25059":58266,"_17489":97717,"_5":17384,"_23720":97634,"_2383":97718},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2856":58296,"_25059":58266,"_17489":97720,"_5":17384,"_23720":97634,"_2383":97721},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2856":58297,"_25059":58266,"_17489":97723,"_5":17384,"_23720":97634,"_2383":97724},[],"Diseña el consumidor para:",{"_2856":58298,"_25059":58266,"_17489":97726,"_5":17384,"_23720":97634,"_2383":97727},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2856":58299,"_25059":58266,"_17489":97729,"_5":17384,"_23720":97634,"_2383":97730},[],"conservar el CloudEvent completo sin modificar;",{"_2856":58300,"_25059":58266,"_17489":97732,"_5":17384,"_23720":97634,"_2383":97733},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2856":58301,"_25059":58266,"_17489":97735,"_5":17384,"_23720":97634,"_2383":97736},[],"cifrar en tránsito y en reposo;",{"_2856":58302,"_25059":58266,"_17489":97738,"_5":17384,"_23720":97634,"_2383":97739},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2856":58303,"_25059":58266,"_17489":97741,"_5":17384,"_23720":97634,"_2383":97742},[],"aplicar una política explícita de retención y legal hold;",{"_2856":58304,"_25059":58266,"_17489":97744,"_5":17384,"_23720":97634,"_2383":97745},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2856":58305,"_25059":58266,"_17489":97747,"_5":17384,"_23720":97638,"_2383":97748},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2856":58306,"_25059":58266,"_17489":97750,"_5":17384,"_23720":97638,"_2383":97751},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2856":58307,"_25059":58266,"_17489":97753,"_5":17384,"_23720":97646,"_2383":97754},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2856":58308,"_25059":58266,"_17489":97756,"_5":17384,"_23720":97650,"_2383":97757},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2856":58309,"_25059":58266,"_17489":97759,"_5":17384,"_23720":97654,"_2383":97760},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2856":58310,"_25059":58266,"_17489":97762,"_5":17384,"_23720":97658,"_2383":97763},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2856":58311,"_25059":58266,"_17489":97765,"_5":17384,"_23720":97662,"_2383":97766},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2856":58312,"_25059":58266,"_17489":97768,"_5":17384,"_23720":97666,"_2383":97769},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2856":58313,"_25059":58266,"_17489":97771,"_5":17384,"_23720":97666,"_2383":97772},[],"aparece un evento de auditoría correcto;",{"_2856":58314,"_25059":58266,"_17489":97774,"_5":17384,"_23720":97666,"_2383":97775},[],"el principal coincide con la identidad utilizada;",{"_2856":58315,"_25059":58266,"_17489":97777,"_5":17384,"_23720":97666,"_2383":97778},[],"el consumidor lo persiste una sola vez;",{"_2856":58316,"_25059":58266,"_17489":97780,"_5":17384,"_23720":97666,"_2383":97781},[],"puede recuperarse por recurso, actor y periodo;",{"_2856":58317,"_25059":58266,"_17489":97783,"_5":17384,"_23720":97666,"_2383":97784},[],"una interrupción del consumidor produce una alerta.",{"_2856":58318,"_25059":58266,"_17489":97786,"_5":17384,"_23720":97666,"_2383":97787},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2856":58319,"_25059":58319,"_5":12268,"_2383":97789,"_25374":97790,"_17489":97791,"_23720":58319},"Arquitectura de la plataforma",[40699,96919],[],{"_2856":58320,"_25059":58319,"_17489":97793,"_5":17384,"_23720":58319,"_2383":97794},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2856":58321,"_25059":58319,"_5":25371,"_17489":97796,"_23720":97797,"_2383":97798},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2856":58322,"_25059":58319,"_5":25371,"_17489":97800,"_23720":97801,"_2383":97802},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2856":58323,"_25059":58319,"_5":25371,"_17489":97804,"_23720":97805,"_2383":97806},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2856":58324,"_25059":58319,"_5":25371,"_17489":97808,"_23720":97809,"_2383":97810},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2856":58325,"_25059":58319,"_5":25371,"_17489":97812,"_23720":97813,"_2383":97814},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2856":58326,"_25059":58319,"_17489":97816,"_5":17384,"_23720":58319,"_2383":97817},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2856":58327,"_25059":58319,"_17489":97819,"_5":17384,"_23720":58319,"_2383":97820},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2856":58328,"_25059":58319,"_17489":97822,"_5":17384,"_23720":97797,"_2383":97823},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2856":58329,"_25059":58319,"_17489":97825,"_5":17384,"_23720":97801,"_2383":97826},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2856":58330,"_25059":58319,"_17489":97828,"_5":17384,"_23720":97805,"_2383":97829},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2856":58331,"_25059":58319,"_17489":97831,"_5":17384,"_23720":97809,"_2383":97832},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2856":58332,"_25059":58319,"_17489":97834,"_5":17384,"_23720":97813,"_2383":97835},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2856":58333,"_25059":58333,"_5":12268,"_2383":97837,"_25374":97838,"_17489":97839,"_23720":58333},"Cómo funciona Lamassu",[40699,96919],[],{"_2856":58334,"_25059":58333,"_17489":97841,"_5":17384,"_23720":58333,"_2383":97842},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2856":58335,"_25059":58333,"_5":25371,"_17489":97844,"_23720":97845,"_2383":97846},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2856":58336,"_25059":58333,"_5":25371,"_17489":97848,"_23720":97849,"_2383":97850},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2856":58337,"_25059":58333,"_17489":97852,"_5":17384,"_23720":58333,"_2383":97853},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2856":58338,"_25059":58333,"_17489":97855,"_5":17384,"_23720":97845,"_2383":97856},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2856":58339,"_25059":58333,"_17489":97858,"_5":17384,"_23720":97845,"_2383":97859},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2856":58340,"_25059":58333,"_17489":97861,"_5":17384,"_23720":97845,"_2383":97862},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2856":58341,"_25059":58333,"_17489":97864,"_5":17384,"_23720":97845,"_2383":97865},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2856":58342,"_25059":58333,"_17489":97867,"_5":17384,"_23720":97845,"_2383":97868},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2856":58343,"_25059":58333,"_17489":97870,"_5":17384,"_23720":97849,"_2383":97871},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2856":58344,"_25059":58333,"_17489":97873,"_5":17384,"_23720":97849,"_2383":97874},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2856":58345,"_25059":58333,"_17489":97876,"_5":17384,"_23720":97849,"_2383":97877},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2856":58346,"_25059":58333,"_17489":97879,"_5":17384,"_23720":97849,"_2383":97880},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2856":58347,"_25059":58333,"_17489":97882,"_5":17384,"_23720":97849,"_2383":97883},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2856":58348,"_25059":58333,"_17489":97885,"_5":17384,"_23720":97849,"_2383":97886},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2856":58349,"_25059":58333,"_17489":97888,"_5":17384,"_23720":97849,"_2383":97889},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2856":58350,"_25059":58350,"_5":12268,"_2383":97891,"_25374":97892,"_17489":97893,"_23720":58350},"Dispositivos e identidades",[40699,96919,43017,97891],[],{"_2856":58351,"_25059":58350,"_17489":97895,"_5":17384,"_23720":58350,"_2383":97896},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2856":58352,"_25059":58350,"_5":25371,"_17489":97898,"_23720":97899,"_2383":97900},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2856":58353,"_25059":58350,"_5":25371,"_17489":97902,"_23720":97903,"_2383":97904},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2856":58354,"_25059":58350,"_5":25371,"_17489":97906,"_23720":97907,"_2383":97908},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2856":58355,"_25059":58350,"_5":25371,"_17489":97910,"_23720":97911,"_2383":97912},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2856":58356,"_25059":58350,"_5":25371,"_17489":97914,"_23720":97915,"_2383":97916},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2856":58357,"_25059":58350,"_5":25371,"_17489":97918,"_23720":97919,"_2383":97920},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2856":58358,"_25059":58350,"_5":25371,"_17489":97922,"_23720":97923,"_2383":97924},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2856":58359,"_25059":58350,"_5":25371,"_17489":97926,"_23720":97927,"_2383":97928},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2856":58360,"_25059":58350,"_5":25371,"_17489":97930,"_23720":97931,"_2383":97932},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2856":58361,"_25059":58350,"_5":25371,"_17489":97934,"_23720":97935,"_2383":97936},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2856":58362,"_25059":58350,"_5":25371,"_17489":97938,"_23720":97939,"_2383":97940},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2856":58363,"_25059":58350,"_17489":97942,"_5":17384,"_23720":58350,"_2383":97943},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2856":58364,"_25059":58350,"_17489":97945,"_5":17384,"_23720":58350,"_2383":97946},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2856":58365,"_25059":58350,"_17489":97948,"_5":17384,"_23720":97899,"_2383":97949},[],"Vista operativa",{"_2856":58366,"_25059":58350,"_17489":97951,"_5":17384,"_23720":97899,"_2383":97952},[],"Interpretación",{"_2856":58367,"_25059":58350,"_17489":97954,"_5":17384,"_23720":97899,"_2383":43080},[],{"_2856":58368,"_25059":58350,"_17489":97956,"_5":17384,"_23720":97899,"_2383":97957},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2856":58369,"_25059":58350,"_17489":97959,"_5":17384,"_23720":97899,"_2383":43086},[],{"_2856":58370,"_25059":58350,"_17489":97961,"_5":17384,"_23720":97899,"_2383":97962},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2856":58371,"_25059":58350,"_17489":97964,"_5":17384,"_23720":97899,"_2383":43092},[],{"_2856":58372,"_25059":58350,"_17489":97966,"_5":17384,"_23720":97899,"_2383":97967},[],"La identidad está en la ventana operativa de renovación.",{"_2856":58373,"_25059":58350,"_17489":97969,"_5":17384,"_23720":97899,"_2383":43098},[],{"_2856":58374,"_25059":58350,"_17489":97971,"_5":17384,"_23720":97899,"_2383":97972},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2856":58375,"_25059":58350,"_17489":97974,"_5":17384,"_23720":97899,"_2383":43104},[],{"_2856":58376,"_25059":58350,"_17489":97976,"_5":17384,"_23720":97899,"_2383":97977},[],"La identidad ha vencido.",{"_2856":58377,"_25059":58350,"_17489":97979,"_5":17384,"_23720":97899,"_2383":43110},[],{"_2856":58378,"_25059":58350,"_17489":97981,"_5":17384,"_23720":97899,"_2383":97982},[],"La identidad está marcada como revocada.",{"_2856":58379,"_25059":58350,"_17489":97984,"_5":17384,"_23720":97899,"_2383":43116},[],{"_2856":58380,"_25059":58350,"_17489":97986,"_5":17384,"_23720":97899,"_2383":97987},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2856":58381,"_25059":58350,"_17489":97989,"_5":17384,"_23720":97899,"_2383":97990},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2856":58382,"_25059":58350,"_17489":97992,"_5":17384,"_23720":97903,"_2383":97993},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2856":58383,"_25059":58350,"_17489":97995,"_5":17384,"_23720":97903,"_2383":97996},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2856":58384,"_25059":58350,"_17489":97998,"_5":17384,"_23720":97903,"_2383":97999},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2856":58385,"_25059":58350,"_17489":98001,"_5":17384,"_23720":97903,"_2383":98002},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2856":58386,"_25059":58350,"_17489":98004,"_5":17384,"_23720":97907,"_2383":98005},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2856":58387,"_25059":58350,"_17489":98007,"_5":17384,"_23720":97911,"_2383":98008},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2856":58388,"_25059":58350,"_17489":98010,"_5":17384,"_23720":97915,"_2383":98011},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2856":58389,"_25059":58350,"_17489":98013,"_5":17384,"_23720":97919,"_2383":98014},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2856":58390,"_25059":58350,"_17489":98016,"_5":17384,"_23720":97923,"_2383":98017},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2856":58391,"_25059":58350,"_17489":98019,"_5":17384,"_23720":97923,"_2383":98020},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2856":58392,"_25059":58350,"_17489":98022,"_5":17384,"_23720":97927,"_2383":98023},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2856":58393,"_25059":58350,"_17489":98025,"_5":17384,"_23720":97927,"_2383":98026},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2856":58394,"_25059":58350,"_17489":98028,"_5":17384,"_23720":97927,"_2383":98029},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2856":58395,"_25059":58350,"_17489":98031,"_5":17384,"_23720":97927,"_2383":98032},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2856":58396,"_25059":58350,"_17489":98034,"_5":17384,"_23720":97927,"_2383":98035},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2856":58397,"_25059":58350,"_17489":98037,"_5":17384,"_23720":97927,"_2383":98038},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2856":58398,"_25059":58350,"_17489":98040,"_5":17384,"_23720":97931,"_2383":98041},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2856":58399,"_25059":58350,"_17489":98043,"_5":17384,"_23720":97931,"_2383":98044},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2856":58400,"_25059":58350,"_17489":98046,"_5":17384,"_23720":97935,"_2383":98047},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2856":58401,"_25059":58350,"_17489":98049,"_5":17384,"_23720":97935,"_2383":98050},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2856":58402,"_25059":58350,"_17489":98052,"_5":17384,"_23720":97935,"_2383":98053},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2856":58403,"_25059":58350,"_17489":98055,"_5":17384,"_23720":97935,"_2383":98056},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2856":58404,"_25059":58350,"_17489":98058,"_5":17384,"_23720":97939,"_2383":98059},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":58405,"_25059":58350,"_17489":98061,"_5":17384,"_23720":97939,"_2383":98062},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":58406,"_25059":58406,"_5":12268,"_2383":98064,"_25374":98065,"_17489":98067,"_23720":58406},"Identidad inicial y autenticación",[40699,96919,43017,97891,98066],"Enrolamiento con PKI",[],{"_2856":58407,"_25059":58406,"_17489":98069,"_5":17384,"_23720":58406,"_2383":98070},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2856":58408,"_25059":58406,"_5":25371,"_17489":98072,"_23720":98073,"_2383":98074},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2856":58409,"_25059":58406,"_5":25371,"_17489":98076,"_23720":98077,"_2383":98078},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2856":58410,"_25059":58406,"_5":25371,"_17489":98080,"_23720":98081,"_2383":98082},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2856":58411,"_25059":58406,"_5":25371,"_17489":98084,"_23720":98085,"_2383":98086},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2856":58412,"_25059":58406,"_5":25371,"_17489":98088,"_23720":98089,"_2383":98090},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2856":58413,"_25059":58406,"_17489":98092,"_5":17384,"_23720":58406,"_2383":98093},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2856":58414,"_25059":58406,"_17489":98095,"_5":17384,"_23720":98073,"_2383":98096},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2856":58415,"_25059":58406,"_17489":98098,"_5":17384,"_23720":98073,"_2383":98099},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2856":58416,"_25059":58406,"_17489":98101,"_5":17384,"_23720":98077,"_2383":98102},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2856":58417,"_25059":58406,"_17489":98104,"_5":17384,"_23720":98077,"_2383":98105},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2856":58418,"_25059":58406,"_17489":98107,"_5":17384,"_23720":98077,"_2383":98108},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2856":58419,"_25059":58406,"_17489":98110,"_5":17384,"_23720":98081,"_2383":98111},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2856":58420,"_25059":58406,"_17489":98113,"_5":17384,"_23720":98081,"_2383":98114},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2856":58421,"_25059":58406,"_17489":98116,"_5":17384,"_23720":98085,"_2383":98117},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2856":58422,"_25059":58406,"_17489":98119,"_5":17384,"_23720":98085,"_2383":98120},[],"Ejemplo de cuerpo:",{"_2856":58423,"_25059":58406,"_17489":98122,"_5":17384,"_23720":98085,"_2383":98123},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2856":58424,"_25059":58406,"_17489":98125,"_5":17384,"_23720":98085,"_2383":98126},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2856":58425,"_25059":58406,"_17489":98128,"_5":17384,"_23720":98085,"_2383":98129},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2856":58426,"_25059":58406,"_17489":98131,"_5":17384,"_23720":98085,"_2383":98132},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2856":58427,"_25059":58406,"_17489":98134,"_5":17384,"_23720":98089,"_2383":98135},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2856":58428,"_25059":58406,"_17489":98137,"_5":17384,"_23720":98089,"_2383":98138},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2856":58429,"_25059":58429,"_5":12268,"_2383":98140,"_25374":98141,"_17489":98142,"_23720":58429},"Configura y opera el DMS",[40699,96919,43017,97891,98066],[],{"_2856":58430,"_25059":58429,"_17489":98144,"_5":17384,"_23720":58429,"_2383":98145},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2856":58431,"_25059":58429,"_5":25371,"_17489":98147,"_23720":98148,"_2383":95620},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2856":58432,"_25059":58429,"_5":25371,"_17489":98150,"_23720":98151,"_2383":98152},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2856":58433,"_25059":58429,"_5":25371,"_17489":98154,"_23720":98155,"_2383":98156},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2856":58434,"_25059":58429,"_5":25371,"_17489":98158,"_23720":98159,"_2383":98160},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2856":58435,"_25059":58429,"_5":25371,"_17489":98162,"_23720":98163,"_2383":98164},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2856":58436,"_25059":58429,"_5":25371,"_17489":98166,"_23720":98167,"_2383":98168},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2856":58437,"_25059":58429,"_5":25371,"_17489":98170,"_23720":98171,"_2383":98172},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2856":58438,"_25059":58429,"_5":25371,"_17489":98174,"_23720":98175,"_2383":98176},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2856":58439,"_25059":58429,"_5":25371,"_17489":98178,"_23720":98179,"_2383":43312},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2856":58440,"_25059":58429,"_5":25371,"_17489":98181,"_23720":98182,"_2383":43316},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2856":58441,"_25059":58429,"_5":25371,"_17489":98184,"_23720":98185,"_2383":98186},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2856":58442,"_25059":58429,"_5":25371,"_17489":98188,"_23720":98189,"_2383":98190},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2856":58443,"_25059":58429,"_5":25371,"_17489":98192,"_23720":98193,"_2383":98194},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2856":58444,"_25059":58429,"_5":25371,"_17489":98196,"_23720":98197,"_2383":98198},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2856":58445,"_25059":58429,"_5":25371,"_17489":98200,"_23720":98201,"_2383":43336},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2856":58446,"_25059":58429,"_5":25371,"_17489":98203,"_23720":98204,"_2383":98205},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2856":58447,"_25059":58429,"_5":25371,"_17489":98207,"_23720":98208,"_2383":98209},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2856":58448,"_25059":58429,"_5":25371,"_17489":98211,"_23720":98212,"_2383":98213},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2856":58449,"_25059":58429,"_17489":98215,"_5":17384,"_23720":58429,"_2383":98216},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2856":58450,"_25059":58429,"_17489":98218,"_5":17384,"_23720":98148,"_2383":98219},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2856":58451,"_25059":58429,"_17489":98221,"_5":17384,"_23720":98148,"_2383":98222},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2856":58452,"_25059":58429,"_17489":98224,"_5":17384,"_23720":98155,"_2383":98225},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2856":58453,"_25059":58429,"_17489":98227,"_5":17384,"_23720":98159,"_2383":98228},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2856":58454,"_25059":58429,"_17489":98230,"_5":17384,"_23720":98163,"_2383":98231},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2856":58455,"_25059":58429,"_17489":98233,"_5":17384,"_23720":98167,"_2383":98234},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2856":58456,"_25059":58429,"_17489":98236,"_5":17384,"_23720":98171,"_2383":98237},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2856":58457,"_25059":58429,"_17489":98239,"_5":17384,"_23720":98179,"_2383":98240},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2856":58458,"_25059":58429,"_17489":98242,"_5":17384,"_23720":98179,"_2383":98243},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2856":58459,"_25059":58429,"_17489":98245,"_5":17384,"_23720":98182,"_2383":98246},[],"Campo de `settings.enrollment_settings`",{"_2856":58460,"_25059":58429,"_17489":98248,"_5":17384,"_23720":98182,"_2383":98249},[],"Decisión",{"_2856":58461,"_25059":58429,"_17489":98251,"_5":17384,"_23720":98182,"_2383":43387},[],{"_2856":58462,"_25059":58429,"_17489":98253,"_5":17384,"_23720":98182,"_2383":98254},[],"`EST_RFC7030` para estas operaciones.",{"_2856":58463,"_25059":58429,"_17489":98256,"_5":17384,"_23720":98182,"_2383":43393},[],{"_2856":58464,"_25059":58429,"_17489":98258,"_5":17384,"_23720":98182,"_2383":98259},[],"ID de la CA que firmará.",{"_2856":58465,"_25059":58429,"_17489":98261,"_5":17384,"_23720":98182,"_2383":43399},[],{"_2856":58466,"_25059":58429,"_17489":98263,"_5":17384,"_23720":98182,"_2383":98264},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2856":58467,"_25059":58429,"_17489":98266,"_5":17384,"_23720":98182,"_2383":43405},[],{"_2856":58468,"_25059":58429,"_17489":98268,"_5":17384,"_23720":98182,"_2383":98269},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2856":58469,"_25059":58429,"_17489":98271,"_5":17384,"_23720":98182,"_2383":43411},[],{"_2856":58470,"_25059":58429,"_17489":98273,"_5":17384,"_23720":98182,"_2383":98274},[],"Uno de los cuatro modos de autenticación.",{"_2856":58471,"_25059":58429,"_17489":98276,"_5":17384,"_23720":98182,"_2383":98277},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2856":58472,"_25059":58429,"_17489":98279,"_5":17384,"_23720":98185,"_2383":98280},[],"Los bloques son independientes:",{"_2856":58473,"_25059":58429,"_17489":98282,"_5":17384,"_23720":98185,"_2383":98283},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2856":58474,"_25059":58429,"_17489":98285,"_5":17384,"_23720":98185,"_2383":98286},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2856":58475,"_25059":58429,"_17489":98288,"_5":17384,"_23720":98185,"_2383":43429},[],{"_2856":58476,"_25059":58429,"_17489":98290,"_5":17384,"_23720":98185,"_2383":98291},[],"Control aplicado en la operación configurada",{"_2856":58477,"_25059":58429,"_17489":98293,"_5":17384,"_23720":98185,"_2383":43435},[],{"_2856":58478,"_25059":58429,"_17489":98295,"_5":17384,"_23720":98185,"_2383":98296},[],"Validación del certificado presentado.",{"_2856":58479,"_25059":58429,"_17489":98298,"_5":17384,"_23720":98185,"_2383":43441},[],{"_2856":58480,"_25059":58429,"_17489":98300,"_5":17384,"_23720":98185,"_2383":98301},[],"Autorización del webhook configurado.",{"_2856":58481,"_25059":58429,"_17489":98303,"_5":17384,"_23720":98185,"_2383":43447},[],{"_2856":58482,"_25059":58429,"_17489":98305,"_5":17384,"_23720":98185,"_2383":98306},[],"Validación del certificado y, después, aprobación del webhook.",{"_2856":58483,"_25059":58429,"_17489":98308,"_5":17384,"_23720":98185,"_2383":43453},[],{"_2856":58484,"_25059":58429,"_17489":98310,"_5":17384,"_23720":98185,"_2383":98311},[],"Sin autenticación del solicitante por el DMS.",{"_2856":58485,"_25059":58429,"_17489":98313,"_5":17384,"_23720":98185,"_2383":98314},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2856":58486,"_25059":58429,"_17489":98316,"_5":17384,"_23720":98185,"_2383":98317},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2856":58487,"_25059":58429,"_17489":98319,"_5":17384,"_23720":98185,"_2383":98320},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2856":58488,"_25059":58429,"_17489":98322,"_5":17384,"_23720":98185,"_2383":98323},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2856":58489,"_25059":58429,"_17489":98325,"_5":17384,"_23720":98189,"_2383":98326},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2856":58490,"_25059":58429,"_17489":98328,"_5":17384,"_23720":98189,"_2383":98329},[],"Campo de `external_webhook_settings`",{"_2856":58491,"_25059":58429,"_17489":98331,"_5":17384,"_23720":98189,"_2383":98249},[],{"_2856":58492,"_25059":58429,"_17489":98333,"_5":17384,"_23720":98189,"_2383":43479},[],{"_2856":58493,"_25059":58429,"_17489":98335,"_5":17384,"_23720":98189,"_2383":98336},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2856":58494,"_25059":58429,"_17489":98338,"_5":17384,"_23720":98189,"_2383":43485},[],{"_2856":58495,"_25059":58429,"_17489":98340,"_5":17384,"_23720":98189,"_2383":98341},[],"`POST` o `PUT`; `POST` por defecto.",{"_2856":58496,"_25059":58429,"_17489":98343,"_5":17384,"_23720":98189,"_2383":43491},[],{"_2856":58497,"_25059":58429,"_17489":98345,"_5":17384,"_23720":98189,"_2383":98346},[],"Etiqueta usada en los logs del servicio.",{"_2856":58498,"_25059":58429,"_17489":98348,"_5":17384,"_23720":98189,"_2383":43497},[],{"_2856":58499,"_25059":58429,"_17489":98350,"_5":17384,"_23720":98189,"_2383":98351},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2856":58500,"_25059":58429,"_17489":98353,"_5":17384,"_23720":98189,"_2383":43503},[],{"_2856":58501,"_25059":58429,"_17489":98355,"_5":17384,"_23720":98189,"_2383":98356},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2856":58502,"_25059":58429,"_17489":98358,"_5":17384,"_23720":98189,"_2383":43509},[],{"_2856":58503,"_25059":58429,"_17489":98360,"_5":17384,"_23720":98189,"_2383":98361},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2856":58504,"_25059":58429,"_17489":98363,"_5":17384,"_23720":98189,"_2383":43515},[],{"_2856":58505,"_25059":58429,"_17489":98365,"_5":17384,"_23720":98189,"_2383":98366},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2856":58506,"_25059":58429,"_17489":98368,"_5":17384,"_23720":98189,"_2383":43521},[],{"_2856":58507,"_25059":58429,"_17489":98370,"_5":17384,"_23720":98189,"_2383":98371},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2856":58508,"_25059":58429,"_17489":98373,"_5":17384,"_23720":98189,"_2383":43527},[],{"_2856":58509,"_25059":58429,"_17489":98375,"_5":17384,"_23720":98189,"_2383":98376},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2856":58510,"_25059":58429,"_17489":98378,"_5":17384,"_23720":98189,"_2383":98379},[],"Reglas de esa configuración:",{"_2856":58511,"_25059":58429,"_17489":98381,"_5":17384,"_23720":98189,"_2383":98382},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2856":58512,"_25059":58429,"_17489":98384,"_5":17384,"_23720":98189,"_2383":98385},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2856":58513,"_25059":58429,"_17489":98387,"_5":17384,"_23720":98189,"_2383":98388},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2856":58514,"_25059":58429,"_17489":98390,"_5":17384,"_23720":98189,"_2383":98391},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2856":58515,"_25059":58429,"_17489":98393,"_5":17384,"_23720":98189,"_2383":98394},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2856":58516,"_25059":58429,"_17489":98396,"_5":17384,"_23720":98189,"_2383":98397},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2856":58517,"_25059":58429,"_17489":98399,"_5":17384,"_23720":98189,"_2383":98400},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2856":58518,"_25059":58429,"_17489":98402,"_5":17384,"_23720":98189,"_2383":98403},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2856":58519,"_25059":58429,"_17489":98405,"_5":17384,"_23720":98193,"_2383":98406},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2856":58520,"_25059":58429,"_17489":98408,"_5":17384,"_23720":98197,"_2383":98409},[],"Campo de `settings.reenrollment_settings`",{"_2856":58521,"_25059":58429,"_17489":98411,"_5":17384,"_23720":98197,"_2383":98412},[],"Función",{"_2856":58522,"_25059":58429,"_17489":98414,"_5":17384,"_23720":98197,"_2383":43568},[],{"_2856":58523,"_25059":58429,"_17489":98416,"_5":17384,"_23720":98197,"_2383":98417},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2856":58524,"_25059":58429,"_17489":98419,"_5":17384,"_23720":98197,"_2383":43574},[],{"_2856":58525,"_25059":58429,"_17489":98421,"_5":17384,"_23720":98197,"_2383":98422},[],"Umbral operativo preventivo de monitorización.",{"_2856":58526,"_25059":58429,"_17489":98424,"_5":17384,"_23720":98197,"_2383":43580},[],{"_2856":58527,"_25059":58429,"_17489":98426,"_5":17384,"_23720":98197,"_2383":98427},[],"Umbral operativo crítico de monitorización.",{"_2856":58528,"_25059":58429,"_17489":98429,"_5":17384,"_23720":98197,"_2383":43586},[],{"_2856":58529,"_25059":58429,"_17489":98431,"_5":17384,"_23720":98197,"_2383":98432},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2856":58530,"_25059":58429,"_17489":98434,"_5":17384,"_23720":98197,"_2383":43592},[],{"_2856":58531,"_25059":58429,"_17489":98436,"_5":17384,"_23720":98197,"_2383":98437},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2856":58532,"_25059":58429,"_17489":98439,"_5":17384,"_23720":98197,"_2383":43598},[],{"_2856":58533,"_25059":58429,"_17489":98441,"_5":17384,"_23720":98197,"_2383":98442},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2856":58534,"_25059":58429,"_17489":98444,"_5":17384,"_23720":98197,"_2383":98445},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2856":58535,"_25059":58429,"_17489":98447,"_5":17384,"_23720":98201,"_2383":98448},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2856":58536,"_25059":58429,"_17489":98450,"_5":17384,"_23720":98204,"_2383":95977},[],{"_2856":58537,"_25059":58429,"_17489":98452,"_5":17384,"_23720":98204,"_2383":98453},[],"Qué publica",{"_2856":58538,"_25059":58429,"_17489":98455,"_5":17384,"_23720":98204,"_2383":43615},[],{"_2856":58539,"_25059":58429,"_17489":98457,"_5":17384,"_23720":98204,"_2383":98458},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2856":58540,"_25059":58429,"_17489":98460,"_5":17384,"_23720":98204,"_2383":43621},[],{"_2856":58541,"_25059":58429,"_17489":98462,"_5":17384,"_23720":98204,"_2383":98463},[],"Certificado de la CA emisora seleccionada.",{"_2856":58542,"_25059":58429,"_17489":98465,"_5":17384,"_23720":98204,"_2383":43627},[],{"_2856":58543,"_25059":58429,"_17489":98467,"_5":17384,"_23720":98204,"_2383":98468},[],"Certificados de las CAs elegidas explícitamente.",{"_2856":58544,"_25059":58429,"_17489":98470,"_5":17384,"_23720":98204,"_2383":98471},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2856":58545,"_25059":58429,"_17489":98473,"_5":17384,"_23720":98208,"_2383":98474},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2856":58546,"_25059":58429,"_17489":98476,"_5":17384,"_23720":98208,"_2383":98477},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2856":58547,"_25059":58429,"_17489":98479,"_5":17384,"_23720":98208,"_2383":98480},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2856":58548,"_25059":58429,"_17489":98482,"_5":17384,"_23720":98212,"_2383":98483},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2856":58549,"_25059":58549,"_5":12268,"_2383":98485,"_25374":98486,"_17489":98487,"_23720":58549},"Integra el cliente EST",[40699,96919,43017,97891,98066],[],{"_2856":58550,"_25059":58549,"_17489":98489,"_5":17384,"_23720":58549,"_2383":98490},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2856":58551,"_25059":58549,"_5":25371,"_17489":98492,"_23720":98493,"_2383":95620},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2856":58552,"_25059":58549,"_5":25371,"_17489":98495,"_23720":98496,"_2383":98497},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2856":58553,"_25059":58549,"_5":25371,"_17489":98499,"_23720":98500,"_2383":98501},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2856":58554,"_25059":58549,"_5":25371,"_17489":98503,"_23720":98504,"_2383":98505},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2856":58555,"_25059":58549,"_5":25371,"_17489":98507,"_23720":98508,"_2383":98509},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2856":58556,"_25059":58549,"_5":25371,"_17489":98511,"_23720":98512,"_2383":98513},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2856":58557,"_25059":58549,"_17489":98515,"_5":17384,"_23720":58549,"_2383":98516},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2856":58558,"_25059":58549,"_17489":98518,"_5":17384,"_23720":98493,"_2383":98519},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2856":58559,"_25059":58549,"_17489":98521,"_5":17384,"_23720":98493,"_2383":98522},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2856":58560,"_25059":58549,"_17489":98524,"_5":17384,"_23720":98493,"_2383":98525},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2856":58561,"_25059":58549,"_17489":98527,"_5":17384,"_23720":98496,"_2383":98528},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2856":58562,"_25059":58549,"_17489":98530,"_5":17384,"_23720":98496,"_2383":98531},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2856":58563,"_25059":58549,"_17489":98533,"_5":17384,"_23720":98500,"_2383":98534},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2856":58564,"_25059":58549,"_17489":98536,"_5":17384,"_23720":98500,"_2383":98537},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2856":58565,"_25059":58549,"_17489":98539,"_5":17384,"_23720":98504,"_2383":98540},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2856":58566,"_25059":58549,"_17489":98542,"_5":17384,"_23720":98504,"_2383":98543},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2856":58567,"_25059":58549,"_17489":98545,"_5":17384,"_23720":98508,"_2383":98546},[],"Para el caso de una raíz que emite directamente:",{"_2856":58568,"_25059":58549,"_17489":98548,"_5":17384,"_23720":98508,"_2383":98549},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2856":58569,"_25059":58549,"_17489":98551,"_5":17384,"_23720":98508,"_2383":98552},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2856":58570,"_25059":58549,"_17489":98554,"_5":17384,"_23720":98512,"_2383":98555},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2856":58571,"_25059":58571,"_5":12268,"_2383":98557,"_25374":98558,"_17489":98559,"_23720":58571},"Referencia EST",[40699,96919,43017,97891,98066],[],{"_2856":58572,"_25059":58571,"_17489":98561,"_5":17384,"_23720":58571,"_2383":98562},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2856":58573,"_25059":58571,"_5":25371,"_17489":98564,"_23720":98565,"_2383":98566},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2856":58574,"_25059":58571,"_5":25371,"_17489":98568,"_23720":98569,"_2383":18993},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2856":58575,"_25059":58571,"_5":25371,"_17489":98571,"_23720":98572,"_2383":21753},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2856":58576,"_25059":58571,"_5":25371,"_17489":98574,"_23720":98575,"_2383":21760},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2856":58577,"_25059":58571,"_5":25371,"_17489":98577,"_23720":98578,"_2383":21130},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2856":58578,"_25059":58571,"_5":25371,"_17489":98580,"_23720":98581,"_2383":98582},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2856":58579,"_25059":58571,"_5":25371,"_17489":98584,"_23720":98585,"_2383":98586},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2856":58580,"_25059":58571,"_5":25371,"_17489":98588,"_23720":98589,"_2383":98590},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2856":58581,"_25059":58571,"_17489":98592,"_5":17384,"_23720":58571,"_2383":98593},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2856":58582,"_25059":58571,"_17489":98595,"_5":17384,"_23720":98565,"_2383":98596},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2856":58583,"_25059":58571,"_17489":98598,"_5":17384,"_23720":98565,"_2383":96710},[],{"_2856":58584,"_25059":58571,"_17489":98600,"_5":17384,"_23720":98565,"_2383":98601},[],"Método",{"_2856":58585,"_25059":58571,"_17489":98603,"_5":17384,"_23720":98565,"_2383":98604},[],"Autenticación y condición",{"_2856":58586,"_25059":58571,"_17489":98606,"_5":17384,"_23720":98565,"_2383":43770},[],{"_2856":58587,"_25059":58571,"_17489":98608,"_5":17384,"_23720":98565,"_2383":43773},[],{"_2856":58588,"_25059":58571,"_17489":98610,"_5":17384,"_23720":98565,"_2383":98611},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2856":58589,"_25059":58571,"_17489":98613,"_5":17384,"_23720":98565,"_2383":43779},[],{"_2856":58590,"_25059":58571,"_17489":98615,"_5":17384,"_23720":98565,"_2383":43782},[],{"_2856":58591,"_25059":58571,"_17489":98617,"_5":17384,"_23720":98565,"_2383":98618},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2856":58592,"_25059":58571,"_17489":98620,"_5":17384,"_23720":98565,"_2383":43788},[],{"_2856":58593,"_25059":58571,"_17489":98622,"_5":17384,"_23720":98565,"_2383":43782},[],{"_2856":58594,"_25059":58571,"_17489":98624,"_5":17384,"_23720":98565,"_2383":98625},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2856":58595,"_25059":58571,"_17489":98627,"_5":17384,"_23720":98565,"_2383":43796},[],{"_2856":58596,"_25059":58571,"_17489":98629,"_5":17384,"_23720":98565,"_2383":43782},[],{"_2856":58597,"_25059":58571,"_17489":98631,"_5":17384,"_23720":98565,"_2383":98632},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2856":58598,"_25059":58571,"_17489":98634,"_5":17384,"_23720":98565,"_2383":98635},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2856":58599,"_25059":58571,"_17489":98637,"_5":17384,"_23720":98569,"_2383":98638},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2856":58600,"_25059":58571,"_17489":98640,"_5":17384,"_23720":98569,"_2383":98641},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2856":58601,"_25059":58571,"_17489":98643,"_5":17384,"_23720":98572,"_2383":98644},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2856":58602,"_25059":58571,"_17489":98646,"_5":17384,"_23720":98572,"_2383":98647},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2856":58603,"_25059":58571,"_17489":98649,"_5":17384,"_23720":98575,"_2383":98650},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2856":58604,"_25059":58571,"_17489":98652,"_5":17384,"_23720":98575,"_2383":98653},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2856":58605,"_25059":58571,"_17489":98655,"_5":17384,"_23720":98578,"_2383":98656},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2856":58606,"_25059":58571,"_17489":98658,"_5":17384,"_23720":98578,"_2383":98659},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2856":58607,"_25059":58571,"_17489":98661,"_5":17384,"_23720":98581,"_2383":98662},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2856":58608,"_25059":58571,"_17489":98664,"_5":17384,"_23720":98581,"_2383":98665},[],"Parte",{"_2856":58609,"_25059":58571,"_17489":98667,"_5":17384,"_23720":98581,"_2383":98668},[],"Contenido tras decodificar su Base64",{"_2856":58610,"_25059":58571,"_17489":98670,"_5":17384,"_23720":98581,"_2383":43840},[],{"_2856":58611,"_25059":58571,"_17489":98672,"_5":17384,"_23720":98581,"_2383":98673},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2856":58612,"_25059":58571,"_17489":98675,"_5":17384,"_23720":98581,"_2383":43846},[],{"_2856":58613,"_25059":58571,"_17489":98677,"_5":17384,"_23720":98581,"_2383":98678},[],"PKCS#7 DER con el certificado emitido.",{"_2856":58614,"_25059":58571,"_17489":98680,"_5":17384,"_23720":98581,"_2383":98681},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2856":58615,"_25059":58571,"_17489":98683,"_5":17384,"_23720":98585,"_2383":98684},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2856":58616,"_25059":58571,"_17489":98686,"_5":17384,"_23720":98585,"_2383":98687},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2856":58617,"_25059":58571,"_17489":98689,"_5":17384,"_23720":98585,"_2383":98690},[],"Convierte y comprueba el resultado:",{"_2856":58618,"_25059":58571,"_17489":98692,"_5":17384,"_23720":98585,"_2383":98693},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2856":58619,"_25059":58571,"_17489":98695,"_5":17384,"_23720":98589,"_2383":98696},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2856":58620,"_25059":58571,"_17489":98698,"_5":17384,"_23720":98589,"_2383":98699},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2856":58621,"_25059":58621,"_5":12268,"_2383":98066,"_25374":98701,"_17489":98702,"_23720":58621},[40699,96919,43017,97891,98066],[],{"_2856":58622,"_25059":58621,"_17489":98704,"_5":17384,"_23720":58621,"_2383":98705},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2856":58623,"_25059":58621,"_5":25371,"_17489":98707,"_23720":98708,"_2383":98709},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2856":58624,"_25059":58621,"_5":25371,"_17489":98711,"_23720":98712,"_2383":98713},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2856":58625,"_25059":58621,"_5":25371,"_17489":98715,"_23720":98716,"_2383":98717},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2856":58626,"_25059":58621,"_5":25371,"_17489":98719,"_23720":98720,"_2383":98721},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2856":58627,"_25059":58621,"_17489":98723,"_5":17384,"_23720":58621,"_2383":98724},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2856":58628,"_25059":58621,"_17489":98726,"_5":17384,"_23720":98708,"_2383":98727},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2856":58629,"_25059":58621,"_17489":98729,"_5":17384,"_23720":98708,"_2383":98730},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2856":58630,"_25059":58621,"_17489":98732,"_5":17384,"_23720":98708,"_2383":98733},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2856":58631,"_25059":58621,"_17489":98735,"_5":17384,"_23720":98708,"_2383":98736},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2856":58632,"_25059":58621,"_17489":98738,"_5":17384,"_23720":98708,"_2383":98739},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2856":58633,"_25059":58621,"_17489":98741,"_5":17384,"_23720":98708,"_2383":98742},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2856":58634,"_25059":58621,"_17489":98744,"_5":17384,"_23720":98712,"_2383":98745},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2856":58635,"_25059":58621,"_17489":98747,"_5":17384,"_23720":98712,"_2383":98748},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":58636,"_25059":58621,"_17489":98750,"_5":17384,"_23720":98712,"_2383":98751},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2856":58637,"_25059":58621,"_17489":98753,"_5":17384,"_23720":98712,"_2383":98754},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2856":58638,"_25059":58621,"_17489":98756,"_5":17384,"_23720":98716,"_2383":98757},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":58639,"_25059":58621,"_17489":98759,"_5":17384,"_23720":98716,"_2383":98760},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":58640,"_25059":58621,"_17489":98762,"_5":17384,"_23720":98716,"_2383":98763},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2856":58641,"_25059":58621,"_17489":98765,"_5":17384,"_23720":98716,"_2383":98766},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2856":58642,"_25059":58621,"_17489":98768,"_5":17384,"_23720":98720,"_2383":98769},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2856":58643,"_25059":58621,"_17489":98771,"_5":17384,"_23720":98720,"_2383":98772},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2856":58644,"_25059":58644,"_5":12268,"_2383":98774,"_25374":98775,"_17489":98776,"_23720":58644},"Estrategias de aprovisionamiento",[40699,96919,43017,97891,98066],[],{"_2856":58645,"_25059":58644,"_17489":98778,"_5":17384,"_23720":58644,"_2383":98779},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2856":58646,"_25059":58644,"_5":25371,"_17489":98781,"_23720":98782,"_2383":98783},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2856":58647,"_25059":58644,"_5":25371,"_17489":98785,"_23720":98786,"_2383":98787},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2856":58648,"_25059":58644,"_5":25371,"_17489":98789,"_23720":98790,"_2383":98791},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2856":58649,"_25059":58644,"_5":25371,"_17489":98793,"_23720":98794,"_2383":98795},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2856":58650,"_25059":58644,"_5":25371,"_17489":98797,"_23720":98798,"_2383":98799},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2856":58651,"_25059":58644,"_17489":98801,"_5":17384,"_23720":58644,"_2383":98802},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2856":58652,"_25059":58644,"_17489":98804,"_5":17384,"_23720":98782,"_2383":98805},[],"Recorrido",{"_2856":58653,"_25059":58644,"_17489":98807,"_5":17384,"_23720":98782,"_2383":98808},[],"Cuándo existe el dispositivo",{"_2856":58654,"_25059":58644,"_17489":98810,"_5":17384,"_23720":98782,"_2383":98811},[],"Qué compruebas",{"_2856":58655,"_25059":58644,"_17489":98813,"_5":17384,"_23720":98782,"_2383":98814},[],"Asignación manual",{"_2856":58656,"_25059":58644,"_17489":98816,"_5":17384,"_23720":98782,"_2383":98817},[],"El operador lo crea antes de asociar un certificado.",{"_2856":58657,"_25059":58644,"_17489":98819,"_5":17384,"_23720":98782,"_2383":98820},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2856":58658,"_25059":58644,"_17489":98822,"_5":17384,"_23720":98782,"_2383":98823},[],"EST con `JITP`",{"_2856":58659,"_25059":58644,"_17489":98825,"_5":17384,"_23720":98782,"_2383":98826},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2856":58660,"_25059":58644,"_17489":98828,"_5":17384,"_23720":98782,"_2383":98829},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2856":58661,"_25059":58644,"_17489":98831,"_5":17384,"_23720":98782,"_2383":98832},[],"EST con `PRE_REGISTRATION`",{"_2856":58662,"_25059":58644,"_17489":98834,"_5":17384,"_23720":98782,"_2383":98835},[],"Debe existir antes de `/simpleenroll`.",{"_2856":58663,"_25059":58644,"_17489":98837,"_5":17384,"_23720":98782,"_2383":98838},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2856":58664,"_25059":58644,"_17489":98840,"_5":17384,"_23720":98782,"_2383":98841},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2856":58665,"_25059":58644,"_17489":98843,"_5":17384,"_23720":98782,"_2383":98844},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2856":58666,"_25059":58644,"_17489":98846,"_5":17384,"_23720":98786,"_2383":98847},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2856":58667,"_25059":58644,"_17489":98849,"_5":17384,"_23720":98786,"_2383":98850},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2856":58668,"_25059":58644,"_17489":98852,"_5":17384,"_23720":98786,"_2383":98853},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2856":58669,"_25059":58644,"_17489":98855,"_5":17384,"_23720":98790,"_2383":98856},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2856":58670,"_25059":58644,"_17489":98858,"_5":17384,"_23720":98790,"_2383":98859},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2856":58671,"_25059":58644,"_17489":98861,"_5":17384,"_23720":98790,"_2383":98862},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2856":58672,"_25059":58644,"_17489":98864,"_5":17384,"_23720":98790,"_2383":98865},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2856":58673,"_25059":58644,"_17489":98867,"_5":17384,"_23720":98790,"_2383":98868},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2856":58674,"_25059":58644,"_17489":98870,"_5":17384,"_23720":98790,"_2383":98871},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2856":58675,"_25059":58644,"_17489":98873,"_5":17384,"_23720":98794,"_2383":95977},[],{"_2856":58676,"_25059":58644,"_17489":98875,"_5":17384,"_23720":98794,"_2383":98876},[],"Material que atraviesa EST",{"_2856":58677,"_25059":58644,"_17489":98878,"_5":17384,"_23720":98794,"_2383":98879},[],"Clave generada por el dispositivo",{"_2856":58678,"_25059":58644,"_17489":98881,"_5":17384,"_23720":98794,"_2383":98882},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2856":58679,"_25059":58644,"_17489":98884,"_5":17384,"_23720":98794,"_2383":98885},[],"Clave ya disponible en el dispositivo",{"_2856":58680,"_25059":58644,"_17489":98887,"_5":17384,"_23720":98794,"_2383":98888},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2856":58681,"_25059":58644,"_17489":98890,"_5":17384,"_23720":98794,"_2383":43336},[],{"_2856":58682,"_25059":58644,"_17489":98892,"_5":17384,"_23720":98794,"_2383":98893},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2856":58683,"_25059":58644,"_17489":98895,"_5":17384,"_23720":98794,"_2383":98896},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2856":58684,"_25059":58644,"_17489":98898,"_5":17384,"_23720":98798,"_2383":98899},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2856":58685,"_25059":58685,"_5":12268,"_2383":98901,"_25374":98902,"_17489":98903,"_23720":58685},"Renovación y recuperación",[40699,96919,43017,97891,98066],[],{"_2856":58686,"_25059":58685,"_17489":98905,"_5":17384,"_23720":58685,"_2383":98906},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2856":58687,"_25059":58685,"_5":25371,"_17489":98908,"_23720":98909,"_2383":98910},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2856":58688,"_25059":58685,"_5":25371,"_17489":98912,"_23720":98913,"_2383":98914},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2856":58689,"_25059":58685,"_5":25371,"_17489":98916,"_23720":98917,"_2383":98918},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2856":58690,"_25059":58685,"_5":25371,"_17489":98920,"_23720":98921,"_2383":98922},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2856":58691,"_25059":58685,"_5":25371,"_17489":98924,"_23720":98925,"_2383":98926},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2856":58692,"_25059":58685,"_17489":98928,"_5":17384,"_23720":58685,"_2383":98929},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2856":58693,"_25059":58685,"_17489":98931,"_5":17384,"_23720":98909,"_2383":98932},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2856":58694,"_25059":58685,"_17489":98934,"_5":17384,"_23720":98909,"_2383":98935},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2856":58695,"_25059":58685,"_17489":98937,"_5":17384,"_23720":98909,"_2383":98938},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2856":58696,"_25059":58685,"_17489":98940,"_5":17384,"_23720":98909,"_2383":98941},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2856":58697,"_25059":58685,"_17489":98943,"_5":17384,"_23720":98913,"_2383":98944},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2856":58698,"_25059":58685,"_17489":98946,"_5":17384,"_23720":98913,"_2383":98947},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2856":58699,"_25059":58685,"_17489":98949,"_5":17384,"_23720":98917,"_2383":98950},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2856":58700,"_25059":58685,"_17489":98952,"_5":17384,"_23720":98917,"_2383":98953},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2856":58701,"_25059":58685,"_17489":98955,"_5":17384,"_23720":98917,"_2383":98956},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2856":58702,"_25059":58685,"_17489":98958,"_5":17384,"_23720":98921,"_2383":98959},[],"Situación",{"_2856":58703,"_25059":58685,"_17489":98961,"_5":17384,"_23720":98921,"_2383":98962},[],"Procedimiento",{"_2856":58704,"_25059":58685,"_17489":98964,"_5":17384,"_23720":98921,"_2383":98965},[],"Certificado vigente, fuera de ventana",{"_2856":58705,"_25059":58685,"_17489":98967,"_5":17384,"_23720":98921,"_2383":98968},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2856":58706,"_25059":58685,"_17489":98970,"_5":17384,"_23720":98921,"_2383":98971},[],"Certificado vencido, clave disponible",{"_2856":58707,"_25059":58685,"_17489":98973,"_5":17384,"_23720":98921,"_2383":98974},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2856":58708,"_25059":58685,"_17489":98976,"_5":17384,"_23720":98921,"_2383":98977},[],"Renovación por webhook o `NO_AUTH`",{"_2856":58709,"_25059":58685,"_17489":98979,"_5":17384,"_23720":98921,"_2383":98980},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2856":58710,"_25059":58685,"_17489":98982,"_5":17384,"_23720":98921,"_2383":98983},[],"Clave perdida o inaccesible",{"_2856":58711,"_25059":58685,"_17489":98985,"_5":17384,"_23720":98921,"_2383":98986},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2856":58712,"_25059":58685,"_17489":98988,"_5":17384,"_23720":98921,"_2383":98989},[],"Identidad actual revocada",{"_2856":58713,"_25059":58685,"_17489":98991,"_5":17384,"_23720":98921,"_2383":98992},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2856":58714,"_25059":58685,"_17489":98994,"_5":17384,"_23720":98921,"_2383":98995},[],"Dispositivo sin identidad",{"_2856":58715,"_25059":58685,"_17489":98997,"_5":17384,"_23720":98921,"_2383":98998},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2856":58716,"_25059":58685,"_17489":99000,"_5":17384,"_23720":98921,"_2383":99001},[],"Dispositivo retirado",{"_2856":58717,"_25059":58685,"_17489":99003,"_5":17384,"_23720":98921,"_2383":99004},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2856":58718,"_25059":58685,"_17489":99006,"_5":17384,"_23720":98921,"_2383":99007},[],"Timeout, HTTP 500 o fallo de instalación",{"_2856":58719,"_25059":58685,"_17489":99009,"_5":17384,"_23720":98921,"_2383":99010},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2856":58720,"_25059":58685,"_17489":99012,"_5":17384,"_23720":98925,"_2383":99013},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2856":58721,"_25059":58685,"_17489":99015,"_5":17384,"_23720":98925,"_2383":99016},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2856":58722,"_25059":58722,"_5":12268,"_2383":99018,"_25374":99019,"_17489":99020,"_23720":58722},"Diagnóstico de enrolamiento",[40699,96919,43017,97891,98066],[],{"_2856":58723,"_25059":58722,"_17489":99022,"_5":17384,"_23720":58722,"_2383":99023},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2856":58724,"_25059":58722,"_5":25371,"_17489":99025,"_23720":99026,"_2383":99027},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2856":58725,"_25059":58722,"_5":25371,"_17489":99029,"_23720":99030,"_2383":99031},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2856":58726,"_25059":58722,"_5":25371,"_17489":99033,"_23720":99034,"_2383":98590},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2856":58727,"_25059":58722,"_5":25371,"_17489":99036,"_23720":99037,"_2383":99038},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2856":58728,"_25059":58722,"_17489":99040,"_5":17384,"_23720":58722,"_2383":99041},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2856":58729,"_25059":58722,"_17489":99043,"_5":17384,"_23720":99030,"_2383":99044},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2856":58730,"_25059":58722,"_17489":99046,"_5":17384,"_23720":99030,"_2383":99047},[],"Síntoma o mensaje",{"_2856":58731,"_25059":58722,"_17489":99049,"_5":17384,"_23720":99030,"_2383":99050},[],"Qué revisar",{"_2856":58732,"_25059":58722,"_17489":99052,"_5":17384,"_23720":99030,"_2383":99053},[],"curl rechaza TLS, nombre o emisor",{"_2856":58733,"_25059":58722,"_17489":99055,"_5":17384,"_23720":99030,"_2383":99056},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2856":58734,"_25059":58722,"_17489":99058,"_5":17384,"_23720":99030,"_2383":99059},[],"404 o APS ausente",{"_2856":58735,"_25059":58722,"_17489":99061,"_5":17384,"_23720":99030,"_2383":99062},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2856":58736,"_25059":58722,"_17489":99064,"_5":17384,"_23720":99030,"_2383":99065},[],"400, error de CSR o formato",{"_2856":58737,"_25059":58722,"_17489":99067,"_5":17384,"_23720":99030,"_2383":99068},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2856":58738,"_25059":58722,"_17489":99070,"_5":17384,"_23720":99030,"_2383":99071},[],"Credencial ausente o certificado no válido",{"_2856":58739,"_25059":58722,"_17489":99073,"_5":17384,"_23720":99030,"_2383":99074},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2856":58740,"_25059":58722,"_17489":99076,"_5":17384,"_23720":99030,"_2383":99077},[],"Webhook deniega, expira o responde sin autorización",{"_2856":58741,"_25059":58722,"_17489":99079,"_5":17384,"_23720":99030,"_2383":99080},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2856":58742,"_25059":58722,"_17489":99082,"_5":17384,"_23720":99030,"_2383":44253},[],{"_2856":58743,"_25059":58722,"_17489":99084,"_5":17384,"_23720":99030,"_2383":99085},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2856":58744,"_25059":58722,"_17489":99087,"_5":17384,"_23720":99030,"_2383":44259},[],{"_2856":58745,"_25059":58722,"_17489":99089,"_5":17384,"_23720":99030,"_2383":99090},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2856":58746,"_25059":58722,"_17489":99092,"_5":17384,"_23720":99030,"_2383":44265},[],{"_2856":58747,"_25059":58722,"_17489":99094,"_5":17384,"_23720":99030,"_2383":99095},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2856":58748,"_25059":58722,"_17489":99097,"_5":17384,"_23720":99030,"_2383":99098},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2856":58749,"_25059":58722,"_17489":99100,"_5":17384,"_23720":99030,"_2383":99101},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2856":58750,"_25059":58722,"_17489":99103,"_5":17384,"_23720":99030,"_2383":99104},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2856":58751,"_25059":58722,"_17489":99106,"_5":17384,"_23720":99030,"_2383":99107},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2856":58752,"_25059":58722,"_17489":99109,"_5":17384,"_23720":99030,"_2383":44283},[],{"_2856":58753,"_25059":58722,"_17489":99111,"_5":17384,"_23720":99030,"_2383":99112},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2856":58754,"_25059":58722,"_17489":99114,"_5":17384,"_23720":99030,"_2383":44289},[],{"_2856":58755,"_25059":58722,"_17489":99116,"_5":17384,"_23720":99030,"_2383":99117},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2856":58756,"_25059":58722,"_17489":99119,"_5":17384,"_23720":99030,"_2383":99120},[],"DMS propietario distinto",{"_2856":58757,"_25059":58722,"_17489":99122,"_5":17384,"_23720":99030,"_2383":99123},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2856":58758,"_25059":58722,"_17489":99125,"_5":17384,"_23720":99030,"_2383":44301},[],{"_2856":58759,"_25059":58722,"_17489":99127,"_5":17384,"_23720":99030,"_2383":99128},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2856":58760,"_25059":58722,"_17489":99130,"_5":17384,"_23720":99030,"_2383":44307},[],{"_2856":58761,"_25059":58722,"_17489":99132,"_5":17384,"_23720":99030,"_2383":99133},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2856":58762,"_25059":58722,"_17489":99135,"_5":17384,"_23720":99030,"_2383":99136},[],"Certificado actual revocado",{"_2856":58763,"_25059":58722,"_17489":99138,"_5":17384,"_23720":99030,"_2383":99139},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2856":58764,"_25059":58722,"_17489":99141,"_5":17384,"_23720":99030,"_2383":99142},[],"Error de CA, perfil o firma",{"_2856":58765,"_25059":58722,"_17489":99144,"_5":17384,"_23720":99030,"_2383":99145},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2856":58766,"_25059":58722,"_17489":99147,"_5":17384,"_23720":99030,"_2383":99148},[],"HTTP 200 sin conexión del dispositivo",{"_2856":58767,"_25059":58722,"_17489":99150,"_5":17384,"_23720":99030,"_2383":99151},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2856":58768,"_25059":58722,"_17489":99153,"_5":17384,"_23720":99030,"_2383":99154},[],"Timeout o error después de emitir",{"_2856":58769,"_25059":58722,"_17489":99156,"_5":17384,"_23720":99030,"_2383":99157},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2856":58770,"_25059":58722,"_17489":99159,"_5":17384,"_23720":99034,"_2383":99160},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2856":58771,"_25059":58722,"_17489":99162,"_5":17384,"_23720":99034,"_2383":99163},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2856":58772,"_25059":58722,"_17489":99165,"_5":17384,"_23720":99037,"_2383":99166},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2856":58773,"_25059":58722,"_17489":99168,"_5":17384,"_23720":99037,"_2383":99169},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2856":58774,"_25059":58722,"_17489":99171,"_5":17384,"_23720":99037,"_2383":99172},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2856":58775,"_25059":58722,"_17489":99174,"_5":17384,"_23720":99037,"_2383":99175},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2856":58776,"_25059":58722,"_17489":99177,"_5":17384,"_23720":99037,"_2383":99178},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2856":58777,"_25059":58722,"_17489":99180,"_5":17384,"_23720":99037,"_2383":99181},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2856":58778,"_25059":58722,"_17489":99183,"_5":17384,"_23720":99037,"_2383":99184},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2856":58779,"_25059":58779,"_5":12268,"_2383":99186,"_25374":99187,"_17489":99188,"_23720":58779},"Distribución y actualización de confianza",[40699,96919,43017,97891,98066],[],{"_2856":58780,"_25059":58779,"_17489":99190,"_5":17384,"_23720":58779,"_2383":99191},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2856":58781,"_25059":58779,"_5":25371,"_17489":99193,"_23720":99194,"_2383":99195},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2856":58782,"_25059":58779,"_5":25371,"_17489":99197,"_23720":99198,"_2383":99199},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2856":58783,"_25059":58779,"_5":25371,"_17489":99201,"_23720":99202,"_2383":99203},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2856":58784,"_25059":58779,"_5":25371,"_17489":99205,"_23720":99206,"_2383":99207},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2856":58785,"_25059":58779,"_5":25371,"_17489":99209,"_23720":99210,"_2383":99211},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2856":58786,"_25059":58779,"_17489":99213,"_5":17384,"_23720":58779,"_2383":99214},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2856":58787,"_25059":58779,"_17489":99216,"_5":17384,"_23720":99194,"_2383":99217},[],"Relación",{"_2856":58788,"_25059":58779,"_17489":99219,"_5":17384,"_23720":99194,"_2383":99220},[],"Material que prepara el responsable",{"_2856":58789,"_25059":58779,"_17489":99222,"_5":17384,"_23720":99194,"_2383":99223},[],"Dispositivo → servidor EST",{"_2856":58790,"_25059":58779,"_17489":99225,"_5":17384,"_23720":99194,"_2383":99226},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2856":58791,"_25059":58779,"_17489":99228,"_5":17384,"_23720":99194,"_2383":99229},[],"DMS → solicitante",{"_2856":58792,"_25059":58779,"_17489":99231,"_5":17384,"_23720":99194,"_2383":99232},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2856":58793,"_25059":58779,"_17489":99234,"_5":17384,"_23720":99194,"_2383":99235},[],"Consumidor → dispositivo",{"_2856":58794,"_25059":58779,"_17489":99237,"_5":17384,"_23720":99194,"_2383":99238},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2856":58795,"_25059":58779,"_17489":99240,"_5":17384,"_23720":99194,"_2383":99241},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2856":58796,"_25059":58779,"_17489":99243,"_5":17384,"_23720":99198,"_2383":99244},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2856":58797,"_25059":58779,"_17489":99246,"_5":17384,"_23720":99198,"_2383":99247},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2856":58798,"_25059":58779,"_17489":99249,"_5":17384,"_23720":99202,"_2383":99250},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2856":58799,"_25059":58779,"_17489":99252,"_5":17384,"_23720":99202,"_2383":99253},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2856":58800,"_25059":58779,"_17489":99255,"_5":17384,"_23720":99202,"_2383":99256},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2856":58801,"_25059":58779,"_17489":99258,"_5":17384,"_23720":99202,"_2383":99259},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2856":58802,"_25059":58779,"_17489":99261,"_5":17384,"_23720":99202,"_2383":99262},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2856":58803,"_25059":58779,"_17489":99264,"_5":17384,"_23720":99202,"_2383":99265},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2856":58804,"_25059":58779,"_17489":99267,"_5":17384,"_23720":99206,"_2383":99268},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2856":58805,"_25059":58779,"_17489":99270,"_5":17384,"_23720":99206,"_2383":99271},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2856":58806,"_25059":58779,"_17489":99273,"_5":17384,"_23720":99206,"_2383":99274},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2856":58807,"_25059":58779,"_17489":99276,"_5":17384,"_23720":99210,"_2383":99277},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2856":58808,"_25059":58808,"_5":12268,"_2383":44456,"_25374":99279,"_17489":99281,"_23720":58808},[40699,96919,43017,97891,99280],"Integraciones",[],{"_2856":58809,"_25059":58808,"_17489":99283,"_5":17384,"_23720":58808,"_2383":99284},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2856":58810,"_25059":58808,"_5":25371,"_17489":99286,"_23720":99287,"_2383":99288},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2856":58811,"_25059":58808,"_5":25371,"_17489":99290,"_23720":99291,"_2383":99292},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2856":58812,"_25059":58808,"_5":25371,"_17489":99294,"_23720":99295,"_2383":99296},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2856":58813,"_25059":58808,"_5":25371,"_17489":99298,"_23720":99299,"_2383":99300},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2856":58814,"_25059":58808,"_5":25371,"_17489":99302,"_23720":99303,"_2383":99304},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2856":58815,"_25059":58808,"_5":25371,"_17489":99306,"_23720":99307,"_2383":99308},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2856":58816,"_25059":58808,"_5":25371,"_17489":99310,"_23720":99311,"_2383":44490},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2856":58817,"_25059":58808,"_5":25371,"_17489":99313,"_23720":99314,"_2383":44494},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2856":58818,"_25059":58808,"_5":25371,"_17489":99316,"_23720":99317,"_2383":99318},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2856":58819,"_25059":58808,"_5":25371,"_17489":99320,"_23720":99321,"_2383":99322},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2856":58820,"_25059":58808,"_5":25371,"_17489":99324,"_23720":99325,"_2383":99326},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2856":58821,"_25059":58808,"_5":25371,"_17489":99328,"_23720":99329,"_2383":99330},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2856":58822,"_25059":58808,"_5":25371,"_17489":99332,"_23720":99333,"_2383":99334},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2856":58823,"_25059":58808,"_5":25371,"_17489":99336,"_23720":99337,"_2383":99338},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2856":58824,"_25059":58808,"_5":25371,"_17489":99340,"_23720":99341,"_2383":99342},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2856":58825,"_25059":58808,"_5":25371,"_17489":99344,"_23720":99345,"_2383":99346},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2856":58826,"_25059":58808,"_5":25371,"_17489":99348,"_23720":99349,"_2383":99350},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2856":58827,"_25059":58808,"_5":25371,"_17489":99352,"_23720":99353,"_2383":99354},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2856":58828,"_25059":58808,"_5":25371,"_17489":99356,"_23720":99357,"_2383":99358},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2856":58829,"_25059":58808,"_5":25371,"_17489":99360,"_23720":99361,"_2383":99362},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2856":58830,"_25059":58808,"_17489":99364,"_5":17384,"_23720":58808,"_2383":99365},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2856":58831,"_25059":58808,"_17489":99367,"_5":17384,"_23720":58808,"_2383":99368},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2856":58832,"_25059":58808,"_17489":99370,"_5":17384,"_23720":58808,"_2383":99371},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2856":58833,"_25059":58808,"_17489":99373,"_5":17384,"_23720":99287,"_2383":99374},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2856":58834,"_25059":58808,"_17489":99376,"_5":17384,"_23720":99287,"_2383":99377},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2856":58835,"_25059":58808,"_17489":99379,"_5":17384,"_23720":99287,"_2383":99380},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2856":58836,"_25059":58808,"_17489":99382,"_5":17384,"_23720":99287,"_2383":99383},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2856":58837,"_25059":58808,"_17489":99385,"_5":17384,"_23720":99291,"_2383":99386},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2856":58838,"_25059":58808,"_17489":99388,"_5":17384,"_23720":99295,"_2383":99389},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2856":58839,"_25059":58808,"_17489":99391,"_5":17384,"_23720":99295,"_2383":99392},[],"Acción IAM",{"_2856":58840,"_25059":58808,"_17489":99394,"_5":17384,"_23720":99295,"_2383":95983},[],{"_2856":58841,"_25059":58808,"_17489":99396,"_5":17384,"_23720":99295,"_2383":44577},[],{"_2856":58842,"_25059":58808,"_17489":99398,"_5":17384,"_23720":99295,"_2383":99399},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2856":58843,"_25059":58808,"_17489":99401,"_5":17384,"_23720":99295,"_2383":44583},[],{"_2856":58844,"_25059":58808,"_17489":99403,"_5":17384,"_23720":99295,"_2383":99404},[],"Registrar la CA en AWS IoT",{"_2856":58845,"_25059":58808,"_17489":99406,"_5":17384,"_23720":99295,"_2383":44589},[],{"_2856":58846,"_25059":58808,"_17489":99408,"_5":17384,"_23720":99295,"_2383":99409},[],"Consultar el estado del registro de la CA",{"_2856":58847,"_25059":58808,"_17489":99411,"_5":17384,"_23720":99295,"_2383":44595},[],{"_2856":58848,"_25059":58808,"_17489":99413,"_5":17384,"_23720":99295,"_2383":99414},[],"Crear o actualizar Things en IoT Core",{"_2856":58849,"_25059":58808,"_17489":99416,"_5":17384,"_23720":99295,"_2383":44601},[],{"_2856":58850,"_25059":58808,"_17489":99418,"_5":17384,"_23720":99295,"_2383":99419},[],"Aprovisionar Things mediante plantilla",{"_2856":58851,"_25059":58808,"_17489":99421,"_5":17384,"_23720":99295,"_2383":44607},[],{"_2856":58852,"_25059":58808,"_17489":99423,"_5":17384,"_23720":99295,"_2383":99424},[],"Registrar certificados de dispositivo",{"_2856":58853,"_25059":58808,"_17489":99426,"_5":17384,"_23720":99295,"_2383":44613},[],{"_2856":58854,"_25059":58808,"_17489":99428,"_5":17384,"_23720":99295,"_2383":99429},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2856":58855,"_25059":58808,"_17489":99431,"_5":17384,"_23720":99295,"_2383":44619},[],{"_2856":58856,"_25059":58808,"_17489":99433,"_5":17384,"_23720":99295,"_2383":99434},[],"Crear y adjuntar políticas IoT",{"_2856":58857,"_25059":58808,"_17489":99436,"_5":17384,"_23720":99295,"_2383":44625},[],{"_2856":58858,"_25059":58808,"_17489":99438,"_5":17384,"_23720":99295,"_2383":99439},[],"Gestionar grupos de Things",{"_2856":58859,"_25059":58808,"_17489":99441,"_5":17384,"_23720":99295,"_2383":44631},[],{"_2856":58860,"_25059":58808,"_17489":99443,"_5":17384,"_23720":99295,"_2383":99444},[],"Crear plantillas JITP",{"_2856":58861,"_25059":58808,"_17489":99446,"_5":17384,"_23720":99295,"_2383":44637},[],{"_2856":58862,"_25059":58808,"_17489":99448,"_5":17384,"_23720":99295,"_2383":99449},[],"Leer y escribir el Device Shadow",{"_2856":58863,"_25059":58808,"_17489":99451,"_5":17384,"_23720":99295,"_2383":99452},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2856":58864,"_25059":58808,"_17489":99454,"_5":17384,"_23720":99299,"_2383":99455},[],"Parámetro",{"_2856":58865,"_25059":58808,"_17489":99457,"_5":17384,"_23720":99299,"_2383":99458},[],"Tipo",{"_2856":58866,"_25059":58808,"_17489":99460,"_5":17384,"_23720":99299,"_2383":99461},[],"Requerido",{"_2856":58867,"_25059":58808,"_17489":99463,"_5":17384,"_23720":99299,"_2383":99464},[],"Descripción",{"_2856":58868,"_25059":58808,"_17489":99466,"_5":17384,"_23720":99299,"_2383":44658},[],{"_2856":58869,"_25059":58808,"_17489":99468,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58870,"_25059":58808,"_17489":99470,"_5":17384,"_23720":99299,"_2383":99471},[],"Sí",{"_2856":58871,"_25059":58808,"_17489":99473,"_5":17384,"_23720":99299,"_2383":99474},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2856":58872,"_25059":58808,"_17489":99476,"_5":17384,"_23720":99299,"_2383":44669},[],{"_2856":58873,"_25059":58808,"_17489":99478,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58874,"_25059":58808,"_17489":99480,"_5":17384,"_23720":99299,"_2383":99471},[],{"_2856":58875,"_25059":58808,"_17489":99482,"_5":17384,"_23720":99299,"_2383":99483},[],"Región AWS donde opera el conector.",{"_2856":58876,"_25059":58808,"_17489":99485,"_5":17384,"_23720":99299,"_2383":44679},[],{"_2856":58877,"_25059":58808,"_17489":99487,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58878,"_25059":58808,"_17489":99489,"_5":17384,"_23720":99299,"_2383":99471},[],{"_2856":58879,"_25059":58808,"_17489":99491,"_5":17384,"_23720":99299,"_2383":99492},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2856":58880,"_25059":58808,"_17489":99494,"_5":17384,"_23720":99299,"_2383":44689},[],{"_2856":58881,"_25059":58808,"_17489":99496,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58882,"_25059":58808,"_17489":99498,"_5":17384,"_23720":99299,"_2383":99499},[],"Solo con `auth_method=static`",{"_2856":58883,"_25059":58808,"_17489":99501,"_5":17384,"_23720":99299,"_2383":99502},[],"Clave de acceso AWS.",{"_2856":58884,"_25059":58808,"_17489":99504,"_5":17384,"_23720":99299,"_2383":44700},[],{"_2856":58885,"_25059":58808,"_17489":99506,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58886,"_25059":58808,"_17489":99508,"_5":17384,"_23720":99299,"_2383":99499},[],{"_2856":58887,"_25059":58808,"_17489":99510,"_5":17384,"_23720":99299,"_2383":99511},[],"Clave secreta AWS.",{"_2856":58888,"_25059":58808,"_17489":99513,"_5":17384,"_23720":99299,"_2383":44710},[],{"_2856":58889,"_25059":58808,"_17489":99515,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58890,"_25059":58808,"_17489":99517,"_5":17384,"_23720":99299,"_2383":44715},[],{"_2856":58891,"_25059":58808,"_17489":99519,"_5":17384,"_23720":99299,"_2383":99520},[],"Token de sesión (con `auth_method=static`).",{"_2856":58892,"_25059":58808,"_17489":99522,"_5":17384,"_23720":99299,"_2383":44721},[],{"_2856":58893,"_25059":58808,"_17489":99524,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58894,"_25059":58808,"_17489":99526,"_5":17384,"_23720":99299,"_2383":99527},[],"Solo con `auth_method=role`",{"_2856":58895,"_25059":58808,"_17489":99529,"_5":17384,"_23720":99299,"_2383":99530},[],"ARN del rol a asumir.",{"_2856":58896,"_25059":58808,"_17489":99532,"_5":17384,"_23720":99299,"_2383":44732},[],{"_2856":58897,"_25059":58808,"_17489":99534,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58898,"_25059":58808,"_17489":99536,"_5":17384,"_23720":99299,"_2383":44715},[],{"_2856":58899,"_25059":58808,"_17489":99538,"_5":17384,"_23720":99299,"_2383":99539},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2856":58900,"_25059":58808,"_17489":99541,"_5":17384,"_23720":99299,"_2383":44742},[],{"_2856":58901,"_25059":58808,"_17489":99543,"_5":17384,"_23720":99299,"_2383":14693},[],{"_2856":58902,"_25059":58808,"_17489":99545,"_5":17384,"_23720":99299,"_2383":99471},[],{"_2856":58903,"_25059":58808,"_17489":99547,"_5":17384,"_23720":99299,"_2383":99548},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2856":58904,"_25059":58808,"_17489":99550,"_5":17384,"_23720":99299,"_2383":44752},[],{"_2856":58905,"_25059":58808,"_17489":99552,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58906,"_25059":58808,"_17489":99554,"_5":17384,"_23720":99299,"_2383":99471},[],{"_2856":58907,"_25059":58808,"_17489":99556,"_5":17384,"_23720":99299,"_2383":99557},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2856":58908,"_25059":58808,"_17489":99559,"_5":17384,"_23720":99299,"_2383":44762},[],{"_2856":58909,"_25059":58808,"_17489":99561,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58910,"_25059":58808,"_17489":99563,"_5":17384,"_23720":99299,"_2383":99471},[],{"_2856":58911,"_25059":58808,"_17489":99565,"_5":17384,"_23720":99299,"_2383":99566},[],"URL HTTP del Device Manager de Lamassu.",{"_2856":58912,"_25059":58808,"_17489":99568,"_5":17384,"_23720":99299,"_2383":44772},[],{"_2856":58913,"_25059":58808,"_17489":99570,"_5":17384,"_23720":99299,"_2383":20874},[],{"_2856":58914,"_25059":58808,"_17489":99572,"_5":17384,"_23720":99299,"_2383":99471},[],{"_2856":58915,"_25059":58808,"_17489":99574,"_5":17384,"_23720":99299,"_2383":99575},[],"URL HTTP del servicio de CA de Lamassu.",{"_2856":58916,"_25059":58808,"_17489":99577,"_5":17384,"_23720":99303,"_2383":99578},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2856":58917,"_25059":58808,"_17489":99580,"_5":17384,"_23720":99307,"_2383":99581},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2856":58918,"_25059":58808,"_17489":99583,"_5":17384,"_23720":99307,"_2383":99584},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2856":58919,"_25059":58808,"_17489":99586,"_5":17384,"_23720":99311,"_2383":99587},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2856":58920,"_25059":58808,"_17489":99589,"_5":17384,"_23720":99311,"_2383":99590},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2856":58921,"_25059":58808,"_17489":99592,"_5":17384,"_23720":99311,"_2383":99593},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2856":58922,"_25059":58808,"_17489":99595,"_5":17384,"_23720":99311,"_2383":99596},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2856":58923,"_25059":58808,"_17489":99598,"_5":17384,"_23720":99311,"_2383":99599},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2856":58924,"_25059":58808,"_17489":99601,"_5":17384,"_23720":99311,"_2383":99602},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2856":58925,"_25059":58808,"_17489":99604,"_5":17384,"_23720":99314,"_2383":99605},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2856":58926,"_25059":58808,"_17489":99607,"_5":17384,"_23720":99317,"_2383":99608},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2856":58927,"_25059":58808,"_17489":99610,"_5":17384,"_23720":99317,"_2383":99611},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2856":58928,"_25059":58808,"_17489":99613,"_5":17384,"_23720":99321,"_2383":99614},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2856":58929,"_25059":58808,"_17489":99616,"_5":17384,"_23720":99325,"_2383":99617},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2856":58930,"_25059":58808,"_17489":99619,"_5":17384,"_23720":99325,"_2383":99620},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2856":58931,"_25059":58808,"_17489":99622,"_5":17384,"_23720":99325,"_2383":99623},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2856":58932,"_25059":58808,"_17489":99625,"_5":17384,"_23720":99325,"_2383":99626},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2856":58933,"_25059":58808,"_17489":99628,"_5":17384,"_23720":99325,"_2383":99629},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2856":58934,"_25059":58808,"_17489":99631,"_5":17384,"_23720":99325,"_2383":99632},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2856":58935,"_25059":58808,"_17489":99634,"_5":17384,"_23720":99329,"_2383":99635},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2856":58936,"_25059":58808,"_17489":99637,"_5":17384,"_23720":99329,"_2383":99638},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2856":58937,"_25059":58808,"_17489":99640,"_5":17384,"_23720":99329,"_2383":99641},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2856":58938,"_25059":58808,"_17489":99643,"_5":17384,"_23720":99333,"_2383":99644},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2856":58939,"_25059":58808,"_17489":99646,"_5":17384,"_23720":99333,"_2383":99647},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2856":58940,"_25059":58808,"_17489":99649,"_5":17384,"_23720":99333,"_2383":99650},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2856":58941,"_25059":58808,"_17489":99652,"_5":17384,"_23720":99337,"_2383":99653},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2856":58942,"_25059":58808,"_17489":99655,"_5":17384,"_23720":99337,"_2383":99656},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2856":58943,"_25059":58808,"_17489":99658,"_5":17384,"_23720":99337,"_2383":99659},[],"Para que el flujo JITP funcione correctamente:",{"_2856":58944,"_25059":58808,"_17489":99661,"_5":17384,"_23720":99337,"_2383":99662},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2856":58945,"_25059":58808,"_17489":99664,"_5":17384,"_23720":99337,"_2383":99665},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2856":58946,"_25059":58808,"_17489":99667,"_5":17384,"_23720":99337,"_2383":99668},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2856":58947,"_25059":58808,"_17489":99670,"_5":17384,"_23720":99337,"_2383":99671},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2856":58948,"_25059":58808,"_17489":99673,"_5":17384,"_23720":99341,"_2383":99674},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2856":58949,"_25059":58808,"_17489":99676,"_5":17384,"_23720":99341,"_2383":99677},[],"Estado en Lamassu",{"_2856":58950,"_25059":58808,"_17489":99679,"_5":17384,"_23720":99341,"_2383":99680},[],"Razón de revocación",{"_2856":58951,"_25059":58808,"_17489":99682,"_5":17384,"_23720":99341,"_2383":99683},[],"Estado en AWS IoT Core",{"_2856":58952,"_25059":58808,"_17489":99685,"_5":17384,"_23720":99341,"_2383":44893},[],{"_2856":58953,"_25059":58808,"_17489":99687,"_5":17384,"_23720":99341,"_2383":99688},[],"Ninguna",{"_2856":58954,"_25059":58808,"_17489":99690,"_5":17384,"_23720":99341,"_2383":44899},[],{"_2856":58955,"_25059":58808,"_17489":99692,"_5":17384,"_23720":99341,"_2383":44902},[],{"_2856":58956,"_25059":58808,"_17489":99694,"_5":17384,"_23720":99341,"_2383":44905},[],{"_2856":58957,"_25059":58808,"_17489":99696,"_5":17384,"_23720":99341,"_2383":44908},[],{"_2856":58958,"_25059":58808,"_17489":99698,"_5":17384,"_23720":99341,"_2383":44902},[],{"_2856":58959,"_25059":58808,"_17489":99700,"_5":17384,"_23720":99341,"_2383":99701},[],"Cualquier otra razón",{"_2856":58960,"_25059":58808,"_17489":99703,"_5":17384,"_23720":99341,"_2383":44916},[],{"_2856":58961,"_25059":58808,"_17489":99705,"_5":17384,"_23720":99341,"_2383":99706},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2856":58962,"_25059":58808,"_17489":99708,"_5":17384,"_23720":99345,"_2383":99709},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2856":58963,"_25059":58808,"_17489":99711,"_5":17384,"_23720":99345,"_2383":99712},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2856":58964,"_25059":58808,"_17489":99714,"_5":17384,"_23720":99345,"_2383":99715},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2856":58965,"_25059":58808,"_17489":99717,"_5":17384,"_23720":99349,"_2383":99718},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2856":58966,"_25059":58808,"_17489":99720,"_5":17384,"_23720":99349,"_2383":99721},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2856":58967,"_25059":58808,"_17489":99723,"_5":17384,"_23720":99353,"_2383":99724},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2856":58968,"_25059":58808,"_17489":99726,"_5":17384,"_23720":99353,"_2383":99727},[],"Existen dos tipos de acciones:",{"_2856":58969,"_25059":58808,"_17489":99729,"_5":17384,"_23720":99353,"_2383":99730},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2856":58970,"_25059":58808,"_17489":99732,"_5":17384,"_23720":99353,"_2383":99733},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2856":58971,"_25059":58808,"_17489":99735,"_5":17384,"_23720":99353,"_2383":99736},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2856":58972,"_25059":58808,"_17489":99738,"_5":17384,"_23720":99357,"_2383":99739},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2856":58973,"_25059":58808,"_17489":99741,"_5":17384,"_23720":99357,"_2383":99742},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2856":58974,"_25059":58808,"_17489":99744,"_5":17384,"_23720":99357,"_2383":99745},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2856":58975,"_25059":58808,"_17489":99747,"_5":17384,"_23720":99361,"_2383":99748},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2856":58976,"_25059":58808,"_17489":99750,"_5":17384,"_23720":99361,"_2383":99751},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2856":58977,"_25059":58808,"_17489":99753,"_5":17384,"_23720":99361,"_2383":99754},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2856":58978,"_25059":58808,"_17489":99756,"_5":17384,"_23720":99361,"_2383":99757},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2856":58979,"_25059":58808,"_17489":99759,"_5":17384,"_23720":99361,"_2383":99760},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2856":58980,"_25059":58808,"_17489":99762,"_5":17384,"_23720":99361,"_2383":99763},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2856":58981,"_25059":58808,"_17489":99765,"_5":17384,"_23720":99361,"_2383":99766},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2856":58982,"_25059":58808,"_17489":99768,"_5":17384,"_23720":99361,"_2383":99769},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2856":58983,"_25059":58808,"_17489":99771,"_5":17384,"_23720":99361,"_2383":99772},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2856":58984,"_25059":58808,"_17489":99774,"_5":17384,"_23720":99361,"_2383":99775},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2856":58985,"_25059":58808,"_17489":99777,"_5":17384,"_23720":99361,"_2383":99778},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2856":58986,"_25059":58808,"_17489":99780,"_5":17384,"_23720":99361,"_2383":99781},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2856":58987,"_25059":58808,"_17489":99783,"_5":17384,"_23720":99361,"_2383":99784},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2856":58988,"_25059":58808,"_17489":99786,"_5":17384,"_23720":99361,"_2383":99787},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2856":58989,"_25059":58808,"_17489":99789,"_5":17384,"_23720":99361,"_2383":99790},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2856":58990,"_25059":58808,"_17489":99792,"_5":17384,"_23720":99361,"_2383":99793},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2856":58991,"_25059":58808,"_17489":99795,"_5":17384,"_23720":99361,"_2383":99796},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2856":58992,"_25059":58808,"_17489":99798,"_5":17384,"_23720":99361,"_2383":99799},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2856":58993,"_25059":58808,"_17489":99801,"_5":17384,"_23720":99361,"_2383":99802},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":58994,"_25059":58808,"_17489":99804,"_5":17384,"_23720":99361,"_2383":99805},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2856":58995,"_25059":58808,"_17489":99807,"_5":17384,"_23720":99361,"_2383":99808},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2856":58996,"_25059":58996,"_5":12268,"_2383":43017,"_25374":99810,"_17489":99811,"_23720":58996},[40699,96919,43017],[],{"_2856":58997,"_25059":58996,"_17489":99813,"_5":17384,"_23720":58996,"_2383":99814},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2856":58998,"_25059":58996,"_5":25371,"_17489":99816,"_23720":99817,"_2383":99818},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2856":58999,"_25059":58996,"_5":25371,"_17489":99820,"_23720":99821,"_2383":97891},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2856":59000,"_25059":58996,"_5":25371,"_17489":99823,"_23720":99824,"_2383":98066},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2856":59001,"_25059":58996,"_5":25371,"_17489":99826,"_23720":99827,"_2383":99280},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_2856":59002,"_25059":58996,"_5":25371,"_17489":99829,"_23720":99830,"_2383":99831},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2856":59003,"_25059":58996,"_17489":99833,"_5":17384,"_23720":58996,"_2383":99834},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2856":59004,"_25059":58996,"_17489":99836,"_5":17384,"_23720":99817,"_2383":99837},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2856":59005,"_25059":58996,"_17489":99839,"_5":17384,"_23720":99817,"_2383":99840},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2856":59006,"_25059":58996,"_17489":99842,"_5":17384,"_23720":99821,"_2383":99843},[],"Recurso",{"_2856":59007,"_25059":58996,"_17489":99845,"_5":17384,"_23720":99821,"_2383":99846},[],"Qué representa",{"_2856":59008,"_25059":58996,"_17489":99848,"_5":17384,"_23720":99821,"_2383":99849},[],"**Dispositivo**",{"_2856":59009,"_25059":58996,"_17489":99851,"_5":17384,"_23720":99821,"_2383":99852},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2856":59010,"_25059":58996,"_17489":99854,"_5":17384,"_23720":99821,"_2383":99855},[],"**Identidad**",{"_2856":59011,"_25059":58996,"_17489":99857,"_5":17384,"_23720":99821,"_2383":99858},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2856":59012,"_25059":58996,"_17489":99860,"_5":17384,"_23720":99821,"_2383":45074},[],{"_2856":59013,"_25059":58996,"_17489":99862,"_5":17384,"_23720":99821,"_2383":99863},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2856":59014,"_25059":58996,"_17489":99865,"_5":17384,"_23720":99821,"_2383":99866},[],"**Flota**",{"_2856":59015,"_25059":58996,"_17489":99868,"_5":17384,"_23720":99821,"_2383":99869},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2856":59016,"_25059":58996,"_17489":99871,"_5":17384,"_23720":99821,"_2383":99872},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2856":59017,"_25059":58996,"_17489":99874,"_5":17384,"_23720":99821,"_2383":99875},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2856":59018,"_25059":58996,"_17489":99877,"_5":17384,"_23720":99824,"_2383":99878},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2856":59019,"_25059":58996,"_17489":99880,"_5":17384,"_23720":99824,"_2383":99881},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2856":59020,"_25059":58996,"_17489":99883,"_5":17384,"_23720":99824,"_2383":99884},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2856":59021,"_25059":58996,"_17489":99886,"_5":17384,"_23720":99824,"_2383":99887},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2856":59022,"_25059":58996,"_17489":99889,"_5":17384,"_23720":99824,"_2383":99890},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2856":59023,"_25059":58996,"_17489":99892,"_5":17384,"_23720":99824,"_2383":99893},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2856":59024,"_25059":58996,"_17489":99895,"_5":17384,"_23720":99824,"_2383":99896},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":59025,"_25059":58996,"_17489":99898,"_5":17384,"_23720":99824,"_2383":99899},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":59026,"_25059":58996,"_17489":99901,"_5":17384,"_23720":99827,"_2383":99902},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2856":59027,"_25059":58996,"_17489":99904,"_5":17384,"_23720":99827,"_2383":99905},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2856":59028,"_25059":58996,"_17489":99907,"_5":17384,"_23720":99830,"_2383":99908},[],"Participante",{"_2856":59029,"_25059":58996,"_17489":99910,"_5":17384,"_23720":99830,"_2383":99911},[],"Responsabilidad",{"_2856":59030,"_25059":58996,"_17489":99913,"_5":17384,"_23720":99830,"_2383":99914},[],"Administrador PKI",{"_2856":59031,"_25059":58996,"_17489":99916,"_5":17384,"_23720":99830,"_2383":99917},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2856":59032,"_25059":58996,"_17489":99919,"_5":17384,"_23720":99830,"_2383":99920},[],"Administrador del aprovisionamiento",{"_2856":59033,"_25059":58996,"_17489":99922,"_5":17384,"_23720":99830,"_2383":99923},[],"DMS, admisión, autenticación por operación e inventario.",{"_2856":59034,"_25059":58996,"_17489":99925,"_5":17384,"_23720":99830,"_2383":99926},[],"Integrador del dispositivo",{"_2856":59035,"_25059":58996,"_17489":99928,"_5":17384,"_23720":99830,"_2383":99929},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2856":59036,"_25059":58996,"_17489":99931,"_5":17384,"_23720":99830,"_2383":99932},[],"Integrador del consumidor",{"_2856":59037,"_25059":58996,"_17489":99934,"_5":17384,"_23720":99830,"_2383":99935},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2856":59038,"_25059":58996,"_17489":99937,"_5":17384,"_23720":99830,"_2383":99938},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2856":59039,"_25059":59039,"_5":12268,"_2383":99940,"_25374":99941,"_17489":99943,"_23720":59039},"Enrola y conecta tu primer dispositivo",[40699,96919,43017,99942],"Primeros pasos",[],{"_2856":59040,"_25059":59039,"_17489":99945,"_5":17384,"_23720":59039,"_2383":99946},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2856":59041,"_25059":59039,"_5":25371,"_17489":99948,"_23720":99949,"_2383":95620},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2856":59042,"_25059":59039,"_5":25371,"_17489":99951,"_23720":99952,"_2383":99953},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2856":59043,"_25059":59039,"_5":25371,"_17489":99955,"_23720":99956,"_2383":99957},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2856":59044,"_25059":59039,"_5":25371,"_17489":99959,"_23720":99960,"_2383":99961},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2856":59045,"_25059":59039,"_5":25371,"_17489":99963,"_23720":99964,"_2383":99965},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2856":59046,"_25059":59039,"_5":25371,"_17489":99967,"_23720":99968,"_2383":99969},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2856":59047,"_25059":59039,"_5":25371,"_17489":99971,"_23720":99972,"_2383":99973},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2856":59048,"_25059":59039,"_5":25371,"_17489":99975,"_23720":99976,"_2383":99977},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2856":59049,"_25059":59039,"_17489":99979,"_5":17384,"_23720":59039,"_2383":99980},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2856":59050,"_25059":59039,"_17489":99982,"_5":17384,"_23720":99949,"_2383":99983},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2856":59051,"_25059":59039,"_17489":99985,"_5":17384,"_23720":99949,"_2383":99986},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2856":59052,"_25059":59039,"_17489":99988,"_5":17384,"_23720":99949,"_2383":99989},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2856":59053,"_25059":59039,"_17489":99991,"_5":17384,"_23720":99949,"_2383":99992},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2856":59054,"_25059":59039,"_17489":99994,"_5":17384,"_23720":99949,"_2383":99995},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2856":59055,"_25059":59039,"_17489":99997,"_5":17384,"_23720":99952,"_2383":99998},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2856":59056,"_25059":59039,"_17489":100000,"_5":17384,"_23720":99952,"_2383":100001},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2856":59057,"_25059":59039,"_17489":100003,"_5":17384,"_23720":99956,"_2383":100004},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2856":59058,"_25059":59039,"_17489":100006,"_5":17384,"_23720":99956,"_2383":100007},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2856":59059,"_25059":59039,"_17489":100009,"_5":17384,"_23720":99956,"_2383":100010},[],"Ajuste",{"_2856":59060,"_25059":59039,"_17489":100012,"_5":17384,"_23720":99956,"_2383":100013},[],"Valor de evaluación",{"_2856":59061,"_25059":59039,"_17489":100015,"_5":17384,"_23720":99956,"_2383":45230},[],{"_2856":59062,"_25059":59039,"_17489":100017,"_5":17384,"_23720":99956,"_2383":100018},[],"Raíz emisora de `device-root.pem`.",{"_2856":59063,"_25059":59039,"_17489":100020,"_5":17384,"_23720":99956,"_2383":98194},[],{"_2856":59064,"_25059":59039,"_17489":100022,"_5":17384,"_23720":99956,"_2383":100023},[],"Perfil final de 1 hora que acabas de preparar.",{"_2856":59065,"_25059":59039,"_17489":100025,"_5":17384,"_23720":99956,"_2383":45241},[],{"_2856":59066,"_25059":59039,"_17489":100027,"_5":17384,"_23720":99956,"_2383":45244},[],{"_2856":59067,"_25059":59039,"_17489":100029,"_5":17384,"_23720":99956,"_2383":45247},[],{"_2856":59068,"_25059":59039,"_17489":100031,"_5":17384,"_23720":99956,"_2383":100032},[],"Habilitado.",{"_2856":59069,"_25059":59039,"_17489":100034,"_5":17384,"_23720":99956,"_2383":45253},[],{"_2856":59070,"_25059":59039,"_17489":100036,"_5":17384,"_23720":99956,"_2383":100037},[],"Deshabilitado; el ID debe ser nuevo.",{"_2856":59071,"_25059":59039,"_17489":100039,"_5":17384,"_23720":99956,"_2383":100040},[],"Autenticación inicial",{"_2856":59072,"_25059":59039,"_17489":100042,"_5":17384,"_23720":99956,"_2383":100043},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2856":59073,"_25059":59039,"_17489":100045,"_5":17384,"_23720":99956,"_2383":100046},[],"Autenticación de renovación",{"_2856":59074,"_25059":59039,"_17489":100048,"_5":17384,"_23720":99956,"_2383":100049},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2856":59075,"_25059":59039,"_17489":100051,"_5":17384,"_23720":99956,"_2383":45271},[],{"_2856":59076,"_25059":59039,"_17489":100053,"_5":17384,"_23720":99956,"_2383":100054},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2856":59077,"_25059":59039,"_17489":100056,"_5":17384,"_23720":99956,"_2383":45277},[],{"_2856":59078,"_25059":59039,"_17489":100058,"_5":17384,"_23720":99956,"_2383":100059},[],"1 hora.",{"_2856":59079,"_25059":59039,"_17489":100061,"_5":17384,"_23720":99956,"_2383":45283},[],{"_2856":59080,"_25059":59039,"_17489":100063,"_5":17384,"_23720":99956,"_2383":100064},[],"30 minutos / 10 minutos.",{"_2856":59081,"_25059":59039,"_17489":100066,"_5":17384,"_23720":99956,"_2383":45289},[],{"_2856":59082,"_25059":59039,"_17489":100068,"_5":17384,"_23720":99956,"_2383":100069},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2856":59083,"_25059":59039,"_17489":100071,"_5":17384,"_23720":99956,"_2383":43336},[],{"_2856":59084,"_25059":59039,"_17489":100073,"_5":17384,"_23720":99956,"_2383":100074},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2856":59085,"_25059":59039,"_17489":100076,"_5":17384,"_23720":99956,"_2383":45300},[],{"_2856":59086,"_25059":59039,"_17489":100078,"_5":17384,"_23720":99956,"_2383":100079},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2856":59087,"_25059":59039,"_17489":100081,"_5":17384,"_23720":99956,"_2383":100082},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2856":59088,"_25059":59039,"_17489":100084,"_5":17384,"_23720":99960,"_2383":100085},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2856":59089,"_25059":59039,"_17489":100087,"_5":17384,"_23720":99960,"_2383":100088},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2856":59090,"_25059":59039,"_17489":100090,"_5":17384,"_23720":99964,"_2383":100091},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2856":59091,"_25059":59039,"_17489":100093,"_5":17384,"_23720":99964,"_2383":100094},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2856":59092,"_25059":59039,"_17489":100096,"_5":17384,"_23720":99964,"_2383":100097},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2856":59093,"_25059":59039,"_17489":100099,"_5":17384,"_23720":99968,"_2383":100100},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2856":59094,"_25059":59039,"_17489":100102,"_5":17384,"_23720":99968,"_2383":100103},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2856":59095,"_25059":59039,"_17489":100105,"_5":17384,"_23720":99972,"_2383":100106},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2856":59096,"_25059":59039,"_17489":100108,"_5":17384,"_23720":99972,"_2383":100109},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2856":59097,"_25059":59039,"_17489":100111,"_5":17384,"_23720":99972,"_2383":100112},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2856":59098,"_25059":59039,"_17489":100114,"_5":17384,"_23720":99972,"_2383":100115},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2856":59099,"_25059":59039,"_17489":100117,"_5":17384,"_23720":99972,"_2383":100118},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2856":59100,"_25059":59039,"_17489":100120,"_5":17384,"_23720":99976,"_2383":100121},[],"Comprobación",{"_2856":59101,"_25059":59039,"_17489":100123,"_5":17384,"_23720":99976,"_2383":100124},[],"Resultado esperado",{"_2856":59102,"_25059":59039,"_17489":100126,"_5":17384,"_23720":99976,"_2383":100127},[],"Registro",{"_2856":59103,"_25059":59039,"_17489":100129,"_5":17384,"_23720":99976,"_2383":100130},[],"ID creado automáticamente y DMS correcto.",{"_2856":59104,"_25059":59039,"_17489":100132,"_5":17384,"_23720":99976,"_2383":100133},[],"Certificado",{"_2856":59105,"_25059":59039,"_17489":100135,"_5":17384,"_23720":99976,"_2383":100136},[],"CN, perfil, serie y clave verificados.",{"_2856":59106,"_25059":59039,"_17489":100138,"_5":17384,"_23720":99976,"_2383":100139},[],"Inventario",{"_2856":59107,"_25059":59039,"_17489":100141,"_5":17384,"_23720":99976,"_2383":100142},[],"Serie recibida visible como identidad actual y en el historial.",{"_2856":59108,"_25059":59039,"_17489":100144,"_5":17384,"_23720":99976,"_2383":100145},[],"Consumidor",{"_2856":59109,"_25059":59039,"_17489":100147,"_5":17384,"_23720":99976,"_2383":100148},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2856":59110,"_25059":59039,"_17489":100150,"_5":17384,"_23720":99976,"_2383":100151},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2856":59111,"_25059":59039,"_17489":100153,"_5":17384,"_23720":99976,"_2383":100154},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2856":59112,"_25059":59112,"_5":12268,"_2383":97908,"_25374":100156,"_17489":100157,"_23720":59112},[40699,96919,43017,99942],[],{"_2856":59113,"_25059":59112,"_17489":100159,"_5":17384,"_23720":59112,"_2383":100160},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2856":59114,"_25059":59112,"_5":25371,"_17489":100162,"_23720":100163,"_2383":95620},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2856":59115,"_25059":59112,"_5":25371,"_17489":100165,"_23720":100166,"_2383":100167},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2856":59116,"_25059":59112,"_5":25371,"_17489":100169,"_23720":100170,"_2383":100171},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2856":59117,"_25059":59112,"_5":25371,"_17489":100173,"_23720":100174,"_2383":100175},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2856":59118,"_25059":59112,"_5":25371,"_17489":100177,"_23720":100178,"_2383":100179},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2856":59119,"_25059":59112,"_5":25371,"_17489":100181,"_23720":100182,"_2383":100183},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2856":59120,"_25059":59112,"_5":25371,"_17489":100185,"_23720":100186,"_2383":100124},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2856":59121,"_25059":59112,"_5":25371,"_17489":100188,"_23720":100189,"_2383":100190},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2856":59122,"_25059":59112,"_5":25371,"_17489":100192,"_23720":100193,"_2383":100194},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2856":59123,"_25059":59112,"_17489":100196,"_5":17384,"_23720":59112,"_2383":100197},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2856":59124,"_25059":59112,"_17489":100199,"_5":17384,"_23720":59112,"_2383":100200},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2856":59125,"_25059":59112,"_17489":100202,"_5":17384,"_23720":100163,"_2383":100203},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2856":59126,"_25059":59112,"_17489":100205,"_5":17384,"_23720":100163,"_2383":100206},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2856":59127,"_25059":59112,"_17489":100208,"_5":17384,"_23720":100163,"_2383":100209},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2856":59128,"_25059":59112,"_17489":100211,"_5":17384,"_23720":100163,"_2383":100212},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2856":59129,"_25059":59112,"_17489":100214,"_5":17384,"_23720":100166,"_2383":100215},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2856":59130,"_25059":59112,"_17489":100217,"_5":17384,"_23720":100166,"_2383":100218},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2856":59131,"_25059":59112,"_17489":100220,"_5":17384,"_23720":100166,"_2383":100221},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2856":59132,"_25059":59112,"_17489":100223,"_5":17384,"_23720":100166,"_2383":100224},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2856":59133,"_25059":59112,"_17489":100226,"_5":17384,"_23720":100166,"_2383":100227},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2856":59134,"_25059":59112,"_17489":100229,"_5":17384,"_23720":100166,"_2383":100230},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2856":59135,"_25059":59112,"_17489":100232,"_5":17384,"_23720":100166,"_2383":100233},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2856":59136,"_25059":59112,"_17489":100235,"_5":17384,"_23720":100166,"_2383":100236},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2856":59137,"_25059":59112,"_17489":100238,"_5":17384,"_23720":100170,"_2383":100239},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2856":59138,"_25059":59112,"_17489":100241,"_5":17384,"_23720":100170,"_2383":45466},[],{"_2856":59139,"_25059":59112,"_17489":100243,"_5":17384,"_23720":100170,"_2383":100244},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2856":59140,"_25059":59112,"_17489":100246,"_5":17384,"_23720":100170,"_2383":100247},[],"**Icon** y **Tags**: clasificación opcional.",{"_2856":59141,"_25059":59112,"_17489":100249,"_5":17384,"_23720":100170,"_2383":100250},[],"Confirma el registro.",{"_2856":59142,"_25059":59112,"_17489":100252,"_5":17384,"_23720":100174,"_2383":100253},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2856":59143,"_25059":59112,"_17489":100255,"_5":17384,"_23720":100174,"_2383":100256},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2856":59144,"_25059":59112,"_17489":100258,"_5":17384,"_23720":100178,"_2383":100259},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2856":59145,"_25059":59112,"_17489":100261,"_5":17384,"_23720":100178,"_2383":100262},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2856":59146,"_25059":59112,"_17489":100264,"_5":17384,"_23720":100182,"_2383":100265},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2856":59147,"_25059":59112,"_17489":100267,"_5":17384,"_23720":100182,"_2383":100268},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2856":59148,"_25059":59112,"_17489":100270,"_5":17384,"_23720":100186,"_2383":100121},[],{"_2856":59149,"_25059":59112,"_17489":100272,"_5":17384,"_23720":100186,"_2383":100273},[],"Resultado",{"_2856":59150,"_25059":59112,"_17489":100275,"_5":17384,"_23720":100186,"_2383":100276},[],"Dispositivo",{"_2856":59151,"_25059":59112,"_17489":100278,"_5":17384,"_23720":100186,"_2383":100279},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2856":59152,"_25059":59112,"_17489":100281,"_5":17384,"_23720":100186,"_2383":100282},[],"Identidad actual",{"_2856":59153,"_25059":59112,"_17489":100284,"_5":17384,"_23720":100186,"_2383":100285},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2856":59154,"_25059":59112,"_17489":100287,"_5":17384,"_23720":100186,"_2383":100288},[],"Historial",{"_2856":59155,"_25059":59112,"_17489":100290,"_5":17384,"_23720":100186,"_2383":100291},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2856":59156,"_25059":59112,"_17489":100293,"_5":17384,"_23720":100186,"_2383":100294},[],"Clave y certificado",{"_2856":59157,"_25059":59112,"_17489":100296,"_5":17384,"_23720":100186,"_2383":100297},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2856":59158,"_25059":59112,"_17489":100299,"_5":17384,"_23720":100189,"_2383":100300},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2856":59159,"_25059":59112,"_17489":100302,"_5":17384,"_23720":100189,"_2383":100303},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2856":59160,"_25059":59112,"_17489":100305,"_5":17384,"_23720":100189,"_2383":100306},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2856":59161,"_25059":59112,"_17489":100308,"_5":17384,"_23720":100189,"_2383":100309},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2856":59162,"_25059":59112,"_17489":100311,"_5":17384,"_23720":100193,"_2383":100312},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2856":59163,"_25059":59112,"_17489":100314,"_5":17384,"_23720":100193,"_2383":100315},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2856":59164,"_25059":59112,"_17489":100317,"_5":17384,"_23720":100193,"_2383":100318},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2856":59165,"_25059":59165,"_5":12268,"_2383":100320,"_25374":100321,"_17489":100322,"_23720":59165},"Plataforma Lamassu IoT",[40699,96919],[],{"_2856":59166,"_25059":59165,"_17489":100324,"_5":17384,"_23720":59165,"_2383":100325},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2856":59167,"_25059":59165,"_5":25371,"_17489":100327,"_23720":100328,"_2383":99818},[],"/docs/es/platform/overview#empieza-aquí",{"_2856":59168,"_25059":59165,"_5":25371,"_17489":100330,"_23720":100331,"_2383":100332},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2856":59169,"_25059":59165,"_5":25371,"_17489":100334,"_23720":100335,"_2383":100336},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2856":59170,"_25059":59165,"_5":25371,"_17489":100338,"_23720":100339,"_2383":100340},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_2856":59171,"_25059":59165,"_5":25371,"_17489":100342,"_23720":100343,"_2383":100344},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2856":59172,"_25059":59165,"_5":25371,"_17489":100346,"_23720":100347,"_2383":100348},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2856":59173,"_25059":59165,"_5":25371,"_17489":100350,"_23720":100351,"_2383":100352},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2856":59174,"_25059":59165,"_5":25371,"_17489":100354,"_23720":100355,"_2383":100356},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2856":59175,"_25059":59165,"_5":25371,"_17489":100358,"_23720":100359,"_2383":100360},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2856":59176,"_25059":59165,"_5":25371,"_17489":100362,"_23720":100363,"_2383":100364},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2856":59177,"_25059":59165,"_5":25371,"_17489":100366,"_23720":100367,"_2383":100368},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_2856":59178,"_25059":59165,"_17489":100370,"_5":17384,"_23720":59165,"_2383":100371},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2856":59179,"_25059":59165,"_17489":100373,"_5":17384,"_23720":100328,"_2383":100374},[],"Elige el resultado que necesitas obtener:",{"_2856":59180,"_25059":59165,"_17489":100376,"_5":17384,"_23720":100328,"_2383":100377},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":59181,"_25059":59165,"_17489":100379,"_5":17384,"_23720":100328,"_2383":100380},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":59182,"_25059":59165,"_17489":100382,"_5":17384,"_23720":100328,"_2383":100383},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2856":59183,"_25059":59165,"_17489":100385,"_5":17384,"_23720":100331,"_2383":100386},[],"Bloque",{"_2856":59184,"_25059":59165,"_17489":100388,"_5":17384,"_23720":100331,"_2383":100389},[],"Qué gestionas",{"_2856":59185,"_25059":59165,"_17489":100391,"_5":17384,"_23720":100331,"_2383":100392},[],"Punto de entrada",{"_2856":59186,"_25059":59165,"_17489":100394,"_5":17384,"_23720":100331,"_2383":45620},[],{"_2856":59187,"_25059":59165,"_17489":100396,"_5":17384,"_23720":100331,"_2383":100397},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2856":59188,"_25059":59165,"_17489":100399,"_5":17384,"_23720":100331,"_2383":100400},[],"Visión general de PKI",{"_2856":59189,"_25059":59165,"_17489":100402,"_5":17384,"_23720":100331,"_2383":45629},[],{"_2856":59190,"_25059":59165,"_17489":100404,"_5":17384,"_23720":100331,"_2383":100405},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2856":59191,"_25059":59165,"_17489":100407,"_5":17384,"_23720":100331,"_2383":100408},[],"Visión general de IoT Fleets",{"_2856":59192,"_25059":59165,"_17489":100410,"_5":17384,"_23720":100331,"_2383":100411},[],"**Administración**",{"_2856":59193,"_25059":59165,"_17489":100413,"_5":17384,"_23720":100331,"_2383":100414},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2856":59194,"_25059":59165,"_17489":100416,"_5":17384,"_23720":100331,"_2383":96917},[],{"_2856":59195,"_25059":59165,"_17489":100418,"_5":17384,"_23720":100331,"_2383":100419},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2856":59196,"_25059":59165,"_17489":100421,"_5":17384,"_23720":100335,"_2383":100422},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2856":59197,"_25059":59165,"_17489":100424,"_5":17384,"_23720":100335,"_2383":100425},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2856":59198,"_25059":59165,"_17489":100427,"_5":17384,"_23720":100335,"_2383":100428},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2856":59199,"_25059":59165,"_17489":100430,"_5":17384,"_23720":100335,"_2383":100431},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2856":59200,"_25059":59165,"_17489":100433,"_5":17384,"_23720":100335,"_2383":100434},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2856":59201,"_25059":59165,"_17489":100436,"_5":17384,"_23720":100335,"_2383":100437},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2856":59202,"_25059":59165,"_17489":100439,"_5":17384,"_23720":100343,"_2383":100440},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2856":59203,"_25059":59165,"_17489":100442,"_5":17384,"_23720":100347,"_2383":100443},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2856":59204,"_25059":59165,"_17489":100445,"_5":17384,"_23720":100351,"_2383":100446},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2856":59205,"_25059":59165,"_17489":100448,"_5":17384,"_23720":100355,"_2383":100449},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2856":59206,"_25059":59165,"_17489":100451,"_5":17384,"_23720":100359,"_2383":100452},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2856":59207,"_25059":59165,"_17489":100454,"_5":17384,"_23720":100363,"_2383":100455},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2856":59208,"_25059":59165,"_17489":100457,"_5":17384,"_23720":100367,"_2383":99911},[],{"_2856":59209,"_25059":59165,"_17489":100459,"_5":17384,"_23720":100367,"_2383":100460},[],"Qué prepara o comprueba",{"_2856":59210,"_25059":59165,"_17489":100462,"_5":17384,"_23720":100367,"_2383":99914},[],{"_2856":59211,"_25059":59165,"_17489":100464,"_5":17384,"_23720":100367,"_2383":100465},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2856":59212,"_25059":59165,"_17489":100467,"_5":17384,"_23720":100367,"_2383":100468},[],"Administrador de la flota",{"_2856":59213,"_25059":59165,"_17489":100470,"_5":17384,"_23720":100367,"_2383":100471},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2856":59214,"_25059":59165,"_17489":100473,"_5":17384,"_23720":100367,"_2383":99926},[],{"_2856":59215,"_25059":59165,"_17489":100475,"_5":17384,"_23720":100367,"_2383":100476},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2856":59216,"_25059":59165,"_17489":100478,"_5":17384,"_23720":100367,"_2383":99932},[],{"_2856":59217,"_25059":59165,"_17489":100480,"_5":17384,"_23720":100367,"_2383":100481},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2856":59218,"_25059":59165,"_17489":100483,"_5":17384,"_23720":100367,"_2383":100484},[],"Operador de infraestructura",{"_2856":59219,"_25059":59165,"_17489":100486,"_5":17384,"_23720":100367,"_2383":100487},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2856":59220,"_25059":59165,"_17489":100489,"_5":17384,"_23720":100367,"_2383":100490},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2856":59221,"_25059":59221,"_5":12268,"_2383":100492,"_25374":100493,"_17489":100495,"_23720":59221},"Jerarquía y rotación de CAs",[40699,96919,45721,100494],"Claves, autoridades y certificados",[],{"_2856":59222,"_25059":59221,"_17489":100497,"_5":17384,"_23720":59221,"_2383":100498},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2856":59223,"_25059":59221,"_5":25371,"_17489":100500,"_23720":100501,"_2383":100502},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2856":59224,"_25059":59221,"_5":25371,"_17489":100504,"_23720":100505,"_2383":100506},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2856":59225,"_25059":59221,"_5":25371,"_17489":100508,"_23720":100509,"_2383":100510},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2856":59226,"_25059":59221,"_5":25371,"_17489":100512,"_23720":100513,"_2383":100514},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2856":59227,"_25059":59221,"_5":25371,"_17489":100516,"_23720":100517,"_2383":100518},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2856":59228,"_25059":59221,"_5":25371,"_17489":100520,"_23720":100521,"_2383":100522},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2856":59229,"_25059":59221,"_5":25371,"_17489":100524,"_23720":100525,"_2383":100526},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2856":59230,"_25059":59221,"_5":25371,"_17489":100528,"_23720":100529,"_2383":100530},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2856":59231,"_25059":59221,"_5":25371,"_17489":100532,"_23720":100533,"_2383":100534},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2856":59232,"_25059":59221,"_5":25371,"_17489":100536,"_23720":100537,"_2383":100538},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2856":59233,"_25059":59221,"_5":25371,"_17489":100540,"_23720":100541,"_2383":100542},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2856":59234,"_25059":59221,"_5":25371,"_17489":100544,"_23720":100545,"_2383":100546},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2856":59235,"_25059":59221,"_17489":100548,"_5":17384,"_23720":59221,"_2383":100549},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2856":59236,"_25059":59221,"_17489":100551,"_5":17384,"_23720":59221,"_2383":100552},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2856":59237,"_25059":59221,"_17489":100554,"_5":17384,"_23720":100501,"_2383":100555},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2856":59238,"_25059":59221,"_17489":100557,"_5":17384,"_23720":100501,"_2383":100558},[],"entorno, como producción y preproducción;",{"_2856":59239,"_25059":59221,"_17489":100560,"_5":17384,"_23720":100501,"_2383":100561},[],"propietario o equipo operador;",{"_2856":59240,"_25059":59221,"_17489":100563,"_5":17384,"_23720":100501,"_2383":100564},[],"familia de dispositivos o proceso de fabricación;",{"_2856":59241,"_25059":59221,"_17489":100566,"_5":17384,"_23720":100501,"_2383":100567},[],"región o requisito regulatorio;",{"_2856":59242,"_25059":59221,"_17489":100569,"_5":17384,"_23720":100501,"_2383":100570},[],"motor criptográfico o política de clave;",{"_2856":59243,"_25059":59221,"_17489":100572,"_5":17384,"_23720":100501,"_2383":100573},[],"ventana de mantenimiento y ritmo de renovación.",{"_2856":59244,"_25059":59221,"_17489":100575,"_5":17384,"_23720":100501,"_2383":100576},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2856":59245,"_25059":59221,"_17489":100578,"_5":17384,"_23720":100501,"_2383":100579},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2856":59246,"_25059":59221,"_17489":100581,"_5":17384,"_23720":100505,"_2383":100582},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2856":59247,"_25059":59221,"_17489":100584,"_5":17384,"_23720":100505,"_2383":100585},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2856":59248,"_25059":59221,"_17489":100587,"_5":17384,"_23720":100505,"_2383":100588},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2856":59249,"_25059":59221,"_17489":100590,"_5":17384,"_23720":100509,"_2383":100591},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2856":59250,"_25059":59221,"_17489":100593,"_5":17384,"_23720":100509,"_2383":100594},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2856":59251,"_25059":59221,"_17489":100596,"_5":17384,"_23720":100509,"_2383":100597},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2856":59252,"_25059":59221,"_17489":100599,"_5":17384,"_23720":100509,"_2383":100600},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2856":59253,"_25059":59221,"_17489":100602,"_5":17384,"_23720":100517,"_2383":100603},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2856":59254,"_25059":59221,"_17489":100605,"_5":17384,"_23720":100521,"_2383":100606},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2856":59255,"_25059":59221,"_17489":100608,"_5":17384,"_23720":100525,"_2383":100609},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2856":59256,"_25059":59221,"_17489":100611,"_5":17384,"_23720":100529,"_2383":100612},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2856":59257,"_25059":59221,"_17489":100614,"_5":17384,"_23720":100533,"_2383":100615},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2856":59258,"_25059":59221,"_17489":100617,"_5":17384,"_23720":100537,"_2383":100618},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2856":59259,"_25059":59221,"_17489":100620,"_5":17384,"_23720":100541,"_2383":100621},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2856":59260,"_25059":59221,"_17489":100623,"_5":17384,"_23720":100541,"_2383":100624},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2856":59261,"_25059":59221,"_17489":100626,"_5":17384,"_23720":100541,"_2383":100627},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2856":59262,"_25059":59221,"_17489":100629,"_5":17384,"_23720":100541,"_2383":100630},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2856":59263,"_25059":59221,"_17489":100632,"_5":17384,"_23720":100545,"_2383":100633},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2856":59264,"_25059":59221,"_17489":100635,"_5":17384,"_23720":100545,"_2383":100636},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2856":59265,"_25059":59221,"_17489":100638,"_5":17384,"_23720":100545,"_2383":100639},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2856":59266,"_25059":59221,"_17489":100641,"_5":17384,"_23720":100545,"_2383":100642},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2856":59267,"_25059":59221,"_17489":100644,"_5":17384,"_23720":100545,"_2383":100645},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2856":59268,"_25059":59221,"_17489":100647,"_5":17384,"_23720":100545,"_2383":100648},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2856":59269,"_25059":59221,"_17489":100650,"_5":17384,"_23720":100545,"_2383":100651},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2856":59270,"_25059":59270,"_5":12268,"_2383":100653,"_25374":100654,"_17489":100655,"_23720":59270},"Autoridades de certificación",[40699,96919,45721,100494],[],{"_2856":59271,"_25059":59270,"_17489":100657,"_5":17384,"_23720":59270,"_2383":100658},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2856":59272,"_25059":59270,"_5":25371,"_17489":100660,"_23720":100661,"_2383":100662},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2856":59273,"_25059":59270,"_5":25371,"_17489":100664,"_23720":100665,"_2383":100666},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2856":59274,"_25059":59270,"_5":25371,"_17489":100668,"_23720":100669,"_2383":95620},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2856":59275,"_25059":59270,"_5":25371,"_17489":100671,"_23720":100672,"_2383":100673},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2856":59276,"_25059":59270,"_5":25371,"_17489":100675,"_23720":100676,"_2383":100677},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2856":59277,"_25059":59270,"_5":25371,"_17489":100679,"_23720":100680,"_2383":100681},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2856":59278,"_25059":59270,"_5":25371,"_17489":100683,"_23720":100684,"_2383":100685},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2856":59279,"_25059":59270,"_5":25371,"_17489":100687,"_23720":100688,"_2383":100689},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2856":59280,"_25059":59270,"_5":25371,"_17489":100691,"_23720":100692,"_2383":100693},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2856":59281,"_25059":59270,"_5":25371,"_17489":100695,"_23720":100696,"_2383":100697},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2856":59282,"_25059":59270,"_5":25371,"_17489":100699,"_23720":100700,"_2383":100701},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2856":59283,"_25059":59270,"_5":25371,"_17489":100703,"_23720":100704,"_2383":100705},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2856":59284,"_25059":59270,"_5":25371,"_17489":100707,"_23720":100708,"_2383":100709},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2856":59285,"_25059":59270,"_5":25371,"_17489":100711,"_23720":100712,"_2383":100713},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2856":59286,"_25059":59270,"_5":25371,"_17489":100715,"_23720":100716,"_2383":100717},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2856":59287,"_25059":59270,"_5":25371,"_17489":100719,"_23720":100720,"_2383":100721},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2856":59288,"_25059":59270,"_5":25371,"_17489":100723,"_23720":100724,"_2383":100725},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2856":59289,"_25059":59270,"_5":25371,"_17489":100727,"_23720":100728,"_2383":100729},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2856":59290,"_25059":59270,"_5":25371,"_17489":100731,"_23720":100732,"_2383":100733},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2856":59291,"_25059":59270,"_5":25371,"_17489":100735,"_23720":100736,"_2383":100737},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2856":59292,"_25059":59270,"_5":25371,"_17489":100739,"_23720":100740,"_2383":100741},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2856":59293,"_25059":59270,"_5":25371,"_17489":100743,"_23720":100744,"_2383":100745},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2856":59294,"_25059":59270,"_17489":100747,"_5":17384,"_23720":59270,"_2383":100748},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2856":59295,"_25059":59270,"_17489":100750,"_5":17384,"_23720":59270,"_2383":100751},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2856":59296,"_25059":59270,"_17489":100753,"_5":17384,"_23720":59270,"_2383":100754},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2856":59297,"_25059":59270,"_17489":100756,"_5":17384,"_23720":100661,"_2383":100757},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2856":59298,"_25059":59270,"_17489":100759,"_5":17384,"_23720":100661,"_2383":100760},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2856":59299,"_25059":59270,"_17489":100762,"_5":17384,"_23720":100661,"_2383":100763},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2856":59300,"_25059":59270,"_17489":100765,"_5":17384,"_23720":100661,"_2383":100766},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2856":59301,"_25059":59270,"_17489":100768,"_5":17384,"_23720":100661,"_2383":100769},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2856":59302,"_25059":59270,"_17489":100771,"_5":17384,"_23720":100669,"_2383":100772},[],"Decide si la CA será raíz o intermedia.",{"_2856":59303,"_25059":59270,"_17489":100774,"_5":17384,"_23720":100669,"_2383":100775},[],"Elige el motor que custodiará la clave.",{"_2856":59304,"_25059":59270,"_17489":100777,"_5":17384,"_23720":100669,"_2383":100778},[],"Define una validez superior a la de los certificados que emitirá.",{"_2856":59305,"_25059":59270,"_17489":100780,"_5":17384,"_23720":100669,"_2383":100781},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2856":59306,"_25059":59270,"_17489":100783,"_5":17384,"_23720":100672,"_2383":100784},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2856":59307,"_25059":59270,"_17489":100786,"_5":17384,"_23720":100676,"_2383":100787},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2856":59308,"_25059":59270,"_17489":100789,"_5":17384,"_23720":100676,"_2383":100790},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2856":59309,"_25059":59270,"_17489":100792,"_5":17384,"_23720":100680,"_2383":100793},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2856":59310,"_25059":59270,"_17489":100795,"_5":17384,"_23720":100684,"_2383":100796},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2856":59311,"_25059":59270,"_17489":100798,"_5":17384,"_23720":100684,"_2383":100799},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2856":59312,"_25059":59270,"_17489":100801,"_5":17384,"_23720":100684,"_2383":100802},[],"`ST`: estado o provincia.",{"_2856":59313,"_25059":59270,"_17489":100804,"_5":17384,"_23720":100684,"_2383":100805},[],"`L`: localidad.",{"_2856":59314,"_25059":59270,"_17489":100807,"_5":17384,"_23720":100684,"_2383":100808},[],"`O`: organización.",{"_2856":59315,"_25059":59270,"_17489":100810,"_5":17384,"_23720":100684,"_2383":100811},[],"`OU`: unidad organizativa.",{"_2856":59316,"_25059":59270,"_17489":100813,"_5":17384,"_23720":100684,"_2383":100814},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2856":59317,"_25059":59270,"_17489":100816,"_5":17384,"_23720":100688,"_2383":100817},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2856":59318,"_25059":59270,"_17489":100819,"_5":17384,"_23720":100688,"_2383":100820},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2856":59319,"_25059":59270,"_17489":100822,"_5":17384,"_23720":100692,"_2383":100823},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2856":59320,"_25059":59270,"_17489":100825,"_5":17384,"_23720":100692,"_2383":100826},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2856":59321,"_25059":59270,"_17489":100828,"_5":17384,"_23720":100696,"_2383":100829},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2856":59322,"_25059":59270,"_17489":100831,"_5":17384,"_23720":100696,"_2383":100832},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2856":59323,"_25059":59270,"_17489":100834,"_5":17384,"_23720":100700,"_2383":100835},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2856":59324,"_25059":59270,"_17489":100837,"_5":17384,"_23720":100704,"_2383":100838},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2856":59325,"_25059":59270,"_17489":100840,"_5":17384,"_23720":100708,"_2383":100841},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2856":59326,"_25059":59270,"_17489":100843,"_5":17384,"_23720":100712,"_2383":100844},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2856":59327,"_25059":59270,"_17489":100846,"_5":17384,"_23720":100716,"_2383":100847},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2856":59328,"_25059":59270,"_17489":100849,"_5":17384,"_23720":100716,"_2383":100850},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2856":59329,"_25059":59270,"_17489":100852,"_5":17384,"_23720":100720,"_2383":100853},[],"Abre una CA desde el inventario para consultar:",{"_2856":59330,"_25059":59270,"_17489":100855,"_5":17384,"_23720":100720,"_2383":100856},[],"Estado y periodo de validez.",{"_2856":59331,"_25059":59270,"_17489":100858,"_5":17384,"_23720":100720,"_2383":100859},[],"Certificado y cadena en formato PEM.",{"_2856":59332,"_25059":59270,"_17489":100861,"_5":17384,"_23720":100720,"_2383":100862},[],"Número de certificados activos, expirados y revocados.",{"_2856":59333,"_25059":59270,"_17489":100864,"_5":17384,"_23720":100720,"_2383":100865},[],"Certificados emitidos en **Issued Certificates**.",{"_2856":59334,"_25059":59270,"_17489":100867,"_5":17384,"_23720":100720,"_2383":100868},[],"CRL vinculada a la autoridad.",{"_2856":59335,"_25059":59270,"_17489":100870,"_5":17384,"_23720":100720,"_2383":100871},[],"Metadatos y motor criptográfico asociado.",{"_2856":59336,"_25059":59270,"_17489":100873,"_5":17384,"_23720":100720,"_2383":100874},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2856":59337,"_25059":59270,"_17489":100876,"_5":17384,"_23720":100724,"_2383":100877},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2856":59338,"_25059":59270,"_17489":100879,"_5":17384,"_23720":100724,"_2383":100880},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2856":59339,"_25059":59270,"_17489":100882,"_5":17384,"_23720":100724,"_2383":100883},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2856":59340,"_25059":59270,"_17489":100885,"_5":17384,"_23720":100724,"_2383":100886},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2856":59341,"_25059":59270,"_17489":100888,"_5":17384,"_23720":100728,"_2383":100889},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2856":59342,"_25059":59270,"_17489":100891,"_5":17384,"_23720":100732,"_2383":100892},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2856":59343,"_25059":59270,"_17489":100894,"_5":17384,"_23720":100736,"_2383":100895},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2856":59344,"_25059":59270,"_17489":100897,"_5":17384,"_23720":100740,"_2383":100898},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2856":59345,"_25059":59270,"_17489":100900,"_5":17384,"_23720":100744,"_2383":100901},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2856":59346,"_25059":59270,"_17489":100903,"_5":17384,"_23720":100744,"_2383":100904},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2856":59347,"_25059":59347,"_5":12268,"_2383":100906,"_25374":100907,"_17489":100908,"_23720":59347},"Perfiles de certificado",[40699,96919,45721,100494],[],{"_2856":59348,"_25059":59347,"_17489":100910,"_5":17384,"_23720":59347,"_2383":100911},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2856":59349,"_25059":59347,"_5":25371,"_17489":100913,"_23720":100914,"_2383":100915},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2856":59350,"_25059":59347,"_5":25371,"_17489":100917,"_23720":100918,"_2383":100919},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_2856":59351,"_25059":59347,"_5":25371,"_17489":100921,"_23720":100922,"_2383":100923},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2856":59352,"_25059":59347,"_5":25371,"_17489":100925,"_23720":100926,"_2383":100927},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2856":59353,"_25059":59347,"_5":25371,"_17489":100929,"_23720":100930,"_2383":100931},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2856":59354,"_25059":59347,"_5":25371,"_17489":100933,"_23720":100934,"_2383":100935},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2856":59355,"_25059":59347,"_5":25371,"_17489":100937,"_23720":100938,"_2383":100939},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2856":59356,"_25059":59347,"_5":25371,"_17489":100941,"_23720":100942,"_2383":100943},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2856":59357,"_25059":59347,"_5":25371,"_17489":100945,"_23720":100946,"_2383":100947},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2856":59358,"_25059":59347,"_5":25371,"_17489":100949,"_23720":100950,"_2383":100951},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2856":59359,"_25059":59347,"_5":25371,"_17489":100953,"_23720":100954,"_2383":100955},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2856":59360,"_25059":59347,"_5":25371,"_17489":100957,"_23720":100958,"_2383":100959},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2856":59361,"_25059":59347,"_5":25371,"_17489":100961,"_23720":100962,"_2383":100963},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2856":59362,"_25059":59347,"_5":25371,"_17489":100965,"_23720":100966,"_2383":100967},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2856":59363,"_25059":59347,"_5":25371,"_17489":100969,"_23720":100970,"_2383":100971},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2856":59364,"_25059":59347,"_5":25371,"_17489":100973,"_23720":100974,"_2383":100975},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2856":59365,"_25059":59347,"_17489":100977,"_5":17384,"_23720":59347,"_2383":100978},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2856":59366,"_25059":59347,"_17489":100980,"_5":17384,"_23720":59347,"_2383":100981},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2856":59367,"_25059":59347,"_17489":100983,"_5":17384,"_23720":100918,"_2383":100984},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2856":59368,"_25059":59347,"_17489":100986,"_5":17384,"_23720":100918,"_2383":100987},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2856":59369,"_25059":59347,"_17489":100989,"_5":17384,"_23720":100922,"_2383":100990},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2856":59370,"_25059":59347,"_17489":100992,"_5":17384,"_23720":100926,"_2383":100993},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2856":59371,"_25059":59347,"_17489":100995,"_5":17384,"_23720":100926,"_2383":100996},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2856":59372,"_25059":59347,"_17489":100998,"_5":17384,"_23720":100926,"_2383":100999},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2856":59373,"_25059":59347,"_17489":101001,"_5":17384,"_23720":100930,"_2383":101002},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2856":59374,"_25059":59347,"_17489":101004,"_5":17384,"_23720":100934,"_2383":101005},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2856":59375,"_25059":59347,"_17489":101007,"_5":17384,"_23720":100934,"_2383":101008},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2856":59376,"_25059":59347,"_17489":101010,"_5":17384,"_23720":100938,"_2383":101011},[],"La aplicación criptográfica puede:",{"_2856":59377,"_25059":59347,"_17489":101013,"_5":17384,"_23720":100938,"_2383":101014},[],"permitir o bloquear claves RSA;",{"_2856":59378,"_25059":59347,"_17489":101016,"_5":17384,"_23720":100938,"_2383":101017},[],"limitar los tamaños RSA admitidos;",{"_2856":59379,"_25059":59347,"_17489":101019,"_5":17384,"_23720":100938,"_2383":101020},[],"permitir o bloquear claves ECDSA;",{"_2856":59380,"_25059":59347,"_17489":101022,"_5":17384,"_23720":100938,"_2383":101023},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2856":59381,"_25059":59347,"_17489":101025,"_5":17384,"_23720":100938,"_2383":101026},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2856":59382,"_25059":59347,"_17489":101028,"_5":17384,"_23720":100942,"_2383":101029},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2856":59383,"_25059":59347,"_17489":101031,"_5":17384,"_23720":100942,"_2383":96710},[],{"_2856":59384,"_25059":59347,"_17489":101033,"_5":17384,"_23720":100942,"_2383":101034},[],"Primera opción",{"_2856":59385,"_25059":59347,"_17489":101036,"_5":17384,"_23720":100942,"_2383":101037},[],"Segunda opción",{"_2856":59386,"_25059":59347,"_17489":101039,"_5":17384,"_23720":100942,"_2383":101040},[],"Si no hay ninguna",{"_2856":59387,"_25059":59347,"_17489":101042,"_5":17384,"_23720":100942,"_2383":101043},[],"Firma directa con una CA",{"_2856":59388,"_25059":59347,"_17489":101045,"_5":17384,"_23720":100942,"_2383":101046},[],"`issuance_profile` incluido en la solicitud",{"_2856":59389,"_25059":59347,"_17489":101048,"_5":17384,"_23720":100942,"_2383":101049},[],"`issuance_profile_id` de la solicitud",{"_2856":59390,"_25059":59347,"_17489":101051,"_5":17384,"_23720":100942,"_2383":101052},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2856":59391,"_25059":59347,"_17489":101054,"_5":17384,"_23720":100942,"_2383":101055},[],"Emisión mediante DMS",{"_2856":59392,"_25059":59347,"_17489":101057,"_5":17384,"_23720":100942,"_2383":46286},[],{"_2856":59393,"_25059":59347,"_17489":101059,"_5":17384,"_23720":100942,"_2383":101060},[],"`settings.issuance_profile` incluido en el DMS",{"_2856":59394,"_25059":59347,"_17489":101062,"_5":17384,"_23720":100942,"_2383":101063},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2856":59395,"_25059":59347,"_17489":101065,"_5":17384,"_23720":100942,"_2383":101066},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2856":59396,"_25059":59347,"_17489":101068,"_5":17384,"_23720":100942,"_2383":101069},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2856":59397,"_25059":59347,"_17489":101071,"_5":17384,"_23720":100950,"_2383":101072},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2856":59398,"_25059":59347,"_17489":101074,"_5":17384,"_23720":100954,"_2383":101075},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2856":59399,"_25059":59347,"_17489":101077,"_5":17384,"_23720":100958,"_2383":101078},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2856":59400,"_25059":59347,"_17489":101080,"_5":17384,"_23720":100962,"_2383":101081},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2856":59401,"_25059":59347,"_17489":101083,"_5":17384,"_23720":100966,"_2383":101084},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2856":59402,"_25059":59347,"_17489":101086,"_5":17384,"_23720":100966,"_2383":101087},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2856":59403,"_25059":59347,"_17489":101089,"_5":17384,"_23720":100970,"_2383":101090},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2856":59404,"_25059":59347,"_17489":101092,"_5":17384,"_23720":100970,"_2383":101093},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2856":59405,"_25059":59347,"_17489":101095,"_5":17384,"_23720":100970,"_2383":101096},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2856":59406,"_25059":59347,"_17489":101098,"_5":17384,"_23720":100970,"_2383":101099},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2856":59407,"_25059":59347,"_17489":101101,"_5":17384,"_23720":100974,"_2383":101102},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2856":59408,"_25059":59347,"_17489":101104,"_5":17384,"_23720":100974,"_2383":101105},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2856":59409,"_25059":59409,"_5":12268,"_2383":101107,"_25374":101108,"_17489":101110,"_23720":59409},"Validación de certificados",[40699,96919,45721,101109],"Validación",[],{"_2856":59410,"_25059":59409,"_17489":101112,"_5":17384,"_23720":59409,"_2383":101113},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2856":59411,"_25059":59409,"_5":25371,"_17489":101115,"_23720":101116,"_2383":101117},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2856":59412,"_25059":59409,"_5":25371,"_17489":101119,"_23720":101120,"_2383":101121},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2856":59413,"_25059":59409,"_5":25371,"_17489":101123,"_23720":101124,"_2383":101125},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2856":59414,"_25059":59409,"_17489":101127,"_5":17384,"_23720":59409,"_2383":101128},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2856":59415,"_25059":59409,"_17489":101130,"_5":17384,"_23720":101116,"_2383":101131},[],"Verifica estos criterios juntos:",{"_2856":59416,"_25059":59409,"_17489":101133,"_5":17384,"_23720":101116,"_2383":100121},[],{"_2856":59417,"_25059":59409,"_17489":101135,"_5":17384,"_23720":101116,"_2383":101136},[],"Resultado necesario",{"_2856":59418,"_25059":59409,"_17489":101138,"_5":17384,"_23720":101116,"_2383":101139},[],"Cadena y firma",{"_2856":59419,"_25059":59409,"_17489":101141,"_5":17384,"_23720":101116,"_2383":101142},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2856":59420,"_25059":59409,"_17489":101144,"_5":17384,"_23720":101116,"_2383":101145},[],"Fechas",{"_2856":59421,"_25059":59409,"_17489":101147,"_5":17384,"_23720":101116,"_2383":101148},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2856":59422,"_25059":59409,"_17489":101150,"_5":17384,"_23720":101116,"_2383":96623},[],{"_2856":59423,"_25059":59409,"_17489":101152,"_5":17384,"_23720":101116,"_2383":101153},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2856":59424,"_25059":59409,"_17489":101155,"_5":17384,"_23720":101116,"_2383":101156},[],"Uso",{"_2856":59425,"_25059":59409,"_17489":101158,"_5":17384,"_23720":101116,"_2383":101159},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2856":59426,"_25059":59409,"_17489":101161,"_5":17384,"_23720":101116,"_2383":101162},[],"Revocación",{"_2856":59427,"_25059":59409,"_17489":101164,"_5":17384,"_23720":101116,"_2383":101165},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2856":59428,"_25059":59409,"_17489":101167,"_5":17384,"_23720":101116,"_2383":101168},[],"Autorización",{"_2856":59429,"_25059":59409,"_17489":101170,"_5":17384,"_23720":101116,"_2383":101171},[],"La aplicación permite la acción a esa identidad.",{"_2856":59430,"_25059":59409,"_17489":101173,"_5":17384,"_23720":101116,"_2383":101174},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2856":59431,"_25059":59409,"_17489":101176,"_5":17384,"_23720":101120,"_2383":101177},[],"Mecanismo",{"_2856":59432,"_25059":59409,"_17489":101179,"_5":17384,"_23720":101120,"_2383":101180},[],"Cuándo utilizarlo",{"_2856":59433,"_25059":59409,"_17489":101182,"_5":17384,"_23720":101120,"_2383":101183},[],"Qué debes mantener",{"_2856":59434,"_25059":59409,"_17489":101185,"_5":17384,"_23720":101120,"_2383":46414},[],{"_2856":59435,"_25059":59409,"_17489":101187,"_5":17384,"_23720":101120,"_2383":101188},[],"Consulta del estado de un certificado concreto.",{"_2856":59436,"_25059":59409,"_17489":101190,"_5":17384,"_23720":101120,"_2383":101191},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2856":59437,"_25059":59409,"_17489":101193,"_5":17384,"_23720":101120,"_2383":46423},[],{"_2856":59438,"_25059":59409,"_17489":101195,"_5":17384,"_23720":101120,"_2383":101196},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2856":59439,"_25059":59409,"_17489":101198,"_5":17384,"_23720":101120,"_2383":101199},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2856":59440,"_25059":59409,"_17489":101201,"_5":17384,"_23720":101120,"_2383":101202},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2856":59441,"_25059":59409,"_17489":101204,"_5":17384,"_23720":101120,"_2383":101205},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2856":59442,"_25059":59409,"_17489":101207,"_5":17384,"_23720":101124,"_2383":101208},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2856":59443,"_25059":59409,"_17489":101210,"_5":17384,"_23720":101124,"_2383":101211},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2856":59444,"_25059":59409,"_17489":101213,"_5":17384,"_23720":101124,"_2383":101214},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2856":59445,"_25059":59409,"_17489":101216,"_5":17384,"_23720":101124,"_2383":101217},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2856":59446,"_25059":59409,"_17489":101219,"_5":17384,"_23720":101124,"_2383":101220},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2856":59447,"_25059":59409,"_17489":101222,"_5":17384,"_23720":101124,"_2383":101223},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2856":59448,"_25059":59409,"_17489":101225,"_5":17384,"_23720":101124,"_2383":101226},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2856":59449,"_25059":59409,"_17489":101228,"_5":17384,"_23720":101124,"_2383":101229},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59450,"_25059":59409,"_17489":101231,"_5":17384,"_23720":101124,"_2383":101232},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2856":59451,"_25059":59451,"_5":12268,"_2383":101234,"_25374":101235,"_17489":101236,"_23720":59451},"Certificados",[40699,96919,45721,100494],[],{"_2856":59452,"_25059":59451,"_17489":101238,"_5":17384,"_23720":59451,"_2383":101239},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2856":59453,"_25059":59451,"_5":25371,"_17489":101241,"_23720":101242,"_2383":101243},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2856":59454,"_25059":59451,"_5":25371,"_17489":101245,"_23720":101246,"_2383":101247},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2856":59455,"_25059":59451,"_5":25371,"_17489":101249,"_23720":101250,"_2383":101251},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2856":59456,"_25059":59451,"_5":25371,"_17489":101253,"_23720":101254,"_2383":101255},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2856":59457,"_25059":59451,"_5":25371,"_17489":101257,"_23720":101258,"_2383":101259},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2856":59458,"_25059":59451,"_5":25371,"_17489":101261,"_23720":101262,"_2383":101263},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2856":59459,"_25059":59451,"_5":25371,"_17489":101265,"_23720":101266,"_2383":101267},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2856":59460,"_25059":59451,"_5":25371,"_17489":101269,"_23720":101270,"_2383":101271},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2856":59461,"_25059":59451,"_5":25371,"_17489":101273,"_23720":101274,"_2383":101275},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_2856":59462,"_25059":59451,"_17489":101277,"_5":17384,"_23720":59451,"_2383":101278},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2856":59463,"_25059":59451,"_17489":101280,"_5":17384,"_23720":101242,"_2383":101281},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2856":59464,"_25059":59451,"_17489":101283,"_5":17384,"_23720":101242,"_2383":101284},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2856":59465,"_25059":59451,"_17489":101286,"_5":17384,"_23720":101246,"_2383":101287},[],"Descarga el PEM e inspecciónalo:",{"_2856":59466,"_25059":59451,"_17489":101289,"_5":17384,"_23720":101246,"_2383":101290},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2856":59467,"_25059":59451,"_17489":101292,"_5":17384,"_23720":101250,"_2383":101293},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2856":59468,"_25059":59451,"_17489":101295,"_5":17384,"_23720":101250,"_2383":101296},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2856":59469,"_25059":59451,"_17489":101298,"_5":17384,"_23720":101250,"_2383":101299},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2856":59470,"_25059":59451,"_17489":101301,"_5":17384,"_23720":101250,"_2383":101302},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2856":59471,"_25059":59451,"_17489":101304,"_5":17384,"_23720":101250,"_2383":101305},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2856":59472,"_25059":59451,"_17489":101307,"_5":17384,"_23720":101250,"_2383":101308},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2856":59473,"_25059":59451,"_17489":101310,"_5":17384,"_23720":101250,"_2383":101311},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2856":59474,"_25059":59451,"_17489":101313,"_5":17384,"_23720":101254,"_2383":101314},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2856":59475,"_25059":59451,"_17489":101316,"_5":17384,"_23720":101258,"_2383":101317},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2856":59476,"_25059":59451,"_17489":101319,"_5":17384,"_23720":101262,"_2383":101320},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2856":59477,"_25059":59451,"_17489":101322,"_5":17384,"_23720":101266,"_2383":101323},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2856":59478,"_25059":59451,"_17489":101325,"_5":17384,"_23720":101266,"_2383":101326},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2856":59479,"_25059":59451,"_17489":101328,"_5":17384,"_23720":101266,"_2383":101329},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2856":59480,"_25059":59451,"_17489":101331,"_5":17384,"_23720":101270,"_2383":101332},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2856":59481,"_25059":59451,"_17489":101334,"_5":17384,"_23720":101270,"_2383":101335},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2856":59482,"_25059":59451,"_17489":101337,"_5":17384,"_23720":101270,"_2383":101338},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2856":59483,"_25059":59451,"_17489":101340,"_5":17384,"_23720":101274,"_2383":101341},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59484,"_25059":59451,"_17489":101343,"_5":17384,"_23720":101274,"_2383":101344},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2856":59485,"_25059":59485,"_5":12268,"_2383":101346,"_25374":101347,"_17489":101349,"_23720":59485},"Ciclo de vida de un certificado",[40699,96919,45721,101348],"Conceptos",[],{"_2856":59486,"_25059":59485,"_17489":101351,"_5":17384,"_23720":59485,"_2383":101352},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2856":59487,"_25059":59485,"_5":25371,"_17489":101354,"_23720":101355,"_2383":101356},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2856":59488,"_25059":59485,"_5":25371,"_17489":101358,"_23720":101359,"_2383":101360},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2856":59489,"_25059":59485,"_5":25371,"_17489":101362,"_23720":101363,"_2383":101364},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2856":59490,"_25059":59485,"_5":25371,"_17489":101366,"_23720":101367,"_2383":101368},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2856":59491,"_25059":59485,"_5":25371,"_17489":101370,"_23720":101371,"_2383":101372},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2856":59492,"_25059":59485,"_5":25371,"_17489":101374,"_23720":101375,"_2383":101376},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2856":59493,"_25059":59485,"_5":25371,"_17489":101378,"_23720":101379,"_2383":101380},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2856":59494,"_25059":59485,"_5":25371,"_17489":101382,"_23720":101383,"_2383":101384},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2856":59495,"_25059":59485,"_5":25371,"_17489":101386,"_23720":101387,"_2383":101388},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2856":59496,"_25059":59485,"_5":25371,"_17489":101390,"_23720":101391,"_2383":101392},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2856":59497,"_25059":59485,"_17489":101394,"_5":17384,"_23720":59485,"_2383":101395},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2856":59498,"_25059":59485,"_17489":101397,"_5":17384,"_23720":101359,"_2383":101398},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2856":59499,"_25059":59485,"_17489":101400,"_5":17384,"_23720":101363,"_2383":101401},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2856":59500,"_25059":59485,"_17489":101403,"_5":17384,"_23720":101367,"_2383":101404},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2856":59501,"_25059":59485,"_17489":101406,"_5":17384,"_23720":101371,"_2383":101407},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2856":59502,"_25059":59485,"_17489":101409,"_5":17384,"_23720":101375,"_2383":101410},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2856":59503,"_25059":59485,"_17489":101412,"_5":17384,"_23720":101379,"_2383":101413},[],"Lamassu persiste cuatro estados X.509:",{"_2856":59504,"_25059":59485,"_17489":101415,"_5":17384,"_23720":101379,"_2383":101416},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2856":59505,"_25059":59485,"_17489":101418,"_5":17384,"_23720":101379,"_2383":101419},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2856":59506,"_25059":59485,"_17489":101421,"_5":17384,"_23720":101379,"_2383":101422},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2856":59507,"_25059":59485,"_17489":101424,"_5":17384,"_23720":101379,"_2383":101425},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2856":59508,"_25059":59485,"_17489":101427,"_5":17384,"_23720":101379,"_2383":101428},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2856":59509,"_25059":59485,"_17489":101430,"_5":17384,"_23720":101383,"_2383":101431},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2856":59510,"_25059":59485,"_17489":101433,"_5":17384,"_23720":101383,"_2383":101434},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2856":59511,"_25059":59485,"_17489":101436,"_5":17384,"_23720":101383,"_2383":101437},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2856":59512,"_25059":59485,"_17489":101439,"_5":17384,"_23720":101387,"_2383":101440},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2856":59513,"_25059":59485,"_17489":101442,"_5":17384,"_23720":101387,"_2383":101443},[],"Antes de confirmar:",{"_2856":59514,"_25059":59485,"_17489":101445,"_5":17384,"_23720":101387,"_2383":101446},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2856":59515,"_25059":59485,"_17489":101448,"_5":17384,"_23720":101387,"_2383":101449},[],"Distribuye la nueva cadena de confianza.",{"_2856":59516,"_25059":59485,"_17489":101451,"_5":17384,"_23720":101387,"_2383":101452},[],"Reemite las identidades necesarias.",{"_2856":59517,"_25059":59485,"_17489":101454,"_5":17384,"_23720":101387,"_2383":101455},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2856":59518,"_25059":59485,"_17489":101457,"_5":17384,"_23720":101387,"_2383":101458},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2856":59519,"_25059":59485,"_17489":101460,"_5":17384,"_23720":101387,"_2383":101461},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2856":59520,"_25059":59485,"_17489":101463,"_5":17384,"_23720":101391,"_2383":101464},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2856":59521,"_25059":59485,"_17489":101466,"_5":17384,"_23720":101391,"_2383":101467},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2856":59522,"_25059":59485,"_17489":101469,"_5":17384,"_23720":101391,"_2383":101470},[],"Cambios de estado y razones de revocación.",{"_2856":59523,"_25059":59485,"_17489":101472,"_5":17384,"_23720":101391,"_2383":101473},[],"Publicación y vigencia de OCSP y CRLs.",{"_2856":59524,"_25059":59485,"_17489":101475,"_5":17384,"_23720":101391,"_2383":101476},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2856":59525,"_25059":59485,"_17489":101478,"_5":17384,"_23720":101391,"_2383":101479},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2856":59526,"_25059":59526,"_5":12268,"_2383":101481,"_25374":101482,"_17489":101483,"_23720":59526},"Modelo de confianza",[40699,96919,45721,101348],[],{"_2856":59527,"_25059":59526,"_17489":101485,"_5":17384,"_23720":59526,"_2383":101486},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2856":59528,"_25059":59526,"_5":25371,"_17489":101488,"_23720":101489,"_2383":101490},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2856":59529,"_25059":59526,"_5":25371,"_17489":101492,"_23720":101493,"_2383":101494},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2856":59530,"_25059":59526,"_5":25371,"_17489":101496,"_23720":101497,"_2383":101498},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2856":59531,"_25059":59526,"_5":25371,"_17489":101500,"_23720":101501,"_2383":101502},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2856":59532,"_25059":59526,"_5":25371,"_17489":101504,"_23720":101505,"_2383":101506},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2856":59533,"_25059":59526,"_5":25371,"_17489":101508,"_23720":101509,"_2383":101510},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2856":59534,"_25059":59526,"_5":25371,"_17489":101512,"_23720":101513,"_2383":101514},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2856":59535,"_25059":59526,"_5":25371,"_17489":101516,"_23720":101517,"_2383":101518},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2856":59536,"_25059":59526,"_5":25371,"_17489":101520,"_23720":101521,"_2383":101522},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2856":59537,"_25059":59526,"_5":25371,"_17489":101524,"_23720":101525,"_2383":101526},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2856":59538,"_25059":59526,"_17489":101528,"_5":17384,"_23720":59526,"_2383":101529},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2856":59539,"_25059":59526,"_17489":101531,"_5":17384,"_23720":101493,"_2383":101532},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2856":59540,"_25059":59526,"_17489":101534,"_5":17384,"_23720":101497,"_2383":101535},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2856":59541,"_25059":59526,"_17489":101537,"_5":17384,"_23720":101501,"_2383":101538},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2856":59542,"_25059":59526,"_17489":101540,"_5":17384,"_23720":101505,"_2383":101541},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2856":59543,"_25059":59526,"_17489":101543,"_5":17384,"_23720":101509,"_2383":101544},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2856":59544,"_25059":59526,"_17489":101546,"_5":17384,"_23720":101509,"_2383":101547},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2856":59545,"_25059":59526,"_17489":101549,"_5":17384,"_23720":101509,"_2383":101550},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2856":59546,"_25059":59526,"_17489":101552,"_5":17384,"_23720":101509,"_2383":101553},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2856":59547,"_25059":59526,"_17489":101555,"_5":17384,"_23720":101509,"_2383":101556},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2856":59548,"_25059":59526,"_17489":101558,"_5":17384,"_23720":101509,"_2383":101559},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2856":59549,"_25059":59526,"_17489":101561,"_5":17384,"_23720":101513,"_2383":101562},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2856":59550,"_25059":59526,"_17489":101564,"_5":17384,"_23720":101513,"_2383":101565},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2856":59551,"_25059":59526,"_17489":101567,"_5":17384,"_23720":101513,"_2383":101568},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2856":59552,"_25059":59526,"_17489":101570,"_5":17384,"_23720":101513,"_2383":101571},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2856":59553,"_25059":59526,"_17489":101573,"_5":17384,"_23720":101513,"_2383":101574},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2856":59554,"_25059":59526,"_17489":101576,"_5":17384,"_23720":101517,"_2383":101577},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2856":59555,"_25059":59526,"_17489":101579,"_5":17384,"_23720":101517,"_2383":101580},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2856":59556,"_25059":59526,"_17489":101582,"_5":17384,"_23720":101517,"_2383":101583},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2856":59557,"_25059":59526,"_17489":101585,"_5":17384,"_23720":101517,"_2383":101586},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2856":59558,"_25059":59526,"_17489":101588,"_5":17384,"_23720":101517,"_2383":101589},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2856":59559,"_25059":59526,"_17489":101591,"_5":17384,"_23720":101517,"_2383":101592},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2856":59560,"_25059":59526,"_17489":101594,"_5":17384,"_23720":101517,"_2383":101595},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2856":59561,"_25059":59526,"_17489":101597,"_5":17384,"_23720":101521,"_2383":101598},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2856":59562,"_25059":59526,"_17489":101600,"_5":17384,"_23720":101525,"_2383":101601},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2856":59563,"_25059":59526,"_17489":101603,"_5":17384,"_23720":101525,"_2383":101604},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2856":59564,"_25059":59526,"_17489":101606,"_5":17384,"_23720":101525,"_2383":101607},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2856":59565,"_25059":59526,"_17489":101609,"_5":17384,"_23720":101525,"_2383":101610},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2856":59566,"_25059":59526,"_17489":101612,"_5":17384,"_23720":101525,"_2383":101613},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2856":59567,"_25059":59526,"_17489":101615,"_5":17384,"_23720":101525,"_2383":101616},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2856":59568,"_25059":59526,"_17489":101618,"_5":17384,"_23720":101525,"_2383":101619},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2856":59569,"_25059":59569,"_5":12268,"_2383":101621,"_25374":101622,"_17489":101623,"_23720":59569},"Listas de revocación (CRL)",[40699,96919,45721,101109],[],{"_2856":59570,"_25059":59569,"_17489":101625,"_5":17384,"_23720":59569,"_2383":101626},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2856":59571,"_25059":59569,"_5":25371,"_17489":101628,"_23720":101629,"_2383":101630},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2856":59572,"_25059":59569,"_5":25371,"_17489":101632,"_23720":101633,"_2383":101634},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2856":59573,"_25059":59569,"_5":25371,"_17489":101636,"_23720":101637,"_2383":101638},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2856":59574,"_25059":59569,"_5":25371,"_17489":101640,"_23720":101641,"_2383":101642},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2856":59575,"_25059":59569,"_5":25371,"_17489":101644,"_23720":101645,"_2383":101646},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2856":59576,"_25059":59569,"_5":25371,"_17489":101648,"_23720":101649,"_2383":101650},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2856":59577,"_25059":59569,"_5":25371,"_17489":101652,"_23720":101653,"_2383":101654},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_2856":59578,"_25059":59569,"_17489":101656,"_5":17384,"_23720":59569,"_2383":101657},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2856":59579,"_25059":59569,"_17489":101659,"_5":17384,"_23720":101629,"_2383":101660},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2856":59580,"_25059":59569,"_17489":101662,"_5":17384,"_23720":101629,"_2383":101663},[],"Campo de `crl_options`",{"_2856":59581,"_25059":59569,"_17489":101665,"_5":17384,"_23720":101629,"_2383":98412},[],{"_2856":59582,"_25059":59569,"_17489":101667,"_5":17384,"_23720":101629,"_2383":101668},[],"Valor inicial del backend",{"_2856":59583,"_25059":59569,"_17489":101670,"_5":17384,"_23720":101629,"_2383":46901},[],{"_2856":59584,"_25059":59569,"_17489":101672,"_5":17384,"_23720":101629,"_2383":101673},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2856":59585,"_25059":59569,"_17489":101675,"_5":17384,"_23720":101629,"_2383":101676},[],"7 días.",{"_2856":59586,"_25059":59569,"_17489":101678,"_5":17384,"_23720":101629,"_2383":46910},[],{"_2856":59587,"_25059":59569,"_17489":101680,"_5":17384,"_23720":101629,"_2383":101681},[],"Plazo desde la publicación que activa la renovación programada.",{"_2856":59588,"_25059":59569,"_17489":101683,"_5":17384,"_23720":101629,"_2383":101684},[],"6 días y 23 horas.",{"_2856":59589,"_25059":59569,"_17489":101686,"_5":17384,"_23720":101629,"_2383":46919},[],{"_2856":59590,"_25059":59569,"_17489":101688,"_5":17384,"_23720":101629,"_2383":101689},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2856":59591,"_25059":59569,"_17489":101691,"_5":17384,"_23720":101629,"_2383":46925},[],{"_2856":59592,"_25059":59569,"_17489":101693,"_5":17384,"_23720":101629,"_2383":46928},[],{"_2856":59593,"_25059":59569,"_17489":101695,"_5":17384,"_23720":101629,"_2383":101696},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2856":59594,"_25059":59569,"_17489":101698,"_5":17384,"_23720":101629,"_2383":101699},[],"SKI de la CA.",{"_2856":59595,"_25059":59569,"_17489":101701,"_5":17384,"_23720":101629,"_2383":101702},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2856":59596,"_25059":59569,"_17489":101704,"_5":17384,"_23720":101629,"_2383":101705},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2856":59597,"_25059":59569,"_17489":101707,"_5":17384,"_23720":101633,"_2383":101708},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2856":59598,"_25059":59569,"_17489":101710,"_5":17384,"_23720":101633,"_2383":101711},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2856":59599,"_25059":59569,"_17489":101713,"_5":17384,"_23720":101633,"_2383":101714},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2856":59600,"_25059":59569,"_17489":101716,"_5":17384,"_23720":101637,"_2383":101717},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2856":59601,"_25059":59569,"_17489":101719,"_5":17384,"_23720":101637,"_2383":101720},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2856":59602,"_25059":59569,"_17489":101722,"_5":17384,"_23720":101641,"_2383":101723},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2856":59603,"_25059":59569,"_17489":101725,"_5":17384,"_23720":101641,"_2383":101726},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2856":59604,"_25059":59569,"_17489":101728,"_5":17384,"_23720":101641,"_2383":101729},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2856":59605,"_25059":59569,"_17489":101731,"_5":17384,"_23720":101641,"_2383":101732},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2856":59606,"_25059":59569,"_17489":101734,"_5":17384,"_23720":101641,"_2383":101735},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2856":59607,"_25059":59569,"_17489":101737,"_5":17384,"_23720":101645,"_2383":101738},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2856":59608,"_25059":59569,"_17489":101740,"_5":17384,"_23720":101645,"_2383":98601},[],{"_2856":59609,"_25059":59569,"_17489":101742,"_5":17384,"_23720":101645,"_2383":101743},[],"Path relativo",{"_2856":59610,"_25059":59569,"_17489":101745,"_5":17384,"_23720":101645,"_2383":96710},[],{"_2856":59611,"_25059":59569,"_17489":101747,"_5":17384,"_23720":101645,"_2383":46983},[],{"_2856":59612,"_25059":59569,"_17489":101749,"_5":17384,"_23720":101645,"_2383":46986},[],{"_2856":59613,"_25059":59569,"_17489":101751,"_5":17384,"_23720":101645,"_2383":101752},[],"Consultar `crl_options` y `latest_crl`.",{"_2856":59614,"_25059":59569,"_17489":101754,"_5":17384,"_23720":101645,"_2383":46992},[],{"_2856":59615,"_25059":59569,"_17489":101756,"_5":17384,"_23720":101645,"_2383":46986},[],{"_2856":59616,"_25059":59569,"_17489":101758,"_5":17384,"_23720":101645,"_2383":101759},[],"Sustituir la configuración de CRL.",{"_2856":59617,"_25059":59569,"_17489":101761,"_5":17384,"_23720":101645,"_2383":101762},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2856":59618,"_25059":59569,"_17489":101764,"_5":17384,"_23720":101645,"_2383":101765},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2856":59619,"_25059":59569,"_17489":101767,"_5":17384,"_23720":101649,"_2383":101768},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2856":59620,"_25059":59569,"_17489":101770,"_5":17384,"_23720":101653,"_2383":101771},[],"RFC 5280: perfil X.509 y CRL.",{"_2856":59621,"_25059":59569,"_17489":101773,"_5":17384,"_23720":101653,"_2383":47012},[],{"_2856":59622,"_25059":59569,"_17489":101775,"_5":17384,"_23720":101653,"_2383":47015},[],{"_2856":59623,"_25059":59569,"_17489":101777,"_5":17384,"_23720":101653,"_2383":101778},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59624,"_25059":59569,"_17489":101780,"_5":17384,"_23720":101653,"_2383":101781},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2856":59625,"_25059":59625,"_5":12268,"_2383":101783,"_25374":101784,"_17489":101785,"_23720":59625},"Claves y motores criptográficos",[40699,96919,45721,100494],[],{"_2856":59626,"_25059":59625,"_17489":101787,"_5":17384,"_23720":59625,"_2383":101788},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2856":59627,"_25059":59625,"_5":25371,"_17489":101790,"_23720":101791,"_2383":101792},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2856":59628,"_25059":59625,"_5":25371,"_17489":101794,"_23720":101795,"_2383":101796},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2856":59629,"_25059":59625,"_5":25371,"_17489":101798,"_23720":101799,"_2383":47040},[],"/docs/es/platform/pki/key-management#file-system",{"_2856":59630,"_25059":59625,"_5":25371,"_17489":101801,"_23720":101802,"_2383":47044},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_2856":59631,"_25059":59625,"_5":25371,"_17489":101804,"_23720":101805,"_2383":47048},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_2856":59632,"_25059":59625,"_5":25371,"_17489":101807,"_23720":101808,"_2383":47052},[],"/docs/es/platform/pki/key-management#aws-kms",{"_2856":59633,"_25059":59625,"_5":25371,"_17489":101810,"_23720":101811,"_2383":47056},[],"/docs/es/platform/pki/key-management#pkcs11",{"_2856":59634,"_25059":59625,"_5":25371,"_17489":101813,"_23720":101814,"_2383":47060},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_2856":59635,"_25059":59625,"_5":25371,"_17489":101816,"_23720":101817,"_2383":101818},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2856":59636,"_25059":59625,"_5":25371,"_17489":101820,"_23720":101821,"_2383":101822},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2856":59637,"_25059":59625,"_5":25371,"_17489":101824,"_23720":101825,"_2383":101826},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2856":59638,"_25059":59625,"_5":25371,"_17489":101828,"_23720":101829,"_2383":101830},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2856":59639,"_25059":59625,"_5":25371,"_17489":101832,"_23720":101833,"_2383":101834},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2856":59640,"_25059":59625,"_5":25371,"_17489":101836,"_23720":101837,"_2383":101838},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2856":59641,"_25059":59625,"_5":25371,"_17489":101840,"_23720":101841,"_2383":101842},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2856":59642,"_25059":59625,"_5":25371,"_17489":101844,"_23720":101845,"_2383":47092},[],"/docs/es/platform/pki/key-management#sign",{"_2856":59643,"_25059":59625,"_5":25371,"_17489":101847,"_23720":101848,"_2383":47096},[],"/docs/es/platform/pki/key-management#verify",{"_2856":59644,"_25059":59625,"_5":25371,"_17489":101850,"_23720":101851,"_2383":101852},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2856":59645,"_25059":59625,"_5":25371,"_17489":101854,"_23720":101855,"_2383":101856},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2856":59646,"_25059":59625,"_5":25371,"_17489":101858,"_23720":101859,"_2383":101860},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2856":59647,"_25059":59625,"_17489":101862,"_5":17384,"_23720":59625,"_2383":101863},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2856":59648,"_25059":59625,"_17489":101865,"_5":17384,"_23720":59625,"_2383":101866},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2856":59649,"_25059":59625,"_17489":101868,"_5":17384,"_23720":101791,"_2383":101869},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2856":59650,"_25059":59625,"_17489":101871,"_5":17384,"_23720":101791,"_2383":101872},[],"En la práctica, permite:",{"_2856":59651,"_25059":59625,"_17489":101874,"_5":17384,"_23720":101791,"_2383":101875},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2856":59652,"_25059":59625,"_17489":101877,"_5":17384,"_23720":101791,"_2383":101878},[],"Importar claves creadas externamente.",{"_2856":59653,"_25059":59625,"_17489":101880,"_5":17384,"_23720":101791,"_2383":101881},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2856":59654,"_25059":59625,"_17489":101883,"_5":17384,"_23720":101791,"_2383":101884},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2856":59655,"_25059":59625,"_17489":101886,"_5":17384,"_23720":101795,"_2383":101887},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2856":59656,"_25059":59625,"_17489":101889,"_5":17384,"_23720":101795,"_2383":101890},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2856":59657,"_25059":59625,"_17489":101892,"_5":17384,"_23720":101795,"_2383":101893},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2856":59658,"_25059":59625,"_17489":101895,"_5":17384,"_23720":101799,"_2383":101896},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2856":59659,"_25059":59625,"_17489":101898,"_5":17384,"_23720":101802,"_2383":101899},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2856":59660,"_25059":59625,"_17489":101901,"_5":17384,"_23720":101805,"_2383":101902},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2856":59661,"_25059":59625,"_17489":101904,"_5":17384,"_23720":101808,"_2383":101905},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2856":59662,"_25059":59625,"_17489":101907,"_5":17384,"_23720":101811,"_2383":101908},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2856":59663,"_25059":59625,"_17489":101910,"_5":17384,"_23720":101814,"_2383":101911},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2856":59664,"_25059":59625,"_17489":101913,"_5":17384,"_23720":101814,"_2383":101914},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2856":59665,"_25059":59625,"_17489":101916,"_5":17384,"_23720":101814,"_2383":101917},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2856":59666,"_25059":59625,"_17489":101919,"_5":17384,"_23720":101814,"_2383":101920},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2856":59667,"_25059":59625,"_17489":101922,"_5":17384,"_23720":101817,"_2383":101923},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2856":59668,"_25059":59625,"_17489":101925,"_5":17384,"_23720":101817,"_2383":101926},[],"La tabla incluye los siguientes campos:",{"_2856":59669,"_25059":59625,"_17489":101928,"_5":17384,"_23720":101817,"_2383":101929},[],"**Name**: nombre descriptivo de la clave.",{"_2856":59670,"_25059":59625,"_17489":101931,"_5":17384,"_23720":101817,"_2383":101932},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2856":59671,"_25059":59625,"_17489":101934,"_5":17384,"_23720":101817,"_2383":101935},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2856":59672,"_25059":59625,"_17489":101937,"_5":17384,"_23720":101817,"_2383":101938},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2856":59673,"_25059":59625,"_17489":101940,"_5":17384,"_23720":101817,"_2383":101941},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2856":59674,"_25059":59625,"_17489":101943,"_5":17384,"_23720":101817,"_2383":101944},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2856":59675,"_25059":59625,"_17489":101946,"_5":17384,"_23720":101817,"_2383":101947},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2856":59676,"_25059":59625,"_17489":101949,"_5":17384,"_23720":101817,"_2383":101950},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2856":59677,"_25059":59625,"_17489":101952,"_5":17384,"_23720":101817,"_2383":101953},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2856":59678,"_25059":59625,"_17489":101955,"_5":17384,"_23720":101817,"_2383":101956},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2856":59679,"_25059":59625,"_17489":101958,"_5":17384,"_23720":101817,"_2383":101959},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2856":59680,"_25059":59625,"_17489":101961,"_5":17384,"_23720":101817,"_2383":101962},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2856":59681,"_25059":59625,"_17489":101964,"_5":17384,"_23720":101817,"_2383":101965},[],"**Delete Key** para eliminar la clave del sistema.",{"_2856":59682,"_25059":59625,"_17489":101967,"_5":17384,"_23720":101821,"_2383":101968},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2856":59683,"_25059":59625,"_17489":101970,"_5":17384,"_23720":101825,"_2383":101971},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2856":59684,"_25059":59625,"_17489":101973,"_5":17384,"_23720":101825,"_2383":101974},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2856":59685,"_25059":59625,"_17489":101976,"_5":17384,"_23720":101825,"_2383":101977},[],"**Key Name**: nombre único y descriptivo.",{"_2856":59686,"_25059":59625,"_17489":101979,"_5":17384,"_23720":101825,"_2383":101980},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2856":59687,"_25059":59625,"_17489":101982,"_5":17384,"_23720":101825,"_2383":101983},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2856":59688,"_25059":59625,"_17489":101985,"_5":17384,"_23720":101825,"_2383":101986},[],"**Tags**: metadatos para clasificar la clave.",{"_2856":59689,"_25059":59625,"_17489":101988,"_5":17384,"_23720":101825,"_2383":101989},[],"**Metadata**: información adicional para usos avanzados.",{"_2856":59690,"_25059":59625,"_17489":101991,"_5":17384,"_23720":101829,"_2383":101992},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2856":59691,"_25059":59625,"_17489":101994,"_5":17384,"_23720":101829,"_2383":101995},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2856":59692,"_25059":59625,"_17489":101997,"_5":17384,"_23720":101829,"_2383":101998},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2856":59693,"_25059":59625,"_17489":102000,"_5":17384,"_23720":101829,"_2383":102001},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2856":59694,"_25059":59625,"_17489":102003,"_5":17384,"_23720":101829,"_2383":102004},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2856":59695,"_25059":59625,"_17489":102006,"_5":17384,"_23720":101829,"_2383":102007},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2856":59696,"_25059":59625,"_17489":102009,"_5":17384,"_23720":101829,"_2383":102010},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2856":59697,"_25059":59625,"_17489":102012,"_5":17384,"_23720":101829,"_2383":102013},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2856":59698,"_25059":59625,"_17489":102015,"_5":17384,"_23720":101829,"_2383":102016},[],"**Metadata**: información adicional opcional.",{"_2856":59699,"_25059":59625,"_17489":102018,"_5":17384,"_23720":101829,"_2383":102019},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2856":59700,"_25059":59625,"_17489":102021,"_5":17384,"_23720":101829,"_2383":102022},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2856":59701,"_25059":59625,"_17489":102024,"_5":17384,"_23720":101833,"_2383":102025},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2856":59702,"_25059":59625,"_17489":102027,"_5":17384,"_23720":101837,"_2383":102028},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2856":59703,"_25059":59625,"_17489":102030,"_5":17384,"_23720":101837,"_2383":102031},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2856":59704,"_25059":59625,"_17489":102033,"_5":17384,"_23720":101837,"_2383":102034},[],"**Key Name**: nombre descriptivo.",{"_2856":59705,"_25059":59625,"_17489":102036,"_5":17384,"_23720":101837,"_2383":102037},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2856":59706,"_25059":59625,"_17489":102039,"_5":17384,"_23720":101837,"_2383":102040},[],"**Tags**: etiquetas asociadas.",{"_2856":59707,"_25059":59625,"_17489":102042,"_5":17384,"_23720":101837,"_2383":102043},[],"**Aliases**: nombres alternativos.",{"_2856":59708,"_25059":59625,"_17489":102045,"_5":17384,"_23720":101837,"_2383":102046},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2856":59709,"_25059":59625,"_17489":102048,"_5":17384,"_23720":101837,"_2383":102049},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2856":59710,"_25059":59625,"_17489":102051,"_5":17384,"_23720":101837,"_2383":102052},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2856":59711,"_25059":59625,"_17489":102054,"_5":17384,"_23720":101837,"_2383":102055},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2856":59712,"_25059":59625,"_17489":102057,"_5":17384,"_23720":101841,"_2383":102058},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2856":59713,"_25059":59625,"_17489":102060,"_5":17384,"_23720":101841,"_2383":102061},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2856":59714,"_25059":59625,"_17489":102063,"_5":17384,"_23720":101841,"_2383":102064},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2856":59715,"_25059":59625,"_17489":102066,"_5":17384,"_23720":101845,"_2383":102067},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2856":59716,"_25059":59625,"_17489":102069,"_5":17384,"_23720":101845,"_2383":102070},[],"Campos principales:",{"_2856":59717,"_25059":59625,"_17489":102072,"_5":17384,"_23720":101845,"_2383":102073},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2856":59718,"_25059":59625,"_17489":102075,"_5":17384,"_23720":101845,"_2383":102076},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2856":59719,"_25059":59625,"_17489":102078,"_5":17384,"_23720":101845,"_2383":102079},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2856":59720,"_25059":59625,"_17489":102081,"_5":17384,"_23720":101845,"_2383":102082},[],"**Message**: contenido que se va a firmar.",{"_2856":59721,"_25059":59625,"_17489":102084,"_5":17384,"_23720":101845,"_2383":102085},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2856":59722,"_25059":59625,"_17489":102087,"_5":17384,"_23720":101848,"_2383":102088},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2856":59723,"_25059":59625,"_17489":102090,"_5":17384,"_23720":101848,"_2383":102070},[],{"_2856":59724,"_25059":59625,"_17489":102092,"_5":17384,"_23720":101848,"_2383":102093},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2856":59725,"_25059":59625,"_17489":102095,"_5":17384,"_23720":101848,"_2383":102096},[],"**Message Type**: `Raw` o `Digest`.",{"_2856":59726,"_25059":59625,"_17489":102098,"_5":17384,"_23720":101848,"_2383":102099},[],"**Payload Encoding**: codificación del mensaje.",{"_2856":59727,"_25059":59625,"_17489":102101,"_5":17384,"_23720":101848,"_2383":102102},[],"**Message**: mensaje original o hash.",{"_2856":59728,"_25059":59625,"_17489":102104,"_5":17384,"_23720":101848,"_2383":102105},[],"**Signature**: firma que se desea comprobar.",{"_2856":59729,"_25059":59625,"_17489":102107,"_5":17384,"_23720":101848,"_2383":102108},[],"**Result**: indicador del resultado de la validación.",{"_2856":59730,"_25059":59625,"_17489":102110,"_5":17384,"_23720":101851,"_2383":102111},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2856":59731,"_25059":59625,"_17489":102113,"_5":17384,"_23720":101851,"_2383":102114},[],"Este flujo es útil para:",{"_2856":59732,"_25059":59625,"_17489":102116,"_5":17384,"_23720":101851,"_2383":102117},[],"Solicitar certificados a una CA externa.",{"_2856":59733,"_25059":59625,"_17489":102119,"_5":17384,"_23720":101851,"_2383":102120},[],"Renovar una identidad manteniendo la misma clave.",{"_2856":59734,"_25059":59625,"_17489":102122,"_5":17384,"_23720":101851,"_2383":102123},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2856":59735,"_25059":59625,"_17489":102125,"_5":17384,"_23720":101851,"_2383":102126},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2856":59736,"_25059":59625,"_17489":102128,"_5":17384,"_23720":101851,"_2383":102129},[],"**Organization (O)**: organización o empresa.",{"_2856":59737,"_25059":59625,"_17489":102131,"_5":17384,"_23720":101851,"_2383":102132},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2856":59738,"_25059":59625,"_17489":102134,"_5":17384,"_23720":101851,"_2383":102135},[],"**Country (C)**: código de país de dos letras.",{"_2856":59739,"_25059":59625,"_17489":102137,"_5":17384,"_23720":101851,"_2383":102138},[],"**State / Province (ST)**: estado o provincia.",{"_2856":59740,"_25059":59625,"_17489":102140,"_5":17384,"_23720":101851,"_2383":102141},[],"**Locality (L)**: ciudad o localidad.",{"_2856":59741,"_25059":59625,"_17489":102143,"_5":17384,"_23720":101851,"_2383":102144},[],"**Email Address**: correo de contacto.",{"_2856":59742,"_25059":59625,"_17489":102146,"_5":17384,"_23720":101851,"_2383":102147},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2856":59743,"_25059":59625,"_17489":102149,"_5":17384,"_23720":101851,"_2383":102150},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2856":59744,"_25059":59625,"_17489":102152,"_5":17384,"_23720":101855,"_2383":102153},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2856":59745,"_25059":59625,"_17489":102155,"_5":17384,"_23720":101855,"_2383":47404},[],{"_2856":59746,"_25059":59625,"_17489":102157,"_5":17384,"_23720":101859,"_2383":102158},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2856":59747,"_25059":59747,"_5":12268,"_2383":102160,"_25374":102161,"_17489":102162,"_23720":59747},"Validación online con OCSP",[40699,96919,45721,101109],[],{"_2856":59748,"_25059":59747,"_17489":102164,"_5":17384,"_23720":59747,"_2383":102165},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2856":59749,"_25059":59747,"_5":25371,"_17489":102167,"_23720":102168,"_2383":102169},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2856":59750,"_25059":59747,"_5":25371,"_17489":102171,"_23720":102172,"_2383":102173},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2856":59751,"_25059":59747,"_5":25371,"_17489":102175,"_23720":102176,"_2383":102177},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2856":59752,"_25059":59747,"_5":25371,"_17489":102179,"_23720":102180,"_2383":102181},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2856":59753,"_25059":59747,"_5":25371,"_17489":102183,"_23720":102184,"_2383":102185},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2856":59754,"_25059":59747,"_5":25371,"_17489":102187,"_23720":102188,"_2383":101654},[],"/docs/es/platform/pki/ocsp#referencias",{"_2856":59755,"_25059":59747,"_17489":102190,"_5":17384,"_23720":59747,"_2383":102191},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2856":59756,"_25059":59747,"_17489":102193,"_5":17384,"_23720":102168,"_2383":102194},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2856":59757,"_25059":59747,"_17489":102196,"_5":17384,"_23720":102168,"_2383":102197},[],"Estado del registro",{"_2856":59758,"_25059":59747,"_17489":102199,"_5":17384,"_23720":102168,"_2383":102200},[],"Respuesta firmada",{"_2856":59759,"_25059":59747,"_17489":102202,"_5":17384,"_23720":102168,"_2383":44899},[],{"_2856":59760,"_25059":59747,"_17489":102204,"_5":17384,"_23720":102168,"_2383":47454},[],{"_2856":59761,"_25059":59747,"_17489":102206,"_5":17384,"_23720":102168,"_2383":44916},[],{"_2856":59762,"_25059":59747,"_17489":102208,"_5":17384,"_23720":102168,"_2383":102209},[],"`Revoked`, con razón y fecha de revocación.",{"_2856":59763,"_25059":59747,"_17489":102211,"_5":17384,"_23720":102168,"_2383":102212},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2856":59764,"_25059":59747,"_17489":102214,"_5":17384,"_23720":102168,"_2383":102215},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2856":59765,"_25059":59747,"_17489":102217,"_5":17384,"_23720":102168,"_2383":102218},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2856":59766,"_25059":59747,"_17489":102220,"_5":17384,"_23720":102168,"_2383":102221},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2856":59767,"_25059":59747,"_17489":102223,"_5":17384,"_23720":102168,"_2383":102224},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2856":59768,"_25059":59747,"_17489":102226,"_5":17384,"_23720":102172,"_2383":102227},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2856":59769,"_25059":59747,"_17489":102229,"_5":17384,"_23720":102172,"_2383":102230},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2856":59770,"_25059":59747,"_17489":102232,"_5":17384,"_23720":102176,"_2383":102233},[],"El servicio acepta:",{"_2856":59771,"_25059":59747,"_17489":102235,"_5":17384,"_23720":102176,"_2383":98601},[],{"_2856":59772,"_25059":59747,"_17489":102237,"_5":17384,"_23720":102176,"_2383":102238},[],"Ruta del servicio VA",{"_2856":59773,"_25059":59747,"_17489":102240,"_5":17384,"_23720":102176,"_2383":102241},[],"Formato",{"_2856":59774,"_25059":59747,"_17489":102243,"_5":17384,"_23720":102176,"_2383":47494},[],{"_2856":59775,"_25059":59747,"_17489":102245,"_5":17384,"_23720":102176,"_2383":47497},[],{"_2856":59776,"_25059":59747,"_17489":102247,"_5":17384,"_23720":102176,"_2383":102248},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2856":59777,"_25059":59747,"_17489":102250,"_5":17384,"_23720":102176,"_2383":46983},[],{"_2856":59778,"_25059":59747,"_17489":102252,"_5":17384,"_23720":102176,"_2383":47505},[],{"_2856":59779,"_25059":59747,"_17489":102254,"_5":17384,"_23720":102176,"_2383":102255},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2856":59780,"_25059":59747,"_17489":102257,"_5":17384,"_23720":102176,"_2383":102258},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2856":59781,"_25059":59747,"_17489":102260,"_5":17384,"_23720":102180,"_2383":102261},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2856":59782,"_25059":59747,"_17489":102263,"_5":17384,"_23720":102180,"_2383":102264},[],"Genera la solicitud:",{"_2856":59783,"_25059":59747,"_17489":102266,"_5":17384,"_23720":102180,"_2383":102267},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2856":59784,"_25059":59747,"_17489":102269,"_5":17384,"_23720":102180,"_2383":102270},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2856":59785,"_25059":59747,"_17489":102272,"_5":17384,"_23720":102180,"_2383":102273},[],"Verifica el DER recibido:",{"_2856":59786,"_25059":59747,"_17489":102275,"_5":17384,"_23720":102180,"_2383":102276},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2856":59787,"_25059":59747,"_17489":102278,"_5":17384,"_23720":102184,"_2383":102279},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2856":59788,"_25059":59747,"_17489":102281,"_5":17384,"_23720":102184,"_2383":102282},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2856":59789,"_25059":59747,"_17489":102284,"_5":17384,"_23720":102188,"_2383":47538},[],{"_2856":59790,"_25059":59747,"_17489":102286,"_5":17384,"_23720":102188,"_2383":47541},[],{"_2856":59791,"_25059":59747,"_17489":102288,"_5":17384,"_23720":102188,"_2383":102289},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2856":59792,"_25059":59747,"_17489":102291,"_5":17384,"_23720":102188,"_2383":101781},[],{"_2856":59793,"_25059":59793,"_5":12268,"_2383":45721,"_25374":102293,"_17489":102294,"_23720":59793},[40699,96919,45721],[],{"_2856":59794,"_25059":59793,"_17489":102296,"_5":17384,"_23720":59793,"_2383":102297},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2856":59795,"_25059":59793,"_5":25371,"_17489":102299,"_23720":102300,"_2383":99818},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_2856":59796,"_25059":59793,"_5":25371,"_17489":102302,"_23720":102303,"_2383":102304},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2856":59797,"_25059":59793,"_5":25371,"_17489":102306,"_23720":102307,"_2383":100340},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_2856":59798,"_25059":59793,"_5":25371,"_17489":102309,"_23720":102310,"_2383":100344},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2856":59799,"_25059":59793,"_5":25371,"_17489":102312,"_23720":102313,"_2383":100348},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2856":59800,"_25059":59793,"_5":25371,"_17489":102315,"_23720":102316,"_2383":100352},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_2856":59801,"_25059":59793,"_5":25371,"_17489":102318,"_23720":102319,"_2383":100360},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_2856":59802,"_25059":59793,"_5":25371,"_17489":102321,"_23720":102322,"_2383":102323},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2856":59803,"_25059":59793,"_5":25371,"_17489":102325,"_23720":102326,"_2383":101275},[],"/docs/es/platform/pki/overview#continúa",{"_2856":59804,"_25059":59793,"_17489":102328,"_5":17384,"_23720":59793,"_2383":102329},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2856":59805,"_25059":59793,"_17489":102331,"_5":17384,"_23720":102300,"_2383":102332},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2856":59806,"_25059":59793,"_17489":102334,"_5":17384,"_23720":102300,"_2383":102335},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2856":59807,"_25059":59793,"_17489":102337,"_5":17384,"_23720":102303,"_2383":102338},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2856":59808,"_25059":59793,"_17489":102340,"_5":17384,"_23720":102303,"_2383":102341},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2856":59809,"_25059":59793,"_17489":102343,"_5":17384,"_23720":102303,"_2383":102344},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2856":59810,"_25059":59793,"_17489":102346,"_5":17384,"_23720":102303,"_2383":102347},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2856":59811,"_25059":59793,"_17489":102349,"_5":17384,"_23720":102303,"_2383":102350},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2856":59812,"_25059":59793,"_17489":102352,"_5":17384,"_23720":102310,"_2383":102353},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2856":59813,"_25059":59793,"_17489":102355,"_5":17384,"_23720":102313,"_2383":102356},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2856":59814,"_25059":59793,"_17489":102358,"_5":17384,"_23720":102316,"_2383":102359},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2856":59815,"_25059":59793,"_17489":102361,"_5":17384,"_23720":102319,"_2383":102362},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2856":59816,"_25059":59793,"_17489":102364,"_5":17384,"_23720":102322,"_2383":102365},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2856":59817,"_25059":59793,"_17489":102367,"_5":17384,"_23720":102322,"_2383":102368},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2856":59818,"_25059":59793,"_17489":102370,"_5":17384,"_23720":102322,"_2383":102371},[],"su clave pública corresponda a la clave privada del cliente;",{"_2856":59819,"_25059":59793,"_17489":102373,"_5":17384,"_23720":102322,"_2383":102374},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2856":59820,"_25059":59793,"_17489":102376,"_5":17384,"_23720":102322,"_2383":102377},[],"sus fechas y usos permitan la operación;",{"_2856":59821,"_25059":59793,"_17489":102379,"_5":17384,"_23720":102322,"_2383":102380},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2856":59822,"_25059":59793,"_17489":102382,"_5":17384,"_23720":102322,"_2383":102383},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2856":59823,"_25059":59793,"_17489":102385,"_5":17384,"_23720":102326,"_2383":102386},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":59824,"_25059":59793,"_17489":102388,"_5":17384,"_23720":102326,"_2383":102389},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2856":59825,"_25059":59793,"_17489":102391,"_5":17384,"_23720":102326,"_2383":102392},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2856":59826,"_25059":59826,"_5":12268,"_2383":102394,"_25374":102395,"_17489":102396,"_23720":59826},"Crea tu primera CA",[40699,96919,45721,99942],[],{"_2856":59827,"_25059":59826,"_17489":102398,"_5":17384,"_23720":59826,"_2383":102399},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2856":59828,"_25059":59826,"_5":25371,"_17489":102401,"_23720":102402,"_2383":95620},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2856":59829,"_25059":59826,"_5":25371,"_17489":102404,"_23720":102405,"_2383":102406},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2856":59830,"_25059":59826,"_5":25371,"_17489":102408,"_23720":102409,"_2383":102410},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2856":59831,"_25059":59826,"_5":25371,"_17489":102412,"_23720":102413,"_2383":102414},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2856":59832,"_25059":59826,"_5":25371,"_17489":102416,"_23720":102417,"_2383":102418},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2856":59833,"_25059":59826,"_5":25371,"_17489":102420,"_23720":102421,"_2383":102422},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2856":59834,"_25059":59826,"_5":25371,"_17489":102424,"_23720":102425,"_2383":102426},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2856":59835,"_25059":59826,"_5":25371,"_17489":102428,"_23720":102429,"_2383":100190},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2856":59836,"_25059":59826,"_5":25371,"_17489":102431,"_23720":102432,"_2383":95644},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2856":59837,"_25059":59826,"_17489":102434,"_5":17384,"_23720":59826,"_2383":102435},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2856":59838,"_25059":59826,"_17489":102437,"_5":17384,"_23720":102402,"_2383":102438},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2856":59839,"_25059":59826,"_17489":102440,"_5":17384,"_23720":102402,"_2383":102441},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2856":59840,"_25059":59826,"_17489":102443,"_5":17384,"_23720":102402,"_2383":102444},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2856":59841,"_25059":59826,"_17489":102446,"_5":17384,"_23720":102402,"_2383":102447},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2856":59842,"_25059":59826,"_17489":102449,"_5":17384,"_23720":102405,"_2383":102450},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2856":59843,"_25059":59826,"_17489":102452,"_5":17384,"_23720":102405,"_2383":102453},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2856":59844,"_25059":59826,"_17489":102455,"_5":17384,"_23720":102409,"_2383":102456},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2856":59845,"_25059":59826,"_17489":102458,"_5":17384,"_23720":102409,"_2383":102459},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2856":59846,"_25059":59826,"_17489":102461,"_5":17384,"_23720":102413,"_2383":102462},[],"Selecciona **Root CA** y completa:",{"_2856":59847,"_25059":59826,"_17489":102464,"_5":17384,"_23720":102413,"_2383":47720},[],{"_2856":59848,"_25059":59826,"_17489":102466,"_5":17384,"_23720":102413,"_2383":102467},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2856":59849,"_25059":59826,"_17489":102469,"_5":17384,"_23720":102413,"_2383":102470},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2856":59850,"_25059":59826,"_17489":102472,"_5":17384,"_23720":102413,"_2383":102473},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2856":59851,"_25059":59826,"_17489":102475,"_5":17384,"_23720":102413,"_2383":102476},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2856":59852,"_25059":59826,"_17489":102478,"_5":17384,"_23720":102417,"_2383":102479},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2856":59853,"_25059":59826,"_17489":102481,"_5":17384,"_23720":102421,"_2383":102482},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2856":59854,"_25059":59826,"_17489":102484,"_5":17384,"_23720":102421,"_2383":102485},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2856":59855,"_25059":59826,"_17489":102487,"_5":17384,"_23720":102425,"_2383":102488},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2856":59856,"_25059":59826,"_17489":102490,"_5":17384,"_23720":102425,"_2383":102491},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2856":59857,"_25059":59826,"_17489":102493,"_5":17384,"_23720":102425,"_2383":102494},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2856":59858,"_25059":59826,"_17489":102496,"_5":17384,"_23720":102429,"_2383":102497},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2856":59859,"_25059":59826,"_17489":102499,"_5":17384,"_23720":102429,"_2383":102500},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2856":59860,"_25059":59826,"_17489":102502,"_5":17384,"_23720":102429,"_2383":102503},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2856":59861,"_25059":59826,"_17489":102505,"_5":17384,"_23720":102429,"_2383":102506},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2856":59862,"_25059":59826,"_17489":102508,"_5":17384,"_23720":102432,"_2383":102509},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2856":59863,"_25059":59863,"_5":12268,"_2383":102511,"_25374":102512,"_17489":102513,"_23720":59863},"Emite y verifica un certificado",[40699,96919,45721,99942],[],{"_2856":59864,"_25059":59863,"_17489":102515,"_5":17384,"_23720":59863,"_2383":102516},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2856":59865,"_25059":59863,"_5":25371,"_17489":102518,"_23720":102519,"_2383":95620},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2856":59866,"_25059":59863,"_5":25371,"_17489":102521,"_23720":102522,"_2383":102523},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2856":59867,"_25059":59863,"_5":25371,"_17489":102525,"_23720":102526,"_2383":102527},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2856":59868,"_25059":59863,"_5":25371,"_17489":102529,"_23720":102530,"_2383":102531},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2856":59869,"_25059":59863,"_5":25371,"_17489":102533,"_23720":102534,"_2383":102535},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2856":59870,"_25059":59863,"_5":25371,"_17489":102537,"_23720":102538,"_2383":102539},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2856":59871,"_25059":59863,"_5":25371,"_17489":102541,"_23720":102542,"_2383":102422},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2856":59872,"_25059":59863,"_5":25371,"_17489":102544,"_23720":102545,"_2383":102546},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2856":59873,"_25059":59863,"_5":25371,"_17489":102548,"_23720":102549,"_2383":102550},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2856":59874,"_25059":59863,"_5":25371,"_17489":102552,"_23720":102553,"_2383":102554},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2856":59875,"_25059":59863,"_5":25371,"_17489":102556,"_23720":102557,"_2383":100190},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2856":59876,"_25059":59863,"_5":25371,"_17489":102559,"_23720":102560,"_2383":95644},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2856":59877,"_25059":59863,"_17489":102562,"_5":17384,"_23720":59863,"_2383":102563},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2856":59878,"_25059":59863,"_17489":102565,"_5":17384,"_23720":102519,"_2383":102566},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2856":59879,"_25059":59863,"_17489":102568,"_5":17384,"_23720":102519,"_2383":102569},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2856":59880,"_25059":59863,"_17489":102571,"_5":17384,"_23720":102519,"_2383":102572},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2856":59881,"_25059":59863,"_17489":102574,"_5":17384,"_23720":102519,"_2383":102575},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2856":59882,"_25059":59863,"_17489":102577,"_5":17384,"_23720":102519,"_2383":102578},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2856":59883,"_25059":59863,"_17489":102580,"_5":17384,"_23720":102522,"_2383":102581},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2856":59884,"_25059":59863,"_17489":102583,"_5":17384,"_23720":102526,"_2383":102584},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2856":59885,"_25059":59863,"_17489":102586,"_5":17384,"_23720":102526,"_2383":102587},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2856":59886,"_25059":59863,"_17489":102589,"_5":17384,"_23720":102530,"_2383":102590},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2856":59887,"_25059":59863,"_17489":102592,"_5":17384,"_23720":102530,"_2383":102593},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2856":59888,"_25059":59863,"_17489":102595,"_5":17384,"_23720":102534,"_2383":102596},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2856":59889,"_25059":59863,"_17489":102598,"_5":17384,"_23720":102534,"_2383":102599},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2856":59890,"_25059":59863,"_17489":102601,"_5":17384,"_23720":102538,"_2383":102602},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2856":59891,"_25059":59863,"_17489":102604,"_5":17384,"_23720":102542,"_2383":102605},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2856":59892,"_25059":59863,"_17489":102607,"_5":17384,"_23720":102545,"_2383":102608},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2856":59893,"_25059":59863,"_17489":102610,"_5":17384,"_23720":102549,"_2383":102611},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2856":59894,"_25059":59863,"_17489":102613,"_5":17384,"_23720":102549,"_2383":102614},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2856":59895,"_25059":59863,"_17489":102616,"_5":17384,"_23720":102549,"_2383":102617},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2856":59896,"_25059":59863,"_17489":102619,"_5":17384,"_23720":102553,"_2383":102620},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2856":59897,"_25059":59863,"_17489":102622,"_5":17384,"_23720":102553,"_2383":102623},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2856":59898,"_25059":59863,"_17489":102625,"_5":17384,"_23720":102553,"_2383":102626},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2856":59899,"_25059":59863,"_17489":102628,"_5":17384,"_23720":102557,"_2383":100273},[],{"_2856":59900,"_25059":59863,"_17489":102630,"_5":17384,"_23720":102557,"_2383":99050},[],{"_2856":59901,"_25059":59863,"_17489":102632,"_5":17384,"_23720":102557,"_2383":102633},[],"La CA rechaza la emisión",{"_2856":59902,"_25059":59863,"_17489":102635,"_5":17384,"_23720":102557,"_2383":102636},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2856":59903,"_25059":59863,"_17489":102638,"_5":17384,"_23720":102557,"_2383":102639},[],"Sujeto o usos diferentes",{"_2856":59904,"_25059":59863,"_17489":102641,"_5":17384,"_23720":102557,"_2383":102642},[],"Perfil aplicado y valores solicitados.",{"_2856":59905,"_25059":59863,"_17489":102644,"_5":17384,"_23720":102557,"_2383":102645},[],"No se encuentra el emisor",{"_2856":59906,"_25059":59863,"_17489":102647,"_5":17384,"_23720":102557,"_2383":102648},[],"CA descargada y cadena intermedia necesaria.",{"_2856":59907,"_25059":59863,"_17489":102650,"_5":17384,"_23720":102557,"_2383":102651},[],"Falla la vigencia",{"_2856":59908,"_25059":59863,"_17489":102653,"_5":17384,"_23720":102557,"_2383":102654},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2856":59909,"_25059":59863,"_17489":102656,"_5":17384,"_23720":102557,"_2383":102657},[],"Los resúmenes de clave difieren",{"_2856":59910,"_25059":59863,"_17489":102659,"_5":17384,"_23720":102557,"_2383":102660},[],"Archivos de certificado y clave de la misma emisión.",{"_2856":59911,"_25059":59863,"_17489":102662,"_5":17384,"_23720":102557,"_2383":102663},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2856":59912,"_25059":59863,"_17489":102665,"_5":17384,"_23720":102560,"_2383":102666},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2856":59913,"_25059":59863,"_17489":102668,"_5":17384,"_23720":102560,"_2383":102669},[],"Gestionar certificados para inspección, estado y revocación.",{"_2856":59914,"_25059":59863,"_17489":102671,"_5":17384,"_23720":102560,"_2383":102672},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2856":59915,"_25059":59863,"_17489":102674,"_5":17384,"_23720":102560,"_2383":102675},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2856":59916,"_25059":59863,"_17489":102677,"_5":17384,"_23720":102560,"_2383":102678},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2856":59917,"_25059":59917,"_5":12268,"_2383":102680,"_25374":102681,"_17489":102682,"_23720":59917},"Primeros pasos de PKI",[40699,96919,45721,99942],[],{"_2856":59918,"_25059":59917,"_17489":102684,"_5":17384,"_23720":59917,"_2383":102685},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2856":59919,"_25059":59917,"_5":25371,"_17489":102687,"_23720":102688,"_2383":95620},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2856":59920,"_25059":59917,"_5":25371,"_17489":102690,"_23720":102691,"_2383":102692},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2856":59921,"_25059":59917,"_5":25371,"_17489":102694,"_23720":102695,"_2383":100124},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2856":59922,"_25059":59917,"_5":25371,"_17489":102697,"_23720":102698,"_2383":102699},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2856":59923,"_25059":59917,"_17489":102701,"_5":17384,"_23720":59917,"_2383":102702},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2856":59924,"_25059":59917,"_17489":102704,"_5":17384,"_23720":102688,"_2383":102705},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2856":59925,"_25059":59917,"_17489":102707,"_5":17384,"_23720":102688,"_2383":102708},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2856":59926,"_25059":59917,"_17489":102710,"_5":17384,"_23720":102688,"_2383":102711},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2856":59927,"_25059":59917,"_17489":102713,"_5":17384,"_23720":102688,"_2383":102714},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2856":59928,"_25059":59917,"_17489":102716,"_5":17384,"_23720":102688,"_2383":102717},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2856":59929,"_25059":59917,"_17489":102719,"_5":17384,"_23720":102691,"_2383":102720},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2856":59930,"_25059":59917,"_17489":102722,"_5":17384,"_23720":102691,"_2383":102723},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2856":59931,"_25059":59917,"_17489":102725,"_5":17384,"_23720":102691,"_2383":102726},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2856":59932,"_25059":59917,"_17489":102728,"_5":17384,"_23720":102691,"_2383":102729},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2856":59933,"_25059":59917,"_17489":102731,"_5":17384,"_23720":102695,"_2383":102732},[],"Archivo o recurso",{"_2856":59934,"_25059":59917,"_17489":102734,"_5":17384,"_23720":102695,"_2383":100121},[],{"_2856":59935,"_25059":59917,"_17489":102736,"_5":17384,"_23720":102695,"_2383":102737},[],"CA raíz activa y `ca.pem`",{"_2856":59936,"_25059":59917,"_17489":102739,"_5":17384,"_23720":102695,"_2383":102740},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2856":59937,"_25059":59917,"_17489":102742,"_5":17384,"_23720":102695,"_2383":102743},[],"Certificado final y `device.crt`",{"_2856":59938,"_25059":59917,"_17489":102745,"_5":17384,"_23720":102695,"_2383":102746},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2856":59939,"_25059":59917,"_17489":102748,"_5":17384,"_23720":102695,"_2383":102749},[],"Clave privada `device.key`",{"_2856":59940,"_25059":59917,"_17489":102751,"_5":17384,"_23720":102695,"_2383":102752},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2856":59941,"_25059":59917,"_17489":102754,"_5":17384,"_23720":102695,"_2383":102755},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2856":59942,"_25059":59917,"_17489":102757,"_5":17384,"_23720":102698,"_2383":102758},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2856":59943,"_25059":59917,"_17489":102760,"_5":17384,"_23720":102698,"_2383":102761},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2856":59944,"_25059":59917,"_17489":102763,"_5":17384,"_23720":102698,"_2383":102764},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2856":59945,"_25059":59945,"_5":12268,"_2383":102766,"_25374":102767,"_17489":102769,"_23720":59945},"Resolución de problemas PKI",[40699,96919,45721,102768],"Resolución de problemas",[],{"_2856":59946,"_25059":59945,"_17489":102771,"_5":17384,"_23720":59945,"_2383":102772},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2856":59947,"_25059":59945,"_5":25371,"_17489":102774,"_23720":102775,"_2383":102776},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2856":59948,"_25059":59945,"_5":25371,"_17489":102778,"_23720":102779,"_2383":102780},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2856":59949,"_25059":59945,"_5":25371,"_17489":102782,"_23720":102783,"_2383":102784},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2856":59950,"_25059":59945,"_17489":102786,"_5":17384,"_23720":59945,"_2383":102787},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2856":59951,"_25059":59945,"_17489":102789,"_5":17384,"_23720":59945,"_2383":102790},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2856":59952,"_25059":59945,"_17489":102792,"_5":17384,"_23720":102775,"_2383":100121},[],{"_2856":59953,"_25059":59945,"_17489":102794,"_5":17384,"_23720":102775,"_2383":99050},[],{"_2856":59954,"_25059":59945,"_17489":102796,"_5":17384,"_23720":102775,"_2383":95644},[],{"_2856":59955,"_25059":59945,"_17489":102798,"_5":17384,"_23720":102775,"_2383":48056},[],{"_2856":59956,"_25059":59945,"_17489":102800,"_5":17384,"_23720":102775,"_2383":102801},[],"Existe, está activa y sus fechas son utilizables.",{"_2856":59957,"_25059":59945,"_17489":102803,"_5":17384,"_23720":102775,"_2383":102804},[],"Autoridades.",{"_2856":59958,"_25059":59945,"_17489":102806,"_5":17384,"_23720":102775,"_2383":102807},[],"Clave",{"_2856":59959,"_25059":59945,"_17489":102809,"_5":17384,"_23720":102775,"_2383":102810},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2856":59960,"_25059":59945,"_17489":102812,"_5":17384,"_23720":102775,"_2383":102813},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2856":59961,"_25059":59945,"_17489":102815,"_5":17384,"_23720":102775,"_2383":48074},[],{"_2856":59962,"_25059":59945,"_17489":102817,"_5":17384,"_23720":102775,"_2383":102818},[],"PEM correcto y firma verificable.",{"_2856":59963,"_25059":59945,"_17489":102820,"_5":17384,"_23720":102775,"_2383":48080},[],{"_2856":59964,"_25059":59945,"_17489":102822,"_5":17384,"_23720":102775,"_2383":102823},[],"Perfil",{"_2856":59965,"_25059":59945,"_17489":102825,"_5":17384,"_23720":102775,"_2383":102826},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2856":59966,"_25059":59945,"_17489":102828,"_5":17384,"_23720":102775,"_2383":102829},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2856":59967,"_25059":59945,"_17489":102831,"_5":17384,"_23720":102775,"_2383":100273},[],{"_2856":59968,"_25059":59945,"_17489":102833,"_5":17384,"_23720":102775,"_2383":102834},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2856":59969,"_25059":59945,"_17489":102836,"_5":17384,"_23720":102775,"_2383":102837},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2856":59970,"_25059":59945,"_17489":102839,"_5":17384,"_23720":102775,"_2383":102840},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2856":59971,"_25059":59945,"_17489":102842,"_5":17384,"_23720":102775,"_2383":102843},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2856":59972,"_25059":59945,"_17489":102845,"_5":17384,"_23720":102779,"_2383":102846},[],"Revisa cada frontera por separado:",{"_2856":59973,"_25059":59945,"_17489":102848,"_5":17384,"_23720":102779,"_2383":102849},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2856":59974,"_25059":59945,"_17489":102851,"_5":17384,"_23720":102779,"_2383":102852},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2856":59975,"_25059":59945,"_17489":102854,"_5":17384,"_23720":102779,"_2383":102855},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2856":59976,"_25059":59945,"_17489":102857,"_5":17384,"_23720":102779,"_2383":102858},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2856":59977,"_25059":59945,"_17489":102860,"_5":17384,"_23720":102779,"_2383":102861},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2856":59978,"_25059":59945,"_17489":102863,"_5":17384,"_23720":102779,"_2383":102864},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2856":59979,"_25059":59945,"_17489":102866,"_5":17384,"_23720":102783,"_2383":102867},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2856":59980,"_25059":59945,"_17489":102869,"_5":17384,"_23720":102783,"_2383":102870},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48134":102872,"_48136":102873,"_48138":102874,"_48140":102875,"_15199":2405,"_57611":2405},"spanish",[2383,25059,5,23720],{"_2383":20874,"_25059":20874,"_5":20874,"_23720":20874},{"_2383":102876,"_25059":105242,"_5":107608,"_23720":109974},{"_3827":1