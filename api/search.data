0165,"_41796":130168,"_41798":130171,"_41800":130174,"_41802":130177,"_41804":130180,"_41806":130183,"_41808":130186,"_41810":130189,"_41812":130192,"_41814":130195,"_41816":130198,"_41818":130201,"_41820":130204,"_41822":130207,"_41824":130210,"_41826":130213,"_41828":130216,"_41830":130219,"_41832":130222,"_41834":130225,"_41836":130228,"_41838":130231,"_41840":130234,"_41842":130237,"_41844":130240,"_41846":130243,"_41848":130246,"_41850":130249,"_41852":130252,"_41854":130255,"_41857":130258,"_31201":130261,"_41860":130264},{"_3704":73060,"_31315":73060,"_5":15297,"_3093":120933,"_31653":120934,"_21707":120937,"_28496":73060},"Despliega desde AWS Marketplace",[51162,120935,120936],"Despliegue","Otros modelos",[],{"_3704":73061,"_31315":73060,"_21707":120939,"_5":14937,"_28496":73060,"_3093":120940},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3704":73062,"_31315":73060,"_5":31650,"_21707":120942,"_28496":120943,"_3093":120944},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3704":73063,"_31315":73060,"_5":31650,"_21707":120946,"_28496":120947,"_3093":120948},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3704":73064,"_31315":73060,"_5":31650,"_21707":120950,"_28496":120951,"_3093":120952},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3704":73065,"_31315":73060,"_5":31650,"_21707":120954,"_28496":120955,"_3093":120956},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3704":73066,"_31315":73060,"_5":31650,"_21707":120958,"_28496":120959,"_3093":120960},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3704":73067,"_31315":73060,"_5":31650,"_21707":120962,"_28496":120963,"_3093":120964},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3704":73068,"_31315":73060,"_5":31650,"_21707":120966,"_28496":120967,"_3093":120968},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3704":73069,"_31315":73060,"_21707":120970,"_5":14937,"_28496":73060,"_3093":120971},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3704":73070,"_31315":73060,"_21707":120973,"_5":14937,"_28496":120943,"_3093":120974},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3704":73071,"_31315":73060,"_21707":120976,"_5":14937,"_28496":120943,"_3093":120977},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3704":73072,"_31315":73060,"_21707":120979,"_5":14937,"_28496":120943,"_3093":120980},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3704":73073,"_31315":73060,"_21707":120982,"_5":14937,"_28496":120947,"_3093":120983},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3704":73074,"_31315":73060,"_21707":120985,"_5":14937,"_28496":120947,"_3093":120986},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3704":73075,"_31315":73060,"_21707":120988,"_5":14937,"_28496":120947,"_3093":120989},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3704":73076,"_31315":73060,"_21707":120991,"_5":14937,"_28496":120951,"_3093":120992},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3704":73077,"_31315":73060,"_21707":120994,"_5":14937,"_28496":120955,"_3093":120995},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3704":73078,"_31315":73060,"_21707":120997,"_5":14937,"_28496":120959,"_3093":120998},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3704":73079,"_31315":73060,"_21707":121000,"_5":14937,"_28496":120963,"_3093":121001},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3704":73080,"_31315":73060,"_21707":121003,"_5":14937,"_28496":120967,"_3093":121004},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3704":73081,"_31315":73081,"_5":15297,"_3093":121006,"_31653":121007,"_21707":121008,"_28496":73081},"Despliega Lamassu",[51162,120935],[],{"_3704":73082,"_31315":73081,"_21707":121010,"_5":14937,"_28496":73081,"_3093":121011},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3704":73083,"_31315":73081,"_5":31650,"_21707":121013,"_28496":121014,"_3093":121015},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3704":73084,"_31315":73081,"_5":31650,"_21707":121017,"_28496":121018,"_3093":121019},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3704":73085,"_31315":73081,"_5":31650,"_21707":121021,"_28496":121022,"_3093":121023},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3704":73086,"_31315":73081,"_21707":121025,"_5":14937,"_28496":73081,"_3093":121026},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3704":73087,"_31315":73081,"_21707":121028,"_5":14937,"_28496":121014,"_3093":121029},[],"Modelo",{"_3704":73088,"_31315":73081,"_21707":121031,"_5":14937,"_28496":121014,"_3093":121032},[],"Recomendado para",{"_3704":73089,"_31315":73081,"_21707":121034,"_5":14937,"_28496":121014,"_3093":121035},[],"Quién opera la infraestructura",{"_3704":73090,"_31315":73081,"_21707":121037,"_5":14937,"_28496":121014,"_3093":121038},[],"Punto de partida",{"_3704":73091,"_31315":73081,"_21707":121040,"_5":14937,"_28496":121014,"_3093":51269},[],{"_3704":73092,"_31315":73081,"_21707":121042,"_5":14937,"_28496":121014,"_3093":121043},[],"Producción, entornos regulados y despliegues personalizados",{"_3704":73093,"_31315":73081,"_21707":121045,"_5":14937,"_28496":121014,"_3093":121046},[],"Tu equipo",{"_3704":73094,"_31315":73081,"_21707":121048,"_5":14937,"_28496":121014,"_3093":121049},[],"Helm o Fastlane",{"_3704":73095,"_31315":73081,"_21707":121051,"_5":14937,"_28496":121014,"_3093":51281},[],{"_3704":73096,"_31315":73081,"_21707":121053,"_5":14937,"_28496":121014,"_3093":121054},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3704":73097,"_31315":73081,"_21707":121056,"_5":14937,"_28496":121014,"_3093":121046},[],{"_3704":73098,"_31315":73081,"_21707":121058,"_5":14937,"_28496":121014,"_3093":121059},[],"Imagen preconfigurada en EC2",{"_3704":73099,"_31315":73081,"_21707":121061,"_5":14937,"_28496":121014,"_3093":51292},[],{"_3704":73100,"_31315":73081,"_21707":121063,"_5":14937,"_28496":121014,"_3093":121064},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3704":73101,"_31315":73081,"_21707":121066,"_5":14937,"_28496":121014,"_3093":51298},[],{"_3704":73102,"_31315":73081,"_21707":121068,"_5":14937,"_28496":121014,"_3093":121069},[],"Suscripción gestionada",{"_3704":73103,"_31315":73081,"_21707":121071,"_5":14937,"_28496":121014,"_3093":121072},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3704":73104,"_31315":73081,"_21707":121074,"_5":14937,"_28496":121014,"_3093":121075},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3704":73105,"_31315":73081,"_21707":121077,"_5":14937,"_28496":121014,"_3093":121078},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3704":73106,"_31315":73081,"_21707":121080,"_5":14937,"_28496":121018,"_3093":121081},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3704":73107,"_31315":73081,"_21707":121083,"_5":14937,"_28496":121022,"_3093":121084},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3704":73108,"_31315":73108,"_5":15297,"_3093":121086,"_31653":121087,"_21707":121088,"_28496":73108},"Utiliza Lamassu como SaaS",[51162,120935,120936],[],{"_3704":73109,"_31315":73108,"_21707":121090,"_5":14937,"_28496":73108,"_3093":121091},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3704":73110,"_31315":73108,"_5":31650,"_21707":121093,"_28496":121094,"_3093":121095},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3704":73111,"_31315":73108,"_5":31650,"_21707":121097,"_28496":121098,"_3093":121099},[],"/docs/es/deployment/saas#planes","Planes",{"_3704":73112,"_31315":73108,"_5":31650,"_21707":121101,"_28496":121102,"_3093":121103},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3704":73113,"_31315":73108,"_21707":121105,"_5":14937,"_28496":73108,"_3093":121106},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3704":73114,"_31315":73108,"_21707":121108,"_5":14937,"_28496":121094,"_3093":121109},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3704":73115,"_31315":73108,"_21707":121111,"_5":14937,"_28496":121094,"_3093":121112},[],"Copias de seguridad automáticas.",{"_3704":73116,"_31315":73108,"_21707":121114,"_5":14937,"_28496":121094,"_3093":121115},[],"Actualizaciones de versión.",{"_3704":73117,"_31315":73108,"_21707":121117,"_5":14937,"_28496":121094,"_3093":121118},[],"Soporte técnico y SLA según el plan contratado.",{"_3704":73118,"_31315":73108,"_21707":121120,"_5":14937,"_28496":121098,"_3093":51353},[],{"_3704":73119,"_31315":73108,"_21707":121122,"_5":14937,"_28496":121098,"_3093":121123},[],"Dispositivos",{"_3704":73120,"_31315":73108,"_21707":121125,"_5":14937,"_28496":121098,"_3093":121126},[],"Soporte",{"_3704":73121,"_31315":73108,"_21707":121128,"_5":14937,"_28496":121098,"_3093":51362},[],{"_3704":73122,"_31315":73108,"_21707":121130,"_5":14937,"_28496":121098,"_3093":51365},[],{"_3704":73123,"_31315":73108,"_21707":121132,"_5":14937,"_28496":121098,"_3093":121133},[],"Hasta 1.000",{"_3704":73124,"_31315":73108,"_21707":121135,"_5":14937,"_28496":121098,"_3093":51371},[],{"_3704":73125,"_31315":73108,"_21707":121137,"_5":14937,"_28496":121098,"_3093":121138},[],"99,5 %",{"_3704":73126,"_31315":73108,"_21707":121140,"_5":14937,"_28496":121098,"_3093":51377},[],{"_3704":73127,"_31315":73108,"_21707":121142,"_5":14937,"_28496":121098,"_3093":121143},[],"Hasta 10.000",{"_3704":73128,"_31315":73108,"_21707":121145,"_5":14937,"_28496":121098,"_3093":121146},[],"Email y chat",{"_3704":73129,"_31315":73108,"_21707":121148,"_5":14937,"_28496":121098,"_3093":121149},[],"99,9 %",{"_3704":73130,"_31315":73108,"_21707":121151,"_5":14937,"_28496":121098,"_3093":51389},[],{"_3704":73131,"_31315":73108,"_21707":121153,"_5":14937,"_28496":121098,"_3093":121154},[],"Ilimitados",{"_3704":73132,"_31315":73108,"_21707":121156,"_5":14937,"_28496":121098,"_3093":121157},[],"Dedicado",{"_3704":73133,"_31315":73108,"_21707":121159,"_5":14937,"_28496":121098,"_3093":121160},[],"99,99 %",{"_3704":73134,"_31315":73108,"_21707":121162,"_5":14937,"_28496":121102,"_3093":121163},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3704":73135,"_31315":73108,"_21707":121165,"_5":14937,"_28496":121102,"_3093":121166},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3704":73136,"_31315":73136,"_5":15297,"_3093":51406,"_31653":121168,"_21707":121170,"_28496":73136},[51162,120935,121169],"Kubernetes autogestionado",[],{"_3704":73137,"_31315":73136,"_21707":121172,"_5":14937,"_28496":73136,"_3093":121173},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3704":73138,"_31315":73136,"_5":31650,"_21707":121175,"_28496":121176,"_3093":121177},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3704":73139,"_31315":73136,"_5":31650,"_21707":121179,"_28496":121180,"_3093":121181},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3704":73140,"_31315":73136,"_5":31650,"_21707":121183,"_28496":121184,"_3093":121185},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3704":73141,"_31315":73136,"_5":31650,"_21707":121187,"_28496":121188,"_3093":121189},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3704":73142,"_31315":73136,"_5":31650,"_21707":121191,"_28496":121192,"_3093":121193},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3704":73143,"_31315":73136,"_5":31650,"_21707":121195,"_28496":121196,"_3093":121197},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3704":73144,"_31315":73136,"_5":31650,"_21707":121199,"_28496":121200,"_3093":121201},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3704":73145,"_31315":73136,"_5":31650,"_21707":121203,"_28496":121204,"_3093":121205},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3704":73146,"_31315":73136,"_5":31650,"_21707":121207,"_28496":121208,"_3093":121209},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3704":73147,"_31315":73136,"_5":31650,"_21707":121211,"_28496":121212,"_3093":121213},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3704":73148,"_31315":73136,"_5":31650,"_21707":121215,"_28496":121216,"_3093":121217},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3704":73149,"_31315":73136,"_21707":121219,"_5":14937,"_28496":121176,"_3093":121220},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3704":73150,"_31315":73136,"_21707":121222,"_5":14937,"_28496":121176,"_3093":121223},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3704":73151,"_31315":73136,"_21707":121225,"_5":14937,"_28496":121180,"_3093":121226},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3704":73152,"_31315":73136,"_21707":121228,"_5":14937,"_28496":121180,"_3093":121229},[],"Fastlane instala o configura",{"_3704":73153,"_31315":73136,"_21707":121231,"_5":14937,"_28496":121180,"_3093":121232},[],"Tú sigues proporcionando",{"_3704":73154,"_31315":73136,"_21707":121234,"_5":14937,"_28496":121180,"_3093":121235},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3704":73155,"_31315":73136,"_21707":121237,"_5":14937,"_28496":121180,"_3093":121238},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3704":73156,"_31315":73136,"_21707":121240,"_5":14937,"_28496":121180,"_3093":121241},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3704":73157,"_31315":73136,"_21707":121243,"_5":14937,"_28496":121180,"_3093":121244},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3704":73158,"_31315":73136,"_21707":121246,"_5":14937,"_28496":121180,"_3093":121247},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3704":73159,"_31315":73136,"_21707":121249,"_5":14937,"_28496":121180,"_3093":121250},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3704":73160,"_31315":73136,"_21707":121252,"_5":14937,"_28496":121180,"_3093":121253},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3704":73161,"_31315":73136,"_21707":121255,"_5":14937,"_28496":121180,"_3093":121256},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3704":73162,"_31315":73136,"_21707":121258,"_5":14937,"_28496":121180,"_3093":121259},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3704":73163,"_31315":73136,"_21707":121261,"_5":14937,"_28496":121184,"_3093":121262},[],"Necesitas:",{"_3704":73164,"_31315":73136,"_21707":121264,"_5":14937,"_28496":121184,"_3093":121265},[],"un clúster Kubernetes existente",{"_3704":73165,"_31315":73136,"_21707":121267,"_5":14937,"_28496":121184,"_3093":121268},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3704":73166,"_31315":73136,"_21707":121270,"_5":14937,"_28496":121184,"_3093":51508},[],{"_3704":73167,"_31315":73136,"_21707":121272,"_5":14937,"_28496":121184,"_3093":24520},[],{"_3704":73168,"_31315":73136,"_21707":121274,"_5":14937,"_28496":121184,"_3093":121275},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3704":73169,"_31315":73136,"_21707":121277,"_5":14937,"_28496":121184,"_3093":121278},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3704":73170,"_31315":73136,"_21707":121280,"_5":14937,"_28496":121184,"_3093":121281},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3704":73171,"_31315":73136,"_21707":121283,"_5":14937,"_28496":121184,"_3093":121284},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3704":73172,"_31315":73136,"_21707":121286,"_5":14937,"_28496":121184,"_3093":121287},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3704":73173,"_31315":73136,"_21707":121289,"_5":14937,"_28496":121188,"_3093":121290},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3704":73174,"_31315":73136,"_21707":121292,"_5":14937,"_28496":121188,"_3093":121293},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3704":73175,"_31315":73136,"_21707":121295,"_5":14937,"_28496":121192,"_3093":121296},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3704":73176,"_31315":73136,"_21707":121298,"_5":14937,"_28496":121192,"_3093":121299},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3704":73177,"_31315":73136,"_21707":121301,"_5":14937,"_28496":121192,"_3093":121302},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3704":73178,"_31315":73136,"_21707":121304,"_5":14937,"_28496":121192,"_3093":121305},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3704":73179,"_31315":73136,"_21707":121307,"_5":14937,"_28496":121196,"_3093":121308},[],"Opción",{"_3704":73180,"_31315":73136,"_21707":121310,"_5":14937,"_28496":121196,"_3093":121311},[],"Valor predeterminado",{"_3704":73181,"_31315":73136,"_21707":121313,"_5":14937,"_28496":121196,"_3093":121314},[],"Propósito",{"_3704":73182,"_31315":73136,"_21707":121316,"_5":14937,"_28496":121196,"_3093":51555},[],{"_3704":73183,"_31315":73136,"_21707":121318,"_5":14937,"_28496":121196,"_3093":51558},[],{"_3704":73184,"_31315":73136,"_21707":121320,"_5":14937,"_28496":121196,"_3093":121321},[],"Muestra la ayuda",{"_3704":73185,"_31315":73136,"_21707":121323,"_5":14937,"_28496":121196,"_3093":51564},[],{"_3704":73186,"_31315":73136,"_21707":121325,"_5":14937,"_28496":121196,"_3093":121326},[],"contexto actual",{"_3704":73187,"_31315":73136,"_21707":121328,"_5":14937,"_28496":121196,"_3093":121329},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3704":73188,"_31315":73136,"_21707":121331,"_5":14937,"_28496":121196,"_3093":51573},[],{"_3704":73189,"_31315":73136,"_21707":121333,"_5":14937,"_28496":121196,"_3093":6837},[],{"_3704":73190,"_31315":73136,"_21707":121335,"_5":14937,"_28496":121196,"_3093":121336},[],"Omite prompts y genera credenciales para las dependencias",{"_3704":73191,"_31315":73136,"_21707":121338,"_5":14937,"_28496":121196,"_3093":51581},[],{"_3704":73192,"_31315":73136,"_21707":121340,"_5":14937,"_28496":121196,"_3093":51584},[],{"_3704":73193,"_31315":73136,"_21707":121342,"_5":14937,"_28496":121196,"_3093":121343},[],"Namespace de la instalación",{"_3704":73194,"_31315":73136,"_21707":121345,"_5":14937,"_28496":121196,"_3093":51590},[],{"_3704":73195,"_31315":73136,"_21707":121347,"_5":14937,"_28496":121196,"_3093":51593},[],{"_3704":73196,"_31315":73136,"_21707":121349,"_5":14937,"_28496":121196,"_3093":121350},[],"Dominio usado por la UI, OIDC y el certificado",{"_3704":73197,"_31315":73136,"_21707":121352,"_5":14937,"_28496":121196,"_3093":51599},[],{"_3704":73198,"_31315":73136,"_21707":121354,"_5":14937,"_28496":121196,"_3093":15649},[],{"_3704":73199,"_31315":73136,"_21707":121356,"_5":14937,"_28496":121196,"_3093":121357},[],"Versión del chart de Lamassu",{"_3704":73200,"_31315":73136,"_21707":121359,"_5":14937,"_28496":121196,"_3093":51607},[],{"_3704":73201,"_31315":73136,"_21707":121361,"_5":14937,"_28496":121196,"_3093":51610},[],{"_3704":73202,"_31315":73136,"_21707":121363,"_5":14937,"_28496":121196,"_3093":121364},[],"Puerto del listener HTTPS",{"_3704":73203,"_31315":73136,"_21707":121366,"_5":14937,"_28496":121196,"_3093":51616},[],{"_3704":73204,"_31315":73136,"_21707":121368,"_5":14937,"_28496":121196,"_3093":51619},[],{"_3704":73205,"_31315":73136,"_21707":121370,"_5":14937,"_28496":121196,"_3093":121371},[],"Puerto del listener HTTP",{"_3704":73206,"_31315":73136,"_21707":121373,"_5":14937,"_28496":121196,"_3093":51625},[],{"_3704":73207,"_31315":73136,"_21707":121375,"_5":14937,"_28496":121196,"_3093":51558},[],{"_3704":73208,"_31315":73136,"_21707":121377,"_5":14937,"_28496":121196,"_3093":121378},[],"Certificado PEM para TLS downstream",{"_3704":73209,"_31315":73136,"_21707":121380,"_5":14937,"_28496":121196,"_3093":51633},[],{"_3704":73210,"_31315":73136,"_21707":121382,"_5":14937,"_28496":121196,"_3093":51558},[],{"_3704":73211,"_31315":73136,"_21707":121384,"_5":14937,"_28496":121196,"_3093":121385},[],"Clave privada PEM para TLS downstream",{"_3704":73212,"_31315":73136,"_21707":121387,"_5":14937,"_28496":121196,"_3093":51641},[],{"_3704":73213,"_31315":73136,"_21707":121389,"_5":14937,"_28496":121196,"_3093":121390},[],"chart del repositorio",{"_3704":73214,"_31315":73136,"_21707":121392,"_5":14937,"_28496":121196,"_3093":121393},[],"Usa un chart local de Lamassu sin empaquetar",{"_3704":73215,"_31315":73136,"_21707":121395,"_5":14937,"_28496":121196,"_3093":51650},[],{"_3704":73216,"_31315":73136,"_21707":121397,"_5":14937,"_28496":121196,"_3093":121398},[],"detección automática",{"_3704":73217,"_31315":73136,"_21707":121400,"_5":14937,"_28496":121196,"_3093":121401},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3704":73218,"_31315":73136,"_21707":121403,"_5":14937,"_28496":121196,"_3093":51658},[],{"_3704":73219,"_31315":73136,"_21707":121405,"_5":14937,"_28496":121196,"_3093":6837},[],{"_3704":73220,"_31315":73136,"_21707":121407,"_5":14937,"_28496":121196,"_3093":121408},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3704":73221,"_31315":73136,"_21707":121410,"_5":14937,"_28496":121196,"_3093":51666},[],{"_3704":73222,"_31315":73136,"_21707":121412,"_5":14937,"_28496":121196,"_3093":6837},[],{"_3704":73223,"_31315":73136,"_21707":121414,"_5":14937,"_28496":121196,"_3093":121415},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3704":73224,"_31315":73136,"_21707":121417,"_5":14937,"_28496":121196,"_3093":51674},[],{"_3704":73225,"_31315":73136,"_21707":121419,"_5":14937,"_28496":121196,"_3093":6837},[],{"_3704":73226,"_31315":73136,"_21707":121421,"_5":14937,"_28496":121196,"_3093":121422},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3704":73227,"_31315":73136,"_21707":121424,"_5":14937,"_28496":121196,"_3093":51682},[],{"_3704":73228,"_31315":73136,"_21707":121426,"_5":14937,"_28496":121196,"_3093":6837},[],{"_3704":73229,"_31315":73136,"_21707":121428,"_5":14937,"_28496":121196,"_3093":121429},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3704":73230,"_31315":73136,"_21707":121431,"_5":14937,"_28496":121196,"_3093":51690},[],{"_3704":73231,"_31315":73136,"_21707":121433,"_5":14937,"_28496":121196,"_3093":51693},[],{"_3704":73232,"_31315":73136,"_21707":121435,"_5":14937,"_28496":121196,"_3093":121436},[],"Usa otro chart local de SoftHSM",{"_3704":73233,"_31315":73136,"_21707":121438,"_5":14937,"_28496":121196,"_3093":121439},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3704":73234,"_31315":73136,"_21707":121441,"_5":14937,"_28496":121200,"_3093":121442},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3704":73235,"_31315":73136,"_21707":121444,"_5":14937,"_28496":121200,"_3093":121445},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3704":73236,"_31315":73136,"_21707":121447,"_5":14937,"_28496":121200,"_3093":121448},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3704":73237,"_31315":73136,"_21707":121450,"_5":14937,"_28496":121200,"_3093":121451},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3704":73238,"_31315":73136,"_21707":121453,"_5":14937,"_28496":121200,"_3093":121454},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3704":73239,"_31315":73136,"_21707":121456,"_5":14937,"_28496":121200,"_3093":121457},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3704":73240,"_31315":73136,"_21707":121459,"_5":14937,"_28496":121204,"_3093":51720},[],{"_3704":73241,"_31315":73136,"_21707":121461,"_5":14937,"_28496":121204,"_3093":121462},[],"valida las herramientas locales y el clúster seleccionado",{"_3704":73242,"_31315":73136,"_21707":121464,"_5":14937,"_28496":121204,"_3093":121465},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3704":73243,"_31315":73136,"_21707":121467,"_5":14937,"_28496":121204,"_3093":121468},[],"crea el namespace",{"_3704":73244,"_31315":73136,"_21707":121470,"_5":14937,"_28496":121204,"_3093":121471},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3704":73245,"_31315":73136,"_21707":121473,"_5":14937,"_28496":121204,"_3093":121474},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3704":73246,"_31315":73136,"_21707":121476,"_5":14937,"_28496":121204,"_3093":121477},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3704":73247,"_31315":73136,"_21707":121479,"_5":14937,"_28496":121204,"_3093":121480},[],"instala RabbitMQ",{"_3704":73248,"_31315":73136,"_21707":121482,"_5":14937,"_28496":121204,"_3093":121483},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3704":73249,"_31315":73136,"_21707":121485,"_5":14937,"_28496":121204,"_3093":121486},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3704":73250,"_31315":73136,"_21707":121488,"_5":14937,"_28496":121204,"_3093":121489},[],"carga datos de ejemplo opcionalmente",{"_3704":73251,"_31315":73136,"_21707":121491,"_5":14937,"_28496":121204,"_3093":121492},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3704":73252,"_31315":73136,"_21707":121494,"_5":14937,"_28496":121208,"_3093":121495},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3704":73253,"_31315":73136,"_21707":121497,"_5":14937,"_28496":121208,"_3093":121498},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3704":73254,"_31315":73136,"_21707":121500,"_5":14937,"_28496":121212,"_3093":121501},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3704":73255,"_31315":73136,"_21707":121503,"_5":14937,"_28496":121212,"_3093":121504},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3704":73256,"_31315":73136,"_21707":121506,"_5":14937,"_28496":121212,"_3093":121507},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3704":73257,"_31315":73136,"_21707":121509,"_5":14937,"_28496":121212,"_3093":121510},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3704":73258,"_31315":73136,"_21707":121512,"_5":14937,"_28496":121216,"_3093":121513},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3704":73259,"_31315":73259,"_5":15297,"_3093":121515,"_31653":121516,"_21707":121517,"_28496":73259},"Instala con Helm",[51162,120935,121169],[],{"_3704":73260,"_31315":73259,"_21707":121519,"_5":14937,"_28496":73259,"_3093":121520},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3704":73261,"_31315":73259,"_5":31650,"_21707":121522,"_28496":121523,"_3093":121524},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3704":73262,"_31315":73259,"_5":31650,"_21707":121526,"_28496":121527,"_3093":121185},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3704":73263,"_31315":73259,"_5":31650,"_21707":121529,"_28496":121530,"_3093":121531},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3704":73264,"_31315":73259,"_5":31650,"_21707":121533,"_28496":121534,"_3093":121535},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3704":73265,"_31315":73259,"_5":31650,"_21707":121537,"_28496":121538,"_3093":121539},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3704":73266,"_31315":73259,"_5":31650,"_21707":121541,"_28496":121542,"_3093":121543},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3704":73267,"_31315":73259,"_5":31650,"_21707":121545,"_28496":121546,"_3093":121547},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3704":73268,"_31315":73259,"_5":31650,"_21707":121549,"_28496":121550,"_3093":121551},[],"/docs/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3704":73269,"_31315":73259,"_5":31650,"_21707":121553,"_28496":121554,"_3093":121555},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3704":73270,"_31315":73259,"_5":31650,"_21707":121557,"_28496":121558,"_3093":121559},[],"/docs/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3704":73271,"_31315":73259,"_5":31650,"_21707":121561,"_28496":121562,"_3093":121563},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3704":73272,"_31315":73259,"_5":31650,"_21707":121565,"_28496":121566,"_3093":121567},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3704":73273,"_31315":73259,"_5":31650,"_21707":121569,"_28496":121570,"_3093":121571},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3704":73274,"_31315":73259,"_5":31650,"_21707":121573,"_28496":121574,"_3093":121575},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3704":73275,"_31315":73259,"_21707":121577,"_5":14937,"_28496":121523,"_3093":121578},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3704":73276,"_31315":73259,"_21707":121580,"_5":14937,"_28496":121527,"_3093":121581},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3704":73277,"_31315":73259,"_21707":121583,"_5":14937,"_28496":121527,"_3093":121584},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3704":73278,"_31315":73259,"_21707":121586,"_5":14937,"_28496":121527,"_3093":121587},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3704":73279,"_31315":73259,"_21707":121589,"_5":14937,"_28496":121527,"_3093":121590},[],"un broker RabbitMQ accesible y sus credenciales",{"_3704":73280,"_31315":73259,"_21707":121592,"_5":14937,"_28496":121527,"_3093":121593},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3704":73281,"_31315":73259,"_21707":121595,"_5":14937,"_28496":121527,"_3093":121596},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3704":73282,"_31315":73259,"_21707":121598,"_5":14937,"_28496":121527,"_3093":121599},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3704":73283,"_31315":73259,"_21707":121601,"_5":14937,"_28496":121527,"_3093":121602},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3704":73284,"_31315":73259,"_21707":121604,"_5":14937,"_28496":121527,"_3093":121605},[],"una StorageClass y un diseño de tráfico externo",{"_3704":73285,"_31315":73259,"_21707":121607,"_5":14937,"_28496":121527,"_3093":121608},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3704":73286,"_31315":73259,"_21707":121610,"_5":14937,"_28496":121527,"_3093":121611},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3704":73287,"_31315":73259,"_21707":121613,"_5":14937,"_28496":121527,"_3093":121614},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3704":73288,"_31315":73259,"_21707":121616,"_5":14937,"_28496":121530,"_3093":121617},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3704":73289,"_31315":73259,"_21707":121619,"_5":14937,"_28496":121530,"_3093":121620},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3704":73290,"_31315":73259,"_21707":121622,"_5":14937,"_28496":121530,"_3093":121623},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3704":73291,"_31315":73259,"_21707":121625,"_5":14937,"_28496":121534,"_3093":121626},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3704":73292,"_31315":73259,"_21707":121628,"_5":14937,"_28496":121534,"_3093":121629},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3704":73293,"_31315":73259,"_21707":121631,"_5":14937,"_28496":121534,"_3093":121632},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3704":73294,"_31315":73259,"_21707":121634,"_5":14937,"_28496":121534,"_3093":121635},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3704":73295,"_31315":73259,"_21707":121637,"_5":14937,"_28496":121538,"_3093":121638},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3704":73296,"_31315":73259,"_21707":121640,"_5":14937,"_28496":121538,"_3093":121641},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3704":73297,"_31315":73259,"_21707":121643,"_5":14937,"_28496":121538,"_3093":121644},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3704":73298,"_31315":73259,"_21707":121646,"_5":14937,"_28496":121538,"_3093":121647},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3704":73299,"_31315":73259,"_21707":121649,"_5":14937,"_28496":121538,"_3093":121650},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3704":73300,"_31315":73259,"_21707":121652,"_5":14937,"_28496":121538,"_3093":121653},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3704":73301,"_31315":73259,"_21707":121655,"_5":14937,"_28496":121538,"_3093":121656},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3704":73302,"_31315":73259,"_21707":121658,"_5":14937,"_28496":121538,"_3093":121659},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3704":73303,"_31315":73259,"_21707":121661,"_5":14937,"_28496":121542,"_3093":121662},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3704":73304,"_31315":73259,"_21707":121664,"_5":14937,"_28496":121546,"_3093":121665},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3704":73305,"_31315":73259,"_21707":121667,"_5":14937,"_28496":121546,"_3093":121668},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3704":73306,"_31315":73259,"_21707":121670,"_5":14937,"_28496":121546,"_3093":121671},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3704":73307,"_31315":73259,"_21707":121673,"_5":14937,"_28496":121546,"_3093":121674},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3704":73308,"_31315":73259,"_21707":121676,"_5":14937,"_28496":121546,"_3093":121677},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3704":73309,"_31315":73259,"_21707":121679,"_5":14937,"_28496":121546,"_3093":121680},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3704":73310,"_31315":73259,"_21707":121682,"_5":14937,"_28496":121546,"_3093":121683},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3704":73311,"_31315":73259,"_21707":121685,"_5":14937,"_28496":121550,"_3093":121686},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3704":73312,"_31315":73259,"_21707":121688,"_5":14937,"_28496":121550,"_3093":121689},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3704":73313,"_31315":73259,"_21707":121691,"_5":14937,"_28496":121554,"_3093":121692},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3704":73314,"_31315":73259,"_21707":121694,"_5":14937,"_28496":121554,"_3093":121695},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3704":73315,"_31315":73259,"_21707":121697,"_5":14937,"_28496":121554,"_3093":121698},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3704":73316,"_31315":73259,"_21707":121700,"_5":14937,"_28496":121554,"_3093":121701},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3704":73317,"_31315":73259,"_21707":121703,"_5":14937,"_28496":121558,"_3093":121704},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3704":73318,"_31315":73259,"_21707":121706,"_5":14937,"_28496":121558,"_3093":121707},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3704":73319,"_31315":73259,"_21707":121709,"_5":14937,"_28496":121558,"_3093":121710},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3704":73320,"_31315":73259,"_21707":121712,"_5":14937,"_28496":121558,"_3093":121713},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3704":73321,"_31315":73259,"_21707":121715,"_5":14937,"_28496":121562,"_3093":121716},[],"Para instalar un checkout local:",{"_3704":73322,"_31315":73259,"_21707":121718,"_5":14937,"_28496":121566,"_3093":121719},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3704":73323,"_31315":73259,"_21707":121721,"_5":14937,"_28496":121566,"_3093":121722},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3704":73324,"_31315":73259,"_21707":121724,"_5":14937,"_28496":121570,"_3093":121725},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3704":73325,"_31315":73259,"_21707":121727,"_5":14937,"_28496":121570,"_3093":121728},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3704":73326,"_31315":73259,"_21707":121730,"_5":14937,"_28496":121570,"_3093":121731},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3704":73327,"_31315":73259,"_21707":121733,"_5":14937,"_28496":121570,"_3093":121734},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3704":73328,"_31315":73259,"_21707":121736,"_5":14937,"_28496":121570,"_3093":121737},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3704":73329,"_31315":73259,"_21707":121739,"_5":14937,"_28496":121574,"_3093":121740},[],"Antes de pasar a producción, revisa:",{"_3704":73330,"_31315":73259,"_21707":121742,"_5":14937,"_28496":121574,"_3093":121743},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3704":73331,"_31315":73259,"_21707":121745,"_5":14937,"_28496":121574,"_3093":121746},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3704":73332,"_31315":73259,"_21707":121748,"_5":14937,"_28496":121574,"_3093":121749},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3704":73333,"_31315":73259,"_21707":121751,"_5":14937,"_28496":121574,"_3093":121752},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3704":73334,"_31315":73259,"_21707":121754,"_5":14937,"_28496":121574,"_3093":121755},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3704":73335,"_31315":73259,"_21707":121757,"_5":14937,"_28496":121574,"_3093":121758},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3704":73336,"_31315":73259,"_21707":121760,"_5":14937,"_28496":121574,"_3093":121761},[],"SMTP, observabilidad y entrega de alertas",{"_3704":73337,"_31315":73259,"_21707":121763,"_5":14937,"_28496":121574,"_3093":121764},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3704":73338,"_31315":73259,"_21707":121766,"_5":14937,"_28496":121574,"_3093":121767},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3704":73339,"_31315":73339,"_5":15297,"_3093":121769,"_31653":121770,"_21707":121771,"_28496":73339},"Expón el Gateway",[51162,120935,121169],[],{"_3704":73340,"_31315":73339,"_21707":121773,"_5":14937,"_28496":73339,"_3093":121774},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3704":73341,"_31315":73339,"_5":31650,"_21707":121776,"_28496":121777,"_3093":121778},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3704":73342,"_31315":73339,"_5":31650,"_21707":121780,"_28496":121781,"_3093":121782},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3704":73343,"_31315":73339,"_5":31650,"_21707":121784,"_28496":121785,"_3093":121786},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3704":73344,"_31315":73339,"_5":31650,"_21707":121788,"_28496":121789,"_3093":52051},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3704":73345,"_31315":73339,"_5":31650,"_21707":121791,"_28496":121792,"_3093":121793},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3704":73346,"_31315":73339,"_5":31650,"_21707":121795,"_28496":121796,"_3093":121797},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3704":73347,"_31315":73339,"_5":31650,"_21707":121799,"_28496":121800,"_3093":121801},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3704":73348,"_31315":73339,"_5":31650,"_21707":121803,"_28496":121804,"_3093":121805},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3704":73349,"_31315":73339,"_5":31650,"_21707":121807,"_28496":121808,"_3093":121809},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3704":73350,"_31315":73339,"_5":31650,"_21707":121811,"_28496":121812,"_3093":121813},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3704":73351,"_31315":73339,"_5":31650,"_21707":121815,"_28496":121816,"_3093":121817},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3704":73352,"_31315":73339,"_21707":121819,"_5":14937,"_28496":121777,"_3093":121820},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3704":73353,"_31315":73339,"_21707":121822,"_5":14937,"_28496":121777,"_3093":121823},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3704":73354,"_31315":73339,"_21707":121825,"_5":14937,"_28496":121781,"_3093":121826},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3704":73355,"_31315":73339,"_21707":121828,"_5":14937,"_28496":121781,"_3093":121829},[],"Defínelo únicamente cuando:",{"_3704":73356,"_31315":73339,"_21707":121831,"_5":14937,"_28496":121781,"_3093":121832},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3704":73357,"_31315":73339,"_21707":121834,"_5":14937,"_28496":121781,"_3093":121835},[],"esa dirección está asignada a este Gateway",{"_3704":73358,"_31315":73339,"_21707":121837,"_5":14937,"_28496":121781,"_3093":121838},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3704":73359,"_31315":73339,"_21707":121840,"_5":14937,"_28496":121781,"_3093":121841},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3704":73360,"_31315":73339,"_21707":121843,"_5":14937,"_28496":121781,"_3093":121844},[],"No confundas estos valores:",{"_3704":73361,"_31315":73339,"_21707":121846,"_5":14937,"_28496":121781,"_3093":121847},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3704":73362,"_31315":73339,"_21707":121849,"_5":14937,"_28496":121781,"_3093":121850},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3704":73363,"_31315":73339,"_21707":121852,"_5":14937,"_28496":121781,"_3093":121853},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3704":73364,"_31315":73339,"_21707":121855,"_5":14937,"_28496":121785,"_3093":121856},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3704":73365,"_31315":73339,"_21707":121858,"_5":14937,"_28496":121785,"_3093":121859},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3704":73366,"_31315":73339,"_21707":121861,"_5":14937,"_28496":121789,"_3093":121862},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3704":73367,"_31315":73339,"_21707":121864,"_5":14937,"_28496":121789,"_3093":121865},[],"Para el diseño recomendado:",{"_3704":73368,"_31315":73339,"_21707":121867,"_5":14937,"_28496":121789,"_3093":121868},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3704":73369,"_31315":73339,"_21707":121870,"_5":14937,"_28496":121789,"_3093":121871},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3704":73370,"_31315":73339,"_21707":121873,"_5":14937,"_28496":121789,"_3093":121874},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3704":73371,"_31315":73339,"_21707":121876,"_5":14937,"_28496":121789,"_3093":121877},[],"Apunta DNS a la dirección accesible de la VM.",{"_3704":73372,"_31315":73339,"_21707":121879,"_5":14937,"_28496":121789,"_3093":121880},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3704":73373,"_31315":73339,"_21707":121882,"_5":14937,"_28496":121792,"_3093":121883},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3704":73374,"_31315":73339,"_21707":121885,"_5":14937,"_28496":121796,"_3093":121886},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3704":73375,"_31315":73339,"_21707":121888,"_5":14937,"_28496":121796,"_3093":121889},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3704":73376,"_31315":73339,"_21707":121891,"_5":14937,"_28496":121800,"_3093":121892},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3704":73377,"_31315":73339,"_21707":121894,"_5":14937,"_28496":121800,"_3093":121895},[],"Requisito",{"_3704":73378,"_31315":73339,"_21707":121897,"_5":14937,"_28496":121800,"_3093":121898},[],"Diseño recomendado",{"_3704":73379,"_31315":73339,"_21707":121900,"_5":14937,"_28496":121800,"_3093":121901},[],"Consecuencia",{"_3704":73380,"_31315":73339,"_21707":121903,"_5":14937,"_28496":121800,"_3093":121904},[],"Varias URL o servicios de Lamassu",{"_3704":73381,"_31315":73339,"_21707":121906,"_5":14937,"_28496":121800,"_3093":121907},[],"Un Gateway con varias rutas",{"_3704":73382,"_31315":73339,"_21707":121909,"_5":14937,"_28496":121800,"_3093":121910},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3704":73383,"_31315":73339,"_21707":121912,"_5":14937,"_28496":121800,"_3093":121913},[],"Gateways independientes e IP externas distintas",{"_3704":73384,"_31315":73339,"_21707":121915,"_5":14937,"_28496":121800,"_3093":121916},[],"Una VIP por Gateway",{"_3704":73385,"_31315":73339,"_21707":121918,"_5":14937,"_28496":121800,"_3093":121919},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3704":73386,"_31315":73339,"_21707":121921,"_5":14937,"_28496":121800,"_3093":121922},[],"Gateways independientes, un nodo y una IP",{"_3704":73387,"_31315":73339,"_21707":121924,"_5":14937,"_28496":121800,"_3093":121925},[],"Puertos externos diferentes",{"_3704":73388,"_31315":73339,"_21707":121927,"_5":14937,"_28496":121800,"_3093":121928},[],"Los clientes deben indicar puertos no estándar",{"_3704":73389,"_31315":73339,"_21707":121930,"_5":14937,"_28496":121800,"_3093":121931},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3704":73390,"_31315":73339,"_21707":121933,"_5":14937,"_28496":121800,"_3093":121934},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3704":73391,"_31315":73339,"_21707":121936,"_5":14937,"_28496":121800,"_3093":121937},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3704":73392,"_31315":73339,"_21707":121939,"_5":14937,"_28496":121800,"_3093":121940},[],"Recursos Gateway separados pero proxy compartido",{"_3704":73393,"_31315":73339,"_21707":121942,"_5":14937,"_28496":121800,"_3093":121943},[],"Modo merged Gateway de Envoy",{"_3704":73394,"_31315":73339,"_21707":121945,"_5":14937,"_28496":121800,"_3093":121946},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3704":73395,"_31315":73339,"_21707":121948,"_5":14937,"_28496":121800,"_3093":121949},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3704":73396,"_31315":73339,"_21707":121951,"_5":14937,"_28496":121800,"_3093":121952},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3704":73397,"_31315":73339,"_21707":121954,"_5":14937,"_28496":121800,"_3093":121955},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3704":73398,"_31315":73339,"_21707":121957,"_5":14937,"_28496":121800,"_3093":121958},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3704":73399,"_31315":73339,"_21707":121960,"_5":14937,"_28496":121804,"_3093":121961},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3704":73400,"_31315":73339,"_21707":121963,"_5":14937,"_28496":121808,"_3093":121964},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3704":73401,"_31315":73339,"_21707":121966,"_5":14937,"_28496":121808,"_3093":121967},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3704":73402,"_31315":73339,"_21707":121969,"_5":14937,"_28496":121808,"_3093":121970},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3704":73403,"_31315":73339,"_21707":121972,"_5":14937,"_28496":121808,"_3093":121973},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3704":73404,"_31315":73339,"_21707":121975,"_5":14937,"_28496":121808,"_3093":121976},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3704":73405,"_31315":73339,"_21707":121978,"_5":14937,"_28496":121812,"_3093":121979},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3704":73406,"_31315":73339,"_21707":121981,"_5":14937,"_28496":121812,"_3093":121982},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3704":73407,"_31315":73339,"_21707":121984,"_5":14937,"_28496":121816,"_3093":121985},[],"Comprueba, en orden:",{"_3704":73408,"_31315":73339,"_21707":121987,"_5":14937,"_28496":121816,"_3093":121988},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3704":73409,"_31315":73339,"_21707":121990,"_5":14937,"_28496":121816,"_3093":121991},[],"Su estado contiene la dirección esperada.",{"_3704":73410,"_31315":73339,"_21707":121993,"_5":14937,"_28496":121816,"_3093":121994},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3704":73411,"_31315":73339,"_21707":121996,"_5":14937,"_28496":121816,"_3093":121997},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3704":73412,"_31315":73339,"_21707":121999,"_5":14937,"_28496":121816,"_3093":122000},[],"DNS resuelve al endpoint accesible externamente.",{"_3704":73413,"_31315":73339,"_21707":122002,"_5":14937,"_28496":121816,"_3093":122003},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3704":73414,"_31315":73339,"_21707":122005,"_5":14937,"_28496":121816,"_3093":122006},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3704":73415,"_31315":73415,"_5":15297,"_3093":51269,"_31653":122008,"_21707":122009,"_28496":73415},[51162,120935,121169],[],{"_3704":73416,"_31315":73415,"_21707":122011,"_5":14937,"_28496":73415,"_3093":122012},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3704":73417,"_31315":73415,"_5":31650,"_21707":122014,"_28496":122015,"_3093":122016},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3704":73418,"_31315":73415,"_5":31650,"_21707":122018,"_28496":122019,"_3093":122020},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3704":73419,"_31315":73415,"_5":31650,"_21707":122022,"_28496":122023,"_3093":122024},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3704":73420,"_31315":73415,"_5":31650,"_21707":122026,"_28496":122027,"_3093":122028},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3704":73421,"_31315":73415,"_5":31650,"_21707":122030,"_28496":122031,"_3093":122032},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3704":73422,"_31315":73415,"_5":31650,"_21707":122034,"_28496":122035,"_3093":122036},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3704":73423,"_31315":73415,"_21707":122038,"_5":14937,"_28496":122015,"_3093":122039},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3704":73424,"_31315":73415,"_21707":122041,"_5":14937,"_28496":122019,"_3093":122042},[],"Flujo",{"_3704":73425,"_31315":73415,"_21707":122044,"_5":14937,"_28496":122019,"_3093":122045},[],"Úsalo para",{"_3704":73426,"_31315":73415,"_21707":122047,"_5":14937,"_28496":122019,"_3093":122048},[],"Qué instala",{"_3704":73427,"_31315":73415,"_21707":122050,"_5":14937,"_28496":122019,"_3093":52313},[],{"_3704":73428,"_31315":73415,"_21707":122052,"_5":14937,"_28496":122019,"_3093":122053},[],"Producción y entornos controlados",{"_3704":73429,"_31315":73415,"_21707":122055,"_5":14937,"_28496":122019,"_3093":122056},[],"Servicios de Lamassu y recursos de Gateway API",{"_3704":73430,"_31315":73415,"_21707":122058,"_5":14937,"_28496":122019,"_3093":51406},[],{"_3704":73431,"_31315":73415,"_21707":122060,"_5":14937,"_28496":122019,"_3093":122061},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3704":73432,"_31315":73415,"_21707":122063,"_5":14937,"_28496":122019,"_3093":122064},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3704":73433,"_31315":73415,"_21707":122066,"_5":14937,"_28496":122023,"_3093":122067},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3704":73434,"_31315":73415,"_21707":122069,"_5":14937,"_28496":122023,"_3093":122070},[],"Área",{"_3704":73435,"_31315":73415,"_21707":122072,"_5":14937,"_28496":122023,"_3093":122073},[],"El chart de Lamassu proporciona",{"_3704":73436,"_31315":73415,"_21707":122075,"_5":14937,"_28496":122023,"_3093":122076},[],"Tú proporcionas",{"_3704":73437,"_31315":73415,"_21707":122078,"_5":14937,"_28496":122023,"_3093":122079},[],"Aplicaciones Lamassu",{"_3704":73438,"_31315":73415,"_21707":122081,"_5":14937,"_28496":122023,"_3093":122082},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3704":73439,"_31315":73415,"_21707":122084,"_5":14937,"_28496":122023,"_3093":122085},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3704":73440,"_31315":73415,"_21707":122087,"_5":14937,"_28496":122023,"_3093":122088},[],"Datos PostgreSQL",{"_3704":73441,"_31315":73415,"_21707":122090,"_5":14937,"_28496":122023,"_3093":122091},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3704":73442,"_31315":73415,"_21707":122093,"_5":14937,"_28496":122023,"_3093":122094},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3704":73443,"_31315":73415,"_21707":122096,"_5":14937,"_28496":122023,"_3093":122097},[],"Mensajería",{"_3704":73444,"_31315":73415,"_21707":122099,"_5":14937,"_28496":122023,"_3093":122100},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3704":73445,"_31315":73415,"_21707":122102,"_5":14937,"_28496":122023,"_3093":122103},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3704":73446,"_31315":73415,"_21707":122105,"_5":14937,"_28496":122023,"_3093":122106},[],"Identidad",{"_3704":73447,"_31315":73415,"_21707":122108,"_5":14937,"_28496":122023,"_3093":122109},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3704":73448,"_31315":73415,"_21707":122111,"_5":14937,"_28496":122023,"_3093":122112},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3704":73449,"_31315":73415,"_21707":122114,"_5":14937,"_28496":122023,"_3093":122115},[],"Enrutamiento externo",{"_3704":73450,"_31315":73415,"_21707":122117,"_5":14937,"_28496":122023,"_3093":122118},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3704":73451,"_31315":73415,"_21707":122120,"_5":14937,"_28496":122023,"_3093":122121},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3704":73452,"_31315":73415,"_21707":122123,"_5":14937,"_28496":122023,"_3093":52387},[],{"_3704":73453,"_31315":73415,"_21707":122125,"_5":14937,"_28496":122023,"_3093":122126},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3704":73454,"_31315":73415,"_21707":122128,"_5":14937,"_28496":122023,"_3093":122129},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3704":73455,"_31315":73415,"_21707":122131,"_5":14937,"_28496":122023,"_3093":122132},[],"Datos persistentes de la aplicación",{"_3704":73456,"_31315":73415,"_21707":122134,"_5":14937,"_28496":122023,"_3093":122135},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3704":73457,"_31315":73415,"_21707":122137,"_5":14937,"_28496":122023,"_3093":122138},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3704":73458,"_31315":73415,"_21707":122140,"_5":14937,"_28496":122023,"_3093":122141},[],"Integraciones opcionales",{"_3704":73459,"_31315":73415,"_21707":122143,"_5":14937,"_28496":122023,"_3093":122144},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3704":73460,"_31315":73415,"_21707":122146,"_5":14937,"_28496":122023,"_3093":122147},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3704":73461,"_31315":73415,"_21707":122149,"_5":14937,"_28496":122023,"_3093":122150},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3704":73462,"_31315":73415,"_21707":122152,"_5":14937,"_28496":122023,"_3093":122153},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3704":73463,"_31315":73415,"_21707":122155,"_5":14937,"_28496":122027,"_3093":122156},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3704":73464,"_31315":73415,"_21707":122158,"_5":14937,"_28496":122027,"_3093":122159},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3704":73465,"_31315":73415,"_21707":122161,"_5":14937,"_28496":122031,"_3093":122162},[],"Kubernetes 1.24 o posterior",{"_3704":73466,"_31315":73415,"_21707":122164,"_5":14937,"_28496":122031,"_3093":122165},[],"Helm 3.2 o posterior",{"_3704":73467,"_31315":73415,"_21707":122167,"_5":14937,"_28496":122031,"_3093":122168},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3704":73468,"_31315":73415,"_21707":122170,"_5":14937,"_28496":122031,"_3093":122171},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3704":73469,"_31315":73415,"_21707":122173,"_5":14937,"_28496":122031,"_3093":122174},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3704":73470,"_31315":73415,"_21707":122176,"_5":14937,"_28496":122031,"_3093":122177},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3704":73471,"_31315":73415,"_21707":122179,"_5":14937,"_28496":122031,"_3093":122180},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3704":73472,"_31315":73415,"_21707":122182,"_5":14937,"_28496":122035,"_3093":122183},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3704":73473,"_31315":73415,"_21707":122185,"_5":14937,"_28496":122035,"_3093":122186},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3704":73474,"_31315":73415,"_21707":122188,"_5":14937,"_28496":122035,"_3093":122189},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3704":73475,"_31315":73415,"_21707":122191,"_5":14937,"_28496":122035,"_3093":122192},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3704":73476,"_31315":73476,"_5":15297,"_3093":122194,"_31653":122195,"_21707":122197,"_28496":73476},"Resolución de problemas de despliegue",[51162,120935,122196],"Operación",[],{"_3704":73477,"_31315":73476,"_21707":122199,"_5":14937,"_28496":73476,"_3093":122200},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3704":73478,"_31315":73476,"_5":31650,"_21707":122202,"_28496":122203,"_3093":122204},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3704":73479,"_31315":73476,"_5":31650,"_21707":122206,"_28496":122207,"_3093":122208},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3704":73480,"_31315":73476,"_5":31650,"_21707":122210,"_28496":122211,"_3093":122212},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3704":73481,"_31315":73476,"_5":31650,"_21707":122214,"_28496":122215,"_3093":122216},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3704":73482,"_31315":73476,"_5":31650,"_21707":122218,"_28496":122219,"_3093":122220},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3704":73483,"_31315":73476,"_5":31650,"_21707":122222,"_28496":122223,"_3093":122224},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3704":73484,"_31315":73476,"_5":31650,"_21707":122226,"_28496":122227,"_3093":122228},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3704":73485,"_31315":73476,"_5":31650,"_21707":122230,"_28496":122231,"_3093":122232},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3704":73486,"_31315":73476,"_5":31650,"_21707":122234,"_28496":122235,"_3093":122236},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3704":73487,"_31315":73476,"_5":31650,"_21707":122238,"_28496":122239,"_3093":122240},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3704":73488,"_31315":73476,"_5":31650,"_21707":122242,"_28496":122243,"_3093":122244},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3704":73489,"_31315":73476,"_5":31650,"_21707":122246,"_28496":122247,"_3093":122248},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3704":73490,"_31315":73476,"_5":31650,"_21707":122250,"_28496":122251,"_3093":122252},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3704":73491,"_31315":73476,"_21707":122254,"_5":14937,"_28496":73476,"_3093":122255},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3704":73492,"_31315":73476,"_21707":122257,"_5":14937,"_28496":122207,"_3093":122258},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3704":73493,"_31315":73476,"_21707":122260,"_5":14937,"_28496":122211,"_3093":122261},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3704":73494,"_31315":73476,"_21707":122263,"_5":14937,"_28496":122215,"_3093":122264},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3704":73495,"_31315":73476,"_21707":122266,"_5":14937,"_28496":122219,"_3093":122267},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3704":73496,"_31315":73476,"_21707":122269,"_5":14937,"_28496":122223,"_3093":122270},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3704":73497,"_31315":73476,"_21707":122272,"_5":14937,"_28496":122227,"_3093":122273},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3704":73498,"_31315":73476,"_21707":122275,"_5":14937,"_28496":122227,"_3093":122276},[],"Ejecuta también la prueba de conectividad del chart:",{"_3704":73499,"_31315":73476,"_21707":122278,"_5":14937,"_28496":122227,"_3093":122279},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3704":73500,"_31315":73476,"_21707":122281,"_5":14937,"_28496":122227,"_3093":122282},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3704":73501,"_31315":73476,"_21707":122284,"_5":14937,"_28496":122231,"_3093":122285},[],"Si recibes un 401:",{"_3704":73502,"_31315":73476,"_21707":122287,"_5":14937,"_28496":122231,"_3093":122288},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3704":73503,"_31315":73476,"_21707":122290,"_5":14937,"_28496":122231,"_3093":122291},[],"verifica emisor, audiencia y expiración del token;",{"_3704":73504,"_31315":73476,"_21707":122293,"_5":14937,"_28496":122231,"_3093":122294},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3704":73505,"_31315":73476,"_21707":122296,"_5":14937,"_28496":122231,"_3093":122297},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3704":73506,"_31315":73476,"_21707":122299,"_5":14937,"_28496":122231,"_3093":122300},[],"Si el login termina pero las APIs devuelven 403:",{"_3704":73507,"_31315":73476,"_21707":122302,"_5":14937,"_28496":122231,"_3093":122303},[],"inspecciona los claims reales del token;",{"_3704":73508,"_31315":73476,"_21707":122305,"_5":14937,"_28496":122231,"_3093":122306},[],"confirma que coinciden con un principal activo;",{"_3704":73509,"_31315":73476,"_21707":122308,"_5":14937,"_28496":122231,"_3093":122309},[],"revisa las políticas concedidas al principal;",{"_3704":73510,"_31315":73476,"_21707":122311,"_5":14937,"_28496":122231,"_3093":122312},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3704":73511,"_31315":73476,"_21707":122314,"_5":14937,"_28496":122231,"_3093":122315},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3704":73512,"_31315":73476,"_21707":122317,"_5":14937,"_28496":122235,"_3093":122318},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3704":73513,"_31315":73476,"_21707":122320,"_5":14937,"_28496":122235,"_3093":122321},[],"Localiza el pod y Service de authz.",{"_3704":73514,"_31315":73476,"_21707":122323,"_5":14937,"_28496":122235,"_3093":122324},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3704":73515,"_31315":73476,"_21707":122326,"_5":14937,"_28496":122235,"_3093":122327},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3704":73516,"_31315":73476,"_21707":122329,"_5":14937,"_28496":122235,"_3093":122330},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3704":73517,"_31315":73476,"_21707":122332,"_5":14937,"_28496":122235,"_3093":122333},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3704":73518,"_31315":73476,"_21707":122335,"_5":14937,"_28496":122239,"_3093":122336},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3704":73519,"_31315":73476,"_21707":122338,"_5":14937,"_28496":122243,"_3093":122339},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3704":73520,"_31315":73476,"_21707":122341,"_5":14937,"_28496":122243,"_3093":122342},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3704":73521,"_31315":73476,"_21707":122344,"_5":14937,"_28496":122243,"_3093":122345},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3704":73522,"_31315":73476,"_21707":122347,"_5":14937,"_28496":122243,"_3093":122348},[],"volumen persistente sin enlazar;",{"_3704":73523,"_31315":73476,"_21707":122350,"_5":14937,"_28496":122243,"_3093":122351},[],"imagen inaccesible o política de pull incorrecta;",{"_3704":73524,"_31315":73476,"_21707":122353,"_5":14937,"_28496":122243,"_3093":122354},[],"configuración inválida del motor criptográfico;",{"_3704":73525,"_31315":73476,"_21707":122356,"_5":14937,"_28496":122243,"_3093":122357},[],"límites de CPU o memoria demasiado bajos;",{"_3704":73526,"_31315":73476,"_21707":122359,"_5":14937,"_28496":122243,"_3093":122360},[],"migración previa incompleta.",{"_3704":73527,"_31315":73476,"_21707":122362,"_5":14937,"_28496":122243,"_3093":122363},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3704":73528,"_31315":73476,"_21707":122365,"_5":14937,"_28496":122243,"_3093":122366},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3704":73529,"_31315":73476,"_21707":122368,"_5":14937,"_28496":122243,"_3093":122369},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3704":73530,"_31315":73476,"_21707":122371,"_5":14937,"_28496":122247,"_3093":122372},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3704":73531,"_31315":73476,"_21707":122374,"_5":14937,"_28496":122247,"_3093":122375},[],"verifica que esté habilitado en el servicio emisor;",{"_3704":73532,"_31315":73476,"_21707":122377,"_5":14937,"_28496":122247,"_3093":122378},[],"comprueba conectividad y credenciales AMQP;",{"_3704":73533,"_31315":73476,"_21707":122380,"_5":14937,"_28496":122247,"_3093":122381},[],"revisa exchange, routing key, colas y consumidores;",{"_3704":73534,"_31315":73476,"_21707":122383,"_5":14937,"_28496":122247,"_3093":122384},[],"inspecciona dead-letter queues;",{"_3704":73535,"_31315":73476,"_21707":122386,"_5":14937,"_28496":122247,"_3093":122387},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3704":73536,"_31315":73476,"_21707":122389,"_5":14937,"_28496":122247,"_3093":122390},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3704":73537,"_31315":73476,"_21707":122392,"_5":14937,"_28496":122247,"_3093":122393},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3704":73538,"_31315":73476,"_21707":122395,"_5":14937,"_28496":122247,"_3093":122396},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3704":73539,"_31315":73476,"_21707":122398,"_5":14937,"_28496":122247,"_3093":122399},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3704":73540,"_31315":73476,"_21707":122401,"_5":14937,"_28496":122247,"_3093":122402},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3704":73541,"_31315":73476,"_21707":122404,"_5":14937,"_28496":122247,"_3093":122405},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3704":73542,"_31315":73476,"_21707":122407,"_5":14937,"_28496":122247,"_3093":122408},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3704":73543,"_31315":73476,"_21707":122410,"_5":14937,"_28496":122251,"_3093":122411},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3704":73544,"_31315":73476,"_21707":122413,"_5":14937,"_28496":122251,"_3093":122414},[],"Antes de cerrar una incidencia, guarda:",{"_3704":73545,"_31315":73476,"_21707":122416,"_5":14937,"_28496":122251,"_3093":122417},[],"causa confirmada;",{"_3704":73546,"_31315":73476,"_21707":122419,"_5":14937,"_28496":122251,"_3093":122420},[],"alcance temporal y recursos afectados;",{"_3704":73547,"_31315":73476,"_21707":122422,"_5":14937,"_28496":122251,"_3093":122423},[],"comandos o consultas utilizados;",{"_3704":73548,"_31315":73476,"_21707":122425,"_5":14937,"_28496":122251,"_3093":122426},[],"cambio aplicado y forma de revertirlo;",{"_3704":73549,"_31315":73476,"_21707":122428,"_5":14937,"_28496":122251,"_3093":122429},[],"validación desde un consumidor;",{"_3704":73550,"_31315":73476,"_21707":122431,"_5":14937,"_28496":122251,"_3093":122432},[],"acción preventiva y propietario.",{"_3704":73551,"_31315":73551,"_5":15297,"_3093":122434,"_31653":122435,"_21707":122439,"_28496":73551},"Modelo de datos",[51162,122436,122437,122438],"Plataforma","Administración","Control de acceso",[],{"_3704":73552,"_31315":73551,"_21707":122441,"_5":14937,"_28496":73551,"_3093":122442},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3704":73553,"_31315":73551,"_5":31650,"_21707":122444,"_28496":122445,"_3093":122446},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3704":73554,"_31315":73551,"_5":31650,"_21707":122448,"_28496":122449,"_3093":122450},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3704":73555,"_31315":73551,"_21707":122452,"_5":14937,"_28496":73551,"_3093":122453},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3704":73556,"_31315":73551,"_21707":122455,"_5":14937,"_28496":122445,"_3093":122456},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3704":73557,"_31315":73551,"_21707":122458,"_5":14937,"_28496":122445,"_3093":122459},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3704":73558,"_31315":73551,"_21707":122461,"_5":14937,"_28496":122445,"_3093":122462},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3704":73559,"_31315":73551,"_21707":122464,"_5":14937,"_28496":122449,"_3093":122465},[],"Entidad (`schema_name.entity_type`)",{"_3704":73560,"_31315":73551,"_21707":122467,"_5":14937,"_28496":122449,"_3093":122468},[],"Tabla (`table_name`)",{"_3704":73561,"_31315":73551,"_21707":122470,"_5":14937,"_28496":122449,"_3093":122471},[],"Clave (`primary_key`)",{"_3704":73562,"_31315":73551,"_21707":122473,"_5":14937,"_28496":122449,"_3093":52738},[],{"_3704":73563,"_31315":73551,"_21707":122475,"_5":14937,"_28496":122449,"_3093":52741},[],{"_3704":73564,"_31315":73551,"_21707":122477,"_5":14937,"_28496":122449,"_3093":52744},[],{"_3704":73565,"_31315":73551,"_21707":122479,"_5":14937,"_28496":122449,"_3093":52747},[],{"_3704":73566,"_31315":73551,"_21707":122481,"_5":14937,"_28496":122449,"_3093":52750},[],{"_3704":73567,"_31315":73551,"_21707":122483,"_5":14937,"_28496":122449,"_3093":52753},[],{"_3704":73568,"_31315":73551,"_21707":122485,"_5":14937,"_28496":122449,"_3093":52756},[],{"_3704":73569,"_31315":73551,"_21707":122487,"_5":14937,"_28496":122449,"_3093":52759},[],{"_3704":73570,"_31315":73551,"_21707":122489,"_5":14937,"_28496":122449,"_3093":52753},[],{"_3704":73571,"_31315":73551,"_21707":122491,"_5":14937,"_28496":122449,"_3093":52764},[],{"_3704":73572,"_31315":73551,"_21707":122493,"_5":14937,"_28496":122449,"_3093":52767},[],{"_3704":73573,"_31315":73551,"_21707":122495,"_5":14937,"_28496":122449,"_3093":52770},[],{"_3704":73574,"_31315":73551,"_21707":122497,"_5":14937,"_28496":122449,"_3093":52773},[],{"_3704":73575,"_31315":73551,"_21707":122499,"_5":14937,"_28496":122449,"_3093":52776},[],{"_3704":73576,"_31315":73551,"_21707":122501,"_5":14937,"_28496":122449,"_3093":52753},[],{"_3704":73577,"_31315":73551,"_21707":122503,"_5":14937,"_28496":122449,"_3093":52781},[],{"_3704":73578,"_31315":73551,"_21707":122505,"_5":14937,"_28496":122449,"_3093":52784},[],{"_3704":73579,"_31315":73551,"_21707":122507,"_5":14937,"_28496":122449,"_3093":52753},[],{"_3704":73580,"_31315":73551,"_21707":122509,"_5":14937,"_28496":122449,"_3093":52789},[],{"_3704":73581,"_31315":73551,"_21707":122511,"_5":14937,"_28496":122449,"_3093":52792},[],{"_3704":73582,"_31315":73551,"_21707":122513,"_5":14937,"_28496":122449,"_3093":52753},[],{"_3704":73583,"_31315":73551,"_21707":122515,"_5":14937,"_28496":122449,"_3093":52797},[],{"_3704":73584,"_31315":73551,"_21707":122517,"_5":14937,"_28496":122449,"_3093":52800},[],{"_3704":73585,"_31315":73551,"_21707":122519,"_5":14937,"_28496":122449,"_3093":52753},[],{"_3704":73586,"_31315":73551,"_21707":122521,"_5":14937,"_28496":122449,"_3093":52805},[],{"_3704":73587,"_31315":73551,"_21707":122523,"_5":14937,"_28496":122449,"_3093":52808},[],{"_3704":73588,"_31315":73551,"_21707":122525,"_5":14937,"_28496":122449,"_3093":52811},[],{"_3704":73589,"_31315":73551,"_21707":122527,"_5":14937,"_28496":122449,"_3093":52814},[],{"_3704":73590,"_31315":73551,"_21707":122529,"_5":14937,"_28496":122449,"_3093":52817},[],{"_3704":73591,"_31315":73551,"_21707":122531,"_5":14937,"_28496":122449,"_3093":52820},[],{"_3704":73592,"_31315":73551,"_21707":122533,"_5":14937,"_28496":122449,"_3093":122534},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3704":73593,"_31315":73551,"_21707":122536,"_5":14937,"_28496":122449,"_3093":122537},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3704":73594,"_31315":73551,"_21707":122539,"_5":14937,"_28496":122449,"_3093":122540},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3704":73595,"_31315":73595,"_5":15297,"_3093":122542,"_31653":122543,"_21707":122544,"_28496":73595},"Visión general del control de acceso",[51162,122436,122437,122438],[],{"_3704":73596,"_31315":73595,"_21707":122546,"_5":14937,"_28496":73595,"_3093":122547},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3704":73597,"_31315":73595,"_5":31650,"_21707":122549,"_28496":122550,"_3093":122551},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3704":73598,"_31315":73595,"_5":31650,"_21707":122553,"_28496":122554,"_3093":122555},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3704":73599,"_31315":73595,"_5":31650,"_21707":122557,"_28496":122558,"_3093":122559},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3704":73600,"_31315":73595,"_5":31650,"_21707":122561,"_28496":122562,"_3093":122563},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3704":73601,"_31315":73595,"_5":31650,"_21707":122565,"_28496":122566,"_3093":122567},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3704":73602,"_31315":73595,"_5":31650,"_21707":122569,"_28496":122570,"_3093":122571},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3704":73603,"_31315":73595,"_5":31650,"_21707":122573,"_28496":122574,"_3093":122575},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3704":73604,"_31315":73595,"_5":31650,"_21707":122577,"_28496":122578,"_3093":122579},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3704":73605,"_31315":73595,"_5":31650,"_21707":122581,"_28496":122582,"_3093":122583},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3704":73606,"_31315":73595,"_5":31650,"_21707":122585,"_28496":122586,"_3093":122587},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3704":73607,"_31315":73595,"_5":31650,"_21707":122589,"_28496":122590,"_3093":122591},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3704":73608,"_31315":73595,"_5":31650,"_21707":122593,"_28496":122594,"_3093":122595},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3704":73609,"_31315":73595,"_5":31650,"_21707":122597,"_28496":122598,"_3093":122599},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3704":73610,"_31315":73595,"_5":31650,"_21707":122601,"_28496":122602,"_3093":122603},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3704":73611,"_31315":73595,"_5":31650,"_21707":122605,"_28496":122606,"_3093":122607},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3704":73612,"_31315":73595,"_5":31650,"_21707":122609,"_28496":122610,"_3093":121555},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3704":73613,"_31315":73595,"_5":31650,"_21707":122612,"_28496":122613,"_3093":122614},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3704":73614,"_31315":73595,"_5":31650,"_21707":122616,"_28496":122617,"_3093":122618},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3704":73615,"_31315":73595,"_5":31650,"_21707":122620,"_28496":122621,"_3093":122622},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3704":73616,"_31315":73595,"_5":31650,"_21707":122624,"_28496":122625,"_3093":122626},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3704":73617,"_31315":73595,"_5":31650,"_21707":122628,"_28496":122629,"_3093":122630},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3704":73618,"_31315":73595,"_5":31650,"_21707":122632,"_28496":122633,"_3093":122634},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3704":73619,"_31315":73595,"_5":31650,"_21707":122636,"_28496":122637,"_3093":122638},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3704":73620,"_31315":73595,"_5":31650,"_21707":122640,"_28496":122641,"_3093":122642},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3704":73621,"_31315":73595,"_5":31650,"_21707":122644,"_28496":122645,"_3093":122646},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3704":73622,"_31315":73595,"_5":31650,"_21707":122648,"_28496":122649,"_3093":122650},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3704":73623,"_31315":73595,"_5":31650,"_21707":122652,"_28496":122653,"_3093":122654},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3704":73624,"_31315":73595,"_5":31650,"_21707":122656,"_28496":122657,"_3093":122658},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3704":73625,"_31315":73595,"_5":31650,"_21707":122660,"_28496":122661,"_3093":122662},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3704":73626,"_31315":73595,"_5":31650,"_21707":122664,"_28496":122665,"_3093":122666},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3704":73627,"_31315":73595,"_5":31650,"_21707":122668,"_28496":122669,"_3093":122670},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3704":73628,"_31315":73595,"_21707":122672,"_5":14937,"_28496":73595,"_3093":122673},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3704":73629,"_31315":73595,"_21707":122675,"_5":14937,"_28496":73595,"_3093":122676},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3704":73630,"_31315":73595,"_21707":122678,"_5":14937,"_28496":73595,"_3093":122679},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3704":73631,"_31315":73595,"_21707":122681,"_5":14937,"_28496":122550,"_3093":122682},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3704":73632,"_31315":73595,"_21707":122684,"_5":14937,"_28496":122550,"_3093":122685},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3704":73633,"_31315":73595,"_21707":122687,"_5":14937,"_28496":122550,"_3093":122688},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3704":73634,"_31315":73595,"_21707":122690,"_5":14937,"_28496":122550,"_3093":122691},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3704":73635,"_31315":73595,"_21707":122693,"_5":14937,"_28496":122550,"_3093":122694},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3704":73636,"_31315":73595,"_21707":122696,"_5":14937,"_28496":122550,"_3093":122697},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3704":73637,"_31315":73595,"_21707":122699,"_5":14937,"_28496":122554,"_3093":122700},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3704":73638,"_31315":73595,"_21707":122702,"_5":14937,"_28496":122554,"_3093":122703},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3704":73639,"_31315":73595,"_21707":122705,"_5":14937,"_28496":122558,"_3093":122706},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3704":73640,"_31315":73595,"_21707":122708,"_5":14937,"_28496":122558,"_3093":122709},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3704":73641,"_31315":73595,"_21707":122711,"_5":14937,"_28496":122558,"_3093":122712},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3704":73642,"_31315":73595,"_21707":122714,"_5":14937,"_28496":122558,"_3093":122715},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3704":73643,"_31315":73595,"_21707":122717,"_5":14937,"_28496":122558,"_3093":122718},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3704":73644,"_31315":73595,"_21707":122720,"_5":14937,"_28496":122558,"_3093":122721},[],"Carga por separado las políticas concedidas a cada principal.",{"_3704":73645,"_31315":73595,"_21707":122723,"_5":14937,"_28496":122558,"_3093":122724},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3704":73646,"_31315":73595,"_21707":122726,"_5":14937,"_28496":122558,"_3093":122727},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3704":73647,"_31315":73595,"_21707":122729,"_5":14937,"_28496":122558,"_3093":122730},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3704":73648,"_31315":73595,"_21707":122732,"_5":14937,"_28496":122558,"_3093":122733},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3704":73649,"_31315":73595,"_21707":122735,"_5":14937,"_28496":122558,"_3093":122736},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3704":73650,"_31315":73595,"_21707":122738,"_5":14937,"_28496":122558,"_3093":122739},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3704":73651,"_31315":73595,"_21707":122741,"_5":14937,"_28496":122562,"_3093":122742},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3704":73652,"_31315":73595,"_21707":122744,"_5":14937,"_28496":122562,"_3093":122745},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3704":73653,"_31315":73595,"_21707":122747,"_5":14937,"_28496":122562,"_3093":122748},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3704":73654,"_31315":73595,"_21707":122750,"_5":14937,"_28496":122562,"_3093":122751},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3704":73655,"_31315":73595,"_21707":122753,"_5":14937,"_28496":122562,"_3093":122754},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3704":73656,"_31315":73595,"_21707":122756,"_5":14937,"_28496":122562,"_3093":122757},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3704":73657,"_31315":73595,"_21707":122759,"_5":14937,"_28496":122562,"_3093":122760},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3704":73658,"_31315":73595,"_21707":122762,"_5":14937,"_28496":122562,"_3093":122763},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3704":73659,"_31315":73595,"_21707":122765,"_5":14937,"_28496":122562,"_3093":122766},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3704":73660,"_31315":73595,"_21707":122768,"_5":14937,"_28496":122562,"_3093":122769},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3704":73661,"_31315":73595,"_21707":122771,"_5":14937,"_28496":122566,"_3093":122772},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3704":73662,"_31315":73595,"_21707":122774,"_5":14937,"_28496":122566,"_3093":122775},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3704":73663,"_31315":73595,"_21707":122777,"_5":14937,"_28496":122566,"_3093":122778},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3704":73664,"_31315":73595,"_21707":122780,"_5":14937,"_28496":122566,"_3093":122781},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3704":73665,"_31315":73595,"_21707":122783,"_5":14937,"_28496":122566,"_3093":122784},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3704":73666,"_31315":73595,"_21707":122786,"_5":14937,"_28496":122566,"_3093":122787},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3704":73667,"_31315":73595,"_21707":122789,"_5":14937,"_28496":122566,"_3093":122790},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3704":73668,"_31315":73595,"_21707":122792,"_5":14937,"_28496":122566,"_3093":122793},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3704":73669,"_31315":73595,"_21707":122795,"_5":14937,"_28496":122566,"_3093":122796},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3704":73670,"_31315":73595,"_21707":122798,"_5":14937,"_28496":122566,"_3093":122799},[],"Las acciones se dividen en dos grupos:",{"_3704":73671,"_31315":73595,"_21707":122801,"_5":14937,"_28496":122566,"_3093":122802},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3704":73672,"_31315":73595,"_21707":122804,"_5":14937,"_28496":122566,"_3093":122805},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3704":73673,"_31315":73595,"_21707":122807,"_5":14937,"_28496":122566,"_3093":122808},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3704":73674,"_31315":73595,"_21707":122810,"_5":14937,"_28496":122570,"_3093":122811},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3704":73675,"_31315":73595,"_21707":122813,"_5":14937,"_28496":122570,"_3093":122814},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3704":73676,"_31315":73595,"_21707":122816,"_5":14937,"_28496":122570,"_3093":122817},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3704":73677,"_31315":73595,"_21707":122819,"_5":14937,"_28496":122574,"_3093":122820},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3704":73678,"_31315":73595,"_21707":122822,"_5":14937,"_28496":122574,"_3093":122823},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3704":73679,"_31315":73595,"_21707":122825,"_5":14937,"_28496":122574,"_3093":122826},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3704":73680,"_31315":73595,"_21707":122828,"_5":14937,"_28496":122574,"_3093":122829},[],"Los operadores implementados son:",{"_3704":73681,"_31315":73595,"_21707":122831,"_5":14937,"_28496":122574,"_3093":122832},[],"`equals`, para igualdad exacta;",{"_3704":73682,"_31315":73595,"_21707":122834,"_5":14937,"_28496":122574,"_3093":122835},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3704":73683,"_31315":73595,"_21707":122837,"_5":14937,"_28496":122574,"_3093":122838},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3704":73684,"_31315":73595,"_21707":122840,"_5":14937,"_28496":122574,"_3093":122841},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3704":73685,"_31315":73595,"_21707":122843,"_5":14937,"_28496":122578,"_3093":122844},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3704":73686,"_31315":73595,"_21707":122846,"_5":14937,"_28496":122578,"_3093":122847},[],"Los modos disponibles son:",{"_3704":73687,"_31315":73595,"_21707":122849,"_5":14937,"_28496":122578,"_3093":122850},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3704":73688,"_31315":73595,"_21707":122852,"_5":14937,"_28496":122578,"_3093":122853},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3704":73689,"_31315":73595,"_21707":122855,"_5":14937,"_28496":122578,"_3093":122856},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3704":73690,"_31315":73595,"_21707":122858,"_5":14937,"_28496":122578,"_3093":122859},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3704":73691,"_31315":73595,"_21707":122861,"_5":14937,"_28496":122578,"_3093":122862},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3704":73692,"_31315":73595,"_21707":122864,"_5":14937,"_28496":122578,"_3093":122865},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3704":73693,"_31315":73595,"_21707":122867,"_5":14937,"_28496":122582,"_3093":122868},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3704":73694,"_31315":73595,"_21707":122870,"_5":14937,"_28496":122582,"_3093":122871},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3704":73695,"_31315":73595,"_21707":122873,"_5":14937,"_28496":122582,"_3093":122874},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3704":73696,"_31315":73595,"_21707":122876,"_5":14937,"_28496":122582,"_3093":122877},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3704":73697,"_31315":73595,"_21707":122879,"_5":14937,"_28496":122590,"_3093":122880},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3704":73698,"_31315":73595,"_21707":122882,"_5":14937,"_28496":122590,"_3093":122883},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3704":73699,"_31315":73595,"_21707":122885,"_5":14937,"_28496":122594,"_3093":122886},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3704":73700,"_31315":73595,"_21707":122888,"_5":14937,"_28496":122594,"_3093":122889},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3704":73701,"_31315":73595,"_21707":122891,"_5":14937,"_28496":122594,"_3093":122892},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3704":73702,"_31315":73595,"_21707":122894,"_5":14937,"_28496":122594,"_3093":122895},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3704":73703,"_31315":73595,"_21707":122897,"_5":14937,"_28496":122594,"_3093":122898},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3704":73704,"_31315":73595,"_21707":122900,"_5":14937,"_28496":122598,"_3093":122901},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3704":73705,"_31315":73595,"_21707":122903,"_5":14937,"_28496":122598,"_3093":122904},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3704":73706,"_31315":73595,"_21707":122906,"_5":14937,"_28496":122598,"_3093":122907},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3704":73707,"_31315":73595,"_21707":122909,"_5":14937,"_28496":122602,"_3093":122910},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3704":73708,"_31315":73595,"_21707":122912,"_5":14937,"_28496":122602,"_3093":122913},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3704":73709,"_31315":73595,"_21707":122915,"_5":14937,"_28496":122602,"_3093":122916},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3704":73710,"_31315":73595,"_21707":122918,"_5":14937,"_28496":122602,"_3093":122919},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3704":73711,"_31315":73595,"_21707":122921,"_5":14937,"_28496":122602,"_3093":122922},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3704":73712,"_31315":73595,"_21707":122924,"_5":14937,"_28496":122602,"_3093":122925},[],"Ten en cuenta que:",{"_3704":73713,"_31315":73595,"_21707":122927,"_5":14937,"_28496":122602,"_3093":122928},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3704":73714,"_31315":73595,"_21707":122930,"_5":14937,"_28496":122602,"_3093":122931},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3704":73715,"_31315":73595,"_21707":122933,"_5":14937,"_28496":122602,"_3093":122934},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3704":73716,"_31315":73595,"_21707":122936,"_5":14937,"_28496":122606,"_3093":122937},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3704":73717,"_31315":73595,"_21707":122939,"_5":14937,"_28496":122606,"_3093":122940},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3704":73718,"_31315":73595,"_21707":122942,"_5":14937,"_28496":122606,"_3093":122943},[],"acceso completo y de solo lectura a KMS;",{"_3704":73719,"_31315":73595,"_21707":122945,"_5":14937,"_28496":122606,"_3093":122946},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3704":73720,"_31315":73595,"_21707":122948,"_5":14937,"_28496":122606,"_3093":122949},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3704":73721,"_31315":73595,"_21707":122951,"_5":14937,"_28496":122606,"_3093":122952},[],"acceso a la interfaz;",{"_3704":73722,"_31315":73595,"_21707":122954,"_5":14937,"_28496":122606,"_3093":122955},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3704":73723,"_31315":73595,"_21707":122957,"_5":14937,"_28496":122606,"_3093":122958},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3704":73724,"_31315":73595,"_21707":122960,"_5":14937,"_28496":122606,"_3093":122961},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3704":73725,"_31315":73595,"_21707":122963,"_5":14937,"_28496":122606,"_3093":122964},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3704":73726,"_31315":73595,"_21707":122966,"_5":14937,"_28496":122606,"_3093":122967},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3704":73727,"_31315":73595,"_21707":122969,"_5":14937,"_28496":122610,"_3093":122970},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3704":73728,"_31315":73595,"_21707":122972,"_5":14937,"_28496":122610,"_3093":122973},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3704":73729,"_31315":73595,"_21707":122975,"_5":14937,"_28496":122610,"_3093":122976},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3704":73730,"_31315":73595,"_21707":122978,"_5":14937,"_28496":122613,"_3093":122979},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3704":73731,"_31315":73595,"_21707":122981,"_5":14937,"_28496":122617,"_3093":122982},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3704":73732,"_31315":73595,"_21707":122984,"_5":14937,"_28496":122617,"_3093":122985},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3704":73733,"_31315":73595,"_21707":122987,"_5":14937,"_28496":122621,"_3093":122988},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3704":73734,"_31315":73595,"_21707":122990,"_5":14937,"_28496":122625,"_3093":122991},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3704":73735,"_31315":73595,"_21707":122993,"_5":14937,"_28496":122629,"_3093":122994},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3704":73736,"_31315":73595,"_21707":122996,"_5":14937,"_28496":122633,"_3093":122997},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3704":73737,"_31315":73595,"_21707":122999,"_5":14937,"_28496":122633,"_3093":123000},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3704":73738,"_31315":73595,"_21707":123002,"_5":14937,"_28496":122637,"_3093":123003},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3704":73739,"_31315":73595,"_21707":123005,"_5":14937,"_28496":122637,"_3093":123006},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3704":73740,"_31315":73595,"_21707":123008,"_5":14937,"_28496":122637,"_3093":123009},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3704":73741,"_31315":73595,"_21707":123011,"_5":14937,"_28496":122637,"_3093":123012},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3704":73742,"_31315":73595,"_21707":123014,"_5":14937,"_28496":122637,"_3093":123015},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3704":73743,"_31315":73595,"_21707":123017,"_5":14937,"_28496":122637,"_3093":123018},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3704":73744,"_31315":73595,"_21707":123020,"_5":14937,"_28496":122637,"_3093":123021},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3704":73745,"_31315":73595,"_21707":123023,"_5":14937,"_28496":122637,"_3093":123024},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3704":73746,"_31315":73595,"_21707":123026,"_5":14937,"_28496":122641,"_3093":123027},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3704":73747,"_31315":73595,"_21707":123029,"_5":14937,"_28496":122641,"_3093":123030},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3704":73748,"_31315":73595,"_21707":123032,"_5":14937,"_28496":122641,"_3093":123033},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3704":73749,"_31315":73595,"_21707":123035,"_5":14937,"_28496":122645,"_3093":123036},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3704":73750,"_31315":73595,"_21707":123038,"_5":14937,"_28496":122645,"_3093":123039},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3704":73751,"_31315":73595,"_21707":123041,"_5":14937,"_28496":122645,"_3093":123042},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3704":73752,"_31315":73595,"_21707":123044,"_5":14937,"_28496":122645,"_3093":123045},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3704":73753,"_31315":73595,"_21707":123047,"_5":14937,"_28496":122645,"_3093":123048},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3704":73754,"_31315":73595,"_21707":123050,"_5":14937,"_28496":122645,"_3093":123051},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3704":73755,"_31315":73595,"_21707":123053,"_5":14937,"_28496":122645,"_3093":123054},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3704":73756,"_31315":73595,"_21707":123056,"_5":14937,"_28496":122645,"_3093":123057},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3704":73757,"_31315":73595,"_21707":123059,"_5":14937,"_28496":122653,"_3093":123060},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3704":73758,"_31315":73595,"_21707":123062,"_5":14937,"_28496":122657,"_3093":123063},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3704":73759,"_31315":73595,"_21707":123065,"_5":14937,"_28496":122657,"_3093":123066},[],"que exista un principal activo del tipo correcto;",{"_3704":73760,"_31315":73595,"_21707":123068,"_5":14937,"_28496":122657,"_3093":123069},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3704":73761,"_31315":73595,"_21707":123071,"_5":14937,"_28496":122657,"_3093":123072},[],"que todas las condiciones del principal se cumplan;",{"_3704":73762,"_31315":73595,"_21707":123074,"_5":14937,"_28496":122657,"_3093":123075},[],"que el principal tenga concedida la política esperada;",{"_3704":73763,"_31315":73595,"_21707":123077,"_5":14937,"_28496":122657,"_3093":123078},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3704":73764,"_31315":73595,"_21707":123080,"_5":14937,"_28496":122657,"_3093":123081},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3704":73765,"_31315":73595,"_21707":123083,"_5":14937,"_28496":122657,"_3093":123084},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3704":73766,"_31315":73595,"_21707":123086,"_5":14937,"_28496":122657,"_3093":123087},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3704":73767,"_31315":73595,"_21707":123089,"_5":14937,"_28496":122661,"_3093":123090},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3704":73768,"_31315":73595,"_21707":123092,"_5":14937,"_28496":122665,"_3093":123093},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3704":73769,"_31315":73595,"_21707":123095,"_5":14937,"_28496":122669,"_3093":123096},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3704":73770,"_31315":73595,"_21707":123098,"_5":14937,"_28496":122669,"_3093":123099},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3704":73771,"_31315":73771,"_5":15297,"_3093":123101,"_31653":123102,"_21707":123103,"_28496":73771},"Alertas y suscripciones",[51162,122436,122437],[],{"_3704":73772,"_31315":73771,"_21707":123105,"_5":14937,"_28496":73771,"_3093":123106},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3704":73773,"_31315":73771,"_5":31650,"_21707":123108,"_28496":123109,"_3093":123110},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3704":73774,"_31315":73771,"_5":31650,"_21707":123112,"_28496":123113,"_3093":123114},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3704":73775,"_31315":73771,"_5":31650,"_21707":123116,"_28496":123117,"_3093":123118},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3704":73776,"_31315":73771,"_5":31650,"_21707":123120,"_28496":123121,"_3093":123122},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3704":73777,"_31315":73771,"_5":31650,"_21707":123124,"_28496":123125,"_3093":123126},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3704":73778,"_31315":73771,"_5":31650,"_21707":123128,"_28496":123129,"_3093":123130},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3704":73779,"_31315":73771,"_5":31650,"_21707":123132,"_28496":123133,"_3093":123134},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3704":73780,"_31315":73771,"_5":31650,"_21707":123136,"_28496":123137,"_3093":123138},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3704":73781,"_31315":73771,"_5":31650,"_21707":123140,"_28496":123141,"_3093":123142},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3704":73782,"_31315":73771,"_5":31650,"_21707":123144,"_28496":123145,"_3093":123146},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3704":73783,"_31315":73771,"_5":31650,"_21707":123148,"_28496":123149,"_3093":123150},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3704":73784,"_31315":73771,"_21707":123152,"_5":14937,"_28496":73771,"_3093":123153},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3704":73785,"_31315":73771,"_21707":123155,"_5":14937,"_28496":123109,"_3093":123156},[],"Un servicio publica un evento de dominio.",{"_3704":73786,"_31315":73771,"_21707":123158,"_5":14937,"_28496":123109,"_3093":123159},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3704":73787,"_31315":73771,"_21707":123161,"_5":14937,"_28496":123109,"_3093":123162},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3704":73788,"_31315":73771,"_21707":123164,"_5":14937,"_28496":123109,"_3093":123165},[],"Lamassu entrega el evento al canal configurado.",{"_3704":73789,"_31315":73771,"_21707":123167,"_5":14937,"_28496":123109,"_3093":123168},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3704":73790,"_31315":73771,"_21707":123170,"_5":14937,"_28496":123113,"_3093":123171},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3704":73791,"_31315":73771,"_21707":123173,"_5":14937,"_28496":123113,"_3093":123174},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3704":73792,"_31315":73771,"_21707":123176,"_5":14937,"_28496":123113,"_3093":123177},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3704":73793,"_31315":73771,"_21707":123179,"_5":14937,"_28496":123113,"_3093":123180},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3704":73794,"_31315":73771,"_21707":123182,"_5":14937,"_28496":123113,"_3093":123183},[],"`apikey_options` necesita `header` y `key`.",{"_3704":73795,"_31315":73771,"_21707":123185,"_5":14937,"_28496":123113,"_3093":123186},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3704":73796,"_31315":73771,"_21707":123188,"_5":14937,"_28496":123113,"_3093":123189},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3704":73797,"_31315":73771,"_21707":123191,"_5":14937,"_28496":123113,"_3093":123192},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3704":73798,"_31315":73771,"_21707":123194,"_5":14937,"_28496":123121,"_3093":123195},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3704":73799,"_31315":73771,"_21707":123197,"_5":14937,"_28496":123125,"_3093":123198},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3704":73800,"_31315":73771,"_21707":123200,"_5":14937,"_28496":123129,"_3093":123201},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3704":73801,"_31315":73771,"_21707":123203,"_5":14937,"_28496":123129,"_3093":123204},[],"**None** notifica todas las instancias del evento.",{"_3704":73802,"_31315":73771,"_21707":123206,"_5":14937,"_28496":123129,"_3093":123207},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3704":73803,"_31315":73771,"_21707":123209,"_5":14937,"_28496":123129,"_3093":123210},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3704":73804,"_31315":73771,"_21707":123212,"_5":14937,"_28496":123129,"_3093":123213},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3704":73805,"_31315":73771,"_21707":123215,"_5":14937,"_28496":123129,"_3093":123216},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3704":73806,"_31315":73771,"_21707":123218,"_5":14937,"_28496":123129,"_3093":123219},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3704":73807,"_31315":73771,"_21707":123221,"_5":14937,"_28496":123133,"_3093":123222},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3704":73808,"_31315":73771,"_21707":123224,"_5":14937,"_28496":123137,"_3093":123225},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3704":73809,"_31315":73771,"_21707":123227,"_5":14937,"_28496":123137,"_3093":123228},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3704":73810,"_31315":73771,"_21707":123230,"_5":14937,"_28496":123137,"_3093":123231},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3704":73811,"_31315":73771,"_21707":123233,"_5":14937,"_28496":123137,"_3093":123234},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3704":73812,"_31315":73771,"_21707":123236,"_5":14937,"_28496":123137,"_3093":123237},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3704":73813,"_31315":73771,"_21707":123239,"_5":14937,"_28496":123137,"_3093":123240},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3704":73814,"_31315":73771,"_21707":123242,"_5":14937,"_28496":123137,"_3093":123243},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3704":73815,"_31315":73771,"_21707":123245,"_5":14937,"_28496":123137,"_3093":123246},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3704":73816,"_31315":73771,"_21707":123248,"_5":14937,"_28496":123141,"_3093":123249},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3704":73817,"_31315":73771,"_21707":123251,"_5":14937,"_28496":123141,"_3093":123252},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3704":73818,"_31315":73771,"_21707":123254,"_5":14937,"_28496":123141,"_3093":123255},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3704":73819,"_31315":73771,"_21707":123257,"_5":14937,"_28496":123141,"_3093":123258},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3704":73820,"_31315":73771,"_21707":123260,"_5":14937,"_28496":123141,"_3093":123261},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3704":73821,"_31315":73771,"_21707":123263,"_5":14937,"_28496":123141,"_3093":123264},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3704":73822,"_31315":73771,"_21707":123266,"_5":14937,"_28496":123141,"_3093":123267},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3704":73823,"_31315":73771,"_21707":123269,"_5":14937,"_28496":123141,"_3093":123270},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3704":73824,"_31315":73771,"_21707":123272,"_5":14937,"_28496":123145,"_3093":123273},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3704":73825,"_31315":73771,"_21707":123275,"_5":14937,"_28496":123145,"_3093":123276},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3704":73826,"_31315":73771,"_21707":123278,"_5":14937,"_28496":123149,"_3093":123279},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3704":73827,"_31315":73771,"_21707":123281,"_5":14937,"_28496":123149,"_3093":123282},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3704":73828,"_31315":73771,"_21707":123284,"_5":14937,"_28496":123149,"_3093":123285},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3704":73829,"_31315":73771,"_21707":123287,"_5":14937,"_28496":123149,"_3093":123288},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3704":73830,"_31315":73771,"_21707":123290,"_5":14937,"_28496":123149,"_3093":123291},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3704":73831,"_31315":73771,"_21707":123293,"_5":14937,"_28496":123149,"_3093":123294},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3704":73832,"_31315":73771,"_21707":123296,"_5":14937,"_28496":123149,"_3093":123297},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3704":73833,"_31315":73771,"_21707":123299,"_5":14937,"_28496":123149,"_3093":123300},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3704":73834,"_31315":73771,"_21707":123302,"_5":14937,"_28496":123149,"_3093":123303},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3704":73835,"_31315":73771,"_21707":123305,"_5":14937,"_28496":123149,"_3093":123306},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3704":73836,"_31315":73836,"_5":15297,"_3093":123308,"_31653":123309,"_21707":123310,"_28496":73836},"Registros de auditoría",[51162,122436,122437],[],{"_3704":73837,"_31315":73836,"_21707":123312,"_5":14937,"_28496":73836,"_3093":123313},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3704":73838,"_31315":73836,"_5":31650,"_21707":123315,"_28496":123316,"_3093":123317},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3704":73839,"_31315":73836,"_5":31650,"_21707":123319,"_28496":123320,"_3093":123321},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3704":73840,"_31315":73836,"_5":31650,"_21707":123323,"_28496":123324,"_3093":123325},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3704":73841,"_31315":73836,"_5":31650,"_21707":123327,"_28496":123328,"_3093":123329},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3704":73842,"_31315":73836,"_5":31650,"_21707":123331,"_28496":123332,"_3093":123333},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3704":73843,"_31315":73836,"_5":31650,"_21707":123335,"_28496":123336,"_3093":123337},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3704":73844,"_31315":73836,"_5":31650,"_21707":123339,"_28496":123340,"_3093":123341},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3704":73845,"_31315":73836,"_5":31650,"_21707":123343,"_28496":123344,"_3093":123345},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3704":73846,"_31315":73836,"_5":31650,"_21707":123347,"_28496":123348,"_3093":123349},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3704":73847,"_31315":73836,"_5":31650,"_21707":123351,"_28496":123352,"_3093":123353},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3704":73848,"_31315":73836,"_5":31650,"_21707":123355,"_28496":123356,"_3093":123357},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3704":73849,"_31315":73836,"_21707":123359,"_5":14937,"_28496":73836,"_3093":123360},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3704":73850,"_31315":73836,"_21707":123362,"_5":14937,"_28496":123316,"_3093":123363},[],"El cuerpo de auditoría incluye:",{"_3704":73851,"_31315":73836,"_21707":123365,"_5":14937,"_28496":123316,"_3093":123366},[],"input: datos recibidos por la operación;",{"_3704":73852,"_31315":73836,"_21707":123368,"_5":14937,"_28496":123316,"_3093":123369},[],"has\\_error: indica si el servicio devolvió un error;",{"_3704":73853,"_31315":73836,"_21707":123371,"_5":14937,"_28496":123316,"_3093":123372},[],"output: resultado producido o mensaje de error;",{"_3704":73854,"_31315":73836,"_21707":123374,"_5":14937,"_28496":123316,"_3093":123375},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3704":73855,"_31315":73836,"_21707":123377,"_5":14937,"_28496":123316,"_3093":123378},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3704":73856,"_31315":73836,"_21707":123380,"_5":14937,"_28496":123316,"_3093":123381},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3704":73857,"_31315":73836,"_21707":123383,"_5":14937,"_28496":123320,"_3093":123384},[],"El backend aplica auditoría a mutaciones de:",{"_3704":73858,"_31315":73836,"_21707":123386,"_5":14937,"_28496":123320,"_3093":123387},[],"autoridades, certificados y perfiles de emisión;",{"_3704":73859,"_31315":73836,"_21707":123389,"_5":14937,"_28496":123320,"_3093":123390},[],"claves y motores KMS;",{"_3704":73860,"_31315":73836,"_21707":123392,"_5":14937,"_28496":123320,"_3093":123393},[],"dispositivos e identidades;",{"_3704":73861,"_31315":73836,"_21707":123395,"_5":14937,"_28496":123320,"_3093":123396},[],"DMS y operaciones de enrolamiento;",{"_3704":73862,"_31315":73836,"_21707":123398,"_5":14937,"_28496":123320,"_3093":123399},[],"funciones de validación y CRL;",{"_3704":73863,"_31315":73836,"_21707":123401,"_5":14937,"_28496":123320,"_3093":123402},[],"principales, políticas y concesiones de autorización.",{"_3704":73864,"_31315":73836,"_21707":123404,"_5":14937,"_28496":123320,"_3093":123405},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3704":73865,"_31315":73836,"_21707":123407,"_5":14937,"_28496":123324,"_3093":123408},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3704":73866,"_31315":73836,"_21707":123410,"_5":14937,"_28496":123324,"_3093":123411},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3704":73867,"_31315":73836,"_21707":123413,"_5":14937,"_28496":123324,"_3093":123414},[],"Diseña el consumidor para:",{"_3704":73868,"_31315":73836,"_21707":123416,"_5":14937,"_28496":123324,"_3093":123417},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3704":73869,"_31315":73836,"_21707":123419,"_5":14937,"_28496":123324,"_3093":123420},[],"conservar el CloudEvent completo sin modificar;",{"_3704":73870,"_31315":73836,"_21707":123422,"_5":14937,"_28496":123324,"_3093":123423},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3704":73871,"_31315":73836,"_21707":123425,"_5":14937,"_28496":123324,"_3093":123426},[],"cifrar en tránsito y en reposo;",{"_3704":73872,"_31315":73836,"_21707":123428,"_5":14937,"_28496":123324,"_3093":123429},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3704":73873,"_31315":73836,"_21707":123431,"_5":14937,"_28496":123324,"_3093":123432},[],"aplicar una política explícita de retención y legal hold;",{"_3704":73874,"_31315":73836,"_21707":123434,"_5":14937,"_28496":123324,"_3093":123435},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3704":73875,"_31315":73836,"_21707":123437,"_5":14937,"_28496":123328,"_3093":123438},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3704":73876,"_31315":73836,"_21707":123440,"_5":14937,"_28496":123328,"_3093":123441},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3704":73877,"_31315":73836,"_21707":123443,"_5":14937,"_28496":123336,"_3093":123444},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3704":73878,"_31315":73836,"_21707":123446,"_5":14937,"_28496":123340,"_3093":123447},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3704":73879,"_31315":73836,"_21707":123449,"_5":14937,"_28496":123344,"_3093":123450},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3704":73880,"_31315":73836,"_21707":123452,"_5":14937,"_28496":123348,"_3093":123453},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3704":73881,"_31315":73836,"_21707":123455,"_5":14937,"_28496":123352,"_3093":123456},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3704":73882,"_31315":73836,"_21707":123458,"_5":14937,"_28496":123356,"_3093":123459},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3704":73883,"_31315":73836,"_21707":123461,"_5":14937,"_28496":123356,"_3093":123462},[],"aparece un evento de auditoría correcto;",{"_3704":73884,"_31315":73836,"_21707":123464,"_5":14937,"_28496":123356,"_3093":123465},[],"el principal coincide con la identidad utilizada;",{"_3704":73885,"_31315":73836,"_21707":123467,"_5":14937,"_28496":123356,"_3093":123468},[],"el consumidor lo persiste una sola vez;",{"_3704":73886,"_31315":73836,"_21707":123470,"_5":14937,"_28496":123356,"_3093":123471},[],"puede recuperarse por recurso, actor y periodo;",{"_3704":73887,"_31315":73836,"_21707":123473,"_5":14937,"_28496":123356,"_3093":123474},[],"una interrupción del consumidor produce una alerta.",{"_3704":73888,"_31315":73836,"_21707":123476,"_5":14937,"_28496":123356,"_3093":123477},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3704":73889,"_31315":73889,"_5":15297,"_3093":123479,"_31653":123480,"_21707":123481,"_28496":73889},"Arquitectura de la plataforma",[51162,122436],[],{"_3704":73890,"_31315":73889,"_21707":123483,"_5":14937,"_28496":73889,"_3093":123484},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3704":73891,"_31315":73889,"_5":31650,"_21707":123486,"_28496":123487,"_3093":123488},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3704":73892,"_31315":73889,"_5":31650,"_21707":123490,"_28496":123491,"_3093":123492},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3704":73893,"_31315":73889,"_5":31650,"_21707":123494,"_28496":123495,"_3093":123496},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3704":73894,"_31315":73889,"_5":31650,"_21707":123498,"_28496":123499,"_3093":123500},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3704":73895,"_31315":73889,"_5":31650,"_21707":123502,"_28496":123503,"_3093":123504},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3704":73896,"_31315":73889,"_21707":123506,"_5":14937,"_28496":73889,"_3093":123507},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3704":73897,"_31315":73889,"_21707":123509,"_5":14937,"_28496":73889,"_3093":123510},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3704":73898,"_31315":73889,"_21707":123512,"_5":14937,"_28496":123487,"_3093":123513},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3704":73899,"_31315":73889,"_21707":123515,"_5":14937,"_28496":123491,"_3093":123516},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3704":73900,"_31315":73889,"_21707":123518,"_5":14937,"_28496":123495,"_3093":123519},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3704":73901,"_31315":73889,"_21707":123521,"_5":14937,"_28496":123499,"_3093":123522},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3704":73902,"_31315":73889,"_21707":123524,"_5":14937,"_28496":123503,"_3093":123525},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3704":73903,"_31315":73903,"_5":15297,"_3093":123527,"_31653":123528,"_21707":123529,"_28496":73903},"Cómo funciona Lamassu",[51162,122436],[],{"_3704":73904,"_31315":73903,"_21707":123531,"_5":14937,"_28496":73903,"_3093":123532},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3704":73905,"_31315":73903,"_5":31650,"_21707":123534,"_28496":123535,"_3093":123536},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3704":73906,"_31315":73903,"_5":31650,"_21707":123538,"_28496":123539,"_3093":123540},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3704":73907,"_31315":73903,"_21707":123542,"_5":14937,"_28496":73903,"_3093":123543},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3704":73908,"_31315":73903,"_21707":123545,"_5":14937,"_28496":123535,"_3093":123546},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3704":73909,"_31315":73903,"_21707":123548,"_5":14937,"_28496":123535,"_3093":123549},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3704":73910,"_31315":73903,"_21707":123551,"_5":14937,"_28496":123535,"_3093":123552},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3704":73911,"_31315":73903,"_21707":123554,"_5":14937,"_28496":123535,"_3093":123555},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3704":73912,"_31315":73903,"_21707":123557,"_5":14937,"_28496":123535,"_3093":123558},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3704":73913,"_31315":73903,"_21707":123560,"_5":14937,"_28496":123539,"_3093":123561},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3704":73914,"_31315":73903,"_21707":123563,"_5":14937,"_28496":123539,"_3093":123564},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3704":73915,"_31315":73903,"_21707":123566,"_5":14937,"_28496":123539,"_3093":123567},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3704":73916,"_31315":73903,"_21707":123569,"_5":14937,"_28496":123539,"_3093":123570},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3704":73917,"_31315":73903,"_21707":123572,"_5":14937,"_28496":123539,"_3093":123573},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3704":73918,"_31315":73903,"_21707":123575,"_5":14937,"_28496":123539,"_3093":123576},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3704":73919,"_31315":73903,"_21707":123578,"_5":14937,"_28496":123539,"_3093":123579},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3704":73920,"_31315":73920,"_5":15297,"_3093":123581,"_31653":123582,"_21707":123583,"_28496":73920},"Dispositivos e identidades",[51162,122436,53872,123581],[],{"_3704":73921,"_31315":73920,"_21707":123585,"_5":14937,"_28496":73920,"_3093":123586},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3704":73922,"_31315":73920,"_5":31650,"_21707":123588,"_28496":123589,"_3093":123590},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3704":73923,"_31315":73920,"_5":31650,"_21707":123592,"_28496":123593,"_3093":123594},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3704":73924,"_31315":73920,"_5":31650,"_21707":123596,"_28496":123597,"_3093":123598},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3704":73925,"_31315":73920,"_5":31650,"_21707":123600,"_28496":123601,"_3093":123602},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3704":73926,"_31315":73920,"_5":31650,"_21707":123604,"_28496":123605,"_3093":123606},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3704":73927,"_31315":73920,"_5":31650,"_21707":123608,"_28496":123609,"_3093":123610},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3704":73928,"_31315":73920,"_5":31650,"_21707":123612,"_28496":123613,"_3093":123614},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3704":73929,"_31315":73920,"_5":31650,"_21707":123616,"_28496":123617,"_3093":123618},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3704":73930,"_31315":73920,"_5":31650,"_21707":123620,"_28496":123621,"_3093":123622},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3704":73931,"_31315":73920,"_5":31650,"_21707":123624,"_28496":123625,"_3093":123626},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3704":73932,"_31315":73920,"_5":31650,"_21707":123628,"_28496":123629,"_3093":123630},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3704":73933,"_31315":73920,"_21707":123632,"_5":14937,"_28496":73920,"_3093":123633},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3704":73934,"_31315":73920,"_21707":123635,"_5":14937,"_28496":73920,"_3093":123636},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3704":73935,"_31315":73920,"_21707":123638,"_5":14937,"_28496":123589,"_3093":123639},[],"Vista operativa",{"_3704":73936,"_31315":73920,"_21707":123641,"_5":14937,"_28496":123589,"_3093":123642},[],"Interpretación",{"_3704":73937,"_31315":73920,"_21707":123644,"_5":14937,"_28496":123589,"_3093":53935},[],{"_3704":73938,"_31315":73920,"_21707":123646,"_5":14937,"_28496":123589,"_3093":123647},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3704":73939,"_31315":73920,"_21707":123649,"_5":14937,"_28496":123589,"_3093":53941},[],{"_3704":73940,"_31315":73920,"_21707":123651,"_5":14937,"_28496":123589,"_3093":123652},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3704":73941,"_31315":73920,"_21707":123654,"_5":14937,"_28496":123589,"_3093":53947},[],{"_3704":73942,"_31315":73920,"_21707":123656,"_5":14937,"_28496":123589,"_3093":123657},[],"La identidad está en la ventana operativa de renovación.",{"_3704":73943,"_31315":73920,"_21707":123659,"_5":14937,"_28496":123589,"_3093":53953},[],{"_3704":73944,"_31315":73920,"_21707":123661,"_5":14937,"_28496":123589,"_3093":123662},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3704":73945,"_31315":73920,"_21707":123664,"_5":14937,"_28496":123589,"_3093":53959},[],{"_3704":73946,"_31315":73920,"_21707":123666,"_5":14937,"_28496":123589,"_3093":123667},[],"La identidad ha vencido.",{"_3704":73947,"_31315":73920,"_21707":123669,"_5":14937,"_28496":123589,"_3093":53965},[],{"_3704":73948,"_31315":73920,"_21707":123671,"_5":14937,"_28496":123589,"_3093":123672},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3704":73949,"_31315":73920,"_21707":123674,"_5":14937,"_28496":123589,"_3093":53971},[],{"_3704":73950,"_31315":73920,"_21707":123676,"_5":14937,"_28496":123589,"_3093":123677},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3704":73951,"_31315":73920,"_21707":123679,"_5":14937,"_28496":123589,"_3093":123680},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3704":73952,"_31315":73920,"_21707":123682,"_5":14937,"_28496":123593,"_3093":123683},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3704":73953,"_31315":73920,"_21707":123685,"_5":14937,"_28496":123593,"_3093":123686},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3704":73954,"_31315":73920,"_21707":123688,"_5":14937,"_28496":123593,"_3093":123689},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3704":73955,"_31315":73920,"_21707":123691,"_5":14937,"_28496":123593,"_3093":123692},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3704":73956,"_31315":73920,"_21707":123694,"_5":14937,"_28496":123597,"_3093":123695},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3704":73957,"_31315":73920,"_21707":123697,"_5":14937,"_28496":123601,"_3093":123698},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3704":73958,"_31315":73920,"_21707":123700,"_5":14937,"_28496":123605,"_3093":123701},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3704":73959,"_31315":73920,"_21707":123703,"_5":14937,"_28496":123609,"_3093":123704},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3704":73960,"_31315":73920,"_21707":123706,"_5":14937,"_28496":123613,"_3093":123707},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3704":73961,"_31315":73920,"_21707":123709,"_5":14937,"_28496":123613,"_3093":123710},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3704":73962,"_31315":73920,"_21707":123712,"_5":14937,"_28496":123617,"_3093":123713},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3704":73963,"_31315":73920,"_21707":123715,"_5":14937,"_28496":123617,"_3093":123716},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3704":73964,"_31315":73920,"_21707":123718,"_5":14937,"_28496":123617,"_3093":123719},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3704":73965,"_31315":73920,"_21707":123721,"_5":14937,"_28496":123617,"_3093":123722},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3704":73966,"_31315":73920,"_21707":123724,"_5":14937,"_28496":123617,"_3093":123725},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3704":73967,"_31315":73920,"_21707":123727,"_5":14937,"_28496":123617,"_3093":123728},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3704":73968,"_31315":73920,"_21707":123730,"_5":14937,"_28496":123621,"_3093":123731},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3704":73969,"_31315":73920,"_21707":123733,"_5":14937,"_28496":123621,"_3093":123734},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3704":73970,"_31315":73920,"_21707":123736,"_5":14937,"_28496":123621,"_3093":123737},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3704":73971,"_31315":73920,"_21707":123739,"_5":14937,"_28496":123625,"_3093":123740},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3704":73972,"_31315":73920,"_21707":123742,"_5":14937,"_28496":123625,"_3093":123743},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3704":73973,"_31315":73920,"_21707":123745,"_5":14937,"_28496":123625,"_3093":123746},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3704":73974,"_31315":73920,"_21707":123748,"_5":14937,"_28496":123625,"_3093":123749},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3704":73975,"_31315":73920,"_21707":123751,"_5":14937,"_28496":123629,"_3093":123752},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3704":73976,"_31315":73920,"_21707":123754,"_5":14937,"_28496":123629,"_3093":123755},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3704":73977,"_31315":73977,"_5":15297,"_3093":123757,"_31653":123758,"_21707":123760,"_28496":73977},"Identidad inicial y autenticación",[51162,122436,53872,123581,123759],"Enrolamiento con PKI",[],{"_3704":73978,"_31315":73977,"_21707":123762,"_5":14937,"_28496":73977,"_3093":123763},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3704":73979,"_31315":73977,"_5":31650,"_21707":123765,"_28496":123766,"_3093":123767},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3704":73980,"_31315":73977,"_5":31650,"_21707":123769,"_28496":123770,"_3093":123771},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3704":73981,"_31315":73977,"_5":31650,"_21707":123773,"_28496":123774,"_3093":123775},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3704":73982,"_31315":73977,"_5":31650,"_21707":123777,"_28496":123778,"_3093":123779},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3704":73983,"_31315":73977,"_5":31650,"_21707":123781,"_28496":123782,"_3093":123783},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3704":73984,"_31315":73977,"_21707":123785,"_5":14937,"_28496":73977,"_3093":123786},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3704":73985,"_31315":73977,"_21707":123788,"_5":14937,"_28496":123766,"_3093":123789},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3704":73986,"_31315":73977,"_21707":123791,"_5":14937,"_28496":123766,"_3093":123792},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3704":73987,"_31315":73977,"_21707":123794,"_5":14937,"_28496":123770,"_3093":123795},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3704":73988,"_31315":73977,"_21707":123797,"_5":14937,"_28496":123770,"_3093":123798},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3704":73989,"_31315":73977,"_21707":123800,"_5":14937,"_28496":123770,"_3093":123801},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3704":73990,"_31315":73977,"_21707":123803,"_5":14937,"_28496":123774,"_3093":123804},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3704":73991,"_31315":73977,"_21707":123806,"_5":14937,"_28496":123774,"_3093":123807},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3704":73992,"_31315":73977,"_21707":123809,"_5":14937,"_28496":123778,"_3093":123810},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3704":73993,"_31315":73977,"_21707":123812,"_5":14937,"_28496":123778,"_3093":123813},[],"Ejemplo de cuerpo:",{"_3704":73994,"_31315":73977,"_21707":123815,"_5":14937,"_28496":123778,"_3093":123816},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3704":73995,"_31315":73977,"_21707":123818,"_5":14937,"_28496":123778,"_3093":123819},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3704":73996,"_31315":73977,"_21707":123821,"_5":14937,"_28496":123778,"_3093":123822},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3704":73997,"_31315":73977,"_21707":123824,"_5":14937,"_28496":123778,"_3093":123825},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3704":73998,"_31315":73977,"_21707":123827,"_5":14937,"_28496":123782,"_3093":123828},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3704":73999,"_31315":73977,"_21707":123830,"_5":14937,"_28496":123782,"_3093":123831},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3704":74000,"_31315":73977,"_21707":123833,"_5":14937,"_28496":123782,"_3093":123834},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3704":74001,"_31315":73977,"_21707":123836,"_5":14937,"_28496":123782,"_3093":123837},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3704":74002,"_31315":74002,"_5":15297,"_3093":123839,"_31653":123840,"_21707":123841,"_28496":74002},"Configura y opera el DMS",[51162,122436,53872,123581,123759],[],{"_3704":74003,"_31315":74002,"_21707":123843,"_5":14937,"_28496":74002,"_3093":123844},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3704":74004,"_31315":74002,"_5":31650,"_21707":123846,"_28496":123847,"_3093":120944},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3704":74005,"_31315":74002,"_5":31650,"_21707":123849,"_28496":123850,"_3093":123851},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3704":74006,"_31315":74002,"_5":31650,"_21707":123853,"_28496":123854,"_3093":123855},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3704":74007,"_31315":74002,"_5":31650,"_21707":123857,"_28496":123858,"_3093":123859},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3704":74008,"_31315":74002,"_5":31650,"_21707":123861,"_28496":123862,"_3093":123863},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3704":74009,"_31315":74002,"_5":31650,"_21707":123865,"_28496":123866,"_3093":123867},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3704":74010,"_31315":74002,"_5":31650,"_21707":123869,"_28496":123870,"_3093":123871},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3704":74011,"_31315":74002,"_5":31650,"_21707":123873,"_28496":123874,"_3093":123875},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3704":74012,"_31315":74002,"_5":31650,"_21707":123877,"_28496":123878,"_3093":54176},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3704":74013,"_31315":74002,"_5":31650,"_21707":123880,"_28496":123881,"_3093":54180},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3704":74014,"_31315":74002,"_5":31650,"_21707":123883,"_28496":123884,"_3093":123885},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3704":74015,"_31315":74002,"_5":31650,"_21707":123887,"_28496":123888,"_3093":123889},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3704":74016,"_31315":74002,"_5":31650,"_21707":123891,"_28496":123892,"_3093":123893},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3704":74017,"_31315":74002,"_5":31650,"_21707":123895,"_28496":123896,"_3093":123897},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3704":74018,"_31315":74002,"_5":31650,"_21707":123899,"_28496":123900,"_3093":54200},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3704":74019,"_31315":74002,"_5":31650,"_21707":123902,"_28496":123903,"_3093":123904},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3704":74020,"_31315":74002,"_5":31650,"_21707":123906,"_28496":123907,"_3093":123908},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3704":74021,"_31315":74002,"_5":31650,"_21707":123910,"_28496":123911,"_3093":123912},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3704":74022,"_31315":74002,"_21707":123914,"_5":14937,"_28496":74002,"_3093":123915},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3704":74023,"_31315":74002,"_21707":123917,"_5":14937,"_28496":123847,"_3093":123918},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3704":74024,"_31315":74002,"_21707":123920,"_5":14937,"_28496":123847,"_3093":123921},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3704":74025,"_31315":74002,"_21707":123923,"_5":14937,"_28496":123854,"_3093":123924},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3704":74026,"_31315":74002,"_21707":123926,"_5":14937,"_28496":123858,"_3093":123927},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3704":74027,"_31315":74002,"_21707":123929,"_5":14937,"_28496":123862,"_3093":123930},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3704":74028,"_31315":74002,"_21707":123932,"_5":14937,"_28496":123866,"_3093":123933},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3704":74029,"_31315":74002,"_21707":123935,"_5":14937,"_28496":123870,"_3093":123936},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3704":74030,"_31315":74002,"_21707":123938,"_5":14937,"_28496":123878,"_3093":123939},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3704":74031,"_31315":74002,"_21707":123941,"_5":14937,"_28496":123878,"_3093":123942},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3704":74032,"_31315":74002,"_21707":123944,"_5":14937,"_28496":123881,"_3093":123945},[],"Campo de `settings.enrollment_settings`",{"_3704":74033,"_31315":74002,"_21707":123947,"_5":14937,"_28496":123881,"_3093":123948},[],"Decisión",{"_3704":74034,"_31315":74002,"_21707":123950,"_5":14937,"_28496":123881,"_3093":54251},[],{"_3704":74035,"_31315":74002,"_21707":123952,"_5":14937,"_28496":123881,"_3093":123953},[],"`EST_RFC7030` para estas operaciones.",{"_3704":74036,"_31315":74002,"_21707":123955,"_5":14937,"_28496":123881,"_3093":54257},[],{"_3704":74037,"_31315":74002,"_21707":123957,"_5":14937,"_28496":123881,"_3093":123958},[],"ID de la CA que firmará.",{"_3704":74038,"_31315":74002,"_21707":123960,"_5":14937,"_28496":123881,"_3093":54263},[],{"_3704":74039,"_31315":74002,"_21707":123962,"_5":14937,"_28496":123881,"_3093":123963},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3704":74040,"_31315":74002,"_21707":123965,"_5":14937,"_28496":123881,"_3093":54269},[],{"_3704":74041,"_31315":74002,"_21707":123967,"_5":14937,"_28496":123881,"_3093":123968},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3704":74042,"_31315":74002,"_21707":123970,"_5":14937,"_28496":123881,"_3093":54275},[],{"_3704":74043,"_31315":74002,"_21707":123972,"_5":14937,"_28496":123881,"_3093":123973},[],"Uno de los cuatro modos de autenticación.",{"_3704":74044,"_31315":74002,"_21707":123975,"_5":14937,"_28496":123881,"_3093":123976},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3704":74045,"_31315":74002,"_21707":123978,"_5":14937,"_28496":123884,"_3093":123979},[],"Los bloques son independientes:",{"_3704":74046,"_31315":74002,"_21707":123981,"_5":14937,"_28496":123884,"_3093":123982},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3704":74047,"_31315":74002,"_21707":123984,"_5":14937,"_28496":123884,"_3093":123985},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3704":74048,"_31315":74002,"_21707":123987,"_5":14937,"_28496":123884,"_3093":54293},[],{"_3704":74049,"_31315":74002,"_21707":123989,"_5":14937,"_28496":123884,"_3093":123990},[],"Control aplicado en la operación configurada",{"_3704":74050,"_31315":74002,"_21707":123992,"_5":14937,"_28496":123884,"_3093":54299},[],{"_3704":74051,"_31315":74002,"_21707":123994,"_5":14937,"_28496":123884,"_3093":123995},[],"Validación del certificado presentado.",{"_3704":74052,"_31315":74002,"_21707":123997,"_5":14937,"_28496":123884,"_3093":54305},[],{"_3704":74053,"_31315":74002,"_21707":123999,"_5":14937,"_28496":123884,"_3093":124000},[],"Autorización del webhook configurado.",{"_3704":74054,"_31315":74002,"_21707":124002,"_5":14937,"_28496":123884,"_3093":54311},[],{"_3704":74055,"_31315":74002,"_21707":124004,"_5":14937,"_28496":123884,"_3093":124005},[],"Validación del certificado y, después, aprobación del webhook.",{"_3704":74056,"_31315":74002,"_21707":124007,"_5":14937,"_28496":123884,"_3093":54317},[],{"_3704":74057,"_31315":74002,"_21707":124009,"_5":14937,"_28496":123884,"_3093":124010},[],"Sin autenticación del solicitante por el DMS.",{"_3704":74058,"_31315":74002,"_21707":124012,"_5":14937,"_28496":123884,"_3093":124013},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3704":74059,"_31315":74002,"_21707":124015,"_5":14937,"_28496":123884,"_3093":124016},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3704":74060,"_31315":74002,"_21707":124018,"_5":14937,"_28496":123884,"_3093":124019},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados — y CAs intermedias de la cadena — que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified** — un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3704":74061,"_31315":74002,"_21707":124021,"_5":14937,"_28496":123884,"_3093":124022},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro — **Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado — y la nota de No authentication se presenta también como alerta de aviso.",{"_3704":74062,"_31315":74002,"_21707":124024,"_5":14937,"_28496":123884,"_3093":124025},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3704":74063,"_31315":74002,"_21707":124027,"_5":14937,"_28496":123884,"_3093":124028},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3704":74064,"_31315":74002,"_21707":124030,"_5":14937,"_28496":123884,"_3093":124031},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3704":74065,"_31315":74002,"_21707":124033,"_5":14937,"_28496":123888,"_3093":124034},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3704":74066,"_31315":74002,"_21707":124036,"_5":14937,"_28496":123888,"_3093":124037},[],"Campo de `external_webhook_settings`",{"_3704":74067,"_31315":74002,"_21707":124039,"_5":14937,"_28496":123888,"_3093":123948},[],{"_3704":74068,"_31315":74002,"_21707":124041,"_5":14937,"_28496":123888,"_3093":54352},[],{"_3704":74069,"_31315":74002,"_21707":124043,"_5":14937,"_28496":123888,"_3093":124044},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3704":74070,"_31315":74002,"_21707":124046,"_5":14937,"_28496":123888,"_3093":54358},[],{"_3704":74071,"_31315":74002,"_21707":124048,"_5":14937,"_28496":123888,"_3093":124049},[],"`POST` o `PUT`; `POST` por defecto.",{"_3704":74072,"_31315":74002,"_21707":124051,"_5":14937,"_28496":123888,"_3093":54364},[],{"_3704":74073,"_31315":74002,"_21707":124053,"_5":14937,"_28496":123888,"_3093":124054},[],"Etiqueta usada en los logs del servicio.",{"_3704":74074,"_31315":74002,"_21707":124056,"_5":14937,"_28496":123888,"_3093":54370},[],{"_3704":74075,"_31315":74002,"_21707":124058,"_5":14937,"_28496":123888,"_3093":124059},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3704":74076,"_31315":74002,"_21707":124061,"_5":14937,"_28496":123888,"_3093":54376},[],{"_3704":74077,"_31315":74002,"_21707":124063,"_5":14937,"_28496":123888,"_3093":124064},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3704":74078,"_31315":74002,"_21707":124066,"_5":14937,"_28496":123888,"_3093":54382},[],{"_3704":74079,"_31315":74002,"_21707":124068,"_5":14937,"_28496":123888,"_3093":124069},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3704":74080,"_31315":74002,"_21707":124071,"_5":14937,"_28496":123888,"_3093":54388},[],{"_3704":74081,"_31315":74002,"_21707":124073,"_5":14937,"_28496":123888,"_3093":124074},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3704":74082,"_31315":74002,"_21707":124076,"_5":14937,"_28496":123888,"_3093":54394},[],{"_3704":74083,"_31315":74002,"_21707":124078,"_5":14937,"_28496":123888,"_3093":124079},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3704":74084,"_31315":74002,"_21707":124081,"_5":14937,"_28496":123888,"_3093":54400},[],{"_3704":74085,"_31315":74002,"_21707":124083,"_5":14937,"_28496":123888,"_3093":124084},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3704":74086,"_31315":74002,"_21707":124086,"_5":14937,"_28496":123888,"_3093":54406},[],{"_3704":74087,"_31315":74002,"_21707":124088,"_5":14937,"_28496":123888,"_3093":124089},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3704":74088,"_31315":74002,"_21707":124091,"_5":14937,"_28496":123888,"_3093":124092},[],"Reglas de esa configuración:",{"_3704":74089,"_31315":74002,"_21707":124094,"_5":14937,"_28496":123888,"_3093":124095},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3704":74090,"_31315":74002,"_21707":124097,"_5":14937,"_28496":123888,"_3093":124098},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3704":74091,"_31315":74002,"_21707":124100,"_5":14937,"_28496":123888,"_3093":124101},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3704":74092,"_31315":74002,"_21707":124103,"_5":14937,"_28496":123888,"_3093":124104},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3704":74093,"_31315":74002,"_21707":124106,"_5":14937,"_28496":123888,"_3093":124107},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3704":74094,"_31315":74002,"_21707":124109,"_5":14937,"_28496":123888,"_3093":124110},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3704":74095,"_31315":74002,"_21707":124112,"_5":14937,"_28496":123888,"_3093":124113},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3704":74096,"_31315":74002,"_21707":124115,"_5":14937,"_28496":123888,"_3093":124116},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3704":74097,"_31315":74002,"_21707":124118,"_5":14937,"_28496":123888,"_3093":124119},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3704":74098,"_31315":74002,"_21707":124121,"_5":14937,"_28496":123892,"_3093":124122},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3704":74099,"_31315":74002,"_21707":124124,"_5":14937,"_28496":123896,"_3093":124125},[],"Campo de `settings.reenrollment_settings`",{"_3704":74100,"_31315":74002,"_21707":124127,"_5":14937,"_28496":123896,"_3093":124128},[],"Función",{"_3704":74101,"_31315":74002,"_21707":124130,"_5":14937,"_28496":123896,"_3093":54450},[],{"_3704":74102,"_31315":74002,"_21707":124132,"_5":14937,"_28496":123896,"_3093":124133},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3704":74103,"_31315":74002,"_21707":124135,"_5":14937,"_28496":123896,"_3093":54456},[],{"_3704":74104,"_31315":74002,"_21707":124137,"_5":14937,"_28496":123896,"_3093":124138},[],"Umbral operativo preventivo de monitorización.",{"_3704":74105,"_31315":74002,"_21707":124140,"_5":14937,"_28496":123896,"_3093":54462},[],{"_3704":74106,"_31315":74002,"_21707":124142,"_5":14937,"_28496":123896,"_3093":124143},[],"Umbral operativo crítico de monitorización.",{"_3704":74107,"_31315":74002,"_21707":124145,"_5":14937,"_28496":123896,"_3093":54468},[],{"_3704":74108,"_31315":74002,"_21707":124147,"_5":14937,"_28496":123896,"_3093":124148},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3704":74109,"_31315":74002,"_21707":124150,"_5":14937,"_28496":123896,"_3093":54474},[],{"_3704":74110,"_31315":74002,"_21707":124152,"_5":14937,"_28496":123896,"_3093":124153},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3704":74111,"_31315":74002,"_21707":124155,"_5":14937,"_28496":123896,"_3093":54480},[],{"_3704":74112,"_31315":74002,"_21707":124157,"_5":14937,"_28496":123896,"_3093":124158},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3704":74113,"_31315":74002,"_21707":124160,"_5":14937,"_28496":123896,"_3093":124161},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3704":74114,"_31315":74002,"_21707":124163,"_5":14937,"_28496":123900,"_3093":124164},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3704":74115,"_31315":74002,"_21707":124166,"_5":14937,"_28496":123903,"_3093":121308},[],{"_3704":74116,"_31315":74002,"_21707":124168,"_5":14937,"_28496":123903,"_3093":124169},[],"Qué publica",{"_3704":74117,"_31315":74002,"_21707":124171,"_5":14937,"_28496":123903,"_3093":54497},[],{"_3704":74118,"_31315":74002,"_21707":124173,"_5":14937,"_28496":123903,"_3093":124174},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3704":74119,"_31315":74002,"_21707":124176,"_5":14937,"_28496":123903,"_3093":54503},[],{"_3704":74120,"_31315":74002,"_21707":124178,"_5":14937,"_28496":123903,"_3093":124179},[],"Certificado de la CA emisora seleccionada.",{"_3704":74121,"_31315":74002,"_21707":124181,"_5":14937,"_28496":123903,"_3093":54509},[],{"_3704":74122,"_31315":74002,"_21707":124183,"_5":14937,"_28496":123903,"_3093":124184},[],"Certificados de las CAs elegidas explícitamente.",{"_3704":74123,"_31315":74002,"_21707":124186,"_5":14937,"_28496":123903,"_3093":124187},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3704":74124,"_31315":74002,"_21707":124189,"_5":14937,"_28496":123907,"_3093":124190},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3704":74125,"_31315":74002,"_21707":124192,"_5":14937,"_28496":123907,"_3093":124193},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3704":74126,"_31315":74002,"_21707":124195,"_5":14937,"_28496":123907,"_3093":124196},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3704":74127,"_31315":74002,"_21707":124198,"_5":14937,"_28496":123911,"_3093":124199},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3704":74128,"_31315":74128,"_5":15297,"_3093":124201,"_31653":124202,"_21707":124203,"_28496":74128},"Integra el cliente EST",[51162,122436,53872,123581,123759],[],{"_3704":74129,"_31315":74128,"_21707":124205,"_5":14937,"_28496":74128,"_3093":124206},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3704":74130,"_31315":74128,"_5":31650,"_21707":124208,"_28496":124209,"_3093":120944},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3704":74131,"_31315":74128,"_5":31650,"_21707":124211,"_28496":124212,"_3093":124213},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3704":74132,"_31315":74128,"_5":31650,"_21707":124215,"_28496":124216,"_3093":124217},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3704":74133,"_31315":74128,"_5":31650,"_21707":124219,"_28496":124220,"_3093":124221},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3704":74134,"_31315":74128,"_5":31650,"_21707":124223,"_28496":124224,"_3093":124225},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3704":74135,"_31315":74128,"_5":31650,"_21707":124227,"_28496":124228,"_3093":124229},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3704":74136,"_31315":74128,"_21707":124231,"_5":14937,"_28496":74128,"_3093":124232},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3704":74137,"_31315":74128,"_21707":124234,"_5":14937,"_28496":124209,"_3093":124235},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3704":74138,"_31315":74128,"_21707":124237,"_5":14937,"_28496":124209,"_3093":124238},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3704":74139,"_31315":74128,"_21707":124240,"_5":14937,"_28496":124209,"_3093":124241},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3704":74140,"_31315":74128,"_21707":124243,"_5":14937,"_28496":124212,"_3093":124244},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3704":74141,"_31315":74128,"_21707":124246,"_5":14937,"_28496":124212,"_3093":124247},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3704":74142,"_31315":74128,"_21707":124249,"_5":14937,"_28496":124216,"_3093":124250},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3704":74143,"_31315":74128,"_21707":124252,"_5":14937,"_28496":124216,"_3093":124253},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3704":74144,"_31315":74128,"_21707":124255,"_5":14937,"_28496":124220,"_3093":124256},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3704":74145,"_31315":74128,"_21707":124258,"_5":14937,"_28496":124220,"_3093":124259},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3704":74146,"_31315":74128,"_21707":124261,"_5":14937,"_28496":124224,"_3093":124262},[],"Para el caso de una raíz que emite directamente:",{"_3704":74147,"_31315":74128,"_21707":124264,"_5":14937,"_28496":124224,"_3093":124265},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3704":74148,"_31315":74128,"_21707":124267,"_5":14937,"_28496":124224,"_3093":124268},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3704":74149,"_31315":74128,"_21707":124270,"_5":14937,"_28496":124228,"_3093":124271},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3704":74150,"_31315":74150,"_5":15297,"_3093":124273,"_31653":124274,"_21707":124275,"_28496":74150},"Referencia EST",[51162,122436,53872,123581,123759],[],{"_3704":74151,"_31315":74150,"_21707":124277,"_5":14937,"_28496":74150,"_3093":124278},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3704":74152,"_31315":74150,"_5":31650,"_21707":124280,"_28496":124281,"_3093":124282},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3704":74153,"_31315":74150,"_5":31650,"_21707":124284,"_28496":124285,"_3093":23510},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3704":74154,"_31315":74150,"_5":31650,"_21707":124287,"_28496":124288,"_3093":27025},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3704":74155,"_31315":74150,"_5":31650,"_21707":124290,"_28496":124291,"_3093":27032},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3704":74156,"_31315":74150,"_5":31650,"_21707":124293,"_28496":124294,"_3093":26294},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3704":74157,"_31315":74150,"_5":31650,"_21707":124296,"_28496":124297,"_3093":124298},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3704":74158,"_31315":74150,"_5":31650,"_21707":124300,"_28496":124301,"_3093":124302},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3704":74159,"_31315":74150,"_5":31650,"_21707":124304,"_28496":124305,"_3093":124306},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3704":74160,"_31315":74150,"_21707":124308,"_5":14937,"_28496":74150,"_3093":124309},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3704":74161,"_31315":74150,"_21707":124311,"_5":14937,"_28496":124281,"_3093":124312},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3704":74162,"_31315":74150,"_21707":124314,"_5":14937,"_28496":124281,"_3093":122196},[],{"_3704":74163,"_31315":74150,"_21707":124316,"_5":14937,"_28496":124281,"_3093":124317},[],"Método",{"_3704":74164,"_31315":74150,"_21707":124319,"_5":14937,"_28496":124281,"_3093":124320},[],"Autenticación y condición",{"_3704":74165,"_31315":74150,"_21707":124322,"_5":14937,"_28496":124281,"_3093":54652},[],{"_3704":74166,"_31315":74150,"_21707":124324,"_5":14937,"_28496":124281,"_3093":54655},[],{"_3704":74167,"_31315":74150,"_21707":124326,"_5":14937,"_28496":124281,"_3093":124327},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3704":74168,"_31315":74150,"_21707":124329,"_5":14937,"_28496":124281,"_3093":54661},[],{"_3704":74169,"_31315":74150,"_21707":124331,"_5":14937,"_28496":124281,"_3093":54664},[],{"_3704":74170,"_31315":74150,"_21707":124333,"_5":14937,"_28496":124281,"_3093":124334},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3704":74171,"_31315":74150,"_21707":124336,"_5":14937,"_28496":124281,"_3093":54670},[],{"_3704":74172,"_31315":74150,"_21707":124338,"_5":14937,"_28496":124281,"_3093":54664},[],{"_3704":74173,"_31315":74150,"_21707":124340,"_5":14937,"_28496":124281,"_3093":124341},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3704":74174,"_31315":74150,"_21707":124343,"_5":14937,"_28496":124281,"_3093":54678},[],{"_3704":74175,"_31315":74150,"_21707":124345,"_5":14937,"_28496":124281,"_3093":54664},[],{"_3704":74176,"_31315":74150,"_21707":124347,"_5":14937,"_28496":124281,"_3093":124348},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3704":74177,"_31315":74150,"_21707":124350,"_5":14937,"_28496":124281,"_3093":124351},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3704":74178,"_31315":74150,"_21707":124353,"_5":14937,"_28496":124285,"_3093":124354},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3704":74179,"_31315":74150,"_21707":124356,"_5":14937,"_28496":124285,"_3093":124357},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3704":74180,"_31315":74150,"_21707":124359,"_5":14937,"_28496":124288,"_3093":124360},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3704":74181,"_31315":74150,"_21707":124362,"_5":14937,"_28496":124288,"_3093":124363},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3704":74182,"_31315":74150,"_21707":124365,"_5":14937,"_28496":124291,"_3093":124366},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3704":74183,"_31315":74150,"_21707":124368,"_5":14937,"_28496":124291,"_3093":124369},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3704":74184,"_31315":74150,"_21707":124371,"_5":14937,"_28496":124294,"_3093":124372},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3704":74185,"_31315":74150,"_21707":124374,"_5":14937,"_28496":124294,"_3093":124375},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3704":74186,"_31315":74150,"_21707":124377,"_5":14937,"_28496":124297,"_3093":124378},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3704":74187,"_31315":74150,"_21707":124380,"_5":14937,"_28496":124297,"_3093":124381},[],"Parte",{"_3704":74188,"_31315":74150,"_21707":124383,"_5":14937,"_28496":124297,"_3093":124384},[],"Contenido tras decodificar su Base64",{"_3704":74189,"_31315":74150,"_21707":124386,"_5":14937,"_28496":124297,"_3093":54722},[],{"_3704":74190,"_31315":74150,"_21707":124388,"_5":14937,"_28496":124297,"_3093":124389},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3704":74191,"_31315":74150,"_21707":124391,"_5":14937,"_28496":124297,"_3093":54728},[],{"_3704":74192,"_31315":74150,"_21707":124393,"_5":14937,"_28496":124297,"_3093":124394},[],"PKCS#7 DER con el certificado emitido.",{"_3704":74193,"_31315":74150,"_21707":124396,"_5":14937,"_28496":124297,"_3093":124397},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3704":74194,"_31315":74150,"_21707":124399,"_5":14937,"_28496":124301,"_3093":124400},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3704":74195,"_31315":74150,"_21707":124402,"_5":14937,"_28496":124301,"_3093":124403},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3704":74196,"_31315":74150,"_21707":124405,"_5":14937,"_28496":124301,"_3093":124406},[],"Convierte y comprueba el resultado:",{"_3704":74197,"_31315":74150,"_21707":124408,"_5":14937,"_28496":124301,"_3093":124409},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3704":74198,"_31315":74150,"_21707":124411,"_5":14937,"_28496":124305,"_3093":124412},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3704":74199,"_31315":74150,"_21707":124414,"_5":14937,"_28496":124305,"_3093":124415},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3704":74200,"_31315":74200,"_5":15297,"_3093":123759,"_31653":124417,"_21707":124418,"_28496":74200},[51162,122436,53872,123581,123759],[],{"_3704":74201,"_31315":74200,"_21707":124420,"_5":14937,"_28496":74200,"_3093":124421},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3704":74202,"_31315":74200,"_5":31650,"_21707":124423,"_28496":124424,"_3093":124425},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3704":74203,"_31315":74200,"_5":31650,"_21707":124427,"_28496":124428,"_3093":124429},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3704":74204,"_31315":74200,"_5":31650,"_21707":124431,"_28496":124432,"_3093":124433},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3704":74205,"_31315":74200,"_21707":124435,"_5":14937,"_28496":74200,"_3093":124436},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3704":74206,"_31315":74200,"_21707":124438,"_5":14937,"_28496":124424,"_3093":124439},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3704":74207,"_31315":74200,"_21707":124441,"_5":14937,"_28496":124424,"_3093":124442},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3704":74208,"_31315":74200,"_21707":124444,"_5":14937,"_28496":124424,"_3093":124445},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3704":74209,"_31315":74200,"_21707":124447,"_5":14937,"_28496":124424,"_3093":124448},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3704":74210,"_31315":74200,"_21707":124450,"_5":14937,"_28496":124424,"_3093":124451},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3704":74211,"_31315":74200,"_21707":124453,"_5":14937,"_28496":124424,"_3093":124454},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3704":74212,"_31315":74200,"_21707":124456,"_5":14937,"_28496":124428,"_3093":124457},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3704":74213,"_31315":74200,"_21707":124459,"_5":14937,"_28496":124428,"_3093":124460},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3704":74214,"_31315":74200,"_21707":124462,"_5":14937,"_28496":124428,"_3093":124463},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3704":74215,"_31315":74200,"_21707":124465,"_5":14937,"_28496":124428,"_3093":124466},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3704":74216,"_31315":74200,"_21707":124468,"_5":14937,"_28496":124432,"_3093":124469},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3704":74217,"_31315":74200,"_21707":124471,"_5":14937,"_28496":124432,"_3093":124472},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3704":74218,"_31315":74200,"_21707":124474,"_5":14937,"_28496":124432,"_3093":124475},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3704":74219,"_31315":74200,"_21707":124477,"_5":14937,"_28496":124432,"_3093":124478},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3704":74220,"_31315":74200,"_21707":124480,"_5":14937,"_28496":124432,"_3093":124481},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3704":74221,"_31315":74221,"_5":15297,"_3093":124483,"_31653":124484,"_21707":124485,"_28496":74221},"Estrategias de aprovisionamiento",[51162,122436,53872,123581,123759],[],{"_3704":74222,"_31315":74221,"_21707":124487,"_5":14937,"_28496":74221,"_3093":124488},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3704":74223,"_31315":74221,"_5":31650,"_21707":124490,"_28496":124491,"_3093":124492},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3704":74224,"_31315":74221,"_5":31650,"_21707":124494,"_28496":124495,"_3093":124496},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3704":74225,"_31315":74221,"_5":31650,"_21707":124498,"_28496":124499,"_3093":124500},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3704":74226,"_31315":74221,"_5":31650,"_21707":124502,"_28496":124503,"_3093":124504},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3704":74227,"_31315":74221,"_5":31650,"_21707":124506,"_28496":124507,"_3093":124508},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3704":74228,"_31315":74221,"_21707":124510,"_5":14937,"_28496":74221,"_3093":124511},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3704":74229,"_31315":74221,"_21707":124513,"_5":14937,"_28496":124491,"_3093":124514},[],"Recorrido",{"_3704":74230,"_31315":74221,"_21707":124516,"_5":14937,"_28496":124491,"_3093":124517},[],"Cuándo existe el dispositivo",{"_3704":74231,"_31315":74221,"_21707":124519,"_5":14937,"_28496":124491,"_3093":124520},[],"Qué compruebas",{"_3704":74232,"_31315":74221,"_21707":124522,"_5":14937,"_28496":124491,"_3093":124523},[],"Asignación manual",{"_3704":74233,"_31315":74221,"_21707":124525,"_5":14937,"_28496":124491,"_3093":124526},[],"El operador lo crea antes de asociar un certificado.",{"_3704":74234,"_31315":74221,"_21707":124528,"_5":14937,"_28496":124491,"_3093":124529},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3704":74235,"_31315":74221,"_21707":124531,"_5":14937,"_28496":124491,"_3093":124532},[],"EST con `JITP`",{"_3704":74236,"_31315":74221,"_21707":124534,"_5":14937,"_28496":124491,"_3093":124535},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3704":74237,"_31315":74221,"_21707":124537,"_5":14937,"_28496":124491,"_3093":124538},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3704":74238,"_31315":74221,"_21707":124540,"_5":14937,"_28496":124491,"_3093":124541},[],"EST con `PRE_REGISTRATION`",{"_3704":74239,"_31315":74221,"_21707":124543,"_5":14937,"_28496":124491,"_3093":124544},[],"Debe existir antes de `/simpleenroll`.",{"_3704":74240,"_31315":74221,"_21707":124546,"_5":14937,"_28496":124491,"_3093":124547},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3704":74241,"_31315":74221,"_21707":124549,"_5":14937,"_28496":124491,"_3093":124550},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3704":74242,"_31315":74221,"_21707":124552,"_5":14937,"_28496":124491,"_3093":124553},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3704":74243,"_31315":74221,"_21707":124555,"_5":14937,"_28496":124495,"_3093":124556},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3704":74244,"_31315":74221,"_21707":124558,"_5":14937,"_28496":124495,"_3093":124559},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3704":74245,"_31315":74221,"_21707":124561,"_5":14937,"_28496":124495,"_3093":124562},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3704":74246,"_31315":74221,"_21707":124564,"_5":14937,"_28496":124499,"_3093":124565},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3704":74247,"_31315":74221,"_21707":124567,"_5":14937,"_28496":124499,"_3093":124568},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3704":74248,"_31315":74221,"_21707":124570,"_5":14937,"_28496":124499,"_3093":124571},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3704":74249,"_31315":74221,"_21707":124573,"_5":14937,"_28496":124499,"_3093":124574},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3704":74250,"_31315":74221,"_21707":124576,"_5":14937,"_28496":124499,"_3093":124577},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3704":74251,"_31315":74221,"_21707":124579,"_5":14937,"_28496":124499,"_3093":124580},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3704":74252,"_31315":74221,"_21707":124582,"_5":14937,"_28496":124503,"_3093":121308},[],{"_3704":74253,"_31315":74221,"_21707":124584,"_5":14937,"_28496":124503,"_3093":124585},[],"Material que atraviesa EST",{"_3704":74254,"_31315":74221,"_21707":124587,"_5":14937,"_28496":124503,"_3093":124588},[],"Clave generada por el dispositivo",{"_3704":74255,"_31315":74221,"_21707":124590,"_5":14937,"_28496":124503,"_3093":124591},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3704":74256,"_31315":74221,"_21707":124593,"_5":14937,"_28496":124503,"_3093":124594},[],"Clave ya disponible en el dispositivo",{"_3704":74257,"_31315":74221,"_21707":124596,"_5":14937,"_28496":124503,"_3093":124597},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3704":74258,"_31315":74221,"_21707":124599,"_5":14937,"_28496":124503,"_3093":54200},[],{"_3704":74259,"_31315":74221,"_21707":124601,"_5":14937,"_28496":124503,"_3093":124602},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3704":74260,"_31315":74221,"_21707":124604,"_5":14937,"_28496":124503,"_3093":124605},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3704":74261,"_31315":74221,"_21707":124607,"_5":14937,"_28496":124507,"_3093":124608},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3704":74262,"_31315":74262,"_5":15297,"_3093":124610,"_31653":124611,"_21707":124612,"_28496":74262},"Renovación y recuperación",[51162,122436,53872,123581,123759],[],{"_3704":74263,"_31315":74262,"_21707":124614,"_5":14937,"_28496":74262,"_3093":124615},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3704":74264,"_31315":74262,"_5":31650,"_21707":124617,"_28496":124618,"_3093":124619},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3704":74265,"_31315":74262,"_5":31650,"_21707":124621,"_28496":124622,"_3093":124623},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3704":74266,"_31315":74262,"_5":31650,"_21707":124625,"_28496":124626,"_3093":124627},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3704":74267,"_31315":74262,"_5":31650,"_21707":124629,"_28496":124630,"_3093":124631},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3704":74268,"_31315":74262,"_5":31650,"_21707":124633,"_28496":124634,"_3093":124635},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3704":74269,"_31315":74262,"_21707":124637,"_5":14937,"_28496":74262,"_3093":124638},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3704":74270,"_31315":74262,"_21707":124640,"_5":14937,"_28496":124618,"_3093":124641},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3704":74271,"_31315":74262,"_21707":124643,"_5":14937,"_28496":124618,"_3093":124644},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3704":74272,"_31315":74262,"_21707":124646,"_5":14937,"_28496":124618,"_3093":124647},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3704":74273,"_31315":74262,"_21707":124649,"_5":14937,"_28496":124618,"_3093":124650},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3704":74274,"_31315":74262,"_21707":124652,"_5":14937,"_28496":124622,"_3093":124653},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3704":74275,"_31315":74262,"_21707":124655,"_5":14937,"_28496":124622,"_3093":124656},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3704":74276,"_31315":74262,"_21707":124658,"_5":14937,"_28496":124626,"_3093":124659},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3704":74277,"_31315":74262,"_21707":124661,"_5":14937,"_28496":124626,"_3093":124662},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3704":74278,"_31315":74262,"_21707":124664,"_5":14937,"_28496":124626,"_3093":124665},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3704":74279,"_31315":74262,"_21707":124667,"_5":14937,"_28496":124630,"_3093":124668},[],"Situación",{"_3704":74280,"_31315":74262,"_21707":124670,"_5":14937,"_28496":124630,"_3093":124671},[],"Procedimiento",{"_3704":74281,"_31315":74262,"_21707":124673,"_5":14937,"_28496":124630,"_3093":124674},[],"Certificado vigente, fuera de ventana",{"_3704":74282,"_31315":74262,"_21707":124676,"_5":14937,"_28496":124630,"_3093":124677},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3704":74283,"_31315":74262,"_21707":124679,"_5":14937,"_28496":124630,"_3093":124680},[],"Certificado vencido, clave disponible",{"_3704":74284,"_31315":74262,"_21707":124682,"_5":14937,"_28496":124630,"_3093":124683},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3704":74285,"_31315":74262,"_21707":124685,"_5":14937,"_28496":124630,"_3093":124686},[],"Renovación por webhook o `NO_AUTH`",{"_3704":74286,"_31315":74262,"_21707":124688,"_5":14937,"_28496":124630,"_3093":124689},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3704":74287,"_31315":74262,"_21707":124691,"_5":14937,"_28496":124630,"_3093":124692},[],"Clave perdida o inaccesible",{"_3704":74288,"_31315":74262,"_21707":124694,"_5":14937,"_28496":124630,"_3093":124695},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3704":74289,"_31315":74262,"_21707":124697,"_5":14937,"_28496":124630,"_3093":124698},[],"Identidad actual revocada",{"_3704":74290,"_31315":74262,"_21707":124700,"_5":14937,"_28496":124630,"_3093":124701},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3704":74291,"_31315":74262,"_21707":124703,"_5":14937,"_28496":124630,"_3093":124704},[],"Dispositivo sin identidad",{"_3704":74292,"_31315":74262,"_21707":124706,"_5":14937,"_28496":124630,"_3093":124707},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3704":74293,"_31315":74262,"_21707":124709,"_5":14937,"_28496":124630,"_3093":124710},[],"Dispositivo retirado",{"_3704":74294,"_31315":74262,"_21707":124712,"_5":14937,"_28496":124630,"_3093":124713},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3704":74295,"_31315":74262,"_21707":124715,"_5":14937,"_28496":124630,"_3093":124716},[],"Timeout, HTTP 500 o fallo de instalación",{"_3704":74296,"_31315":74262,"_21707":124718,"_5":14937,"_28496":124630,"_3093":124719},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3704":74297,"_31315":74262,"_21707":124721,"_5":14937,"_28496":124634,"_3093":124722},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3704":74298,"_31315":74262,"_21707":124724,"_5":14937,"_28496":124634,"_3093":124725},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3704":74299,"_31315":74299,"_5":15297,"_3093":124727,"_31653":124728,"_21707":124729,"_28496":74299},"Diagnóstico de enrolamiento",[51162,122436,53872,123581,123759],[],{"_3704":74300,"_31315":74299,"_21707":124731,"_5":14937,"_28496":74299,"_3093":124732},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3704":74301,"_31315":74299,"_5":31650,"_21707":124734,"_28496":124735,"_3093":124736},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3704":74302,"_31315":74299,"_5":31650,"_21707":124738,"_28496":124739,"_3093":124740},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3704":74303,"_31315":74299,"_5":31650,"_21707":124742,"_28496":124743,"_3093":124306},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3704":74304,"_31315":74299,"_5":31650,"_21707":124745,"_28496":124746,"_3093":124747},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3704":74305,"_31315":74299,"_21707":124749,"_5":14937,"_28496":74299,"_3093":124750},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3704":74306,"_31315":74299,"_21707":124752,"_5":14937,"_28496":124739,"_3093":124753},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3704":74307,"_31315":74299,"_21707":124755,"_5":14937,"_28496":124739,"_3093":124756},[],"Síntoma o mensaje",{"_3704":74308,"_31315":74299,"_21707":124758,"_5":14937,"_28496":124739,"_3093":124759},[],"Qué revisar",{"_3704":74309,"_31315":74299,"_21707":124761,"_5":14937,"_28496":124739,"_3093":124762},[],"curl rechaza TLS, nombre o emisor",{"_3704":74310,"_31315":74299,"_21707":124764,"_5":14937,"_28496":124739,"_3093":124765},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3704":74311,"_31315":74299,"_21707":124767,"_5":14937,"_28496":124739,"_3093":124768},[],"404 o APS ausente",{"_3704":74312,"_31315":74299,"_21707":124770,"_5":14937,"_28496":124739,"_3093":124771},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3704":74313,"_31315":74299,"_21707":124773,"_5":14937,"_28496":124739,"_3093":124774},[],"400, error de CSR o formato",{"_3704":74314,"_31315":74299,"_21707":124776,"_5":14937,"_28496":124739,"_3093":124777},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3704":74315,"_31315":74299,"_21707":124779,"_5":14937,"_28496":124739,"_3093":124780},[],"Credencial ausente o certificado no válido",{"_3704":74316,"_31315":74299,"_21707":124782,"_5":14937,"_28496":124739,"_3093":124783},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3704":74317,"_31315":74299,"_21707":124785,"_5":14937,"_28496":124739,"_3093":124786},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3704":74318,"_31315":74299,"_21707":124788,"_5":14937,"_28496":124739,"_3093":124789},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3704":74319,"_31315":74299,"_21707":124791,"_5":14937,"_28496":124739,"_3093":124792},[],"Webhook deniega, expira o responde sin autorización",{"_3704":74320,"_31315":74299,"_21707":124794,"_5":14937,"_28496":124739,"_3093":124795},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3704":74321,"_31315":74299,"_21707":124797,"_5":14937,"_28496":124739,"_3093":55134},[],{"_3704":74322,"_31315":74299,"_21707":124799,"_5":14937,"_28496":124739,"_3093":124800},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3704":74323,"_31315":74299,"_21707":124802,"_5":14937,"_28496":124739,"_3093":55140},[],{"_3704":74324,"_31315":74299,"_21707":124804,"_5":14937,"_28496":124739,"_3093":124805},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3704":74325,"_31315":74299,"_21707":124807,"_5":14937,"_28496":124739,"_3093":55146},[],{"_3704":74326,"_31315":74299,"_21707":124809,"_5":14937,"_28496":124739,"_3093":124810},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3704":74327,"_31315":74299,"_21707":124812,"_5":14937,"_28496":124739,"_3093":55152},[],{"_3704":74328,"_31315":74299,"_21707":124814,"_5":14937,"_28496":124739,"_3093":124815},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3704":74329,"_31315":74299,"_21707":124817,"_5":14937,"_28496":124739,"_3093":55158},[],{"_3704":74330,"_31315":74299,"_21707":124819,"_5":14937,"_28496":124739,"_3093":124820},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3704":74331,"_31315":74299,"_21707":124822,"_5":14937,"_28496":124739,"_3093":124823},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3704":74332,"_31315":74299,"_21707":124825,"_5":14937,"_28496":124739,"_3093":124826},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3704":74333,"_31315":74299,"_21707":124828,"_5":14937,"_28496":124739,"_3093":124829},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3704":74334,"_31315":74299,"_21707":124831,"_5":14937,"_28496":124739,"_3093":124832},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3704":74335,"_31315":74299,"_21707":124834,"_5":14937,"_28496":124739,"_3093":55176},[],{"_3704":74336,"_31315":74299,"_21707":124836,"_5":14937,"_28496":124739,"_3093":124837},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3704":74337,"_31315":74299,"_21707":124839,"_5":14937,"_28496":124739,"_3093":55182},[],{"_3704":74338,"_31315":74299,"_21707":124841,"_5":14937,"_28496":124739,"_3093":124842},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3704":74339,"_31315":74299,"_21707":124844,"_5":14937,"_28496":124739,"_3093":124845},[],"DMS propietario distinto",{"_3704":74340,"_31315":74299,"_21707":124847,"_5":14937,"_28496":124739,"_3093":124848},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3704":74341,"_31315":74299,"_21707":124850,"_5":14937,"_28496":124739,"_3093":55194},[],{"_3704":74342,"_31315":74299,"_21707":124852,"_5":14937,"_28496":124739,"_3093":124853},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3704":74343,"_31315":74299,"_21707":124855,"_5":14937,"_28496":124739,"_3093":55200},[],{"_3704":74344,"_31315":74299,"_21707":124857,"_5":14937,"_28496":124739,"_3093":124858},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3704":74345,"_31315":74299,"_21707":124860,"_5":14937,"_28496":124739,"_3093":124861},[],"Certificado actual revocado",{"_3704":74346,"_31315":74299,"_21707":124863,"_5":14937,"_28496":124739,"_3093":124864},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3704":74347,"_31315":74299,"_21707":124866,"_5":14937,"_28496":124739,"_3093":124867},[],"Error de CA, perfil o firma",{"_3704":74348,"_31315":74299,"_21707":124869,"_5":14937,"_28496":124739,"_3093":124870},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3704":74349,"_31315":74299,"_21707":124872,"_5":14937,"_28496":124739,"_3093":124873},[],"HTTP 200 sin conexión del dispositivo",{"_3704":74350,"_31315":74299,"_21707":124875,"_5":14937,"_28496":124739,"_3093":124876},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3704":74351,"_31315":74299,"_21707":124878,"_5":14937,"_28496":124739,"_3093":124879},[],"Timeout o error después de emitir",{"_3704":74352,"_31315":74299,"_21707":124881,"_5":14937,"_28496":124739,"_3093":124882},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3704":74353,"_31315":74299,"_21707":124884,"_5":14937,"_28496":124743,"_3093":124885},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3704":74354,"_31315":74299,"_21707":124887,"_5":14937,"_28496":124743,"_3093":124888},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3704":74355,"_31315":74299,"_21707":124890,"_5":14937,"_28496":124746,"_3093":124891},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3704":74356,"_31315":74299,"_21707":124893,"_5":14937,"_28496":124746,"_3093":124894},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3704":74357,"_31315":74299,"_21707":124896,"_5":14937,"_28496":124746,"_3093":124897},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3704":74358,"_31315":74299,"_21707":124899,"_5":14937,"_28496":124746,"_3093":124900},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3704":74359,"_31315":74299,"_21707":124902,"_5":14937,"_28496":124746,"_3093":124903},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3704":74360,"_31315":74299,"_21707":124905,"_5":14937,"_28496":124746,"_3093":124906},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3704":74361,"_31315":74299,"_21707":124908,"_5":14937,"_28496":124746,"_3093":124909},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3704":74362,"_31315":74362,"_5":15297,"_3093":124911,"_31653":124912,"_21707":124913,"_28496":74362},"Distribución y actualización de confianza",[51162,122436,53872,123581,123759],[],{"_3704":74363,"_31315":74362,"_21707":124915,"_5":14937,"_28496":74362,"_3093":124916},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3704":74364,"_31315":74362,"_5":31650,"_21707":124918,"_28496":124919,"_3093":124920},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3704":74365,"_31315":74362,"_5":31650,"_21707":124922,"_28496":124923,"_3093":124924},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3704":74366,"_31315":74362,"_5":31650,"_21707":124926,"_28496":124927,"_3093":124928},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3704":74367,"_31315":74362,"_5":31650,"_21707":124930,"_28496":124931,"_3093":124932},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3704":74368,"_31315":74362,"_5":31650,"_21707":124934,"_28496":124935,"_3093":124936},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3704":74369,"_31315":74362,"_21707":124938,"_5":14937,"_28496":74362,"_3093":124939},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3704":74370,"_31315":74362,"_21707":124941,"_5":14937,"_28496":124919,"_3093":124942},[],"Relación",{"_3704":74371,"_31315":74362,"_21707":124944,"_5":14937,"_28496":124919,"_3093":124945},[],"Material que prepara el responsable",{"_3704":74372,"_31315":74362,"_21707":124947,"_5":14937,"_28496":124919,"_3093":124948},[],"Dispositivo → servidor EST",{"_3704":74373,"_31315":74362,"_21707":124950,"_5":14937,"_28496":124919,"_3093":124951},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3704":74374,"_31315":74362,"_21707":124953,"_5":14937,"_28496":124919,"_3093":124954},[],"DMS → solicitante",{"_3704":74375,"_31315":74362,"_21707":124956,"_5":14937,"_28496":124919,"_3093":124957},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3704":74376,"_31315":74362,"_21707":124959,"_5":14937,"_28496":124919,"_3093":124960},[],"Consumidor → dispositivo",{"_3704":74377,"_31315":74362,"_21707":124962,"_5":14937,"_28496":124919,"_3093":124963},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3704":74378,"_31315":74362,"_21707":124965,"_5":14937,"_28496":124919,"_3093":124966},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3704":74379,"_31315":74362,"_21707":124968,"_5":14937,"_28496":124923,"_3093":124969},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3704":74380,"_31315":74362,"_21707":124971,"_5":14937,"_28496":124923,"_3093":124972},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3704":74381,"_31315":74362,"_21707":124974,"_5":14937,"_28496":124927,"_3093":124975},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3704":74382,"_31315":74362,"_21707":124977,"_5":14937,"_28496":124927,"_3093":124978},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3704":74383,"_31315":74362,"_21707":124980,"_5":14937,"_28496":124927,"_3093":124981},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3704":74384,"_31315":74362,"_21707":124983,"_5":14937,"_28496":124927,"_3093":124984},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3704":74385,"_31315":74362,"_21707":124986,"_5":14937,"_28496":124927,"_3093":124987},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3704":74386,"_31315":74362,"_21707":124989,"_5":14937,"_28496":124927,"_3093":124990},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3704":74387,"_31315":74362,"_21707":124992,"_5":14937,"_28496":124931,"_3093":124993},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3704":74388,"_31315":74362,"_21707":124995,"_5":14937,"_28496":124931,"_3093":124996},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3704":74389,"_31315":74362,"_21707":124998,"_5":14937,"_28496":124931,"_3093":124999},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3704":74390,"_31315":74362,"_21707":125001,"_5":14937,"_28496":124935,"_3093":125002},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3704":74391,"_31315":74391,"_5":15297,"_3093":55349,"_31653":125004,"_21707":125006,"_28496":74391},[51162,122436,53872,123581,125005],"Integraciones",[],{"_3704":74392,"_31315":74391,"_21707":125008,"_5":14937,"_28496":74391,"_3093":125009},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3704":74393,"_31315":74391,"_5":31650,"_21707":125011,"_28496":125012,"_3093":125013},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3704":74394,"_31315":74391,"_5":31650,"_21707":125015,"_28496":125016,"_3093":125017},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3704":74395,"_31315":74391,"_5":31650,"_21707":125019,"_28496":125020,"_3093":125021},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3704":74396,"_31315":74391,"_5":31650,"_21707":125023,"_28496":125024,"_3093":125025},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3704":74397,"_31315":74391,"_5":31650,"_21707":125027,"_28496":125028,"_3093":125029},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3704":74398,"_31315":74391,"_5":31650,"_21707":125031,"_28496":125032,"_3093":125033},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3704":74399,"_31315":74391,"_5":31650,"_21707":125035,"_28496":125036,"_3093":125037},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3704":74400,"_31315":74391,"_5":31650,"_21707":125039,"_28496":125040,"_3093":125041},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3704":74401,"_31315":74391,"_5":31650,"_21707":125043,"_28496":125044,"_3093":55391},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3704":74402,"_31315":74391,"_5":31650,"_21707":125046,"_28496":125047,"_3093":55395},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3704":74403,"_31315":74391,"_5":31650,"_21707":125049,"_28496":125050,"_3093":125051},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3704":74404,"_31315":74391,"_5":31650,"_21707":125053,"_28496":125054,"_3093":125055},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3704":74405,"_31315":74391,"_5":31650,"_21707":125057,"_28496":125058,"_3093":125059},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3704":74406,"_31315":74391,"_5":31650,"_21707":125061,"_28496":125062,"_3093":125063},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3704":74407,"_31315":74391,"_5":31650,"_21707":125065,"_28496":125066,"_3093":125067},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3704":74408,"_31315":74391,"_5":31650,"_21707":125069,"_28496":125070,"_3093":125071},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3704":74409,"_31315":74391,"_5":31650,"_21707":125073,"_28496":125074,"_3093":125075},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3704":74410,"_31315":74391,"_5":31650,"_21707":125077,"_28496":125078,"_3093":125079},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3704":74411,"_31315":74391,"_5":31650,"_21707":125081,"_28496":125082,"_3093":125083},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3704":74412,"_31315":74391,"_5":31650,"_21707":125085,"_28496":125086,"_3093":125087},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3704":74413,"_31315":74391,"_5":31650,"_21707":125089,"_28496":125090,"_3093":125091},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3704":74414,"_31315":74391,"_5":31650,"_21707":125093,"_28496":125094,"_3093":125095},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3704":74415,"_31315":74391,"_5":31650,"_21707":125097,"_28496":125098,"_3093":125099},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3704":74416,"_31315":74391,"_5":31650,"_21707":125101,"_28496":125102,"_3093":125103},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3704":74417,"_31315":74391,"_5":31650,"_21707":125105,"_28496":125106,"_3093":125107},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3704":74418,"_31315":74391,"_21707":125109,"_5":14937,"_28496":74391,"_3093":125110},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3704":74419,"_31315":74391,"_21707":125112,"_5":14937,"_28496":74391,"_3093":125113},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3704":74420,"_31315":74391,"_21707":125115,"_5":14937,"_28496":74391,"_3093":125116},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3704":74421,"_31315":74391,"_21707":125118,"_5":14937,"_28496":125012,"_3093":125119},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3704":74422,"_31315":74391,"_21707":125121,"_5":14937,"_28496":125012,"_3093":125122},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3704":74423,"_31315":74391,"_21707":125124,"_5":14937,"_28496":125012,"_3093":125125},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3704":74424,"_31315":74391,"_21707":125127,"_5":14937,"_28496":125012,"_3093":125128},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3704":74425,"_31315":74391,"_21707":125130,"_5":14937,"_28496":125016,"_3093":125131},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3704":74426,"_31315":74391,"_21707":125133,"_5":14937,"_28496":125020,"_3093":125134},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3704":74427,"_31315":74391,"_21707":125136,"_5":14937,"_28496":125020,"_3093":125137},[],"Acción IAM",{"_3704":74428,"_31315":74391,"_21707":125139,"_5":14937,"_28496":125020,"_3093":121314},[],{"_3704":74429,"_31315":74391,"_21707":125141,"_5":14937,"_28496":125020,"_3093":55490},[],{"_3704":74430,"_31315":74391,"_21707":125143,"_5":14937,"_28496":125020,"_3093":125144},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3704":74431,"_31315":74391,"_21707":125146,"_5":14937,"_28496":125020,"_3093":55496},[],{"_3704":74432,"_31315":74391,"_21707":125148,"_5":14937,"_28496":125020,"_3093":125149},[],"Registrar la CA en AWS IoT",{"_3704":74433,"_31315":74391,"_21707":125151,"_5":14937,"_28496":125020,"_3093":55502},[],{"_3704":74434,"_31315":74391,"_21707":125153,"_5":14937,"_28496":125020,"_3093":125154},[],"Consultar el estado del registro de la CA",{"_3704":74435,"_31315":74391,"_21707":125156,"_5":14937,"_28496":125020,"_3093":55508},[],{"_3704":74436,"_31315":74391,"_21707":125158,"_5":14937,"_28496":125020,"_3093":125159},[],"Crear o actualizar Things en IoT Core",{"_3704":74437,"_31315":74391,"_21707":125161,"_5":14937,"_28496":125020,"_3093":55514},[],{"_3704":74438,"_31315":74391,"_21707":125163,"_5":14937,"_28496":125020,"_3093":125164},[],"Aprovisionar Things mediante plantilla",{"_3704":74439,"_31315":74391,"_21707":125166,"_5":14937,"_28496":125020,"_3093":55520},[],{"_3704":74440,"_31315":74391,"_21707":125168,"_5":14937,"_28496":125020,"_3093":125169},[],"Registrar certificados de dispositivo",{"_3704":74441,"_31315":74391,"_21707":125171,"_5":14937,"_28496":125020,"_3093":55526},[],{"_3704":74442,"_31315":74391,"_21707":125173,"_5":14937,"_28496":125020,"_3093":125174},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3704":74443,"_31315":74391,"_21707":125176,"_5":14937,"_28496":125020,"_3093":55532},[],{"_3704":74444,"_31315":74391,"_21707":125178,"_5":14937,"_28496":125020,"_3093":125179},[],"Crear y adjuntar políticas IoT",{"_3704":74445,"_31315":74391,"_21707":125181,"_5":14937,"_28496":125020,"_3093":55538},[],{"_3704":74446,"_31315":74391,"_21707":125183,"_5":14937,"_28496":125020,"_3093":125184},[],"Gestionar grupos de Things",{"_3704":74447,"_31315":74391,"_21707":125186,"_5":14937,"_28496":125020,"_3093":55544},[],{"_3704":74448,"_31315":74391,"_21707":125188,"_5":14937,"_28496":125020,"_3093":125189},[],"Crear plantillas JITP",{"_3704":74449,"_31315":74391,"_21707":125191,"_5":14937,"_28496":125020,"_3093":55550},[],{"_3704":74450,"_31315":74391,"_21707":125193,"_5":14937,"_28496":125020,"_3093":125194},[],"Leer y escribir el Device Shadow",{"_3704":74451,"_31315":74391,"_21707":125196,"_5":14937,"_28496":125020,"_3093":125197},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3704":74452,"_31315":74391,"_21707":125199,"_5":14937,"_28496":125024,"_3093":125200},[],"Parámetro",{"_3704":74453,"_31315":74391,"_21707":125202,"_5":14937,"_28496":125024,"_3093":125203},[],"Tipo",{"_3704":74454,"_31315":74391,"_21707":125205,"_5":14937,"_28496":125024,"_3093":125206},[],"Requerido",{"_3704":74455,"_31315":74391,"_21707":125208,"_5":14937,"_28496":125024,"_3093":125209},[],"Descripción",{"_3704":74456,"_31315":74391,"_21707":125211,"_5":14937,"_28496":125024,"_3093":55571},[],{"_3704":74457,"_31315":74391,"_21707":125213,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74458,"_31315":74391,"_21707":125215,"_5":14937,"_28496":125024,"_3093":125216},[],"Sí",{"_3704":74459,"_31315":74391,"_21707":125218,"_5":14937,"_28496":125024,"_3093":125219},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3704":74460,"_31315":74391,"_21707":125221,"_5":14937,"_28496":125024,"_3093":55582},[],{"_3704":74461,"_31315":74391,"_21707":125223,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74462,"_31315":74391,"_21707":125225,"_5":14937,"_28496":125024,"_3093":125216},[],{"_3704":74463,"_31315":74391,"_21707":125227,"_5":14937,"_28496":125024,"_3093":125228},[],"Región AWS donde opera el conector.",{"_3704":74464,"_31315":74391,"_21707":125230,"_5":14937,"_28496":125024,"_3093":55592},[],{"_3704":74465,"_31315":74391,"_21707":125232,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74466,"_31315":74391,"_21707":125234,"_5":14937,"_28496":125024,"_3093":125216},[],{"_3704":74467,"_31315":74391,"_21707":125236,"_5":14937,"_28496":125024,"_3093":125237},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3704":74468,"_31315":74391,"_21707":125239,"_5":14937,"_28496":125024,"_3093":55602},[],{"_3704":74469,"_31315":74391,"_21707":125241,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74470,"_31315":74391,"_21707":125243,"_5":14937,"_28496":125024,"_3093":125244},[],"Solo con `auth_method=static`",{"_3704":74471,"_31315":74391,"_21707":125246,"_5":14937,"_28496":125024,"_3093":125247},[],"Clave de acceso AWS.",{"_3704":74472,"_31315":74391,"_21707":125249,"_5":14937,"_28496":125024,"_3093":55613},[],{"_3704":74473,"_31315":74391,"_21707":125251,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74474,"_31315":74391,"_21707":125253,"_5":14937,"_28496":125024,"_3093":125244},[],{"_3704":74475,"_31315":74391,"_21707":125255,"_5":14937,"_28496":125024,"_3093":125256},[],"Clave secreta AWS.",{"_3704":74476,"_31315":74391,"_21707":125258,"_5":14937,"_28496":125024,"_3093":55623},[],{"_3704":74477,"_31315":74391,"_21707":125260,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74478,"_31315":74391,"_21707":125262,"_5":14937,"_28496":125024,"_3093":55628},[],{"_3704":74479,"_31315":74391,"_21707":125264,"_5":14937,"_28496":125024,"_3093":125265},[],"Token de sesión (con `auth_method=static`).",{"_3704":74480,"_31315":74391,"_21707":125267,"_5":14937,"_28496":125024,"_3093":55634},[],{"_3704":74481,"_31315":74391,"_21707":125269,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74482,"_31315":74391,"_21707":125271,"_5":14937,"_28496":125024,"_3093":125272},[],"Solo con `auth_method=role`",{"_3704":74483,"_31315":74391,"_21707":125274,"_5":14937,"_28496":125024,"_3093":125275},[],"ARN del rol a asumir.",{"_3704":74484,"_31315":74391,"_21707":125277,"_5":14937,"_28496":125024,"_3093":55645},[],{"_3704":74485,"_31315":74391,"_21707":125279,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74486,"_31315":74391,"_21707":125281,"_5":14937,"_28496":125024,"_3093":55628},[],{"_3704":74487,"_31315":74391,"_21707":125283,"_5":14937,"_28496":125024,"_3093":125284},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3704":74488,"_31315":74391,"_21707":125286,"_5":14937,"_28496":125024,"_3093":55655},[],{"_3704":74489,"_31315":74391,"_21707":125288,"_5":14937,"_28496":125024,"_3093":93391},[],{"_3704":74490,"_31315":74391,"_21707":125290,"_5":14937,"_28496":125024,"_3093":125216},[],{"_3704":74491,"_31315":74391,"_21707":125292,"_5":14937,"_28496":125024,"_3093":125293},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3704":74492,"_31315":74391,"_21707":125295,"_5":14937,"_28496":125024,"_3093":55665},[],{"_3704":74493,"_31315":74391,"_21707":125297,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74494,"_31315":74391,"_21707":125299,"_5":14937,"_28496":125024,"_3093":125216},[],{"_3704":74495,"_31315":74391,"_21707":125301,"_5":14937,"_28496":125024,"_3093":125302},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3704":74496,"_31315":74391,"_21707":125304,"_5":14937,"_28496":125024,"_3093":55675},[],{"_3704":74497,"_31315":74391,"_21707":125306,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74498,"_31315":74391,"_21707":125308,"_5":14937,"_28496":125024,"_3093":125216},[],{"_3704":74499,"_31315":74391,"_21707":125310,"_5":14937,"_28496":125024,"_3093":125311},[],"URL HTTP del Device Manager de Lamassu.",{"_3704":74500,"_31315":74391,"_21707":125313,"_5":14937,"_28496":125024,"_3093":55685},[],{"_3704":74501,"_31315":74391,"_21707":125315,"_5":14937,"_28496":125024,"_3093":25914},[],{"_3704":74502,"_31315":74391,"_21707":125317,"_5":14937,"_28496":125024,"_3093":125216},[],{"_3704":74503,"_31315":74391,"_21707":125319,"_5":14937,"_28496":125024,"_3093":125320},[],"URL HTTP del servicio de CA de Lamassu.",{"_3704":74504,"_31315":74391,"_21707":125322,"_5":14937,"_28496":125028,"_3093":125323},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3704":74505,"_31315":74391,"_21707":125325,"_5":14937,"_28496":125028,"_3093":125326},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3704":74506,"_31315":74391,"_21707":125328,"_5":14937,"_28496":125028,"_3093":125329},[],"Tipo de CloudEvent",{"_3704":74507,"_31315":74391,"_21707":125331,"_5":14937,"_28496":125028,"_3093":125332},[],"Recurso en Lamassu",{"_3704":74508,"_31315":74391,"_21707":125334,"_5":14937,"_28496":125028,"_3093":125335},[],"Recurso AWS",{"_3704":74509,"_31315":74391,"_21707":125337,"_5":14937,"_28496":125028,"_3093":125338},[],"Acciones IAM",{"_3704":74510,"_31315":74391,"_21707":125340,"_5":14937,"_28496":125028,"_3093":125341},[],"Llamadas AWS y efecto",{"_3704":74511,"_31315":74391,"_21707":125343,"_5":14937,"_28496":125028,"_3093":125344},[],"Dónde en esta página",{"_3704":74512,"_31315":74391,"_21707":125346,"_5":14937,"_28496":125028,"_3093":55719},[],{"_3704":74513,"_31315":74391,"_21707":125348,"_5":14937,"_28496":125028,"_3093":55722},[],{"_3704":74514,"_31315":74391,"_21707":125350,"_5":14937,"_28496":125028,"_3093":55725},[],{"_3704":74515,"_31315":74391,"_21707":125352,"_5":14937,"_28496":125028,"_3093":55728},[],{"_3704":74516,"_31315":74391,"_21707":125354,"_5":14937,"_28496":125028,"_3093":125355},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3704":74517,"_31315":74391,"_21707":125357,"_5":14937,"_28496":125028,"_3093":125041},[],{"_3704":74518,"_31315":74391,"_21707":125359,"_5":14937,"_28496":125028,"_3093":55736},[],{"_3704":74519,"_31315":74391,"_21707":125361,"_5":14937,"_28496":125028,"_3093":55739},[],{"_3704":74520,"_31315":74391,"_21707":125363,"_5":14937,"_28496":125028,"_3093":55742},[],{"_3704":74521,"_31315":74391,"_21707":125365,"_5":14937,"_28496":125028,"_3093":55745},[],{"_3704":74522,"_31315":74391,"_21707":125367,"_5":14937,"_28496":125028,"_3093":125368},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3704":74523,"_31315":74391,"_21707":125370,"_5":14937,"_28496":125028,"_3093":125067},[],{"_3704":74524,"_31315":74391,"_21707":125372,"_5":14937,"_28496":125028,"_3093":55753},[],{"_3704":74525,"_31315":74391,"_21707":125374,"_5":14937,"_28496":125028,"_3093":125375},[],"Dispositivo",{"_3704":74526,"_31315":74391,"_21707":125377,"_5":14937,"_28496":125028,"_3093":55759},[],{"_3704":74527,"_31315":74391,"_21707":125379,"_5":14937,"_28496":125028,"_3093":55762},[],{"_3704":74528,"_31315":74391,"_21707":125381,"_5":14937,"_28496":125028,"_3093":125382},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3704":74529,"_31315":74391,"_21707":125384,"_5":14937,"_28496":125028,"_3093":125075},[],{"_3704":74530,"_31315":74391,"_21707":125386,"_5":14937,"_28496":125028,"_3093":55770},[],{"_3704":74531,"_31315":74391,"_21707":125388,"_5":14937,"_28496":125028,"_3093":125389},[],"Certificado",{"_3704":74532,"_31315":74391,"_21707":125391,"_5":14937,"_28496":125028,"_3093":55776},[],{"_3704":74533,"_31315":74391,"_21707":125393,"_5":14937,"_28496":125028,"_3093":125394},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3704":74534,"_31315":74391,"_21707":125396,"_5":14937,"_28496":125028,"_3093":125397},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3704":74535,"_31315":74391,"_21707":125399,"_5":14937,"_28496":125028,"_3093":125087},[],{"_3704":74536,"_31315":74391,"_21707":125401,"_5":14937,"_28496":125028,"_3093":55787},[],{"_3704":74537,"_31315":74391,"_21707":125403,"_5":14937,"_28496":125028,"_3093":125404},[],"Certificado / Dispositivo",{"_3704":74538,"_31315":74391,"_21707":125406,"_5":14937,"_28496":125028,"_3093":55793},[],{"_3704":74539,"_31315":74391,"_21707":125408,"_5":14937,"_28496":125028,"_3093":51558},[],{"_3704":74540,"_31315":74391,"_21707":125410,"_5":14937,"_28496":125028,"_3093":125411},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3704":74541,"_31315":74391,"_21707":125413,"_5":14937,"_28496":125028,"_3093":125095},[],{"_3704":74542,"_31315":74391,"_21707":125415,"_5":14937,"_28496":125032,"_3093":125416},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3704":74543,"_31315":74391,"_21707":125418,"_5":14937,"_28496":125036,"_3093":125419},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3704":74544,"_31315":74391,"_21707":125421,"_5":14937,"_28496":125036,"_3093":125422},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3704":74545,"_31315":74391,"_21707":125424,"_5":14937,"_28496":125040,"_3093":125425},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3704":74546,"_31315":74391,"_21707":125427,"_5":14937,"_28496":125040,"_3093":125428},[],"Transición",{"_3704":74547,"_31315":74391,"_21707":125430,"_5":14937,"_28496":125040,"_3093":125431},[],"Llamadas AWS",{"_3704":74548,"_31315":74391,"_21707":125433,"_5":14937,"_28496":125040,"_3093":125434},[],"`NoRegistrada` → `Solicitada`",{"_3704":74549,"_31315":74391,"_21707":125436,"_5":14937,"_28496":125040,"_3093":125437},[],"ninguna (solo escritura de metadatos)",{"_3704":74550,"_31315":74391,"_21707":125439,"_5":14937,"_28496":125040,"_3093":125440},[],"`Solicitada` → `Registrando`",{"_3704":74551,"_31315":74391,"_21707":125442,"_5":14937,"_28496":125040,"_3093":125443},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3704":74552,"_31315":74391,"_21707":125445,"_5":14937,"_28496":125040,"_3093":125446},[],"`Registrando` → `Completada`",{"_3704":74553,"_31315":74391,"_21707":125448,"_5":14937,"_28496":125040,"_3093":125449},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3704":74554,"_31315":74391,"_21707":125451,"_5":14937,"_28496":125040,"_3093":125452},[],"`Registrando` → `Fallida`",{"_3704":74555,"_31315":74391,"_21707":125454,"_5":14937,"_28496":125040,"_3093":125455},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3704":74556,"_31315":74391,"_21707":125457,"_5":14937,"_28496":125040,"_3093":125458},[],"`Fallida` / `Completada` → `Solicitada`",{"_3704":74557,"_31315":74391,"_21707":125460,"_5":14937,"_28496":125040,"_3093":125461},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3704":74558,"_31315":74391,"_21707":125463,"_5":14937,"_28496":125044,"_3093":125464},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3704":74559,"_31315":74391,"_21707":125466,"_5":14937,"_28496":125044,"_3093":125467},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3704":74560,"_31315":74391,"_21707":125469,"_5":14937,"_28496":125044,"_3093":125470},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3704":74561,"_31315":74391,"_21707":125472,"_5":14937,"_28496":125044,"_3093":125473},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3704":74562,"_31315":74391,"_21707":125475,"_5":14937,"_28496":125044,"_3093":125476},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3704":74563,"_31315":74391,"_21707":125478,"_5":14937,"_28496":125044,"_3093":125479},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3704":74564,"_31315":74391,"_21707":125481,"_5":14937,"_28496":125047,"_3093":125482},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3704":74565,"_31315":74391,"_21707":125484,"_5":14937,"_28496":125050,"_3093":125485},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3704":74566,"_31315":74391,"_21707":125487,"_5":14937,"_28496":125050,"_3093":125488},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3704":74567,"_31315":74391,"_21707":125490,"_5":14937,"_28496":125054,"_3093":125491},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3704":74568,"_31315":74391,"_21707":125493,"_5":14937,"_28496":125058,"_3093":125494},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3704":74569,"_31315":74391,"_21707":125496,"_5":14937,"_28496":125058,"_3093":125497},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3704":74570,"_31315":74391,"_21707":125499,"_5":14937,"_28496":125058,"_3093":125500},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3704":74571,"_31315":74391,"_21707":125502,"_5":14937,"_28496":125058,"_3093":125503},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3704":74572,"_31315":74391,"_21707":125505,"_5":14937,"_28496":125058,"_3093":125506},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3704":74573,"_31315":74391,"_21707":125508,"_5":14937,"_28496":125058,"_3093":125509},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3704":74574,"_31315":74391,"_21707":125511,"_5":14937,"_28496":125062,"_3093":125512},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3704":74575,"_31315":74391,"_21707":125514,"_5":14937,"_28496":125062,"_3093":125515},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3704":74576,"_31315":74391,"_21707":125517,"_5":14937,"_28496":125062,"_3093":125518},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3704":74577,"_31315":74391,"_21707":125520,"_5":14937,"_28496":125062,"_3093":125521},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3704":74578,"_31315":74391,"_21707":125523,"_5":14937,"_28496":125062,"_3093":125524},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3704":74579,"_31315":74391,"_21707":125526,"_5":14937,"_28496":125066,"_3093":125527},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3704":74580,"_31315":74391,"_21707":125529,"_5":14937,"_28496":125066,"_3093":125428},[],{"_3704":74581,"_31315":74391,"_21707":125531,"_5":14937,"_28496":125066,"_3093":125431},[],{"_3704":74582,"_31315":74391,"_21707":125533,"_5":14937,"_28496":125066,"_3093":125534},[],"`SinConfigurar` → `None` / `Auto`",{"_3704":74583,"_31315":74391,"_21707":125536,"_5":14937,"_28496":125066,"_3093":125537},[],"ninguna (solo configuración)",{"_3704":74584,"_31315":74391,"_21707":125539,"_5":14937,"_28496":125066,"_3093":55930},[],{"_3704":74585,"_31315":74391,"_21707":125541,"_5":14937,"_28496":125066,"_3093":125537},[],{"_3704":74586,"_31315":74391,"_21707":125543,"_5":14937,"_28496":125066,"_3093":125544},[],"Cualquiera → `Jitp`",{"_3704":74587,"_31315":74391,"_21707":125546,"_5":14937,"_28496":125066,"_3093":125547},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3704":74588,"_31315":74391,"_21707":125549,"_5":14937,"_28496":125066,"_3093":55941},[],{"_3704":74589,"_31315":74391,"_21707":125551,"_5":14937,"_28496":125066,"_3093":125552},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3704":74590,"_31315":74391,"_21707":125554,"_5":14937,"_28496":125070,"_3093":125555},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3704":74591,"_31315":74391,"_21707":125557,"_5":14937,"_28496":125070,"_3093":125558},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3704":74592,"_31315":74391,"_21707":125560,"_5":14937,"_28496":125070,"_3093":125561},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3704":74593,"_31315":74391,"_21707":125563,"_5":14937,"_28496":125074,"_3093":125564},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3704":74594,"_31315":74391,"_21707":125566,"_5":14937,"_28496":125074,"_3093":125428},[],{"_3704":74595,"_31315":74391,"_21707":125568,"_5":14937,"_28496":125074,"_3093":125431},[],{"_3704":74596,"_31315":74391,"_21707":125570,"_5":14937,"_28496":125074,"_3093":125571},[],"`Ausente` → `Aprovisionado`",{"_3704":74597,"_31315":74391,"_21707":125573,"_5":14937,"_28496":125074,"_3093":125574},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3704":74598,"_31315":74391,"_21707":125576,"_5":14937,"_28496":125074,"_3093":125577},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3704":74599,"_31315":74391,"_21707":125579,"_5":14937,"_28496":125074,"_3093":125580},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3704":74600,"_31315":74391,"_21707":125582,"_5":14937,"_28496":125074,"_3093":125583},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3704":74601,"_31315":74391,"_21707":125585,"_5":14937,"_28496":125078,"_3093":125586},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3704":74602,"_31315":74391,"_21707":125588,"_5":14937,"_28496":125078,"_3093":125589},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3704":74603,"_31315":74391,"_21707":125591,"_5":14937,"_28496":125078,"_3093":125592},[],"Para que el flujo JITP funcione correctamente:",{"_3704":74604,"_31315":74391,"_21707":125594,"_5":14937,"_28496":125078,"_3093":125595},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3704":74605,"_31315":74391,"_21707":125597,"_5":14937,"_28496":125078,"_3093":125598},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3704":74606,"_31315":74391,"_21707":125600,"_5":14937,"_28496":125078,"_3093":125601},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3704":74607,"_31315":74391,"_21707":125603,"_5":14937,"_28496":125078,"_3093":125604},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3704":74608,"_31315":74391,"_21707":125606,"_5":14937,"_28496":125082,"_3093":125607},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3704":74609,"_31315":74391,"_21707":125609,"_5":14937,"_28496":125082,"_3093":125610},[],"Estado en Lamassu",{"_3704":74610,"_31315":74391,"_21707":125612,"_5":14937,"_28496":125082,"_3093":125613},[],"Razón de revocación",{"_3704":74611,"_31315":74391,"_21707":125615,"_5":14937,"_28496":125082,"_3093":125616},[],"Estado en AWS IoT Core",{"_3704":74612,"_31315":74391,"_21707":125618,"_5":14937,"_28496":125082,"_3093":56011},[],{"_3704":74613,"_31315":74391,"_21707":125620,"_5":14937,"_28496":125082,"_3093":125621},[],"Ninguna",{"_3704":74614,"_31315":74391,"_21707":125623,"_5":14937,"_28496":125082,"_3093":56017},[],{"_3704":74615,"_31315":74391,"_21707":125625,"_5":14937,"_28496":125082,"_3093":56020},[],{"_3704":74616,"_31315":74391,"_21707":125627,"_5":14937,"_28496":125082,"_3093":56023},[],{"_3704":74617,"_31315":74391,"_21707":125629,"_5":14937,"_28496":125082,"_3093":56026},[],{"_3704":74618,"_31315":74391,"_21707":125631,"_5":14937,"_28496":125082,"_3093":56020},[],{"_3704":74619,"_31315":74391,"_21707":125633,"_5":14937,"_28496":125082,"_3093":125634},[],"Cualquier otra razón",{"_3704":74620,"_31315":74391,"_21707":125636,"_5":14937,"_28496":125082,"_3093":56034},[],{"_3704":74621,"_31315":74391,"_21707":125638,"_5":14937,"_28496":125082,"_3093":125639},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3704":74622,"_31315":74391,"_21707":125641,"_5":14937,"_28496":125086,"_3093":125642},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3704":74623,"_31315":74391,"_21707":125644,"_5":14937,"_28496":125086,"_3093":125428},[],{"_3704":74624,"_31315":74391,"_21707":125646,"_5":14937,"_28496":125086,"_3093":125431},[],{"_3704":74625,"_31315":74391,"_21707":125648,"_5":14937,"_28496":125086,"_3093":125649},[],"`NoSincronizado` → `Active`",{"_3704":74626,"_31315":74391,"_21707":125651,"_5":14937,"_28496":125086,"_3093":55526},[],{"_3704":74627,"_31315":74391,"_21707":125653,"_5":14937,"_28496":125086,"_3093":56052},[],{"_3704":74628,"_31315":74391,"_21707":125655,"_5":14937,"_28496":125086,"_3093":125656},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3704":74629,"_31315":74391,"_21707":125658,"_5":14937,"_28496":125086,"_3093":56058},[],{"_3704":74630,"_31315":74391,"_21707":125660,"_5":14937,"_28496":125086,"_3093":125656},[],{"_3704":74631,"_31315":74391,"_21707":125662,"_5":14937,"_28496":125086,"_3093":56063},[],{"_3704":74632,"_31315":74391,"_21707":125664,"_5":14937,"_28496":125086,"_3093":55526},[],{"_3704":74633,"_31315":74391,"_21707":125666,"_5":14937,"_28496":125086,"_3093":56068},[],{"_3704":74634,"_31315":74391,"_21707":125668,"_5":14937,"_28496":125086,"_3093":125669},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3704":74635,"_31315":74391,"_21707":125671,"_5":14937,"_28496":125090,"_3093":125672},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3704":74636,"_31315":74391,"_21707":125674,"_5":14937,"_28496":125090,"_3093":125675},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3704":74637,"_31315":74391,"_21707":125677,"_5":14937,"_28496":125090,"_3093":125678},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3704":74638,"_31315":74391,"_21707":125680,"_5":14937,"_28496":125094,"_3093":125681},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3704":74639,"_31315":74391,"_21707":125683,"_5":14937,"_28496":125094,"_3093":125684},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3704":74640,"_31315":74391,"_21707":125686,"_5":14937,"_28496":125098,"_3093":125687},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3704":74641,"_31315":74391,"_21707":125689,"_5":14937,"_28496":125098,"_3093":125690},[],"Existen dos tipos de acciones:",{"_3704":74642,"_31315":74391,"_21707":125692,"_5":14937,"_28496":125098,"_3093":125693},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3704":74643,"_31315":74391,"_21707":125695,"_5":14937,"_28496":125098,"_3093":125696},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3704":74644,"_31315":74391,"_21707":125698,"_5":14937,"_28496":125098,"_3093":125699},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3704":74645,"_31315":74391,"_21707":125701,"_5":14937,"_28496":125102,"_3093":125702},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3704":74646,"_31315":74391,"_21707":125704,"_5":14937,"_28496":125102,"_3093":125705},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3704":74647,"_31315":74391,"_21707":125707,"_5":14937,"_28496":125102,"_3093":125708},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3704":74648,"_31315":74391,"_21707":125710,"_5":14937,"_28496":125106,"_3093":125711},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3704":74649,"_31315":74391,"_21707":125713,"_5":14937,"_28496":125106,"_3093":125714},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3704":74650,"_31315":74391,"_21707":125716,"_5":14937,"_28496":125106,"_3093":125717},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3704":74651,"_31315":74391,"_21707":125719,"_5":14937,"_28496":125106,"_3093":125720},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3704":74652,"_31315":74391,"_21707":125722,"_5":14937,"_28496":125106,"_3093":125723},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3704":74653,"_31315":74391,"_21707":125725,"_5":14937,"_28496":125106,"_3093":125726},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3704":74654,"_31315":74391,"_21707":125728,"_5":14937,"_28496":125106,"_3093":125729},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3704":74655,"_31315":74391,"_21707":125731,"_5":14937,"_28496":125106,"_3093":125732},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3704":74656,"_31315":74391,"_21707":125734,"_5":14937,"_28496":125106,"_3093":125735},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3704":74657,"_31315":74391,"_21707":125737,"_5":14937,"_28496":125106,"_3093":125738},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3704":74658,"_31315":74391,"_21707":125740,"_5":14937,"_28496":125106,"_3093":125741},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3704":74659,"_31315":74391,"_21707":125743,"_5":14937,"_28496":125106,"_3093":125744},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3704":74660,"_31315":74391,"_21707":125746,"_5":14937,"_28496":125106,"_3093":125747},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3704":74661,"_31315":74391,"_21707":125749,"_5":14937,"_28496":125106,"_3093":125750},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3704":74662,"_31315":74391,"_21707":125752,"_5":14937,"_28496":125106,"_3093":125753},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3704":74663,"_31315":74391,"_21707":125755,"_5":14937,"_28496":125106,"_3093":125756},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3704":74664,"_31315":74391,"_21707":125758,"_5":14937,"_28496":125106,"_3093":125759},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3704":74665,"_31315":74391,"_21707":125761,"_5":14937,"_28496":125106,"_3093":125762},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3704":74666,"_31315":74391,"_21707":125764,"_5":14937,"_28496":125106,"_3093":125765},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3704":74667,"_31315":74391,"_21707":125767,"_5":14937,"_28496":125106,"_3093":125768},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3704":74668,"_31315":74391,"_21707":125770,"_5":14937,"_28496":125106,"_3093":125771},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3704":74669,"_31315":74391,"_21707":125773,"_5":14937,"_28496":125106,"_3093":125774},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3704":74670,"_31315":74391,"_21707":125776,"_5":14937,"_28496":125106,"_3093":125777},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3704":74671,"_31315":74391,"_21707":125779,"_5":14937,"_28496":125106,"_3093":125780},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3704":74672,"_31315":74672,"_5":15297,"_3093":53872,"_31653":125782,"_21707":125783,"_28496":74672},[51162,122436,53872],[],{"_3704":74673,"_31315":74672,"_21707":125785,"_5":14937,"_28496":74672,"_3093":125786},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3704":74674,"_31315":74672,"_5":31650,"_21707":125788,"_28496":125789,"_3093":125790},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3704":74675,"_31315":74672,"_5":31650,"_21707":125792,"_28496":125793,"_3093":123581},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3704":74676,"_31315":74672,"_5":31650,"_21707":125795,"_28496":125796,"_3093":123759},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3704":74677,"_31315":74672,"_5":31650,"_21707":125798,"_28496":125799,"_3093":125005},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3704":74678,"_31315":74672,"_5":31650,"_21707":125801,"_28496":125802,"_3093":125803},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3704":74679,"_31315":74672,"_21707":125805,"_5":14937,"_28496":74672,"_3093":125806},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3704":74680,"_31315":74672,"_21707":125808,"_5":14937,"_28496":125789,"_3093":125809},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3704":74681,"_31315":74672,"_21707":125811,"_5":14937,"_28496":125789,"_3093":125812},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3704":74682,"_31315":74672,"_21707":125814,"_5":14937,"_28496":125793,"_3093":125815},[],"Recurso",{"_3704":74683,"_31315":74672,"_21707":125817,"_5":14937,"_28496":125793,"_3093":125818},[],"Qué representa",{"_3704":74684,"_31315":74672,"_21707":125820,"_5":14937,"_28496":125793,"_3093":125821},[],"**Dispositivo**",{"_3704":74685,"_31315":74672,"_21707":125823,"_5":14937,"_28496":125793,"_3093":125824},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3704":74686,"_31315":74672,"_21707":125826,"_5":14937,"_28496":125793,"_3093":125827},[],"**Identidad**",{"_3704":74687,"_31315":74672,"_21707":125829,"_5":14937,"_28496":125793,"_3093":125830},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3704":74688,"_31315":74672,"_21707":125832,"_5":14937,"_28496":125793,"_3093":56235},[],{"_3704":74689,"_31315":74672,"_21707":125834,"_5":14937,"_28496":125793,"_3093":125835},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3704":74690,"_31315":74672,"_21707":125837,"_5":14937,"_28496":125793,"_3093":125838},[],"**Flota**",{"_3704":74691,"_31315":74672,"_21707":125840,"_5":14937,"_28496":125793,"_3093":125841},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3704":74692,"_31315":74672,"_21707":125843,"_5":14937,"_28496":125793,"_3093":125844},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3704":74693,"_31315":74672,"_21707":125846,"_5":14937,"_28496":125793,"_3093":125847},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3704":74694,"_31315":74672,"_21707":125849,"_5":14937,"_28496":125796,"_3093":125850},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3704":74695,"_31315":74672,"_21707":125852,"_5":14937,"_28496":125796,"_3093":125853},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3704":74696,"_31315":74672,"_21707":125855,"_5":14937,"_28496":125796,"_3093":125856},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3704":74697,"_31315":74672,"_21707":125858,"_5":14937,"_28496":125796,"_3093":125859},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3704":74698,"_31315":74672,"_21707":125861,"_5":14937,"_28496":125796,"_3093":125862},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3704":74699,"_31315":74672,"_21707":125864,"_5":14937,"_28496":125796,"_3093":125865},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3704":74700,"_31315":74672,"_21707":125867,"_5":14937,"_28496":125796,"_3093":125868},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3704":74701,"_31315":74672,"_21707":125870,"_5":14937,"_28496":125796,"_3093":125871},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3704":74702,"_31315":74672,"_21707":125873,"_5":14937,"_28496":125799,"_3093":125874},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3704":74703,"_31315":74672,"_21707":125876,"_5":14937,"_28496":125799,"_3093":125877},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3704":74704,"_31315":74672,"_21707":125879,"_5":14937,"_28496":125802,"_3093":125880},[],"Participante",{"_3704":74705,"_31315":74672,"_21707":125882,"_5":14937,"_28496":125802,"_3093":125883},[],"Responsabilidad",{"_3704":74706,"_31315":74672,"_21707":125885,"_5":14937,"_28496":125802,"_3093":125886},[],"Administrador PKI",{"_3704":74707,"_31315":74672,"_21707":125888,"_5":14937,"_28496":125802,"_3093":125889},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3704":74708,"_31315":74672,"_21707":125891,"_5":14937,"_28496":125802,"_3093":125892},[],"Administrador del aprovisionamiento",{"_3704":74709,"_31315":74672,"_21707":125894,"_5":14937,"_28496":125802,"_3093":125895},[],"DMS, admisión, autenticación por operación e inventario.",{"_3704":74710,"_31315":74672,"_21707":125897,"_5":14937,"_28496":125802,"_3093":125898},[],"Integrador del dispositivo",{"_3704":74711,"_31315":74672,"_21707":125900,"_5":14937,"_28496":125802,"_3093":125901},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3704":74712,"_31315":74672,"_21707":125903,"_5":14937,"_28496":125802,"_3093":125904},[],"Integrador del consumidor",{"_3704":74713,"_31315":74672,"_21707":125906,"_5":14937,"_28496":125802,"_3093":125907},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3704":74714,"_31315":74672,"_21707":125909,"_5":14937,"_28496":125802,"_3093":125910},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3704":74715,"_31315":74715,"_5":15297,"_3093":125912,"_31653":125913,"_21707":125915,"_28496":74715},"Enrola y conecta tu primer dispositivo",[51162,122436,53872,125914],"Primeros pasos",[],{"_3704":74716,"_31315":74715,"_21707":125917,"_5":14937,"_28496":74715,"_3093":125918},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3704":74717,"_31315":74715,"_5":31650,"_21707":125920,"_28496":125921,"_3093":120944},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3704":74718,"_31315":74715,"_5":31650,"_21707":125923,"_28496":125924,"_3093":125925},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3704":74719,"_31315":74715,"_5":31650,"_21707":125927,"_28496":125928,"_3093":125929},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3704":74720,"_31315":74715,"_5":31650,"_21707":125931,"_28496":125932,"_3093":125933},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3704":74721,"_31315":74715,"_5":31650,"_21707":125935,"_28496":125936,"_3093":125937},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3704":74722,"_31315":74715,"_5":31650,"_21707":125939,"_28496":125940,"_3093":125941},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3704":74723,"_31315":74715,"_5":31650,"_21707":125943,"_28496":125944,"_3093":125945},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3704":74724,"_31315":74715,"_5":31650,"_21707":125947,"_28496":125948,"_3093":125949},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3704":74725,"_31315":74715,"_21707":125951,"_5":14937,"_28496":74715,"_3093":125952},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3704":74726,"_31315":74715,"_21707":125954,"_5":14937,"_28496":125921,"_3093":125955},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3704":74727,"_31315":74715,"_21707":125957,"_5":14937,"_28496":125921,"_3093":125958},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3704":74728,"_31315":74715,"_21707":125960,"_5":14937,"_28496":125921,"_3093":125961},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3704":74729,"_31315":74715,"_21707":125963,"_5":14937,"_28496":125921,"_3093":125964},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3704":74730,"_31315":74715,"_21707":125966,"_5":14937,"_28496":125921,"_3093":125967},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3704":74731,"_31315":74715,"_21707":125969,"_5":14937,"_28496":125924,"_3093":125970},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3704":74732,"_31315":74715,"_21707":125972,"_5":14937,"_28496":125924,"_3093":125973},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3704":74733,"_31315":74715,"_21707":125975,"_5":14937,"_28496":125928,"_3093":125976},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3704":74734,"_31315":74715,"_21707":125978,"_5":14937,"_28496":125928,"_3093":125979},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3704":74735,"_31315":74715,"_21707":125981,"_5":14937,"_28496":125928,"_3093":125982},[],"Ajuste",{"_3704":74736,"_31315":74715,"_21707":125984,"_5":14937,"_28496":125928,"_3093":125985},[],"Valor de evaluación",{"_3704":74737,"_31315":74715,"_21707":125987,"_5":14937,"_28496":125928,"_3093":56391},[],{"_3704":74738,"_31315":74715,"_21707":125989,"_5":14937,"_28496":125928,"_3093":125990},[],"Raíz emisora de `device-root.pem`.",{"_3704":74739,"_31315":74715,"_21707":125992,"_5":14937,"_28496":125928,"_3093":123893},[],{"_3704":74740,"_31315":74715,"_21707":125994,"_5":14937,"_28496":125928,"_3093":125995},[],"Perfil final de 1 hora que acabas de preparar.",{"_3704":74741,"_31315":74715,"_21707":125997,"_5":14937,"_28496":125928,"_3093":56402},[],{"_3704":74742,"_31315":74715,"_21707":125999,"_5":14937,"_28496":125928,"_3093":56405},[],{"_3704":74743,"_31315":74715,"_21707":126001,"_5":14937,"_28496":125928,"_3093":56408},[],{"_3704":74744,"_31315":74715,"_21707":126003,"_5":14937,"_28496":125928,"_3093":126004},[],"Habilitado.",{"_3704":74745,"_31315":74715,"_21707":126006,"_5":14937,"_28496":125928,"_3093":56414},[],{"_3704":74746,"_31315":74715,"_21707":126008,"_5":14937,"_28496":125928,"_3093":126009},[],"Deshabilitado; el ID debe ser nuevo.",{"_3704":74747,"_31315":74715,"_21707":126011,"_5":14937,"_28496":125928,"_3093":126012},[],"Autenticación inicial",{"_3704":74748,"_31315":74715,"_21707":126014,"_5":14937,"_28496":125928,"_3093":126015},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3704":74749,"_31315":74715,"_21707":126017,"_5":14937,"_28496":125928,"_3093":126018},[],"Autenticación de renovación",{"_3704":74750,"_31315":74715,"_21707":126020,"_5":14937,"_28496":125928,"_3093":126021},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3704":74751,"_31315":74715,"_21707":126023,"_5":14937,"_28496":125928,"_3093":56432},[],{"_3704":74752,"_31315":74715,"_21707":126025,"_5":14937,"_28496":125928,"_3093":126026},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3704":74753,"_31315":74715,"_21707":126028,"_5":14937,"_28496":125928,"_3093":56438},[],{"_3704":74754,"_31315":74715,"_21707":126030,"_5":14937,"_28496":125928,"_3093":126031},[],"1 hora.",{"_3704":74755,"_31315":74715,"_21707":126033,"_5":14937,"_28496":125928,"_3093":56444},[],{"_3704":74756,"_31315":74715,"_21707":126035,"_5":14937,"_28496":125928,"_3093":126036},[],"30 minutos / 10 minutos.",{"_3704":74757,"_31315":74715,"_21707":126038,"_5":14937,"_28496":125928,"_3093":56450},[],{"_3704":74758,"_31315":74715,"_21707":126040,"_5":14937,"_28496":125928,"_3093":126041},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3704":74759,"_31315":74715,"_21707":126043,"_5":14937,"_28496":125928,"_3093":54200},[],{"_3704":74760,"_31315":74715,"_21707":126045,"_5":14937,"_28496":125928,"_3093":126046},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3704":74761,"_31315":74715,"_21707":126048,"_5":14937,"_28496":125928,"_3093":56461},[],{"_3704":74762,"_31315":74715,"_21707":126050,"_5":14937,"_28496":125928,"_3093":126051},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3704":74763,"_31315":74715,"_21707":126053,"_5":14937,"_28496":125928,"_3093":126054},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3704":74764,"_31315":74715,"_21707":126056,"_5":14937,"_28496":125932,"_3093":126057},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3704":74765,"_31315":74715,"_21707":126059,"_5":14937,"_28496":125932,"_3093":126060},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3704":74766,"_31315":74715,"_21707":126062,"_5":14937,"_28496":125936,"_3093":126063},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3704":74767,"_31315":74715,"_21707":126065,"_5":14937,"_28496":125936,"_3093":126066},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3704":74768,"_31315":74715,"_21707":126068,"_5":14937,"_28496":125936,"_3093":126069},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3704":74769,"_31315":74715,"_21707":126071,"_5":14937,"_28496":125940,"_3093":126072},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3704":74770,"_31315":74715,"_21707":126074,"_5":14937,"_28496":125940,"_3093":126075},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3704":74771,"_31315":74715,"_21707":126077,"_5":14937,"_28496":125944,"_3093":126078},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3704":74772,"_31315":74715,"_21707":126080,"_5":14937,"_28496":125944,"_3093":126081},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3704":74773,"_31315":74715,"_21707":126083,"_5":14937,"_28496":125944,"_3093":126084},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3704":74774,"_31315":74715,"_21707":126086,"_5":14937,"_28496":125944,"_3093":126087},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3704":74775,"_31315":74715,"_21707":126089,"_5":14937,"_28496":125944,"_3093":126090},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3704":74776,"_31315":74715,"_21707":126092,"_5":14937,"_28496":125948,"_3093":126093},[],"Comprobación",{"_3704":74777,"_31315":74715,"_21707":126095,"_5":14937,"_28496":125948,"_3093":126096},[],"Resultado esperado",{"_3704":74778,"_31315":74715,"_21707":126098,"_5":14937,"_28496":125948,"_3093":126099},[],"Registro",{"_3704":74779,"_31315":74715,"_21707":126101,"_5":14937,"_28496":125948,"_3093":126102},[],"ID creado automáticamente y DMS correcto.",{"_3704":74780,"_31315":74715,"_21707":126104,"_5":14937,"_28496":125948,"_3093":125389},[],{"_3704":74781,"_31315":74715,"_21707":126106,"_5":14937,"_28496":125948,"_3093":126107},[],"CN, perfil, serie y clave verificados.",{"_3704":74782,"_31315":74715,"_21707":126109,"_5":14937,"_28496":125948,"_3093":126110},[],"Inventario",{"_3704":74783,"_31315":74715,"_21707":126112,"_5":14937,"_28496":125948,"_3093":126113},[],"Serie recibida visible como identidad actual y en el historial.",{"_3704":74784,"_31315":74715,"_21707":126115,"_5":14937,"_28496":125948,"_3093":126116},[],"Consumidor",{"_3704":74785,"_31315":74715,"_21707":126118,"_5":14937,"_28496":125948,"_3093":126119},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3704":74786,"_31315":74715,"_21707":126121,"_5":14937,"_28496":125948,"_3093":126122},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3704":74787,"_31315":74715,"_21707":126124,"_5":14937,"_28496":125948,"_3093":126125},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3704":74788,"_31315":74788,"_5":15297,"_3093":123598,"_31653":126127,"_21707":126128,"_28496":74788},[51162,122436,53872,125914],[],{"_3704":74789,"_31315":74788,"_21707":126130,"_5":14937,"_28496":74788,"_3093":126131},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3704":74790,"_31315":74788,"_5":31650,"_21707":126133,"_28496":126134,"_3093":120944},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3704":74791,"_31315":74788,"_5":31650,"_21707":126136,"_28496":126137,"_3093":126138},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3704":74792,"_31315":74788,"_5":31650,"_21707":126140,"_28496":126141,"_3093":126142},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3704":74793,"_31315":74788,"_5":31650,"_21707":126144,"_28496":126145,"_3093":126146},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3704":74794,"_31315":74788,"_5":31650,"_21707":126148,"_28496":126149,"_3093":126150},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3704":74795,"_31315":74788,"_5":31650,"_21707":126152,"_28496":126153,"_3093":126154},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3704":74796,"_31315":74788,"_5":31650,"_21707":126156,"_28496":126157,"_3093":126096},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3704":74797,"_31315":74788,"_5":31650,"_21707":126159,"_28496":126160,"_3093":126161},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3704":74798,"_31315":74788,"_5":31650,"_21707":126163,"_28496":126164,"_3093":126165},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3704":74799,"_31315":74788,"_21707":126167,"_5":14937,"_28496":74788,"_3093":126168},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3704":74800,"_31315":74788,"_21707":126170,"_5":14937,"_28496":74788,"_3093":126171},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3704":74801,"_31315":74788,"_21707":126173,"_5":14937,"_28496":126134,"_3093":126174},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3704":74802,"_31315":74788,"_21707":126176,"_5":14937,"_28496":126134,"_3093":126177},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3704":74803,"_31315":74788,"_21707":126179,"_5":14937,"_28496":126134,"_3093":126180},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3704":74804,"_31315":74788,"_21707":126182,"_5":14937,"_28496":126134,"_3093":126183},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3704":74805,"_31315":74788,"_21707":126185,"_5":14937,"_28496":126137,"_3093":126186},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3704":74806,"_31315":74788,"_21707":126188,"_5":14937,"_28496":126137,"_3093":126189},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3704":74807,"_31315":74788,"_21707":126191,"_5":14937,"_28496":126137,"_3093":126192},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3704":74808,"_31315":74788,"_21707":126194,"_5":14937,"_28496":126137,"_3093":126195},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3704":74809,"_31315":74788,"_21707":126197,"_5":14937,"_28496":126137,"_3093":126198},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3704":74810,"_31315":74788,"_21707":126200,"_5":14937,"_28496":126137,"_3093":126201},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3704":74811,"_31315":74788,"_21707":126203,"_5":14937,"_28496":126137,"_3093":126204},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3704":74812,"_31315":74788,"_21707":126206,"_5":14937,"_28496":126137,"_3093":126207},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3704":74813,"_31315":74788,"_21707":126209,"_5":14937,"_28496":126141,"_3093":126210},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3704":74814,"_31315":74788,"_21707":126212,"_5":14937,"_28496":126141,"_3093":56626},[],{"_3704":74815,"_31315":74788,"_21707":126214,"_5":14937,"_28496":126141,"_3093":126215},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3704":74816,"_31315":74788,"_21707":126217,"_5":14937,"_28496":126141,"_3093":126218},[],"**Icon** y **Tags**: clasificación opcional.",{"_3704":74817,"_31315":74788,"_21707":126220,"_5":14937,"_28496":126141,"_3093":126221},[],"Confirma el registro.",{"_3704":74818,"_31315":74788,"_21707":126223,"_5":14937,"_28496":126145,"_3093":126224},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3704":74819,"_31315":74788,"_21707":126226,"_5":14937,"_28496":126145,"_3093":126227},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3704":74820,"_31315":74788,"_21707":126229,"_5":14937,"_28496":126149,"_3093":126230},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3704":74821,"_31315":74788,"_21707":126232,"_5":14937,"_28496":126149,"_3093":126233},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3704":74822,"_31315":74788,"_21707":126235,"_5":14937,"_28496":126153,"_3093":126236},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3704":74823,"_31315":74788,"_21707":126238,"_5":14937,"_28496":126153,"_3093":126239},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3704":74824,"_31315":74788,"_21707":126241,"_5":14937,"_28496":126157,"_3093":126093},[],{"_3704":74825,"_31315":74788,"_21707":126243,"_5":14937,"_28496":126157,"_3093":126244},[],"Resultado",{"_3704":74826,"_31315":74788,"_21707":126246,"_5":14937,"_28496":126157,"_3093":125375},[],{"_3704":74827,"_31315":74788,"_21707":126248,"_5":14937,"_28496":126157,"_3093":126249},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3704":74828,"_31315":74788,"_21707":126251,"_5":14937,"_28496":126157,"_3093":126252},[],"Identidad actual",{"_3704":74829,"_31315":74788,"_21707":126254,"_5":14937,"_28496":126157,"_3093":126255},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3704":74830,"_31315":74788,"_21707":126257,"_5":14937,"_28496":126157,"_3093":126258},[],"Historial",{"_3704":74831,"_31315":74788,"_21707":126260,"_5":14937,"_28496":126157,"_3093":126261},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3704":74832,"_31315":74788,"_21707":126263,"_5":14937,"_28496":126157,"_3093":126264},[],"Clave y certificado",{"_3704":74833,"_31315":74788,"_21707":126266,"_5":14937,"_28496":126157,"_3093":126267},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3704":74834,"_31315":74788,"_21707":126269,"_5":14937,"_28496":126160,"_3093":126270},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3704":74835,"_31315":74788,"_21707":126272,"_5":14937,"_28496":126160,"_3093":126273},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3704":74836,"_31315":74788,"_21707":126275,"_5":14937,"_28496":126160,"_3093":126276},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3704":74837,"_31315":74788,"_21707":126278,"_5":14937,"_28496":126160,"_3093":126279},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3704":74838,"_31315":74788,"_21707":126281,"_5":14937,"_28496":126164,"_3093":126282},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3704":74839,"_31315":74788,"_21707":126284,"_5":14937,"_28496":126164,"_3093":126285},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3704":74840,"_31315":74788,"_21707":126287,"_5":14937,"_28496":126164,"_3093":126288},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3704":74841,"_31315":74841,"_5":15297,"_3093":126290,"_31653":126291,"_21707":126292,"_28496":74841},"Plataforma Lamassu IoT",[51162,122436],[],{"_3704":74842,"_31315":74841,"_21707":126294,"_5":14937,"_28496":74841,"_3093":126295},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3704":74843,"_31315":74841,"_5":31650,"_21707":126297,"_28496":126298,"_3093":125790},[],"/docs/es/platform/overview#empieza-aquí",{"_3704":74844,"_31315":74841,"_5":31650,"_21707":126300,"_28496":126301,"_3093":126302},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3704":74845,"_31315":74841,"_5":31650,"_21707":126304,"_28496":126305,"_3093":126306},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3704":74846,"_31315":74841,"_5":31650,"_21707":126308,"_28496":126309,"_3093":126310},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3704":74847,"_31315":74841,"_5":31650,"_21707":126312,"_28496":126313,"_3093":126314},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3704":74848,"_31315":74841,"_5":31650,"_21707":126316,"_28496":126317,"_3093":126318},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3704":74849,"_31315":74841,"_5":31650,"_21707":126320,"_28496":126321,"_3093":126322},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3704":74850,"_31315":74841,"_5":31650,"_21707":126324,"_28496":126325,"_3093":126326},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3704":74851,"_31315":74841,"_5":31650,"_21707":126328,"_28496":126329,"_3093":126330},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3704":74852,"_31315":74841,"_5":31650,"_21707":126332,"_28496":126333,"_3093":126334},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3704":74853,"_31315":74841,"_5":31650,"_21707":126336,"_28496":126337,"_3093":126338},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3704":74854,"_31315":74841,"_21707":126340,"_5":14937,"_28496":74841,"_3093":126341},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3704":74855,"_31315":74841,"_21707":126343,"_5":14937,"_28496":126298,"_3093":126344},[],"Elige el resultado que necesitas obtener:",{"_3704":74856,"_31315":74841,"_21707":126346,"_5":14937,"_28496":126298,"_3093":126347},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3704":74857,"_31315":74841,"_21707":126349,"_5":14937,"_28496":126298,"_3093":126350},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3704":74858,"_31315":74841,"_21707":126352,"_5":14937,"_28496":126298,"_3093":126353},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3704":74859,"_31315":74841,"_21707":126355,"_5":14937,"_28496":126301,"_3093":126356},[],"Bloque",{"_3704":74860,"_31315":74841,"_21707":126358,"_5":14937,"_28496":126301,"_3093":126359},[],"Qué gestionas",{"_3704":74861,"_31315":74841,"_21707":126361,"_5":14937,"_28496":126301,"_3093":126362},[],"Punto de entrada",{"_3704":74862,"_31315":74841,"_21707":126364,"_5":14937,"_28496":126301,"_3093":56779},[],{"_3704":74863,"_31315":74841,"_21707":126366,"_5":14937,"_28496":126301,"_3093":126367},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3704":74864,"_31315":74841,"_21707":126369,"_5":14937,"_28496":126301,"_3093":126370},[],"Visión general de PKI",{"_3704":74865,"_31315":74841,"_21707":126372,"_5":14937,"_28496":126301,"_3093":56788},[],{"_3704":74866,"_31315":74841,"_21707":126374,"_5":14937,"_28496":126301,"_3093":126375},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3704":74867,"_31315":74841,"_21707":126377,"_5":14937,"_28496":126301,"_3093":126378},[],"Visión general de IoT Fleets",{"_3704":74868,"_31315":74841,"_21707":126380,"_5":14937,"_28496":126301,"_3093":126381},[],"**Administración**",{"_3704":74869,"_31315":74841,"_21707":126383,"_5":14937,"_28496":126301,"_3093":126384},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3704":74870,"_31315":74841,"_21707":126386,"_5":14937,"_28496":126301,"_3093":122438},[],{"_3704":74871,"_31315":74841,"_21707":126388,"_5":14937,"_28496":126301,"_3093":126389},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3704":74872,"_31315":74841,"_21707":126391,"_5":14937,"_28496":126305,"_3093":126392},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3704":74873,"_31315":74841,"_21707":126394,"_5":14937,"_28496":126305,"_3093":126395},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3704":74874,"_31315":74841,"_21707":126397,"_5":14937,"_28496":126305,"_3093":126398},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3704":74875,"_31315":74841,"_21707":126400,"_5":14937,"_28496":126305,"_3093":126401},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3704":74876,"_31315":74841,"_21707":126403,"_5":14937,"_28496":126305,"_3093":126404},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3704":74877,"_31315":74841,"_21707":126406,"_5":14937,"_28496":126305,"_3093":126407},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3704":74878,"_31315":74841,"_21707":126409,"_5":14937,"_28496":126313,"_3093":126410},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3704":74879,"_31315":74841,"_21707":126412,"_5":14937,"_28496":126317,"_3093":126413},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3704":74880,"_31315":74841,"_21707":126415,"_5":14937,"_28496":126321,"_3093":126416},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3704":74881,"_31315":74841,"_21707":126418,"_5":14937,"_28496":126325,"_3093":126419},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3704":74882,"_31315":74841,"_21707":126421,"_5":14937,"_28496":126329,"_3093":126422},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3704":74883,"_31315":74841,"_21707":126424,"_5":14937,"_28496":126333,"_3093":126425},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3704":74884,"_31315":74841,"_21707":126427,"_5":14937,"_28496":126337,"_3093":125883},[],{"_3704":74885,"_31315":74841,"_21707":126429,"_5":14937,"_28496":126337,"_3093":126430},[],"Qué prepara o comprueba",{"_3704":74886,"_31315":74841,"_21707":126432,"_5":14937,"_28496":126337,"_3093":125886},[],{"_3704":74887,"_31315":74841,"_21707":126434,"_5":14937,"_28496":126337,"_3093":126435},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3704":74888,"_31315":74841,"_21707":126437,"_5":14937,"_28496":126337,"_3093":126438},[],"Administrador de la flota",{"_3704":74889,"_31315":74841,"_21707":126440,"_5":14937,"_28496":126337,"_3093":126441},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3704":74890,"_31315":74841,"_21707":126443,"_5":14937,"_28496":126337,"_3093":125898},[],{"_3704":74891,"_31315":74841,"_21707":126445,"_5":14937,"_28496":126337,"_3093":126446},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3704":74892,"_31315":74841,"_21707":126448,"_5":14937,"_28496":126337,"_3093":125904},[],{"_3704":74893,"_31315":74841,"_21707":126450,"_5":14937,"_28496":126337,"_3093":126451},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3704":74894,"_31315":74841,"_21707":126453,"_5":14937,"_28496":126337,"_3093":126454},[],"Operador de infraestructura",{"_3704":74895,"_31315":74841,"_21707":126456,"_5":14937,"_28496":126337,"_3093":126457},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3704":74896,"_31315":74841,"_21707":126459,"_5":14937,"_28496":126337,"_3093":126460},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3704":74897,"_31315":74897,"_5":15297,"_3093":126462,"_31653":126463,"_21707":126465,"_28496":74897},"Jerarquía y rotación de CAs",[51162,122436,56880,126464],"Claves, autoridades y certificados",[],{"_3704":74898,"_31315":74897,"_21707":126467,"_5":14937,"_28496":74897,"_3093":126468},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3704":74899,"_31315":74897,"_5":31650,"_21707":126470,"_28496":126471,"_3093":126472},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3704":74900,"_31315":74897,"_5":31650,"_21707":126474,"_28496":126475,"_3093":126476},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3704":74901,"_31315":74897,"_5":31650,"_21707":126478,"_28496":126479,"_3093":126480},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3704":74902,"_31315":74897,"_5":31650,"_21707":126482,"_28496":126483,"_3093":126484},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3704":74903,"_31315":74897,"_5":31650,"_21707":126486,"_28496":126487,"_3093":126488},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3704":74904,"_31315":74897,"_5":31650,"_21707":126490,"_28496":126491,"_3093":126492},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3704":74905,"_31315":74897,"_5":31650,"_21707":126494,"_28496":126495,"_3093":126496},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3704":74906,"_31315":74897,"_5":31650,"_21707":126498,"_28496":126499,"_3093":126500},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3704":74907,"_31315":74897,"_5":31650,"_21707":126502,"_28496":126503,"_3093":126504},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3704":74908,"_31315":74897,"_5":31650,"_21707":126506,"_28496":126507,"_3093":126508},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3704":74909,"_31315":74897,"_5":31650,"_21707":126510,"_28496":126511,"_3093":126512},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3704":74910,"_31315":74897,"_5":31650,"_21707":126514,"_28496":126515,"_3093":126516},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3704":74911,"_31315":74897,"_21707":126518,"_5":14937,"_28496":74897,"_3093":126519},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3704":74912,"_31315":74897,"_21707":126521,"_5":14937,"_28496":74897,"_3093":126522},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3704":74913,"_31315":74897,"_21707":126524,"_5":14937,"_28496":126471,"_3093":126525},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3704":74914,"_31315":74897,"_21707":126527,"_5":14937,"_28496":126471,"_3093":126528},[],"entorno, como producción y preproducción;",{"_3704":74915,"_31315":74897,"_21707":126530,"_5":14937,"_28496":126471,"_3093":126531},[],"propietario o equipo operador;",{"_3704":74916,"_31315":74897,"_21707":126533,"_5":14937,"_28496":126471,"_3093":126534},[],"familia de dispositivos o proceso de fabricación;",{"_3704":74917,"_31315":74897,"_21707":126536,"_5":14937,"_28496":126471,"_3093":126537},[],"región o requisito regulatorio;",{"_3704":74918,"_31315":74897,"_21707":126539,"_5":14937,"_28496":126471,"_3093":126540},[],"motor criptográfico o política de clave;",{"_3704":74919,"_31315":74897,"_21707":126542,"_5":14937,"_28496":126471,"_3093":126543},[],"ventana de mantenimiento y ritmo de renovación.",{"_3704":74920,"_31315":74897,"_21707":126545,"_5":14937,"_28496":126471,"_3093":126546},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3704":74921,"_31315":74897,"_21707":126548,"_5":14937,"_28496":126471,"_3093":126549},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3704":74922,"_31315":74897,"_21707":126551,"_5":14937,"_28496":126475,"_3093":126552},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3704":74923,"_31315":74897,"_21707":126554,"_5":14937,"_28496":126475,"_3093":126555},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3704":74924,"_31315":74897,"_21707":126557,"_5":14937,"_28496":126475,"_3093":126558},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3704":74925,"_31315":74897,"_21707":126560,"_5":14937,"_28496":126475,"_3093":126561},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3704":74926,"_31315":74897,"_21707":126563,"_5":14937,"_28496":126479,"_3093":126564},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3704":74927,"_31315":74897,"_21707":126566,"_5":14937,"_28496":126479,"_3093":126567},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3704":74928,"_31315":74897,"_21707":126569,"_5":14937,"_28496":126479,"_3093":126570},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3704":74929,"_31315":74897,"_21707":126572,"_5":14937,"_28496":126479,"_3093":126573},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3704":74930,"_31315":74897,"_21707":126575,"_5":14937,"_28496":126487,"_3093":126576},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3704":74931,"_31315":74897,"_21707":126578,"_5":14937,"_28496":126491,"_3093":126579},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3704":74932,"_31315":74897,"_21707":126581,"_5":14937,"_28496":126495,"_3093":126582},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3704":74933,"_31315":74897,"_21707":126584,"_5":14937,"_28496":126499,"_3093":126585},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3704":74934,"_31315":74897,"_21707":126587,"_5":14937,"_28496":126503,"_3093":126588},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3704":74935,"_31315":74897,"_21707":126590,"_5":14937,"_28496":126507,"_3093":126591},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3704":74936,"_31315":74897,"_21707":126593,"_5":14937,"_28496":126511,"_3093":126594},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3704":74937,"_31315":74897,"_21707":126596,"_5":14937,"_28496":126511,"_3093":126597},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3704":74938,"_31315":74897,"_21707":126599,"_5":14937,"_28496":126511,"_3093":126600},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3704":74939,"_31315":74897,"_21707":126602,"_5":14937,"_28496":126511,"_3093":126603},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3704":74940,"_31315":74897,"_21707":126605,"_5":14937,"_28496":126515,"_3093":126606},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3704":74941,"_31315":74897,"_21707":126608,"_5":14937,"_28496":126515,"_3093":126609},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3704":74942,"_31315":74897,"_21707":126611,"_5":14937,"_28496":126515,"_3093":126612},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3704":74943,"_31315":74897,"_21707":126614,"_5":14937,"_28496":126515,"_3093":126615},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3704":74944,"_31315":74897,"_21707":126617,"_5":14937,"_28496":126515,"_3093":126618},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3704":74945,"_31315":74897,"_21707":126620,"_5":14937,"_28496":126515,"_3093":126621},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3704":74946,"_31315":74897,"_21707":126623,"_5":14937,"_28496":126515,"_3093":126624},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3704":74947,"_31315":74947,"_5":15297,"_3093":126626,"_31653":126627,"_21707":126628,"_28496":74947},"Autoridades de certificación",[51162,122436,56880,126464],[],{"_3704":74948,"_31315":74947,"_21707":126630,"_5":14937,"_28496":74947,"_3093":126631},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3704":74949,"_31315":74947,"_5":31650,"_21707":126633,"_28496":126634,"_3093":126635},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3704":74950,"_31315":74947,"_5":31650,"_21707":126637,"_28496":126638,"_3093":126639},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3704":74951,"_31315":74947,"_5":31650,"_21707":126641,"_28496":126642,"_3093":120944},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3704":74952,"_31315":74947,"_5":31650,"_21707":126644,"_28496":126645,"_3093":126646},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3704":74953,"_31315":74947,"_5":31650,"_21707":126648,"_28496":126649,"_3093":126650},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3704":74954,"_31315":74947,"_5":31650,"_21707":126652,"_28496":126653,"_3093":126654},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3704":74955,"_31315":74947,"_5":31650,"_21707":126656,"_28496":126657,"_3093":126658},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3704":74956,"_31315":74947,"_5":31650,"_21707":126660,"_28496":126661,"_3093":126662},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3704":74957,"_31315":74947,"_5":31650,"_21707":126664,"_28496":126665,"_3093":126666},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3704":74958,"_31315":74947,"_5":31650,"_21707":126668,"_28496":126669,"_3093":126670},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3704":74959,"_31315":74947,"_5":31650,"_21707":126672,"_28496":126673,"_3093":126674},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3704":74960,"_31315":74947,"_5":31650,"_21707":126676,"_28496":126677,"_3093":126678},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3704":74961,"_31315":74947,"_5":31650,"_21707":126680,"_28496":126681,"_3093":126682},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3704":74962,"_31315":74947,"_5":31650,"_21707":126684,"_28496":126685,"_3093":126686},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3704":74963,"_31315":74947,"_5":31650,"_21707":126688,"_28496":126689,"_3093":126690},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3704":74964,"_31315":74947,"_5":31650,"_21707":126692,"_28496":126693,"_3093":126694},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3704":74965,"_31315":74947,"_5":31650,"_21707":126696,"_28496":126697,"_3093":126698},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3704":74966,"_31315":74947,"_5":31650,"_21707":126700,"_28496":126701,"_3093":126702},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3704":74967,"_31315":74947,"_5":31650,"_21707":126704,"_28496":126705,"_3093":126706},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3704":74968,"_31315":74947,"_5":31650,"_21707":126708,"_28496":126709,"_3093":126710},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3704":74969,"_31315":74947,"_5":31650,"_21707":126712,"_28496":126713,"_3093":126714},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3704":74970,"_31315":74947,"_5":31650,"_21707":126716,"_28496":126717,"_3093":126718},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3704":74971,"_31315":74947,"_5":31650,"_21707":126720,"_28496":126721,"_3093":126722},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3704":74972,"_31315":74947,"_5":31650,"_21707":126724,"_28496":126725,"_3093":126726},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3704":74973,"_31315":74947,"_21707":126728,"_5":14937,"_28496":74947,"_3093":126729},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3704":74974,"_31315":74947,"_21707":126731,"_5":14937,"_28496":74947,"_3093":126732},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3704":74975,"_31315":74947,"_21707":126734,"_5":14937,"_28496":74947,"_3093":126735},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3704":74976,"_31315":74947,"_21707":126737,"_5":14937,"_28496":126634,"_3093":126738},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3704":74977,"_31315":74947,"_21707":126740,"_5":14937,"_28496":126634,"_3093":126741},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3704":74978,"_31315":74947,"_21707":126743,"_5":14937,"_28496":126634,"_3093":126744},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3704":74979,"_31315":74947,"_21707":126746,"_5":14937,"_28496":126634,"_3093":126747},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3704":74980,"_31315":74947,"_21707":126749,"_5":14937,"_28496":126634,"_3093":126750},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3704":74981,"_31315":74947,"_21707":126752,"_5":14937,"_28496":126642,"_3093":126753},[],"Decide si la CA será raíz o intermedia.",{"_3704":74982,"_31315":74947,"_21707":126755,"_5":14937,"_28496":126642,"_3093":126756},[],"Elige el motor que custodiará la clave.",{"_3704":74983,"_31315":74947,"_21707":126758,"_5":14937,"_28496":126642,"_3093":126759},[],"Define una validez superior a la de los certificados que emitirá.",{"_3704":74984,"_31315":74947,"_21707":126761,"_5":14937,"_28496":126642,"_3093":126762},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3704":74985,"_31315":74947,"_21707":126764,"_5":14937,"_28496":126645,"_3093":126765},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3704":74986,"_31315":74947,"_21707":126767,"_5":14937,"_28496":126649,"_3093":126768},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3704":74987,"_31315":74947,"_21707":126770,"_5":14937,"_28496":126649,"_3093":126771},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3704":74988,"_31315":74947,"_21707":126773,"_5":14937,"_28496":126653,"_3093":126774},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3704":74989,"_31315":74947,"_21707":126776,"_5":14937,"_28496":126657,"_3093":126777},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3704":74990,"_31315":74947,"_21707":126779,"_5":14937,"_28496":126657,"_3093":126780},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3704":74991,"_31315":74947,"_21707":126782,"_5":14937,"_28496":126657,"_3093":126783},[],"`ST`: estado o provincia.",{"_3704":74992,"_31315":74947,"_21707":126785,"_5":14937,"_28496":126657,"_3093":126786},[],"`L`: localidad.",{"_3704":74993,"_31315":74947,"_21707":126788,"_5":14937,"_28496":126657,"_3093":126789},[],"`O`: organización.",{"_3704":74994,"_31315":74947,"_21707":126791,"_5":14937,"_28496":126657,"_3093":126792},[],"`OU`: unidad organizativa.",{"_3704":74995,"_31315":74947,"_21707":126794,"_5":14937,"_28496":126657,"_3093":126795},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3704":74996,"_31315":74947,"_21707":126797,"_5":14937,"_28496":126661,"_3093":126798},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3704":74997,"_31315":74947,"_21707":126800,"_5":14937,"_28496":126661,"_3093":126801},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3704":74998,"_31315":74947,"_21707":126803,"_5":14937,"_28496":126665,"_3093":126804},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3704":74999,"_31315":74947,"_21707":126806,"_5":14937,"_28496":126665,"_3093":126807},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3704":75000,"_31315":74947,"_21707":126809,"_5":14937,"_28496":126669,"_3093":126810},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3704":75001,"_31315":74947,"_21707":126812,"_5":14937,"_28496":126669,"_3093":126813},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3704":75002,"_31315":74947,"_21707":126815,"_5":14937,"_28496":126673,"_3093":126816},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3704":75003,"_31315":74947,"_21707":126818,"_5":14937,"_28496":126673,"_3093":126819},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3704":75004,"_31315":74947,"_21707":126821,"_5":14937,"_28496":126673,"_3093":126822},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3704":75005,"_31315":74947,"_21707":126824,"_5":14937,"_28496":126673,"_3093":126825},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3704":75006,"_31315":74947,"_21707":126827,"_5":14937,"_28496":126677,"_3093":126828},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3704":75007,"_31315":74947,"_21707":126830,"_5":14937,"_28496":126681,"_3093":126831},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3704":75008,"_31315":74947,"_21707":126833,"_5":14937,"_28496":126681,"_3093":126834},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3704":75009,"_31315":74947,"_21707":126836,"_5":14937,"_28496":126685,"_3093":126837},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3704":75010,"_31315":74947,"_21707":126839,"_5":14937,"_28496":126689,"_3093":126840},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3704":75011,"_31315":74947,"_21707":126842,"_5":14937,"_28496":126689,"_3093":126843},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3704":75012,"_31315":74947,"_21707":126845,"_5":14937,"_28496":126689,"_3093":126846},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3704":75013,"_31315":74947,"_21707":126848,"_5":14937,"_28496":126693,"_3093":126849},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3704":75014,"_31315":74947,"_21707":126851,"_5":14937,"_28496":126693,"_3093":126852},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3704":75015,"_31315":74947,"_21707":126854,"_5":14937,"_28496":126693,"_3093":126855},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3704":75016,"_31315":74947,"_21707":126857,"_5":14937,"_28496":126693,"_3093":126858},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3704":75017,"_31315":74947,"_21707":126860,"_5":14937,"_28496":126697,"_3093":126861},[],"Abre una CA desde el inventario para consultar:",{"_3704":75018,"_31315":74947,"_21707":126863,"_5":14937,"_28496":126697,"_3093":126864},[],"Estado y periodo de validez.",{"_3704":75019,"_31315":74947,"_21707":126866,"_5":14937,"_28496":126697,"_3093":126867},[],"Certificado y cadena en formato PEM.",{"_3704":75020,"_31315":74947,"_21707":126869,"_5":14937,"_28496":126697,"_3093":126870},[],"Número de certificados activos, expirados y revocados.",{"_3704":75021,"_31315":74947,"_21707":126872,"_5":14937,"_28496":126697,"_3093":126873},[],"Certificados emitidos en **Issued Certificates**.",{"_3704":75022,"_31315":74947,"_21707":126875,"_5":14937,"_28496":126697,"_3093":126876},[],"CRL vinculada a la autoridad.",{"_3704":75023,"_31315":74947,"_21707":126878,"_5":14937,"_28496":126697,"_3093":126879},[],"Metadatos y motor criptográfico asociado.",{"_3704":75024,"_31315":74947,"_21707":126881,"_5":14937,"_28496":126697,"_3093":126882},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3704":75025,"_31315":74947,"_21707":126884,"_5":14937,"_28496":126701,"_3093":126885},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3704":75026,"_31315":74947,"_21707":126887,"_5":14937,"_28496":126701,"_3093":126888},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3704":75027,"_31315":74947,"_21707":126890,"_5":14937,"_28496":126701,"_3093":126891},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3704":75028,"_31315":74947,"_21707":126893,"_5":14937,"_28496":126701,"_3093":126894},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3704":75029,"_31315":74947,"_21707":126896,"_5":14937,"_28496":126701,"_3093":126897},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3704":75030,"_31315":74947,"_21707":126899,"_5":14937,"_28496":126701,"_3093":126900},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3704":75031,"_31315":74947,"_21707":126902,"_5":14937,"_28496":126705,"_3093":126903},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3704":75032,"_31315":74947,"_21707":126905,"_5":14937,"_28496":126709,"_3093":126906},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3704":75033,"_31315":74947,"_21707":126908,"_5":14937,"_28496":126713,"_3093":126909},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3704":75034,"_31315":74947,"_21707":126911,"_5":14937,"_28496":126717,"_3093":126912},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3704":75035,"_31315":74947,"_21707":126914,"_5":14937,"_28496":126721,"_3093":126915},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3704":75036,"_31315":74947,"_21707":126917,"_5":14937,"_28496":126725,"_3093":126918},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3704":75037,"_31315":74947,"_21707":126920,"_5":14937,"_28496":126725,"_3093":126921},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3704":75038,"_31315":74947,"_21707":126923,"_5":14937,"_28496":126725,"_3093":126924},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3704":75039,"_31315":74947,"_21707":126926,"_5":14937,"_28496":126725,"_3093":126927},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3704":75040,"_31315":74947,"_21707":126929,"_5":14937,"_28496":126725,"_3093":126930},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3704":75041,"_31315":75041,"_5":15297,"_3093":126932,"_31653":126933,"_21707":126934,"_28496":75041},"Perfiles de certificado",[51162,122436,56880,126464],[],{"_3704":75042,"_31315":75041,"_21707":126936,"_5":14937,"_28496":75041,"_3093":126937},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3704":75043,"_31315":75041,"_5":31650,"_21707":126939,"_28496":126940,"_3093":126941},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3704":75044,"_31315":75041,"_5":31650,"_21707":126943,"_28496":126944,"_3093":126945},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3704":75045,"_31315":75041,"_5":31650,"_21707":126947,"_28496":126948,"_3093":126949},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3704":75046,"_31315":75041,"_5":31650,"_21707":126951,"_28496":126952,"_3093":126953},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3704":75047,"_31315":75041,"_5":31650,"_21707":126955,"_28496":126956,"_3093":126957},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3704":75048,"_31315":75041,"_5":31650,"_21707":126959,"_28496":126960,"_3093":126961},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3704":75049,"_31315":75041,"_5":31650,"_21707":126963,"_28496":126964,"_3093":126965},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3704":75050,"_31315":75041,"_5":31650,"_21707":126967,"_28496":126968,"_3093":126969},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3704":75051,"_31315":75041,"_5":31650,"_21707":126971,"_28496":126972,"_3093":126973},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3704":75052,"_31315":75041,"_5":31650,"_21707":126975,"_28496":126976,"_3093":126977},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3704":75053,"_31315":75041,"_5":31650,"_21707":126979,"_28496":126980,"_3093":126981},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3704":75054,"_31315":75041,"_5":31650,"_21707":126983,"_28496":126984,"_3093":126985},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3704":75055,"_31315":75041,"_5":31650,"_21707":126987,"_28496":126988,"_3093":126989},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3704":75056,"_31315":75041,"_5":31650,"_21707":126991,"_28496":126992,"_3093":126993},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3704":75057,"_31315":75041,"_5":31650,"_21707":126995,"_28496":126996,"_3093":126997},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3704":75058,"_31315":75041,"_5":31650,"_21707":126999,"_28496":127000,"_3093":127001},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3704":75059,"_31315":75041,"_21707":127003,"_5":14937,"_28496":75041,"_3093":127004},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3704":75060,"_31315":75041,"_21707":127006,"_5":14937,"_28496":75041,"_3093":127007},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3704":75061,"_31315":75041,"_21707":127009,"_5":14937,"_28496":126944,"_3093":127010},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3704":75062,"_31315":75041,"_21707":127012,"_5":14937,"_28496":126944,"_3093":127013},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3704":75063,"_31315":75041,"_21707":127015,"_5":14937,"_28496":126948,"_3093":127016},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3704":75064,"_31315":75041,"_21707":127018,"_5":14937,"_28496":126952,"_3093":127019},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3704":75065,"_31315":75041,"_21707":127021,"_5":14937,"_28496":126952,"_3093":127022},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3704":75066,"_31315":75041,"_21707":127024,"_5":14937,"_28496":126952,"_3093":127025},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3704":75067,"_31315":75041,"_21707":127027,"_5":14937,"_28496":126956,"_3093":127028},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3704":75068,"_31315":75041,"_21707":127030,"_5":14937,"_28496":126960,"_3093":127031},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3704":75069,"_31315":75041,"_21707":127033,"_5":14937,"_28496":126960,"_3093":127034},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3704":75070,"_31315":75041,"_21707":127036,"_5":14937,"_28496":126964,"_3093":127037},[],"La aplicación criptográfica puede:",{"_3704":75071,"_31315":75041,"_21707":127039,"_5":14937,"_28496":126964,"_3093":127040},[],"permitir o bloquear claves RSA;",{"_3704":75072,"_31315":75041,"_21707":127042,"_5":14937,"_28496":126964,"_3093":127043},[],"limitar los tamaños RSA admitidos;",{"_3704":75073,"_31315":75041,"_21707":127045,"_5":14937,"_28496":126964,"_3093":127046},[],"permitir o bloquear claves ECDSA;",{"_3704":75074,"_31315":75041,"_21707":127048,"_5":14937,"_28496":126964,"_3093":127049},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3704":75075,"_31315":75041,"_21707":127051,"_5":14937,"_28496":126964,"_3093":127052},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3704":75076,"_31315":75041,"_21707":127054,"_5":14937,"_28496":126968,"_3093":127055},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3704":75077,"_31315":75041,"_21707":127057,"_5":14937,"_28496":126968,"_3093":122196},[],{"_3704":75078,"_31315":75041,"_21707":127059,"_5":14937,"_28496":126968,"_3093":127060},[],"Primera opción",{"_3704":75079,"_31315":75041,"_21707":127062,"_5":14937,"_28496":126968,"_3093":127063},[],"Segunda opción",{"_3704":75080,"_31315":75041,"_21707":127065,"_5":14937,"_28496":126968,"_3093":127066},[],"Si no hay ninguna",{"_3704":75081,"_31315":75041,"_21707":127068,"_5":14937,"_28496":126968,"_3093":127069},[],"Firma directa con una CA",{"_3704":75082,"_31315":75041,"_21707":127071,"_5":14937,"_28496":126968,"_3093":127072},[],"`issuance_profile` incluido en la solicitud",{"_3704":75083,"_31315":75041,"_21707":127074,"_5":14937,"_28496":126968,"_3093":127075},[],"`issuance_profile_id` de la solicitud",{"_3704":75084,"_31315":75041,"_21707":127077,"_5":14937,"_28496":126968,"_3093":127078},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3704":75085,"_31315":75041,"_21707":127080,"_5":14937,"_28496":126968,"_3093":127081},[],"Emisión mediante DMS",{"_3704":75086,"_31315":75041,"_21707":127083,"_5":14937,"_28496":126968,"_3093":57501},[],{"_3704":75087,"_31315":75041,"_21707":127085,"_5":14937,"_28496":126968,"_3093":127086},[],"`settings.issuance_profile` incluido en el DMS",{"_3704":75088,"_31315":75041,"_21707":127088,"_5":14937,"_28496":126968,"_3093":127089},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3704":75089,"_31315":75041,"_21707":127091,"_5":14937,"_28496":126968,"_3093":127092},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3704":75090,"_31315":75041,"_21707":127094,"_5":14937,"_28496":126968,"_3093":127095},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3704":75091,"_31315":75041,"_21707":127097,"_5":14937,"_28496":126976,"_3093":127098},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3704":75092,"_31315":75041,"_21707":127100,"_5":14937,"_28496":126980,"_3093":127101},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3704":75093,"_31315":75041,"_21707":127103,"_5":14937,"_28496":126984,"_3093":127104},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3704":75094,"_31315":75041,"_21707":127106,"_5":14937,"_28496":126988,"_3093":127107},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3704":75095,"_31315":75041,"_21707":127109,"_5":14937,"_28496":126992,"_3093":127110},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3704":75096,"_31315":75041,"_21707":127112,"_5":14937,"_28496":126992,"_3093":127113},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3704":75097,"_31315":75041,"_21707":127115,"_5":14937,"_28496":126996,"_3093":127116},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3704":75098,"_31315":75041,"_21707":127118,"_5":14937,"_28496":126996,"_3093":127119},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3704":75099,"_31315":75041,"_21707":127121,"_5":14937,"_28496":126996,"_3093":127122},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3704":75100,"_31315":75041,"_21707":127124,"_5":14937,"_28496":126996,"_3093":127125},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3704":75101,"_31315":75041,"_21707":127127,"_5":14937,"_28496":127000,"_3093":127128},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3704":75102,"_31315":75041,"_21707":127130,"_5":14937,"_28496":127000,"_3093":127131},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3704":75103,"_31315":75103,"_5":15297,"_3093":127133,"_31653":127134,"_21707":127136,"_28496":75103},"Validación de certificados",[51162,122436,56880,127135],"Validación",[],{"_3704":75104,"_31315":75103,"_21707":127138,"_5":14937,"_28496":75103,"_3093":127139},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3704":75105,"_31315":75103,"_5":31650,"_21707":127141,"_28496":127142,"_3093":127143},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3704":75106,"_31315":75103,"_5":31650,"_21707":127145,"_28496":127146,"_3093":127147},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3704":75107,"_31315":75103,"_5":31650,"_21707":127149,"_28496":127150,"_3093":127151},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3704":75108,"_31315":75103,"_21707":127153,"_5":14937,"_28496":75103,"_3093":127154},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3704":75109,"_31315":75103,"_21707":127156,"_5":14937,"_28496":127142,"_3093":127157},[],"Verifica estos criterios juntos:",{"_3704":75110,"_31315":75103,"_21707":127159,"_5":14937,"_28496":127142,"_3093":126093},[],{"_3704":75111,"_31315":75103,"_21707":127161,"_5":14937,"_28496":127142,"_3093":127162},[],"Resultado necesario",{"_3704":75112,"_31315":75103,"_21707":127164,"_5":14937,"_28496":127142,"_3093":127165},[],"Cadena y firma",{"_3704":75113,"_31315":75103,"_21707":127167,"_5":14937,"_28496":127142,"_3093":127168},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3704":75114,"_31315":75103,"_21707":127170,"_5":14937,"_28496":127142,"_3093":127171},[],"Fechas",{"_3704":75115,"_31315":75103,"_21707":127173,"_5":14937,"_28496":127142,"_3093":127174},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3704":75116,"_31315":75103,"_21707":127176,"_5":14937,"_28496":127142,"_3093":122106},[],{"_3704":75117,"_31315":75103,"_21707":127178,"_5":14937,"_28496":127142,"_3093":127179},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3704":75118,"_31315":75103,"_21707":127181,"_5":14937,"_28496":127142,"_3093":127182},[],"Uso",{"_3704":75119,"_31315":75103,"_21707":127184,"_5":14937,"_28496":127142,"_3093":127185},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3704":75120,"_31315":75103,"_21707":127187,"_5":14937,"_28496":127142,"_3093":127188},[],"Revocación",{"_3704":75121,"_31315":75103,"_21707":127190,"_5":14937,"_28496":127142,"_3093":127191},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3704":75122,"_31315":75103,"_21707":127193,"_5":14937,"_28496":127142,"_3093":127194},[],"Autorización",{"_3704":75123,"_31315":75103,"_21707":127196,"_5":14937,"_28496":127142,"_3093":127197},[],"La aplicación permite la acción a esa identidad.",{"_3704":75124,"_31315":75103,"_21707":127199,"_5":14937,"_28496":127142,"_3093":127200},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3704":75125,"_31315":75103,"_21707":127202,"_5":14937,"_28496":127146,"_3093":127203},[],"Mecanismo",{"_3704":75126,"_31315":75103,"_21707":127205,"_5":14937,"_28496":127146,"_3093":127206},[],"Cuándo utilizarlo",{"_3704":75127,"_31315":75103,"_21707":127208,"_5":14937,"_28496":127146,"_3093":127209},[],"Qué debes mantener",{"_3704":75128,"_31315":75103,"_21707":127211,"_5":14937,"_28496":127146,"_3093":57629},[],{"_3704":75129,"_31315":75103,"_21707":127213,"_5":14937,"_28496":127146,"_3093":127214},[],"Consulta del estado de un certificado concreto.",{"_3704":75130,"_31315":75103,"_21707":127216,"_5":14937,"_28496":127146,"_3093":127217},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3704":75131,"_31315":75103,"_21707":127219,"_5":14937,"_28496":127146,"_3093":57638},[],{"_3704":75132,"_31315":75103,"_21707":127221,"_5":14937,"_28496":127146,"_3093":127222},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3704":75133,"_31315":75103,"_21707":127224,"_5":14937,"_28496":127146,"_3093":127225},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3704":75134,"_31315":75103,"_21707":127227,"_5":14937,"_28496":127146,"_3093":127228},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3704":75135,"_31315":75103,"_21707":127230,"_5":14937,"_28496":127146,"_3093":127231},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3704":75136,"_31315":75103,"_21707":127233,"_5":14937,"_28496":127150,"_3093":127234},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3704":75137,"_31315":75103,"_21707":127236,"_5":14937,"_28496":127150,"_3093":127237},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3704":75138,"_31315":75103,"_21707":127239,"_5":14937,"_28496":127150,"_3093":127240},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3704":75139,"_31315":75103,"_21707":127242,"_5":14937,"_28496":127150,"_3093":127243},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3704":75140,"_31315":75103,"_21707":127245,"_5":14937,"_28496":127150,"_3093":127246},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3704":75141,"_31315":75103,"_21707":127248,"_5":14937,"_28496":127150,"_3093":127249},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3704":75142,"_31315":75103,"_21707":127251,"_5":14937,"_28496":127150,"_3093":127252},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3704":75143,"_31315":75103,"_21707":127254,"_5":14937,"_28496":127150,"_3093":127255},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3704":75144,"_31315":75103,"_21707":127257,"_5":14937,"_28496":127150,"_3093":127258},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3704":75145,"_31315":75145,"_5":15297,"_3093":127260,"_31653":127261,"_21707":127262,"_28496":75145},"Certificados",[51162,122436,56880,126464],[],{"_3704":75146,"_31315":75145,"_21707":127264,"_5":14937,"_28496":75145,"_3093":127265},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3704":75147,"_31315":75145,"_5":31650,"_21707":127267,"_28496":127268,"_3093":127269},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3704":75148,"_31315":75145,"_5":31650,"_21707":127271,"_28496":127272,"_3093":127273},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3704":75149,"_31315":75145,"_5":31650,"_21707":127275,"_28496":127276,"_3093":127277},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3704":75150,"_31315":75145,"_5":31650,"_21707":127279,"_28496":127280,"_3093":127281},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3704":75151,"_31315":75145,"_5":31650,"_21707":127283,"_28496":127284,"_3093":127285},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3704":75152,"_31315":75145,"_5":31650,"_21707":127287,"_28496":127288,"_3093":127289},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3704":75153,"_31315":75145,"_5":31650,"_21707":127291,"_28496":127292,"_3093":127293},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3704":75154,"_31315":75145,"_5":31650,"_21707":127295,"_28496":127296,"_3093":127297},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3704":75155,"_31315":75145,"_5":31650,"_21707":127299,"_28496":127300,"_3093":127301},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3704":75156,"_31315":75145,"_21707":127303,"_5":14937,"_28496":75145,"_3093":127304},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3704":75157,"_31315":75145,"_21707":127306,"_5":14937,"_28496":127268,"_3093":127307},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3704":75158,"_31315":75145,"_21707":127309,"_5":14937,"_28496":127268,"_3093":127310},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3704":75159,"_31315":75145,"_21707":127312,"_5":14937,"_28496":127268,"_3093":127313},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3704":75160,"_31315":75145,"_21707":127315,"_5":14937,"_28496":127268,"_3093":127316},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3704":75161,"_31315":75145,"_21707":127318,"_5":14937,"_28496":127268,"_3093":127319},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3704":75162,"_31315":75145,"_21707":127321,"_5":14937,"_28496":127268,"_3093":127322},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3704":75163,"_31315":75145,"_21707":127324,"_5":14937,"_28496":127268,"_3093":127325},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3704":75164,"_31315":75145,"_21707":127327,"_5":14937,"_28496":127272,"_3093":127328},[],"Descarga el PEM e inspecciónalo:",{"_3704":75165,"_31315":75145,"_21707":127330,"_5":14937,"_28496":127272,"_3093":127331},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3704":75166,"_31315":75145,"_21707":127333,"_5":14937,"_28496":127276,"_3093":127334},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3704":75167,"_31315":75145,"_21707":127336,"_5":14937,"_28496":127276,"_3093":127337},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3704":75168,"_31315":75145,"_21707":127339,"_5":14937,"_28496":127276,"_3093":127340},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3704":75169,"_31315":75145,"_21707":127342,"_5":14937,"_28496":127276,"_3093":127343},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3704":75170,"_31315":75145,"_21707":127345,"_5":14937,"_28496":127276,"_3093":127346},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3704":75171,"_31315":75145,"_21707":127348,"_5":14937,"_28496":127276,"_3093":127349},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3704":75172,"_31315":75145,"_21707":127351,"_5":14937,"_28496":127276,"_3093":127352},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3704":75173,"_31315":75145,"_21707":127354,"_5":14937,"_28496":127280,"_3093":127355},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3704":75174,"_31315":75145,"_21707":127357,"_5":14937,"_28496":127284,"_3093":127358},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3704":75175,"_31315":75145,"_21707":127360,"_5":14937,"_28496":127288,"_3093":127361},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3704":75176,"_31315":75145,"_21707":127363,"_5":14937,"_28496":127292,"_3093":127364},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3704":75177,"_31315":75145,"_21707":127366,"_5":14937,"_28496":127292,"_3093":127367},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3704":75178,"_31315":75145,"_21707":127369,"_5":14937,"_28496":127292,"_3093":127370},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3704":75179,"_31315":75145,"_21707":127372,"_5":14937,"_28496":127296,"_3093":127373},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3704":75180,"_31315":75145,"_21707":127375,"_5":14937,"_28496":127296,"_3093":127376},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3704":75181,"_31315":75145,"_21707":127378,"_5":14937,"_28496":127296,"_3093":127379},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3704":75182,"_31315":75145,"_21707":127381,"_5":14937,"_28496":127300,"_3093":127382},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3704":75183,"_31315":75145,"_21707":127384,"_5":14937,"_28496":127300,"_3093":127385},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3704":75184,"_31315":75184,"_5":15297,"_3093":127387,"_31653":127388,"_21707":127390,"_28496":75184},"Ciclo de vida de un certificado",[51162,122436,56880,127389],"Conceptos",[],{"_3704":75185,"_31315":75184,"_21707":127392,"_5":14937,"_28496":75184,"_3093":127393},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3704":75186,"_31315":75184,"_5":31650,"_21707":127395,"_28496":127396,"_3093":127397},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3704":75187,"_31315":75184,"_5":31650,"_21707":127399,"_28496":127400,"_3093":127401},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3704":75188,"_31315":75184,"_5":31650,"_21707":127403,"_28496":127404,"_3093":127405},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3704":75189,"_31315":75184,"_5":31650,"_21707":127407,"_28496":127408,"_3093":127409},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3704":75190,"_31315":75184,"_5":31650,"_21707":127411,"_28496":127412,"_3093":127413},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3704":75191,"_31315":75184,"_5":31650,"_21707":127415,"_28496":127416,"_3093":127417},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3704":75192,"_31315":75184,"_5":31650,"_21707":127419,"_28496":127420,"_3093":125087},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3704":75193,"_31315":75184,"_5":31650,"_21707":127422,"_28496":127423,"_3093":127424},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3704":75194,"_31315":75184,"_5":31650,"_21707":127426,"_28496":127427,"_3093":127428},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3704":75195,"_31315":75184,"_5":31650,"_21707":127430,"_28496":127431,"_3093":127432},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3704":75196,"_31315":75184,"_21707":127434,"_5":14937,"_28496":75184,"_3093":127435},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3704":75197,"_31315":75184,"_21707":127437,"_5":14937,"_28496":127400,"_3093":127438},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3704":75198,"_31315":75184,"_21707":127440,"_5":14937,"_28496":127404,"_3093":127441},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3704":75199,"_31315":75184,"_21707":127443,"_5":14937,"_28496":127408,"_3093":127444},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3704":75200,"_31315":75184,"_21707":127446,"_5":14937,"_28496":127412,"_3093":127447},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3704":75201,"_31315":75184,"_21707":127449,"_5":14937,"_28496":127416,"_3093":127450},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3704":75202,"_31315":75184,"_21707":127452,"_5":14937,"_28496":127420,"_3093":127453},[],"Lamassu persiste cuatro estados X.509:",{"_3704":75203,"_31315":75184,"_21707":127455,"_5":14937,"_28496":127420,"_3093":127456},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3704":75204,"_31315":75184,"_21707":127458,"_5":14937,"_28496":127420,"_3093":127459},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3704":75205,"_31315":75184,"_21707":127461,"_5":14937,"_28496":127420,"_3093":127462},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3704":75206,"_31315":75184,"_21707":127464,"_5":14937,"_28496":127420,"_3093":127465},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3704":75207,"_31315":75184,"_21707":127467,"_5":14937,"_28496":127420,"_3093":127468},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3704":75208,"_31315":75184,"_21707":127470,"_5":14937,"_28496":127423,"_3093":127471},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3704":75209,"_31315":75184,"_21707":127473,"_5":14937,"_28496":127423,"_3093":127474},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3704":75210,"_31315":75184,"_21707":127476,"_5":14937,"_28496":127423,"_3093":127477},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3704":75211,"_31315":75184,"_21707":127479,"_5":14937,"_28496":127427,"_3093":127480},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3704":75212,"_31315":75184,"_21707":127482,"_5":14937,"_28496":127427,"_3093":127483},[],"Antes de confirmar:",{"_3704":75213,"_31315":75184,"_21707":127485,"_5":14937,"_28496":127427,"_3093":127486},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3704":75214,"_31315":75184,"_21707":127488,"_5":14937,"_28496":127427,"_3093":127489},[],"Distribuye la nueva cadena de confianza.",{"_3704":75215,"_31315":75184,"_21707":127491,"_5":14937,"_28496":127427,"_3093":127492},[],"Reemite las identidades necesarias.",{"_3704":75216,"_31315":75184,"_21707":127494,"_5":14937,"_28496":127427,"_3093":127495},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3704":75217,"_31315":75184,"_21707":127497,"_5":14937,"_28496":127427,"_3093":127498},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3704":75218,"_31315":75184,"_21707":127500,"_5":14937,"_28496":127427,"_3093":127501},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3704":75219,"_31315":75184,"_21707":127503,"_5":14937,"_28496":127431,"_3093":127504},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3704":75220,"_31315":75184,"_21707":127506,"_5":14937,"_28496":127431,"_3093":127507},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3704":75221,"_31315":75184,"_21707":127509,"_5":14937,"_28496":127431,"_3093":127510},[],"Cambios de estado y razones de revocación.",{"_3704":75222,"_31315":75184,"_21707":127512,"_5":14937,"_28496":127431,"_3093":127513},[],"Publicación y vigencia de OCSP y CRLs.",{"_3704":75223,"_31315":75184,"_21707":127515,"_5":14937,"_28496":127431,"_3093":127516},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3704":75224,"_31315":75184,"_21707":127518,"_5":14937,"_28496":127431,"_3093":127519},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3704":75225,"_31315":75225,"_5":15297,"_3093":127521,"_31653":127522,"_21707":127523,"_28496":75225},"Modelo de confianza",[51162,122436,56880,127389],[],{"_3704":75226,"_31315":75225,"_21707":127525,"_5":14937,"_28496":75225,"_3093":127526},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3704":75227,"_31315":75225,"_5":31650,"_21707":127528,"_28496":127529,"_3093":127530},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3704":75228,"_31315":75225,"_5":31650,"_21707":127532,"_28496":127533,"_3093":127534},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3704":75229,"_31315":75225,"_5":31650,"_21707":127536,"_28496":127537,"_3093":127538},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3704":75230,"_31315":75225,"_5":31650,"_21707":127540,"_28496":127541,"_3093":127542},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3704":75231,"_31315":75225,"_5":31650,"_21707":127544,"_28496":127545,"_3093":127546},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3704":75232,"_31315":75225,"_5":31650,"_21707":127548,"_28496":127549,"_3093":127550},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3704":75233,"_31315":75225,"_5":31650,"_21707":127552,"_28496":127553,"_3093":127554},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3704":75234,"_31315":75225,"_5":31650,"_21707":127556,"_28496":127557,"_3093":127558},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3704":75235,"_31315":75225,"_5":31650,"_21707":127560,"_28496":127561,"_3093":127562},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3704":75236,"_31315":75225,"_5":31650,"_21707":127564,"_28496":127565,"_3093":127566},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3704":75237,"_31315":75225,"_21707":127568,"_5":14937,"_28496":75225,"_3093":127569},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3704":75238,"_31315":75225,"_21707":127571,"_5":14937,"_28496":127533,"_3093":127572},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3704":75239,"_31315":75225,"_21707":127574,"_5":14937,"_28496":127537,"_3093":127575},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3704":75240,"_31315":75225,"_21707":127577,"_5":14937,"_28496":127541,"_3093":127578},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3704":75241,"_31315":75225,"_21707":127580,"_5":14937,"_28496":127545,"_3093":127581},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3704":75242,"_31315":75225,"_21707":127583,"_5":14937,"_28496":127549,"_3093":127584},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3704":75243,"_31315":75225,"_21707":127586,"_5":14937,"_28496":127549,"_3093":127587},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3704":75244,"_31315":75225,"_21707":127589,"_5":14937,"_28496":127549,"_3093":127590},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3704":75245,"_31315":75225,"_21707":127592,"_5":14937,"_28496":127549,"_3093":127593},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3704":75246,"_31315":75225,"_21707":127595,"_5":14937,"_28496":127549,"_3093":127596},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3704":75247,"_31315":75225,"_21707":127598,"_5":14937,"_28496":127549,"_3093":127599},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3704":75248,"_31315":75225,"_21707":127601,"_5":14937,"_28496":127553,"_3093":127602},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3704":75249,"_31315":75225,"_21707":127604,"_5":14937,"_28496":127553,"_3093":127605},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3704":75250,"_31315":75225,"_21707":127607,"_5":14937,"_28496":127553,"_3093":127608},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3704":75251,"_31315":75225,"_21707":127610,"_5":14937,"_28496":127553,"_3093":127611},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3704":75252,"_31315":75225,"_21707":127613,"_5":14937,"_28496":127553,"_3093":127614},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3704":75253,"_31315":75225,"_21707":127616,"_5":14937,"_28496":127557,"_3093":127617},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3704":75254,"_31315":75225,"_21707":127619,"_5":14937,"_28496":127557,"_3093":127620},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3704":75255,"_31315":75225,"_21707":127622,"_5":14937,"_28496":127557,"_3093":127623},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3704":75256,"_31315":75225,"_21707":127625,"_5":14937,"_28496":127557,"_3093":127626},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3704":75257,"_31315":75225,"_21707":127628,"_5":14937,"_28496":127557,"_3093":127629},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3704":75258,"_31315":75225,"_21707":127631,"_5":14937,"_28496":127557,"_3093":127632},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3704":75259,"_31315":75225,"_21707":127634,"_5":14937,"_28496":127557,"_3093":127635},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3704":75260,"_31315":75225,"_21707":127637,"_5":14937,"_28496":127561,"_3093":127638},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3704":75261,"_31315":75225,"_21707":127640,"_5":14937,"_28496":127565,"_3093":127641},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3704":75262,"_31315":75225,"_21707":127643,"_5":14937,"_28496":127565,"_3093":127644},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3704":75263,"_31315":75225,"_21707":127646,"_5":14937,"_28496":127565,"_3093":127647},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3704":75264,"_31315":75225,"_21707":127649,"_5":14937,"_28496":127565,"_3093":127650},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3704":75265,"_31315":75225,"_21707":127652,"_5":14937,"_28496":127565,"_3093":127653},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3704":75266,"_31315":75225,"_21707":127655,"_5":14937,"_28496":127565,"_3093":127656},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3704":75267,"_31315":75225,"_21707":127658,"_5":14937,"_28496":127565,"_3093":127659},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3704":75268,"_31315":75268,"_5":15297,"_3093":127661,"_31653":127662,"_21707":127663,"_28496":75268},"Listas de revocación (CRL)",[51162,122436,56880,127135],[],{"_3704":75269,"_31315":75268,"_21707":127665,"_5":14937,"_28496":75268,"_3093":127666},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3704":75270,"_31315":75268,"_5":31650,"_21707":127668,"_28496":127669,"_3093":127670},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3704":75271,"_31315":75268,"_5":31650,"_21707":127672,"_28496":127673,"_3093":127674},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3704":75272,"_31315":75268,"_5":31650,"_21707":127676,"_28496":127677,"_3093":127678},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3704":75273,"_31315":75268,"_5":31650,"_21707":127680,"_28496":127681,"_3093":127682},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3704":75274,"_31315":75268,"_5":31650,"_21707":127684,"_28496":127685,"_3093":127686},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3704":75275,"_31315":75268,"_5":31650,"_21707":127688,"_28496":127689,"_3093":127690},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3704":75276,"_31315":75268,"_5":31650,"_21707":127692,"_28496":127693,"_3093":127694},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3704":75277,"_31315":75268,"_5":31650,"_21707":127696,"_28496":127697,"_3093":127698},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3704":75278,"_31315":75268,"_21707":127700,"_5":14937,"_28496":75268,"_3093":127701},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3704":75279,"_31315":75268,"_21707":127703,"_5":14937,"_28496":127669,"_3093":127704},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3704":75280,"_31315":75268,"_21707":127706,"_5":14937,"_28496":127669,"_3093":127707},[],"Campo",{"_3704":75281,"_31315":75268,"_21707":127709,"_5":14937,"_28496":127669,"_3093":124128},[],{"_3704":75282,"_31315":75268,"_21707":127711,"_5":14937,"_28496":127669,"_3093":52820},[],{"_3704":75283,"_31315":75268,"_21707":127713,"_5":14937,"_28496":127669,"_3093":127714},[],"ID de la CA a la que pertenecen los ajustes.",{"_3704":75284,"_31315":75268,"_21707":127716,"_5":14937,"_28496":127669,"_3093":58137},[],{"_3704":75285,"_31315":75268,"_21707":127718,"_5":14937,"_28496":127669,"_3093":127719},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3704":75286,"_31315":75268,"_21707":127721,"_5":14937,"_28496":127669,"_3093":58143},[],{"_3704":75287,"_31315":75268,"_21707":127723,"_5":14937,"_28496":127669,"_3093":127724},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3704":75288,"_31315":75268,"_21707":127726,"_5":14937,"_28496":127669,"_3093":58149},[],{"_3704":75289,"_31315":75268,"_21707":127728,"_5":14937,"_28496":127669,"_3093":127729},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3704":75290,"_31315":75268,"_21707":127731,"_5":14937,"_28496":127669,"_3093":127732},[],"Campo de `crl_options`",{"_3704":75291,"_31315":75268,"_21707":127734,"_5":14937,"_28496":127669,"_3093":124128},[],{"_3704":75292,"_31315":75268,"_21707":127736,"_5":14937,"_28496":127669,"_3093":127737},[],"Valor inicial",{"_3704":75293,"_31315":75268,"_21707":127739,"_5":14937,"_28496":127669,"_3093":58163},[],{"_3704":75294,"_31315":75268,"_21707":127741,"_5":14937,"_28496":127669,"_3093":127742},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3704":75295,"_31315":75268,"_21707":127744,"_5":14937,"_28496":127669,"_3093":127745},[],"7 días.",{"_3704":75296,"_31315":75268,"_21707":127747,"_5":14937,"_28496":127669,"_3093":58172},[],{"_3704":75297,"_31315":75268,"_21707":127749,"_5":14937,"_28496":127669,"_3093":127750},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3704":75298,"_31315":75268,"_21707":127752,"_5":14937,"_28496":127669,"_3093":127753},[],"6 días y 23 horas.",{"_3704":75299,"_31315":75268,"_21707":127755,"_5":14937,"_28496":127669,"_3093":58181},[],{"_3704":75300,"_31315":75268,"_21707":127757,"_5":14937,"_28496":127669,"_3093":127758},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3704":75301,"_31315":75268,"_21707":127760,"_5":14937,"_28496":127669,"_3093":58187},[],{"_3704":75302,"_31315":75268,"_21707":127762,"_5":14937,"_28496":127669,"_3093":58190},[],{"_3704":75303,"_31315":75268,"_21707":127764,"_5":14937,"_28496":127669,"_3093":127765},[],"Número de serie del certificado existente que firma la CRL.",{"_3704":75304,"_31315":75268,"_21707":127767,"_5":14937,"_28496":127669,"_3093":127768},[],"Número de serie del certificado actual de la CA.",{"_3704":75305,"_31315":75268,"_21707":127770,"_5":14937,"_28496":127669,"_3093":127771},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3704":75306,"_31315":75268,"_21707":127773,"_5":14937,"_28496":127669,"_3093":127774},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3704":75307,"_31315":75268,"_21707":127776,"_5":14937,"_28496":127669,"_3093":127777},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3704":75308,"_31315":75268,"_21707":127779,"_5":14937,"_28496":127669,"_3093":127780},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3704":75309,"_31315":75268,"_21707":127782,"_5":14937,"_28496":127669,"_3093":127783},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3704":75310,"_31315":75268,"_21707":127785,"_5":14937,"_28496":127669,"_3093":127786},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3704":75311,"_31315":75268,"_21707":127788,"_5":14937,"_28496":127669,"_3093":127789},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3704":75312,"_31315":75268,"_21707":127791,"_5":14937,"_28496":127669,"_3093":127792},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3704":75313,"_31315":75268,"_21707":127794,"_5":14937,"_28496":127669,"_3093":127795},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3704":75314,"_31315":75268,"_21707":127797,"_5":14937,"_28496":127669,"_3093":127798},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3704":75315,"_31315":75268,"_21707":127800,"_5":14937,"_28496":127669,"_3093":127801},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3704":75316,"_31315":75268,"_21707":127803,"_5":14937,"_28496":127673,"_3093":127804},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3704":75317,"_31315":75268,"_21707":127806,"_5":14937,"_28496":127673,"_3093":127807},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3704":75318,"_31315":75268,"_21707":127809,"_5":14937,"_28496":127673,"_3093":127810},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3704":75319,"_31315":75268,"_21707":127812,"_5":14937,"_28496":127673,"_3093":127813},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3704":75320,"_31315":75268,"_21707":127815,"_5":14937,"_28496":127677,"_3093":127816},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3704":75321,"_31315":75268,"_21707":127818,"_5":14937,"_28496":127677,"_3093":127819},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3704":75322,"_31315":75268,"_21707":127821,"_5":14937,"_28496":127677,"_3093":127822},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3704":75323,"_31315":75268,"_21707":127824,"_5":14937,"_28496":127677,"_3093":127825},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3704":75324,"_31315":75268,"_21707":127827,"_5":14937,"_28496":127677,"_3093":127828},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3704":75325,"_31315":75268,"_21707":127830,"_5":14937,"_28496":127677,"_3093":127831},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3704":75326,"_31315":75268,"_21707":127833,"_5":14937,"_28496":127677,"_3093":127834},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3704":75327,"_31315":75268,"_21707":127836,"_5":14937,"_28496":127677,"_3093":127837},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3704":75328,"_31315":75268,"_21707":127839,"_5":14937,"_28496":127677,"_3093":127840},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3704":75329,"_31315":75268,"_21707":127842,"_5":14937,"_28496":127681,"_3093":127843},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3704":75330,"_31315":75268,"_21707":127845,"_5":14937,"_28496":127681,"_3093":127846},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3704":75331,"_31315":75268,"_21707":127848,"_5":14937,"_28496":127685,"_3093":127849},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3704":75332,"_31315":75268,"_21707":127851,"_5":14937,"_28496":127685,"_3093":127852},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3704":75333,"_31315":75268,"_21707":127854,"_5":14937,"_28496":127685,"_3093":127855},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3704":75334,"_31315":75268,"_21707":127857,"_5":14937,"_28496":127685,"_3093":127858},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3704":75335,"_31315":75268,"_21707":127860,"_5":14937,"_28496":127685,"_3093":127861},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3704":75336,"_31315":75268,"_21707":127863,"_5":14937,"_28496":127689,"_3093":127864},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3704":75337,"_31315":75268,"_21707":127866,"_5":14937,"_28496":127689,"_3093":124317},[],{"_3704":75338,"_31315":75268,"_21707":127868,"_5":14937,"_28496":127689,"_3093":127869},[],"Path relativo",{"_3704":75339,"_31315":75268,"_21707":127871,"_5":14937,"_28496":127689,"_3093":122196},[],{"_3704":75340,"_31315":75268,"_21707":127873,"_5":14937,"_28496":127689,"_3093":58302},[],{"_3704":75341,"_31315":75268,"_21707":127875,"_5":14937,"_28496":127689,"_3093":58305},[],{"_3704":75342,"_31315":75268,"_21707":127877,"_5":14937,"_28496":127689,"_3093":127878},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3704":75343,"_31315":75268,"_21707":127880,"_5":14937,"_28496":127689,"_3093":58302},[],{"_3704":75344,"_31315":75268,"_21707":127882,"_5":14937,"_28496":127689,"_3093":58313},[],{"_3704":75345,"_31315":75268,"_21707":127884,"_5":14937,"_28496":127689,"_3093":127885},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3704":75346,"_31315":75268,"_21707":127887,"_5":14937,"_28496":127689,"_3093":58319},[],{"_3704":75347,"_31315":75268,"_21707":127889,"_5":14937,"_28496":127689,"_3093":58313},[],{"_3704":75348,"_31315":75268,"_21707":127891,"_5":14937,"_28496":127689,"_3093":127892},[],"Sustituir la configuración de CRL de una CA.",{"_3704":75349,"_31315":75268,"_21707":127894,"_5":14937,"_28496":127689,"_3093":58327},[],{"_3704":75350,"_31315":75268,"_21707":127896,"_5":14937,"_28496":127689,"_3093":58313},[],{"_3704":75351,"_31315":75268,"_21707":127898,"_5":14937,"_28496":127689,"_3093":127899},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3704":75352,"_31315":75268,"_21707":127901,"_5":14937,"_28496":127689,"_3093":127902},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3704":75353,"_31315":75268,"_21707":127904,"_5":14937,"_28496":127689,"_3093":127905},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3704":75354,"_31315":75268,"_21707":127907,"_5":14937,"_28496":127689,"_3093":127908},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3704":75355,"_31315":75268,"_21707":127910,"_5":14937,"_28496":127693,"_3093":127911},[],"Síntoma",{"_3704":75356,"_31315":75268,"_21707":127913,"_5":14937,"_28496":127693,"_3093":127914},[],"Causa",{"_3704":75357,"_31315":75268,"_21707":127916,"_5":14937,"_28496":127693,"_3093":127917},[],"Acción",{"_3704":75358,"_31315":75268,"_21707":127919,"_5":14937,"_28496":127693,"_3093":127920},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3704":75359,"_31315":75268,"_21707":127922,"_5":14937,"_28496":127693,"_3093":127923},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3704":75360,"_31315":75268,"_21707":127925,"_5":14937,"_28496":127693,"_3093":127926},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3704":75361,"_31315":75268,"_21707":127928,"_5":14937,"_28496":127693,"_3093":127929},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3704":75362,"_31315":75268,"_21707":127931,"_5":14937,"_28496":127693,"_3093":127932},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3704":75363,"_31315":75268,"_21707":127934,"_5":14937,"_28496":127693,"_3093":127935},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3704":75364,"_31315":75268,"_21707":127937,"_5":14937,"_28496":127693,"_3093":127938},[],"`PUT` devuelve 400.",{"_3704":75365,"_31315":75268,"_21707":127940,"_5":14937,"_28496":127693,"_3093":127941},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3704":75366,"_31315":75268,"_21707":127943,"_5":14937,"_28496":127693,"_3093":127944},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3704":75367,"_31315":75268,"_21707":127946,"_5":14937,"_28496":127693,"_3093":127947},[],"`PUT` devuelve 404.",{"_3704":75368,"_31315":75268,"_21707":127949,"_5":14937,"_28496":127693,"_3093":127950},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3704":75369,"_31315":75268,"_21707":127952,"_5":14937,"_28496":127693,"_3093":127953},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3704":75370,"_31315":75268,"_21707":127955,"_5":14937,"_28496":127693,"_3093":127956},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3704":75371,"_31315":75268,"_21707":127958,"_5":14937,"_28496":127693,"_3093":127959},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3704":75372,"_31315":75268,"_21707":127961,"_5":14937,"_28496":127693,"_3093":127962},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3704":75373,"_31315":75268,"_21707":127964,"_5":14937,"_28496":127693,"_3093":127965},[],"La CRL no cambia tras revocar un certificado.",{"_3704":75374,"_31315":75268,"_21707":127967,"_5":14937,"_28496":127693,"_3093":127968},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3704":75375,"_31315":75268,"_21707":127970,"_5":14937,"_28496":127693,"_3093":127971},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3704":75376,"_31315":75268,"_21707":127973,"_5":14937,"_28496":127693,"_3093":127974},[],"Un verificador rechaza la CRL por el emisor.",{"_3704":75377,"_31315":75268,"_21707":127976,"_5":14937,"_28496":127693,"_3093":127977},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3704":75378,"_31315":75268,"_21707":127979,"_5":14937,"_28496":127693,"_3093":127980},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3704":75379,"_31315":75268,"_21707":127982,"_5":14937,"_28496":127697,"_3093":127983},[],"RFC 5280: perfil X.509 y CRL.",{"_3704":75380,"_31315":75268,"_21707":127985,"_5":14937,"_28496":127697,"_3093":58419},[],{"_3704":75381,"_31315":75268,"_21707":127987,"_5":14937,"_28496":127697,"_3093":58422},[],{"_3704":75382,"_31315":75268,"_21707":127989,"_5":14937,"_28496":127697,"_3093":127990},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3704":75383,"_31315":75268,"_21707":127992,"_5":14937,"_28496":127697,"_3093":127993},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3704":75384,"_31315":75384,"_5":15297,"_3093":127995,"_31653":127996,"_21707":127997,"_28496":75384},"Claves y motores criptográficos",[51162,122436,56880,126464],[],{"_3704":75385,"_31315":75384,"_21707":127999,"_5":14937,"_28496":75384,"_3093":128000},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3704":75386,"_31315":75384,"_5":31650,"_21707":128002,"_28496":128003,"_3093":128004},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3704":75387,"_31315":75384,"_5":31650,"_21707":128006,"_28496":128007,"_3093":128008},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3704":75388,"_31315":75384,"_5":31650,"_21707":128010,"_28496":128011,"_3093":58447},[],"/docs/es/platform/pki/key-management#file-system",{"_3704":75389,"_31315":75384,"_5":31650,"_21707":128013,"_28496":128014,"_3093":58451},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3704":75390,"_31315":75384,"_5":31650,"_21707":128016,"_28496":128017,"_3093":58455},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3704":75391,"_31315":75384,"_5":31650,"_21707":128019,"_28496":128020,"_3093":58459},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3704":75392,"_31315":75384,"_5":31650,"_21707":128022,"_28496":128023,"_3093":58463},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3704":75393,"_31315":75384,"_5":31650,"_21707":128025,"_28496":128026,"_3093":58467},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3704":75394,"_31315":75384,"_5":31650,"_21707":128028,"_28496":128029,"_3093":128030},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3704":75395,"_31315":75384,"_5":31650,"_21707":128032,"_28496":128033,"_3093":128034},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3704":75396,"_31315":75384,"_5":31650,"_21707":128036,"_28496":128037,"_3093":128038},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3704":75397,"_31315":75384,"_5":31650,"_21707":128040,"_28496":128041,"_3093":128042},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3704":75398,"_31315":75384,"_5":31650,"_21707":128044,"_28496":128045,"_3093":128046},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3704":75399,"_31315":75384,"_5":31650,"_21707":128048,"_28496":128049,"_3093":128050},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3704":75400,"_31315":75384,"_5":31650,"_21707":128052,"_28496":128053,"_3093":128054},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3704":75401,"_31315":75384,"_5":31650,"_21707":128056,"_28496":128057,"_3093":58499},[],"/docs/es/platform/pki/key-management#sign",{"_3704":75402,"_31315":75384,"_5":31650,"_21707":128059,"_28496":128060,"_3093":58503},[],"/docs/es/platform/pki/key-management#verify",{"_3704":75403,"_31315":75384,"_5":31650,"_21707":128062,"_28496":128063,"_3093":128064},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3704":75404,"_31315":75384,"_5":31650,"_21707":128066,"_28496":128067,"_3093":128068},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3704":75405,"_31315":75384,"_5":31650,"_21707":128070,"_28496":128071,"_3093":128072},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3704":75406,"_31315":75384,"_21707":128074,"_5":14937,"_28496":75384,"_3093":128075},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3704":75407,"_31315":75384,"_21707":128077,"_5":14937,"_28496":75384,"_3093":128078},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3704":75408,"_31315":75384,"_21707":128080,"_5":14937,"_28496":128003,"_3093":128081},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3704":75409,"_31315":75384,"_21707":128083,"_5":14937,"_28496":128003,"_3093":128084},[],"En la práctica, permite:",{"_3704":75410,"_31315":75384,"_21707":128086,"_5":14937,"_28496":128003,"_3093":128087},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3704":75411,"_31315":75384,"_21707":128089,"_5":14937,"_28496":128003,"_3093":128090},[],"Importar claves creadas externamente.",{"_3704":75412,"_31315":75384,"_21707":128092,"_5":14937,"_28496":128003,"_3093":128093},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3704":75413,"_31315":75384,"_21707":128095,"_5":14937,"_28496":128003,"_3093":128096},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3704":75414,"_31315":75384,"_21707":128098,"_5":14937,"_28496":128007,"_3093":128099},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3704":75415,"_31315":75384,"_21707":128101,"_5":14937,"_28496":128007,"_3093":128102},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3704":75416,"_31315":75384,"_21707":128104,"_5":14937,"_28496":128007,"_3093":128105},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3704":75417,"_31315":75384,"_21707":128107,"_5":14937,"_28496":128011,"_3093":128108},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3704":75418,"_31315":75384,"_21707":128110,"_5":14937,"_28496":128014,"_3093":128111},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3704":75419,"_31315":75384,"_21707":128113,"_5":14937,"_28496":128014,"_3093":128114},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3704":75420,"_31315":75384,"_21707":128116,"_5":14937,"_28496":128017,"_3093":128117},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3704":75421,"_31315":75384,"_21707":128119,"_5":14937,"_28496":128020,"_3093":128120},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3704":75422,"_31315":75384,"_21707":128122,"_5":14937,"_28496":128023,"_3093":128123},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3704":75423,"_31315":75384,"_21707":128125,"_5":14937,"_28496":128026,"_3093":128126},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3704":75424,"_31315":75384,"_21707":128128,"_5":14937,"_28496":128026,"_3093":128129},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3704":75425,"_31315":75384,"_21707":128131,"_5":14937,"_28496":128026,"_3093":128132},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3704":75426,"_31315":75384,"_21707":128134,"_5":14937,"_28496":128026,"_3093":128135},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3704":75427,"_31315":75384,"_21707":128137,"_5":14937,"_28496":128029,"_3093":128138},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3704":75428,"_31315":75384,"_21707":128140,"_5":14937,"_28496":128029,"_3093":128141},[],"La tabla incluye los siguientes campos:",{"_3704":75429,"_31315":75384,"_21707":128143,"_5":14937,"_28496":128029,"_3093":128144},[],"**Name**: nombre descriptivo de la clave.",{"_3704":75430,"_31315":75384,"_21707":128146,"_5":14937,"_28496":128029,"_3093":128147},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3704":75431,"_31315":75384,"_21707":128149,"_5":14937,"_28496":128029,"_3093":128150},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3704":75432,"_31315":75384,"_21707":128152,"_5":14937,"_28496":128029,"_3093":128153},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3704":75433,"_31315":75384,"_21707":128155,"_5":14937,"_28496":128029,"_3093":128156},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3704":75434,"_31315":75384,"_21707":128158,"_5":14937,"_28496":128029,"_3093":128159},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3704":75435,"_31315":75384,"_21707":128161,"_5":14937,"_28496":128029,"_3093":128162},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3704":75436,"_31315":75384,"_21707":128164,"_5":14937,"_28496":128029,"_3093":128165},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3704":75437,"_31315":75384,"_21707":128167,"_5":14937,"_28496":128029,"_3093":128168},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3704":75438,"_31315":75384,"_21707":128170,"_5":14937,"_28496":128029,"_3093":128171},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3704":75439,"_31315":75384,"_21707":128173,"_5":14937,"_28496":128029,"_3093":128174},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3704":75440,"_31315":75384,"_21707":128176,"_5":14937,"_28496":128029,"_3093":128177},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3704":75441,"_31315":75384,"_21707":128179,"_5":14937,"_28496":128029,"_3093":128180},[],"**Delete Key** para eliminar la clave del sistema.",{"_3704":75442,"_31315":75384,"_21707":128182,"_5":14937,"_28496":128033,"_3093":128183},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3704":75443,"_31315":75384,"_21707":128185,"_5":14937,"_28496":128037,"_3093":128186},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3704":75444,"_31315":75384,"_21707":128188,"_5":14937,"_28496":128037,"_3093":128189},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3704":75445,"_31315":75384,"_21707":128191,"_5":14937,"_28496":128037,"_3093":128192},[],"**Key Name**: nombre único y descriptivo.",{"_3704":75446,"_31315":75384,"_21707":128194,"_5":14937,"_28496":128037,"_3093":128195},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3704":75447,"_31315":75384,"_21707":128197,"_5":14937,"_28496":128037,"_3093":128198},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3704":75448,"_31315":75384,"_21707":128200,"_5":14937,"_28496":128037,"_3093":128201},[],"**Tags**: metadatos para clasificar la clave.",{"_3704":75449,"_31315":75384,"_21707":128203,"_5":14937,"_28496":128037,"_3093":128204},[],"**Metadata**: información adicional para usos avanzados.",{"_3704":75450,"_31315":75384,"_21707":128206,"_5":14937,"_28496":128041,"_3093":128207},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3704":75451,"_31315":75384,"_21707":128209,"_5":14937,"_28496":128041,"_3093":128210},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3704":75452,"_31315":75384,"_21707":128212,"_5":14937,"_28496":128041,"_3093":128213},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3704":75453,"_31315":75384,"_21707":128215,"_5":14937,"_28496":128041,"_3093":128216},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3704":75454,"_31315":75384,"_21707":128218,"_5":14937,"_28496":128041,"_3093":128219},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3704":75455,"_31315":75384,"_21707":128221,"_5":14937,"_28496":128041,"_3093":128222},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3704":75456,"_31315":75384,"_21707":128224,"_5":14937,"_28496":128041,"_3093":128225},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3704":75457,"_31315":75384,"_21707":128227,"_5":14937,"_28496":128041,"_3093":128228},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3704":75458,"_31315":75384,"_21707":128230,"_5":14937,"_28496":128041,"_3093":128231},[],"**Metadata**: información adicional opcional.",{"_3704":75459,"_31315":75384,"_21707":128233,"_5":14937,"_28496":128041,"_3093":128234},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3704":75460,"_31315":75384,"_21707":128236,"_5":14937,"_28496":128041,"_3093":128237},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3704":75461,"_31315":75384,"_21707":128239,"_5":14937,"_28496":128045,"_3093":128240},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3704":75462,"_31315":75384,"_21707":128242,"_5":14937,"_28496":128049,"_3093":128243},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3704":75463,"_31315":75384,"_21707":128245,"_5":14937,"_28496":128049,"_3093":128246},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3704":75464,"_31315":75384,"_21707":128248,"_5":14937,"_28496":128049,"_3093":128249},[],"**Key Name**: nombre descriptivo.",{"_3704":75465,"_31315":75384,"_21707":128251,"_5":14937,"_28496":128049,"_3093":128252},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3704":75466,"_31315":75384,"_21707":128254,"_5":14937,"_28496":128049,"_3093":128255},[],"**Tags**: etiquetas asociadas.",{"_3704":75467,"_31315":75384,"_21707":128257,"_5":14937,"_28496":128049,"_3093":128258},[],"**Aliases**: nombres alternativos.",{"_3704":75468,"_31315":75384,"_21707":128260,"_5":14937,"_28496":128049,"_3093":128261},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3704":75469,"_31315":75384,"_21707":128263,"_5":14937,"_28496":128049,"_3093":128264},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3704":75470,"_31315":75384,"_21707":128266,"_5":14937,"_28496":128049,"_3093":128267},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3704":75471,"_31315":75384,"_21707":128269,"_5":14937,"_28496":128049,"_3093":128270},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3704":75472,"_31315":75384,"_21707":128272,"_5":14937,"_28496":128053,"_3093":128273},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3704":75473,"_31315":75384,"_21707":128275,"_5":14937,"_28496":128053,"_3093":128276},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3704":75474,"_31315":75384,"_21707":128278,"_5":14937,"_28496":128053,"_3093":128279},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3704":75475,"_31315":75384,"_21707":128281,"_5":14937,"_28496":128057,"_3093":128282},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3704":75476,"_31315":75384,"_21707":128284,"_5":14937,"_28496":128057,"_3093":128285},[],"Campos principales:",{"_3704":75477,"_31315":75384,"_21707":128287,"_5":14937,"_28496":128057,"_3093":128288},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3704":75478,"_31315":75384,"_21707":128290,"_5":14937,"_28496":128057,"_3093":128291},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3704":75479,"_31315":75384,"_21707":128293,"_5":14937,"_28496":128057,"_3093":128294},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3704":75480,"_31315":75384,"_21707":128296,"_5":14937,"_28496":128057,"_3093":128297},[],"**Message**: contenido que se va a firmar.",{"_3704":75481,"_31315":75384,"_21707":128299,"_5":14937,"_28496":128057,"_3093":128300},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3704":75482,"_31315":75384,"_21707":128302,"_5":14937,"_28496":128060,"_3093":128303},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3704":75483,"_31315":75384,"_21707":128305,"_5":14937,"_28496":128060,"_3093":128285},[],{"_3704":75484,"_31315":75384,"_21707":128307,"_5":14937,"_28496":128060,"_3093":128308},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3704":75485,"_31315":75384,"_21707":128310,"_5":14937,"_28496":128060,"_3093":128311},[],"**Message Type**: `Raw` o `Digest`.",{"_3704":75486,"_31315":75384,"_21707":128313,"_5":14937,"_28496":128060,"_3093":128314},[],"**Payload Encoding**: codificación del mensaje.",{"_3704":75487,"_31315":75384,"_21707":128316,"_5":14937,"_28496":128060,"_3093":128317},[],"**Message**: mensaje original o hash.",{"_3704":75488,"_31315":75384,"_21707":128319,"_5":14937,"_28496":128060,"_3093":128320},[],"**Signature**: firma que se desea comprobar.",{"_3704":75489,"_31315":75384,"_21707":128322,"_5":14937,"_28496":128060,"_3093":128323},[],"**Result**: indicador del resultado de la validación.",{"_3704":75490,"_31315":75384,"_21707":128325,"_5":14937,"_28496":128063,"_3093":128326},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3704":75491,"_31315":75384,"_21707":128328,"_5":14937,"_28496":128063,"_3093":128329},[],"Este flujo es útil para:",{"_3704":75492,"_31315":75384,"_21707":128331,"_5":14937,"_28496":128063,"_3093":128332},[],"Solicitar certificados a una CA externa.",{"_3704":75493,"_31315":75384,"_21707":128334,"_5":14937,"_28496":128063,"_3093":128335},[],"Renovar una identidad manteniendo la misma clave.",{"_3704":75494,"_31315":75384,"_21707":128337,"_5":14937,"_28496":128063,"_3093":128338},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3704":75495,"_31315":75384,"_21707":128340,"_5":14937,"_28496":128063,"_3093":128341},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3704":75496,"_31315":75384,"_21707":128343,"_5":14937,"_28496":128063,"_3093":128344},[],"**Organization (O)**: organización o empresa.",{"_3704":75497,"_31315":75384,"_21707":128346,"_5":14937,"_28496":128063,"_3093":128347},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3704":75498,"_31315":75384,"_21707":128349,"_5":14937,"_28496":128063,"_3093":128350},[],"**Country (C)**: código de país de dos letras.",{"_3704":75499,"_31315":75384,"_21707":128352,"_5":14937,"_28496":128063,"_3093":128353},[],"**State / Province (ST)**: estado o provincia.",{"_3704":75500,"_31315":75384,"_21707":128355,"_5":14937,"_28496":128063,"_3093":128356},[],"**Locality (L)**: ciudad o localidad.",{"_3704":75501,"_31315":75384,"_21707":128358,"_5":14937,"_28496":128063,"_3093":128359},[],"**Email Address**: correo de contacto.",{"_3704":75502,"_31315":75384,"_21707":128361,"_5":14937,"_28496":128063,"_3093":128362},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3704":75503,"_31315":75384,"_21707":128364,"_5":14937,"_28496":128063,"_3093":128365},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3704":75504,"_31315":75384,"_21707":128367,"_5":14937,"_28496":128067,"_3093":128368},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3704":75505,"_31315":75384,"_21707":128370,"_5":14937,"_28496":128067,"_3093":128371},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3704":75506,"_31315":75384,"_21707":128373,"_5":14937,"_28496":128071,"_3093":128374},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3704":75507,"_31315":75384,"_21707":128376,"_5":14937,"_28496":128071,"_3093":128377},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3704":75508,"_31315":75508,"_5":15297,"_3093":128379,"_31653":128380,"_21707":128381,"_28496":75508},"Validación online con OCSP",[51162,122436,56880,127135],[],{"_3704":75509,"_31315":75508,"_21707":128383,"_5":14937,"_28496":75508,"_3093":128384},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3704":75510,"_31315":75508,"_5":31650,"_21707":128386,"_28496":128387,"_3093":128388},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3704":75511,"_31315":75508,"_5":31650,"_21707":128390,"_28496":128391,"_3093":128392},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3704":75512,"_31315":75508,"_5":31650,"_21707":128394,"_28496":128395,"_3093":128396},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3704":75513,"_31315":75508,"_5":31650,"_21707":128398,"_28496":128399,"_3093":128400},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3704":75514,"_31315":75508,"_5":31650,"_21707":128402,"_28496":128403,"_3093":128404},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3704":75515,"_31315":75508,"_5":31650,"_21707":128406,"_28496":128407,"_3093":127698},[],"/docs/es/platform/pki/ocsp#referencias",{"_3704":75516,"_31315":75508,"_21707":128409,"_5":14937,"_28496":75508,"_3093":128410},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3704":75517,"_31315":75508,"_21707":128412,"_5":14937,"_28496":128387,"_3093":128413},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3704":75518,"_31315":75508,"_21707":128415,"_5":14937,"_28496":128387,"_3093":128416},[],"Estado del registro",{"_3704":75519,"_31315":75508,"_21707":128418,"_5":14937,"_28496":128387,"_3093":128419},[],"Respuesta firmada",{"_3704":75520,"_31315":75508,"_21707":128421,"_5":14937,"_28496":128387,"_3093":56017},[],{"_3704":75521,"_31315":75508,"_21707":128423,"_5":14937,"_28496":128387,"_3093":58867},[],{"_3704":75522,"_31315":75508,"_21707":128425,"_5":14937,"_28496":128387,"_3093":56034},[],{"_3704":75523,"_31315":75508,"_21707":128427,"_5":14937,"_28496":128387,"_3093":128428},[],"`Revoked`, con razón y fecha de revocación.",{"_3704":75524,"_31315":75508,"_21707":128430,"_5":14937,"_28496":128387,"_3093":128431},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3704":75525,"_31315":75508,"_21707":128433,"_5":14937,"_28496":128387,"_3093":128434},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3704":75526,"_31315":75508,"_21707":128436,"_5":14937,"_28496":128387,"_3093":128437},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3704":75527,"_31315":75508,"_21707":128439,"_5":14937,"_28496":128387,"_3093":128440},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3704":75528,"_31315":75508,"_21707":128442,"_5":14937,"_28496":128387,"_3093":128443},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3704":75529,"_31315":75508,"_21707":128445,"_5":14937,"_28496":128391,"_3093":128446},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3704":75530,"_31315":75508,"_21707":128448,"_5":14937,"_28496":128391,"_3093":128449},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3704":75531,"_31315":75508,"_21707":128451,"_5":14937,"_28496":128395,"_3093":128452},[],"El servicio acepta:",{"_3704":75532,"_31315":75508,"_21707":128454,"_5":14937,"_28496":128395,"_3093":124317},[],{"_3704":75533,"_31315":75508,"_21707":128456,"_5":14937,"_28496":128395,"_3093":128457},[],"Ruta del servicio VA",{"_3704":75534,"_31315":75508,"_21707":128459,"_5":14937,"_28496":128395,"_3093":128460},[],"Formato",{"_3704":75535,"_31315":75508,"_21707":128462,"_5":14937,"_28496":128395,"_3093":58907},[],{"_3704":75536,"_31315":75508,"_21707":128464,"_5":14937,"_28496":128395,"_3093":58910},[],{"_3704":75537,"_31315":75508,"_21707":128466,"_5":14937,"_28496":128395,"_3093":128467},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3704":75538,"_31315":75508,"_21707":128469,"_5":14937,"_28496":128395,"_3093":58302},[],{"_3704":75539,"_31315":75508,"_21707":128471,"_5":14937,"_28496":128395,"_3093":58918},[],{"_3704":75540,"_31315":75508,"_21707":128473,"_5":14937,"_28496":128395,"_3093":128474},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3704":75541,"_31315":75508,"_21707":128476,"_5":14937,"_28496":128395,"_3093":128477},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3704":75542,"_31315":75508,"_21707":128479,"_5":14937,"_28496":128399,"_3093":128480},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3704":75543,"_31315":75508,"_21707":128482,"_5":14937,"_28496":128399,"_3093":128483},[],"Genera la solicitud:",{"_3704":75544,"_31315":75508,"_21707":128485,"_5":14937,"_28496":128399,"_3093":128486},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3704":75545,"_31315":75508,"_21707":128488,"_5":14937,"_28496":128399,"_3093":128489},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3704":75546,"_31315":75508,"_21707":128491,"_5":14937,"_28496":128399,"_3093":128492},[],"Verifica el DER recibido:",{"_3704":75547,"_31315":75508,"_21707":128494,"_5":14937,"_28496":128399,"_3093":128495},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3704":75548,"_31315":75508,"_21707":128497,"_5":14937,"_28496":128403,"_3093":128498},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3704":75549,"_31315":75508,"_21707":128500,"_5":14937,"_28496":128403,"_3093":128501},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3704":75550,"_31315":75508,"_21707":128503,"_5":14937,"_28496":128407,"_3093":58951},[],{"_3704":75551,"_31315":75508,"_21707":128505,"_5":14937,"_28496":128407,"_3093":58954},[],{"_3704":75552,"_31315":75508,"_21707":128507,"_5":14937,"_28496":128407,"_3093":128508},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3704":75553,"_31315":75508,"_21707":128510,"_5":14937,"_28496":128407,"_3093":127993},[],{"_3704":75554,"_31315":75554,"_5":15297,"_3093":56880,"_31653":128512,"_21707":128513,"_28496":75554},[51162,122436,56880],[],{"_3704":75555,"_31315":75554,"_21707":128515,"_5":14937,"_28496":75554,"_3093":128516},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3704":75556,"_31315":75554,"_5":31650,"_21707":128518,"_28496":128519,"_3093":125790},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3704":75557,"_31315":75554,"_5":31650,"_21707":128521,"_28496":128522,"_3093":128523},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3704":75558,"_31315":75554,"_5":31650,"_21707":128525,"_28496":128526,"_3093":126310},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3704":75559,"_31315":75554,"_5":31650,"_21707":128528,"_28496":128529,"_3093":126314},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3704":75560,"_31315":75554,"_5":31650,"_21707":128531,"_28496":128532,"_3093":126318},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3704":75561,"_31315":75554,"_5":31650,"_21707":128534,"_28496":128535,"_3093":126322},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3704":75562,"_31315":75554,"_5":31650,"_21707":128537,"_28496":128538,"_3093":126330},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3704":75563,"_31315":75554,"_5":31650,"_21707":128540,"_28496":128541,"_3093":128542},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3704":75564,"_31315":75554,"_5":31650,"_21707":128544,"_28496":128545,"_3093":127301},[],"/docs/es/platform/pki/overview#continúa",{"_3704":75565,"_31315":75554,"_21707":128547,"_5":14937,"_28496":75554,"_3093":128548},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3704":75566,"_31315":75554,"_21707":128550,"_5":14937,"_28496":128519,"_3093":128551},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3704":75567,"_31315":75554,"_21707":128553,"_5":14937,"_28496":128519,"_3093":128554},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3704":75568,"_31315":75554,"_21707":128556,"_5":14937,"_28496":128522,"_3093":128557},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3704":75569,"_31315":75554,"_21707":128559,"_5":14937,"_28496":128522,"_3093":128560},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3704":75570,"_31315":75554,"_21707":128562,"_5":14937,"_28496":128522,"_3093":128563},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3704":75571,"_31315":75554,"_21707":128565,"_5":14937,"_28496":128522,"_3093":128566},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3704":75572,"_31315":75554,"_21707":128568,"_5":14937,"_28496":128522,"_3093":128569},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3704":75573,"_31315":75554,"_21707":128571,"_5":14937,"_28496":128529,"_3093":128572},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3704":75574,"_31315":75554,"_21707":128574,"_5":14937,"_28496":128532,"_3093":128575},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3704":75575,"_31315":75554,"_21707":128577,"_5":14937,"_28496":128535,"_3093":128578},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3704":75576,"_31315":75554,"_21707":128580,"_5":14937,"_28496":128538,"_3093":128581},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3704":75577,"_31315":75554,"_21707":128583,"_5":14937,"_28496":128541,"_3093":128584},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3704":75578,"_31315":75554,"_21707":128586,"_5":14937,"_28496":128541,"_3093":128587},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3704":75579,"_31315":75554,"_21707":128589,"_5":14937,"_28496":128541,"_3093":128590},[],"su clave pública corresponda a la clave privada del cliente;",{"_3704":75580,"_31315":75554,"_21707":128592,"_5":14937,"_28496":128541,"_3093":128593},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3704":75581,"_31315":75554,"_21707":128595,"_5":14937,"_28496":128541,"_3093":128596},[],"sus fechas y usos permitan la operación;",{"_3704":75582,"_31315":75554,"_21707":128598,"_5":14937,"_28496":128541,"_3093":128599},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3704":75583,"_31315":75554,"_21707":128601,"_5":14937,"_28496":128541,"_3093":128602},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3704":75584,"_31315":75554,"_21707":128604,"_5":14937,"_28496":128545,"_3093":128605},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3704":75585,"_31315":75554,"_21707":128607,"_5":14937,"_28496":128545,"_3093":128608},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3704":75586,"_31315":75554,"_21707":128610,"_5":14937,"_28496":128545,"_3093":128611},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3704":75587,"_31315":75587,"_5":15297,"_3093":128613,"_31653":128614,"_21707":128615,"_28496":75587},"Crea tu primera CA",[51162,122436,56880,125914],[],{"_3704":75588,"_31315":75587,"_21707":128617,"_5":14937,"_28496":75587,"_3093":128618},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3704":75589,"_31315":75587,"_5":31650,"_21707":128620,"_28496":128621,"_3093":120944},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3704":75590,"_31315":75587,"_5":31650,"_21707":128623,"_28496":128624,"_3093":128625},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3704":75591,"_31315":75587,"_5":31650,"_21707":128627,"_28496":128628,"_3093":128629},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3704":75592,"_31315":75587,"_5":31650,"_21707":128631,"_28496":128632,"_3093":128633},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3704":75593,"_31315":75587,"_5":31650,"_21707":128635,"_28496":128636,"_3093":128637},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3704":75594,"_31315":75587,"_5":31650,"_21707":128639,"_28496":128640,"_3093":128641},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3704":75595,"_31315":75587,"_5":31650,"_21707":128643,"_28496":128644,"_3093":128645},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3704":75596,"_31315":75587,"_5":31650,"_21707":128647,"_28496":128648,"_3093":126161},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3704":75597,"_31315":75587,"_5":31650,"_21707":128650,"_28496":128651,"_3093":120968},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3704":75598,"_31315":75587,"_21707":128653,"_5":14937,"_28496":75587,"_3093":128654},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3704":75599,"_31315":75587,"_21707":128656,"_5":14937,"_28496":128621,"_3093":128657},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3704":75600,"_31315":75587,"_21707":128659,"_5":14937,"_28496":128621,"_3093":128660},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3704":75601,"_31315":75587,"_21707":128662,"_5":14937,"_28496":128621,"_3093":128663},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3704":75602,"_31315":75587,"_21707":128665,"_5":14937,"_28496":128621,"_3093":128666},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3704":75603,"_31315":75587,"_21707":128668,"_5":14937,"_28496":128624,"_3093":128669},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3704":75604,"_31315":75587,"_21707":128671,"_5":14937,"_28496":128624,"_3093":128672},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3704":75605,"_31315":75587,"_21707":128674,"_5":14937,"_28496":128628,"_3093":128675},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3704":75606,"_31315":75587,"_21707":128677,"_5":14937,"_28496":128628,"_3093":128678},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3704":75607,"_31315":75587,"_21707":128680,"_5":14937,"_28496":128632,"_3093":128681},[],"Selecciona **Root CA** y completa:",{"_3704":75608,"_31315":75587,"_21707":128683,"_5":14937,"_28496":128632,"_3093":59133},[],{"_3704":75609,"_31315":75587,"_21707":128685,"_5":14937,"_28496":128632,"_3093":128686},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3704":75610,"_31315":75587,"_21707":128688,"_5":14937,"_28496":128632,"_3093":128689},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3704":75611,"_31315":75587,"_21707":128691,"_5":14937,"_28496":128632,"_3093":128692},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3704":75612,"_31315":75587,"_21707":128694,"_5":14937,"_28496":128632,"_3093":128695},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3704":75613,"_31315":75587,"_21707":128697,"_5":14937,"_28496":128636,"_3093":128698},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3704":75614,"_31315":75587,"_21707":128700,"_5":14937,"_28496":128640,"_3093":128701},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3704":75615,"_31315":75587,"_21707":128703,"_5":14937,"_28496":128640,"_3093":128704},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3704":75616,"_31315":75587,"_21707":128706,"_5":14937,"_28496":128644,"_3093":128707},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3704":75617,"_31315":75587,"_21707":128709,"_5":14937,"_28496":128644,"_3093":128710},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3704":75618,"_31315":75587,"_21707":128712,"_5":14937,"_28496":128644,"_3093":128713},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3704":75619,"_31315":75587,"_21707":128715,"_5":14937,"_28496":128648,"_3093":128716},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3704":75620,"_31315":75587,"_21707":128718,"_5":14937,"_28496":128648,"_3093":128719},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3704":75621,"_31315":75587,"_21707":128721,"_5":14937,"_28496":128648,"_3093":128722},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3704":75622,"_31315":75587,"_21707":128724,"_5":14937,"_28496":128648,"_3093":128725},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3704":75623,"_31315":75587,"_21707":128727,"_5":14937,"_28496":128651,"_3093":128728},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3704":75624,"_31315":75624,"_5":15297,"_3093":128730,"_31653":128731,"_21707":128732,"_28496":75624},"Emite y verifica un certificado",[51162,122436,56880,125914],[],{"_3704":75625,"_31315":75624,"_21707":128734,"_5":14937,"_28496":75624,"_3093":128735},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3704":75626,"_31315":75624,"_5":31650,"_21707":128737,"_28496":128738,"_3093":120944},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3704":75627,"_31315":75624,"_5":31650,"_21707":128740,"_28496":128741,"_3093":128742},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3704":75628,"_31315":75624,"_5":31650,"_21707":128744,"_28496":128745,"_3093":128746},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3704":75629,"_31315":75624,"_5":31650,"_21707":128748,"_28496":128749,"_3093":128750},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3704":75630,"_31315":75624,"_5":31650,"_21707":128752,"_28496":128753,"_3093":128754},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3704":75631,"_31315":75624,"_5":31650,"_21707":128756,"_28496":128757,"_3093":128758},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3704":75632,"_31315":75624,"_5":31650,"_21707":128760,"_28496":128761,"_3093":128762},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3704":75633,"_31315":75624,"_5":31650,"_21707":128764,"_28496":128765,"_3093":128766},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3704":75634,"_31315":75624,"_5":31650,"_21707":128768,"_28496":128769,"_3093":128770},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3704":75635,"_31315":75624,"_5":31650,"_21707":128772,"_28496":128773,"_3093":128774},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3704":75636,"_31315":75624,"_5":31650,"_21707":128776,"_28496":128777,"_3093":126161},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3704":75637,"_31315":75624,"_5":31650,"_21707":128779,"_28496":128780,"_3093":120968},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3704":75638,"_31315":75624,"_21707":128782,"_5":14937,"_28496":75624,"_3093":128783},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3704":75639,"_31315":75624,"_21707":128785,"_5":14937,"_28496":128738,"_3093":128786},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3704":75640,"_31315":75624,"_21707":128788,"_5":14937,"_28496":128738,"_3093":128789},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3704":75641,"_31315":75624,"_21707":128791,"_5":14937,"_28496":128738,"_3093":128792},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3704":75642,"_31315":75624,"_21707":128794,"_5":14937,"_28496":128738,"_3093":128795},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3704":75643,"_31315":75624,"_21707":128797,"_5":14937,"_28496":128738,"_3093":128798},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3704":75644,"_31315":75624,"_21707":128800,"_5":14937,"_28496":128741,"_3093":128801},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3704":75645,"_31315":75624,"_21707":128803,"_5":14937,"_28496":128745,"_3093":128804},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3704":75646,"_31315":75624,"_21707":128806,"_5":14937,"_28496":128745,"_3093":128807},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3704":75647,"_31315":75624,"_21707":128809,"_5":14937,"_28496":128749,"_3093":128810},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3704":75648,"_31315":75624,"_21707":128812,"_5":14937,"_28496":128749,"_3093":128813},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3704":75649,"_31315":75624,"_21707":128815,"_5":14937,"_28496":128753,"_3093":128816},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3704":75650,"_31315":75624,"_21707":128818,"_5":14937,"_28496":128753,"_3093":128819},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3704":75651,"_31315":75624,"_21707":128821,"_5":14937,"_28496":128757,"_3093":128822},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3704":75652,"_31315":75624,"_21707":128824,"_5":14937,"_28496":128761,"_3093":128825},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3704":75653,"_31315":75624,"_21707":128827,"_5":14937,"_28496":128765,"_3093":128828},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3704":75654,"_31315":75624,"_21707":128830,"_5":14937,"_28496":128769,"_3093":128831},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3704":75655,"_31315":75624,"_21707":128833,"_5":14937,"_28496":128769,"_3093":128834},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3704":75656,"_31315":75624,"_21707":128836,"_5":14937,"_28496":128769,"_3093":128837},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3704":75657,"_31315":75624,"_21707":128839,"_5":14937,"_28496":128773,"_3093":128840},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3704":75658,"_31315":75624,"_21707":128842,"_5":14937,"_28496":128773,"_3093":128843},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3704":75659,"_31315":75624,"_21707":128845,"_5":14937,"_28496":128773,"_3093":128846},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3704":75660,"_31315":75624,"_21707":128848,"_5":14937,"_28496":128777,"_3093":126244},[],{"_3704":75661,"_31315":75624,"_21707":128850,"_5":14937,"_28496":128777,"_3093":124759},[],{"_3704":75662,"_31315":75624,"_21707":128852,"_5":14937,"_28496":128777,"_3093":128853},[],"La CA rechaza la emisión",{"_3704":75663,"_31315":75624,"_21707":128855,"_5":14937,"_28496":128777,"_3093":128856},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3704":75664,"_31315":75624,"_21707":128858,"_5":14937,"_28496":128777,"_3093":128859},[],"Sujeto o usos diferentes",{"_3704":75665,"_31315":75624,"_21707":128861,"_5":14937,"_28496":128777,"_3093":128862},[],"Perfil aplicado y valores solicitados.",{"_3704":75666,"_31315":75624,"_21707":128864,"_5":14937,"_28496":128777,"_3093":128865},[],"No se encuentra el emisor",{"_3704":75667,"_31315":75624,"_21707":128867,"_5":14937,"_28496":128777,"_3093":128868},[],"CA descargada y cadena intermedia necesaria.",{"_3704":75668,"_31315":75624,"_21707":128870,"_5":14937,"_28496":128777,"_3093":128871},[],"Falla la vigencia",{"_3704":75669,"_31315":75624,"_21707":128873,"_5":14937,"_28496":128777,"_3093":128874},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3704":75670,"_31315":75624,"_21707":128876,"_5":14937,"_28496":128777,"_3093":128877},[],"Los resúmenes de clave difieren",{"_3704":75671,"_31315":75624,"_21707":128879,"_5":14937,"_28496":128777,"_3093":128880},[],"Archivos de certificado y clave de la misma emisión.",{"_3704":75672,"_31315":75624,"_21707":128882,"_5":14937,"_28496":128777,"_3093":128883},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3704":75673,"_31315":75624,"_21707":128885,"_5":14937,"_28496":128780,"_3093":128886},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3704":75674,"_31315":75624,"_21707":128888,"_5":14937,"_28496":128780,"_3093":128889},[],"Gestionar certificados para inspección, estado y revocación.",{"_3704":75675,"_31315":75624,"_21707":128891,"_5":14937,"_28496":128780,"_3093":128892},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3704":75676,"_31315":75624,"_21707":128894,"_5":14937,"_28496":128780,"_3093":128895},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3704":75677,"_31315":75624,"_21707":128897,"_5":14937,"_28496":128780,"_3093":128898},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3704":75678,"_31315":75678,"_5":15297,"_3093":128900,"_31653":128901,"_21707":128902,"_28496":75678},"Primeros pasos de PKI",[51162,122436,56880,125914],[],{"_3704":75679,"_31315":75678,"_21707":128904,"_5":14937,"_28496":75678,"_3093":128905},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3704":75680,"_31315":75678,"_5":31650,"_21707":128907,"_28496":128908,"_3093":120944},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3704":75681,"_31315":75678,"_5":31650,"_21707":128910,"_28496":128911,"_3093":128912},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3704":75682,"_31315":75678,"_5":31650,"_21707":128914,"_28496":128915,"_3093":126096},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3704":75683,"_31315":75678,"_5":31650,"_21707":128917,"_28496":128918,"_3093":128919},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3704":75684,"_31315":75678,"_21707":128921,"_5":14937,"_28496":75678,"_3093":128922},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3704":75685,"_31315":75678,"_21707":128924,"_5":14937,"_28496":128908,"_3093":128925},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3704":75686,"_31315":75678,"_21707":128927,"_5":14937,"_28496":128908,"_3093":128928},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3704":75687,"_31315":75678,"_21707":128930,"_5":14937,"_28496":128908,"_3093":128931},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3704":75688,"_31315":75678,"_21707":128933,"_5":14937,"_28496":128908,"_3093":128934},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3704":75689,"_31315":75678,"_21707":128936,"_5":14937,"_28496":128908,"_3093":128937},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3704":75690,"_31315":75678,"_21707":128939,"_5":14937,"_28496":128911,"_3093":128940},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3704":75691,"_31315":75678,"_21707":128942,"_5":14937,"_28496":128911,"_3093":128943},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3704":75692,"_31315":75678,"_21707":128945,"_5":14937,"_28496":128911,"_3093":128946},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3704":75693,"_31315":75678,"_21707":128948,"_5":14937,"_28496":128911,"_3093":128949},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3704":75694,"_31315":75678,"_21707":128951,"_5":14937,"_28496":128915,"_3093":128952},[],"Archivo o recurso",{"_3704":75695,"_31315":75678,"_21707":128954,"_5":14937,"_28496":128915,"_3093":126093},[],{"_3704":75696,"_31315":75678,"_21707":128956,"_5":14937,"_28496":128915,"_3093":128957},[],"CA raíz activa y `ca.pem`",{"_3704":75697,"_31315":75678,"_21707":128959,"_5":14937,"_28496":128915,"_3093":128960},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3704":75698,"_31315":75678,"_21707":128962,"_5":14937,"_28496":128915,"_3093":128963},[],"Certificado final y `device.crt`",{"_3704":75699,"_31315":75678,"_21707":128965,"_5":14937,"_28496":128915,"_3093":128966},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3704":75700,"_31315":75678,"_21707":128968,"_5":14937,"_28496":128915,"_3093":128969},[],"Clave privada `device.key`",{"_3704":75701,"_31315":75678,"_21707":128971,"_5":14937,"_28496":128915,"_3093":128972},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3704":75702,"_31315":75678,"_21707":128974,"_5":14937,"_28496":128915,"_3093":128975},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3704":75703,"_31315":75678,"_21707":128977,"_5":14937,"_28496":128918,"_3093":128978},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3704":75704,"_31315":75678,"_21707":128980,"_5":14937,"_28496":128918,"_3093":128981},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3704":75705,"_31315":75678,"_21707":128983,"_5":14937,"_28496":128918,"_3093":128984},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3704":75706,"_31315":75706,"_5":15297,"_3093":128986,"_31653":128987,"_21707":128989,"_28496":75706},"Resolución de problemas PKI",[51162,122436,56880,128988],"Resolución de problemas",[],{"_3704":75707,"_31315":75706,"_21707":128991,"_5":14937,"_28496":75706,"_3093":128992},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3704":75708,"_31315":75706,"_5":31650,"_21707":128994,"_28496":128995,"_3093":128996},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3704":75709,"_31315":75706,"_5":31650,"_21707":128998,"_28496":128999,"_3093":129000},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3704":75710,"_31315":75706,"_5":31650,"_21707":129002,"_28496":129003,"_3093":129004},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3704":75711,"_31315":75706,"_21707":129006,"_5":14937,"_28496":75706,"_3093":129007},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3704":75712,"_31315":75706,"_21707":129009,"_5":14937,"_28496":75706,"_3093":129010},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3704":75713,"_31315":75706,"_21707":129012,"_5":14937,"_28496":128995,"_3093":126093},[],{"_3704":75714,"_31315":75706,"_21707":129014,"_5":14937,"_28496":128995,"_3093":124759},[],{"_3704":75715,"_31315":75706,"_21707":129016,"_5":14937,"_28496":128995,"_3093":120968},[],{"_3704":75716,"_31315":75706,"_21707":129018,"_5":14937,"_28496":128995,"_3093":55722},[],{"_3704":75717,"_31315":75706,"_21707":129020,"_5":14937,"_28496":128995,"_3093":129021},[],"Existe, está activa y sus fechas son utilizables.",{"_3704":75718,"_31315":75706,"_21707":129023,"_5":14937,"_28496":128995,"_3093":129024},[],"Autoridades.",{"_3704":75719,"_31315":75706,"_21707":129026,"_5":14937,"_28496":128995,"_3093":129027},[],"Clave",{"_3704":75720,"_31315":75706,"_21707":129029,"_5":14937,"_28496":128995,"_3093":129030},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3704":75721,"_31315":75706,"_21707":129032,"_5":14937,"_28496":128995,"_3093":129033},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3704":75722,"_31315":75706,"_21707":129035,"_5":14937,"_28496":128995,"_3093":59487},[],{"_3704":75723,"_31315":75706,"_21707":129037,"_5":14937,"_28496":128995,"_3093":129038},[],"PEM correcto y firma verificable.",{"_3704":75724,"_31315":75706,"_21707":129040,"_5":14937,"_28496":128995,"_3093":59493},[],{"_3704":75725,"_31315":75706,"_21707":129042,"_5":14937,"_28496":128995,"_3093":129043},[],"Perfil",{"_3704":75726,"_31315":75706,"_21707":129045,"_5":14937,"_28496":128995,"_3093":129046},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3704":75727,"_31315":75706,"_21707":129048,"_5":14937,"_28496":128995,"_3093":129049},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3704":75728,"_31315":75706,"_21707":129051,"_5":14937,"_28496":128995,"_3093":126244},[],{"_3704":75729,"_31315":75706,"_21707":129053,"_5":14937,"_28496":128995,"_3093":129054},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3704":75730,"_31315":75706,"_21707":129056,"_5":14937,"_28496":128995,"_3093":129057},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3704":75731,"_31315":75706,"_21707":129059,"_5":14937,"_28496":128995,"_3093":129060},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3704":75732,"_31315":75706,"_21707":129062,"_5":14937,"_28496":128995,"_3093":129063},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3704":75733,"_31315":75706,"_21707":129065,"_5":14937,"_28496":128995,"_3093":129066},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3704":75734,"_31315":75706,"_21707":129068,"_5":14937,"_28496":128999,"_3093":129069},[],"Revisa cada frontera por separado:",{"_3704":75735,"_31315":75706,"_21707":129071,"_5":14937,"_28496":128999,"_3093":129072},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3704":75736,"_31315":75706,"_21707":129074,"_5":14937,"_28496":128999,"_3093":129075},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3704":75737,"_31315":75706,"_21707":129077,"_5":14937,"_28496":128999,"_3093":129078},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3704":75738,"_31315":75706,"_21707":129080,"_5":14937,"_28496":128999,"_3093":129081},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3704":75739,"_31315":75706,"_21707":129083,"_5":14937,"_28496":128999,"_3093":129084},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3704":75740,"_31315":75706,"_21707":129086,"_5":14937,"_28496":128999,"_3093":129087},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3704":75741,"_31315":75706,"_21707":129089,"_5":14937,"_28496":129003,"_3093":129090},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3704":75742,"_31315":75706,"_21707":129092,"_5":14937,"_28496":129003,"_3093":129093},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3704":75743,"_31315":75743,"_5":15297,"_3093":129095,"_31653":129096,"_21707":129097,"_28496":75743},"Seguridad",[51162],[],{"_3704":75744,"_31315":75743,"_21707":129099,"_5":14937,"_28496":75743,"_3093":129100},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3704":75745,"_31315":75743,"_5":31650,"_21707":129102,"_28496":129103,"_3093":129104},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3704":75746,"_31315":75743,"_5":31650,"_21707":129106,"_28496":129107,"_3093":129108},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3704":75747,"_31315":75743,"_5":31650,"_21707":129110,"_28496":129111,"_3093":129112},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3704":75748,"_31315":75743,"_5":31650,"_21707":129114,"_28496":129115,"_3093":129116},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3704":75749,"_31315":75743,"_21707":129118,"_5":14937,"_28496":75743,"_3093":129119},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3704":75750,"_31315":75743,"_21707":129121,"_5":14937,"_28496":129103,"_3093":129122},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3704":75751,"_31315":75743,"_21707":129124,"_5":14937,"_28496":129103,"_3093":129125},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3704":75752,"_31315":75743,"_21707":129127,"_5":14937,"_28496":129103,"_3093":15576},[],{"_3704":75753,"_31315":75743,"_21707":129129,"_5":14937,"_28496":129103,"_3093":15505},[],{"_3704":75754,"_31315":75743,"_21707":129131,"_5":14937,"_28496":129103,"_3093":15563},[],{"_3704":75755,"_31315":75743,"_21707":129133,"_5":14937,"_28496":129103,"_3093":129134},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3704":75756,"_31315":75743,"_21707":129136,"_5":14937,"_28496":129103,"_3093":129137},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3704":75757,"_31315":75743,"_21707":129139,"_5":14937,"_28496":129107,"_3093":129140},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3704":75758,"_31315":75743,"_21707":129142,"_5":14937,"_28496":129107,"_3093":129143},[],"No incluyas en el reporte:",{"_3704":75759,"_31315":75743,"_21707":129145,"_5":14937,"_28496":129107,"_3093":129146},[],"Credenciales, tokens o claves privadas",{"_3704":75760,"_31315":75743,"_21707":129148,"_5":14937,"_28496":129107,"_3093":129149},[],"Datos de clientes o información identificable de clientes",{"_3704":75761,"_31315":75743,"_21707":129151,"_5":14937,"_28496":129107,"_3093":129152},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3704":75762,"_31315":75743,"_21707":129154,"_5":14937,"_28496":129111,"_3093":129155},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3704":75763,"_31315":75743,"_21707":129157,"_5":14937,"_28496":129111,"_3093":129158},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3704":75764,"_31315":75743,"_21707":129160,"_5":14937,"_28496":129115,"_3093":129161},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3704":75765,"_31315":75743,"_21707":129163,"_5":14937,"_28496":129115,"_3093":129164},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3704":75766,"_31315":75743,"_21707":129166,"_5":14937,"_28496":129115,"_3093":129167},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3704":75767,"_31315":75743,"_21707":129169,"_5":14937,"_28496":129115,"_3093":129170},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3704":75768,"_31315":75743,"_21707":129172,"_5":14937,"_28496":129115,"_3093":129173},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3704":75769,"_31315":75769,"_5":15297,"_3093":129175,"_31653":129176,"_21707":129178,"_28496":75769},"3.8.0 a 4.0.0",[51162,129177],"Actualizaciones",[],{"_3704":75770,"_31315":75769,"_21707":129180,"_5":14937,"_28496":75769,"_3093":129181},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3704":75771,"_31315":75769,"_5":31650,"_21707":129183,"_28496":129184,"_3093":129185},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3704":75772,"_31315":75769,"_5":31650,"_21707":129187,"_28496":129188,"_3093":129189},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3704":75773,"_31315":75769,"_5":31650,"_21707":129191,"_28496":129192,"_3093":129193},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3704":75774,"_31315":75769,"_5":31650,"_21707":129195,"_28496":129196,"_3093":129197},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3704":75775,"_31315":75769,"_5":31650,"_21707":129199,"_28496":129200,"_3093":129201},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3704":75776,"_31315":75769,"_5":31650,"_21707":129203,"_28496":129204,"_3093":129205},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3704":75777,"_31315":75769,"_5":31650,"_21707":129207,"_28496":129208,"_3093":59662},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3704":75778,"_31315":75769,"_5":31650,"_21707":129210,"_28496":129211,"_3093":129212},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3704":75779,"_31315":75769,"_5":31650,"_21707":129214,"_28496":129215,"_3093":129216},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3704":75780,"_31315":75769,"_5":31650,"_21707":129218,"_28496":129219,"_3093":129220},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3704":75781,"_31315":75769,"_5":31650,"_21707":129222,"_28496":129223,"_3093":121539},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3704":75782,"_31315":75769,"_5":31650,"_21707":129225,"_28496":129226,"_3093":129227},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3704":75783,"_31315":75769,"_5":31650,"_21707":129229,"_28496":129230,"_3093":129231},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3704":75784,"_31315":75769,"_5":31650,"_21707":129233,"_28496":129234,"_3093":129235},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3704":75785,"_31315":75769,"_5":31650,"_21707":129237,"_28496":129238,"_3093":129239},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3704":75786,"_31315":75769,"_5":31650,"_21707":129241,"_28496":129242,"_3093":129243},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3704":75787,"_31315":75769,"_5":31650,"_21707":129245,"_28496":129246,"_3093":129247},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3704":75788,"_31315":75769,"_5":31650,"_21707":129249,"_28496":129250,"_3093":129251},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3704":75789,"_31315":75769,"_5":31650,"_21707":129253,"_28496":129254,"_3093":129255},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3704":75790,"_31315":75769,"_5":31650,"_21707":129257,"_28496":129258,"_3093":129259},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3704":75791,"_31315":75769,"_5":31650,"_21707":129261,"_28496":129262,"_3093":129263},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3704":75792,"_31315":75769,"_5":31650,"_21707":129265,"_28496":129266,"_3093":129267},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3704":75793,"_31315":75769,"_5":31650,"_21707":129269,"_28496":129270,"_3093":129271},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3704":75794,"_31315":75769,"_5":31650,"_21707":129273,"_28496":129274,"_3093":129275},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3704":75795,"_31315":75769,"_5":31650,"_21707":129277,"_28496":129278,"_3093":129279},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3704":75796,"_31315":75769,"_5":31650,"_21707":129281,"_28496":129282,"_3093":129283},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3704":75797,"_31315":75769,"_5":31650,"_21707":129285,"_28496":129286,"_3093":129287},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3704":75798,"_31315":75769,"_5":31650,"_21707":129289,"_28496":129290,"_3093":129291},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3704":75799,"_31315":75769,"_5":31650,"_21707":129293,"_28496":129294,"_3093":129295},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3704":75800,"_31315":75769,"_5":31650,"_21707":129297,"_28496":129298,"_3093":129299},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3704":75801,"_31315":75769,"_5":31650,"_21707":129301,"_28496":129302,"_3093":129303},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3704":75802,"_31315":75769,"_5":31650,"_21707":129305,"_28496":129306,"_3093":129307},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3704":75803,"_31315":75769,"_5":31650,"_21707":129309,"_28496":129310,"_3093":129311},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3704":75804,"_31315":75769,"_5":31650,"_21707":129313,"_28496":129314,"_3093":129315},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3704":75805,"_31315":75769,"_5":31650,"_21707":129317,"_28496":129318,"_3093":129319},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3704":75806,"_31315":75769,"_5":31650,"_21707":129321,"_28496":129322,"_3093":129323},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3704":75807,"_31315":75769,"_5":31650,"_21707":129325,"_28496":129326,"_3093":129327},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3704":75808,"_31315":75769,"_5":31650,"_21707":129329,"_28496":129330,"_3093":129331},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3704":75809,"_31315":75769,"_5":31650,"_21707":129333,"_28496":129334,"_3093":129335},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3704":75810,"_31315":75769,"_5":31650,"_21707":129337,"_28496":129338,"_3093":129339},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3704":75811,"_31315":75769,"_5":31650,"_21707":129341,"_28496":129342,"_3093":129343},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3704":75812,"_31315":75769,"_5":31650,"_21707":129345,"_28496":129346,"_3093":129347},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3704":75813,"_31315":75769,"_5":31650,"_21707":129349,"_28496":129350,"_3093":129351},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3704":75814,"_31315":75769,"_5":31650,"_21707":129353,"_28496":129354,"_3093":129355},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3704":75815,"_31315":75769,"_5":31650,"_21707":129357,"_28496":129358,"_3093":125107},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3704":75816,"_31315":75769,"_5":31650,"_21707":129360,"_28496":129361,"_3093":129362},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3704":75817,"_31315":75769,"_5":31650,"_21707":129364,"_28496":129365,"_3093":129366},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3704":75818,"_31315":75769,"_21707":129368,"_5":14937,"_28496":75769,"_3093":129369},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3704":75819,"_31315":75769,"_21707":129371,"_5":14937,"_28496":75769,"_3093":129372},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3704":75820,"_31315":75769,"_21707":129374,"_5":14937,"_28496":75769,"_3093":129375},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3704":75821,"_31315":75769,"_21707":129377,"_5":14937,"_28496":75769,"_3093":129378},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3704":75822,"_31315":75769,"_21707":129380,"_5":14937,"_28496":75769,"_3093":129381},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3704":75823,"_31315":75769,"_21707":129383,"_5":14937,"_28496":75769,"_3093":129384},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3704":75824,"_31315":75769,"_21707":129386,"_5":14937,"_28496":75769,"_3093":129387},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3704":75825,"_31315":75769,"_21707":129389,"_5":14937,"_28496":129188,"_3093":129390},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3704":75826,"_31315":75769,"_21707":129392,"_5":14937,"_28496":129188,"_3093":129393},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3704":75827,"_31315":75769,"_21707":129395,"_5":14937,"_28496":129192,"_3093":129396},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3704":75828,"_31315":75769,"_21707":129398,"_5":14937,"_28496":129192,"_3093":129399},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3704":75829,"_31315":75769,"_21707":129401,"_5":14937,"_28496":129196,"_3093":129402},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3704":75830,"_31315":75769,"_21707":129404,"_5":14937,"_28496":129200,"_3093":129405},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3704":75831,"_31315":75769,"_21707":129407,"_5":14937,"_28496":129200,"_3093":129408},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3704":75832,"_31315":75769,"_21707":129410,"_5":14937,"_28496":129200,"_3093":129411},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3704":75833,"_31315":75769,"_21707":129413,"_5":14937,"_28496":129200,"_3093":129414},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3704":75834,"_31315":75769,"_21707":129416,"_5":14937,"_28496":129200,"_3093":129417},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3704":75835,"_31315":75769,"_21707":129419,"_5":14937,"_28496":129204,"_3093":129420},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3704":75836,"_31315":75769,"_21707":129422,"_5":14937,"_28496":129204,"_3093":129423},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3704":75837,"_31315":75769,"_21707":129425,"_5":14937,"_28496":129204,"_3093":129426},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3704":75838,"_31315":75769,"_21707":129428,"_5":14937,"_28496":129204,"_3093":129429},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3704":75839,"_31315":75769,"_21707":129431,"_5":14937,"_28496":129204,"_3093":129432},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3704":75840,"_31315":75769,"_21707":129434,"_5":14937,"_28496":129204,"_3093":129435},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3704":75841,"_31315":75769,"_21707":129437,"_5":14937,"_28496":129208,"_3093":129438},[],"Cambio",{"_3704":75842,"_31315":75769,"_21707":129440,"_5":14937,"_28496":129208,"_3093":129441},[],"A quién afecta",{"_3704":75843,"_31315":75769,"_21707":129443,"_5":14937,"_28496":129208,"_3093":129444},[],"Gravedad",{"_3704":75844,"_31315":75769,"_21707":129446,"_5":14937,"_28496":129208,"_3093":127917},[],{"_3704":75845,"_31315":75769,"_21707":129448,"_5":14937,"_28496":129208,"_3093":129216},[],{"_3704":75846,"_31315":75769,"_21707":129450,"_5":14937,"_28496":129208,"_3093":129451},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3704":75847,"_31315":75769,"_21707":129453,"_5":14937,"_28496":129208,"_3093":129454},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3704":75848,"_31315":75769,"_21707":129456,"_5":14937,"_28496":129208,"_3093":129457},[],"Copiar los datos a los volúmenes nuevos",{"_3704":75849,"_31315":75769,"_21707":129459,"_5":14937,"_28496":129208,"_3093":129220},[],{"_3704":75850,"_31315":75769,"_21707":129461,"_5":14937,"_28496":129208,"_3093":129462},[],"Todas las releases de Helm",{"_3704":75851,"_31315":75769,"_21707":129464,"_5":14937,"_28496":129208,"_3093":129465},[],"Alta: `helm upgrade` falla",{"_3704":75852,"_31315":75769,"_21707":129467,"_5":14937,"_28496":129208,"_3093":129468},[],"Eliminar o renombrar las claves heredadas",{"_3704":75853,"_31315":75769,"_21707":129470,"_5":14937,"_28496":129208,"_3093":121539},[],{"_3704":75854,"_31315":75769,"_21707":129472,"_5":14937,"_28496":129208,"_3093":129462},[],{"_3704":75855,"_31315":75769,"_21707":129474,"_5":14937,"_28496":129208,"_3093":129475},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3704":75856,"_31315":75769,"_21707":129477,"_5":14937,"_28496":129208,"_3093":129478},[],"Crear primero los Secrets; consulta el paso 2",{"_3704":75857,"_31315":75769,"_21707":129480,"_5":14937,"_28496":129208,"_3093":129227},[],{"_3704":75858,"_31315":75769,"_21707":129482,"_5":14937,"_28496":129208,"_3093":129483},[],"Todos los despliegues",{"_3704":75859,"_31315":75769,"_21707":129485,"_5":14937,"_28496":129208,"_3093":129486},[],"Alta: sin principal de bootstrap no hay administrador",{"_3704":75860,"_31315":75769,"_21707":129488,"_5":14937,"_28496":129208,"_3093":129489},[],"Configurar `services.authz`",{"_3704":75861,"_31315":75769,"_21707":129491,"_5":14937,"_28496":129208,"_3093":129231},[],{"_3704":75862,"_31315":75769,"_21707":129493,"_5":14937,"_28496":129208,"_3093":129462},[],{"_3704":75863,"_31315":75769,"_21707":129495,"_5":14937,"_28496":129208,"_3093":129496},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3704":75864,"_31315":75769,"_21707":129498,"_5":14937,"_28496":129208,"_3093":129499},[],"Mover JWKS y roles a `services.authz`",{"_3704":75865,"_31315":75769,"_21707":129501,"_5":14937,"_28496":129208,"_3093":129251},[],{"_3704":75866,"_31315":75769,"_21707":129503,"_5":14937,"_28496":129208,"_3093":129504},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3704":75867,"_31315":75769,"_21707":129506,"_5":14937,"_28496":129208,"_3093":129507},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3704":75868,"_31315":75769,"_21707":129509,"_5":14937,"_28496":129208,"_3093":129510},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3704":75869,"_31315":75769,"_21707":129512,"_5":14937,"_28496":129208,"_3093":129255},[],{"_3704":75870,"_31315":75769,"_21707":129514,"_5":14937,"_28496":129208,"_3093":129515},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3704":75871,"_31315":75769,"_21707":129517,"_5":14937,"_28496":129208,"_3093":129518},[],"Alta: el backend ya no arranca con ellos",{"_3704":75872,"_31315":75769,"_21707":129520,"_5":14937,"_28496":129208,"_3093":129521},[],"Pasar a PostgreSQL antes de actualizar",{"_3704":75873,"_31315":75769,"_21707":129523,"_5":14937,"_28496":129208,"_3093":129303},[],{"_3704":75874,"_31315":75769,"_21707":129525,"_5":14937,"_28496":129208,"_3093":129526},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3704":75875,"_31315":75769,"_21707":129528,"_5":14937,"_28496":129208,"_3093":129529},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3704":75876,"_31315":75769,"_21707":129531,"_5":14937,"_28496":129208,"_3093":129532},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3704":75877,"_31315":75769,"_21707":129534,"_5":14937,"_28496":129208,"_3093":129535},[],"Webhooks con referencias a archivos",{"_3704":75878,"_31315":75769,"_21707":129537,"_5":14937,"_28496":129208,"_3093":129538},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3704":75879,"_31315":75769,"_21707":129540,"_5":14937,"_28496":129208,"_3093":129541},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3704":75880,"_31315":75769,"_21707":129543,"_5":14937,"_28496":129208,"_3093":129544},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3704":75881,"_31315":75769,"_21707":129546,"_5":14937,"_28496":129208,"_3093":129235},[],{"_3704":75882,"_31315":75769,"_21707":129548,"_5":14937,"_28496":129208,"_3093":129549},[],"Releases con identidades por servicio o material de claves montado",{"_3704":75883,"_31315":75769,"_21707":129551,"_5":14937,"_28496":129208,"_3093":129552},[],"Media: los servicios no pueden leer sus archivos",{"_3704":75884,"_31315":75769,"_21707":129554,"_5":14937,"_28496":129208,"_3093":129555},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3704":75885,"_31315":75769,"_21707":129557,"_5":14937,"_28496":129208,"_3093":129239},[],{"_3704":75886,"_31315":75769,"_21707":129559,"_5":14937,"_28496":129208,"_3093":129560},[],"Releases que definen `amqp.tls`",{"_3704":75887,"_31315":75769,"_21707":129562,"_5":14937,"_28496":129208,"_3093":129563},[],"Media: los clientes se conectan al puerto equivocado",{"_3704":75888,"_31315":75769,"_21707":129565,"_5":14937,"_28496":129208,"_3093":129566},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3704":75889,"_31315":75769,"_21707":129568,"_5":14937,"_28496":129208,"_3093":129259},[],{"_3704":75890,"_31315":75769,"_21707":129570,"_5":14937,"_28496":129208,"_3093":129571},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3704":75891,"_31315":75769,"_21707":129573,"_5":14937,"_28496":129208,"_3093":129574},[],"Media: las claves de CA quedan sin gestionar",{"_3704":75892,"_31315":75769,"_21707":129576,"_5":14937,"_28496":129208,"_3093":129577},[],"Ejecutar la migración de CA a KMS",{"_3704":75893,"_31315":75769,"_21707":129579,"_5":14937,"_28496":129208,"_3093":129580},[],"Verificación del certificado del receptor",{"_3704":75894,"_31315":75769,"_21707":129582,"_5":14937,"_28496":129208,"_3093":129583},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3704":75895,"_31315":75769,"_21707":129585,"_5":14937,"_28496":129208,"_3093":129586},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3704":75896,"_31315":75769,"_21707":129588,"_5":14937,"_28496":129208,"_3093":129589},[],"Poner `insecure_skip_verify` a `false`",{"_3704":75897,"_31315":75769,"_21707":129591,"_5":14937,"_28496":129208,"_3093":129275},[],{"_3704":75898,"_31315":75769,"_21707":129593,"_5":14937,"_28496":129208,"_3093":129594},[],"Scripts y consolas que editan DMS por API",{"_3704":75899,"_31315":75769,"_21707":129596,"_5":14937,"_28496":129208,"_3093":129597},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3704":75900,"_31315":75769,"_21707":129599,"_5":14937,"_28496":129208,"_3093":129600},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3704":75901,"_31315":75769,"_21707":129602,"_5":14937,"_28496":129208,"_3093":129279},[],{"_3704":75902,"_31315":75769,"_21707":129604,"_5":14937,"_28496":129208,"_3093":129605},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3704":75903,"_31315":75769,"_21707":129607,"_5":14937,"_28496":129208,"_3093":129608},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3704":75904,"_31315":75769,"_21707":129610,"_5":14937,"_28496":129208,"_3093":129611},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3704":75905,"_31315":75769,"_21707":129613,"_5":14937,"_28496":129208,"_3093":129299},[],{"_3704":75906,"_31315":75769,"_21707":129615,"_5":14937,"_28496":129208,"_3093":129616},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3704":75907,"_31315":75769,"_21707":129618,"_5":14937,"_28496":129208,"_3093":129619},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3704":75908,"_31315":75769,"_21707":129621,"_5":14937,"_28496":129208,"_3093":129622},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3704":75909,"_31315":75769,"_21707":129624,"_5":14937,"_28496":129208,"_3093":129307},[],{"_3704":75910,"_31315":75769,"_21707":129626,"_5":14937,"_28496":129208,"_3093":129627},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3704":75911,"_31315":75769,"_21707":129629,"_5":14937,"_28496":129208,"_3093":129630},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3704":75912,"_31315":75769,"_21707":129632,"_5":14937,"_28496":129208,"_3093":129633},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3704":75913,"_31315":75769,"_21707":129635,"_5":14937,"_28496":129208,"_3093":129311},[],{"_3704":75914,"_31315":75769,"_21707":129637,"_5":14937,"_28496":129208,"_3093":129638},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3704":75915,"_31315":75769,"_21707":129640,"_5":14937,"_28496":129208,"_3093":129641},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3704":75916,"_31315":75769,"_21707":129643,"_5":14937,"_28496":129208,"_3093":129644},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3704":75917,"_31315":75769,"_21707":129646,"_5":14937,"_28496":129208,"_3093":129295},[],{"_3704":75918,"_31315":75769,"_21707":129648,"_5":14937,"_28496":129208,"_3093":129649},[],"Consumidores que leen el campo `events` del dispositivo",{"_3704":75919,"_31315":75769,"_21707":129651,"_5":14937,"_28496":129208,"_3093":129652},[],"Media: el campo desaparece",{"_3704":75920,"_31315":75769,"_21707":129654,"_5":14937,"_28496":129208,"_3093":129655},[],"Usar los nuevos endpoints de eventos",{"_3704":75921,"_31315":75769,"_21707":129657,"_5":14937,"_28496":129208,"_3093":129323},[],{"_3704":75922,"_31315":75769,"_21707":129659,"_5":14937,"_28496":129208,"_3093":129660},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3704":75923,"_31315":75769,"_21707":129662,"_5":14937,"_28496":129208,"_3093":129663},[],"Media: la migración de la VA aborta",{"_3704":75924,"_31315":75769,"_21707":129665,"_5":14937,"_28496":129208,"_3093":129666},[],"Corregir los roles afectados antes de actualizar",{"_3704":75925,"_31315":75769,"_21707":129668,"_5":14937,"_28496":129208,"_3093":129243},[],{"_3704":75926,"_31315":75769,"_21707":129670,"_5":14937,"_28496":129208,"_3093":129671},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3704":75927,"_31315":75769,"_21707":129673,"_5":14937,"_28496":129208,"_3093":129674},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3704":75928,"_31315":75769,"_21707":129676,"_5":14937,"_28496":129208,"_3093":129677},[],"Actualizar el archivo de values",{"_3704":75929,"_31315":75769,"_21707":129679,"_5":14937,"_28496":129208,"_3093":129287},[],{"_3704":75930,"_31315":75769,"_21707":129681,"_5":14937,"_28496":129208,"_3093":129682},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3704":75931,"_31315":75769,"_21707":129684,"_5":14937,"_28496":129208,"_3093":129685},[],"Baja: prevalece el ID de la URL",{"_3704":75932,"_31315":75769,"_21707":129687,"_5":14937,"_28496":129208,"_3093":129688},[],"Enviar el ID en la URL",{"_3704":75933,"_31315":75769,"_21707":129690,"_5":14937,"_28496":129208,"_3093":129315},[],{"_3704":75934,"_31315":75769,"_21707":129692,"_5":14937,"_28496":129208,"_3093":129693},[],"Clientes que envían un `id` al crear o importar CAs",{"_3704":75935,"_31315":75769,"_21707":129695,"_5":14937,"_28496":129208,"_3093":129696},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3704":75936,"_31315":75769,"_21707":129698,"_5":14937,"_28496":129208,"_3093":129699},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3704":75937,"_31315":75769,"_21707":129701,"_5":14937,"_28496":129208,"_3093":129319},[],{"_3704":75938,"_31315":75769,"_21707":129703,"_5":14937,"_28496":129208,"_3093":129704},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3704":75939,"_31315":75769,"_21707":129706,"_5":14937,"_28496":129208,"_3093":129707},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3704":75940,"_31315":75769,"_21707":129709,"_5":14937,"_28496":129208,"_3093":129710},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3704":75941,"_31315":75769,"_21707":129712,"_5":14937,"_28496":129208,"_3093":129291},[],{"_3704":75942,"_31315":75769,"_21707":129714,"_5":14937,"_28496":129208,"_3093":129715},[],"Consumidores que comparan el `type` del certificado",{"_3704":75943,"_31315":75769,"_21707":129717,"_5":14937,"_28496":129208,"_3093":129718},[],"Baja: dos valores cambian de nombre",{"_3704":75944,"_31315":75769,"_21707":129720,"_5":14937,"_28496":129208,"_3093":129721},[],"Adaptar los consumidores",{"_3704":75945,"_31315":75769,"_21707":129723,"_5":14937,"_28496":129208,"_3093":129283},[],{"_3704":75946,"_31315":75769,"_21707":129725,"_5":14937,"_28496":129208,"_3093":129726},[],"Cualquier DMS",{"_3704":75947,"_31315":75769,"_21707":129728,"_5":14937,"_28496":129208,"_3093":129729},[],"Baja: solo informativo",{"_3704":75948,"_31315":75769,"_21707":129731,"_5":14937,"_28496":129208,"_3093":129732},[],"Revisar ambos bloques antes de editar",{"_3704":75949,"_31315":75769,"_21707":129734,"_5":14937,"_28496":129215,"_3093":129735},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3704":75950,"_31315":75769,"_21707":129737,"_5":14937,"_28496":129215,"_3093":129738},[],"El paso 4 de la guía de migración copia los datos.",{"_3704":75951,"_31315":75769,"_21707":129740,"_5":14937,"_28496":129219,"_3093":129741},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3704":75952,"_31315":75769,"_21707":129743,"_5":14937,"_28496":129223,"_3093":129744},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3704":75953,"_31315":75769,"_21707":129746,"_5":14937,"_28496":129223,"_3093":129747},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3704":75954,"_31315":75769,"_21707":129749,"_5":14937,"_28496":129226,"_3093":129750},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3704":75955,"_31315":75769,"_21707":129752,"_5":14937,"_28496":129230,"_3093":129753},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3704":75956,"_31315":75769,"_21707":129755,"_5":14937,"_28496":129234,"_3093":129756},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3704":75957,"_31315":75769,"_21707":129758,"_5":14937,"_28496":129234,"_3093":129759},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3704":75958,"_31315":75769,"_21707":129761,"_5":14937,"_28496":129234,"_3093":129762},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3704":75959,"_31315":75769,"_21707":129764,"_5":14937,"_28496":129238,"_3093":129765},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3704":75960,"_31315":75769,"_21707":129767,"_5":14937,"_28496":129242,"_3093":129768},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3704":75961,"_31315":75769,"_21707":129770,"_5":14937,"_28496":129242,"_3093":129771},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3704":75962,"_31315":75769,"_21707":129773,"_5":14937,"_28496":129242,"_3093":129774},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3704":75963,"_31315":75769,"_21707":129776,"_5":14937,"_28496":129242,"_3093":129777},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3704":75964,"_31315":75769,"_21707":129779,"_5":14937,"_28496":129242,"_3093":129780},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3704":75965,"_31315":75769,"_21707":129782,"_5":14937,"_28496":129242,"_3093":129783},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3704":75966,"_31315":75769,"_21707":129785,"_5":14937,"_28496":129250,"_3093":129786},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3704":75967,"_31315":75769,"_21707":129788,"_5":14937,"_28496":129250,"_3093":129789},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3704":75968,"_31315":75769,"_21707":129791,"_5":14937,"_28496":129250,"_3093":129792},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3704":75969,"_31315":75769,"_21707":129794,"_5":14937,"_28496":129250,"_3093":129795},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3704":75970,"_31315":75769,"_21707":129797,"_5":14937,"_28496":129250,"_3093":129798},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3704":75971,"_31315":75769,"_21707":129800,"_5":14937,"_28496":129254,"_3093":129801},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3704":75972,"_31315":75769,"_21707":129803,"_5":14937,"_28496":129258,"_3093":129804},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3704":75973,"_31315":75769,"_21707":129806,"_5":14937,"_28496":129258,"_3093":129807},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3704":75974,"_31315":75769,"_21707":129809,"_5":14937,"_28496":129258,"_3093":129810},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3704":75975,"_31315":75769,"_21707":129812,"_5":14937,"_28496":129258,"_3093":129813},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3704":75976,"_31315":75769,"_21707":129815,"_5":14937,"_28496":129258,"_3093":129816},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3704":75977,"_31315":75769,"_21707":129818,"_5":14937,"_28496":129258,"_3093":129819},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3704":75978,"_31315":75769,"_21707":129821,"_5":14937,"_28496":129258,"_3093":129822},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3704":75979,"_31315":75769,"_21707":129824,"_5":14937,"_28496":129258,"_3093":129825},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3704":75980,"_31315":75769,"_21707":129827,"_5":14937,"_28496":129262,"_3093":129828},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3704":75981,"_31315":75769,"_21707":129830,"_5":14937,"_28496":129270,"_3093":129831},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3704":75982,"_31315":75769,"_21707":129833,"_5":14937,"_28496":129270,"_3093":129834},[],"Campo en 3.8.0",{"_3704":75983,"_31315":75769,"_21707":129836,"_5":14937,"_28496":129270,"_3093":129837},[],"Campo en 4.0.0",{"_3704":75984,"_31315":75769,"_21707":129839,"_5":14937,"_28496":129270,"_3093":60293},[],{"_3704":75985,"_31315":75769,"_21707":129841,"_5":14937,"_28496":129270,"_3093":129842},[],"`insecure_skip_verify` (con el valor negado)",{"_3704":75986,"_31315":75769,"_21707":129844,"_5":14937,"_28496":129270,"_3093":60299},[],{"_3704":75987,"_31315":75769,"_21707":129846,"_5":14937,"_28496":129270,"_3093":60302},[],{"_3704":75988,"_31315":75769,"_21707":129848,"_5":14937,"_28496":129270,"_3093":60305},[],{"_3704":75989,"_31315":75769,"_21707":129850,"_5":14937,"_28496":129270,"_3093":60308},[],{"_3704":75990,"_31315":75769,"_21707":129852,"_5":14937,"_28496":129270,"_3093":60311},[],{"_3704":75991,"_31315":75769,"_21707":129854,"_5":14937,"_28496":129270,"_3093":60314},[],{"_3704":75992,"_31315":75769,"_21707":129856,"_5":14937,"_28496":129270,"_3093":129857},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3704":75993,"_31315":75769,"_21707":129859,"_5":14937,"_28496":129270,"_3093":129860},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3704":75994,"_31315":75769,"_21707":129862,"_5":14937,"_28496":129270,"_3093":129863},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3704":75995,"_31315":75769,"_21707":129865,"_5":14937,"_28496":129274,"_3093":129866},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3704":75996,"_31315":75769,"_21707":129868,"_5":14937,"_28496":129274,"_3093":129869},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3704":75997,"_31315":75769,"_21707":129871,"_5":14937,"_28496":129274,"_3093":129872},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3704":75998,"_31315":75769,"_21707":129874,"_5":14937,"_28496":129278,"_3093":129875},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3704":75999,"_31315":75769,"_21707":129877,"_5":14937,"_28496":129278,"_3093":129878},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3704":76000,"_31315":75769,"_21707":129880,"_5":14937,"_28496":129282,"_3093":129881},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3704":76001,"_31315":75769,"_21707":129883,"_5":14937,"_28496":129286,"_3093":129884},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3704":76002,"_31315":75769,"_21707":129886,"_5":14937,"_28496":129290,"_3093":129887},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3704":76003,"_31315":75769,"_21707":129889,"_5":14937,"_28496":129294,"_3093":129890},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3704":76004,"_31315":75769,"_21707":129892,"_5":14937,"_28496":129294,"_3093":129893},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3704":76005,"_31315":75769,"_21707":129895,"_5":14937,"_28496":129294,"_3093":129896},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3704":76006,"_31315":75769,"_21707":129898,"_5":14937,"_28496":129294,"_3093":129899},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3704":76007,"_31315":75769,"_21707":129901,"_5":14937,"_28496":129298,"_3093":129902},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3704":76008,"_31315":75769,"_21707":129904,"_5":14937,"_28496":129302,"_3093":129905},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3704":76009,"_31315":75769,"_21707":129907,"_5":14937,"_28496":129302,"_3093":129908},[],"Ruta",{"_3704":76010,"_31315":75769,"_21707":129910,"_5":14937,"_28496":129302,"_3093":122196},[],{"_3704":76011,"_31315":75769,"_21707":129912,"_5":14937,"_28496":129302,"_3093":60373},[],{"_3704":76012,"_31315":75769,"_21707":129914,"_5":14937,"_28496":129302,"_3093":129915},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3704":76013,"_31315":75769,"_21707":129917,"_5":14937,"_28496":129302,"_3093":60379},[],{"_3704":76014,"_31315":75769,"_21707":129919,"_5":14937,"_28496":129302,"_3093":129920},[],"Lee los ajustes de una CA.",{"_3704":76015,"_31315":75769,"_21707":129922,"_5":14937,"_28496":129302,"_3093":60385},[],{"_3704":76016,"_31315":75769,"_21707":129924,"_5":14937,"_28496":129302,"_3093":129925},[],"Sustituye los `crl_options`.",{"_3704":76017,"_31315":75769,"_21707":129927,"_5":14937,"_28496":129302,"_3093":60391},[],{"_3704":76018,"_31315":75769,"_21707":129929,"_5":14937,"_28496":129302,"_3093":129930},[],"Elimina los ajustes archivados de una CA.",{"_3704":76019,"_31315":75769,"_21707":129932,"_5":14937,"_28496":129302,"_3093":129933},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3704":76020,"_31315":75769,"_21707":129935,"_5":14937,"_28496":129302,"_3093":129936},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3704":76021,"_31315":75769,"_21707":129938,"_5":14937,"_28496":129302,"_3093":129939},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3704":76022,"_31315":75769,"_21707":129941,"_5":14937,"_28496":129302,"_3093":129942},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3704":76023,"_31315":75769,"_21707":129944,"_5":14937,"_28496":129302,"_3093":129945},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3704":76024,"_31315":75769,"_21707":129947,"_5":14937,"_28496":129302,"_3093":129948},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3704":76025,"_31315":75769,"_21707":129950,"_5":14937,"_28496":129302,"_3093":129951},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3704":76026,"_31315":75769,"_21707":129953,"_5":14937,"_28496":129302,"_3093":129954},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3704":76027,"_31315":75769,"_21707":129956,"_5":14937,"_28496":129302,"_3093":129957},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3704":76028,"_31315":75769,"_21707":129959,"_5":14937,"_28496":129302,"_3093":129960},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3704":76029,"_31315":75769,"_21707":129962,"_5":14937,"_28496":129302,"_3093":129963},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3704":76030,"_31315":75769,"_21707":129965,"_5":14937,"_28496":129306,"_3093":129966},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3704":76031,"_31315":75769,"_21707":129968,"_5":14937,"_28496":129310,"_3093":129969},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3704":76032,"_31315":75769,"_21707":129971,"_5":14937,"_28496":129314,"_3093":129972},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3704":76033,"_31315":75769,"_21707":129974,"_5":14937,"_28496":129318,"_3093":129975},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3704":76034,"_31315":75769,"_21707":129977,"_5":14937,"_28496":129318,"_3093":129978},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3704":76035,"_31315":75769,"_21707":129980,"_5":14937,"_28496":129322,"_3093":129981},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3704":76036,"_31315":75769,"_21707":129983,"_5":14937,"_28496":129326,"_3093":129984},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3704":76037,"_31315":75769,"_21707":129986,"_5":14937,"_28496":129330,"_3093":129987},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3704":76038,"_31315":75769,"_21707":129989,"_5":14937,"_28496":129330,"_3093":129990},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3704":76039,"_31315":75769,"_21707":129992,"_5":14937,"_28496":129330,"_3093":129993},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3704":76040,"_31315":75769,"_21707":129995,"_5":14937,"_28496":129330,"_3093":129996},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3704":76041,"_31315":75769,"_21707":129998,"_5":14937,"_28496":129330,"_3093":129999},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3704":76042,"_31315":75769,"_21707":130001,"_5":14937,"_28496":129330,"_3093":130002},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3704":76043,"_31315":75769,"_21707":130004,"_5":14937,"_28496":129334,"_3093":130005},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3704":76044,"_31315":75769,"_21707":130007,"_5":14937,"_28496":129334,"_3093":130008},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3704":76045,"_31315":75769,"_21707":130010,"_5":14937,"_28496":129334,"_3093":130011},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3704":76046,"_31315":75769,"_21707":130013,"_5":14937,"_28496":129334,"_3093":130014},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3704":76047,"_31315":75769,"_21707":130016,"_5":14937,"_28496":129334,"_3093":130017},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3704":76048,"_31315":75769,"_21707":130019,"_5":14937,"_28496":129338,"_3093":130020},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3704":76049,"_31315":75769,"_21707":130022,"_5":14937,"_28496":129338,"_3093":130023},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3704":76050,"_31315":75769,"_21707":130025,"_5":14937,"_28496":129338,"_3093":130026},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3704":76051,"_31315":75769,"_21707":130028,"_5":14937,"_28496":129338,"_3093":60493},[],{"_3704":76052,"_31315":75769,"_21707":130030,"_5":14937,"_28496":129338,"_3093":130031},[],"Claves de datos obligatorias",{"_3704":76053,"_31315":75769,"_21707":130033,"_5":14937,"_28496":129338,"_3093":130034},[],"Cuándo",{"_3704":76054,"_31315":75769,"_21707":130036,"_5":14937,"_28496":129338,"_3093":130037},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3704":76055,"_31315":75769,"_21707":130039,"_5":14937,"_28496":129338,"_3093":60505},[],{"_3704":76056,"_31315":75769,"_21707":130041,"_5":14937,"_28496":129338,"_3093":130042},[],"Siempre",{"_3704":76057,"_31315":75769,"_21707":130044,"_5":14937,"_28496":129338,"_3093":130045},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3704":76058,"_31315":75769,"_21707":130047,"_5":14937,"_28496":129338,"_3093":60505},[],{"_3704":76059,"_31315":75769,"_21707":130049,"_5":14937,"_28496":129338,"_3093":130042},[],{"_3704":76060,"_31315":75769,"_21707":130051,"_5":14937,"_28496":129338,"_3093":60518},[],{"_3704":76061,"_31315":75769,"_21707":130053,"_5":14937,"_28496":129338,"_3093":60505},[],{"_3704":76062,"_31315":75769,"_21707":130055,"_5":14937,"_28496":129338,"_3093":130056},[],"Solo cuando hay autenticación SMTP",{"_3704":76063,"_31315":75769,"_21707":130058,"_5":14937,"_28496":129338,"_3093":130059},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3704":76064,"_31315":75769,"_21707":130061,"_5":14937,"_28496":129338,"_3093":130062},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3704":76065,"_31315":75769,"_21707":130064,"_5":14937,"_28496":129338,"_3093":130065},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3704":76066,"_31315":75769,"_21707":130067,"_5":14937,"_28496":129338,"_3093":130068},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3704":76067,"_31315":75769,"_21707":130070,"_5":14937,"_28496":129338,"_3093":130071},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3704":76068,"_31315":75769,"_21707":130073,"_5":14937,"_28496":129338,"_3093":130074},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3704":76069,"_31315":75769,"_21707":130076,"_5":14937,"_28496":129338,"_3093":130077},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3704":76070,"_31315":75769,"_21707":130079,"_5":14937,"_28496":129338,"_3093":130080},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3704":76071,"_31315":75769,"_21707":130082,"_5":14937,"_28496":129338,"_3093":130083},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3704":76072,"_31315":75769,"_21707":130085,"_5":14937,"_28496":129338,"_3093":130086},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3704":76073,"_31315":75769,"_21707":130088,"_5":14937,"_28496":129338,"_3093":130089},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3704":76074,"_31315":75769,"_21707":130091,"_5":14937,"_28496":129338,"_3093":130092},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3704":76075,"_31315":75769,"_21707":130094,"_5":14937,"_28496":129338,"_3093":130095},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3704":76076,"_31315":75769,"_21707":130097,"_5":14937,"_28496":129338,"_3093":130098},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3704":76077,"_31315":75769,"_21707":130100,"_5":14937,"_28496":129338,"_3093":130101},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3704":76078,"_31315":75769,"_21707":130103,"_5":14937,"_28496":129342,"_3093":130104},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3704":76079,"_31315":75769,"_21707":130106,"_5":14937,"_28496":129342,"_3093":130107},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3704":76080,"_31315":75769,"_21707":130109,"_5":14937,"_28496":129346,"_3093":130110},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3704":76081,"_31315":75769,"_21707":130112,"_5":14937,"_28496":129346,"_3093":130113},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3704":76082,"_31315":75769,"_21707":130115,"_5":14937,"_28496":129346,"_3093":130116},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3704":76083,"_31315":75769,"_21707":130118,"_5":14937,"_28496":129346,"_3093":130119},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3704":76084,"_31315":75769,"_21707":130121,"_5":14937,"_28496":129346,"_3093":130122},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3704":76085,"_31315":75769,"_21707":130124,"_5":14937,"_28496":129346,"_3093":130125},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3704":76086,"_31315":75769,"_21707":130127,"_5":14937,"_28496":129346,"_3093":130128},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3704":76087,"_31315":75769,"_21707":130130,"_5":14937,"_28496":129346,"_3093":130131},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3704":76088,"_31315":75769,"_21707":130133,"_5":14937,"_28496":129346,"_3093":130134},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3704":76089,"_31315":75769,"_21707":130136,"_5":14937,"_28496":129346,"_3093":130137},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3704":76090,"_31315":75769,"_21707":130139,"_5":14937,"_28496":129346,"_3093":130140},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3704":76091,"_31315":75769,"_21707":130142,"_5":14937,"_28496":129350,"_3093":130143},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3704":76092,"_31315":75769,"_21707":130145,"_5":14937,"_28496":129350,"_3093":130146},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3704":76093,"_31315":75769,"_21707":130148,"_5":14937,"_28496":129354,"_3093":130149},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3704":76094,"_31315":75769,"_21707":130151,"_5":14937,"_28496":129354,"_3093":130152},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3704":76095,"_31315":75769,"_21707":130154,"_5":14937,"_28496":129354,"_3093":130155},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3704":76096,"_31315":75769,"_21707":130157,"_5":14937,"_28496":129354,"_3093":130158},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3704":76097,"_31315":75769,"_21707":130160,"_5":14937,"_28496":129354,"_3093":130161},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3704":76098,"_31315":75769,"_21707":130163,"_5":14937,"_28496":129354,"_3093":130164},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3704":76099,"_31315":75769,"_21707":130166,"_5":14937,"_28496":129354,"_3093":130167},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3704":76100,"_31315":75769,"_21707":130169,"_5":14937,"_28496":129354,"_3093":130170},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3704":76101,"_31315":75769,"_21707":130172,"_5":14937,"_28496":129358,"_3093":130173},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3704":76102,"_31315":75769,"_21707":130175,"_5":14937,"_28496":129358,"_3093":130176},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3704":76103,"_31315":75769,"_21707":130178,"_5":14937,"_28496":129358,"_3093":130179},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3704":76104,"_31315":75769,"_21707":130181,"_5":14937,"_28496":129358,"_3093":130182},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3704":76105,"_31315":75769,"_21707":130184,"_5":14937,"_28496":129358,"_3093":130185},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3704":76106,"_31315":75769,"_21707":130187,"_5":14937,"_28496":129358,"_3093":130188},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3704":76107,"_31315":75769,"_21707":130190,"_5":14937,"_28496":129358,"_3093":130191},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3704":76108,"_31315":75769,"_21707":130193,"_5":14937,"_28496":129358,"_3093":130194},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3704":76109,"_31315":75769,"_21707":130196,"_5":14937,"_28496":129358,"_3093":130197},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3704":76110,"_31315":75769,"_21707":130199,"_5":14937,"_28496":129358,"_3093":130200},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3704":76111,"_31315":75769,"_21707":130202,"_5":14937,"_28496":129358,"_3093":130203},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3704":76112,"_31315":75769,"_21707":130205,"_5":14937,"_28496":129361,"_3093":130206},[],"Tras la actualización, comprueba en este orden:",{"_3704":76113,"_31315":75769,"_21707":130208,"_5":14937,"_28496":129361,"_3093":130209},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3704":76114,"_31315":75769,"_21707":130211,"_5":14937,"_28496":129361,"_3093":130212},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3704":76115,"_31315":75769,"_21707":130214,"_5":14937,"_28496":129361,"_3093":130215},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3704":76116,"_31315":75769,"_21707":130217,"_5":14937,"_28496":129361,"_3093":130218},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3704":76117,"_31315":75769,"_21707":130220,"_5":14937,"_28496":129361,"_3093":130221},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3704":76118,"_31315":75769,"_21707":130223,"_5":14937,"_28496":129361,"_3093":130224},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3704":76119,"_31315":75769,"_21707":130226,"_5":14937,"_28496":129361,"_3093":130227},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3704":76120,"_31315":75769,"_21707":130229,"_5":14937,"_28496":129361,"_3093":130230},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3704":76121,"_31315":75769,"_21707":130232,"_5":14937,"_28496":129361,"_3093":130233},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3704":76122,"_31315":75769,"_21707":130235,"_5":14937,"_28496":129361,"_3093":130236},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3704":76123,"_31315":75769,"_21707":130238,"_5":14937,"_28496":129361,"_3093":130239},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3704":76124,"_31315":75769,"_21707":130241,"_5":14937,"_28496":129361,"_3093":130242},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3704":76125,"_31315":75769,"_21707":130244,"_5":14937,"_28496":129361,"_3093":130245},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3704":76126,"_31315":75769,"_21707":130247,"_5":14937,"_28496":129361,"_3093":130248},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3704":76127,"_31315":75769,"_21707":130250,"_5":14937,"_28496":129361,"_3093":130251},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3704":76128,"_31315":75769,"_21707":130253,"_5":14937,"_28496":129365,"_3093":130254},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3704":76129,"_31315":75769,"_21707":130256,"_5":14937,"_28496":129365,"_3093":130257},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3704":76130,"_31315":75769,"_21707":130259,"_5":14937,"_28496":129365,"_3093":130260},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3704":76131,"_31315":75769,"_21707":130262,"_5":14937,"_28496":129365,"_3093":130263},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3704":76132,"_31315":75769,"_21707":130265,"_5":14937,"_28496":129365,"_3093":130266},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/io