5129,"_40345":125132,"_40347":125135,"_40349":125138,"_40351":125141,"_40353":125144,"_40355":125147,"_40357":125150,"_40359":125153,"_40361":125156,"_40363":125159,"_40365":125162,"_40367":125165,"_40369":125168,"_40371":125171,"_40373":125174,"_40375":125177,"_40377":125180,"_40379":125183,"_40381":125186,"_40384":125189,"_40386":125192,"_40388":125195},{"_3465":70144,"_30219":70144,"_5":14725,"_2948":116264,"_30551":116265,"_20927":116268,"_27457":70144},"Despliega desde AWS Marketplace",[49254,116266,116267],"Despliegue","Otros modelos",[],{"_3465":70145,"_30219":70144,"_20927":116270,"_5":14373,"_27457":70144,"_2948":116271},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3465":70146,"_30219":70144,"_5":30548,"_20927":116273,"_27457":116274,"_2948":116275},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3465":70147,"_30219":70144,"_5":30548,"_20927":116277,"_27457":116278,"_2948":116279},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3465":70148,"_30219":70144,"_5":30548,"_20927":116281,"_27457":116282,"_2948":116283},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3465":70149,"_30219":70144,"_5":30548,"_20927":116285,"_27457":116286,"_2948":116287},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3465":70150,"_30219":70144,"_5":30548,"_20927":116289,"_27457":116290,"_2948":116291},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3465":70151,"_30219":70144,"_5":30548,"_20927":116293,"_27457":116294,"_2948":116295},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3465":70152,"_30219":70144,"_5":30548,"_20927":116297,"_27457":116298,"_2948":116299},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3465":70153,"_30219":70144,"_20927":116301,"_5":14373,"_27457":70144,"_2948":116302},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3465":70154,"_30219":70144,"_20927":116304,"_5":14373,"_27457":116274,"_2948":116305},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3465":70155,"_30219":70144,"_20927":116307,"_5":14373,"_27457":116274,"_2948":116308},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3465":70156,"_30219":70144,"_20927":116310,"_5":14373,"_27457":116274,"_2948":116311},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3465":70157,"_30219":70144,"_20927":116313,"_5":14373,"_27457":116278,"_2948":116314},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3465":70158,"_30219":70144,"_20927":116316,"_5":14373,"_27457":116278,"_2948":116317},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3465":70159,"_30219":70144,"_20927":116319,"_5":14373,"_27457":116278,"_2948":116320},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3465":70160,"_30219":70144,"_20927":116322,"_5":14373,"_27457":116282,"_2948":116323},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3465":70161,"_30219":70144,"_20927":116325,"_5":14373,"_27457":116286,"_2948":116326},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3465":70162,"_30219":70144,"_20927":116328,"_5":14373,"_27457":116290,"_2948":116329},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3465":70163,"_30219":70144,"_20927":116331,"_5":14373,"_27457":116294,"_2948":116332},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3465":70164,"_30219":70144,"_20927":116334,"_5":14373,"_27457":116298,"_2948":116335},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3465":70165,"_30219":70165,"_5":14725,"_2948":116337,"_30551":116338,"_20927":116339,"_27457":70165},"Despliega Lamassu",[49254,116266],[],{"_3465":70166,"_30219":70165,"_20927":116341,"_5":14373,"_27457":70165,"_2948":116342},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3465":70167,"_30219":70165,"_5":30548,"_20927":116344,"_27457":116345,"_2948":116346},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3465":70168,"_30219":70165,"_5":30548,"_20927":116348,"_27457":116349,"_2948":116350},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3465":70169,"_30219":70165,"_5":30548,"_20927":116352,"_27457":116353,"_2948":116354},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3465":70170,"_30219":70165,"_20927":116356,"_5":14373,"_27457":70165,"_2948":116357},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3465":70171,"_30219":70165,"_20927":116359,"_5":14373,"_27457":116345,"_2948":116360},[],"Modelo",{"_3465":70172,"_30219":70165,"_20927":116362,"_5":14373,"_27457":116345,"_2948":116363},[],"Recomendado para",{"_3465":70173,"_30219":70165,"_20927":116365,"_5":14373,"_27457":116345,"_2948":116366},[],"Quién opera la infraestructura",{"_3465":70174,"_30219":70165,"_20927":116368,"_5":14373,"_27457":116345,"_2948":116369},[],"Punto de partida",{"_3465":70175,"_30219":70165,"_20927":116371,"_5":14373,"_27457":116345,"_2948":49361},[],{"_3465":70176,"_30219":70165,"_20927":116373,"_5":14373,"_27457":116345,"_2948":116374},[],"Producción, entornos regulados y despliegues personalizados",{"_3465":70177,"_30219":70165,"_20927":116376,"_5":14373,"_27457":116345,"_2948":116377},[],"Tu equipo",{"_3465":70178,"_30219":70165,"_20927":116379,"_5":14373,"_27457":116345,"_2948":116380},[],"Helm o Fastlane",{"_3465":70179,"_30219":70165,"_20927":116382,"_5":14373,"_27457":116345,"_2948":49373},[],{"_3465":70180,"_30219":70165,"_20927":116384,"_5":14373,"_27457":116345,"_2948":116385},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3465":70181,"_30219":70165,"_20927":116387,"_5":14373,"_27457":116345,"_2948":116377},[],{"_3465":70182,"_30219":70165,"_20927":116389,"_5":14373,"_27457":116345,"_2948":116390},[],"Imagen preconfigurada en EC2",{"_3465":70183,"_30219":70165,"_20927":116392,"_5":14373,"_27457":116345,"_2948":49384},[],{"_3465":70184,"_30219":70165,"_20927":116394,"_5":14373,"_27457":116345,"_2948":116395},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3465":70185,"_30219":70165,"_20927":116397,"_5":14373,"_27457":116345,"_2948":49390},[],{"_3465":70186,"_30219":70165,"_20927":116399,"_5":14373,"_27457":116345,"_2948":116400},[],"Suscripción gestionada",{"_3465":70187,"_30219":70165,"_20927":116402,"_5":14373,"_27457":116345,"_2948":116403},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3465":70188,"_30219":70165,"_20927":116405,"_5":14373,"_27457":116345,"_2948":116406},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3465":70189,"_30219":70165,"_20927":116408,"_5":14373,"_27457":116345,"_2948":116409},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3465":70190,"_30219":70165,"_20927":116411,"_5":14373,"_27457":116349,"_2948":116412},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3465":70191,"_30219":70165,"_20927":116414,"_5":14373,"_27457":116353,"_2948":116415},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3465":70192,"_30219":70192,"_5":14725,"_2948":116417,"_30551":116418,"_20927":116419,"_27457":70192},"Utiliza Lamassu como SaaS",[49254,116266,116267],[],{"_3465":70193,"_30219":70192,"_20927":116421,"_5":14373,"_27457":70192,"_2948":116422},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3465":70194,"_30219":70192,"_5":30548,"_20927":116424,"_27457":116425,"_2948":116426},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3465":70195,"_30219":70192,"_5":30548,"_20927":116428,"_27457":116429,"_2948":116430},[],"/docs/es/deployment/saas#planes","Planes",{"_3465":70196,"_30219":70192,"_5":30548,"_20927":116432,"_27457":116433,"_2948":116434},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3465":70197,"_30219":70192,"_20927":116436,"_5":14373,"_27457":70192,"_2948":116437},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3465":70198,"_30219":70192,"_20927":116439,"_5":14373,"_27457":116425,"_2948":116440},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3465":70199,"_30219":70192,"_20927":116442,"_5":14373,"_27457":116425,"_2948":116443},[],"Copias de seguridad automáticas.",{"_3465":70200,"_30219":70192,"_20927":116445,"_5":14373,"_27457":116425,"_2948":116446},[],"Actualizaciones de versión.",{"_3465":70201,"_30219":70192,"_20927":116448,"_5":14373,"_27457":116425,"_2948":116449},[],"Soporte técnico y SLA según el plan contratado.",{"_3465":70202,"_30219":70192,"_20927":116451,"_5":14373,"_27457":116429,"_2948":49445},[],{"_3465":70203,"_30219":70192,"_20927":116453,"_5":14373,"_27457":116429,"_2948":116454},[],"Dispositivos",{"_3465":70204,"_30219":70192,"_20927":116456,"_5":14373,"_27457":116429,"_2948":116457},[],"Soporte",{"_3465":70205,"_30219":70192,"_20927":116459,"_5":14373,"_27457":116429,"_2948":49454},[],{"_3465":70206,"_30219":70192,"_20927":116461,"_5":14373,"_27457":116429,"_2948":49457},[],{"_3465":70207,"_30219":70192,"_20927":116463,"_5":14373,"_27457":116429,"_2948":116464},[],"Hasta 1.000",{"_3465":70208,"_30219":70192,"_20927":116466,"_5":14373,"_27457":116429,"_2948":49463},[],{"_3465":70209,"_30219":70192,"_20927":116468,"_5":14373,"_27457":116429,"_2948":116469},[],"99,5 %",{"_3465":70210,"_30219":70192,"_20927":116471,"_5":14373,"_27457":116429,"_2948":49469},[],{"_3465":70211,"_30219":70192,"_20927":116473,"_5":14373,"_27457":116429,"_2948":116474},[],"Hasta 10.000",{"_3465":70212,"_30219":70192,"_20927":116476,"_5":14373,"_27457":116429,"_2948":116477},[],"Email y chat",{"_3465":70213,"_30219":70192,"_20927":116479,"_5":14373,"_27457":116429,"_2948":116480},[],"99,9 %",{"_3465":70214,"_30219":70192,"_20927":116482,"_5":14373,"_27457":116429,"_2948":49481},[],{"_3465":70215,"_30219":70192,"_20927":116484,"_5":14373,"_27457":116429,"_2948":116485},[],"Ilimitados",{"_3465":70216,"_30219":70192,"_20927":116487,"_5":14373,"_27457":116429,"_2948":116488},[],"Dedicado",{"_3465":70217,"_30219":70192,"_20927":116490,"_5":14373,"_27457":116429,"_2948":116491},[],"99,99 %",{"_3465":70218,"_30219":70192,"_20927":116493,"_5":14373,"_27457":116433,"_2948":116494},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3465":70219,"_30219":70192,"_20927":116496,"_5":14373,"_27457":116433,"_2948":116497},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3465":70220,"_30219":70220,"_5":14725,"_2948":49498,"_30551":116499,"_20927":116501,"_27457":70220},[49254,116266,116500],"Kubernetes autogestionado",[],{"_3465":70221,"_30219":70220,"_20927":116503,"_5":14373,"_27457":70220,"_2948":116504},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3465":70222,"_30219":70220,"_5":30548,"_20927":116506,"_27457":116507,"_2948":116508},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3465":70223,"_30219":70220,"_5":30548,"_20927":116510,"_27457":116511,"_2948":116512},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3465":70224,"_30219":70220,"_5":30548,"_20927":116514,"_27457":116515,"_2948":116516},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3465":70225,"_30219":70220,"_5":30548,"_20927":116518,"_27457":116519,"_2948":116520},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3465":70226,"_30219":70220,"_5":30548,"_20927":116522,"_27457":116523,"_2948":116524},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3465":70227,"_30219":70220,"_5":30548,"_20927":116526,"_27457":116527,"_2948":116528},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3465":70228,"_30219":70220,"_5":30548,"_20927":116530,"_27457":116531,"_2948":116532},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3465":70229,"_30219":70220,"_5":30548,"_20927":116534,"_27457":116535,"_2948":116536},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3465":70230,"_30219":70220,"_5":30548,"_20927":116538,"_27457":116539,"_2948":116540},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3465":70231,"_30219":70220,"_5":30548,"_20927":116542,"_27457":116543,"_2948":116544},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3465":70232,"_30219":70220,"_5":30548,"_20927":116546,"_27457":116547,"_2948":116548},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3465":70233,"_30219":70220,"_20927":116550,"_5":14373,"_27457":116507,"_2948":116551},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3465":70234,"_30219":70220,"_20927":116553,"_5":14373,"_27457":116507,"_2948":116554},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3465":70235,"_30219":70220,"_20927":116556,"_5":14373,"_27457":116511,"_2948":116557},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3465":70236,"_30219":70220,"_20927":116559,"_5":14373,"_27457":116511,"_2948":116560},[],"Fastlane instala o configura",{"_3465":70237,"_30219":70220,"_20927":116562,"_5":14373,"_27457":116511,"_2948":116563},[],"Tú sigues proporcionando",{"_3465":70238,"_30219":70220,"_20927":116565,"_5":14373,"_27457":116511,"_2948":116566},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3465":70239,"_30219":70220,"_20927":116568,"_5":14373,"_27457":116511,"_2948":116569},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3465":70240,"_30219":70220,"_20927":116571,"_5":14373,"_27457":116511,"_2948":116572},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3465":70241,"_30219":70220,"_20927":116574,"_5":14373,"_27457":116511,"_2948":116575},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3465":70242,"_30219":70220,"_20927":116577,"_5":14373,"_27457":116511,"_2948":116578},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3465":70243,"_30219":70220,"_20927":116580,"_5":14373,"_27457":116511,"_2948":116581},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3465":70244,"_30219":70220,"_20927":116583,"_5":14373,"_27457":116511,"_2948":116584},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3465":70245,"_30219":70220,"_20927":116586,"_5":14373,"_27457":116511,"_2948":116587},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3465":70246,"_30219":70220,"_20927":116589,"_5":14373,"_27457":116511,"_2948":116590},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3465":70247,"_30219":70220,"_20927":116592,"_5":14373,"_27457":116515,"_2948":116593},[],"Necesitas:",{"_3465":70248,"_30219":70220,"_20927":116595,"_5":14373,"_27457":116515,"_2948":116596},[],"un clúster Kubernetes existente",{"_3465":70249,"_30219":70220,"_20927":116598,"_5":14373,"_27457":116515,"_2948":116599},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3465":70250,"_30219":70220,"_20927":116601,"_5":14373,"_27457":116515,"_2948":49600},[],{"_3465":70251,"_30219":70220,"_20927":116603,"_5":14373,"_27457":116515,"_2948":23665},[],{"_3465":70252,"_30219":70220,"_20927":116605,"_5":14373,"_27457":116515,"_2948":116606},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3465":70253,"_30219":70220,"_20927":116608,"_5":14373,"_27457":116515,"_2948":116609},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3465":70254,"_30219":70220,"_20927":116611,"_5":14373,"_27457":116515,"_2948":116612},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3465":70255,"_30219":70220,"_20927":116614,"_5":14373,"_27457":116515,"_2948":116615},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3465":70256,"_30219":70220,"_20927":116617,"_5":14373,"_27457":116515,"_2948":116618},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3465":70257,"_30219":70220,"_20927":116620,"_5":14373,"_27457":116519,"_2948":116621},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3465":70258,"_30219":70220,"_20927":116623,"_5":14373,"_27457":116519,"_2948":116624},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3465":70259,"_30219":70220,"_20927":116626,"_5":14373,"_27457":116523,"_2948":116627},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3465":70260,"_30219":70220,"_20927":116629,"_5":14373,"_27457":116523,"_2948":116630},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3465":70261,"_30219":70220,"_20927":116632,"_5":14373,"_27457":116523,"_2948":116633},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3465":70262,"_30219":70220,"_20927":116635,"_5":14373,"_27457":116523,"_2948":116636},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3465":70263,"_30219":70220,"_20927":116638,"_5":14373,"_27457":116527,"_2948":116639},[],"Opción",{"_3465":70264,"_30219":70220,"_20927":116641,"_5":14373,"_27457":116527,"_2948":116642},[],"Valor predeterminado",{"_3465":70265,"_30219":70220,"_20927":116644,"_5":14373,"_27457":116527,"_2948":116645},[],"Propósito",{"_3465":70266,"_30219":70220,"_20927":116647,"_5":14373,"_27457":116527,"_2948":49647},[],{"_3465":70267,"_30219":70220,"_20927":116649,"_5":14373,"_27457":116527,"_2948":49650},[],{"_3465":70268,"_30219":70220,"_20927":116651,"_5":14373,"_27457":116527,"_2948":116652},[],"Muestra la ayuda",{"_3465":70269,"_30219":70220,"_20927":116654,"_5":14373,"_27457":116527,"_2948":49656},[],{"_3465":70270,"_30219":70220,"_20927":116656,"_5":14373,"_27457":116527,"_2948":116657},[],"contexto actual",{"_3465":70271,"_30219":70220,"_20927":116659,"_5":14373,"_27457":116527,"_2948":116660},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3465":70272,"_30219":70220,"_20927":116662,"_5":14373,"_27457":116527,"_2948":49665},[],{"_3465":70273,"_30219":70220,"_20927":116664,"_5":14373,"_27457":116527,"_2948":6533},[],{"_3465":70274,"_30219":70220,"_20927":116666,"_5":14373,"_27457":116527,"_2948":116667},[],"Omite prompts y genera credenciales para las dependencias",{"_3465":70275,"_30219":70220,"_20927":116669,"_5":14373,"_27457":116527,"_2948":49673},[],{"_3465":70276,"_30219":70220,"_20927":116671,"_5":14373,"_27457":116527,"_2948":49676},[],{"_3465":70277,"_30219":70220,"_20927":116673,"_5":14373,"_27457":116527,"_2948":116674},[],"Namespace de la instalación",{"_3465":70278,"_30219":70220,"_20927":116676,"_5":14373,"_27457":116527,"_2948":49682},[],{"_3465":70279,"_30219":70220,"_20927":116678,"_5":14373,"_27457":116527,"_2948":49685},[],{"_3465":70280,"_30219":70220,"_20927":116680,"_5":14373,"_27457":116527,"_2948":116681},[],"Dominio usado por la UI, OIDC y el certificado",{"_3465":70281,"_30219":70220,"_20927":116683,"_5":14373,"_27457":116527,"_2948":49691},[],{"_3465":70282,"_30219":70220,"_20927":116685,"_5":14373,"_27457":116527,"_2948":15070},[],{"_3465":70283,"_30219":70220,"_20927":116687,"_5":14373,"_27457":116527,"_2948":116688},[],"Versión del chart de Lamassu",{"_3465":70284,"_30219":70220,"_20927":116690,"_5":14373,"_27457":116527,"_2948":49699},[],{"_3465":70285,"_30219":70220,"_20927":116692,"_5":14373,"_27457":116527,"_2948":49702},[],{"_3465":70286,"_30219":70220,"_20927":116694,"_5":14373,"_27457":116527,"_2948":116695},[],"Puerto del listener HTTPS",{"_3465":70287,"_30219":70220,"_20927":116697,"_5":14373,"_27457":116527,"_2948":49708},[],{"_3465":70288,"_30219":70220,"_20927":116699,"_5":14373,"_27457":116527,"_2948":49711},[],{"_3465":70289,"_30219":70220,"_20927":116701,"_5":14373,"_27457":116527,"_2948":116702},[],"Puerto del listener HTTP",{"_3465":70290,"_30219":70220,"_20927":116704,"_5":14373,"_27457":116527,"_2948":49717},[],{"_3465":70291,"_30219":70220,"_20927":116706,"_5":14373,"_27457":116527,"_2948":49650},[],{"_3465":70292,"_30219":70220,"_20927":116708,"_5":14373,"_27457":116527,"_2948":116709},[],"Certificado PEM para TLS downstream",{"_3465":70293,"_30219":70220,"_20927":116711,"_5":14373,"_27457":116527,"_2948":49725},[],{"_3465":70294,"_30219":70220,"_20927":116713,"_5":14373,"_27457":116527,"_2948":49650},[],{"_3465":70295,"_30219":70220,"_20927":116715,"_5":14373,"_27457":116527,"_2948":116716},[],"Clave privada PEM para TLS downstream",{"_3465":70296,"_30219":70220,"_20927":116718,"_5":14373,"_27457":116527,"_2948":49733},[],{"_3465":70297,"_30219":70220,"_20927":116720,"_5":14373,"_27457":116527,"_2948":116721},[],"chart del repositorio",{"_3465":70298,"_30219":70220,"_20927":116723,"_5":14373,"_27457":116527,"_2948":116724},[],"Usa un chart local de Lamassu sin empaquetar",{"_3465":70299,"_30219":70220,"_20927":116726,"_5":14373,"_27457":116527,"_2948":49742},[],{"_3465":70300,"_30219":70220,"_20927":116728,"_5":14373,"_27457":116527,"_2948":116729},[],"detección automática",{"_3465":70301,"_30219":70220,"_20927":116731,"_5":14373,"_27457":116527,"_2948":116732},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3465":70302,"_30219":70220,"_20927":116734,"_5":14373,"_27457":116527,"_2948":49750},[],{"_3465":70303,"_30219":70220,"_20927":116736,"_5":14373,"_27457":116527,"_2948":6533},[],{"_3465":70304,"_30219":70220,"_20927":116738,"_5":14373,"_27457":116527,"_2948":116739},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3465":70305,"_30219":70220,"_20927":116741,"_5":14373,"_27457":116527,"_2948":49758},[],{"_3465":70306,"_30219":70220,"_20927":116743,"_5":14373,"_27457":116527,"_2948":6533},[],{"_3465":70307,"_30219":70220,"_20927":116745,"_5":14373,"_27457":116527,"_2948":116746},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3465":70308,"_30219":70220,"_20927":116748,"_5":14373,"_27457":116527,"_2948":49766},[],{"_3465":70309,"_30219":70220,"_20927":116750,"_5":14373,"_27457":116527,"_2948":6533},[],{"_3465":70310,"_30219":70220,"_20927":116752,"_5":14373,"_27457":116527,"_2948":116753},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3465":70311,"_30219":70220,"_20927":116755,"_5":14373,"_27457":116527,"_2948":49774},[],{"_3465":70312,"_30219":70220,"_20927":116757,"_5":14373,"_27457":116527,"_2948":6533},[],{"_3465":70313,"_30219":70220,"_20927":116759,"_5":14373,"_27457":116527,"_2948":116760},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3465":70314,"_30219":70220,"_20927":116762,"_5":14373,"_27457":116527,"_2948":49782},[],{"_3465":70315,"_30219":70220,"_20927":116764,"_5":14373,"_27457":116527,"_2948":49785},[],{"_3465":70316,"_30219":70220,"_20927":116766,"_5":14373,"_27457":116527,"_2948":116767},[],"Usa otro chart local de SoftHSM",{"_3465":70317,"_30219":70220,"_20927":116769,"_5":14373,"_27457":116527,"_2948":116770},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3465":70318,"_30219":70220,"_20927":116772,"_5":14373,"_27457":116531,"_2948":116773},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3465":70319,"_30219":70220,"_20927":116775,"_5":14373,"_27457":116531,"_2948":116776},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3465":70320,"_30219":70220,"_20927":116778,"_5":14373,"_27457":116531,"_2948":116779},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3465":70321,"_30219":70220,"_20927":116781,"_5":14373,"_27457":116531,"_2948":116782},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3465":70322,"_30219":70220,"_20927":116784,"_5":14373,"_27457":116531,"_2948":116785},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3465":70323,"_30219":70220,"_20927":116787,"_5":14373,"_27457":116531,"_2948":116788},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3465":70324,"_30219":70220,"_20927":116790,"_5":14373,"_27457":116535,"_2948":49812},[],{"_3465":70325,"_30219":70220,"_20927":116792,"_5":14373,"_27457":116535,"_2948":116793},[],"valida las herramientas locales y el clúster seleccionado",{"_3465":70326,"_30219":70220,"_20927":116795,"_5":14373,"_27457":116535,"_2948":116796},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3465":70327,"_30219":70220,"_20927":116798,"_5":14373,"_27457":116535,"_2948":116799},[],"crea el namespace",{"_3465":70328,"_30219":70220,"_20927":116801,"_5":14373,"_27457":116535,"_2948":116802},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3465":70329,"_30219":70220,"_20927":116804,"_5":14373,"_27457":116535,"_2948":116805},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3465":70330,"_30219":70220,"_20927":116807,"_5":14373,"_27457":116535,"_2948":116808},[],"instala RabbitMQ",{"_3465":70331,"_30219":70220,"_20927":116810,"_5":14373,"_27457":116535,"_2948":116811},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3465":70332,"_30219":70220,"_20927":116813,"_5":14373,"_27457":116535,"_2948":116814},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3465":70333,"_30219":70220,"_20927":116816,"_5":14373,"_27457":116535,"_2948":116817},[],"carga datos de ejemplo opcionalmente",{"_3465":70334,"_30219":70220,"_20927":116819,"_5":14373,"_27457":116535,"_2948":116820},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3465":70335,"_30219":70220,"_20927":116822,"_5":14373,"_27457":116539,"_2948":116823},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3465":70336,"_30219":70220,"_20927":116825,"_5":14373,"_27457":116539,"_2948":116826},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3465":70337,"_30219":70220,"_20927":116828,"_5":14373,"_27457":116543,"_2948":116829},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3465":70338,"_30219":70220,"_20927":116831,"_5":14373,"_27457":116543,"_2948":116832},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3465":70339,"_30219":70220,"_20927":116834,"_5":14373,"_27457":116543,"_2948":116835},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3465":70340,"_30219":70220,"_20927":116837,"_5":14373,"_27457":116547,"_2948":116838},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3465":70341,"_30219":70341,"_5":14725,"_2948":116840,"_30551":116841,"_20927":116842,"_27457":70341},"Instala con Helm",[49254,116266,116500],[],{"_3465":70342,"_30219":70341,"_20927":116844,"_5":14373,"_27457":70341,"_2948":116845},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3465":70343,"_30219":70341,"_5":30548,"_20927":116847,"_27457":116848,"_2948":116849},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3465":70344,"_30219":70341,"_5":30548,"_20927":116851,"_27457":116852,"_2948":116516},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3465":70345,"_30219":70341,"_5":30548,"_20927":116854,"_27457":116855,"_2948":116856},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3465":70346,"_30219":70341,"_5":30548,"_20927":116858,"_27457":116859,"_2948":116860},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3465":70347,"_30219":70341,"_5":30548,"_20927":116862,"_27457":116863,"_2948":116864},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3465":70348,"_30219":70341,"_5":30548,"_20927":116866,"_27457":116867,"_2948":116868},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3465":70349,"_30219":70341,"_5":30548,"_20927":116870,"_27457":116871,"_2948":116872},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3465":70350,"_30219":70341,"_5":30548,"_20927":116874,"_27457":116875,"_2948":116876},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3465":70351,"_30219":70341,"_5":30548,"_20927":116878,"_27457":116879,"_2948":116880},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3465":70352,"_30219":70341,"_5":30548,"_20927":116882,"_27457":116883,"_2948":116884},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3465":70353,"_30219":70341,"_5":30548,"_20927":116886,"_27457":116887,"_2948":116888},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3465":70354,"_30219":70341,"_20927":116890,"_5":14373,"_27457":116848,"_2948":116891},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3465":70355,"_30219":70341,"_20927":116893,"_5":14373,"_27457":116852,"_2948":116894},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3465":70356,"_30219":70341,"_20927":116896,"_5":14373,"_27457":116852,"_2948":116897},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3465":70357,"_30219":70341,"_20927":116899,"_5":14373,"_27457":116852,"_2948":116900},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3465":70358,"_30219":70341,"_20927":116902,"_5":14373,"_27457":116852,"_2948":116903},[],"un broker RabbitMQ accesible y sus credenciales",{"_3465":70359,"_30219":70341,"_20927":116905,"_5":14373,"_27457":116852,"_2948":116906},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3465":70360,"_30219":70341,"_20927":116908,"_5":14373,"_27457":116852,"_2948":116909},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3465":70361,"_30219":70341,"_20927":116911,"_5":14373,"_27457":116852,"_2948":116912},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3465":70362,"_30219":70341,"_20927":116914,"_5":14373,"_27457":116852,"_2948":116915},[],"una StorageClass y un diseño de tráfico externo",{"_3465":70363,"_30219":70341,"_20927":116917,"_5":14373,"_27457":116852,"_2948":116918},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3465":70364,"_30219":70341,"_20927":116920,"_5":14373,"_27457":116852,"_2948":116921},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3465":70365,"_30219":70341,"_20927":116923,"_5":14373,"_27457":116852,"_2948":116924},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3465":70366,"_30219":70341,"_20927":116926,"_5":14373,"_27457":116855,"_2948":116927},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3465":70367,"_30219":70341,"_20927":116929,"_5":14373,"_27457":116855,"_2948":116930},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3465":70368,"_30219":70341,"_20927":116932,"_5":14373,"_27457":116855,"_2948":116933},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3465":70369,"_30219":70341,"_20927":116935,"_5":14373,"_27457":116859,"_2948":116936},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3465":70370,"_30219":70341,"_20927":116938,"_5":14373,"_27457":116859,"_2948":116939},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3465":70371,"_30219":70341,"_20927":116941,"_5":14373,"_27457":116859,"_2948":116942},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3465":70372,"_30219":70341,"_20927":116944,"_5":14373,"_27457":116859,"_2948":116945},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3465":70373,"_30219":70341,"_20927":116947,"_5":14373,"_27457":116863,"_2948":116948},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3465":70374,"_30219":70341,"_20927":116950,"_5":14373,"_27457":116867,"_2948":116951},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3465":70375,"_30219":70341,"_20927":116953,"_5":14373,"_27457":116867,"_2948":116954},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3465":70376,"_30219":70341,"_20927":116956,"_5":14373,"_27457":116867,"_2948":116957},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3465":70377,"_30219":70341,"_20927":116959,"_5":14373,"_27457":116867,"_2948":116960},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3465":70378,"_30219":70341,"_20927":116962,"_5":14373,"_27457":116867,"_2948":116963},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3465":70379,"_30219":70341,"_20927":116965,"_5":14373,"_27457":116867,"_2948":116966},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3465":70380,"_30219":70341,"_20927":116968,"_5":14373,"_27457":116867,"_2948":116969},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3465":70381,"_30219":70341,"_20927":116971,"_5":14373,"_27457":116871,"_2948":116972},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3465":70382,"_30219":70341,"_20927":116974,"_5":14373,"_27457":116871,"_2948":116975},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3465":70383,"_30219":70341,"_20927":116977,"_5":14373,"_27457":116871,"_2948":116978},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3465":70384,"_30219":70341,"_20927":116980,"_5":14373,"_27457":116871,"_2948":116981},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3465":70385,"_30219":70341,"_20927":116983,"_5":14373,"_27457":116875,"_2948":116984},[],"Para instalar un checkout local:",{"_3465":70386,"_30219":70341,"_20927":116986,"_5":14373,"_27457":116879,"_2948":116987},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3465":70387,"_30219":70341,"_20927":116989,"_5":14373,"_27457":116879,"_2948":116990},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3465":70388,"_30219":70341,"_20927":116992,"_5":14373,"_27457":116883,"_2948":116993},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3465":70389,"_30219":70341,"_20927":116995,"_5":14373,"_27457":116883,"_2948":116996},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3465":70390,"_30219":70341,"_20927":116998,"_5":14373,"_27457":116883,"_2948":116999},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3465":70391,"_30219":70341,"_20927":117001,"_5":14373,"_27457":116883,"_2948":117002},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3465":70392,"_30219":70341,"_20927":117004,"_5":14373,"_27457":116883,"_2948":117005},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3465":70393,"_30219":70341,"_20927":117007,"_5":14373,"_27457":116887,"_2948":117008},[],"Antes de pasar a producción, revisa:",{"_3465":70394,"_30219":70341,"_20927":117010,"_5":14373,"_27457":116887,"_2948":117011},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3465":70395,"_30219":70341,"_20927":117013,"_5":14373,"_27457":116887,"_2948":117014},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3465":70396,"_30219":70341,"_20927":117016,"_5":14373,"_27457":116887,"_2948":117017},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3465":70397,"_30219":70341,"_20927":117019,"_5":14373,"_27457":116887,"_2948":117020},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3465":70398,"_30219":70341,"_20927":117022,"_5":14373,"_27457":116887,"_2948":117023},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3465":70399,"_30219":70341,"_20927":117025,"_5":14373,"_27457":116887,"_2948":117026},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3465":70400,"_30219":70341,"_20927":117028,"_5":14373,"_27457":116887,"_2948":117029},[],"SMTP, observabilidad y entrega de alertas",{"_3465":70401,"_30219":70341,"_20927":117031,"_5":14373,"_27457":116887,"_2948":117032},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3465":70402,"_30219":70341,"_20927":117034,"_5":14373,"_27457":116887,"_2948":117035},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3465":70403,"_30219":70403,"_5":14725,"_2948":117037,"_30551":117038,"_20927":117039,"_27457":70403},"Expón el Gateway",[49254,116266,116500],[],{"_3465":70404,"_30219":70403,"_20927":117041,"_5":14373,"_27457":70403,"_2948":117042},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3465":70405,"_30219":70403,"_5":30548,"_20927":117044,"_27457":117045,"_2948":117046},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3465":70406,"_30219":70403,"_5":30548,"_20927":117048,"_27457":117049,"_2948":117050},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3465":70407,"_30219":70403,"_5":30548,"_20927":117052,"_27457":117053,"_2948":117054},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3465":70408,"_30219":70403,"_5":30548,"_20927":117056,"_27457":117057,"_2948":50080},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3465":70409,"_30219":70403,"_5":30548,"_20927":117059,"_27457":117060,"_2948":117061},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3465":70410,"_30219":70403,"_5":30548,"_20927":117063,"_27457":117064,"_2948":117065},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3465":70411,"_30219":70403,"_5":30548,"_20927":117067,"_27457":117068,"_2948":117069},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3465":70412,"_30219":70403,"_5":30548,"_20927":117071,"_27457":117072,"_2948":117073},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3465":70413,"_30219":70403,"_5":30548,"_20927":117075,"_27457":117076,"_2948":117077},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3465":70414,"_30219":70403,"_5":30548,"_20927":117079,"_27457":117080,"_2948":117081},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3465":70415,"_30219":70403,"_5":30548,"_20927":117083,"_27457":117084,"_2948":117085},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3465":70416,"_30219":70403,"_20927":117087,"_5":14373,"_27457":117045,"_2948":117088},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3465":70417,"_30219":70403,"_20927":117090,"_5":14373,"_27457":117045,"_2948":117091},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3465":70418,"_30219":70403,"_20927":117093,"_5":14373,"_27457":117049,"_2948":117094},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3465":70419,"_30219":70403,"_20927":117096,"_5":14373,"_27457":117049,"_2948":117097},[],"Defínelo únicamente cuando:",{"_3465":70420,"_30219":70403,"_20927":117099,"_5":14373,"_27457":117049,"_2948":117100},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3465":70421,"_30219":70403,"_20927":117102,"_5":14373,"_27457":117049,"_2948":117103},[],"esa dirección está asignada a este Gateway",{"_3465":70422,"_30219":70403,"_20927":117105,"_5":14373,"_27457":117049,"_2948":117106},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3465":70423,"_30219":70403,"_20927":117108,"_5":14373,"_27457":117049,"_2948":117109},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3465":70424,"_30219":70403,"_20927":117111,"_5":14373,"_27457":117049,"_2948":117112},[],"No confundas estos valores:",{"_3465":70425,"_30219":70403,"_20927":117114,"_5":14373,"_27457":117049,"_2948":117115},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3465":70426,"_30219":70403,"_20927":117117,"_5":14373,"_27457":117049,"_2948":117118},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3465":70427,"_30219":70403,"_20927":117120,"_5":14373,"_27457":117049,"_2948":117121},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3465":70428,"_30219":70403,"_20927":117123,"_5":14373,"_27457":117053,"_2948":117124},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3465":70429,"_30219":70403,"_20927":117126,"_5":14373,"_27457":117053,"_2948":117127},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3465":70430,"_30219":70403,"_20927":117129,"_5":14373,"_27457":117057,"_2948":117130},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3465":70431,"_30219":70403,"_20927":117132,"_5":14373,"_27457":117057,"_2948":117133},[],"Para el diseño recomendado:",{"_3465":70432,"_30219":70403,"_20927":117135,"_5":14373,"_27457":117057,"_2948":117136},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3465":70433,"_30219":70403,"_20927":117138,"_5":14373,"_27457":117057,"_2948":117139},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3465":70434,"_30219":70403,"_20927":117141,"_5":14373,"_27457":117057,"_2948":117142},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3465":70435,"_30219":70403,"_20927":117144,"_5":14373,"_27457":117057,"_2948":117145},[],"Apunta DNS a la dirección accesible de la VM.",{"_3465":70436,"_30219":70403,"_20927":117147,"_5":14373,"_27457":117057,"_2948":117148},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3465":70437,"_30219":70403,"_20927":117150,"_5":14373,"_27457":117060,"_2948":117151},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3465":70438,"_30219":70403,"_20927":117153,"_5":14373,"_27457":117064,"_2948":117154},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3465":70439,"_30219":70403,"_20927":117156,"_5":14373,"_27457":117064,"_2948":117157},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3465":70440,"_30219":70403,"_20927":117159,"_5":14373,"_27457":117068,"_2948":117160},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3465":70441,"_30219":70403,"_20927":117162,"_5":14373,"_27457":117068,"_2948":117163},[],"Requisito",{"_3465":70442,"_30219":70403,"_20927":117165,"_5":14373,"_27457":117068,"_2948":117166},[],"Diseño recomendado",{"_3465":70443,"_30219":70403,"_20927":117168,"_5":14373,"_27457":117068,"_2948":117169},[],"Consecuencia",{"_3465":70444,"_30219":70403,"_20927":117171,"_5":14373,"_27457":117068,"_2948":117172},[],"Varias URL o servicios de Lamassu",{"_3465":70445,"_30219":70403,"_20927":117174,"_5":14373,"_27457":117068,"_2948":117175},[],"Un Gateway con varias rutas",{"_3465":70446,"_30219":70403,"_20927":117177,"_5":14373,"_27457":117068,"_2948":117178},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3465":70447,"_30219":70403,"_20927":117180,"_5":14373,"_27457":117068,"_2948":117181},[],"Gateways independientes e IP externas distintas",{"_3465":70448,"_30219":70403,"_20927":117183,"_5":14373,"_27457":117068,"_2948":117184},[],"Una VIP por Gateway",{"_3465":70449,"_30219":70403,"_20927":117186,"_5":14373,"_27457":117068,"_2948":117187},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3465":70450,"_30219":70403,"_20927":117189,"_5":14373,"_27457":117068,"_2948":117190},[],"Gateways independientes, un nodo y una IP",{"_3465":70451,"_30219":70403,"_20927":117192,"_5":14373,"_27457":117068,"_2948":117193},[],"Puertos externos diferentes",{"_3465":70452,"_30219":70403,"_20927":117195,"_5":14373,"_27457":117068,"_2948":117196},[],"Los clientes deben indicar puertos no estándar",{"_3465":70453,"_30219":70403,"_20927":117198,"_5":14373,"_27457":117068,"_2948":117199},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3465":70454,"_30219":70403,"_20927":117201,"_5":14373,"_27457":117068,"_2948":117202},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3465":70455,"_30219":70403,"_20927":117204,"_5":14373,"_27457":117068,"_2948":117205},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3465":70456,"_30219":70403,"_20927":117207,"_5":14373,"_27457":117068,"_2948":117208},[],"Recursos Gateway separados pero proxy compartido",{"_3465":70457,"_30219":70403,"_20927":117210,"_5":14373,"_27457":117068,"_2948":117211},[],"Modo merged Gateway de Envoy",{"_3465":70458,"_30219":70403,"_20927":117213,"_5":14373,"_27457":117068,"_2948":117214},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3465":70459,"_30219":70403,"_20927":117216,"_5":14373,"_27457":117068,"_2948":117217},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3465":70460,"_30219":70403,"_20927":117219,"_5":14373,"_27457":117068,"_2948":117220},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3465":70461,"_30219":70403,"_20927":117222,"_5":14373,"_27457":117068,"_2948":117223},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3465":70462,"_30219":70403,"_20927":117225,"_5":14373,"_27457":117068,"_2948":117226},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3465":70463,"_30219":70403,"_20927":117228,"_5":14373,"_27457":117072,"_2948":117229},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3465":70464,"_30219":70403,"_20927":117231,"_5":14373,"_27457":117076,"_2948":117232},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3465":70465,"_30219":70403,"_20927":117234,"_5":14373,"_27457":117076,"_2948":117235},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3465":70466,"_30219":70403,"_20927":117237,"_5":14373,"_27457":117076,"_2948":117238},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3465":70467,"_30219":70403,"_20927":117240,"_5":14373,"_27457":117076,"_2948":117241},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3465":70468,"_30219":70403,"_20927":117243,"_5":14373,"_27457":117076,"_2948":117244},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3465":70469,"_30219":70403,"_20927":117246,"_5":14373,"_27457":117080,"_2948":117247},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3465":70470,"_30219":70403,"_20927":117249,"_5":14373,"_27457":117080,"_2948":117250},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3465":70471,"_30219":70403,"_20927":117252,"_5":14373,"_27457":117084,"_2948":117253},[],"Comprueba, en orden:",{"_3465":70472,"_30219":70403,"_20927":117255,"_5":14373,"_27457":117084,"_2948":117256},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3465":70473,"_30219":70403,"_20927":117258,"_5":14373,"_27457":117084,"_2948":117259},[],"Su estado contiene la dirección esperada.",{"_3465":70474,"_30219":70403,"_20927":117261,"_5":14373,"_27457":117084,"_2948":117262},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3465":70475,"_30219":70403,"_20927":117264,"_5":14373,"_27457":117084,"_2948":117265},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3465":70476,"_30219":70403,"_20927":117267,"_5":14373,"_27457":117084,"_2948":117268},[],"DNS resuelve al endpoint accesible externamente.",{"_3465":70477,"_30219":70403,"_20927":117270,"_5":14373,"_27457":117084,"_2948":117271},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3465":70478,"_30219":70403,"_20927":117273,"_5":14373,"_27457":117084,"_2948":117274},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3465":70479,"_30219":70479,"_5":14725,"_2948":49361,"_30551":117276,"_20927":117277,"_27457":70479},[49254,116266,116500],[],{"_3465":70480,"_30219":70479,"_20927":117279,"_5":14373,"_27457":70479,"_2948":117280},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3465":70481,"_30219":70479,"_5":30548,"_20927":117282,"_27457":117283,"_2948":117284},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3465":70482,"_30219":70479,"_5":30548,"_20927":117286,"_27457":117287,"_2948":117288},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3465":70483,"_30219":70479,"_5":30548,"_20927":117290,"_27457":117291,"_2948":117292},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3465":70484,"_30219":70479,"_5":30548,"_20927":117294,"_27457":117295,"_2948":117296},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3465":70485,"_30219":70479,"_5":30548,"_20927":117298,"_27457":117299,"_2948":117300},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3465":70486,"_30219":70479,"_5":30548,"_20927":117302,"_27457":117303,"_2948":117304},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3465":70487,"_30219":70479,"_20927":117306,"_5":14373,"_27457":117283,"_2948":117307},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3465":70488,"_30219":70479,"_20927":117309,"_5":14373,"_27457":117287,"_2948":117310},[],"Flujo",{"_3465":70489,"_30219":70479,"_20927":117312,"_5":14373,"_27457":117287,"_2948":117313},[],"Úsalo para",{"_3465":70490,"_30219":70479,"_20927":117315,"_5":14373,"_27457":117287,"_2948":117316},[],"Qué instala",{"_3465":70491,"_30219":70479,"_20927":117318,"_5":14373,"_27457":117287,"_2948":50342},[],{"_3465":70492,"_30219":70479,"_20927":117320,"_5":14373,"_27457":117287,"_2948":117321},[],"Producción y entornos controlados",{"_3465":70493,"_30219":70479,"_20927":117323,"_5":14373,"_27457":117287,"_2948":117324},[],"Servicios de Lamassu y recursos de Gateway API",{"_3465":70494,"_30219":70479,"_20927":117326,"_5":14373,"_27457":117287,"_2948":49498},[],{"_3465":70495,"_30219":70479,"_20927":117328,"_5":14373,"_27457":117287,"_2948":117329},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3465":70496,"_30219":70479,"_20927":117331,"_5":14373,"_27457":117287,"_2948":117332},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3465":70497,"_30219":70479,"_20927":117334,"_5":14373,"_27457":117291,"_2948":117335},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3465":70498,"_30219":70479,"_20927":117337,"_5":14373,"_27457":117291,"_2948":117338},[],"Área",{"_3465":70499,"_30219":70479,"_20927":117340,"_5":14373,"_27457":117291,"_2948":117341},[],"El chart de Lamassu proporciona",{"_3465":70500,"_30219":70479,"_20927":117343,"_5":14373,"_27457":117291,"_2948":117344},[],"Tú proporcionas",{"_3465":70501,"_30219":70479,"_20927":117346,"_5":14373,"_27457":117291,"_2948":117347},[],"Aplicaciones Lamassu",{"_3465":70502,"_30219":70479,"_20927":117349,"_5":14373,"_27457":117291,"_2948":117350},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3465":70503,"_30219":70479,"_20927":117352,"_5":14373,"_27457":117291,"_2948":117353},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3465":70504,"_30219":70479,"_20927":117355,"_5":14373,"_27457":117291,"_2948":117356},[],"Datos PostgreSQL",{"_3465":70505,"_30219":70479,"_20927":117358,"_5":14373,"_27457":117291,"_2948":117359},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3465":70506,"_30219":70479,"_20927":117361,"_5":14373,"_27457":117291,"_2948":117362},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3465":70507,"_30219":70479,"_20927":117364,"_5":14373,"_27457":117291,"_2948":117365},[],"Mensajería",{"_3465":70508,"_30219":70479,"_20927":117367,"_5":14373,"_27457":117291,"_2948":117368},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3465":70509,"_30219":70479,"_20927":117370,"_5":14373,"_27457":117291,"_2948":117371},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3465":70510,"_30219":70479,"_20927":117373,"_5":14373,"_27457":117291,"_2948":117374},[],"Identidad",{"_3465":70511,"_30219":70479,"_20927":117376,"_5":14373,"_27457":117291,"_2948":117377},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3465":70512,"_30219":70479,"_20927":117379,"_5":14373,"_27457":117291,"_2948":117380},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3465":70513,"_30219":70479,"_20927":117382,"_5":14373,"_27457":117291,"_2948":117383},[],"Enrutamiento externo",{"_3465":70514,"_30219":70479,"_20927":117385,"_5":14373,"_27457":117291,"_2948":117386},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3465":70515,"_30219":70479,"_20927":117388,"_5":14373,"_27457":117291,"_2948":117389},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3465":70516,"_30219":70479,"_20927":117391,"_5":14373,"_27457":117291,"_2948":50416},[],{"_3465":70517,"_30219":70479,"_20927":117393,"_5":14373,"_27457":117291,"_2948":117394},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3465":70518,"_30219":70479,"_20927":117396,"_5":14373,"_27457":117291,"_2948":117397},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3465":70519,"_30219":70479,"_20927":117399,"_5":14373,"_27457":117291,"_2948":117400},[],"Datos persistentes de la aplicación",{"_3465":70520,"_30219":70479,"_20927":117402,"_5":14373,"_27457":117291,"_2948":117403},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3465":70521,"_30219":70479,"_20927":117405,"_5":14373,"_27457":117291,"_2948":117406},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3465":70522,"_30219":70479,"_20927":117408,"_5":14373,"_27457":117291,"_2948":117409},[],"Integraciones opcionales",{"_3465":70523,"_30219":70479,"_20927":117411,"_5":14373,"_27457":117291,"_2948":117412},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3465":70524,"_30219":70479,"_20927":117414,"_5":14373,"_27457":117291,"_2948":117415},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3465":70525,"_30219":70479,"_20927":117417,"_5":14373,"_27457":117291,"_2948":117418},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3465":70526,"_30219":70479,"_20927":117420,"_5":14373,"_27457":117291,"_2948":117421},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3465":70527,"_30219":70479,"_20927":117423,"_5":14373,"_27457":117295,"_2948":117424},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3465":70528,"_30219":70479,"_20927":117426,"_5":14373,"_27457":117295,"_2948":117427},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3465":70529,"_30219":70479,"_20927":117429,"_5":14373,"_27457":117299,"_2948":117430},[],"Kubernetes 1.24 o posterior",{"_3465":70530,"_30219":70479,"_20927":117432,"_5":14373,"_27457":117299,"_2948":117433},[],"Helm 3.2 o posterior",{"_3465":70531,"_30219":70479,"_20927":117435,"_5":14373,"_27457":117299,"_2948":117436},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3465":70532,"_30219":70479,"_20927":117438,"_5":14373,"_27457":117299,"_2948":117439},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3465":70533,"_30219":70479,"_20927":117441,"_5":14373,"_27457":117299,"_2948":117442},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3465":70534,"_30219":70479,"_20927":117444,"_5":14373,"_27457":117299,"_2948":117445},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3465":70535,"_30219":70479,"_20927":117447,"_5":14373,"_27457":117299,"_2948":117448},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3465":70536,"_30219":70479,"_20927":117450,"_5":14373,"_27457":117303,"_2948":117451},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":70537,"_30219":70479,"_20927":117453,"_5":14373,"_27457":117303,"_2948":117454},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3465":70538,"_30219":70479,"_20927":117456,"_5":14373,"_27457":117303,"_2948":117457},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3465":70539,"_30219":70479,"_20927":117459,"_5":14373,"_27457":117303,"_2948":117460},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3465":70540,"_30219":70540,"_5":14725,"_2948":117462,"_30551":117463,"_20927":117465,"_27457":70540},"Resolución de problemas de despliegue",[49254,116266,117464],"Operación",[],{"_3465":70541,"_30219":70540,"_20927":117467,"_5":14373,"_27457":70540,"_2948":117468},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3465":70542,"_30219":70540,"_5":30548,"_20927":117470,"_27457":117471,"_2948":117472},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3465":70543,"_30219":70540,"_5":30548,"_20927":117474,"_27457":117475,"_2948":117476},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3465":70544,"_30219":70540,"_5":30548,"_20927":117478,"_27457":117479,"_2948":117480},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3465":70545,"_30219":70540,"_5":30548,"_20927":117482,"_27457":117483,"_2948":117484},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3465":70546,"_30219":70540,"_5":30548,"_20927":117486,"_27457":117487,"_2948":117488},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3465":70547,"_30219":70540,"_5":30548,"_20927":117490,"_27457":117491,"_2948":117492},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3465":70548,"_30219":70540,"_5":30548,"_20927":117494,"_27457":117495,"_2948":117496},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3465":70549,"_30219":70540,"_5":30548,"_20927":117498,"_27457":117499,"_2948":117500},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3465":70550,"_30219":70540,"_5":30548,"_20927":117502,"_27457":117503,"_2948":117504},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3465":70551,"_30219":70540,"_5":30548,"_20927":117506,"_27457":117507,"_2948":117508},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3465":70552,"_30219":70540,"_5":30548,"_20927":117510,"_27457":117511,"_2948":117512},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3465":70553,"_30219":70540,"_5":30548,"_20927":117514,"_27457":117515,"_2948":117516},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3465":70554,"_30219":70540,"_5":30548,"_20927":117518,"_27457":117519,"_2948":117520},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3465":70555,"_30219":70540,"_20927":117522,"_5":14373,"_27457":70540,"_2948":117523},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3465":70556,"_30219":70540,"_20927":117525,"_5":14373,"_27457":117475,"_2948":117526},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3465":70557,"_30219":70540,"_20927":117528,"_5":14373,"_27457":117479,"_2948":117529},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3465":70558,"_30219":70540,"_20927":117531,"_5":14373,"_27457":117483,"_2948":117532},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3465":70559,"_30219":70540,"_20927":117534,"_5":14373,"_27457":117487,"_2948":117535},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3465":70560,"_30219":70540,"_20927":117537,"_5":14373,"_27457":117491,"_2948":117538},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3465":70561,"_30219":70540,"_20927":117540,"_5":14373,"_27457":117495,"_2948":117541},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3465":70562,"_30219":70540,"_20927":117543,"_5":14373,"_27457":117495,"_2948":117544},[],"Ejecuta también la prueba de conectividad del chart:",{"_3465":70563,"_30219":70540,"_20927":117546,"_5":14373,"_27457":117495,"_2948":117547},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3465":70564,"_30219":70540,"_20927":117549,"_5":14373,"_27457":117495,"_2948":117550},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3465":70565,"_30219":70540,"_20927":117552,"_5":14373,"_27457":117499,"_2948":117553},[],"Si recibes un 401:",{"_3465":70566,"_30219":70540,"_20927":117555,"_5":14373,"_27457":117499,"_2948":117556},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3465":70567,"_30219":70540,"_20927":117558,"_5":14373,"_27457":117499,"_2948":117559},[],"verifica emisor, audiencia y expiración del token;",{"_3465":70568,"_30219":70540,"_20927":117561,"_5":14373,"_27457":117499,"_2948":117562},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3465":70569,"_30219":70540,"_20927":117564,"_5":14373,"_27457":117499,"_2948":117565},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3465":70570,"_30219":70540,"_20927":117567,"_5":14373,"_27457":117499,"_2948":117568},[],"Si el login termina pero las APIs devuelven 403:",{"_3465":70571,"_30219":70540,"_20927":117570,"_5":14373,"_27457":117499,"_2948":117571},[],"inspecciona los claims reales del token;",{"_3465":70572,"_30219":70540,"_20927":117573,"_5":14373,"_27457":117499,"_2948":117574},[],"confirma que coinciden con un principal activo;",{"_3465":70573,"_30219":70540,"_20927":117576,"_5":14373,"_27457":117499,"_2948":117577},[],"revisa las políticas concedidas al principal;",{"_3465":70574,"_30219":70540,"_20927":117579,"_5":14373,"_27457":117499,"_2948":117580},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3465":70575,"_30219":70540,"_20927":117582,"_5":14373,"_27457":117499,"_2948":117583},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3465":70576,"_30219":70540,"_20927":117585,"_5":14373,"_27457":117503,"_2948":117586},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3465":70577,"_30219":70540,"_20927":117588,"_5":14373,"_27457":117503,"_2948":117589},[],"Localiza el pod y Service de authz.",{"_3465":70578,"_30219":70540,"_20927":117591,"_5":14373,"_27457":117503,"_2948":117592},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3465":70579,"_30219":70540,"_20927":117594,"_5":14373,"_27457":117503,"_2948":117595},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3465":70580,"_30219":70540,"_20927":117597,"_5":14373,"_27457":117503,"_2948":117598},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3465":70581,"_30219":70540,"_20927":117600,"_5":14373,"_27457":117503,"_2948":117601},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3465":70582,"_30219":70540,"_20927":117603,"_5":14373,"_27457":117507,"_2948":117604},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3465":70583,"_30219":70540,"_20927":117606,"_5":14373,"_27457":117511,"_2948":117607},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3465":70584,"_30219":70540,"_20927":117609,"_5":14373,"_27457":117511,"_2948":117610},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3465":70585,"_30219":70540,"_20927":117612,"_5":14373,"_27457":117511,"_2948":117613},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3465":70586,"_30219":70540,"_20927":117615,"_5":14373,"_27457":117511,"_2948":117616},[],"volumen persistente sin enlazar;",{"_3465":70587,"_30219":70540,"_20927":117618,"_5":14373,"_27457":117511,"_2948":117619},[],"imagen inaccesible o política de pull incorrecta;",{"_3465":70588,"_30219":70540,"_20927":117621,"_5":14373,"_27457":117511,"_2948":117622},[],"configuración inválida del motor criptográfico;",{"_3465":70589,"_30219":70540,"_20927":117624,"_5":14373,"_27457":117511,"_2948":117625},[],"límites de CPU o memoria demasiado bajos;",{"_3465":70590,"_30219":70540,"_20927":117627,"_5":14373,"_27457":117511,"_2948":117628},[],"migración previa incompleta.",{"_3465":70591,"_30219":70540,"_20927":117630,"_5":14373,"_27457":117511,"_2948":117631},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3465":70592,"_30219":70540,"_20927":117633,"_5":14373,"_27457":117511,"_2948":117634},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3465":70593,"_30219":70540,"_20927":117636,"_5":14373,"_27457":117511,"_2948":117637},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3465":70594,"_30219":70540,"_20927":117639,"_5":14373,"_27457":117515,"_2948":117640},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3465":70595,"_30219":70540,"_20927":117642,"_5":14373,"_27457":117515,"_2948":117643},[],"verifica que esté habilitado en el servicio emisor;",{"_3465":70596,"_30219":70540,"_20927":117645,"_5":14373,"_27457":117515,"_2948":117646},[],"comprueba conectividad y credenciales AMQP;",{"_3465":70597,"_30219":70540,"_20927":117648,"_5":14373,"_27457":117515,"_2948":117649},[],"revisa exchange, routing key, colas y consumidores;",{"_3465":70598,"_30219":70540,"_20927":117651,"_5":14373,"_27457":117515,"_2948":117652},[],"inspecciona dead-letter queues;",{"_3465":70599,"_30219":70540,"_20927":117654,"_5":14373,"_27457":117515,"_2948":117655},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3465":70600,"_30219":70540,"_20927":117657,"_5":14373,"_27457":117515,"_2948":117658},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3465":70601,"_30219":70540,"_20927":117660,"_5":14373,"_27457":117515,"_2948":117661},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3465":70602,"_30219":70540,"_20927":117663,"_5":14373,"_27457":117515,"_2948":117664},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3465":70603,"_30219":70540,"_20927":117666,"_5":14373,"_27457":117515,"_2948":117667},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3465":70604,"_30219":70540,"_20927":117669,"_5":14373,"_27457":117515,"_2948":117670},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3465":70605,"_30219":70540,"_20927":117672,"_5":14373,"_27457":117515,"_2948":117673},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3465":70606,"_30219":70540,"_20927":117675,"_5":14373,"_27457":117515,"_2948":117676},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3465":70607,"_30219":70540,"_20927":117678,"_5":14373,"_27457":117519,"_2948":117679},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3465":70608,"_30219":70540,"_20927":117681,"_5":14373,"_27457":117519,"_2948":117682},[],"Antes de cerrar una incidencia, guarda:",{"_3465":70609,"_30219":70540,"_20927":117684,"_5":14373,"_27457":117519,"_2948":117685},[],"causa confirmada;",{"_3465":70610,"_30219":70540,"_20927":117687,"_5":14373,"_27457":117519,"_2948":117688},[],"alcance temporal y recursos afectados;",{"_3465":70611,"_30219":70540,"_20927":117690,"_5":14373,"_27457":117519,"_2948":117691},[],"comandos o consultas utilizados;",{"_3465":70612,"_30219":70540,"_20927":117693,"_5":14373,"_27457":117519,"_2948":117694},[],"cambio aplicado y forma de revertirlo;",{"_3465":70613,"_30219":70540,"_20927":117696,"_5":14373,"_27457":117519,"_2948":117697},[],"validación desde un consumidor;",{"_3465":70614,"_30219":70540,"_20927":117699,"_5":14373,"_27457":117519,"_2948":117700},[],"acción preventiva y propietario.",{"_3465":70615,"_30219":70615,"_5":14725,"_2948":117702,"_30551":117703,"_20927":117706,"_27457":70615},"Control de acceso",[49254,117704,117705],"Plataforma","Administración",[],{"_3465":70616,"_30219":70615,"_20927":117708,"_5":14373,"_27457":70615,"_2948":117709},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3465":70617,"_30219":70615,"_5":30548,"_20927":117711,"_27457":117712,"_2948":117713},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3465":70618,"_30219":70615,"_5":30548,"_20927":117715,"_27457":117716,"_2948":117717},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3465":70619,"_30219":70615,"_5":30548,"_20927":117719,"_27457":117720,"_2948":117721},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3465":70620,"_30219":70615,"_5":30548,"_20927":117723,"_27457":117724,"_2948":117725},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3465":70621,"_30219":70615,"_5":30548,"_20927":117727,"_27457":117728,"_2948":117729},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3465":70622,"_30219":70615,"_5":30548,"_20927":117731,"_27457":117732,"_2948":117733},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3465":70623,"_30219":70615,"_5":30548,"_20927":117735,"_27457":117736,"_2948":117737},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3465":70624,"_30219":70615,"_5":30548,"_20927":117739,"_27457":117740,"_2948":117741},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3465":70625,"_30219":70615,"_5":30548,"_20927":117743,"_27457":117744,"_2948":117745},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3465":70626,"_30219":70615,"_5":30548,"_20927":117747,"_27457":117748,"_2948":117749},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3465":70627,"_30219":70615,"_5":30548,"_20927":117751,"_27457":117752,"_2948":117753},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3465":70628,"_30219":70615,"_5":30548,"_20927":117755,"_27457":117756,"_2948":117757},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3465":70629,"_30219":70615,"_5":30548,"_20927":117759,"_27457":117760,"_2948":117761},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3465":70630,"_30219":70615,"_5":30548,"_20927":117763,"_27457":117764,"_2948":117765},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3465":70631,"_30219":70615,"_5":30548,"_20927":117767,"_27457":117768,"_2948":117769},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3465":70632,"_30219":70615,"_5":30548,"_20927":117771,"_27457":117772,"_2948":116872},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3465":70633,"_30219":70615,"_5":30548,"_20927":117774,"_27457":117775,"_2948":117776},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3465":70634,"_30219":70615,"_5":30548,"_20927":117778,"_27457":117779,"_2948":117780},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3465":70635,"_30219":70615,"_5":30548,"_20927":117782,"_27457":117783,"_2948":117784},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3465":70636,"_30219":70615,"_5":30548,"_20927":117786,"_27457":117787,"_2948":117788},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3465":70637,"_30219":70615,"_5":30548,"_20927":117790,"_27457":117791,"_2948":117792},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3465":70638,"_30219":70615,"_5":30548,"_20927":117794,"_27457":117795,"_2948":117796},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3465":70639,"_30219":70615,"_5":30548,"_20927":117798,"_27457":117799,"_2948":117800},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3465":70640,"_30219":70615,"_5":30548,"_20927":117802,"_27457":117803,"_2948":117804},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3465":70641,"_30219":70615,"_5":30548,"_20927":117806,"_27457":117807,"_2948":117808},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3465":70642,"_30219":70615,"_5":30548,"_20927":117810,"_27457":117811,"_2948":117812},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3465":70643,"_30219":70615,"_5":30548,"_20927":117814,"_27457":117815,"_2948":117816},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3465":70644,"_30219":70615,"_5":30548,"_20927":117818,"_27457":117819,"_2948":117820},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3465":70645,"_30219":70615,"_5":30548,"_20927":117822,"_27457":117823,"_2948":117824},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3465":70646,"_30219":70615,"_5":30548,"_20927":117826,"_27457":117827,"_2948":117828},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3465":70647,"_30219":70615,"_5":30548,"_20927":117830,"_27457":117831,"_2948":117832},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3465":70648,"_30219":70615,"_20927":117834,"_5":14373,"_27457":70615,"_2948":117835},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3465":70649,"_30219":70615,"_20927":117837,"_5":14373,"_27457":70615,"_2948":117838},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3465":70650,"_30219":70615,"_20927":117840,"_5":14373,"_27457":70615,"_2948":117841},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3465":70651,"_30219":70615,"_20927":117843,"_5":14373,"_27457":117712,"_2948":117844},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3465":70652,"_30219":70615,"_20927":117846,"_5":14373,"_27457":117712,"_2948":117847},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3465":70653,"_30219":70615,"_20927":117849,"_5":14373,"_27457":117712,"_2948":117850},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3465":70654,"_30219":70615,"_20927":117852,"_5":14373,"_27457":117712,"_2948":117853},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3465":70655,"_30219":70615,"_20927":117855,"_5":14373,"_27457":117712,"_2948":117856},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3465":70656,"_30219":70615,"_20927":117858,"_5":14373,"_27457":117712,"_2948":117859},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3465":70657,"_30219":70615,"_20927":117861,"_5":14373,"_27457":117716,"_2948":117862},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3465":70658,"_30219":70615,"_20927":117864,"_5":14373,"_27457":117716,"_2948":117865},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3465":70659,"_30219":70615,"_20927":117867,"_5":14373,"_27457":117720,"_2948":117868},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3465":70660,"_30219":70615,"_20927":117870,"_5":14373,"_27457":117720,"_2948":117871},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3465":70661,"_30219":70615,"_20927":117873,"_5":14373,"_27457":117720,"_2948":117874},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3465":70662,"_30219":70615,"_20927":117876,"_5":14373,"_27457":117720,"_2948":117877},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3465":70663,"_30219":70615,"_20927":117879,"_5":14373,"_27457":117720,"_2948":117880},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3465":70664,"_30219":70615,"_20927":117882,"_5":14373,"_27457":117720,"_2948":117883},[],"Carga por separado las políticas concedidas a cada principal.",{"_3465":70665,"_30219":70615,"_20927":117885,"_5":14373,"_27457":117720,"_2948":117886},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3465":70666,"_30219":70615,"_20927":117888,"_5":14373,"_27457":117720,"_2948":117889},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3465":70667,"_30219":70615,"_20927":117891,"_5":14373,"_27457":117720,"_2948":117892},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3465":70668,"_30219":70615,"_20927":117894,"_5":14373,"_27457":117720,"_2948":117895},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3465":70669,"_30219":70615,"_20927":117897,"_5":14373,"_27457":117720,"_2948":117898},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3465":70670,"_30219":70615,"_20927":117900,"_5":14373,"_27457":117720,"_2948":117901},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3465":70671,"_30219":70615,"_20927":117903,"_5":14373,"_27457":117724,"_2948":117904},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3465":70672,"_30219":70615,"_20927":117906,"_5":14373,"_27457":117724,"_2948":117907},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3465":70673,"_30219":70615,"_20927":117909,"_5":14373,"_27457":117724,"_2948":117910},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3465":70674,"_30219":70615,"_20927":117912,"_5":14373,"_27457":117724,"_2948":117913},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3465":70675,"_30219":70615,"_20927":117915,"_5":14373,"_27457":117724,"_2948":117916},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3465":70676,"_30219":70615,"_20927":117918,"_5":14373,"_27457":117724,"_2948":117919},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3465":70677,"_30219":70615,"_20927":117921,"_5":14373,"_27457":117724,"_2948":117922},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3465":70678,"_30219":70615,"_20927":117924,"_5":14373,"_27457":117724,"_2948":117925},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3465":70679,"_30219":70615,"_20927":117927,"_5":14373,"_27457":117728,"_2948":117928},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3465":70680,"_30219":70615,"_20927":117930,"_5":14373,"_27457":117728,"_2948":117931},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3465":70681,"_30219":70615,"_20927":117933,"_5":14373,"_27457":117728,"_2948":117934},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3465":70682,"_30219":70615,"_20927":117936,"_5":14373,"_27457":117728,"_2948":117937},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3465":70683,"_30219":70615,"_20927":117939,"_5":14373,"_27457":117728,"_2948":117940},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3465":70684,"_30219":70615,"_20927":117942,"_5":14373,"_27457":117728,"_2948":117943},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3465":70685,"_30219":70615,"_20927":117945,"_5":14373,"_27457":117728,"_2948":117946},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3465":70686,"_30219":70615,"_20927":117948,"_5":14373,"_27457":117728,"_2948":117949},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3465":70687,"_30219":70615,"_20927":117951,"_5":14373,"_27457":117728,"_2948":117952},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3465":70688,"_30219":70615,"_20927":117954,"_5":14373,"_27457":117728,"_2948":117955},[],"Las acciones se dividen en dos grupos:",{"_3465":70689,"_30219":70615,"_20927":117957,"_5":14373,"_27457":117728,"_2948":117958},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3465":70690,"_30219":70615,"_20927":117960,"_5":14373,"_27457":117728,"_2948":117961},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3465":70691,"_30219":70615,"_20927":117963,"_5":14373,"_27457":117728,"_2948":117964},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3465":70692,"_30219":70615,"_20927":117966,"_5":14373,"_27457":117732,"_2948":117967},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3465":70693,"_30219":70615,"_20927":117969,"_5":14373,"_27457":117732,"_2948":117970},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3465":70694,"_30219":70615,"_20927":117972,"_5":14373,"_27457":117732,"_2948":117973},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3465":70695,"_30219":70615,"_20927":117975,"_5":14373,"_27457":117736,"_2948":117976},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3465":70696,"_30219":70615,"_20927":117978,"_5":14373,"_27457":117736,"_2948":117979},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3465":70697,"_30219":70615,"_20927":117981,"_5":14373,"_27457":117736,"_2948":117982},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3465":70698,"_30219":70615,"_20927":117984,"_5":14373,"_27457":117736,"_2948":117985},[],"Los operadores implementados son:",{"_3465":70699,"_30219":70615,"_20927":117987,"_5":14373,"_27457":117736,"_2948":117988},[],"`equals`, para igualdad exacta;",{"_3465":70700,"_30219":70615,"_20927":117990,"_5":14373,"_27457":117736,"_2948":117991},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3465":70701,"_30219":70615,"_20927":117993,"_5":14373,"_27457":117736,"_2948":117994},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3465":70702,"_30219":70615,"_20927":117996,"_5":14373,"_27457":117736,"_2948":117997},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3465":70703,"_30219":70615,"_20927":117999,"_5":14373,"_27457":117740,"_2948":118000},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3465":70704,"_30219":70615,"_20927":118002,"_5":14373,"_27457":117740,"_2948":118003},[],"Los modos disponibles son:",{"_3465":70705,"_30219":70615,"_20927":118005,"_5":14373,"_27457":117740,"_2948":118006},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3465":70706,"_30219":70615,"_20927":118008,"_5":14373,"_27457":117740,"_2948":118009},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3465":70707,"_30219":70615,"_20927":118011,"_5":14373,"_27457":117740,"_2948":118012},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3465":70708,"_30219":70615,"_20927":118014,"_5":14373,"_27457":117740,"_2948":118015},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3465":70709,"_30219":70615,"_20927":118017,"_5":14373,"_27457":117740,"_2948":118018},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3465":70710,"_30219":70615,"_20927":118020,"_5":14373,"_27457":117740,"_2948":118021},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3465":70711,"_30219":70615,"_20927":118023,"_5":14373,"_27457":117744,"_2948":118024},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3465":70712,"_30219":70615,"_20927":118026,"_5":14373,"_27457":117744,"_2948":118027},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3465":70713,"_30219":70615,"_20927":118029,"_5":14373,"_27457":117744,"_2948":118030},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3465":70714,"_30219":70615,"_20927":118032,"_5":14373,"_27457":117744,"_2948":118033},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3465":70715,"_30219":70615,"_20927":118035,"_5":14373,"_27457":117752,"_2948":118036},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3465":70716,"_30219":70615,"_20927":118038,"_5":14373,"_27457":117752,"_2948":118039},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3465":70717,"_30219":70615,"_20927":118041,"_5":14373,"_27457":117756,"_2948":118042},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3465":70718,"_30219":70615,"_20927":118044,"_5":14373,"_27457":117756,"_2948":118045},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3465":70719,"_30219":70615,"_20927":118047,"_5":14373,"_27457":117760,"_2948":118048},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3465":70720,"_30219":70615,"_20927":118050,"_5":14373,"_27457":117760,"_2948":118051},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3465":70721,"_30219":70615,"_20927":118053,"_5":14373,"_27457":117760,"_2948":118054},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3465":70722,"_30219":70615,"_20927":118056,"_5":14373,"_27457":117764,"_2948":118057},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3465":70723,"_30219":70615,"_20927":118059,"_5":14373,"_27457":117764,"_2948":118060},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3465":70724,"_30219":70615,"_20927":118062,"_5":14373,"_27457":117764,"_2948":118063},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3465":70725,"_30219":70615,"_20927":118065,"_5":14373,"_27457":117764,"_2948":118066},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3465":70726,"_30219":70615,"_20927":118068,"_5":14373,"_27457":117764,"_2948":118069},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3465":70727,"_30219":70615,"_20927":118071,"_5":14373,"_27457":117764,"_2948":118072},[],"Ten en cuenta que:",{"_3465":70728,"_30219":70615,"_20927":118074,"_5":14373,"_27457":117764,"_2948":118075},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3465":70729,"_30219":70615,"_20927":118077,"_5":14373,"_27457":117764,"_2948":118078},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3465":70730,"_30219":70615,"_20927":118080,"_5":14373,"_27457":117764,"_2948":118081},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3465":70731,"_30219":70615,"_20927":118083,"_5":14373,"_27457":117768,"_2948":118084},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3465":70732,"_30219":70615,"_20927":118086,"_5":14373,"_27457":117768,"_2948":118087},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3465":70733,"_30219":70615,"_20927":118089,"_5":14373,"_27457":117768,"_2948":118090},[],"acceso completo y de solo lectura a KMS;",{"_3465":70734,"_30219":70615,"_20927":118092,"_5":14373,"_27457":117768,"_2948":118093},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3465":70735,"_30219":70615,"_20927":118095,"_5":14373,"_27457":117768,"_2948":118096},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3465":70736,"_30219":70615,"_20927":118098,"_5":14373,"_27457":117768,"_2948":118099},[],"acceso a la interfaz;",{"_3465":70737,"_30219":70615,"_20927":118101,"_5":14373,"_27457":117768,"_2948":118102},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3465":70738,"_30219":70615,"_20927":118104,"_5":14373,"_27457":117768,"_2948":118105},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3465":70739,"_30219":70615,"_20927":118107,"_5":14373,"_27457":117768,"_2948":118108},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3465":70740,"_30219":70615,"_20927":118110,"_5":14373,"_27457":117772,"_2948":118111},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3465":70741,"_30219":70615,"_20927":118113,"_5":14373,"_27457":117772,"_2948":118114},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3465":70742,"_30219":70615,"_20927":118116,"_5":14373,"_27457":117772,"_2948":118117},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3465":70743,"_30219":70615,"_20927":118119,"_5":14373,"_27457":117775,"_2948":118120},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3465":70744,"_30219":70615,"_20927":118122,"_5":14373,"_27457":117779,"_2948":118123},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3465":70745,"_30219":70615,"_20927":118125,"_5":14373,"_27457":117779,"_2948":118126},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3465":70746,"_30219":70615,"_20927":118128,"_5":14373,"_27457":117783,"_2948":118129},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3465":70747,"_30219":70615,"_20927":118131,"_5":14373,"_27457":117787,"_2948":118132},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3465":70748,"_30219":70615,"_20927":118134,"_5":14373,"_27457":117791,"_2948":118135},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3465":70749,"_30219":70615,"_20927":118137,"_5":14373,"_27457":117795,"_2948":118138},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3465":70750,"_30219":70615,"_20927":118140,"_5":14373,"_27457":117795,"_2948":118141},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3465":70751,"_30219":70615,"_20927":118143,"_5":14373,"_27457":117799,"_2948":118144},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3465":70752,"_30219":70615,"_20927":118146,"_5":14373,"_27457":117799,"_2948":118147},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3465":70753,"_30219":70615,"_20927":118149,"_5":14373,"_27457":117799,"_2948":118150},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3465":70754,"_30219":70615,"_20927":118152,"_5":14373,"_27457":117799,"_2948":118153},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3465":70755,"_30219":70615,"_20927":118155,"_5":14373,"_27457":117799,"_2948":118156},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3465":70756,"_30219":70615,"_20927":118158,"_5":14373,"_27457":117799,"_2948":118159},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3465":70757,"_30219":70615,"_20927":118161,"_5":14373,"_27457":117799,"_2948":118162},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3465":70758,"_30219":70615,"_20927":118164,"_5":14373,"_27457":117799,"_2948":118165},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3465":70759,"_30219":70615,"_20927":118167,"_5":14373,"_27457":117803,"_2948":118168},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3465":70760,"_30219":70615,"_20927":118170,"_5":14373,"_27457":117803,"_2948":118171},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3465":70761,"_30219":70615,"_20927":118173,"_5":14373,"_27457":117803,"_2948":118174},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3465":70762,"_30219":70615,"_20927":118176,"_5":14373,"_27457":117807,"_2948":118177},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3465":70763,"_30219":70615,"_20927":118179,"_5":14373,"_27457":117807,"_2948":118180},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3465":70764,"_30219":70615,"_20927":118182,"_5":14373,"_27457":117807,"_2948":118183},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3465":70765,"_30219":70615,"_20927":118185,"_5":14373,"_27457":117807,"_2948":118186},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3465":70766,"_30219":70615,"_20927":118188,"_5":14373,"_27457":117807,"_2948":118189},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3465":70767,"_30219":70615,"_20927":118191,"_5":14373,"_27457":117807,"_2948":118192},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3465":70768,"_30219":70615,"_20927":118194,"_5":14373,"_27457":117807,"_2948":118195},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3465":70769,"_30219":70615,"_20927":118197,"_5":14373,"_27457":117807,"_2948":118198},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3465":70770,"_30219":70615,"_20927":118200,"_5":14373,"_27457":117815,"_2948":118201},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3465":70771,"_30219":70615,"_20927":118203,"_5":14373,"_27457":117819,"_2948":118204},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3465":70772,"_30219":70615,"_20927":118206,"_5":14373,"_27457":117819,"_2948":118207},[],"que exista un principal activo del tipo correcto;",{"_3465":70773,"_30219":70615,"_20927":118209,"_5":14373,"_27457":117819,"_2948":118210},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3465":70774,"_30219":70615,"_20927":118212,"_5":14373,"_27457":117819,"_2948":118213},[],"que todas las condiciones del principal se cumplan;",{"_3465":70775,"_30219":70615,"_20927":118215,"_5":14373,"_27457":117819,"_2948":118216},[],"que el principal tenga concedida la política esperada;",{"_3465":70776,"_30219":70615,"_20927":118218,"_5":14373,"_27457":117819,"_2948":118219},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3465":70777,"_30219":70615,"_20927":118221,"_5":14373,"_27457":117819,"_2948":118222},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3465":70778,"_30219":70615,"_20927":118224,"_5":14373,"_27457":117819,"_2948":118225},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3465":70779,"_30219":70615,"_20927":118227,"_5":14373,"_27457":117823,"_2948":118228},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3465":70780,"_30219":70615,"_20927":118230,"_5":14373,"_27457":117827,"_2948":118231},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3465":70781,"_30219":70615,"_20927":118233,"_5":14373,"_27457":117831,"_2948":118234},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3465":70782,"_30219":70615,"_20927":118236,"_5":14373,"_27457":117831,"_2948":118237},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3465":70783,"_30219":70783,"_5":14725,"_2948":118239,"_30551":118240,"_20927":118241,"_27457":70783},"Alertas y suscripciones",[49254,117704,117705],[],{"_3465":70784,"_30219":70783,"_20927":118243,"_5":14373,"_27457":70783,"_2948":118244},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3465":70785,"_30219":70783,"_5":30548,"_20927":118246,"_27457":118247,"_2948":118248},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3465":70786,"_30219":70783,"_5":30548,"_20927":118250,"_27457":118251,"_2948":118252},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3465":70787,"_30219":70783,"_5":30548,"_20927":118254,"_27457":118255,"_2948":118256},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3465":70788,"_30219":70783,"_5":30548,"_20927":118258,"_27457":118259,"_2948":118260},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3465":70789,"_30219":70783,"_5":30548,"_20927":118262,"_27457":118263,"_2948":118264},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3465":70790,"_30219":70783,"_5":30548,"_20927":118266,"_27457":118267,"_2948":118268},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3465":70791,"_30219":70783,"_5":30548,"_20927":118270,"_27457":118271,"_2948":118272},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3465":70792,"_30219":70783,"_5":30548,"_20927":118274,"_27457":118275,"_2948":118276},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3465":70793,"_30219":70783,"_5":30548,"_20927":118278,"_27457":118279,"_2948":118280},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3465":70794,"_30219":70783,"_5":30548,"_20927":118282,"_27457":118283,"_2948":118284},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3465":70795,"_30219":70783,"_5":30548,"_20927":118286,"_27457":118287,"_2948":118288},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3465":70796,"_30219":70783,"_20927":118290,"_5":14373,"_27457":70783,"_2948":118291},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3465":70797,"_30219":70783,"_20927":118293,"_5":14373,"_27457":118247,"_2948":118294},[],"Un servicio publica un evento de dominio.",{"_3465":70798,"_30219":70783,"_20927":118296,"_5":14373,"_27457":118247,"_2948":118297},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3465":70799,"_30219":70783,"_20927":118299,"_5":14373,"_27457":118247,"_2948":118300},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3465":70800,"_30219":70783,"_20927":118302,"_5":14373,"_27457":118247,"_2948":118303},[],"Lamassu entrega el evento al canal configurado.",{"_3465":70801,"_30219":70783,"_20927":118305,"_5":14373,"_27457":118247,"_2948":118306},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3465":70802,"_30219":70783,"_20927":118308,"_5":14373,"_27457":118251,"_2948":118309},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3465":70803,"_30219":70783,"_20927":118311,"_5":14373,"_27457":118251,"_2948":118312},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3465":70804,"_30219":70783,"_20927":118314,"_5":14373,"_27457":118251,"_2948":118315},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3465":70805,"_30219":70783,"_20927":118317,"_5":14373,"_27457":118251,"_2948":118318},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3465":70806,"_30219":70783,"_20927":118320,"_5":14373,"_27457":118251,"_2948":118321},[],"`apikey_options` necesita `header` y `key`.",{"_3465":70807,"_30219":70783,"_20927":118323,"_5":14373,"_27457":118251,"_2948":118324},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3465":70808,"_30219":70783,"_20927":118326,"_5":14373,"_27457":118251,"_2948":118327},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3465":70809,"_30219":70783,"_20927":118329,"_5":14373,"_27457":118251,"_2948":118330},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3465":70810,"_30219":70783,"_20927":118332,"_5":14373,"_27457":118259,"_2948":118333},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3465":70811,"_30219":70783,"_20927":118335,"_5":14373,"_27457":118263,"_2948":118336},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3465":70812,"_30219":70783,"_20927":118338,"_5":14373,"_27457":118267,"_2948":118339},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3465":70813,"_30219":70783,"_20927":118341,"_5":14373,"_27457":118267,"_2948":118342},[],"**None** notifica todas las instancias del evento.",{"_3465":70814,"_30219":70783,"_20927":118344,"_5":14373,"_27457":118267,"_2948":118345},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3465":70815,"_30219":70783,"_20927":118347,"_5":14373,"_27457":118267,"_2948":118348},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3465":70816,"_30219":70783,"_20927":118350,"_5":14373,"_27457":118267,"_2948":118351},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3465":70817,"_30219":70783,"_20927":118353,"_5":14373,"_27457":118267,"_2948":118354},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3465":70818,"_30219":70783,"_20927":118356,"_5":14373,"_27457":118267,"_2948":118357},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3465":70819,"_30219":70783,"_20927":118359,"_5":14373,"_27457":118271,"_2948":118360},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3465":70820,"_30219":70783,"_20927":118362,"_5":14373,"_27457":118275,"_2948":118363},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3465":70821,"_30219":70783,"_20927":118365,"_5":14373,"_27457":118275,"_2948":118366},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3465":70822,"_30219":70783,"_20927":118368,"_5":14373,"_27457":118275,"_2948":118369},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3465":70823,"_30219":70783,"_20927":118371,"_5":14373,"_27457":118275,"_2948":118372},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3465":70824,"_30219":70783,"_20927":118374,"_5":14373,"_27457":118275,"_2948":118375},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3465":70825,"_30219":70783,"_20927":118377,"_5":14373,"_27457":118275,"_2948":118378},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3465":70826,"_30219":70783,"_20927":118380,"_5":14373,"_27457":118275,"_2948":118381},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3465":70827,"_30219":70783,"_20927":118383,"_5":14373,"_27457":118275,"_2948":118384},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3465":70828,"_30219":70783,"_20927":118386,"_5":14373,"_27457":118279,"_2948":118387},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3465":70829,"_30219":70783,"_20927":118389,"_5":14373,"_27457":118279,"_2948":118390},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3465":70830,"_30219":70783,"_20927":118392,"_5":14373,"_27457":118279,"_2948":118393},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3465":70831,"_30219":70783,"_20927":118395,"_5":14373,"_27457":118279,"_2948":118396},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3465":70832,"_30219":70783,"_20927":118398,"_5":14373,"_27457":118279,"_2948":118399},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3465":70833,"_30219":70783,"_20927":118401,"_5":14373,"_27457":118279,"_2948":118402},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3465":70834,"_30219":70783,"_20927":118404,"_5":14373,"_27457":118279,"_2948":118405},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3465":70835,"_30219":70783,"_20927":118407,"_5":14373,"_27457":118279,"_2948":118408},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3465":70836,"_30219":70783,"_20927":118410,"_5":14373,"_27457":118283,"_2948":118411},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3465":70837,"_30219":70783,"_20927":118413,"_5":14373,"_27457":118283,"_2948":118414},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3465":70838,"_30219":70783,"_20927":118416,"_5":14373,"_27457":118287,"_2948":118417},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3465":70839,"_30219":70783,"_20927":118419,"_5":14373,"_27457":118287,"_2948":118420},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3465":70840,"_30219":70783,"_20927":118422,"_5":14373,"_27457":118287,"_2948":118423},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3465":70841,"_30219":70783,"_20927":118425,"_5":14373,"_27457":118287,"_2948":118426},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3465":70842,"_30219":70783,"_20927":118428,"_5":14373,"_27457":118287,"_2948":118429},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3465":70843,"_30219":70783,"_20927":118431,"_5":14373,"_27457":118287,"_2948":118432},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3465":70844,"_30219":70783,"_20927":118434,"_5":14373,"_27457":118287,"_2948":118435},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3465":70845,"_30219":70783,"_20927":118437,"_5":14373,"_27457":118287,"_2948":118438},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3465":70846,"_30219":70783,"_20927":118440,"_5":14373,"_27457":118287,"_2948":118441},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3465":70847,"_30219":70847,"_5":14725,"_2948":118443,"_30551":118444,"_20927":118445,"_27457":70847},"Registros de auditoría",[49254,117704,117705],[],{"_3465":70848,"_30219":70847,"_20927":118447,"_5":14373,"_27457":70847,"_2948":118448},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3465":70849,"_30219":70847,"_5":30548,"_20927":118450,"_27457":118451,"_2948":118452},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3465":70850,"_30219":70847,"_5":30548,"_20927":118454,"_27457":118455,"_2948":118456},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3465":70851,"_30219":70847,"_5":30548,"_20927":118458,"_27457":118459,"_2948":118460},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3465":70852,"_30219":70847,"_5":30548,"_20927":118462,"_27457":118463,"_2948":118464},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3465":70853,"_30219":70847,"_5":30548,"_20927":118466,"_27457":118467,"_2948":118468},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3465":70854,"_30219":70847,"_5":30548,"_20927":118470,"_27457":118471,"_2948":118472},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3465":70855,"_30219":70847,"_5":30548,"_20927":118474,"_27457":118475,"_2948":118476},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3465":70856,"_30219":70847,"_5":30548,"_20927":118478,"_27457":118479,"_2948":118480},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3465":70857,"_30219":70847,"_5":30548,"_20927":118482,"_27457":118483,"_2948":118484},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3465":70858,"_30219":70847,"_5":30548,"_20927":118486,"_27457":118487,"_2948":118488},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3465":70859,"_30219":70847,"_5":30548,"_20927":118490,"_27457":118491,"_2948":118492},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3465":70860,"_30219":70847,"_20927":118494,"_5":14373,"_27457":70847,"_2948":118495},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3465":70861,"_30219":70847,"_20927":118497,"_5":14373,"_27457":118451,"_2948":118498},[],"El cuerpo de auditoría incluye:",{"_3465":70862,"_30219":70847,"_20927":118500,"_5":14373,"_27457":118451,"_2948":118501},[],"input: datos recibidos por la operación;",{"_3465":70863,"_30219":70847,"_20927":118503,"_5":14373,"_27457":118451,"_2948":118504},[],"has\\_error: indica si el servicio devolvió un error;",{"_3465":70864,"_30219":70847,"_20927":118506,"_5":14373,"_27457":118451,"_2948":118507},[],"output: resultado producido o mensaje de error;",{"_3465":70865,"_30219":70847,"_20927":118509,"_5":14373,"_27457":118451,"_2948":118510},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3465":70866,"_30219":70847,"_20927":118512,"_5":14373,"_27457":118451,"_2948":118513},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3465":70867,"_30219":70847,"_20927":118515,"_5":14373,"_27457":118451,"_2948":118516},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3465":70868,"_30219":70847,"_20927":118518,"_5":14373,"_27457":118455,"_2948":118519},[],"El backend aplica auditoría a mutaciones de:",{"_3465":70869,"_30219":70847,"_20927":118521,"_5":14373,"_27457":118455,"_2948":118522},[],"autoridades, certificados y perfiles de emisión;",{"_3465":70870,"_30219":70847,"_20927":118524,"_5":14373,"_27457":118455,"_2948":118525},[],"claves y motores KMS;",{"_3465":70871,"_30219":70847,"_20927":118527,"_5":14373,"_27457":118455,"_2948":118528},[],"dispositivos e identidades;",{"_3465":70872,"_30219":70847,"_20927":118530,"_5":14373,"_27457":118455,"_2948":118531},[],"DMS y operaciones de enrolamiento;",{"_3465":70873,"_30219":70847,"_20927":118533,"_5":14373,"_27457":118455,"_2948":118534},[],"funciones de validación y CRL;",{"_3465":70874,"_30219":70847,"_20927":118536,"_5":14373,"_27457":118455,"_2948":118537},[],"principales, políticas y concesiones de autorización.",{"_3465":70875,"_30219":70847,"_20927":118539,"_5":14373,"_27457":118455,"_2948":118540},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3465":70876,"_30219":70847,"_20927":118542,"_5":14373,"_27457":118459,"_2948":118543},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3465":70877,"_30219":70847,"_20927":118545,"_5":14373,"_27457":118459,"_2948":118546},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3465":70878,"_30219":70847,"_20927":118548,"_5":14373,"_27457":118459,"_2948":118549},[],"Diseña el consumidor para:",{"_3465":70879,"_30219":70847,"_20927":118551,"_5":14373,"_27457":118459,"_2948":118552},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3465":70880,"_30219":70847,"_20927":118554,"_5":14373,"_27457":118459,"_2948":118555},[],"conservar el CloudEvent completo sin modificar;",{"_3465":70881,"_30219":70847,"_20927":118557,"_5":14373,"_27457":118459,"_2948":118558},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3465":70882,"_30219":70847,"_20927":118560,"_5":14373,"_27457":118459,"_2948":118561},[],"cifrar en tránsito y en reposo;",{"_3465":70883,"_30219":70847,"_20927":118563,"_5":14373,"_27457":118459,"_2948":118564},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3465":70884,"_30219":70847,"_20927":118566,"_5":14373,"_27457":118459,"_2948":118567},[],"aplicar una política explícita de retención y legal hold;",{"_3465":70885,"_30219":70847,"_20927":118569,"_5":14373,"_27457":118459,"_2948":118570},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3465":70886,"_30219":70847,"_20927":118572,"_5":14373,"_27457":118463,"_2948":118573},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3465":70887,"_30219":70847,"_20927":118575,"_5":14373,"_27457":118463,"_2948":118576},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3465":70888,"_30219":70847,"_20927":118578,"_5":14373,"_27457":118471,"_2948":118579},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3465":70889,"_30219":70847,"_20927":118581,"_5":14373,"_27457":118475,"_2948":118582},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3465":70890,"_30219":70847,"_20927":118584,"_5":14373,"_27457":118479,"_2948":118585},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3465":70891,"_30219":70847,"_20927":118587,"_5":14373,"_27457":118483,"_2948":118588},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3465":70892,"_30219":70847,"_20927":118590,"_5":14373,"_27457":118487,"_2948":118591},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3465":70893,"_30219":70847,"_20927":118593,"_5":14373,"_27457":118491,"_2948":118594},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3465":70894,"_30219":70847,"_20927":118596,"_5":14373,"_27457":118491,"_2948":118597},[],"aparece un evento de auditoría correcto;",{"_3465":70895,"_30219":70847,"_20927":118599,"_5":14373,"_27457":118491,"_2948":118600},[],"el principal coincide con la identidad utilizada;",{"_3465":70896,"_30219":70847,"_20927":118602,"_5":14373,"_27457":118491,"_2948":118603},[],"el consumidor lo persiste una sola vez;",{"_3465":70897,"_30219":70847,"_20927":118605,"_5":14373,"_27457":118491,"_2948":118606},[],"puede recuperarse por recurso, actor y periodo;",{"_3465":70898,"_30219":70847,"_20927":118608,"_5":14373,"_27457":118491,"_2948":118609},[],"una interrupción del consumidor produce una alerta.",{"_3465":70899,"_30219":70847,"_20927":118611,"_5":14373,"_27457":118491,"_2948":118612},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3465":70900,"_30219":70900,"_5":14725,"_2948":118614,"_30551":118615,"_20927":118616,"_27457":70900},"Arquitectura de la plataforma",[49254,117704],[],{"_3465":70901,"_30219":70900,"_20927":118618,"_5":14373,"_27457":70900,"_2948":118619},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3465":70902,"_30219":70900,"_5":30548,"_20927":118621,"_27457":118622,"_2948":118623},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3465":70903,"_30219":70900,"_5":30548,"_20927":118625,"_27457":118626,"_2948":118627},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3465":70904,"_30219":70900,"_5":30548,"_20927":118629,"_27457":118630,"_2948":118631},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3465":70905,"_30219":70900,"_5":30548,"_20927":118633,"_27457":118634,"_2948":118635},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3465":70906,"_30219":70900,"_5":30548,"_20927":118637,"_27457":118638,"_2948":118639},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3465":70907,"_30219":70900,"_20927":118641,"_5":14373,"_27457":70900,"_2948":118642},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3465":70908,"_30219":70900,"_20927":118644,"_5":14373,"_27457":70900,"_2948":118645},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3465":70909,"_30219":70900,"_20927":118647,"_5":14373,"_27457":118622,"_2948":118648},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3465":70910,"_30219":70900,"_20927":118650,"_5":14373,"_27457":118626,"_2948":118651},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3465":70911,"_30219":70900,"_20927":118653,"_5":14373,"_27457":118630,"_2948":118654},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3465":70912,"_30219":70900,"_20927":118656,"_5":14373,"_27457":118634,"_2948":118657},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3465":70913,"_30219":70900,"_20927":118659,"_5":14373,"_27457":118638,"_2948":118660},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3465":70914,"_30219":70914,"_5":14725,"_2948":118662,"_30551":118663,"_20927":118664,"_27457":70914},"Cómo funciona Lamassu",[49254,117704],[],{"_3465":70915,"_30219":70914,"_20927":118666,"_5":14373,"_27457":70914,"_2948":118667},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3465":70916,"_30219":70914,"_5":30548,"_20927":118669,"_27457":118670,"_2948":118671},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3465":70917,"_30219":70914,"_5":30548,"_20927":118673,"_27457":118674,"_2948":118675},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3465":70918,"_30219":70914,"_20927":118677,"_5":14373,"_27457":70914,"_2948":118678},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3465":70919,"_30219":70914,"_20927":118680,"_5":14373,"_27457":118670,"_2948":118681},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3465":70920,"_30219":70914,"_20927":118683,"_5":14373,"_27457":118670,"_2948":118684},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3465":70921,"_30219":70914,"_20927":118686,"_5":14373,"_27457":118670,"_2948":118687},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3465":70922,"_30219":70914,"_20927":118689,"_5":14373,"_27457":118670,"_2948":118690},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3465":70923,"_30219":70914,"_20927":118692,"_5":14373,"_27457":118670,"_2948":118693},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3465":70924,"_30219":70914,"_20927":118695,"_5":14373,"_27457":118674,"_2948":118696},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3465":70925,"_30219":70914,"_20927":118698,"_5":14373,"_27457":118674,"_2948":118699},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3465":70926,"_30219":70914,"_20927":118701,"_5":14373,"_27457":118674,"_2948":118702},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3465":70927,"_30219":70914,"_20927":118704,"_5":14373,"_27457":118674,"_2948":118705},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3465":70928,"_30219":70914,"_20927":118707,"_5":14373,"_27457":118674,"_2948":118708},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3465":70929,"_30219":70914,"_20927":118710,"_5":14373,"_27457":118674,"_2948":118711},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3465":70930,"_30219":70914,"_20927":118713,"_5":14373,"_27457":118674,"_2948":118714},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3465":70931,"_30219":70931,"_5":14725,"_2948":118716,"_30551":118717,"_20927":118718,"_27457":70931},"Dispositivos e identidades",[49254,117704,51743,118716],[],{"_3465":70932,"_30219":70931,"_20927":118720,"_5":14373,"_27457":70931,"_2948":118721},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3465":70933,"_30219":70931,"_5":30548,"_20927":118723,"_27457":118724,"_2948":118725},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3465":70934,"_30219":70931,"_5":30548,"_20927":118727,"_27457":118728,"_2948":118729},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3465":70935,"_30219":70931,"_5":30548,"_20927":118731,"_27457":118732,"_2948":118733},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3465":70936,"_30219":70931,"_5":30548,"_20927":118735,"_27457":118736,"_2948":118737},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3465":70937,"_30219":70931,"_5":30548,"_20927":118739,"_27457":118740,"_2948":118741},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3465":70938,"_30219":70931,"_5":30548,"_20927":118743,"_27457":118744,"_2948":118745},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3465":70939,"_30219":70931,"_5":30548,"_20927":118747,"_27457":118748,"_2948":118749},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3465":70940,"_30219":70931,"_5":30548,"_20927":118751,"_27457":118752,"_2948":118753},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3465":70941,"_30219":70931,"_5":30548,"_20927":118755,"_27457":118756,"_2948":118757},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3465":70942,"_30219":70931,"_5":30548,"_20927":118759,"_27457":118760,"_2948":118761},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3465":70943,"_30219":70931,"_5":30548,"_20927":118763,"_27457":118764,"_2948":118765},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3465":70944,"_30219":70931,"_20927":118767,"_5":14373,"_27457":70931,"_2948":118768},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3465":70945,"_30219":70931,"_20927":118770,"_5":14373,"_27457":70931,"_2948":118771},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3465":70946,"_30219":70931,"_20927":118773,"_5":14373,"_27457":118724,"_2948":118774},[],"Vista operativa",{"_3465":70947,"_30219":70931,"_20927":118776,"_5":14373,"_27457":118724,"_2948":118777},[],"Interpretación",{"_3465":70948,"_30219":70931,"_20927":118779,"_5":14373,"_27457":118724,"_2948":51806},[],{"_3465":70949,"_30219":70931,"_20927":118781,"_5":14373,"_27457":118724,"_2948":118782},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3465":70950,"_30219":70931,"_20927":118784,"_5":14373,"_27457":118724,"_2948":51812},[],{"_3465":70951,"_30219":70931,"_20927":118786,"_5":14373,"_27457":118724,"_2948":118787},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3465":70952,"_30219":70931,"_20927":118789,"_5":14373,"_27457":118724,"_2948":51818},[],{"_3465":70953,"_30219":70931,"_20927":118791,"_5":14373,"_27457":118724,"_2948":118792},[],"La identidad está en la ventana operativa de renovación.",{"_3465":70954,"_30219":70931,"_20927":118794,"_5":14373,"_27457":118724,"_2948":51824},[],{"_3465":70955,"_30219":70931,"_20927":118796,"_5":14373,"_27457":118724,"_2948":118797},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3465":70956,"_30219":70931,"_20927":118799,"_5":14373,"_27457":118724,"_2948":51830},[],{"_3465":70957,"_30219":70931,"_20927":118801,"_5":14373,"_27457":118724,"_2948":118802},[],"La identidad ha vencido.",{"_3465":70958,"_30219":70931,"_20927":118804,"_5":14373,"_27457":118724,"_2948":51836},[],{"_3465":70959,"_30219":70931,"_20927":118806,"_5":14373,"_27457":118724,"_2948":118807},[],"La identidad está marcada como revocada.",{"_3465":70960,"_30219":70931,"_20927":118809,"_5":14373,"_27457":118724,"_2948":51842},[],{"_3465":70961,"_30219":70931,"_20927":118811,"_5":14373,"_27457":118724,"_2948":118812},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3465":70962,"_30219":70931,"_20927":118814,"_5":14373,"_27457":118724,"_2948":118815},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3465":70963,"_30219":70931,"_20927":118817,"_5":14373,"_27457":118728,"_2948":118818},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3465":70964,"_30219":70931,"_20927":118820,"_5":14373,"_27457":118728,"_2948":118821},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3465":70965,"_30219":70931,"_20927":118823,"_5":14373,"_27457":118728,"_2948":118824},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3465":70966,"_30219":70931,"_20927":118826,"_5":14373,"_27457":118728,"_2948":118827},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3465":70967,"_30219":70931,"_20927":118829,"_5":14373,"_27457":118732,"_2948":118830},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3465":70968,"_30219":70931,"_20927":118832,"_5":14373,"_27457":118736,"_2948":118833},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3465":70969,"_30219":70931,"_20927":118835,"_5":14373,"_27457":118740,"_2948":118836},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3465":70970,"_30219":70931,"_20927":118838,"_5":14373,"_27457":118744,"_2948":118839},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3465":70971,"_30219":70931,"_20927":118841,"_5":14373,"_27457":118748,"_2948":118842},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3465":70972,"_30219":70931,"_20927":118844,"_5":14373,"_27457":118748,"_2948":118845},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3465":70973,"_30219":70931,"_20927":118847,"_5":14373,"_27457":118752,"_2948":118848},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3465":70974,"_30219":70931,"_20927":118850,"_5":14373,"_27457":118752,"_2948":118851},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3465":70975,"_30219":70931,"_20927":118853,"_5":14373,"_27457":118752,"_2948":118854},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3465":70976,"_30219":70931,"_20927":118856,"_5":14373,"_27457":118752,"_2948":118857},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3465":70977,"_30219":70931,"_20927":118859,"_5":14373,"_27457":118752,"_2948":118860},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3465":70978,"_30219":70931,"_20927":118862,"_5":14373,"_27457":118752,"_2948":118863},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3465":70979,"_30219":70931,"_20927":118865,"_5":14373,"_27457":118756,"_2948":118866},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3465":70980,"_30219":70931,"_20927":118868,"_5":14373,"_27457":118756,"_2948":118869},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3465":70981,"_30219":70931,"_20927":118871,"_5":14373,"_27457":118760,"_2948":118872},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3465":70982,"_30219":70931,"_20927":118874,"_5":14373,"_27457":118760,"_2948":118875},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3465":70983,"_30219":70931,"_20927":118877,"_5":14373,"_27457":118760,"_2948":118878},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3465":70984,"_30219":70931,"_20927":118880,"_5":14373,"_27457":118760,"_2948":118881},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3465":70985,"_30219":70931,"_20927":118883,"_5":14373,"_27457":118764,"_2948":118884},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":70986,"_30219":70931,"_20927":118886,"_5":14373,"_27457":118764,"_2948":118887},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":70987,"_30219":70987,"_5":14725,"_2948":118889,"_30551":118890,"_20927":118892,"_27457":70987},"Identidad inicial y autenticación",[49254,117704,51743,118716,118891],"Enrolamiento con PKI",[],{"_3465":70988,"_30219":70987,"_20927":118894,"_5":14373,"_27457":70987,"_2948":118895},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3465":70989,"_30219":70987,"_5":30548,"_20927":118897,"_27457":118898,"_2948":118899},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3465":70990,"_30219":70987,"_5":30548,"_20927":118901,"_27457":118902,"_2948":118903},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3465":70991,"_30219":70987,"_5":30548,"_20927":118905,"_27457":118906,"_2948":118907},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3465":70992,"_30219":70987,"_5":30548,"_20927":118909,"_27457":118910,"_2948":118911},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3465":70993,"_30219":70987,"_5":30548,"_20927":118913,"_27457":118914,"_2948":118915},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3465":70994,"_30219":70987,"_20927":118917,"_5":14373,"_27457":70987,"_2948":118918},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3465":70995,"_30219":70987,"_20927":118920,"_5":14373,"_27457":118898,"_2948":118921},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3465":70996,"_30219":70987,"_20927":118923,"_5":14373,"_27457":118898,"_2948":118924},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3465":70997,"_30219":70987,"_20927":118926,"_5":14373,"_27457":118902,"_2948":118927},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3465":70998,"_30219":70987,"_20927":118929,"_5":14373,"_27457":118902,"_2948":118930},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3465":70999,"_30219":70987,"_20927":118932,"_5":14373,"_27457":118902,"_2948":118933},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3465":71000,"_30219":70987,"_20927":118935,"_5":14373,"_27457":118906,"_2948":118936},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3465":71001,"_30219":70987,"_20927":118938,"_5":14373,"_27457":118906,"_2948":118939},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3465":71002,"_30219":70987,"_20927":118941,"_5":14373,"_27457":118910,"_2948":118942},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3465":71003,"_30219":70987,"_20927":118944,"_5":14373,"_27457":118910,"_2948":118945},[],"Ejemplo de cuerpo:",{"_3465":71004,"_30219":70987,"_20927":118947,"_5":14373,"_27457":118910,"_2948":118948},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3465":71005,"_30219":70987,"_20927":118950,"_5":14373,"_27457":118910,"_2948":118951},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3465":71006,"_30219":70987,"_20927":118953,"_5":14373,"_27457":118910,"_2948":118954},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3465":71007,"_30219":70987,"_20927":118956,"_5":14373,"_27457":118910,"_2948":118957},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3465":71008,"_30219":70987,"_20927":118959,"_5":14373,"_27457":118914,"_2948":118960},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3465":71009,"_30219":70987,"_20927":118962,"_5":14373,"_27457":118914,"_2948":118963},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3465":71010,"_30219":71010,"_5":14725,"_2948":118965,"_30551":118966,"_20927":118967,"_27457":71010},"Configura y opera el DMS",[49254,117704,51743,118716,118891],[],{"_3465":71011,"_30219":71010,"_20927":118969,"_5":14373,"_27457":71010,"_2948":118970},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3465":71012,"_30219":71010,"_5":30548,"_20927":118972,"_27457":118973,"_2948":116275},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3465":71013,"_30219":71010,"_5":30548,"_20927":118975,"_27457":118976,"_2948":118977},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3465":71014,"_30219":71010,"_5":30548,"_20927":118979,"_27457":118980,"_2948":118981},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3465":71015,"_30219":71010,"_5":30548,"_20927":118983,"_27457":118984,"_2948":118985},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3465":71016,"_30219":71010,"_5":30548,"_20927":118987,"_27457":118988,"_2948":118989},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3465":71017,"_30219":71010,"_5":30548,"_20927":118991,"_27457":118992,"_2948":118993},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3465":71018,"_30219":71010,"_5":30548,"_20927":118995,"_27457":118996,"_2948":118997},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3465":71019,"_30219":71010,"_5":30548,"_20927":118999,"_27457":119000,"_2948":119001},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3465":71020,"_30219":71010,"_5":30548,"_20927":119003,"_27457":119004,"_2948":52038},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3465":71021,"_30219":71010,"_5":30548,"_20927":119006,"_27457":119007,"_2948":52042},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3465":71022,"_30219":71010,"_5":30548,"_20927":119009,"_27457":119010,"_2948":119011},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3465":71023,"_30219":71010,"_5":30548,"_20927":119013,"_27457":119014,"_2948":119015},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3465":71024,"_30219":71010,"_5":30548,"_20927":119017,"_27457":119018,"_2948":119019},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3465":71025,"_30219":71010,"_5":30548,"_20927":119021,"_27457":119022,"_2948":119023},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3465":71026,"_30219":71010,"_5":30548,"_20927":119025,"_27457":119026,"_2948":52062},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3465":71027,"_30219":71010,"_5":30548,"_20927":119028,"_27457":119029,"_2948":119030},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3465":71028,"_30219":71010,"_5":30548,"_20927":119032,"_27457":119033,"_2948":119034},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3465":71029,"_30219":71010,"_5":30548,"_20927":119036,"_27457":119037,"_2948":119038},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3465":71030,"_30219":71010,"_20927":119040,"_5":14373,"_27457":71010,"_2948":119041},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3465":71031,"_30219":71010,"_20927":119043,"_5":14373,"_27457":118973,"_2948":119044},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3465":71032,"_30219":71010,"_20927":119046,"_5":14373,"_27457":118973,"_2948":119047},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3465":71033,"_30219":71010,"_20927":119049,"_5":14373,"_27457":118980,"_2948":119050},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3465":71034,"_30219":71010,"_20927":119052,"_5":14373,"_27457":118984,"_2948":119053},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3465":71035,"_30219":71010,"_20927":119055,"_5":14373,"_27457":118988,"_2948":119056},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3465":71036,"_30219":71010,"_20927":119058,"_5":14373,"_27457":118992,"_2948":119059},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3465":71037,"_30219":71010,"_20927":119061,"_5":14373,"_27457":118996,"_2948":119062},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3465":71038,"_30219":71010,"_20927":119064,"_5":14373,"_27457":119004,"_2948":119065},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3465":71039,"_30219":71010,"_20927":119067,"_5":14373,"_27457":119004,"_2948":119068},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3465":71040,"_30219":71010,"_20927":119070,"_5":14373,"_27457":119007,"_2948":119071},[],"Campo de `settings.enrollment_settings`",{"_3465":71041,"_30219":71010,"_20927":119073,"_5":14373,"_27457":119007,"_2948":119074},[],"Decisión",{"_3465":71042,"_30219":71010,"_20927":119076,"_5":14373,"_27457":119007,"_2948":52113},[],{"_3465":71043,"_30219":71010,"_20927":119078,"_5":14373,"_27457":119007,"_2948":119079},[],"`EST_RFC7030` para estas operaciones.",{"_3465":71044,"_30219":71010,"_20927":119081,"_5":14373,"_27457":119007,"_2948":52119},[],{"_3465":71045,"_30219":71010,"_20927":119083,"_5":14373,"_27457":119007,"_2948":119084},[],"ID de la CA que firmará.",{"_3465":71046,"_30219":71010,"_20927":119086,"_5":14373,"_27457":119007,"_2948":52125},[],{"_3465":71047,"_30219":71010,"_20927":119088,"_5":14373,"_27457":119007,"_2948":119089},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3465":71048,"_30219":71010,"_20927":119091,"_5":14373,"_27457":119007,"_2948":52131},[],{"_3465":71049,"_30219":71010,"_20927":119093,"_5":14373,"_27457":119007,"_2948":119094},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3465":71050,"_30219":71010,"_20927":119096,"_5":14373,"_27457":119007,"_2948":52137},[],{"_3465":71051,"_30219":71010,"_20927":119098,"_5":14373,"_27457":119007,"_2948":119099},[],"Uno de los cuatro modos de autenticación.",{"_3465":71052,"_30219":71010,"_20927":119101,"_5":14373,"_27457":119007,"_2948":119102},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3465":71053,"_30219":71010,"_20927":119104,"_5":14373,"_27457":119010,"_2948":119105},[],"Los bloques son independientes:",{"_3465":71054,"_30219":71010,"_20927":119107,"_5":14373,"_27457":119010,"_2948":119108},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3465":71055,"_30219":71010,"_20927":119110,"_5":14373,"_27457":119010,"_2948":119111},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3465":71056,"_30219":71010,"_20927":119113,"_5":14373,"_27457":119010,"_2948":52155},[],{"_3465":71057,"_30219":71010,"_20927":119115,"_5":14373,"_27457":119010,"_2948":119116},[],"Control aplicado en la operación configurada",{"_3465":71058,"_30219":71010,"_20927":119118,"_5":14373,"_27457":119010,"_2948":52161},[],{"_3465":71059,"_30219":71010,"_20927":119120,"_5":14373,"_27457":119010,"_2948":119121},[],"Validación del certificado presentado.",{"_3465":71060,"_30219":71010,"_20927":119123,"_5":14373,"_27457":119010,"_2948":52167},[],{"_3465":71061,"_30219":71010,"_20927":119125,"_5":14373,"_27457":119010,"_2948":119126},[],"Autorización del webhook configurado.",{"_3465":71062,"_30219":71010,"_20927":119128,"_5":14373,"_27457":119010,"_2948":52173},[],{"_3465":71063,"_30219":71010,"_20927":119130,"_5":14373,"_27457":119010,"_2948":119131},[],"Validación del certificado y, después, aprobación del webhook.",{"_3465":71064,"_30219":71010,"_20927":119133,"_5":14373,"_27457":119010,"_2948":52179},[],{"_3465":71065,"_30219":71010,"_20927":119135,"_5":14373,"_27457":119010,"_2948":119136},[],"Sin autenticación del solicitante por el DMS.",{"_3465":71066,"_30219":71010,"_20927":119138,"_5":14373,"_27457":119010,"_2948":119139},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3465":71067,"_30219":71010,"_20927":119141,"_5":14373,"_27457":119010,"_2948":119142},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3465":71068,"_30219":71010,"_20927":119144,"_5":14373,"_27457":119010,"_2948":119145},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3465":71069,"_30219":71010,"_20927":119147,"_5":14373,"_27457":119010,"_2948":119148},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3465":71070,"_30219":71010,"_20927":119150,"_5":14373,"_27457":119014,"_2948":119151},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3465":71071,"_30219":71010,"_20927":119153,"_5":14373,"_27457":119014,"_2948":119154},[],"Campo de `external_webhook_settings`",{"_3465":71072,"_30219":71010,"_20927":119156,"_5":14373,"_27457":119014,"_2948":119074},[],{"_3465":71073,"_30219":71010,"_20927":119158,"_5":14373,"_27457":119014,"_2948":52205},[],{"_3465":71074,"_30219":71010,"_20927":119160,"_5":14373,"_27457":119014,"_2948":119161},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3465":71075,"_30219":71010,"_20927":119163,"_5":14373,"_27457":119014,"_2948":52211},[],{"_3465":71076,"_30219":71010,"_20927":119165,"_5":14373,"_27457":119014,"_2948":119166},[],"`POST` o `PUT`; `POST` por defecto.",{"_3465":71077,"_30219":71010,"_20927":119168,"_5":14373,"_27457":119014,"_2948":52217},[],{"_3465":71078,"_30219":71010,"_20927":119170,"_5":14373,"_27457":119014,"_2948":119171},[],"Etiqueta usada en los logs del servicio.",{"_3465":71079,"_30219":71010,"_20927":119173,"_5":14373,"_27457":119014,"_2948":52223},[],{"_3465":71080,"_30219":71010,"_20927":119175,"_5":14373,"_27457":119014,"_2948":119176},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3465":71081,"_30219":71010,"_20927":119178,"_5":14373,"_27457":119014,"_2948":52229},[],{"_3465":71082,"_30219":71010,"_20927":119180,"_5":14373,"_27457":119014,"_2948":119181},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3465":71083,"_30219":71010,"_20927":119183,"_5":14373,"_27457":119014,"_2948":52235},[],{"_3465":71084,"_30219":71010,"_20927":119185,"_5":14373,"_27457":119014,"_2948":119186},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3465":71085,"_30219":71010,"_20927":119188,"_5":14373,"_27457":119014,"_2948":52241},[],{"_3465":71086,"_30219":71010,"_20927":119190,"_5":14373,"_27457":119014,"_2948":119191},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3465":71087,"_30219":71010,"_20927":119193,"_5":14373,"_27457":119014,"_2948":52247},[],{"_3465":71088,"_30219":71010,"_20927":119195,"_5":14373,"_27457":119014,"_2948":119196},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3465":71089,"_30219":71010,"_20927":119198,"_5":14373,"_27457":119014,"_2948":52253},[],{"_3465":71090,"_30219":71010,"_20927":119200,"_5":14373,"_27457":119014,"_2948":119201},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3465":71091,"_30219":71010,"_20927":119203,"_5":14373,"_27457":119014,"_2948":52259},[],{"_3465":71092,"_30219":71010,"_20927":119205,"_5":14373,"_27457":119014,"_2948":119206},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3465":71093,"_30219":71010,"_20927":119208,"_5":14373,"_27457":119014,"_2948":119209},[],"Reglas de esa configuración:",{"_3465":71094,"_30219":71010,"_20927":119211,"_5":14373,"_27457":119014,"_2948":119212},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3465":71095,"_30219":71010,"_20927":119214,"_5":14373,"_27457":119014,"_2948":119215},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3465":71096,"_30219":71010,"_20927":119217,"_5":14373,"_27457":119014,"_2948":119218},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3465":71097,"_30219":71010,"_20927":119220,"_5":14373,"_27457":119014,"_2948":119221},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3465":71098,"_30219":71010,"_20927":119223,"_5":14373,"_27457":119014,"_2948":119224},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3465":71099,"_30219":71010,"_20927":119226,"_5":14373,"_27457":119014,"_2948":119227},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3465":71100,"_30219":71010,"_20927":119229,"_5":14373,"_27457":119014,"_2948":119230},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3465":71101,"_30219":71010,"_20927":119232,"_5":14373,"_27457":119014,"_2948":119233},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3465":71102,"_30219":71010,"_20927":119235,"_5":14373,"_27457":119014,"_2948":119236},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3465":71103,"_30219":71010,"_20927":119238,"_5":14373,"_27457":119018,"_2948":119239},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3465":71104,"_30219":71010,"_20927":119241,"_5":14373,"_27457":119022,"_2948":119242},[],"Campo de `settings.reenrollment_settings`",{"_3465":71105,"_30219":71010,"_20927":119244,"_5":14373,"_27457":119022,"_2948":119245},[],"Función",{"_3465":71106,"_30219":71010,"_20927":119247,"_5":14373,"_27457":119022,"_2948":52303},[],{"_3465":71107,"_30219":71010,"_20927":119249,"_5":14373,"_27457":119022,"_2948":119250},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3465":71108,"_30219":71010,"_20927":119252,"_5":14373,"_27457":119022,"_2948":52309},[],{"_3465":71109,"_30219":71010,"_20927":119254,"_5":14373,"_27457":119022,"_2948":119255},[],"Umbral operativo preventivo de monitorización.",{"_3465":71110,"_30219":71010,"_20927":119257,"_5":14373,"_27457":119022,"_2948":52315},[],{"_3465":71111,"_30219":71010,"_20927":119259,"_5":14373,"_27457":119022,"_2948":119260},[],"Umbral operativo crítico de monitorización.",{"_3465":71112,"_30219":71010,"_20927":119262,"_5":14373,"_27457":119022,"_2948":52321},[],{"_3465":71113,"_30219":71010,"_20927":119264,"_5":14373,"_27457":119022,"_2948":119265},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3465":71114,"_30219":71010,"_20927":119267,"_5":14373,"_27457":119022,"_2948":52327},[],{"_3465":71115,"_30219":71010,"_20927":119269,"_5":14373,"_27457":119022,"_2948":119270},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3465":71116,"_30219":71010,"_20927":119272,"_5":14373,"_27457":119022,"_2948":52333},[],{"_3465":71117,"_30219":71010,"_20927":119274,"_5":14373,"_27457":119022,"_2948":119275},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3465":71118,"_30219":71010,"_20927":119277,"_5":14373,"_27457":119022,"_2948":119278},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3465":71119,"_30219":71010,"_20927":119280,"_5":14373,"_27457":119026,"_2948":119281},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3465":71120,"_30219":71010,"_20927":119283,"_5":14373,"_27457":119029,"_2948":116639},[],{"_3465":71121,"_30219":71010,"_20927":119285,"_5":14373,"_27457":119029,"_2948":119286},[],"Qué publica",{"_3465":71122,"_30219":71010,"_20927":119288,"_5":14373,"_27457":119029,"_2948":52350},[],{"_3465":71123,"_30219":71010,"_20927":119290,"_5":14373,"_27457":119029,"_2948":119291},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3465":71124,"_30219":71010,"_20927":119293,"_5":14373,"_27457":119029,"_2948":52356},[],{"_3465":71125,"_30219":71010,"_20927":119295,"_5":14373,"_27457":119029,"_2948":119296},[],"Certificado de la CA emisora seleccionada.",{"_3465":71126,"_30219":71010,"_20927":119298,"_5":14373,"_27457":119029,"_2948":52362},[],{"_3465":71127,"_30219":71010,"_20927":119300,"_5":14373,"_27457":119029,"_2948":119301},[],"Certificados de las CAs elegidas explícitamente.",{"_3465":71128,"_30219":71010,"_20927":119303,"_5":14373,"_27457":119029,"_2948":119304},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3465":71129,"_30219":71010,"_20927":119306,"_5":14373,"_27457":119033,"_2948":119307},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3465":71130,"_30219":71010,"_20927":119309,"_5":14373,"_27457":119033,"_2948":119310},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3465":71131,"_30219":71010,"_20927":119312,"_5":14373,"_27457":119033,"_2948":119313},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3465":71132,"_30219":71010,"_20927":119315,"_5":14373,"_27457":119037,"_2948":119316},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3465":71133,"_30219":71133,"_5":14725,"_2948":119318,"_30551":119319,"_20927":119320,"_27457":71133},"Integra el cliente EST",[49254,117704,51743,118716,118891],[],{"_3465":71134,"_30219":71133,"_20927":119322,"_5":14373,"_27457":71133,"_2948":119323},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3465":71135,"_30219":71133,"_5":30548,"_20927":119325,"_27457":119326,"_2948":116275},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3465":71136,"_30219":71133,"_5":30548,"_20927":119328,"_27457":119329,"_2948":119330},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3465":71137,"_30219":71133,"_5":30548,"_20927":119332,"_27457":119333,"_2948":119334},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3465":71138,"_30219":71133,"_5":30548,"_20927":119336,"_27457":119337,"_2948":119338},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3465":71139,"_30219":71133,"_5":30548,"_20927":119340,"_27457":119341,"_2948":119342},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3465":71140,"_30219":71133,"_5":30548,"_20927":119344,"_27457":119345,"_2948":119346},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3465":71141,"_30219":71133,"_20927":119348,"_5":14373,"_27457":71133,"_2948":119349},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3465":71142,"_30219":71133,"_20927":119351,"_5":14373,"_27457":119326,"_2948":119352},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3465":71143,"_30219":71133,"_20927":119354,"_5":14373,"_27457":119326,"_2948":119355},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3465":71144,"_30219":71133,"_20927":119357,"_5":14373,"_27457":119326,"_2948":119358},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3465":71145,"_30219":71133,"_20927":119360,"_5":14373,"_27457":119329,"_2948":119361},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3465":71146,"_30219":71133,"_20927":119363,"_5":14373,"_27457":119329,"_2948":119364},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3465":71147,"_30219":71133,"_20927":119366,"_5":14373,"_27457":119333,"_2948":119367},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3465":71148,"_30219":71133,"_20927":119369,"_5":14373,"_27457":119333,"_2948":119370},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3465":71149,"_30219":71133,"_20927":119372,"_5":14373,"_27457":119337,"_2948":119373},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3465":71150,"_30219":71133,"_20927":119375,"_5":14373,"_27457":119337,"_2948":119376},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3465":71151,"_30219":71133,"_20927":119378,"_5":14373,"_27457":119341,"_2948":119379},[],"Para el caso de una raíz que emite directamente:",{"_3465":71152,"_30219":71133,"_20927":119381,"_5":14373,"_27457":119341,"_2948":119382},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3465":71153,"_30219":71133,"_20927":119384,"_5":14373,"_27457":119341,"_2948":119385},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3465":71154,"_30219":71133,"_20927":119387,"_5":14373,"_27457":119345,"_2948":119388},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3465":71155,"_30219":71155,"_5":14725,"_2948":119390,"_30551":119391,"_20927":119392,"_27457":71155},"Referencia EST",[49254,117704,51743,118716,118891],[],{"_3465":71156,"_30219":71155,"_20927":119394,"_5":14373,"_27457":71155,"_2948":119395},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3465":71157,"_30219":71155,"_5":30548,"_20927":119397,"_27457":119398,"_2948":119399},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3465":71158,"_30219":71155,"_5":30548,"_20927":119401,"_27457":119402,"_2948":22683},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3465":71159,"_30219":71155,"_5":30548,"_20927":119404,"_27457":119405,"_2948":26060},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3465":71160,"_30219":71155,"_5":30548,"_20927":119407,"_27457":119408,"_2948":26067},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3465":71161,"_30219":71155,"_5":30548,"_20927":119410,"_27457":119411,"_2948":25386},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3465":71162,"_30219":71155,"_5":30548,"_20927":119413,"_27457":119414,"_2948":119415},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3465":71163,"_30219":71155,"_5":30548,"_20927":119417,"_27457":119418,"_2948":119419},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3465":71164,"_30219":71155,"_5":30548,"_20927":119421,"_27457":119422,"_2948":119423},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3465":71165,"_30219":71155,"_20927":119425,"_5":14373,"_27457":71155,"_2948":119426},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3465":71166,"_30219":71155,"_20927":119428,"_5":14373,"_27457":119398,"_2948":119429},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3465":71167,"_30219":71155,"_20927":119431,"_5":14373,"_27457":119398,"_2948":117464},[],{"_3465":71168,"_30219":71155,"_20927":119433,"_5":14373,"_27457":119398,"_2948":119434},[],"Método",{"_3465":71169,"_30219":71155,"_20927":119436,"_5":14373,"_27457":119398,"_2948":119437},[],"Autenticación y condición",{"_3465":71170,"_30219":71155,"_20927":119439,"_5":14373,"_27457":119398,"_2948":52505},[],{"_3465":71171,"_30219":71155,"_20927":119441,"_5":14373,"_27457":119398,"_2948":52508},[],{"_3465":71172,"_30219":71155,"_20927":119443,"_5":14373,"_27457":119398,"_2948":119444},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3465":71173,"_30219":71155,"_20927":119446,"_5":14373,"_27457":119398,"_2948":52514},[],{"_3465":71174,"_30219":71155,"_20927":119448,"_5":14373,"_27457":119398,"_2948":52517},[],{"_3465":71175,"_30219":71155,"_20927":119450,"_5":14373,"_27457":119398,"_2948":119451},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3465":71176,"_30219":71155,"_20927":119453,"_5":14373,"_27457":119398,"_2948":52523},[],{"_3465":71177,"_30219":71155,"_20927":119455,"_5":14373,"_27457":119398,"_2948":52517},[],{"_3465":71178,"_30219":71155,"_20927":119457,"_5":14373,"_27457":119398,"_2948":119458},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3465":71179,"_30219":71155,"_20927":119460,"_5":14373,"_27457":119398,"_2948":52531},[],{"_3465":71180,"_30219":71155,"_20927":119462,"_5":14373,"_27457":119398,"_2948":52517},[],{"_3465":71181,"_30219":71155,"_20927":119464,"_5":14373,"_27457":119398,"_2948":119465},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3465":71182,"_30219":71155,"_20927":119467,"_5":14373,"_27457":119398,"_2948":119468},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3465":71183,"_30219":71155,"_20927":119470,"_5":14373,"_27457":119402,"_2948":119471},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3465":71184,"_30219":71155,"_20927":119473,"_5":14373,"_27457":119402,"_2948":119474},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3465":71185,"_30219":71155,"_20927":119476,"_5":14373,"_27457":119405,"_2948":119477},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3465":71186,"_30219":71155,"_20927":119479,"_5":14373,"_27457":119405,"_2948":119480},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3465":71187,"_30219":71155,"_20927":119482,"_5":14373,"_27457":119408,"_2948":119483},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3465":71188,"_30219":71155,"_20927":119485,"_5":14373,"_27457":119408,"_2948":119486},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3465":71189,"_30219":71155,"_20927":119488,"_5":14373,"_27457":119411,"_2948":119489},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3465":71190,"_30219":71155,"_20927":119491,"_5":14373,"_27457":119411,"_2948":119492},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3465":71191,"_30219":71155,"_20927":119494,"_5":14373,"_27457":119414,"_2948":119495},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3465":71192,"_30219":71155,"_20927":119497,"_5":14373,"_27457":119414,"_2948":119498},[],"Parte",{"_3465":71193,"_30219":71155,"_20927":119500,"_5":14373,"_27457":119414,"_2948":119501},[],"Contenido tras decodificar su Base64",{"_3465":71194,"_30219":71155,"_20927":119503,"_5":14373,"_27457":119414,"_2948":52575},[],{"_3465":71195,"_30219":71155,"_20927":119505,"_5":14373,"_27457":119414,"_2948":119506},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3465":71196,"_30219":71155,"_20927":119508,"_5":14373,"_27457":119414,"_2948":52581},[],{"_3465":71197,"_30219":71155,"_20927":119510,"_5":14373,"_27457":119414,"_2948":119511},[],"PKCS#7 DER con el certificado emitido.",{"_3465":71198,"_30219":71155,"_20927":119513,"_5":14373,"_27457":119414,"_2948":119514},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3465":71199,"_30219":71155,"_20927":119516,"_5":14373,"_27457":119418,"_2948":119517},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3465":71200,"_30219":71155,"_20927":119519,"_5":14373,"_27457":119418,"_2948":119520},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3465":71201,"_30219":71155,"_20927":119522,"_5":14373,"_27457":119418,"_2948":119523},[],"Convierte y comprueba el resultado:",{"_3465":71202,"_30219":71155,"_20927":119525,"_5":14373,"_27457":119418,"_2948":119526},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3465":71203,"_30219":71155,"_20927":119528,"_5":14373,"_27457":119422,"_2948":119529},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3465":71204,"_30219":71155,"_20927":119531,"_5":14373,"_27457":119422,"_2948":119532},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3465":71205,"_30219":71205,"_5":14725,"_2948":118891,"_30551":119534,"_20927":119535,"_27457":71205},[49254,117704,51743,118716,118891],[],{"_3465":71206,"_30219":71205,"_20927":119537,"_5":14373,"_27457":71205,"_2948":119538},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3465":71207,"_30219":71205,"_5":30548,"_20927":119540,"_27457":119541,"_2948":119542},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3465":71208,"_30219":71205,"_5":30548,"_20927":119544,"_27457":119545,"_2948":119546},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3465":71209,"_30219":71205,"_5":30548,"_20927":119548,"_27457":119549,"_2948":119550},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3465":71210,"_30219":71205,"_5":30548,"_20927":119552,"_27457":119553,"_2948":119554},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3465":71211,"_30219":71205,"_20927":119556,"_5":14373,"_27457":71205,"_2948":119557},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3465":71212,"_30219":71205,"_20927":119559,"_5":14373,"_27457":119541,"_2948":119560},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3465":71213,"_30219":71205,"_20927":119562,"_5":14373,"_27457":119541,"_2948":119563},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3465":71214,"_30219":71205,"_20927":119565,"_5":14373,"_27457":119541,"_2948":119566},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3465":71215,"_30219":71205,"_20927":119568,"_5":14373,"_27457":119541,"_2948":119569},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3465":71216,"_30219":71205,"_20927":119571,"_5":14373,"_27457":119541,"_2948":119572},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3465":71217,"_30219":71205,"_20927":119574,"_5":14373,"_27457":119541,"_2948":119575},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3465":71218,"_30219":71205,"_20927":119577,"_5":14373,"_27457":119545,"_2948":119578},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3465":71219,"_30219":71205,"_20927":119580,"_5":14373,"_27457":119545,"_2948":119581},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71220,"_30219":71205,"_20927":119583,"_5":14373,"_27457":119545,"_2948":119584},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3465":71221,"_30219":71205,"_20927":119586,"_5":14373,"_27457":119545,"_2948":119587},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3465":71222,"_30219":71205,"_20927":119589,"_5":14373,"_27457":119549,"_2948":119590},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":71223,"_30219":71205,"_20927":119592,"_5":14373,"_27457":119549,"_2948":119593},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":71224,"_30219":71205,"_20927":119595,"_5":14373,"_27457":119549,"_2948":119596},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3465":71225,"_30219":71205,"_20927":119598,"_5":14373,"_27457":119549,"_2948":119599},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3465":71226,"_30219":71205,"_20927":119601,"_5":14373,"_27457":119553,"_2948":119602},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3465":71227,"_30219":71205,"_20927":119604,"_5":14373,"_27457":119553,"_2948":119605},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3465":71228,"_30219":71228,"_5":14725,"_2948":119607,"_30551":119608,"_20927":119609,"_27457":71228},"Estrategias de aprovisionamiento",[49254,117704,51743,118716,118891],[],{"_3465":71229,"_30219":71228,"_20927":119611,"_5":14373,"_27457":71228,"_2948":119612},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3465":71230,"_30219":71228,"_5":30548,"_20927":119614,"_27457":119615,"_2948":119616},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3465":71231,"_30219":71228,"_5":30548,"_20927":119618,"_27457":119619,"_2948":119620},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3465":71232,"_30219":71228,"_5":30548,"_20927":119622,"_27457":119623,"_2948":119624},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3465":71233,"_30219":71228,"_5":30548,"_20927":119626,"_27457":119627,"_2948":119628},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3465":71234,"_30219":71228,"_5":30548,"_20927":119630,"_27457":119631,"_2948":119632},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3465":71235,"_30219":71228,"_20927":119634,"_5":14373,"_27457":71228,"_2948":119635},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3465":71236,"_30219":71228,"_20927":119637,"_5":14373,"_27457":119615,"_2948":119638},[],"Recorrido",{"_3465":71237,"_30219":71228,"_20927":119640,"_5":14373,"_27457":119615,"_2948":119641},[],"Cuándo existe el dispositivo",{"_3465":71238,"_30219":71228,"_20927":119643,"_5":14373,"_27457":119615,"_2948":119644},[],"Qué compruebas",{"_3465":71239,"_30219":71228,"_20927":119646,"_5":14373,"_27457":119615,"_2948":119647},[],"Asignación manual",{"_3465":71240,"_30219":71228,"_20927":119649,"_5":14373,"_27457":119615,"_2948":119650},[],"El operador lo crea antes de asociar un certificado.",{"_3465":71241,"_30219":71228,"_20927":119652,"_5":14373,"_27457":119615,"_2948":119653},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3465":71242,"_30219":71228,"_20927":119655,"_5":14373,"_27457":119615,"_2948":119656},[],"EST con `JITP`",{"_3465":71243,"_30219":71228,"_20927":119658,"_5":14373,"_27457":119615,"_2948":119659},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3465":71244,"_30219":71228,"_20927":119661,"_5":14373,"_27457":119615,"_2948":119662},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3465":71245,"_30219":71228,"_20927":119664,"_5":14373,"_27457":119615,"_2948":119665},[],"EST con `PRE_REGISTRATION`",{"_3465":71246,"_30219":71228,"_20927":119667,"_5":14373,"_27457":119615,"_2948":119668},[],"Debe existir antes de `/simpleenroll`.",{"_3465":71247,"_30219":71228,"_20927":119670,"_5":14373,"_27457":119615,"_2948":119671},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3465":71248,"_30219":71228,"_20927":119673,"_5":14373,"_27457":119615,"_2948":119674},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3465":71249,"_30219":71228,"_20927":119676,"_5":14373,"_27457":119615,"_2948":119677},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3465":71250,"_30219":71228,"_20927":119679,"_5":14373,"_27457":119619,"_2948":119680},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3465":71251,"_30219":71228,"_20927":119682,"_5":14373,"_27457":119619,"_2948":119683},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3465":71252,"_30219":71228,"_20927":119685,"_5":14373,"_27457":119619,"_2948":119686},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3465":71253,"_30219":71228,"_20927":119688,"_5":14373,"_27457":119623,"_2948":119689},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3465":71254,"_30219":71228,"_20927":119691,"_5":14373,"_27457":119623,"_2948":119692},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3465":71255,"_30219":71228,"_20927":119694,"_5":14373,"_27457":119623,"_2948":119695},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3465":71256,"_30219":71228,"_20927":119697,"_5":14373,"_27457":119623,"_2948":119698},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3465":71257,"_30219":71228,"_20927":119700,"_5":14373,"_27457":119623,"_2948":119701},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3465":71258,"_30219":71228,"_20927":119703,"_5":14373,"_27457":119623,"_2948":119704},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3465":71259,"_30219":71228,"_20927":119706,"_5":14373,"_27457":119627,"_2948":116639},[],{"_3465":71260,"_30219":71228,"_20927":119708,"_5":14373,"_27457":119627,"_2948":119709},[],"Material que atraviesa EST",{"_3465":71261,"_30219":71228,"_20927":119711,"_5":14373,"_27457":119627,"_2948":119712},[],"Clave generada por el dispositivo",{"_3465":71262,"_30219":71228,"_20927":119714,"_5":14373,"_27457":119627,"_2948":119715},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3465":71263,"_30219":71228,"_20927":119717,"_5":14373,"_27457":119627,"_2948":119718},[],"Clave ya disponible en el dispositivo",{"_3465":71264,"_30219":71228,"_20927":119720,"_5":14373,"_27457":119627,"_2948":119721},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3465":71265,"_30219":71228,"_20927":119723,"_5":14373,"_27457":119627,"_2948":52062},[],{"_3465":71266,"_30219":71228,"_20927":119725,"_5":14373,"_27457":119627,"_2948":119726},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3465":71267,"_30219":71228,"_20927":119728,"_5":14373,"_27457":119627,"_2948":119729},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3465":71268,"_30219":71228,"_20927":119731,"_5":14373,"_27457":119631,"_2948":119732},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3465":71269,"_30219":71269,"_5":14725,"_2948":119734,"_30551":119735,"_20927":119736,"_27457":71269},"Renovación y recuperación",[49254,117704,51743,118716,118891],[],{"_3465":71270,"_30219":71269,"_20927":119738,"_5":14373,"_27457":71269,"_2948":119739},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3465":71271,"_30219":71269,"_5":30548,"_20927":119741,"_27457":119742,"_2948":119743},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3465":71272,"_30219":71269,"_5":30548,"_20927":119745,"_27457":119746,"_2948":119747},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3465":71273,"_30219":71269,"_5":30548,"_20927":119749,"_27457":119750,"_2948":119751},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3465":71274,"_30219":71269,"_5":30548,"_20927":119753,"_27457":119754,"_2948":119755},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3465":71275,"_30219":71269,"_5":30548,"_20927":119757,"_27457":119758,"_2948":119759},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3465":71276,"_30219":71269,"_20927":119761,"_5":14373,"_27457":71269,"_2948":119762},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3465":71277,"_30219":71269,"_20927":119764,"_5":14373,"_27457":119742,"_2948":119765},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3465":71278,"_30219":71269,"_20927":119767,"_5":14373,"_27457":119742,"_2948":119768},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3465":71279,"_30219":71269,"_20927":119770,"_5":14373,"_27457":119742,"_2948":119771},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3465":71280,"_30219":71269,"_20927":119773,"_5":14373,"_27457":119742,"_2948":119774},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3465":71281,"_30219":71269,"_20927":119776,"_5":14373,"_27457":119746,"_2948":119777},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3465":71282,"_30219":71269,"_20927":119779,"_5":14373,"_27457":119746,"_2948":119780},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3465":71283,"_30219":71269,"_20927":119782,"_5":14373,"_27457":119750,"_2948":119783},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3465":71284,"_30219":71269,"_20927":119785,"_5":14373,"_27457":119750,"_2948":119786},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3465":71285,"_30219":71269,"_20927":119788,"_5":14373,"_27457":119750,"_2948":119789},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3465":71286,"_30219":71269,"_20927":119791,"_5":14373,"_27457":119754,"_2948":119792},[],"Situación",{"_3465":71287,"_30219":71269,"_20927":119794,"_5":14373,"_27457":119754,"_2948":119795},[],"Procedimiento",{"_3465":71288,"_30219":71269,"_20927":119797,"_5":14373,"_27457":119754,"_2948":119798},[],"Certificado vigente, fuera de ventana",{"_3465":71289,"_30219":71269,"_20927":119800,"_5":14373,"_27457":119754,"_2948":119801},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3465":71290,"_30219":71269,"_20927":119803,"_5":14373,"_27457":119754,"_2948":119804},[],"Certificado vencido, clave disponible",{"_3465":71291,"_30219":71269,"_20927":119806,"_5":14373,"_27457":119754,"_2948":119807},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3465":71292,"_30219":71269,"_20927":119809,"_5":14373,"_27457":119754,"_2948":119810},[],"Renovación por webhook o `NO_AUTH`",{"_3465":71293,"_30219":71269,"_20927":119812,"_5":14373,"_27457":119754,"_2948":119813},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3465":71294,"_30219":71269,"_20927":119815,"_5":14373,"_27457":119754,"_2948":119816},[],"Clave perdida o inaccesible",{"_3465":71295,"_30219":71269,"_20927":119818,"_5":14373,"_27457":119754,"_2948":119819},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3465":71296,"_30219":71269,"_20927":119821,"_5":14373,"_27457":119754,"_2948":119822},[],"Identidad actual revocada",{"_3465":71297,"_30219":71269,"_20927":119824,"_5":14373,"_27457":119754,"_2948":119825},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3465":71298,"_30219":71269,"_20927":119827,"_5":14373,"_27457":119754,"_2948":119828},[],"Dispositivo sin identidad",{"_3465":71299,"_30219":71269,"_20927":119830,"_5":14373,"_27457":119754,"_2948":119831},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3465":71300,"_30219":71269,"_20927":119833,"_5":14373,"_27457":119754,"_2948":119834},[],"Dispositivo retirado",{"_3465":71301,"_30219":71269,"_20927":119836,"_5":14373,"_27457":119754,"_2948":119837},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3465":71302,"_30219":71269,"_20927":119839,"_5":14373,"_27457":119754,"_2948":119840},[],"Timeout, HTTP 500 o fallo de instalación",{"_3465":71303,"_30219":71269,"_20927":119842,"_5":14373,"_27457":119754,"_2948":119843},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3465":71304,"_30219":71269,"_20927":119845,"_5":14373,"_27457":119758,"_2948":119846},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3465":71305,"_30219":71269,"_20927":119848,"_5":14373,"_27457":119758,"_2948":119849},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3465":71306,"_30219":71306,"_5":14725,"_2948":119851,"_30551":119852,"_20927":119853,"_27457":71306},"Diagnóstico de enrolamiento",[49254,117704,51743,118716,118891],[],{"_3465":71307,"_30219":71306,"_20927":119855,"_5":14373,"_27457":71306,"_2948":119856},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3465":71308,"_30219":71306,"_5":30548,"_20927":119858,"_27457":119859,"_2948":119860},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3465":71309,"_30219":71306,"_5":30548,"_20927":119862,"_27457":119863,"_2948":119864},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3465":71310,"_30219":71306,"_5":30548,"_20927":119866,"_27457":119867,"_2948":119423},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3465":71311,"_30219":71306,"_5":30548,"_20927":119869,"_27457":119870,"_2948":119871},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3465":71312,"_30219":71306,"_20927":119873,"_5":14373,"_27457":71306,"_2948":119874},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3465":71313,"_30219":71306,"_20927":119876,"_5":14373,"_27457":119863,"_2948":119877},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3465":71314,"_30219":71306,"_20927":119879,"_5":14373,"_27457":119863,"_2948":119880},[],"Síntoma o mensaje",{"_3465":71315,"_30219":71306,"_20927":119882,"_5":14373,"_27457":119863,"_2948":119883},[],"Qué revisar",{"_3465":71316,"_30219":71306,"_20927":119885,"_5":14373,"_27457":119863,"_2948":119886},[],"curl rechaza TLS, nombre o emisor",{"_3465":71317,"_30219":71306,"_20927":119888,"_5":14373,"_27457":119863,"_2948":119889},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3465":71318,"_30219":71306,"_20927":119891,"_5":14373,"_27457":119863,"_2948":119892},[],"404 o APS ausente",{"_3465":71319,"_30219":71306,"_20927":119894,"_5":14373,"_27457":119863,"_2948":119895},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3465":71320,"_30219":71306,"_20927":119897,"_5":14373,"_27457":119863,"_2948":119898},[],"400, error de CSR o formato",{"_3465":71321,"_30219":71306,"_20927":119900,"_5":14373,"_27457":119863,"_2948":119901},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3465":71322,"_30219":71306,"_20927":119903,"_5":14373,"_27457":119863,"_2948":119904},[],"Credencial ausente o certificado no válido",{"_3465":71323,"_30219":71306,"_20927":119906,"_5":14373,"_27457":119863,"_2948":119907},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3465":71324,"_30219":71306,"_20927":119909,"_5":14373,"_27457":119863,"_2948":119910},[],"Webhook deniega, expira o responde sin autorización",{"_3465":71325,"_30219":71306,"_20927":119912,"_5":14373,"_27457":119863,"_2948":119913},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3465":71326,"_30219":71306,"_20927":119915,"_5":14373,"_27457":119863,"_2948":52988},[],{"_3465":71327,"_30219":71306,"_20927":119917,"_5":14373,"_27457":119863,"_2948":119918},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3465":71328,"_30219":71306,"_20927":119920,"_5":14373,"_27457":119863,"_2948":52994},[],{"_3465":71329,"_30219":71306,"_20927":119922,"_5":14373,"_27457":119863,"_2948":119923},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3465":71330,"_30219":71306,"_20927":119925,"_5":14373,"_27457":119863,"_2948":53000},[],{"_3465":71331,"_30219":71306,"_20927":119927,"_5":14373,"_27457":119863,"_2948":119928},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3465":71332,"_30219":71306,"_20927":119930,"_5":14373,"_27457":119863,"_2948":53006},[],{"_3465":71333,"_30219":71306,"_20927":119932,"_5":14373,"_27457":119863,"_2948":119933},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3465":71334,"_30219":71306,"_20927":119935,"_5":14373,"_27457":119863,"_2948":53012},[],{"_3465":71335,"_30219":71306,"_20927":119937,"_5":14373,"_27457":119863,"_2948":119938},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3465":71336,"_30219":71306,"_20927":119940,"_5":14373,"_27457":119863,"_2948":119941},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3465":71337,"_30219":71306,"_20927":119943,"_5":14373,"_27457":119863,"_2948":119944},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3465":71338,"_30219":71306,"_20927":119946,"_5":14373,"_27457":119863,"_2948":119947},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3465":71339,"_30219":71306,"_20927":119949,"_5":14373,"_27457":119863,"_2948":119950},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3465":71340,"_30219":71306,"_20927":119952,"_5":14373,"_27457":119863,"_2948":53030},[],{"_3465":71341,"_30219":71306,"_20927":119954,"_5":14373,"_27457":119863,"_2948":119955},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3465":71342,"_30219":71306,"_20927":119957,"_5":14373,"_27457":119863,"_2948":53036},[],{"_3465":71343,"_30219":71306,"_20927":119959,"_5":14373,"_27457":119863,"_2948":119960},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3465":71344,"_30219":71306,"_20927":119962,"_5":14373,"_27457":119863,"_2948":119963},[],"DMS propietario distinto",{"_3465":71345,"_30219":71306,"_20927":119965,"_5":14373,"_27457":119863,"_2948":119966},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3465":71346,"_30219":71306,"_20927":119968,"_5":14373,"_27457":119863,"_2948":53048},[],{"_3465":71347,"_30219":71306,"_20927":119970,"_5":14373,"_27457":119863,"_2948":119971},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3465":71348,"_30219":71306,"_20927":119973,"_5":14373,"_27457":119863,"_2948":53054},[],{"_3465":71349,"_30219":71306,"_20927":119975,"_5":14373,"_27457":119863,"_2948":119976},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3465":71350,"_30219":71306,"_20927":119978,"_5":14373,"_27457":119863,"_2948":119979},[],"Certificado actual revocado",{"_3465":71351,"_30219":71306,"_20927":119981,"_5":14373,"_27457":119863,"_2948":119982},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3465":71352,"_30219":71306,"_20927":119984,"_5":14373,"_27457":119863,"_2948":119985},[],"Error de CA, perfil o firma",{"_3465":71353,"_30219":71306,"_20927":119987,"_5":14373,"_27457":119863,"_2948":119988},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3465":71354,"_30219":71306,"_20927":119990,"_5":14373,"_27457":119863,"_2948":119991},[],"HTTP 200 sin conexión del dispositivo",{"_3465":71355,"_30219":71306,"_20927":119993,"_5":14373,"_27457":119863,"_2948":119994},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3465":71356,"_30219":71306,"_20927":119996,"_5":14373,"_27457":119863,"_2948":119997},[],"Timeout o error después de emitir",{"_3465":71357,"_30219":71306,"_20927":119999,"_5":14373,"_27457":119863,"_2948":120000},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3465":71358,"_30219":71306,"_20927":120002,"_5":14373,"_27457":119867,"_2948":120003},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3465":71359,"_30219":71306,"_20927":120005,"_5":14373,"_27457":119867,"_2948":120006},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3465":71360,"_30219":71306,"_20927":120008,"_5":14373,"_27457":119870,"_2948":120009},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3465":71361,"_30219":71306,"_20927":120011,"_5":14373,"_27457":119870,"_2948":120012},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3465":71362,"_30219":71306,"_20927":120014,"_5":14373,"_27457":119870,"_2948":120015},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3465":71363,"_30219":71306,"_20927":120017,"_5":14373,"_27457":119870,"_2948":120018},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3465":71364,"_30219":71306,"_20927":120020,"_5":14373,"_27457":119870,"_2948":120021},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3465":71365,"_30219":71306,"_20927":120023,"_5":14373,"_27457":119870,"_2948":120024},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3465":71366,"_30219":71306,"_20927":120026,"_5":14373,"_27457":119870,"_2948":120027},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3465":71367,"_30219":71367,"_5":14725,"_2948":120029,"_30551":120030,"_20927":120031,"_27457":71367},"Distribución y actualización de confianza",[49254,117704,51743,118716,118891],[],{"_3465":71368,"_30219":71367,"_20927":120033,"_5":14373,"_27457":71367,"_2948":120034},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3465":71369,"_30219":71367,"_5":30548,"_20927":120036,"_27457":120037,"_2948":120038},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3465":71370,"_30219":71367,"_5":30548,"_20927":120040,"_27457":120041,"_2948":120042},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3465":71371,"_30219":71367,"_5":30548,"_20927":120044,"_27457":120045,"_2948":120046},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3465":71372,"_30219":71367,"_5":30548,"_20927":120048,"_27457":120049,"_2948":120050},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3465":71373,"_30219":71367,"_5":30548,"_20927":120052,"_27457":120053,"_2948":120054},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3465":71374,"_30219":71367,"_20927":120056,"_5":14373,"_27457":71367,"_2948":120057},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3465":71375,"_30219":71367,"_20927":120059,"_5":14373,"_27457":120037,"_2948":120060},[],"Relación",{"_3465":71376,"_30219":71367,"_20927":120062,"_5":14373,"_27457":120037,"_2948":120063},[],"Material que prepara el responsable",{"_3465":71377,"_30219":71367,"_20927":120065,"_5":14373,"_27457":120037,"_2948":120066},[],"Dispositivo → servidor EST",{"_3465":71378,"_30219":71367,"_20927":120068,"_5":14373,"_27457":120037,"_2948":120069},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3465":71379,"_30219":71367,"_20927":120071,"_5":14373,"_27457":120037,"_2948":120072},[],"DMS → solicitante",{"_3465":71380,"_30219":71367,"_20927":120074,"_5":14373,"_27457":120037,"_2948":120075},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3465":71381,"_30219":71367,"_20927":120077,"_5":14373,"_27457":120037,"_2948":120078},[],"Consumidor → dispositivo",{"_3465":71382,"_30219":71367,"_20927":120080,"_5":14373,"_27457":120037,"_2948":120081},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3465":71383,"_30219":71367,"_20927":120083,"_5":14373,"_27457":120037,"_2948":120084},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3465":71384,"_30219":71367,"_20927":120086,"_5":14373,"_27457":120041,"_2948":120087},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3465":71385,"_30219":71367,"_20927":120089,"_5":14373,"_27457":120041,"_2948":120090},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3465":71386,"_30219":71367,"_20927":120092,"_5":14373,"_27457":120045,"_2948":120093},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3465":71387,"_30219":71367,"_20927":120095,"_5":14373,"_27457":120045,"_2948":120096},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3465":71388,"_30219":71367,"_20927":120098,"_5":14373,"_27457":120045,"_2948":120099},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3465":71389,"_30219":71367,"_20927":120101,"_5":14373,"_27457":120045,"_2948":120102},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3465":71390,"_30219":71367,"_20927":120104,"_5":14373,"_27457":120045,"_2948":120105},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3465":71391,"_30219":71367,"_20927":120107,"_5":14373,"_27457":120045,"_2948":120108},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3465":71392,"_30219":71367,"_20927":120110,"_5":14373,"_27457":120049,"_2948":120111},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3465":71393,"_30219":71367,"_20927":120113,"_5":14373,"_27457":120049,"_2948":120114},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3465":71394,"_30219":71367,"_20927":120116,"_5":14373,"_27457":120049,"_2948":120117},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3465":71395,"_30219":71367,"_20927":120119,"_5":14373,"_27457":120053,"_2948":120120},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3465":71396,"_30219":71396,"_5":14725,"_2948":53203,"_30551":120122,"_20927":120124,"_27457":71396},[49254,117704,51743,118716,120123],"Integraciones",[],{"_3465":71397,"_30219":71396,"_20927":120126,"_5":14373,"_27457":71396,"_2948":120127},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3465":71398,"_30219":71396,"_5":30548,"_20927":120129,"_27457":120130,"_2948":120131},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3465":71399,"_30219":71396,"_5":30548,"_20927":120133,"_27457":120134,"_2948":120135},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3465":71400,"_30219":71396,"_5":30548,"_20927":120137,"_27457":120138,"_2948":120139},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3465":71401,"_30219":71396,"_5":30548,"_20927":120141,"_27457":120142,"_2948":120143},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3465":71402,"_30219":71396,"_5":30548,"_20927":120145,"_27457":120146,"_2948":120147},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3465":71403,"_30219":71396,"_5":30548,"_20927":120149,"_27457":120150,"_2948":120151},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3465":71404,"_30219":71396,"_5":30548,"_20927":120153,"_27457":120154,"_2948":120155},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3465":71405,"_30219":71396,"_5":30548,"_20927":120157,"_27457":120158,"_2948":120159},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3465":71406,"_30219":71396,"_5":30548,"_20927":120161,"_27457":120162,"_2948":53245},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3465":71407,"_30219":71396,"_5":30548,"_20927":120164,"_27457":120165,"_2948":53249},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3465":71408,"_30219":71396,"_5":30548,"_20927":120167,"_27457":120168,"_2948":120169},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3465":71409,"_30219":71396,"_5":30548,"_20927":120171,"_27457":120172,"_2948":120173},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3465":71410,"_30219":71396,"_5":30548,"_20927":120175,"_27457":120176,"_2948":120177},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3465":71411,"_30219":71396,"_5":30548,"_20927":120179,"_27457":120180,"_2948":120181},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3465":71412,"_30219":71396,"_5":30548,"_20927":120183,"_27457":120184,"_2948":120185},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3465":71413,"_30219":71396,"_5":30548,"_20927":120187,"_27457":120188,"_2948":120189},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3465":71414,"_30219":71396,"_5":30548,"_20927":120191,"_27457":120192,"_2948":120193},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3465":71415,"_30219":71396,"_5":30548,"_20927":120195,"_27457":120196,"_2948":120197},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3465":71416,"_30219":71396,"_5":30548,"_20927":120199,"_27457":120200,"_2948":120201},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3465":71417,"_30219":71396,"_5":30548,"_20927":120203,"_27457":120204,"_2948":120205},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3465":71418,"_30219":71396,"_5":30548,"_20927":120207,"_27457":120208,"_2948":120209},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3465":71419,"_30219":71396,"_5":30548,"_20927":120211,"_27457":120212,"_2948":120213},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3465":71420,"_30219":71396,"_5":30548,"_20927":120215,"_27457":120216,"_2948":120217},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3465":71421,"_30219":71396,"_5":30548,"_20927":120219,"_27457":120220,"_2948":120221},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3465":71422,"_30219":71396,"_5":30548,"_20927":120223,"_27457":120224,"_2948":120225},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3465":71423,"_30219":71396,"_20927":120227,"_5":14373,"_27457":71396,"_2948":120228},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3465":71424,"_30219":71396,"_20927":120230,"_5":14373,"_27457":71396,"_2948":120231},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3465":71425,"_30219":71396,"_20927":120233,"_5":14373,"_27457":71396,"_2948":120234},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3465":71426,"_30219":71396,"_20927":120236,"_5":14373,"_27457":120130,"_2948":120237},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3465":71427,"_30219":71396,"_20927":120239,"_5":14373,"_27457":120130,"_2948":120240},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3465":71428,"_30219":71396,"_20927":120242,"_5":14373,"_27457":120130,"_2948":120243},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3465":71429,"_30219":71396,"_20927":120245,"_5":14373,"_27457":120130,"_2948":120246},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3465":71430,"_30219":71396,"_20927":120248,"_5":14373,"_27457":120134,"_2948":120249},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3465":71431,"_30219":71396,"_20927":120251,"_5":14373,"_27457":120138,"_2948":120252},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3465":71432,"_30219":71396,"_20927":120254,"_5":14373,"_27457":120138,"_2948":120255},[],"Acción IAM",{"_3465":71433,"_30219":71396,"_20927":120257,"_5":14373,"_27457":120138,"_2948":116645},[],{"_3465":71434,"_30219":71396,"_20927":120259,"_5":14373,"_27457":120138,"_2948":53344},[],{"_3465":71435,"_30219":71396,"_20927":120261,"_5":14373,"_27457":120138,"_2948":120262},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3465":71436,"_30219":71396,"_20927":120264,"_5":14373,"_27457":120138,"_2948":53350},[],{"_3465":71437,"_30219":71396,"_20927":120266,"_5":14373,"_27457":120138,"_2948":120267},[],"Registrar la CA en AWS IoT",{"_3465":71438,"_30219":71396,"_20927":120269,"_5":14373,"_27457":120138,"_2948":53356},[],{"_3465":71439,"_30219":71396,"_20927":120271,"_5":14373,"_27457":120138,"_2948":120272},[],"Consultar el estado del registro de la CA",{"_3465":71440,"_30219":71396,"_20927":120274,"_5":14373,"_27457":120138,"_2948":53362},[],{"_3465":71441,"_30219":71396,"_20927":120276,"_5":14373,"_27457":120138,"_2948":120277},[],"Crear o actualizar Things en IoT Core",{"_3465":71442,"_30219":71396,"_20927":120279,"_5":14373,"_27457":120138,"_2948":53368},[],{"_3465":71443,"_30219":71396,"_20927":120281,"_5":14373,"_27457":120138,"_2948":120282},[],"Aprovisionar Things mediante plantilla",{"_3465":71444,"_30219":71396,"_20927":120284,"_5":14373,"_27457":120138,"_2948":53374},[],{"_3465":71445,"_30219":71396,"_20927":120286,"_5":14373,"_27457":120138,"_2948":120287},[],"Registrar certificados de dispositivo",{"_3465":71446,"_30219":71396,"_20927":120289,"_5":14373,"_27457":120138,"_2948":53380},[],{"_3465":71447,"_30219":71396,"_20927":120291,"_5":14373,"_27457":120138,"_2948":120292},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3465":71448,"_30219":71396,"_20927":120294,"_5":14373,"_27457":120138,"_2948":53386},[],{"_3465":71449,"_30219":71396,"_20927":120296,"_5":14373,"_27457":120138,"_2948":120297},[],"Crear y adjuntar políticas IoT",{"_3465":71450,"_30219":71396,"_20927":120299,"_5":14373,"_27457":120138,"_2948":53392},[],{"_3465":71451,"_30219":71396,"_20927":120301,"_5":14373,"_27457":120138,"_2948":120302},[],"Gestionar grupos de Things",{"_3465":71452,"_30219":71396,"_20927":120304,"_5":14373,"_27457":120138,"_2948":53398},[],{"_3465":71453,"_30219":71396,"_20927":120306,"_5":14373,"_27457":120138,"_2948":120307},[],"Crear plantillas JITP",{"_3465":71454,"_30219":71396,"_20927":120309,"_5":14373,"_27457":120138,"_2948":53404},[],{"_3465":71455,"_30219":71396,"_20927":120311,"_5":14373,"_27457":120138,"_2948":120312},[],"Leer y escribir el Device Shadow",{"_3465":71456,"_30219":71396,"_20927":120314,"_5":14373,"_27457":120138,"_2948":120315},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3465":71457,"_30219":71396,"_20927":120317,"_5":14373,"_27457":120142,"_2948":120318},[],"Parámetro",{"_3465":71458,"_30219":71396,"_20927":120320,"_5":14373,"_27457":120142,"_2948":120321},[],"Tipo",{"_3465":71459,"_30219":71396,"_20927":120323,"_5":14373,"_27457":120142,"_2948":120324},[],"Requerido",{"_3465":71460,"_30219":71396,"_20927":120326,"_5":14373,"_27457":120142,"_2948":120327},[],"Descripción",{"_3465":71461,"_30219":71396,"_20927":120329,"_5":14373,"_27457":120142,"_2948":53425},[],{"_3465":71462,"_30219":71396,"_20927":120331,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71463,"_30219":71396,"_20927":120333,"_5":14373,"_27457":120142,"_2948":120334},[],"Sí",{"_3465":71464,"_30219":71396,"_20927":120336,"_5":14373,"_27457":120142,"_2948":120337},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3465":71465,"_30219":71396,"_20927":120339,"_5":14373,"_27457":120142,"_2948":53436},[],{"_3465":71466,"_30219":71396,"_20927":120341,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71467,"_30219":71396,"_20927":120343,"_5":14373,"_27457":120142,"_2948":120334},[],{"_3465":71468,"_30219":71396,"_20927":120345,"_5":14373,"_27457":120142,"_2948":120346},[],"Región AWS donde opera el conector.",{"_3465":71469,"_30219":71396,"_20927":120348,"_5":14373,"_27457":120142,"_2948":53446},[],{"_3465":71470,"_30219":71396,"_20927":120350,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71471,"_30219":71396,"_20927":120352,"_5":14373,"_27457":120142,"_2948":120334},[],{"_3465":71472,"_30219":71396,"_20927":120354,"_5":14373,"_27457":120142,"_2948":120355},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3465":71473,"_30219":71396,"_20927":120357,"_5":14373,"_27457":120142,"_2948":53456},[],{"_3465":71474,"_30219":71396,"_20927":120359,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71475,"_30219":71396,"_20927":120361,"_5":14373,"_27457":120142,"_2948":120362},[],"Solo con `auth_method=static`",{"_3465":71476,"_30219":71396,"_20927":120364,"_5":14373,"_27457":120142,"_2948":120365},[],"Clave de acceso AWS.",{"_3465":71477,"_30219":71396,"_20927":120367,"_5":14373,"_27457":120142,"_2948":53467},[],{"_3465":71478,"_30219":71396,"_20927":120369,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71479,"_30219":71396,"_20927":120371,"_5":14373,"_27457":120142,"_2948":120362},[],{"_3465":71480,"_30219":71396,"_20927":120373,"_5":14373,"_27457":120142,"_2948":120374},[],"Clave secreta AWS.",{"_3465":71481,"_30219":71396,"_20927":120376,"_5":14373,"_27457":120142,"_2948":53477},[],{"_3465":71482,"_30219":71396,"_20927":120378,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71483,"_30219":71396,"_20927":120380,"_5":14373,"_27457":120142,"_2948":53482},[],{"_3465":71484,"_30219":71396,"_20927":120382,"_5":14373,"_27457":120142,"_2948":120383},[],"Token de sesión (con `auth_method=static`).",{"_3465":71485,"_30219":71396,"_20927":120385,"_5":14373,"_27457":120142,"_2948":53488},[],{"_3465":71486,"_30219":71396,"_20927":120387,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71487,"_30219":71396,"_20927":120389,"_5":14373,"_27457":120142,"_2948":120390},[],"Solo con `auth_method=role`",{"_3465":71488,"_30219":71396,"_20927":120392,"_5":14373,"_27457":120142,"_2948":120393},[],"ARN del rol a asumir.",{"_3465":71489,"_30219":71396,"_20927":120395,"_5":14373,"_27457":120142,"_2948":53499},[],{"_3465":71490,"_30219":71396,"_20927":120397,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71491,"_30219":71396,"_20927":120399,"_5":14373,"_27457":120142,"_2948":53482},[],{"_3465":71492,"_30219":71396,"_20927":120401,"_5":14373,"_27457":120142,"_2948":120402},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3465":71493,"_30219":71396,"_20927":120404,"_5":14373,"_27457":120142,"_2948":53509},[],{"_3465":71494,"_30219":71396,"_20927":120406,"_5":14373,"_27457":120142,"_2948":89764},[],{"_3465":71495,"_30219":71396,"_20927":120408,"_5":14373,"_27457":120142,"_2948":120334},[],{"_3465":71496,"_30219":71396,"_20927":120410,"_5":14373,"_27457":120142,"_2948":120411},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3465":71497,"_30219":71396,"_20927":120413,"_5":14373,"_27457":120142,"_2948":53519},[],{"_3465":71498,"_30219":71396,"_20927":120415,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71499,"_30219":71396,"_20927":120417,"_5":14373,"_27457":120142,"_2948":120334},[],{"_3465":71500,"_30219":71396,"_20927":120419,"_5":14373,"_27457":120142,"_2948":120420},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3465":71501,"_30219":71396,"_20927":120422,"_5":14373,"_27457":120142,"_2948":53529},[],{"_3465":71502,"_30219":71396,"_20927":120424,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71503,"_30219":71396,"_20927":120426,"_5":14373,"_27457":120142,"_2948":120334},[],{"_3465":71504,"_30219":71396,"_20927":120428,"_5":14373,"_27457":120142,"_2948":120429},[],"URL HTTP del Device Manager de Lamassu.",{"_3465":71505,"_30219":71396,"_20927":120431,"_5":14373,"_27457":120142,"_2948":53539},[],{"_3465":71506,"_30219":71396,"_20927":120433,"_5":14373,"_27457":120142,"_2948":25026},[],{"_3465":71507,"_30219":71396,"_20927":120435,"_5":14373,"_27457":120142,"_2948":120334},[],{"_3465":71508,"_30219":71396,"_20927":120437,"_5":14373,"_27457":120142,"_2948":120438},[],"URL HTTP del servicio de CA de Lamassu.",{"_3465":71509,"_30219":71396,"_20927":120440,"_5":14373,"_27457":120146,"_2948":120441},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3465":71510,"_30219":71396,"_20927":120443,"_5":14373,"_27457":120146,"_2948":120444},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3465":71511,"_30219":71396,"_20927":120446,"_5":14373,"_27457":120146,"_2948":120447},[],"Tipo de CloudEvent",{"_3465":71512,"_30219":71396,"_20927":120449,"_5":14373,"_27457":120146,"_2948":120450},[],"Recurso en Lamassu",{"_3465":71513,"_30219":71396,"_20927":120452,"_5":14373,"_27457":120146,"_2948":120453},[],"Recurso AWS",{"_3465":71514,"_30219":71396,"_20927":120455,"_5":14373,"_27457":120146,"_2948":120456},[],"Acciones IAM",{"_3465":71515,"_30219":71396,"_20927":120458,"_5":14373,"_27457":120146,"_2948":120459},[],"Llamadas AWS y efecto",{"_3465":71516,"_30219":71396,"_20927":120461,"_5":14373,"_27457":120146,"_2948":120462},[],"Dónde en esta página",{"_3465":71517,"_30219":71396,"_20927":120464,"_5":14373,"_27457":120146,"_2948":53573},[],{"_3465":71518,"_30219":71396,"_20927":120466,"_5":14373,"_27457":120146,"_2948":53576},[],{"_3465":71519,"_30219":71396,"_20927":120468,"_5":14373,"_27457":120146,"_2948":53579},[],{"_3465":71520,"_30219":71396,"_20927":120470,"_5":14373,"_27457":120146,"_2948":53582},[],{"_3465":71521,"_30219":71396,"_20927":120472,"_5":14373,"_27457":120146,"_2948":120473},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3465":71522,"_30219":71396,"_20927":120475,"_5":14373,"_27457":120146,"_2948":120159},[],{"_3465":71523,"_30219":71396,"_20927":120477,"_5":14373,"_27457":120146,"_2948":53590},[],{"_3465":71524,"_30219":71396,"_20927":120479,"_5":14373,"_27457":120146,"_2948":53593},[],{"_3465":71525,"_30219":71396,"_20927":120481,"_5":14373,"_27457":120146,"_2948":53596},[],{"_3465":71526,"_30219":71396,"_20927":120483,"_5":14373,"_27457":120146,"_2948":53599},[],{"_3465":71527,"_30219":71396,"_20927":120485,"_5":14373,"_27457":120146,"_2948":120486},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3465":71528,"_30219":71396,"_20927":120488,"_5":14373,"_27457":120146,"_2948":120185},[],{"_3465":71529,"_30219":71396,"_20927":120490,"_5":14373,"_27457":120146,"_2948":53607},[],{"_3465":71530,"_30219":71396,"_20927":120492,"_5":14373,"_27457":120146,"_2948":120493},[],"Dispositivo",{"_3465":71531,"_30219":71396,"_20927":120495,"_5":14373,"_27457":120146,"_2948":53613},[],{"_3465":71532,"_30219":71396,"_20927":120497,"_5":14373,"_27457":120146,"_2948":53616},[],{"_3465":71533,"_30219":71396,"_20927":120499,"_5":14373,"_27457":120146,"_2948":120500},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3465":71534,"_30219":71396,"_20927":120502,"_5":14373,"_27457":120146,"_2948":120193},[],{"_3465":71535,"_30219":71396,"_20927":120504,"_5":14373,"_27457":120146,"_2948":53624},[],{"_3465":71536,"_30219":71396,"_20927":120506,"_5":14373,"_27457":120146,"_2948":120507},[],"Certificado",{"_3465":71537,"_30219":71396,"_20927":120509,"_5":14373,"_27457":120146,"_2948":53630},[],{"_3465":71538,"_30219":71396,"_20927":120511,"_5":14373,"_27457":120146,"_2948":120512},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3465":71539,"_30219":71396,"_20927":120514,"_5":14373,"_27457":120146,"_2948":120515},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3465":71540,"_30219":71396,"_20927":120517,"_5":14373,"_27457":120146,"_2948":120205},[],{"_3465":71541,"_30219":71396,"_20927":120519,"_5":14373,"_27457":120146,"_2948":53641},[],{"_3465":71542,"_30219":71396,"_20927":120521,"_5":14373,"_27457":120146,"_2948":120522},[],"Certificado / Dispositivo",{"_3465":71543,"_30219":71396,"_20927":120524,"_5":14373,"_27457":120146,"_2948":53647},[],{"_3465":71544,"_30219":71396,"_20927":120526,"_5":14373,"_27457":120146,"_2948":49650},[],{"_3465":71545,"_30219":71396,"_20927":120528,"_5":14373,"_27457":120146,"_2948":120529},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3465":71546,"_30219":71396,"_20927":120531,"_5":14373,"_27457":120146,"_2948":120213},[],{"_3465":71547,"_30219":71396,"_20927":120533,"_5":14373,"_27457":120150,"_2948":120534},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3465":71548,"_30219":71396,"_20927":120536,"_5":14373,"_27457":120154,"_2948":120537},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3465":71549,"_30219":71396,"_20927":120539,"_5":14373,"_27457":120154,"_2948":120540},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3465":71550,"_30219":71396,"_20927":120542,"_5":14373,"_27457":120158,"_2948":120543},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3465":71551,"_30219":71396,"_20927":120545,"_5":14373,"_27457":120158,"_2948":120546},[],"Transición",{"_3465":71552,"_30219":71396,"_20927":120548,"_5":14373,"_27457":120158,"_2948":120549},[],"Llamadas AWS",{"_3465":71553,"_30219":71396,"_20927":120551,"_5":14373,"_27457":120158,"_2948":120552},[],"`NoRegistrada` → `Solicitada`",{"_3465":71554,"_30219":71396,"_20927":120554,"_5":14373,"_27457":120158,"_2948":120555},[],"ninguna (solo escritura de metadatos)",{"_3465":71555,"_30219":71396,"_20927":120557,"_5":14373,"_27457":120158,"_2948":120558},[],"`Solicitada` → `Registrando`",{"_3465":71556,"_30219":71396,"_20927":120560,"_5":14373,"_27457":120158,"_2948":120561},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3465":71557,"_30219":71396,"_20927":120563,"_5":14373,"_27457":120158,"_2948":120564},[],"`Registrando` → `Completada`",{"_3465":71558,"_30219":71396,"_20927":120566,"_5":14373,"_27457":120158,"_2948":120567},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3465":71559,"_30219":71396,"_20927":120569,"_5":14373,"_27457":120158,"_2948":120570},[],"`Registrando` → `Fallida`",{"_3465":71560,"_30219":71396,"_20927":120572,"_5":14373,"_27457":120158,"_2948":120573},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3465":71561,"_30219":71396,"_20927":120575,"_5":14373,"_27457":120158,"_2948":120576},[],"`Fallida` / `Completada` → `Solicitada`",{"_3465":71562,"_30219":71396,"_20927":120578,"_5":14373,"_27457":120158,"_2948":120579},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3465":71563,"_30219":71396,"_20927":120581,"_5":14373,"_27457":120162,"_2948":120582},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3465":71564,"_30219":71396,"_20927":120584,"_5":14373,"_27457":120162,"_2948":120585},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3465":71565,"_30219":71396,"_20927":120587,"_5":14373,"_27457":120162,"_2948":120588},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3465":71566,"_30219":71396,"_20927":120590,"_5":14373,"_27457":120162,"_2948":120591},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3465":71567,"_30219":71396,"_20927":120593,"_5":14373,"_27457":120162,"_2948":120594},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3465":71568,"_30219":71396,"_20927":120596,"_5":14373,"_27457":120162,"_2948":120597},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3465":71569,"_30219":71396,"_20927":120599,"_5":14373,"_27457":120165,"_2948":120600},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3465":71570,"_30219":71396,"_20927":120602,"_5":14373,"_27457":120168,"_2948":120603},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3465":71571,"_30219":71396,"_20927":120605,"_5":14373,"_27457":120168,"_2948":120606},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3465":71572,"_30219":71396,"_20927":120608,"_5":14373,"_27457":120172,"_2948":120609},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3465":71573,"_30219":71396,"_20927":120611,"_5":14373,"_27457":120176,"_2948":120612},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3465":71574,"_30219":71396,"_20927":120614,"_5":14373,"_27457":120176,"_2948":120615},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3465":71575,"_30219":71396,"_20927":120617,"_5":14373,"_27457":120176,"_2948":120618},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3465":71576,"_30219":71396,"_20927":120620,"_5":14373,"_27457":120176,"_2948":120621},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3465":71577,"_30219":71396,"_20927":120623,"_5":14373,"_27457":120176,"_2948":120624},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3465":71578,"_30219":71396,"_20927":120626,"_5":14373,"_27457":120176,"_2948":120627},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3465":71579,"_30219":71396,"_20927":120629,"_5":14373,"_27457":120180,"_2948":120630},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3465":71580,"_30219":71396,"_20927":120632,"_5":14373,"_27457":120180,"_2948":120633},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3465":71581,"_30219":71396,"_20927":120635,"_5":14373,"_27457":120180,"_2948":120636},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3465":71582,"_30219":71396,"_20927":120638,"_5":14373,"_27457":120180,"_2948":120639},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3465":71583,"_30219":71396,"_20927":120641,"_5":14373,"_27457":120180,"_2948":120642},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3465":71584,"_30219":71396,"_20927":120644,"_5":14373,"_27457":120184,"_2948":120645},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3465":71585,"_30219":71396,"_20927":120647,"_5":14373,"_27457":120184,"_2948":120546},[],{"_3465":71586,"_30219":71396,"_20927":120649,"_5":14373,"_27457":120184,"_2948":120549},[],{"_3465":71587,"_30219":71396,"_20927":120651,"_5":14373,"_27457":120184,"_2948":120652},[],"`SinConfigurar` → `None` / `Auto`",{"_3465":71588,"_30219":71396,"_20927":120654,"_5":14373,"_27457":120184,"_2948":120655},[],"ninguna (solo configuración)",{"_3465":71589,"_30219":71396,"_20927":120657,"_5":14373,"_27457":120184,"_2948":53784},[],{"_3465":71590,"_30219":71396,"_20927":120659,"_5":14373,"_27457":120184,"_2948":120655},[],{"_3465":71591,"_30219":71396,"_20927":120661,"_5":14373,"_27457":120184,"_2948":120662},[],"Cualquiera → `Jitp`",{"_3465":71592,"_30219":71396,"_20927":120664,"_5":14373,"_27457":120184,"_2948":120665},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3465":71593,"_30219":71396,"_20927":120667,"_5":14373,"_27457":120184,"_2948":53795},[],{"_3465":71594,"_30219":71396,"_20927":120669,"_5":14373,"_27457":120184,"_2948":120670},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3465":71595,"_30219":71396,"_20927":120672,"_5":14373,"_27457":120188,"_2948":120673},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3465":71596,"_30219":71396,"_20927":120675,"_5":14373,"_27457":120188,"_2948":120676},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3465":71597,"_30219":71396,"_20927":120678,"_5":14373,"_27457":120188,"_2948":120679},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3465":71598,"_30219":71396,"_20927":120681,"_5":14373,"_27457":120192,"_2948":120682},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3465":71599,"_30219":71396,"_20927":120684,"_5":14373,"_27457":120192,"_2948":120546},[],{"_3465":71600,"_30219":71396,"_20927":120686,"_5":14373,"_27457":120192,"_2948":120549},[],{"_3465":71601,"_30219":71396,"_20927":120688,"_5":14373,"_27457":120192,"_2948":120689},[],"`Ausente` → `Aprovisionado`",{"_3465":71602,"_30219":71396,"_20927":120691,"_5":14373,"_27457":120192,"_2948":120692},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3465":71603,"_30219":71396,"_20927":120694,"_5":14373,"_27457":120192,"_2948":120695},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3465":71604,"_30219":71396,"_20927":120697,"_5":14373,"_27457":120192,"_2948":120698},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3465":71605,"_30219":71396,"_20927":120700,"_5":14373,"_27457":120192,"_2948":120701},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3465":71606,"_30219":71396,"_20927":120703,"_5":14373,"_27457":120196,"_2948":120704},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3465":71607,"_30219":71396,"_20927":120706,"_5":14373,"_27457":120196,"_2948":120707},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3465":71608,"_30219":71396,"_20927":120709,"_5":14373,"_27457":120196,"_2948":120710},[],"Para que el flujo JITP funcione correctamente:",{"_3465":71609,"_30219":71396,"_20927":120712,"_5":14373,"_27457":120196,"_2948":120713},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3465":71610,"_30219":71396,"_20927":120715,"_5":14373,"_27457":120196,"_2948":120716},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3465":71611,"_30219":71396,"_20927":120718,"_5":14373,"_27457":120196,"_2948":120719},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3465":71612,"_30219":71396,"_20927":120721,"_5":14373,"_27457":120196,"_2948":120722},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3465":71613,"_30219":71396,"_20927":120724,"_5":14373,"_27457":120200,"_2948":120725},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3465":71614,"_30219":71396,"_20927":120727,"_5":14373,"_27457":120200,"_2948":120728},[],"Estado en Lamassu",{"_3465":71615,"_30219":71396,"_20927":120730,"_5":14373,"_27457":120200,"_2948":120731},[],"Razón de revocación",{"_3465":71616,"_30219":71396,"_20927":120733,"_5":14373,"_27457":120200,"_2948":120734},[],"Estado en AWS IoT Core",{"_3465":71617,"_30219":71396,"_20927":120736,"_5":14373,"_27457":120200,"_2948":53865},[],{"_3465":71618,"_30219":71396,"_20927":120738,"_5":14373,"_27457":120200,"_2948":120739},[],"Ninguna",{"_3465":71619,"_30219":71396,"_20927":120741,"_5":14373,"_27457":120200,"_2948":53871},[],{"_3465":71620,"_30219":71396,"_20927":120743,"_5":14373,"_27457":120200,"_2948":53874},[],{"_3465":71621,"_30219":71396,"_20927":120745,"_5":14373,"_27457":120200,"_2948":53877},[],{"_3465":71622,"_30219":71396,"_20927":120747,"_5":14373,"_27457":120200,"_2948":53880},[],{"_3465":71623,"_30219":71396,"_20927":120749,"_5":14373,"_27457":120200,"_2948":53874},[],{"_3465":71624,"_30219":71396,"_20927":120751,"_5":14373,"_27457":120200,"_2948":120752},[],"Cualquier otra razón",{"_3465":71625,"_30219":71396,"_20927":120754,"_5":14373,"_27457":120200,"_2948":53888},[],{"_3465":71626,"_30219":71396,"_20927":120756,"_5":14373,"_27457":120200,"_2948":120757},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3465":71627,"_30219":71396,"_20927":120759,"_5":14373,"_27457":120204,"_2948":120760},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3465":71628,"_30219":71396,"_20927":120762,"_5":14373,"_27457":120204,"_2948":120546},[],{"_3465":71629,"_30219":71396,"_20927":120764,"_5":14373,"_27457":120204,"_2948":120549},[],{"_3465":71630,"_30219":71396,"_20927":120766,"_5":14373,"_27457":120204,"_2948":120767},[],"`NoSincronizado` → `Active`",{"_3465":71631,"_30219":71396,"_20927":120769,"_5":14373,"_27457":120204,"_2948":53380},[],{"_3465":71632,"_30219":71396,"_20927":120771,"_5":14373,"_27457":120204,"_2948":53906},[],{"_3465":71633,"_30219":71396,"_20927":120773,"_5":14373,"_27457":120204,"_2948":120774},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3465":71634,"_30219":71396,"_20927":120776,"_5":14373,"_27457":120204,"_2948":53912},[],{"_3465":71635,"_30219":71396,"_20927":120778,"_5":14373,"_27457":120204,"_2948":120774},[],{"_3465":71636,"_30219":71396,"_20927":120780,"_5":14373,"_27457":120204,"_2948":53917},[],{"_3465":71637,"_30219":71396,"_20927":120782,"_5":14373,"_27457":120204,"_2948":53380},[],{"_3465":71638,"_30219":71396,"_20927":120784,"_5":14373,"_27457":120204,"_2948":53922},[],{"_3465":71639,"_30219":71396,"_20927":120786,"_5":14373,"_27457":120204,"_2948":120787},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3465":71640,"_30219":71396,"_20927":120789,"_5":14373,"_27457":120208,"_2948":120790},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3465":71641,"_30219":71396,"_20927":120792,"_5":14373,"_27457":120208,"_2948":120793},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3465":71642,"_30219":71396,"_20927":120795,"_5":14373,"_27457":120208,"_2948":120796},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3465":71643,"_30219":71396,"_20927":120798,"_5":14373,"_27457":120212,"_2948":120799},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3465":71644,"_30219":71396,"_20927":120801,"_5":14373,"_27457":120212,"_2948":120802},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3465":71645,"_30219":71396,"_20927":120804,"_5":14373,"_27457":120216,"_2948":120805},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3465":71646,"_30219":71396,"_20927":120807,"_5":14373,"_27457":120216,"_2948":120808},[],"Existen dos tipos de acciones:",{"_3465":71647,"_30219":71396,"_20927":120810,"_5":14373,"_27457":120216,"_2948":120811},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3465":71648,"_30219":71396,"_20927":120813,"_5":14373,"_27457":120216,"_2948":120814},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3465":71649,"_30219":71396,"_20927":120816,"_5":14373,"_27457":120216,"_2948":120817},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3465":71650,"_30219":71396,"_20927":120819,"_5":14373,"_27457":120220,"_2948":120820},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3465":71651,"_30219":71396,"_20927":120822,"_5":14373,"_27457":120220,"_2948":120823},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3465":71652,"_30219":71396,"_20927":120825,"_5":14373,"_27457":120220,"_2948":120826},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3465":71653,"_30219":71396,"_20927":120828,"_5":14373,"_27457":120224,"_2948":120829},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3465":71654,"_30219":71396,"_20927":120831,"_5":14373,"_27457":120224,"_2948":120832},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3465":71655,"_30219":71396,"_20927":120834,"_5":14373,"_27457":120224,"_2948":120835},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3465":71656,"_30219":71396,"_20927":120837,"_5":14373,"_27457":120224,"_2948":120838},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3465":71657,"_30219":71396,"_20927":120840,"_5":14373,"_27457":120224,"_2948":120841},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3465":71658,"_30219":71396,"_20927":120843,"_5":14373,"_27457":120224,"_2948":120844},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3465":71659,"_30219":71396,"_20927":120846,"_5":14373,"_27457":120224,"_2948":120847},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3465":71660,"_30219":71396,"_20927":120849,"_5":14373,"_27457":120224,"_2948":120850},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3465":71661,"_30219":71396,"_20927":120852,"_5":14373,"_27457":120224,"_2948":120853},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3465":71662,"_30219":71396,"_20927":120855,"_5":14373,"_27457":120224,"_2948":120856},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3465":71663,"_30219":71396,"_20927":120858,"_5":14373,"_27457":120224,"_2948":120859},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3465":71664,"_30219":71396,"_20927":120861,"_5":14373,"_27457":120224,"_2948":120862},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3465":71665,"_30219":71396,"_20927":120864,"_5":14373,"_27457":120224,"_2948":120865},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3465":71666,"_30219":71396,"_20927":120867,"_5":14373,"_27457":120224,"_2948":120868},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3465":71667,"_30219":71396,"_20927":120870,"_5":14373,"_27457":120224,"_2948":120871},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3465":71668,"_30219":71396,"_20927":120873,"_5":14373,"_27457":120224,"_2948":120874},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3465":71669,"_30219":71396,"_20927":120876,"_5":14373,"_27457":120224,"_2948":120877},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3465":71670,"_30219":71396,"_20927":120879,"_5":14373,"_27457":120224,"_2948":120880},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3465":71671,"_30219":71396,"_20927":120882,"_5":14373,"_27457":120224,"_2948":120883},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3465":71672,"_30219":71396,"_20927":120885,"_5":14373,"_27457":120224,"_2948":120886},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3465":71673,"_30219":71396,"_20927":120888,"_5":14373,"_27457":120224,"_2948":120889},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3465":71674,"_30219":71396,"_20927":120891,"_5":14373,"_27457":120224,"_2948":120892},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71675,"_30219":71396,"_20927":120894,"_5":14373,"_27457":120224,"_2948":120895},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3465":71676,"_30219":71396,"_20927":120897,"_5":14373,"_27457":120224,"_2948":120898},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3465":71677,"_30219":71677,"_5":14725,"_2948":51743,"_30551":120900,"_20927":120901,"_27457":71677},[49254,117704,51743],[],{"_3465":71678,"_30219":71677,"_20927":120903,"_5":14373,"_27457":71677,"_2948":120904},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3465":71679,"_30219":71677,"_5":30548,"_20927":120906,"_27457":120907,"_2948":120908},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3465":71680,"_30219":71677,"_5":30548,"_20927":120910,"_27457":120911,"_2948":118716},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3465":71681,"_30219":71677,"_5":30548,"_20927":120913,"_27457":120914,"_2948":118891},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3465":71682,"_30219":71677,"_5":30548,"_20927":120916,"_27457":120917,"_2948":120123},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3465":71683,"_30219":71677,"_5":30548,"_20927":120919,"_27457":120920,"_2948":120921},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3465":71684,"_30219":71677,"_20927":120923,"_5":14373,"_27457":71677,"_2948":120924},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3465":71685,"_30219":71677,"_20927":120926,"_5":14373,"_27457":120907,"_2948":120927},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3465":71686,"_30219":71677,"_20927":120929,"_5":14373,"_27457":120907,"_2948":120930},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3465":71687,"_30219":71677,"_20927":120932,"_5":14373,"_27457":120911,"_2948":120933},[],"Recurso",{"_3465":71688,"_30219":71677,"_20927":120935,"_5":14373,"_27457":120911,"_2948":120936},[],"Qué representa",{"_3465":71689,"_30219":71677,"_20927":120938,"_5":14373,"_27457":120911,"_2948":120939},[],"**Dispositivo**",{"_3465":71690,"_30219":71677,"_20927":120941,"_5":14373,"_27457":120911,"_2948":120942},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3465":71691,"_30219":71677,"_20927":120944,"_5":14373,"_27457":120911,"_2948":120945},[],"**Identidad**",{"_3465":71692,"_30219":71677,"_20927":120947,"_5":14373,"_27457":120911,"_2948":120948},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3465":71693,"_30219":71677,"_20927":120950,"_5":14373,"_27457":120911,"_2948":54089},[],{"_3465":71694,"_30219":71677,"_20927":120952,"_5":14373,"_27457":120911,"_2948":120953},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3465":71695,"_30219":71677,"_20927":120955,"_5":14373,"_27457":120911,"_2948":120956},[],"**Flota**",{"_3465":71696,"_30219":71677,"_20927":120958,"_5":14373,"_27457":120911,"_2948":120959},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3465":71697,"_30219":71677,"_20927":120961,"_5":14373,"_27457":120911,"_2948":120962},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3465":71698,"_30219":71677,"_20927":120964,"_5":14373,"_27457":120911,"_2948":120965},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3465":71699,"_30219":71677,"_20927":120967,"_5":14373,"_27457":120914,"_2948":120968},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3465":71700,"_30219":71677,"_20927":120970,"_5":14373,"_27457":120914,"_2948":120971},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3465":71701,"_30219":71677,"_20927":120973,"_5":14373,"_27457":120914,"_2948":120974},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3465":71702,"_30219":71677,"_20927":120976,"_5":14373,"_27457":120914,"_2948":120977},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3465":71703,"_30219":71677,"_20927":120979,"_5":14373,"_27457":120914,"_2948":120980},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3465":71704,"_30219":71677,"_20927":120982,"_5":14373,"_27457":120914,"_2948":120983},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3465":71705,"_30219":71677,"_20927":120985,"_5":14373,"_27457":120914,"_2948":120986},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71706,"_30219":71677,"_20927":120988,"_5":14373,"_27457":120914,"_2948":120989},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":71707,"_30219":71677,"_20927":120991,"_5":14373,"_27457":120917,"_2948":120992},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3465":71708,"_30219":71677,"_20927":120994,"_5":14373,"_27457":120917,"_2948":120995},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3465":71709,"_30219":71677,"_20927":120997,"_5":14373,"_27457":120920,"_2948":120998},[],"Participante",{"_3465":71710,"_30219":71677,"_20927":121000,"_5":14373,"_27457":120920,"_2948":121001},[],"Responsabilidad",{"_3465":71711,"_30219":71677,"_20927":121003,"_5":14373,"_27457":120920,"_2948":121004},[],"Administrador PKI",{"_3465":71712,"_30219":71677,"_20927":121006,"_5":14373,"_27457":120920,"_2948":121007},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3465":71713,"_30219":71677,"_20927":121009,"_5":14373,"_27457":120920,"_2948":121010},[],"Administrador del aprovisionamiento",{"_3465":71714,"_30219":71677,"_20927":121012,"_5":14373,"_27457":120920,"_2948":121013},[],"DMS, admisión, autenticación por operación e inventario.",{"_3465":71715,"_30219":71677,"_20927":121015,"_5":14373,"_27457":120920,"_2948":121016},[],"Integrador del dispositivo",{"_3465":71716,"_30219":71677,"_20927":121018,"_5":14373,"_27457":120920,"_2948":121019},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3465":71717,"_30219":71677,"_20927":121021,"_5":14373,"_27457":120920,"_2948":121022},[],"Integrador del consumidor",{"_3465":71718,"_30219":71677,"_20927":121024,"_5":14373,"_27457":120920,"_2948":121025},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3465":71719,"_30219":71677,"_20927":121027,"_5":14373,"_27457":120920,"_2948":121028},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3465":71720,"_30219":71720,"_5":14725,"_2948":121030,"_30551":121031,"_20927":121033,"_27457":71720},"Enrola y conecta tu primer dispositivo",[49254,117704,51743,121032],"Primeros pasos",[],{"_3465":71721,"_30219":71720,"_20927":121035,"_5":14373,"_27457":71720,"_2948":121036},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3465":71722,"_30219":71720,"_5":30548,"_20927":121038,"_27457":121039,"_2948":116275},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3465":71723,"_30219":71720,"_5":30548,"_20927":121041,"_27457":121042,"_2948":121043},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3465":71724,"_30219":71720,"_5":30548,"_20927":121045,"_27457":121046,"_2948":121047},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3465":71725,"_30219":71720,"_5":30548,"_20927":121049,"_27457":121050,"_2948":121051},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3465":71726,"_30219":71720,"_5":30548,"_20927":121053,"_27457":121054,"_2948":121055},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3465":71727,"_30219":71720,"_5":30548,"_20927":121057,"_27457":121058,"_2948":121059},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3465":71728,"_30219":71720,"_5":30548,"_20927":121061,"_27457":121062,"_2948":121063},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3465":71729,"_30219":71720,"_5":30548,"_20927":121065,"_27457":121066,"_2948":121067},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3465":71730,"_30219":71720,"_20927":121069,"_5":14373,"_27457":71720,"_2948":121070},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3465":71731,"_30219":71720,"_20927":121072,"_5":14373,"_27457":121039,"_2948":121073},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3465":71732,"_30219":71720,"_20927":121075,"_5":14373,"_27457":121039,"_2948":121076},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3465":71733,"_30219":71720,"_20927":121078,"_5":14373,"_27457":121039,"_2948":121079},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3465":71734,"_30219":71720,"_20927":121081,"_5":14373,"_27457":121039,"_2948":121082},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3465":71735,"_30219":71720,"_20927":121084,"_5":14373,"_27457":121039,"_2948":121085},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3465":71736,"_30219":71720,"_20927":121087,"_5":14373,"_27457":121042,"_2948":121088},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3465":71737,"_30219":71720,"_20927":121090,"_5":14373,"_27457":121042,"_2948":121091},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3465":71738,"_30219":71720,"_20927":121093,"_5":14373,"_27457":121046,"_2948":121094},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3465":71739,"_30219":71720,"_20927":121096,"_5":14373,"_27457":121046,"_2948":121097},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3465":71740,"_30219":71720,"_20927":121099,"_5":14373,"_27457":121046,"_2948":121100},[],"Ajuste",{"_3465":71741,"_30219":71720,"_20927":121102,"_5":14373,"_27457":121046,"_2948":121103},[],"Valor de evaluación",{"_3465":71742,"_30219":71720,"_20927":121105,"_5":14373,"_27457":121046,"_2948":54245},[],{"_3465":71743,"_30219":71720,"_20927":121107,"_5":14373,"_27457":121046,"_2948":121108},[],"Raíz emisora de `device-root.pem`.",{"_3465":71744,"_30219":71720,"_20927":121110,"_5":14373,"_27457":121046,"_2948":119019},[],{"_3465":71745,"_30219":71720,"_20927":121112,"_5":14373,"_27457":121046,"_2948":121113},[],"Perfil final de 1 hora que acabas de preparar.",{"_3465":71746,"_30219":71720,"_20927":121115,"_5":14373,"_27457":121046,"_2948":54256},[],{"_3465":71747,"_30219":71720,"_20927":121117,"_5":14373,"_27457":121046,"_2948":54259},[],{"_3465":71748,"_30219":71720,"_20927":121119,"_5":14373,"_27457":121046,"_2948":54262},[],{"_3465":71749,"_30219":71720,"_20927":121121,"_5":14373,"_27457":121046,"_2948":121122},[],"Habilitado.",{"_3465":71750,"_30219":71720,"_20927":121124,"_5":14373,"_27457":121046,"_2948":54268},[],{"_3465":71751,"_30219":71720,"_20927":121126,"_5":14373,"_27457":121046,"_2948":121127},[],"Deshabilitado; el ID debe ser nuevo.",{"_3465":71752,"_30219":71720,"_20927":121129,"_5":14373,"_27457":121046,"_2948":121130},[],"Autenticación inicial",{"_3465":71753,"_30219":71720,"_20927":121132,"_5":14373,"_27457":121046,"_2948":121133},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3465":71754,"_30219":71720,"_20927":121135,"_5":14373,"_27457":121046,"_2948":121136},[],"Autenticación de renovación",{"_3465":71755,"_30219":71720,"_20927":121138,"_5":14373,"_27457":121046,"_2948":121139},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3465":71756,"_30219":71720,"_20927":121141,"_5":14373,"_27457":121046,"_2948":54286},[],{"_3465":71757,"_30219":71720,"_20927":121143,"_5":14373,"_27457":121046,"_2948":121144},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3465":71758,"_30219":71720,"_20927":121146,"_5":14373,"_27457":121046,"_2948":54292},[],{"_3465":71759,"_30219":71720,"_20927":121148,"_5":14373,"_27457":121046,"_2948":121149},[],"1 hora.",{"_3465":71760,"_30219":71720,"_20927":121151,"_5":14373,"_27457":121046,"_2948":54298},[],{"_3465":71761,"_30219":71720,"_20927":121153,"_5":14373,"_27457":121046,"_2948":121154},[],"30 minutos / 10 minutos.",{"_3465":71762,"_30219":71720,"_20927":121156,"_5":14373,"_27457":121046,"_2948":54304},[],{"_3465":71763,"_30219":71720,"_20927":121158,"_5":14373,"_27457":121046,"_2948":121159},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3465":71764,"_30219":71720,"_20927":121161,"_5":14373,"_27457":121046,"_2948":52062},[],{"_3465":71765,"_30219":71720,"_20927":121163,"_5":14373,"_27457":121046,"_2948":121164},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3465":71766,"_30219":71720,"_20927":121166,"_5":14373,"_27457":121046,"_2948":54315},[],{"_3465":71767,"_30219":71720,"_20927":121168,"_5":14373,"_27457":121046,"_2948":121169},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3465":71768,"_30219":71720,"_20927":121171,"_5":14373,"_27457":121046,"_2948":121172},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3465":71769,"_30219":71720,"_20927":121174,"_5":14373,"_27457":121050,"_2948":121175},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3465":71770,"_30219":71720,"_20927":121177,"_5":14373,"_27457":121050,"_2948":121178},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3465":71771,"_30219":71720,"_20927":121180,"_5":14373,"_27457":121054,"_2948":121181},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3465":71772,"_30219":71720,"_20927":121183,"_5":14373,"_27457":121054,"_2948":121184},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3465":71773,"_30219":71720,"_20927":121186,"_5":14373,"_27457":121054,"_2948":121187},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3465":71774,"_30219":71720,"_20927":121189,"_5":14373,"_27457":121058,"_2948":121190},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3465":71775,"_30219":71720,"_20927":121192,"_5":14373,"_27457":121058,"_2948":121193},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3465":71776,"_30219":71720,"_20927":121195,"_5":14373,"_27457":121062,"_2948":121196},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3465":71777,"_30219":71720,"_20927":121198,"_5":14373,"_27457":121062,"_2948":121199},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3465":71778,"_30219":71720,"_20927":121201,"_5":14373,"_27457":121062,"_2948":121202},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3465":71779,"_30219":71720,"_20927":121204,"_5":14373,"_27457":121062,"_2948":121205},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3465":71780,"_30219":71720,"_20927":121207,"_5":14373,"_27457":121062,"_2948":121208},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3465":71781,"_30219":71720,"_20927":121210,"_5":14373,"_27457":121066,"_2948":121211},[],"Comprobación",{"_3465":71782,"_30219":71720,"_20927":121213,"_5":14373,"_27457":121066,"_2948":121214},[],"Resultado esperado",{"_3465":71783,"_30219":71720,"_20927":121216,"_5":14373,"_27457":121066,"_2948":121217},[],"Registro",{"_3465":71784,"_30219":71720,"_20927":121219,"_5":14373,"_27457":121066,"_2948":121220},[],"ID creado automáticamente y DMS correcto.",{"_3465":71785,"_30219":71720,"_20927":121222,"_5":14373,"_27457":121066,"_2948":120507},[],{"_3465":71786,"_30219":71720,"_20927":121224,"_5":14373,"_27457":121066,"_2948":121225},[],"CN, perfil, serie y clave verificados.",{"_3465":71787,"_30219":71720,"_20927":121227,"_5":14373,"_27457":121066,"_2948":121228},[],"Inventario",{"_3465":71788,"_30219":71720,"_20927":121230,"_5":14373,"_27457":121066,"_2948":121231},[],"Serie recibida visible como identidad actual y en el historial.",{"_3465":71789,"_30219":71720,"_20927":121233,"_5":14373,"_27457":121066,"_2948":121234},[],"Consumidor",{"_3465":71790,"_30219":71720,"_20927":121236,"_5":14373,"_27457":121066,"_2948":121237},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3465":71791,"_30219":71720,"_20927":121239,"_5":14373,"_27457":121066,"_2948":121240},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3465":71792,"_30219":71720,"_20927":121242,"_5":14373,"_27457":121066,"_2948":121243},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3465":71793,"_30219":71793,"_5":14725,"_2948":118733,"_30551":121245,"_20927":121246,"_27457":71793},[49254,117704,51743,121032],[],{"_3465":71794,"_30219":71793,"_20927":121248,"_5":14373,"_27457":71793,"_2948":121249},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3465":71795,"_30219":71793,"_5":30548,"_20927":121251,"_27457":121252,"_2948":116275},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3465":71796,"_30219":71793,"_5":30548,"_20927":121254,"_27457":121255,"_2948":121256},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3465":71797,"_30219":71793,"_5":30548,"_20927":121258,"_27457":121259,"_2948":121260},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3465":71798,"_30219":71793,"_5":30548,"_20927":121262,"_27457":121263,"_2948":121264},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3465":71799,"_30219":71793,"_5":30548,"_20927":121266,"_27457":121267,"_2948":121268},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3465":71800,"_30219":71793,"_5":30548,"_20927":121270,"_27457":121271,"_2948":121272},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3465":71801,"_30219":71793,"_5":30548,"_20927":121274,"_27457":121275,"_2948":121214},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3465":71802,"_30219":71793,"_5":30548,"_20927":121277,"_27457":121278,"_2948":121279},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3465":71803,"_30219":71793,"_5":30548,"_20927":121281,"_27457":121282,"_2948":121283},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3465":71804,"_30219":71793,"_20927":121285,"_5":14373,"_27457":71793,"_2948":121286},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3465":71805,"_30219":71793,"_20927":121288,"_5":14373,"_27457":71793,"_2948":121289},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3465":71806,"_30219":71793,"_20927":121291,"_5":14373,"_27457":121252,"_2948":121292},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3465":71807,"_30219":71793,"_20927":121294,"_5":14373,"_27457":121252,"_2948":121295},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3465":71808,"_30219":71793,"_20927":121297,"_5":14373,"_27457":121252,"_2948":121298},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3465":71809,"_30219":71793,"_20927":121300,"_5":14373,"_27457":121252,"_2948":121301},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3465":71810,"_30219":71793,"_20927":121303,"_5":14373,"_27457":121255,"_2948":121304},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3465":71811,"_30219":71793,"_20927":121306,"_5":14373,"_27457":121255,"_2948":121307},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3465":71812,"_30219":71793,"_20927":121309,"_5":14373,"_27457":121255,"_2948":121310},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3465":71813,"_30219":71793,"_20927":121312,"_5":14373,"_27457":121255,"_2948":121313},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3465":71814,"_30219":71793,"_20927":121315,"_5":14373,"_27457":121255,"_2948":121316},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3465":71815,"_30219":71793,"_20927":121318,"_5":14373,"_27457":121255,"_2948":121319},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3465":71816,"_30219":71793,"_20927":121321,"_5":14373,"_27457":121255,"_2948":121322},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3465":71817,"_30219":71793,"_20927":121324,"_5":14373,"_27457":121255,"_2948":121325},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3465":71818,"_30219":71793,"_20927":121327,"_5":14373,"_27457":121259,"_2948":121328},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3465":71819,"_30219":71793,"_20927":121330,"_5":14373,"_27457":121259,"_2948":54480},[],{"_3465":71820,"_30219":71793,"_20927":121332,"_5":14373,"_27457":121259,"_2948":121333},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3465":71821,"_30219":71793,"_20927":121335,"_5":14373,"_27457":121259,"_2948":121336},[],"**Icon** y **Tags**: clasificación opcional.",{"_3465":71822,"_30219":71793,"_20927":121338,"_5":14373,"_27457":121259,"_2948":121339},[],"Confirma el registro.",{"_3465":71823,"_30219":71793,"_20927":121341,"_5":14373,"_27457":121263,"_2948":121342},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3465":71824,"_30219":71793,"_20927":121344,"_5":14373,"_27457":121263,"_2948":121345},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3465":71825,"_30219":71793,"_20927":121347,"_5":14373,"_27457":121267,"_2948":121348},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3465":71826,"_30219":71793,"_20927":121350,"_5":14373,"_27457":121267,"_2948":121351},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3465":71827,"_30219":71793,"_20927":121353,"_5":14373,"_27457":121271,"_2948":121354},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3465":71828,"_30219":71793,"_20927":121356,"_5":14373,"_27457":121271,"_2948":121357},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3465":71829,"_30219":71793,"_20927":121359,"_5":14373,"_27457":121275,"_2948":121211},[],{"_3465":71830,"_30219":71793,"_20927":121361,"_5":14373,"_27457":121275,"_2948":121362},[],"Resultado",{"_3465":71831,"_30219":71793,"_20927":121364,"_5":14373,"_27457":121275,"_2948":120493},[],{"_3465":71832,"_30219":71793,"_20927":121366,"_5":14373,"_27457":121275,"_2948":121367},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3465":71833,"_30219":71793,"_20927":121369,"_5":14373,"_27457":121275,"_2948":121370},[],"Identidad actual",{"_3465":71834,"_30219":71793,"_20927":121372,"_5":14373,"_27457":121275,"_2948":121373},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3465":71835,"_30219":71793,"_20927":121375,"_5":14373,"_27457":121275,"_2948":121376},[],"Historial",{"_3465":71836,"_30219":71793,"_20927":121378,"_5":14373,"_27457":121275,"_2948":121379},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3465":71837,"_30219":71793,"_20927":121381,"_5":14373,"_27457":121275,"_2948":121382},[],"Clave y certificado",{"_3465":71838,"_30219":71793,"_20927":121384,"_5":14373,"_27457":121275,"_2948":121385},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3465":71839,"_30219":71793,"_20927":121387,"_5":14373,"_27457":121278,"_2948":121388},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3465":71840,"_30219":71793,"_20927":121390,"_5":14373,"_27457":121278,"_2948":121391},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3465":71841,"_30219":71793,"_20927":121393,"_5":14373,"_27457":121278,"_2948":121394},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3465":71842,"_30219":71793,"_20927":121396,"_5":14373,"_27457":121278,"_2948":121397},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3465":71843,"_30219":71793,"_20927":121399,"_5":14373,"_27457":121282,"_2948":121400},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3465":71844,"_30219":71793,"_20927":121402,"_5":14373,"_27457":121282,"_2948":121403},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3465":71845,"_30219":71793,"_20927":121405,"_5":14373,"_27457":121282,"_2948":121406},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3465":71846,"_30219":71846,"_5":14725,"_2948":121408,"_30551":121409,"_20927":121410,"_27457":71846},"Plataforma Lamassu IoT",[49254,117704],[],{"_3465":71847,"_30219":71846,"_20927":121412,"_5":14373,"_27457":71846,"_2948":121413},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3465":71848,"_30219":71846,"_5":30548,"_20927":121415,"_27457":121416,"_2948":120908},[],"/docs/es/platform/overview#empieza-aquí",{"_3465":71849,"_30219":71846,"_5":30548,"_20927":121418,"_27457":121419,"_2948":121420},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3465":71850,"_30219":71846,"_5":30548,"_20927":121422,"_27457":121423,"_2948":121424},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3465":71851,"_30219":71846,"_5":30548,"_20927":121426,"_27457":121427,"_2948":121428},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3465":71852,"_30219":71846,"_5":30548,"_20927":121430,"_27457":121431,"_2948":121432},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3465":71853,"_30219":71846,"_5":30548,"_20927":121434,"_27457":121435,"_2948":121436},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3465":71854,"_30219":71846,"_5":30548,"_20927":121438,"_27457":121439,"_2948":121440},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3465":71855,"_30219":71846,"_5":30548,"_20927":121442,"_27457":121443,"_2948":121444},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3465":71856,"_30219":71846,"_5":30548,"_20927":121446,"_27457":121447,"_2948":121448},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3465":71857,"_30219":71846,"_5":30548,"_20927":121450,"_27457":121451,"_2948":121452},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3465":71858,"_30219":71846,"_5":30548,"_20927":121454,"_27457":121455,"_2948":121456},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3465":71859,"_30219":71846,"_20927":121458,"_5":14373,"_27457":71846,"_2948":121459},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3465":71860,"_30219":71846,"_20927":121461,"_5":14373,"_27457":121416,"_2948":121462},[],"Elige el resultado que necesitas obtener:",{"_3465":71861,"_30219":71846,"_20927":121464,"_5":14373,"_27457":121416,"_2948":121465},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":71862,"_30219":71846,"_20927":121467,"_5":14373,"_27457":121416,"_2948":121468},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":71863,"_30219":71846,"_20927":121470,"_5":14373,"_27457":121416,"_2948":121471},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3465":71864,"_30219":71846,"_20927":121473,"_5":14373,"_27457":121419,"_2948":121474},[],"Bloque",{"_3465":71865,"_30219":71846,"_20927":121476,"_5":14373,"_27457":121419,"_2948":121477},[],"Qué gestionas",{"_3465":71866,"_30219":71846,"_20927":121479,"_5":14373,"_27457":121419,"_2948":121480},[],"Punto de entrada",{"_3465":71867,"_30219":71846,"_20927":121482,"_5":14373,"_27457":121419,"_2948":54633},[],{"_3465":71868,"_30219":71846,"_20927":121484,"_5":14373,"_27457":121419,"_2948":121485},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3465":71869,"_30219":71846,"_20927":121487,"_5":14373,"_27457":121419,"_2948":121488},[],"Visión general de PKI",{"_3465":71870,"_30219":71846,"_20927":121490,"_5":14373,"_27457":121419,"_2948":54642},[],{"_3465":71871,"_30219":71846,"_20927":121492,"_5":14373,"_27457":121419,"_2948":121493},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3465":71872,"_30219":71846,"_20927":121495,"_5":14373,"_27457":121419,"_2948":121496},[],"Visión general de IoT Fleets",{"_3465":71873,"_30219":71846,"_20927":121498,"_5":14373,"_27457":121419,"_2948":121499},[],"**Administración**",{"_3465":71874,"_30219":71846,"_20927":121501,"_5":14373,"_27457":121419,"_2948":121502},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3465":71875,"_30219":71846,"_20927":121504,"_5":14373,"_27457":121419,"_2948":117702},[],{"_3465":71876,"_30219":71846,"_20927":121506,"_5":14373,"_27457":121419,"_2948":121507},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3465":71877,"_30219":71846,"_20927":121509,"_5":14373,"_27457":121423,"_2948":121510},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3465":71878,"_30219":71846,"_20927":121512,"_5":14373,"_27457":121423,"_2948":121513},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3465":71879,"_30219":71846,"_20927":121515,"_5":14373,"_27457":121423,"_2948":121516},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3465":71880,"_30219":71846,"_20927":121518,"_5":14373,"_27457":121423,"_2948":121519},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3465":71881,"_30219":71846,"_20927":121521,"_5":14373,"_27457":121423,"_2948":121522},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3465":71882,"_30219":71846,"_20927":121524,"_5":14373,"_27457":121423,"_2948":121525},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3465":71883,"_30219":71846,"_20927":121527,"_5":14373,"_27457":121431,"_2948":121528},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3465":71884,"_30219":71846,"_20927":121530,"_5":14373,"_27457":121435,"_2948":121531},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3465":71885,"_30219":71846,"_20927":121533,"_5":14373,"_27457":121439,"_2948":121534},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3465":71886,"_30219":71846,"_20927":121536,"_5":14373,"_27457":121443,"_2948":121537},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3465":71887,"_30219":71846,"_20927":121539,"_5":14373,"_27457":121447,"_2948":121540},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3465":71888,"_30219":71846,"_20927":121542,"_5":14373,"_27457":121451,"_2948":121543},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3465":71889,"_30219":71846,"_20927":121545,"_5":14373,"_27457":121455,"_2948":121001},[],{"_3465":71890,"_30219":71846,"_20927":121547,"_5":14373,"_27457":121455,"_2948":121548},[],"Qué prepara o comprueba",{"_3465":71891,"_30219":71846,"_20927":121550,"_5":14373,"_27457":121455,"_2948":121004},[],{"_3465":71892,"_30219":71846,"_20927":121552,"_5":14373,"_27457":121455,"_2948":121553},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3465":71893,"_30219":71846,"_20927":121555,"_5":14373,"_27457":121455,"_2948":121556},[],"Administrador de la flota",{"_3465":71894,"_30219":71846,"_20927":121558,"_5":14373,"_27457":121455,"_2948":121559},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3465":71895,"_30219":71846,"_20927":121561,"_5":14373,"_27457":121455,"_2948":121016},[],{"_3465":71896,"_30219":71846,"_20927":121563,"_5":14373,"_27457":121455,"_2948":121564},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3465":71897,"_30219":71846,"_20927":121566,"_5":14373,"_27457":121455,"_2948":121022},[],{"_3465":71898,"_30219":71846,"_20927":121568,"_5":14373,"_27457":121455,"_2948":121569},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3465":71899,"_30219":71846,"_20927":121571,"_5":14373,"_27457":121455,"_2948":121572},[],"Operador de infraestructura",{"_3465":71900,"_30219":71846,"_20927":121574,"_5":14373,"_27457":121455,"_2948":121575},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3465":71901,"_30219":71846,"_20927":121577,"_5":14373,"_27457":121455,"_2948":121578},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3465":71902,"_30219":71902,"_5":14725,"_2948":121580,"_30551":121581,"_20927":121583,"_27457":71902},"Jerarquía y rotación de CAs",[49254,117704,54734,121582],"Claves, autoridades y certificados",[],{"_3465":71903,"_30219":71902,"_20927":121585,"_5":14373,"_27457":71902,"_2948":121586},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3465":71904,"_30219":71902,"_5":30548,"_20927":121588,"_27457":121589,"_2948":121590},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3465":71905,"_30219":71902,"_5":30548,"_20927":121592,"_27457":121593,"_2948":121594},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3465":71906,"_30219":71902,"_5":30548,"_20927":121596,"_27457":121597,"_2948":121598},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3465":71907,"_30219":71902,"_5":30548,"_20927":121600,"_27457":121601,"_2948":121602},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3465":71908,"_30219":71902,"_5":30548,"_20927":121604,"_27457":121605,"_2948":121606},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3465":71909,"_30219":71902,"_5":30548,"_20927":121608,"_27457":121609,"_2948":121610},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3465":71910,"_30219":71902,"_5":30548,"_20927":121612,"_27457":121613,"_2948":121614},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3465":71911,"_30219":71902,"_5":30548,"_20927":121616,"_27457":121617,"_2948":121618},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3465":71912,"_30219":71902,"_5":30548,"_20927":121620,"_27457":121621,"_2948":121622},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3465":71913,"_30219":71902,"_5":30548,"_20927":121624,"_27457":121625,"_2948":121626},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3465":71914,"_30219":71902,"_5":30548,"_20927":121628,"_27457":121629,"_2948":121630},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3465":71915,"_30219":71902,"_5":30548,"_20927":121632,"_27457":121633,"_2948":121634},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3465":71916,"_30219":71902,"_20927":121636,"_5":14373,"_27457":71902,"_2948":121637},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3465":71917,"_30219":71902,"_20927":121639,"_5":14373,"_27457":71902,"_2948":121640},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3465":71918,"_30219":71902,"_20927":121642,"_5":14373,"_27457":121589,"_2948":121643},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3465":71919,"_30219":71902,"_20927":121645,"_5":14373,"_27457":121589,"_2948":121646},[],"entorno, como producción y preproducción;",{"_3465":71920,"_30219":71902,"_20927":121648,"_5":14373,"_27457":121589,"_2948":121649},[],"propietario o equipo operador;",{"_3465":71921,"_30219":71902,"_20927":121651,"_5":14373,"_27457":121589,"_2948":121652},[],"familia de dispositivos o proceso de fabricación;",{"_3465":71922,"_30219":71902,"_20927":121654,"_5":14373,"_27457":121589,"_2948":121655},[],"región o requisito regulatorio;",{"_3465":71923,"_30219":71902,"_20927":121657,"_5":14373,"_27457":121589,"_2948":121658},[],"motor criptográfico o política de clave;",{"_3465":71924,"_30219":71902,"_20927":121660,"_5":14373,"_27457":121589,"_2948":121661},[],"ventana de mantenimiento y ritmo de renovación.",{"_3465":71925,"_30219":71902,"_20927":121663,"_5":14373,"_27457":121589,"_2948":121664},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3465":71926,"_30219":71902,"_20927":121666,"_5":14373,"_27457":121589,"_2948":121667},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3465":71927,"_30219":71902,"_20927":121669,"_5":14373,"_27457":121593,"_2948":121670},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3465":71928,"_30219":71902,"_20927":121672,"_5":14373,"_27457":121593,"_2948":121673},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3465":71929,"_30219":71902,"_20927":121675,"_5":14373,"_27457":121593,"_2948":121676},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3465":71930,"_30219":71902,"_20927":121678,"_5":14373,"_27457":121593,"_2948":121679},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3465":71931,"_30219":71902,"_20927":121681,"_5":14373,"_27457":121597,"_2948":121682},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3465":71932,"_30219":71902,"_20927":121684,"_5":14373,"_27457":121597,"_2948":121685},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3465":71933,"_30219":71902,"_20927":121687,"_5":14373,"_27457":121597,"_2948":121688},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3465":71934,"_30219":71902,"_20927":121690,"_5":14373,"_27457":121597,"_2948":121691},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3465":71935,"_30219":71902,"_20927":121693,"_5":14373,"_27457":121605,"_2948":121694},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3465":71936,"_30219":71902,"_20927":121696,"_5":14373,"_27457":121609,"_2948":121697},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3465":71937,"_30219":71902,"_20927":121699,"_5":14373,"_27457":121613,"_2948":121700},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3465":71938,"_30219":71902,"_20927":121702,"_5":14373,"_27457":121617,"_2948":121703},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3465":71939,"_30219":71902,"_20927":121705,"_5":14373,"_27457":121621,"_2948":121706},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3465":71940,"_30219":71902,"_20927":121708,"_5":14373,"_27457":121625,"_2948":121709},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3465":71941,"_30219":71902,"_20927":121711,"_5":14373,"_27457":121629,"_2948":121712},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3465":71942,"_30219":71902,"_20927":121714,"_5":14373,"_27457":121629,"_2948":121715},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3465":71943,"_30219":71902,"_20927":121717,"_5":14373,"_27457":121629,"_2948":121718},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3465":71944,"_30219":71902,"_20927":121720,"_5":14373,"_27457":121629,"_2948":121721},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3465":71945,"_30219":71902,"_20927":121723,"_5":14373,"_27457":121633,"_2948":121724},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3465":71946,"_30219":71902,"_20927":121726,"_5":14373,"_27457":121633,"_2948":121727},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3465":71947,"_30219":71902,"_20927":121729,"_5":14373,"_27457":121633,"_2948":121730},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3465":71948,"_30219":71902,"_20927":121732,"_5":14373,"_27457":121633,"_2948":121733},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3465":71949,"_30219":71902,"_20927":121735,"_5":14373,"_27457":121633,"_2948":121736},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3465":71950,"_30219":71902,"_20927":121738,"_5":14373,"_27457":121633,"_2948":121739},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3465":71951,"_30219":71902,"_20927":121741,"_5":14373,"_27457":121633,"_2948":121742},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3465":71952,"_30219":71952,"_5":14725,"_2948":121744,"_30551":121745,"_20927":121746,"_27457":71952},"Autoridades de certificación",[49254,117704,54734,121582],[],{"_3465":71953,"_30219":71952,"_20927":121748,"_5":14373,"_27457":71952,"_2948":121749},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3465":71954,"_30219":71952,"_5":30548,"_20927":121751,"_27457":121752,"_2948":121753},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3465":71955,"_30219":71952,"_5":30548,"_20927":121755,"_27457":121756,"_2948":121757},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3465":71956,"_30219":71952,"_5":30548,"_20927":121759,"_27457":121760,"_2948":116275},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3465":71957,"_30219":71952,"_5":30548,"_20927":121762,"_27457":121763,"_2948":121764},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3465":71958,"_30219":71952,"_5":30548,"_20927":121766,"_27457":121767,"_2948":121768},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3465":71959,"_30219":71952,"_5":30548,"_20927":121770,"_27457":121771,"_2948":121772},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3465":71960,"_30219":71952,"_5":30548,"_20927":121774,"_27457":121775,"_2948":121776},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3465":71961,"_30219":71952,"_5":30548,"_20927":121778,"_27457":121779,"_2948":121780},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3465":71962,"_30219":71952,"_5":30548,"_20927":121782,"_27457":121783,"_2948":121784},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3465":71963,"_30219":71952,"_5":30548,"_20927":121786,"_27457":121787,"_2948":121788},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3465":71964,"_30219":71952,"_5":30548,"_20927":121790,"_27457":121791,"_2948":121792},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3465":71965,"_30219":71952,"_5":30548,"_20927":121794,"_27457":121795,"_2948":121796},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3465":71966,"_30219":71952,"_5":30548,"_20927":121798,"_27457":121799,"_2948":121800},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3465":71967,"_30219":71952,"_5":30548,"_20927":121802,"_27457":121803,"_2948":121804},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3465":71968,"_30219":71952,"_5":30548,"_20927":121806,"_27457":121807,"_2948":121808},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3465":71969,"_30219":71952,"_5":30548,"_20927":121810,"_27457":121811,"_2948":121812},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3465":71970,"_30219":71952,"_5":30548,"_20927":121814,"_27457":121815,"_2948":121816},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3465":71971,"_30219":71952,"_5":30548,"_20927":121818,"_27457":121819,"_2948":121820},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3465":71972,"_30219":71952,"_5":30548,"_20927":121822,"_27457":121823,"_2948":121824},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3465":71973,"_30219":71952,"_5":30548,"_20927":121826,"_27457":121827,"_2948":121828},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3465":71974,"_30219":71952,"_5":30548,"_20927":121830,"_27457":121831,"_2948":121832},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3465":71975,"_30219":71952,"_5":30548,"_20927":121834,"_27457":121835,"_2948":121836},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3465":71976,"_30219":71952,"_5":30548,"_20927":121838,"_27457":121839,"_2948":121840},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3465":71977,"_30219":71952,"_20927":121842,"_5":14373,"_27457":71952,"_2948":121843},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3465":71978,"_30219":71952,"_20927":121845,"_5":14373,"_27457":71952,"_2948":121846},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3465":71979,"_30219":71952,"_20927":121848,"_5":14373,"_27457":71952,"_2948":121849},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3465":71980,"_30219":71952,"_20927":121851,"_5":14373,"_27457":121752,"_2948":121852},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3465":71981,"_30219":71952,"_20927":121854,"_5":14373,"_27457":121752,"_2948":121855},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3465":71982,"_30219":71952,"_20927":121857,"_5":14373,"_27457":121752,"_2948":121858},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3465":71983,"_30219":71952,"_20927":121860,"_5":14373,"_27457":121752,"_2948":121861},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3465":71984,"_30219":71952,"_20927":121863,"_5":14373,"_27457":121752,"_2948":121864},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3465":71985,"_30219":71952,"_20927":121866,"_5":14373,"_27457":121760,"_2948":121867},[],"Decide si la CA será raíz o intermedia.",{"_3465":71986,"_30219":71952,"_20927":121869,"_5":14373,"_27457":121760,"_2948":121870},[],"Elige el motor que custodiará la clave.",{"_3465":71987,"_30219":71952,"_20927":121872,"_5":14373,"_27457":121760,"_2948":121873},[],"Define una validez superior a la de los certificados que emitirá.",{"_3465":71988,"_30219":71952,"_20927":121875,"_5":14373,"_27457":121760,"_2948":121876},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3465":71989,"_30219":71952,"_20927":121878,"_5":14373,"_27457":121763,"_2948":121879},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3465":71990,"_30219":71952,"_20927":121881,"_5":14373,"_27457":121767,"_2948":121882},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3465":71991,"_30219":71952,"_20927":121884,"_5":14373,"_27457":121767,"_2948":121885},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3465":71992,"_30219":71952,"_20927":121887,"_5":14373,"_27457":121771,"_2948":121888},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3465":71993,"_30219":71952,"_20927":121890,"_5":14373,"_27457":121775,"_2948":121891},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3465":71994,"_30219":71952,"_20927":121893,"_5":14373,"_27457":121775,"_2948":121894},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3465":71995,"_30219":71952,"_20927":121896,"_5":14373,"_27457":121775,"_2948":121897},[],"`ST`: estado o provincia.",{"_3465":71996,"_30219":71952,"_20927":121899,"_5":14373,"_27457":121775,"_2948":121900},[],"`L`: localidad.",{"_3465":71997,"_30219":71952,"_20927":121902,"_5":14373,"_27457":121775,"_2948":121903},[],"`O`: organización.",{"_3465":71998,"_30219":71952,"_20927":121905,"_5":14373,"_27457":121775,"_2948":121906},[],"`OU`: unidad organizativa.",{"_3465":71999,"_30219":71952,"_20927":121908,"_5":14373,"_27457":121775,"_2948":121909},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3465":72000,"_30219":71952,"_20927":121911,"_5":14373,"_27457":121779,"_2948":121912},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3465":72001,"_30219":71952,"_20927":121914,"_5":14373,"_27457":121779,"_2948":121915},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3465":72002,"_30219":71952,"_20927":121917,"_5":14373,"_27457":121783,"_2948":121918},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3465":72003,"_30219":71952,"_20927":121920,"_5":14373,"_27457":121783,"_2948":121921},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3465":72004,"_30219":71952,"_20927":121923,"_5":14373,"_27457":121787,"_2948":121924},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3465":72005,"_30219":71952,"_20927":121926,"_5":14373,"_27457":121787,"_2948":121927},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3465":72006,"_30219":71952,"_20927":121929,"_5":14373,"_27457":121791,"_2948":121930},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3465":72007,"_30219":71952,"_20927":121932,"_5":14373,"_27457":121791,"_2948":121933},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3465":72008,"_30219":71952,"_20927":121935,"_5":14373,"_27457":121791,"_2948":121936},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3465":72009,"_30219":71952,"_20927":121938,"_5":14373,"_27457":121795,"_2948":121939},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3465":72010,"_30219":71952,"_20927":121941,"_5":14373,"_27457":121799,"_2948":121942},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3465":72011,"_30219":71952,"_20927":121944,"_5":14373,"_27457":121799,"_2948":121945},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3465":72012,"_30219":71952,"_20927":121947,"_5":14373,"_27457":121803,"_2948":121948},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3465":72013,"_30219":71952,"_20927":121950,"_5":14373,"_27457":121807,"_2948":121951},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3465":72014,"_30219":71952,"_20927":121953,"_5":14373,"_27457":121807,"_2948":121954},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3465":72015,"_30219":71952,"_20927":121956,"_5":14373,"_27457":121811,"_2948":121957},[],"Abre una CA desde el inventario para consultar:",{"_3465":72016,"_30219":71952,"_20927":121959,"_5":14373,"_27457":121811,"_2948":121960},[],"Estado y periodo de validez.",{"_3465":72017,"_30219":71952,"_20927":121962,"_5":14373,"_27457":121811,"_2948":121963},[],"Certificado y cadena en formato PEM.",{"_3465":72018,"_30219":71952,"_20927":121965,"_5":14373,"_27457":121811,"_2948":121966},[],"Número de certificados activos, expirados y revocados.",{"_3465":72019,"_30219":71952,"_20927":121968,"_5":14373,"_27457":121811,"_2948":121969},[],"Certificados emitidos en **Issued Certificates**.",{"_3465":72020,"_30219":71952,"_20927":121971,"_5":14373,"_27457":121811,"_2948":121972},[],"CRL vinculada a la autoridad.",{"_3465":72021,"_30219":71952,"_20927":121974,"_5":14373,"_27457":121811,"_2948":121975},[],"Metadatos y motor criptográfico asociado.",{"_3465":72022,"_30219":71952,"_20927":121977,"_5":14373,"_27457":121811,"_2948":121978},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3465":72023,"_30219":71952,"_20927":121980,"_5":14373,"_27457":121815,"_2948":121981},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3465":72024,"_30219":71952,"_20927":121983,"_5":14373,"_27457":121815,"_2948":121984},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3465":72025,"_30219":71952,"_20927":121986,"_5":14373,"_27457":121815,"_2948":121987},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3465":72026,"_30219":71952,"_20927":121989,"_5":14373,"_27457":121815,"_2948":121990},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3465":72027,"_30219":71952,"_20927":121992,"_5":14373,"_27457":121819,"_2948":121993},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3465":72028,"_30219":71952,"_20927":121995,"_5":14373,"_27457":121823,"_2948":121996},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3465":72029,"_30219":71952,"_20927":121998,"_5":14373,"_27457":121827,"_2948":121999},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3465":72030,"_30219":71952,"_20927":122001,"_5":14373,"_27457":121831,"_2948":122002},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3465":72031,"_30219":71952,"_20927":122004,"_5":14373,"_27457":121835,"_2948":122005},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3465":72032,"_30219":71952,"_20927":122007,"_5":14373,"_27457":121839,"_2948":122008},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3465":72033,"_30219":71952,"_20927":122010,"_5":14373,"_27457":121839,"_2948":122011},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3465":72034,"_30219":71952,"_20927":122013,"_5":14373,"_27457":121839,"_2948":122014},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3465":72035,"_30219":72035,"_5":14725,"_2948":122016,"_30551":122017,"_20927":122018,"_27457":72035},"Perfiles de certificado",[49254,117704,54734,121582],[],{"_3465":72036,"_30219":72035,"_20927":122020,"_5":14373,"_27457":72035,"_2948":122021},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3465":72037,"_30219":72035,"_5":30548,"_20927":122023,"_27457":122024,"_2948":122025},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3465":72038,"_30219":72035,"_5":30548,"_20927":122027,"_27457":122028,"_2948":122029},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3465":72039,"_30219":72035,"_5":30548,"_20927":122031,"_27457":122032,"_2948":122033},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3465":72040,"_30219":72035,"_5":30548,"_20927":122035,"_27457":122036,"_2948":122037},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3465":72041,"_30219":72035,"_5":30548,"_20927":122039,"_27457":122040,"_2948":122041},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3465":72042,"_30219":72035,"_5":30548,"_20927":122043,"_27457":122044,"_2948":122045},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3465":72043,"_30219":72035,"_5":30548,"_20927":122047,"_27457":122048,"_2948":122049},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3465":72044,"_30219":72035,"_5":30548,"_20927":122051,"_27457":122052,"_2948":122053},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3465":72045,"_30219":72035,"_5":30548,"_20927":122055,"_27457":122056,"_2948":122057},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3465":72046,"_30219":72035,"_5":30548,"_20927":122059,"_27457":122060,"_2948":122061},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3465":72047,"_30219":72035,"_5":30548,"_20927":122063,"_27457":122064,"_2948":122065},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3465":72048,"_30219":72035,"_5":30548,"_20927":122067,"_27457":122068,"_2948":122069},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3465":72049,"_30219":72035,"_5":30548,"_20927":122071,"_27457":122072,"_2948":122073},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3465":72050,"_30219":72035,"_5":30548,"_20927":122075,"_27457":122076,"_2948":122077},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3465":72051,"_30219":72035,"_5":30548,"_20927":122079,"_27457":122080,"_2948":122081},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3465":72052,"_30219":72035,"_5":30548,"_20927":122083,"_27457":122084,"_2948":122085},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3465":72053,"_30219":72035,"_20927":122087,"_5":14373,"_27457":72035,"_2948":122088},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3465":72054,"_30219":72035,"_20927":122090,"_5":14373,"_27457":72035,"_2948":122091},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3465":72055,"_30219":72035,"_20927":122093,"_5":14373,"_27457":122028,"_2948":122094},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3465":72056,"_30219":72035,"_20927":122096,"_5":14373,"_27457":122028,"_2948":122097},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3465":72057,"_30219":72035,"_20927":122099,"_5":14373,"_27457":122032,"_2948":122100},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3465":72058,"_30219":72035,"_20927":122102,"_5":14373,"_27457":122036,"_2948":122103},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3465":72059,"_30219":72035,"_20927":122105,"_5":14373,"_27457":122036,"_2948":122106},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3465":72060,"_30219":72035,"_20927":122108,"_5":14373,"_27457":122036,"_2948":122109},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3465":72061,"_30219":72035,"_20927":122111,"_5":14373,"_27457":122040,"_2948":122112},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3465":72062,"_30219":72035,"_20927":122114,"_5":14373,"_27457":122044,"_2948":122115},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3465":72063,"_30219":72035,"_20927":122117,"_5":14373,"_27457":122044,"_2948":122118},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3465":72064,"_30219":72035,"_20927":122120,"_5":14373,"_27457":122048,"_2948":122121},[],"La aplicación criptográfica puede:",{"_3465":72065,"_30219":72035,"_20927":122123,"_5":14373,"_27457":122048,"_2948":122124},[],"permitir o bloquear claves RSA;",{"_3465":72066,"_30219":72035,"_20927":122126,"_5":14373,"_27457":122048,"_2948":122127},[],"limitar los tamaños RSA admitidos;",{"_3465":72067,"_30219":72035,"_20927":122129,"_5":14373,"_27457":122048,"_2948":122130},[],"permitir o bloquear claves ECDSA;",{"_3465":72068,"_30219":72035,"_20927":122132,"_5":14373,"_27457":122048,"_2948":122133},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3465":72069,"_30219":72035,"_20927":122135,"_5":14373,"_27457":122048,"_2948":122136},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3465":72070,"_30219":72035,"_20927":122138,"_5":14373,"_27457":122052,"_2948":122139},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3465":72071,"_30219":72035,"_20927":122141,"_5":14373,"_27457":122052,"_2948":117464},[],{"_3465":72072,"_30219":72035,"_20927":122143,"_5":14373,"_27457":122052,"_2948":122144},[],"Primera opción",{"_3465":72073,"_30219":72035,"_20927":122146,"_5":14373,"_27457":122052,"_2948":122147},[],"Segunda opción",{"_3465":72074,"_30219":72035,"_20927":122149,"_5":14373,"_27457":122052,"_2948":122150},[],"Si no hay ninguna",{"_3465":72075,"_30219":72035,"_20927":122152,"_5":14373,"_27457":122052,"_2948":122153},[],"Firma directa con una CA",{"_3465":72076,"_30219":72035,"_20927":122155,"_5":14373,"_27457":122052,"_2948":122156},[],"`issuance_profile` incluido en la solicitud",{"_3465":72077,"_30219":72035,"_20927":122158,"_5":14373,"_27457":122052,"_2948":122159},[],"`issuance_profile_id` de la solicitud",{"_3465":72078,"_30219":72035,"_20927":122161,"_5":14373,"_27457":122052,"_2948":122162},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3465":72079,"_30219":72035,"_20927":122164,"_5":14373,"_27457":122052,"_2948":122165},[],"Emisión mediante DMS",{"_3465":72080,"_30219":72035,"_20927":122167,"_5":14373,"_27457":122052,"_2948":55321},[],{"_3465":72081,"_30219":72035,"_20927":122169,"_5":14373,"_27457":122052,"_2948":122170},[],"`settings.issuance_profile` incluido en el DMS",{"_3465":72082,"_30219":72035,"_20927":122172,"_5":14373,"_27457":122052,"_2948":122173},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3465":72083,"_30219":72035,"_20927":122175,"_5":14373,"_27457":122052,"_2948":122176},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3465":72084,"_30219":72035,"_20927":122178,"_5":14373,"_27457":122052,"_2948":122179},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3465":72085,"_30219":72035,"_20927":122181,"_5":14373,"_27457":122060,"_2948":122182},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3465":72086,"_30219":72035,"_20927":122184,"_5":14373,"_27457":122064,"_2948":122185},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3465":72087,"_30219":72035,"_20927":122187,"_5":14373,"_27457":122068,"_2948":122188},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3465":72088,"_30219":72035,"_20927":122190,"_5":14373,"_27457":122072,"_2948":122191},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3465":72089,"_30219":72035,"_20927":122193,"_5":14373,"_27457":122076,"_2948":122194},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3465":72090,"_30219":72035,"_20927":122196,"_5":14373,"_27457":122076,"_2948":122197},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3465":72091,"_30219":72035,"_20927":122199,"_5":14373,"_27457":122080,"_2948":122200},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3465":72092,"_30219":72035,"_20927":122202,"_5":14373,"_27457":122080,"_2948":122203},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3465":72093,"_30219":72035,"_20927":122205,"_5":14373,"_27457":122080,"_2948":122206},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3465":72094,"_30219":72035,"_20927":122208,"_5":14373,"_27457":122080,"_2948":122209},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3465":72095,"_30219":72035,"_20927":122211,"_5":14373,"_27457":122084,"_2948":122212},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3465":72096,"_30219":72035,"_20927":122214,"_5":14373,"_27457":122084,"_2948":122215},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3465":72097,"_30219":72097,"_5":14725,"_2948":122217,"_30551":122218,"_20927":122220,"_27457":72097},"Validación de certificados",[49254,117704,54734,122219],"Validación",[],{"_3465":72098,"_30219":72097,"_20927":122222,"_5":14373,"_27457":72097,"_2948":122223},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3465":72099,"_30219":72097,"_5":30548,"_20927":122225,"_27457":122226,"_2948":122227},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3465":72100,"_30219":72097,"_5":30548,"_20927":122229,"_27457":122230,"_2948":122231},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3465":72101,"_30219":72097,"_5":30548,"_20927":122233,"_27457":122234,"_2948":122235},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3465":72102,"_30219":72097,"_20927":122237,"_5":14373,"_27457":72097,"_2948":122238},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3465":72103,"_30219":72097,"_20927":122240,"_5":14373,"_27457":122226,"_2948":122241},[],"Verifica estos criterios juntos:",{"_3465":72104,"_30219":72097,"_20927":122243,"_5":14373,"_27457":122226,"_2948":121211},[],{"_3465":72105,"_30219":72097,"_20927":122245,"_5":14373,"_27457":122226,"_2948":122246},[],"Resultado necesario",{"_3465":72106,"_30219":72097,"_20927":122248,"_5":14373,"_27457":122226,"_2948":122249},[],"Cadena y firma",{"_3465":72107,"_30219":72097,"_20927":122251,"_5":14373,"_27457":122226,"_2948":122252},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3465":72108,"_30219":72097,"_20927":122254,"_5":14373,"_27457":122226,"_2948":122255},[],"Fechas",{"_3465":72109,"_30219":72097,"_20927":122257,"_5":14373,"_27457":122226,"_2948":122258},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3465":72110,"_30219":72097,"_20927":122260,"_5":14373,"_27457":122226,"_2948":117374},[],{"_3465":72111,"_30219":72097,"_20927":122262,"_5":14373,"_27457":122226,"_2948":122263},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3465":72112,"_30219":72097,"_20927":122265,"_5":14373,"_27457":122226,"_2948":122266},[],"Uso",{"_3465":72113,"_30219":72097,"_20927":122268,"_5":14373,"_27457":122226,"_2948":122269},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3465":72114,"_30219":72097,"_20927":122271,"_5":14373,"_27457":122226,"_2948":122272},[],"Revocación",{"_3465":72115,"_30219":72097,"_20927":122274,"_5":14373,"_27457":122226,"_2948":122275},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3465":72116,"_30219":72097,"_20927":122277,"_5":14373,"_27457":122226,"_2948":122278},[],"Autorización",{"_3465":72117,"_30219":72097,"_20927":122280,"_5":14373,"_27457":122226,"_2948":122281},[],"La aplicación permite la acción a esa identidad.",{"_3465":72118,"_30219":72097,"_20927":122283,"_5":14373,"_27457":122226,"_2948":122284},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3465":72119,"_30219":72097,"_20927":122286,"_5":14373,"_27457":122230,"_2948":122287},[],"Mecanismo",{"_3465":72120,"_30219":72097,"_20927":122289,"_5":14373,"_27457":122230,"_2948":122290},[],"Cuándo utilizarlo",{"_3465":72121,"_30219":72097,"_20927":122292,"_5":14373,"_27457":122230,"_2948":122293},[],"Qué debes mantener",{"_3465":72122,"_30219":72097,"_20927":122295,"_5":14373,"_27457":122230,"_2948":55449},[],{"_3465":72123,"_30219":72097,"_20927":122297,"_5":14373,"_27457":122230,"_2948":122298},[],"Consulta del estado de un certificado concreto.",{"_3465":72124,"_30219":72097,"_20927":122300,"_5":14373,"_27457":122230,"_2948":122301},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3465":72125,"_30219":72097,"_20927":122303,"_5":14373,"_27457":122230,"_2948":55458},[],{"_3465":72126,"_30219":72097,"_20927":122305,"_5":14373,"_27457":122230,"_2948":122306},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3465":72127,"_30219":72097,"_20927":122308,"_5":14373,"_27457":122230,"_2948":122309},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3465":72128,"_30219":72097,"_20927":122311,"_5":14373,"_27457":122230,"_2948":122312},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3465":72129,"_30219":72097,"_20927":122314,"_5":14373,"_27457":122230,"_2948":122315},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3465":72130,"_30219":72097,"_20927":122317,"_5":14373,"_27457":122234,"_2948":122318},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3465":72131,"_30219":72097,"_20927":122320,"_5":14373,"_27457":122234,"_2948":122321},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3465":72132,"_30219":72097,"_20927":122323,"_5":14373,"_27457":122234,"_2948":122324},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3465":72133,"_30219":72097,"_20927":122326,"_5":14373,"_27457":122234,"_2948":122327},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3465":72134,"_30219":72097,"_20927":122329,"_5":14373,"_27457":122234,"_2948":122330},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3465":72135,"_30219":72097,"_20927":122332,"_5":14373,"_27457":122234,"_2948":122333},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3465":72136,"_30219":72097,"_20927":122335,"_5":14373,"_27457":122234,"_2948":122336},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3465":72137,"_30219":72097,"_20927":122338,"_5":14373,"_27457":122234,"_2948":122339},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72138,"_30219":72097,"_20927":122341,"_5":14373,"_27457":122234,"_2948":122342},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3465":72139,"_30219":72139,"_5":14725,"_2948":122344,"_30551":122345,"_20927":122346,"_27457":72139},"Certificados",[49254,117704,54734,121582],[],{"_3465":72140,"_30219":72139,"_20927":122348,"_5":14373,"_27457":72139,"_2948":122349},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3465":72141,"_30219":72139,"_5":30548,"_20927":122351,"_27457":122352,"_2948":122353},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3465":72142,"_30219":72139,"_5":30548,"_20927":122355,"_27457":122356,"_2948":122357},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3465":72143,"_30219":72139,"_5":30548,"_20927":122359,"_27457":122360,"_2948":122361},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3465":72144,"_30219":72139,"_5":30548,"_20927":122363,"_27457":122364,"_2948":122365},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3465":72145,"_30219":72139,"_5":30548,"_20927":122367,"_27457":122368,"_2948":122369},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3465":72146,"_30219":72139,"_5":30548,"_20927":122371,"_27457":122372,"_2948":122373},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3465":72147,"_30219":72139,"_5":30548,"_20927":122375,"_27457":122376,"_2948":122377},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3465":72148,"_30219":72139,"_5":30548,"_20927":122379,"_27457":122380,"_2948":122381},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3465":72149,"_30219":72139,"_5":30548,"_20927":122383,"_27457":122384,"_2948":122385},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3465":72150,"_30219":72139,"_20927":122387,"_5":14373,"_27457":72139,"_2948":122388},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3465":72151,"_30219":72139,"_20927":122390,"_5":14373,"_27457":122352,"_2948":122391},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3465":72152,"_30219":72139,"_20927":122393,"_5":14373,"_27457":122352,"_2948":122394},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3465":72153,"_30219":72139,"_20927":122396,"_5":14373,"_27457":122352,"_2948":122397},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3465":72154,"_30219":72139,"_20927":122399,"_5":14373,"_27457":122352,"_2948":122400},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3465":72155,"_30219":72139,"_20927":122402,"_5":14373,"_27457":122352,"_2948":122403},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3465":72156,"_30219":72139,"_20927":122405,"_5":14373,"_27457":122352,"_2948":122406},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3465":72157,"_30219":72139,"_20927":122408,"_5":14373,"_27457":122352,"_2948":122409},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3465":72158,"_30219":72139,"_20927":122411,"_5":14373,"_27457":122356,"_2948":122412},[],"Descarga el PEM e inspecciónalo:",{"_3465":72159,"_30219":72139,"_20927":122414,"_5":14373,"_27457":122356,"_2948":122415},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3465":72160,"_30219":72139,"_20927":122417,"_5":14373,"_27457":122360,"_2948":122418},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3465":72161,"_30219":72139,"_20927":122420,"_5":14373,"_27457":122360,"_2948":122421},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3465":72162,"_30219":72139,"_20927":122423,"_5":14373,"_27457":122360,"_2948":122424},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3465":72163,"_30219":72139,"_20927":122426,"_5":14373,"_27457":122360,"_2948":122427},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3465":72164,"_30219":72139,"_20927":122429,"_5":14373,"_27457":122360,"_2948":122430},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3465":72165,"_30219":72139,"_20927":122432,"_5":14373,"_27457":122360,"_2948":122433},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3465":72166,"_30219":72139,"_20927":122435,"_5":14373,"_27457":122360,"_2948":122436},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3465":72167,"_30219":72139,"_20927":122438,"_5":14373,"_27457":122364,"_2948":122439},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3465":72168,"_30219":72139,"_20927":122441,"_5":14373,"_27457":122368,"_2948":122442},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3465":72169,"_30219":72139,"_20927":122444,"_5":14373,"_27457":122372,"_2948":122445},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3465":72170,"_30219":72139,"_20927":122447,"_5":14373,"_27457":122376,"_2948":122448},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3465":72171,"_30219":72139,"_20927":122450,"_5":14373,"_27457":122376,"_2948":122451},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3465":72172,"_30219":72139,"_20927":122453,"_5":14373,"_27457":122376,"_2948":122454},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3465":72173,"_30219":72139,"_20927":122456,"_5":14373,"_27457":122380,"_2948":122457},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3465":72174,"_30219":72139,"_20927":122459,"_5":14373,"_27457":122380,"_2948":122460},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3465":72175,"_30219":72139,"_20927":122462,"_5":14373,"_27457":122380,"_2948":122463},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3465":72176,"_30219":72139,"_20927":122465,"_5":14373,"_27457":122384,"_2948":122466},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72177,"_30219":72139,"_20927":122468,"_5":14373,"_27457":122384,"_2948":122469},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3465":72178,"_30219":72178,"_5":14725,"_2948":122471,"_30551":122472,"_20927":122474,"_27457":72178},"Ciclo de vida de un certificado",[49254,117704,54734,122473],"Conceptos",[],{"_3465":72179,"_30219":72178,"_20927":122476,"_5":14373,"_27457":72178,"_2948":122477},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3465":72180,"_30219":72178,"_5":30548,"_20927":122479,"_27457":122480,"_2948":122481},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3465":72181,"_30219":72178,"_5":30548,"_20927":122483,"_27457":122484,"_2948":122485},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3465":72182,"_30219":72178,"_5":30548,"_20927":122487,"_27457":122488,"_2948":122489},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3465":72183,"_30219":72178,"_5":30548,"_20927":122491,"_27457":122492,"_2948":122493},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3465":72184,"_30219":72178,"_5":30548,"_20927":122495,"_27457":122496,"_2948":122497},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3465":72185,"_30219":72178,"_5":30548,"_20927":122499,"_27457":122500,"_2948":122501},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3465":72186,"_30219":72178,"_5":30548,"_20927":122503,"_27457":122504,"_2948":120205},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3465":72187,"_30219":72178,"_5":30548,"_20927":122506,"_27457":122507,"_2948":122508},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3465":72188,"_30219":72178,"_5":30548,"_20927":122510,"_27457":122511,"_2948":122512},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3465":72189,"_30219":72178,"_5":30548,"_20927":122514,"_27457":122515,"_2948":122516},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3465":72190,"_30219":72178,"_20927":122518,"_5":14373,"_27457":72178,"_2948":122519},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3465":72191,"_30219":72178,"_20927":122521,"_5":14373,"_27457":122484,"_2948":122522},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3465":72192,"_30219":72178,"_20927":122524,"_5":14373,"_27457":122488,"_2948":122525},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3465":72193,"_30219":72178,"_20927":122527,"_5":14373,"_27457":122492,"_2948":122528},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3465":72194,"_30219":72178,"_20927":122530,"_5":14373,"_27457":122496,"_2948":122531},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3465":72195,"_30219":72178,"_20927":122533,"_5":14373,"_27457":122500,"_2948":122534},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3465":72196,"_30219":72178,"_20927":122536,"_5":14373,"_27457":122504,"_2948":122537},[],"Lamassu persiste cuatro estados X.509:",{"_3465":72197,"_30219":72178,"_20927":122539,"_5":14373,"_27457":122504,"_2948":122540},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3465":72198,"_30219":72178,"_20927":122542,"_5":14373,"_27457":122504,"_2948":122543},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3465":72199,"_30219":72178,"_20927":122545,"_5":14373,"_27457":122504,"_2948":122546},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3465":72200,"_30219":72178,"_20927":122548,"_5":14373,"_27457":122504,"_2948":122549},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3465":72201,"_30219":72178,"_20927":122551,"_5":14373,"_27457":122504,"_2948":122552},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3465":72202,"_30219":72178,"_20927":122554,"_5":14373,"_27457":122507,"_2948":122555},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3465":72203,"_30219":72178,"_20927":122557,"_5":14373,"_27457":122507,"_2948":122558},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3465":72204,"_30219":72178,"_20927":122560,"_5":14373,"_27457":122507,"_2948":122561},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3465":72205,"_30219":72178,"_20927":122563,"_5":14373,"_27457":122511,"_2948":122564},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3465":72206,"_30219":72178,"_20927":122566,"_5":14373,"_27457":122511,"_2948":122567},[],"Antes de confirmar:",{"_3465":72207,"_30219":72178,"_20927":122569,"_5":14373,"_27457":122511,"_2948":122570},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3465":72208,"_30219":72178,"_20927":122572,"_5":14373,"_27457":122511,"_2948":122573},[],"Distribuye la nueva cadena de confianza.",{"_3465":72209,"_30219":72178,"_20927":122575,"_5":14373,"_27457":122511,"_2948":122576},[],"Reemite las identidades necesarias.",{"_3465":72210,"_30219":72178,"_20927":122578,"_5":14373,"_27457":122511,"_2948":122579},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3465":72211,"_30219":72178,"_20927":122581,"_5":14373,"_27457":122511,"_2948":122582},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3465":72212,"_30219":72178,"_20927":122584,"_5":14373,"_27457":122511,"_2948":122585},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3465":72213,"_30219":72178,"_20927":122587,"_5":14373,"_27457":122515,"_2948":122588},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3465":72214,"_30219":72178,"_20927":122590,"_5":14373,"_27457":122515,"_2948":122591},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3465":72215,"_30219":72178,"_20927":122593,"_5":14373,"_27457":122515,"_2948":122594},[],"Cambios de estado y razones de revocación.",{"_3465":72216,"_30219":72178,"_20927":122596,"_5":14373,"_27457":122515,"_2948":122597},[],"Publicación y vigencia de OCSP y CRLs.",{"_3465":72217,"_30219":72178,"_20927":122599,"_5":14373,"_27457":122515,"_2948":122600},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3465":72218,"_30219":72178,"_20927":122602,"_5":14373,"_27457":122515,"_2948":122603},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3465":72219,"_30219":72219,"_5":14725,"_2948":122605,"_30551":122606,"_20927":122607,"_27457":72219},"Modelo de confianza",[49254,117704,54734,122473],[],{"_3465":72220,"_30219":72219,"_20927":122609,"_5":14373,"_27457":72219,"_2948":122610},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3465":72221,"_30219":72219,"_5":30548,"_20927":122612,"_27457":122613,"_2948":122614},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3465":72222,"_30219":72219,"_5":30548,"_20927":122616,"_27457":122617,"_2948":122618},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3465":72223,"_30219":72219,"_5":30548,"_20927":122620,"_27457":122621,"_2948":122622},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3465":72224,"_30219":72219,"_5":30548,"_20927":122624,"_27457":122625,"_2948":122626},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3465":72225,"_30219":72219,"_5":30548,"_20927":122628,"_27457":122629,"_2948":122630},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3465":72226,"_30219":72219,"_5":30548,"_20927":122632,"_27457":122633,"_2948":122634},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3465":72227,"_30219":72219,"_5":30548,"_20927":122636,"_27457":122637,"_2948":122638},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3465":72228,"_30219":72219,"_5":30548,"_20927":122640,"_27457":122641,"_2948":122642},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3465":72229,"_30219":72219,"_5":30548,"_20927":122644,"_27457":122645,"_2948":122646},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3465":72230,"_30219":72219,"_5":30548,"_20927":122648,"_27457":122649,"_2948":122650},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3465":72231,"_30219":72219,"_20927":122652,"_5":14373,"_27457":72219,"_2948":122653},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3465":72232,"_30219":72219,"_20927":122655,"_5":14373,"_27457":122617,"_2948":122656},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3465":72233,"_30219":72219,"_20927":122658,"_5":14373,"_27457":122621,"_2948":122659},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3465":72234,"_30219":72219,"_20927":122661,"_5":14373,"_27457":122625,"_2948":122662},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3465":72235,"_30219":72219,"_20927":122664,"_5":14373,"_27457":122629,"_2948":122665},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3465":72236,"_30219":72219,"_20927":122667,"_5":14373,"_27457":122633,"_2948":122668},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3465":72237,"_30219":72219,"_20927":122670,"_5":14373,"_27457":122633,"_2948":122671},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3465":72238,"_30219":72219,"_20927":122673,"_5":14373,"_27457":122633,"_2948":122674},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3465":72239,"_30219":72219,"_20927":122676,"_5":14373,"_27457":122633,"_2948":122677},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3465":72240,"_30219":72219,"_20927":122679,"_5":14373,"_27457":122633,"_2948":122680},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3465":72241,"_30219":72219,"_20927":122682,"_5":14373,"_27457":122633,"_2948":122683},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3465":72242,"_30219":72219,"_20927":122685,"_5":14373,"_27457":122637,"_2948":122686},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3465":72243,"_30219":72219,"_20927":122688,"_5":14373,"_27457":122637,"_2948":122689},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3465":72244,"_30219":72219,"_20927":122691,"_5":14373,"_27457":122637,"_2948":122692},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3465":72245,"_30219":72219,"_20927":122694,"_5":14373,"_27457":122637,"_2948":122695},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3465":72246,"_30219":72219,"_20927":122697,"_5":14373,"_27457":122637,"_2948":122698},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3465":72247,"_30219":72219,"_20927":122700,"_5":14373,"_27457":122641,"_2948":122701},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3465":72248,"_30219":72219,"_20927":122703,"_5":14373,"_27457":122641,"_2948":122704},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3465":72249,"_30219":72219,"_20927":122706,"_5":14373,"_27457":122641,"_2948":122707},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3465":72250,"_30219":72219,"_20927":122709,"_5":14373,"_27457":122641,"_2948":122710},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3465":72251,"_30219":72219,"_20927":122712,"_5":14373,"_27457":122641,"_2948":122713},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3465":72252,"_30219":72219,"_20927":122715,"_5":14373,"_27457":122641,"_2948":122716},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3465":72253,"_30219":72219,"_20927":122718,"_5":14373,"_27457":122641,"_2948":122719},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3465":72254,"_30219":72219,"_20927":122721,"_5":14373,"_27457":122645,"_2948":122722},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3465":72255,"_30219":72219,"_20927":122724,"_5":14373,"_27457":122649,"_2948":122725},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3465":72256,"_30219":72219,"_20927":122727,"_5":14373,"_27457":122649,"_2948":122728},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3465":72257,"_30219":72219,"_20927":122730,"_5":14373,"_27457":122649,"_2948":122731},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3465":72258,"_30219":72219,"_20927":122733,"_5":14373,"_27457":122649,"_2948":122734},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3465":72259,"_30219":72219,"_20927":122736,"_5":14373,"_27457":122649,"_2948":122737},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3465":72260,"_30219":72219,"_20927":122739,"_5":14373,"_27457":122649,"_2948":122740},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3465":72261,"_30219":72219,"_20927":122742,"_5":14373,"_27457":122649,"_2948":122743},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3465":72262,"_30219":72262,"_5":14725,"_2948":122745,"_30551":122746,"_20927":122747,"_27457":72262},"Listas de revocación (CRL)",[49254,117704,54734,122219],[],{"_3465":72263,"_30219":72262,"_20927":122749,"_5":14373,"_27457":72262,"_2948":122750},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3465":72264,"_30219":72262,"_5":30548,"_20927":122752,"_27457":122753,"_2948":122754},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3465":72265,"_30219":72262,"_5":30548,"_20927":122756,"_27457":122757,"_2948":122758},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3465":72266,"_30219":72262,"_5":30548,"_20927":122760,"_27457":122761,"_2948":122762},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3465":72267,"_30219":72262,"_5":30548,"_20927":122764,"_27457":122765,"_2948":122766},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3465":72268,"_30219":72262,"_5":30548,"_20927":122768,"_27457":122769,"_2948":122770},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3465":72269,"_30219":72262,"_5":30548,"_20927":122772,"_27457":122773,"_2948":122774},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3465":72270,"_30219":72262,"_5":30548,"_20927":122776,"_27457":122777,"_2948":122778},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3465":72271,"_30219":72262,"_5":30548,"_20927":122780,"_27457":122781,"_2948":122782},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3465":72272,"_30219":72262,"_5":30548,"_20927":122784,"_27457":122785,"_2948":122786},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3465":72273,"_30219":72262,"_20927":122788,"_5":14373,"_27457":72262,"_2948":122789},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3465":72274,"_30219":72262,"_20927":122791,"_5":14373,"_27457":122753,"_2948":122792},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3465":72275,"_30219":72262,"_20927":122794,"_5":14373,"_27457":122753,"_2948":122795},[],"Campo",{"_3465":72276,"_30219":72262,"_20927":122797,"_5":14373,"_27457":122753,"_2948":119245},[],{"_3465":72277,"_30219":72262,"_20927":122799,"_5":14373,"_27457":122753,"_2948":55956},[],{"_3465":72278,"_30219":72262,"_20927":122801,"_5":14373,"_27457":122753,"_2948":122802},[],"ID de la CA a la que pertenecen los ajustes.",{"_3465":72279,"_30219":72262,"_20927":122804,"_5":14373,"_27457":122753,"_2948":55962},[],{"_3465":72280,"_30219":72262,"_20927":122806,"_5":14373,"_27457":122753,"_2948":122807},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3465":72281,"_30219":72262,"_20927":122809,"_5":14373,"_27457":122753,"_2948":55968},[],{"_3465":72282,"_30219":72262,"_20927":122811,"_5":14373,"_27457":122753,"_2948":122812},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3465":72283,"_30219":72262,"_20927":122814,"_5":14373,"_27457":122753,"_2948":55974},[],{"_3465":72284,"_30219":72262,"_20927":122816,"_5":14373,"_27457":122753,"_2948":122817},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3465":72285,"_30219":72262,"_20927":122819,"_5":14373,"_27457":122753,"_2948":122820},[],"Campo de `crl_options`",{"_3465":72286,"_30219":72262,"_20927":122822,"_5":14373,"_27457":122753,"_2948":119245},[],{"_3465":72287,"_30219":72262,"_20927":122824,"_5":14373,"_27457":122753,"_2948":122825},[],"Valor inicial",{"_3465":72288,"_30219":72262,"_20927":122827,"_5":14373,"_27457":122753,"_2948":55988},[],{"_3465":72289,"_30219":72262,"_20927":122829,"_5":14373,"_27457":122753,"_2948":122830},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3465":72290,"_30219":72262,"_20927":122832,"_5":14373,"_27457":122753,"_2948":122833},[],"7 días.",{"_3465":72291,"_30219":72262,"_20927":122835,"_5":14373,"_27457":122753,"_2948":55997},[],{"_3465":72292,"_30219":72262,"_20927":122837,"_5":14373,"_27457":122753,"_2948":122838},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3465":72293,"_30219":72262,"_20927":122840,"_5":14373,"_27457":122753,"_2948":122841},[],"6 días y 23 horas.",{"_3465":72294,"_30219":72262,"_20927":122843,"_5":14373,"_27457":122753,"_2948":56006},[],{"_3465":72295,"_30219":72262,"_20927":122845,"_5":14373,"_27457":122753,"_2948":122846},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3465":72296,"_30219":72262,"_20927":122848,"_5":14373,"_27457":122753,"_2948":56012},[],{"_3465":72297,"_30219":72262,"_20927":122850,"_5":14373,"_27457":122753,"_2948":56015},[],{"_3465":72298,"_30219":72262,"_20927":122852,"_5":14373,"_27457":122753,"_2948":122853},[],"Número de serie del certificado existente que firma la CRL.",{"_3465":72299,"_30219":72262,"_20927":122855,"_5":14373,"_27457":122753,"_2948":122856},[],"Número de serie del certificado actual de la CA.",{"_3465":72300,"_30219":72262,"_20927":122858,"_5":14373,"_27457":122753,"_2948":122859},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3465":72301,"_30219":72262,"_20927":122861,"_5":14373,"_27457":122753,"_2948":122862},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3465":72302,"_30219":72262,"_20927":122864,"_5":14373,"_27457":122753,"_2948":122865},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3465":72303,"_30219":72262,"_20927":122867,"_5":14373,"_27457":122753,"_2948":122868},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3465":72304,"_30219":72262,"_20927":122870,"_5":14373,"_27457":122753,"_2948":122871},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3465":72305,"_30219":72262,"_20927":122873,"_5":14373,"_27457":122753,"_2948":122874},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3465":72306,"_30219":72262,"_20927":122876,"_5":14373,"_27457":122753,"_2948":122877},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3465":72307,"_30219":72262,"_20927":122879,"_5":14373,"_27457":122753,"_2948":122880},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3465":72308,"_30219":72262,"_20927":122882,"_5":14373,"_27457":122753,"_2948":122883},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3465":72309,"_30219":72262,"_20927":122885,"_5":14373,"_27457":122753,"_2948":122886},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3465":72310,"_30219":72262,"_20927":122888,"_5":14373,"_27457":122757,"_2948":122889},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3465":72311,"_30219":72262,"_20927":122891,"_5":14373,"_27457":122757,"_2948":122892},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3465":72312,"_30219":72262,"_20927":122894,"_5":14373,"_27457":122757,"_2948":122895},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3465":72313,"_30219":72262,"_20927":122897,"_5":14373,"_27457":122757,"_2948":122898},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3465":72314,"_30219":72262,"_20927":122900,"_5":14373,"_27457":122761,"_2948":122901},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3465":72315,"_30219":72262,"_20927":122903,"_5":14373,"_27457":122761,"_2948":122904},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3465":72316,"_30219":72262,"_20927":122906,"_5":14373,"_27457":122761,"_2948":122907},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3465":72317,"_30219":72262,"_20927":122909,"_5":14373,"_27457":122761,"_2948":122910},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3465":72318,"_30219":72262,"_20927":122912,"_5":14373,"_27457":122761,"_2948":122913},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3465":72319,"_30219":72262,"_20927":122915,"_5":14373,"_27457":122761,"_2948":122916},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3465":72320,"_30219":72262,"_20927":122918,"_5":14373,"_27457":122761,"_2948":122919},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3465":72321,"_30219":72262,"_20927":122921,"_5":14373,"_27457":122761,"_2948":122922},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3465":72322,"_30219":72262,"_20927":122924,"_5":14373,"_27457":122761,"_2948":122925},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3465":72323,"_30219":72262,"_20927":122927,"_5":14373,"_27457":122765,"_2948":122928},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3465":72324,"_30219":72262,"_20927":122930,"_5":14373,"_27457":122765,"_2948":122931},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3465":72325,"_30219":72262,"_20927":122933,"_5":14373,"_27457":122769,"_2948":122934},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3465":72326,"_30219":72262,"_20927":122936,"_5":14373,"_27457":122769,"_2948":122937},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3465":72327,"_30219":72262,"_20927":122939,"_5":14373,"_27457":122769,"_2948":122940},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3465":72328,"_30219":72262,"_20927":122942,"_5":14373,"_27457":122769,"_2948":122943},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3465":72329,"_30219":72262,"_20927":122945,"_5":14373,"_27457":122769,"_2948":122946},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3465":72330,"_30219":72262,"_20927":122948,"_5":14373,"_27457":122773,"_2948":122949},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3465":72331,"_30219":72262,"_20927":122951,"_5":14373,"_27457":122773,"_2948":119434},[],{"_3465":72332,"_30219":72262,"_20927":122953,"_5":14373,"_27457":122773,"_2948":122954},[],"Path relativo",{"_3465":72333,"_30219":72262,"_20927":122956,"_5":14373,"_27457":122773,"_2948":117464},[],{"_3465":72334,"_30219":72262,"_20927":122958,"_5":14373,"_27457":122773,"_2948":56124},[],{"_3465":72335,"_30219":72262,"_20927":122960,"_5":14373,"_27457":122773,"_2948":56127},[],{"_3465":72336,"_30219":72262,"_20927":122962,"_5":14373,"_27457":122773,"_2948":122963},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3465":72337,"_30219":72262,"_20927":122965,"_5":14373,"_27457":122773,"_2948":56124},[],{"_3465":72338,"_30219":72262,"_20927":122967,"_5":14373,"_27457":122773,"_2948":56135},[],{"_3465":72339,"_30219":72262,"_20927":122969,"_5":14373,"_27457":122773,"_2948":122970},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3465":72340,"_30219":72262,"_20927":122972,"_5":14373,"_27457":122773,"_2948":56141},[],{"_3465":72341,"_30219":72262,"_20927":122974,"_5":14373,"_27457":122773,"_2948":56135},[],{"_3465":72342,"_30219":72262,"_20927":122976,"_5":14373,"_27457":122773,"_2948":122977},[],"Sustituir la configuración de CRL de una CA.",{"_3465":72343,"_30219":72262,"_20927":122979,"_5":14373,"_27457":122773,"_2948":122980},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3465":72344,"_30219":72262,"_20927":122982,"_5":14373,"_27457":122773,"_2948":122983},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3465":72345,"_30219":72262,"_20927":122985,"_5":14373,"_27457":122777,"_2948":122986},[],"Síntoma",{"_3465":72346,"_30219":72262,"_20927":122988,"_5":14373,"_27457":122777,"_2948":122989},[],"Causa",{"_3465":72347,"_30219":72262,"_20927":122991,"_5":14373,"_27457":122777,"_2948":122992},[],"Acción",{"_3465":72348,"_30219":72262,"_20927":122994,"_5":14373,"_27457":122777,"_2948":122995},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3465":72349,"_30219":72262,"_20927":122997,"_5":14373,"_27457":122777,"_2948":122998},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3465":72350,"_30219":72262,"_20927":123000,"_5":14373,"_27457":122777,"_2948":123001},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3465":72351,"_30219":72262,"_20927":123003,"_5":14373,"_27457":122777,"_2948":123004},[],"`PUT` devuelve 400.",{"_3465":72352,"_30219":72262,"_20927":123006,"_5":14373,"_27457":122777,"_2948":123007},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3465":72353,"_30219":72262,"_20927":123009,"_5":14373,"_27457":122777,"_2948":123010},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3465":72354,"_30219":72262,"_20927":123012,"_5":14373,"_27457":122777,"_2948":123013},[],"`PUT` devuelve 404.",{"_3465":72355,"_30219":72262,"_20927":123015,"_5":14373,"_27457":122777,"_2948":123016},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3465":72356,"_30219":72262,"_20927":123018,"_5":14373,"_27457":122777,"_2948":123019},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3465":72357,"_30219":72262,"_20927":123021,"_5":14373,"_27457":122777,"_2948":123022},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3465":72358,"_30219":72262,"_20927":123024,"_5":14373,"_27457":122777,"_2948":123025},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3465":72359,"_30219":72262,"_20927":123027,"_5":14373,"_27457":122777,"_2948":123028},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3465":72360,"_30219":72262,"_20927":123030,"_5":14373,"_27457":122777,"_2948":123031},[],"La CRL no cambia tras revocar un certificado.",{"_3465":72361,"_30219":72262,"_20927":123033,"_5":14373,"_27457":122777,"_2948":123034},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3465":72362,"_30219":72262,"_20927":123036,"_5":14373,"_27457":122777,"_2948":123037},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3465":72363,"_30219":72262,"_20927":123039,"_5":14373,"_27457":122777,"_2948":123040},[],"Un verificador rechaza la CRL por el emisor.",{"_3465":72364,"_30219":72262,"_20927":123042,"_5":14373,"_27457":122777,"_2948":123043},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3465":72365,"_30219":72262,"_20927":123045,"_5":14373,"_27457":122777,"_2948":123046},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3465":72366,"_30219":72262,"_20927":123048,"_5":14373,"_27457":122781,"_2948":123049},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3465":72367,"_30219":72262,"_20927":123051,"_5":14373,"_27457":122785,"_2948":123052},[],"RFC 5280: perfil X.509 y CRL.",{"_3465":72368,"_30219":72262,"_20927":123054,"_5":14373,"_27457":122785,"_2948":56224},[],{"_3465":72369,"_30219":72262,"_20927":123056,"_5":14373,"_27457":122785,"_2948":56227},[],{"_3465":72370,"_30219":72262,"_20927":123058,"_5":14373,"_27457":122785,"_2948":123059},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72371,"_30219":72262,"_20927":123061,"_5":14373,"_27457":122785,"_2948":123062},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3465":72372,"_30219":72372,"_5":14725,"_2948":123064,"_30551":123065,"_20927":123066,"_27457":72372},"Claves y motores criptográficos",[49254,117704,54734,121582],[],{"_3465":72373,"_30219":72372,"_20927":123068,"_5":14373,"_27457":72372,"_2948":123069},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3465":72374,"_30219":72372,"_5":30548,"_20927":123071,"_27457":123072,"_2948":123073},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3465":72375,"_30219":72372,"_5":30548,"_20927":123075,"_27457":123076,"_2948":123077},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3465":72376,"_30219":72372,"_5":30548,"_20927":123079,"_27457":123080,"_2948":56252},[],"/docs/es/platform/pki/key-management#file-system",{"_3465":72377,"_30219":72372,"_5":30548,"_20927":123082,"_27457":123083,"_2948":56256},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3465":72378,"_30219":72372,"_5":30548,"_20927":123085,"_27457":123086,"_2948":56260},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3465":72379,"_30219":72372,"_5":30548,"_20927":123088,"_27457":123089,"_2948":56264},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3465":72380,"_30219":72372,"_5":30548,"_20927":123091,"_27457":123092,"_2948":56268},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3465":72381,"_30219":72372,"_5":30548,"_20927":123094,"_27457":123095,"_2948":56272},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3465":72382,"_30219":72372,"_5":30548,"_20927":123097,"_27457":123098,"_2948":123099},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3465":72383,"_30219":72372,"_5":30548,"_20927":123101,"_27457":123102,"_2948":123103},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3465":72384,"_30219":72372,"_5":30548,"_20927":123105,"_27457":123106,"_2948":123107},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3465":72385,"_30219":72372,"_5":30548,"_20927":123109,"_27457":123110,"_2948":123111},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3465":72386,"_30219":72372,"_5":30548,"_20927":123113,"_27457":123114,"_2948":123115},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3465":72387,"_30219":72372,"_5":30548,"_20927":123117,"_27457":123118,"_2948":123119},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3465":72388,"_30219":72372,"_5":30548,"_20927":123121,"_27457":123122,"_2948":123123},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3465":72389,"_30219":72372,"_5":30548,"_20927":123125,"_27457":123126,"_2948":56304},[],"/docs/es/platform/pki/key-management#sign",{"_3465":72390,"_30219":72372,"_5":30548,"_20927":123128,"_27457":123129,"_2948":56308},[],"/docs/es/platform/pki/key-management#verify",{"_3465":72391,"_30219":72372,"_5":30548,"_20927":123131,"_27457":123132,"_2948":123133},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3465":72392,"_30219":72372,"_5":30548,"_20927":123135,"_27457":123136,"_2948":123137},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3465":72393,"_30219":72372,"_5":30548,"_20927":123139,"_27457":123140,"_2948":123141},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3465":72394,"_30219":72372,"_20927":123143,"_5":14373,"_27457":72372,"_2948":123144},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3465":72395,"_30219":72372,"_20927":123146,"_5":14373,"_27457":72372,"_2948":123147},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3465":72396,"_30219":72372,"_20927":123149,"_5":14373,"_27457":123072,"_2948":123150},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3465":72397,"_30219":72372,"_20927":123152,"_5":14373,"_27457":123072,"_2948":123153},[],"En la práctica, permite:",{"_3465":72398,"_30219":72372,"_20927":123155,"_5":14373,"_27457":123072,"_2948":123156},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3465":72399,"_30219":72372,"_20927":123158,"_5":14373,"_27457":123072,"_2948":123159},[],"Importar claves creadas externamente.",{"_3465":72400,"_30219":72372,"_20927":123161,"_5":14373,"_27457":123072,"_2948":123162},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3465":72401,"_30219":72372,"_20927":123164,"_5":14373,"_27457":123072,"_2948":123165},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3465":72402,"_30219":72372,"_20927":123167,"_5":14373,"_27457":123076,"_2948":123168},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3465":72403,"_30219":72372,"_20927":123170,"_5":14373,"_27457":123076,"_2948":123171},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3465":72404,"_30219":72372,"_20927":123173,"_5":14373,"_27457":123076,"_2948":123174},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3465":72405,"_30219":72372,"_20927":123176,"_5":14373,"_27457":123080,"_2948":123177},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3465":72406,"_30219":72372,"_20927":123179,"_5":14373,"_27457":123083,"_2948":123180},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3465":72407,"_30219":72372,"_20927":123182,"_5":14373,"_27457":123083,"_2948":123183},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3465":72408,"_30219":72372,"_20927":123185,"_5":14373,"_27457":123086,"_2948":123186},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3465":72409,"_30219":72372,"_20927":123188,"_5":14373,"_27457":123089,"_2948":123189},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3465":72410,"_30219":72372,"_20927":123191,"_5":14373,"_27457":123092,"_2948":123192},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3465":72411,"_30219":72372,"_20927":123194,"_5":14373,"_27457":123095,"_2948":123195},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3465":72412,"_30219":72372,"_20927":123197,"_5":14373,"_27457":123095,"_2948":123198},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3465":72413,"_30219":72372,"_20927":123200,"_5":14373,"_27457":123095,"_2948":123201},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3465":72414,"_30219":72372,"_20927":123203,"_5":14373,"_27457":123095,"_2948":123204},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3465":72415,"_30219":72372,"_20927":123206,"_5":14373,"_27457":123098,"_2948":123207},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3465":72416,"_30219":72372,"_20927":123209,"_5":14373,"_27457":123098,"_2948":123210},[],"La tabla incluye los siguientes campos:",{"_3465":72417,"_30219":72372,"_20927":123212,"_5":14373,"_27457":123098,"_2948":123213},[],"**Name**: nombre descriptivo de la clave.",{"_3465":72418,"_30219":72372,"_20927":123215,"_5":14373,"_27457":123098,"_2948":123216},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3465":72419,"_30219":72372,"_20927":123218,"_5":14373,"_27457":123098,"_2948":123219},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3465":72420,"_30219":72372,"_20927":123221,"_5":14373,"_27457":123098,"_2948":123222},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3465":72421,"_30219":72372,"_20927":123224,"_5":14373,"_27457":123098,"_2948":123225},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3465":72422,"_30219":72372,"_20927":123227,"_5":14373,"_27457":123098,"_2948":123228},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3465":72423,"_30219":72372,"_20927":123230,"_5":14373,"_27457":123098,"_2948":123231},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3465":72424,"_30219":72372,"_20927":123233,"_5":14373,"_27457":123098,"_2948":123234},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3465":72425,"_30219":72372,"_20927":123236,"_5":14373,"_27457":123098,"_2948":123237},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3465":72426,"_30219":72372,"_20927":123239,"_5":14373,"_27457":123098,"_2948":123240},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3465":72427,"_30219":72372,"_20927":123242,"_5":14373,"_27457":123098,"_2948":123243},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3465":72428,"_30219":72372,"_20927":123245,"_5":14373,"_27457":123098,"_2948":123246},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3465":72429,"_30219":72372,"_20927":123248,"_5":14373,"_27457":123098,"_2948":123249},[],"**Delete Key** para eliminar la clave del sistema.",{"_3465":72430,"_30219":72372,"_20927":123251,"_5":14373,"_27457":123102,"_2948":123252},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3465":72431,"_30219":72372,"_20927":123254,"_5":14373,"_27457":123106,"_2948":123255},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3465":72432,"_30219":72372,"_20927":123257,"_5":14373,"_27457":123106,"_2948":123258},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3465":72433,"_30219":72372,"_20927":123260,"_5":14373,"_27457":123106,"_2948":123261},[],"**Key Name**: nombre único y descriptivo.",{"_3465":72434,"_30219":72372,"_20927":123263,"_5":14373,"_27457":123106,"_2948":123264},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3465":72435,"_30219":72372,"_20927":123266,"_5":14373,"_27457":123106,"_2948":123267},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3465":72436,"_30219":72372,"_20927":123269,"_5":14373,"_27457":123106,"_2948":123270},[],"**Tags**: metadatos para clasificar la clave.",{"_3465":72437,"_30219":72372,"_20927":123272,"_5":14373,"_27457":123106,"_2948":123273},[],"**Metadata**: información adicional para usos avanzados.",{"_3465":72438,"_30219":72372,"_20927":123275,"_5":14373,"_27457":123110,"_2948":123276},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3465":72439,"_30219":72372,"_20927":123278,"_5":14373,"_27457":123110,"_2948":123279},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3465":72440,"_30219":72372,"_20927":123281,"_5":14373,"_27457":123110,"_2948":123282},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3465":72441,"_30219":72372,"_20927":123284,"_5":14373,"_27457":123110,"_2948":123285},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3465":72442,"_30219":72372,"_20927":123287,"_5":14373,"_27457":123110,"_2948":123288},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3465":72443,"_30219":72372,"_20927":123290,"_5":14373,"_27457":123110,"_2948":123291},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3465":72444,"_30219":72372,"_20927":123293,"_5":14373,"_27457":123110,"_2948":123294},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3465":72445,"_30219":72372,"_20927":123296,"_5":14373,"_27457":123110,"_2948":123297},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3465":72446,"_30219":72372,"_20927":123299,"_5":14373,"_27457":123110,"_2948":123300},[],"**Metadata**: información adicional opcional.",{"_3465":72447,"_30219":72372,"_20927":123302,"_5":14373,"_27457":123110,"_2948":123303},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3465":72448,"_30219":72372,"_20927":123305,"_5":14373,"_27457":123110,"_2948":123306},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3465":72449,"_30219":72372,"_20927":123308,"_5":14373,"_27457":123114,"_2948":123309},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3465":72450,"_30219":72372,"_20927":123311,"_5":14373,"_27457":123118,"_2948":123312},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3465":72451,"_30219":72372,"_20927":123314,"_5":14373,"_27457":123118,"_2948":123315},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3465":72452,"_30219":72372,"_20927":123317,"_5":14373,"_27457":123118,"_2948":123318},[],"**Key Name**: nombre descriptivo.",{"_3465":72453,"_30219":72372,"_20927":123320,"_5":14373,"_27457":123118,"_2948":123321},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3465":72454,"_30219":72372,"_20927":123323,"_5":14373,"_27457":123118,"_2948":123324},[],"**Tags**: etiquetas asociadas.",{"_3465":72455,"_30219":72372,"_20927":123326,"_5":14373,"_27457":123118,"_2948":123327},[],"**Aliases**: nombres alternativos.",{"_3465":72456,"_30219":72372,"_20927":123329,"_5":14373,"_27457":123118,"_2948":123330},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3465":72457,"_30219":72372,"_20927":123332,"_5":14373,"_27457":123118,"_2948":123333},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3465":72458,"_30219":72372,"_20927":123335,"_5":14373,"_27457":123118,"_2948":123336},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3465":72459,"_30219":72372,"_20927":123338,"_5":14373,"_27457":123118,"_2948":123339},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3465":72460,"_30219":72372,"_20927":123341,"_5":14373,"_27457":123122,"_2948":123342},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3465":72461,"_30219":72372,"_20927":123344,"_5":14373,"_27457":123122,"_2948":123345},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3465":72462,"_30219":72372,"_20927":123347,"_5":14373,"_27457":123122,"_2948":123348},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3465":72463,"_30219":72372,"_20927":123350,"_5":14373,"_27457":123126,"_2948":123351},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3465":72464,"_30219":72372,"_20927":123353,"_5":14373,"_27457":123126,"_2948":123354},[],"Campos principales:",{"_3465":72465,"_30219":72372,"_20927":123356,"_5":14373,"_27457":123126,"_2948":123357},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3465":72466,"_30219":72372,"_20927":123359,"_5":14373,"_27457":123126,"_2948":123360},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3465":72467,"_30219":72372,"_20927":123362,"_5":14373,"_27457":123126,"_2948":123363},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3465":72468,"_30219":72372,"_20927":123365,"_5":14373,"_27457":123126,"_2948":123366},[],"**Message**: contenido que se va a firmar.",{"_3465":72469,"_30219":72372,"_20927":123368,"_5":14373,"_27457":123126,"_2948":123369},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3465":72470,"_30219":72372,"_20927":123371,"_5":14373,"_27457":123129,"_2948":123372},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3465":72471,"_30219":72372,"_20927":123374,"_5":14373,"_27457":123129,"_2948":123354},[],{"_3465":72472,"_30219":72372,"_20927":123376,"_5":14373,"_27457":123129,"_2948":123377},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3465":72473,"_30219":72372,"_20927":123379,"_5":14373,"_27457":123129,"_2948":123380},[],"**Message Type**: `Raw` o `Digest`.",{"_3465":72474,"_30219":72372,"_20927":123382,"_5":14373,"_27457":123129,"_2948":123383},[],"**Payload Encoding**: codificación del mensaje.",{"_3465":72475,"_30219":72372,"_20927":123385,"_5":14373,"_27457":123129,"_2948":123386},[],"**Message**: mensaje original o hash.",{"_3465":72476,"_30219":72372,"_20927":123388,"_5":14373,"_27457":123129,"_2948":123389},[],"**Signature**: firma que se desea comprobar.",{"_3465":72477,"_30219":72372,"_20927":123391,"_5":14373,"_27457":123129,"_2948":123392},[],"**Result**: indicador del resultado de la validación.",{"_3465":72478,"_30219":72372,"_20927":123394,"_5":14373,"_27457":123132,"_2948":123395},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3465":72479,"_30219":72372,"_20927":123397,"_5":14373,"_27457":123132,"_2948":123398},[],"Este flujo es útil para:",{"_3465":72480,"_30219":72372,"_20927":123400,"_5":14373,"_27457":123132,"_2948":123401},[],"Solicitar certificados a una CA externa.",{"_3465":72481,"_30219":72372,"_20927":123403,"_5":14373,"_27457":123132,"_2948":123404},[],"Renovar una identidad manteniendo la misma clave.",{"_3465":72482,"_30219":72372,"_20927":123406,"_5":14373,"_27457":123132,"_2948":123407},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3465":72483,"_30219":72372,"_20927":123409,"_5":14373,"_27457":123132,"_2948":123410},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3465":72484,"_30219":72372,"_20927":123412,"_5":14373,"_27457":123132,"_2948":123413},[],"**Organization (O)**: organización o empresa.",{"_3465":72485,"_30219":72372,"_20927":123415,"_5":14373,"_27457":123132,"_2948":123416},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3465":72486,"_30219":72372,"_20927":123418,"_5":14373,"_27457":123132,"_2948":123419},[],"**Country (C)**: código de país de dos letras.",{"_3465":72487,"_30219":72372,"_20927":123421,"_5":14373,"_27457":123132,"_2948":123422},[],"**State / Province (ST)**: estado o provincia.",{"_3465":72488,"_30219":72372,"_20927":123424,"_5":14373,"_27457":123132,"_2948":123425},[],"**Locality (L)**: ciudad o localidad.",{"_3465":72489,"_30219":72372,"_20927":123427,"_5":14373,"_27457":123132,"_2948":123428},[],"**Email Address**: correo de contacto.",{"_3465":72490,"_30219":72372,"_20927":123430,"_5":14373,"_27457":123132,"_2948":123431},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3465":72491,"_30219":72372,"_20927":123433,"_5":14373,"_27457":123132,"_2948":123434},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3465":72492,"_30219":72372,"_20927":123436,"_5":14373,"_27457":123136,"_2948":123437},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3465":72493,"_30219":72372,"_20927":123439,"_5":14373,"_27457":123136,"_2948":123440},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3465":72494,"_30219":72372,"_20927":123442,"_5":14373,"_27457":123140,"_2948":123443},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3465":72495,"_30219":72372,"_20927":123445,"_5":14373,"_27457":123140,"_2948":123446},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3465":72496,"_30219":72496,"_5":14725,"_2948":123448,"_30551":123449,"_20927":123450,"_27457":72496},"Validación online con OCSP",[49254,117704,54734,122219],[],{"_3465":72497,"_30219":72496,"_20927":123452,"_5":14373,"_27457":72496,"_2948":123453},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3465":72498,"_30219":72496,"_5":30548,"_20927":123455,"_27457":123456,"_2948":123457},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3465":72499,"_30219":72496,"_5":30548,"_20927":123459,"_27457":123460,"_2948":123461},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3465":72500,"_30219":72496,"_5":30548,"_20927":123463,"_27457":123464,"_2948":123465},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3465":72501,"_30219":72496,"_5":30548,"_20927":123467,"_27457":123468,"_2948":123469},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3465":72502,"_30219":72496,"_5":30548,"_20927":123471,"_27457":123472,"_2948":123473},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3465":72503,"_30219":72496,"_5":30548,"_20927":123475,"_27457":123476,"_2948":122786},[],"/docs/es/platform/pki/ocsp#referencias",{"_3465":72504,"_30219":72496,"_20927":123478,"_5":14373,"_27457":72496,"_2948":123479},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3465":72505,"_30219":72496,"_20927":123481,"_5":14373,"_27457":123456,"_2948":123482},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3465":72506,"_30219":72496,"_20927":123484,"_5":14373,"_27457":123456,"_2948":123485},[],"Estado del registro",{"_3465":72507,"_30219":72496,"_20927":123487,"_5":14373,"_27457":123456,"_2948":123488},[],"Respuesta firmada",{"_3465":72508,"_30219":72496,"_20927":123490,"_5":14373,"_27457":123456,"_2948":53871},[],{"_3465":72509,"_30219":72496,"_20927":123492,"_5":14373,"_27457":123456,"_2948":56672},[],{"_3465":72510,"_30219":72496,"_20927":123494,"_5":14373,"_27457":123456,"_2948":53888},[],{"_3465":72511,"_30219":72496,"_20927":123496,"_5":14373,"_27457":123456,"_2948":123497},[],"`Revoked`, con razón y fecha de revocación.",{"_3465":72512,"_30219":72496,"_20927":123499,"_5":14373,"_27457":123456,"_2948":123500},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3465":72513,"_30219":72496,"_20927":123502,"_5":14373,"_27457":123456,"_2948":123503},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3465":72514,"_30219":72496,"_20927":123505,"_5":14373,"_27457":123456,"_2948":123506},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3465":72515,"_30219":72496,"_20927":123508,"_5":14373,"_27457":123456,"_2948":123509},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3465":72516,"_30219":72496,"_20927":123511,"_5":14373,"_27457":123456,"_2948":123512},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3465":72517,"_30219":72496,"_20927":123514,"_5":14373,"_27457":123460,"_2948":123515},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3465":72518,"_30219":72496,"_20927":123517,"_5":14373,"_27457":123460,"_2948":123518},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3465":72519,"_30219":72496,"_20927":123520,"_5":14373,"_27457":123464,"_2948":123521},[],"El servicio acepta:",{"_3465":72520,"_30219":72496,"_20927":123523,"_5":14373,"_27457":123464,"_2948":119434},[],{"_3465":72521,"_30219":72496,"_20927":123525,"_5":14373,"_27457":123464,"_2948":123526},[],"Ruta del servicio VA",{"_3465":72522,"_30219":72496,"_20927":123528,"_5":14373,"_27457":123464,"_2948":123529},[],"Formato",{"_3465":72523,"_30219":72496,"_20927":123531,"_5":14373,"_27457":123464,"_2948":56712},[],{"_3465":72524,"_30219":72496,"_20927":123533,"_5":14373,"_27457":123464,"_2948":56715},[],{"_3465":72525,"_30219":72496,"_20927":123535,"_5":14373,"_27457":123464,"_2948":123536},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3465":72526,"_30219":72496,"_20927":123538,"_5":14373,"_27457":123464,"_2948":56124},[],{"_3465":72527,"_30219":72496,"_20927":123540,"_5":14373,"_27457":123464,"_2948":56723},[],{"_3465":72528,"_30219":72496,"_20927":123542,"_5":14373,"_27457":123464,"_2948":123543},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3465":72529,"_30219":72496,"_20927":123545,"_5":14373,"_27457":123464,"_2948":123546},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3465":72530,"_30219":72496,"_20927":123548,"_5":14373,"_27457":123468,"_2948":123549},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3465":72531,"_30219":72496,"_20927":123551,"_5":14373,"_27457":123468,"_2948":123552},[],"Genera la solicitud:",{"_3465":72532,"_30219":72496,"_20927":123554,"_5":14373,"_27457":123468,"_2948":123555},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3465":72533,"_30219":72496,"_20927":123557,"_5":14373,"_27457":123468,"_2948":123558},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3465":72534,"_30219":72496,"_20927":123560,"_5":14373,"_27457":123468,"_2948":123561},[],"Verifica el DER recibido:",{"_3465":72535,"_30219":72496,"_20927":123563,"_5":14373,"_27457":123468,"_2948":123564},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3465":72536,"_30219":72496,"_20927":123566,"_5":14373,"_27457":123472,"_2948":123567},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3465":72537,"_30219":72496,"_20927":123569,"_5":14373,"_27457":123472,"_2948":123570},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3465":72538,"_30219":72496,"_20927":123572,"_5":14373,"_27457":123476,"_2948":56756},[],{"_3465":72539,"_30219":72496,"_20927":123574,"_5":14373,"_27457":123476,"_2948":56759},[],{"_3465":72540,"_30219":72496,"_20927":123576,"_5":14373,"_27457":123476,"_2948":123577},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3465":72541,"_30219":72496,"_20927":123579,"_5":14373,"_27457":123476,"_2948":123062},[],{"_3465":72542,"_30219":72542,"_5":14725,"_2948":54734,"_30551":123581,"_20927":123582,"_27457":72542},[49254,117704,54734],[],{"_3465":72543,"_30219":72542,"_20927":123584,"_5":14373,"_27457":72542,"_2948":123585},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3465":72544,"_30219":72542,"_5":30548,"_20927":123587,"_27457":123588,"_2948":120908},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3465":72545,"_30219":72542,"_5":30548,"_20927":123590,"_27457":123591,"_2948":123592},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3465":72546,"_30219":72542,"_5":30548,"_20927":123594,"_27457":123595,"_2948":121428},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3465":72547,"_30219":72542,"_5":30548,"_20927":123597,"_27457":123598,"_2948":121432},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3465":72548,"_30219":72542,"_5":30548,"_20927":123600,"_27457":123601,"_2948":121436},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3465":72549,"_30219":72542,"_5":30548,"_20927":123603,"_27457":123604,"_2948":121440},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3465":72550,"_30219":72542,"_5":30548,"_20927":123606,"_27457":123607,"_2948":121448},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3465":72551,"_30219":72542,"_5":30548,"_20927":123609,"_27457":123610,"_2948":123611},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3465":72552,"_30219":72542,"_5":30548,"_20927":123613,"_27457":123614,"_2948":122385},[],"/docs/es/platform/pki/overview#continúa",{"_3465":72553,"_30219":72542,"_20927":123616,"_5":14373,"_27457":72542,"_2948":123617},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3465":72554,"_30219":72542,"_20927":123619,"_5":14373,"_27457":123588,"_2948":123620},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3465":72555,"_30219":72542,"_20927":123622,"_5":14373,"_27457":123588,"_2948":123623},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3465":72556,"_30219":72542,"_20927":123625,"_5":14373,"_27457":123591,"_2948":123626},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3465":72557,"_30219":72542,"_20927":123628,"_5":14373,"_27457":123591,"_2948":123629},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3465":72558,"_30219":72542,"_20927":123631,"_5":14373,"_27457":123591,"_2948":123632},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3465":72559,"_30219":72542,"_20927":123634,"_5":14373,"_27457":123591,"_2948":123635},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3465":72560,"_30219":72542,"_20927":123637,"_5":14373,"_27457":123591,"_2948":123638},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3465":72561,"_30219":72542,"_20927":123640,"_5":14373,"_27457":123598,"_2948":123641},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3465":72562,"_30219":72542,"_20927":123643,"_5":14373,"_27457":123601,"_2948":123644},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3465":72563,"_30219":72542,"_20927":123646,"_5":14373,"_27457":123604,"_2948":123647},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3465":72564,"_30219":72542,"_20927":123649,"_5":14373,"_27457":123607,"_2948":123650},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3465":72565,"_30219":72542,"_20927":123652,"_5":14373,"_27457":123610,"_2948":123653},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3465":72566,"_30219":72542,"_20927":123655,"_5":14373,"_27457":123610,"_2948":123656},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3465":72567,"_30219":72542,"_20927":123658,"_5":14373,"_27457":123610,"_2948":123659},[],"su clave pública corresponda a la clave privada del cliente;",{"_3465":72568,"_30219":72542,"_20927":123661,"_5":14373,"_27457":123610,"_2948":123662},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3465":72569,"_30219":72542,"_20927":123664,"_5":14373,"_27457":123610,"_2948":123665},[],"sus fechas y usos permitan la operación;",{"_3465":72570,"_30219":72542,"_20927":123667,"_5":14373,"_27457":123610,"_2948":123668},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3465":72571,"_30219":72542,"_20927":123670,"_5":14373,"_27457":123610,"_2948":123671},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3465":72572,"_30219":72542,"_20927":123673,"_5":14373,"_27457":123614,"_2948":123674},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":72573,"_30219":72542,"_20927":123676,"_5":14373,"_27457":123614,"_2948":123677},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3465":72574,"_30219":72542,"_20927":123679,"_5":14373,"_27457":123614,"_2948":123680},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3465":72575,"_30219":72575,"_5":14725,"_2948":123682,"_30551":123683,"_20927":123684,"_27457":72575},"Crea tu primera CA",[49254,117704,54734,121032],[],{"_3465":72576,"_30219":72575,"_20927":123686,"_5":14373,"_27457":72575,"_2948":123687},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3465":72577,"_30219":72575,"_5":30548,"_20927":123689,"_27457":123690,"_2948":116275},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3465":72578,"_30219":72575,"_5":30548,"_20927":123692,"_27457":123693,"_2948":123694},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3465":72579,"_30219":72575,"_5":30548,"_20927":123696,"_27457":123697,"_2948":123698},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3465":72580,"_30219":72575,"_5":30548,"_20927":123700,"_27457":123701,"_2948":123702},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3465":72581,"_30219":72575,"_5":30548,"_20927":123704,"_27457":123705,"_2948":123706},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3465":72582,"_30219":72575,"_5":30548,"_20927":123708,"_27457":123709,"_2948":123710},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3465":72583,"_30219":72575,"_5":30548,"_20927":123712,"_27457":123713,"_2948":123714},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3465":72584,"_30219":72575,"_5":30548,"_20927":123716,"_27457":123717,"_2948":121279},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3465":72585,"_30219":72575,"_5":30548,"_20927":123719,"_27457":123720,"_2948":116299},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3465":72586,"_30219":72575,"_20927":123722,"_5":14373,"_27457":72575,"_2948":123723},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3465":72587,"_30219":72575,"_20927":123725,"_5":14373,"_27457":123690,"_2948":123726},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3465":72588,"_30219":72575,"_20927":123728,"_5":14373,"_27457":123690,"_2948":123729},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3465":72589,"_30219":72575,"_20927":123731,"_5":14373,"_27457":123690,"_2948":123732},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3465":72590,"_30219":72575,"_20927":123734,"_5":14373,"_27457":123690,"_2948":123735},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3465":72591,"_30219":72575,"_20927":123737,"_5":14373,"_27457":123693,"_2948":123738},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3465":72592,"_30219":72575,"_20927":123740,"_5":14373,"_27457":123693,"_2948":123741},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3465":72593,"_30219":72575,"_20927":123743,"_5":14373,"_27457":123697,"_2948":123744},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3465":72594,"_30219":72575,"_20927":123746,"_5":14373,"_27457":123697,"_2948":123747},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3465":72595,"_30219":72575,"_20927":123749,"_5":14373,"_27457":123701,"_2948":123750},[],"Selecciona **Root CA** y completa:",{"_3465":72596,"_30219":72575,"_20927":123752,"_5":14373,"_27457":123701,"_2948":56938},[],{"_3465":72597,"_30219":72575,"_20927":123754,"_5":14373,"_27457":123701,"_2948":123755},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3465":72598,"_30219":72575,"_20927":123757,"_5":14373,"_27457":123701,"_2948":123758},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3465":72599,"_30219":72575,"_20927":123760,"_5":14373,"_27457":123701,"_2948":123761},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3465":72600,"_30219":72575,"_20927":123763,"_5":14373,"_27457":123701,"_2948":123764},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3465":72601,"_30219":72575,"_20927":123766,"_5":14373,"_27457":123705,"_2948":123767},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3465":72602,"_30219":72575,"_20927":123769,"_5":14373,"_27457":123709,"_2948":123770},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3465":72603,"_30219":72575,"_20927":123772,"_5":14373,"_27457":123709,"_2948":123773},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3465":72604,"_30219":72575,"_20927":123775,"_5":14373,"_27457":123713,"_2948":123776},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3465":72605,"_30219":72575,"_20927":123778,"_5":14373,"_27457":123713,"_2948":123779},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3465":72606,"_30219":72575,"_20927":123781,"_5":14373,"_27457":123713,"_2948":123782},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3465":72607,"_30219":72575,"_20927":123784,"_5":14373,"_27457":123717,"_2948":123785},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3465":72608,"_30219":72575,"_20927":123787,"_5":14373,"_27457":123717,"_2948":123788},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3465":72609,"_30219":72575,"_20927":123790,"_5":14373,"_27457":123717,"_2948":123791},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3465":72610,"_30219":72575,"_20927":123793,"_5":14373,"_27457":123717,"_2948":123794},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3465":72611,"_30219":72575,"_20927":123796,"_5":14373,"_27457":123720,"_2948":123797},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3465":72612,"_30219":72612,"_5":14725,"_2948":123799,"_30551":123800,"_20927":123801,"_27457":72612},"Emite y verifica un certificado",[49254,117704,54734,121032],[],{"_3465":72613,"_30219":72612,"_20927":123803,"_5":14373,"_27457":72612,"_2948":123804},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3465":72614,"_30219":72612,"_5":30548,"_20927":123806,"_27457":123807,"_2948":116275},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3465":72615,"_30219":72612,"_5":30548,"_20927":123809,"_27457":123810,"_2948":123811},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3465":72616,"_30219":72612,"_5":30548,"_20927":123813,"_27457":123814,"_2948":123815},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3465":72617,"_30219":72612,"_5":30548,"_20927":123817,"_27457":123818,"_2948":123819},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3465":72618,"_30219":72612,"_5":30548,"_20927":123821,"_27457":123822,"_2948":123823},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3465":72619,"_30219":72612,"_5":30548,"_20927":123825,"_27457":123826,"_2948":123827},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3465":72620,"_30219":72612,"_5":30548,"_20927":123829,"_27457":123830,"_2948":123831},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3465":72621,"_30219":72612,"_5":30548,"_20927":123833,"_27457":123834,"_2948":123835},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3465":72622,"_30219":72612,"_5":30548,"_20927":123837,"_27457":123838,"_2948":123839},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3465":72623,"_30219":72612,"_5":30548,"_20927":123841,"_27457":123842,"_2948":123843},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3465":72624,"_30219":72612,"_5":30548,"_20927":123845,"_27457":123846,"_2948":121279},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3465":72625,"_30219":72612,"_5":30548,"_20927":123848,"_27457":123849,"_2948":116299},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3465":72626,"_30219":72612,"_20927":123851,"_5":14373,"_27457":72612,"_2948":123852},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3465":72627,"_30219":72612,"_20927":123854,"_5":14373,"_27457":123807,"_2948":123855},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3465":72628,"_30219":72612,"_20927":123857,"_5":14373,"_27457":123807,"_2948":123858},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3465":72629,"_30219":72612,"_20927":123860,"_5":14373,"_27457":123807,"_2948":123861},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3465":72630,"_30219":72612,"_20927":123863,"_5":14373,"_27457":123807,"_2948":123864},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3465":72631,"_30219":72612,"_20927":123866,"_5":14373,"_27457":123807,"_2948":123867},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3465":72632,"_30219":72612,"_20927":123869,"_5":14373,"_27457":123810,"_2948":123870},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3465":72633,"_30219":72612,"_20927":123872,"_5":14373,"_27457":123814,"_2948":123873},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3465":72634,"_30219":72612,"_20927":123875,"_5":14373,"_27457":123814,"_2948":123876},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3465":72635,"_30219":72612,"_20927":123878,"_5":14373,"_27457":123818,"_2948":123879},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3465":72636,"_30219":72612,"_20927":123881,"_5":14373,"_27457":123818,"_2948":123882},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3465":72637,"_30219":72612,"_20927":123884,"_5":14373,"_27457":123822,"_2948":123885},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3465":72638,"_30219":72612,"_20927":123887,"_5":14373,"_27457":123822,"_2948":123888},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3465":72639,"_30219":72612,"_20927":123890,"_5":14373,"_27457":123826,"_2948":123891},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3465":72640,"_30219":72612,"_20927":123893,"_5":14373,"_27457":123830,"_2948":123894},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3465":72641,"_30219":72612,"_20927":123896,"_5":14373,"_27457":123834,"_2948":123897},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3465":72642,"_30219":72612,"_20927":123899,"_5":14373,"_27457":123838,"_2948":123900},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3465":72643,"_30219":72612,"_20927":123902,"_5":14373,"_27457":123838,"_2948":123903},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3465":72644,"_30219":72612,"_20927":123905,"_5":14373,"_27457":123838,"_2948":123906},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3465":72645,"_30219":72612,"_20927":123908,"_5":14373,"_27457":123842,"_2948":123909},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3465":72646,"_30219":72612,"_20927":123911,"_5":14373,"_27457":123842,"_2948":123912},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3465":72647,"_30219":72612,"_20927":123914,"_5":14373,"_27457":123842,"_2948":123915},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3465":72648,"_30219":72612,"_20927":123917,"_5":14373,"_27457":123846,"_2948":121362},[],{"_3465":72649,"_30219":72612,"_20927":123919,"_5":14373,"_27457":123846,"_2948":119883},[],{"_3465":72650,"_30219":72612,"_20927":123921,"_5":14373,"_27457":123846,"_2948":123922},[],"La CA rechaza la emisión",{"_3465":72651,"_30219":72612,"_20927":123924,"_5":14373,"_27457":123846,"_2948":123925},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3465":72652,"_30219":72612,"_20927":123927,"_5":14373,"_27457":123846,"_2948":123928},[],"Sujeto o usos diferentes",{"_3465":72653,"_30219":72612,"_20927":123930,"_5":14373,"_27457":123846,"_2948":123931},[],"Perfil aplicado y valores solicitados.",{"_3465":72654,"_30219":72612,"_20927":123933,"_5":14373,"_27457":123846,"_2948":123934},[],"No se encuentra el emisor",{"_3465":72655,"_30219":72612,"_20927":123936,"_5":14373,"_27457":123846,"_2948":123937},[],"CA descargada y cadena intermedia necesaria.",{"_3465":72656,"_30219":72612,"_20927":123939,"_5":14373,"_27457":123846,"_2948":123940},[],"Falla la vigencia",{"_3465":72657,"_30219":72612,"_20927":123942,"_5":14373,"_27457":123846,"_2948":123943},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3465":72658,"_30219":72612,"_20927":123945,"_5":14373,"_27457":123846,"_2948":123946},[],"Los resúmenes de clave difieren",{"_3465":72659,"_30219":72612,"_20927":123948,"_5":14373,"_27457":123846,"_2948":123949},[],"Archivos de certificado y clave de la misma emisión.",{"_3465":72660,"_30219":72612,"_20927":123951,"_5":14373,"_27457":123846,"_2948":123952},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3465":72661,"_30219":72612,"_20927":123954,"_5":14373,"_27457":123849,"_2948":123955},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3465":72662,"_30219":72612,"_20927":123957,"_5":14373,"_27457":123849,"_2948":123958},[],"Gestionar certificados para inspección, estado y revocación.",{"_3465":72663,"_30219":72612,"_20927":123960,"_5":14373,"_27457":123849,"_2948":123961},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3465":72664,"_30219":72612,"_20927":123963,"_5":14373,"_27457":123849,"_2948":123964},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3465":72665,"_30219":72612,"_20927":123966,"_5":14373,"_27457":123849,"_2948":123967},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3465":72666,"_30219":72666,"_5":14725,"_2948":123969,"_30551":123970,"_20927":123971,"_27457":72666},"Primeros pasos de PKI",[49254,117704,54734,121032],[],{"_3465":72667,"_30219":72666,"_20927":123973,"_5":14373,"_27457":72666,"_2948":123974},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3465":72668,"_30219":72666,"_5":30548,"_20927":123976,"_27457":123977,"_2948":116275},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3465":72669,"_30219":72666,"_5":30548,"_20927":123979,"_27457":123980,"_2948":123981},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3465":72670,"_30219":72666,"_5":30548,"_20927":123983,"_27457":123984,"_2948":121214},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3465":72671,"_30219":72666,"_5":30548,"_20927":123986,"_27457":123987,"_2948":123988},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3465":72672,"_30219":72666,"_20927":123990,"_5":14373,"_27457":72666,"_2948":123991},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3465":72673,"_30219":72666,"_20927":123993,"_5":14373,"_27457":123977,"_2948":123994},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3465":72674,"_30219":72666,"_20927":123996,"_5":14373,"_27457":123977,"_2948":123997},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3465":72675,"_30219":72666,"_20927":123999,"_5":14373,"_27457":123977,"_2948":124000},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3465":72676,"_30219":72666,"_20927":124002,"_5":14373,"_27457":123977,"_2948":124003},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3465":72677,"_30219":72666,"_20927":124005,"_5":14373,"_27457":123977,"_2948":124006},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3465":72678,"_30219":72666,"_20927":124008,"_5":14373,"_27457":123980,"_2948":124009},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3465":72679,"_30219":72666,"_20927":124011,"_5":14373,"_27457":123980,"_2948":124012},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3465":72680,"_30219":72666,"_20927":124014,"_5":14373,"_27457":123980,"_2948":124015},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3465":72681,"_30219":72666,"_20927":124017,"_5":14373,"_27457":123980,"_2948":124018},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3465":72682,"_30219":72666,"_20927":124020,"_5":14373,"_27457":123984,"_2948":124021},[],"Archivo o recurso",{"_3465":72683,"_30219":72666,"_20927":124023,"_5":14373,"_27457":123984,"_2948":121211},[],{"_3465":72684,"_30219":72666,"_20927":124025,"_5":14373,"_27457":123984,"_2948":124026},[],"CA raíz activa y `ca.pem`",{"_3465":72685,"_30219":72666,"_20927":124028,"_5":14373,"_27457":123984,"_2948":124029},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3465":72686,"_30219":72666,"_20927":124031,"_5":14373,"_27457":123984,"_2948":124032},[],"Certificado final y `device.crt`",{"_3465":72687,"_30219":72666,"_20927":124034,"_5":14373,"_27457":123984,"_2948":124035},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3465":72688,"_30219":72666,"_20927":124037,"_5":14373,"_27457":123984,"_2948":124038},[],"Clave privada `device.key`",{"_3465":72689,"_30219":72666,"_20927":124040,"_5":14373,"_27457":123984,"_2948":124041},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3465":72690,"_30219":72666,"_20927":124043,"_5":14373,"_27457":123984,"_2948":124044},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3465":72691,"_30219":72666,"_20927":124046,"_5":14373,"_27457":123987,"_2948":124047},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3465":72692,"_30219":72666,"_20927":124049,"_5":14373,"_27457":123987,"_2948":124050},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3465":72693,"_30219":72666,"_20927":124052,"_5":14373,"_27457":123987,"_2948":124053},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3465":72694,"_30219":72694,"_5":14725,"_2948":124055,"_30551":124056,"_20927":124058,"_27457":72694},"Resolución de problemas PKI",[49254,117704,54734,124057],"Resolución de problemas",[],{"_3465":72695,"_30219":72694,"_20927":124060,"_5":14373,"_27457":72694,"_2948":124061},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3465":72696,"_30219":72694,"_5":30548,"_20927":124063,"_27457":124064,"_2948":124065},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3465":72697,"_30219":72694,"_5":30548,"_20927":124067,"_27457":124068,"_2948":124069},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3465":72698,"_30219":72694,"_5":30548,"_20927":124071,"_27457":124072,"_2948":124073},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3465":72699,"_30219":72694,"_20927":124075,"_5":14373,"_27457":72694,"_2948":124076},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3465":72700,"_30219":72694,"_20927":124078,"_5":14373,"_27457":72694,"_2948":124079},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3465":72701,"_30219":72694,"_20927":124081,"_5":14373,"_27457":124064,"_2948":121211},[],{"_3465":72702,"_30219":72694,"_20927":124083,"_5":14373,"_27457":124064,"_2948":119883},[],{"_3465":72703,"_30219":72694,"_20927":124085,"_5":14373,"_27457":124064,"_2948":116299},[],{"_3465":72704,"_30219":72694,"_20927":124087,"_5":14373,"_27457":124064,"_2948":53576},[],{"_3465":72705,"_30219":72694,"_20927":124089,"_5":14373,"_27457":124064,"_2948":124090},[],"Existe, está activa y sus fechas son utilizables.",{"_3465":72706,"_30219":72694,"_20927":124092,"_5":14373,"_27457":124064,"_2948":124093},[],"Autoridades.",{"_3465":72707,"_30219":72694,"_20927":124095,"_5":14373,"_27457":124064,"_2948":124096},[],"Clave",{"_3465":72708,"_30219":72694,"_20927":124098,"_5":14373,"_27457":124064,"_2948":124099},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3465":72709,"_30219":72694,"_20927":124101,"_5":14373,"_27457":124064,"_2948":124102},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3465":72710,"_30219":72694,"_20927":124104,"_5":14373,"_27457":124064,"_2948":57292},[],{"_3465":72711,"_30219":72694,"_20927":124106,"_5":14373,"_27457":124064,"_2948":124107},[],"PEM correcto y firma verificable.",{"_3465":72712,"_30219":72694,"_20927":124109,"_5":14373,"_27457":124064,"_2948":57298},[],{"_3465":72713,"_30219":72694,"_20927":124111,"_5":14373,"_27457":124064,"_2948":124112},[],"Perfil",{"_3465":72714,"_30219":72694,"_20927":124114,"_5":14373,"_27457":124064,"_2948":124115},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3465":72715,"_30219":72694,"_20927":124117,"_5":14373,"_27457":124064,"_2948":124118},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3465":72716,"_30219":72694,"_20927":124120,"_5":14373,"_27457":124064,"_2948":121362},[],{"_3465":72717,"_30219":72694,"_20927":124122,"_5":14373,"_27457":124064,"_2948":124123},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3465":72718,"_30219":72694,"_20927":124125,"_5":14373,"_27457":124064,"_2948":124126},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3465":72719,"_30219":72694,"_20927":124128,"_5":14373,"_27457":124064,"_2948":124129},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3465":72720,"_30219":72694,"_20927":124131,"_5":14373,"_27457":124064,"_2948":124132},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3465":72721,"_30219":72694,"_20927":124134,"_5":14373,"_27457":124068,"_2948":124135},[],"Revisa cada frontera por separado:",{"_3465":72722,"_30219":72694,"_20927":124137,"_5":14373,"_27457":124068,"_2948":124138},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3465":72723,"_30219":72694,"_20927":124140,"_5":14373,"_27457":124068,"_2948":124141},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3465":72724,"_30219":72694,"_20927":124143,"_5":14373,"_27457":124068,"_2948":124144},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3465":72725,"_30219":72694,"_20927":124146,"_5":14373,"_27457":124068,"_2948":124147},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3465":72726,"_30219":72694,"_20927":124149,"_5":14373,"_27457":124068,"_2948":124150},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3465":72727,"_30219":72694,"_20927":124152,"_5":14373,"_27457":124068,"_2948":124153},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3465":72728,"_30219":72694,"_20927":124155,"_5":14373,"_27457":124072,"_2948":124156},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3465":72729,"_30219":72694,"_20927":124158,"_5":14373,"_27457":124072,"_2948":124159},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3465":72730,"_30219":72730,"_5":14725,"_2948":124161,"_30551":124162,"_20927":124163,"_27457":72730},"Seguridad",[49254],[],{"_3465":72731,"_30219":72730,"_20927":124165,"_5":14373,"_27457":72730,"_2948":124166},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3465":72732,"_30219":72730,"_5":30548,"_20927":124168,"_27457":124169,"_2948":124170},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3465":72733,"_30219":72730,"_5":30548,"_20927":124172,"_27457":124173,"_2948":124174},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3465":72734,"_30219":72730,"_5":30548,"_20927":124176,"_27457":124177,"_2948":124178},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3465":72735,"_30219":72730,"_5":30548,"_20927":124180,"_27457":124181,"_2948":124182},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3465":72736,"_30219":72730,"_20927":124184,"_5":14373,"_27457":72730,"_2948":124185},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3465":72737,"_30219":72730,"_20927":124187,"_5":14373,"_27457":124169,"_2948":124188},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3465":72738,"_30219":72730,"_20927":124190,"_5":14373,"_27457":124169,"_2948":124191},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3465":72739,"_30219":72730,"_20927":124193,"_5":14373,"_27457":124169,"_2948":14997},[],{"_3465":72740,"_30219":72730,"_20927":124195,"_5":14373,"_27457":124169,"_2948":14937},[],{"_3465":72741,"_30219":72730,"_20927":124197,"_5":14373,"_27457":124169,"_2948":14984},[],{"_3465":72742,"_30219":72730,"_20927":124199,"_5":14373,"_27457":124169,"_2948":124200},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3465":72743,"_30219":72730,"_20927":124202,"_5":14373,"_27457":124169,"_2948":124203},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3465":72744,"_30219":72730,"_20927":124205,"_5":14373,"_27457":124173,"_2948":124206},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3465":72745,"_30219":72730,"_20927":124208,"_5":14373,"_27457":124173,"_2948":124209},[],"No incluyas en el reporte:",{"_3465":72746,"_30219":72730,"_20927":124211,"_5":14373,"_27457":124173,"_2948":124212},[],"Credenciales, tokens o claves privadas",{"_3465":72747,"_30219":72730,"_20927":124214,"_5":14373,"_27457":124173,"_2948":124215},[],"Datos de clientes o información identificable de clientes",{"_3465":72748,"_30219":72730,"_20927":124217,"_5":14373,"_27457":124173,"_2948":124218},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3465":72749,"_30219":72730,"_20927":124220,"_5":14373,"_27457":124177,"_2948":124221},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3465":72750,"_30219":72730,"_20927":124223,"_5":14373,"_27457":124177,"_2948":124224},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3465":72751,"_30219":72730,"_20927":124226,"_5":14373,"_27457":124181,"_2948":124227},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3465":72752,"_30219":72730,"_20927":124229,"_5":14373,"_27457":124181,"_2948":124230},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3465":72753,"_30219":72730,"_20927":124232,"_5":14373,"_27457":124181,"_2948":124233},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3465":72754,"_30219":72730,"_20927":124235,"_5":14373,"_27457":124181,"_2948":124236},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3465":72755,"_30219":72730,"_20927":124238,"_5":14373,"_27457":124181,"_2948":124239},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3465":72756,"_30219":72756,"_5":14725,"_2948":124241,"_30551":124242,"_20927":124244,"_27457":72756},"3.8.0 a 4.0.0",[49254,124243],"Actualizaciones",[],{"_3465":72757,"_30219":72756,"_20927":124246,"_5":14373,"_27457":72756,"_2948":124247},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3465":72758,"_30219":72756,"_5":30548,"_20927":124249,"_27457":124250,"_2948":124251},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3465":72759,"_30219":72756,"_5":30548,"_20927":124253,"_27457":124254,"_2948":124255},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3465":72760,"_30219":72756,"_5":30548,"_20927":124257,"_27457":124258,"_2948":124259},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3465":72761,"_30219":72756,"_5":30548,"_20927":124261,"_27457":124262,"_2948":124263},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3465":72762,"_30219":72756,"_5":30548,"_20927":124265,"_27457":124266,"_2948":124267},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3465":72763,"_30219":72756,"_5":30548,"_20927":124269,"_27457":124270,"_2948":124271},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3465":72764,"_30219":72756,"_5":30548,"_20927":124273,"_27457":124274,"_2948":57464},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3465":72765,"_30219":72756,"_5":30548,"_20927":124276,"_27457":124277,"_2948":124278},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3465":72766,"_30219":72756,"_5":30548,"_20927":124280,"_27457":124281,"_2948":124282},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3465":72767,"_30219":72756,"_5":30548,"_20927":124284,"_27457":124285,"_2948":124286},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3465":72768,"_30219":72756,"_5":30548,"_20927":124288,"_27457":124289,"_2948":124290},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3465":72769,"_30219":72756,"_5":30548,"_20927":124292,"_27457":124293,"_2948":124294},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3465":72770,"_30219":72756,"_5":30548,"_20927":124296,"_27457":124297,"_2948":124298},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3465":72771,"_30219":72756,"_5":30548,"_20927":124300,"_27457":124301,"_2948":124302},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3465":72772,"_30219":72756,"_5":30548,"_20927":124304,"_27457":124305,"_2948":124306},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3465":72773,"_30219":72756,"_5":30548,"_20927":124308,"_27457":124309,"_2948":124310},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3465":72774,"_30219":72756,"_5":30548,"_20927":124312,"_27457":124313,"_2948":124314},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3465":72775,"_30219":72756,"_5":30548,"_20927":124316,"_27457":124317,"_2948":124318},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3465":72776,"_30219":72756,"_5":30548,"_20927":124320,"_27457":124321,"_2948":124322},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3465":72777,"_30219":72756,"_5":30548,"_20927":124324,"_27457":124325,"_2948":124326},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3465":72778,"_30219":72756,"_5":30548,"_20927":124328,"_27457":124329,"_2948":124330},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3465":72779,"_30219":72756,"_5":30548,"_20927":124332,"_27457":124333,"_2948":124334},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3465":72780,"_30219":72756,"_5":30548,"_20927":124336,"_27457":124337,"_2948":124338},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3465":72781,"_30219":72756,"_5":30548,"_20927":124340,"_27457":124341,"_2948":124342},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3465":72782,"_30219":72756,"_5":30548,"_20927":124344,"_27457":124345,"_2948":124346},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3465":72783,"_30219":72756,"_5":30548,"_20927":124348,"_27457":124349,"_2948":124350},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3465":72784,"_30219":72756,"_5":30548,"_20927":124352,"_27457":124353,"_2948":124354},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3465":72785,"_30219":72756,"_5":30548,"_20927":124356,"_27457":124357,"_2948":124358},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3465":72786,"_30219":72756,"_5":30548,"_20927":124360,"_27457":124361,"_2948":124362},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3465":72787,"_30219":72756,"_5":30548,"_20927":124364,"_27457":124365,"_2948":124366},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3465":72788,"_30219":72756,"_5":30548,"_20927":124368,"_27457":124369,"_2948":124370},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3465":72789,"_30219":72756,"_5":30548,"_20927":124372,"_27457":124373,"_2948":124374},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3465":72790,"_30219":72756,"_5":30548,"_20927":124376,"_27457":124377,"_2948":124378},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3465":72791,"_30219":72756,"_5":30548,"_20927":124380,"_27457":124381,"_2948":124382},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3465":72792,"_30219":72756,"_5":30548,"_20927":124384,"_27457":124385,"_2948":124386},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3465":72793,"_30219":72756,"_5":30548,"_20927":124388,"_27457":124389,"_2948":124390},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3465":72794,"_30219":72756,"_5":30548,"_20927":124392,"_27457":124393,"_2948":124394},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3465":72795,"_30219":72756,"_5":30548,"_20927":124396,"_27457":124397,"_2948":124398},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3465":72796,"_30219":72756,"_5":30548,"_20927":124400,"_27457":124401,"_2948":124402},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3465":72797,"_30219":72756,"_5":30548,"_20927":124404,"_27457":124405,"_2948":124406},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3465":72798,"_30219":72756,"_5":30548,"_20927":124408,"_27457":124409,"_2948":120225},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3465":72799,"_30219":72756,"_5":30548,"_20927":124411,"_27457":124412,"_2948":124413},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3465":72800,"_30219":72756,"_5":30548,"_20927":124415,"_27457":124416,"_2948":124417},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3465":72801,"_30219":72756,"_20927":124419,"_5":14373,"_27457":72756,"_2948":124420},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3465":72802,"_30219":72756,"_20927":124422,"_5":14373,"_27457":72756,"_2948":124423},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3465":72803,"_30219":72756,"_20927":124425,"_5":14373,"_27457":72756,"_2948":124426},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3465":72804,"_30219":72756,"_20927":124428,"_5":14373,"_27457":72756,"_2948":124429},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3465":72805,"_30219":72756,"_20927":124431,"_5":14373,"_27457":72756,"_2948":124432},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3465":72806,"_30219":72756,"_20927":124434,"_5":14373,"_27457":72756,"_2948":124435},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3465":72807,"_30219":72756,"_20927":124437,"_5":14373,"_27457":72756,"_2948":124438},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3465":72808,"_30219":72756,"_20927":124440,"_5":14373,"_27457":124254,"_2948":124441},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3465":72809,"_30219":72756,"_20927":124443,"_5":14373,"_27457":124254,"_2948":124444},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3465":72810,"_30219":72756,"_20927":124446,"_5":14373,"_27457":124258,"_2948":124447},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3465":72811,"_30219":72756,"_20927":124449,"_5":14373,"_27457":124258,"_2948":124450},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3465":72812,"_30219":72756,"_20927":124452,"_5":14373,"_27457":124262,"_2948":124453},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3465":72813,"_30219":72756,"_20927":124455,"_5":14373,"_27457":124266,"_2948":124456},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3465":72814,"_30219":72756,"_20927":124458,"_5":14373,"_27457":124266,"_2948":124459},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3465":72815,"_30219":72756,"_20927":124461,"_5":14373,"_27457":124266,"_2948":124462},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3465":72816,"_30219":72756,"_20927":124464,"_5":14373,"_27457":124266,"_2948":124465},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3465":72817,"_30219":72756,"_20927":124467,"_5":14373,"_27457":124266,"_2948":124468},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3465":72818,"_30219":72756,"_20927":124470,"_5":14373,"_27457":124270,"_2948":124471},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3465":72819,"_30219":72756,"_20927":124473,"_5":14373,"_27457":124270,"_2948":124474},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3465":72820,"_30219":72756,"_20927":124476,"_5":14373,"_27457":124270,"_2948":124477},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3465":72821,"_30219":72756,"_20927":124479,"_5":14373,"_27457":124270,"_2948":124480},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3465":72822,"_30219":72756,"_20927":124482,"_5":14373,"_27457":124270,"_2948":124483},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3465":72823,"_30219":72756,"_20927":124485,"_5":14373,"_27457":124270,"_2948":124486},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3465":72824,"_30219":72756,"_20927":124488,"_5":14373,"_27457":124274,"_2948":124489},[],"Cambio",{"_3465":72825,"_30219":72756,"_20927":124491,"_5":14373,"_27457":124274,"_2948":124492},[],"A quién afecta",{"_3465":72826,"_30219":72756,"_20927":124494,"_5":14373,"_27457":124274,"_2948":124495},[],"Gravedad",{"_3465":72827,"_30219":72756,"_20927":124497,"_5":14373,"_27457":124274,"_2948":122992},[],{"_3465":72828,"_30219":72756,"_20927":124499,"_5":14373,"_27457":124274,"_2948":124282},[],{"_3465":72829,"_30219":72756,"_20927":124501,"_5":14373,"_27457":124274,"_2948":124502},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3465":72830,"_30219":72756,"_20927":124504,"_5":14373,"_27457":124274,"_2948":124505},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3465":72831,"_30219":72756,"_20927":124507,"_5":14373,"_27457":124274,"_2948":124508},[],"Copiar los datos a los volúmenes nuevos",{"_3465":72832,"_30219":72756,"_20927":124510,"_5":14373,"_27457":124274,"_2948":124286},[],{"_3465":72833,"_30219":72756,"_20927":124512,"_5":14373,"_27457":124274,"_2948":124513},[],"Todas las releases de Helm",{"_3465":72834,"_30219":72756,"_20927":124515,"_5":14373,"_27457":124274,"_2948":124516},[],"Alta: `helm upgrade` falla",{"_3465":72835,"_30219":72756,"_20927":124518,"_5":14373,"_27457":124274,"_2948":124519},[],"Eliminar o renombrar las claves heredadas",{"_3465":72836,"_30219":72756,"_20927":124521,"_5":14373,"_27457":124274,"_2948":124290},[],{"_3465":72837,"_30219":72756,"_20927":124523,"_5":14373,"_27457":124274,"_2948":124524},[],"Todos los despliegues",{"_3465":72838,"_30219":72756,"_20927":124526,"_5":14373,"_27457":124274,"_2948":124527},[],"Alta: sin principal de bootstrap no hay administrador",{"_3465":72839,"_30219":72756,"_20927":124529,"_5":14373,"_27457":124274,"_2948":124530},[],"Configurar `services.authz`",{"_3465":72840,"_30219":72756,"_20927":124532,"_5":14373,"_27457":124274,"_2948":124294},[],{"_3465":72841,"_30219":72756,"_20927":124534,"_5":14373,"_27457":124274,"_2948":124513},[],{"_3465":72842,"_30219":72756,"_20927":124536,"_5":14373,"_27457":124274,"_2948":124537},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3465":72843,"_30219":72756,"_20927":124539,"_5":14373,"_27457":124274,"_2948":124540},[],"Mover JWKS y roles a `services.authz`",{"_3465":72844,"_30219":72756,"_20927":124542,"_5":14373,"_27457":124274,"_2948":124314},[],{"_3465":72845,"_30219":72756,"_20927":124544,"_5":14373,"_27457":124274,"_2948":124545},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3465":72846,"_30219":72756,"_20927":124547,"_5":14373,"_27457":124274,"_2948":124548},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3465":72847,"_30219":72756,"_20927":124550,"_5":14373,"_27457":124274,"_2948":124551},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3465":72848,"_30219":72756,"_20927":124553,"_5":14373,"_27457":124274,"_2948":124318},[],{"_3465":72849,"_30219":72756,"_20927":124555,"_5":14373,"_27457":124274,"_2948":124556},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3465":72850,"_30219":72756,"_20927":124558,"_5":14373,"_27457":124274,"_2948":124559},[],"Alta: el backend ya no arranca con ellos",{"_3465":72851,"_30219":72756,"_20927":124561,"_5":14373,"_27457":124274,"_2948":124562},[],"Pasar a PostgreSQL antes de actualizar",{"_3465":72852,"_30219":72756,"_20927":124564,"_5":14373,"_27457":124274,"_2948":124362},[],{"_3465":72853,"_30219":72756,"_20927":124566,"_5":14373,"_27457":124274,"_2948":124567},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3465":72854,"_30219":72756,"_20927":124569,"_5":14373,"_27457":124274,"_2948":124570},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3465":72855,"_30219":72756,"_20927":124572,"_5":14373,"_27457":124274,"_2948":124573},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3465":72856,"_30219":72756,"_20927":124575,"_5":14373,"_27457":124274,"_2948":124576},[],"Webhooks con referencias a archivos",{"_3465":72857,"_30219":72756,"_20927":124578,"_5":14373,"_27457":124274,"_2948":124579},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3465":72858,"_30219":72756,"_20927":124581,"_5":14373,"_27457":124274,"_2948":124582},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3465":72859,"_30219":72756,"_20927":124584,"_5":14373,"_27457":124274,"_2948":124585},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3465":72860,"_30219":72756,"_20927":124587,"_5":14373,"_27457":124274,"_2948":124298},[],{"_3465":72861,"_30219":72756,"_20927":124589,"_5":14373,"_27457":124274,"_2948":124590},[],"Releases con identidades por servicio o material de claves montado",{"_3465":72862,"_30219":72756,"_20927":124592,"_5":14373,"_27457":124274,"_2948":124593},[],"Media: los servicios no pueden leer sus archivos",{"_3465":72863,"_30219":72756,"_20927":124595,"_5":14373,"_27457":124274,"_2948":124596},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3465":72864,"_30219":72756,"_20927":124598,"_5":14373,"_27457":124274,"_2948":124302},[],{"_3465":72865,"_30219":72756,"_20927":124600,"_5":14373,"_27457":124274,"_2948":124601},[],"Releases que definen `amqp.tls`",{"_3465":72866,"_30219":72756,"_20927":124603,"_5":14373,"_27457":124274,"_2948":124604},[],"Media: los clientes se conectan al puerto equivocado",{"_3465":72867,"_30219":72756,"_20927":124606,"_5":14373,"_27457":124274,"_2948":124607},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3465":72868,"_30219":72756,"_20927":124609,"_5":14373,"_27457":124274,"_2948":124322},[],{"_3465":72869,"_30219":72756,"_20927":124611,"_5":14373,"_27457":124274,"_2948":124612},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3465":72870,"_30219":72756,"_20927":124614,"_5":14373,"_27457":124274,"_2948":124615},[],"Media: las claves de CA quedan sin gestionar",{"_3465":72871,"_30219":72756,"_20927":124617,"_5":14373,"_27457":124274,"_2948":124618},[],"Ejecutar la migración de CA a KMS",{"_3465":72872,"_30219":72756,"_20927":124620,"_5":14373,"_27457":124274,"_2948":124621},[],"Verificación del certificado del receptor",{"_3465":72873,"_30219":72756,"_20927":124623,"_5":14373,"_27457":124274,"_2948":124624},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3465":72874,"_30219":72756,"_20927":124626,"_5":14373,"_27457":124274,"_2948":124627},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3465":72875,"_30219":72756,"_20927":124629,"_5":14373,"_27457":124274,"_2948":124630},[],"Poner `insecure_skip_verify` a `false`",{"_3465":72876,"_30219":72756,"_20927":124632,"_5":14373,"_27457":124274,"_2948":124338},[],{"_3465":72877,"_30219":72756,"_20927":124634,"_5":14373,"_27457":124274,"_2948":124635},[],"Scripts y consolas que editan DMS por API",{"_3465":72878,"_30219":72756,"_20927":124637,"_5":14373,"_27457":124274,"_2948":124638},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3465":72879,"_30219":72756,"_20927":124640,"_5":14373,"_27457":124274,"_2948":124641},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3465":72880,"_30219":72756,"_20927":124643,"_5":14373,"_27457":124274,"_2948":124358},[],{"_3465":72881,"_30219":72756,"_20927":124645,"_5":14373,"_27457":124274,"_2948":124646},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3465":72882,"_30219":72756,"_20927":124648,"_5":14373,"_27457":124274,"_2948":124649},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3465":72883,"_30219":72756,"_20927":124651,"_5":14373,"_27457":124274,"_2948":124652},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3465":72884,"_30219":72756,"_20927":124654,"_5":14373,"_27457":124274,"_2948":124366},[],{"_3465":72885,"_30219":72756,"_20927":124656,"_5":14373,"_27457":124274,"_2948":124657},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3465":72886,"_30219":72756,"_20927":124659,"_5":14373,"_27457":124274,"_2948":124660},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3465":72887,"_30219":72756,"_20927":124662,"_5":14373,"_27457":124274,"_2948":124663},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3465":72888,"_30219":72756,"_20927":124665,"_5":14373,"_27457":124274,"_2948":124354},[],{"_3465":72889,"_30219":72756,"_20927":124667,"_5":14373,"_27457":124274,"_2948":124668},[],"Consumidores que leen el campo `events` del dispositivo",{"_3465":72890,"_30219":72756,"_20927":124670,"_5":14373,"_27457":124274,"_2948":124671},[],"Media: el campo desaparece",{"_3465":72891,"_30219":72756,"_20927":124673,"_5":14373,"_27457":124274,"_2948":124674},[],"Usar los nuevos endpoints de eventos",{"_3465":72892,"_30219":72756,"_20927":124676,"_5":14373,"_27457":124274,"_2948":124374},[],{"_3465":72893,"_30219":72756,"_20927":124678,"_5":14373,"_27457":124274,"_2948":124679},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3465":72894,"_30219":72756,"_20927":124681,"_5":14373,"_27457":124274,"_2948":124682},[],"Media: la migración de la VA aborta",{"_3465":72895,"_30219":72756,"_20927":124684,"_5":14373,"_27457":124274,"_2948":124685},[],"Corregir los roles afectados antes de actualizar",{"_3465":72896,"_30219":72756,"_20927":124687,"_5":14373,"_27457":124274,"_2948":124306},[],{"_3465":72897,"_30219":72756,"_20927":124689,"_5":14373,"_27457":124274,"_2948":124690},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3465":72898,"_30219":72756,"_20927":124692,"_5":14373,"_27457":124274,"_2948":124693},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3465":72899,"_30219":72756,"_20927":124695,"_5":14373,"_27457":124274,"_2948":124696},[],"Actualizar el archivo de values",{"_3465":72900,"_30219":72756,"_20927":124698,"_5":14373,"_27457":124274,"_2948":124346},[],{"_3465":72901,"_30219":72756,"_20927":124700,"_5":14373,"_27457":124274,"_2948":124701},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3465":72902,"_30219":72756,"_20927":124703,"_5":14373,"_27457":124274,"_2948":124704},[],"Baja: prevalece el ID de la URL",{"_3465":72903,"_30219":72756,"_20927":124706,"_5":14373,"_27457":124274,"_2948":124707},[],"Enviar el ID en la URL",{"_3465":72904,"_30219":72756,"_20927":124709,"_5":14373,"_27457":124274,"_2948":124370},[],{"_3465":72905,"_30219":72756,"_20927":124711,"_5":14373,"_27457":124274,"_2948":124712},[],"Clientes que envían un `id` al crear o importar CAs",{"_3465":72906,"_30219":72756,"_20927":124714,"_5":14373,"_27457":124274,"_2948":124715},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3465":72907,"_30219":72756,"_20927":124717,"_5":14373,"_27457":124274,"_2948":124718},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3465":72908,"_30219":72756,"_20927":124720,"_5":14373,"_27457":124274,"_2948":124350},[],{"_3465":72909,"_30219":72756,"_20927":124722,"_5":14373,"_27457":124274,"_2948":124723},[],"Consumidores que comparan el `type` del certificado",{"_3465":72910,"_30219":72756,"_20927":124725,"_5":14373,"_27457":124274,"_2948":124726},[],"Baja: dos valores cambian de nombre",{"_3465":72911,"_30219":72756,"_20927":124728,"_5":14373,"_27457":124274,"_2948":124729},[],"Adaptar los consumidores",{"_3465":72912,"_30219":72756,"_20927":124731,"_5":14373,"_27457":124274,"_2948":124342},[],{"_3465":72913,"_30219":72756,"_20927":124733,"_5":14373,"_27457":124274,"_2948":124734},[],"Cualquier DMS",{"_3465":72914,"_30219":72756,"_20927":124736,"_5":14373,"_27457":124274,"_2948":124737},[],"Baja: solo informativo",{"_3465":72915,"_30219":72756,"_20927":124739,"_5":14373,"_27457":124274,"_2948":124740},[],"Revisar ambos bloques antes de editar",{"_3465":72916,"_30219":72756,"_20927":124742,"_5":14373,"_27457":124281,"_2948":124743},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3465":72917,"_30219":72756,"_20927":124745,"_5":14373,"_27457":124281,"_2948":124746},[],"El paso 4 de la guía de migración copia los datos.",{"_3465":72918,"_30219":72756,"_20927":124748,"_5":14373,"_27457":124285,"_2948":124749},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3465":72919,"_30219":72756,"_20927":124751,"_5":14373,"_27457":124289,"_2948":124752},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3465":72920,"_30219":72756,"_20927":124754,"_5":14373,"_27457":124293,"_2948":124755},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3465":72921,"_30219":72756,"_20927":124757,"_5":14373,"_27457":124297,"_2948":124758},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3465":72922,"_30219":72756,"_20927":124760,"_5":14373,"_27457":124297,"_2948":124761},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3465":72923,"_30219":72756,"_20927":124763,"_5":14373,"_27457":124301,"_2948":124764},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3465":72924,"_30219":72756,"_20927":124766,"_5":14373,"_27457":124305,"_2948":124767},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3465":72925,"_30219":72756,"_20927":124769,"_5":14373,"_27457":124305,"_2948":124770},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3465":72926,"_30219":72756,"_20927":124772,"_5":14373,"_27457":124305,"_2948":124773},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3465":72927,"_30219":72756,"_20927":124775,"_5":14373,"_27457":124305,"_2948":124776},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3465":72928,"_30219":72756,"_20927":124778,"_5":14373,"_27457":124305,"_2948":124779},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3465":72929,"_30219":72756,"_20927":124781,"_5":14373,"_27457":124305,"_2948":124782},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3465":72930,"_30219":72756,"_20927":124784,"_5":14373,"_27457":124313,"_2948":124785},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3465":72931,"_30219":72756,"_20927":124787,"_5":14373,"_27457":124313,"_2948":124788},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3465":72932,"_30219":72756,"_20927":124790,"_5":14373,"_27457":124313,"_2948":124791},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3465":72933,"_30219":72756,"_20927":124793,"_5":14373,"_27457":124313,"_2948":124794},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3465":72934,"_30219":72756,"_20927":124796,"_5":14373,"_27457":124313,"_2948":124797},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3465":72935,"_30219":72756,"_20927":124799,"_5":14373,"_27457":124317,"_2948":124800},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3465":72936,"_30219":72756,"_20927":124802,"_5":14373,"_27457":124321,"_2948":124803},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3465":72937,"_30219":72756,"_20927":124805,"_5":14373,"_27457":124321,"_2948":124806},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3465":72938,"_30219":72756,"_20927":124808,"_5":14373,"_27457":124321,"_2948":124809},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3465":72939,"_30219":72756,"_20927":124811,"_5":14373,"_27457":124321,"_2948":124812},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3465":72940,"_30219":72756,"_20927":124814,"_5":14373,"_27457":124321,"_2948":124815},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3465":72941,"_30219":72756,"_20927":124817,"_5":14373,"_27457":124321,"_2948":124818},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3465":72942,"_30219":72756,"_20927":124820,"_5":14373,"_27457":124321,"_2948":124821},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3465":72943,"_30219":72756,"_20927":124823,"_5":14373,"_27457":124321,"_2948":124824},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3465":72944,"_30219":72756,"_20927":124826,"_5":14373,"_27457":124325,"_2948":124827},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3465":72945,"_30219":72756,"_20927":124829,"_5":14373,"_27457":124333,"_2948":124830},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3465":72946,"_30219":72756,"_20927":124832,"_5":14373,"_27457":124333,"_2948":124833},[],"Campo en 3.8.0",{"_3465":72947,"_30219":72756,"_20927":124835,"_5":14373,"_27457":124333,"_2948":124836},[],"Campo en 4.0.0",{"_3465":72948,"_30219":72756,"_20927":124838,"_5":14373,"_27457":124333,"_2948":58029},[],{"_3465":72949,"_30219":72756,"_20927":124840,"_5":14373,"_27457":124333,"_2948":124841},[],"`insecure_skip_verify` (con el valor negado)",{"_3465":72950,"_30219":72756,"_20927":124843,"_5":14373,"_27457":124333,"_2948":58035},[],{"_3465":72951,"_30219":72756,"_20927":124845,"_5":14373,"_27457":124333,"_2948":58038},[],{"_3465":72952,"_30219":72756,"_20927":124847,"_5":14373,"_27457":124333,"_2948":58041},[],{"_3465":72953,"_30219":72756,"_20927":124849,"_5":14373,"_27457":124333,"_2948":58044},[],{"_3465":72954,"_30219":72756,"_20927":124851,"_5":14373,"_27457":124333,"_2948":58047},[],{"_3465":72955,"_30219":72756,"_20927":124853,"_5":14373,"_27457":124333,"_2948":58050},[],{"_3465":72956,"_30219":72756,"_20927":124855,"_5":14373,"_27457":124333,"_2948":124856},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3465":72957,"_30219":72756,"_20927":124858,"_5":14373,"_27457":124333,"_2948":124859},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3465":72958,"_30219":72756,"_20927":124861,"_5":14373,"_27457":124333,"_2948":124862},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3465":72959,"_30219":72756,"_20927":124864,"_5":14373,"_27457":124337,"_2948":124865},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3465":72960,"_30219":72756,"_20927":124867,"_5":14373,"_27457":124337,"_2948":124868},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3465":72961,"_30219":72756,"_20927":124870,"_5":14373,"_27457":124337,"_2948":124871},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3465":72962,"_30219":72756,"_20927":124873,"_5":14373,"_27457":124341,"_2948":124874},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3465":72963,"_30219":72756,"_20927":124876,"_5":14373,"_27457":124345,"_2948":124877},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3465":72964,"_30219":72756,"_20927":124879,"_5":14373,"_27457":124349,"_2948":124880},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3465":72965,"_30219":72756,"_20927":124882,"_5":14373,"_27457":124353,"_2948":124883},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3465":72966,"_30219":72756,"_20927":124885,"_5":14373,"_27457":124353,"_2948":124886},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3465":72967,"_30219":72756,"_20927":124888,"_5":14373,"_27457":124353,"_2948":124889},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3465":72968,"_30219":72756,"_20927":124891,"_5":14373,"_27457":124353,"_2948":124892},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3465":72969,"_30219":72756,"_20927":124894,"_5":14373,"_27457":124357,"_2948":124895},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3465":72970,"_30219":72756,"_20927":124897,"_5":14373,"_27457":124361,"_2948":124898},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3465":72971,"_30219":72756,"_20927":124900,"_5":14373,"_27457":124361,"_2948":124901},[],"Ruta",{"_3465":72972,"_30219":72756,"_20927":124903,"_5":14373,"_27457":124361,"_2948":117464},[],{"_3465":72973,"_30219":72756,"_20927":124905,"_5":14373,"_27457":124361,"_2948":58103},[],{"_3465":72974,"_30219":72756,"_20927":124907,"_5":14373,"_27457":124361,"_2948":124908},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3465":72975,"_30219":72756,"_20927":124910,"_5":14373,"_27457":124361,"_2948":58109},[],{"_3465":72976,"_30219":72756,"_20927":124912,"_5":14373,"_27457":124361,"_2948":124913},[],"Lee los ajustes de una CA.",{"_3465":72977,"_30219":72756,"_20927":124915,"_5":14373,"_27457":124361,"_2948":58115},[],{"_3465":72978,"_30219":72756,"_20927":124917,"_5":14373,"_27457":124361,"_2948":124918},[],"Sustituye los `crl_options`.",{"_3465":72979,"_30219":72756,"_20927":124920,"_5":14373,"_27457":124361,"_2948":124921},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3465":72980,"_30219":72756,"_20927":124923,"_5":14373,"_27457":124361,"_2948":124924},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3465":72981,"_30219":72756,"_20927":124926,"_5":14373,"_27457":124361,"_2948":124927},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3465":72982,"_30219":72756,"_20927":124929,"_5":14373,"_27457":124361,"_2948":124930},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3465":72983,"_30219":72756,"_20927":124932,"_5":14373,"_27457":124361,"_2948":124933},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3465":72984,"_30219":72756,"_20927":124935,"_5":14373,"_27457":124361,"_2948":124936},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3465":72985,"_30219":72756,"_20927":124938,"_5":14373,"_27457":124361,"_2948":124939},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3465":72986,"_30219":72756,"_20927":124941,"_5":14373,"_27457":124361,"_2948":124942},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3465":72987,"_30219":72756,"_20927":124944,"_5":14373,"_27457":124361,"_2948":124945},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3465":72988,"_30219":72756,"_20927":124947,"_5":14373,"_27457":124361,"_2948":124948},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3465":72989,"_30219":72756,"_20927":124950,"_5":14373,"_27457":124361,"_2948":124951},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3465":72990,"_30219":72756,"_20927":124953,"_5":14373,"_27457":124365,"_2948":124954},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3465":72991,"_30219":72756,"_20927":124956,"_5":14373,"_27457":124369,"_2948":124957},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3465":72992,"_30219":72756,"_20927":124959,"_5":14373,"_27457":124373,"_2948":124960},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3465":72993,"_30219":72756,"_20927":124962,"_5":14373,"_27457":124377,"_2948":124963},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3465":72994,"_30219":72756,"_20927":124965,"_5":14373,"_27457":124381,"_2948":124966},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3465":72995,"_30219":72756,"_20927":124968,"_5":14373,"_27457":124381,"_2948":124969},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3465":72996,"_30219":72756,"_20927":124971,"_5":14373,"_27457":124381,"_2948":124972},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3465":72997,"_30219":72756,"_20927":124974,"_5":14373,"_27457":124381,"_2948":124975},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3465":72998,"_30219":72756,"_20927":124977,"_5":14373,"_27457":124381,"_2948":124978},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3465":72999,"_30219":72756,"_20927":124980,"_5":14373,"_27457":124381,"_2948":124981},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3465":73000,"_30219":72756,"_20927":124983,"_5":14373,"_27457":124385,"_2948":124984},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3465":73001,"_30219":72756,"_20927":124986,"_5":14373,"_27457":124385,"_2948":124987},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3465":73002,"_30219":72756,"_20927":124989,"_5":14373,"_27457":124385,"_2948":124990},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3465":73003,"_30219":72756,"_20927":124992,"_5":14373,"_27457":124385,"_2948":124993},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3465":73004,"_30219":72756,"_20927":124995,"_5":14373,"_27457":124385,"_2948":124996},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3465":73005,"_30219":72756,"_20927":124998,"_5":14373,"_27457":124389,"_2948":124999},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3465":73006,"_30219":72756,"_20927":125001,"_5":14373,"_27457":124389,"_2948":125002},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3465":73007,"_30219":72756,"_20927":125004,"_5":14373,"_27457":124389,"_2948":125005},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3465":73008,"_30219":72756,"_20927":125007,"_5":14373,"_27457":124389,"_2948":125008},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3465":73009,"_30219":72756,"_20927":125010,"_5":14373,"_27457":124389,"_2948":125011},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3465":73010,"_30219":72756,"_20927":125013,"_5":14373,"_27457":124389,"_2948":125014},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3465":73011,"_30219":72756,"_20927":125016,"_5":14373,"_27457":124389,"_2948":125017},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3465":73012,"_30219":72756,"_20927":125019,"_5":14373,"_27457":124389,"_2948":125020},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3465":73013,"_30219":72756,"_20927":125022,"_5":14373,"_27457":124389,"_2948":125023},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3465":73014,"_30219":72756,"_20927":125025,"_5":14373,"_27457":124389,"_2948":125026},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3465":73015,"_30219":72756,"_20927":125028,"_5":14373,"_27457":124389,"_2948":125029},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3465":73016,"_30219":72756,"_20927":125031,"_5":14373,"_27457":124389,"_2948":125032},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3465":73017,"_30219":72756,"_20927":125034,"_5":14373,"_27457":124393,"_2948":125035},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3465":73018,"_30219":72756,"_20927":125037,"_5":14373,"_27457":124393,"_2948":125038},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3465":73019,"_30219":72756,"_20927":125040,"_5":14373,"_27457":124397,"_2948":125041},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3465":73020,"_30219":72756,"_20927":125043,"_5":14373,"_27457":124397,"_2948":125044},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3465":73021,"_30219":72756,"_20927":125046,"_5":14373,"_27457":124397,"_2948":125047},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3465":73022,"_30219":72756,"_20927":125049,"_5":14373,"_27457":124397,"_2948":125050},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3465":73023,"_30219":72756,"_20927":125052,"_5":14373,"_27457":124397,"_2948":125053},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3465":73024,"_30219":72756,"_20927":125055,"_5":14373,"_27457":124397,"_2948":125056},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3465":73025,"_30219":72756,"_20927":125058,"_5":14373,"_27457":124397,"_2948":125059},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3465":73026,"_30219":72756,"_20927":125061,"_5":14373,"_27457":124397,"_2948":125062},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3465":73027,"_30219":72756,"_20927":125064,"_5":14373,"_27457":124397,"_2948":125065},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3465":73028,"_30219":72756,"_20927":125067,"_5":14373,"_27457":124397,"_2948":125068},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3465":73029,"_30219":72756,"_20927":125070,"_5":14373,"_27457":124397,"_2948":125071},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3465":73030,"_30219":72756,"_20927":125073,"_5":14373,"_27457":124401,"_2948":125074},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3465":73031,"_30219":72756,"_20927":125076,"_5":14373,"_27457":124401,"_2948":125077},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3465":73032,"_30219":72756,"_20927":125079,"_5":14373,"_27457":124405,"_2948":125080},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3465":73033,"_30219":72756,"_20927":125082,"_5":14373,"_27457":124405,"_2948":125083},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3465":73034,"_30219":72756,"_20927":125085,"_5":14373,"_27457":124405,"_2948":125086},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3465":73035,"_30219":72756,"_20927":125088,"_5":14373,"_27457":124405,"_2948":125089},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3465":73036,"_30219":72756,"_20927":125091,"_5":14373,"_27457":124405,"_2948":125092},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3465":73037,"_30219":72756,"_20927":125094,"_5":14373,"_27457":124405,"_2948":125095},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3465":73038,"_30219":72756,"_20927":125097,"_5":14373,"_27457":124405,"_2948":125098},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3465":73039,"_30219":72756,"_20927":125100,"_5":14373,"_27457":124405,"_2948":125101},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3465":73040,"_30219":72756,"_20927":125103,"_5":14373,"_27457":124409,"_2948":125104},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3465":73041,"_30219":72756,"_20927":125106,"_5":14373,"_27457":124409,"_2948":125107},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3465":73042,"_30219":72756,"_20927":125109,"_5":14373,"_27457":124409,"_2948":125110},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3465":73043,"_30219":72756,"_20927":125112,"_5":14373,"_27457":124409,"_2948":125113},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3465":73044,"_30219":72756,"_20927":125115,"_5":14373,"_27457":124409,"_2948":125116},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3465":73045,"_30219":72756,"_20927":125118,"_5":14373,"_27457":124409,"_2948":125119},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3465":73046,"_30219":72756,"_20927":125121,"_5":14373,"_27457":124409,"_2948":125122},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3465":73047,"_30219":72756,"_20927":125124,"_5":14373,"_27457":124409,"_2948":125125},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3465":73048,"_30219":72756,"_20927":125127,"_5":14373,"_27457":124409,"_2948":125128},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3465":73049,"_30219":72756,"_20927":125130,"_5":14373,"_27457":124409,"_2948":125131},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3465":73050,"_30219":72756,"_20927":125133,"_5":14373,"_27457":124409,"_2948":125134},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3465":73051,"_30219":72756,"_20927":125136,"_5":14373,"_27457":124412,"_2948":125137},[],"Tras la actualización, comprueba en este orden:",{"_3465":73052,"_30219":72756,"_20927":125139,"_5":14373,"_27457":124412,"_2948":125140},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3465":73053,"_30219":72756,"_20927":125142,"_5":14373,"_27457":124412,"_2948":125143},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3465":73054,"_30219":72756,"_20927":125145,"_5":14373,"_27457":124412,"_2948":125146},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3465":73055,"_30219":72756,"_20927":125148,"_5":14373,"_27457":124412,"_2948":125149},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3465":73056,"_30219":72756,"_20927":125151,"_5":14373,"_27457":124412,"_2948":125152},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3465":73057,"_30219":72756,"_20927":125154,"_5":14373,"_27457":124412,"_2948":125155},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3465":73058,"_30219":72756,"_20927":125157,"_5":14373,"_27457":124412,"_2948":125158},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3465":73059,"_30219":72756,"_20927":125160,"_5":14373,"_27457":124412,"_2948":125161},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3465":73060,"_30219":72756,"_20927":125163,"_5":14373,"_27457":124412,"_2948":125164},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3465":73061,"_30219":72756,"_20927":125166,"_5":14373,"_27457":124412,"_2948":125167},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3465":73062,"_30219":72756,"_20927":125169,"_5":14373,"_27457":124412,"_2948":125170},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3465":73063,"_30219":72756,"_20927":125172,"_5":14373,"_27457":124412,"_2948":125173},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3465":73064,"_30219":72756,"_20927":125175,"_5":14373,"_27457":124412,"_2948":125176},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3465":73065,"_30219":72756,"_20927":125178,"_5":14373,"_27457":124412,"_2948":125179},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3465":73066,"_30219":72756,"_20927":125181,"_5":14373,"_27457":124412,"_2948":125182},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3465":73067,"_30219":72756,"_20927":125184,"_5":14373,"_27457":124416,"_2948":125185},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3465":73068,"_30219":72756,"_20927":125187,"_5":14373,"_27457":124416,"_2948":125188},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3465":73069,"_30219":72756,"_20927":125190,"_5":14373,"_27457":124416,"_2948":125191},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":73070,"_30219":72756,"_20927":125193,"_5":14373,"_27457":124416,"_2948":125194},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3465":73071,"_30219":72756,"_20927":125196,"_5":14373,"_27457":124416,"_2948":125197},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58400":125199,"_58402":125200,"_58404":125201,"_58406":125202,"_18133":2983,"_70137":2983},"spanish",[2948,30219,5,27457],{"_2948":25026,"_30219":25026,"_5":25026,"_27457":25026},{"_2948":125203,"_30219":128134,"_5":131065,"_27457":133996},{"_4645":125204,"_58410":125205,"_5":25026},{"_14449":10458,"_14829":4612,"_14848":7199,"_29222":3444,"_14835":5950,"_19859":8652,"_14470":6970,"_14477":13293,"_29164":20344,"_29573":14244,"_29594":6541,"_29198":7027,"_34539":12263,"_29301":20339,"_29638":9859,"_34546":22841,"_34549":4593,"_34552":7010,"_34555":14078,"_30045":3348,"_34560":16786,"_34562":7573,"_30075":5133,"_14844":15806,"_34566":7499,"_34569":6580,"_34571":7643,"_29622":23601,"_30040":4799,"_30088":12179,"_34576":6015,"_34578":3767,"_34580":6995,"_29318":6371,"_34583":5152,"_34585":4315,"_34587":7824,"_34589":7136,"_34591":28745,"_29235":4688,"_34594":4617,"_34596":5054,"_29229":8808,"_29659":5630,"_34600":16272,"_34602":11081,"_34605":5254,"_29275":6945,"_34609":4966,"_29155":9917,"_34612":4951,"_29203":6991,"_34615":11754,"_34617":3730,"_3