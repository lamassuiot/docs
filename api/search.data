5":28905,"_19790":46308,"_26008":46309,"_2720":46310},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3227":18,"_28586":15,"_5":28905,"_19790":46312,"_26008":46313,"_2720":46314},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3227":19,"_28586":15,"_5":28905,"_19790":46316,"_26008":46317,"_2720":46318},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3227":20,"_28586":15,"_5":28905,"_19790":46320,"_26008":46321,"_2720":46322},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3227":21,"_28586":15,"_5":28905,"_19790":46324,"_26008":46325,"_2720":46326},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3227":22,"_28586":15,"_5":28905,"_19790":46328,"_26008":46329,"_2720":46330},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3227":23,"_28586":15,"_5":28905,"_19790":46332,"_26008":46333,"_2720":46334},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3227":24,"_28586":15,"_19790":46336,"_5":13558,"_26008":15,"_2720":46337},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3227":25,"_28586":15,"_19790":46339,"_5":13558,"_26008":46309,"_2720":46340},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3227":26,"_28586":15,"_19790":46342,"_5":13558,"_26008":46309,"_2720":46343},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3227":27,"_28586":15,"_19790":46345,"_5":13558,"_26008":46309,"_2720":46346},[],"A security group allowing the necessary endpoints.",{"_3227":28,"_28586":15,"_19790":46348,"_5":13558,"_26008":46313,"_2720":46349},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3227":29,"_28586":15,"_19790":46351,"_5":13558,"_26008":46313,"_2720":46352},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3227":30,"_28586":15,"_19790":46354,"_5":13558,"_26008":46313,"_2720":46355},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3227":31,"_28586":15,"_19790":46357,"_5":13558,"_26008":46317,"_2720":46358},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3227":32,"_28586":15,"_19790":46360,"_5":13558,"_26008":46321,"_2720":46361},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3227":33,"_28586":15,"_19790":46363,"_5":13558,"_26008":46325,"_2720":46364},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3227":34,"_28586":15,"_19790":46366,"_5":13558,"_26008":46329,"_2720":46367},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3227":35,"_28586":15,"_19790":46369,"_5":13558,"_26008":46333,"_2720":46370},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3227":36,"_28586":36,"_5":13916,"_2720":46372,"_28908":46373,"_19790":46374,"_26008":36},"Deploy Lamassu",[46300,46301],[],{"_3227":37,"_28586":36,"_19790":46376,"_5":13558,"_26008":36,"_2720":46377},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3227":38,"_28586":36,"_5":28905,"_19790":46379,"_26008":46380,"_2720":46381},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3227":39,"_28586":36,"_5":28905,"_19790":46383,"_26008":46384,"_2720":46385},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3227":40,"_28586":36,"_5":28905,"_19790":46387,"_26008":46388,"_2720":46389},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3227":41,"_28586":36,"_19790":46391,"_5":13558,"_26008":36,"_2720":46392},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3227":42,"_28586":36,"_19790":46394,"_5":13558,"_26008":46380,"_2720":46395},[],"Model",{"_3227":43,"_28586":36,"_19790":46397,"_5":13558,"_26008":46380,"_2720":46398},[],"Recommended for",{"_3227":44,"_28586":36,"_19790":46400,"_5":13558,"_26008":46380,"_2720":46401},[],"Who operates the infrastructure",{"_3227":45,"_28586":36,"_19790":46403,"_5":13558,"_26008":46380,"_2720":46404},[],"Starting point",{"_3227":46,"_28586":36,"_19790":46406,"_5":13558,"_26008":46380,"_2720":46407},[],"Kubernetes self-managed",{"_3227":47,"_28586":36,"_19790":46409,"_5":13558,"_26008":46380,"_2720":46410},[],"Production, regulated environments and custom deployments",{"_3227":48,"_28586":36,"_19790":46412,"_5":13558,"_26008":46380,"_2720":46413},[],"Your team",{"_3227":49,"_28586":36,"_19790":46415,"_5":13558,"_26008":46380,"_2720":46416},[],"Helm or Fastlane",{"_3227":50,"_28586":36,"_19790":46418,"_5":13558,"_26008":46380,"_2720":46419},[],"AWS Marketplace",{"_3227":51,"_28586":36,"_19790":46421,"_5":13558,"_26008":46380,"_2720":46422},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3227":52,"_28586":36,"_19790":46424,"_5":13558,"_26008":46380,"_2720":46413},[],{"_3227":53,"_28586":36,"_19790":46426,"_5":13558,"_26008":46380,"_2720":46427},[],"Preconfigured image on EC2",{"_3227":54,"_28586":36,"_19790":46429,"_5":13558,"_26008":46380,"_2720":46430},[],"SaaS",{"_3227":55,"_28586":36,"_19790":46432,"_5":13558,"_26008":46380,"_2720":46433},[],"Teams that want to use the platform without operating it",{"_3227":56,"_28586":36,"_19790":46435,"_5":13558,"_26008":46380,"_2720":46436},[],"Lamassu",{"_3227":57,"_28586":36,"_19790":46438,"_5":13558,"_26008":46380,"_2720":46439},[],"Managed subscription",{"_3227":58,"_28586":36,"_19790":46441,"_5":13558,"_26008":46380,"_2720":46442},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3227":59,"_28586":36,"_19790":46444,"_5":13558,"_26008":46380,"_2720":46445},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3227":60,"_28586":36,"_19790":46447,"_5":13558,"_26008":46380,"_2720":46448},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3227":61,"_28586":36,"_19790":46450,"_5":13558,"_26008":46384,"_2720":46451},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3227":62,"_28586":36,"_19790":46453,"_5":13558,"_26008":46388,"_2720":46454},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3227":63,"_28586":63,"_5":13916,"_2720":46456,"_28908":46457,"_19790":46458,"_26008":63},"Use Lamassu as SaaS",[46300,46301,46302],[],{"_3227":64,"_28586":63,"_19790":46460,"_5":13558,"_26008":63,"_2720":46461},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3227":65,"_28586":63,"_5":28905,"_19790":46463,"_26008":46464,"_2720":46465},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3227":66,"_28586":63,"_5":28905,"_19790":46467,"_26008":46468,"_2720":46469},[],"/docs/deployment/saas#plans","Plans",{"_3227":67,"_28586":63,"_5":28905,"_19790":46471,"_26008":46472,"_2720":46473},[],"/docs/deployment/saas#request-access","Request access",{"_3227":68,"_28586":63,"_19790":46475,"_5":13558,"_26008":63,"_2720":46476},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3227":69,"_28586":63,"_19790":46478,"_5":13558,"_26008":46464,"_2720":46479},[],"Platform availability and maintenance.",{"_3227":70,"_28586":63,"_19790":46481,"_5":13558,"_26008":46464,"_2720":46482},[],"Automatic backups.",{"_3227":71,"_28586":63,"_19790":46484,"_5":13558,"_26008":46464,"_2720":46485},[],"Version upgrades.",{"_3227":72,"_28586":63,"_19790":46487,"_5":13558,"_26008":46464,"_2720":46488},[],"Technical support and SLA according to your plan.",{"_3227":73,"_28586":63,"_19790":46490,"_5":13558,"_26008":46468,"_2720":46491},[],"Plan",{"_3227":74,"_28586":63,"_19790":46493,"_5":13558,"_26008":46468,"_2720":46494},[],"Devices",{"_3227":75,"_28586":63,"_19790":46496,"_5":13558,"_26008":46468,"_2720":46497},[],"Support",{"_3227":76,"_28586":63,"_19790":46499,"_5":13558,"_26008":46468,"_2720":46500},[],"SLA",{"_3227":77,"_28586":63,"_19790":46502,"_5":13558,"_26008":46468,"_2720":46503},[],"Starter",{"_3227":78,"_28586":63,"_19790":46505,"_5":13558,"_26008":46468,"_2720":46506},[],"Up to 1,000",{"_3227":79,"_28586":63,"_19790":46508,"_5":13558,"_26008":46468,"_2720":46509},[],"Email",{"_3227":80,"_28586":63,"_19790":46511,"_5":13558,"_26008":46468,"_2720":46512},[],"99.5 %",{"_3227":81,"_28586":63,"_19790":46514,"_5":13558,"_26008":46468,"_2720":46515},[],"Professional",{"_3227":82,"_28586":63,"_19790":46517,"_5":13558,"_26008":46468,"_2720":46518},[],"Up to 10,000",{"_3227":83,"_28586":63,"_19790":46520,"_5":13558,"_26008":46468,"_2720":46521},[],"Email and chat",{"_3227":84,"_28586":63,"_19790":46523,"_5":13558,"_26008":46468,"_2720":46524},[],"99.9 %",{"_3227":85,"_28586":63,"_19790":46526,"_5":13558,"_26008":46468,"_2720":46527},[],"Enterprise",{"_3227":86,"_28586":63,"_19790":46529,"_5":13558,"_26008":46468,"_2720":46530},[],"Unlimited",{"_3227":87,"_28586":63,"_19790":46532,"_5":13558,"_26008":46468,"_2720":46533},[],"Dedicated",{"_3227":88,"_28586":63,"_19790":46535,"_5":13558,"_26008":46468,"_2720":46536},[],"99.99 %",{"_3227":89,"_28586":63,"_19790":46538,"_5":13558,"_26008":46472,"_2720":46539},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3227":90,"_28586":63,"_19790":46541,"_5":13558,"_26008":46472,"_2720":46542},[],"When you receive your instance's credentials, continue with Get started.",{"_3227":91,"_28586":91,"_5":13916,"_2720":46544,"_28908":46545,"_19790":46546,"_26008":91},"Fastlane",[46300,46301,46407],[],{"_3227":92,"_28586":91,"_19790":46548,"_5":13558,"_26008":91,"_2720":46549},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3227":93,"_28586":91,"_5":28905,"_19790":46551,"_26008":46552,"_2720":46553},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3227":94,"_28586":91,"_5":28905,"_19790":46555,"_26008":46556,"_2720":46557},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3227":95,"_28586":91,"_5":28905,"_19790":46559,"_26008":46560,"_2720":46310},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3227":96,"_28586":91,"_5":28905,"_19790":46562,"_26008":46563,"_2720":46564},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3227":97,"_28586":91,"_5":28905,"_19790":46566,"_26008":46567,"_2720":46568},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3227":98,"_28586":91,"_5":28905,"_19790":46570,"_26008":46571,"_2720":46572},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3227":99,"_28586":91,"_5":28905,"_19790":46574,"_26008":46575,"_2720":46576},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3227":100,"_28586":91,"_5":28905,"_19790":46578,"_26008":46579,"_2720":46580},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3227":101,"_28586":91,"_5":28905,"_19790":46582,"_26008":46583,"_2720":46584},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3227":102,"_28586":91,"_5":28905,"_19790":46586,"_26008":46587,"_2720":46588},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3227":103,"_28586":91,"_5":28905,"_19790":46590,"_26008":46591,"_2720":46592},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3227":104,"_28586":91,"_19790":46594,"_5":13558,"_26008":46552,"_2720":46595},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3227":105,"_28586":91,"_19790":46597,"_5":13558,"_26008":46552,"_2720":46598},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3227":106,"_28586":91,"_19790":46600,"_5":13558,"_26008":46556,"_2720":46601},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3227":107,"_28586":91,"_19790":46603,"_5":13558,"_26008":46556,"_2720":46604},[],"Fastlane installs or configures",{"_3227":108,"_28586":91,"_19790":46606,"_5":13558,"_26008":46556,"_2720":46607},[],"You still provide",{"_3227":109,"_28586":91,"_19790":46609,"_5":13558,"_26008":46556,"_2720":46610},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3227":110,"_28586":91,"_19790":46612,"_5":13558,"_26008":46556,"_2720":46613},[],"The Kubernetes cluster, nodes and persistent storage",{"_3227":111,"_28586":91,"_19790":46615,"_5":13558,"_26008":46556,"_2720":46616},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3227":112,"_28586":91,"_19790":46618,"_5":13558,"_26008":46556,"_2720":46619},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3227":113,"_28586":91,"_19790":46621,"_5":13558,"_26008":46556,"_2720":46622},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3227":114,"_28586":91,"_19790":46624,"_5":13558,"_26008":46556,"_2720":46625},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3227":115,"_28586":91,"_19790":46627,"_5":13558,"_26008":46556,"_2720":46628},[],"Optional observability and lab HSM components",{"_3227":116,"_28586":91,"_19790":46630,"_5":13558,"_26008":46556,"_2720":46631},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3227":117,"_28586":91,"_19790":46633,"_5":13558,"_26008":46556,"_2720":46634},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3227":118,"_28586":91,"_19790":46636,"_5":13558,"_26008":46560,"_2720":46637},[],"You need:",{"_3227":119,"_28586":91,"_19790":46639,"_5":13558,"_26008":46560,"_2720":46640},[],"an existing Kubernetes cluster",{"_3227":120,"_28586":91,"_19790":46642,"_5":13558,"_26008":46560,"_2720":46643},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3227":121,"_28586":91,"_19790":46645,"_5":13558,"_26008":46560,"_2720":46646},[],"`yq`",{"_3227":122,"_28586":91,"_19790":46648,"_5":13558,"_26008":46560,"_2720":22417},[],{"_3227":123,"_28586":91,"_19790":46650,"_5":13558,"_26008":46560,"_2720":46651},[],"`jq` only when using `--sample-data` or `--development`",{"_3227":124,"_28586":91,"_19790":46653,"_5":13558,"_26008":46560,"_2720":46654},[],"`ssh-keygen` only when using `--with-hsm`",{"_3227":125,"_28586":91,"_19790":46656,"_5":13558,"_26008":46560,"_2720":46657},[],"free external ports 80 and 443 on a single-node K3s host",{"_3227":126,"_28586":91,"_19790":46659,"_5":13558,"_26008":46560,"_2720":46660},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3227":127,"_28586":91,"_19790":46662,"_5":13558,"_26008":46560,"_2720":46663},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3227":128,"_28586":91,"_19790":46665,"_5":13558,"_26008":46563,"_2720":46666},[],"Run the script from a clone of the Helm repository:",{"_3227":129,"_28586":91,"_19790":46668,"_5":13558,"_26008":46563,"_2720":46669},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3227":130,"_28586":91,"_19790":46671,"_5":13558,"_26008":46567,"_2720":46672},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3227":131,"_28586":91,"_19790":46674,"_5":13558,"_26008":46567,"_2720":46675},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3227":132,"_28586":91,"_19790":46677,"_5":13558,"_26008":46567,"_2720":46678},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3227":133,"_28586":91,"_19790":46680,"_5":13558,"_26008":46567,"_2720":46681},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3227":134,"_28586":91,"_19790":46683,"_5":13558,"_26008":46571,"_2720":46684},[],"Option",{"_3227":135,"_28586":91,"_19790":46686,"_5":13558,"_26008":46571,"_2720":46687},[],"Default",{"_3227":136,"_28586":91,"_19790":46689,"_5":13558,"_26008":46571,"_2720":46690},[],"Purpose",{"_3227":137,"_28586":91,"_19790":46692,"_5":13558,"_26008":46571,"_2720":46693},[],"`-h`, `--help`",{"_3227":138,"_28586":91,"_19790":46695,"_5":13558,"_26008":46571,"_2720":46696},[],"—",{"_3227":139,"_28586":91,"_19790":46698,"_5":13558,"_26008":46571,"_2720":46699},[],"Show help",{"_3227":140,"_28586":91,"_19790":46701,"_5":13558,"_26008":46571,"_2720":46702},[],"`-c`, `--context`",{"_3227":141,"_28586":91,"_19790":46704,"_5":13558,"_26008":46571,"_2720":46705},[],"current context",{"_3227":142,"_28586":91,"_19790":46707,"_5":13558,"_26008":46571,"_2720":46708},[],"Select the kubeconfig context for kubectl and Helm",{"_3227":143,"_28586":91,"_19790":46710,"_5":13558,"_26008":46571,"_2720":46711},[],"`-n`, `--non-interactive`",{"_3227":144,"_28586":91,"_19790":46713,"_5":13558,"_26008":46571,"_2720":6085},[],{"_3227":145,"_28586":91,"_19790":46715,"_5":13558,"_26008":46571,"_2720":46716},[],"Skip prompts and generate dependency credentials",{"_3227":146,"_28586":91,"_19790":46718,"_5":13558,"_26008":46571,"_2720":46719},[],"`-ns`, `--namespace`",{"_3227":147,"_28586":91,"_19790":46721,"_5":13558,"_26008":46571,"_2720":46722},[],"`lamassu-dev`",{"_3227":148,"_28586":91,"_19790":46724,"_5":13558,"_26008":46571,"_2720":46725},[],"Namespace for the installation",{"_3227":149,"_28586":91,"_19790":46727,"_5":13558,"_26008":46571,"_2720":46728},[],"`-d`, `--domain`",{"_3227":150,"_28586":91,"_19790":46730,"_5":13558,"_26008":46571,"_2720":46731},[],"`dev.lamassu.io`",{"_3227":151,"_28586":91,"_19790":46733,"_5":13558,"_26008":46571,"_2720":46734},[],"Domain used by the UI, OIDC and certificate",{"_3227":152,"_28586":91,"_19790":46736,"_5":13558,"_26008":46571,"_2720":46737},[],"`-v`, `--version`",{"_3227":153,"_28586":91,"_19790":46739,"_5":13558,"_26008":46571,"_2720":14216},[],{"_3227":154,"_28586":91,"_19790":46741,"_5":13558,"_26008":46571,"_2720":46742},[],"Lamassu chart version",{"_3227":155,"_28586":91,"_19790":46744,"_5":13558,"_26008":46571,"_2720":46745},[],"`--https-port`",{"_3227":156,"_28586":91,"_19790":46747,"_5":13558,"_26008":46571,"_2720":46748},[],"`443`",{"_3227":157,"_28586":91,"_19790":46750,"_5":13558,"_26008":46571,"_2720":46751},[],"Gateway HTTPS listener port",{"_3227":158,"_28586":91,"_19790":46753,"_5":13558,"_26008":46571,"_2720":46754},[],"`--http-port`",{"_3227":159,"_28586":91,"_19790":46756,"_5":13558,"_26008":46571,"_2720":46757},[],"`80`",{"_3227":160,"_28586":91,"_19790":46759,"_5":13558,"_26008":46571,"_2720":46760},[],"Gateway HTTP listener port",{"_3227":161,"_28586":91,"_19790":46762,"_5":13558,"_26008":46571,"_2720":46763},[],"`--tls-crt`",{"_3227":162,"_28586":91,"_19790":46765,"_5":13558,"_26008":46571,"_2720":46696},[],{"_3227":163,"_28586":91,"_19790":46767,"_5":13558,"_26008":46571,"_2720":46768},[],"PEM certificate for downstream TLS",{"_3227":164,"_28586":91,"_19790":46770,"_5":13558,"_26008":46571,"_2720":46771},[],"`--tls-key`",{"_3227":165,"_28586":91,"_19790":46773,"_5":13558,"_26008":46571,"_2720":46696},[],{"_3227":166,"_28586":91,"_19790":46775,"_5":13558,"_26008":46571,"_2720":46776},[],"PEM private key for downstream TLS",{"_3227":167,"_28586":91,"_19790":46778,"_5":13558,"_26008":46571,"_2720":46779},[],"`-l`, `--local-chart-path`",{"_3227":168,"_28586":91,"_19790":46781,"_5":13558,"_26008":46571,"_2720":46782},[],"repository chart",{"_3227":169,"_28586":91,"_19790":46784,"_5":13558,"_26008":46571,"_2720":46785},[],"Use an unpacked local Lamassu chart",{"_3227":170,"_28586":91,"_19790":46787,"_5":13558,"_26008":46571,"_2720":46788},[],"`-ip`, `--gateway-ip`",{"_3227":171,"_28586":91,"_19790":46790,"_5":13558,"_26008":46571,"_2720":8201},[],{"_3227":172,"_28586":91,"_19790":46792,"_5":13558,"_26008":46571,"_2720":46793},[],"Override the address written to `gateway.addresses`",{"_3227":173,"_28586":91,"_19790":46795,"_5":13558,"_26008":46571,"_2720":46796},[],"`--otel`",{"_3227":174,"_28586":91,"_19790":46798,"_5":13558,"_26008":46571,"_2720":6085},[],{"_3227":175,"_28586":91,"_19790":46800,"_5":13558,"_26008":46571,"_2720":46801},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3227":176,"_28586":91,"_19790":46803,"_5":13558,"_26008":46571,"_2720":46804},[],"`--development`",{"_3227":177,"_28586":91,"_19790":46806,"_5":13558,"_26008":46571,"_2720":6085},[],{"_3227":178,"_28586":91,"_19790":46808,"_5":13558,"_26008":46571,"_2720":46809},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3227":179,"_28586":91,"_19790":46811,"_5":13558,"_26008":46571,"_2720":46812},[],"`--sample-data`",{"_3227":180,"_28586":91,"_19790":46814,"_5":13558,"_26008":46571,"_2720":6085},[],{"_3227":181,"_28586":91,"_19790":46816,"_5":13558,"_26008":46571,"_2720":46817},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3227":182,"_28586":91,"_19790":46819,"_5":13558,"_26008":46571,"_2720":46820},[],"`--with-hsm`",{"_3227":183,"_28586":91,"_19790":46822,"_5":13558,"_26008":46571,"_2720":6085},[],{"_3227":184,"_28586":91,"_19790":46824,"_5":13558,"_26008":46571,"_2720":46825},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3227":185,"_28586":91,"_19790":46827,"_5":13558,"_26008":46571,"_2720":46828},[],"`--softhsm-chart-path`",{"_3227":186,"_28586":91,"_19790":46830,"_5":13558,"_26008":46571,"_2720":46831},[],"`./charts/softhsm`",{"_3227":187,"_28586":91,"_19790":46833,"_5":13558,"_26008":46571,"_2720":46834},[],"Use a different local SoftHSM chart",{"_3227":188,"_28586":91,"_19790":46836,"_5":13558,"_26008":46571,"_2720":46837},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3227":189,"_28586":91,"_19790":46839,"_5":13558,"_26008":46575,"_2720":46840},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3227":190,"_28586":91,"_19790":46842,"_5":13558,"_26008":46575,"_2720":46843},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3227":191,"_28586":91,"_19790":46845,"_5":13558,"_26008":46575,"_2720":46846},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3227":192,"_28586":91,"_19790":46848,"_5":13558,"_26008":46575,"_2720":46849},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3227":193,"_28586":91,"_19790":46851,"_5":13558,"_26008":46575,"_2720":46852},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3227":194,"_28586":91,"_19790":46854,"_5":13558,"_26008":46575,"_2720":46855},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3227":195,"_28586":91,"_19790":46857,"_5":13558,"_26008":46579,"_2720":46858},[],"Fastlane:",{"_3227":196,"_28586":91,"_19790":46860,"_5":13558,"_26008":46579,"_2720":46861},[],"validates local tools and the selected cluster",{"_3227":197,"_28586":91,"_19790":46863,"_5":13558,"_26008":46579,"_2720":46864},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3227":198,"_28586":91,"_19790":46866,"_5":13558,"_26008":46579,"_2720":46867},[],"creates the namespace",{"_3227":199,"_28586":91,"_19790":46869,"_5":13558,"_26008":46579,"_2720":46870},[],"installs PostgreSQL and creates the required databases",{"_3227":200,"_28586":91,"_19790":46872,"_5":13558,"_26008":46579,"_2720":46873},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3227":201,"_28586":91,"_19790":46875,"_5":13558,"_26008":46579,"_2720":46876},[],"installs RabbitMQ",{"_3227":202,"_28586":91,"_19790":46878,"_5":13558,"_26008":46579,"_2720":46879},[],"optionally installs observability and lab HSM components",{"_3227":203,"_28586":91,"_19790":46881,"_5":13558,"_26008":46579,"_2720":46882},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3227":204,"_28586":91,"_19790":46884,"_5":13558,"_26008":46579,"_2720":46885},[],"optionally loads sample data",{"_3227":205,"_28586":91,"_19790":46887,"_5":13558,"_26008":46579,"_2720":46888},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3227":206,"_28586":91,"_19790":46890,"_5":13558,"_26008":46583,"_2720":46891},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3227":207,"_28586":91,"_19790":46893,"_5":13558,"_26008":46583,"_2720":46894},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3227":208,"_28586":91,"_19790":46896,"_5":13558,"_26008":46587,"_2720":46897},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3227":209,"_28586":91,"_19790":46899,"_5":13558,"_26008":46587,"_2720":46900},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3227":210,"_28586":91,"_19790":46902,"_5":13558,"_26008":46587,"_2720":46903},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3227":211,"_28586":91,"_19790":46905,"_5":13558,"_26008":46591,"_2720":46906},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3227":212,"_28586":212,"_5":13916,"_2720":46908,"_28908":46909,"_19790":46910,"_26008":212},"Install with Helm",[46300,46301,46407],[],{"_3227":213,"_28586":212,"_19790":46912,"_5":13558,"_26008":212,"_2720":46913},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3227":214,"_28586":212,"_5":28905,"_19790":46915,"_26008":46916,"_2720":46917},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3227":215,"_28586":212,"_5":28905,"_19790":46919,"_26008":46920,"_2720":46310},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3227":216,"_28586":212,"_5":28905,"_19790":46922,"_26008":46923,"_2720":46924},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3227":217,"_28586":212,"_5":28905,"_19790":46926,"_26008":46927,"_2720":46928},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3227":218,"_28586":212,"_5":28905,"_19790":46930,"_26008":46931,"_2720":46932},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3227":219,"_28586":212,"_5":28905,"_19790":46934,"_26008":46935,"_2720":46936},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3227":220,"_28586":212,"_5":28905,"_19790":46938,"_26008":46939,"_2720":46940},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3227":221,"_28586":212,"_5":28905,"_19790":46942,"_26008":46943,"_2720":46944},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3227":222,"_28586":212,"_5":28905,"_19790":46946,"_26008":46947,"_2720":46948},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3227":223,"_28586":212,"_5":28905,"_19790":46950,"_26008":46951,"_2720":46952},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3227":224,"_28586":212,"_19790":46954,"_5":13558,"_26008":46916,"_2720":46955},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3227":225,"_28586":212,"_19790":46957,"_5":13558,"_26008":46920,"_2720":46958},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3227":226,"_28586":212,"_19790":46960,"_5":13558,"_26008":46920,"_2720":46961},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3227":227,"_28586":212,"_19790":46963,"_5":13558,"_26008":46920,"_2720":46964},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3227":228,"_28586":212,"_19790":46966,"_5":13558,"_26008":46920,"_2720":46967},[],"a reachable RabbitMQ broker and credentials",{"_3227":229,"_28586":212,"_19790":46969,"_5":13558,"_26008":46920,"_2720":46970},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3227":230,"_28586":212,"_19790":46972,"_5":13558,"_26008":46920,"_2720":46973},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3227":231,"_28586":212,"_19790":46975,"_5":13558,"_26008":46920,"_2720":46976},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3227":232,"_28586":212,"_19790":46978,"_5":13558,"_26008":46920,"_2720":46979},[],"a StorageClass and an external traffic design",{"_3227":233,"_28586":212,"_19790":46981,"_5":13558,"_26008":46920,"_2720":46982},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3227":234,"_28586":212,"_19790":46984,"_5":13558,"_26008":46920,"_2720":46985},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3227":235,"_28586":212,"_19790":46987,"_5":13558,"_26008":46920,"_2720":46988},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3227":236,"_28586":212,"_19790":46990,"_5":13558,"_26008":46923,"_2720":46991},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3227":237,"_28586":212,"_19790":46993,"_5":13558,"_26008":46923,"_2720":46994},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3227":238,"_28586":212,"_19790":46996,"_5":13558,"_26008":46923,"_2720":46997},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3227":239,"_28586":212,"_19790":46999,"_5":13558,"_26008":46927,"_2720":47000},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3227":240,"_28586":212,"_19790":47002,"_5":13558,"_26008":46927,"_2720":47003},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3227":241,"_28586":212,"_19790":47005,"_5":13558,"_26008":46927,"_2720":47006},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3227":242,"_28586":212,"_19790":47008,"_5":13558,"_26008":46927,"_2720":47009},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3227":243,"_28586":212,"_19790":47011,"_5":13558,"_26008":46931,"_2720":47012},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3227":244,"_28586":212,"_19790":47014,"_5":13558,"_26008":46935,"_2720":47015},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3227":245,"_28586":212,"_19790":47017,"_5":13558,"_26008":46935,"_2720":47018},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3227":246,"_28586":212,"_19790":47020,"_5":13558,"_26008":46935,"_2720":47021},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3227":247,"_28586":212,"_19790":47023,"_5":13558,"_26008":46935,"_2720":47024},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3227":248,"_28586":212,"_19790":47026,"_5":13558,"_26008":46935,"_2720":47027},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3227":249,"_28586":212,"_19790":47029,"_5":13558,"_26008":46935,"_2720":47030},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3227":250,"_28586":212,"_19790":47032,"_5":13558,"_26008":46935,"_2720":47033},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3227":251,"_28586":212,"_19790":47035,"_5":13558,"_26008":46939,"_2720":47036},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3227":252,"_28586":212,"_19790":47038,"_5":13558,"_26008":46939,"_2720":47039},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3227":253,"_28586":212,"_19790":47041,"_5":13558,"_26008":46939,"_2720":47042},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3227":254,"_28586":212,"_19790":47044,"_5":13558,"_26008":46939,"_2720":47045},[],"See Access control for the principal and policy model.",{"_3227":255,"_28586":212,"_19790":47047,"_5":13558,"_26008":46943,"_2720":47048},[],"To install a local checkout instead:",{"_3227":256,"_28586":212,"_19790":47050,"_5":13558,"_26008":46947,"_2720":47051},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3227":257,"_28586":212,"_19790":47053,"_5":13558,"_26008":46947,"_2720":47054},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3227":258,"_28586":212,"_19790":47056,"_5":13558,"_26008":46951,"_2720":47057},[],"Before going live, review:",{"_3227":259,"_28586":212,"_19790":47059,"_5":13558,"_26008":46951,"_2720":47060},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3227":260,"_28586":212,"_19790":47062,"_5":13558,"_26008":46951,"_2720":47063},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3227":261,"_28586":212,"_19790":47065,"_5":13558,"_26008":46951,"_2720":47066},[],"shared VA storage before increasing VA replicas",{"_3227":262,"_28586":212,"_19790":47068,"_5":13558,"_26008":46951,"_2720":47069},[],"managed OIDC roles and removal of evaluation credentials",{"_3227":263,"_28586":212,"_19790":47071,"_5":13558,"_26008":46951,"_2720":47072},[],"a trusted TLS issuer or externally managed certificate",{"_3227":264,"_28586":212,"_19790":47074,"_5":13558,"_26008":46951,"_2720":47075},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3227":265,"_28586":212,"_19790":47077,"_5":13558,"_26008":46951,"_2720":47078},[],"SMTP, observability and alert delivery",{"_3227":266,"_28586":212,"_19790":47080,"_5":13558,"_26008":46951,"_2720":47081},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3227":267,"_28586":212,"_19790":47083,"_5":13558,"_26008":46951,"_2720":47084},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3227":268,"_28586":268,"_5":13916,"_2720":47086,"_28908":47087,"_19790":47088,"_26008":268},"Expose the Gateway",[46300,46301,46407],[],{"_3227":269,"_28586":268,"_19790":47090,"_5":13558,"_26008":268,"_2720":47091},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3227":270,"_28586":268,"_5":28905,"_19790":47093,"_26008":47094,"_2720":47095},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3227":271,"_28586":268,"_5":28905,"_19790":47097,"_26008":47098,"_2720":47099},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3227":272,"_28586":268,"_5":28905,"_19790":47101,"_26008":47102,"_2720":47103},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3227":273,"_28586":268,"_5":28905,"_19790":47105,"_26008":47106,"_2720":47107},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3227":274,"_28586":268,"_5":28905,"_19790":47109,"_26008":47110,"_2720":47111},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3227":275,"_28586":268,"_5":28905,"_19790":47113,"_26008":47114,"_2720":47115},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3227":276,"_28586":268,"_5":28905,"_19790":47117,"_26008":47118,"_2720":47119},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3227":277,"_28586":268,"_5":28905,"_19790":47121,"_26008":47122,"_2720":47123},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3227":278,"_28586":268,"_5":28905,"_19790":47125,"_26008":47126,"_2720":47127},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3227":279,"_28586":268,"_5":28905,"_19790":47129,"_26008":47130,"_2720":47131},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3227":280,"_28586":268,"_19790":47133,"_5":13558,"_26008":47094,"_2720":47134},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3227":281,"_28586":268,"_19790":47136,"_5":13558,"_26008":47094,"_2720":47137},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3227":282,"_28586":268,"_19790":47139,"_5":13558,"_26008":47098,"_2720":47140},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3227":283,"_28586":268,"_19790":47142,"_5":13558,"_26008":47098,"_2720":47143},[],"Set it only when:",{"_3227":284,"_28586":268,"_19790":47145,"_5":13558,"_26008":47098,"_2720":47146},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3227":285,"_28586":268,"_19790":47148,"_5":13558,"_26008":47098,"_2720":47149},[],"that address is allocated to this Gateway",{"_3227":286,"_28586":268,"_19790":47151,"_5":13558,"_26008":47098,"_2720":47152},[],"the surrounding network already routes traffic for it to the cluster",{"_3227":287,"_28586":268,"_19790":47154,"_5":13558,"_26008":47098,"_2720":47155},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3227":288,"_28586":268,"_19790":47157,"_5":13558,"_26008":47098,"_2720":47158},[],"Keep these two settings separate:",{"_3227":289,"_28586":268,"_19790":47160,"_5":13558,"_26008":47098,"_2720":47161},[],"`gateway.addresses` requests an address for the Gateway.",{"_3227":290,"_28586":268,"_19790":47163,"_5":13558,"_26008":47098,"_2720":47164},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3227":291,"_28586":268,"_19790":47166,"_5":13558,"_26008":47098,"_2720":47167},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3227":292,"_28586":268,"_19790":47169,"_5":13558,"_26008":47102,"_2720":47170},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3227":293,"_28586":268,"_19790":47172,"_5":13558,"_26008":47102,"_2720":47173},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3227":294,"_28586":268,"_19790":47175,"_5":13558,"_26008":47106,"_2720":47176},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3227":295,"_28586":268,"_19790":47178,"_5":13558,"_26008":47106,"_2720":47179},[],"For the recommended design:",{"_3227":296,"_28586":268,"_19790":47181,"_5":13558,"_26008":47106,"_2720":47182},[],"Use only one externally exposed Lamassu Gateway.",{"_3227":297,"_28586":268,"_19790":47184,"_5":13558,"_26008":47106,"_2720":47185},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3227":298,"_28586":268,"_19790":47187,"_5":13558,"_26008":47106,"_2720":47188},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3227":299,"_28586":268,"_19790":47190,"_5":13558,"_26008":47106,"_2720":47191},[],"Point DNS at the VM's reachable address.",{"_3227":300,"_28586":268,"_19790":47193,"_5":13558,"_26008":47106,"_2720":47194},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3227":301,"_28586":268,"_19790":47196,"_5":13558,"_26008":47110,"_2720":47197},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3227":302,"_28586":268,"_19790":47199,"_5":13558,"_26008":47114,"_2720":47200},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3227":303,"_28586":268,"_19790":47202,"_5":13558,"_26008":47114,"_2720":47203},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3227":304,"_28586":268,"_19790":47205,"_5":13558,"_26008":47118,"_2720":47206},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3227":305,"_28586":268,"_19790":47208,"_5":13558,"_26008":47118,"_2720":47209},[],"Requirement",{"_3227":306,"_28586":268,"_19790":47211,"_5":13558,"_26008":47118,"_2720":47212},[],"Recommended design",{"_3227":307,"_28586":268,"_19790":47214,"_5":13558,"_26008":47118,"_2720":47215},[],"Consequence",{"_3227":308,"_28586":268,"_19790":47217,"_5":13558,"_26008":47118,"_2720":47218},[],"Several Lamassu URLs or services",{"_3227":309,"_28586":268,"_19790":47220,"_5":13558,"_26008":47118,"_2720":47221},[],"One Gateway with multiple routes",{"_3227":310,"_28586":268,"_19790":47223,"_5":13558,"_26008":47118,"_2720":47224},[],"One IP and one proxy fleet; this is the chart default",{"_3227":311,"_28586":268,"_19790":47226,"_5":13558,"_26008":47118,"_2720":47227},[],"Independent Gateways and separate external IPs",{"_3227":312,"_28586":268,"_19790":47229,"_5":13558,"_26008":47118,"_2720":47230},[],"One VIP per Gateway",{"_3227":313,"_28586":268,"_19790":47232,"_5":13558,"_26008":47118,"_2720":47233},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3227":314,"_28586":268,"_19790":47235,"_5":13558,"_26008":47118,"_2720":47236},[],"Independent Gateways on one node and one IP",{"_3227":315,"_28586":268,"_19790":47238,"_5":13558,"_26008":47118,"_2720":47239},[],"Use different external ports",{"_3227":316,"_28586":268,"_19790":47241,"_5":13558,"_26008":47118,"_2720":47242},[],"Clients must include non-standard ports",{"_3227":317,"_28586":268,"_19790":47244,"_5":13558,"_26008":47118,"_2720":47245},[],"Separate TLS/mTLS termination behind one IP",{"_3227":318,"_28586":268,"_19790":47247,"_5":13558,"_26008":47118,"_2720":47248},[],"Front-door SNI routing to internal Gateways",{"_3227":319,"_28586":268,"_19790":47250,"_5":13558,"_26008":47118,"_2720":47251},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3227":320,"_28586":268,"_19790":47253,"_5":13558,"_26008":47118,"_2720":47254},[],"Separate Gateway resources but shared proxy infrastructure",{"_3227":321,"_28586":268,"_19790":47256,"_5":13558,"_26008":47118,"_2720":47257},[],"Envoy merged-Gateway mode",{"_3227":322,"_28586":268,"_19790":47259,"_5":13558,"_26008":47118,"_2720":47260},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3227":323,"_28586":268,"_19790":47262,"_5":13558,"_26008":47118,"_2720":47263},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3227":324,"_28586":268,"_19790":47265,"_5":13558,"_26008":47118,"_2720":47266},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3227":325,"_28586":268,"_19790":47268,"_5":13558,"_26008":47118,"_2720":47269},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3227":326,"_28586":268,"_19790":47271,"_5":13558,"_26008":47118,"_2720":47272},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3227":327,"_28586":268,"_19790":47274,"_5":13558,"_26008":47122,"_2720":47275},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3227":328,"_28586":268,"_19790":47277,"_5":13558,"_26008":47122,"_2720":47278},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3227":329,"_28586":268,"_19790":47280,"_5":13558,"_26008":47122,"_2720":47281},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3227":330,"_28586":268,"_19790":47283,"_5":13558,"_26008":47122,"_2720":47284},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3227":331,"_28586":268,"_19790":47286,"_5":13558,"_26008":47122,"_2720":47287},[],"If none of those are possible, use different external ports or change the external network design.",{"_3227":332,"_28586":268,"_19790":47289,"_5":13558,"_26008":47126,"_2720":47290},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3227":333,"_28586":268,"_19790":47292,"_5":13558,"_26008":47126,"_2720":47293},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3227":334,"_28586":268,"_19790":47295,"_5":13558,"_26008":47130,"_2720":47296},[],"Check, in order:",{"_3227":335,"_28586":268,"_19790":47298,"_5":13558,"_26008":47130,"_2720":47299},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3227":336,"_28586":268,"_19790":47301,"_5":13558,"_26008":47130,"_2720":47302},[],"Its status contains the expected address.",{"_3227":337,"_28586":268,"_19790":47304,"_5":13558,"_26008":47130,"_2720":47305},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3227":338,"_28586":268,"_19790":47307,"_5":13558,"_26008":47130,"_2720":47308},[],"Port 443 reaches that address from the client network.",{"_3227":339,"_28586":268,"_19790":47310,"_5":13558,"_26008":47130,"_2720":47311},[],"DNS resolves to the externally reachable endpoint.",{"_3227":340,"_28586":268,"_19790":47313,"_5":13558,"_26008":47130,"_2720":47314},[],"The certificate contains the DNS name or IP used by the client.",{"_3227":341,"_28586":268,"_19790":47316,"_5":13558,"_26008":47130,"_2720":47317},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3227":342,"_28586":342,"_5":13916,"_2720":46407,"_28908":47319,"_19790":47320,"_26008":342},[46300,46301,46407],[],{"_3227":343,"_28586":342,"_19790":47322,"_5":13558,"_26008":342,"_2720":47323},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3227":344,"_28586":342,"_5":28905,"_19790":47325,"_26008":47326,"_2720":47327},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3227":345,"_28586":342,"_5":28905,"_19790":47329,"_26008":47330,"_2720":47331},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3227":346,"_28586":342,"_5":28905,"_19790":47333,"_26008":47334,"_2720":47335},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3227":347,"_28586":342,"_5":28905,"_19790":47337,"_26008":47338,"_2720":47339},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3227":348,"_28586":342,"_5":28905,"_19790":47341,"_26008":47342,"_2720":47343},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3227":349,"_28586":342,"_5":28905,"_19790":47345,"_26008":47346,"_2720":47347},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3227":350,"_28586":342,"_19790":47349,"_5":13558,"_26008":47326,"_2720":47350},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3227":351,"_28586":342,"_19790":47352,"_5":13558,"_26008":47330,"_2720":47353},[],"Workflow",{"_3227":352,"_28586":342,"_19790":47355,"_5":13558,"_26008":47330,"_2720":47356},[],"Use it for",{"_3227":353,"_28586":342,"_19790":47358,"_5":13558,"_26008":47330,"_2720":47359},[],"What it installs",{"_3227":354,"_28586":342,"_19790":47361,"_5":13558,"_26008":47330,"_2720":47362},[],"Helm",{"_3227":355,"_28586":342,"_19790":47364,"_5":13558,"_26008":47330,"_2720":47365},[],"Production and controlled environments",{"_3227":356,"_28586":342,"_19790":47367,"_5":13558,"_26008":47330,"_2720":47368},[],"Lamassu services and Gateway API resources",{"_3227":357,"_28586":342,"_19790":47370,"_5":13558,"_26008":47330,"_2720":46544},[],{"_3227":358,"_28586":342,"_19790":47372,"_5":13558,"_26008":47330,"_2720":47373},[],"Evaluation, demos, CI and small lab clusters",{"_3227":359,"_28586":342,"_19790":47375,"_5":13558,"_26008":47330,"_2720":47376},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3227":360,"_28586":342,"_19790":47378,"_5":13558,"_26008":47334,"_2720":47379},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3227":361,"_28586":342,"_19790":47381,"_5":13558,"_26008":47334,"_2720":47382},[],"Area",{"_3227":362,"_28586":342,"_19790":47384,"_5":13558,"_26008":47334,"_2720":47385},[],"The Lamassu chart provides",{"_3227":363,"_28586":342,"_19790":47387,"_5":13558,"_26008":47334,"_2720":47388},[],"You provide",{"_3227":364,"_28586":342,"_19790":47390,"_5":13558,"_26008":47334,"_2720":47391},[],"Lamassu applications",{"_3227":365,"_28586":342,"_19790":47393,"_5":13558,"_26008":47334,"_2720":47394},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3227":366,"_28586":342,"_19790":47396,"_5":13558,"_26008":47334,"_2720":47397},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3227":367,"_28586":342,"_19790":47399,"_5":13558,"_26008":47334,"_2720":47400},[],"PostgreSQL data",{"_3227":368,"_28586":342,"_19790":47402,"_5":13558,"_26008":47334,"_2720":47403},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3227":369,"_28586":342,"_19790":47405,"_5":13558,"_26008":47334,"_2720":47406},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3227":370,"_28586":342,"_19790":47408,"_5":13558,"_26008":47334,"_2720":47409},[],"Messaging",{"_3227":371,"_28586":342,"_19790":47411,"_5":13558,"_26008":47334,"_2720":47412},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3227":372,"_28586":342,"_19790":47414,"_5":13558,"_26008":47334,"_2720":47415},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3227":373,"_28586":342,"_19790":47417,"_5":13558,"_26008":47334,"_2720":47418},[],"Identity",{"_3227":374,"_28586":342,"_19790":47420,"_5":13558,"_26008":47334,"_2720":47421},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3227":375,"_28586":342,"_19790":47423,"_5":13558,"_26008":47334,"_2720":47424},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3227":376,"_28586":342,"_19790":47426,"_5":13558,"_26008":47334,"_2720":47427},[],"External routing",{"_3227":377,"_28586":342,"_19790":47429,"_5":13558,"_26008":47334,"_2720":47430},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3227":378,"_28586":342,"_19790":47432,"_5":13558,"_26008":47334,"_2720":47433},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3227":379,"_28586":342,"_19790":47435,"_5":13558,"_26008":47334,"_2720":47436},[],"TLS",{"_3227":380,"_28586":342,"_19790":47438,"_5":13558,"_26008":47334,"_2720":47439},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3227":381,"_28586":342,"_19790":47441,"_5":13558,"_26008":47334,"_2720":47442},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3227":382,"_28586":342,"_19790":47444,"_5":13558,"_26008":47334,"_2720":47445},[],"Persistent application data",{"_3227":383,"_28586":342,"_19790":47447,"_5":13558,"_26008":47334,"_2720":47448},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3227":384,"_28586":342,"_19790":47450,"_5":13558,"_26008":47334,"_2720":47451},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3227":385,"_28586":342,"_19790":47453,"_5":13558,"_26008":47334,"_2720":47454},[],"Optional integrations",{"_3227":386,"_28586":342,"_19790":47456,"_5":13558,"_26008":47334,"_2720":47457},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3227":387,"_28586":342,"_19790":47459,"_5":13558,"_26008":47334,"_2720":47460},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3227":388,"_28586":342,"_19790":47462,"_5":13558,"_26008":47334,"_2720":47463},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3227":389,"_28586":342,"_19790":47465,"_5":13558,"_26008":47334,"_2720":47466},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3227":390,"_28586":342,"_19790":47468,"_5":13558,"_26008":47338,"_2720":47469},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3227":391,"_28586":342,"_19790":47471,"_5":13558,"_26008":47338,"_2720":47472},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3227":392,"_28586":342,"_19790":47474,"_5":13558,"_26008":47342,"_2720":47475},[],"Kubernetes 1.24 or newer",{"_3227":393,"_28586":342,"_19790":47477,"_5":13558,"_26008":47342,"_2720":47478},[],"Helm 3.2 or newer",{"_3227":394,"_28586":342,"_19790":47480,"_5":13558,"_26008":47342,"_2720":47481},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3227":395,"_28586":342,"_19790":47483,"_5":13558,"_26008":47342,"_2720":47484},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3227":396,"_28586":342,"_19790":47486,"_5":13558,"_26008":47342,"_2720":47487},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3227":397,"_28586":342,"_19790":47489,"_5":13558,"_26008":47342,"_2720":47490},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3227":398,"_28586":342,"_19790":47492,"_5":13558,"_26008":47342,"_2720":47493},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3227":399,"_28586":342,"_19790":47495,"_5":13558,"_26008":47346,"_2720":47496},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3227":400,"_28586":342,"_19790":47498,"_5":13558,"_26008":47346,"_2720":47499},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3227":401,"_28586":342,"_19790":47501,"_5":13558,"_26008":47346,"_2720":47502},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3227":402,"_28586":342,"_19790":47504,"_5":13558,"_26008":47346,"_2720":47505},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3227":403,"_28586":403,"_5":13916,"_2720":47507,"_28908":47508,"_19790":47510,"_26008":403},"Deployment troubleshooting",[46300,46301,47509],"Operations",[],{"_3227":404,"_28586":403,"_19790":47512,"_5":13558,"_26008":403,"_2720":47513},[],"Diagnose access, service health and infrastructure dependencies.",{"_3227":405,"_28586":403,"_5":28905,"_19790":47515,"_26008":47516,"_2720":47517},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3227":406,"_28586":403,"_5":28905,"_19790":47519,"_26008":47520,"_2720":47521},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3227":407,"_28586":403,"_5":28905,"_19790":47523,"_26008":47524,"_2720":47525},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3227":408,"_28586":403,"_5":28905,"_19790":47527,"_26008":47528,"_2720":47529},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3227":409,"_28586":403,"_5":28905,"_19790":47531,"_26008":47532,"_2720":47533},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3227":410,"_28586":403,"_5":28905,"_19790":47535,"_26008":47536,"_2720":47537},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3227":411,"_28586":403,"_5":28905,"_19790":47539,"_26008":47540,"_2720":47541},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3227":412,"_28586":403,"_5":28905,"_19790":47543,"_26008":47544,"_2720":47545},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3227":413,"_28586":403,"_5":28905,"_19790":47547,"_26008":47548,"_2720":47549},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3227":414,"_28586":403,"_5":28905,"_19790":47551,"_26008":47552,"_2720":47553},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3227":415,"_28586":403,"_5":28905,"_19790":47555,"_26008":47556,"_2720":47557},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3227":416,"_28586":403,"_5":28905,"_19790":47559,"_26008":47560,"_2720":47561},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3227":417,"_28586":403,"_5":28905,"_19790":47563,"_26008":47564,"_2720":47565},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3227":418,"_28586":403,"_19790":47567,"_5":13558,"_26008":403,"_2720":47568},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3227":419,"_28586":403,"_19790":47570,"_5":13558,"_26008":47520,"_2720":47571},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3227":420,"_28586":403,"_19790":47573,"_5":13558,"_26008":47524,"_2720":47574},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3227":421,"_28586":403,"_19790":47576,"_5":13558,"_26008":47528,"_2720":47577},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3227":422,"_28586":403,"_19790":47579,"_5":13558,"_26008":47532,"_2720":47580},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3227":423,"_28586":403,"_19790":47582,"_5":13558,"_26008":47536,"_2720":47583},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3227":424,"_28586":403,"_19790":47585,"_5":13558,"_26008":47540,"_2720":47586},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3227":425,"_28586":403,"_19790":47588,"_5":13558,"_26008":47540,"_2720":47589},[],"Also run the chart's connectivity test:",{"_3227":426,"_28586":403,"_19790":47591,"_5":13558,"_26008":47540,"_2720":47592},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3227":427,"_28586":403,"_19790":47594,"_5":13558,"_26008":47540,"_2720":47595},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3227":428,"_28586":403,"_19790":47597,"_5":13558,"_26008":47544,"_2720":47598},[],"If you receive a 401:",{"_3227":429,"_28586":403,"_19790":47600,"_5":13558,"_26008":47544,"_2720":47601},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3227":430,"_28586":403,"_19790":47603,"_5":13558,"_26008":47544,"_2720":47604},[],"verify issuer, audience and expiration of the token;",{"_3227":431,"_28586":403,"_19790":47606,"_5":13558,"_26008":47544,"_2720":47607},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3227":432,"_28586":403,"_19790":47609,"_5":13558,"_26008":47544,"_2720":47610},[],"check that the provider's public and internal routes point to the same realm.",{"_3227":433,"_28586":403,"_19790":47612,"_5":13558,"_26008":47544,"_2720":47613},[],"If login succeeds but the APIs return 403:",{"_3227":434,"_28586":403,"_19790":47615,"_5":13558,"_26008":47544,"_2720":47616},[],"inspect the token's real claims;",{"_3227":435,"_28586":403,"_19790":47618,"_5":13558,"_26008":47544,"_2720":47619},[],"confirm they match an active principal;",{"_3227":436,"_28586":403,"_19790":47621,"_5":13558,"_26008":47544,"_2720":47622},[],"review the policies granted to that principal;",{"_3227":437,"_28586":403,"_19790":47624,"_5":13558,"_26008":47544,"_2720":47625},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3227":438,"_28586":403,"_19790":47627,"_5":13558,"_26008":47544,"_2720":47628},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3227":439,"_28586":403,"_19790":47630,"_5":13558,"_26008":47548,"_2720":47631},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3227":440,"_28586":403,"_19790":47633,"_5":13558,"_26008":47548,"_2720":47634},[],"Locate the authz pod and Service.",{"_3227":441,"_28586":403,"_19790":47636,"_5":13558,"_26008":47548,"_2720":47637},[],"Check /health, logs and its database connection.",{"_3227":442,"_28586":403,"_19790":47639,"_5":13558,"_26008":47548,"_2720":47640},[],"Verify the DNS and port configured in externalAuthorization.",{"_3227":443,"_28586":403,"_19790":47642,"_5":13558,"_26008":47548,"_2720":47643},[],"Check the check route is /v1/ext\\_authz/check.",{"_3227":444,"_28586":403,"_19790":47645,"_5":13558,"_26008":47548,"_2720":47646},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3227":445,"_28586":403,"_19790":47648,"_5":13558,"_26008":47552,"_2720":47649},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3227":446,"_28586":403,"_19790":47651,"_5":13558,"_26008":47556,"_2720":47652},[],"Review kubectl describe pod first. Common causes are:",{"_3227":447,"_28586":403,"_19790":47654,"_5":13558,"_26008":47556,"_2720":47655},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3227":448,"_28586":403,"_19790":47657,"_5":13558,"_26008":47556,"_2720":47658},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3227":449,"_28586":403,"_19790":47660,"_5":13558,"_26008":47556,"_2720":47661},[],"unbound persistent volume;",{"_3227":450,"_28586":403,"_19790":47663,"_5":13558,"_26008":47556,"_2720":47664},[],"inaccessible image or incorrect pull policy;",{"_3227":451,"_28586":403,"_19790":47666,"_5":13558,"_26008":47556,"_2720":47667},[],"invalid cryptographic engine configuration;",{"_3227":452,"_28586":403,"_19790":47669,"_5":13558,"_26008":47556,"_2720":47670},[],"CPU or memory limits set too low;",{"_3227":453,"_28586":403,"_19790":47672,"_5":13558,"_26008":47556,"_2720":47673},[],"an incomplete prior migration.",{"_3227":454,"_28586":403,"_19790":47675,"_5":13558,"_26008":47556,"_2720":47676},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3227":455,"_28586":403,"_19790":47678,"_5":13558,"_26008":47556,"_2720":47679},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3227":456,"_28586":403,"_19790":47681,"_5":13558,"_26008":47556,"_2720":47682},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3227":457,"_28586":403,"_19790":47684,"_5":13558,"_26008":47560,"_2720":47685},[],"Domain and audit events depend on the bus publisher:",{"_3227":458,"_28586":403,"_19790":47687,"_5":13558,"_26008":47560,"_2720":47688},[],"verify it is enabled in the emitting service;",{"_3227":459,"_28586":403,"_19790":47690,"_5":13558,"_26008":47560,"_2720":47691},[],"check AMQP connectivity and credentials;",{"_3227":460,"_28586":403,"_19790":47693,"_5":13558,"_26008":47560,"_2720":47694},[],"review exchange, routing key, queues and consumers;",{"_3227":461,"_28586":403,"_19790":47696,"_5":13558,"_26008":47560,"_2720":47697},[],"inspect dead-letter queues;",{"_3227":462,"_28586":403,"_19790":47699,"_5":13558,"_26008":47560,"_2720":47700},[],"alert on orphan durable queues and backlog growth.",{"_3227":463,"_28586":403,"_19790":47702,"_5":13558,"_26008":47560,"_2720":47703},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3227":464,"_28586":403,"_19790":47705,"_5":13558,"_26008":47560,"_2720":47706},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3227":465,"_28586":403,"_19790":47708,"_5":13558,"_26008":47560,"_2720":47709},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3227":466,"_28586":403,"_19790":47711,"_5":13558,"_26008":47560,"_2720":47712},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3227":467,"_28586":403,"_19790":47714,"_5":13558,"_26008":47560,"_2720":47715},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3227":468,"_28586":403,"_19790":47717,"_5":13558,"_26008":47560,"_2720":47718},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3227":469,"_28586":403,"_19790":47720,"_5":13558,"_26008":47560,"_2720":47721},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3227":470,"_28586":403,"_19790":47723,"_5":13558,"_26008":47564,"_2720":47724},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3227":471,"_28586":403,"_19790":47726,"_5":13558,"_26008":47564,"_2720":47727},[],"Before closing an incident, record:",{"_3227":472,"_28586":403,"_19790":47729,"_5":13558,"_26008":47564,"_2720":47730},[],"the confirmed cause;",{"_3227":473,"_28586":403,"_19790":47732,"_5":13558,"_26008":47564,"_2720":47733},[],"the time scope and affected resources;",{"_3227":474,"_28586":403,"_19790":47735,"_5":13558,"_26008":47564,"_2720":47736},[],"the commands or queries used;",{"_3227":475,"_28586":403,"_19790":47738,"_5":13558,"_26008":47564,"_2720":47739},[],"the applied change and how to revert it;",{"_3227":476,"_28586":403,"_19790":47741,"_5":13558,"_26008":47564,"_2720":47742},[],"validation from a consumer;",{"_3227":477,"_28586":403,"_19790":47744,"_5":13558,"_26008":47564,"_2720":47745},[],"the preventive action and its owner.",{"_3227":478,"_28586":478,"_5":13916,"_2720":47747,"_28908":47748,"_19790":47751,"_26008":478},"Access control",[46300,47749,47750],"Platform","Administration",[],{"_3227":479,"_28586":478,"_19790":47753,"_5":13558,"_26008":478,"_2720":47754},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3227":480,"_28586":478,"_5":28905,"_19790":47756,"_26008":47757,"_2720":47758},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3227":481,"_28586":478,"_5":28905,"_19790":47760,"_26008":47761,"_2720":47762},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3227":482,"_28586":478,"_5":28905,"_19790":47764,"_26008":47765,"_2720":47766},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3227":483,"_28586":478,"_5":28905,"_19790":47768,"_26008":47769,"_2720":47770},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3227":484,"_28586":478,"_5":28905,"_19790":47772,"_26008":47773,"_2720":47774},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3227":485,"_28586":478,"_5":28905,"_19790":47776,"_26008":47777,"_2720":47778},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3227":486,"_28586":478,"_5":28905,"_19790":47780,"_26008":47781,"_2720":47782},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3227":487,"_28586":478,"_5":28905,"_19790":47784,"_26008":47785,"_2720":47786},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3227":488,"_28586":478,"_5":28905,"_19790":47788,"_26008":47789,"_2720":47790},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3227":489,"_28586":478,"_5":28905,"_19790":47792,"_26008":47793,"_2720":47794},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3227":490,"_28586":478,"_5":28905,"_19790":47796,"_26008":47797,"_2720":47798},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3227":491,"_28586":478,"_5":28905,"_19790":47800,"_26008":47801,"_2720":47802},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3227":492,"_28586":478,"_5":28905,"_19790":47804,"_26008":47805,"_2720":47806},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3227":493,"_28586":478,"_5":28905,"_19790":47808,"_26008":47809,"_2720":47810},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3227":494,"_28586":478,"_5":28905,"_19790":47812,"_26008":47813,"_2720":47814},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3227":495,"_28586":478,"_5":28905,"_19790":47816,"_26008":47817,"_2720":46940},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3227":496,"_28586":478,"_5":28905,"_19790":47819,"_26008":47820,"_2720":47821},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3227":497,"_28586":478,"_5":28905,"_19790":47823,"_26008":47824,"_2720":47825},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3227":498,"_28586":478,"_5":28905,"_19790":47827,"_26008":47828,"_2720":47829},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3227":499,"_28586":478,"_5":28905,"_19790":47831,"_26008":47832,"_2720":47833},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3227":500,"_28586":478,"_5":28905,"_19790":47835,"_26008":47836,"_2720":47837},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3227":501,"_28586":478,"_5":28905,"_19790":47839,"_26008":47840,"_2720":47841},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3227":502,"_28586":478,"_5":28905,"_19790":47843,"_26008":47844,"_2720":47845},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3227":503,"_28586":478,"_5":28905,"_19790":47847,"_26008":47848,"_2720":47849},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3227":504,"_28586":478,"_5":28905,"_19790":47851,"_26008":47852,"_2720":47853},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3227":505,"_28586":478,"_5":28905,"_19790":47855,"_26008":47856,"_2720":47857},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3227":506,"_28586":478,"_5":28905,"_19790":47859,"_26008":47860,"_2720":47861},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3227":507,"_28586":478,"_5":28905,"_19790":47863,"_26008":47864,"_2720":47865},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3227":508,"_28586":478,"_5":28905,"_19790":47867,"_26008":47868,"_2720":47869},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3227":509,"_28586":478,"_5":28905,"_19790":47871,"_26008":47872,"_2720":47873},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3227":510,"_28586":478,"_5":28905,"_19790":47875,"_26008":47876,"_2720":47877},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3227":511,"_28586":478,"_19790":47879,"_5":13558,"_26008":478,"_2720":47880},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3227":512,"_28586":478,"_19790":47882,"_5":13558,"_26008":478,"_2720":47883},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3227":513,"_28586":478,"_19790":47885,"_5":13558,"_26008":478,"_2720":47886},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3227":514,"_28586":478,"_19790":47888,"_5":13558,"_26008":47757,"_2720":47889},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3227":515,"_28586":478,"_19790":47891,"_5":13558,"_26008":47757,"_2720":47892},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3227":516,"_28586":478,"_19790":47894,"_5":13558,"_26008":47757,"_2720":47895},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3227":517,"_28586":478,"_19790":47897,"_5":13558,"_26008":47757,"_2720":47898},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3227":518,"_28586":478,"_19790":47900,"_5":13558,"_26008":47757,"_2720":47901},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3227":519,"_28586":478,"_19790":47903,"_5":13558,"_26008":47757,"_2720":47904},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3227":520,"_28586":478,"_19790":47906,"_5":13558,"_26008":47761,"_2720":47907},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3227":521,"_28586":478,"_19790":47909,"_5":13558,"_26008":47761,"_2720":47910},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3227":522,"_28586":478,"_19790":47912,"_5":13558,"_26008":47765,"_2720":47913},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3227":523,"_28586":478,"_19790":47915,"_5":13558,"_26008":47765,"_2720":47916},[],"The decision is made **before forwarding the request to the service**:",{"_3227":524,"_28586":478,"_19790":47918,"_5":13558,"_26008":47765,"_2720":47919},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3227":525,"_28586":478,"_19790":47921,"_5":13558,"_26008":47765,"_2720":47922},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3227":526,"_28586":478,"_19790":47924,"_5":13558,"_26008":47765,"_2720":47925},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3227":527,"_28586":478,"_19790":47927,"_5":13558,"_26008":47765,"_2720":47928},[],"It separately loads the policies granted to each principal.",{"_3227":528,"_28586":478,"_19790":47930,"_5":13558,"_26008":47765,"_2720":47931},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3227":529,"_28586":478,"_19790":47933,"_5":13558,"_26008":47765,"_2720":47934},[],"`authz` looks for an HTTP rule granting that action.",{"_3227":530,"_28586":478,"_19790":47936,"_5":13558,"_26008":47765,"_2720":47937},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3227":531,"_28586":478,"_19790":47939,"_5":13558,"_26008":47765,"_2720":47940},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3227":532,"_28586":478,"_19790":47942,"_5":13558,"_26008":47765,"_2720":47943},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3227":533,"_28586":478,"_19790":47945,"_5":13558,"_26008":47765,"_2720":47946},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3227":534,"_28586":478,"_19790":47948,"_5":13558,"_26008":47769,"_2720":47949},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3227":535,"_28586":478,"_19790":47951,"_5":13558,"_26008":47769,"_2720":47952},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3227":536,"_28586":478,"_19790":47954,"_5":13558,"_26008":47769,"_2720":47955},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3227":537,"_28586":478,"_19790":47957,"_5":13558,"_26008":47769,"_2720":47958},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3227":538,"_28586":478,"_19790":47960,"_5":13558,"_26008":47769,"_2720":47961},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3227":539,"_28586":478,"_19790":47963,"_5":13558,"_26008":47769,"_2720":47964},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3227":540,"_28586":478,"_19790":47966,"_5":13558,"_26008":47769,"_2720":47967},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3227":541,"_28586":478,"_19790":47969,"_5":13558,"_26008":47769,"_2720":47970},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3227":542,"_28586":478,"_19790":47972,"_5":13558,"_26008":47773,"_2720":47973},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3227":543,"_28586":478,"_19790":47975,"_5":13558,"_26008":47773,"_2720":47976},[],"The decision is made with the domain operation context:",{"_3227":544,"_28586":478,"_19790":47978,"_5":13558,"_26008":47773,"_2720":47979},[],"The middleware extracts the credential and resolves the matching principals.",{"_3227":545,"_28586":478,"_19790":47981,"_5":13558,"_26008":47773,"_2720":47982},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3227":546,"_28586":478,"_19790":47984,"_5":13558,"_26008":47773,"_2720":47985},[],"`authz` gathers the entity rules of the granted policies.",{"_3227":547,"_28586":478,"_19790":47987,"_5":13558,"_26008":47773,"_2720":47988},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3227":548,"_28586":478,"_19790":47990,"_5":13558,"_26008":47773,"_2720":47991},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3227":549,"_28586":478,"_19790":47993,"_5":13558,"_26008":47773,"_2720":47994},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3227":550,"_28586":478,"_19790":47996,"_5":13558,"_26008":47773,"_2720":47997},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3227":551,"_28586":478,"_19790":47999,"_5":13558,"_26008":47773,"_2720":48000},[],"Actions fall into two groups:",{"_3227":552,"_28586":478,"_19790":48002,"_5":13558,"_26008":47773,"_2720":48003},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3227":553,"_28586":478,"_19790":48005,"_5":13558,"_26008":47773,"_2720":48006},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3227":554,"_28586":478,"_19790":48008,"_5":13558,"_26008":47773,"_2720":48009},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3227":555,"_28586":478,"_19790":48011,"_5":13558,"_26008":47777,"_2720":48012},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3227":556,"_28586":478,"_19790":48014,"_5":13558,"_26008":47777,"_2720":48015},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3227":557,"_28586":478,"_19790":48017,"_5":13558,"_26008":47777,"_2720":48018},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3227":558,"_28586":478,"_19790":48020,"_5":13558,"_26008":47781,"_2720":48021},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3227":559,"_28586":478,"_19790":48023,"_5":13558,"_26008":47781,"_2720":48024},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3227":560,"_28586":478,"_19790":48026,"_5":13558,"_26008":47781,"_2720":48027},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3227":561,"_28586":478,"_19790":48029,"_5":13558,"_26008":47781,"_2720":48030},[],"The implemented operators are:",{"_3227":562,"_28586":478,"_19790":48032,"_5":13558,"_26008":47781,"_2720":48033},[],"`equals`, for exact equality;",{"_3227":563,"_28586":478,"_19790":48035,"_5":13558,"_26008":47781,"_2720":48036},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3227":564,"_28586":478,"_19790":48038,"_5":13558,"_26008":47781,"_2720":48039},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3227":565,"_28586":478,"_19790":48041,"_5":13558,"_26008":47781,"_2720":48042},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3227":566,"_28586":478,"_19790":48044,"_5":13558,"_26008":47785,"_2720":48045},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3227":567,"_28586":478,"_19790":48047,"_5":13558,"_26008":47785,"_2720":48048},[],"The available modes are:",{"_3227":568,"_28586":478,"_19790":48050,"_5":13558,"_26008":47785,"_2720":48051},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3227":569,"_28586":478,"_19790":48053,"_5":13558,"_26008":47785,"_2720":48054},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3227":570,"_28586":478,"_19790":48056,"_5":13558,"_26008":47785,"_2720":48057},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3227":571,"_28586":478,"_19790":48059,"_5":13558,"_26008":47785,"_2720":48060},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3227":572,"_28586":478,"_19790":48062,"_5":13558,"_26008":47785,"_2720":48063},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3227":573,"_28586":478,"_19790":48065,"_5":13558,"_26008":47785,"_2720":48066},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3227":574,"_28586":478,"_19790":48068,"_5":13558,"_26008":47789,"_2720":48069},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3227":575,"_28586":478,"_19790":48071,"_5":13558,"_26008":47789,"_2720":48072},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3227":576,"_28586":478,"_19790":48074,"_5":13558,"_26008":47789,"_2720":48075},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3227":577,"_28586":478,"_19790":48077,"_5":13558,"_26008":47789,"_2720":48078},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3227":578,"_28586":478,"_19790":48080,"_5":13558,"_26008":47797,"_2720":48081},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3227":579,"_28586":478,"_19790":48083,"_5":13558,"_26008":47797,"_2720":48084},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3227":580,"_28586":478,"_19790":48086,"_5":13558,"_26008":47801,"_2720":48087},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3227":581,"_28586":478,"_19790":48089,"_5":13558,"_26008":47801,"_2720":48090},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3227":582,"_28586":478,"_19790":48092,"_5":13558,"_26008":47805,"_2720":48093},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3227":583,"_28586":478,"_19790":48095,"_5":13558,"_26008":47805,"_2720":48096},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3227":584,"_28586":478,"_19790":48098,"_5":13558,"_26008":47805,"_2720":48099},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3227":585,"_28586":478,"_19790":48101,"_5":13558,"_26008":47809,"_2720":48102},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3227":586,"_28586":478,"_19790":48104,"_5":13558,"_26008":47809,"_2720":48105},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3227":587,"_28586":478,"_19790":48107,"_5":13558,"_26008":47809,"_2720":48108},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3227":588,"_28586":478,"_19790":48110,"_5":13558,"_26008":47809,"_2720":48111},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3227":589,"_28586":478,"_19790":48113,"_5":13558,"_26008":47809,"_2720":48114},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3227":590,"_28586":478,"_19790":48116,"_5":13558,"_26008":47809,"_2720":48117},[],"Note that:",{"_3227":591,"_28586":478,"_19790":48119,"_5":13558,"_26008":47809,"_2720":48120},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3227":592,"_28586":478,"_19790":48122,"_5":13558,"_26008":47809,"_2720":48123},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3227":593,"_28586":478,"_19790":48125,"_5":13558,"_26008":47809,"_2720":48126},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3227":594,"_28586":478,"_19790":48128,"_5":13558,"_26008":47813,"_2720":48129},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3227":595,"_28586":478,"_19790":48131,"_5":13558,"_26008":47813,"_2720":48132},[],"full and read-only access to certificates and authorities;",{"_3227":596,"_28586":478,"_19790":48134,"_5":13558,"_26008":47813,"_2720":48135},[],"full and read-only access to the KMS;",{"_3227":597,"_28586":478,"_19790":48137,"_5":13558,"_26008":47813,"_2720":48138},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3227":598,"_28586":478,"_19790":48140,"_5":13558,"_26008":47813,"_2720":48141},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3227":599,"_28586":478,"_19790":48143,"_5":13558,"_26008":47813,"_2720":48144},[],"console access;",{"_3227":600,"_28586":478,"_19790":48146,"_5":13558,"_26008":47813,"_2720":48147},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3227":601,"_28586":478,"_19790":48149,"_5":13558,"_26008":47813,"_2720":48150},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3227":602,"_28586":478,"_19790":48152,"_5":13558,"_26008":47813,"_2720":48153},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3227":603,"_28586":478,"_19790":48155,"_5":13558,"_26008":47817,"_2720":48156},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3227":604,"_28586":478,"_19790":48158,"_5":13558,"_26008":47817,"_2720":48159},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3227":605,"_28586":478,"_19790":48161,"_5":13558,"_26008":47817,"_2720":48162},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3227":606,"_28586":478,"_19790":48164,"_5":13558,"_26008":47820,"_2720":48165},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3227":607,"_28586":478,"_19790":48167,"_5":13558,"_26008":47824,"_2720":48168},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3227":608,"_28586":478,"_19790":48170,"_5":13558,"_26008":47824,"_2720":48171},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3227":609,"_28586":478,"_19790":48173,"_5":13558,"_26008":47828,"_2720":48174},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3227":610,"_28586":478,"_19790":48176,"_5":13558,"_26008":47832,"_2720":48177},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3227":611,"_28586":478,"_19790":48179,"_5":13558,"_26008":47836,"_2720":48180},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3227":612,"_28586":478,"_19790":48182,"_5":13558,"_26008":47840,"_2720":48183},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3227":613,"_28586":478,"_19790":48185,"_5":13558,"_26008":47840,"_2720":48186},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3227":614,"_28586":478,"_19790":48188,"_5":13558,"_26008":47844,"_2720":48189},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3227":615,"_28586":478,"_19790":48191,"_5":13558,"_26008":47844,"_2720":48192},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3227":616,"_28586":478,"_19790":48194,"_5":13558,"_26008":47844,"_2720":48195},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3227":617,"_28586":478,"_19790":48197,"_5":13558,"_26008":47844,"_2720":48198},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3227":618,"_28586":478,"_19790":48200,"_5":13558,"_26008":47844,"_2720":48201},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3227":619,"_28586":478,"_19790":48203,"_5":13558,"_26008":47844,"_2720":48204},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3227":620,"_28586":478,"_19790":48206,"_5":13558,"_26008":47844,"_2720":48207},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3227":621,"_28586":478,"_19790":48209,"_5":13558,"_26008":47844,"_2720":48210},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3227":622,"_28586":478,"_19790":48212,"_5":13558,"_26008":47848,"_2720":48213},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3227":623,"_28586":478,"_19790":48215,"_5":13558,"_26008":47848,"_2720":48216},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3227":624,"_28586":478,"_19790":48218,"_5":13558,"_26008":47848,"_2720":48219},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3227":625,"_28586":478,"_19790":48221,"_5":13558,"_26008":47852,"_2720":48222},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3227":626,"_28586":478,"_19790":48224,"_5":13558,"_26008":47852,"_2720":48225},[],"Use groups or stable roles for people and independent identities for automations.",{"_3227":627,"_28586":478,"_19790":48227,"_5":13558,"_26008":47852,"_2720":48228},[],"Keep at least two recovery administrators and test their access periodically.",{"_3227":628,"_28586":478,"_19790":48230,"_5":13558,"_26008":47852,"_2720":48231},[],"Review active principals, their matches and their grants after IdP changes.",{"_3227":629,"_28586":478,"_19790":48233,"_5":13558,"_26008":47852,"_2720":48234},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3227":630,"_28586":478,"_19790":48236,"_5":13558,"_26008":47852,"_2720":48237},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3227":631,"_28586":478,"_19790":48239,"_5":13558,"_26008":47852,"_2720":48240},[],"Always test one allowed and one denied operation for each role.",{"_3227":632,"_28586":478,"_19790":48242,"_5":13558,"_26008":47852,"_2720":48243},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3227":633,"_28586":478,"_19790":48245,"_5":13558,"_26008":47860,"_2720":48246},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3227":634,"_28586":478,"_19790":48248,"_5":13558,"_26008":47864,"_2720":48249},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3227":635,"_28586":478,"_19790":48251,"_5":13558,"_26008":47864,"_2720":48252},[],"that an active principal of the correct type exists;",{"_3227":636,"_28586":478,"_19790":48254,"_5":13558,"_26008":47864,"_2720":48255},[],"that the claim paths and values match the real token exactly;",{"_3227":637,"_28586":478,"_19790":48257,"_5":13558,"_26008":47864,"_2720":48258},[],"that all of the principal's conditions hold;",{"_3227":638,"_28586":478,"_19790":48260,"_5":13558,"_26008":47864,"_2720":48261},[],"that the principal has the expected policy granted;",{"_3227":639,"_28586":478,"_19790":48263,"_5":13558,"_26008":47864,"_2720":48264},[],"that the policy includes the action and the requested resource type or route;",{"_3227":640,"_28586":478,"_19790":48266,"_5":13558,"_26008":47864,"_2720":48267},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3227":641,"_28586":478,"_19790":48269,"_5":13558,"_26008":47864,"_2720":48270},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3227":642,"_28586":478,"_19790":48272,"_5":13558,"_26008":47868,"_2720":48273},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3227":643,"_28586":478,"_19790":48275,"_5":13558,"_26008":47872,"_2720":48276},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3227":644,"_28586":478,"_19790":48278,"_5":13558,"_26008":47876,"_2720":48279},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3227":645,"_28586":478,"_19790":48281,"_5":13558,"_26008":47876,"_2720":48282},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3227":646,"_28586":646,"_5":13916,"_2720":48284,"_28908":48285,"_19790":48286,"_26008":646},"Alerts and subscriptions",[46300,47749,47750],[],{"_3227":647,"_28586":646,"_19790":48288,"_5":13558,"_26008":646,"_2720":48289},[],"Send PKI events to people and external systems.",{"_3227":648,"_28586":646,"_5":28905,"_19790":48291,"_26008":48292,"_2720":48293},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3227":649,"_28586":646,"_5":28905,"_19790":48295,"_26008":48296,"_2720":48297},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3227":650,"_28586":646,"_5":28905,"_19790":48299,"_26008":48300,"_2720":48301},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3227":651,"_28586":646,"_5":28905,"_19790":48303,"_26008":48304,"_2720":48305},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3227":652,"_28586":646,"_5":28905,"_19790":48307,"_26008":48308,"_2720":48309},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3227":653,"_28586":646,"_5":28905,"_19790":48311,"_26008":48312,"_2720":48313},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3227":654,"_28586":646,"_5":28905,"_19790":48315,"_26008":48316,"_2720":48317},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3227":655,"_28586":646,"_5":28905,"_19790":48319,"_26008":48320,"_2720":48321},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3227":656,"_28586":646,"_5":28905,"_19790":48323,"_26008":48324,"_2720":48325},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3227":657,"_28586":646,"_5":28905,"_19790":48327,"_26008":48328,"_2720":48329},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3227":658,"_28586":646,"_5":28905,"_19790":48331,"_26008":48332,"_2720":48333},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3227":659,"_28586":646,"_19790":48335,"_5":13558,"_26008":646,"_2720":48336},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3227":660,"_28586":646,"_19790":48338,"_5":13558,"_26008":48292,"_2720":48339},[],"A service publishes a domain event.",{"_3227":661,"_28586":646,"_19790":48341,"_5":13558,"_26008":48292,"_2720":48342},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3227":662,"_28586":646,"_19790":48344,"_5":13558,"_26008":48292,"_2720":48345},[],"Each subscription's filter decides whether it should be notified.",{"_3227":663,"_28586":646,"_19790":48347,"_5":13558,"_26008":48292,"_2720":48348},[],"Lamassu delivers the event to the configured channel.",{"_3227":664,"_28586":646,"_19790":48350,"_5":13558,"_26008":48292,"_2720":48351},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3227":665,"_28586":646,"_19790":48353,"_5":13558,"_26008":48296,"_2720":48354},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3227":666,"_28586":646,"_19790":48356,"_5":13558,"_26008":48296,"_2720":48357},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3227":667,"_28586":646,"_19790":48359,"_5":13558,"_26008":48296,"_2720":48360},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3227":668,"_28586":646,"_19790":48362,"_5":13558,"_26008":48296,"_2720":48363},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3227":669,"_28586":646,"_19790":48365,"_5":13558,"_26008":48296,"_2720":48366},[],"`apikey_options` requires `header` and `key`.",{"_3227":670,"_28586":646,"_19790":48368,"_5":13558,"_26008":48296,"_2720":48369},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3227":671,"_28586":646,"_19790":48371,"_5":13558,"_26008":48296,"_2720":48372},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3227":672,"_28586":646,"_19790":48374,"_5":13558,"_26008":48296,"_2720":48375},[],"The alerts API reference documents the full `http_client` schema.",{"_3227":673,"_28586":646,"_19790":48377,"_5":13558,"_26008":48304,"_2720":48378},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3227":674,"_28586":646,"_19790":48380,"_5":13558,"_26008":48308,"_2720":48381},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3227":675,"_28586":646,"_19790":48383,"_5":13558,"_26008":48312,"_2720":48384},[],"Add a filter if you don't want to receive every instance of the event.",{"_3227":676,"_28586":646,"_19790":48386,"_5":13558,"_26008":48312,"_2720":48387},[],"**None** notifies all instances of the event.",{"_3227":677,"_28586":646,"_19790":48389,"_5":13558,"_26008":48312,"_2720":48390},[],"**JSON Path** evaluates one or more specific fields.",{"_3227":678,"_28586":646,"_19790":48392,"_5":13558,"_26008":48312,"_2720":48393},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3227":679,"_28586":646,"_19790":48395,"_5":13558,"_26008":48312,"_2720":48396},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3227":680,"_28586":646,"_19790":48398,"_5":13558,"_26008":48312,"_2720":48399},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3227":681,"_28586":646,"_19790":48401,"_5":13558,"_26008":48316,"_2720":48402},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3227":682,"_28586":646,"_19790":48404,"_5":13558,"_26008":48320,"_2720":48405},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3227":683,"_28586":646,"_19790":48407,"_5":13558,"_26008":48320,"_2720":48408},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3227":684,"_28586":646,"_19790":48410,"_5":13558,"_26008":48320,"_2720":48411},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3227":685,"_28586":646,"_19790":48413,"_5":13558,"_26008":48320,"_2720":48414},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3227":686,"_28586":646,"_19790":48416,"_5":13558,"_26008":48320,"_2720":48417},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3227":687,"_28586":646,"_19790":48419,"_5":13558,"_26008":48320,"_2720":48420},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3227":688,"_28586":646,"_19790":48422,"_5":13558,"_26008":48320,"_2720":48423},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3227":689,"_28586":646,"_19790":48425,"_5":13558,"_26008":48320,"_2720":48426},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3227":690,"_28586":646,"_19790":48428,"_5":13558,"_26008":48324,"_2720":48429},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3227":691,"_28586":646,"_19790":48431,"_5":13558,"_26008":48324,"_2720":48432},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3227":692,"_28586":646,"_19790":48434,"_5":13558,"_26008":48324,"_2720":48435},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3227":693,"_28586":646,"_19790":48437,"_5":13558,"_26008":48324,"_2720":48438},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3227":694,"_28586":646,"_19790":48440,"_5":13558,"_26008":48324,"_2720":48441},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3227":695,"_28586":646,"_19790":48443,"_5":13558,"_26008":48324,"_2720":48444},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3227":696,"_28586":646,"_19790":48446,"_5":13558,"_26008":48324,"_2720":48447},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3227":697,"_28586":646,"_19790":48449,"_5":13558,"_26008":48324,"_2720":48450},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3227":698,"_28586":646,"_19790":48452,"_5":13558,"_26008":48328,"_2720":48453},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3227":699,"_28586":646,"_19790":48455,"_5":13558,"_26008":48328,"_2720":48456},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3227":700,"_28586":646,"_19790":48458,"_5":13558,"_26008":48332,"_2720":48459},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3227":701,"_28586":646,"_19790":48461,"_5":13558,"_26008":48332,"_2720":48462},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3227":702,"_28586":646,"_19790":48464,"_5":13558,"_26008":48332,"_2720":48465},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3227":703,"_28586":646,"_19790":48467,"_5":13558,"_26008":48332,"_2720":48468},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3227":704,"_28586":646,"_19790":48470,"_5":13558,"_26008":48332,"_2720":48471},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3227":705,"_28586":646,"_19790":48473,"_5":13558,"_26008":48332,"_2720":48474},[],"**Validation:** `va.role.crl.create`.",{"_3227":706,"_28586":646,"_19790":48476,"_5":13558,"_26008":48332,"_2720":48477},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3227":707,"_28586":646,"_19790":48479,"_5":13558,"_26008":48332,"_2720":48480},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3227":708,"_28586":708,"_5":13916,"_2720":48482,"_28908":48483,"_19790":48484,"_26008":708},"Audit logs",[46300,47749,47750],[],{"_3227":709,"_28586":708,"_19790":48486,"_5":13558,"_26008":708,"_2720":48487},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3227":710,"_28586":708,"_5":28905,"_19790":48489,"_26008":48490,"_2720":48491},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3227":711,"_28586":708,"_5":28905,"_19790":48493,"_26008":48494,"_2720":48495},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3227":712,"_28586":708,"_5":28905,"_19790":48497,"_26008":48498,"_2720":48499},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3227":713,"_28586":708,"_5":28905,"_19790":48501,"_26008":48502,"_2720":48503},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3227":714,"_28586":708,"_5":28905,"_19790":48505,"_26008":48506,"_2720":48507},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3227":715,"_28586":708,"_5":28905,"_19790":48509,"_26008":48510,"_2720":48511},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3227":716,"_28586":708,"_5":28905,"_19790":48513,"_26008":48514,"_2720":48515},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3227":717,"_28586":708,"_5":28905,"_19790":48517,"_26008":48518,"_2720":48519},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3227":718,"_28586":708,"_5":28905,"_19790":48521,"_26008":48522,"_2720":48523},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3227":719,"_28586":708,"_5":28905,"_19790":48525,"_26008":48526,"_2720":48527},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3227":720,"_28586":708,"_5":28905,"_19790":48529,"_26008":48530,"_2720":48531},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3227":721,"_28586":708,"_19790":48533,"_5":13558,"_26008":708,"_2720":48534},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3227":722,"_28586":708,"_19790":48536,"_5":13558,"_26008":48490,"_2720":48537},[],"The audit body includes:",{"_3227":723,"_28586":708,"_19790":48539,"_5":13558,"_26008":48490,"_2720":48540},[],"input: data received by the operation;",{"_3227":724,"_28586":708,"_19790":48542,"_5":13558,"_26008":48490,"_2720":48543},[],"has\\_error: whether the service returned an error;",{"_3227":725,"_28586":708,"_19790":48545,"_5":13558,"_26008":48490,"_2720":48546},[],"output: produced result or error message;",{"_3227":726,"_28586":708,"_19790":48548,"_5":13558,"_26008":48490,"_2720":48549},[],"principals: identifiers of the principals that matched the request.",{"_3227":727,"_28586":708,"_19790":48551,"_5":13558,"_26008":48490,"_2720":48552},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3227":728,"_28586":708,"_19790":48554,"_5":13558,"_26008":48490,"_2720":48555},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3227":729,"_28586":708,"_19790":48557,"_5":13558,"_26008":48494,"_2720":48558},[],"The backend applies auditing to mutations of:",{"_3227":730,"_28586":708,"_19790":48560,"_5":13558,"_26008":48494,"_2720":48561},[],"authorities, certificates and issuance profiles;",{"_3227":731,"_28586":708,"_19790":48563,"_5":13558,"_26008":48494,"_2720":48564},[],"keys and KMS engines;",{"_3227":732,"_28586":708,"_19790":48566,"_5":13558,"_26008":48494,"_2720":48567},[],"devices and identities;",{"_3227":733,"_28586":708,"_19790":48569,"_5":13558,"_26008":48494,"_2720":48570},[],"DMSs and enrollment operations;",{"_3227":734,"_28586":708,"_19790":48572,"_5":13558,"_26008":48494,"_2720":48573},[],"validation functions and CRL;",{"_3227":735,"_28586":708,"_19790":48575,"_5":13558,"_26008":48494,"_2720":48576},[],"principals, policies and authorization grants.",{"_3227":736,"_28586":708,"_19790":48578,"_5":13558,"_26008":48494,"_2720":48579},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3227":737,"_28586":708,"_19790":48581,"_5":13558,"_26008":48498,"_2720":48582},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3227":738,"_28586":708,"_19790":48584,"_5":13558,"_26008":48498,"_2720":48585},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3227":739,"_28586":708,"_19790":48587,"_5":13558,"_26008":48498,"_2720":48588},[],"Design the consumer to:",{"_3227":740,"_28586":708,"_19790":48590,"_5":13558,"_26008":48498,"_2720":48591},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3227":741,"_28586":708,"_19790":48593,"_5":13558,"_26008":48498,"_2720":48594},[],"keep the complete CloudEvent unmodified;",{"_3227":742,"_28586":708,"_19790":48596,"_5":13558,"_26008":48498,"_2720":48597},[],"record the ingestion time and detect duplicates by ID;",{"_3227":743,"_28586":708,"_19790":48599,"_5":13558,"_26008":48498,"_2720":48600},[],"encrypt in transit and at rest;",{"_3227":744,"_28586":708,"_19790":48602,"_5":13558,"_26008":48498,"_2720":48603},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3227":745,"_28586":708,"_19790":48605,"_5":13558,"_26008":48498,"_2720":48606},[],"apply an explicit retention and legal hold policy;",{"_3227":746,"_28586":708,"_19790":48608,"_5":13558,"_26008":48498,"_2720":48609},[],"alert if it stops consuming or the pending queue grows.",{"_3227":747,"_28586":708,"_19790":48611,"_5":13558,"_26008":48502,"_2720":48612},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3227":748,"_28586":708,"_19790":48614,"_5":13558,"_26008":48502,"_2720":48615},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3227":749,"_28586":708,"_19790":48617,"_5":13558,"_26008":48510,"_2720":48618},[],"Start from the reported time and normalize every source to UTC.",{"_3227":750,"_28586":708,"_19790":48620,"_5":13558,"_26008":48514,"_2720":48621},[],"Filter by event type, service source and resource identifier.",{"_3227":751,"_28586":708,"_19790":48623,"_5":13558,"_26008":48518,"_2720":48624},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3227":752,"_28586":708,"_19790":48626,"_5":13558,"_26008":48522,"_2720":48627},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3227":753,"_28586":708,"_19790":48629,"_5":13558,"_26008":48526,"_2720":48630},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3227":754,"_28586":708,"_19790":48632,"_5":13558,"_26008":48530,"_2720":48633},[],"Generate a controlled mutation in a test environment and check that:",{"_3227":755,"_28586":708,"_19790":48635,"_5":13558,"_26008":48530,"_2720":48636},[],"a successful audit event appears;",{"_3227":756,"_28586":708,"_19790":48638,"_5":13558,"_26008":48530,"_2720":48639},[],"the principal matches the identity used;",{"_3227":757,"_28586":708,"_19790":48641,"_5":13558,"_26008":48530,"_2720":48642},[],"the consumer persists it exactly once;",{"_3227":758,"_28586":708,"_19790":48644,"_5":13558,"_26008":48530,"_2720":48645},[],"it can be retrieved by resource, actor and period;",{"_3227":759,"_28586":708,"_19790":48647,"_5":13558,"_26008":48530,"_2720":48648},[],"a consumer outage raises an alert.",{"_3227":760,"_28586":708,"_19790":48650,"_5":13558,"_26008":48530,"_2720":48651},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3227":761,"_28586":761,"_5":13916,"_2720":48653,"_28908":48654,"_19790":48655,"_26008":761},"Platform architecture",[46300,47749],[],{"_3227":762,"_28586":761,"_19790":48657,"_5":13558,"_26008":761,"_2720":48658},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3227":763,"_28586":761,"_5":28905,"_19790":48660,"_26008":48661,"_2720":48662},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3227":764,"_28586":761,"_5":28905,"_19790":48664,"_26008":48665,"_2720":48666},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3227":765,"_28586":761,"_5":28905,"_19790":48668,"_26008":48669,"_2720":48670},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3227":766,"_28586":761,"_5":28905,"_19790":48672,"_26008":48673,"_2720":48674},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3227":767,"_28586":761,"_5":28905,"_19790":48676,"_26008":48677,"_2720":48678},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3227":768,"_28586":761,"_19790":48680,"_5":13558,"_26008":761,"_2720":48681},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3227":769,"_28586":761,"_19790":48683,"_5":13558,"_26008":761,"_2720":48684},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3227":770,"_28586":761,"_19790":48686,"_5":13558,"_26008":48661,"_2720":48687},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3227":771,"_28586":761,"_19790":48689,"_5":13558,"_26008":48665,"_2720":48690},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3227":772,"_28586":761,"_19790":48692,"_5":13558,"_26008":48669,"_2720":48693},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3227":773,"_28586":761,"_19790":48695,"_5":13558,"_26008":48673,"_2720":48696},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3227":774,"_28586":761,"_19790":48698,"_5":13558,"_26008":48677,"_2720":48699},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3227":775,"_28586":775,"_5":13916,"_2720":48701,"_28908":48702,"_19790":48703,"_26008":775},"How Lamassu works",[46300,47749],[],{"_3227":776,"_28586":775,"_19790":48705,"_5":13558,"_26008":775,"_2720":48706},[],"The mental model of trust, keys, certificates and devices.",{"_3227":777,"_28586":775,"_5":28905,"_19790":48708,"_26008":48709,"_2720":48710},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3227":778,"_28586":775,"_5":28905,"_19790":48712,"_26008":48713,"_2720":48714},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3227":779,"_28586":775,"_19790":48716,"_5":13558,"_26008":775,"_2720":48717},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3227":780,"_28586":775,"_19790":48719,"_5":13558,"_26008":48709,"_2720":48720},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3227":781,"_28586":775,"_19790":48722,"_5":13558,"_26008":48709,"_2720":48723},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3227":782,"_28586":775,"_19790":48725,"_5":13558,"_26008":48709,"_2720":48726},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3227":783,"_28586":775,"_19790":48728,"_5":13558,"_26008":48709,"_2720":48729},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3227":784,"_28586":775,"_19790":48731,"_5":13558,"_26008":48709,"_2720":48732},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3227":785,"_28586":775,"_19790":48734,"_5":13558,"_26008":48713,"_2720":48735},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3227":786,"_28586":775,"_19790":48737,"_5":13558,"_26008":48713,"_2720":48738},[],"A DMS relates that CA to an enrollment policy.",{"_3227":787,"_28586":775,"_19790":48740,"_5":13558,"_26008":48713,"_2720":48741},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3227":788,"_28586":775,"_19790":48743,"_5":13558,"_26008":48713,"_2720":48744},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3227":789,"_28586":775,"_19790":48746,"_5":13558,"_26008":48713,"_2720":48747},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3227":790,"_28586":775,"_19790":48749,"_5":13558,"_26008":48713,"_2720":48750},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3227":791,"_28586":775,"_19790":48752,"_5":13558,"_26008":48713,"_2720":48753},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3227":792,"_28586":792,"_5":13916,"_2720":48755,"_28908":48756,"_19790":48758,"_26008":792},"Devices and identities",[46300,47749,48757,48755],"IoT Fleets",[],{"_3227":793,"_28586":792,"_19790":48760,"_5":13558,"_26008":792,"_2720":48761},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3227":794,"_28586":792,"_5":28905,"_19790":48763,"_26008":48764,"_2720":48765},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3227":795,"_28586":792,"_5":28905,"_19790":48767,"_26008":48768,"_2720":48769},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3227":796,"_28586":792,"_5":28905,"_19790":48771,"_26008":48772,"_2720":48773},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3227":797,"_28586":792,"_5":28905,"_19790":48775,"_26008":48776,"_2720":48777},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3227":798,"_28586":792,"_5":28905,"_19790":48779,"_26008":48780,"_2720":48781},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3227":799,"_28586":792,"_5":28905,"_19790":48783,"_26008":48784,"_2720":48785},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3227":800,"_28586":792,"_5":28905,"_19790":48787,"_26008":48788,"_2720":48789},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3227":801,"_28586":792,"_5":28905,"_19790":48791,"_26008":48792,"_2720":48793},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3227":802,"_28586":792,"_5":28905,"_19790":48795,"_26008":48796,"_2720":48797},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3227":803,"_28586":792,"_5":28905,"_19790":48799,"_26008":48800,"_2720":48801},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3227":804,"_28586":792,"_5":28905,"_19790":48803,"_26008":48804,"_2720":48805},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3227":805,"_28586":792,"_19790":48807,"_5":13558,"_26008":792,"_2720":48808},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3227":806,"_28586":792,"_19790":48810,"_5":13558,"_26008":792,"_2720":48811},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3227":807,"_28586":792,"_19790":48813,"_5":13558,"_26008":48764,"_2720":48814},[],"Operational view",{"_3227":808,"_28586":792,"_19790":48816,"_5":13558,"_26008":48764,"_2720":48817},[],"Meaning",{"_3227":809,"_28586":792,"_19790":48819,"_5":13558,"_26008":48764,"_2720":48820},[],"**No Identity**",{"_3227":810,"_28586":792,"_19790":48822,"_5":13558,"_26008":48764,"_2720":48823},[],"A record exists without an associated identity.",{"_3227":811,"_28586":792,"_19790":48825,"_5":13558,"_26008":48764,"_2720":48826},[],"**Active**",{"_3227":812,"_28586":792,"_19790":48828,"_5":13558,"_26008":48764,"_2720":48829},[],"The slot is active; also check certificate dates, status and usages.",{"_3227":813,"_28586":792,"_19790":48831,"_5":13558,"_26008":48764,"_2720":48832},[],"**Renewal Pending**",{"_3227":814,"_28586":792,"_19790":48834,"_5":13558,"_26008":48764,"_2720":48835},[],"The identity is in the operational renewal window.",{"_3227":815,"_28586":792,"_19790":48837,"_5":13558,"_26008":48764,"_2720":48838},[],"**Expiring Soon**",{"_3227":816,"_28586":792,"_19790":48840,"_5":13558,"_26008":48764,"_2720":48841},[],"Expiration is approaching according to configured thresholds.",{"_3227":817,"_28586":792,"_19790":48843,"_5":13558,"_26008":48764,"_2720":48844},[],"**Expired**",{"_3227":818,"_28586":792,"_19790":48846,"_5":13558,"_26008":48764,"_2720":48847},[],"The identity has expired.",{"_3227":819,"_28586":792,"_19790":48849,"_5":13558,"_26008":48764,"_2720":48850},[],"**Revoked**",{"_3227":820,"_28586":792,"_19790":48852,"_5":13558,"_26008":48764,"_2720":48853},[],"The identity is marked revoked.",{"_3227":821,"_28586":792,"_19790":48855,"_5":13558,"_26008":48764,"_2720":48856},[],"**Decommissioned**",{"_3227":822,"_28586":792,"_19790":48858,"_5":13558,"_26008":48764,"_2720":48859},[],"The record is retired and ordinary updates do not restore operation.",{"_3227":823,"_28586":792,"_19790":48861,"_5":13558,"_26008":48764,"_2720":48862},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3227":824,"_28586":792,"_19790":48864,"_5":13558,"_26008":48768,"_2720":48865},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3227":825,"_28586":792,"_19790":48867,"_5":13558,"_26008":48768,"_2720":48868},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3227":826,"_28586":792,"_19790":48870,"_5":13558,"_26008":48768,"_2720":48871},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3227":827,"_28586":792,"_19790":48873,"_5":13558,"_26008":48768,"_2720":48874},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3227":828,"_28586":792,"_19790":48876,"_5":13558,"_26008":48772,"_2720":48877},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3227":829,"_28586":792,"_19790":48879,"_5":13558,"_26008":48776,"_2720":48880},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3227":830,"_28586":792,"_19790":48882,"_5":13558,"_26008":48780,"_2720":48883},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3227":831,"_28586":792,"_19790":48885,"_5":13558,"_26008":48784,"_2720":48886},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3227":832,"_28586":792,"_19790":48888,"_5":13558,"_26008":48788,"_2720":48889},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3227":833,"_28586":792,"_19790":48891,"_5":13558,"_26008":48788,"_2720":48892},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3227":834,"_28586":792,"_19790":48894,"_5":13558,"_26008":48792,"_2720":48895},[],"From **No Identity**, use **Assign Identity**:",{"_3227":835,"_28586":792,"_19790":48897,"_5":13558,"_26008":48792,"_2720":48898},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3227":836,"_28586":792,"_19790":48900,"_5":13558,"_26008":48792,"_2720":48901},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3227":837,"_28586":792,"_19790":48903,"_5":13558,"_26008":48792,"_2720":48904},[],"Confirm and read the serial, active version and history again.",{"_3227":838,"_28586":792,"_19790":48906,"_5":13558,"_26008":48792,"_2720":48907},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3227":839,"_28586":792,"_19790":48909,"_5":13558,"_26008":48792,"_2720":48910},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3227":840,"_28586":792,"_19790":48912,"_5":13558,"_26008":48796,"_2720":48913},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3227":841,"_28586":792,"_19790":48915,"_5":13558,"_26008":48796,"_2720":48916},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3227":842,"_28586":792,"_19790":48918,"_5":13558,"_26008":48800,"_2720":48919},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3227":843,"_28586":792,"_19790":48921,"_5":13558,"_26008":48800,"_2720":48922},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3227":844,"_28586":792,"_19790":48924,"_5":13558,"_26008":48800,"_2720":48925},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3227":845,"_28586":792,"_19790":48927,"_5":13558,"_26008":48800,"_2720":48928},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3227":846,"_28586":792,"_19790":48930,"_5":13558,"_26008":48804,"_2720":48931},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3227":847,"_28586":792,"_19790":48933,"_5":13558,"_26008":48804,"_2720":48934},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3227":848,"_28586":848,"_5":13916,"_2720":48936,"_28908":48937,"_19790":48939,"_26008":848},"Bootstrap identity and authentication",[46300,47749,48757,48755,48938],"Enrollment with PKI",[],{"_3227":849,"_28586":848,"_19790":48941,"_5":13558,"_26008":848,"_2720":48942},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3227":850,"_28586":848,"_5":28905,"_19790":48944,"_26008":48945,"_2720":48946},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3227":851,"_28586":848,"_5":28905,"_19790":48948,"_26008":48949,"_2720":48950},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3227":852,"_28586":848,"_5":28905,"_19790":48952,"_26008":48953,"_2720":48954},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3227":853,"_28586":848,"_5":28905,"_19790":48956,"_26008":48957,"_2720":48958},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3227":854,"_28586":848,"_5":28905,"_19790":48960,"_26008":48961,"_2720":48962},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3227":855,"_28586":848,"_19790":48964,"_5":13558,"_26008":848,"_2720":48965},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3227":856,"_28586":848,"_19790":48967,"_5":13558,"_26008":48945,"_2720":48968},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3227":857,"_28586":848,"_19790":48970,"_5":13558,"_26008":48945,"_2720":48971},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3227":858,"_28586":848,"_19790":48973,"_5":13558,"_26008":48949,"_2720":48974},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3227":859,"_28586":848,"_19790":48976,"_5":13558,"_26008":48949,"_2720":48977},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3227":860,"_28586":848,"_19790":48979,"_5":13558,"_26008":48949,"_2720":48980},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3227":861,"_28586":848,"_19790":48982,"_5":13558,"_26008":48953,"_2720":48983},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3227":862,"_28586":848,"_19790":48985,"_5":13558,"_26008":48953,"_2720":48986},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3227":863,"_28586":848,"_19790":48988,"_5":13558,"_26008":48957,"_2720":48989},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3227":864,"_28586":848,"_19790":48991,"_5":13558,"_26008":48957,"_2720":48992},[],"Example body:",{"_3227":865,"_28586":848,"_19790":48994,"_5":13558,"_26008":48957,"_2720":48995},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3227":866,"_28586":848,"_19790":48997,"_5":13558,"_26008":48957,"_2720":48998},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3227":867,"_28586":848,"_19790":49000,"_5":13558,"_26008":48957,"_2720":49001},[],"Continuation requires a successful HTTP response and JSON:",{"_3227":868,"_28586":848,"_19790":49003,"_5":13558,"_26008":48957,"_2720":49004},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3227":869,"_28586":848,"_19790":49006,"_5":13558,"_26008":48961,"_2720":49007},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3227":870,"_28586":848,"_19790":49009,"_5":13558,"_26008":48961,"_2720":49010},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3227":871,"_28586":871,"_5":13916,"_2720":49012,"_28908":49013,"_19790":49014,"_26008":871},"Configure and operate the DMS",[46300,47749,48757,48755,48938],[],{"_3227":872,"_28586":871,"_19790":49016,"_5":13558,"_26008":871,"_2720":49017},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3227":873,"_28586":871,"_5":28905,"_19790":49019,"_26008":49020,"_2720":46310},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3227":874,"_28586":871,"_5":28905,"_19790":49022,"_26008":49023,"_2720":49024},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3227":875,"_28586":871,"_5":28905,"_19790":49026,"_26008":49027,"_2720":49028},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3227":876,"_28586":871,"_5":28905,"_19790":49030,"_26008":49031,"_2720":49032},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3227":877,"_28586":871,"_5":28905,"_19790":49034,"_26008":49035,"_2720":49036},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3227":878,"_28586":871,"_5":28905,"_19790":49038,"_26008":49039,"_2720":49040},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3227":879,"_28586":871,"_5":28905,"_19790":49042,"_26008":49043,"_2720":49044},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3227":880,"_28586":871,"_5":28905,"_19790":49046,"_26008":49047,"_2720":49048},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3227":881,"_28586":871,"_5":28905,"_19790":49050,"_26008":49051,"_2720":49052},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3227":882,"_28586":871,"_5":28905,"_19790":49054,"_26008":49055,"_2720":49056},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3227":883,"_28586":871,"_5":28905,"_19790":49058,"_26008":49059,"_2720":49060},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3227":884,"_28586":871,"_5":28905,"_19790":49062,"_26008":49063,"_2720":49064},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3227":885,"_28586":871,"_5":28905,"_19790":49066,"_26008":49067,"_2720":49068},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3227":886,"_28586":871,"_5":28905,"_19790":49070,"_26008":49071,"_2720":49072},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3227":887,"_28586":871,"_5":28905,"_19790":49074,"_26008":49075,"_2720":49076},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3227":888,"_28586":871,"_5":28905,"_19790":49078,"_26008":49079,"_2720":49080},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3227":889,"_28586":871,"_5":28905,"_19790":49082,"_26008":49083,"_2720":49084},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3227":890,"_28586":871,"_5":28905,"_19790":49086,"_26008":49087,"_2720":49088},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3227":891,"_28586":871,"_19790":49090,"_5":13558,"_26008":871,"_2720":49091},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3227":892,"_28586":871,"_19790":49093,"_5":13558,"_26008":49020,"_2720":49094},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3227":893,"_28586":871,"_19790":49096,"_5":13558,"_26008":49020,"_2720":49097},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3227":894,"_28586":871,"_19790":49099,"_5":13558,"_26008":49027,"_2720":49100},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3227":895,"_28586":871,"_19790":49102,"_5":13558,"_26008":49031,"_2720":49103},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3227":896,"_28586":871,"_19790":49105,"_5":13558,"_26008":49035,"_2720":49106},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3227":897,"_28586":871,"_19790":49108,"_5":13558,"_26008":49039,"_2720":49109},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3227":898,"_28586":871,"_19790":49111,"_5":13558,"_26008":49043,"_2720":49112},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3227":899,"_28586":871,"_19790":49114,"_5":13558,"_26008":49051,"_2720":49115},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3227":900,"_28586":871,"_19790":49117,"_5":13558,"_26008":49051,"_2720":49118},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3227":901,"_28586":871,"_19790":49120,"_5":13558,"_26008":49055,"_2720":49121},[],"`settings.enrollment_settings` field",{"_3227":902,"_28586":871,"_19790":49123,"_5":13558,"_26008":49055,"_2720":49124},[],"Decision",{"_3227":903,"_28586":871,"_19790":49126,"_5":13558,"_26008":49055,"_2720":49127},[],"`protocol`",{"_3227":904,"_28586":871,"_19790":49129,"_5":13558,"_26008":49055,"_2720":49130},[],"`EST_RFC7030` for these operations.",{"_3227":905,"_28586":871,"_19790":49132,"_5":13558,"_26008":49055,"_2720":49133},[],"`enrollment_ca`",{"_3227":906,"_28586":871,"_19790":49135,"_5":13558,"_26008":49055,"_2720":49136},[],"ID of the signing CA.",{"_3227":907,"_28586":871,"_19790":49138,"_5":13558,"_26008":49055,"_2720":49139},[],"`verify_csr_signature`",{"_3227":908,"_28586":871,"_19790":49141,"_5":13558,"_26008":49055,"_2720":49142},[],"Keep `true` to verify CSR key possession.",{"_3227":909,"_28586":871,"_19790":49144,"_5":13558,"_26008":49055,"_2720":49145},[],"`enable_replaceable_enrollment`",{"_3227":910,"_28586":871,"_19790":49147,"_5":13558,"_26008":49055,"_2720":49148},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3227":911,"_28586":871,"_19790":49150,"_5":13558,"_26008":49055,"_2720":49151},[],"`est_rfc7030_settings.auth_mode`",{"_3227":912,"_28586":871,"_19790":49153,"_5":13558,"_26008":49055,"_2720":49154},[],"One of the four authentication modes.",{"_3227":913,"_28586":871,"_19790":49156,"_5":13558,"_26008":49055,"_2720":49157},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3227":914,"_28586":871,"_19790":49159,"_5":13558,"_26008":49059,"_2720":49160},[],"The blocks are independent:",{"_3227":915,"_28586":871,"_19790":49162,"_5":13558,"_26008":49059,"_2720":49163},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3227":916,"_28586":871,"_19790":49165,"_5":13558,"_26008":49059,"_2720":49166},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3227":917,"_28586":871,"_19790":49168,"_5":13558,"_26008":49059,"_2720":49169},[],"`auth_mode`",{"_3227":918,"_28586":871,"_19790":49171,"_5":13558,"_26008":49059,"_2720":49172},[],"Control applied in the configured operation",{"_3227":919,"_28586":871,"_19790":49174,"_5":13558,"_26008":49059,"_2720":49175},[],"`CLIENT_CERTIFICATE`",{"_3227":920,"_28586":871,"_19790":49177,"_5":13558,"_26008":49059,"_2720":49178},[],"Presented certificate validation.",{"_3227":921,"_28586":871,"_19790":49180,"_5":13558,"_26008":49059,"_2720":49181},[],"`EXTERNAL_WEBHOOK`",{"_3227":922,"_28586":871,"_19790":49183,"_5":13558,"_26008":49059,"_2720":49184},[],"Configured webhook authorization.",{"_3227":923,"_28586":871,"_19790":49186,"_5":13558,"_26008":49059,"_2720":49187},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3227":924,"_28586":871,"_19790":49189,"_5":13558,"_26008":49059,"_2720":49190},[],"Certificate validation followed by webhook approval.",{"_3227":925,"_28586":871,"_19790":49192,"_5":13558,"_26008":49059,"_2720":49193},[],"`NO_AUTH`",{"_3227":926,"_28586":871,"_19790":49195,"_5":13558,"_26008":49059,"_2720":49196},[],"No DMS requester authentication.",{"_3227":927,"_28586":871,"_19790":49198,"_5":13558,"_26008":49059,"_2720":49199},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3227":928,"_28586":871,"_19790":49201,"_5":13558,"_26008":49059,"_2720":49202},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3227":929,"_28586":871,"_19790":49204,"_5":13558,"_26008":49059,"_2720":49205},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3227":930,"_28586":871,"_19790":49207,"_5":13558,"_26008":49059,"_2720":49208},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3227":931,"_28586":871,"_19790":49210,"_5":13558,"_26008":49063,"_2720":49211},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3227":932,"_28586":871,"_19790":49213,"_5":13558,"_26008":49063,"_2720":49214},[],"`external_webhook_settings` field",{"_3227":933,"_28586":871,"_19790":49216,"_5":13558,"_26008":49063,"_2720":49124},[],{"_3227":934,"_28586":871,"_19790":49218,"_5":13558,"_26008":49063,"_2720":49219},[],"`url`",{"_3227":935,"_28586":871,"_19790":49221,"_5":13558,"_26008":49063,"_2720":49222},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3227":936,"_28586":871,"_19790":49224,"_5":13558,"_26008":49063,"_2720":49225},[],"`method`",{"_3227":937,"_28586":871,"_19790":49227,"_5":13558,"_26008":49063,"_2720":49228},[],"`POST` or `PUT`; `POST` by default.",{"_3227":938,"_28586":871,"_19790":49230,"_5":13558,"_26008":49063,"_2720":49231},[],"`name`",{"_3227":939,"_28586":871,"_19790":49233,"_5":13558,"_26008":49063,"_2720":49234},[],"Label used in service logs.",{"_3227":940,"_28586":871,"_19790":49236,"_5":13558,"_26008":49063,"_2720":49237},[],"`config.auth_mode`",{"_3227":941,"_28586":871,"_19790":49239,"_5":13558,"_26008":49063,"_2720":49240},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3227":942,"_28586":871,"_19790":49242,"_5":13558,"_26008":49063,"_2720":49243},[],"`config.log_level`",{"_3227":943,"_28586":871,"_19790":49245,"_5":13558,"_26008":49063,"_2720":49246},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3227":944,"_28586":871,"_19790":49248,"_5":13558,"_26008":49063,"_2720":49249},[],"`config.apikey_options`",{"_3227":945,"_28586":871,"_19790":49251,"_5":13558,"_26008":49063,"_2720":49252},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3227":946,"_28586":871,"_19790":49254,"_5":13558,"_26008":49063,"_2720":49255},[],"`config.jwt_options`",{"_3227":947,"_28586":871,"_19790":49257,"_5":13558,"_26008":49063,"_2720":49258},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3227":948,"_28586":871,"_19790":49260,"_5":13558,"_26008":49063,"_2720":49261},[],"`config.mtls_options`",{"_3227":949,"_28586":871,"_19790":49263,"_5":13558,"_26008":49063,"_2720":49264},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3227":950,"_28586":871,"_19790":49266,"_5":13558,"_26008":49063,"_2720":49267},[],"`config.insecure_skip_verify`",{"_3227":951,"_28586":871,"_19790":49269,"_5":13558,"_26008":49063,"_2720":49270},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3227":952,"_28586":871,"_19790":49272,"_5":13558,"_26008":49063,"_2720":49273},[],"`config.call_timeout`",{"_3227":953,"_28586":871,"_19790":49275,"_5":13558,"_26008":49063,"_2720":49276},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3227":954,"_28586":871,"_19790":49278,"_5":13558,"_26008":49063,"_2720":49279},[],"Rules for that configuration:",{"_3227":955,"_28586":871,"_19790":49281,"_5":13558,"_26008":49063,"_2720":49282},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3227":956,"_28586":871,"_19790":49284,"_5":13558,"_26008":49063,"_2720":49285},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3227":957,"_28586":871,"_19790":49287,"_5":13558,"_26008":49063,"_2720":49288},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3227":958,"_28586":871,"_19790":49290,"_5":13558,"_26008":49063,"_2720":49291},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3227":959,"_28586":871,"_19790":49293,"_5":13558,"_26008":49063,"_2720":49294},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3227":960,"_28586":871,"_19790":49296,"_5":13558,"_26008":49063,"_2720":49297},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3227":961,"_28586":871,"_19790":49299,"_5":13558,"_26008":49063,"_2720":49300},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3227":962,"_28586":871,"_19790":49302,"_5":13558,"_26008":49063,"_2720":49303},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3227":963,"_28586":871,"_19790":49305,"_5":13558,"_26008":49063,"_2720":49306},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3227":964,"_28586":871,"_19790":49308,"_5":13558,"_26008":49067,"_2720":49309},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3227":965,"_28586":871,"_19790":49311,"_5":13558,"_26008":49071,"_2720":49312},[],"`settings.reenrollment_settings` field",{"_3227":966,"_28586":871,"_19790":49314,"_5":13558,"_26008":49071,"_2720":46690},[],{"_3227":967,"_28586":871,"_19790":49316,"_5":13558,"_26008":49071,"_2720":49317},[],"`reenrollment_delta`",{"_3227":968,"_28586":871,"_19790":49319,"_5":13558,"_26008":49071,"_2720":49320},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3227":969,"_28586":871,"_19790":49322,"_5":13558,"_26008":49071,"_2720":49323},[],"`preventive_delta`",{"_3227":970,"_28586":871,"_19790":49325,"_5":13558,"_26008":49071,"_2720":49326},[],"Preventive operational monitoring threshold.",{"_3227":971,"_28586":871,"_19790":49328,"_5":13558,"_26008":49071,"_2720":49329},[],"`critical_delta`",{"_3227":972,"_28586":871,"_19790":49331,"_5":13558,"_26008":49071,"_2720":49332},[],"Critical operational monitoring threshold.",{"_3227":973,"_28586":871,"_19790":49334,"_5":13558,"_26008":49071,"_2720":49335},[],"`enable_expired_renewal`",{"_3227":974,"_28586":871,"_19790":49337,"_5":13558,"_26008":49071,"_2720":49338},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3227":975,"_28586":871,"_19790":49340,"_5":13558,"_26008":49071,"_2720":49341},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3227":976,"_28586":871,"_19790":49343,"_5":13558,"_26008":49071,"_2720":49344},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3227":977,"_28586":871,"_19790":49346,"_5":13558,"_26008":49071,"_2720":49347},[],"`revoke_on_reenrollment`",{"_3227":978,"_28586":871,"_19790":49349,"_5":13558,"_26008":49071,"_2720":49350},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3227":979,"_28586":871,"_19790":49352,"_5":13558,"_26008":49071,"_2720":49353},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3227":980,"_28586":871,"_19790":49355,"_5":13558,"_26008":49075,"_2720":49356},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3227":981,"_28586":871,"_19790":49358,"_5":13558,"_26008":49079,"_2720":46684},[],{"_3227":982,"_28586":871,"_19790":49360,"_5":13558,"_26008":49079,"_2720":49361},[],"Published material",{"_3227":983,"_28586":871,"_19790":49363,"_5":13558,"_26008":49079,"_2720":49364},[],"**Include Lamassu System CA**",{"_3227":984,"_28586":871,"_19790":49366,"_5":13558,"_26008":49079,"_2720":49367},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3227":985,"_28586":871,"_19790":49369,"_5":13558,"_26008":49079,"_2720":49370},[],"**Include Enrollment CA**",{"_3227":986,"_28586":871,"_19790":49372,"_5":13558,"_26008":49079,"_2720":49373},[],"Selected issuing CA certificate.",{"_3227":987,"_28586":871,"_19790":49375,"_5":13558,"_26008":49079,"_2720":49376},[],"**Managed CAs**",{"_3227":988,"_28586":871,"_19790":49378,"_5":13558,"_26008":49079,"_2720":49379},[],"Explicitly selected CA certificates.",{"_3227":989,"_28586":871,"_19790":49381,"_5":13558,"_26008":49079,"_2720":49382},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3227":990,"_28586":871,"_19790":49384,"_5":13558,"_26008":49083,"_2720":49385},[],"**Edit** changes name, settings and metadata. When using the API, read the DMS before editing it: `name` and `settings` are replaced entirely. Omitted or `null` `metadata` keeps the stored value, and an object replaces it entirely. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3227":991,"_28586":871,"_19790":49387,"_5":13558,"_26008":49083,"_2720":49388},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3227":992,"_28586":871,"_19790":49390,"_5":13558,"_26008":49083,"_2720":49391},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3227":993,"_28586":871,"_19790":49393,"_5":13558,"_26008":49087,"_2720":49394},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3227":994,"_28586":994,"_5":13916,"_2720":49396,"_28908":49397,"_19790":49398,"_26008":994},"Integrate the EST client",[46300,47749,48757,48755,48938],[],{"_3227":995,"_28586":994,"_19790":49400,"_5":13558,"_26008":994,"_2720":49401},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3227":996,"_28586":994,"_5":28905,"_19790":49403,"_26008":49404,"_2720":46310},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3227":997,"_28586":994,"_5":28905,"_19790":49406,"_26008":49407,"_2720":49408},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3227":998,"_28586":994,"_5":28905,"_19790":49410,"_26008":49411,"_2720":49412},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3227":999,"_28586":994,"_5":28905,"_19790":49414,"_26008":49415,"_2720":49416},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3227":1000,"_28586":994,"_5":28905,"_19790":49418,"_26008":49419,"_2720":49420},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3227":1001,"_28586":994,"_5":28905,"_19790":49422,"_26008":49423,"_2720":49424},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3227":1002,"_28586":994,"_19790":49426,"_5":13558,"_26008":994,"_2720":49427},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3227":1003,"_28586":994,"_19790":49429,"_5":13558,"_26008":49404,"_2720":49430},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3227":1004,"_28586":994,"_19790":49432,"_5":13558,"_26008":49404,"_2720":49433},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3227":1005,"_28586":994,"_19790":49435,"_5":13558,"_26008":49404,"_2720":49436},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3227":1006,"_28586":994,"_19790":49438,"_5":13558,"_26008":49407,"_2720":49439},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3227":1007,"_28586":994,"_19790":49441,"_5":13558,"_26008":49407,"_2720":49442},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3227":1008,"_28586":994,"_19790":49444,"_5":13558,"_26008":49411,"_2720":49445},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3227":1009,"_28586":994,"_19790":49447,"_5":13558,"_26008":49411,"_2720":49448},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3227":1010,"_28586":994,"_19790":49450,"_5":13558,"_26008":49415,"_2720":49451},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3227":1011,"_28586":994,"_19790":49453,"_5":13558,"_26008":49415,"_2720":49454},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3227":1012,"_28586":994,"_19790":49456,"_5":13558,"_26008":49419,"_2720":49457},[],"For a root that issues directly:",{"_3227":1013,"_28586":994,"_19790":49459,"_5":13558,"_26008":49419,"_2720":49460},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3227":1014,"_28586":994,"_19790":49462,"_5":13558,"_26008":49419,"_2720":49463},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3227":1015,"_28586":994,"_19790":49465,"_5":13558,"_26008":49423,"_2720":49466},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3227":1016,"_28586":1016,"_5":13916,"_2720":49468,"_28908":49469,"_19790":49470,"_26008":1016},"EST reference",[46300,47749,48757,48755,48938],[],{"_3227":1017,"_28586":1016,"_19790":49472,"_5":13558,"_26008":1016,"_2720":49473},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3227":1018,"_28586":1016,"_5":28905,"_19790":49475,"_26008":49476,"_2720":49477},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3227":1019,"_28586":1016,"_5":28905,"_19790":49479,"_26008":49480,"_2720":21508},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3227":1020,"_28586":1016,"_5":28905,"_19790":49482,"_26008":49483,"_2720":24657},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3227":1021,"_28586":1016,"_5":28905,"_19790":49485,"_26008":49486,"_2720":24664},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3227":1022,"_28586":1016,"_5":28905,"_19790":49488,"_26008":49489,"_2720":23997},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3227":1023,"_28586":1016,"_5":28905,"_19790":49491,"_26008":49492,"_2720":49493},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3227":1024,"_28586":1016,"_5":28905,"_19790":49495,"_26008":49496,"_2720":49497},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3227":1025,"_28586":1016,"_5":28905,"_19790":49499,"_26008":49500,"_2720":49501},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3227":1026,"_28586":1016,"_19790":49503,"_5":13558,"_26008":1016,"_2720":49504},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3227":1027,"_28586":1016,"_19790":49506,"_5":13558,"_26008":49476,"_2720":49507},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3227":1028,"_28586":1016,"_19790":49509,"_5":13558,"_26008":49476,"_2720":49510},[],"Operation",{"_3227":1029,"_28586":1016,"_19790":49512,"_5":13558,"_26008":49476,"_2720":49513},[],"Method",{"_3227":1030,"_28586":1016,"_19790":49515,"_5":13558,"_26008":49476,"_2720":49516},[],"Authentication and condition",{"_3227":1031,"_28586":1016,"_19790":49518,"_5":13558,"_26008":49476,"_2720":49519},[],"`/cacerts`",{"_3227":1032,"_28586":1016,"_19790":49521,"_5":13558,"_26008":49476,"_2720":49522},[],"GET",{"_3227":1033,"_28586":1016,"_19790":49524,"_5":13558,"_26008":49476,"_2720":49525},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3227":1034,"_28586":1016,"_19790":49527,"_5":13558,"_26008":49476,"_2720":49528},[],"`/simpleenroll`",{"_3227":1035,"_28586":1016,"_19790":49530,"_5":13558,"_26008":49476,"_2720":49531},[],"POST",{"_3227":1036,"_28586":1016,"_19790":49533,"_5":13558,"_26008":49476,"_2720":49534},[],"Initial authentication and DMS registration/replacement policy.",{"_3227":1037,"_28586":1016,"_19790":49536,"_5":13558,"_26008":49476,"_2720":49537},[],"`/simplereenroll`",{"_3227":1038,"_28586":1016,"_19790":49539,"_5":13558,"_26008":49476,"_2720":49531},[],{"_3227":1039,"_28586":1016,"_19790":49541,"_5":13558,"_26008":49476,"_2720":49542},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3227":1040,"_28586":1016,"_19790":49544,"_5":13558,"_26008":49476,"_2720":49545},[],"`/serverkeygen`",{"_3227":1041,"_28586":1016,"_19790":49547,"_5":13558,"_26008":49476,"_2720":49531},[],{"_3227":1042,"_28586":1016,"_19790":49549,"_5":13558,"_26008":49476,"_2720":49550},[],"Initial authentication and admission; server generation enabled.",{"_3227":1043,"_28586":1016,"_19790":49552,"_5":13558,"_26008":49476,"_2720":49553},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3227":1044,"_28586":1016,"_19790":49555,"_5":13558,"_26008":49480,"_2720":49556},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3227":1045,"_28586":1016,"_19790":49558,"_5":13558,"_26008":49480,"_2720":49559},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3227":1046,"_28586":1016,"_19790":49561,"_5":13558,"_26008":49483,"_2720":49562},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3227":1047,"_28586":1016,"_19790":49564,"_5":13558,"_26008":49483,"_2720":49565},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3227":1048,"_28586":1016,"_19790":49567,"_5":13558,"_26008":49486,"_2720":49568},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3227":1049,"_28586":1016,"_19790":49570,"_5":13558,"_26008":49486,"_2720":49571},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3227":1050,"_28586":1016,"_19790":49573,"_5":13558,"_26008":49489,"_2720":49574},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3227":1051,"_28586":1016,"_19790":49576,"_5":13558,"_26008":49489,"_2720":49577},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3227":1052,"_28586":1016,"_19790":49579,"_5":13558,"_26008":49492,"_2720":49580},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3227":1053,"_28586":1016,"_19790":49582,"_5":13558,"_26008":49492,"_2720":49583},[],"Part",{"_3227":1054,"_28586":1016,"_19790":49585,"_5":13558,"_26008":49492,"_2720":49586},[],"Content after decoding its Base64",{"_3227":1055,"_28586":1016,"_19790":49588,"_5":13558,"_26008":49492,"_2720":49589},[],"`application/pkcs8`",{"_3227":1056,"_28586":1016,"_19790":49591,"_5":13558,"_26008":49492,"_2720":49592},[],"Unencrypted DER PKCS#8 private key.",{"_3227":1057,"_28586":1016,"_19790":49594,"_5":13558,"_26008":49492,"_2720":49595},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3227":1058,"_28586":1016,"_19790":49597,"_5":13558,"_26008":49492,"_2720":49598},[],"DER PKCS#7 containing the issued certificate.",{"_3227":1059,"_28586":1016,"_19790":49600,"_5":13558,"_26008":49492,"_2720":49601},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3227":1060,"_28586":1016,"_19790":49603,"_5":13558,"_26008":49496,"_2720":49604},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3227":1061,"_28586":1016,"_19790":49606,"_5":13558,"_26008":49496,"_2720":49607},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3227":1062,"_28586":1016,"_19790":49609,"_5":13558,"_26008":49496,"_2720":49610},[],"Convert and check the result:",{"_3227":1063,"_28586":1016,"_19790":49612,"_5":13558,"_26008":49496,"_2720":49613},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3227":1064,"_28586":1016,"_19790":49615,"_5":13558,"_26008":49500,"_2720":49616},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3227":1065,"_28586":1016,"_19790":49618,"_5":13558,"_26008":49500,"_2720":49619},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3227":1066,"_28586":1066,"_5":13916,"_2720":48938,"_28908":49621,"_19790":49622,"_26008":1066},[46300,47749,48757,48755,48938],[],{"_3227":1067,"_28586":1066,"_19790":49624,"_5":13558,"_26008":1066,"_2720":49625},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3227":1068,"_28586":1066,"_5":28905,"_19790":49627,"_26008":49628,"_2720":49629},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3227":1069,"_28586":1066,"_5":28905,"_19790":49631,"_26008":49632,"_2720":49633},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3227":1070,"_28586":1066,"_5":28905,"_19790":49635,"_26008":49636,"_2720":49637},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3227":1071,"_28586":1066,"_5":28905,"_19790":49639,"_26008":49640,"_2720":49641},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3227":1072,"_28586":1066,"_19790":49643,"_5":13558,"_26008":1066,"_2720":49644},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3227":1073,"_28586":1066,"_19790":49646,"_5":13558,"_26008":49628,"_2720":49647},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3227":1074,"_28586":1066,"_19790":49649,"_5":13558,"_26008":49628,"_2720":49650},[],"The integrator installs initial EST server trust and an admission credential.",{"_3227":1075,"_28586":1066,"_19790":49652,"_5":13558,"_26008":49628,"_2720":49653},[],"The client requests an identity for its `Device ID` through EST.",{"_3227":1076,"_28586":1066,"_19790":49655,"_5":13558,"_26008":49628,"_2720":49656},[],"Certificate, device binding and key/certificate installation are checked.",{"_3227":1077,"_28586":1066,"_19790":49658,"_5":13558,"_26008":49628,"_2720":49659},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3227":1078,"_28586":1066,"_19790":49661,"_5":13558,"_26008":49628,"_2720":49662},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3227":1079,"_28586":1066,"_19790":49664,"_5":13558,"_26008":49632,"_2720":49665},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3227":1080,"_28586":1066,"_19790":49667,"_5":13558,"_26008":49632,"_2720":49668},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":1081,"_28586":1066,"_19790":49670,"_5":13558,"_26008":49632,"_2720":49671},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3227":1082,"_28586":1066,"_19790":49673,"_5":13558,"_26008":49632,"_2720":49674},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3227":1083,"_28586":1066,"_19790":49676,"_5":13558,"_26008":49636,"_2720":49677},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3227":1084,"_28586":1066,"_19790":49679,"_5":13558,"_26008":49636,"_2720":49680},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3227":1085,"_28586":1066,"_19790":49682,"_5":13558,"_26008":49636,"_2720":49683},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3227":1086,"_28586":1066,"_19790":49685,"_5":13558,"_26008":49636,"_2720":49686},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3227":1087,"_28586":1066,"_19790":49688,"_5":13558,"_26008":49640,"_2720":49689},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3227":1088,"_28586":1066,"_19790":49691,"_5":13558,"_26008":49640,"_2720":49692},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3227":1089,"_28586":1089,"_5":13916,"_2720":49694,"_28908":49695,"_19790":49696,"_26008":1089},"Provisioning strategies",[46300,47749,48757,48755,48938],[],{"_3227":1090,"_28586":1089,"_19790":49698,"_5":13558,"_26008":1089,"_2720":49699},[],"Choose device registration, identity authorization and key generation.",{"_3227":1091,"_28586":1089,"_5":28905,"_19790":49701,"_26008":49702,"_2720":49703},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3227":1092,"_28586":1089,"_5":28905,"_19790":49705,"_26008":49706,"_2720":49707},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3227":1093,"_28586":1089,"_5":28905,"_19790":49709,"_26008":49710,"_2720":49711},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3227":1094,"_28586":1089,"_5":28905,"_19790":49713,"_26008":49714,"_2720":49715},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3227":1095,"_28586":1089,"_5":28905,"_19790":49717,"_26008":49718,"_2720":49719},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3227":1096,"_28586":1089,"_19790":49721,"_5":13558,"_26008":1089,"_2720":49722},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3227":1097,"_28586":1089,"_19790":49724,"_5":13558,"_26008":49702,"_2720":49725},[],"Path",{"_3227":1098,"_28586":1089,"_19790":49727,"_5":13558,"_26008":49702,"_2720":49728},[],"When the device exists",{"_3227":1099,"_28586":1089,"_19790":49730,"_5":13558,"_26008":49702,"_2720":49731},[],"What to check",{"_3227":1100,"_28586":1089,"_19790":49733,"_5":13558,"_26008":49702,"_2720":49734},[],"Manual assignment",{"_3227":1101,"_28586":1089,"_19790":49736,"_5":13558,"_26008":49702,"_2720":49737},[],"An operator creates it before associating a certificate.",{"_3227":1102,"_28586":1089,"_19790":49739,"_5":13558,"_26008":49702,"_2720":49740},[],"ID, owning DMS, certificate CN and bound serial.",{"_3227":1103,"_28586":1089,"_19790":49742,"_5":13558,"_26008":49702,"_2720":49743},[],"EST with `JITP`",{"_3227":1104,"_28586":1089,"_19790":49745,"_5":13558,"_26008":49702,"_2720":49746},[],"Created for an unknown CN during `/simpleenroll`.",{"_3227":1105,"_28586":1089,"_19790":49748,"_5":13558,"_26008":49702,"_2720":49749},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3227":1106,"_28586":1089,"_19790":49751,"_5":13558,"_26008":49702,"_2720":49752},[],"EST with `PRE_REGISTRATION`",{"_3227":1107,"_28586":1089,"_19790":49754,"_5":13558,"_26008":49702,"_2720":49755},[],"Must exist before `/simpleenroll`.",{"_3227":1108,"_28586":1089,"_19790":49757,"_5":13558,"_26008":49702,"_2720":49758},[],"Approved record, same DMS and replacement conditions for your version.",{"_3227":1109,"_28586":1089,"_19790":49760,"_5":13558,"_26008":49702,"_2720":49761},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3227":1110,"_28586":1089,"_19790":49763,"_5":13558,"_26008":49702,"_2720":49764},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3227":1111,"_28586":1089,"_19790":49766,"_5":13558,"_26008":49706,"_2720":49767},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3227":1112,"_28586":1089,"_19790":49769,"_5":13558,"_26008":49706,"_2720":49770},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3227":1113,"_28586":1089,"_19790":49772,"_5":13558,"_26008":49706,"_2720":49773},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3227":1114,"_28586":1089,"_19790":49775,"_5":13558,"_26008":49710,"_2720":49776},[],"Decide initial enrollment and re-enrollment separately:",{"_3227":1115,"_28586":1089,"_19790":49778,"_5":13558,"_26008":49710,"_2720":49779},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3227":1116,"_28586":1089,"_19790":49781,"_5":13558,"_26008":49710,"_2720":49782},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3227":1117,"_28586":1089,"_19790":49784,"_5":13558,"_26008":49710,"_2720":49785},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3227":1118,"_28586":1089,"_19790":49787,"_5":13558,"_26008":49710,"_2720":49788},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3227":1119,"_28586":1089,"_19790":49790,"_5":13558,"_26008":49710,"_2720":49791},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3227":1120,"_28586":1089,"_19790":49793,"_5":13558,"_26008":49714,"_2720":46684},[],{"_3227":1121,"_28586":1089,"_19790":49795,"_5":13558,"_26008":49714,"_2720":49796},[],"Material crossing EST",{"_3227":1122,"_28586":1089,"_19790":49798,"_5":13558,"_26008":49714,"_2720":49799},[],"Device-generated key",{"_3227":1123,"_28586":1089,"_19790":49801,"_5":13558,"_26008":49714,"_2720":49802},[],"Public CSR and certificate; the key stays on the client.",{"_3227":1124,"_28586":1089,"_19790":49804,"_5":13558,"_26008":49714,"_2720":49805},[],"Existing device key",{"_3227":1125,"_28586":1089,"_19790":49807,"_5":13558,"_26008":49714,"_2720":49808},[],"CSR signed with that key and a new certificate.",{"_3227":1126,"_28586":1089,"_19790":49810,"_5":13558,"_26008":49714,"_2720":49076},[],{"_3227":1127,"_28586":1089,"_19790":49812,"_5":13558,"_26008":49714,"_2720":49813},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3227":1128,"_28586":1089,"_19790":49815,"_5":13558,"_26008":49714,"_2720":49816},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3227":1129,"_28586":1089,"_19790":49818,"_5":13558,"_26008":49718,"_2720":49819},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3227":1130,"_28586":1130,"_5":13916,"_2720":49821,"_28908":49822,"_19790":49823,"_26008":1130},"Renewal and recovery",[46300,47749,48757,48755,48938],[],{"_3227":1131,"_28586":1130,"_19790":49825,"_5":13558,"_26008":1130,"_2720":49826},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3227":1132,"_28586":1130,"_5":28905,"_19790":49828,"_26008":49829,"_2720":49830},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3227":1133,"_28586":1130,"_5":28905,"_19790":49832,"_26008":49833,"_2720":49834},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3227":1134,"_28586":1130,"_5":28905,"_19790":49836,"_26008":49837,"_2720":49838},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3227":1135,"_28586":1130,"_5":28905,"_19790":49840,"_26008":49841,"_2720":49842},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3227":1136,"_28586":1130,"_5":28905,"_19790":49844,"_26008":49845,"_2720":49846},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3227":1137,"_28586":1130,"_19790":49848,"_5":13558,"_26008":1130,"_2720":49849},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3227":1138,"_28586":1130,"_19790":49851,"_5":13558,"_26008":49829,"_2720":49852},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3227":1139,"_28586":1130,"_19790":49854,"_5":13558,"_26008":49829,"_2720":49855},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3227":1140,"_28586":1130,"_19790":49857,"_5":13558,"_26008":49829,"_2720":49858},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3227":1141,"_28586":1130,"_19790":49860,"_5":13558,"_26008":49829,"_2720":49861},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3227":1142,"_28586":1130,"_19790":49863,"_5":13558,"_26008":49833,"_2720":49864},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3227":1143,"_28586":1130,"_19790":49866,"_5":13558,"_26008":49833,"_2720":49867},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3227":1144,"_28586":1130,"_19790":49869,"_5":13558,"_26008":49837,"_2720":49870},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3227":1145,"_28586":1130,"_19790":49872,"_5":13558,"_26008":49837,"_2720":49873},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3227":1146,"_28586":1130,"_19790":49875,"_5":13558,"_26008":49837,"_2720":49876},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3227":1147,"_28586":1130,"_19790":49878,"_5":13558,"_26008":49841,"_2720":49879},[],"Situation",{"_3227":1148,"_28586":1130,"_19790":49881,"_5":13558,"_26008":49841,"_2720":49882},[],"Procedure",{"_3227":1149,"_28586":1130,"_19790":49884,"_5":13558,"_26008":49841,"_2720":49885},[],"Valid certificate, outside the window",{"_3227":1150,"_28586":1130,"_19790":49887,"_5":13558,"_26008":49841,"_2720":49888},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3227":1151,"_28586":1130,"_19790":49890,"_5":13558,"_26008":49841,"_2720":49891},[],"Expired certificate, key available",{"_3227":1152,"_28586":1130,"_19790":49893,"_5":13558,"_26008":49841,"_2720":49894},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3227":1153,"_28586":1130,"_19790":49896,"_5":13558,"_26008":49841,"_2720":49897},[],"Renewal through webhook or `NO_AUTH`",{"_3227":1154,"_28586":1130,"_19790":49899,"_5":13558,"_26008":49841,"_2720":49900},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3227":1155,"_28586":1130,"_19790":49902,"_5":13558,"_26008":49841,"_2720":49903},[],"Lost or inaccessible key",{"_3227":1156,"_28586":1130,"_19790":49905,"_5":13558,"_26008":49841,"_2720":49906},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3227":1157,"_28586":1130,"_19790":49908,"_5":13558,"_26008":49841,"_2720":49909},[],"Current identity revoked",{"_3227":1158,"_28586":1130,"_19790":49911,"_5":13558,"_26008":49841,"_2720":49912},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3227":1159,"_28586":1130,"_19790":49914,"_5":13558,"_26008":49841,"_2720":49915},[],"Device without an identity",{"_3227":1160,"_28586":1130,"_19790":49917,"_5":13558,"_26008":49841,"_2720":49918},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3227":1161,"_28586":1130,"_19790":49920,"_5":13558,"_26008":49841,"_2720":49921},[],"Retired device",{"_3227":1162,"_28586":1130,"_19790":49923,"_5":13558,"_26008":49841,"_2720":49924},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3227":1163,"_28586":1130,"_19790":49926,"_5":13558,"_26008":49841,"_2720":49927},[],"Timeout, HTTP 500 or installation failure",{"_3227":1164,"_28586":1130,"_19790":49929,"_5":13558,"_26008":49841,"_2720":49930},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3227":1165,"_28586":1130,"_19790":49932,"_5":13558,"_26008":49845,"_2720":49933},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3227":1166,"_28586":1130,"_19790":49935,"_5":13558,"_26008":49845,"_2720":49936},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3227":1167,"_28586":1167,"_5":13916,"_2720":49938,"_28908":49939,"_19790":49940,"_26008":1167},"Enrollment troubleshooting",[46300,47749,48757,48755,48938],[],{"_3227":1168,"_28586":1167,"_19790":49942,"_5":13558,"_26008":1167,"_2720":49943},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3227":1169,"_28586":1167,"_5":28905,"_19790":49945,"_26008":49946,"_2720":49947},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3227":1170,"_28586":1167,"_5":28905,"_19790":49949,"_26008":49950,"_2720":49951},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3227":1171,"_28586":1167,"_5":28905,"_19790":49953,"_26008":49954,"_2720":49501},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3227":1172,"_28586":1167,"_5":28905,"_19790":49956,"_26008":49957,"_2720":49958},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3227":1173,"_28586":1167,"_19790":49960,"_5":13558,"_26008":1167,"_2720":49961},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3227":1174,"_28586":1167,"_19790":49963,"_5":13558,"_26008":49950,"_2720":49964},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3227":1175,"_28586":1167,"_19790":49966,"_5":13558,"_26008":49950,"_2720":49967},[],"Symptom or message",{"_3227":1176,"_28586":1167,"_19790":49969,"_5":13558,"_26008":49950,"_2720":49731},[],{"_3227":1177,"_28586":1167,"_19790":49971,"_5":13558,"_26008":49950,"_2720":49972},[],"curl rejects TLS, name or issuer",{"_3227":1178,"_28586":1167,"_19790":49974,"_5":13558,"_26008":49950,"_2720":49975},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3227":1179,"_28586":1167,"_19790":49977,"_5":13558,"_26008":49950,"_2720":49978},[],"404 or missing APS",{"_3227":1180,"_28586":1167,"_19790":49980,"_5":13558,"_26008":49950,"_2720":49981},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3227":1181,"_28586":1167,"_19790":49983,"_5":13558,"_26008":49950,"_2720":49984},[],"400, CSR or format error",{"_3227":1182,"_28586":1167,"_19790":49986,"_5":13558,"_26008":49950,"_2720":49987},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3227":1183,"_28586":1167,"_19790":49989,"_5":13558,"_26008":49950,"_2720":49990},[],"Missing credential or invalid certificate",{"_3227":1184,"_28586":1167,"_19790":49992,"_5":13558,"_26008":49950,"_2720":49993},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3227":1185,"_28586":1167,"_19790":49995,"_5":13558,"_26008":49950,"_2720":49996},[],"Webhook denies, times out or responds without authorization",{"_3227":1186,"_28586":1167,"_19790":49998,"_5":13558,"_26008":49950,"_2720":49999},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3227":1187,"_28586":1167,"_19790":50001,"_5":13558,"_26008":49950,"_2720":50002},[],"`unexpected status code: <n>: redirects are not followed`",{"_3227":1188,"_28586":1167,"_19790":50004,"_5":13558,"_26008":49950,"_2720":50005},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3227":1189,"_28586":1167,"_19790":50007,"_5":13558,"_26008":49950,"_2720":50008},[],"`webhook response exceeds 1048576 bytes`",{"_3227":1190,"_28586":1167,"_19790":50010,"_5":13558,"_26008":49950,"_2720":50011},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3227":1191,"_28586":1167,"_19790":50013,"_5":13558,"_26008":49950,"_2720":50014},[],"`webhook config must not reference files`",{"_3227":1192,"_28586":1167,"_19790":50016,"_5":13558,"_26008":49950,"_2720":50017},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3227":1193,"_28586":1167,"_19790":50019,"_5":13558,"_26008":49950,"_2720":50020},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3227":1194,"_28586":1167,"_19790":50022,"_5":13558,"_26008":49950,"_2720":50023},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3227":1195,"_28586":1167,"_19790":50025,"_5":13558,"_26008":49950,"_2720":50026},[],"`webhook mTLS certificate and key are invalid: …`",{"_3227":1196,"_28586":1167,"_19790":50028,"_5":13558,"_26008":49950,"_2720":50029},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3227":1197,"_28586":1167,"_19790":50031,"_5":13558,"_26008":49950,"_2720":50032},[],"400 `struct validation error` creating or updating a DMS",{"_3227":1198,"_28586":1167,"_19790":50034,"_5":13558,"_26008":49950,"_2720":50035},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3227":1199,"_28586":1167,"_19790":50037,"_5":13558,"_26008":49950,"_2720":50038},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3227":1200,"_28586":1167,"_19790":50040,"_5":13558,"_26008":49950,"_2720":50041},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3227":1201,"_28586":1167,"_19790":50043,"_5":13558,"_26008":49950,"_2720":50044},[],"`device not preregistered`",{"_3227":1202,"_28586":1167,"_19790":50046,"_5":13558,"_26008":49950,"_2720":50047},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3227":1203,"_28586":1167,"_19790":50049,"_5":13558,"_26008":49950,"_2720":50050},[],"`forbiddenNewEnrollment`",{"_3227":1204,"_28586":1167,"_19790":50052,"_5":13558,"_26008":49950,"_2720":50053},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3227":1205,"_28586":1167,"_19790":50055,"_5":13558,"_26008":49950,"_2720":50056},[],"Different owning DMS",{"_3227":1206,"_28586":1167,"_19790":50058,"_5":13558,"_26008":49950,"_2720":50059},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3227":1207,"_28586":1167,"_19790":50061,"_5":13558,"_26008":49950,"_2720":50062},[],"`invalid RawSubject bytes`",{"_3227":1208,"_28586":1167,"_19790":50064,"_5":13558,"_26008":49950,"_2720":50065},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3227":1209,"_28586":1167,"_19790":50067,"_5":13558,"_26008":49950,"_2720":50068},[],"`invalid reenroll window`",{"_3227":1210,"_28586":1167,"_19790":50070,"_5":13558,"_26008":49950,"_2720":50071},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3227":1211,"_28586":1167,"_19790":50073,"_5":13558,"_26008":49950,"_2720":50074},[],"Current certificate revoked",{"_3227":1212,"_28586":1167,"_19790":50076,"_5":13558,"_26008":49950,"_2720":50077},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3227":1213,"_28586":1167,"_19790":50079,"_5":13558,"_26008":49950,"_2720":50080},[],"CA, profile or signing error",{"_3227":1214,"_28586":1167,"_19790":50082,"_5":13558,"_26008":49950,"_2720":50083},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3227":1215,"_28586":1167,"_19790":50085,"_5":13558,"_26008":49950,"_2720":50086},[],"HTTP 200 without a device connection",{"_3227":1216,"_28586":1167,"_19790":50088,"_5":13558,"_26008":49950,"_2720":50089},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3227":1217,"_28586":1167,"_19790":50091,"_5":13558,"_26008":49950,"_2720":50092},[],"Timeout or error after issuance",{"_3227":1218,"_28586":1167,"_19790":50094,"_5":13558,"_26008":49950,"_2720":50095},[],"New certificates, current slot and previous identity's state before retrying.",{"_3227":1219,"_28586":1167,"_19790":50097,"_5":13558,"_26008":49954,"_2720":50098},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3227":1220,"_28586":1167,"_19790":50100,"_5":13558,"_26008":49954,"_2720":50101},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3227":1221,"_28586":1167,"_19790":50103,"_5":13558,"_26008":49957,"_2720":50104},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3227":1222,"_28586":1167,"_19790":50106,"_5":13558,"_26008":49957,"_2720":50107},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3227":1223,"_28586":1167,"_19790":50109,"_5":13558,"_26008":49957,"_2720":50110},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3227":1224,"_28586":1167,"_19790":50112,"_5":13558,"_26008":49957,"_2720":50113},[],"Make one request, save headers/body and query the device and certificates.",{"_3227":1225,"_28586":1167,"_19790":50115,"_5":13558,"_26008":49957,"_2720":50116},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3227":1226,"_28586":1167,"_19790":50118,"_5":13558,"_26008":49957,"_2720":50119},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3227":1227,"_28586":1167,"_19790":50121,"_5":13558,"_26008":49957,"_2720":50122},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3227":1228,"_28586":1228,"_5":13916,"_2720":50124,"_28908":50125,"_19790":50126,"_26008":1228},"Trust distribution and updates",[46300,47749,48757,48755,48938],[],{"_3227":1229,"_28586":1228,"_19790":50128,"_5":13558,"_26008":1228,"_2720":50129},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3227":1230,"_28586":1228,"_5":28905,"_19790":50131,"_26008":50132,"_2720":50133},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3227":1231,"_28586":1228,"_5":28905,"_19790":50135,"_26008":50136,"_2720":50137},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3227":1232,"_28586":1228,"_5":28905,"_19790":50139,"_26008":50140,"_2720":50141},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3227":1233,"_28586":1228,"_5":28905,"_19790":50143,"_26008":50144,"_2720":50145},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3227":1234,"_28586":1228,"_5":28905,"_19790":50147,"_26008":50148,"_2720":50149},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3227":1235,"_28586":1228,"_19790":50151,"_5":13558,"_26008":1228,"_2720":50152},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3227":1236,"_28586":1228,"_19790":50154,"_5":13558,"_26008":50132,"_2720":50155},[],"Relationship",{"_3227":1237,"_28586":1228,"_19790":50157,"_5":13558,"_26008":50132,"_2720":50158},[],"Material prepared by its owner",{"_3227":1238,"_28586":1228,"_19790":50160,"_5":13558,"_26008":50132,"_2720":50161},[],"Device → EST server",{"_3227":1239,"_28586":1228,"_19790":50163,"_5":13558,"_26008":50132,"_2720":50164},[],"Previously verified server root, chain or pin and TLS name.",{"_3227":1240,"_28586":1228,"_19790":50166,"_5":13558,"_26008":50132,"_2720":50167},[],"DMS → requester",{"_3227":1241,"_28586":1228,"_19790":50169,"_5":13558,"_26008":50132,"_2720":50170},[],"CAs and rules authorizing initial or renewal credentials.",{"_3227":1242,"_28586":1228,"_19790":50172,"_5":13558,"_26008":50132,"_2720":50173},[],"Consumer → device",{"_3227":1243,"_28586":1228,"_19790":50175,"_5":13558,"_26008":50132,"_2720":50176},[],"Operational identity roots, intermediates, validation and permissions.",{"_3227":1244,"_28586":1228,"_19790":50178,"_5":13558,"_26008":50132,"_2720":50179},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3227":1245,"_28586":1228,"_19790":50181,"_5":13558,"_26008":50136,"_2720":50182},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3227":1246,"_28586":1228,"_19790":50184,"_5":13558,"_26008":50136,"_2720":50185},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3227":1247,"_28586":1228,"_19790":50187,"_5":13558,"_26008":50140,"_2720":50188},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3227":1248,"_28586":1228,"_19790":50190,"_5":13558,"_26008":50140,"_2720":50191},[],"Select policy-approved roots as anchors.",{"_3227":1249,"_28586":1228,"_19790":50193,"_5":13558,"_26008":50140,"_2720":50194},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3227":1250,"_28586":1228,"_19790":50196,"_5":13558,"_26008":50140,"_2720":50197},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3227":1251,"_28586":1228,"_19790":50199,"_5":13558,"_26008":50140,"_2720":50200},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3227":1252,"_28586":1228,"_19790":50202,"_5":13558,"_26008":50140,"_2720":50203},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3227":1253,"_28586":1228,"_19790":50205,"_5":13558,"_26008":50144,"_2720":50206},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3227":1254,"_28586":1228,"_19790":50208,"_5":13558,"_26008":50144,"_2720":50209},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3227":1255,"_28586":1228,"_19790":50211,"_5":13558,"_26008":50144,"_2720":50212},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3227":1256,"_28586":1228,"_19790":50214,"_5":13558,"_26008":50148,"_2720":50215},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3227":1257,"_28586":1257,"_5":13916,"_2720":50217,"_28908":50218,"_19790":50220,"_26008":1257},"AWS IoT Core",[46300,47749,48757,48755,50219],"Integrations",[],{"_3227":1258,"_28586":1257,"_19790":50222,"_5":13558,"_26008":1257,"_2720":50223},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3227":1259,"_28586":1257,"_5":28905,"_19790":50225,"_26008":50226,"_2720":50227},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3227":1260,"_28586":1257,"_5":28905,"_19790":50229,"_26008":50230,"_2720":50231},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3227":1261,"_28586":1257,"_5":28905,"_19790":50233,"_26008":50234,"_2720":50235},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3227":1262,"_28586":1257,"_5":28905,"_19790":50237,"_26008":50238,"_2720":50239},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3227":1263,"_28586":1257,"_5":28905,"_19790":50241,"_26008":50242,"_2720":50243},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3227":1264,"_28586":1257,"_5":28905,"_19790":50245,"_26008":50246,"_2720":50247},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3227":1265,"_28586":1257,"_5":28905,"_19790":50249,"_26008":50250,"_2720":50251},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3227":1266,"_28586":1257,"_5":28905,"_19790":50253,"_26008":50254,"_2720":50255},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3227":1267,"_28586":1257,"_5":28905,"_19790":50257,"_26008":50258,"_2720":50259},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3227":1268,"_28586":1257,"_5":28905,"_19790":50261,"_26008":50262,"_2720":50263},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3227":1269,"_28586":1257,"_5":28905,"_19790":50265,"_26008":50266,"_2720":50267},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3227":1270,"_28586":1257,"_5":28905,"_19790":50269,"_26008":50270,"_2720":50271},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3227":1271,"_28586":1257,"_5":28905,"_19790":50273,"_26008":50274,"_2720":50275},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3227":1272,"_28586":1257,"_5":28905,"_19790":50277,"_26008":50278,"_2720":50279},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3227":1273,"_28586":1257,"_5":28905,"_19790":50281,"_26008":50282,"_2720":50283},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3227":1274,"_28586":1257,"_5":28905,"_19790":50285,"_26008":50286,"_2720":50287},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3227":1275,"_28586":1257,"_5":28905,"_19790":50289,"_26008":50290,"_2720":50291},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3227":1276,"_28586":1257,"_5":28905,"_19790":50293,"_26008":50294,"_2720":50295},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3227":1277,"_28586":1257,"_5":28905,"_19790":50297,"_26008":50298,"_2720":50299},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3227":1278,"_28586":1257,"_5":28905,"_19790":50301,"_26008":50302,"_2720":50303},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3227":1279,"_28586":1257,"_19790":50305,"_5":13558,"_26008":1257,"_2720":50306},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3227":1280,"_28586":1257,"_19790":50308,"_5":13558,"_26008":1257,"_2720":50309},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3227":1281,"_28586":1257,"_19790":50311,"_5":13558,"_26008":1257,"_2720":50312},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3227":1282,"_28586":1257,"_19790":50314,"_5":13558,"_26008":50226,"_2720":50315},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3227":1283,"_28586":1257,"_19790":50317,"_5":13558,"_26008":50226,"_2720":50318},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3227":1284,"_28586":1257,"_19790":50320,"_5":13558,"_26008":50226,"_2720":50321},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3227":1285,"_28586":1257,"_19790":50323,"_5":13558,"_26008":50226,"_2720":50324},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3227":1286,"_28586":1257,"_19790":50326,"_5":13558,"_26008":50230,"_2720":50327},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3227":1287,"_28586":1257,"_19790":50329,"_5":13558,"_26008":50234,"_2720":50330},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3227":1288,"_28586":1257,"_19790":50332,"_5":13558,"_26008":50234,"_2720":50333},[],"IAM action",{"_3227":1289,"_28586":1257,"_19790":50335,"_5":13558,"_26008":50234,"_2720":46690},[],{"_3227":1290,"_28586":1257,"_19790":50337,"_5":13558,"_26008":50234,"_2720":50338},[],"`iot:GetRegistrationCode`",{"_3227":1291,"_28586":1257,"_19790":50340,"_5":13558,"_26008":50234,"_2720":50341},[],"Obtain the verification code for CA registration in the Primary Account",{"_3227":1292,"_28586":1257,"_19790":50343,"_5":13558,"_26008":50234,"_2720":50344},[],"`iot:RegisterCACertificate`",{"_3227":1293,"_28586":1257,"_19790":50346,"_5":13558,"_26008":50234,"_2720":50347},[],"Register the CA in AWS IoT",{"_3227":1294,"_28586":1257,"_19790":50349,"_5":13558,"_26008":50234,"_2720":50350},[],"`iot:DescribeCACertificate`",{"_3227":1295,"_28586":1257,"_19790":50352,"_5":13558,"_26008":50234,"_2720":50353},[],"Check the CA registration status",{"_3227":1296,"_28586":1257,"_19790":50355,"_5":13558,"_26008":50234,"_2720":50356},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3227":1297,"_28586":1257,"_19790":50358,"_5":13558,"_26008":50234,"_2720":50359},[],"Create or update Things in IoT Core",{"_3227":1298,"_28586":1257,"_19790":50361,"_5":13558,"_26008":50234,"_2720":50362},[],"`iot:RegisterThing`",{"_3227":1299,"_28586":1257,"_19790":50364,"_5":13558,"_26008":50234,"_2720":50365},[],"Provision Things through a template",{"_3227":1300,"_28586":1257,"_19790":50367,"_5":13558,"_26008":50234,"_2720":50368},[],"`iot:RegisterCertificate`",{"_3227":1301,"_28586":1257,"_19790":50370,"_5":13558,"_26008":50234,"_2720":50371},[],"Register device certificates",{"_3227":1302,"_28586":1257,"_19790":50373,"_5":13558,"_26008":50234,"_2720":50374},[],"`iot:UpdateCertificate`",{"_3227":1303,"_28586":1257,"_19790":50376,"_5":13558,"_26008":50234,"_2720":50377},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3227":1304,"_28586":1257,"_19790":50379,"_5":13558,"_26008":50234,"_2720":50380},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3227":1305,"_28586":1257,"_19790":50382,"_5":13558,"_26008":50234,"_2720":50383},[],"Create and attach IoT policies",{"_3227":1306,"_28586":1257,"_19790":50385,"_5":13558,"_26008":50234,"_2720":50386},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3227":1307,"_28586":1257,"_19790":50388,"_5":13558,"_26008":50234,"_2720":50389},[],"Manage Thing groups",{"_3227":1308,"_28586":1257,"_19790":50391,"_5":13558,"_26008":50234,"_2720":50392},[],"`iot:CreateProvisioningTemplate`",{"_3227":1309,"_28586":1257,"_19790":50394,"_5":13558,"_26008":50234,"_2720":50395},[],"Create JITP templates",{"_3227":1310,"_28586":1257,"_19790":50397,"_5":13558,"_26008":50234,"_2720":50398},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3227":1311,"_28586":1257,"_19790":50400,"_5":13558,"_26008":50234,"_2720":50401},[],"Read and write the Device Shadow",{"_3227":1312,"_28586":1257,"_19790":50403,"_5":13558,"_26008":50234,"_2720":50404},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3227":1313,"_28586":1257,"_19790":50406,"_5":13558,"_26008":50238,"_2720":50407},[],"Parameter",{"_3227":1314,"_28586":1257,"_19790":50409,"_5":13558,"_26008":50238,"_2720":50410},[],"Type",{"_3227":1315,"_28586":1257,"_19790":50412,"_5":13558,"_26008":50238,"_2720":50413},[],"Required",{"_3227":1316,"_28586":1257,"_19790":50415,"_5":13558,"_26008":50238,"_2720":50416},[],"Description",{"_3227":1317,"_28586":1257,"_19790":50418,"_5":13558,"_26008":50238,"_2720":50419},[],"`connector_id`",{"_3227":1318,"_28586":1257,"_19790":50421,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1319,"_28586":1257,"_19790":50423,"_5":13558,"_26008":50238,"_2720":50424},[],"Yes",{"_3227":1320,"_28586":1257,"_19790":50426,"_5":13558,"_26008":50238,"_2720":50427},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3227":1321,"_28586":1257,"_19790":50429,"_5":13558,"_26008":50238,"_2720":50430},[],"`aws_config.region`",{"_3227":1322,"_28586":1257,"_19790":50432,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1323,"_28586":1257,"_19790":50434,"_5":13558,"_26008":50238,"_2720":50424},[],{"_3227":1324,"_28586":1257,"_19790":50436,"_5":13558,"_26008":50238,"_2720":50437},[],"AWS region where the connector operates.",{"_3227":1325,"_28586":1257,"_19790":50439,"_5":13558,"_26008":50238,"_2720":50440},[],"`aws_config.auth_method`",{"_3227":1326,"_28586":1257,"_19790":50442,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1327,"_28586":1257,"_19790":50444,"_5":13558,"_26008":50238,"_2720":50424},[],{"_3227":1328,"_28586":1257,"_19790":50446,"_5":13558,"_26008":50238,"_2720":50447},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3227":1329,"_28586":1257,"_19790":50449,"_5":13558,"_26008":50238,"_2720":50450},[],"`aws_config.access_key_id`",{"_3227":1330,"_28586":1257,"_19790":50452,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1331,"_28586":1257,"_19790":50454,"_5":13558,"_26008":50238,"_2720":50455},[],"Only with `auth_method=static`",{"_3227":1332,"_28586":1257,"_19790":50457,"_5":13558,"_26008":50238,"_2720":50458},[],"AWS access key.",{"_3227":1333,"_28586":1257,"_19790":50460,"_5":13558,"_26008":50238,"_2720":50461},[],"`aws_config.secret_access_key`",{"_3227":1334,"_28586":1257,"_19790":50463,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1335,"_28586":1257,"_19790":50465,"_5":13558,"_26008":50238,"_2720":50455},[],{"_3227":1336,"_28586":1257,"_19790":50467,"_5":13558,"_26008":50238,"_2720":50468},[],"AWS secret key.",{"_3227":1337,"_28586":1257,"_19790":50470,"_5":13558,"_26008":50238,"_2720":50471},[],"`aws_config.session_token`",{"_3227":1338,"_28586":1257,"_19790":50473,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1339,"_28586":1257,"_19790":50475,"_5":13558,"_26008":50238,"_2720":50476},[],"No",{"_3227":1340,"_28586":1257,"_19790":50478,"_5":13558,"_26008":50238,"_2720":50479},[],"Session token (with `auth_method=static`).",{"_3227":1341,"_28586":1257,"_19790":50481,"_5":13558,"_26008":50238,"_2720":50482},[],"`aws_config.role_arn`",{"_3227":1342,"_28586":1257,"_19790":50484,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1343,"_28586":1257,"_19790":50486,"_5":13558,"_26008":50238,"_2720":50487},[],"Only with `auth_method=role`",{"_3227":1344,"_28586":1257,"_19790":50489,"_5":13558,"_26008":50238,"_2720":50490},[],"ARN of the role to assume.",{"_3227":1345,"_28586":1257,"_19790":50492,"_5":13558,"_26008":50238,"_2720":50493},[],"`aws_config.endpoint_url`",{"_3227":1346,"_28586":1257,"_19790":50495,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1347,"_28586":1257,"_19790":50497,"_5":13558,"_26008":50238,"_2720":50476},[],{"_3227":1348,"_28586":1257,"_19790":50499,"_5":13558,"_26008":50238,"_2720":50500},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3227":1349,"_28586":1257,"_19790":50502,"_5":13558,"_26008":50238,"_2720":50503},[],"`subscriber_event_bus`",{"_3227":1350,"_28586":1257,"_19790":50505,"_5":13558,"_26008":50238,"_2720":16655},[],{"_3227":1351,"_28586":1257,"_19790":50507,"_5":13558,"_26008":50238,"_2720":50424},[],{"_3227":1352,"_28586":1257,"_19790":50509,"_5":13558,"_26008":50238,"_2720":50510},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3227":1353,"_28586":1257,"_19790":50512,"_5":13558,"_26008":50238,"_2720":50513},[],"`dms_manager_client`",{"_3227":1354,"_28586":1257,"_19790":50515,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1355,"_28586":1257,"_19790":50517,"_5":13558,"_26008":50238,"_2720":50424},[],{"_3227":1356,"_28586":1257,"_19790":50519,"_5":13558,"_26008":50238,"_2720":50520},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3227":1357,"_28586":1257,"_19790":50522,"_5":13558,"_26008":50238,"_2720":50523},[],"`device_manager_client`",{"_3227":1358,"_28586":1257,"_19790":50525,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1359,"_28586":1257,"_19790":50527,"_5":13558,"_26008":50238,"_2720":50424},[],{"_3227":1360,"_28586":1257,"_19790":50529,"_5":13558,"_26008":50238,"_2720":50530},[],"HTTP URL of Lamassu's Device Manager.",{"_3227":1361,"_28586":1257,"_19790":50532,"_5":13558,"_26008":50238,"_2720":50533},[],"`ca_client`",{"_3227":1362,"_28586":1257,"_19790":50535,"_5":13558,"_26008":50238,"_2720":23659},[],{"_3227":1363,"_28586":1257,"_19790":50537,"_5":13558,"_26008":50238,"_2720":50424},[],{"_3227":1364,"_28586":1257,"_19790":50539,"_5":13558,"_26008":50238,"_2720":50540},[],"HTTP URL of Lamassu's CA service.",{"_3227":1365,"_28586":1257,"_19790":50542,"_5":13558,"_26008":50242,"_2720":50543},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3227":1366,"_28586":1257,"_19790":50545,"_5":13558,"_26008":50246,"_2720":50546},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3227":1367,"_28586":1257,"_19790":50548,"_5":13558,"_26008":50246,"_2720":50549},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3227":1368,"_28586":1257,"_19790":50551,"_5":13558,"_26008":50250,"_2720":50552},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3227":1369,"_28586":1257,"_19790":50554,"_5":13558,"_26008":50250,"_2720":50555},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3227":1370,"_28586":1257,"_19790":50557,"_5":13558,"_26008":50250,"_2720":50558},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3227":1371,"_28586":1257,"_19790":50560,"_5":13558,"_26008":50250,"_2720":50561},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3227":1372,"_28586":1257,"_19790":50563,"_5":13558,"_26008":50250,"_2720":50564},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3227":1373,"_28586":1257,"_19790":50566,"_5":13558,"_26008":50250,"_2720":50567},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3227":1374,"_28586":1257,"_19790":50569,"_5":13558,"_26008":50254,"_2720":50570},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3227":1375,"_28586":1257,"_19790":50572,"_5":13558,"_26008":50258,"_2720":50573},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3227":1376,"_28586":1257,"_19790":50575,"_5":13558,"_26008":50258,"_2720":50576},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3227":1377,"_28586":1257,"_19790":50578,"_5":13558,"_26008":50262,"_2720":50579},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3227":1378,"_28586":1257,"_19790":50581,"_5":13558,"_26008":50266,"_2720":50582},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3227":1379,"_28586":1257,"_19790":50584,"_5":13558,"_26008":50266,"_2720":50585},[],"Creates or updates the IoT policies configured in the DMS.",{"_3227":1380,"_28586":1257,"_19790":50587,"_5":13558,"_26008":50266,"_2720":50588},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3227":1381,"_28586":1257,"_19790":50590,"_5":13558,"_26008":50266,"_2720":50591},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3227":1382,"_28586":1257,"_19790":50593,"_5":13558,"_26008":50266,"_2720":50594},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3227":1383,"_28586":1257,"_19790":50596,"_5":13558,"_26008":50266,"_2720":50597},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3227":1384,"_28586":1257,"_19790":50599,"_5":13558,"_26008":50266,"_2720":50600},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3227":1385,"_28586":1257,"_19790":50602,"_5":13558,"_26008":50270,"_2720":50603},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The template is created when the DMS is created in Lamassu, not at device enrollment, and it is not updated afterwards (see the notice below). From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3227":1386,"_28586":1257,"_19790":50605,"_5":13558,"_26008":50270,"_2720":50606},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3227":1387,"_28586":1257,"_19790":50608,"_5":13558,"_26008":50270,"_2720":50609},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3227":1388,"_28586":1257,"_19790":50611,"_5":13558,"_26008":50270,"_2720":50612},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3227":1389,"_28586":1257,"_19790":50614,"_5":13558,"_26008":50270,"_2720":50615},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3227":1390,"_28586":1257,"_19790":50617,"_5":13558,"_26008":50274,"_2720":50618},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3227":1391,"_28586":1257,"_19790":50620,"_5":13558,"_26008":50274,"_2720":50621},[],"The full flow from the device's perspective is:",{"_3227":1392,"_28586":1257,"_19790":50623,"_5":13558,"_26008":50274,"_2720":50624},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3227":1393,"_28586":1257,"_19790":50626,"_5":13558,"_26008":50278,"_2720":50627},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3227":1394,"_28586":1257,"_19790":50629,"_5":13558,"_26008":50278,"_2720":50630},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3227":1395,"_28586":1257,"_19790":50632,"_5":13558,"_26008":50278,"_2720":50633},[],"For the JITP flow to work correctly:",{"_3227":1396,"_28586":1257,"_19790":50635,"_5":13558,"_26008":50278,"_2720":50636},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3227":1397,"_28586":1257,"_19790":50638,"_5":13558,"_26008":50278,"_2720":50639},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3227":1398,"_28586":1257,"_19790":50641,"_5":13558,"_26008":50278,"_2720":50642},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3227":1399,"_28586":1257,"_19790":50644,"_5":13558,"_26008":50278,"_2720":50645},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3227":1400,"_28586":1257,"_19790":50647,"_5":13558,"_26008":50282,"_2720":50648},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3227":1401,"_28586":1257,"_19790":50650,"_5":13558,"_26008":50282,"_2720":50651},[],"Status in Lamassu",{"_3227":1402,"_28586":1257,"_19790":50653,"_5":13558,"_26008":50282,"_2720":50654},[],"Revocation reason",{"_3227":1403,"_28586":1257,"_19790":50656,"_5":13558,"_26008":50282,"_2720":50657},[],"Status in AWS IoT Core",{"_3227":1404,"_28586":1257,"_19790":50659,"_5":13558,"_26008":50282,"_2720":50660},[],"`Active`",{"_3227":1405,"_28586":1257,"_19790":50662,"_5":13558,"_26008":50282,"_2720":50663},[],"None",{"_3227":1406,"_28586":1257,"_19790":50665,"_5":13558,"_26008":50282,"_2720":50666},[],"`ACTIVE`",{"_3227":1407,"_28586":1257,"_19790":50668,"_5":13558,"_26008":50282,"_2720":50669},[],"`Revoked`",{"_3227":1408,"_28586":1257,"_19790":50671,"_5":13558,"_26008":50282,"_2720":50672},[],"`certificateHold`",{"_3227":1409,"_28586":1257,"_19790":50674,"_5":13558,"_26008":50282,"_2720":50675},[],"`INACTIVE`",{"_3227":1410,"_28586":1257,"_19790":50677,"_5":13558,"_26008":50282,"_2720":50669},[],{"_3227":1411,"_28586":1257,"_19790":50679,"_5":13558,"_26008":50282,"_2720":50680},[],"Any other reason",{"_3227":1412,"_28586":1257,"_19790":50682,"_5":13558,"_26008":50282,"_2720":50683},[],"`REVOKED`",{"_3227":1413,"_28586":1257,"_19790":50685,"_5":13558,"_26008":50282,"_2720":50686},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3227":1414,"_28586":1257,"_19790":50688,"_5":13558,"_26008":50286,"_2720":50689},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3227":1415,"_28586":1257,"_19790":50691,"_5":13558,"_26008":50286,"_2720":50692},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3227":1416,"_28586":1257,"_19790":50694,"_5":13558,"_26008":50286,"_2720":50695},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3227":1417,"_28586":1257,"_19790":50697,"_5":13558,"_26008":50290,"_2720":50698},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3227":1418,"_28586":1257,"_19790":50700,"_5":13558,"_26008":50290,"_2720":50701},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3227":1419,"_28586":1257,"_19790":50703,"_5":13558,"_26008":50294,"_2720":50704},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3227":1420,"_28586":1257,"_19790":50706,"_5":13558,"_26008":50294,"_2720":50707},[],"There are two action types:",{"_3227":1421,"_28586":1257,"_19790":50709,"_5":13558,"_26008":50294,"_2720":50710},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3227":1422,"_28586":1257,"_19790":50712,"_5":13558,"_26008":50294,"_2720":50713},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3227":1423,"_28586":1257,"_19790":50715,"_5":13558,"_26008":50294,"_2720":50716},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3227":1424,"_28586":1257,"_19790":50718,"_5":13558,"_26008":50298,"_2720":50719},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3227":1425,"_28586":1257,"_19790":50721,"_5":13558,"_26008":50298,"_2720":50722},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3227":1426,"_28586":1257,"_19790":50724,"_5":13558,"_26008":50298,"_2720":50725},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3227":1427,"_28586":1257,"_19790":50727,"_5":13558,"_26008":50302,"_2720":50728},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3227":1428,"_28586":1257,"_19790":50730,"_5":13558,"_26008":50302,"_2720":50731},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3227":1429,"_28586":1257,"_19790":50733,"_5":13558,"_26008":50302,"_2720":50734},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3227":1430,"_28586":1257,"_19790":50736,"_5":13558,"_26008":50302,"_2720":50737},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3227":1431,"_28586":1257,"_19790":50739,"_5":13558,"_26008":50302,"_2720":50740},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3227":1432,"_28586":1257,"_19790":50742,"_5":13558,"_26008":50302,"_2720":50743},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3227":1433,"_28586":1257,"_19790":50745,"_5":13558,"_26008":50302,"_2720":50746},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3227":1434,"_28586":1257,"_19790":50748,"_5":13558,"_26008":50302,"_2720":50749},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3227":1435,"_28586":1257,"_19790":50751,"_5":13558,"_26008":50302,"_2720":50752},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3227":1436,"_28586":1257,"_19790":50754,"_5":13558,"_26008":50302,"_2720":50755},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3227":1437,"_28586":1257,"_19790":50757,"_5":13558,"_26008":50302,"_2720":50758},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3227":1438,"_28586":1257,"_19790":50760,"_5":13558,"_26008":50302,"_2720":50761},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3227":1439,"_28586":1257,"_19790":50763,"_5":13558,"_26008":50302,"_2720":50764},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3227":1440,"_28586":1257,"_19790":50766,"_5":13558,"_26008":50302,"_2720":50767},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3227":1441,"_28586":1257,"_19790":50769,"_5":13558,"_26008":50302,"_2720":50770},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3227":1442,"_28586":1257,"_19790":50772,"_5":13558,"_26008":50302,"_2720":50773},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3227":1443,"_28586":1257,"_19790":50775,"_5":13558,"_26008":50302,"_2720":50776},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3227":1444,"_28586":1257,"_19790":50778,"_5":13558,"_26008":50302,"_2720":50779},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3227":1445,"_28586":1257,"_19790":50781,"_5":13558,"_26008":50302,"_2720":50782},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3227":1446,"_28586":1257,"_19790":50784,"_5":13558,"_26008":50302,"_2720":50785},[],"**Cause:** The edit triggers a new attempt to create the JITP template, which already exists in AWS. The attempt fails and the connector's later steps are skipped.",{"_3227":1447,"_28586":1257,"_19790":50787,"_5":13558,"_26008":50302,"_2720":50788},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3227":1448,"_28586":1257,"_19790":50790,"_5":13558,"_26008":50302,"_2720":50791},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":1449,"_28586":1257,"_19790":50793,"_5":13558,"_26008":50302,"_2720":50794},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3227":1450,"_28586":1257,"_19790":50796,"_5":13558,"_26008":50302,"_2720":50797},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3227":1451,"_28586":1451,"_5":13916,"_2720":48757,"_28908":50799,"_19790":50800,"_26008":1451},[46300,47749,48757],[],{"_3227":1452,"_28586":1451,"_19790":50802,"_5":13558,"_26008":1451,"_2720":50803},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3227":1453,"_28586":1451,"_5":28905,"_19790":50805,"_26008":50806,"_2720":50807},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3227":1454,"_28586":1451,"_5":28905,"_19790":50809,"_26008":50810,"_2720":48755},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3227":1455,"_28586":1451,"_5":28905,"_19790":50812,"_26008":50813,"_2720":48938},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3227":1456,"_28586":1451,"_5":28905,"_19790":50815,"_26008":50816,"_2720":50219},[],"/docs/platform/iot-fleets/overview#integrations",{"_3227":1457,"_28586":1451,"_5":28905,"_19790":50818,"_26008":50819,"_2720":50820},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3227":1458,"_28586":1451,"_19790":50822,"_5":13558,"_26008":1451,"_2720":50823},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3227":1459,"_28586":1451,"_19790":50825,"_5":13558,"_26008":50806,"_2720":50826},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3227":1460,"_28586":1451,"_19790":50828,"_5":13558,"_26008":50806,"_2720":50829},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3227":1461,"_28586":1451,"_19790":50831,"_5":13558,"_26008":50810,"_2720":50832},[],"Resource",{"_3227":1462,"_28586":1451,"_19790":50834,"_5":13558,"_26008":50810,"_2720":50835},[],"What it represents",{"_3227":1463,"_28586":1451,"_19790":50837,"_5":13558,"_26008":50810,"_2720":50838},[],"**Device**",{"_3227":1464,"_28586":1451,"_19790":50840,"_5":13558,"_26008":50810,"_2720":50841},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3227":1465,"_28586":1451,"_19790":50843,"_5":13558,"_26008":50810,"_2720":50844},[],"**Identity**",{"_3227":1466,"_28586":1451,"_19790":50846,"_5":13558,"_26008":50810,"_2720":50847},[],"The device's association with its certificates: an active version and a history.",{"_3227":1467,"_28586":1451,"_19790":50849,"_5":13558,"_26008":50810,"_2720":50850},[],"**DMS**",{"_3227":1468,"_28586":1451,"_19790":50852,"_5":13558,"_26008":50810,"_2720":50853},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3227":1469,"_28586":1451,"_19790":50855,"_5":13558,"_26008":50810,"_2720":50856},[],"**Fleet**",{"_3227":1470,"_28586":1451,"_19790":50858,"_5":13558,"_26008":50810,"_2720":50859},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3227":1471,"_28586":1451,"_19790":50861,"_5":13558,"_26008":50810,"_2720":50862},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3227":1472,"_28586":1451,"_19790":50864,"_5":13558,"_26008":50810,"_2720":50865},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3227":1473,"_28586":1451,"_19790":50867,"_5":13558,"_26008":50813,"_2720":50868},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3227":1474,"_28586":1451,"_19790":50870,"_5":13558,"_26008":50813,"_2720":50871},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3227":1475,"_28586":1451,"_19790":50873,"_5":13558,"_26008":50813,"_2720":50874},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3227":1476,"_28586":1451,"_19790":50876,"_5":13558,"_26008":50813,"_2720":50877},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3227":1477,"_28586":1451,"_19790":50879,"_5":13558,"_26008":50813,"_2720":50880},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3227":1478,"_28586":1451,"_19790":50882,"_5":13558,"_26008":50813,"_2720":50883},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3227":1479,"_28586":1451,"_19790":50885,"_5":13558,"_26008":50813,"_2720":50886},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":1480,"_28586":1451,"_19790":50888,"_5":13558,"_26008":50813,"_2720":50889},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3227":1481,"_28586":1451,"_19790":50891,"_5":13558,"_26008":50816,"_2720":50892},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3227":1482,"_28586":1451,"_19790":50894,"_5":13558,"_26008":50816,"_2720":50895},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3227":1483,"_28586":1451,"_19790":50897,"_5":13558,"_26008":50819,"_2720":50898},[],"Participant",{"_3227":1484,"_28586":1451,"_19790":50900,"_5":13558,"_26008":50819,"_2720":50901},[],"Responsibility",{"_3227":1485,"_28586":1451,"_19790":50903,"_5":13558,"_26008":50819,"_2720":50904},[],"PKI administrator",{"_3227":1486,"_28586":1451,"_19790":50906,"_5":13558,"_26008":50819,"_2720":50907},[],"CA, issuance profile, chain and revocation publication.",{"_3227":1487,"_28586":1451,"_19790":50909,"_5":13558,"_26008":50819,"_2720":50910},[],"Provisioning administrator",{"_3227":1488,"_28586":1451,"_19790":50912,"_5":13558,"_26008":50819,"_2720":50913},[],"DMS, admission, authentication per operation and inventory.",{"_3227":1489,"_28586":1451,"_19790":50915,"_5":13558,"_26008":50819,"_2720":50916},[],"Device integrator",{"_3227":1490,"_28586":1451,"_19790":50918,"_5":13558,"_26008":50819,"_2720":50919},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3227":1491,"_28586":1451,"_19790":50921,"_5":13558,"_26008":50819,"_2720":50922},[],"Consumer integrator",{"_3227":1492,"_28586":1451,"_19790":50924,"_5":13558,"_26008":50819,"_2720":50925},[],"Trusted issuers, validation and device permissions in the destination.",{"_3227":1493,"_28586":1451,"_19790":50927,"_5":13558,"_26008":50819,"_2720":50928},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3227":1494,"_28586":1494,"_5":13916,"_2720":50930,"_28908":50931,"_19790":50933,"_26008":1494},"Enroll and connect your first device",[46300,47749,48757,50932],"Getting started",[],{"_3227":1495,"_28586":1494,"_19790":50935,"_5":13558,"_26008":1494,"_2720":50936},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3227":1496,"_28586":1494,"_5":28905,"_19790":50938,"_26008":50939,"_2720":46310},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3227":1497,"_28586":1494,"_5":28905,"_19790":50941,"_26008":50942,"_2720":50943},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3227":1498,"_28586":1494,"_5":28905,"_19790":50945,"_26008":50946,"_2720":50947},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3227":1499,"_28586":1494,"_5":28905,"_19790":50949,"_26008":50950,"_2720":50951},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3227":1500,"_28586":1494,"_5":28905,"_19790":50953,"_26008":50954,"_2720":50955},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3227":1501,"_28586":1494,"_5":28905,"_19790":50957,"_26008":50958,"_2720":50959},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3227":1502,"_28586":1494,"_5":28905,"_19790":50961,"_26008":50962,"_2720":50963},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3227":1503,"_28586":1494,"_5":28905,"_19790":50965,"_26008":50966,"_2720":50967},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3227":1504,"_28586":1494,"_19790":50969,"_5":13558,"_26008":1494,"_2720":50970},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3227":1505,"_28586":1494,"_19790":50972,"_5":13558,"_26008":50939,"_2720":50973},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3227":1506,"_28586":1494,"_19790":50975,"_5":13558,"_26008":50939,"_2720":50976},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3227":1507,"_28586":1494,"_19790":50978,"_5":13558,"_26008":50939,"_2720":50979},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3227":1508,"_28586":1494,"_19790":50981,"_5":13558,"_26008":50939,"_2720":50982},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3227":1509,"_28586":1494,"_19790":50984,"_5":13558,"_26008":50939,"_2720":50985},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3227":1510,"_28586":1494,"_19790":50987,"_5":13558,"_26008":50942,"_2720":50988},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3227":1511,"_28586":1494,"_19790":50990,"_5":13558,"_26008":50942,"_2720":50991},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3227":1512,"_28586":1494,"_19790":50993,"_5":13558,"_26008":50946,"_2720":50994},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3227":1513,"_28586":1494,"_19790":50996,"_5":13558,"_26008":50946,"_2720":50997},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3227":1514,"_28586":1494,"_19790":50999,"_5":13558,"_26008":50946,"_2720":51000},[],"Setting",{"_3227":1515,"_28586":1494,"_19790":51002,"_5":13558,"_26008":50946,"_2720":51003},[],"Evaluation value",{"_3227":1516,"_28586":1494,"_19790":51005,"_5":13558,"_26008":50946,"_2720":51006},[],"Enrollment CA",{"_3227":1517,"_28586":1494,"_19790":51008,"_5":13558,"_26008":50946,"_2720":51009},[],"Issuing root from `device-root.pem`.",{"_3227":1518,"_28586":1494,"_19790":51011,"_5":13558,"_26008":50946,"_2720":49068},[],{"_3227":1519,"_28586":1494,"_19790":51013,"_5":13558,"_26008":50946,"_2720":51014},[],"The 1-hour leaf profile you just prepared.",{"_3227":1520,"_28586":1494,"_19790":51016,"_5":13558,"_26008":50946,"_2720":51017},[],"Protocol / Registration Mode",{"_3227":1521,"_28586":1494,"_19790":51019,"_5":13558,"_26008":50946,"_2720":51020},[],"`EST_RFC7030` / `JITP`.",{"_3227":1522,"_28586":1494,"_19790":51022,"_5":13558,"_26008":50946,"_2720":51023},[],"Verify CSR Signature",{"_3227":1523,"_28586":1494,"_19790":51025,"_5":13558,"_26008":50946,"_2720":51026},[],"Enabled.",{"_3227":1524,"_28586":1494,"_19790":51028,"_5":13558,"_26008":50946,"_2720":51029},[],"Enable Replaceable Enrollment",{"_3227":1525,"_28586":1494,"_19790":51031,"_5":13558,"_26008":50946,"_2720":51032},[],"Disabled; the ID must be new.",{"_3227":1526,"_28586":1494,"_19790":51034,"_5":13558,"_26008":50946,"_2720":51035},[],"Initial authentication",{"_3227":1527,"_28586":1494,"_19790":51037,"_5":13558,"_26008":50946,"_2720":51038},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3227":1528,"_28586":1494,"_19790":51040,"_5":13558,"_26008":50946,"_2720":51041},[],"Renewal authentication",{"_3227":1529,"_28586":1494,"_19790":51043,"_5":13558,"_26008":50946,"_2720":51044},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3227":1530,"_28586":1494,"_19790":51046,"_5":13558,"_26008":50946,"_2720":51047},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3227":1531,"_28586":1494,"_19790":51049,"_5":13558,"_26008":50946,"_2720":51050},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3227":1532,"_28586":1494,"_19790":51052,"_5":13558,"_26008":50946,"_2720":51053},[],"Re-enrollment Delta",{"_3227":1533,"_28586":1494,"_19790":51055,"_5":13558,"_26008":50946,"_2720":51056},[],"1 hour.",{"_3227":1534,"_28586":1494,"_19790":51058,"_5":13558,"_26008":50946,"_2720":51059},[],"Preventive / Critical Delta",{"_3227":1535,"_28586":1494,"_19790":51061,"_5":13558,"_26008":50946,"_2720":51062},[],"30 minutes / 10 minutes.",{"_3227":1536,"_28586":1494,"_19790":51064,"_5":13558,"_26008":50946,"_2720":51065},[],"Revoke on Re-enrollment",{"_3227":1537,"_28586":1494,"_19790":51067,"_5":13558,"_26008":50946,"_2720":51068},[],"Disabled to test the successor before retiring the previous identity.",{"_3227":1538,"_28586":1494,"_19790":51070,"_5":13558,"_26008":50946,"_2720":49076},[],{"_3227":1539,"_28586":1494,"_19790":51072,"_5":13558,"_26008":50946,"_2720":51073},[],"Disabled; the operational key is generated in the client.",{"_3227":1540,"_28586":1494,"_19790":51075,"_5":13558,"_26008":50946,"_2720":51076},[],"CA Distribution",{"_3227":1541,"_28586":1494,"_19790":51078,"_5":13558,"_26008":50946,"_2720":51079},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3227":1542,"_28586":1494,"_19790":51081,"_5":13558,"_26008":50946,"_2720":51082},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3227":1543,"_28586":1494,"_19790":51084,"_5":13558,"_26008":50950,"_2720":51085},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3227":1544,"_28586":1494,"_19790":51087,"_5":13558,"_26008":50950,"_2720":51088},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3227":1545,"_28586":1494,"_19790":51090,"_5":13558,"_26008":50954,"_2720":51091},[],"Generate a new key and CSR with the selected identifier:",{"_3227":1546,"_28586":1494,"_19790":51093,"_5":13558,"_26008":50954,"_2720":51094},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3227":1547,"_28586":1494,"_19790":51096,"_5":13558,"_26008":50954,"_2720":51097},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3227":1548,"_28586":1494,"_19790":51099,"_5":13558,"_26008":50958,"_2720":51100},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3227":1549,"_28586":1494,"_19790":51102,"_5":13558,"_26008":50958,"_2720":51103},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3227":1550,"_28586":1494,"_19790":51105,"_5":13558,"_26008":50962,"_2720":51106},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3227":1551,"_28586":1494,"_19790":51108,"_5":13558,"_26008":50962,"_2720":51109},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3227":1552,"_28586":1494,"_19790":51111,"_5":13558,"_26008":50962,"_2720":51112},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3227":1553,"_28586":1494,"_19790":51114,"_5":13558,"_26008":50962,"_2720":51115},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3227":1554,"_28586":1494,"_19790":51117,"_5":13558,"_26008":50962,"_2720":51118},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3227":1555,"_28586":1494,"_19790":51120,"_5":13558,"_26008":50966,"_2720":51121},[],"Check",{"_3227":1556,"_28586":1494,"_19790":51123,"_5":13558,"_26008":50966,"_2720":51124},[],"Expected result",{"_3227":1557,"_28586":1494,"_19790":51126,"_5":13558,"_26008":50966,"_2720":51127},[],"Registration",{"_3227":1558,"_28586":1494,"_19790":51129,"_5":13558,"_26008":50966,"_2720":51130},[],"ID created automatically and correct DMS.",{"_3227":1559,"_28586":1494,"_19790":51132,"_5":13558,"_26008":50966,"_2720":51133},[],"Certificate",{"_3227":1560,"_28586":1494,"_19790":51135,"_5":13558,"_26008":50966,"_2720":51136},[],"CN, profile, serial and key verified.",{"_3227":1561,"_28586":1494,"_19790":51138,"_5":13558,"_26008":50966,"_2720":51139},[],"Inventory",{"_3227":1562,"_28586":1494,"_19790":51141,"_5":13558,"_26008":50966,"_2720":51142},[],"Received serial visible as the current identity and in history.",{"_3227":1563,"_28586":1494,"_19790":51144,"_5":13558,"_26008":50966,"_2720":51145},[],"Consumer",{"_3227":1564,"_28586":1494,"_19790":51147,"_5":13558,"_26008":50966,"_2720":51148},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3227":1565,"_28586":1494,"_19790":51150,"_5":13558,"_26008":50966,"_2720":51151},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3227":1566,"_28586":1494,"_19790":51153,"_5":13558,"_26008":50966,"_2720":51154},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3227":1567,"_28586":1567,"_5":13916,"_2720":48773,"_28908":51156,"_19790":51157,"_26008":1567},[46300,47749,48757,50932],[],{"_3227":1568,"_28586":1567,"_19790":51159,"_5":13558,"_26008":1567,"_2720":51160},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3227":1569,"_28586":1567,"_5":28905,"_19790":51162,"_26008":51163,"_2720":46310},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3227":1570,"_28586":1567,"_5":28905,"_19790":51165,"_26008":51166,"_2720":51167},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3227":1571,"_28586":1567,"_5":28905,"_19790":51169,"_26008":51170,"_2720":51171},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3227":1572,"_28586":1567,"_5":28905,"_19790":51173,"_26008":51174,"_2720":51175},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3227":1573,"_28586":1567,"_5":28905,"_19790":51177,"_26008":51178,"_2720":51179},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3227":1574,"_28586":1567,"_5":28905,"_19790":51181,"_26008":51182,"_2720":51183},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3227":1575,"_28586":1567,"_5":28905,"_19790":51185,"_26008":51186,"_2720":51124},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3227":1576,"_28586":1567,"_5":28905,"_19790":51188,"_26008":51189,"_2720":51190},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3227":1577,"_28586":1567,"_5":28905,"_19790":51192,"_26008":51193,"_2720":51194},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3227":1578,"_28586":1567,"_19790":51196,"_5":13558,"_26008":1567,"_2720":51197},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3227":1579,"_28586":1567,"_19790":51199,"_5":13558,"_26008":1567,"_2720":51200},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3227":1580,"_28586":1567,"_19790":51202,"_5":13558,"_26008":51163,"_2720":51203},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3227":1581,"_28586":1567,"_19790":51205,"_5":13558,"_26008":51163,"_2720":51206},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3227":1582,"_28586":1567,"_19790":51208,"_5":13558,"_26008":51163,"_2720":51209},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3227":1583,"_28586":1567,"_19790":51211,"_5":13558,"_26008":51163,"_2720":51212},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3227":1584,"_28586":1567,"_19790":51214,"_5":13558,"_26008":51166,"_2720":51215},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3227":1585,"_28586":1567,"_19790":51217,"_5":13558,"_26008":51166,"_2720":51218},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3227":1586,"_28586":1567,"_19790":51220,"_5":13558,"_26008":51166,"_2720":51221},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3227":1587,"_28586":1567,"_19790":51223,"_5":13558,"_26008":51166,"_2720":51224},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3227":1588,"_28586":1567,"_19790":51226,"_5":13558,"_26008":51166,"_2720":51227},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3227":1589,"_28586":1567,"_19790":51229,"_5":13558,"_26008":51166,"_2720":51230},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3227":1590,"_28586":1567,"_19790":51232,"_5":13558,"_26008":51166,"_2720":51233},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3227":1591,"_28586":1567,"_19790":51235,"_5":13558,"_26008":51166,"_2720":51236},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3227":1592,"_28586":1567,"_19790":51238,"_5":13558,"_26008":51170,"_2720":51239},[],"Open **Managed Devices** and the registration action. Complete:",{"_3227":1593,"_28586":1567,"_19790":51241,"_5":13558,"_26008":51170,"_2720":51242},[],"**Device ID**: `device-001`.",{"_3227":1594,"_28586":1567,"_19790":51244,"_5":13558,"_26008":51170,"_2720":51245},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3227":1595,"_28586":1567,"_19790":51247,"_5":13558,"_26008":51170,"_2720":51248},[],"**Icon** and **Tags**: optional classification.",{"_3227":1596,"_28586":1567,"_19790":51250,"_5":13558,"_26008":51170,"_2720":51251},[],"Confirm registration.",{"_3227":1597,"_28586":1567,"_19790":51253,"_5":13558,"_26008":51174,"_2720":51254},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3227":1598,"_28586":1567,"_19790":51256,"_5":13558,"_26008":51174,"_2720":51257},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3227":1599,"_28586":1567,"_19790":51259,"_5":13558,"_26008":51178,"_2720":51260},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3227":1600,"_28586":1567,"_19790":51262,"_5":13558,"_26008":51178,"_2720":51263},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3227":1601,"_28586":1567,"_19790":51265,"_5":13558,"_26008":51182,"_2720":51266},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3227":1602,"_28586":1567,"_19790":51268,"_5":13558,"_26008":51182,"_2720":51269},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3227":1603,"_28586":1567,"_19790":51271,"_5":13558,"_26008":51186,"_2720":51121},[],{"_3227":1604,"_28586":1567,"_19790":51273,"_5":13558,"_26008":51186,"_2720":51274},[],"Result",{"_3227":1605,"_28586":1567,"_19790":51276,"_5":13558,"_26008":51186,"_2720":51277},[],"Device",{"_3227":1606,"_28586":1567,"_19790":51279,"_5":13558,"_26008":51186,"_2720":51280},[],"`device-001` appears in inventory with the expected DMS.",{"_3227":1607,"_28586":1567,"_19790":51282,"_5":13558,"_26008":51186,"_2720":51283},[],"Current identity",{"_3227":1608,"_28586":1567,"_19790":51285,"_5":13558,"_26008":51186,"_2720":51286},[],"The associated certificate matches the one you verified in PKI.",{"_3227":1609,"_28586":1567,"_19790":51288,"_5":13558,"_26008":51186,"_2720":51289},[],"History",{"_3227":1610,"_28586":1567,"_19790":51291,"_5":13558,"_26008":51186,"_2720":51292},[],"The associated issuance appears with its serial number and dates.",{"_3227":1611,"_28586":1567,"_19790":51294,"_5":13558,"_26008":51186,"_2720":51295},[],"Key and certificate",{"_3227":1612,"_28586":1567,"_19790":51297,"_5":13558,"_26008":51186,"_2720":51298},[],"You have the verified pair ready to install on the device.",{"_3227":1613,"_28586":1567,"_19790":51300,"_5":13558,"_26008":51189,"_2720":51301},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3227":1614,"_28586":1567,"_19790":51303,"_5":13558,"_26008":51189,"_2720":51304},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3227":1615,"_28586":1567,"_19790":51306,"_5":13558,"_26008":51189,"_2720":51307},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3227":1616,"_28586":1567,"_19790":51309,"_5":13558,"_26008":51189,"_2720":51310},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3227":1617,"_28586":1567,"_19790":51312,"_5":13558,"_26008":51193,"_2720":51313},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3227":1618,"_28586":1567,"_19790":51315,"_5":13558,"_26008":51193,"_2720":51316},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3227":1619,"_28586":1567,"_19790":51318,"_5":13558,"_26008":51193,"_2720":51319},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3227":1620,"_28586":1620,"_5":13916,"_2720":51321,"_28908":51322,"_19790":51323,"_26008":1620},"Lamassu IoT Platform",[46300,47749],[],{"_3227":1621,"_28586":1620,"_19790":51325,"_5":13558,"_26008":1620,"_2720":51326},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3227":1622,"_28586":1620,"_5":28905,"_19790":51328,"_26008":51329,"_2720":50807},[],"/docs/platform/overview#start-here",{"_3227":1623,"_28586":1620,"_5":28905,"_19790":51331,"_26008":51332,"_2720":51333},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3227":1624,"_28586":1620,"_5":28905,"_19790":51335,"_26008":51336,"_2720":51337},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3227":1625,"_28586":1620,"_5":28905,"_19790":51339,"_26008":51340,"_2720":51341},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3227":1626,"_28586":1620,"_5":28905,"_19790":51343,"_26008":51344,"_2720":51345},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3227":1627,"_28586":1620,"_5":28905,"_19790":51347,"_26008":51348,"_2720":51349},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3227":1628,"_28586":1620,"_5":28905,"_19790":51351,"_26008":51352,"_2720":51353},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3227":1629,"_28586":1620,"_5":28905,"_19790":51355,"_26008":51356,"_2720":51357},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3227":1630,"_28586":1620,"_5":28905,"_19790":51359,"_26008":51360,"_2720":51361},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3227":1631,"_28586":1620,"_5":28905,"_19790":51363,"_26008":51364,"_2720":51365},[],"/docs/platform/overview#react-to-events","React to events",{"_3227":1632,"_28586":1620,"_5":28905,"_19790":51367,"_26008":51368,"_2720":51369},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3227":1633,"_28586":1620,"_19790":51371,"_5":13558,"_26008":1620,"_2720":51372},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3227":1634,"_28586":1620,"_19790":51374,"_5":13558,"_26008":51329,"_2720":51375},[],"Choose the result you need:",{"_3227":1635,"_28586":1620,"_19790":51377,"_5":13558,"_26008":51329,"_2720":51378},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3227":1636,"_28586":1620,"_19790":51380,"_5":13558,"_26008":51329,"_2720":51381},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3227":1637,"_28586":1620,"_19790":51383,"_5":13558,"_26008":51329,"_2720":51384},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3227":1638,"_28586":1620,"_19790":51386,"_5":13558,"_26008":51332,"_2720":51387},[],"Section",{"_3227":1639,"_28586":1620,"_19790":51389,"_5":13558,"_26008":51332,"_2720":51390},[],"What you manage",{"_3227":1640,"_28586":1620,"_19790":51392,"_5":13558,"_26008":51332,"_2720":51393},[],"Entry point",{"_3227":1641,"_28586":1620,"_19790":51395,"_5":13558,"_26008":51332,"_2720":51396},[],"**PKI**",{"_3227":1642,"_28586":1620,"_19790":51398,"_5":13558,"_26008":51332,"_2720":51399},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3227":1643,"_28586":1620,"_19790":51401,"_5":13558,"_26008":51332,"_2720":51402},[],"PKI overview",{"_3227":1644,"_28586":1620,"_19790":51404,"_5":13558,"_26008":51332,"_2720":51405},[],"**IoT Fleets**",{"_3227":1645,"_28586":1620,"_19790":51407,"_5":13558,"_26008":51332,"_2720":51408},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3227":1646,"_28586":1620,"_19790":51410,"_5":13558,"_26008":51332,"_2720":51411},[],"IoT Fleets overview",{"_3227":1647,"_28586":1620,"_19790":51413,"_5":13558,"_26008":51332,"_2720":51414},[],"**Administration**",{"_3227":1648,"_28586":1620,"_19790":51416,"_5":13558,"_26008":51332,"_2720":51417},[],"Operator permissions, audit and event subscriptions.",{"_3227":1649,"_28586":1620,"_19790":51419,"_5":13558,"_26008":51332,"_2720":47747},[],{"_3227":1650,"_28586":1620,"_19790":51421,"_5":13558,"_26008":51332,"_2720":51422},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3227":1651,"_28586":1620,"_19790":51424,"_5":13558,"_26008":51336,"_2720":51425},[],"An identity's journey connects four responsibilities:",{"_3227":1652,"_28586":1620,"_19790":51427,"_5":13558,"_26008":51336,"_2720":51428},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3227":1653,"_28586":1620,"_19790":51430,"_5":13558,"_26008":51336,"_2720":51431},[],"The provisioning administrator configures the DMS and initial trust.",{"_3227":1654,"_28586":1620,"_19790":51433,"_5":13558,"_26008":51336,"_2720":51434},[],"The device client requests a certificate and installs it with the matching key.",{"_3227":1655,"_28586":1620,"_19790":51436,"_5":13558,"_26008":51336,"_2720":51437},[],"The consumer validates the identity and applies its access permissions.",{"_3227":1656,"_28586":1620,"_19790":51439,"_5":13558,"_26008":51336,"_2720":51440},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3227":1657,"_28586":1620,"_19790":51442,"_5":13558,"_26008":51344,"_2720":51443},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3227":1658,"_28586":1620,"_19790":51445,"_5":13558,"_26008":51348,"_2720":51446},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3227":1659,"_28586":1620,"_19790":51448,"_5":13558,"_26008":51352,"_2720":51449},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3227":1660,"_28586":1620,"_19790":51451,"_5":13558,"_26008":51356,"_2720":51452},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3227":1661,"_28586":1620,"_19790":51454,"_5":13558,"_26008":51360,"_2720":51455},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3227":1662,"_28586":1620,"_19790":51457,"_5":13558,"_26008":51364,"_2720":51458},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3227":1663,"_28586":1620,"_19790":51460,"_5":13558,"_26008":51368,"_2720":50901},[],{"_3227":1664,"_28586":1620,"_19790":51462,"_5":13558,"_26008":51368,"_2720":51463},[],"What it prepares or checks",{"_3227":1665,"_28586":1620,"_19790":51465,"_5":13558,"_26008":51368,"_2720":50904},[],{"_3227":1666,"_28586":1620,"_19790":51467,"_5":13558,"_26008":51368,"_2720":51468},[],"Key custody, CA hierarchy, profiles and validation.",{"_3227":1667,"_28586":1620,"_19790":51470,"_5":13558,"_26008":51368,"_2720":51471},[],"Fleet administrator",{"_3227":1668,"_28586":1620,"_19790":51473,"_5":13558,"_26008":51368,"_2720":51474},[],"DMS, device admission, renewal policy and inventory.",{"_3227":1669,"_28586":1620,"_19790":51476,"_5":13558,"_26008":51368,"_2720":50916},[],{"_3227":1670,"_28586":1620,"_19790":51478,"_5":13558,"_26008":51368,"_2720":51479},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3227":1671,"_28586":1620,"_19790":51481,"_5":13558,"_26008":51368,"_2720":50922},[],{"_3227":1672,"_28586":1620,"_19790":51483,"_5":13558,"_26008":51368,"_2720":51484},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3227":1673,"_28586":1620,"_19790":51486,"_5":13558,"_26008":51368,"_2720":51487},[],"Infrastructure operator",{"_3227":1674,"_28586":1620,"_19790":51489,"_5":13558,"_26008":51368,"_2720":51490},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3227":1675,"_28586":1620,"_19790":51492,"_5":13558,"_26008":51368,"_2720":51493},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3227":1676,"_28586":1676,"_5":13916,"_2720":51495,"_28908":51496,"_19790":51499,"_26008":1676},"CA hierarchy and rotation",[46300,47749,51497,51498],"PKI","Keys, authorities and certificates",[],{"_3227":1677,"_28586":1676,"_19790":51501,"_5":13558,"_26008":1676,"_2720":51502},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3227":1678,"_28586":1676,"_5":28905,"_19790":51504,"_26008":51505,"_2720":51506},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3227":1679,"_28586":1676,"_5":28905,"_19790":51508,"_26008":51509,"_2720":51510},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3227":1680,"_28586":1676,"_5":28905,"_19790":51512,"_26008":51513,"_2720":51514},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3227":1681,"_28586":1676,"_5":28905,"_19790":51516,"_26008":51517,"_2720":51518},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3227":1682,"_28586":1676,"_5":28905,"_19790":51520,"_26008":51521,"_2720":51522},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3227":1683,"_28586":1676,"_5":28905,"_19790":51524,"_26008":51525,"_2720":51526},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3227":1684,"_28586":1676,"_5":28905,"_19790":51528,"_26008":51529,"_2720":51530},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3227":1685,"_28586":1676,"_5":28905,"_19790":51532,"_26008":51533,"_2720":51534},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3227":1686,"_28586":1676,"_5":28905,"_19790":51536,"_26008":51537,"_2720":51538},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3227":1687,"_28586":1676,"_5":28905,"_19790":51540,"_26008":51541,"_2720":51542},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3227":1688,"_28586":1676,"_5":28905,"_19790":51544,"_26008":51545,"_2720":51546},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3227":1689,"_28586":1676,"_5":28905,"_19790":51548,"_26008":51549,"_2720":51550},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3227":1690,"_28586":1676,"_19790":51552,"_5":13558,"_26008":1676,"_2720":51553},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3227":1691,"_28586":1676,"_19790":51555,"_5":13558,"_26008":1676,"_2720":51556},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3227":1692,"_28586":1676,"_19790":51558,"_5":13558,"_26008":51505,"_2720":51559},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3227":1693,"_28586":1676,"_19790":51561,"_5":13558,"_26008":51505,"_2720":51562},[],"environment, such as production and preproduction;",{"_3227":1694,"_28586":1676,"_19790":51564,"_5":13558,"_26008":51505,"_2720":51565},[],"owner or operating team;",{"_3227":1695,"_28586":1676,"_19790":51567,"_5":13558,"_26008":51505,"_2720":51568},[],"device family or manufacturing process;",{"_3227":1696,"_28586":1676,"_19790":51570,"_5":13558,"_26008":51505,"_2720":51571},[],"region or regulatory requirement;",{"_3227":1697,"_28586":1676,"_19790":51573,"_5":13558,"_26008":51505,"_2720":51574},[],"cryptographic engine or key policy;",{"_3227":1698,"_28586":1676,"_19790":51576,"_5":13558,"_26008":51505,"_2720":51577},[],"maintenance window and renewal cadence.",{"_3227":1699,"_28586":1676,"_19790":51579,"_5":13558,"_26008":51505,"_2720":51580},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3227":1700,"_28586":1676,"_19790":51582,"_5":13558,"_26008":51505,"_2720":51583},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3227":1701,"_28586":1676,"_19790":51585,"_5":13558,"_26008":51509,"_2720":51586},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3227":1702,"_28586":1676,"_19790":51588,"_5":13558,"_26008":51509,"_2720":51589},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3227":1703,"_28586":1676,"_19790":51591,"_5":13558,"_26008":51509,"_2720":51592},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3227":1704,"_28586":1676,"_19790":51594,"_5":13558,"_26008":51513,"_2720":51595},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3227":1705,"_28586":1676,"_19790":51597,"_5":13558,"_26008":51513,"_2720":51598},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3227":1706,"_28586":1676,"_19790":51600,"_5":13558,"_26008":51513,"_2720":51601},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3227":1707,"_28586":1676,"_19790":51603,"_5":13558,"_26008":51513,"_2720":51604},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3227":1708,"_28586":1676,"_19790":51606,"_5":13558,"_26008":51521,"_2720":51607},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3227":1709,"_28586":1676,"_19790":51609,"_5":13558,"_26008":51525,"_2720":51610},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3227":1710,"_28586":1676,"_19790":51612,"_5":13558,"_26008":51529,"_2720":51613},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3227":1711,"_28586":1676,"_19790":51615,"_5":13558,"_26008":51533,"_2720":51616},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3227":1712,"_28586":1676,"_19790":51618,"_5":13558,"_26008":51537,"_2720":51619},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3227":1713,"_28586":1676,"_19790":51621,"_5":13558,"_26008":51541,"_2720":51622},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3227":1714,"_28586":1676,"_19790":51624,"_5":13558,"_26008":51545,"_2720":51625},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3227":1715,"_28586":1676,"_19790":51627,"_5":13558,"_26008":51545,"_2720":51628},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3227":1716,"_28586":1676,"_19790":51630,"_5":13558,"_26008":51545,"_2720":51631},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3227":1717,"_28586":1676,"_19790":51633,"_5":13558,"_26008":51545,"_2720":51634},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3227":1718,"_28586":1676,"_19790":51636,"_5":13558,"_26008":51549,"_2720":51637},[],"The new chain ends in an anchor installed by the consumer.",{"_3227":1719,"_28586":1676,"_19790":51639,"_5":13558,"_26008":51549,"_2720":51640},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3227":1720,"_28586":1676,"_19790":51642,"_5":13558,"_26008":51549,"_2720":51643},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3227":1721,"_28586":1676,"_19790":51645,"_5":13558,"_26008":51549,"_2720":51646},[],"Re-enrollment accepts the old identity during the planned period.",{"_3227":1722,"_28586":1676,"_19790":51648,"_5":13558,"_26008":51549,"_2720":51649},[],"OCSP and CRL respond for the authorities that remain active.",{"_3227":1723,"_28586":1676,"_19790":51651,"_5":13558,"_26008":51549,"_2720":51652},[],"No DMS is left accidentally issuing from the old CA.",{"_3227":1724,"_28586":1676,"_19790":51654,"_5":13558,"_26008":51549,"_2720":51655},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3227":1725,"_28586":1725,"_5":13916,"_2720":51657,"_28908":51658,"_19790":51659,"_26008":1725},"Certification authorities",[46300,47749,51497,51498],[],{"_3227":1726,"_28586":1725,"_19790":51661,"_5":13558,"_26008":1725,"_2720":51662},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3227":1727,"_28586":1725,"_5":28905,"_19790":51664,"_26008":51665,"_2720":51666},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3227":1728,"_28586":1725,"_5":28905,"_19790":51668,"_26008":51669,"_2720":51670},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3227":1729,"_28586":1725,"_5":28905,"_19790":51672,"_26008":51673,"_2720":46310},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3227":1730,"_28586":1725,"_5":28905,"_19790":51675,"_26008":51676,"_2720":51677},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3227":1731,"_28586":1725,"_5":28905,"_19790":51679,"_26008":51680,"_2720":51681},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3227":1732,"_28586":1725,"_5":28905,"_19790":51683,"_26008":51684,"_2720":51685},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3227":1733,"_28586":1725,"_5":28905,"_19790":51687,"_26008":51688,"_2720":51689},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3227":1734,"_28586":1725,"_5":28905,"_19790":51691,"_26008":51692,"_2720":51693},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3227":1735,"_28586":1725,"_5":28905,"_19790":51695,"_26008":51696,"_2720":51697},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3227":1736,"_28586":1725,"_5":28905,"_19790":51699,"_26008":51700,"_2720":51701},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3227":1737,"_28586":1725,"_5":28905,"_19790":51703,"_26008":51704,"_2720":51705},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3227":1738,"_28586":1725,"_5":28905,"_19790":51707,"_26008":51708,"_2720":51709},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3227":1739,"_28586":1725,"_5":28905,"_19790":51711,"_26008":51712,"_2720":51713},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3227":1740,"_28586":1725,"_5":28905,"_19790":51715,"_26008":51716,"_2720":51717},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3227":1741,"_28586":1725,"_5":28905,"_19790":51719,"_26008":51720,"_2720":51721},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3227":1742,"_28586":1725,"_5":28905,"_19790":51723,"_26008":51724,"_2720":51725},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3227":1743,"_28586":1725,"_5":28905,"_19790":51727,"_26008":51728,"_2720":51729},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3227":1744,"_28586":1725,"_5":28905,"_19790":51731,"_26008":51732,"_2720":51733},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3227":1745,"_28586":1725,"_5":28905,"_19790":51735,"_26008":51736,"_2720":51737},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3227":1746,"_28586":1725,"_5":28905,"_19790":51739,"_26008":51740,"_2720":51741},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3227":1747,"_28586":1725,"_5":28905,"_19790":51743,"_26008":51744,"_2720":51745},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3227":1748,"_28586":1725,"_5":28905,"_19790":51747,"_26008":51748,"_2720":51749},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3227":1749,"_28586":1725,"_5":28905,"_19790":51751,"_26008":51752,"_2720":51753},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3227":1750,"_28586":1725,"_19790":51755,"_5":13558,"_26008":1725,"_2720":51756},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3227":1751,"_28586":1725,"_19790":51758,"_5":13558,"_26008":1725,"_2720":51759},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3227":1752,"_28586":1725,"_19790":51761,"_5":13558,"_26008":1725,"_2720":51762},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3227":1753,"_28586":1725,"_19790":51764,"_5":13558,"_26008":51665,"_2720":51765},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3227":1754,"_28586":1725,"_19790":51767,"_5":13558,"_26008":51665,"_2720":51768},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3227":1755,"_28586":1725,"_19790":51770,"_5":13558,"_26008":51665,"_2720":51771},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3227":1756,"_28586":1725,"_19790":51773,"_5":13558,"_26008":51665,"_2720":51774},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3227":1757,"_28586":1725,"_19790":51776,"_5":13558,"_26008":51665,"_2720":51777},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3227":1758,"_28586":1725,"_19790":51779,"_5":13558,"_26008":51673,"_2720":51780},[],"Decide whether the CA will be a root or an intermediate.",{"_3227":1759,"_28586":1725,"_19790":51782,"_5":13558,"_26008":51673,"_2720":51783},[],"Choose the engine that will keep the key.",{"_3227":1760,"_28586":1725,"_19790":51785,"_5":13558,"_26008":51673,"_2720":51786},[],"Define a validity longer than that of the certificates it will issue.",{"_3227":1761,"_28586":1725,"_19790":51788,"_5":13558,"_26008":51673,"_2720":51789},[],"For an intermediate CA, make sure the parent CA is active.",{"_3227":1762,"_28586":1725,"_19790":51791,"_5":13558,"_26008":51676,"_2720":51792},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3227":1763,"_28586":1725,"_19790":51794,"_5":13558,"_26008":51680,"_2720":51795},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3227":1764,"_28586":1725,"_19790":51797,"_5":13558,"_26008":51680,"_2720":51798},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3227":1765,"_28586":1725,"_19790":51800,"_5":13558,"_26008":51684,"_2720":51801},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3227":1766,"_28586":1725,"_19790":51803,"_5":13558,"_26008":51688,"_2720":51804},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3227":1767,"_28586":1725,"_19790":51806,"_5":13558,"_26008":51688,"_2720":51807},[],"`C`: two-letter ISO 3166-1 country code.",{"_3227":1768,"_28586":1725,"_19790":51809,"_5":13558,"_26008":51688,"_2720":51810},[],"`ST`: state or province.",{"_3227":1769,"_28586":1725,"_19790":51812,"_5":13558,"_26008":51688,"_2720":51813},[],"`L`: locality.",{"_3227":1770,"_28586":1725,"_19790":51815,"_5":13558,"_26008":51688,"_2720":51816},[],"`O`: organization.",{"_3227":1771,"_28586":1725,"_19790":51818,"_5":13558,"_26008":51688,"_2720":51819},[],"`OU`: organizational unit.",{"_3227":1772,"_28586":1725,"_19790":51821,"_5":13558,"_26008":51688,"_2720":51822},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3227":1773,"_28586":1725,"_19790":51824,"_5":13558,"_26008":51692,"_2720":51825},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3227":1774,"_28586":1725,"_19790":51827,"_5":13558,"_26008":51692,"_2720":51828},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3227":1775,"_28586":1725,"_19790":51830,"_5":13558,"_26008":51696,"_2720":51831},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3227":1776,"_28586":1725,"_19790":51833,"_5":13558,"_26008":51696,"_2720":51834},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3227":1777,"_28586":1725,"_19790":51836,"_5":13558,"_26008":51700,"_2720":51837},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3227":1778,"_28586":1725,"_19790":51839,"_5":13558,"_26008":51700,"_2720":51840},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3227":1779,"_28586":1725,"_19790":51842,"_5":13558,"_26008":51704,"_2720":51843},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3227":1780,"_28586":1725,"_19790":51845,"_5":13558,"_26008":51708,"_2720":51846},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3227":1781,"_28586":1725,"_19790":51848,"_5":13558,"_26008":51712,"_2720":51849},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3227":1782,"_28586":1725,"_19790":51851,"_5":13558,"_26008":51716,"_2720":51852},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3227":1783,"_28586":1725,"_19790":51854,"_5":13558,"_26008":51720,"_2720":51855},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3227":1784,"_28586":1725,"_19790":51857,"_5":13558,"_26008":51720,"_2720":51858},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3227":1785,"_28586":1725,"_19790":51860,"_5":13558,"_26008":51724,"_2720":51861},[],"Open a CA from the inventory to review:",{"_3227":1786,"_28586":1725,"_19790":51863,"_5":13558,"_26008":51724,"_2720":51864},[],"Status and validity period.",{"_3227":1787,"_28586":1725,"_19790":51866,"_5":13558,"_26008":51724,"_2720":51867},[],"Certificate and chain in PEM format.",{"_3227":1788,"_28586":1725,"_19790":51869,"_5":13558,"_26008":51724,"_2720":51870},[],"Number of active, expired and revoked certificates.",{"_3227":1789,"_28586":1725,"_19790":51872,"_5":13558,"_26008":51724,"_2720":51873},[],"Certificates issued in **Issued Certificates**.",{"_3227":1790,"_28586":1725,"_19790":51875,"_5":13558,"_26008":51724,"_2720":51876},[],"The CRL linked to the authority.",{"_3227":1791,"_28586":1725,"_19790":51878,"_5":13558,"_26008":51724,"_2720":51879},[],"Metadata and the associated cryptographic engine.",{"_3227":1792,"_28586":1725,"_19790":51881,"_5":13558,"_26008":51724,"_2720":51882},[],"You can filter the inventory by name, status and CA type.",{"_3227":1793,"_28586":1725,"_19790":51884,"_5":13558,"_26008":51728,"_2720":51885},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3227":1794,"_28586":1725,"_19790":51887,"_5":13558,"_26008":51728,"_2720":51888},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3227":1795,"_28586":1725,"_19790":51890,"_5":13558,"_26008":51728,"_2720":51891},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3227":1796,"_28586":1725,"_19790":51893,"_5":13558,"_26008":51728,"_2720":51894},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3227":1797,"_28586":1725,"_19790":51896,"_5":13558,"_26008":51732,"_2720":51897},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3227":1798,"_28586":1725,"_19790":51899,"_5":13558,"_26008":51736,"_2720":51900},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3227":1799,"_28586":1725,"_19790":51902,"_5":13558,"_26008":51740,"_2720":51903},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3227":1800,"_28586":1725,"_19790":51905,"_5":13558,"_26008":51744,"_2720":51906},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3227":1801,"_28586":1725,"_19790":51908,"_5":13558,"_26008":51748,"_2720":51909},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3227":1802,"_28586":1725,"_19790":51911,"_5":13558,"_26008":51752,"_2720":51912},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3227":1803,"_28586":1725,"_19790":51914,"_5":13558,"_26008":51752,"_2720":51915},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3227":1804,"_28586":1725,"_19790":51917,"_5":13558,"_26008":51752,"_2720":51918},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3227":1805,"_28586":1805,"_5":13916,"_2720":51920,"_28908":51921,"_19790":51922,"_26008":1805},"Certificate profiles",[46300,47749,51497,51498],[],{"_3227":1806,"_28586":1805,"_19790":51924,"_5":13558,"_26008":1805,"_2720":51925},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3227":1807,"_28586":1805,"_5":28905,"_19790":51927,"_26008":51928,"_2720":51929},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3227":1808,"_28586":1805,"_5":28905,"_19790":51931,"_26008":51932,"_2720":51933},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3227":1809,"_28586":1805,"_5":28905,"_19790":51935,"_26008":51936,"_2720":51937},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3227":1810,"_28586":1805,"_5":28905,"_19790":51939,"_26008":51940,"_2720":51941},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3227":1811,"_28586":1805,"_5":28905,"_19790":51943,"_26008":51944,"_2720":51945},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3227":1812,"_28586":1805,"_5":28905,"_19790":51947,"_26008":51948,"_2720":51949},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3227":1813,"_28586":1805,"_5":28905,"_19790":51951,"_26008":51952,"_2720":51953},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3227":1814,"_28586":1805,"_5":28905,"_19790":51955,"_26008":51956,"_2720":51957},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3227":1815,"_28586":1805,"_5":28905,"_19790":51959,"_26008":51960,"_2720":51961},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3227":1816,"_28586":1805,"_5":28905,"_19790":51963,"_26008":51964,"_2720":51965},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3227":1817,"_28586":1805,"_5":28905,"_19790":51967,"_26008":51968,"_2720":51969},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3227":1818,"_28586":1805,"_5":28905,"_19790":51971,"_26008":51972,"_2720":51973},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3227":1819,"_28586":1805,"_5":28905,"_19790":51975,"_26008":51976,"_2720":51977},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3227":1820,"_28586":1805,"_5":28905,"_19790":51979,"_26008":51980,"_2720":51981},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3227":1821,"_28586":1805,"_5":28905,"_19790":51983,"_26008":51984,"_2720":51985},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3227":1822,"_28586":1805,"_5":28905,"_19790":51987,"_26008":51988,"_2720":51989},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3227":1823,"_28586":1805,"_19790":51991,"_5":13558,"_26008":1805,"_2720":51992},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3227":1824,"_28586":1805,"_19790":51994,"_5":13558,"_26008":1805,"_2720":51995},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3227":1825,"_28586":1805,"_19790":51997,"_5":13558,"_26008":51932,"_2720":51998},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3227":1826,"_28586":1805,"_19790":52000,"_5":13558,"_26008":51932,"_2720":52001},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3227":1827,"_28586":1805,"_19790":52003,"_5":13558,"_26008":51936,"_2720":52004},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3227":1828,"_28586":1805,"_19790":52006,"_5":13558,"_26008":51940,"_2720":52007},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3227":1829,"_28586":1805,"_19790":52009,"_5":13558,"_26008":51940,"_2720":52010},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3227":1830,"_28586":1805,"_19790":52012,"_5":13558,"_26008":51940,"_2720":52013},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3227":1831,"_28586":1805,"_19790":52015,"_5":13558,"_26008":51944,"_2720":52016},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3227":1832,"_28586":1805,"_19790":52018,"_5":13558,"_26008":51948,"_2720":52019},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3227":1833,"_28586":1805,"_19790":52021,"_5":13558,"_26008":51948,"_2720":52022},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3227":1834,"_28586":1805,"_19790":52024,"_5":13558,"_26008":51952,"_2720":52025},[],"The cryptographic enforcement can:",{"_3227":1835,"_28586":1805,"_19790":52027,"_5":13558,"_26008":51952,"_2720":52028},[],"allow or block RSA keys;",{"_3227":1836,"_28586":1805,"_19790":52030,"_5":13558,"_26008":51952,"_2720":52031},[],"limit the supported RSA sizes;",{"_3227":1837,"_28586":1805,"_19790":52033,"_5":13558,"_26008":51952,"_2720":52034},[],"allow or block ECDSA keys;",{"_3227":1838,"_28586":1805,"_19790":52036,"_5":13558,"_26008":51952,"_2720":52037},[],"limit the supported ECDSA sizes or curves.",{"_3227":1839,"_28586":1805,"_19790":52039,"_5":13558,"_26008":51952,"_2720":52040},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3227":1840,"_28586":1805,"_19790":52042,"_5":13558,"_26008":51956,"_2720":52043},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3227":1841,"_28586":1805,"_19790":52045,"_5":13558,"_26008":51956,"_2720":49510},[],{"_3227":1842,"_28586":1805,"_19790":52047,"_5":13558,"_26008":51956,"_2720":52048},[],"First choice",{"_3227":1843,"_28586":1805,"_19790":52050,"_5":13558,"_26008":51956,"_2720":52051},[],"Second choice",{"_3227":1844,"_28586":1805,"_19790":52053,"_5":13558,"_26008":51956,"_2720":52054},[],"If neither is supplied",{"_3227":1845,"_28586":1805,"_19790":52056,"_5":13558,"_26008":51956,"_2720":52057},[],"Direct signing with a CA",{"_3227":1846,"_28586":1805,"_19790":52059,"_5":13558,"_26008":51956,"_2720":52060},[],"`issuance_profile` embedded in the request",{"_3227":1847,"_28586":1805,"_19790":52062,"_5":13558,"_26008":51956,"_2720":52063},[],"Request `issuance_profile_id`",{"_3227":1848,"_28586":1805,"_19790":52065,"_5":13558,"_26008":51956,"_2720":52066},[],"CA default profile (`profile_id`).",{"_3227":1849,"_28586":1805,"_19790":52068,"_5":13558,"_26008":51956,"_2720":52069},[],"Issuance through a DMS",{"_3227":1850,"_28586":1805,"_19790":52071,"_5":13558,"_26008":51956,"_2720":52072},[],"`settings.issuance_profile_id`",{"_3227":1851,"_28586":1805,"_19790":52074,"_5":13558,"_26008":51956,"_2720":52075},[],"`settings.issuance_profile` embedded in the DMS",{"_3227":1852,"_28586":1805,"_19790":52077,"_5":13558,"_26008":51956,"_2720":52078},[],"Enrollment CA default profile.",{"_3227":1853,"_28586":1805,"_19790":52080,"_5":13558,"_26008":51956,"_2720":52081},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3227":1854,"_28586":1805,"_19790":52083,"_5":13558,"_26008":51956,"_2720":52084},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3227":1855,"_28586":1805,"_19790":52086,"_5":13558,"_26008":51964,"_2720":52087},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3227":1856,"_28586":1805,"_19790":52089,"_5":13558,"_26008":51968,"_2720":52090},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3227":1857,"_28586":1805,"_19790":52092,"_5":13558,"_26008":51972,"_2720":52093},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3227":1858,"_28586":1805,"_19790":52095,"_5":13558,"_26008":51976,"_2720":52096},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3227":1859,"_28586":1805,"_19790":52098,"_5":13558,"_26008":51980,"_2720":52099},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3227":1860,"_28586":1805,"_19790":52101,"_5":13558,"_26008":51980,"_2720":52102},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3227":1861,"_28586":1805,"_19790":52104,"_5":13558,"_26008":51984,"_2720":52105},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3227":1862,"_28586":1805,"_19790":52107,"_5":13558,"_26008":51984,"_2720":52108},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3227":1863,"_28586":1805,"_19790":52110,"_5":13558,"_26008":51984,"_2720":52111},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3227":1864,"_28586":1805,"_19790":52113,"_5":13558,"_26008":51984,"_2720":52114},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3227":1865,"_28586":1805,"_19790":52116,"_5":13558,"_26008":51988,"_2720":52117},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3227":1866,"_28586":1805,"_19790":52119,"_5":13558,"_26008":51988,"_2720":52120},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3227":1867,"_28586":1867,"_5":13916,"_2720":52122,"_28908":52123,"_19790":52125,"_26008":1867},"Certificate validation",[46300,47749,51497,52124],"Validation",[],{"_3227":1868,"_28586":1867,"_19790":52127,"_5":13558,"_26008":1867,"_2720":52128},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3227":1869,"_28586":1867,"_5":28905,"_19790":52130,"_26008":52131,"_2720":52132},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3227":1870,"_28586":1867,"_5":28905,"_19790":52134,"_26008":52135,"_2720":52136},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3227":1871,"_28586":1867,"_5":28905,"_19790":52138,"_26008":52139,"_2720":52140},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3227":1872,"_28586":1867,"_19790":52142,"_5":13558,"_26008":1867,"_2720":52143},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3227":1873,"_28586":1867,"_19790":52145,"_5":13558,"_26008":52131,"_2720":52146},[],"Verify these criteria together:",{"_3227":1874,"_28586":1867,"_19790":52148,"_5":13558,"_26008":52131,"_2720":51121},[],{"_3227":1875,"_28586":1867,"_19790":52150,"_5":13558,"_26008":52131,"_2720":52151},[],"Required result",{"_3227":1876,"_28586":1867,"_19790":52153,"_5":13558,"_26008":52131,"_2720":52154},[],"Chain and signature",{"_3227":1877,"_28586":1867,"_19790":52156,"_5":13558,"_26008":52131,"_2720":52157},[],"Valid chain to a root deliberately installed in the consumer.",{"_3227":1878,"_28586":1867,"_19790":52159,"_5":13558,"_26008":52131,"_2720":52160},[],"Dates",{"_3227":1879,"_28586":1867,"_19790":52162,"_5":13558,"_26008":52131,"_2720":52163},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3227":1880,"_28586":1867,"_19790":52165,"_5":13558,"_26008":52131,"_2720":47418},[],{"_3227":1881,"_28586":1867,"_19790":52167,"_5":13558,"_26008":52131,"_2720":52168},[],"Name, SAN or identifier matches the expected peer.",{"_3227":1882,"_28586":1867,"_19790":52170,"_5":13558,"_26008":52131,"_2720":46690},[],{"_3227":1883,"_28586":1867,"_19790":52172,"_5":13558,"_26008":52131,"_2720":52173},[],"KU, EKU and constraints permit the specific operation.",{"_3227":1884,"_28586":1867,"_19790":52175,"_5":13558,"_26008":52131,"_2720":52176},[],"Revocation",{"_3227":1885,"_28586":1867,"_19790":52178,"_5":13558,"_26008":52131,"_2720":52179},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3227":1886,"_28586":1867,"_19790":52181,"_5":13558,"_26008":52131,"_2720":52182},[],"Authorization",{"_3227":1887,"_28586":1867,"_19790":52184,"_5":13558,"_26008":52131,"_2720":52185},[],"The application permits that identity to perform the action.",{"_3227":1888,"_28586":1867,"_19790":52187,"_5":13558,"_26008":52131,"_2720":52188},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3227":1889,"_28586":1867,"_19790":52190,"_5":13558,"_26008":52135,"_2720":52191},[],"Mechanism",{"_3227":1890,"_28586":1867,"_19790":52193,"_5":13558,"_26008":52135,"_2720":52194},[],"When to use it",{"_3227":1891,"_28586":1867,"_19790":52196,"_5":13558,"_26008":52135,"_2720":52197},[],"What you must maintain",{"_3227":1892,"_28586":1867,"_19790":52199,"_5":13558,"_26008":52135,"_2720":52200},[],"OCSP",{"_3227":1893,"_28586":1867,"_19790":52202,"_5":13558,"_26008":52135,"_2720":52203},[],"Status query for a specific certificate.",{"_3227":1894,"_28586":1867,"_19790":52205,"_5":13558,"_26008":52135,"_2720":52206},[],"Responder access, signature verification and cache/freshness policy.",{"_3227":1895,"_28586":1867,"_19790":52208,"_5":13558,"_26008":52135,"_2720":52209},[],"CRL",{"_3227":1896,"_28586":1867,"_19790":52211,"_5":13558,"_26008":52135,"_2720":52212},[],"Local checks for many certificates or offline operation.",{"_3227":1897,"_28586":1867,"_19790":52214,"_5":13558,"_26008":52135,"_2720":52215},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3227":1898,"_28586":1867,"_19790":52217,"_5":13558,"_26008":52135,"_2720":52218},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3227":1899,"_28586":1867,"_19790":52220,"_5":13558,"_26008":52135,"_2720":52221},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3227":1900,"_28586":1867,"_19790":52223,"_5":13558,"_26008":52139,"_2720":52224},[],"Accept a current, authorized certificate with a known chain.",{"_3227":1901,"_28586":1867,"_19790":52226,"_5":13558,"_26008":52139,"_2720":52227},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3227":1902,"_28586":1867,"_19790":52229,"_5":13558,"_26008":52139,"_2720":52230},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3227":1903,"_28586":1867,"_19790":52232,"_5":13558,"_26008":52139,"_2720":52233},[],"Check that a new connection with that identity is rejected.",{"_3227":1904,"_28586":1867,"_19790":52235,"_5":13558,"_26008":52139,"_2720":52236},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3227":1905,"_28586":1867,"_19790":52238,"_5":13558,"_26008":52139,"_2720":52239},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3227":1906,"_28586":1867,"_19790":52241,"_5":13558,"_26008":52139,"_2720":52242},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3227":1907,"_28586":1867,"_19790":52244,"_5":13558,"_26008":52139,"_2720":52245},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":1908,"_28586":1867,"_19790":52247,"_5":13558,"_26008":52139,"_2720":52248},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3227":1909,"_28586":1909,"_5":13916,"_2720":52250,"_28908":52251,"_19790":52252,"_26008":1909},"Certificates",[46300,47749,51497,51498],[],{"_3227":1910,"_28586":1909,"_19790":52254,"_5":13558,"_26008":1909,"_2720":52255},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3227":1911,"_28586":1909,"_5":28905,"_19790":52257,"_26008":52258,"_2720":52259},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3227":1912,"_28586":1909,"_5":28905,"_19790":52261,"_26008":52262,"_2720":52263},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3227":1913,"_28586":1909,"_5":28905,"_19790":52265,"_26008":52266,"_2720":52267},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3227":1914,"_28586":1909,"_5":28905,"_19790":52269,"_26008":52270,"_2720":52271},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3227":1915,"_28586":1909,"_5":28905,"_19790":52273,"_26008":52274,"_2720":52275},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3227":1916,"_28586":1909,"_5":28905,"_19790":52277,"_26008":52278,"_2720":52279},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3227":1917,"_28586":1909,"_5":28905,"_19790":52281,"_26008":52282,"_2720":52283},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3227":1918,"_28586":1909,"_5":28905,"_19790":52285,"_26008":52286,"_2720":52287},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3227":1919,"_28586":1909,"_5":28905,"_19790":52289,"_26008":52290,"_2720":52291},[],"/docs/platform/pki/certificates#continue","Continue",{"_3227":1920,"_28586":1909,"_19790":52293,"_5":13558,"_26008":1909,"_2720":52294},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3227":1921,"_28586":1909,"_19790":52296,"_5":13558,"_26008":52258,"_2720":52297},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3227":1922,"_28586":1909,"_19790":52299,"_5":13558,"_26008":52258,"_2720":52300},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3227":1923,"_28586":1909,"_19790":52302,"_5":13558,"_26008":52262,"_2720":52303},[],"Download the PEM and inspect it:",{"_3227":1924,"_28586":1909,"_19790":52305,"_5":13558,"_26008":52262,"_2720":52306},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3227":1925,"_28586":1909,"_19790":52308,"_5":13558,"_26008":52266,"_2720":52309},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3227":1926,"_28586":1909,"_19790":52311,"_5":13558,"_26008":52266,"_2720":52312},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3227":1927,"_28586":1909,"_19790":52314,"_5":13558,"_26008":52266,"_2720":52315},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3227":1928,"_28586":1909,"_19790":52317,"_5":13558,"_26008":52266,"_2720":52318},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3227":1929,"_28586":1909,"_19790":52320,"_5":13558,"_26008":52266,"_2720":52321},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3227":1930,"_28586":1909,"_19790":52323,"_5":13558,"_26008":52266,"_2720":52324},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3227":1931,"_28586":1909,"_19790":52326,"_5":13558,"_26008":52266,"_2720":52327},[],"For browser key generation, follow Issue your first certificate.",{"_3227":1932,"_28586":1909,"_19790":52329,"_5":13558,"_26008":52270,"_2720":52330},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3227":1933,"_28586":1909,"_19790":52332,"_5":13558,"_26008":52274,"_2720":52333},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3227":1934,"_28586":1909,"_19790":52335,"_5":13558,"_26008":52278,"_2720":52336},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3227":1935,"_28586":1909,"_19790":52338,"_5":13558,"_26008":52282,"_2720":52339},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3227":1936,"_28586":1909,"_19790":52341,"_5":13558,"_26008":52282,"_2720":52342},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3227":1937,"_28586":1909,"_19790":52344,"_5":13558,"_26008":52282,"_2720":52345},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3227":1938,"_28586":1909,"_19790":52347,"_5":13558,"_26008":52286,"_2720":52348},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3227":1939,"_28586":1909,"_19790":52350,"_5":13558,"_26008":52286,"_2720":52351},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3227":1940,"_28586":1909,"_19790":52353,"_5":13558,"_26008":52286,"_2720":52354},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3227":1941,"_28586":1909,"_19790":52356,"_5":13558,"_26008":52290,"_2720":52357},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":1942,"_28586":1909,"_19790":52359,"_5":13558,"_26008":52290,"_2720":52360},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3227":1943,"_28586":1943,"_5":13916,"_2720":52362,"_28908":52363,"_19790":52365,"_26008":1943},"Certificate lifecycle",[46300,47749,51497,52364],"Concepts",[],{"_3227":1944,"_28586":1943,"_19790":52367,"_5":13558,"_26008":1943,"_2720":52368},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3227":1945,"_28586":1943,"_5":28905,"_19790":52370,"_26008":52371,"_2720":52372},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3227":1946,"_28586":1943,"_5":28905,"_19790":52374,"_26008":52375,"_2720":52376},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3227":1947,"_28586":1943,"_5":28905,"_19790":52378,"_26008":52379,"_2720":52380},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3227":1948,"_28586":1943,"_5":28905,"_19790":52382,"_26008":52383,"_2720":52384},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3227":1949,"_28586":1943,"_5":28905,"_19790":52386,"_26008":52387,"_2720":52388},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3227":1950,"_28586":1943,"_5":28905,"_19790":52390,"_26008":52391,"_2720":52392},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3227":1951,"_28586":1943,"_5":28905,"_19790":52394,"_26008":52395,"_2720":52396},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3227":1952,"_28586":1943,"_5":28905,"_19790":52398,"_26008":52399,"_2720":52400},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3227":1953,"_28586":1943,"_5":28905,"_19790":52402,"_26008":52403,"_2720":52404},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3227":1954,"_28586":1943,"_5":28905,"_19790":52406,"_26008":52407,"_2720":52408},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3227":1955,"_28586":1943,"_19790":52410,"_5":13558,"_26008":1943,"_2720":52411},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3227":1956,"_28586":1943,"_19790":52413,"_5":13558,"_26008":52375,"_2720":52414},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3227":1957,"_28586":1943,"_19790":52416,"_5":13558,"_26008":52379,"_2720":52417},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3227":1958,"_28586":1943,"_19790":52419,"_5":13558,"_26008":52383,"_2720":52420},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3227":1959,"_28586":1943,"_19790":52422,"_5":13558,"_26008":52387,"_2720":52423},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3227":1960,"_28586":1943,"_19790":52425,"_5":13558,"_26008":52391,"_2720":52426},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3227":1961,"_28586":1943,"_19790":52428,"_5":13558,"_26008":52395,"_2720":52429},[],"Lamassu persists four X.509 states:",{"_3227":1962,"_28586":1943,"_19790":52431,"_5":13558,"_26008":52395,"_2720":52432},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3227":1963,"_28586":1943,"_19790":52434,"_5":13558,"_26008":52395,"_2720":52435},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3227":1964,"_28586":1943,"_19790":52437,"_5":13558,"_26008":52395,"_2720":52438},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3227":1965,"_28586":1943,"_19790":52440,"_5":13558,"_26008":52395,"_2720":52441},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3227":1966,"_28586":1943,"_19790":52443,"_5":13558,"_26008":52395,"_2720":52444},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3227":1967,"_28586":1943,"_19790":52446,"_5":13558,"_26008":52399,"_2720":52447},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3227":1968,"_28586":1943,"_19790":52449,"_5":13558,"_26008":52399,"_2720":52450},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3227":1969,"_28586":1943,"_19790":52452,"_5":13558,"_26008":52399,"_2720":52453},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3227":1970,"_28586":1943,"_19790":52455,"_5":13558,"_26008":52403,"_2720":52456},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3227":1971,"_28586":1943,"_19790":52458,"_5":13558,"_26008":52403,"_2720":52459},[],"Before confirming:",{"_3227":1972,"_28586":1943,"_19790":52461,"_5":13558,"_26008":52403,"_2720":52462},[],"Identify DMSs, devices and services that trust that chain.",{"_3227":1973,"_28586":1943,"_19790":52464,"_5":13558,"_26008":52403,"_2720":52465},[],"Distribute the new chain of trust.",{"_3227":1974,"_28586":1943,"_19790":52467,"_5":13558,"_26008":52403,"_2720":52468},[],"Reissue the necessary identities.",{"_3227":1975,"_28586":1943,"_19790":52470,"_5":13558,"_26008":52403,"_2720":52471},[],"Check OCSP and CRL from a real consumer.",{"_3227":1976,"_28586":1943,"_19790":52473,"_5":13558,"_26008":52403,"_2720":52474},[],"Revoke the old CA once no legitimate traffic remains.",{"_3227":1977,"_28586":1943,"_19790":52476,"_5":13558,"_26008":52403,"_2720":52477},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3227":1978,"_28586":1943,"_19790":52479,"_5":13558,"_26008":52407,"_2720":52480},[],"Certificates entering the preventive or critical renewal window.",{"_3227":1979,"_28586":1943,"_19790":52482,"_5":13558,"_26008":52407,"_2720":52483},[],"Repeated enrollment or re-enrollment failures.",{"_3227":1980,"_28586":1943,"_19790":52485,"_5":13558,"_26008":52407,"_2720":52486},[],"Status changes and revocation reasons.",{"_3227":1981,"_28586":1943,"_19790":52488,"_5":13558,"_26008":52407,"_2720":52489},[],"OCSP and CRL publication and validity.",{"_3227":1982,"_28586":1943,"_19790":52491,"_5":13558,"_26008":52407,"_2720":52492},[],"Dependencies still presenting a replaced certificate.",{"_3227":1983,"_28586":1943,"_19790":52494,"_5":13558,"_26008":52407,"_2720":52495},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3227":1984,"_28586":1984,"_5":13916,"_2720":52497,"_28908":52498,"_19790":52499,"_26008":1984},"Trust model",[46300,47749,51497,52364],[],{"_3227":1985,"_28586":1984,"_19790":52501,"_5":13558,"_26008":1984,"_2720":52502},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3227":1986,"_28586":1984,"_5":28905,"_19790":52504,"_26008":52505,"_2720":52506},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3227":1987,"_28586":1984,"_5":28905,"_19790":52508,"_26008":52509,"_2720":52510},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3227":1988,"_28586":1984,"_5":28905,"_19790":52512,"_26008":52513,"_2720":52514},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3227":1989,"_28586":1984,"_5":28905,"_19790":52516,"_26008":52517,"_2720":52518},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3227":1990,"_28586":1984,"_5":28905,"_19790":52520,"_26008":52521,"_2720":52522},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3227":1991,"_28586":1984,"_5":28905,"_19790":52524,"_26008":52525,"_2720":52526},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3227":1992,"_28586":1984,"_5":28905,"_19790":52528,"_26008":52529,"_2720":52530},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3227":1993,"_28586":1984,"_5":28905,"_19790":52532,"_26008":52533,"_2720":52534},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3227":1994,"_28586":1984,"_5":28905,"_19790":52536,"_26008":52537,"_2720":52538},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3227":1995,"_28586":1984,"_5":28905,"_19790":52540,"_26008":52541,"_2720":52542},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3227":1996,"_28586":1984,"_19790":52544,"_5":13558,"_26008":1984,"_2720":52545},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3227":1997,"_28586":1984,"_19790":52547,"_5":13558,"_26008":52509,"_2720":52548},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3227":1998,"_28586":1984,"_19790":52550,"_5":13558,"_26008":52513,"_2720":52551},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3227":1999,"_28586":1984,"_19790":52553,"_5":13558,"_26008":52517,"_2720":52554},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3227":2000,"_28586":1984,"_19790":52556,"_5":13558,"_26008":52521,"_2720":52557},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3227":2001,"_28586":1984,"_19790":52559,"_5":13558,"_26008":52525,"_2720":52560},[],"The device proves it can enroll according to the DMS policy.",{"_3227":2002,"_28586":1984,"_19790":52562,"_5":13558,"_26008":52525,"_2720":52563},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3227":2003,"_28586":1984,"_19790":52565,"_5":13558,"_26008":52525,"_2720":52566},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3227":2004,"_28586":1984,"_19790":52568,"_5":13558,"_26008":52525,"_2720":52569},[],"The device installs the certificate and the chain it needs.",{"_3227":2005,"_28586":1984,"_19790":52571,"_5":13558,"_26008":52525,"_2720":52572},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3227":2006,"_28586":1984,"_19790":52574,"_5":13558,"_26008":52525,"_2720":52575},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3227":2007,"_28586":1984,"_19790":52577,"_5":13558,"_26008":52529,"_2720":52578},[],"A DMS relates three sets that are worth designing separately:",{"_3227":2008,"_28586":1984,"_19790":52580,"_5":13558,"_26008":52529,"_2720":52581},[],"**Enrollment CA:** signs the new identities.",{"_3227":2009,"_28586":1984,"_19790":52583,"_5":13558,"_26008":52529,"_2720":52584},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3227":2010,"_28586":1984,"_19790":52586,"_5":13558,"_26008":52529,"_2720":52587},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3227":2011,"_28586":1984,"_19790":52589,"_5":13558,"_26008":52529,"_2720":52590},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3227":2012,"_28586":1984,"_19790":52592,"_5":13558,"_26008":52533,"_2720":52593},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3227":2013,"_28586":1984,"_19790":52595,"_5":13558,"_26008":52533,"_2720":52596},[],"that the current date is between `Not Before` and `Not After`;",{"_3227":2014,"_28586":1984,"_19790":52598,"_5":13558,"_26008":52533,"_2720":52599},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3227":2015,"_28586":1984,"_19790":52601,"_5":13558,"_26008":52533,"_2720":52602},[],"that names, SANs and subject match the expected identity;",{"_3227":2016,"_28586":1984,"_19790":52604,"_5":13558,"_26008":52533,"_2720":52605},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3227":2017,"_28586":1984,"_19790":52607,"_5":13558,"_26008":52533,"_2720":52608},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3227":2018,"_28586":1984,"_19790":52610,"_5":13558,"_26008":52533,"_2720":52611},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3227":2019,"_28586":1984,"_19790":52613,"_5":13558,"_26008":52537,"_2720":52614},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3227":2020,"_28586":1984,"_19790":52616,"_5":13558,"_26008":52541,"_2720":52617},[],"Keep the root out of daily operations, or with very restricted access.",{"_3227":2021,"_28586":1984,"_19790":52619,"_5":13558,"_26008":52541,"_2720":52620},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3227":2022,"_28586":1984,"_19790":52622,"_5":13558,"_26008":52541,"_2720":52623},[],"Assign explicit profiles to every use case.",{"_3227":2023,"_28586":1984,"_19790":52625,"_5":13558,"_26008":52541,"_2720":52626},[],"Distribute the new trust before starting a rotation.",{"_3227":2024,"_28586":1984,"_19790":52628,"_5":13558,"_26008":52541,"_2720":52629},[],"Keep enough overlap to renew a disconnected fleet.",{"_3227":2025,"_28586":1984,"_19790":52631,"_5":13558,"_26008":52541,"_2720":52632},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3227":2026,"_28586":1984,"_19790":52634,"_5":13558,"_26008":52541,"_2720":52635},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3227":2027,"_28586":2027,"_5":13916,"_2720":52637,"_28908":52638,"_19790":52639,"_26008":2027},"Revocation lists (CRL)",[46300,47749,51497,52124],[],{"_3227":2028,"_28586":2027,"_19790":52641,"_5":13558,"_26008":2027,"_2720":52642},[],"Generate and distribute signed lists to validate certificates offline.",{"_3227":2029,"_28586":2027,"_5":28905,"_19790":52644,"_26008":52645,"_2720":52646},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3227":2030,"_28586":2027,"_5":28905,"_19790":52648,"_26008":52649,"_2720":52650},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3227":2031,"_28586":2027,"_5":28905,"_19790":52652,"_26008":52653,"_2720":52654},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3227":2032,"_28586":2027,"_5":28905,"_19790":52656,"_26008":52657,"_2720":52658},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3227":2033,"_28586":2027,"_5":28905,"_19790":52660,"_26008":52661,"_2720":52662},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3227":2034,"_28586":2027,"_5":28905,"_19790":52664,"_26008":52665,"_2720":52666},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3227":2035,"_28586":2027,"_5":28905,"_19790":52668,"_26008":52669,"_2720":52670},[],"/docs/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3227":2036,"_28586":2027,"_5":28905,"_19790":52672,"_26008":52673,"_2720":52674},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3227":2037,"_28586":2027,"_5":28905,"_19790":52676,"_26008":52677,"_2720":52678},[],"/docs/platform/pki/crl#references","References",{"_3227":2038,"_28586":2027,"_19790":52680,"_5":13558,"_26008":2027,"_2720":52681},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3227":2039,"_28586":2027,"_19790":52683,"_5":13558,"_26008":52645,"_2720":52684},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3227":2040,"_28586":2027,"_19790":52686,"_5":13558,"_26008":52645,"_2720":52687},[],"`crl_options` field",{"_3227":2041,"_28586":2027,"_19790":52689,"_5":13558,"_26008":52645,"_2720":46690},[],{"_3227":2042,"_28586":2027,"_19790":52691,"_5":13558,"_26008":52645,"_2720":52692},[],"Backend initial value",{"_3227":2043,"_28586":2027,"_19790":52694,"_5":13558,"_26008":52645,"_2720":52695},[],"`validity`",{"_3227":2044,"_28586":2027,"_19790":52697,"_5":13558,"_26008":52645,"_2720":52698},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3227":2045,"_28586":2027,"_19790":52700,"_5":13558,"_26008":52645,"_2720":52701},[],"7 days.",{"_3227":2046,"_28586":2027,"_19790":52703,"_5":13558,"_26008":52645,"_2720":52704},[],"`refresh_interval`",{"_3227":2047,"_28586":2027,"_19790":52706,"_5":13558,"_26008":52645,"_2720":52707},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3227":2048,"_28586":2027,"_19790":52709,"_5":13558,"_26008":52645,"_2720":52710},[],"6 days and 23 hours.",{"_3227":2049,"_28586":2027,"_19790":52712,"_5":13558,"_26008":52645,"_2720":52713},[],"`regenerate_on_revoke`",{"_3227":2050,"_28586":2027,"_19790":52715,"_5":13558,"_26008":52645,"_2720":52716},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3227":2051,"_28586":2027,"_19790":52718,"_5":13558,"_26008":52645,"_2720":52719},[],"`true`.",{"_3227":2052,"_28586":2027,"_19790":52721,"_5":13558,"_26008":52645,"_2720":52722},[],"`signer_certificate_serial_number`",{"_3227":2053,"_28586":2027,"_19790":52724,"_5":13558,"_26008":52645,"_2720":52725},[],"Serial number of the existing certificate that signs the CRL.",{"_3227":2054,"_28586":2027,"_19790":52727,"_5":13558,"_26008":52645,"_2720":52728},[],"Serial number of the CA’s current certificate.",{"_3227":2055,"_28586":2027,"_19790":52730,"_5":13558,"_26008":52645,"_2720":52731},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3227":2056,"_28586":2027,"_19790":52733,"_5":13558,"_26008":52645,"_2720":52734},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3227":2057,"_28586":2027,"_19790":52736,"_5":13558,"_26008":52645,"_2720":52737},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3227":2058,"_28586":2027,"_19790":52739,"_5":13558,"_26008":52645,"_2720":52740},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3227":2059,"_28586":2027,"_19790":52742,"_5":13558,"_26008":52645,"_2720":52743},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3227":2060,"_28586":2027,"_19790":52745,"_5":13558,"_26008":52645,"_2720":52746},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3227":2061,"_28586":2027,"_19790":52748,"_5":13558,"_26008":52649,"_2720":52749},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3227":2062,"_28586":2027,"_19790":52751,"_5":13558,"_26008":52649,"_2720":52752},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3227":2063,"_28586":2027,"_19790":52754,"_5":13558,"_26008":52649,"_2720":52755},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3227":2064,"_28586":2027,"_19790":52757,"_5":13558,"_26008":52649,"_2720":52758},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3227":2065,"_28586":2027,"_19790":52760,"_5":13558,"_26008":52653,"_2720":52761},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3227":2066,"_28586":2027,"_19790":52763,"_5":13558,"_26008":52653,"_2720":52764},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3227":2067,"_28586":2027,"_19790":52766,"_5":13558,"_26008":52653,"_2720":52767},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3227":2068,"_28586":2027,"_19790":52769,"_5":13558,"_26008":52653,"_2720":52770},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3227":2069,"_28586":2027,"_19790":52772,"_5":13558,"_26008":52657,"_2720":52773},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3227":2070,"_28586":2027,"_19790":52775,"_5":13558,"_26008":52657,"_2720":52776},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3227":2071,"_28586":2027,"_19790":52778,"_5":13558,"_26008":52661,"_2720":52779},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3227":2072,"_28586":2027,"_19790":52781,"_5":13558,"_26008":52661,"_2720":52782},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3227":2073,"_28586":2027,"_19790":52784,"_5":13558,"_26008":52661,"_2720":52785},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3227":2074,"_28586":2027,"_19790":52787,"_5":13558,"_26008":52661,"_2720":52788},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3227":2075,"_28586":2027,"_19790":52790,"_5":13558,"_26008":52661,"_2720":52791},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3227":2076,"_28586":2027,"_19790":52793,"_5":13558,"_26008":52665,"_2720":52794},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3227":2077,"_28586":2027,"_19790":52796,"_5":13558,"_26008":52665,"_2720":49513},[],{"_3227":2078,"_28586":2027,"_19790":52798,"_5":13558,"_26008":52665,"_2720":52799},[],"Relative path",{"_3227":2079,"_28586":2027,"_19790":52801,"_5":13558,"_26008":52665,"_2720":49510},[],{"_3227":2080,"_28586":2027,"_19790":52803,"_5":13558,"_26008":52665,"_2720":52804},[],"`GET`",{"_3227":2081,"_28586":2027,"_19790":52806,"_5":13558,"_26008":52665,"_2720":52807},[],"`/v1/roles/{ca-ski}`",{"_3227":2082,"_28586":2027,"_19790":52809,"_5":13558,"_26008":52665,"_2720":52810},[],"Read `crl_options` and `latest_crl`.",{"_3227":2083,"_28586":2027,"_19790":52812,"_5":13558,"_26008":52665,"_2720":52813},[],"`PUT`",{"_3227":2084,"_28586":2027,"_19790":52815,"_5":13558,"_26008":52665,"_2720":52807},[],{"_3227":2085,"_28586":2027,"_19790":52817,"_5":13558,"_26008":52665,"_2720":52818},[],"Replace CRL configuration.",{"_3227":2086,"_28586":2027,"_19790":52820,"_5":13558,"_26008":52665,"_2720":52821},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3227":2087,"_28586":2027,"_19790":52823,"_5":13558,"_26008":52665,"_2720":52824},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3227":2088,"_28586":2027,"_19790":52826,"_5":13558,"_26008":52669,"_2720":52827},[],"Symptom",{"_3227":2089,"_28586":2027,"_19790":52829,"_5":13558,"_26008":52669,"_2720":52830},[],"Cause",{"_3227":2090,"_28586":2027,"_19790":52832,"_5":13558,"_26008":52669,"_2720":52833},[],"Action",{"_3227":2091,"_28586":2027,"_19790":52835,"_5":13558,"_26008":52669,"_2720":52836},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3227":2092,"_28586":2027,"_19790":52838,"_5":13558,"_26008":52669,"_2720":52839},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3227":2093,"_28586":2027,"_19790":52841,"_5":13558,"_26008":52669,"_2720":52842},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3227":2094,"_28586":2027,"_19790":52844,"_5":13558,"_26008":52669,"_2720":52845},[],"`PUT` returns 400.",{"_3227":2095,"_28586":2027,"_19790":52847,"_5":13558,"_26008":52669,"_2720":52848},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3227":2096,"_28586":2027,"_19790":52850,"_5":13558,"_26008":52669,"_2720":52851},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3227":2097,"_28586":2027,"_19790":52853,"_5":13558,"_26008":52669,"_2720":52854},[],"`PUT` returns 400 from a 3.x client.",{"_3227":2098,"_28586":2027,"_19790":52856,"_5":13558,"_26008":52669,"_2720":52857},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3227":2099,"_28586":2027,"_19790":52859,"_5":13558,"_26008":52669,"_2720":52860},[],"Update the client to send the new field.",{"_3227":2100,"_28586":2027,"_19790":52862,"_5":13558,"_26008":52669,"_2720":52863},[],"The CRL does not change after revoking a certificate.",{"_3227":2101,"_28586":2027,"_19790":52865,"_5":13558,"_26008":52669,"_2720":52866},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3227":2102,"_28586":2027,"_19790":52868,"_5":13558,"_26008":52669,"_2720":52869},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3227":2103,"_28586":2027,"_19790":52871,"_5":13558,"_26008":52669,"_2720":52872},[],"A verifier rejects the CRL because of the issuer.",{"_3227":2104,"_28586":2027,"_19790":52874,"_5":13558,"_26008":52669,"_2720":52875},[],"Several CAs share an SKI.",{"_3227":2105,"_28586":2027,"_19790":52877,"_5":13558,"_26008":52669,"_2720":52878},[],"See CAs that share a key.",{"_3227":2106,"_28586":2027,"_19790":52880,"_5":13558,"_26008":52673,"_2720":52881},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3227":2107,"_28586":2027,"_19790":52883,"_5":13558,"_26008":52677,"_2720":52884},[],"RFC 5280: X.509 and CRL profile.",{"_3227":2108,"_28586":2027,"_19790":52886,"_5":13558,"_26008":52677,"_2720":52887},[],"OpenSSL: openssl-crl.",{"_3227":2109,"_28586":2027,"_19790":52889,"_5":13558,"_26008":52677,"_2720":52890},[],"OpenSSL: openssl-verify.",{"_3227":2110,"_28586":2027,"_19790":52892,"_5":13558,"_26008":52677,"_2720":52893},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":2111,"_28586":2027,"_19790":52895,"_5":13558,"_26008":52677,"_2720":52896},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3227":2112,"_28586":2112,"_5":13916,"_2720":52898,"_28908":52899,"_19790":52900,"_26008":2112},"Keys and cryptographic engines",[46300,47749,51497,51498],[],{"_3227":2113,"_28586":2112,"_19790":52902,"_5":13558,"_26008":2112,"_2720":52903},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3227":2114,"_28586":2112,"_5":28905,"_19790":52905,"_26008":52906,"_2720":52907},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3227":2115,"_28586":2112,"_5":28905,"_19790":52909,"_26008":52910,"_2720":52911},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3227":2116,"_28586":2112,"_5":28905,"_19790":52913,"_26008":52914,"_2720":52915},[],"/docs/platform/pki/key-management#file-system","File System",{"_3227":2117,"_28586":2112,"_5":28905,"_19790":52917,"_26008":52918,"_2720":52919},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3227":2118,"_28586":2112,"_5":28905,"_19790":52921,"_26008":52922,"_2720":52923},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3227":2119,"_28586":2112,"_5":28905,"_19790":52925,"_26008":52926,"_2720":52927},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3227":2120,"_28586":2112,"_5":28905,"_19790":52929,"_26008":52930,"_2720":52931},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3227":2121,"_28586":2112,"_5":28905,"_19790":52933,"_26008":52934,"_2720":52935},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3227":2122,"_28586":2112,"_5":28905,"_19790":52937,"_26008":52938,"_2720":52939},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3227":2123,"_28586":2112,"_5":28905,"_19790":52941,"_26008":52942,"_2720":52943},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3227":2124,"_28586":2112,"_5":28905,"_19790":52945,"_26008":52946,"_2720":52947},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3227":2125,"_28586":2112,"_5":28905,"_19790":52949,"_26008":52950,"_2720":52951},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3227":2126,"_28586":2112,"_5":28905,"_19790":52953,"_26008":52954,"_2720":52955},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3227":2127,"_28586":2112,"_5":28905,"_19790":52957,"_26008":52958,"_2720":52959},[],"/docs/platform/pki/key-management#view-details","View details",{"_3227":2128,"_28586":2112,"_5":28905,"_19790":52961,"_26008":52962,"_2720":52963},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3227":2129,"_28586":2112,"_5":28905,"_19790":52965,"_26008":52966,"_2720":52967},[],"/docs/platform/pki/key-management#sign","Sign",{"_3227":2130,"_28586":2112,"_5":28905,"_19790":52969,"_26008":52970,"_2720":52971},[],"/docs/platform/pki/key-management#verify","Verify",{"_3227":2131,"_28586":2112,"_5":28905,"_19790":52973,"_26008":52974,"_2720":52975},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3227":2132,"_28586":2112,"_5":28905,"_19790":52977,"_26008":52978,"_2720":52979},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3227":2133,"_28586":2112,"_5":28905,"_19790":52981,"_26008":52982,"_2720":52983},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3227":2134,"_28586":2112,"_19790":52985,"_5":13558,"_26008":2112,"_2720":52986},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3227":2135,"_28586":2112,"_19790":52988,"_5":13558,"_26008":2112,"_2720":52989},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3227":2136,"_28586":2112,"_19790":52991,"_5":13558,"_26008":52906,"_2720":52992},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3227":2137,"_28586":2112,"_19790":52994,"_5":13558,"_26008":52906,"_2720":52995},[],"In practice, it lets you:",{"_3227":2138,"_28586":2112,"_19790":52997,"_5":13558,"_26008":52906,"_2720":52998},[],"Generate new key pairs from Lamassu IoT.",{"_3227":2139,"_28586":2112,"_19790":53000,"_5":13558,"_26008":52906,"_2720":53001},[],"Import keys created externally.",{"_3227":2140,"_28586":2112,"_19790":53003,"_5":13558,"_26008":52906,"_2720":53004},[],"Delegate custody and cryptographic operations to external engines.",{"_3227":2141,"_28586":2112,"_19790":53006,"_5":13558,"_26008":52906,"_2720":53007},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3227":2142,"_28586":2112,"_19790":53009,"_5":13558,"_26008":52910,"_2720":53010},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3227":2143,"_28586":2112,"_19790":53012,"_5":13558,"_26008":52910,"_2720":53013},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3227":2144,"_28586":2112,"_19790":53015,"_5":13558,"_26008":52910,"_2720":53016},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3227":2145,"_28586":2112,"_19790":53018,"_5":13558,"_26008":52914,"_2720":53019},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3227":2146,"_28586":2112,"_19790":53021,"_5":13558,"_26008":52918,"_2720":53022},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3227":2147,"_28586":2112,"_19790":53024,"_5":13558,"_26008":52918,"_2720":53025},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3227":2148,"_28586":2112,"_19790":53027,"_5":13558,"_26008":52922,"_2720":53028},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3227":2149,"_28586":2112,"_19790":53030,"_5":13558,"_26008":52926,"_2720":53031},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3227":2150,"_28586":2112,"_19790":53033,"_5":13558,"_26008":52930,"_2720":53034},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3227":2151,"_28586":2112,"_19790":53036,"_5":13558,"_26008":52934,"_2720":53037},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3227":2152,"_28586":2112,"_19790":53039,"_5":13558,"_26008":52934,"_2720":53040},[],"Lamassu shows the enabled engines in the console.",{"_3227":2153,"_28586":2112,"_19790":53042,"_5":13558,"_26008":52934,"_2720":53043},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3227":2154,"_28586":2112,"_19790":53045,"_5":13558,"_26008":52934,"_2720":53046},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3227":2155,"_28586":2112,"_19790":53048,"_5":13558,"_26008":52938,"_2720":53049},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3227":2156,"_28586":2112,"_19790":53051,"_5":13558,"_26008":52938,"_2720":53052},[],"The table includes the following fields:",{"_3227":2157,"_28586":2112,"_19790":53054,"_5":13558,"_26008":52938,"_2720":53055},[],"**Name**: descriptive name of the key.",{"_3227":2158,"_28586":2112,"_19790":53057,"_5":13558,"_26008":52938,"_2720":53058},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3227":2159,"_28586":2112,"_19790":53060,"_5":13558,"_26008":52938,"_2720":53061},[],"**Strength**: visual indicator of cryptographic strength.",{"_3227":2160,"_28586":2112,"_19790":53063,"_5":13558,"_26008":52938,"_2720":53064},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3227":2161,"_28586":2112,"_19790":53066,"_5":13558,"_26008":52938,"_2720":53067},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3227":2162,"_28586":2112,"_19790":53069,"_5":13558,"_26008":52938,"_2720":53070},[],"**Aliases**: alternative names associated with the key.",{"_3227":2163,"_28586":2112,"_19790":53072,"_5":13558,"_26008":52938,"_2720":53073},[],"**Tags**: labels for classification and search.",{"_3227":2164,"_28586":2112,"_19790":53075,"_5":13558,"_26008":52938,"_2720":53076},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3227":2165,"_28586":2112,"_19790":53078,"_5":13558,"_26008":52938,"_2720":53079},[],"From this view you also reach the most common actions:",{"_3227":2166,"_28586":2112,"_19790":53081,"_5":13558,"_26008":52938,"_2720":53082},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3227":2167,"_28586":2112,"_19790":53084,"_5":13558,"_26008":52938,"_2720":53085},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3227":2168,"_28586":2112,"_19790":53087,"_5":13558,"_26008":52938,"_2720":53088},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3227":2169,"_28586":2112,"_19790":53090,"_5":13558,"_26008":52938,"_2720":53091},[],"**Delete Key** to remove the key from the system.",{"_3227":2170,"_28586":2112,"_19790":53093,"_5":13558,"_26008":52942,"_2720":53094},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3227":2171,"_28586":2112,"_19790":53096,"_5":13558,"_26008":52946,"_2720":53097},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3227":2172,"_28586":2112,"_19790":53099,"_5":13558,"_26008":52946,"_2720":53100},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3227":2173,"_28586":2112,"_19790":53102,"_5":13558,"_26008":52946,"_2720":53103},[],"**Key Name**: unique and descriptive name.",{"_3227":2174,"_28586":2112,"_19790":53105,"_5":13558,"_26008":52946,"_2720":53106},[],"**Crypto Engine**: engine that will keep the key.",{"_3227":2175,"_28586":2112,"_19790":53108,"_5":13558,"_26008":52946,"_2720":53109},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3227":2176,"_28586":2112,"_19790":53111,"_5":13558,"_26008":52946,"_2720":53112},[],"**Tags**: metadata to classify the key.",{"_3227":2177,"_28586":2112,"_19790":53114,"_5":13558,"_26008":52946,"_2720":53115},[],"**Metadata**: additional information for advanced uses.",{"_3227":2178,"_28586":2112,"_19790":53117,"_5":13558,"_26008":52950,"_2720":53118},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3227":2179,"_28586":2112,"_19790":53120,"_5":13558,"_26008":52950,"_2720":53121},[],"When you have an exportable private key and the destination engine supports import.",{"_3227":2180,"_28586":2112,"_19790":53123,"_5":13558,"_26008":52950,"_2720":53124},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3227":2181,"_28586":2112,"_19790":53126,"_5":13558,"_26008":52950,"_2720":53127},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3227":2182,"_28586":2112,"_19790":53129,"_5":13558,"_26008":52950,"_2720":53130},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3227":2183,"_28586":2112,"_19790":53132,"_5":13558,"_26008":52950,"_2720":53133},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3227":2184,"_28586":2112,"_19790":53135,"_5":13558,"_26008":52950,"_2720":53136},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3227":2185,"_28586":2112,"_19790":53138,"_5":13558,"_26008":52950,"_2720":53139},[],"**Tags**: labels for organization and search.",{"_3227":2186,"_28586":2112,"_19790":53141,"_5":13558,"_26008":52950,"_2720":53142},[],"**Metadata**: additional optional information.",{"_3227":2187,"_28586":2112,"_19790":53144,"_5":13558,"_26008":52950,"_2720":53145},[],"**Private Key (PEM)**: private key in PEM format.",{"_3227":2188,"_28586":2112,"_19790":53147,"_5":13558,"_26008":52950,"_2720":53148},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3227":2189,"_28586":2112,"_19790":53150,"_5":13558,"_26008":52954,"_2720":53151},[],"Each registered key has a detail view and several operational actions.",{"_3227":2190,"_28586":2112,"_19790":53153,"_5":13558,"_26008":52958,"_2720":53154},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3227":2191,"_28586":2112,"_19790":53156,"_5":13558,"_26008":52958,"_2720":53157},[],"The **Overview** tab shows, among others, these fields:",{"_3227":2192,"_28586":2112,"_19790":53159,"_5":13558,"_26008":52958,"_2720":53160},[],"**Key Name**: descriptive name.",{"_3227":2193,"_28586":2112,"_19790":53162,"_5":13558,"_26008":52958,"_2720":53163},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3227":2194,"_28586":2112,"_19790":53165,"_5":13558,"_26008":52958,"_2720":53166},[],"**Tags**: associated labels.",{"_3227":2195,"_28586":2112,"_19790":53168,"_5":13558,"_26008":52958,"_2720":53169},[],"**Aliases**: alternative names.",{"_3227":2196,"_28586":2112,"_19790":53171,"_5":13558,"_26008":52958,"_2720":53172},[],"**Crypto Engine**: engine where the key resides.",{"_3227":2197,"_28586":2112,"_19790":53174,"_5":13558,"_26008":52958,"_2720":53175},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3227":2198,"_28586":2112,"_19790":53177,"_5":13558,"_26008":52958,"_2720":53178},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3227":2199,"_28586":2112,"_19790":53180,"_5":13558,"_26008":52958,"_2720":53181},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3227":2200,"_28586":2112,"_19790":53183,"_5":13558,"_26008":52962,"_2720":53184},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3227":2201,"_28586":2112,"_19790":53186,"_5":13558,"_26008":52962,"_2720":53187},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3227":2202,"_28586":2112,"_19790":53189,"_5":13558,"_26008":52962,"_2720":53190},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3227":2203,"_28586":2112,"_19790":53192,"_5":13558,"_26008":52966,"_2720":53193},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3227":2204,"_28586":2112,"_19790":53195,"_5":13558,"_26008":52966,"_2720":53196},[],"Main fields:",{"_3227":2205,"_28586":2112,"_19790":53198,"_5":13558,"_26008":52966,"_2720":53199},[],"**Algorithm**: signing algorithm available for the key type.",{"_3227":2206,"_28586":2112,"_19790":53201,"_5":13558,"_26008":52966,"_2720":53202},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3227":2207,"_28586":2112,"_19790":53204,"_5":13558,"_26008":52966,"_2720":53205},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3227":2208,"_28586":2112,"_19790":53207,"_5":13558,"_26008":52966,"_2720":53208},[],"**Message**: content to sign.",{"_3227":2209,"_28586":2112,"_19790":53210,"_5":13558,"_26008":52966,"_2720":53211},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3227":2210,"_28586":2112,"_19790":53213,"_5":13558,"_26008":52970,"_2720":53214},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3227":2211,"_28586":2112,"_19790":53216,"_5":13558,"_26008":52970,"_2720":53196},[],{"_3227":2212,"_28586":2112,"_19790":53218,"_5":13558,"_26008":52970,"_2720":53219},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3227":2213,"_28586":2112,"_19790":53221,"_5":13558,"_26008":52970,"_2720":53222},[],"**Message Type**: `Raw` or `Digest`.",{"_3227":2214,"_28586":2112,"_19790":53224,"_5":13558,"_26008":52970,"_2720":53225},[],"**Payload Encoding**: encoding of the message.",{"_3227":2215,"_28586":2112,"_19790":53227,"_5":13558,"_26008":52970,"_2720":53228},[],"**Message**: original message or hash.",{"_3227":2216,"_28586":2112,"_19790":53230,"_5":13558,"_26008":52970,"_2720":53231},[],"**Signature**: signature to check.",{"_3227":2217,"_28586":2112,"_19790":53233,"_5":13558,"_26008":52970,"_2720":53234},[],"**Result**: indicator of the validation result.",{"_3227":2218,"_28586":2112,"_19790":53236,"_5":13558,"_26008":52974,"_2720":53237},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3227":2219,"_28586":2112,"_19790":53239,"_5":13558,"_26008":52974,"_2720":53240},[],"This flow is useful for:",{"_3227":2220,"_28586":2112,"_19790":53242,"_5":13558,"_26008":52974,"_2720":53243},[],"Requesting certificates from an external CA.",{"_3227":2221,"_28586":2112,"_19790":53245,"_5":13558,"_26008":52974,"_2720":53246},[],"Renewing an identity while keeping the same key.",{"_3227":2222,"_28586":2112,"_19790":53248,"_5":13558,"_26008":52974,"_2720":53249},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3227":2223,"_28586":2112,"_19790":53251,"_5":13558,"_26008":52974,"_2720":53252},[],"**Common Name (CN)**: main name of the identity.",{"_3227":2224,"_28586":2112,"_19790":53254,"_5":13558,"_26008":52974,"_2720":53255},[],"**Organization (O)**: organization or company.",{"_3227":2225,"_28586":2112,"_19790":53257,"_5":13558,"_26008":52974,"_2720":53258},[],"**Organizational Unit (OU)**: department or unit.",{"_3227":2226,"_28586":2112,"_19790":53260,"_5":13558,"_26008":52974,"_2720":53261},[],"**Country (C)**: two-letter country code.",{"_3227":2227,"_28586":2112,"_19790":53263,"_5":13558,"_26008":52974,"_2720":53264},[],"**State / Province (ST)**: state or province.",{"_3227":2228,"_28586":2112,"_19790":53266,"_5":13558,"_26008":52974,"_2720":53267},[],"**Locality (L)**: city or locality.",{"_3227":2229,"_28586":2112,"_19790":53269,"_5":13558,"_26008":52974,"_2720":53270},[],"**Email Address**: contact email.",{"_3227":2230,"_28586":2112,"_19790":53272,"_5":13558,"_26008":52974,"_2720":53273},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3227":2231,"_28586":2112,"_19790":53275,"_5":13558,"_26008":52974,"_2720":53276},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3227":2232,"_28586":2112,"_19790":53278,"_5":13558,"_26008":52978,"_2720":53279},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3227":2233,"_28586":2112,"_19790":53281,"_5":13558,"_26008":52978,"_2720":53282},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3227":2234,"_28586":2112,"_19790":53284,"_5":13558,"_26008":52982,"_2720":53285},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3227":2235,"_28586":2235,"_5":13916,"_2720":53287,"_28908":53288,"_19790":53289,"_26008":2235},"Online validation with OCSP",[46300,47749,51497,52124],[],{"_3227":2236,"_28586":2235,"_19790":53291,"_5":13558,"_26008":2235,"_2720":53292},[],"Query signed status and verify the responder’s response.",{"_3227":2237,"_28586":2235,"_5":28905,"_19790":53294,"_26008":53295,"_2720":53296},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3227":2238,"_28586":2235,"_5":28905,"_19790":53298,"_26008":53299,"_2720":53300},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3227":2239,"_28586":2235,"_5":28905,"_19790":53302,"_26008":53303,"_2720":53304},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3227":2240,"_28586":2235,"_5":28905,"_19790":53306,"_26008":53307,"_2720":53308},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3227":2241,"_28586":2235,"_5":28905,"_19790":53310,"_26008":53311,"_2720":53312},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3227":2242,"_28586":2235,"_5":28905,"_19790":53314,"_26008":53315,"_2720":52678},[],"/docs/platform/pki/ocsp#references",{"_3227":2243,"_28586":2235,"_19790":53317,"_5":13558,"_26008":2235,"_2720":53318},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3227":2244,"_28586":2235,"_19790":53320,"_5":13558,"_26008":53295,"_2720":53321},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3227":2245,"_28586":2235,"_19790":53323,"_5":13558,"_26008":53295,"_2720":53324},[],"Record status",{"_3227":2246,"_28586":2235,"_19790":53326,"_5":13558,"_26008":53295,"_2720":53327},[],"Signed response",{"_3227":2247,"_28586":2235,"_19790":53329,"_5":13558,"_26008":53295,"_2720":50666},[],{"_3227":2248,"_28586":2235,"_19790":53331,"_5":13558,"_26008":53295,"_2720":53332},[],"`Good`.",{"_3227":2249,"_28586":2235,"_19790":53334,"_5":13558,"_26008":53295,"_2720":50683},[],{"_3227":2250,"_28586":2235,"_19790":53336,"_5":13558,"_26008":53295,"_2720":53337},[],"`Revoked`, with revocation reason and timestamp.",{"_3227":2251,"_28586":2235,"_19790":53339,"_5":13558,"_26008":53295,"_2720":53340},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3227":2252,"_28586":2235,"_19790":53342,"_5":13558,"_26008":53295,"_2720":53343},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3227":2253,"_28586":2235,"_19790":53345,"_5":13558,"_26008":53295,"_2720":53346},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3227":2254,"_28586":2235,"_19790":53348,"_5":13558,"_26008":53295,"_2720":53349},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3227":2255,"_28586":2235,"_19790":53351,"_5":13558,"_26008":53295,"_2720":53352},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3227":2256,"_28586":2235,"_19790":53354,"_5":13558,"_26008":53299,"_2720":53355},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3227":2257,"_28586":2235,"_19790":53357,"_5":13558,"_26008":53299,"_2720":53358},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3227":2258,"_28586":2235,"_19790":53360,"_5":13558,"_26008":53303,"_2720":53361},[],"The service accepts:",{"_3227":2259,"_28586":2235,"_19790":53363,"_5":13558,"_26008":53303,"_2720":49513},[],{"_3227":2260,"_28586":2235,"_19790":53365,"_5":13558,"_26008":53303,"_2720":53366},[],"VA service path",{"_3227":2261,"_28586":2235,"_19790":53368,"_5":13558,"_26008":53303,"_2720":53369},[],"Format",{"_3227":2262,"_28586":2235,"_19790":53371,"_5":13558,"_26008":53303,"_2720":53372},[],"`POST`",{"_3227":2263,"_28586":2235,"_19790":53374,"_5":13558,"_26008":53303,"_2720":53375},[],"`/ocsp`",{"_3227":2264,"_28586":2235,"_19790":53377,"_5":13558,"_26008":53303,"_2720":53378},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3227":2265,"_28586":2235,"_19790":53380,"_5":13558,"_26008":53303,"_2720":52804},[],{"_3227":2266,"_28586":2235,"_19790":53382,"_5":13558,"_26008":53303,"_2720":53383},[],"`/ocsp/{ocsp_request}`",{"_3227":2267,"_28586":2235,"_19790":53385,"_5":13558,"_26008":53303,"_2720":53386},[],"DER request encoded using padded URL Base64.",{"_3227":2268,"_28586":2235,"_19790":53388,"_5":13558,"_26008":53303,"_2720":53389},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3227":2269,"_28586":2235,"_19790":53391,"_5":13558,"_26008":53307,"_2720":53392},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3227":2270,"_28586":2235,"_19790":53394,"_5":13558,"_26008":53307,"_2720":53395},[],"Generate the request:",{"_3227":2271,"_28586":2235,"_19790":53397,"_5":13558,"_26008":53307,"_2720":53398},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3227":2272,"_28586":2235,"_19790":53400,"_5":13558,"_26008":53307,"_2720":53401},[],"Replace the example URL with the inspected endpoint:",{"_3227":2273,"_28586":2235,"_19790":53403,"_5":13558,"_26008":53307,"_2720":53404},[],"Verify the returned DER:",{"_3227":2274,"_28586":2235,"_19790":53406,"_5":13558,"_26008":53307,"_2720":53407},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3227":2275,"_28586":2235,"_19790":53409,"_5":13558,"_26008":53311,"_2720":53410},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3227":2276,"_28586":2235,"_19790":53412,"_5":13558,"_26008":53311,"_2720":53413},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3227":2277,"_28586":2235,"_19790":53415,"_5":13558,"_26008":53315,"_2720":53416},[],"RFC 6960: OCSP.",{"_3227":2278,"_28586":2235,"_19790":53418,"_5":13558,"_26008":53315,"_2720":53419},[],"OpenSSL: openssl-ocsp.",{"_3227":2279,"_28586":2235,"_19790":53421,"_5":13558,"_26008":53315,"_2720":53422},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3227":2280,"_28586":2235,"_19790":53424,"_5":13558,"_26008":53315,"_2720":52896},[],{"_3227":2281,"_28586":2281,"_5":13916,"_2720":51497,"_28908":53426,"_19790":53427,"_26008":2281},[46300,47749,51497],[],{"_3227":2282,"_28586":2281,"_19790":53429,"_5":13558,"_26008":2281,"_2720":53430},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3227":2283,"_28586":2281,"_5":28905,"_19790":53432,"_26008":53433,"_2720":50807},[],"/docs/platform/pki/overview#start-here",{"_3227":2284,"_28586":2281,"_5":28905,"_19790":53435,"_26008":53436,"_2720":53437},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3227":2285,"_28586":2281,"_5":28905,"_19790":53439,"_26008":53440,"_2720":51341},[],"/docs/platform/pki/overview#core-capabilities",{"_3227":2286,"_28586":2281,"_5":28905,"_19790":53442,"_26008":53443,"_2720":51345},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3227":2287,"_28586":2281,"_5":28905,"_19790":53445,"_26008":53446,"_2720":51349},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3227":2288,"_28586":2281,"_5":28905,"_19790":53448,"_26008":53449,"_2720":51353},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3227":2289,"_28586":2281,"_5":28905,"_19790":53451,"_26008":53452,"_2720":51361},[],"/docs/platform/pki/overview#publish-validation-status",{"_3227":2290,"_28586":2281,"_5":28905,"_19790":53454,"_26008":53455,"_2720":53456},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3227":2291,"_28586":2281,"_5":28905,"_19790":53458,"_26008":53459,"_2720":52291},[],"/docs/platform/pki/overview#continue",{"_3227":2292,"_28586":2281,"_19790":53461,"_5":13558,"_26008":2281,"_2720":53462},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3227":2293,"_28586":2281,"_19790":53464,"_5":13558,"_26008":53433,"_2720":53465},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3227":2294,"_28586":2281,"_19790":53467,"_5":13558,"_26008":53433,"_2720":53468},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3227":2295,"_28586":2281,"_19790":53470,"_5":13558,"_26008":53436,"_2720":53471},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3227":2296,"_28586":2281,"_19790":53473,"_5":13558,"_26008":53436,"_2720":53474},[],"An available cryptographic engine to keep the authority's key.",{"_3227":2297,"_28586":2281,"_19790":53476,"_5":13558,"_26008":53436,"_2720":53477},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3227":2298,"_28586":2281,"_19790":53479,"_5":13558,"_26008":53436,"_2720":53480},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3227":2299,"_28586":2281,"_19790":53482,"_5":13558,"_26008":53436,"_2720":53483},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3227":2300,"_28586":2281,"_19790":53485,"_5":13558,"_26008":53443,"_2720":53486},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3227":2301,"_28586":2281,"_19790":53488,"_5":13558,"_26008":53446,"_2720":53489},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3227":2302,"_28586":2281,"_19790":53491,"_5":13558,"_26008":53449,"_2720":53492},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3227":2303,"_28586":2281,"_19790":53494,"_5":13558,"_26008":53452,"_2720":53495},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3227":2304,"_28586":2281,"_19790":53497,"_5":13558,"_26008":53455,"_2720":53498},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3227":2305,"_28586":2281,"_19790":53500,"_5":13558,"_26008":53455,"_2720":53501},[],"its subject and extensions identify the expected client;",{"_3227":2306,"_28586":2281,"_19790":53503,"_5":13558,"_26008":53455,"_2720":53504},[],"its public key matches the client's private key;",{"_3227":2307,"_28586":2281,"_19790":53506,"_5":13558,"_26008":53455,"_2720":53507},[],"its chain reaches a root trusted by the consumer;",{"_3227":2308,"_28586":2281,"_19790":53509,"_5":13558,"_26008":53455,"_2720":53510},[],"its dates and usages allow the operation;",{"_3227":2309,"_28586":2281,"_19790":53512,"_5":13558,"_26008":53455,"_2720":53513},[],"the consumer applies revocation checks and authorization.",{"_3227":2310,"_28586":2281,"_19790":53515,"_5":13558,"_26008":53455,"_2720":53516},[],"The issuance path includes the first independent checks.",{"_3227":2311,"_28586":2281,"_19790":53518,"_5":13558,"_26008":53459,"_2720":53519},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3227":2312,"_28586":2281,"_19790":53521,"_5":13558,"_26008":53459,"_2720":53522},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3227":2313,"_28586":2281,"_19790":53524,"_5":13558,"_26008":53459,"_2720":53525},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3227":2314,"_28586":2314,"_5":13916,"_2720":53527,"_28908":53528,"_19790":53529,"_26008":2314},"Create your first CA",[46300,47749,51497,50932],[],{"_3227":2315,"_28586":2314,"_19790":53531,"_5":13558,"_26008":2314,"_2720":53532},[],"Create an evaluation root and check its certificate before issuing.",{"_3227":2316,"_28586":2314,"_5":28905,"_19790":53534,"_26008":53535,"_2720":46310},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3227":2317,"_28586":2314,"_5":28905,"_19790":53537,"_26008":53538,"_2720":53539},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3227":2318,"_28586":2314,"_5":28905,"_19790":53541,"_26008":53542,"_2720":53543},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3227":2319,"_28586":2314,"_5":28905,"_19790":53545,"_26008":53546,"_2720":53547},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3227":2320,"_28586":2314,"_5":28905,"_19790":53549,"_26008":53550,"_2720":53551},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3227":2321,"_28586":2314,"_5":28905,"_19790":53553,"_26008":53554,"_2720":53555},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3227":2322,"_28586":2314,"_5":28905,"_19790":53557,"_26008":53558,"_2720":53559},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3227":2323,"_28586":2314,"_5":28905,"_19790":53561,"_26008":53562,"_2720":51190},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3227":2324,"_28586":2314,"_5":28905,"_19790":53564,"_26008":53565,"_2720":46334},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3227":2325,"_28586":2314,"_19790":53567,"_5":13558,"_26008":2314,"_2720":53568},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3227":2326,"_28586":2314,"_19790":53570,"_5":13558,"_26008":53535,"_2720":53571},[],"Console access and permission to create keys and authorities.",{"_3227":2327,"_28586":2314,"_19790":53573,"_5":13558,"_26008":53535,"_2720":53574},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3227":2328,"_28586":2314,"_19790":53576,"_5":13558,"_26008":53535,"_2720":53577},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3227":2329,"_28586":2314,"_19790":53579,"_5":13558,"_26008":53535,"_2720":53580},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3227":2330,"_28586":2314,"_19790":53582,"_5":13558,"_26008":53538,"_2720":53583},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3227":2331,"_28586":2314,"_19790":53585,"_5":13558,"_26008":53538,"_2720":53586},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3227":2332,"_28586":2314,"_19790":53588,"_5":13558,"_26008":53542,"_2720":53589},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3227":2333,"_28586":2314,"_19790":53591,"_5":13558,"_26008":53542,"_2720":53592},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3227":2334,"_28586":2314,"_19790":53594,"_5":13558,"_26008":53546,"_2720":53595},[],"Select **Root CA** and complete:",{"_3227":2335,"_28586":2314,"_19790":53597,"_5":13558,"_26008":53546,"_2720":53598},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3227":2336,"_28586":2314,"_19790":53600,"_5":13558,"_26008":53546,"_2720":53601},[],"**Subject**: organization and country details for your evaluation.",{"_3227":2337,"_28586":2314,"_19790":53603,"_5":13558,"_26008":53546,"_2720":53604},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3227":2338,"_28586":2314,"_19790":53606,"_5":13558,"_26008":53546,"_2720":53607},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3227":2339,"_28586":2314,"_19790":53609,"_5":13558,"_26008":53546,"_2720":53610},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3227":2340,"_28586":2314,"_19790":53612,"_5":13558,"_26008":53550,"_2720":53613},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3227":2341,"_28586":2314,"_19790":53615,"_5":13558,"_26008":53554,"_2720":53616},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3227":2342,"_28586":2314,"_19790":53618,"_5":13558,"_26008":53554,"_2720":53619},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3227":2343,"_28586":2314,"_19790":53621,"_5":13558,"_26008":53558,"_2720":53622},[],"Run from the directory where you saved `ca.pem`:",{"_3227":2344,"_28586":2314,"_19790":53624,"_5":13558,"_26008":53558,"_2720":53625},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3227":2345,"_28586":2314,"_19790":53627,"_5":13558,"_26008":53558,"_2720":53628},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3227":2346,"_28586":2314,"_19790":53630,"_5":13558,"_26008":53562,"_2720":53631},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3227":2347,"_28586":2314,"_19790":53633,"_5":13558,"_26008":53562,"_2720":53634},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3227":2348,"_28586":2314,"_19790":53636,"_5":13558,"_26008":53562,"_2720":53637},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3227":2349,"_28586":2314,"_19790":53639,"_5":13558,"_26008":53562,"_2720":53640},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3227":2350,"_28586":2314,"_19790":53642,"_5":13558,"_26008":53565,"_2720":53643},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3227":2351,"_28586":2351,"_5":13916,"_2720":53645,"_28908":53646,"_19790":53647,"_26008":2351},"Issue and verify a certificate",[46300,47749,51497,50932],[],{"_3227":2352,"_28586":2351,"_19790":53649,"_5":13558,"_26008":2351,"_2720":53650},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3227":2353,"_28586":2351,"_5":28905,"_19790":53652,"_26008":53653,"_2720":46310},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3227":2354,"_28586":2351,"_5":28905,"_19790":53655,"_26008":53656,"_2720":53657},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3227":2355,"_28586":2351,"_5":28905,"_19790":53659,"_26008":53660,"_2720":53661},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3227":2356,"_28586":2351,"_5":28905,"_19790":53663,"_26008":53664,"_2720":53665},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3227":2357,"_28586":2351,"_5":28905,"_19790":53667,"_26008":53668,"_2720":53669},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3227":2358,"_28586":2351,"_5":28905,"_19790":53671,"_26008":53672,"_2720":53673},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3227":2359,"_28586":2351,"_5":28905,"_19790":53675,"_26008":53676,"_2720":53677},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3227":2360,"_28586":2351,"_5":28905,"_19790":53679,"_26008":53680,"_2720":53681},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3227":2361,"_28586":2351,"_5":28905,"_19790":53683,"_26008":53684,"_2720":53685},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3227":2362,"_28586":2351,"_5":28905,"_19790":53687,"_26008":53688,"_2720":53689},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3227":2363,"_28586":2351,"_5":28905,"_19790":53691,"_26008":53692,"_2720":51190},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3227":2364,"_28586":2351,"_5":28905,"_19790":53694,"_26008":53695,"_2720":46334},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3227":2365,"_28586":2351,"_19790":53697,"_5":13558,"_26008":2351,"_2720":53698},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3227":2366,"_28586":2351,"_19790":53700,"_5":13558,"_26008":53653,"_2720":53701},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3227":2367,"_28586":2351,"_19790":53703,"_5":13558,"_26008":53653,"_2720":53704},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3227":2368,"_28586":2351,"_19790":53706,"_5":13558,"_26008":53653,"_2720":53707},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3227":2369,"_28586":2351,"_19790":53709,"_5":13558,"_26008":53653,"_2720":53710},[],"A client identifier: here we use `device-001`.",{"_3227":2370,"_28586":2351,"_19790":53712,"_5":13558,"_26008":53653,"_2720":53713},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3227":2371,"_28586":2351,"_19790":53715,"_5":13558,"_26008":53656,"_2720":53716},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3227":2372,"_28586":2351,"_19790":53718,"_5":13558,"_26008":53660,"_2720":53719},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3227":2373,"_28586":2351,"_19790":53721,"_5":13558,"_26008":53660,"_2720":53722},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3227":2374,"_28586":2351,"_19790":53724,"_5":13558,"_26008":53664,"_2720":53725},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3227":2375,"_28586":2351,"_19790":53727,"_5":13558,"_26008":53664,"_2720":53728},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3227":2376,"_28586":2351,"_19790":53730,"_5":13558,"_26008":53668,"_2720":53731},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3227":2377,"_28586":2351,"_19790":53733,"_5":13558,"_26008":53668,"_2720":53734},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3227":2378,"_28586":2351,"_19790":53736,"_5":13558,"_26008":53672,"_2720":53737},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3227":2379,"_28586":2351,"_19790":53739,"_5":13558,"_26008":53676,"_2720":53740},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3227":2380,"_28586":2351,"_19790":53742,"_5":13558,"_26008":53680,"_2720":53743},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3227":2381,"_28586":2351,"_19790":53745,"_5":13558,"_26008":53684,"_2720":53746},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3227":2382,"_28586":2351,"_19790":53748,"_5":13558,"_26008":53684,"_2720":53749},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3227":2383,"_28586":2351,"_19790":53751,"_5":13558,"_26008":53684,"_2720":53752},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3227":2384,"_28586":2351,"_19790":53754,"_5":13558,"_26008":53688,"_2720":53755},[],"In Bash, compare the two public-key digests:",{"_3227":2385,"_28586":2351,"_19790":53757,"_5":13558,"_26008":53688,"_2720":53758},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3227":2386,"_28586":2351,"_19790":53760,"_5":13558,"_26008":53688,"_2720":53761},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3227":2387,"_28586":2351,"_19790":53763,"_5":13558,"_26008":53692,"_2720":51274},[],{"_3227":2388,"_28586":2351,"_19790":53765,"_5":13558,"_26008":53692,"_2720":53766},[],"What to review",{"_3227":2389,"_28586":2351,"_19790":53768,"_5":13558,"_26008":53692,"_2720":53769},[],"The CA rejects issuance",{"_3227":2390,"_28586":2351,"_19790":53771,"_5":13558,"_26008":53692,"_2720":53772},[],"Permissions, CA state and key, algorithm and profile.",{"_3227":2391,"_28586":2351,"_19790":53774,"_5":13558,"_26008":53692,"_2720":53775},[],"Different subject or usages",{"_3227":2392,"_28586":2351,"_19790":53777,"_5":13558,"_26008":53692,"_2720":53778},[],"Applied profile and requested values.",{"_3227":2393,"_28586":2351,"_19790":53780,"_5":13558,"_26008":53692,"_2720":53781},[],"Issuer cannot be found",{"_3227":2394,"_28586":2351,"_19790":53783,"_5":13558,"_26008":53692,"_2720":53784},[],"Downloaded CA and required intermediate chain.",{"_3227":2395,"_28586":2351,"_19790":53786,"_5":13558,"_26008":53692,"_2720":53787},[],"Validity fails",{"_3227":2396,"_28586":2351,"_19790":53789,"_5":13558,"_26008":53692,"_2720":53790},[],"Certificate and CA dates, and the computer's clock.",{"_3227":2397,"_28586":2351,"_19790":53792,"_5":13558,"_26008":53692,"_2720":53793},[],"Public-key digests differ",{"_3227":2398,"_28586":2351,"_19790":53795,"_5":13558,"_26008":53692,"_2720":53796},[],"Certificate and key files from the same issuance.",{"_3227":2399,"_28586":2351,"_19790":53798,"_5":13558,"_26008":53692,"_2720":53799},[],"See PKI diagnostics to narrow an issuance failure.",{"_3227":2400,"_28586":2351,"_19790":53801,"_5":13558,"_26008":53695,"_2720":53802},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3227":2401,"_28586":2351,"_19790":53804,"_5":13558,"_26008":53695,"_2720":53805},[],"Manage certificates for inspection, status and revocation.",{"_3227":2402,"_28586":2351,"_19790":53807,"_5":13558,"_26008":53695,"_2720":53808},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3227":2403,"_28586":2351,"_19790":53810,"_5":13558,"_26008":53695,"_2720":53811},[],"Prepare EST for the device to request its next identities.",{"_3227":2404,"_28586":2351,"_19790":53813,"_5":13558,"_26008":53695,"_2720":53814},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3227":2405,"_28586":2405,"_5":13916,"_2720":53816,"_28908":53817,"_19790":53818,"_26008":2405},"PKI getting started",[46300,47749,51497,50932],[],{"_3227":2406,"_28586":2405,"_19790":53820,"_5":13558,"_26008":2405,"_2720":53821},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3227":2407,"_28586":2405,"_5":28905,"_19790":53823,"_26008":53824,"_2720":46310},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3227":2408,"_28586":2405,"_5":28905,"_19790":53826,"_26008":53827,"_2720":53828},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3227":2409,"_28586":2405,"_5":28905,"_19790":53830,"_26008":53831,"_2720":51124},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3227":2410,"_28586":2405,"_5":28905,"_19790":53833,"_26008":53834,"_2720":53835},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3227":2411,"_28586":2405,"_19790":53837,"_5":13558,"_26008":2405,"_2720":53838},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3227":2412,"_28586":2405,"_19790":53840,"_5":13558,"_26008":53824,"_2720":53841},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3227":2413,"_28586":2405,"_19790":53843,"_5":13558,"_26008":53824,"_2720":53844},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3227":2414,"_28586":2405,"_19790":53846,"_5":13558,"_26008":53824,"_2720":53847},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3227":2415,"_28586":2405,"_19790":53849,"_5":13558,"_26008":53824,"_2720":53850},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3227":2416,"_28586":2405,"_19790":53852,"_5":13558,"_26008":53824,"_2720":53853},[],"A working directory with restricted access for the downloaded key.",{"_3227":2417,"_28586":2405,"_19790":53855,"_5":13558,"_26008":53827,"_2720":53856},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3227":2418,"_28586":2405,"_19790":53858,"_5":13558,"_26008":53827,"_2720":53859},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3227":2419,"_28586":2405,"_19790":53861,"_5":13558,"_26008":53827,"_2720":53862},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3227":2420,"_28586":2405,"_19790":53864,"_5":13558,"_26008":53827,"_2720":53865},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3227":2421,"_28586":2405,"_19790":53867,"_5":13558,"_26008":53831,"_2720":53868},[],"File or resource",{"_3227":2422,"_28586":2405,"_19790":53870,"_5":13558,"_26008":53831,"_2720":51121},[],{"_3227":2423,"_28586":2405,"_19790":53872,"_5":13558,"_26008":53831,"_2720":53873},[],"Active root CA and `ca.pem`",{"_3227":2424,"_28586":2405,"_19790":53875,"_5":13558,"_26008":53831,"_2720":53876},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3227":2425,"_28586":2405,"_19790":53878,"_5":13558,"_26008":53831,"_2720":53879},[],"End-entity certificate and `device.crt`",{"_3227":2426,"_28586":2405,"_19790":53881,"_5":13558,"_26008":53831,"_2720":53882},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3227":2427,"_28586":2405,"_19790":53884,"_5":13558,"_26008":53831,"_2720":53885},[],"Private key `device.key`",{"_3227":2428,"_28586":2405,"_19790":53887,"_5":13558,"_26008":53831,"_2720":53888},[],"Its public key matches the one included in `device.crt`.",{"_3227":2429,"_28586":2405,"_19790":53890,"_5":13558,"_26008":53831,"_2720":53891},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3227":2430,"_28586":2405,"_19790":53893,"_5":13558,"_26008":53834,"_2720":53894},[],"To operate certificates, continue with Certificates and Validation.",{"_3227":2431,"_28586":2405,"_19790":53896,"_5":13558,"_26008":53834,"_2720":53897},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3227":2432,"_28586":2405,"_19790":53899,"_5":13558,"_26008":53834,"_2720":53900},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3227":2433,"_28586":2433,"_5":13916,"_2720":53902,"_28908":53903,"_19790":53904,"_26008":2433},"PKI troubleshooting",[46300,47749,51497,50303],[],{"_3227":2434,"_28586":2433,"_19790":53906,"_5":13558,"_26008":2433,"_2720":53907},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3227":2435,"_28586":2433,"_5":28905,"_19790":53909,"_26008":53910,"_2720":53911},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3227":2436,"_28586":2433,"_5":28905,"_19790":53913,"_26008":53914,"_2720":53915},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3227":2437,"_28586":2433,"_5":28905,"_19790":53917,"_26008":53918,"_2720":53919},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3227":2438,"_28586":2433,"_19790":53921,"_5":13558,"_26008":2433,"_2720":53922},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3227":2439,"_28586":2433,"_19790":53924,"_5":13558,"_26008":2433,"_2720":53925},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3227":2440,"_28586":2433,"_19790":53927,"_5":13558,"_26008":53910,"_2720":51121},[],{"_3227":2441,"_28586":2433,"_19790":53929,"_5":13558,"_26008":53910,"_2720":53930},[],"What to inspect",{"_3227":2442,"_28586":2433,"_19790":53932,"_5":13558,"_26008":53910,"_2720":46334},[],{"_3227":2443,"_28586":2433,"_19790":53934,"_5":13558,"_26008":53910,"_2720":53935},[],"CA",{"_3227":2444,"_28586":2433,"_19790":53937,"_5":13558,"_26008":53910,"_2720":53938},[],"Exists, is active and has usable dates.",{"_3227":2445,"_28586":2433,"_19790":53940,"_5":13558,"_26008":53910,"_2720":53941},[],"Authorities.",{"_3227":2446,"_28586":2433,"_19790":53943,"_5":13558,"_26008":53910,"_2720":53944},[],"Key",{"_3227":2447,"_28586":2433,"_19790":53946,"_5":13558,"_26008":53910,"_2720":53947},[],"The record has a usable private key and the engine can sign.",{"_3227":2448,"_28586":2433,"_19790":53949,"_5":13558,"_26008":53910,"_2720":53950},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3227":2449,"_28586":2433,"_19790":53952,"_5":13558,"_26008":53910,"_2720":53953},[],"CSR",{"_3227":2450,"_28586":2433,"_19790":53955,"_5":13558,"_26008":53910,"_2720":53956},[],"Correct PEM and verifiable signature.",{"_3227":2451,"_28586":2433,"_19790":53958,"_5":13558,"_26008":53910,"_2720":53959},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3227":2452,"_28586":2433,"_19790":53961,"_5":13558,"_26008":53910,"_2720":53962},[],"Profile",{"_3227":2453,"_28586":2433,"_19790":53964,"_5":13558,"_26008":53910,"_2720":53965},[],"Selected source, existing ID, allowed algorithm and size.",{"_3227":2454,"_28586":2433,"_19790":53967,"_5":13558,"_26008":53910,"_2720":53968},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3227":2455,"_28586":2433,"_19790":53970,"_5":13558,"_26008":53910,"_2720":51274},[],{"_3227":2456,"_28586":2433,"_19790":53972,"_5":13558,"_26008":53910,"_2720":53973},[],"Appropriate subject, SAN, usages and dates.",{"_3227":2457,"_28586":2433,"_19790":53975,"_5":13558,"_26008":53910,"_2720":53976},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3227":2458,"_28586":2433,"_19790":53978,"_5":13558,"_26008":53910,"_2720":53979},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3227":2459,"_28586":2433,"_19790":53981,"_5":13558,"_26008":53910,"_2720":53982},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3227":2460,"_28586":2433,"_19790":53984,"_5":13558,"_26008":53914,"_2720":53985},[],"Check each boundary independently:",{"_3227":2461,"_28586":2433,"_19790":53987,"_5":13558,"_26008":53914,"_2720":53988},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3227":2462,"_28586":2433,"_19790":53990,"_5":13558,"_26008":53914,"_2720":53991},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3227":2463,"_28586":2433,"_19790":53993,"_5":13558,"_26008":53914,"_2720":53994},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3227":2464,"_28586":2433,"_19790":53996,"_5":13558,"_26008":53914,"_2720":53997},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3227":2465,"_28586":2433,"_19790":53999,"_5":13558,"_26008":53914,"_2720":54000},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3227":2466,"_28586":2433,"_19790":54002,"_5":13558,"_26008":53914,"_2720":54003},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3227":2467,"_28586":2433,"_19790":54005,"_5":13558,"_26008":53918,"_2720":54006},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3227":2468,"_28586":2433,"_19790":54008,"_5":13558,"_26008":53918,"_2720":54009},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3227":2469,"_28586":2469,"_5":13916,"_2720":54011,"_28908":54012,"_19790":54014,"_26008":2469},"3.8.0 to 4.0.0",[46300,54013],"Upgrades",[],{"_3227":2470,"_28586":2469,"_19790":54016,"_5":13558,"_26008":2469,"_2720":54017},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3227":2471,"_28586":2469,"_5":28905,"_19790":54019,"_26008":54020,"_2720":54021},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3227":2472,"_28586":2469,"_5":28905,"_19790":54023,"_26008":54024,"_2720":54025},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3227":2473,"_28586":2469,"_5":28905,"_19790":54027,"_26008":54028,"_2720":54029},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3227":2474,"_28586":2469,"_5":28905,"_19790":54031,"_26008":54032,"_2720":54033},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3227":2475,"_28586":2469,"_5":28905,"_19790":54035,"_26008":54036,"_2720":54037},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3227":2476,"_28586":2469,"_5":28905,"_19790":54039,"_26008":54040,"_2720":54041},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3227":2477,"_28586":2469,"_5":28905,"_19790":54043,"_26008":54044,"_2720":54045},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3227":2478,"_28586":2469,"_5":28905,"_19790":54047,"_26008":54048,"_2720":54049},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3227":2479,"_28586":2469,"_5":28905,"_19790":54051,"_26008":54052,"_2720":54053},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3227":2480,"_28586":2469,"_5":28905,"_19790":54055,"_26008":54056,"_2720":54057},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3227":2481,"_28586":2469,"_5":28905,"_19790":54059,"_26008":54060,"_2720":54061},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3227":2482,"_28586":2469,"_5":28905,"_19790":54063,"_26008":54064,"_2720":54065},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3227":2483,"_28586":2469,"_5":28905,"_19790":54067,"_26008":54068,"_2720":54069},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3227":2484,"_28586":2469,"_5":28905,"_19790":54071,"_26008":54072,"_2720":54073},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3227":2485,"_28586":2469,"_5":28905,"_19790":54075,"_26008":54076,"_2720":54077},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3227":2486,"_28586":2469,"_5":28905,"_19790":54079,"_26008":54080,"_2720":54081},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3227":2487,"_28586":2469,"_5":28905,"_19790":54083,"_26008":54084,"_2720":54085},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3227":2488,"_28586":2469,"_5":28905,"_19790":54087,"_26008":54088,"_2720":54089},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3227":2489,"_28586":2469,"_5":28905,"_19790":54091,"_26008":54092,"_2720":54093},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3227":2490,"_28586":2469,"_5":28905,"_19790":54095,"_26008":54096,"_2720":54097},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3227":2491,"_28586":2469,"_5":28905,"_19790":54099,"_26008":54100,"_2720":54101},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3227":2492,"_28586":2469,"_5":28905,"_19790":54103,"_26008":54104,"_2720":54105},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3227":2493,"_28586":2469,"_5":28905,"_19790":54107,"_26008":54108,"_2720":54109},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3227":2494,"_28586":2469,"_5":28905,"_19790":54111,"_26008":54112,"_2720":54113},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3227":2495,"_28586":2469,"_5":28905,"_19790":54115,"_26008":54116,"_2720":54117},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3227":2496,"_28586":2469,"_5":28905,"_19790":54119,"_26008":54120,"_2720":54121},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3227":2497,"_28586":2469,"_5":28905,"_19790":54123,"_26008":54124,"_2720":54125},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3227":2498,"_28586":2469,"_5":28905,"_19790":54127,"_26008":54128,"_2720":54129},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3227":2499,"_28586":2469,"_5":28905,"_19790":54131,"_26008":54132,"_2720":54133},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3227":2500,"_28586":2469,"_5":28905,"_19790":54135,"_26008":54136,"_2720":54137},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3227":2501,"_28586":2469,"_5":28905,"_19790":54139,"_26008":54140,"_2720":54141},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3227":2502,"_28586":2469,"_5":28905,"_19790":54143,"_26008":54144,"_2720":54145},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3227":2503,"_28586":2469,"_5":28905,"_19790":54147,"_26008":54148,"_2720":54149},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3227":2504,"_28586":2469,"_5":28905,"_19790":54151,"_26008":54152,"_2720":50303},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3227":2505,"_28586":2469,"_5":28905,"_19790":54154,"_26008":54155,"_2720":54156},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3227":2506,"_28586":2469,"_5":28905,"_19790":54158,"_26008":54159,"_2720":54160},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3227":2507,"_28586":2469,"_19790":54162,"_5":13558,"_26008":2469,"_2720":54163},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3227":2508,"_28586":2469,"_19790":54165,"_5":13558,"_26008":2469,"_2720":54166},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3227":2509,"_28586":2469,"_19790":54168,"_5":13558,"_26008":2469,"_2720":54169},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3227":2510,"_28586":2469,"_19790":54171,"_5":13558,"_26008":2469,"_2720":54172},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3227":2511,"_28586":2469,"_19790":54174,"_5":13558,"_26008":2469,"_2720":54175},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3227":2512,"_28586":2469,"_19790":54177,"_5":13558,"_26008":2469,"_2720":54178},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3227":2513,"_28586":2469,"_19790":54180,"_5":13558,"_26008":2469,"_2720":54181},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3227":2514,"_28586":2469,"_19790":54183,"_5":13558,"_26008":54024,"_2720":54184},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3227":2515,"_28586":2469,"_19790":54186,"_5":13558,"_26008":54024,"_2720":54187},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3227":2516,"_28586":2469,"_19790":54189,"_5":13558,"_26008":54028,"_2720":54190},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3227":2517,"_28586":2469,"_19790":54192,"_5":13558,"_26008":54028,"_2720":54193},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3227":2518,"_28586":2469,"_19790":54195,"_5":13558,"_26008":54032,"_2720":54196},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3227":2519,"_28586":2469,"_19790":54198,"_5":13558,"_26008":54036,"_2720":54199},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3227":2520,"_28586":2469,"_19790":54201,"_5":13558,"_26008":54036,"_2720":54202},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3227":2521,"_28586":2469,"_19790":54204,"_5":13558,"_26008":54036,"_2720":54205},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3227":2522,"_28586":2469,"_19790":54207,"_5":13558,"_26008":54036,"_2720":54208},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3227":2523,"_28586":2469,"_19790":54210,"_5":13558,"_26008":54036,"_2720":54211},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3227":2524,"_28586":2469,"_19790":54213,"_5":13558,"_26008":54040,"_2720":54214},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3227":2525,"_28586":2469,"_19790":54216,"_5":13558,"_26008":54040,"_2720":54217},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3227":2526,"_28586":2469,"_19790":54219,"_5":13558,"_26008":54040,"_2720":54220},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3227":2527,"_28586":2469,"_19790":54222,"_5":13558,"_26008":54040,"_2720":54223},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3227":2528,"_28586":2469,"_19790":54225,"_5":13558,"_26008":54040,"_2720":54226},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3227":2529,"_28586":2469,"_19790":54228,"_5":13558,"_26008":54044,"_2720":54229},[],"Change",{"_3227":2530,"_28586":2469,"_19790":54231,"_5":13558,"_26008":54044,"_2720":54232},[],"Who is affected",{"_3227":2531,"_28586":2469,"_19790":54234,"_5":13558,"_26008":54044,"_2720":54235},[],"Severity",{"_3227":2532,"_28586":2469,"_19790":54237,"_5":13558,"_26008":54044,"_2720":52833},[],{"_3227":2533,"_28586":2469,"_19790":54239,"_5":13558,"_26008":54044,"_2720":54053},[],{"_3227":2534,"_28586":2469,"_19790":54241,"_5":13558,"_26008":54044,"_2720":54242},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3227":2535,"_28586":2469,"_19790":54244,"_5":13558,"_26008":54044,"_2720":54245},[],"High: KMS and VA start on empty volumes",{"_3227":2536,"_28586":2469,"_19790":54247,"_5":13558,"_26008":54044,"_2720":54248},[],"Copy the data into the new volumes",{"_3227":2537,"_28586":2469,"_19790":54250,"_5":13558,"_26008":54044,"_2720":54057},[],{"_3227":2538,"_28586":2469,"_19790":54252,"_5":13558,"_26008":54044,"_2720":54253},[],"Every Helm release",{"_3227":2539,"_28586":2469,"_19790":54255,"_5":13558,"_26008":54044,"_2720":54256},[],"High: `helm upgrade` fails",{"_3227":2540,"_28586":2469,"_19790":54258,"_5":13558,"_26008":54044,"_2720":54259},[],"Remove or rename legacy keys",{"_3227":2541,"_28586":2469,"_19790":54261,"_5":13558,"_26008":54044,"_2720":54061},[],{"_3227":2542,"_28586":2469,"_19790":54263,"_5":13558,"_26008":54044,"_2720":54264},[],"Every deployment",{"_3227":2543,"_28586":2469,"_19790":54266,"_5":13558,"_26008":54044,"_2720":54267},[],"High: without a bootstrap principal there is no administrator",{"_3227":2544,"_28586":2469,"_19790":54269,"_5":13558,"_26008":54044,"_2720":54270},[],"Configure `services.authz`",{"_3227":2545,"_28586":2469,"_19790":54272,"_5":13558,"_26008":54044,"_2720":54065},[],{"_3227":2546,"_28586":2469,"_19790":54274,"_5":13558,"_26008":54044,"_2720":54253},[],{"_3227":2547,"_28586":2469,"_19790":54276,"_5":13558,"_26008":54044,"_2720":54277},[],"High: `helm upgrade` fails on the old keys",{"_3227":2548,"_28586":2469,"_19790":54279,"_5":13558,"_26008":54044,"_2720":54280},[],"Move JWKS and roles into `services.authz`",{"_3227":2549,"_28586":2469,"_19790":54282,"_5":13558,"_26008":54044,"_2720":54085},[],{"_3227":2550,"_28586":2469,"_19790":54284,"_5":13558,"_26008":54044,"_2720":54285},[],"3.8.0 deployments with per-service databases",{"_3227":2551,"_28586":2469,"_19790":54287,"_5":13558,"_26008":54044,"_2720":54288},[],"High: services find no data, or a migration aborts",{"_3227":2552,"_28586":2469,"_19790":54290,"_5":13558,"_26008":54044,"_2720":54291},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3227":2553,"_28586":2469,"_19790":54293,"_5":13558,"_26008":54044,"_2720":54089},[],{"_3227":2554,"_28586":2469,"_19790":54295,"_5":13558,"_26008":54044,"_2720":54296},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3227":2555,"_28586":2469,"_19790":54298,"_5":13558,"_26008":54044,"_2720":54299},[],"High: the backend no longer starts with them",{"_3227":2556,"_28586":2469,"_19790":54301,"_5":13558,"_26008":54044,"_2720":54302},[],"Move to PostgreSQL before upgrading",{"_3227":2557,"_28586":2469,"_19790":54304,"_5":13558,"_26008":54044,"_2720":54305},[],"Webhooks with file references",{"_3227":2558,"_28586":2469,"_19790":54307,"_5":13558,"_26008":54044,"_2720":54308},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3227":2559,"_28586":2469,"_19790":54310,"_5":13558,"_26008":54044,"_2720":54311},[],"High: enrollments calling the webhook fail",{"_3227":2560,"_28586":2469,"_19790":54313,"_5":13558,"_26008":54044,"_2720":54314},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3227":2561,"_28586":2469,"_19790":54316,"_5":13558,"_26008":54044,"_2720":54069},[],{"_3227":2562,"_28586":2469,"_19790":54318,"_5":13558,"_26008":54044,"_2720":54319},[],"Releases with per-service identity overrides or mounted key material",{"_3227":2563,"_28586":2469,"_19790":54321,"_5":13558,"_26008":54044,"_2720":54322},[],"Medium: services cannot read their files",{"_3227":2564,"_28586":2469,"_19790":54324,"_5":13558,"_26008":54044,"_2720":54325},[],"Remove the overrides and fix volume ownership",{"_3227":2565,"_28586":2469,"_19790":54327,"_5":13558,"_26008":54044,"_2720":54073},[],{"_3227":2566,"_28586":2469,"_19790":54329,"_5":13558,"_26008":54044,"_2720":54330},[],"Releases that set `amqp.tls`",{"_3227":2567,"_28586":2469,"_19790":54332,"_5":13558,"_26008":54044,"_2720":54333},[],"Medium: clients connect to the wrong port",{"_3227":2568,"_28586":2469,"_19790":54335,"_5":13558,"_26008":54044,"_2720":54336},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3227":2569,"_28586":2469,"_19790":54338,"_5":13558,"_26008":54044,"_2720":54093},[],{"_3227":2570,"_28586":2469,"_19790":54340,"_5":13558,"_26008":54044,"_2720":54341},[],"Installations whose CA keys predate the KMS",{"_3227":2571,"_28586":2469,"_19790":54343,"_5":13558,"_26008":54044,"_2720":54344},[],"Medium: CA keys stay unmanaged",{"_3227":2572,"_28586":2469,"_19790":54346,"_5":13558,"_26008":54044,"_2720":54347},[],"Run the CA-to-KMS migration",{"_3227":2573,"_28586":2469,"_19790":54349,"_5":13558,"_26008":54044,"_2720":54350},[],"Receiver certificate verification",{"_3227":2574,"_28586":2469,"_19790":54352,"_5":13558,"_26008":54044,"_2720":54353},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3227":2575,"_28586":2469,"_19790":54355,"_5":13558,"_26008":54044,"_2720":54356},[],"Medium: credentials go to an unverified receiver",{"_3227":2576,"_28586":2469,"_19790":54358,"_5":13558,"_26008":54044,"_2720":54359},[],"Set `insecure_skip_verify` to `false`",{"_3227":2577,"_28586":2469,"_19790":54361,"_5":13558,"_26008":54044,"_2720":54105},[],{"_3227":2578,"_28586":2469,"_19790":54363,"_5":13558,"_26008":54044,"_2720":54364},[],"Scripts and consoles that edit DMSs through the API",{"_3227":2579,"_28586":2469,"_19790":54366,"_5":13558,"_26008":54044,"_2720":54367},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3227":2580,"_28586":2469,"_19790":54369,"_5":13558,"_26008":54044,"_2720":54370},[],"Read the DMS before editing and use the new field",{"_3227":2581,"_28586":2469,"_19790":54372,"_5":13558,"_26008":54044,"_2720":54121},[],{"_3227":2582,"_28586":2469,"_19790":54374,"_5":13558,"_26008":54044,"_2720":54375},[],"Consumers that read the device `events` field",{"_3227":2583,"_28586":2469,"_19790":54377,"_5":13558,"_26008":54044,"_2720":54378},[],"Medium: the field disappears",{"_3227":2584,"_28586":2469,"_19790":54380,"_5":13558,"_26008":54044,"_2720":54381},[],"Use the new event endpoints",{"_3227":2585,"_28586":2469,"_19790":54383,"_5":13558,"_26008":54044,"_2720":54077},[],{"_3227":2586,"_28586":2469,"_19790":54385,"_5":13558,"_26008":54044,"_2720":54386},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3227":2587,"_28586":2469,"_19790":54388,"_5":13558,"_26008":54044,"_2720":54389},[],"Low to medium: validation errors or changed defaults",{"_3227":2588,"_28586":2469,"_19790":54391,"_5":13558,"_26008":54044,"_2720":54392},[],"Update the values file",{"_3227":2589,"_28586":2469,"_19790":54394,"_5":13558,"_26008":54044,"_2720":54113},[],{"_3227":2590,"_28586":2469,"_19790":54396,"_5":13558,"_26008":54044,"_2720":54397},[],"Clients that send the DMS ID in the update body",{"_3227":2591,"_28586":2469,"_19790":54399,"_5":13558,"_26008":54044,"_2720":54400},[],"Low: the ID in the URL wins",{"_3227":2592,"_28586":2469,"_19790":54402,"_5":13558,"_26008":54044,"_2720":54403},[],"Send the ID in the URL",{"_3227":2593,"_28586":2469,"_19790":54405,"_5":13558,"_26008":54044,"_2720":54117},[],{"_3227":2594,"_28586":2469,"_19790":54407,"_5":13558,"_26008":54044,"_2720":54408},[],"Consumers that match on certificate `type`",{"_3227":2595,"_28586":2469,"_19790":54410,"_5":13558,"_26008":54044,"_2720":54411},[],"Low: two values are renamed",{"_3227":2596,"_28586":2469,"_19790":54413,"_5":13558,"_26008":54044,"_2720":54414},[],"Adapt consumers",{"_3227":2597,"_28586":2469,"_19790":54416,"_5":13558,"_26008":54044,"_2720":54109},[],{"_3227":2598,"_28586":2469,"_19790":54418,"_5":13558,"_26008":54044,"_2720":54419},[],"Any DMS",{"_3227":2599,"_28586":2469,"_19790":54421,"_5":13558,"_26008":54044,"_2720":54422},[],"Low: informational",{"_3227":2600,"_28586":2469,"_19790":54424,"_5":13558,"_26008":54044,"_2720":54425},[],"Read both blocks before editing",{"_3227":2601,"_28586":2469,"_19790":54427,"_5":13558,"_26008":54052,"_2720":54428},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3227":2602,"_28586":2469,"_19790":54430,"_5":13558,"_26008":54052,"_2720":54431},[],"Step 4 of the migration guide copies the data.",{"_3227":2603,"_28586":2469,"_19790":54433,"_5":13558,"_26008":54056,"_2720":54434},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3227":2604,"_28586":2469,"_19790":54436,"_5":13558,"_26008":54060,"_2720":54437},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3227":2605,"_28586":2469,"_19790":54439,"_5":13558,"_26008":54064,"_2720":54440},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3227":2606,"_28586":2469,"_19790":54442,"_5":13558,"_26008":54068,"_2720":54443},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3227":2607,"_28586":2469,"_19790":54445,"_5":13558,"_26008":54068,"_2720":54446},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3227":2608,"_28586":2469,"_19790":54448,"_5":13558,"_26008":54072,"_2720":54449},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3227":2609,"_28586":2469,"_19790":54451,"_5":13558,"_26008":54076,"_2720":54452},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3227":2610,"_28586":2469,"_19790":54454,"_5":13558,"_26008":54076,"_2720":54455},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3227":2611,"_28586":2469,"_19790":54457,"_5":13558,"_26008":54076,"_2720":54458},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3227":2612,"_28586":2469,"_19790":54460,"_5":13558,"_26008":54076,"_2720":54461},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3227":2613,"_28586":2469,"_19790":54463,"_5":13558,"_26008":54076,"_2720":54464},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3227":2614,"_28586":2469,"_19790":54466,"_5":13558,"_26008":54076,"_2720":54467},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3227":2615,"_28586":2469,"_19790":54469,"_5":13558,"_26008":54084,"_2720":54470},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3227":2616,"_28586":2469,"_19790":54472,"_5":13558,"_26008":54084,"_2720":54473},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3227":2617,"_28586":2469,"_19790":54475,"_5":13558,"_26008":54084,"_2720":54476},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3227":2618,"_28586":2469,"_19790":54478,"_5":13558,"_26008":54084,"_2720":54479},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3227":2619,"_28586":2469,"_19790":54481,"_5":13558,"_26008":54084,"_2720":54482},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3227":2620,"_28586":2469,"_19790":54484,"_5":13558,"_26008":54088,"_2720":54485},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3227":2621,"_28586":2469,"_19790":54487,"_5":13558,"_26008":54092,"_2720":54488},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3227":2622,"_28586":2469,"_19790":54490,"_5":13558,"_26008":54092,"_2720":54491},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3227":2623,"_28586":2469,"_19790":54493,"_5":13558,"_26008":54092,"_2720":54494},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3227":2624,"_28586":2469,"_19790":54496,"_5":13558,"_26008":54092,"_2720":54497},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3227":2625,"_28586":2469,"_19790":54499,"_5":13558,"_26008":54092,"_2720":54500},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3227":2626,"_28586":2469,"_19790":54502,"_5":13558,"_26008":54092,"_2720":54503},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3227":2627,"_28586":2469,"_19790":54505,"_5":13558,"_26008":54100,"_2720":54506},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3227":2628,"_28586":2469,"_19790":54508,"_5":13558,"_26008":54100,"_2720":54509},[],"Field in 3.8.0",{"_3227":2629,"_28586":2469,"_19790":54511,"_5":13558,"_26008":54100,"_2720":54512},[],"Field in 4.0.0",{"_3227":2630,"_28586":2469,"_19790":54514,"_5":13558,"_26008":54100,"_2720":54515},[],"`validate_server_cert`",{"_3227":2631,"_28586":2469,"_19790":54517,"_5":13558,"_26008":54100,"_2720":54518},[],"`insecure_skip_verify` (value negated)",{"_3227":2632,"_28586":2469,"_19790":54520,"_5":13558,"_26008":54100,"_2720":54521},[],"`oidc`",{"_3227":2633,"_28586":2469,"_19790":54523,"_5":13558,"_26008":54100,"_2720":54524},[],"`jwt_options`",{"_3227":2634,"_28586":2469,"_19790":54526,"_5":13558,"_26008":54100,"_2720":54527},[],"`apikey`",{"_3227":2635,"_28586":2469,"_19790":54529,"_5":13558,"_26008":54100,"_2720":54530},[],"`apikey_options`",{"_3227":2636,"_28586":2469,"_19790":54532,"_5":13558,"_26008":54100,"_2720":54533},[],"`mtls`",{"_3227":2637,"_28586":2469,"_19790":54535,"_5":13558,"_26008":54100,"_2720":54536},[],"`mtls_options`",{"_3227":2638,"_28586":2469,"_19790":54538,"_5":13558,"_26008":54100,"_2720":54539},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3227":2639,"_28586":2469,"_19790":54541,"_5":13558,"_26008":54100,"_2720":54542},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3227":2640,"_28586":2469,"_19790":54544,"_5":13558,"_26008":54100,"_2720":54545},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3227":2641,"_28586":2469,"_19790":54547,"_5":13558,"_26008":54104,"_2720":54548},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3227":2642,"_28586":2469,"_19790":54550,"_5":13558,"_26008":54104,"_2720":54551},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3227":2643,"_28586":2469,"_19790":54553,"_5":13558,"_26008":54104,"_2720":54554},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3227":2644,"_28586":2469,"_19790":54556,"_5":13558,"_26008":54108,"_2720":54557},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3227":2645,"_28586":2469,"_19790":54559,"_5":13558,"_26008":54112,"_2720":54560},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3227":2646,"_28586":2469,"_19790":54562,"_5":13558,"_26008":54116,"_2720":54563},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3227":2647,"_28586":2469,"_19790":54565,"_5":13558,"_26008":54120,"_2720":54566},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3227":2648,"_28586":2469,"_19790":54568,"_5":13558,"_26008":54120,"_2720":54569},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3227":2649,"_28586":2469,"_19790":54571,"_5":13558,"_26008":54120,"_2720":54572},[],"`POST /v1/devices/:id/events` creates an event.",{"_3227":2650,"_28586":2469,"_19790":54574,"_5":13558,"_26008":54120,"_2720":54575},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3227":2651,"_28586":2469,"_19790":54577,"_5":13558,"_26008":54124,"_2720":54578},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3227":2652,"_28586":2469,"_19790":54580,"_5":13558,"_26008":54128,"_2720":54581},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3227":2653,"_28586":2469,"_19790":54583,"_5":13558,"_26008":54128,"_2720":54584},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3227":2654,"_28586":2469,"_19790":54586,"_5":13558,"_26008":54128,"_2720":54587},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3227":2655,"_28586":2469,"_19790":54589,"_5":13558,"_26008":54128,"_2720":54590},[],"Record the names of your local-storage PVCs:",{"_3227":2656,"_28586":2469,"_19790":54592,"_5":13558,"_26008":54128,"_2720":54593},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3227":2657,"_28586":2469,"_19790":54595,"_5":13558,"_26008":54132,"_2720":54596},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3227":2658,"_28586":2469,"_19790":54598,"_5":13558,"_26008":54132,"_2720":54599},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3227":2659,"_28586":2469,"_19790":54601,"_5":13558,"_26008":54132,"_2720":54602},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3227":2660,"_28586":2469,"_19790":54604,"_5":13558,"_26008":54132,"_2720":54605},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3227":2661,"_28586":2469,"_19790":54607,"_5":13558,"_26008":54132,"_2720":54608},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3227":2662,"_28586":2469,"_19790":54610,"_5":13558,"_26008":54132,"_2720":54611},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3227":2663,"_28586":2469,"_19790":54613,"_5":13558,"_26008":54132,"_2720":54614},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3227":2664,"_28586":2469,"_19790":54616,"_5":13558,"_26008":54132,"_2720":54617},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3227":2665,"_28586":2469,"_19790":54619,"_5":13558,"_26008":54132,"_2720":54620},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3227":2666,"_28586":2469,"_19790":54622,"_5":13558,"_26008":54132,"_2720":54623},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3227":2667,"_28586":2469,"_19790":54625,"_5":13558,"_26008":54132,"_2720":54626},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3227":2668,"_28586":2469,"_19790":54628,"_5":13558,"_26008":54132,"_2720":54629},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3227":2669,"_28586":2469,"_19790":54631,"_5":13558,"_26008":54136,"_2720":54632},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3227":2670,"_28586":2469,"_19790":54634,"_5":13558,"_26008":54136,"_2720":54635},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3227":2671,"_28586":2469,"_19790":54637,"_5":13558,"_26008":54140,"_2720":54638},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3227":2672,"_28586":2469,"_19790":54640,"_5":13558,"_26008":54140,"_2720":54641},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3227":2673,"_28586":2469,"_19790":54643,"_5":13558,"_26008":54140,"_2720":54644},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3227":2674,"_28586":2469,"_19790":54646,"_5":13558,"_26008":54140,"_2720":54647},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3227":2675,"_28586":2469,"_19790":54649,"_5":13558,"_26008":54140,"_2720":54650},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3227":2676,"_28586":2469,"_19790":54652,"_5":13558,"_26008":54140,"_2720":54653},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3227":2677,"_28586":2469,"_19790":54655,"_5":13558,"_26008":54140,"_2720":54656},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3227":2678,"_28586":2469,"_19790":54658,"_5":13558,"_26008":54140,"_2720":54659},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3227":2679,"_28586":2469,"_19790":54661,"_5":13558,"_26008":54140,"_2720":54662},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3227":2680,"_28586":2469,"_19790":54664,"_5":13558,"_26008":54140,"_2720":54665},[],"**Remove the helper and restore the recorded replica counts:**",{"_3227":2681,"_28586":2469,"_19790":54667,"_5":13558,"_26008":54140,"_2720":54668},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3227":2682,"_28586":2469,"_19790":54670,"_5":13558,"_26008":54144,"_2720":54671},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3227":2683,"_28586":2469,"_19790":54673,"_5":13558,"_26008":54144,"_2720":54674},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3227":2684,"_28586":2469,"_19790":54676,"_5":13558,"_26008":54148,"_2720":54677},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3227":2685,"_28586":2469,"_19790":54679,"_5":13558,"_26008":54148,"_2720":54680},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3227":2686,"_28586":2469,"_19790":54682,"_5":13558,"_26008":54148,"_2720":54683},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3227":2687,"_28586":2469,"_19790":54685,"_5":13558,"_26008":54148,"_2720":54686},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3227":2688,"_28586":2469,"_19790":54688,"_5":13558,"_26008":54148,"_2720":54689},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3227":2689,"_28586":2469,"_19790":54691,"_5":13558,"_26008":54152,"_2720":54692},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3227":2690,"_28586":2469,"_19790":54694,"_5":13558,"_26008":54152,"_2720":54695},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3227":2691,"_28586":2469,"_19790":54697,"_5":13558,"_26008":54152,"_2720":54698},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3227":2692,"_28586":2469,"_19790":54700,"_5":13558,"_26008":54152,"_2720":54701},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3227":2693,"_28586":2469,"_19790":54703,"_5":13558,"_26008":54152,"_2720":54704},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3227":2694,"_28586":2469,"_19790":54706,"_5":13558,"_26008":54152,"_2720":54707},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3227":2695,"_28586":2469,"_19790":54709,"_5":13558,"_26008":54152,"_2720":54710},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3227":2696,"_28586":2469,"_19790":54712,"_5":13558,"_26008":54155,"_2720":54713},[],"After the upgrade, check in this order:",{"_3227":2697,"_28586":2469,"_19790":54715,"_5":13558,"_26008":54155,"_2720":54716},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3227":2698,"_28586":2469,"_19790":54718,"_5":13558,"_26008":54155,"_2720":54719},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3227":2699,"_28586":2469,"_19790":54721,"_5":13558,"_26008":54155,"_2720":54722},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3227":2700,"_28586":2469,"_19790":54724,"_5":13558,"_26008":54155,"_2720":54725},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3227":2701,"_28586":2469,"_19790":54727,"_5":13558,"_26008":54155,"_2720":54728},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3227":2702,"_28586":2469,"_19790":54730,"_5":13558,"_26008":54155,"_2720":54731},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3227":2703,"_28586":2469,"_19790":54733,"_5":13558,"_26008":54155,"_2720":54734},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3227":2704,"_28586":2469,"_19790":54736,"_5":13558,"_26008":54155,"_2720":54737},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3227":2705,"_28586":2469,"_19790":54739,"_5":13558,"_26008":54155,"_2720":54740},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3227":2706,"_28586":2469,"_19790":54742,"_5":13558,"_26008":54155,"_2720":54743},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3227":2707,"_28586":2469,"_19790":54745,"_5":13558,"_26008":54155,"_2720":54746},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3227":2708,"_28586":2469,"_19790":54748,"_5":13558,"_26008":54155,"_2720":54749},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3227":2709,"_28586":2469,"_19790":54751,"_5":13558,"_26008":54155,"_2720":54752},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3227":2710,"_28586":2469,"_19790":54754,"_5":13558,"_26008":54155,"_2720":54755},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3227":2711,"_28586":2469,"_19790":54757,"_5":13558,"_26008":54159,"_2720":54758},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3227":2712,"_28586":2469,"_19790":54760,"_5":13558,"_26008":54159,"_2720":54761},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3227":2713,"_28586":2469,"_19790":54763,"_5":13558,"_26008":54159,"_2720":54764},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3227":2714,"_28586":2469,"_19790":54766,"_5":13558,"_26008":54159,"_2720":54767},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3227":2715,"_28586":2469,"_19790":54769,"_5":13558,"_26008":54159,"_2720":54770},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_54773":54774,"_54775":54776,"_54777":54778,"_54779":54780,"_17152":2742,"_65598":2742},"language","english","sortableProperties",[2720,28586,5,26008],"sortablePropertiesWithTypes",{"_2720":23659,"_28586":23659,"_5":23659,"_26008":23659},"sorts",{"_2720":54781,"_28586":57486,"_5":60190,"_26008":62894},{"_4350":54782,"_54783":54784,"_5":23659},{"_13640":21511,"_14015":20325,"_14034":5367,"_12236":3315,"_14021":4061,"_18791":17222,"_13661":4835,"_13668":3101,"_27573":7102,"_27981":16941,"_28002":5598,"_27607":6102,"_32734":3920,"_27709":8837,"_28046":19052,"_32741":28211,"_32744":11013,"_32747":3941,"_32750":17711,"_28423":2860,"_32755":22127,"_32757":24659,"_28453":7064,"_14030":2988,"_32761":11225,"_32764":4412,"_32766":4480,"_28030":13604,"_28418":8915,"_28466":4118,"_32771":4140,"_32773":6500,"_32775":7538,"_27726":2819,"_32778":14875,"_32780":4041,"_32782":3028,"_32784":3416,"_32786":7119,"_27643":11499,"_32789":3427,"_32791":10387,"_27637":3112,"_28067":4246,"_32795":3720,"_32797":5366,"_32800":6557,"_27683":5593,"_32804":6143,"_27564":15855,"_32807":1