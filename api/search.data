1910":60887,"_41912":60890,"_41914":60893,"_41917":60896,"_41919":60899,"_41921":60902,"_41923":60905,"_31371":60908,"_41926":60911,"_41928":60914,"_41930":60917,"_41932":60920,"_41934":60923,"_41936":60926,"_41938":60929,"_41940":60932,"_41942":60935,"_41944":60938,"_41946":60941,"_41948":60944,"_41950":60947,"_41952":60950,"_41954":60953,"_41956":60956,"_41958":60959,"_41960":60962,"_41962":60965,"_41964":60968,"_41966":60971,"_41968":60974,"_41970":60977,"_41972":60980,"_41974":60983,"_41976":60986,"_41978":60989,"_41981":60992,"_41983":60995,"_41985":60998,"_41987":61001},{"_3731":15,"_31485":15,"_5":15390,"_3122":51371,"_31812":51372,"_21804":51376,"_28646":15},"Deploy from AWS Marketplace",[51373,51374,51375],"Docs","Deployment","Other models",[],{"_3731":16,"_31485":15,"_21804":51378,"_5":15036,"_28646":15,"_3122":51379},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3731":17,"_31485":15,"_5":31809,"_21804":51381,"_28646":51382,"_3122":51383},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3731":18,"_31485":15,"_5":31809,"_21804":51385,"_28646":51386,"_3122":51387},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3731":19,"_31485":15,"_5":31809,"_21804":51389,"_28646":51390,"_3122":51391},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3731":20,"_31485":15,"_5":31809,"_21804":51393,"_28646":51394,"_3122":51395},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3731":21,"_31485":15,"_5":31809,"_21804":51397,"_28646":51398,"_3122":51399},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3731":22,"_31485":15,"_5":31809,"_21804":51401,"_28646":51402,"_3122":51403},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3731":23,"_31485":15,"_5":31809,"_21804":51405,"_28646":51406,"_3122":51407},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3731":24,"_31485":15,"_21804":51409,"_5":15036,"_28646":15,"_3122":51410},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3731":25,"_31485":15,"_21804":51412,"_5":15036,"_28646":51382,"_3122":51413},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3731":26,"_31485":15,"_21804":51415,"_5":15036,"_28646":51382,"_3122":51416},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3731":27,"_31485":15,"_21804":51418,"_5":15036,"_28646":51382,"_3122":51419},[],"A security group allowing the necessary endpoints.",{"_3731":28,"_31485":15,"_21804":51421,"_5":15036,"_28646":51386,"_3122":51422},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3731":29,"_31485":15,"_21804":51424,"_5":15036,"_28646":51386,"_3122":51425},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3731":30,"_31485":15,"_21804":51427,"_5":15036,"_28646":51386,"_3122":51428},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3731":31,"_31485":15,"_21804":51430,"_5":15036,"_28646":51390,"_3122":51431},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3731":32,"_31485":15,"_21804":51433,"_5":15036,"_28646":51394,"_3122":51434},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3731":33,"_31485":15,"_21804":51436,"_5":15036,"_28646":51398,"_3122":51437},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3731":34,"_31485":15,"_21804":51439,"_5":15036,"_28646":51402,"_3122":51440},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3731":35,"_31485":15,"_21804":51442,"_5":15036,"_28646":51406,"_3122":51443},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3731":36,"_31485":36,"_5":15390,"_3122":51445,"_31812":51446,"_21804":51447,"_28646":36},"Deploy Lamassu",[51373,51374],[],{"_3731":37,"_31485":36,"_21804":51449,"_5":15036,"_28646":36,"_3122":51450},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3731":38,"_31485":36,"_5":31809,"_21804":51452,"_28646":51453,"_3122":51454},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3731":39,"_31485":36,"_5":31809,"_21804":51456,"_28646":51457,"_3122":51458},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3731":40,"_31485":36,"_5":31809,"_21804":51460,"_28646":51461,"_3122":51462},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3731":41,"_31485":36,"_21804":51464,"_5":15036,"_28646":36,"_3122":51465},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3731":42,"_31485":36,"_21804":51467,"_5":15036,"_28646":51453,"_3122":51468},[],"Model",{"_3731":43,"_31485":36,"_21804":51470,"_5":15036,"_28646":51453,"_3122":51471},[],"Recommended for",{"_3731":44,"_31485":36,"_21804":51473,"_5":15036,"_28646":51453,"_3122":51474},[],"Who operates the infrastructure",{"_3731":45,"_31485":36,"_21804":51476,"_5":15036,"_28646":51453,"_3122":51477},[],"Starting point",{"_3731":46,"_31485":36,"_21804":51479,"_5":15036,"_28646":51453,"_3122":51480},[],"Kubernetes self-managed",{"_3731":47,"_31485":36,"_21804":51482,"_5":15036,"_28646":51453,"_3122":51483},[],"Production, regulated environments and custom deployments",{"_3731":48,"_31485":36,"_21804":51485,"_5":15036,"_28646":51453,"_3122":51486},[],"Your team",{"_3731":49,"_31485":36,"_21804":51488,"_5":15036,"_28646":51453,"_3122":51489},[],"Helm or Fastlane",{"_3731":50,"_31485":36,"_21804":51491,"_5":15036,"_28646":51453,"_3122":51492},[],"AWS Marketplace",{"_3731":51,"_31485":36,"_21804":51494,"_5":15036,"_28646":51453,"_3122":51495},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3731":52,"_31485":36,"_21804":51497,"_5":15036,"_28646":51453,"_3122":51486},[],{"_3731":53,"_31485":36,"_21804":51499,"_5":15036,"_28646":51453,"_3122":51500},[],"Preconfigured image on EC2",{"_3731":54,"_31485":36,"_21804":51502,"_5":15036,"_28646":51453,"_3122":51503},[],"SaaS",{"_3731":55,"_31485":36,"_21804":51505,"_5":15036,"_28646":51453,"_3122":51506},[],"Teams that want to use the platform without operating it",{"_3731":56,"_31485":36,"_21804":51508,"_5":15036,"_28646":51453,"_3122":51509},[],"Lamassu",{"_3731":57,"_31485":36,"_21804":51511,"_5":15036,"_28646":51453,"_3122":51512},[],"Managed subscription",{"_3731":58,"_31485":36,"_21804":51514,"_5":15036,"_28646":51453,"_3122":51515},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3731":59,"_31485":36,"_21804":51517,"_5":15036,"_28646":51453,"_3122":51518},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3731":60,"_31485":36,"_21804":51520,"_5":15036,"_28646":51453,"_3122":51521},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3731":61,"_31485":36,"_21804":51523,"_5":15036,"_28646":51457,"_3122":51524},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3731":62,"_31485":36,"_21804":51526,"_5":15036,"_28646":51461,"_3122":51527},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3731":63,"_31485":63,"_5":15390,"_3122":51529,"_31812":51530,"_21804":51531,"_28646":63},"Use Lamassu as SaaS",[51373,51374,51375],[],{"_3731":64,"_31485":63,"_21804":51533,"_5":15036,"_28646":63,"_3122":51534},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3731":65,"_31485":63,"_5":31809,"_21804":51536,"_28646":51537,"_3122":51538},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3731":66,"_31485":63,"_5":31809,"_21804":51540,"_28646":51541,"_3122":51542},[],"/docs/deployment/saas#plans","Plans",{"_3731":67,"_31485":63,"_5":31809,"_21804":51544,"_28646":51545,"_3122":51546},[],"/docs/deployment/saas#request-access","Request access",{"_3731":68,"_31485":63,"_21804":51548,"_5":15036,"_28646":63,"_3122":51549},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3731":69,"_31485":63,"_21804":51551,"_5":15036,"_28646":51537,"_3122":51552},[],"Platform availability and maintenance.",{"_3731":70,"_31485":63,"_21804":51554,"_5":15036,"_28646":51537,"_3122":51555},[],"Automatic backups.",{"_3731":71,"_31485":63,"_21804":51557,"_5":15036,"_28646":51537,"_3122":51558},[],"Version upgrades.",{"_3731":72,"_31485":63,"_21804":51560,"_5":15036,"_28646":51537,"_3122":51561},[],"Technical support and SLA according to your plan.",{"_3731":73,"_31485":63,"_21804":51563,"_5":15036,"_28646":51541,"_3122":51564},[],"Plan",{"_3731":74,"_31485":63,"_21804":51566,"_5":15036,"_28646":51541,"_3122":51567},[],"Devices",{"_3731":75,"_31485":63,"_21804":51569,"_5":15036,"_28646":51541,"_3122":51570},[],"Support",{"_3731":76,"_31485":63,"_21804":51572,"_5":15036,"_28646":51541,"_3122":51573},[],"SLA",{"_3731":77,"_31485":63,"_21804":51575,"_5":15036,"_28646":51541,"_3122":51576},[],"Starter",{"_3731":78,"_31485":63,"_21804":51578,"_5":15036,"_28646":51541,"_3122":51579},[],"Up to 1,000",{"_3731":79,"_31485":63,"_21804":51581,"_5":15036,"_28646":51541,"_3122":51582},[],"Email",{"_3731":80,"_31485":63,"_21804":51584,"_5":15036,"_28646":51541,"_3122":51585},[],"99.5 %",{"_3731":81,"_31485":63,"_21804":51587,"_5":15036,"_28646":51541,"_3122":51588},[],"Professional",{"_3731":82,"_31485":63,"_21804":51590,"_5":15036,"_28646":51541,"_3122":51591},[],"Up to 10,000",{"_3731":83,"_31485":63,"_21804":51593,"_5":15036,"_28646":51541,"_3122":51594},[],"Email and chat",{"_3731":84,"_31485":63,"_21804":51596,"_5":15036,"_28646":51541,"_3122":51597},[],"99.9 %",{"_3731":85,"_31485":63,"_21804":51599,"_5":15036,"_28646":51541,"_3122":51600},[],"Enterprise",{"_3731":86,"_31485":63,"_21804":51602,"_5":15036,"_28646":51541,"_3122":51603},[],"Unlimited",{"_3731":87,"_31485":63,"_21804":51605,"_5":15036,"_28646":51541,"_3122":51606},[],"Dedicated",{"_3731":88,"_31485":63,"_21804":51608,"_5":15036,"_28646":51541,"_3122":51609},[],"99.99 %",{"_3731":89,"_31485":63,"_21804":51611,"_5":15036,"_28646":51545,"_3122":51612},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3731":90,"_31485":63,"_21804":51614,"_5":15036,"_28646":51545,"_3122":51615},[],"When you receive your instance's credentials, continue with Get started.",{"_3731":91,"_31485":91,"_5":15390,"_3122":51617,"_31812":51618,"_21804":51619,"_28646":91},"Fastlane",[51373,51374,51480],[],{"_3731":92,"_31485":91,"_21804":51621,"_5":15036,"_28646":91,"_3122":51622},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3731":93,"_31485":91,"_5":31809,"_21804":51624,"_28646":51625,"_3122":51626},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3731":94,"_31485":91,"_5":31809,"_21804":51628,"_28646":51629,"_3122":51630},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3731":95,"_31485":91,"_5":31809,"_21804":51632,"_28646":51633,"_3122":51383},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3731":96,"_31485":91,"_5":31809,"_21804":51635,"_28646":51636,"_3122":51637},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3731":97,"_31485":91,"_5":31809,"_21804":51639,"_28646":51640,"_3122":51641},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3731":98,"_31485":91,"_5":31809,"_21804":51643,"_28646":51644,"_3122":51645},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3731":99,"_31485":91,"_5":31809,"_21804":51647,"_28646":51648,"_3122":51649},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3731":100,"_31485":91,"_5":31809,"_21804":51651,"_28646":51652,"_3122":51653},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3731":101,"_31485":91,"_5":31809,"_21804":51655,"_28646":51656,"_3122":51657},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3731":102,"_31485":91,"_5":31809,"_21804":51659,"_28646":51660,"_3122":51661},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3731":103,"_31485":91,"_5":31809,"_21804":51663,"_28646":51664,"_3122":51665},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3731":104,"_31485":91,"_21804":51667,"_5":15036,"_28646":51625,"_3122":51668},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3731":105,"_31485":91,"_21804":51670,"_5":15036,"_28646":51625,"_3122":51671},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3731":106,"_31485":91,"_21804":51673,"_5":15036,"_28646":51629,"_3122":51674},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3731":107,"_31485":91,"_21804":51676,"_5":15036,"_28646":51629,"_3122":51677},[],"Fastlane installs or configures",{"_3731":108,"_31485":91,"_21804":51679,"_5":15036,"_28646":51629,"_3122":51680},[],"You still provide",{"_3731":109,"_31485":91,"_21804":51682,"_5":15036,"_28646":51629,"_3122":51683},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3731":110,"_31485":91,"_21804":51685,"_5":15036,"_28646":51629,"_3122":51686},[],"The Kubernetes cluster, nodes and persistent storage",{"_3731":111,"_31485":91,"_21804":51688,"_5":15036,"_28646":51629,"_3122":51689},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3731":112,"_31485":91,"_21804":51691,"_5":15036,"_28646":51629,"_3122":51692},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3731":113,"_31485":91,"_21804":51694,"_5":15036,"_28646":51629,"_3122":51695},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3731":114,"_31485":91,"_21804":51697,"_5":15036,"_28646":51629,"_3122":51698},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3731":115,"_31485":91,"_21804":51700,"_5":15036,"_28646":51629,"_3122":51701},[],"Optional observability and lab HSM components",{"_3731":116,"_31485":91,"_21804":51703,"_5":15036,"_28646":51629,"_3122":51704},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3731":117,"_31485":91,"_21804":51706,"_5":15036,"_28646":51629,"_3122":51707},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3731":118,"_31485":91,"_21804":51709,"_5":15036,"_28646":51633,"_3122":51710},[],"You need:",{"_3731":119,"_31485":91,"_21804":51712,"_5":15036,"_28646":51633,"_3122":51713},[],"an existing Kubernetes cluster",{"_3731":120,"_31485":91,"_21804":51715,"_5":15036,"_28646":51633,"_3122":51716},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3731":121,"_31485":91,"_21804":51718,"_5":15036,"_28646":51633,"_3122":51719},[],"`yq`",{"_3731":122,"_31485":91,"_21804":51721,"_5":15036,"_28646":51633,"_3122":24618},[],{"_3731":123,"_31485":91,"_21804":51723,"_5":15036,"_28646":51633,"_3122":51724},[],"`jq` only when using `--sample-data` or `--development`",{"_3731":124,"_31485":91,"_21804":51726,"_5":15036,"_28646":51633,"_3122":51727},[],"`ssh-keygen` only when using `--with-hsm`",{"_3731":125,"_31485":91,"_21804":51729,"_5":15036,"_28646":51633,"_3122":51730},[],"free external ports 80 and 443 on a single-node K3s host",{"_3731":126,"_31485":91,"_21804":51732,"_5":15036,"_28646":51633,"_3122":51733},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3731":127,"_31485":91,"_21804":51735,"_5":15036,"_28646":51633,"_3122":51736},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3731":128,"_31485":91,"_21804":51738,"_5":15036,"_28646":51636,"_3122":51739},[],"Run the script from a clone of the Helm repository:",{"_3731":129,"_31485":91,"_21804":51741,"_5":15036,"_28646":51636,"_3122":51742},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3731":130,"_31485":91,"_21804":51744,"_5":15036,"_28646":51640,"_3122":51745},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3731":131,"_31485":91,"_21804":51747,"_5":15036,"_28646":51640,"_3122":51748},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3731":132,"_31485":91,"_21804":51750,"_5":15036,"_28646":51640,"_3122":51751},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3731":133,"_31485":91,"_21804":51753,"_5":15036,"_28646":51640,"_3122":51754},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3731":134,"_31485":91,"_21804":51756,"_5":15036,"_28646":51644,"_3122":51757},[],"Option",{"_3731":135,"_31485":91,"_21804":51759,"_5":15036,"_28646":51644,"_3122":51760},[],"Default",{"_3731":136,"_31485":91,"_21804":51762,"_5":15036,"_28646":51644,"_3122":51763},[],"Purpose",{"_3731":137,"_31485":91,"_21804":51765,"_5":15036,"_28646":51644,"_3122":51766},[],"`-h`, `--help`",{"_3731":138,"_31485":91,"_21804":51768,"_5":15036,"_28646":51644,"_3122":51769},[],"—",{"_3731":139,"_31485":91,"_21804":51771,"_5":15036,"_28646":51644,"_3122":51772},[],"Show help",{"_3731":140,"_31485":91,"_21804":51774,"_5":15036,"_28646":51644,"_3122":51775},[],"`-c`, `--context`",{"_3731":141,"_31485":91,"_21804":51777,"_5":15036,"_28646":51644,"_3122":51778},[],"current context",{"_3731":142,"_31485":91,"_21804":51780,"_5":15036,"_28646":51644,"_3122":51781},[],"Select the kubeconfig context for kubectl and Helm",{"_3731":143,"_31485":91,"_21804":51783,"_5":15036,"_28646":51644,"_3122":51784},[],"`-n`, `--non-interactive`",{"_3731":144,"_31485":91,"_21804":51786,"_5":15036,"_28646":51644,"_3122":6886},[],{"_3731":145,"_31485":91,"_21804":51788,"_5":15036,"_28646":51644,"_3122":51789},[],"Skip prompts and generate dependency credentials",{"_3731":146,"_31485":91,"_21804":51791,"_5":15036,"_28646":51644,"_3122":51792},[],"`-ns`, `--namespace`",{"_3731":147,"_31485":91,"_21804":51794,"_5":15036,"_28646":51644,"_3122":51795},[],"`lamassu-dev`",{"_3731":148,"_31485":91,"_21804":51797,"_5":15036,"_28646":51644,"_3122":51798},[],"Namespace for the installation",{"_3731":149,"_31485":91,"_21804":51800,"_5":15036,"_28646":51644,"_3122":51801},[],"`-d`, `--domain`",{"_3731":150,"_31485":91,"_21804":51803,"_5":15036,"_28646":51644,"_3122":51804},[],"`dev.lamassu.io`",{"_3731":151,"_31485":91,"_21804":51806,"_5":15036,"_28646":51644,"_3122":51807},[],"Domain used by the UI, OIDC and certificate",{"_3731":152,"_31485":91,"_21804":51809,"_5":15036,"_28646":51644,"_3122":51810},[],"`-v`, `--version`",{"_3731":153,"_31485":91,"_21804":51812,"_5":15036,"_28646":51644,"_3122":15737},[],{"_3731":154,"_31485":91,"_21804":51814,"_5":15036,"_28646":51644,"_3122":51815},[],"Lamassu chart version",{"_3731":155,"_31485":91,"_21804":51817,"_5":15036,"_28646":51644,"_3122":51818},[],"`--https-port`",{"_3731":156,"_31485":91,"_21804":51820,"_5":15036,"_28646":51644,"_3122":51821},[],"`443`",{"_3731":157,"_31485":91,"_21804":51823,"_5":15036,"_28646":51644,"_3122":51824},[],"Gateway HTTPS listener port",{"_3731":158,"_31485":91,"_21804":51826,"_5":15036,"_28646":51644,"_3122":51827},[],"`--http-port`",{"_3731":159,"_31485":91,"_21804":51829,"_5":15036,"_28646":51644,"_3122":51830},[],"`80`",{"_3731":160,"_31485":91,"_21804":51832,"_5":15036,"_28646":51644,"_3122":51833},[],"Gateway HTTP listener port",{"_3731":161,"_31485":91,"_21804":51835,"_5":15036,"_28646":51644,"_3122":51836},[],"`--tls-crt`",{"_3731":162,"_31485":91,"_21804":51838,"_5":15036,"_28646":51644,"_3122":51769},[],{"_3731":163,"_31485":91,"_21804":51840,"_5":15036,"_28646":51644,"_3122":51841},[],"PEM certificate for downstream TLS",{"_3731":164,"_31485":91,"_21804":51843,"_5":15036,"_28646":51644,"_3122":51844},[],"`--tls-key`",{"_3731":165,"_31485":91,"_21804":51846,"_5":15036,"_28646":51644,"_3122":51769},[],{"_3731":166,"_31485":91,"_21804":51848,"_5":15036,"_28646":51644,"_3122":51849},[],"PEM private key for downstream TLS",{"_3731":167,"_31485":91,"_21804":51851,"_5":15036,"_28646":51644,"_3122":51852},[],"`-l`, `--local-chart-path`",{"_3731":168,"_31485":91,"_21804":51854,"_5":15036,"_28646":51644,"_3122":51855},[],"repository chart",{"_3731":169,"_31485":91,"_21804":51857,"_5":15036,"_28646":51644,"_3122":51858},[],"Use an unpacked local Lamassu chart",{"_3731":170,"_31485":91,"_21804":51860,"_5":15036,"_28646":51644,"_3122":51861},[],"`-ip`, `--gateway-ip`",{"_3731":171,"_31485":91,"_21804":51863,"_5":15036,"_28646":51644,"_3122":9194},[],{"_3731":172,"_31485":91,"_21804":51865,"_5":15036,"_28646":51644,"_3122":51866},[],"Override the address written to `gateway.addresses`",{"_3731":173,"_31485":91,"_21804":51868,"_5":15036,"_28646":51644,"_3122":51869},[],"`--otel`",{"_3731":174,"_31485":91,"_21804":51871,"_5":15036,"_28646":51644,"_3122":6886},[],{"_3731":175,"_31485":91,"_21804":51873,"_5":15036,"_28646":51644,"_3122":51874},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3731":176,"_31485":91,"_21804":51876,"_5":15036,"_28646":51644,"_3122":51877},[],"`--development`",{"_3731":177,"_31485":91,"_21804":51879,"_5":15036,"_28646":51644,"_3122":6886},[],{"_3731":178,"_31485":91,"_21804":51881,"_5":15036,"_28646":51644,"_3122":51882},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3731":179,"_31485":91,"_21804":51884,"_5":15036,"_28646":51644,"_3122":51885},[],"`--sample-data`",{"_3731":180,"_31485":91,"_21804":51887,"_5":15036,"_28646":51644,"_3122":6886},[],{"_3731":181,"_31485":91,"_21804":51889,"_5":15036,"_28646":51644,"_3122":51890},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3731":182,"_31485":91,"_21804":51892,"_5":15036,"_28646":51644,"_3122":51893},[],"`--with-hsm`",{"_3731":183,"_31485":91,"_21804":51895,"_5":15036,"_28646":51644,"_3122":6886},[],{"_3731":184,"_31485":91,"_21804":51897,"_5":15036,"_28646":51644,"_3122":51898},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3731":185,"_31485":91,"_21804":51900,"_5":15036,"_28646":51644,"_3122":51901},[],"`--softhsm-chart-path`",{"_3731":186,"_31485":91,"_21804":51903,"_5":15036,"_28646":51644,"_3122":51904},[],"`./charts/softhsm`",{"_3731":187,"_31485":91,"_21804":51906,"_5":15036,"_28646":51644,"_3122":51907},[],"Use a different local SoftHSM chart",{"_3731":188,"_31485":91,"_21804":51909,"_5":15036,"_28646":51644,"_3122":51910},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3731":189,"_31485":91,"_21804":51912,"_5":15036,"_28646":51648,"_3122":51913},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3731":190,"_31485":91,"_21804":51915,"_5":15036,"_28646":51648,"_3122":51916},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3731":191,"_31485":91,"_21804":51918,"_5":15036,"_28646":51648,"_3122":51919},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3731":192,"_31485":91,"_21804":51921,"_5":15036,"_28646":51648,"_3122":51922},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3731":193,"_31485":91,"_21804":51924,"_5":15036,"_28646":51648,"_3122":51925},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3731":194,"_31485":91,"_21804":51927,"_5":15036,"_28646":51648,"_3122":51928},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3731":195,"_31485":91,"_21804":51930,"_5":15036,"_28646":51652,"_3122":51931},[],"Fastlane:",{"_3731":196,"_31485":91,"_21804":51933,"_5":15036,"_28646":51652,"_3122":51934},[],"validates local tools and the selected cluster",{"_3731":197,"_31485":91,"_21804":51936,"_5":15036,"_28646":51652,"_3122":51937},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3731":198,"_31485":91,"_21804":51939,"_5":15036,"_28646":51652,"_3122":51940},[],"creates the namespace",{"_3731":199,"_31485":91,"_21804":51942,"_5":15036,"_28646":51652,"_3122":51943},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3731":200,"_31485":91,"_21804":51945,"_5":15036,"_28646":51652,"_3122":51946},[],"installs PostgreSQL and creates the required databases",{"_3731":201,"_31485":91,"_21804":51948,"_5":15036,"_28646":51652,"_3122":51949},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3731":202,"_31485":91,"_21804":51951,"_5":15036,"_28646":51652,"_3122":51952},[],"installs RabbitMQ",{"_3731":203,"_31485":91,"_21804":51954,"_5":15036,"_28646":51652,"_3122":51955},[],"optionally installs observability and lab HSM components",{"_3731":204,"_31485":91,"_21804":51957,"_5":15036,"_28646":51652,"_3122":51958},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3731":205,"_31485":91,"_21804":51960,"_5":15036,"_28646":51652,"_3122":51961},[],"optionally loads sample data",{"_3731":206,"_31485":91,"_21804":51963,"_5":15036,"_28646":51652,"_3122":51964},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3731":207,"_31485":91,"_21804":51966,"_5":15036,"_28646":51656,"_3122":51967},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3731":208,"_31485":91,"_21804":51969,"_5":15036,"_28646":51656,"_3122":51970},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3731":209,"_31485":91,"_21804":51972,"_5":15036,"_28646":51660,"_3122":51973},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3731":210,"_31485":91,"_21804":51975,"_5":15036,"_28646":51660,"_3122":51976},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3731":211,"_31485":91,"_21804":51978,"_5":15036,"_28646":51660,"_3122":51979},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3731":212,"_31485":91,"_21804":51981,"_5":15036,"_28646":51660,"_3122":51982},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3731":213,"_31485":91,"_21804":51984,"_5":15036,"_28646":51664,"_3122":51985},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3731":214,"_31485":214,"_5":15390,"_3122":51987,"_31812":51988,"_21804":51989,"_28646":214},"Install with Helm",[51373,51374,51480],[],{"_3731":215,"_31485":214,"_21804":51991,"_5":15036,"_28646":214,"_3122":51992},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3731":216,"_31485":214,"_5":31809,"_21804":51994,"_28646":51995,"_3122":51996},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3731":217,"_31485":214,"_5":31809,"_21804":51998,"_28646":51999,"_3122":51383},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3731":218,"_31485":214,"_5":31809,"_21804":52001,"_28646":52002,"_3122":52003},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3731":219,"_31485":214,"_5":31809,"_21804":52005,"_28646":52006,"_3122":52007},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3731":220,"_31485":214,"_5":31809,"_21804":52009,"_28646":52010,"_3122":52011},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3731":221,"_31485":214,"_5":31809,"_21804":52013,"_28646":52014,"_3122":52015},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3731":222,"_31485":214,"_5":31809,"_21804":52017,"_28646":52018,"_3122":52019},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3731":223,"_31485":214,"_5":31809,"_21804":52021,"_28646":52022,"_3122":52023},[],"/docs/deployment/self-hosted/helm#device-event-stream-sse","Device event stream (SSE)",{"_3731":224,"_31485":214,"_5":31809,"_21804":52025,"_28646":52026,"_3122":52027},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3731":225,"_31485":214,"_5":31809,"_21804":52029,"_28646":52030,"_3122":52031},[],"/docs/deployment/self-hosted/helm#experimental-dashboard-terminal-optional","Experimental dashboard terminal (optional)",{"_3731":226,"_31485":214,"_5":31809,"_21804":52033,"_28646":52034,"_3122":52035},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3731":227,"_31485":214,"_5":31809,"_21804":52037,"_28646":52038,"_3122":52039},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3731":228,"_31485":214,"_5":31809,"_21804":52041,"_28646":52042,"_3122":52043},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3731":229,"_31485":214,"_5":31809,"_21804":52045,"_28646":52046,"_3122":52047},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3731":230,"_31485":214,"_21804":52049,"_5":15036,"_28646":51995,"_3122":52050},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3731":231,"_31485":214,"_21804":52052,"_5":15036,"_28646":51999,"_3122":52053},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3731":232,"_31485":214,"_21804":52055,"_5":15036,"_28646":51999,"_3122":52056},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3731":233,"_31485":214,"_21804":52058,"_5":15036,"_28646":51999,"_3122":52059},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3731":234,"_31485":214,"_21804":52061,"_5":15036,"_28646":51999,"_3122":52062},[],"a reachable RabbitMQ broker and credentials",{"_3731":235,"_31485":214,"_21804":52064,"_5":15036,"_28646":51999,"_3122":52065},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3731":236,"_31485":214,"_21804":52067,"_5":15036,"_28646":51999,"_3122":52068},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3731":237,"_31485":214,"_21804":52070,"_5":15036,"_28646":51999,"_3122":52071},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3731":238,"_31485":214,"_21804":52073,"_5":15036,"_28646":51999,"_3122":52074},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3731":239,"_31485":214,"_21804":52076,"_5":15036,"_28646":51999,"_3122":52077},[],"a StorageClass and an external traffic design",{"_3731":240,"_31485":214,"_21804":52079,"_5":15036,"_28646":51999,"_3122":52080},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3731":241,"_31485":214,"_21804":52082,"_5":15036,"_28646":51999,"_3122":52083},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3731":242,"_31485":214,"_21804":52085,"_5":15036,"_28646":51999,"_3122":52086},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3731":243,"_31485":214,"_21804":52088,"_5":15036,"_28646":52002,"_3122":52089},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3731":244,"_31485":214,"_21804":52091,"_5":15036,"_28646":52002,"_3122":52092},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3731":245,"_31485":214,"_21804":52094,"_5":15036,"_28646":52002,"_3122":52095},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3731":246,"_31485":214,"_21804":52097,"_5":15036,"_28646":52006,"_3122":52098},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3731":247,"_31485":214,"_21804":52100,"_5":15036,"_28646":52006,"_3122":52101},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3731":248,"_31485":214,"_21804":52103,"_5":15036,"_28646":52006,"_3122":52104},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3731":249,"_31485":214,"_21804":52106,"_5":15036,"_28646":52006,"_3122":52107},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3731":250,"_31485":214,"_21804":52109,"_5":15036,"_28646":52010,"_3122":52110},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3731":251,"_31485":214,"_21804":52112,"_5":15036,"_28646":52010,"_3122":52113},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3731":252,"_31485":214,"_21804":52115,"_5":15036,"_28646":52010,"_3122":52116},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3731":253,"_31485":214,"_21804":52118,"_5":15036,"_28646":52010,"_3122":52119},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3731":254,"_31485":214,"_21804":52121,"_5":15036,"_28646":52010,"_3122":52122},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3731":255,"_31485":214,"_21804":52124,"_5":15036,"_28646":52010,"_3122":52125},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3731":256,"_31485":214,"_21804":52127,"_5":15036,"_28646":52010,"_3122":52128},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3731":257,"_31485":214,"_21804":52130,"_5":15036,"_28646":52010,"_3122":52131},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3731":258,"_31485":214,"_21804":52133,"_5":15036,"_28646":52014,"_3122":52134},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3731":259,"_31485":214,"_21804":52136,"_5":15036,"_28646":52018,"_3122":52137},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3731":260,"_31485":214,"_21804":52139,"_5":15036,"_28646":52018,"_3122":52140},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3731":261,"_31485":214,"_21804":52142,"_5":15036,"_28646":52018,"_3122":52143},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3731":262,"_31485":214,"_21804":52145,"_5":15036,"_28646":52018,"_3122":52146},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3731":263,"_31485":214,"_21804":52148,"_5":15036,"_28646":52018,"_3122":52149},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3731":264,"_31485":214,"_21804":52151,"_5":15036,"_28646":52018,"_3122":52152},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3731":265,"_31485":214,"_21804":52154,"_5":15036,"_28646":52018,"_3122":52155},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3731":266,"_31485":214,"_21804":52157,"_5":15036,"_28646":52022,"_3122":52158},[],"`services.deviceManager.sseEnabled` (default `true`) controls whether Device Manager serves its device-event stream over Server-Sent Events (SSE). With the default, the chart renders a dedicated gateway rule for the device-events endpoint with an 11-minute request timeout, because the Gateway's default request timeout is too short for these streams, which the service keeps open for up to about ten minutes. Device Manager calls that are not SSE requests keep the Gateway's default timeout.",{"_3731":267,"_31485":214,"_21804":52160,"_5":15036,"_28646":52022,"_3122":52161},[],"Set it to `false` to disable the stream: the chart then renders `sse_enabled: false` in the Device Manager configuration and omits the gateway rule, and SSE requests to the device-events endpoint fail. See Device events in the 3.8.0 to 4.0.0 upgrade guide.",{"_3731":268,"_31485":214,"_21804":52163,"_5":15036,"_28646":52026,"_3122":52164},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3731":269,"_31485":214,"_21804":52166,"_5":15036,"_28646":52026,"_3122":52167},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3731":270,"_31485":214,"_21804":52169,"_5":15036,"_28646":52026,"_3122":52170},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3731":271,"_31485":214,"_21804":52172,"_5":15036,"_28646":52026,"_3122":52173},[],"See Access control for the principal and policy model.",{"_3731":272,"_31485":214,"_21804":52175,"_5":15036,"_28646":52030,"_3122":52176},[],"The dashboard includes an experimental browser terminal for working with devices. It is disabled by default; enable it in the values file:",{"_3731":273,"_31485":214,"_21804":52178,"_5":15036,"_28646":52030,"_3122":52179},[],"Enabling the terminal requires external authorization: set `auth.externalAuthorization.enabled: true` and `auth.externalAuthorization.failOpen: false`. The chart refuses to render the release otherwise, because the terminal's WebSocket endpoint would then be exposed through the Gateway without external authorization.",{"_3731":274,"_31485":214,"_21804":52181,"_5":15036,"_28646":52030,"_3122":52182},[],"Only identities granted the preloaded \"Terminal Network\" policy can open terminal sessions. See Access control for how policies are assigned.",{"_3731":275,"_31485":214,"_21804":52184,"_5":15036,"_28646":52030,"_3122":52185},[],"Note that even with the terminal enabled, pods inside the cluster can still reach the UI service directly unless network policies restrict that access — the external authorization applies to traffic entering through the Gateway.",{"_3731":276,"_31485":214,"_21804":52187,"_5":15036,"_28646":52034,"_3122":52188},[],"To install a local checkout instead:",{"_3731":277,"_31485":214,"_21804":52190,"_5":15036,"_28646":52038,"_3122":52191},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3731":278,"_31485":214,"_21804":52193,"_5":15036,"_28646":52038,"_3122":52194},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3731":279,"_31485":214,"_21804":52196,"_5":15036,"_28646":52042,"_3122":52197},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3731":280,"_31485":214,"_21804":52199,"_5":15036,"_28646":52042,"_3122":52200},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3731":281,"_31485":214,"_21804":52202,"_5":15036,"_28646":52042,"_3122":52203},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3731":282,"_31485":214,"_21804":52205,"_5":15036,"_28646":52042,"_3122":52206},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3731":283,"_31485":214,"_21804":52208,"_5":15036,"_28646":52042,"_3122":52209},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3731":284,"_31485":214,"_21804":52211,"_5":15036,"_28646":52046,"_3122":52212},[],"Before going live, review:",{"_3731":285,"_31485":214,"_21804":52214,"_5":15036,"_28646":52046,"_3122":52215},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3731":286,"_31485":214,"_21804":52217,"_5":15036,"_28646":52046,"_3122":52218},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3731":287,"_31485":214,"_21804":52220,"_5":15036,"_28646":52046,"_3122":52221},[],"shared VA storage before increasing VA replicas",{"_3731":288,"_31485":214,"_21804":52223,"_5":15036,"_28646":52046,"_3122":52224},[],"managed OIDC roles and removal of evaluation credentials",{"_3731":289,"_31485":214,"_21804":52226,"_5":15036,"_28646":52046,"_3122":52227},[],"a trusted TLS issuer or externally managed certificate",{"_3731":290,"_31485":214,"_21804":52229,"_5":15036,"_28646":52046,"_3122":52230},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3731":291,"_31485":214,"_21804":52232,"_5":15036,"_28646":52046,"_3122":52233},[],"SMTP, observability and alert delivery",{"_3731":292,"_31485":214,"_21804":52235,"_5":15036,"_28646":52046,"_3122":52236},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3731":293,"_31485":214,"_21804":52238,"_5":15036,"_28646":52046,"_3122":52239},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3731":294,"_31485":294,"_5":15390,"_3122":52241,"_31812":52242,"_21804":52243,"_28646":294},"Expose the Gateway",[51373,51374,51480],[],{"_3731":295,"_31485":294,"_21804":52245,"_5":15036,"_28646":294,"_3122":52246},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3731":296,"_31485":294,"_5":31809,"_21804":52248,"_28646":52249,"_3122":52250},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3731":297,"_31485":294,"_5":31809,"_21804":52252,"_28646":52253,"_3122":52254},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3731":298,"_31485":294,"_5":31809,"_21804":52256,"_28646":52257,"_3122":52258},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3731":299,"_31485":294,"_5":31809,"_21804":52260,"_28646":52261,"_3122":52262},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3731":300,"_31485":294,"_5":31809,"_21804":52264,"_28646":52265,"_3122":52266},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3731":301,"_31485":294,"_5":31809,"_21804":52268,"_28646":52269,"_3122":52270},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3731":302,"_31485":294,"_5":31809,"_21804":52272,"_28646":52273,"_3122":52274},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3731":303,"_31485":294,"_5":31809,"_21804":52276,"_28646":52277,"_3122":52278},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3731":304,"_31485":294,"_5":31809,"_21804":52280,"_28646":52281,"_3122":52282},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3731":305,"_31485":294,"_5":31809,"_21804":52284,"_28646":52285,"_3122":52286},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3731":306,"_31485":294,"_5":31809,"_21804":52288,"_28646":52289,"_3122":52290},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3731":307,"_31485":294,"_21804":52292,"_5":15036,"_28646":52249,"_3122":52293},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3731":308,"_31485":294,"_21804":52295,"_5":15036,"_28646":52249,"_3122":52296},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3731":309,"_31485":294,"_21804":52298,"_5":15036,"_28646":52253,"_3122":52299},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3731":310,"_31485":294,"_21804":52301,"_5":15036,"_28646":52253,"_3122":52302},[],"Set it only when:",{"_3731":311,"_31485":294,"_21804":52304,"_5":15036,"_28646":52253,"_3122":52305},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3731":312,"_31485":294,"_21804":52307,"_5":15036,"_28646":52253,"_3122":52308},[],"that address is allocated to this Gateway",{"_3731":313,"_31485":294,"_21804":52310,"_5":15036,"_28646":52253,"_3122":52311},[],"the surrounding network already routes traffic for it to the cluster",{"_3731":314,"_31485":294,"_21804":52313,"_5":15036,"_28646":52253,"_3122":52314},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3731":315,"_31485":294,"_21804":52316,"_5":15036,"_28646":52253,"_3122":52317},[],"Keep these two settings separate:",{"_3731":316,"_31485":294,"_21804":52319,"_5":15036,"_28646":52253,"_3122":52320},[],"`gateway.addresses` requests an address for the Gateway.",{"_3731":317,"_31485":294,"_21804":52322,"_5":15036,"_28646":52253,"_3122":52323},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3731":318,"_31485":294,"_21804":52325,"_5":15036,"_28646":52253,"_3122":52326},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3731":319,"_31485":294,"_21804":52328,"_5":15036,"_28646":52257,"_3122":52329},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3731":320,"_31485":294,"_21804":52331,"_5":15036,"_28646":52257,"_3122":52332},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3731":321,"_31485":294,"_21804":52334,"_5":15036,"_28646":52261,"_3122":52335},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3731":322,"_31485":294,"_21804":52337,"_5":15036,"_28646":52261,"_3122":52338},[],"For the recommended design:",{"_3731":323,"_31485":294,"_21804":52340,"_5":15036,"_28646":52261,"_3122":52341},[],"Use only one externally exposed Lamassu Gateway.",{"_3731":324,"_31485":294,"_21804":52343,"_5":15036,"_28646":52261,"_3122":52344},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3731":325,"_31485":294,"_21804":52346,"_5":15036,"_28646":52261,"_3122":52347},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3731":326,"_31485":294,"_21804":52349,"_5":15036,"_28646":52261,"_3122":52350},[],"Point DNS at the VM's reachable address.",{"_3731":327,"_31485":294,"_21804":52352,"_5":15036,"_28646":52261,"_3122":52353},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3731":328,"_31485":294,"_21804":52355,"_5":15036,"_28646":52265,"_3122":52356},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3731":329,"_31485":294,"_21804":52358,"_5":15036,"_28646":52269,"_3122":52359},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3731":330,"_31485":294,"_21804":52361,"_5":15036,"_28646":52269,"_3122":52362},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3731":331,"_31485":294,"_21804":52364,"_5":15036,"_28646":52273,"_3122":52365},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3731":332,"_31485":294,"_21804":52367,"_5":15036,"_28646":52273,"_3122":52368},[],"Requirement",{"_3731":333,"_31485":294,"_21804":52370,"_5":15036,"_28646":52273,"_3122":52371},[],"Recommended design",{"_3731":334,"_31485":294,"_21804":52373,"_5":15036,"_28646":52273,"_3122":52374},[],"Consequence",{"_3731":335,"_31485":294,"_21804":52376,"_5":15036,"_28646":52273,"_3122":52377},[],"Several Lamassu URLs or services",{"_3731":336,"_31485":294,"_21804":52379,"_5":15036,"_28646":52273,"_3122":52380},[],"One Gateway with multiple routes",{"_3731":337,"_31485":294,"_21804":52382,"_5":15036,"_28646":52273,"_3122":52383},[],"One IP and one proxy fleet; this is the chart default",{"_3731":338,"_31485":294,"_21804":52385,"_5":15036,"_28646":52273,"_3122":52386},[],"Independent Gateways and separate external IPs",{"_3731":339,"_31485":294,"_21804":52388,"_5":15036,"_28646":52273,"_3122":52389},[],"One VIP per Gateway",{"_3731":340,"_31485":294,"_21804":52391,"_5":15036,"_28646":52273,"_3122":52392},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3731":341,"_31485":294,"_21804":52394,"_5":15036,"_28646":52273,"_3122":52395},[],"Independent Gateways on one node and one IP",{"_3731":342,"_31485":294,"_21804":52397,"_5":15036,"_28646":52273,"_3122":52398},[],"Use different external ports",{"_3731":343,"_31485":294,"_21804":52400,"_5":15036,"_28646":52273,"_3122":52401},[],"Clients must include non-standard ports",{"_3731":344,"_31485":294,"_21804":52403,"_5":15036,"_28646":52273,"_3122":52404},[],"Separate TLS/mTLS termination behind one IP",{"_3731":345,"_31485":294,"_21804":52406,"_5":15036,"_28646":52273,"_3122":52407},[],"Front-door SNI routing to internal Gateways",{"_3731":346,"_31485":294,"_21804":52409,"_5":15036,"_28646":52273,"_3122":52410},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3731":347,"_31485":294,"_21804":52412,"_5":15036,"_28646":52273,"_3122":52413},[],"Separate Gateway resources but shared proxy infrastructure",{"_3731":348,"_31485":294,"_21804":52415,"_5":15036,"_28646":52273,"_3122":52416},[],"Envoy merged-Gateway mode",{"_3731":349,"_31485":294,"_21804":52418,"_5":15036,"_28646":52273,"_3122":52419},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3731":350,"_31485":294,"_21804":52421,"_5":15036,"_28646":52273,"_3122":52422},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3731":351,"_31485":294,"_21804":52424,"_5":15036,"_28646":52273,"_3122":52425},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3731":352,"_31485":294,"_21804":52427,"_5":15036,"_28646":52273,"_3122":52428},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3731":353,"_31485":294,"_21804":52430,"_5":15036,"_28646":52273,"_3122":52431},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3731":354,"_31485":294,"_21804":52433,"_5":15036,"_28646":52277,"_3122":52434},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3731":355,"_31485":294,"_21804":52436,"_5":15036,"_28646":52281,"_3122":52437},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3731":356,"_31485":294,"_21804":52439,"_5":15036,"_28646":52281,"_3122":52440},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3731":357,"_31485":294,"_21804":52442,"_5":15036,"_28646":52281,"_3122":52443},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3731":358,"_31485":294,"_21804":52445,"_5":15036,"_28646":52281,"_3122":52446},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3731":359,"_31485":294,"_21804":52448,"_5":15036,"_28646":52281,"_3122":52449},[],"If none of those are possible, use different external ports or change the external network design.",{"_3731":360,"_31485":294,"_21804":52451,"_5":15036,"_28646":52285,"_3122":52452},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3731":361,"_31485":294,"_21804":52454,"_5":15036,"_28646":52285,"_3122":52455},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3731":362,"_31485":294,"_21804":52457,"_5":15036,"_28646":52289,"_3122":52458},[],"Check, in order:",{"_3731":363,"_31485":294,"_21804":52460,"_5":15036,"_28646":52289,"_3122":52461},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3731":364,"_31485":294,"_21804":52463,"_5":15036,"_28646":52289,"_3122":52464},[],"Its status contains the expected address.",{"_3731":365,"_31485":294,"_21804":52466,"_5":15036,"_28646":52289,"_3122":52467},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3731":366,"_31485":294,"_21804":52469,"_5":15036,"_28646":52289,"_3122":52470},[],"Port 443 reaches that address from the client network.",{"_3731":367,"_31485":294,"_21804":52472,"_5":15036,"_28646":52289,"_3122":52473},[],"DNS resolves to the externally reachable endpoint.",{"_3731":368,"_31485":294,"_21804":52475,"_5":15036,"_28646":52289,"_3122":52476},[],"The certificate contains the DNS name or IP used by the client.",{"_3731":369,"_31485":294,"_21804":52478,"_5":15036,"_28646":52289,"_3122":52479},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3731":370,"_31485":370,"_5":15390,"_3122":51480,"_31812":52481,"_21804":52482,"_28646":370},[51373,51374,51480],[],{"_3731":371,"_31485":370,"_21804":52484,"_5":15036,"_28646":370,"_3122":52485},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3731":372,"_31485":370,"_5":31809,"_21804":52487,"_28646":52488,"_3122":52489},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3731":373,"_31485":370,"_5":31809,"_21804":52491,"_28646":52492,"_3122":52493},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3731":374,"_31485":370,"_5":31809,"_21804":52495,"_28646":52496,"_3122":52497},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3731":375,"_31485":370,"_5":31809,"_21804":52499,"_28646":52500,"_3122":52501},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3731":376,"_31485":370,"_5":31809,"_21804":52503,"_28646":52504,"_3122":52505},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3731":377,"_31485":370,"_5":31809,"_21804":52507,"_28646":52508,"_3122":52509},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3731":378,"_31485":370,"_21804":52511,"_5":15036,"_28646":52488,"_3122":52512},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3731":379,"_31485":370,"_21804":52514,"_5":15036,"_28646":52492,"_3122":52515},[],"Workflow",{"_3731":380,"_31485":370,"_21804":52517,"_5":15036,"_28646":52492,"_3122":52518},[],"Use it for",{"_3731":381,"_31485":370,"_21804":52520,"_5":15036,"_28646":52492,"_3122":52521},[],"What it installs",{"_3731":382,"_31485":370,"_21804":52523,"_5":15036,"_28646":52492,"_3122":52524},[],"Helm",{"_3731":383,"_31485":370,"_21804":52526,"_5":15036,"_28646":52492,"_3122":52527},[],"Production and controlled environments",{"_3731":384,"_31485":370,"_21804":52529,"_5":15036,"_28646":52492,"_3122":52530},[],"Lamassu services and Gateway API resources",{"_3731":385,"_31485":370,"_21804":52532,"_5":15036,"_28646":52492,"_3122":51617},[],{"_3731":386,"_31485":370,"_21804":52534,"_5":15036,"_28646":52492,"_3122":52535},[],"Evaluation, demos, CI and small lab clusters",{"_3731":387,"_31485":370,"_21804":52537,"_5":15036,"_28646":52492,"_3122":52538},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3731":388,"_31485":370,"_21804":52540,"_5":15036,"_28646":52496,"_3122":52541},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3731":389,"_31485":370,"_21804":52543,"_5":15036,"_28646":52496,"_3122":52544},[],"Area",{"_3731":390,"_31485":370,"_21804":52546,"_5":15036,"_28646":52496,"_3122":52547},[],"The Lamassu chart provides",{"_3731":391,"_31485":370,"_21804":52549,"_5":15036,"_28646":52496,"_3122":52550},[],"You provide",{"_3731":392,"_31485":370,"_21804":52552,"_5":15036,"_28646":52496,"_3122":52553},[],"Lamassu applications",{"_3731":393,"_31485":370,"_21804":52555,"_5":15036,"_28646":52496,"_3122":52556},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3731":394,"_31485":370,"_21804":52558,"_5":15036,"_28646":52496,"_3122":52559},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3731":395,"_31485":370,"_21804":52561,"_5":15036,"_28646":52496,"_3122":52562},[],"PostgreSQL data",{"_3731":396,"_31485":370,"_21804":52564,"_5":15036,"_28646":52496,"_3122":52565},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3731":397,"_31485":370,"_21804":52567,"_5":15036,"_28646":52496,"_3122":52568},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3731":398,"_31485":370,"_21804":52570,"_5":15036,"_28646":52496,"_3122":52571},[],"Messaging",{"_3731":399,"_31485":370,"_21804":52573,"_5":15036,"_28646":52496,"_3122":52574},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3731":400,"_31485":370,"_21804":52576,"_5":15036,"_28646":52496,"_3122":52577},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3731":401,"_31485":370,"_21804":52579,"_5":15036,"_28646":52496,"_3122":52580},[],"Identity",{"_3731":402,"_31485":370,"_21804":52582,"_5":15036,"_28646":52496,"_3122":52583},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3731":403,"_31485":370,"_21804":52585,"_5":15036,"_28646":52496,"_3122":52586},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3731":404,"_31485":370,"_21804":52588,"_5":15036,"_28646":52496,"_3122":52589},[],"External routing",{"_3731":405,"_31485":370,"_21804":52591,"_5":15036,"_28646":52496,"_3122":52592},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3731":406,"_31485":370,"_21804":52594,"_5":15036,"_28646":52496,"_3122":52595},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3731":407,"_31485":370,"_21804":52597,"_5":15036,"_28646":52496,"_3122":52598},[],"TLS",{"_3731":408,"_31485":370,"_21804":52600,"_5":15036,"_28646":52496,"_3122":52601},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3731":409,"_31485":370,"_21804":52603,"_5":15036,"_28646":52496,"_3122":52604},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3731":410,"_31485":370,"_21804":52606,"_5":15036,"_28646":52496,"_3122":52607},[],"Persistent application data",{"_3731":411,"_31485":370,"_21804":52609,"_5":15036,"_28646":52496,"_3122":52610},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3731":412,"_31485":370,"_21804":52612,"_5":15036,"_28646":52496,"_3122":52613},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3731":413,"_31485":370,"_21804":52615,"_5":15036,"_28646":52496,"_3122":52616},[],"Optional integrations",{"_3731":414,"_31485":370,"_21804":52618,"_5":15036,"_28646":52496,"_3122":52619},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3731":415,"_31485":370,"_21804":52621,"_5":15036,"_28646":52496,"_3122":52622},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3731":416,"_31485":370,"_21804":52624,"_5":15036,"_28646":52496,"_3122":52625},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3731":417,"_31485":370,"_21804":52627,"_5":15036,"_28646":52496,"_3122":52628},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3731":418,"_31485":370,"_21804":52630,"_5":15036,"_28646":52500,"_3122":52631},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3731":419,"_31485":370,"_21804":52633,"_5":15036,"_28646":52500,"_3122":52634},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3731":420,"_31485":370,"_21804":52636,"_5":15036,"_28646":52504,"_3122":52637},[],"Kubernetes 1.24 or newer",{"_3731":421,"_31485":370,"_21804":52639,"_5":15036,"_28646":52504,"_3122":52640},[],"Helm 3.2 or newer",{"_3731":422,"_31485":370,"_21804":52642,"_5":15036,"_28646":52504,"_3122":52643},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3731":423,"_31485":370,"_21804":52645,"_5":15036,"_28646":52504,"_3122":52646},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3731":424,"_31485":370,"_21804":52648,"_5":15036,"_28646":52504,"_3122":52649},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3731":425,"_31485":370,"_21804":52651,"_5":15036,"_28646":52504,"_3122":52652},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3731":426,"_31485":370,"_21804":52654,"_5":15036,"_28646":52504,"_3122":52655},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3731":427,"_31485":370,"_21804":52657,"_5":15036,"_28646":52508,"_3122":52658},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3731":428,"_31485":370,"_21804":52660,"_5":15036,"_28646":52508,"_3122":52661},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3731":429,"_31485":370,"_21804":52663,"_5":15036,"_28646":52508,"_3122":52664},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3731":430,"_31485":370,"_21804":52666,"_5":15036,"_28646":52508,"_3122":52667},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3731":431,"_31485":431,"_5":15390,"_3122":52669,"_31812":52670,"_21804":52672,"_28646":431},"Deployment troubleshooting",[51373,51374,52671],"Operations",[],{"_3731":432,"_31485":431,"_21804":52674,"_5":15036,"_28646":431,"_3122":52675},[],"Diagnose access, service health and infrastructure dependencies.",{"_3731":433,"_31485":431,"_5":31809,"_21804":52677,"_28646":52678,"_3122":52679},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3731":434,"_31485":431,"_5":31809,"_21804":52681,"_28646":52682,"_3122":52683},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3731":435,"_31485":431,"_5":31809,"_21804":52685,"_28646":52686,"_3122":52687},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3731":436,"_31485":431,"_5":31809,"_21804":52689,"_28646":52690,"_3122":52691},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3731":437,"_31485":431,"_5":31809,"_21804":52693,"_28646":52694,"_3122":52695},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3731":438,"_31485":431,"_5":31809,"_21804":52697,"_28646":52698,"_3122":52699},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3731":439,"_31485":431,"_5":31809,"_21804":52701,"_28646":52702,"_3122":52703},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3731":440,"_31485":431,"_5":31809,"_21804":52705,"_28646":52706,"_3122":52707},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3731":441,"_31485":431,"_5":31809,"_21804":52709,"_28646":52710,"_3122":52711},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3731":442,"_31485":431,"_5":31809,"_21804":52713,"_28646":52714,"_3122":52715},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3731":443,"_31485":431,"_5":31809,"_21804":52717,"_28646":52718,"_3122":52719},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3731":444,"_31485":431,"_5":31809,"_21804":52721,"_28646":52722,"_3122":52723},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3731":445,"_31485":431,"_5":31809,"_21804":52725,"_28646":52726,"_3122":52727},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3731":446,"_31485":431,"_21804":52729,"_5":15036,"_28646":431,"_3122":52730},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3731":447,"_31485":431,"_21804":52732,"_5":15036,"_28646":52682,"_3122":52733},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3731":448,"_31485":431,"_21804":52735,"_5":15036,"_28646":52686,"_3122":52736},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3731":449,"_31485":431,"_21804":52738,"_5":15036,"_28646":52690,"_3122":52739},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3731":450,"_31485":431,"_21804":52741,"_5":15036,"_28646":52694,"_3122":52742},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3731":451,"_31485":431,"_21804":52744,"_5":15036,"_28646":52698,"_3122":52745},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3731":452,"_31485":431,"_21804":52747,"_5":15036,"_28646":52702,"_3122":52748},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3731":453,"_31485":431,"_21804":52750,"_5":15036,"_28646":52702,"_3122":52751},[],"Also run the chart's connectivity test:",{"_3731":454,"_31485":431,"_21804":52753,"_5":15036,"_28646":52702,"_3122":52754},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3731":455,"_31485":431,"_21804":52756,"_5":15036,"_28646":52702,"_3122":52757},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3731":456,"_31485":431,"_21804":52759,"_5":15036,"_28646":52706,"_3122":52760},[],"If you receive a 401:",{"_3731":457,"_31485":431,"_21804":52762,"_5":15036,"_28646":52706,"_3122":52763},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3731":458,"_31485":431,"_21804":52765,"_5":15036,"_28646":52706,"_3122":52766},[],"verify issuer, audience and expiration of the token;",{"_3731":459,"_31485":431,"_21804":52768,"_5":15036,"_28646":52706,"_3122":52769},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3731":460,"_31485":431,"_21804":52771,"_5":15036,"_28646":52706,"_3122":52772},[],"check that the provider's public and internal routes point to the same realm.",{"_3731":461,"_31485":431,"_21804":52774,"_5":15036,"_28646":52706,"_3122":52775},[],"If login succeeds but the APIs return 403:",{"_3731":462,"_31485":431,"_21804":52777,"_5":15036,"_28646":52706,"_3122":52778},[],"inspect the token's real claims;",{"_3731":463,"_31485":431,"_21804":52780,"_5":15036,"_28646":52706,"_3122":52781},[],"confirm they match an active principal;",{"_3731":464,"_31485":431,"_21804":52783,"_5":15036,"_28646":52706,"_3122":52784},[],"review the policies granted to that principal;",{"_3731":465,"_31485":431,"_21804":52786,"_5":15036,"_28646":52706,"_3122":52787},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3731":466,"_31485":431,"_21804":52789,"_5":15036,"_28646":52706,"_3122":52790},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3731":467,"_31485":431,"_21804":52792,"_5":15036,"_28646":52710,"_3122":52793},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3731":468,"_31485":431,"_21804":52795,"_5":15036,"_28646":52710,"_3122":52796},[],"Locate the authz pod and Service.",{"_3731":469,"_31485":431,"_21804":52798,"_5":15036,"_28646":52710,"_3122":52799},[],"Check /health, logs and its database connection.",{"_3731":470,"_31485":431,"_21804":52801,"_5":15036,"_28646":52710,"_3122":52802},[],"Verify the DNS and port configured in externalAuthorization.",{"_3731":471,"_31485":431,"_21804":52804,"_5":15036,"_28646":52710,"_3122":52805},[],"Check the check route is /v1/ext\\_authz/check.",{"_3731":472,"_31485":431,"_21804":52807,"_5":15036,"_28646":52710,"_3122":52808},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3731":473,"_31485":431,"_21804":52810,"_5":15036,"_28646":52714,"_3122":52811},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3731":474,"_31485":431,"_21804":52813,"_5":15036,"_28646":52718,"_3122":52814},[],"Review kubectl describe pod first. Common causes are:",{"_3731":475,"_31485":431,"_21804":52816,"_5":15036,"_28646":52718,"_3122":52817},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3731":476,"_31485":431,"_21804":52819,"_5":15036,"_28646":52718,"_3122":52820},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3731":477,"_31485":431,"_21804":52822,"_5":15036,"_28646":52718,"_3122":52823},[],"unbound persistent volume;",{"_3731":478,"_31485":431,"_21804":52825,"_5":15036,"_28646":52718,"_3122":52826},[],"inaccessible image or incorrect pull policy;",{"_3731":479,"_31485":431,"_21804":52828,"_5":15036,"_28646":52718,"_3122":52829},[],"invalid cryptographic engine configuration;",{"_3731":480,"_31485":431,"_21804":52831,"_5":15036,"_28646":52718,"_3122":52832},[],"CPU or memory limits set too low;",{"_3731":481,"_31485":431,"_21804":52834,"_5":15036,"_28646":52718,"_3122":52835},[],"an incomplete prior migration.",{"_3731":482,"_31485":431,"_21804":52837,"_5":15036,"_28646":52718,"_3122":52838},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3731":483,"_31485":431,"_21804":52840,"_5":15036,"_28646":52718,"_3122":52841},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3731":484,"_31485":431,"_21804":52843,"_5":15036,"_28646":52718,"_3122":52844},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3731":485,"_31485":431,"_21804":52846,"_5":15036,"_28646":52722,"_3122":52847},[],"Domain and audit events depend on the bus publisher:",{"_3731":486,"_31485":431,"_21804":52849,"_5":15036,"_28646":52722,"_3122":52850},[],"verify it is enabled in the emitting service;",{"_3731":487,"_31485":431,"_21804":52852,"_5":15036,"_28646":52722,"_3122":52853},[],"check AMQP connectivity and credentials;",{"_3731":488,"_31485":431,"_21804":52855,"_5":15036,"_28646":52722,"_3122":52856},[],"review exchange, routing key, queues and consumers;",{"_3731":489,"_31485":431,"_21804":52858,"_5":15036,"_28646":52722,"_3122":52859},[],"inspect dead-letter queues;",{"_3731":490,"_31485":431,"_21804":52861,"_5":15036,"_28646":52722,"_3122":52862},[],"alert on orphan durable queues and backlog growth.",{"_3731":491,"_31485":431,"_21804":52864,"_5":15036,"_28646":52722,"_3122":52865},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3731":492,"_31485":431,"_21804":52867,"_5":15036,"_28646":52722,"_3122":52868},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3731":493,"_31485":431,"_21804":52870,"_5":15036,"_28646":52722,"_3122":52871},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3731":494,"_31485":431,"_21804":52873,"_5":15036,"_28646":52722,"_3122":52874},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3731":495,"_31485":431,"_21804":52876,"_5":15036,"_28646":52722,"_3122":52877},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3731":496,"_31485":431,"_21804":52879,"_5":15036,"_28646":52722,"_3122":52880},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3731":497,"_31485":431,"_21804":52882,"_5":15036,"_28646":52722,"_3122":52883},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3731":498,"_31485":431,"_21804":52885,"_5":15036,"_28646":52726,"_3122":52886},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3731":499,"_31485":431,"_21804":52888,"_5":15036,"_28646":52726,"_3122":52889},[],"Before closing an incident, record:",{"_3731":500,"_31485":431,"_21804":52891,"_5":15036,"_28646":52726,"_3122":52892},[],"the confirmed cause;",{"_3731":501,"_31485":431,"_21804":52894,"_5":15036,"_28646":52726,"_3122":52895},[],"the time scope and affected resources;",{"_3731":502,"_31485":431,"_21804":52897,"_5":15036,"_28646":52726,"_3122":52898},[],"the commands or queries used;",{"_3731":503,"_31485":431,"_21804":52900,"_5":15036,"_28646":52726,"_3122":52901},[],"the applied change and how to revert it;",{"_3731":504,"_31485":431,"_21804":52903,"_5":15036,"_28646":52726,"_3122":52904},[],"validation from a consumer;",{"_3731":505,"_31485":431,"_21804":52906,"_5":15036,"_28646":52726,"_3122":52907},[],"the preventive action and its owner.",{"_3731":506,"_31485":506,"_5":15390,"_3122":52909,"_31812":52910,"_21804":52914,"_28646":506},"Data model",[51373,52911,52912,52913],"Platform","Administration","Access control",[],{"_3731":507,"_31485":506,"_21804":52916,"_5":15036,"_28646":506,"_3122":52917},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3731":508,"_31485":506,"_5":31809,"_21804":52919,"_28646":52920,"_3122":52921},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3731":509,"_31485":506,"_5":31809,"_21804":52923,"_28646":52924,"_3122":52925},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3731":510,"_31485":506,"_21804":52927,"_5":15036,"_28646":506,"_3122":52928},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3731":511,"_31485":506,"_21804":52930,"_5":15036,"_28646":52920,"_3122":52931},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3731":512,"_31485":506,"_21804":52933,"_5":15036,"_28646":52920,"_3122":52934},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3731":513,"_31485":506,"_21804":52936,"_5":15036,"_28646":52920,"_3122":52937},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3731":514,"_31485":506,"_21804":52939,"_5":15036,"_28646":52924,"_3122":52940},[],"Entity (`schema_name.entity_type`)",{"_3731":515,"_31485":506,"_21804":52942,"_5":15036,"_28646":52924,"_3122":52943},[],"Table (`table_name`)",{"_3731":516,"_31485":506,"_21804":52945,"_5":15036,"_28646":52924,"_3122":52946},[],"Key (`primary_key`)",{"_3731":517,"_31485":506,"_21804":52948,"_5":15036,"_28646":52924,"_3122":52949},[],"`alerts.event`",{"_3731":518,"_31485":506,"_21804":52951,"_5":15036,"_28646":52924,"_3122":52952},[],"`events`",{"_3731":519,"_31485":506,"_21804":52954,"_5":15036,"_28646":52924,"_3122":52955},[],"`event_type`",{"_3731":520,"_31485":506,"_21804":52957,"_5":15036,"_28646":52924,"_3122":52958},[],"`alerts.subscription`",{"_3731":521,"_31485":506,"_21804":52960,"_5":15036,"_28646":52924,"_3122":52961},[],"`subscriptions`",{"_3731":522,"_31485":506,"_21804":52963,"_5":15036,"_28646":52924,"_3122":52964},[],"`id`",{"_3731":523,"_31485":506,"_21804":52966,"_5":15036,"_28646":52924,"_3122":52967},[],"`ca.ca_certificate`",{"_3731":524,"_31485":506,"_21804":52969,"_5":15036,"_28646":52924,"_3122":52970},[],"`ca_certificates`",{"_3731":525,"_31485":506,"_21804":52972,"_5":15036,"_28646":52924,"_3122":52964},[],{"_3731":526,"_31485":506,"_21804":52974,"_5":15036,"_28646":52924,"_3122":52975},[],"`ca.certificate`",{"_3731":527,"_31485":506,"_21804":52977,"_5":15036,"_28646":52924,"_3122":52978},[],"`certificates`",{"_3731":528,"_31485":506,"_21804":52980,"_5":15036,"_28646":52924,"_3122":52981},[],"`serial_number`",{"_3731":529,"_31485":506,"_21804":52983,"_5":15036,"_28646":52924,"_3122":52984},[],"`ca.issuance_profile`",{"_3731":530,"_31485":506,"_21804":52986,"_5":15036,"_28646":52924,"_3122":52987},[],"`issuance_profiles`",{"_3731":531,"_31485":506,"_21804":52989,"_5":15036,"_28646":52924,"_3122":52964},[],{"_3731":532,"_31485":506,"_21804":52991,"_5":15036,"_28646":52924,"_3122":52992},[],"`devicemanager.device_group`",{"_3731":533,"_31485":506,"_21804":52994,"_5":15036,"_28646":52924,"_3122":52995},[],"`device_groups`",{"_3731":534,"_31485":506,"_21804":52997,"_5":15036,"_28646":52924,"_3122":52964},[],{"_3731":535,"_31485":506,"_21804":52999,"_5":15036,"_28646":52924,"_3122":53000},[],"`devicemanager.device`",{"_3731":536,"_31485":506,"_21804":53002,"_5":15036,"_28646":52924,"_3122":53003},[],"`devices`",{"_3731":537,"_31485":506,"_21804":53005,"_5":15036,"_28646":52924,"_3122":52964},[],{"_3731":538,"_31485":506,"_21804":53007,"_5":15036,"_28646":52924,"_3122":53008},[],"`dmsmanager.dms`",{"_3731":539,"_31485":506,"_21804":53010,"_5":15036,"_28646":52924,"_3122":53011},[],"`dms`",{"_3731":540,"_31485":506,"_21804":53013,"_5":15036,"_28646":52924,"_3122":52964},[],{"_3731":541,"_31485":506,"_21804":53015,"_5":15036,"_28646":52924,"_3122":53016},[],"`kms.kms_key`",{"_3731":542,"_31485":506,"_21804":53018,"_5":15036,"_28646":52924,"_3122":53019},[],"`kms_keys`",{"_3731":543,"_31485":506,"_21804":53021,"_5":15036,"_28646":52924,"_3122":53022},[],"`key_id`, `engine_id`",{"_3731":544,"_31485":506,"_21804":53024,"_5":15036,"_28646":52924,"_3122":53025},[],"`va.crl_settings`",{"_3731":545,"_31485":506,"_21804":53027,"_5":15036,"_28646":52924,"_3122":53028},[],"`crl_settings`",{"_3731":546,"_31485":506,"_21804":53030,"_5":15036,"_28646":52924,"_3122":53031},[],"`ca_id`",{"_3731":547,"_31485":506,"_21804":53033,"_5":15036,"_28646":52924,"_3122":53034},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3731":548,"_31485":506,"_21804":53036,"_5":15036,"_28646":52924,"_3122":53037},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3731":549,"_31485":506,"_21804":53039,"_5":15036,"_28646":52924,"_3122":53040},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3731":550,"_31485":550,"_5":15390,"_3122":53042,"_31812":53043,"_21804":53044,"_28646":550},"Access control overview",[51373,52911,52912,52913],[],{"_3731":551,"_31485":550,"_21804":53046,"_5":15036,"_28646":550,"_3122":53047},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3731":552,"_31485":550,"_5":31809,"_21804":53049,"_28646":53050,"_3122":53051},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3731":553,"_31485":550,"_5":31809,"_21804":53053,"_28646":53054,"_3122":53055},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3731":554,"_31485":550,"_5":31809,"_21804":53057,"_28646":53058,"_3122":53059},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3731":555,"_31485":550,"_5":31809,"_21804":53061,"_28646":53062,"_3122":53063},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3731":556,"_31485":550,"_5":31809,"_21804":53065,"_28646":53066,"_3122":53067},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3731":557,"_31485":550,"_5":31809,"_21804":53069,"_28646":53070,"_3122":53071},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3731":558,"_31485":550,"_5":31809,"_21804":53073,"_28646":53074,"_3122":53075},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3731":559,"_31485":550,"_5":31809,"_21804":53077,"_28646":53078,"_3122":53079},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3731":560,"_31485":550,"_5":31809,"_21804":53081,"_28646":53082,"_3122":53083},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3731":561,"_31485":550,"_5":31809,"_21804":53085,"_28646":53086,"_3122":53087},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3731":562,"_31485":550,"_5":31809,"_21804":53089,"_28646":53090,"_3122":53091},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3731":563,"_31485":550,"_5":31809,"_21804":53093,"_28646":53094,"_3122":53095},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3731":564,"_31485":550,"_5":31809,"_21804":53097,"_28646":53098,"_3122":53099},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3731":565,"_31485":550,"_5":31809,"_21804":53101,"_28646":53102,"_3122":53103},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3731":566,"_31485":550,"_5":31809,"_21804":53105,"_28646":53106,"_3122":53107},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3731":567,"_31485":550,"_5":31809,"_21804":53109,"_28646":53110,"_3122":52027},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3731":568,"_31485":550,"_5":31809,"_21804":53112,"_28646":53113,"_3122":53114},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3731":569,"_31485":550,"_5":31809,"_21804":53116,"_28646":53117,"_3122":53118},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3731":570,"_31485":550,"_5":31809,"_21804":53120,"_28646":53121,"_3122":53122},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3731":571,"_31485":550,"_5":31809,"_21804":53124,"_28646":53125,"_3122":53126},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3731":572,"_31485":550,"_5":31809,"_21804":53128,"_28646":53129,"_3122":53130},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3731":573,"_31485":550,"_5":31809,"_21804":53132,"_28646":53133,"_3122":53134},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3731":574,"_31485":550,"_5":31809,"_21804":53136,"_28646":53137,"_3122":53138},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3731":575,"_31485":550,"_5":31809,"_21804":53140,"_28646":53141,"_3122":53142},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3731":576,"_31485":550,"_5":31809,"_21804":53144,"_28646":53145,"_3122":53146},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3731":577,"_31485":550,"_5":31809,"_21804":53148,"_28646":53149,"_3122":53150},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3731":578,"_31485":550,"_5":31809,"_21804":53152,"_28646":53153,"_3122":53154},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3731":579,"_31485":550,"_5":31809,"_21804":53156,"_28646":53157,"_3122":53158},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3731":580,"_31485":550,"_5":31809,"_21804":53160,"_28646":53161,"_3122":53162},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3731":581,"_31485":550,"_5":31809,"_21804":53164,"_28646":53165,"_3122":53166},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3731":582,"_31485":550,"_5":31809,"_21804":53168,"_28646":53169,"_3122":53170},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3731":583,"_31485":550,"_21804":53172,"_5":15036,"_28646":550,"_3122":53173},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3731":584,"_31485":550,"_21804":53175,"_5":15036,"_28646":550,"_3122":53176},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3731":585,"_31485":550,"_21804":53178,"_5":15036,"_28646":550,"_3122":53179},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3731":586,"_31485":550,"_21804":53181,"_5":15036,"_28646":53050,"_3122":53182},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3731":587,"_31485":550,"_21804":53184,"_5":15036,"_28646":53050,"_3122":53185},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3731":588,"_31485":550,"_21804":53187,"_5":15036,"_28646":53050,"_3122":53188},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3731":589,"_31485":550,"_21804":53190,"_5":15036,"_28646":53050,"_3122":53191},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3731":590,"_31485":550,"_21804":53193,"_5":15036,"_28646":53050,"_3122":53194},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3731":591,"_31485":550,"_21804":53196,"_5":15036,"_28646":53050,"_3122":53197},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3731":592,"_31485":550,"_21804":53199,"_5":15036,"_28646":53054,"_3122":53200},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3731":593,"_31485":550,"_21804":53202,"_5":15036,"_28646":53054,"_3122":53203},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3731":594,"_31485":550,"_21804":53205,"_5":15036,"_28646":53058,"_3122":53206},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3731":595,"_31485":550,"_21804":53208,"_5":15036,"_28646":53058,"_3122":53209},[],"The decision is made **before forwarding the request to the service**:",{"_3731":596,"_31485":550,"_21804":53211,"_5":15036,"_28646":53058,"_3122":53212},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3731":597,"_31485":550,"_21804":53214,"_5":15036,"_28646":53058,"_3122":53215},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3731":598,"_31485":550,"_21804":53217,"_5":15036,"_28646":53058,"_3122":53218},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3731":599,"_31485":550,"_21804":53220,"_5":15036,"_28646":53058,"_3122":53221},[],"It separately loads the policies granted to each principal.",{"_3731":600,"_31485":550,"_21804":53223,"_5":15036,"_28646":53058,"_3122":53224},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3731":601,"_31485":550,"_21804":53226,"_5":15036,"_28646":53058,"_3122":53227},[],"`authz` looks for an HTTP rule granting that action.",{"_3731":602,"_31485":550,"_21804":53229,"_5":15036,"_28646":53058,"_3122":53230},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3731":603,"_31485":550,"_21804":53232,"_5":15036,"_28646":53058,"_3122":53233},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3731":604,"_31485":550,"_21804":53235,"_5":15036,"_28646":53058,"_3122":53236},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3731":605,"_31485":550,"_21804":53238,"_5":15036,"_28646":53058,"_3122":53239},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3731":606,"_31485":550,"_21804":53241,"_5":15036,"_28646":53062,"_3122":53242},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3731":607,"_31485":550,"_21804":53244,"_5":15036,"_28646":53062,"_3122":53245},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3731":608,"_31485":550,"_21804":53247,"_5":15036,"_28646":53062,"_3122":53248},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3731":609,"_31485":550,"_21804":53250,"_5":15036,"_28646":53062,"_3122":53251},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3731":610,"_31485":550,"_21804":53253,"_5":15036,"_28646":53062,"_3122":53254},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3731":611,"_31485":550,"_21804":53256,"_5":15036,"_28646":53062,"_3122":53257},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3731":612,"_31485":550,"_21804":53259,"_5":15036,"_28646":53062,"_3122":53260},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3731":613,"_31485":550,"_21804":53262,"_5":15036,"_28646":53062,"_3122":53263},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3731":614,"_31485":550,"_21804":53265,"_5":15036,"_28646":53062,"_3122":53266},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3731":615,"_31485":550,"_21804":53268,"_5":15036,"_28646":53062,"_3122":53269},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3731":616,"_31485":550,"_21804":53271,"_5":15036,"_28646":53066,"_3122":53272},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3731":617,"_31485":550,"_21804":53274,"_5":15036,"_28646":53066,"_3122":53275},[],"The decision is made with the domain operation context:",{"_3731":618,"_31485":550,"_21804":53277,"_5":15036,"_28646":53066,"_3122":53278},[],"The middleware extracts the credential and resolves the matching principals.",{"_3731":619,"_31485":550,"_21804":53280,"_5":15036,"_28646":53066,"_3122":53281},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3731":620,"_31485":550,"_21804":53283,"_5":15036,"_28646":53066,"_3122":53284},[],"`authz` gathers the entity rules of the granted policies.",{"_3731":621,"_31485":550,"_21804":53286,"_5":15036,"_28646":53066,"_3122":53287},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3731":622,"_31485":550,"_21804":53289,"_5":15036,"_28646":53066,"_3122":53290},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3731":623,"_31485":550,"_21804":53292,"_5":15036,"_28646":53066,"_3122":53293},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3731":624,"_31485":550,"_21804":53295,"_5":15036,"_28646":53066,"_3122":53296},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3731":625,"_31485":550,"_21804":53298,"_5":15036,"_28646":53066,"_3122":53299},[],"Actions fall into two groups:",{"_3731":626,"_31485":550,"_21804":53301,"_5":15036,"_28646":53066,"_3122":53302},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3731":627,"_31485":550,"_21804":53304,"_5":15036,"_28646":53066,"_3122":53305},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3731":628,"_31485":550,"_21804":53307,"_5":15036,"_28646":53066,"_3122":53308},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3731":629,"_31485":550,"_21804":53310,"_5":15036,"_28646":53070,"_3122":53311},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3731":630,"_31485":550,"_21804":53313,"_5":15036,"_28646":53070,"_3122":53314},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3731":631,"_31485":550,"_21804":53316,"_5":15036,"_28646":53070,"_3122":53317},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3731":632,"_31485":550,"_21804":53319,"_5":15036,"_28646":53074,"_3122":53320},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3731":633,"_31485":550,"_21804":53322,"_5":15036,"_28646":53074,"_3122":53323},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3731":634,"_31485":550,"_21804":53325,"_5":15036,"_28646":53074,"_3122":53326},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3731":635,"_31485":550,"_21804":53328,"_5":15036,"_28646":53074,"_3122":53329},[],"The implemented operators are:",{"_3731":636,"_31485":550,"_21804":53331,"_5":15036,"_28646":53074,"_3122":53332},[],"`equals`, for exact equality;",{"_3731":637,"_31485":550,"_21804":53334,"_5":15036,"_28646":53074,"_3122":53335},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3731":638,"_31485":550,"_21804":53337,"_5":15036,"_28646":53074,"_3122":53338},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3731":639,"_31485":550,"_21804":53340,"_5":15036,"_28646":53074,"_3122":53341},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3731":640,"_31485":550,"_21804":53343,"_5":15036,"_28646":53078,"_3122":53344},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3731":641,"_31485":550,"_21804":53346,"_5":15036,"_28646":53078,"_3122":53347},[],"The available modes are:",{"_3731":642,"_31485":550,"_21804":53349,"_5":15036,"_28646":53078,"_3122":53350},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3731":643,"_31485":550,"_21804":53352,"_5":15036,"_28646":53078,"_3122":53353},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3731":644,"_31485":550,"_21804":53355,"_5":15036,"_28646":53078,"_3122":53356},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3731":645,"_31485":550,"_21804":53358,"_5":15036,"_28646":53078,"_3122":53359},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3731":646,"_31485":550,"_21804":53361,"_5":15036,"_28646":53078,"_3122":53362},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3731":647,"_31485":550,"_21804":53364,"_5":15036,"_28646":53078,"_3122":53365},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3731":648,"_31485":550,"_21804":53367,"_5":15036,"_28646":53082,"_3122":53368},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3731":649,"_31485":550,"_21804":53370,"_5":15036,"_28646":53082,"_3122":53371},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3731":650,"_31485":550,"_21804":53373,"_5":15036,"_28646":53082,"_3122":53374},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3731":651,"_31485":550,"_21804":53376,"_5":15036,"_28646":53082,"_3122":53377},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3731":652,"_31485":550,"_21804":53379,"_5":15036,"_28646":53090,"_3122":53380},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3731":653,"_31485":550,"_21804":53382,"_5":15036,"_28646":53090,"_3122":53383},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3731":654,"_31485":550,"_21804":53385,"_5":15036,"_28646":53094,"_3122":53386},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3731":655,"_31485":550,"_21804":53388,"_5":15036,"_28646":53094,"_3122":53389},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3731":656,"_31485":550,"_21804":53391,"_5":15036,"_28646":53094,"_3122":53392},[],"The data model shows how the resources used in entity rules are connected.",{"_3731":657,"_31485":550,"_21804":53394,"_5":15036,"_28646":53094,"_3122":53395},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3731":658,"_31485":550,"_21804":53397,"_5":15036,"_28646":53094,"_3122":53398},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3731":659,"_31485":550,"_21804":53400,"_5":15036,"_28646":53098,"_3122":53401},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3731":660,"_31485":550,"_21804":53403,"_5":15036,"_28646":53098,"_3122":53404},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3731":661,"_31485":550,"_21804":53406,"_5":15036,"_28646":53098,"_3122":53407},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3731":662,"_31485":550,"_21804":53409,"_5":15036,"_28646":53102,"_3122":53410},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3731":663,"_31485":550,"_21804":53412,"_5":15036,"_28646":53102,"_3122":53413},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3731":664,"_31485":550,"_21804":53415,"_5":15036,"_28646":53102,"_3122":53416},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3731":665,"_31485":550,"_21804":53418,"_5":15036,"_28646":53102,"_3122":53419},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3731":666,"_31485":550,"_21804":53421,"_5":15036,"_28646":53102,"_3122":53422},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3731":667,"_31485":550,"_21804":53424,"_5":15036,"_28646":53102,"_3122":53425},[],"Note that:",{"_3731":668,"_31485":550,"_21804":53427,"_5":15036,"_28646":53102,"_3122":53428},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3731":669,"_31485":550,"_21804":53430,"_5":15036,"_28646":53102,"_3122":53431},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3731":670,"_31485":550,"_21804":53433,"_5":15036,"_28646":53102,"_3122":53434},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3731":671,"_31485":550,"_21804":53436,"_5":15036,"_28646":53106,"_3122":53437},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3731":672,"_31485":550,"_21804":53439,"_5":15036,"_28646":53106,"_3122":53440},[],"full and read-only access to certificates and authorities;",{"_3731":673,"_31485":550,"_21804":53442,"_5":15036,"_28646":53106,"_3122":53443},[],"full and read-only access to the KMS;",{"_3731":674,"_31485":550,"_21804":53445,"_5":15036,"_28646":53106,"_3122":53446},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3731":675,"_31485":550,"_21804":53448,"_5":15036,"_28646":53106,"_3122":53449},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3731":676,"_31485":550,"_21804":53451,"_5":15036,"_28646":53106,"_3122":53452},[],"console access;",{"_3731":677,"_31485":550,"_21804":53454,"_5":15036,"_28646":53106,"_3122":53455},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3731":678,"_31485":550,"_21804":53457,"_5":15036,"_28646":53106,"_3122":53458},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3731":679,"_31485":550,"_21804":53460,"_5":15036,"_28646":53106,"_3122":53461},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3731":680,"_31485":550,"_21804":53463,"_5":15036,"_28646":53106,"_3122":53464},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3731":681,"_31485":550,"_21804":53466,"_5":15036,"_28646":53106,"_3122":53467},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3731":682,"_31485":550,"_21804":53469,"_5":15036,"_28646":53110,"_3122":53470},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3731":683,"_31485":550,"_21804":53472,"_5":15036,"_28646":53110,"_3122":53473},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3731":684,"_31485":550,"_21804":53475,"_5":15036,"_28646":53110,"_3122":53476},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3731":685,"_31485":550,"_21804":53478,"_5":15036,"_28646":53113,"_3122":53479},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3731":686,"_31485":550,"_21804":53481,"_5":15036,"_28646":53117,"_3122":53482},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3731":687,"_31485":550,"_21804":53484,"_5":15036,"_28646":53117,"_3122":53485},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3731":688,"_31485":550,"_21804":53487,"_5":15036,"_28646":53121,"_3122":53488},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3731":689,"_31485":550,"_21804":53490,"_5":15036,"_28646":53125,"_3122":53491},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3731":690,"_31485":550,"_21804":53493,"_5":15036,"_28646":53129,"_3122":53494},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3731":691,"_31485":550,"_21804":53496,"_5":15036,"_28646":53133,"_3122":53497},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3731":692,"_31485":550,"_21804":53499,"_5":15036,"_28646":53133,"_3122":53500},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3731":693,"_31485":550,"_21804":53502,"_5":15036,"_28646":53137,"_3122":53503},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3731":694,"_31485":550,"_21804":53505,"_5":15036,"_28646":53137,"_3122":53506},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3731":695,"_31485":550,"_21804":53508,"_5":15036,"_28646":53137,"_3122":53509},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3731":696,"_31485":550,"_21804":53511,"_5":15036,"_28646":53137,"_3122":53512},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3731":697,"_31485":550,"_21804":53514,"_5":15036,"_28646":53137,"_3122":53515},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3731":698,"_31485":550,"_21804":53517,"_5":15036,"_28646":53137,"_3122":53518},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3731":699,"_31485":550,"_21804":53520,"_5":15036,"_28646":53137,"_3122":53521},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3731":700,"_31485":550,"_21804":53523,"_5":15036,"_28646":53137,"_3122":53524},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3731":701,"_31485":550,"_21804":53526,"_5":15036,"_28646":53141,"_3122":53527},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3731":702,"_31485":550,"_21804":53529,"_5":15036,"_28646":53141,"_3122":53530},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3731":703,"_31485":550,"_21804":53532,"_5":15036,"_28646":53141,"_3122":53533},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3731":704,"_31485":550,"_21804":53535,"_5":15036,"_28646":53145,"_3122":53536},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3731":705,"_31485":550,"_21804":53538,"_5":15036,"_28646":53145,"_3122":53539},[],"Use groups or stable roles for people and independent identities for automations.",{"_3731":706,"_31485":550,"_21804":53541,"_5":15036,"_28646":53145,"_3122":53542},[],"Keep at least two recovery administrators and test their access periodically.",{"_3731":707,"_31485":550,"_21804":53544,"_5":15036,"_28646":53145,"_3122":53545},[],"Review active principals, their matches and their grants after IdP changes.",{"_3731":708,"_31485":550,"_21804":53547,"_5":15036,"_28646":53145,"_3122":53548},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3731":709,"_31485":550,"_21804":53550,"_5":15036,"_28646":53145,"_3122":53551},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3731":710,"_31485":550,"_21804":53553,"_5":15036,"_28646":53145,"_3122":53554},[],"Always test one allowed and one denied operation for each role.",{"_3731":711,"_31485":550,"_21804":53556,"_5":15036,"_28646":53145,"_3122":53557},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3731":712,"_31485":550,"_21804":53559,"_5":15036,"_28646":53153,"_3122":53560},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3731":713,"_31485":550,"_21804":53562,"_5":15036,"_28646":53157,"_3122":53563},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3731":714,"_31485":550,"_21804":53565,"_5":15036,"_28646":53157,"_3122":53566},[],"that an active principal of the correct type exists;",{"_3731":715,"_31485":550,"_21804":53568,"_5":15036,"_28646":53157,"_3122":53569},[],"that the claim paths and values match the real token exactly;",{"_3731":716,"_31485":550,"_21804":53571,"_5":15036,"_28646":53157,"_3122":53572},[],"that all of the principal's conditions hold;",{"_3731":717,"_31485":550,"_21804":53574,"_5":15036,"_28646":53157,"_3122":53575},[],"that the principal has the expected policy granted;",{"_3731":718,"_31485":550,"_21804":53577,"_5":15036,"_28646":53157,"_3122":53578},[],"that the policy includes the action and the requested resource type or route;",{"_3731":719,"_31485":550,"_21804":53580,"_5":15036,"_28646":53157,"_3122":53581},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3731":720,"_31485":550,"_21804":53583,"_5":15036,"_28646":53157,"_3122":53584},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3731":721,"_31485":550,"_21804":53586,"_5":15036,"_28646":53157,"_3122":53587},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3731":722,"_31485":550,"_21804":53589,"_5":15036,"_28646":53161,"_3122":53590},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3731":723,"_31485":550,"_21804":53592,"_5":15036,"_28646":53165,"_3122":53593},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3731":724,"_31485":550,"_21804":53595,"_5":15036,"_28646":53169,"_3122":53596},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3731":725,"_31485":550,"_21804":53598,"_5":15036,"_28646":53169,"_3122":53599},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3731":726,"_31485":726,"_5":15390,"_3122":53601,"_31812":53602,"_21804":53603,"_28646":726},"Alerts and subscriptions",[51373,52911,52912],[],{"_3731":727,"_31485":726,"_21804":53605,"_5":15036,"_28646":726,"_3122":53606},[],"Send PKI events to people and external systems.",{"_3731":728,"_31485":726,"_5":31809,"_21804":53608,"_28646":53609,"_3122":53610},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3731":729,"_31485":726,"_5":31809,"_21804":53612,"_28646":53613,"_3122":53614},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3731":730,"_31485":726,"_5":31809,"_21804":53616,"_28646":53617,"_3122":53618},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3731":731,"_31485":726,"_5":31809,"_21804":53620,"_28646":53621,"_3122":53622},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3731":732,"_31485":726,"_5":31809,"_21804":53624,"_28646":53625,"_3122":53626},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3731":733,"_31485":726,"_5":31809,"_21804":53628,"_28646":53629,"_3122":53630},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3731":734,"_31485":726,"_5":31809,"_21804":53632,"_28646":53633,"_3122":53634},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3731":735,"_31485":726,"_5":31809,"_21804":53636,"_28646":53637,"_3122":53638},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3731":736,"_31485":726,"_5":31809,"_21804":53640,"_28646":53641,"_3122":53642},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3731":737,"_31485":726,"_5":31809,"_21804":53644,"_28646":53645,"_3122":53646},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3731":738,"_31485":726,"_5":31809,"_21804":53648,"_28646":53649,"_3122":53650},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3731":739,"_31485":726,"_21804":53652,"_5":15036,"_28646":726,"_3122":53653},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3731":740,"_31485":726,"_21804":53655,"_5":15036,"_28646":53609,"_3122":53656},[],"A service publishes a domain event.",{"_3731":741,"_31485":726,"_21804":53658,"_5":15036,"_28646":53609,"_3122":53659},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3731":742,"_31485":726,"_21804":53661,"_5":15036,"_28646":53609,"_3122":53662},[],"Each subscription's filter decides whether it should be notified.",{"_3731":743,"_31485":726,"_21804":53664,"_5":15036,"_28646":53609,"_3122":53665},[],"Lamassu delivers the event to the configured channel.",{"_3731":744,"_31485":726,"_21804":53667,"_5":15036,"_28646":53609,"_3122":53668},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3731":745,"_31485":726,"_21804":53670,"_5":15036,"_28646":53613,"_3122":53671},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3731":746,"_31485":726,"_21804":53673,"_5":15036,"_28646":53613,"_3122":53674},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3731":747,"_31485":726,"_21804":53676,"_5":15036,"_28646":53613,"_3122":53677},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3731":748,"_31485":726,"_21804":53679,"_5":15036,"_28646":53613,"_3122":53680},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3731":749,"_31485":726,"_21804":53682,"_5":15036,"_28646":53613,"_3122":53683},[],"`apikey_options` requires `header` and `key`.",{"_3731":750,"_31485":726,"_21804":53685,"_5":15036,"_28646":53613,"_3122":53686},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3731":751,"_31485":726,"_21804":53688,"_5":15036,"_28646":53613,"_3122":53689},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3731":752,"_31485":726,"_21804":53691,"_5":15036,"_28646":53613,"_3122":53692},[],"The alerts API reference documents the full `http_client` schema.",{"_3731":753,"_31485":726,"_21804":53694,"_5":15036,"_28646":53621,"_3122":53695},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3731":754,"_31485":726,"_21804":53697,"_5":15036,"_28646":53625,"_3122":53698},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3731":755,"_31485":726,"_21804":53700,"_5":15036,"_28646":53629,"_3122":53701},[],"Add a filter if you don't want to receive every instance of the event.",{"_3731":756,"_31485":726,"_21804":53703,"_5":15036,"_28646":53629,"_3122":53704},[],"**None** notifies all instances of the event.",{"_3731":757,"_31485":726,"_21804":53706,"_5":15036,"_28646":53629,"_3122":53707},[],"**JSON Path** evaluates one or more specific fields.",{"_3731":758,"_31485":726,"_21804":53709,"_5":15036,"_28646":53629,"_3122":53710},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3731":759,"_31485":726,"_21804":53712,"_5":15036,"_28646":53629,"_3122":53713},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3731":760,"_31485":726,"_21804":53715,"_5":15036,"_28646":53629,"_3122":53716},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3731":761,"_31485":726,"_21804":53718,"_5":15036,"_28646":53629,"_3122":53719},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3731":762,"_31485":726,"_21804":53721,"_5":15036,"_28646":53633,"_3122":53722},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3731":763,"_31485":726,"_21804":53724,"_5":15036,"_28646":53637,"_3122":53725},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3731":764,"_31485":726,"_21804":53727,"_5":15036,"_28646":53637,"_3122":53728},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3731":765,"_31485":726,"_21804":53730,"_5":15036,"_28646":53637,"_3122":53731},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3731":766,"_31485":726,"_21804":53733,"_5":15036,"_28646":53637,"_3122":53734},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3731":767,"_31485":726,"_21804":53736,"_5":15036,"_28646":53637,"_3122":53737},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3731":768,"_31485":726,"_21804":53739,"_5":15036,"_28646":53637,"_3122":53740},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3731":769,"_31485":726,"_21804":53742,"_5":15036,"_28646":53637,"_3122":53743},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3731":770,"_31485":726,"_21804":53745,"_5":15036,"_28646":53637,"_3122":53746},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3731":771,"_31485":726,"_21804":53748,"_5":15036,"_28646":53641,"_3122":53749},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3731":772,"_31485":726,"_21804":53751,"_5":15036,"_28646":53641,"_3122":53752},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3731":773,"_31485":726,"_21804":53754,"_5":15036,"_28646":53641,"_3122":53755},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3731":774,"_31485":726,"_21804":53757,"_5":15036,"_28646":53641,"_3122":53758},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3731":775,"_31485":726,"_21804":53760,"_5":15036,"_28646":53641,"_3122":53761},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3731":776,"_31485":726,"_21804":53763,"_5":15036,"_28646":53641,"_3122":53764},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3731":777,"_31485":726,"_21804":53766,"_5":15036,"_28646":53641,"_3122":53767},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3731":778,"_31485":726,"_21804":53769,"_5":15036,"_28646":53641,"_3122":53770},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3731":779,"_31485":726,"_21804":53772,"_5":15036,"_28646":53645,"_3122":53773},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3731":780,"_31485":726,"_21804":53775,"_5":15036,"_28646":53645,"_3122":53776},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3731":781,"_31485":726,"_21804":53778,"_5":15036,"_28646":53649,"_3122":53779},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3731":782,"_31485":726,"_21804":53781,"_5":15036,"_28646":53649,"_3122":53782},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3731":783,"_31485":726,"_21804":53784,"_5":15036,"_28646":53649,"_3122":53785},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3731":784,"_31485":726,"_21804":53787,"_5":15036,"_28646":53649,"_3122":53788},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3731":785,"_31485":726,"_21804":53790,"_5":15036,"_28646":53649,"_3122":53791},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3731":786,"_31485":726,"_21804":53793,"_5":15036,"_28646":53649,"_3122":53794},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3731":787,"_31485":726,"_21804":53796,"_5":15036,"_28646":53649,"_3122":53797},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3731":788,"_31485":726,"_21804":53799,"_5":15036,"_28646":53649,"_3122":53800},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3731":789,"_31485":726,"_21804":53802,"_5":15036,"_28646":53649,"_3122":53803},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3731":790,"_31485":726,"_21804":53805,"_5":15036,"_28646":53649,"_3122":53806},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3731":791,"_31485":791,"_5":15390,"_3122":53808,"_31812":53809,"_21804":53810,"_28646":791},"Audit logs",[51373,52911,52912],[],{"_3731":792,"_31485":791,"_21804":53812,"_5":15036,"_28646":791,"_3122":53813},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3731":793,"_31485":791,"_5":31809,"_21804":53815,"_28646":53816,"_3122":53817},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3731":794,"_31485":791,"_5":31809,"_21804":53819,"_28646":53820,"_3122":53821},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3731":795,"_31485":791,"_5":31809,"_21804":53823,"_28646":53824,"_3122":53825},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3731":796,"_31485":791,"_5":31809,"_21804":53827,"_28646":53828,"_3122":53829},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3731":797,"_31485":791,"_5":31809,"_21804":53831,"_28646":53832,"_3122":53833},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3731":798,"_31485":791,"_5":31809,"_21804":53835,"_28646":53836,"_3122":53837},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3731":799,"_31485":791,"_5":31809,"_21804":53839,"_28646":53840,"_3122":53841},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3731":800,"_31485":791,"_5":31809,"_21804":53843,"_28646":53844,"_3122":53845},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3731":801,"_31485":791,"_5":31809,"_21804":53847,"_28646":53848,"_3122":53849},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3731":802,"_31485":791,"_5":31809,"_21804":53851,"_28646":53852,"_3122":53853},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3731":803,"_31485":791,"_5":31809,"_21804":53855,"_28646":53856,"_3122":53857},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3731":804,"_31485":791,"_21804":53859,"_5":15036,"_28646":791,"_3122":53860},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3731":805,"_31485":791,"_21804":53862,"_5":15036,"_28646":53816,"_3122":53863},[],"The audit body includes:",{"_3731":806,"_31485":791,"_21804":53865,"_5":15036,"_28646":53816,"_3122":53866},[],"input: data received by the operation;",{"_3731":807,"_31485":791,"_21804":53868,"_5":15036,"_28646":53816,"_3122":53869},[],"has\\_error: whether the service returned an error;",{"_3731":808,"_31485":791,"_21804":53871,"_5":15036,"_28646":53816,"_3122":53872},[],"output: produced result or error message;",{"_3731":809,"_31485":791,"_21804":53874,"_5":15036,"_28646":53816,"_3122":53875},[],"principals: identifiers of the principals that matched the request.",{"_3731":810,"_31485":791,"_21804":53877,"_5":15036,"_28646":53816,"_3122":53878},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3731":811,"_31485":791,"_21804":53880,"_5":15036,"_28646":53816,"_3122":53881},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3731":812,"_31485":791,"_21804":53883,"_5":15036,"_28646":53820,"_3122":53884},[],"The backend applies auditing to mutations of:",{"_3731":813,"_31485":791,"_21804":53886,"_5":15036,"_28646":53820,"_3122":53887},[],"authorities, certificates and issuance profiles;",{"_3731":814,"_31485":791,"_21804":53889,"_5":15036,"_28646":53820,"_3122":53890},[],"keys and KMS engines;",{"_3731":815,"_31485":791,"_21804":53892,"_5":15036,"_28646":53820,"_3122":53893},[],"devices and identities;",{"_3731":816,"_31485":791,"_21804":53895,"_5":15036,"_28646":53820,"_3122":53896},[],"DMSs and enrollment operations;",{"_3731":817,"_31485":791,"_21804":53898,"_5":15036,"_28646":53820,"_3122":53899},[],"validation functions and CRL;",{"_3731":818,"_31485":791,"_21804":53901,"_5":15036,"_28646":53820,"_3122":53902},[],"principals, policies and authorization grants.",{"_3731":819,"_31485":791,"_21804":53904,"_5":15036,"_28646":53820,"_3122":53905},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3731":820,"_31485":791,"_21804":53907,"_5":15036,"_28646":53824,"_3122":53908},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3731":821,"_31485":791,"_21804":53910,"_5":15036,"_28646":53824,"_3122":53911},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3731":822,"_31485":791,"_21804":53913,"_5":15036,"_28646":53824,"_3122":53914},[],"Design the consumer to:",{"_3731":823,"_31485":791,"_21804":53916,"_5":15036,"_28646":53824,"_3122":53917},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3731":824,"_31485":791,"_21804":53919,"_5":15036,"_28646":53824,"_3122":53920},[],"keep the complete CloudEvent unmodified;",{"_3731":825,"_31485":791,"_21804":53922,"_5":15036,"_28646":53824,"_3122":53923},[],"record the ingestion time and detect duplicates by ID;",{"_3731":826,"_31485":791,"_21804":53925,"_5":15036,"_28646":53824,"_3122":53926},[],"encrypt in transit and at rest;",{"_3731":827,"_31485":791,"_21804":53928,"_5":15036,"_28646":53824,"_3122":53929},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3731":828,"_31485":791,"_21804":53931,"_5":15036,"_28646":53824,"_3122":53932},[],"apply an explicit retention and legal hold policy;",{"_3731":829,"_31485":791,"_21804":53934,"_5":15036,"_28646":53824,"_3122":53935},[],"alert if it stops consuming or the pending queue grows.",{"_3731":830,"_31485":791,"_21804":53937,"_5":15036,"_28646":53828,"_3122":53938},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3731":831,"_31485":791,"_21804":53940,"_5":15036,"_28646":53828,"_3122":53941},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3731":832,"_31485":791,"_21804":53943,"_5":15036,"_28646":53836,"_3122":53944},[],"Start from the reported time and normalize every source to UTC.",{"_3731":833,"_31485":791,"_21804":53946,"_5":15036,"_28646":53840,"_3122":53947},[],"Filter by event type, service source and resource identifier.",{"_3731":834,"_31485":791,"_21804":53949,"_5":15036,"_28646":53844,"_3122":53950},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3731":835,"_31485":791,"_21804":53952,"_5":15036,"_28646":53848,"_3122":53953},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3731":836,"_31485":791,"_21804":53955,"_5":15036,"_28646":53852,"_3122":53956},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3731":837,"_31485":791,"_21804":53958,"_5":15036,"_28646":53856,"_3122":53959},[],"Generate a controlled mutation in a test environment and check that:",{"_3731":838,"_31485":791,"_21804":53961,"_5":15036,"_28646":53856,"_3122":53962},[],"a successful audit event appears;",{"_3731":839,"_31485":791,"_21804":53964,"_5":15036,"_28646":53856,"_3122":53965},[],"the principal matches the identity used;",{"_3731":840,"_31485":791,"_21804":53967,"_5":15036,"_28646":53856,"_3122":53968},[],"the consumer persists it exactly once;",{"_3731":841,"_31485":791,"_21804":53970,"_5":15036,"_28646":53856,"_3122":53971},[],"it can be retrieved by resource, actor and period;",{"_3731":842,"_31485":791,"_21804":53973,"_5":15036,"_28646":53856,"_3122":53974},[],"a consumer outage raises an alert.",{"_3731":843,"_31485":791,"_21804":53976,"_5":15036,"_28646":53856,"_3122":53977},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3731":844,"_31485":844,"_5":15390,"_3122":53979,"_31812":53980,"_21804":53981,"_28646":844},"Platform architecture",[51373,52911],[],{"_3731":845,"_31485":844,"_21804":53983,"_5":15036,"_28646":844,"_3122":53984},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3731":846,"_31485":844,"_5":31809,"_21804":53986,"_28646":53987,"_3122":53988},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3731":847,"_31485":844,"_5":31809,"_21804":53990,"_28646":53991,"_3122":53992},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3731":848,"_31485":844,"_5":31809,"_21804":53994,"_28646":53995,"_3122":53996},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3731":849,"_31485":844,"_5":31809,"_21804":53998,"_28646":53999,"_3122":54000},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3731":850,"_31485":844,"_5":31809,"_21804":54002,"_28646":54003,"_3122":54004},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3731":851,"_31485":844,"_21804":54006,"_5":15036,"_28646":844,"_3122":54007},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3731":852,"_31485":844,"_21804":54009,"_5":15036,"_28646":844,"_3122":54010},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3731":853,"_31485":844,"_21804":54012,"_5":15036,"_28646":53987,"_3122":54013},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3731":854,"_31485":844,"_21804":54015,"_5":15036,"_28646":53991,"_3122":54016},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3731":855,"_31485":844,"_21804":54018,"_5":15036,"_28646":53995,"_3122":54019},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3731":856,"_31485":844,"_21804":54021,"_5":15036,"_28646":53999,"_3122":54022},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3731":857,"_31485":844,"_21804":54024,"_5":15036,"_28646":54003,"_3122":54025},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3731":858,"_31485":858,"_5":15390,"_3122":54027,"_31812":54028,"_21804":54029,"_28646":858},"How Lamassu works",[51373,52911],[],{"_3731":859,"_31485":858,"_21804":54031,"_5":15036,"_28646":858,"_3122":54032},[],"The mental model of trust, keys, certificates and devices.",{"_3731":860,"_31485":858,"_5":31809,"_21804":54034,"_28646":54035,"_3122":54036},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3731":861,"_31485":858,"_5":31809,"_21804":54038,"_28646":54039,"_3122":54040},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3731":862,"_31485":858,"_21804":54042,"_5":15036,"_28646":858,"_3122":54043},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3731":863,"_31485":858,"_21804":54045,"_5":15036,"_28646":54035,"_3122":54046},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3731":864,"_31485":858,"_21804":54048,"_5":15036,"_28646":54035,"_3122":54049},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3731":865,"_31485":858,"_21804":54051,"_5":15036,"_28646":54035,"_3122":54052},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3731":866,"_31485":858,"_21804":54054,"_5":15036,"_28646":54035,"_3122":54055},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3731":867,"_31485":858,"_21804":54057,"_5":15036,"_28646":54035,"_3122":54058},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3731":868,"_31485":858,"_21804":54060,"_5":15036,"_28646":54039,"_3122":54061},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3731":869,"_31485":858,"_21804":54063,"_5":15036,"_28646":54039,"_3122":54064},[],"A DMS relates that CA to an enrollment policy.",{"_3731":870,"_31485":858,"_21804":54066,"_5":15036,"_28646":54039,"_3122":54067},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3731":871,"_31485":858,"_21804":54069,"_5":15036,"_28646":54039,"_3122":54070},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3731":872,"_31485":858,"_21804":54072,"_5":15036,"_28646":54039,"_3122":54073},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3731":873,"_31485":858,"_21804":54075,"_5":15036,"_28646":54039,"_3122":54076},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3731":874,"_31485":858,"_21804":54078,"_5":15036,"_28646":54039,"_3122":54079},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3731":875,"_31485":875,"_5":15390,"_3122":54081,"_31812":54082,"_21804":54084,"_28646":875},"Devices and identities",[51373,52911,54083,54081],"IoT Fleets",[],{"_3731":876,"_31485":875,"_21804":54086,"_5":15036,"_28646":875,"_3122":54087},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3731":877,"_31485":875,"_5":31809,"_21804":54089,"_28646":54090,"_3122":54091},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3731":878,"_31485":875,"_5":31809,"_21804":54093,"_28646":54094,"_3122":54095},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3731":879,"_31485":875,"_5":31809,"_21804":54097,"_28646":54098,"_3122":54099},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3731":880,"_31485":875,"_5":31809,"_21804":54101,"_28646":54102,"_3122":54103},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3731":881,"_31485":875,"_5":31809,"_21804":54105,"_28646":54106,"_3122":54107},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3731":882,"_31485":875,"_5":31809,"_21804":54109,"_28646":54110,"_3122":54111},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3731":883,"_31485":875,"_5":31809,"_21804":54113,"_28646":54114,"_3122":54115},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3731":884,"_31485":875,"_5":31809,"_21804":54117,"_28646":54118,"_3122":54119},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3731":885,"_31485":875,"_5":31809,"_21804":54121,"_28646":54122,"_3122":54123},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3731":886,"_31485":875,"_5":31809,"_21804":54125,"_28646":54126,"_3122":54127},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3731":887,"_31485":875,"_5":31809,"_21804":54129,"_28646":54130,"_3122":54131},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3731":888,"_31485":875,"_21804":54133,"_5":15036,"_28646":875,"_3122":54134},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3731":889,"_31485":875,"_21804":54136,"_5":15036,"_28646":875,"_3122":54137},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3731":890,"_31485":875,"_21804":54139,"_5":15036,"_28646":54090,"_3122":54140},[],"Operational view",{"_3731":891,"_31485":875,"_21804":54142,"_5":15036,"_28646":54090,"_3122":54143},[],"Meaning",{"_3731":892,"_31485":875,"_21804":54145,"_5":15036,"_28646":54090,"_3122":54146},[],"**No Identity**",{"_3731":893,"_31485":875,"_21804":54148,"_5":15036,"_28646":54090,"_3122":54149},[],"A record exists without an associated identity.",{"_3731":894,"_31485":875,"_21804":54151,"_5":15036,"_28646":54090,"_3122":54152},[],"**Active**",{"_3731":895,"_31485":875,"_21804":54154,"_5":15036,"_28646":54090,"_3122":54155},[],"The slot is active; also check certificate dates, status and usages.",{"_3731":896,"_31485":875,"_21804":54157,"_5":15036,"_28646":54090,"_3122":54158},[],"**Renewal Pending**",{"_3731":897,"_31485":875,"_21804":54160,"_5":15036,"_28646":54090,"_3122":54161},[],"The identity is in the operational renewal window.",{"_3731":898,"_31485":875,"_21804":54163,"_5":15036,"_28646":54090,"_3122":54164},[],"**Expiring Soon**",{"_3731":899,"_31485":875,"_21804":54166,"_5":15036,"_28646":54090,"_3122":54167},[],"Expiration is approaching according to configured thresholds.",{"_3731":900,"_31485":875,"_21804":54169,"_5":15036,"_28646":54090,"_3122":54170},[],"**Expired**",{"_3731":901,"_31485":875,"_21804":54172,"_5":15036,"_28646":54090,"_3122":54173},[],"The identity has expired.",{"_3731":902,"_31485":875,"_21804":54175,"_5":15036,"_28646":54090,"_3122":54176},[],"**Revoked**",{"_3731":903,"_31485":875,"_21804":54178,"_5":15036,"_28646":54090,"_3122":54179},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3731":904,"_31485":875,"_21804":54181,"_5":15036,"_28646":54090,"_3122":54182},[],"**Decommissioned**",{"_3731":905,"_31485":875,"_21804":54184,"_5":15036,"_28646":54090,"_3122":54185},[],"The record is retired and ordinary updates do not restore operation.",{"_3731":906,"_31485":875,"_21804":54187,"_5":15036,"_28646":54090,"_3122":54188},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3731":907,"_31485":875,"_21804":54190,"_5":15036,"_28646":54094,"_3122":54191},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3731":908,"_31485":875,"_21804":54193,"_5":15036,"_28646":54094,"_3122":54194},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3731":909,"_31485":875,"_21804":54196,"_5":15036,"_28646":54094,"_3122":54197},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. In **Live** mode it follows new events and device changes (such as status or owner) automatically without reloading the page, and shows a **Connected** or **Disconnected** indicator. After an interruption it reconnects and recovers without gaps or duplicates, so **Live** shows the same content a page reload would. When live updates cannot be used — no permission, device not found, or live updates not enabled on the server — the timeline shows `Live updates unavailable: ...` with the reason, while history browsing (**Load more**) still works. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3731":910,"_31485":875,"_21804":54199,"_5":15036,"_28646":54094,"_3122":54200},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3731":911,"_31485":875,"_21804":54202,"_5":15036,"_28646":54098,"_3122":54203},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3731":912,"_31485":875,"_21804":54205,"_5":15036,"_28646":54102,"_3122":54206},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3731":913,"_31485":875,"_21804":54208,"_5":15036,"_28646":54106,"_3122":54209},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3731":914,"_31485":875,"_21804":54211,"_5":15036,"_28646":54110,"_3122":54212},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3731":915,"_31485":875,"_21804":54214,"_5":15036,"_28646":54114,"_3122":54215},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3731":916,"_31485":875,"_21804":54217,"_5":15036,"_28646":54114,"_3122":54218},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3731":917,"_31485":875,"_21804":54220,"_5":15036,"_28646":54118,"_3122":54221},[],"From **No Identity**, use **Assign Identity**:",{"_3731":918,"_31485":875,"_21804":54223,"_5":15036,"_28646":54118,"_3122":54224},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3731":919,"_31485":875,"_21804":54226,"_5":15036,"_28646":54118,"_3122":54227},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3731":920,"_31485":875,"_21804":54229,"_5":15036,"_28646":54118,"_3122":54230},[],"Confirm and read the serial, active version and history again.",{"_3731":921,"_31485":875,"_21804":54232,"_5":15036,"_28646":54118,"_3122":54233},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3731":922,"_31485":875,"_21804":54235,"_5":15036,"_28646":54118,"_3122":54236},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3731":923,"_31485":875,"_21804":54238,"_5":15036,"_28646":54122,"_3122":54239},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3731":924,"_31485":875,"_21804":54241,"_5":15036,"_28646":54122,"_3122":54242},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3731":925,"_31485":875,"_21804":54244,"_5":15036,"_28646":54122,"_3122":54245},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3731":926,"_31485":875,"_21804":54247,"_5":15036,"_28646":54126,"_3122":54248},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3731":927,"_31485":875,"_21804":54250,"_5":15036,"_28646":54126,"_3122":54251},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3731":928,"_31485":875,"_21804":54253,"_5":15036,"_28646":54126,"_3122":54254},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3731":929,"_31485":875,"_21804":54256,"_5":15036,"_28646":54126,"_3122":54257},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3731":930,"_31485":875,"_21804":54259,"_5":15036,"_28646":54130,"_3122":54260},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3731":931,"_31485":875,"_21804":54262,"_5":15036,"_28646":54130,"_3122":54263},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/est/configuration\" />",{"_3731":932,"_31485":932,"_5":15390,"_3122":54265,"_31812":54266,"_21804":54268,"_28646":932},"Configure and operate the DMS",[51373,52911,54083,54081,54267],"Enrollment with PKI",[],{"_3731":933,"_31485":932,"_21804":54270,"_5":15036,"_28646":932,"_3122":54271},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3731":934,"_31485":932,"_5":31809,"_21804":54273,"_28646":54274,"_3122":51383},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3731":935,"_31485":932,"_5":31809,"_21804":54276,"_28646":54277,"_3122":54278},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3731":936,"_31485":932,"_5":31809,"_21804":54280,"_28646":54281,"_3122":54282},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3731":937,"_31485":932,"_5":31809,"_21804":54284,"_28646":54285,"_3122":54286},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3731":938,"_31485":932,"_5":31809,"_21804":54288,"_28646":54289,"_3122":54290},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3731":939,"_31485":932,"_5":31809,"_21804":54292,"_28646":54293,"_3122":54294},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3731":940,"_31485":932,"_5":31809,"_21804":54296,"_28646":54297,"_3122":54298},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3731":941,"_31485":932,"_5":31809,"_21804":54300,"_28646":54301,"_3122":54302},[],"/docs/platform/iot-fleets/enrollment/dms#protocol-configuration","Protocol configuration",{"_3731":942,"_31485":932,"_5":31809,"_21804":54304,"_28646":54305,"_3122":54306},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3731":943,"_31485":932,"_5":31809,"_21804":54308,"_28646":54309,"_3122":54310},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3731":944,"_31485":932,"_21804":54312,"_5":15036,"_28646":932,"_3122":54313},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3731":945,"_31485":932,"_21804":54315,"_5":15036,"_28646":54274,"_3122":54316},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3731":946,"_31485":932,"_21804":54318,"_5":15036,"_28646":54274,"_3122":54319},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3731":947,"_31485":932,"_21804":54321,"_5":15036,"_28646":54281,"_3122":54322},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3731":948,"_31485":932,"_21804":54324,"_5":15036,"_28646":54285,"_3122":54325},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3731":949,"_31485":932,"_21804":54327,"_5":15036,"_28646":54289,"_3122":54328},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3731":950,"_31485":932,"_21804":54330,"_5":15036,"_28646":54293,"_3122":54331},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3731":951,"_31485":932,"_21804":54333,"_5":15036,"_28646":54297,"_3122":54334},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3731":952,"_31485":932,"_21804":54336,"_5":15036,"_28646":54301,"_3122":54337},[],"See Configure EST in the DMS for registration, authentication, issuance, renewal, key generation and trust distribution.",{"_3731":953,"_31485":932,"_21804":54339,"_5":15036,"_28646":54305,"_3122":54340},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored. Authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it, including the AWS IoT connector’s JITP writeback. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3731":954,"_31485":932,"_21804":54342,"_5":15036,"_28646":54305,"_3122":54343},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3731":955,"_31485":932,"_21804":54345,"_5":15036,"_28646":54305,"_3122":54346},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3731":956,"_31485":932,"_21804":54348,"_5":15036,"_28646":54309,"_3122":54349},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3731":957,"_31485":957,"_5":15390,"_3122":54267,"_31812":54351,"_21804":54352,"_28646":957},[51373,52911,54083,54081,54267],[],{"_3731":958,"_31485":957,"_21804":54354,"_5":15036,"_28646":957,"_3122":54355},[],"Prepare device admission, registration policy and certificate issuance.",{"_3731":959,"_31485":957,"_5":31809,"_21804":54357,"_28646":54358,"_3122":54359},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3731":960,"_31485":957,"_5":31809,"_21804":54361,"_28646":54362,"_3122":54363},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3731":961,"_31485":957,"_5":31809,"_21804":54365,"_28646":54366,"_3122":54367},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3731":962,"_31485":957,"_21804":54369,"_5":15036,"_28646":957,"_3122":54370},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3731":963,"_31485":957,"_21804":54372,"_5":15036,"_28646":54358,"_3122":54373},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3731":964,"_31485":957,"_21804":54375,"_5":15036,"_28646":54358,"_3122":54376},[],"The integrator installs initial EST server trust and an admission credential.",{"_3731":965,"_31485":957,"_21804":54378,"_5":15036,"_28646":54358,"_3122":54379},[],"The client requests an identity for its `Device ID` through EST.",{"_3731":966,"_31485":957,"_21804":54381,"_5":15036,"_28646":54358,"_3122":54382},[],"Certificate, device binding and key/certificate installation are checked.",{"_3731":967,"_31485":957,"_21804":54384,"_5":15036,"_28646":54358,"_3122":54385},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3731":968,"_31485":957,"_21804":54387,"_5":15036,"_28646":54358,"_3122":54388},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3731":969,"_31485":957,"_21804":54390,"_5":15036,"_28646":54362,"_3122":54391},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3731":970,"_31485":957,"_21804":54393,"_5":15036,"_28646":54362,"_3122":54394},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3731":971,"_31485":957,"_21804":54396,"_5":15036,"_28646":54366,"_3122":54397},[],"See EST (RFC 7030) to prepare authentication and initial trust, integrate the client and maintain the device identity.",{"_3731":972,"_31485":957,"_21804":54399,"_5":15036,"_28646":54366,"_3122":54400},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3731":973,"_31485":973,"_5":15390,"_3122":54402,"_31812":54403,"_21804":54404,"_28646":973},"Provisioning strategies",[51373,52911,54083,54081,54267],[],{"_3731":974,"_31485":973,"_21804":54406,"_5":15036,"_28646":973,"_3122":54407},[],"Choose device registration, identity authorization and key generation.",{"_3731":975,"_31485":973,"_5":31809,"_21804":54409,"_28646":54410,"_3122":54411},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3731":976,"_31485":973,"_5":31809,"_21804":54413,"_28646":54414,"_3122":54415},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3731":977,"_31485":973,"_5":31809,"_21804":54417,"_28646":54418,"_3122":54419},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3731":978,"_31485":973,"_5":31809,"_21804":54421,"_28646":54422,"_3122":54423},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3731":979,"_31485":973,"_5":31809,"_21804":54425,"_28646":54426,"_3122":54427},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3731":980,"_31485":973,"_21804":54429,"_5":15036,"_28646":973,"_3122":54430},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3731":981,"_31485":973,"_21804":54432,"_5":15036,"_28646":54410,"_3122":54433},[],"Path",{"_3731":982,"_31485":973,"_21804":54435,"_5":15036,"_28646":54410,"_3122":54436},[],"When the device exists",{"_3731":983,"_31485":973,"_21804":54438,"_5":15036,"_28646":54410,"_3122":54439},[],"What to check",{"_3731":984,"_31485":973,"_21804":54441,"_5":15036,"_28646":54410,"_3122":54442},[],"Manual assignment",{"_3731":985,"_31485":973,"_21804":54444,"_5":15036,"_28646":54410,"_3122":54445},[],"An operator creates it before associating a certificate.",{"_3731":986,"_31485":973,"_21804":54447,"_5":15036,"_28646":54410,"_3122":54448},[],"ID, owning DMS, certificate CN and bound serial.",{"_3731":987,"_31485":973,"_21804":54450,"_5":15036,"_28646":54410,"_3122":54451},[],"EST with `JITP`",{"_3731":988,"_31485":973,"_21804":54453,"_5":15036,"_28646":54410,"_3122":54454},[],"Created for an unknown CN during `/simpleenroll`.",{"_3731":989,"_31485":973,"_21804":54456,"_5":15036,"_28646":54410,"_3122":54457},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3731":990,"_31485":973,"_21804":54459,"_5":15036,"_28646":54410,"_3122":54460},[],"EST with `PRE_REGISTRATION`",{"_3731":991,"_31485":973,"_21804":54462,"_5":15036,"_28646":54410,"_3122":54463},[],"Must exist before `/simpleenroll`.",{"_3731":992,"_31485":973,"_21804":54465,"_5":15036,"_28646":54410,"_3122":54466},[],"Approved record, same DMS and replacement conditions for your version.",{"_3731":993,"_31485":973,"_21804":54468,"_5":15036,"_28646":54410,"_3122":54469},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3731":994,"_31485":973,"_21804":54471,"_5":15036,"_28646":54410,"_3122":54472},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3731":995,"_31485":973,"_21804":54474,"_5":15036,"_28646":54414,"_3122":54475},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3731":996,"_31485":973,"_21804":54477,"_5":15036,"_28646":54414,"_3122":54478},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3731":997,"_31485":973,"_21804":54480,"_5":15036,"_28646":54414,"_3122":54481},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3731":998,"_31485":973,"_21804":54483,"_5":15036,"_28646":54418,"_3122":54484},[],"Decide initial enrollment and re-enrollment separately:",{"_3731":999,"_31485":973,"_21804":54486,"_5":15036,"_28646":54418,"_3122":54487},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3731":1000,"_31485":973,"_21804":54489,"_5":15036,"_28646":54418,"_3122":54490},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3731":1001,"_31485":973,"_21804":54492,"_5":15036,"_28646":54418,"_3122":54493},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3731":1002,"_31485":973,"_21804":54495,"_5":15036,"_28646":54418,"_3122":54496},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3731":1003,"_31485":973,"_21804":54498,"_5":15036,"_28646":54418,"_3122":54499},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3731":1004,"_31485":973,"_21804":54501,"_5":15036,"_28646":54422,"_3122":51757},[],{"_3731":1005,"_31485":973,"_21804":54503,"_5":15036,"_28646":54422,"_3122":54504},[],"Material crossing EST",{"_3731":1006,"_31485":973,"_21804":54506,"_5":15036,"_28646":54422,"_3122":54507},[],"Device-generated key",{"_3731":1007,"_31485":973,"_21804":54509,"_5":15036,"_28646":54422,"_3122":54510},[],"Public CSR and certificate; the key stays on the client.",{"_3731":1008,"_31485":973,"_21804":54512,"_5":15036,"_28646":54422,"_3122":54513},[],"Existing device key",{"_3731":1009,"_31485":973,"_21804":54515,"_5":15036,"_28646":54422,"_3122":54516},[],"CSR signed with that key and a new certificate.",{"_3731":1010,"_31485":973,"_21804":54518,"_5":15036,"_28646":54422,"_3122":54519},[],"ServerKeyGen",{"_3731":1011,"_31485":973,"_21804":54521,"_5":15036,"_28646":54422,"_3122":54522},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3731":1012,"_31485":973,"_21804":54524,"_5":15036,"_28646":54422,"_3122":54525},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3731":1013,"_31485":973,"_21804":54527,"_5":15036,"_28646":54426,"_3122":54528},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3731":1014,"_31485":1014,"_5":15390,"_3122":54530,"_31812":54531,"_21804":54533,"_28646":1014},"Authentication and trust",[51373,52911,54083,54532],"EST (RFC 7030)",[],{"_3731":1015,"_31485":1014,"_21804":54535,"_5":15036,"_28646":1014,"_3122":54536},[],"Prepare credentials, authentication and trust distribution for EST.",{"_3731":1016,"_31485":1014,"_5":31809,"_21804":54538,"_28646":54539,"_3122":54540},[],"/docs/platform/iot-fleets/est/bootstrap-identity#initial-server-trust","Initial server trust",{"_3731":1017,"_31485":1014,"_5":31809,"_21804":54542,"_28646":54543,"_3122":54544},[],"/docs/platform/iot-fleets/est/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3731":1018,"_31485":1014,"_5":31809,"_21804":54546,"_28646":54547,"_3122":54548},[],"/docs/platform/iot-fleets/est/bootstrap-identity#modes-per-operation","Modes per operation",{"_3731":1019,"_31485":1014,"_5":31809,"_21804":54550,"_28646":54551,"_3122":54552},[],"/docs/platform/iot-fleets/est/bootstrap-identity#webhook-contract","Webhook contract",{"_3731":1020,"_31485":1014,"_5":31809,"_21804":54554,"_28646":54555,"_3122":54556},[],"/docs/platform/iot-fleets/est/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3731":1021,"_31485":1014,"_21804":54558,"_5":15036,"_28646":1014,"_3122":54559},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3731":1022,"_31485":1014,"_21804":54561,"_5":15036,"_28646":54539,"_3122":54562},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3731":1023,"_31485":1014,"_21804":54564,"_5":15036,"_28646":54539,"_3122":54565},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3731":1024,"_31485":1014,"_21804":54567,"_5":15036,"_28646":54543,"_3122":54568},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3731":1025,"_31485":1014,"_21804":54570,"_5":15036,"_28646":54543,"_3122":54571},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3731":1026,"_31485":1014,"_21804":54573,"_5":15036,"_28646":54543,"_3122":54574},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3731":1027,"_31485":1014,"_21804":54576,"_5":15036,"_28646":54547,"_3122":54577},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3731":1028,"_31485":1014,"_21804":54579,"_5":15036,"_28646":54547,"_3122":54580},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3731":1029,"_31485":1014,"_21804":54582,"_5":15036,"_28646":54551,"_3122":54583},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config (verification is on by default) and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3731":1030,"_31485":1014,"_21804":54585,"_5":15036,"_28646":54551,"_3122":54586},[],"Example body:",{"_3731":1031,"_31485":1014,"_21804":54588,"_5":15036,"_28646":54551,"_3122":54589},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3731":1032,"_31485":1014,"_21804":54591,"_5":15036,"_28646":54551,"_3122":54592},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3731":1033,"_31485":1014,"_21804":54594,"_5":15036,"_28646":54551,"_3122":54595},[],"Continuation requires a successful HTTP response and JSON:",{"_3731":1034,"_31485":1014,"_21804":54597,"_5":15036,"_28646":54551,"_3122":54598},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3731":1035,"_31485":1014,"_21804":54600,"_5":15036,"_28646":54555,"_3122":54601},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3731":1036,"_31485":1014,"_21804":54603,"_5":15036,"_28646":54555,"_3122":54604},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh (`thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old) and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3731":1037,"_31485":1014,"_21804":54606,"_5":15036,"_28646":54555,"_3122":54607},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3731":1038,"_31485":1014,"_21804":54609,"_5":15036,"_28646":54555,"_3122":54610},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3731":1039,"_31485":1039,"_5":15390,"_3122":54612,"_31812":54613,"_21804":54614,"_28646":1039},"EST in Lamassu",[51373,52911,54083,54532],[],{"_3731":1040,"_31485":1039,"_21804":54616,"_5":15036,"_28646":1039,"_3122":54617},[],"Configure EST operations, authentication and trust distribution.",{"_3731":1041,"_31485":1039,"_5":31809,"_21804":54619,"_28646":54620,"_3122":54621},[],"/docs/platform/iot-fleets/est/configuration#endpoint-reference","Endpoint reference",{"_3731":1042,"_31485":1039,"_5":31809,"_21804":54623,"_28646":54624,"_3122":54625},[],"/docs/platform/iot-fleets/est/configuration#authentication-per-operation","Authentication per operation",{"_3731":1043,"_31485":1039,"_5":31809,"_21804":54627,"_28646":54628,"_3122":54629},[],"/docs/platform/iot-fleets/est/configuration#external-webhook-settings","External webhook settings",{"_3731":1044,"_31485":1039,"_5":31809,"_21804":54631,"_28646":54632,"_3122":54633},[],"/docs/platform/iot-fleets/est/configuration#compatibility-notes","Compatibility notes",{"_3731":1045,"_31485":1039,"_5":31809,"_21804":54635,"_28646":54636,"_3122":51383},[],"/docs/platform/iot-fleets/est/configuration#before-you-begin",{"_3731":1046,"_31485":1039,"_5":31809,"_21804":54638,"_28646":54639,"_3122":54640},[],"/docs/platform/iot-fleets/est/configuration#cacerts","/cacerts",{"_3731":1047,"_31485":1039,"_5":31809,"_21804":54642,"_28646":54643,"_3122":54644},[],"/docs/platform/iot-fleets/est/configuration#trust-distribution","Configuration",{"_3731":1048,"_31485":1039,"_5":31809,"_21804":54646,"_28646":54647,"_3122":54648},[],"/docs/platform/iot-fleets/est/configuration#cacerts-request-and-response","Request and Response",{"_3731":1049,"_31485":1039,"_5":31809,"_21804":54650,"_28646":54651,"_3122":54652},[],"/docs/platform/iot-fleets/est/configuration#simpleenroll","/simpleenroll",{"_3731":1050,"_31485":1039,"_5":31809,"_21804":54654,"_28646":54655,"_3122":54644},[],"/docs/platform/iot-fleets/est/configuration#enrollment-configuration",{"_3731":1051,"_31485":1039,"_5":31809,"_21804":54657,"_28646":54658,"_3122":54648},[],"/docs/platform/iot-fleets/est/configuration#simpleenroll-request-and-response",{"_3731":1052,"_31485":1039,"_5":31809,"_21804":54660,"_28646":54661,"_3122":54662},[],"/docs/platform/iot-fleets/est/configuration#simplereenroll","/simplereenroll",{"_3731":1053,"_31485":1039,"_5":31809,"_21804":54664,"_28646":54665,"_3122":54644},[],"/docs/platform/iot-fleets/est/configuration#re-enrollment-configuration",{"_3731":1054,"_31485":1039,"_5":31809,"_21804":54667,"_28646":54668,"_3122":54648},[],"/docs/platform/iot-fleets/est/configuration#simplereenroll-request-and-response",{"_3731":1055,"_31485":1039,"_5":31809,"_21804":54670,"_28646":54671,"_3122":54672},[],"/docs/platform/iot-fleets/est/configuration#recover-according-to-state","Recover according to state",{"_3731":1056,"_31485":1039,"_5":31809,"_21804":54674,"_28646":54675,"_3122":54676},[],"/docs/platform/iot-fleets/est/configuration#continuous-operation","Continuous operation",{"_3731":1057,"_31485":1039,"_5":31809,"_21804":54678,"_28646":54679,"_3122":54680},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen","/serverkeygen",{"_3731":1058,"_31485":1039,"_5":31809,"_21804":54682,"_28646":54683,"_3122":54644},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen-configuration",{"_3731":1059,"_31485":1039,"_5":31809,"_21804":54685,"_28646":54686,"_3122":54648},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen-request-and-response",{"_3731":1060,"_31485":1039,"_21804":54688,"_5":15036,"_28646":1039,"_3122":54689},[],"The DMS applies the configured authentication mode to enrollment requests before enforcing registration and issuance rules. Initial enrollment and re-enrollment have independent authentication settings. Lamassu supports a client certificate, a webhook, both, or no DMS authentication. Authentication and trust explains credentials, initial trust and validation.",{"_3731":1061,"_31485":1039,"_21804":54691,"_5":15036,"_28646":1039,"_3122":54692},[],"The DMS also controls the CA, profile, renewal window, server-generated keys and distributed certificates. See the DMS guide for administration.",{"_3731":1062,"_31485":1039,"_21804":54694,"_5":15036,"_28646":54620,"_3122":54695},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3731":1063,"_31485":1039,"_21804":54697,"_5":15036,"_28646":54620,"_3122":54698},[],"Operation",{"_3731":1064,"_31485":1039,"_21804":54700,"_5":15036,"_28646":54620,"_3122":54701},[],"Method",{"_3731":1065,"_31485":1039,"_21804":54703,"_5":15036,"_28646":54620,"_3122":54704},[],"Authentication and condition",{"_3731":1066,"_31485":1039,"_21804":54706,"_5":15036,"_28646":54620,"_3122":54707},[],"`/cacerts`",{"_3731":1067,"_31485":1039,"_21804":54709,"_5":15036,"_28646":54620,"_3122":54710},[],"GET",{"_3731":1068,"_31485":1039,"_21804":54712,"_5":15036,"_28646":54620,"_3122":54713},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3731":1069,"_31485":1039,"_21804":54715,"_5":15036,"_28646":54620,"_3122":54716},[],"`/simpleenroll`",{"_3731":1070,"_31485":1039,"_21804":54718,"_5":15036,"_28646":54620,"_3122":54719},[],"POST",{"_3731":1071,"_31485":1039,"_21804":54721,"_5":15036,"_28646":54620,"_3122":54722},[],"Initial authentication and DMS registration/replacement policy.",{"_3731":1072,"_31485":1039,"_21804":54724,"_5":15036,"_28646":54620,"_3122":54725},[],"`/simplereenroll`",{"_3731":1073,"_31485":1039,"_21804":54727,"_5":15036,"_28646":54620,"_3122":54719},[],{"_3731":1074,"_31485":1039,"_21804":54729,"_5":15036,"_28646":54620,"_3122":54730},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3731":1075,"_31485":1039,"_21804":54732,"_5":15036,"_28646":54620,"_3122":54733},[],"`/serverkeygen`",{"_3731":1076,"_31485":1039,"_21804":54735,"_5":15036,"_28646":54620,"_3122":54719},[],{"_3731":1077,"_31485":1039,"_21804":54737,"_5":15036,"_28646":54620,"_3122":54738},[],"Initial authentication and server-side key generation enabled.",{"_3731":1078,"_31485":1039,"_21804":54740,"_5":15036,"_28646":54620,"_3122":54741},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3731":1079,"_31485":1039,"_21804":54743,"_5":15036,"_28646":54624,"_3122":54744},[],"The blocks are independent:",{"_3731":1080,"_31485":1039,"_21804":54746,"_5":15036,"_28646":54624,"_3122":54747},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3731":1081,"_31485":1039,"_21804":54749,"_5":15036,"_28646":54624,"_3122":54750},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3731":1082,"_31485":1039,"_21804":54752,"_5":15036,"_28646":54624,"_3122":54753},[],"`auth_mode`",{"_3731":1083,"_31485":1039,"_21804":54755,"_5":15036,"_28646":54624,"_3122":54756},[],"Control applied in the configured operation",{"_3731":1084,"_31485":1039,"_21804":54758,"_5":15036,"_28646":54624,"_3122":54759},[],"`CLIENT_CERTIFICATE`",{"_3731":1085,"_31485":1039,"_21804":54761,"_5":15036,"_28646":54624,"_3122":54762},[],"Presented certificate validation.",{"_3731":1086,"_31485":1039,"_21804":54764,"_5":15036,"_28646":54624,"_3122":54765},[],"`EXTERNAL_WEBHOOK`",{"_3731":1087,"_31485":1039,"_21804":54767,"_5":15036,"_28646":54624,"_3122":54768},[],"Configured webhook authorization.",{"_3731":1088,"_31485":1039,"_21804":54770,"_5":15036,"_28646":54624,"_3122":54771},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3731":1089,"_31485":1039,"_21804":54773,"_5":15036,"_28646":54624,"_3122":54774},[],"Certificate validation followed by webhook approval.",{"_3731":1090,"_31485":1039,"_21804":54776,"_5":15036,"_28646":54624,"_3122":54777},[],"`NO_AUTH`",{"_3731":1091,"_31485":1039,"_21804":54779,"_5":15036,"_28646":54624,"_3122":54780},[],"No DMS requester authentication.",{"_3731":1092,"_31485":1039,"_21804":54782,"_5":15036,"_28646":54624,"_3122":54783},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3731":1093,"_31485":1039,"_21804":54785,"_5":15036,"_28646":54624,"_3122":54786},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3731":1094,"_31485":1039,"_21804":54788,"_5":15036,"_28646":54624,"_3122":54789},[],"The authentication editor offers an **Allow certificates without revocation information** switch (`allow_unverifiable_revocation`, off by default). When it is on, certificates (and intermediate CAs of the chain) that Lamassu does not manage and that list no OCSP or CRL endpoint are accepted; unreachable, stale or inconclusive revocation answers are always rejected. While the switch is on, the console shows an amber warning: **Revocation will not be verified**. A revoked certificate with no OCSP or CRL endpoint, and not managed by Lamassu, will be accepted, and this also applies to the intermediate CAs of the chain.",{"_3731":1095,"_31485":1039,"_21804":54791,"_5":15036,"_28646":54624,"_3122":54792},[],"The same switch is offered in both the enrollment and re-enrollment authentication editors and is stored per block inside `est_rfc7030_settings.client_certificate_settings`; a DMS stored before this field existed loads with the switch off. The console also shows an amber warning alert whenever an authentication option is in its insecure state (**Allow expired certificates** on, **Allow expired renewal** on or **Verify CSR signature** off) and the No authentication note is presented as a warning alert too.",{"_3731":1096,"_31485":1039,"_21804":54794,"_5":15036,"_28646":54624,"_3122":54795},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` (`false` by default in both blocks) relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3731":1097,"_31485":1039,"_21804":54797,"_5":15036,"_28646":54624,"_3122":54798},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3731":1098,"_31485":1039,"_21804":54800,"_5":15036,"_28646":54624,"_3122":54801},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3731":1099,"_31485":1039,"_21804":54803,"_5":15036,"_28646":54628,"_3122":54804},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3731":1100,"_31485":1039,"_21804":54806,"_5":15036,"_28646":54628,"_3122":54807},[],"`external_webhook_settings` field",{"_3731":1101,"_31485":1039,"_21804":54809,"_5":15036,"_28646":54628,"_3122":54810},[],"Decision",{"_3731":1102,"_31485":1039,"_21804":54812,"_5":15036,"_28646":54628,"_3122":54813},[],"`url`",{"_3731":1103,"_31485":1039,"_21804":54815,"_5":15036,"_28646":54628,"_3122":54816},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3731":1104,"_31485":1039,"_21804":54818,"_5":15036,"_28646":54628,"_3122":54819},[],"`method`",{"_3731":1105,"_31485":1039,"_21804":54821,"_5":15036,"_28646":54628,"_3122":54822},[],"`POST` or `PUT`; `POST` by default.",{"_3731":1106,"_31485":1039,"_21804":54824,"_5":15036,"_28646":54628,"_3122":54825},[],"`name`",{"_3731":1107,"_31485":1039,"_21804":54827,"_5":15036,"_28646":54628,"_3122":54828},[],"Label used in service logs.",{"_3731":1108,"_31485":1039,"_21804":54830,"_5":15036,"_28646":54628,"_3122":54831},[],"`config.auth_mode`",{"_3731":1109,"_31485":1039,"_21804":54833,"_5":15036,"_28646":54628,"_3122":54834},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3731":1110,"_31485":1039,"_21804":54836,"_5":15036,"_28646":54628,"_3122":54837},[],"`config.log_level`",{"_3731":1111,"_31485":1039,"_21804":54839,"_5":15036,"_28646":54628,"_3122":54840},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3731":1112,"_31485":1039,"_21804":54842,"_5":15036,"_28646":54628,"_3122":54843},[],"`config.apikey_options`",{"_3731":1113,"_31485":1039,"_21804":54845,"_5":15036,"_28646":54628,"_3122":54846},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3731":1114,"_31485":1039,"_21804":54848,"_5":15036,"_28646":54628,"_3122":54849},[],"`config.jwt_options`",{"_3731":1115,"_31485":1039,"_21804":54851,"_5":15036,"_28646":54628,"_3122":54852},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3731":1116,"_31485":1039,"_21804":54854,"_5":15036,"_28646":54628,"_3122":54855},[],"`config.mtls_options`",{"_3731":1117,"_31485":1039,"_21804":54857,"_5":15036,"_28646":54628,"_3122":54858},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3731":1118,"_31485":1039,"_21804":54860,"_5":15036,"_28646":54628,"_3122":54861},[],"`config.insecure_skip_verify`",{"_3731":1119,"_31485":1039,"_21804":54863,"_5":15036,"_28646":54628,"_3122":54864},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3731":1120,"_31485":1039,"_21804":54866,"_5":15036,"_28646":54628,"_3122":54867},[],"`config.call_timeout`",{"_3731":1121,"_31485":1039,"_21804":54869,"_5":15036,"_28646":54628,"_3122":54870},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3731":1122,"_31485":1039,"_21804":54872,"_5":15036,"_28646":54628,"_3122":54873},[],"Rules for that configuration:",{"_3731":1123,"_31485":1039,"_21804":54875,"_5":15036,"_28646":54628,"_3122":54876},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 (the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config`) when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3731":1124,"_31485":1039,"_21804":54878,"_5":15036,"_28646":54628,"_3122":54879},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts (for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded`) and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3731":1125,"_31485":1039,"_21804":54881,"_5":15036,"_28646":54628,"_3122":54882},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3731":1126,"_31485":1039,"_21804":54884,"_5":15036,"_28646":54628,"_3122":54885},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3731":1127,"_31485":1039,"_21804":54887,"_5":15036,"_28646":54628,"_3122":54888},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3731":1128,"_31485":1039,"_21804":54890,"_5":15036,"_28646":54628,"_3122":54891},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3731":1129,"_31485":1039,"_21804":54893,"_5":15036,"_28646":54628,"_3122":54894},[],"Initial authentication and renewal settings are stored independently. Re-enrollment reads its own block and an absent or unknown mode fails. Read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3731":1130,"_31485":1039,"_21804":54896,"_5":15036,"_28646":54628,"_3122":54897},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation (settings are replaced wholesale, so the stored config must be resent) until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content (the editor rejects file paths with an inline field error) and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3731":1131,"_31485":1039,"_21804":54899,"_5":15036,"_28646":54628,"_3122":54900},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored (unknown JSON fields are dropped) and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3731":1132,"_31485":1039,"_21804":54902,"_5":15036,"_28646":54632,"_3122":54903},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3731":1133,"_31485":1039,"_21804":54905,"_5":15036,"_28646":54632,"_3122":54906},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3731":1134,"_31485":1039,"_21804":54908,"_5":15036,"_28646":54636,"_3122":54909},[],"For an end-to-end first enrollment, follow Enroll and connect your first device.",{"_3731":1135,"_31485":1039,"_21804":54911,"_5":15036,"_28646":54636,"_3122":54912},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3731":1136,"_31485":1039,"_21804":54914,"_5":15036,"_28646":54636,"_3122":54915},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3731":1137,"_31485":1039,"_21804":54917,"_5":15036,"_28646":54636,"_3122":54918},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3731":1138,"_31485":1039,"_21804":54920,"_5":15036,"_28646":54639,"_3122":54921},[],"`GET /cacerts` retrieves the certificates published by the DMS. The client can inspect the bundle and use approved certificates to build trust chains.",{"_3731":1139,"_31485":1039,"_21804":54923,"_5":15036,"_28646":54643,"_3122":54924},[],"The options are stored in `settings.ca_distribution_settings` and determine the contents of `/cacerts`.",{"_3731":1140,"_31485":1039,"_21804":54926,"_5":15036,"_28646":54643,"_3122":54927},[],"**Lamassu TLS certificate**",{"_3731":1141,"_31485":1039,"_21804":54929,"_5":15036,"_28646":54643,"_3122":54930},[],"`include_system_ca` (**Include Lamassu System CA**). Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3731":1142,"_31485":1039,"_21804":54932,"_5":15036,"_28646":54643,"_3122":54933},[],"**Enrollment CA**",{"_3731":1143,"_31485":1039,"_21804":54935,"_5":15036,"_28646":54643,"_3122":54936},[],"`include_enrollment_ca` (**Include Enrollment CA**). Selected issuing CA certificate.",{"_3731":1144,"_31485":1039,"_21804":54938,"_5":15036,"_28646":54643,"_3122":54939},[],"**Managed CAs**",{"_3731":1145,"_31485":1039,"_21804":54941,"_5":15036,"_28646":54643,"_3122":54942},[],"`managed_cas` (**Managed CAs**). Explicitly selected CA certificates.",{"_3731":1146,"_31485":1039,"_21804":54944,"_5":15036,"_28646":54643,"_3122":54945},[],"All ancestors are not added automatically.",{"_3731":1147,"_31485":1039,"_21804":54947,"_5":15036,"_28646":54647,"_3122":54948},[],"Send an HTTPS GET with an empty body. The DMS lets clients retrieve certificates without an EST credential. Gateway controls still apply.",{"_3731":1148,"_31485":1039,"_21804":54950,"_5":15036,"_28646":54647,"_3122":54951},[],"**Default response.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters.",{"_3731":1149,"_31485":1039,"_21804":54953,"_5":15036,"_28646":54647,"_3122":54954},[],"**PEM response.** Lamassu selects this format when `Accept` is exactly `application/x-pem-file` and returns the same value in `Content-Type`. The body contains the certificates in PEM.",{"_3731":1150,"_31485":1039,"_21804":54956,"_5":15036,"_28646":54647,"_3122":54957},[],"**What cacerts returns**",{"_3731":1151,"_31485":1039,"_21804":54959,"_5":15036,"_28646":54647,"_3122":54960},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3731":1152,"_31485":1039,"_21804":54962,"_5":15036,"_28646":54647,"_3122":54963},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3731":1153,"_31485":1039,"_21804":54965,"_5":15036,"_28646":54647,"_3122":54966},[],"**Download and inspect cacerts**",{"_3731":1154,"_31485":1039,"_21804":54968,"_5":15036,"_28646":54647,"_3122":54969},[],"This example downloads and converts the default response. Follow the shared client setup to set `EST_BASE` and prepare the credentials.",{"_3731":1155,"_31485":1039,"_21804":54971,"_5":15036,"_28646":54647,"_3122":54972},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3731":1156,"_31485":1039,"_21804":54974,"_5":15036,"_28646":54651,"_3122":54975},[],"`POST /simpleenroll` issues a device’s initial certificate from a CSR. Lamassu takes the device identifier from the CN and binds the issued certificate to the device identity. The private key stays on the client.",{"_3731":1157,"_31485":1039,"_21804":54977,"_5":15036,"_28646":54655,"_3122":54978},[],"The following options are stored in `settings.enrollment_settings`.",{"_3731":1158,"_31485":1039,"_21804":54980,"_5":15036,"_28646":54655,"_3122":54981},[],"**Registration mode**",{"_3731":1159,"_31485":1039,"_21804":54983,"_5":15036,"_28646":54655,"_3122":54984},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner.",{"_3731":1160,"_31485":1039,"_21804":54986,"_5":15036,"_28646":54655,"_3122":54987},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3731":1161,"_31485":1039,"_21804":54989,"_5":15036,"_28646":54655,"_3122":54990},[],"**Device provisioning profile**",{"_3731":1162,"_31485":1039,"_21804":54992,"_5":15036,"_28646":54655,"_3122":54993},[],"`settings.enrollment_settings.device_provisioning_profile` supplies tags, metadata and an icon for JITP registration.",{"_3731":1163,"_31485":1039,"_21804":54995,"_5":15036,"_28646":54655,"_3122":54996},[],"**Protocol**",{"_3731":1164,"_31485":1039,"_21804":54998,"_5":15036,"_28646":54655,"_3122":54999},[],"`protocol`. `EST_RFC7030` for these operations.",{"_3731":1165,"_31485":1039,"_21804":55001,"_5":15036,"_28646":54655,"_3122":55002},[],"**Issuing CA**",{"_3731":1166,"_31485":1039,"_21804":55004,"_5":15036,"_28646":54655,"_3122":55005},[],"`enrollment_ca`. ID of the signing CA.",{"_3731":1167,"_31485":1039,"_21804":55007,"_5":15036,"_28646":54655,"_3122":55008},[],"**CSR signature verification**",{"_3731":1168,"_31485":1039,"_21804":55010,"_5":15036,"_28646":54655,"_3122":55011},[],"`verify_csr_signature`. Keep `true` to verify CSR key possession.",{"_3731":1169,"_31485":1039,"_21804":55013,"_5":15036,"_28646":54655,"_3122":55014},[],"**Certificate replacement**",{"_3731":1170,"_31485":1039,"_21804":55016,"_5":15036,"_28646":54655,"_3122":55017},[],"`enable_replaceable_enrollment`. Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3731":1171,"_31485":1039,"_21804":55019,"_5":15036,"_28646":54655,"_3122":55020},[],"**Authentication mode**",{"_3731":1172,"_31485":1039,"_21804":55022,"_5":15036,"_28646":54655,"_3122":55023},[],"`est_rfc7030_settings.auth_mode`. Select an authentication mode for initial enrollment.",{"_3731":1173,"_31485":1039,"_21804":55025,"_5":15036,"_28646":54655,"_3122":55026},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3731":1174,"_31485":1039,"_21804":55028,"_5":15036,"_28646":54655,"_3122":55029},[],"**Issuance profile**",{"_3731":1175,"_31485":1039,"_21804":55031,"_5":15036,"_28646":54655,"_3122":55032},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile (including the CA default used as fallback when the DMS defines none) must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3731":1176,"_31485":1039,"_21804":55034,"_5":15036,"_28646":54658,"_3122":55035},[],"Send `Content-Type: application/pkcs10` with a Base64-encoded DER PKCS#10 CSR in the body. Lamassu decodes the body directly as Base64. Send the encoded CSR as the entire body.",{"_3731":1177,"_31485":1039,"_21804":55037,"_5":15036,"_28646":54658,"_3122":55038},[],"**Default response.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The PKCS#7 contains the issued certificate. Retrieve the CA certificates you need to validate its chain separately.",{"_3731":1178,"_31485":1039,"_21804":55040,"_5":15036,"_28646":54658,"_3122":55041},[],"**PEM response.** Send exactly `Accept: application/x-pem-file` to receive the certificate in PEM with `Content-Type: application/x-pem-file`.",{"_3731":1179,"_31485":1039,"_21804":55043,"_5":15036,"_28646":54658,"_3122":55044},[],"Follow the shared client setup to set `EST_BASE` and prepare the credentials.",{"_3731":1180,"_31485":1039,"_21804":55046,"_5":15036,"_28646":54658,"_3122":55047},[],"**Prepare the CSR**",{"_3731":1181,"_31485":1039,"_21804":55049,"_5":15036,"_28646":54658,"_3122":55050},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3731":1182,"_31485":1039,"_21804":55052,"_5":15036,"_28646":54658,"_3122":55053},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3731":1183,"_31485":1039,"_21804":55055,"_5":15036,"_28646":54658,"_3122":55056},[],"**Request the identity**",{"_3731":1184,"_31485":1039,"_21804":55058,"_5":15036,"_28646":54658,"_3122":55059},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3731":1185,"_31485":1039,"_21804":55061,"_5":15036,"_28646":54658,"_3122":55062},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3731":1186,"_31485":1039,"_21804":55064,"_5":15036,"_28646":54658,"_3122":55065},[],"For a root that issues directly:",{"_3731":1187,"_31485":1039,"_21804":55067,"_5":15036,"_28646":54658,"_3122":55068},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3731":1188,"_31485":1039,"_21804":55070,"_5":15036,"_28646":54658,"_3122":55071},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3731":1189,"_31485":1039,"_21804":55073,"_5":15036,"_28646":54661,"_3122":55074},[],"`POST /simplereenroll` issues a successor certificate for an active identity. The client keeps the device identifier and can request the certificate with a new key.",{"_3731":1190,"_31485":1039,"_21804":55076,"_5":15036,"_28646":54665,"_3122":55077},[],"The following options are stored in `settings.reenrollment_settings`.",{"_3731":1191,"_31485":1039,"_21804":55079,"_5":15036,"_28646":54665,"_3122":55080},[],"**Renewal authentication**",{"_3731":1192,"_31485":1039,"_21804":55082,"_5":15036,"_28646":54665,"_3122":55083},[],"`est_rfc7030_settings.auth_mode` controls how the client authenticates for renewal. See Authentication per operation.",{"_3731":1193,"_31485":1039,"_21804":55085,"_5":15036,"_28646":54665,"_3122":55086},[],"**Renewal window**",{"_3731":1194,"_31485":1039,"_21804":55088,"_5":15036,"_28646":54665,"_3122":55089},[],"`reenrollment_delta`. Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3731":1195,"_31485":1039,"_21804":55091,"_5":15036,"_28646":54665,"_3122":55092},[],"**Preventive threshold**",{"_3731":1196,"_31485":1039,"_21804":55094,"_5":15036,"_28646":54665,"_3122":55095},[],"`preventive_delta`. Preventive operational monitoring threshold.",{"_3731":1197,"_31485":1039,"_21804":55097,"_5":15036,"_28646":54665,"_3122":55098},[],"**Critical threshold**",{"_3731":1198,"_31485":1039,"_21804":55100,"_5":15036,"_28646":54665,"_3122":55101},[],"`critical_delta`. Critical operational monitoring threshold.",{"_3731":1199,"_31485":1039,"_21804":55103,"_5":15036,"_28646":54665,"_3122":55104},[],"**Renewal with an expired certificate**",{"_3731":1200,"_31485":1039,"_21804":55106,"_5":15036,"_28646":54665,"_3122":55107},[],"`enable_expired_renewal`. Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3731":1201,"_31485":1039,"_21804":55109,"_5":15036,"_28646":54665,"_3122":55110},[],"**Renewal validation CAs**",{"_3731":1202,"_31485":1039,"_21804":55112,"_5":15036,"_28646":54665,"_3122":55113},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`. Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3731":1203,"_31485":1039,"_21804":55115,"_5":15036,"_28646":54665,"_3122":55116},[],"**Previous certificate revocation**",{"_3731":1204,"_31485":1039,"_21804":55118,"_5":15036,"_28646":54665,"_3122":55119},[],"`revoke_on_reenrollment`. If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3731":1205,"_31485":1039,"_21804":55121,"_5":15036,"_28646":54665,"_3122":55122},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review renewal and recovery for operation order and partial failures.",{"_3731":1206,"_31485":1039,"_21804":55124,"_5":15036,"_28646":54668,"_3122":55125},[],"Use the same CSR format and headers as `simpleenroll`. The response contains the successor certificate in Base64-encoded DER PKCS#7, or in PEM if you send exactly `Accept: application/x-pem-file`.",{"_3731":1207,"_31485":1039,"_21804":55127,"_5":15036,"_28646":54668,"_3122":55128},[],"With certificate authentication, Lamassu requires the credential’s CN to match the CSR’s CN and compares the requested subject with the current certificate. The DMS rejects a revoked current certificate or a request made before the renewal window. See authentication per operation for accepted CAs, expiry and revocation checks.",{"_3731":1208,"_31485":1039,"_21804":55130,"_5":15036,"_28646":54668,"_3122":55131},[],"**Prepare renewal**",{"_3731":1209,"_31485":1039,"_21804":55133,"_5":15036,"_28646":54668,"_3122":55134},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3731":1210,"_31485":1039,"_21804":55136,"_5":15036,"_28646":54668,"_3122":55137},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3731":1211,"_31485":1039,"_21804":55139,"_5":15036,"_28646":54668,"_3122":55140},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3731":1212,"_31485":1039,"_21804":55142,"_5":15036,"_28646":54668,"_3122":55143},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3731":1213,"_31485":1039,"_21804":55145,"_5":15036,"_28646":54668,"_3122":55146},[],"**Request the successor certificate**",{"_3731":1214,"_31485":1039,"_21804":55148,"_5":15036,"_28646":54668,"_3122":55149},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3731":1215,"_31485":1039,"_21804":55151,"_5":15036,"_28646":54668,"_3122":55152},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3731":1216,"_31485":1039,"_21804":55154,"_5":15036,"_28646":54668,"_3122":55155},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3731":1217,"_31485":1039,"_21804":55157,"_5":15036,"_28646":54668,"_3122":55158},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3731":1218,"_31485":1039,"_21804":55160,"_5":15036,"_28646":54668,"_3122":55161},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3731":1219,"_31485":1039,"_21804":55163,"_5":15036,"_28646":54671,"_3122":55164},[],"Situation",{"_3731":1220,"_31485":1039,"_21804":55166,"_5":15036,"_28646":54671,"_3122":55167},[],"Procedure",{"_3731":1221,"_31485":1039,"_21804":55169,"_5":15036,"_28646":54671,"_3122":55170},[],"Valid certificate, outside the window",{"_3731":1222,"_31485":1039,"_21804":55172,"_5":15036,"_28646":54671,"_3122":55173},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3731":1223,"_31485":1039,"_21804":55175,"_5":15036,"_28646":54671,"_3122":55176},[],"Expired certificate, key available",{"_3731":1224,"_31485":1039,"_21804":55178,"_5":15036,"_28646":54671,"_3122":55179},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3731":1225,"_31485":1039,"_21804":55181,"_5":15036,"_28646":54671,"_3122":55182},[],"Renewal through webhook or `NO_AUTH`",{"_3731":1226,"_31485":1039,"_21804":55184,"_5":15036,"_28646":54671,"_3122":55185},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3731":1227,"_31485":1039,"_21804":55187,"_5":15036,"_28646":54671,"_3122":55188},[],"Lost or inaccessible key",{"_3731":1228,"_31485":1039,"_21804":55190,"_5":15036,"_28646":54671,"_3122":55191},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3731":1229,"_31485":1039,"_21804":55193,"_5":15036,"_28646":54671,"_3122":55194},[],"Current identity revoked",{"_3731":1230,"_31485":1039,"_21804":55196,"_5":15036,"_28646":54671,"_3122":55197},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3731":1231,"_31485":1039,"_21804":55199,"_5":15036,"_28646":54671,"_3122":55200},[],"Device without an identity",{"_3731":1232,"_31485":1039,"_21804":55202,"_5":15036,"_28646":54671,"_3122":55203},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3731":1233,"_31485":1039,"_21804":55205,"_5":15036,"_28646":54671,"_3122":55206},[],"Retired device",{"_3731":1234,"_31485":1039,"_21804":55208,"_5":15036,"_28646":54671,"_3122":55209},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3731":1235,"_31485":1039,"_21804":55211,"_5":15036,"_28646":54671,"_3122":55212},[],"Timeout, HTTP 500 or installation failure",{"_3731":1236,"_31485":1039,"_21804":55214,"_5":15036,"_28646":54671,"_3122":55215},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3731":1237,"_31485":1039,"_21804":55217,"_5":15036,"_28646":54675,"_3122":55218},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3731":1238,"_31485":1039,"_21804":55220,"_5":15036,"_28646":54675,"_3122":55221},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3731":1239,"_31485":1039,"_21804":55223,"_5":15036,"_28646":54679,"_3122":55224},[],"`POST /serverkeygen` generates a software key in Lamassu, rebuilds the CSR with that key and performs initial enrollment. The client receives the private key and certificate.",{"_3731":1240,"_31485":1039,"_21804":55226,"_5":15036,"_28646":54683,"_3122":55227},[],"`settings.server_keygen_settings` controls key generation. The operation applies the initial enrollment policy. Before testing with a registered ID, check whether the policy allows certificate replacement.",{"_3731":1241,"_31485":1039,"_21804":55229,"_5":15036,"_28646":54683,"_3122":55230},[],"**Enable key generation**",{"_3731":1242,"_31485":1039,"_21804":55232,"_5":15036,"_28646":54683,"_3122":55233},[],"`enabled` turns on the operation. The console shows an **Enable server-side key generation** switch. When disabled, the console omits the `key` field.",{"_3731":1243,"_31485":1039,"_21804":55235,"_5":15036,"_28646":54683,"_3122":55236},[],"**Key type**",{"_3731":1244,"_31485":1039,"_21804":55238,"_5":15036,"_28646":54683,"_3122":55239},[],"`key.type` selects RSA or ECDSA in **Key type**. The issuance profile must allow the selected algorithm and size.",{"_3731":1245,"_31485":1039,"_21804":55241,"_5":15036,"_28646":54683,"_3122":55242},[],"**Key size**",{"_3731":1246,"_31485":1039,"_21804":55244,"_5":15036,"_28646":54683,"_3122":55245},[],"`key.bits` is the modulus size for RSA or the curve for ECDSA. The console offers 2048, 3072 or 4096 bits for RSA, defaulting to 4096, and P-256, P-384 or P-521 for ECDSA, defaulting to P-256.",{"_3731":1247,"_31485":1039,"_21804":55247,"_5":15036,"_28646":54683,"_3122":55248},[],"For ECDSA, the service also recognizes 224, 256, 384 and 521 as P-224, P-256, P-384 and P-521. An unrecognized value selects P-256. Choose a compatible size and check the resulting key.",{"_3731":1248,"_31485":1039,"_21804":55250,"_5":15036,"_28646":54686,"_3122":55251},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The response uses this operation’s multipart format even if `Accept` asks for PEM. Lamassu generates the key in software even when the CA signs with an HSM-backed key.",{"_3731":1249,"_31485":1039,"_21804":55253,"_5":15036,"_28646":54686,"_3122":55254},[],"**Response format**",{"_3731":1250,"_31485":1039,"_21804":55256,"_5":15036,"_28646":54686,"_3122":55257},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3731":1251,"_31485":1039,"_21804":55259,"_5":15036,"_28646":54686,"_3122":55260},[],"Part",{"_3731":1252,"_31485":1039,"_21804":55262,"_5":15036,"_28646":54686,"_3122":55263},[],"Content after decoding its Base64",{"_3731":1253,"_31485":1039,"_21804":55265,"_5":15036,"_28646":54686,"_3122":55266},[],"`application/pkcs8`",{"_3731":1254,"_31485":1039,"_21804":55268,"_5":15036,"_28646":54686,"_3122":55269},[],"Unencrypted DER PKCS#8 private key.",{"_3731":1255,"_31485":1039,"_21804":55271,"_5":15036,"_28646":54686,"_3122":55272},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3731":1256,"_31485":1039,"_21804":55274,"_5":15036,"_28646":54686,"_3122":55275},[],"DER PKCS#7 containing the issued certificate.",{"_3731":1257,"_31485":1039,"_21804":55277,"_5":15036,"_28646":54686,"_3122":55278},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3731":1258,"_31485":1039,"_21804":55280,"_5":15036,"_28646":54686,"_3122":55281},[],"**Example request**",{"_3731":1259,"_31485":1039,"_21804":55283,"_5":15036,"_28646":54686,"_3122":55284},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from client setup. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3731":1260,"_31485":1039,"_21804":55286,"_5":15036,"_28646":54686,"_3122":55287},[],"Process the MIME parts according to their headers and verify that the received key matches the certificate. Inspect the CN, serial, dates and uses, and check the association in Lamassu before installing. Protect files containing the key and remove temporary copies according to the device storage mechanism.",{"_3731":1261,"_31485":1261,"_5":15390,"_3122":55289,"_31812":55290,"_21804":55291,"_28646":1261},"EST Reference",[51373,52911,54083,54532],[],{"_3731":1262,"_31485":1261,"_21804":55293,"_5":15036,"_28646":1261,"_3122":55294},[],"The Enrollment over Secure Transport protocol defined by RFC 7030.",{"_3731":1263,"_31485":1261,"_5":31809,"_21804":55296,"_28646":55297,"_3122":52671},[],"/docs/platform/iot-fleets/est#operations",{"_3731":1264,"_31485":1261,"_5":31809,"_21804":55299,"_28646":55300,"_3122":55301},[],"/docs/platform/iot-fleets/est#authentication-and-messages","Authentication and messages",{"_3731":1265,"_31485":1261,"_21804":55303,"_5":15036,"_28646":1261,"_3122":55304},[],"Enrollment over Secure Transport (EST) is a protocol for obtaining and renewing X.509 certificates over HTTPS. An EST client communicates with an EST server, which handles certificate requests and provides certification authority certificates. The standard defines messages, operations and authentication mechanisms. RFC 7030",{"_3731":1266,"_31485":1261,"_21804":55306,"_5":15036,"_28646":55297,"_3122":55307},[],"Operation paths are appended to the `/.well-known/est` prefix, which may include a label identifying the CA or service.",{"_3731":1267,"_31485":1261,"_21804":55309,"_5":15036,"_28646":55297,"_3122":54698},[],{"_3731":1268,"_31485":1261,"_21804":55311,"_5":15036,"_28646":55297,"_3122":54701},[],{"_3731":1269,"_31485":1261,"_21804":55313,"_5":15036,"_28646":55297,"_3122":51763},[],{"_3731":1270,"_31485":1261,"_21804":55315,"_5":15036,"_28646":55297,"_3122":55316},[],"Server support",{"_3731":1271,"_31485":1261,"_21804":55318,"_5":15036,"_28646":55297,"_3122":54707},[],{"_3731":1272,"_31485":1261,"_21804":55320,"_5":15036,"_28646":55297,"_3122":54710},[],{"_3731":1273,"_31485":1261,"_21804":55322,"_5":15036,"_28646":55297,"_3122":55323},[],"Retrieve CA certificates.",{"_3731":1274,"_31485":1261,"_21804":55325,"_5":15036,"_28646":55297,"_3122":55326},[],"Mandatory",{"_3731":1275,"_31485":1261,"_21804":55328,"_5":15036,"_28646":55297,"_3122":54716},[],{"_3731":1276,"_31485":1261,"_21804":55330,"_5":15036,"_28646":55297,"_3122":54719},[],{"_3731":1277,"_31485":1261,"_21804":55332,"_5":15036,"_28646":55297,"_3122":55333},[],"Request an initial certificate using a CSR.",{"_3731":1278,"_31485":1261,"_21804":55335,"_5":15036,"_28646":55297,"_3122":55326},[],{"_3731":1279,"_31485":1261,"_21804":55337,"_5":15036,"_28646":55297,"_3122":54725},[],{"_3731":1280,"_31485":1261,"_21804":55339,"_5":15036,"_28646":55297,"_3122":54719},[],{"_3731":1281,"_31485":1261,"_21804":55341,"_5":15036,"_28646":55297,"_3122":55342},[],"Request certificate renewal or rekeying.",{"_3731":1282,"_31485":1261,"_21804":55344,"_5":15036,"_28646":55297,"_3122":55326},[],{"_3731":1283,"_31485":1261,"_21804":55346,"_5":15036,"_28646":55297,"_3122":54733},[],{"_3731":1284,"_31485":1261,"_21804":55348,"_5":15036,"_28646":55297,"_3122":54719},[],{"_3731":1285,"_31485":1261,"_21804":55350,"_5":15036,"_28646":55297,"_3122":55351},[],"Request a server-generated key and its certificate.",{"_3731":1286,"_31485":1261,"_21804":55353,"_5":15036,"_28646":55297,"_3122":55354},[],"Optional",{"_3731":1287,"_31485":1261,"_21804":55356,"_5":15036,"_28646":55297,"_3122":55357},[],"`/csrattrs`",{"_3731":1288,"_31485":1261,"_21804":55359,"_5":15036,"_28646":55297,"_3122":54710},[],{"_3731":1289,"_31485":1261,"_21804":55361,"_5":15036,"_28646":55297,"_3122":55362},[],"Retrieve suggested CSR attributes.",{"_3731":1290,"_31485":1261,"_21804":55364,"_5":15036,"_28646":55297,"_3122":55354},[],{"_3731":1291,"_31485":1261,"_21804":55366,"_5":15036,"_28646":55297,"_3122":55367},[],"`/fullcmc`",{"_3731":1292,"_31485":1261,"_21804":55369,"_5":15036,"_28646":55297,"_3122":54719},[],{"_3731":1293,"_31485":1261,"_21804":55371,"_5":15036,"_28646":55297,"_3122":55372},[],"Submit a Full CMC request.",{"_3731":1294,"_31485":1261,"_21804":55374,"_5":15036,"_28646":55297,"_3122":55354},[],{"_3731":1295,"_31485":1261,"_21804":55376,"_5":15036,"_28646":55300,"_3122":55377},[],"EST uses TLS to protect the exchange. The client authenticates the server, and the server authenticates and authorizes the client using the mechanisms defined by the standard. Initial CA certificate distribution has specific conditions for establishing trust. RFC 7030, sections 3.3 and 4.1",{"_3731":1296,"_31485":1261,"_21804":55379,"_5":15036,"_28646":55300,"_3122":55380},[],"The `/simpleenroll` and `/simplereenroll` requests use a PKCS#10 CSR. The certificate response uses PKCS#7. The `/serverkeygen` response is `multipart/mixed` and contains the key and certificate. The standard also defines Full CMC requests and responses and the CSR attributes format. RFC 7030, section 3.2.4",{"_3731":1297,"_31485":1261,"_21804":55382,"_5":15036,"_28646":55300,"_3122":55383},[],"See EST in Lamassu for the available operations and their configuration.",{"_3731":1298,"_31485":1298,"_5":15390,"_3122":55385,"_31812":55386,"_21804":55387,"_28646":1298},"Enrollment troubleshooting",[51373,52911,54083,54532],[],{"_3731":1299,"_31485":1298,"_21804":55389,"_5":15036,"_28646":1298,"_3122":55390},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3731":1300,"_31485":1298,"_5":31809,"_21804":55392,"_28646":55393,"_3122":55394},[],"/docs/platform/iot-fleets/est/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3731":1301,"_31485":1298,"_5":31809,"_21804":55396,"_28646":55397,"_3122":55398},[],"/docs/platform/iot-fleets/est/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3731":1302,"_31485":1298,"_5":31809,"_21804":55400,"_28646":55401,"_3122":54633},[],"/docs/platform/iot-fleets/est/troubleshooting#compatibility-notes",{"_3731":1303,"_31485":1298,"_5":31809,"_21804":55403,"_28646":55404,"_3122":55405},[],"/docs/platform/iot-fleets/est/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3731":1304,"_31485":1298,"_21804":55407,"_5":15036,"_28646":1298,"_3122":55408},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3731":1305,"_31485":1298,"_21804":55410,"_5":15036,"_28646":55397,"_3122":55411},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3731":1306,"_31485":1298,"_21804":55413,"_5":15036,"_28646":55397,"_3122":55414},[],"Symptom or message",{"_3731":1307,"_31485":1298,"_21804":55416,"_5":15036,"_28646":55397,"_3122":54439},[],{"_3731":1308,"_31485":1298,"_21804":55418,"_5":15036,"_28646":55397,"_3122":55419},[],"curl rejects TLS, name or issuer",{"_3731":1309,"_31485":1298,"_21804":55421,"_5":15036,"_28646":55397,"_3122":55422},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3731":1310,"_31485":1298,"_21804":55424,"_5":15036,"_28646":55397,"_3122":55425},[],"404 or missing APS",{"_3731":1311,"_31485":1298,"_21804":55427,"_5":15036,"_28646":55397,"_3122":55428},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3731":1312,"_31485":1298,"_21804":55430,"_5":15036,"_28646":55397,"_3122":55431},[],"400, CSR or format error",{"_3731":1313,"_31485":1298,"_21804":55433,"_5":15036,"_28646":55397,"_3122":55434},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3731":1314,"_31485":1298,"_21804":55436,"_5":15036,"_28646":55397,"_3122":55437},[],"Missing credential or invalid certificate",{"_3731":1315,"_31485":1298,"_21804":55439,"_5":15036,"_28646":55397,"_3122":55440},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3731":1316,"_31485":1298,"_21804":55442,"_5":15036,"_28646":55397,"_3122":55443},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3731":1317,"_31485":1298,"_21804":55445,"_5":15036,"_28646":55397,"_3122":55446},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3731":1318,"_31485":1298,"_21804":55448,"_5":15036,"_28646":55397,"_3122":55449},[],"Webhook denies, times out or responds without authorization",{"_3731":1319,"_31485":1298,"_21804":55451,"_5":15036,"_28646":55397,"_3122":55452},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3731":1320,"_31485":1298,"_21804":55454,"_5":15036,"_28646":55397,"_3122":55455},[],"`unexpected status code: <n>: redirects are not followed`",{"_3731":1321,"_31485":1298,"_21804":55457,"_5":15036,"_28646":55397,"_3122":55458},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3731":1322,"_31485":1298,"_21804":55460,"_5":15036,"_28646":55397,"_3122":55461},[],"`webhook response exceeds 1048576 bytes`",{"_3731":1323,"_31485":1298,"_21804":55463,"_5":15036,"_28646":55397,"_3122":55464},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3731":1324,"_31485":1298,"_21804":55466,"_5":15036,"_28646":55397,"_3122":55467},[],"`webhook config must not reference files`",{"_3731":1325,"_31485":1298,"_21804":55469,"_5":15036,"_28646":55397,"_3122":55470},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3731":1326,"_31485":1298,"_21804":55472,"_5":15036,"_28646":55397,"_3122":55473},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3731":1327,"_31485":1298,"_21804":55475,"_5":15036,"_28646":55397,"_3122":55476},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3731":1328,"_31485":1298,"_21804":55478,"_5":15036,"_28646":55397,"_3122":55479},[],"`webhook mTLS certificate and key are invalid: …`",{"_3731":1329,"_31485":1298,"_21804":55481,"_5":15036,"_28646":55397,"_3122":55482},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3731":1330,"_31485":1298,"_21804":55484,"_5":15036,"_28646":55397,"_3122":55485},[],"400 `struct validation error` creating or updating a DMS",{"_3731":1331,"_31485":1298,"_21804":55487,"_5":15036,"_28646":55397,"_3122":55488},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3731":1332,"_31485":1298,"_21804":55490,"_5":15036,"_28646":55397,"_3122":55491},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3731":1333,"_31485":1298,"_21804":55493,"_5":15036,"_28646":55397,"_3122":55494},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3731":1334,"_31485":1298,"_21804":55496,"_5":15036,"_28646":55397,"_3122":55497},[],"`device not preregistered`",{"_3731":1335,"_31485":1298,"_21804":55499,"_5":15036,"_28646":55397,"_3122":55500},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3731":1336,"_31485":1298,"_21804":55502,"_5":15036,"_28646":55397,"_3122":55503},[],"`forbiddenNewEnrollment`",{"_3731":1337,"_31485":1298,"_21804":55505,"_5":15036,"_28646":55397,"_3122":55506},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3731":1338,"_31485":1298,"_21804":55508,"_5":15036,"_28646":55397,"_3122":55509},[],"Different owning DMS",{"_3731":1339,"_31485":1298,"_21804":55511,"_5":15036,"_28646":55397,"_3122":55512},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3731":1340,"_31485":1298,"_21804":55514,"_5":15036,"_28646":55397,"_3122":55515},[],"`invalid RawSubject bytes`",{"_3731":1341,"_31485":1298,"_21804":55517,"_5":15036,"_28646":55397,"_3122":55518},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3731":1342,"_31485":1298,"_21804":55520,"_5":15036,"_28646":55397,"_3122":55521},[],"`invalid reenroll window`",{"_3731":1343,"_31485":1298,"_21804":55523,"_5":15036,"_28646":55397,"_3122":55524},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3731":1344,"_31485":1298,"_21804":55526,"_5":15036,"_28646":55397,"_3122":55527},[],"Current certificate revoked",{"_3731":1345,"_31485":1298,"_21804":55529,"_5":15036,"_28646":55397,"_3122":55530},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3731":1346,"_31485":1298,"_21804":55532,"_5":15036,"_28646":55397,"_3122":55533},[],"CA, profile or signing error",{"_3731":1347,"_31485":1298,"_21804":55535,"_5":15036,"_28646":55397,"_3122":55536},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3731":1348,"_31485":1298,"_21804":55538,"_5":15036,"_28646":55397,"_3122":55539},[],"HTTP 200 without a device connection",{"_3731":1349,"_31485":1298,"_21804":55541,"_5":15036,"_28646":55397,"_3122":55542},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3731":1350,"_31485":1298,"_21804":55544,"_5":15036,"_28646":55397,"_3122":55545},[],"Timeout or error after issuance",{"_3731":1351,"_31485":1298,"_21804":55547,"_5":15036,"_28646":55397,"_3122":55548},[],"New certificates, current slot and previous identity's state before retrying.",{"_3731":1352,"_31485":1298,"_21804":55550,"_5":15036,"_28646":55401,"_3122":55551},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3731":1353,"_31485":1298,"_21804":55553,"_5":15036,"_28646":55401,"_3122":55554},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST in Lamassu.",{"_3731":1354,"_31485":1298,"_21804":55556,"_5":15036,"_28646":55404,"_3122":55557},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3731":1355,"_31485":1298,"_21804":55559,"_5":15036,"_28646":55404,"_3122":55560},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3731":1356,"_31485":1298,"_21804":55562,"_5":15036,"_28646":55404,"_3122":55563},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3731":1357,"_31485":1298,"_21804":55565,"_5":15036,"_28646":55404,"_3122":55566},[],"Make one request, save headers/body and query the device and certificates.",{"_3731":1358,"_31485":1298,"_21804":55568,"_5":15036,"_28646":55404,"_3122":55569},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3731":1359,"_31485":1298,"_21804":55571,"_5":15036,"_28646":55404,"_3122":55572},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified (including an OCSP Unknown status) is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3731":1360,"_31485":1298,"_21804":55574,"_5":15036,"_28646":55404,"_3122":55575},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3731":1361,"_31485":1361,"_5":15390,"_3122":55577,"_31812":55578,"_21804":55580,"_28646":1361},"AWS IoT Core",[51373,52911,54083,54081,55579],"Integrations",[],{"_3731":1362,"_31485":1361,"_21804":55582,"_5":15036,"_28646":1361,"_3122":55583},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3731":1363,"_31485":1361,"_5":31809,"_21804":55585,"_28646":55586,"_3122":55587},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3731":1364,"_31485":1361,"_5":31809,"_21804":55589,"_28646":55590,"_3122":55591},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3731":1365,"_31485":1361,"_5":31809,"_21804":55593,"_28646":55594,"_3122":55595},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3731":1366,"_31485":1361,"_5":31809,"_21804":55597,"_28646":55598,"_3122":55599},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3731":1367,"_31485":1361,"_5":31809,"_21804":55601,"_28646":55602,"_3122":55603},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3731":1368,"_31485":1361,"_5":31809,"_21804":55605,"_28646":55606,"_3122":55607},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3731":1369,"_31485":1361,"_5":31809,"_21804":55609,"_28646":55610,"_3122":55611},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3731":1370,"_31485":1361,"_5":31809,"_21804":55613,"_28646":55614,"_3122":55615},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3731":1371,"_31485":1361,"_5":31809,"_21804":55617,"_28646":55618,"_3122":55619},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3731":1372,"_31485":1361,"_5":31809,"_21804":55621,"_28646":55622,"_3122":55623},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3731":1373,"_31485":1361,"_5":31809,"_21804":55625,"_28646":55626,"_3122":55627},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3731":1374,"_31485":1361,"_5":31809,"_21804":55629,"_28646":55630,"_3122":55631},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3731":1375,"_31485":1361,"_5":31809,"_21804":55633,"_28646":55634,"_3122":55635},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3731":1376,"_31485":1361,"_5":31809,"_21804":55637,"_28646":55638,"_3122":55639},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3731":1377,"_31485":1361,"_5":31809,"_21804":55641,"_28646":55642,"_3122":55643},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3731":1378,"_31485":1361,"_5":31809,"_21804":55645,"_28646":55646,"_3122":55647},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3731":1379,"_31485":1361,"_5":31809,"_21804":55649,"_28646":55650,"_3122":55651},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3731":1380,"_31485":1361,"_5":31809,"_21804":55653,"_28646":55654,"_3122":55655},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3731":1381,"_31485":1361,"_5":31809,"_21804":55657,"_28646":55658,"_3122":55659},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3731":1382,"_31485":1361,"_5":31809,"_21804":55661,"_28646":55662,"_3122":55663},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3731":1383,"_31485":1361,"_5":31809,"_21804":55665,"_28646":55666,"_3122":55667},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3731":1384,"_31485":1361,"_5":31809,"_21804":55669,"_28646":55670,"_3122":55671},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3731":1385,"_31485":1361,"_5":31809,"_21804":55673,"_28646":55674,"_3122":55675},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3731":1386,"_31485":1361,"_5":31809,"_21804":55677,"_28646":55678,"_3122":55679},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3731":1387,"_31485":1361,"_5":31809,"_21804":55681,"_28646":55682,"_3122":55683},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3731":1388,"_31485":1361,"_21804":55685,"_5":15036,"_28646":1361,"_3122":55686},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3731":1389,"_31485":1361,"_21804":55688,"_5":15036,"_28646":1361,"_3122":55689},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3731":1390,"_31485":1361,"_21804":55691,"_5":15036,"_28646":1361,"_3122":55692},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3731":1391,"_31485":1361,"_21804":55694,"_5":15036,"_28646":55586,"_3122":55695},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3731":1392,"_31485":1361,"_21804":55697,"_5":15036,"_28646":55586,"_3122":55698},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3731":1393,"_31485":1361,"_21804":55700,"_5":15036,"_28646":55586,"_3122":55701},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3731":1394,"_31485":1361,"_21804":55703,"_5":15036,"_28646":55586,"_3122":55704},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3731":1395,"_31485":1361,"_21804":55706,"_5":15036,"_28646":55590,"_3122":55707},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3731":1396,"_31485":1361,"_21804":55709,"_5":15036,"_28646":55594,"_3122":55710},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3731":1397,"_31485":1361,"_21804":55712,"_5":15036,"_28646":55594,"_3122":55713},[],"IAM action",{"_3731":1398,"_31485":1361,"_21804":55715,"_5":15036,"_28646":55594,"_3122":51763},[],{"_3731":1399,"_31485":1361,"_21804":55717,"_5":15036,"_28646":55594,"_3122":55718},[],"`iot:GetRegistrationCode`",{"_3731":1400,"_31485":1361,"_21804":55720,"_5":15036,"_28646":55594,"_3122":55721},[],"Obtain the verification code for CA registration in the Primary Account",{"_3731":1401,"_31485":1361,"_21804":55723,"_5":15036,"_28646":55594,"_3122":55724},[],"`iot:RegisterCACertificate`",{"_3731":1402,"_31485":1361,"_21804":55726,"_5":15036,"_28646":55594,"_3122":55727},[],"Register the CA in AWS IoT",{"_3731":1403,"_31485":1361,"_21804":55729,"_5":15036,"_28646":55594,"_3122":55730},[],"`iot:DescribeCACertificate`",{"_3731":1404,"_31485":1361,"_21804":55732,"_5":15036,"_28646":55594,"_3122":55733},[],"Check the CA registration status",{"_3731":1405,"_31485":1361,"_21804":55735,"_5":15036,"_28646":55594,"_3122":55736},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3731":1406,"_31485":1361,"_21804":55738,"_5":15036,"_28646":55594,"_3122":55739},[],"Create or update Things in IoT Core",{"_3731":1407,"_31485":1361,"_21804":55741,"_5":15036,"_28646":55594,"_3122":55742},[],"`iot:RegisterThing`",{"_3731":1408,"_31485":1361,"_21804":55744,"_5":15036,"_28646":55594,"_3122":55745},[],"Provision Things through a template",{"_3731":1409,"_31485":1361,"_21804":55747,"_5":15036,"_28646":55594,"_3122":55748},[],"`iot:RegisterCertificate`",{"_3731":1410,"_31485":1361,"_21804":55750,"_5":15036,"_28646":55594,"_3122":55751},[],"Register device certificates",{"_3731":1411,"_31485":1361,"_21804":55753,"_5":15036,"_28646":55594,"_3122":55754},[],"`iot:UpdateCertificate`",{"_3731":1412,"_31485":1361,"_21804":55756,"_5":15036,"_28646":55594,"_3122":55757},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3731":1413,"_31485":1361,"_21804":55759,"_5":15036,"_28646":55594,"_3122":55760},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3731":1414,"_31485":1361,"_21804":55762,"_5":15036,"_28646":55594,"_3122":55763},[],"Create and attach IoT policies",{"_3731":1415,"_31485":1361,"_21804":55765,"_5":15036,"_28646":55594,"_3122":55766},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3731":1416,"_31485":1361,"_21804":55768,"_5":15036,"_28646":55594,"_3122":55769},[],"Manage Thing groups",{"_3731":1417,"_31485":1361,"_21804":55771,"_5":15036,"_28646":55594,"_3122":55772},[],"`iot:CreateProvisioningTemplate`",{"_3731":1418,"_31485":1361,"_21804":55774,"_5":15036,"_28646":55594,"_3122":55775},[],"Create JITP templates",{"_3731":1419,"_31485":1361,"_21804":55777,"_5":15036,"_28646":55594,"_3122":55778},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3731":1420,"_31485":1361,"_21804":55780,"_5":15036,"_28646":55594,"_3122":55781},[],"Read and write the Device Shadow",{"_3731":1421,"_31485":1361,"_21804":55783,"_5":15036,"_28646":55594,"_3122":55784},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3731":1422,"_31485":1361,"_21804":55786,"_5":15036,"_28646":55598,"_3122":55787},[],"Parameter",{"_3731":1423,"_31485":1361,"_21804":55789,"_5":15036,"_28646":55598,"_3122":55790},[],"Type",{"_3731":1424,"_31485":1361,"_21804":55792,"_5":15036,"_28646":55598,"_3122":55793},[],"Required",{"_3731":1425,"_31485":1361,"_21804":55795,"_5":15036,"_28646":55598,"_3122":55796},[],"Description",{"_3731":1426,"_31485":1361,"_21804":55798,"_5":15036,"_28646":55598,"_3122":55799},[],"`connector_id`",{"_3731":1427,"_31485":1361,"_21804":55801,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1428,"_31485":1361,"_21804":55803,"_5":15036,"_28646":55598,"_3122":55804},[],"Yes",{"_3731":1429,"_31485":1361,"_21804":55806,"_5":15036,"_28646":55598,"_3122":55807},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3731":1430,"_31485":1361,"_21804":55809,"_5":15036,"_28646":55598,"_3122":55810},[],"`aws_config.region`",{"_3731":1431,"_31485":1361,"_21804":55812,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1432,"_31485":1361,"_21804":55814,"_5":15036,"_28646":55598,"_3122":55804},[],{"_3731":1433,"_31485":1361,"_21804":55816,"_5":15036,"_28646":55598,"_3122":55817},[],"AWS region where the connector operates.",{"_3731":1434,"_31485":1361,"_21804":55819,"_5":15036,"_28646":55598,"_3122":55820},[],"`aws_config.auth_method`",{"_3731":1435,"_31485":1361,"_21804":55822,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1436,"_31485":1361,"_21804":55824,"_5":15036,"_28646":55598,"_3122":55804},[],{"_3731":1437,"_31485":1361,"_21804":55826,"_5":15036,"_28646":55598,"_3122":55827},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3731":1438,"_31485":1361,"_21804":55829,"_5":15036,"_28646":55598,"_3122":55830},[],"`aws_config.access_key_id`",{"_3731":1439,"_31485":1361,"_21804":55832,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1440,"_31485":1361,"_21804":55834,"_5":15036,"_28646":55598,"_3122":55835},[],"Only with `auth_method=static`",{"_3731":1441,"_31485":1361,"_21804":55837,"_5":15036,"_28646":55598,"_3122":55838},[],"AWS access key.",{"_3731":1442,"_31485":1361,"_21804":55840,"_5":15036,"_28646":55598,"_3122":55841},[],"`aws_config.secret_access_key`",{"_3731":1443,"_31485":1361,"_21804":55843,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1444,"_31485":1361,"_21804":55845,"_5":15036,"_28646":55598,"_3122":55835},[],{"_3731":1445,"_31485":1361,"_21804":55847,"_5":15036,"_28646":55598,"_3122":55848},[],"AWS secret key.",{"_3731":1446,"_31485":1361,"_21804":55850,"_5":15036,"_28646":55598,"_3122":55851},[],"`aws_config.session_token`",{"_3731":1447,"_31485":1361,"_21804":55853,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1448,"_31485":1361,"_21804":55855,"_5":15036,"_28646":55598,"_3122":55856},[],"No",{"_3731":1449,"_31485":1361,"_21804":55858,"_5":15036,"_28646":55598,"_3122":55859},[],"Session token (with `auth_method=static`).",{"_3731":1450,"_31485":1361,"_21804":55861,"_5":15036,"_28646":55598,"_3122":55862},[],"`aws_config.role_arn`",{"_3731":1451,"_31485":1361,"_21804":55864,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1452,"_31485":1361,"_21804":55866,"_5":15036,"_28646":55598,"_3122":55867},[],"Only with `auth_method=role`",{"_3731":1453,"_31485":1361,"_21804":55869,"_5":15036,"_28646":55598,"_3122":55870},[],"ARN of the role to assume.",{"_3731":1454,"_31485":1361,"_21804":55872,"_5":15036,"_28646":55598,"_3122":55873},[],"`aws_config.endpoint_url`",{"_3731":1455,"_31485":1361,"_21804":55875,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1456,"_31485":1361,"_21804":55877,"_5":15036,"_28646":55598,"_3122":55856},[],{"_3731":1457,"_31485":1361,"_21804":55879,"_5":15036,"_28646":55598,"_3122":55880},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3731":1458,"_31485":1361,"_21804":55882,"_5":15036,"_28646":55598,"_3122":55883},[],"`subscriber_event_bus`",{"_3731":1459,"_31485":1361,"_21804":55885,"_5":15036,"_28646":55598,"_3122":18396},[],{"_3731":1460,"_31485":1361,"_21804":55887,"_5":15036,"_28646":55598,"_3122":55804},[],{"_3731":1461,"_31485":1361,"_21804":55889,"_5":15036,"_28646":55598,"_3122":55890},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3731":1462,"_31485":1361,"_21804":55892,"_5":15036,"_28646":55598,"_3122":55893},[],"`dms_manager_client`",{"_3731":1463,"_31485":1361,"_21804":55895,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1464,"_31485":1361,"_21804":55897,"_5":15036,"_28646":55598,"_3122":55804},[],{"_3731":1465,"_31485":1361,"_21804":55899,"_5":15036,"_28646":55598,"_3122":55900},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3731":1466,"_31485":1361,"_21804":55902,"_5":15036,"_28646":55598,"_3122":55903},[],"`device_manager_client`",{"_3731":1467,"_31485":1361,"_21804":55905,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1468,"_31485":1361,"_21804":55907,"_5":15036,"_28646":55598,"_3122":55804},[],{"_3731":1469,"_31485":1361,"_21804":55909,"_5":15036,"_28646":55598,"_3122":55910},[],"HTTP URL of Lamassu's Device Manager.",{"_3731":1470,"_31485":1361,"_21804":55912,"_5":15036,"_28646":55598,"_3122":55913},[],"`ca_client`",{"_3731":1471,"_31485":1361,"_21804":55915,"_5":15036,"_28646":55598,"_3122":26006},[],{"_3731":1472,"_31485":1361,"_21804":55917,"_5":15036,"_28646":55598,"_3122":55804},[],{"_3731":1473,"_31485":1361,"_21804":55919,"_5":15036,"_28646":55598,"_3122":55920},[],"HTTP URL of Lamassu's CA service.",{"_3731":1474,"_31485":1361,"_21804":55922,"_5":15036,"_28646":55602,"_3122":55923},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3731":1475,"_31485":1361,"_21804":55925,"_5":15036,"_28646":55602,"_3122":55926},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3731":1476,"_31485":1361,"_21804":55928,"_5":15036,"_28646":55602,"_3122":55929},[],"CloudEvent type",{"_3731":1477,"_31485":1361,"_21804":55931,"_5":15036,"_28646":55602,"_3122":55932},[],"Lamassu resource",{"_3731":1478,"_31485":1361,"_21804":55934,"_5":15036,"_28646":55602,"_3122":55935},[],"AWS Resource",{"_3731":1479,"_31485":1361,"_21804":55937,"_5":15036,"_28646":55602,"_3122":55938},[],"IAM actions",{"_3731":1480,"_31485":1361,"_21804":55940,"_5":15036,"_28646":55602,"_3122":55941},[],"AWS calls and effect",{"_3731":1481,"_31485":1361,"_21804":55943,"_5":15036,"_28646":55602,"_3122":55944},[],"Where in this page",{"_3731":1482,"_31485":1361,"_21804":55946,"_5":15036,"_28646":55602,"_3122":55947},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3731":1483,"_31485":1361,"_21804":55949,"_5":15036,"_28646":55602,"_3122":55950},[],"CA",{"_3731":1484,"_31485":1361,"_21804":55952,"_5":15036,"_28646":55602,"_3122":55953},[],"`IoTCore/CACertificate`",{"_3731":1485,"_31485":1361,"_21804":55955,"_5":15036,"_28646":55602,"_3122":55956},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3731":1486,"_31485":1361,"_21804":55958,"_5":15036,"_28646":55602,"_3122":55959},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3731":1487,"_31485":1361,"_21804":55961,"_5":15036,"_28646":55602,"_3122":55615},[],{"_3731":1488,"_31485":1361,"_21804":55963,"_5":15036,"_28646":55602,"_3122":55964},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3731":1489,"_31485":1361,"_21804":55966,"_5":15036,"_28646":55602,"_3122":55967},[],"DMS",{"_3731":1490,"_31485":1361,"_21804":55969,"_5":15036,"_28646":55602,"_3122":55970},[],"`IoTCore/ProvisioningTemplate`",{"_3731":1491,"_31485":1361,"_21804":55972,"_5":15036,"_28646":55602,"_3122":55973},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3731":1492,"_31485":1361,"_21804":55975,"_5":15036,"_28646":55602,"_3122":55976},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3731":1493,"_31485":1361,"_21804":55978,"_5":15036,"_28646":55602,"_3122":55643},[],{"_3731":1494,"_31485":1361,"_21804":55980,"_5":15036,"_28646":55602,"_3122":55981},[],"`EventBindDeviceIdentityKey`",{"_3731":1495,"_31485":1361,"_21804":55983,"_5":15036,"_28646":55602,"_3122":55984},[],"Device",{"_3731":1496,"_31485":1361,"_21804":55986,"_5":15036,"_28646":55602,"_3122":55987},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3731":1497,"_31485":1361,"_21804":55989,"_5":15036,"_28646":55602,"_3122":55990},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3731":1498,"_31485":1361,"_21804":55992,"_5":15036,"_28646":55602,"_3122":55993},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3731":1499,"_31485":1361,"_21804":55995,"_5":15036,"_28646":55602,"_3122":55651},[],{"_3731":1500,"_31485":1361,"_21804":55997,"_5":15036,"_28646":55602,"_3122":55998},[],"`EventUpdateCertificateStatusKey`",{"_3731":1501,"_31485":1361,"_21804":56000,"_5":15036,"_28646":55602,"_3122":56001},[],"Certificate",{"_3731":1502,"_31485":1361,"_21804":56003,"_5":15036,"_28646":55602,"_3122":56004},[],"`IoTCore/Certificate`",{"_3731":1503,"_31485":1361,"_21804":56006,"_5":15036,"_28646":55602,"_3122":56007},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3731":1504,"_31485":1361,"_21804":56009,"_5":15036,"_28646":55602,"_3122":56010},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3731":1505,"_31485":1361,"_21804":56012,"_5":15036,"_28646":55602,"_3122":55663},[],{"_3731":1506,"_31485":1361,"_21804":56014,"_5":15036,"_28646":55602,"_3122":56015},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3731":1507,"_31485":1361,"_21804":56017,"_5":15036,"_28646":55602,"_3122":56018},[],"Certificate / Device",{"_3731":1508,"_31485":1361,"_21804":56020,"_5":15036,"_28646":55602,"_3122":56021},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3731":1509,"_31485":1361,"_21804":56023,"_5":15036,"_28646":55602,"_3122":51769},[],{"_3731":1510,"_31485":1361,"_21804":56025,"_5":15036,"_28646":55602,"_3122":56026},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3731":1511,"_31485":1361,"_21804":56028,"_5":15036,"_28646":55602,"_3122":55671},[],{"_3731":1512,"_31485":1361,"_21804":56030,"_5":15036,"_28646":55606,"_3122":56031},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3731":1513,"_31485":1361,"_21804":56033,"_5":15036,"_28646":55610,"_3122":56034},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3731":1514,"_31485":1361,"_21804":56036,"_5":15036,"_28646":55610,"_3122":56037},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3731":1515,"_31485":1361,"_21804":56039,"_5":15036,"_28646":55614,"_3122":56040},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3731":1516,"_31485":1361,"_21804":56042,"_5":15036,"_28646":55614,"_3122":56043},[],"Transition",{"_3731":1517,"_31485":1361,"_21804":56045,"_5":15036,"_28646":55614,"_3122":56046},[],"AWS calls",{"_3731":1518,"_31485":1361,"_21804":56048,"_5":15036,"_28646":55614,"_3122":56049},[],"`NotRegistered` → `Requested`",{"_3731":1519,"_31485":1361,"_21804":56051,"_5":15036,"_28646":55614,"_3122":56052},[],"none (metadata write only)",{"_3731":1520,"_31485":1361,"_21804":56054,"_5":15036,"_28646":55614,"_3122":56055},[],"`Requested` → `Registering`",{"_3731":1521,"_31485":1361,"_21804":56057,"_5":15036,"_28646":55614,"_3122":56058},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3731":1522,"_31485":1361,"_21804":56060,"_5":15036,"_28646":55614,"_3122":56061},[],"`Registering` → `Succeeded`",{"_3731":1523,"_31485":1361,"_21804":56063,"_5":15036,"_28646":55614,"_3122":56064},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3731":1524,"_31485":1361,"_21804":56066,"_5":15036,"_28646":55614,"_3122":56067},[],"`Registering` → `Failed`",{"_3731":1525,"_31485":1361,"_21804":56069,"_5":15036,"_28646":55614,"_3122":56070},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3731":1526,"_31485":1361,"_21804":56072,"_5":15036,"_28646":55614,"_3122":56073},[],"`Failed` / `Succeeded` → `Requested`",{"_3731":1527,"_31485":1361,"_21804":56075,"_5":15036,"_28646":55614,"_3122":56076},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3731":1528,"_31485":1361,"_21804":56078,"_5":15036,"_28646":55618,"_3122":56079},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3731":1529,"_31485":1361,"_21804":56081,"_5":15036,"_28646":55618,"_3122":56082},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3731":1530,"_31485":1361,"_21804":56084,"_5":15036,"_28646":55618,"_3122":56085},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3731":1531,"_31485":1361,"_21804":56087,"_5":15036,"_28646":55618,"_3122":56088},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3731":1532,"_31485":1361,"_21804":56090,"_5":15036,"_28646":55618,"_3122":56091},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3731":1533,"_31485":1361,"_21804":56093,"_5":15036,"_28646":55618,"_3122":56094},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3731":1534,"_31485":1361,"_21804":56096,"_5":15036,"_28646":55622,"_3122":56097},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3731":1535,"_31485":1361,"_21804":56099,"_5":15036,"_28646":55626,"_3122":56100},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3731":1536,"_31485":1361,"_21804":56102,"_5":15036,"_28646":55626,"_3122":56103},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3731":1537,"_31485":1361,"_21804":56105,"_5":15036,"_28646":55630,"_3122":56106},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3731":1538,"_31485":1361,"_21804":56108,"_5":15036,"_28646":55634,"_3122":56109},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3731":1539,"_31485":1361,"_21804":56111,"_5":15036,"_28646":55634,"_3122":56112},[],"Creates or updates the IoT policies configured in the DMS.",{"_3731":1540,"_31485":1361,"_21804":56114,"_5":15036,"_28646":55634,"_3122":56115},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3731":1541,"_31485":1361,"_21804":56117,"_5":15036,"_28646":55634,"_3122":56118},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3731":1542,"_31485":1361,"_21804":56120,"_5":15036,"_28646":55634,"_3122":56121},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3731":1543,"_31485":1361,"_21804":56123,"_5":15036,"_28646":55634,"_3122":56124},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3731":1544,"_31485":1361,"_21804":56126,"_5":15036,"_28646":55634,"_3122":56127},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3731":1545,"_31485":1361,"_21804":56129,"_5":15036,"_28646":55638,"_3122":56130},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3731":1546,"_31485":1361,"_21804":56132,"_5":15036,"_28646":55638,"_3122":56133},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3731":1547,"_31485":1361,"_21804":56135,"_5":15036,"_28646":55638,"_3122":56136},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3731":1548,"_31485":1361,"_21804":56138,"_5":15036,"_28646":55638,"_3122":56139},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3731":1549,"_31485":1361,"_21804":56141,"_5":15036,"_28646":55638,"_3122":56142},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3731":1550,"_31485":1361,"_21804":56144,"_5":15036,"_28646":55642,"_3122":56145},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3731":1551,"_31485":1361,"_21804":56147,"_5":15036,"_28646":55642,"_3122":56043},[],{"_3731":1552,"_31485":1361,"_21804":56149,"_5":15036,"_28646":55642,"_3122":56046},[],{"_3731":1553,"_31485":1361,"_21804":56151,"_5":15036,"_28646":55642,"_3122":56152},[],"`Unconfigured` → `None` / `Auto`",{"_3731":1554,"_31485":1361,"_21804":56154,"_5":15036,"_28646":55642,"_3122":56155},[],"none (configuration only)",{"_3731":1555,"_31485":1361,"_21804":56157,"_5":15036,"_28646":55642,"_3122":56158},[],"`None` ↔ `Auto`",{"_3731":1556,"_31485":1361,"_21804":56160,"_5":15036,"_28646":55642,"_3122":56155},[],{"_3731":1557,"_31485":1361,"_21804":56162,"_5":15036,"_28646":55642,"_3122":56163},[],"Any → `Jitp`",{"_3731":1558,"_31485":1361,"_21804":56165,"_5":15036,"_28646":55642,"_3122":56166},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3731":1559,"_31485":1361,"_21804":56168,"_5":15036,"_28646":55642,"_3122":56169},[],"`Jitp` → `None` / `Auto`",{"_3731":1560,"_31485":1361,"_21804":56171,"_5":15036,"_28646":55642,"_3122":56172},[],"none (the template stays in the AWS account)",{"_3731":1561,"_31485":1361,"_21804":56174,"_5":15036,"_28646":55646,"_3122":56175},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3731":1562,"_31485":1361,"_21804":56177,"_5":15036,"_28646":55646,"_3122":56178},[],"The full flow from the device's perspective is:",{"_3731":1563,"_31485":1361,"_21804":56180,"_5":15036,"_28646":55646,"_3122":56181},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3731":1564,"_31485":1361,"_21804":56183,"_5":15036,"_28646":55650,"_3122":56184},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3731":1565,"_31485":1361,"_21804":56186,"_5":15036,"_28646":55650,"_3122":56043},[],{"_3731":1566,"_31485":1361,"_21804":56188,"_5":15036,"_28646":55650,"_3122":56046},[],{"_3731":1567,"_31485":1361,"_21804":56190,"_5":15036,"_28646":55650,"_3122":56191},[],"`Absent` → `Provisioned`",{"_3731":1568,"_31485":1361,"_21804":56193,"_5":15036,"_28646":55650,"_3122":56194},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3731":1569,"_31485":1361,"_21804":56196,"_5":15036,"_28646":55650,"_3122":56197},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3731":1570,"_31485":1361,"_21804":56199,"_5":15036,"_28646":55650,"_3122":56200},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3731":1571,"_31485":1361,"_21804":56202,"_5":15036,"_28646":55650,"_3122":56203},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3731":1572,"_31485":1361,"_21804":56205,"_5":15036,"_28646":55654,"_3122":56206},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3731":1573,"_31485":1361,"_21804":56208,"_5":15036,"_28646":55654,"_3122":56209},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3731":1574,"_31485":1361,"_21804":56211,"_5":15036,"_28646":55654,"_3122":56212},[],"For the JITP flow to work correctly:",{"_3731":1575,"_31485":1361,"_21804":56214,"_5":15036,"_28646":55654,"_3122":56215},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3731":1576,"_31485":1361,"_21804":56217,"_5":15036,"_28646":55654,"_3122":56218},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3731":1577,"_31485":1361,"_21804":56220,"_5":15036,"_28646":55654,"_3122":56221},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3731":1578,"_31485":1361,"_21804":56223,"_5":15036,"_28646":55654,"_3122":56224},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3731":1579,"_31485":1361,"_21804":56226,"_5":15036,"_28646":55658,"_3122":56227},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3731":1580,"_31485":1361,"_21804":56229,"_5":15036,"_28646":55658,"_3122":56230},[],"Status in Lamassu",{"_3731":1581,"_31485":1361,"_21804":56232,"_5":15036,"_28646":55658,"_3122":56233},[],"Revocation reason",{"_3731":1582,"_31485":1361,"_21804":56235,"_5":15036,"_28646":55658,"_3122":56236},[],"Status in AWS IoT Core",{"_3731":1583,"_31485":1361,"_21804":56238,"_5":15036,"_28646":55658,"_3122":56239},[],"`Active`",{"_3731":1584,"_31485":1361,"_21804":56241,"_5":15036,"_28646":55658,"_3122":56242},[],"None",{"_3731":1585,"_31485":1361,"_21804":56244,"_5":15036,"_28646":55658,"_3122":56245},[],"`ACTIVE`",{"_3731":1586,"_31485":1361,"_21804":56247,"_5":15036,"_28646":55658,"_3122":56248},[],"`Revoked`",{"_3731":1587,"_31485":1361,"_21804":56250,"_5":15036,"_28646":55658,"_3122":56251},[],"`certificateHold`",{"_3731":1588,"_31485":1361,"_21804":56253,"_5":15036,"_28646":55658,"_3122":56254},[],"`INACTIVE`",{"_3731":1589,"_31485":1361,"_21804":56256,"_5":15036,"_28646":55658,"_3122":56248},[],{"_3731":1590,"_31485":1361,"_21804":56258,"_5":15036,"_28646":55658,"_3122":56259},[],"Any other reason",{"_3731":1591,"_31485":1361,"_21804":56261,"_5":15036,"_28646":55658,"_3122":56262},[],"`REVOKED`",{"_3731":1592,"_31485":1361,"_21804":56264,"_5":15036,"_28646":55658,"_3122":56265},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3731":1593,"_31485":1361,"_21804":56267,"_5":15036,"_28646":55662,"_3122":56268},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3731":1594,"_31485":1361,"_21804":56270,"_5":15036,"_28646":55662,"_3122":56043},[],{"_3731":1595,"_31485":1361,"_21804":56272,"_5":15036,"_28646":55662,"_3122":56046},[],{"_3731":1596,"_31485":1361,"_21804":56274,"_5":15036,"_28646":55662,"_3122":56275},[],"`NotSynced` → `Active`",{"_3731":1597,"_31485":1361,"_21804":56277,"_5":15036,"_28646":55662,"_3122":55754},[],{"_3731":1598,"_31485":1361,"_21804":56279,"_5":15036,"_28646":55662,"_3122":56280},[],"`Active` → `Inactive`",{"_3731":1599,"_31485":1361,"_21804":56282,"_5":15036,"_28646":55662,"_3122":56283},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3731":1600,"_31485":1361,"_21804":56285,"_5":15036,"_28646":55662,"_3122":56286},[],"`Active` → `Revoked`",{"_3731":1601,"_31485":1361,"_21804":56288,"_5":15036,"_28646":55662,"_3122":56283},[],{"_3731":1602,"_31485":1361,"_21804":56290,"_5":15036,"_28646":55662,"_3122":56291},[],"`Inactive` / `Revoked` → `Active`",{"_3731":1603,"_31485":1361,"_21804":56293,"_5":15036,"_28646":55662,"_3122":55754},[],{"_3731":1604,"_31485":1361,"_21804":56295,"_5":15036,"_28646":55662,"_3122":56296},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3731":1605,"_31485":1361,"_21804":56298,"_5":15036,"_28646":55662,"_3122":56299},[],"none (these states are not synced to AWS)",{"_3731":1606,"_31485":1361,"_21804":56301,"_5":15036,"_28646":55666,"_3122":56302},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3731":1607,"_31485":1361,"_21804":56304,"_5":15036,"_28646":55666,"_3122":56305},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3731":1608,"_31485":1361,"_21804":56307,"_5":15036,"_28646":55666,"_3122":56308},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3731":1609,"_31485":1361,"_21804":56310,"_5":15036,"_28646":55670,"_3122":56311},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3731":1610,"_31485":1361,"_21804":56313,"_5":15036,"_28646":55670,"_3122":56314},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3731":1611,"_31485":1361,"_21804":56316,"_5":15036,"_28646":55674,"_3122":56317},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3731":1612,"_31485":1361,"_21804":56319,"_5":15036,"_28646":55674,"_3122":56320},[],"There are two action types:",{"_3731":1613,"_31485":1361,"_21804":56322,"_5":15036,"_28646":55674,"_3122":56323},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3731":1614,"_31485":1361,"_21804":56325,"_5":15036,"_28646":55674,"_3122":56326},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3731":1615,"_31485":1361,"_21804":56328,"_5":15036,"_28646":55674,"_3122":56329},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3731":1616,"_31485":1361,"_21804":56331,"_5":15036,"_28646":55678,"_3122":56332},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3731":1617,"_31485":1361,"_21804":56334,"_5":15036,"_28646":55678,"_3122":56335},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3731":1618,"_31485":1361,"_21804":56337,"_5":15036,"_28646":55678,"_3122":56338},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3731":1619,"_31485":1361,"_21804":56340,"_5":15036,"_28646":55682,"_3122":56341},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3731":1620,"_31485":1361,"_21804":56343,"_5":15036,"_28646":55682,"_3122":56344},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3731":1621,"_31485":1361,"_21804":56346,"_5":15036,"_28646":55682,"_3122":56347},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3731":1622,"_31485":1361,"_21804":56349,"_5":15036,"_28646":55682,"_3122":56350},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3731":1623,"_31485":1361,"_21804":56352,"_5":15036,"_28646":55682,"_3122":56353},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3731":1624,"_31485":1361,"_21804":56355,"_5":15036,"_28646":55682,"_3122":56356},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3731":1625,"_31485":1361,"_21804":56358,"_5":15036,"_28646":55682,"_3122":56359},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3731":1626,"_31485":1361,"_21804":56361,"_5":15036,"_28646":55682,"_3122":56362},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3731":1627,"_31485":1361,"_21804":56364,"_5":15036,"_28646":55682,"_3122":56365},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3731":1628,"_31485":1361,"_21804":56367,"_5":15036,"_28646":55682,"_3122":56368},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3731":1629,"_31485":1361,"_21804":56370,"_5":15036,"_28646":55682,"_3122":56371},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3731":1630,"_31485":1361,"_21804":56373,"_5":15036,"_28646":55682,"_3122":56374},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3731":1631,"_31485":1361,"_21804":56376,"_5":15036,"_28646":55682,"_3122":56377},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3731":1632,"_31485":1361,"_21804":56379,"_5":15036,"_28646":55682,"_3122":56380},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3731":1633,"_31485":1361,"_21804":56382,"_5":15036,"_28646":55682,"_3122":56383},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3731":1634,"_31485":1361,"_21804":56385,"_5":15036,"_28646":55682,"_3122":56386},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3731":1635,"_31485":1361,"_21804":56388,"_5":15036,"_28646":55682,"_3122":56389},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3731":1636,"_31485":1361,"_21804":56391,"_5":15036,"_28646":55682,"_3122":56392},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3731":1637,"_31485":1361,"_21804":56394,"_5":15036,"_28646":55682,"_3122":56395},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3731":1638,"_31485":1361,"_21804":56397,"_5":15036,"_28646":55682,"_3122":56398},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3731":1639,"_31485":1361,"_21804":56400,"_5":15036,"_28646":55682,"_3122":56401},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3731":1640,"_31485":1361,"_21804":56403,"_5":15036,"_28646":55682,"_3122":56404},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3731":1641,"_31485":1361,"_21804":56406,"_5":15036,"_28646":55682,"_3122":56407},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/est\" />",{"_3731":1642,"_31485":1361,"_21804":56409,"_5":15036,"_28646":55682,"_3122":56410},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3731":1643,"_31485":1643,"_5":15390,"_3122":54083,"_31812":56412,"_21804":56413,"_28646":1643},[51373,52911,54083],[],{"_3731":1644,"_31485":1643,"_21804":56415,"_5":15036,"_28646":1643,"_3122":56416},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3731":1645,"_31485":1643,"_5":31809,"_21804":56418,"_28646":56419,"_3122":56420},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3731":1646,"_31485":1643,"_5":31809,"_21804":56422,"_28646":56423,"_3122":54081},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3731":1647,"_31485":1643,"_5":31809,"_21804":56425,"_28646":56426,"_3122":54267},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3731":1648,"_31485":1643,"_5":31809,"_21804":56428,"_28646":56429,"_3122":55579},[],"/docs/platform/iot-fleets/overview#integrations",{"_3731":1649,"_31485":1643,"_5":31809,"_21804":56431,"_28646":56432,"_3122":56433},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3731":1650,"_31485":1643,"_21804":56435,"_5":15036,"_28646":1643,"_3122":56436},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3731":1651,"_31485":1643,"_21804":56438,"_5":15036,"_28646":56419,"_3122":56439},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3731":1652,"_31485":1643,"_21804":56441,"_5":15036,"_28646":56419,"_3122":56442},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3731":1653,"_31485":1643,"_21804":56444,"_5":15036,"_28646":56423,"_3122":56445},[],"Resource",{"_3731":1654,"_31485":1643,"_21804":56447,"_5":15036,"_28646":56423,"_3122":56448},[],"What it represents",{"_3731":1655,"_31485":1643,"_21804":56450,"_5":15036,"_28646":56423,"_3122":56451},[],"**Device**",{"_3731":1656,"_31485":1643,"_21804":56453,"_5":15036,"_28646":56423,"_3122":56454},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3731":1657,"_31485":1643,"_21804":56456,"_5":15036,"_28646":56423,"_3122":56457},[],"**Identity**",{"_3731":1658,"_31485":1643,"_21804":56459,"_5":15036,"_28646":56423,"_3122":56460},[],"The device's association with its certificates: an active version and a history.",{"_3731":1659,"_31485":1643,"_21804":56462,"_5":15036,"_28646":56423,"_3122":56463},[],"**DMS**",{"_3731":1660,"_31485":1643,"_21804":56465,"_5":15036,"_28646":56423,"_3122":56466},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3731":1661,"_31485":1643,"_21804":56468,"_5":15036,"_28646":56423,"_3122":56469},[],"**Fleet**",{"_3731":1662,"_31485":1643,"_21804":56471,"_5":15036,"_28646":56423,"_3122":56472},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3731":1663,"_31485":1643,"_21804":56474,"_5":15036,"_28646":56423,"_3122":56475},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3731":1664,"_31485":1643,"_21804":56477,"_5":15036,"_28646":56423,"_3122":56478},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3731":1665,"_31485":1643,"_21804":56480,"_5":15036,"_28646":56426,"_3122":56481},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3731":1666,"_31485":1643,"_21804":56483,"_5":15036,"_28646":56426,"_3122":56484},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3731":1667,"_31485":1643,"_21804":56486,"_5":15036,"_28646":56426,"_3122":56487},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3731":1668,"_31485":1643,"_21804":56489,"_5":15036,"_28646":56426,"_3122":56490},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3731":1669,"_31485":1643,"_21804":56492,"_5":15036,"_28646":56426,"_3122":56493},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3731":1670,"_31485":1643,"_21804":56495,"_5":15036,"_28646":56426,"_3122":56496},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3731":1671,"_31485":1643,"_21804":56498,"_5":15036,"_28646":56426,"_3122":56499},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3731":1672,"_31485":1643,"_21804":56501,"_5":15036,"_28646":56426,"_3122":56502},[],"<Card title=\"EST (RFC 7030)\" description=\"Find the guides for authentication, client integration and renewal.\" href=\"/docs/platform/iot-fleets/est\" />",{"_3731":1673,"_31485":1643,"_21804":56504,"_5":15036,"_28646":56429,"_3122":56505},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3731":1674,"_31485":1643,"_21804":56507,"_5":15036,"_28646":56429,"_3122":56508},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3731":1675,"_31485":1643,"_21804":56510,"_5":15036,"_28646":56432,"_3122":56511},[],"Participant",{"_3731":1676,"_31485":1643,"_21804":56513,"_5":15036,"_28646":56432,"_3122":56514},[],"Responsibility",{"_3731":1677,"_31485":1643,"_21804":56516,"_5":15036,"_28646":56432,"_3122":56517},[],"PKI administrator",{"_3731":1678,"_31485":1643,"_21804":56519,"_5":15036,"_28646":56432,"_3122":56520},[],"CA, issuance profile, chain and revocation publication.",{"_3731":1679,"_31485":1643,"_21804":56522,"_5":15036,"_28646":56432,"_3122":56523},[],"Provisioning administrator",{"_3731":1680,"_31485":1643,"_21804":56525,"_5":15036,"_28646":56432,"_3122":56526},[],"DMS, admission, authentication per operation and inventory.",{"_3731":1681,"_31485":1643,"_21804":56528,"_5":15036,"_28646":56432,"_3122":56529},[],"Device integrator",{"_3731":1682,"_31485":1643,"_21804":56531,"_5":15036,"_28646":56432,"_3122":56532},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3731":1683,"_31485":1643,"_21804":56534,"_5":15036,"_28646":56432,"_3122":56535},[],"Consumer integrator",{"_3731":1684,"_31485":1643,"_21804":56537,"_5":15036,"_28646":56432,"_3122":56538},[],"Trusted issuers, validation and device permissions in the destination.",{"_3731":1685,"_31485":1643,"_21804":56540,"_5":15036,"_28646":56432,"_3122":56541},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3731":1686,"_31485":1686,"_5":15390,"_3122":56543,"_31812":56544,"_21804":56546,"_28646":1686},"Enroll and connect your first device",[51373,52911,54083,56545],"Getting started",[],{"_3731":1687,"_31485":1686,"_21804":56548,"_5":15036,"_28646":1686,"_3122":56549},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3731":1688,"_31485":1686,"_5":31809,"_21804":56551,"_28646":56552,"_3122":51383},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3731":1689,"_31485":1686,"_5":31809,"_21804":56554,"_28646":56555,"_3122":56556},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3731":1690,"_31485":1686,"_5":31809,"_21804":56558,"_28646":56559,"_3122":56560},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3731":1691,"_31485":1686,"_5":31809,"_21804":56562,"_28646":56563,"_3122":56564},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3731":1692,"_31485":1686,"_5":31809,"_21804":56566,"_28646":56567,"_3122":56568},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3731":1693,"_31485":1686,"_5":31809,"_21804":56570,"_28646":56571,"_3122":56572},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3731":1694,"_31485":1686,"_5":31809,"_21804":56574,"_28646":56575,"_3122":56576},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3731":1695,"_31485":1686,"_5":31809,"_21804":56578,"_28646":56579,"_3122":56580},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3731":1696,"_31485":1686,"_21804":56582,"_5":15036,"_28646":1686,"_3122":56583},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3731":1697,"_31485":1686,"_21804":56585,"_5":15036,"_28646":56552,"_3122":56586},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3731":1698,"_31485":1686,"_21804":56588,"_5":15036,"_28646":56552,"_3122":56589},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3731":1699,"_31485":1686,"_21804":56591,"_5":15036,"_28646":56552,"_3122":56592},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3731":1700,"_31485":1686,"_21804":56594,"_5":15036,"_28646":56552,"_3122":56595},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3731":1701,"_31485":1686,"_21804":56597,"_5":15036,"_28646":56552,"_3122":56598},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3731":1702,"_31485":1686,"_21804":56600,"_5":15036,"_28646":56555,"_3122":56601},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3731":1703,"_31485":1686,"_21804":56603,"_5":15036,"_28646":56555,"_3122":56604},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3731":1704,"_31485":1686,"_21804":56606,"_5":15036,"_28646":56559,"_3122":56607},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3731":1705,"_31485":1686,"_21804":56609,"_5":15036,"_28646":56559,"_3122":56610},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3731":1706,"_31485":1686,"_21804":56612,"_5":15036,"_28646":56559,"_3122":56613},[],"Setting",{"_3731":1707,"_31485":1686,"_21804":56615,"_5":15036,"_28646":56559,"_3122":56616},[],"Evaluation value",{"_3731":1708,"_31485":1686,"_21804":56618,"_5":15036,"_28646":56559,"_3122":56619},[],"Enrollment CA",{"_3731":1709,"_31485":1686,"_21804":56621,"_5":15036,"_28646":56559,"_3122":56622},[],"Issuing root from `device-root.pem`.",{"_3731":1710,"_31485":1686,"_21804":56624,"_5":15036,"_28646":56559,"_3122":56625},[],"Issuance profile",{"_3731":1711,"_31485":1686,"_21804":56627,"_5":15036,"_28646":56559,"_3122":56628},[],"The 1-hour leaf profile you just prepared.",{"_3731":1712,"_31485":1686,"_21804":56630,"_5":15036,"_28646":56559,"_3122":56631},[],"Protocol / Registration Mode",{"_3731":1713,"_31485":1686,"_21804":56633,"_5":15036,"_28646":56559,"_3122":56634},[],"`EST_RFC7030` / `JITP`.",{"_3731":1714,"_31485":1686,"_21804":56636,"_5":15036,"_28646":56559,"_3122":56637},[],"Verify CSR Signature",{"_3731":1715,"_31485":1686,"_21804":56639,"_5":15036,"_28646":56559,"_3122":56640},[],"Enabled.",{"_3731":1716,"_31485":1686,"_21804":56642,"_5":15036,"_28646":56559,"_3122":56643},[],"Enable Replaceable Enrollment",{"_3731":1717,"_31485":1686,"_21804":56645,"_5":15036,"_28646":56559,"_3122":56646},[],"Disabled; the ID must be new.",{"_3731":1718,"_31485":1686,"_21804":56648,"_5":15036,"_28646":56559,"_3122":56649},[],"Initial authentication",{"_3731":1719,"_31485":1686,"_21804":56651,"_5":15036,"_28646":56559,"_3122":56652},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3731":1720,"_31485":1686,"_21804":56654,"_5":15036,"_28646":56559,"_3122":56655},[],"Renewal authentication",{"_3731":1721,"_31485":1686,"_21804":56657,"_5":15036,"_28646":56559,"_3122":56658},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3731":1722,"_31485":1686,"_21804":56660,"_5":15036,"_28646":56559,"_3122":56661},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3731":1723,"_31485":1686,"_21804":56663,"_5":15036,"_28646":56559,"_3122":56664},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3731":1724,"_31485":1686,"_21804":56666,"_5":15036,"_28646":56559,"_3122":56667},[],"Re-enrollment Delta",{"_3731":1725,"_31485":1686,"_21804":56669,"_5":15036,"_28646":56559,"_3122":56670},[],"1 hour.",{"_3731":1726,"_31485":1686,"_21804":56672,"_5":15036,"_28646":56559,"_3122":56673},[],"Preventive / Critical Delta",{"_3731":1727,"_31485":1686,"_21804":56675,"_5":15036,"_28646":56559,"_3122":56676},[],"30 minutes / 10 minutes.",{"_3731":1728,"_31485":1686,"_21804":56678,"_5":15036,"_28646":56559,"_3122":56679},[],"Revoke on Re-enrollment",{"_3731":1729,"_31485":1686,"_21804":56681,"_5":15036,"_28646":56559,"_3122":56682},[],"Disabled to test the successor before retiring the previous identity.",{"_3731":1730,"_31485":1686,"_21804":56684,"_5":15036,"_28646":56559,"_3122":54519},[],{"_3731":1731,"_31485":1686,"_21804":56686,"_5":15036,"_28646":56559,"_3122":56687},[],"Disabled; the operational key is generated in the client.",{"_3731":1732,"_31485":1686,"_21804":56689,"_5":15036,"_28646":56559,"_3122":56690},[],"CA Distribution",{"_3731":1733,"_31485":1686,"_21804":56692,"_5":15036,"_28646":56559,"_3122":56693},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3731":1734,"_31485":1686,"_21804":56695,"_5":15036,"_28646":56559,"_3122":56696},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3731":1735,"_31485":1686,"_21804":56698,"_5":15036,"_28646":56563,"_3122":56699},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3731":1736,"_31485":1686,"_21804":56701,"_5":15036,"_28646":56563,"_3122":56702},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3731":1737,"_31485":1686,"_21804":56704,"_5":15036,"_28646":56567,"_3122":56705},[],"Generate a new key and CSR with the selected identifier:",{"_3731":1738,"_31485":1686,"_21804":56707,"_5":15036,"_28646":56567,"_3122":56708},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3731":1739,"_31485":1686,"_21804":56710,"_5":15036,"_28646":56567,"_3122":56711},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3731":1740,"_31485":1686,"_21804":56713,"_5":15036,"_28646":56571,"_3122":56714},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3731":1741,"_31485":1686,"_21804":56716,"_5":15036,"_28646":56571,"_3122":56717},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3731":1742,"_31485":1686,"_21804":56719,"_5":15036,"_28646":56575,"_3122":56720},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3731":1743,"_31485":1686,"_21804":56722,"_5":15036,"_28646":56575,"_3122":56723},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3731":1744,"_31485":1686,"_21804":56725,"_5":15036,"_28646":56575,"_3122":56726},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3731":1745,"_31485":1686,"_21804":56728,"_5":15036,"_28646":56575,"_3122":56729},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3731":1746,"_31485":1686,"_21804":56731,"_5":15036,"_28646":56575,"_3122":56732},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3731":1747,"_31485":1686,"_21804":56734,"_5":15036,"_28646":56579,"_3122":56735},[],"Check",{"_3731":1748,"_31485":1686,"_21804":56737,"_5":15036,"_28646":56579,"_3122":56738},[],"Expected result",{"_3731":1749,"_31485":1686,"_21804":56740,"_5":15036,"_28646":56579,"_3122":56741},[],"Registration",{"_3731":1750,"_31485":1686,"_21804":56743,"_5":15036,"_28646":56579,"_3122":56744},[],"ID created automatically and correct DMS.",{"_3731":1751,"_31485":1686,"_21804":56746,"_5":15036,"_28646":56579,"_3122":56001},[],{"_3731":1752,"_31485":1686,"_21804":56748,"_5":15036,"_28646":56579,"_3122":56749},[],"CN, profile, serial and key verified.",{"_3731":1753,"_31485":1686,"_21804":56751,"_5":15036,"_28646":56579,"_3122":56752},[],"Inventory",{"_3731":1754,"_31485":1686,"_21804":56754,"_5":15036,"_28646":56579,"_3122":56755},[],"Received serial visible as the current identity and in history.",{"_3731":1755,"_31485":1686,"_21804":56757,"_5":15036,"_28646":56579,"_3122":56758},[],"Consumer",{"_3731":1756,"_31485":1686,"_21804":56760,"_5":15036,"_28646":56579,"_3122":56761},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3731":1757,"_31485":1686,"_21804":56763,"_5":15036,"_28646":56579,"_3122":56764},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3731":1758,"_31485":1686,"_21804":56766,"_5":15036,"_28646":56579,"_3122":56767},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3731":1759,"_31485":1759,"_5":15390,"_3122":54099,"_31812":56769,"_21804":56770,"_28646":1759},[51373,52911,54083,56545],[],{"_3731":1760,"_31485":1759,"_21804":56772,"_5":15036,"_28646":1759,"_3122":56773},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3731":1761,"_31485":1759,"_5":31809,"_21804":56775,"_28646":56776,"_3122":51383},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3731":1762,"_31485":1759,"_5":31809,"_21804":56778,"_28646":56779,"_3122":56780},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3731":1763,"_31485":1759,"_5":31809,"_21804":56782,"_28646":56783,"_3122":56784},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3731":1764,"_31485":1759,"_5":31809,"_21804":56786,"_28646":56787,"_3122":56788},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3731":1765,"_31485":1759,"_5":31809,"_21804":56790,"_28646":56791,"_3122":56792},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3731":1766,"_31485":1759,"_5":31809,"_21804":56794,"_28646":56795,"_3122":56796},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3731":1767,"_31485":1759,"_5":31809,"_21804":56798,"_28646":56799,"_3122":56738},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3731":1768,"_31485":1759,"_5":31809,"_21804":56801,"_28646":56802,"_3122":56803},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3731":1769,"_31485":1759,"_5":31809,"_21804":56805,"_28646":56806,"_3122":56807},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3731":1770,"_31485":1759,"_21804":56809,"_5":15036,"_28646":1759,"_3122":56810},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3731":1771,"_31485":1759,"_21804":56812,"_5":15036,"_28646":1759,"_3122":56813},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3731":1772,"_31485":1759,"_21804":56815,"_5":15036,"_28646":56776,"_3122":56816},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3731":1773,"_31485":1759,"_21804":56818,"_5":15036,"_28646":56776,"_3122":56819},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3731":1774,"_31485":1759,"_21804":56821,"_5":15036,"_28646":56776,"_3122":56822},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3731":1775,"_31485":1759,"_21804":56824,"_5":15036,"_28646":56776,"_3122":56825},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3731":1776,"_31485":1759,"_21804":56827,"_5":15036,"_28646":56779,"_3122":56828},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3731":1777,"_31485":1759,"_21804":56830,"_5":15036,"_28646":56779,"_3122":56831},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3731":1778,"_31485":1759,"_21804":56833,"_5":15036,"_28646":56779,"_3122":56834},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3731":1779,"_31485":1759,"_21804":56836,"_5":15036,"_28646":56779,"_3122":56837},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3731":1780,"_31485":1759,"_21804":56839,"_5":15036,"_28646":56779,"_3122":56840},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3731":1781,"_31485":1759,"_21804":56842,"_5":15036,"_28646":56779,"_3122":56843},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3731":1782,"_31485":1759,"_21804":56845,"_5":15036,"_28646":56779,"_3122":56846},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3731":1783,"_31485":1759,"_21804":56848,"_5":15036,"_28646":56779,"_3122":56849},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3731":1784,"_31485":1759,"_21804":56851,"_5":15036,"_28646":56783,"_3122":56852},[],"Open **Managed Devices** and the registration action. Complete:",{"_3731":1785,"_31485":1759,"_21804":56854,"_5":15036,"_28646":56783,"_3122":56855},[],"**Device ID**: `device-001`.",{"_3731":1786,"_31485":1759,"_21804":56857,"_5":15036,"_28646":56783,"_3122":56858},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3731":1787,"_31485":1759,"_21804":56860,"_5":15036,"_28646":56783,"_3122":56861},[],"**Icon** and **Tags**: optional classification.",{"_3731":1788,"_31485":1759,"_21804":56863,"_5":15036,"_28646":56783,"_3122":56864},[],"Confirm registration.",{"_3731":1789,"_31485":1759,"_21804":56866,"_5":15036,"_28646":56787,"_3122":56867},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3731":1790,"_31485":1759,"_21804":56869,"_5":15036,"_28646":56787,"_3122":56870},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3731":1791,"_31485":1759,"_21804":56872,"_5":15036,"_28646":56791,"_3122":56873},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3731":1792,"_31485":1759,"_21804":56875,"_5":15036,"_28646":56791,"_3122":56876},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3731":1793,"_31485":1759,"_21804":56878,"_5":15036,"_28646":56795,"_3122":56879},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3731":1794,"_31485":1759,"_21804":56881,"_5":15036,"_28646":56795,"_3122":56882},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3731":1795,"_31485":1759,"_21804":56884,"_5":15036,"_28646":56799,"_3122":56735},[],{"_3731":1796,"_31485":1759,"_21804":56886,"_5":15036,"_28646":56799,"_3122":56887},[],"Result",{"_3731":1797,"_31485":1759,"_21804":56889,"_5":15036,"_28646":56799,"_3122":55984},[],{"_3731":1798,"_31485":1759,"_21804":56891,"_5":15036,"_28646":56799,"_3122":56892},[],"`device-001` appears in inventory with the expected DMS.",{"_3731":1799,"_31485":1759,"_21804":56894,"_5":15036,"_28646":56799,"_3122":56895},[],"Current identity",{"_3731":1800,"_31485":1759,"_21804":56897,"_5":15036,"_28646":56799,"_3122":56898},[],"The associated certificate matches the one you verified in PKI.",{"_3731":1801,"_31485":1759,"_21804":56900,"_5":15036,"_28646":56799,"_3122":56901},[],"History",{"_3731":1802,"_31485":1759,"_21804":56903,"_5":15036,"_28646":56799,"_3122":56904},[],"The associated issuance appears with its serial number and dates.",{"_3731":1803,"_31485":1759,"_21804":56906,"_5":15036,"_28646":56799,"_3122":56907},[],"Key and certificate",{"_3731":1804,"_31485":1759,"_21804":56909,"_5":15036,"_28646":56799,"_3122":56910},[],"You have the verified pair ready to install on the device.",{"_3731":1805,"_31485":1759,"_21804":56912,"_5":15036,"_28646":56802,"_3122":56913},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3731":1806,"_31485":1759,"_21804":56915,"_5":15036,"_28646":56802,"_3122":56916},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3731":1807,"_31485":1759,"_21804":56918,"_5":15036,"_28646":56802,"_3122":56919},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3731":1808,"_31485":1759,"_21804":56921,"_5":15036,"_28646":56802,"_3122":56922},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3731":1809,"_31485":1759,"_21804":56924,"_5":15036,"_28646":56806,"_3122":56925},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3731":1810,"_31485":1759,"_21804":56927,"_5":15036,"_28646":56806,"_3122":56928},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3731":1811,"_31485":1759,"_21804":56930,"_5":15036,"_28646":56806,"_3122":56931},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3731":1812,"_31485":1812,"_5":15390,"_3122":56933,"_31812":56934,"_21804":56935,"_28646":1812},"Lamassu IoT Platform",[51373,52911],[],{"_3731":1813,"_31485":1812,"_21804":56937,"_5":15036,"_28646":1812,"_3122":56938},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3731":1814,"_31485":1812,"_5":31809,"_21804":56940,"_28646":56941,"_3122":56420},[],"/docs/platform/overview#start-here",{"_3731":1815,"_31485":1812,"_5":31809,"_21804":56943,"_28646":56944,"_3122":56945},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3731":1816,"_31485":1812,"_5":31809,"_21804":56947,"_28646":56948,"_3122":56949},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3731":1817,"_31485":1812,"_5":31809,"_21804":56951,"_28646":56952,"_3122":56953},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3731":1818,"_31485":1812,"_5":31809,"_21804":56955,"_28646":56956,"_3122":56957},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3731":1819,"_31485":1812,"_5":31809,"_21804":56959,"_28646":56960,"_3122":56961},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3731":1820,"_31485":1812,"_5":31809,"_21804":56963,"_28646":56964,"_3122":56965},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3731":1821,"_31485":1812,"_5":31809,"_21804":56967,"_28646":56968,"_3122":56969},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3731":1822,"_31485":1812,"_5":31809,"_21804":56971,"_28646":56972,"_3122":56973},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3731":1823,"_31485":1812,"_5":31809,"_21804":56975,"_28646":56976,"_3122":56977},[],"/docs/platform/overview#react-to-events","React to events",{"_3731":1824,"_31485":1812,"_5":31809,"_21804":56979,"_28646":56980,"_3122":56981},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3731":1825,"_31485":1812,"_21804":56983,"_5":15036,"_28646":1812,"_3122":56984},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3731":1826,"_31485":1812,"_21804":56986,"_5":15036,"_28646":56941,"_3122":56987},[],"Choose the result you need:",{"_3731":1827,"_31485":1812,"_21804":56989,"_5":15036,"_28646":56941,"_3122":56990},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3731":1828,"_31485":1812,"_21804":56992,"_5":15036,"_28646":56941,"_3122":56993},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3731":1829,"_31485":1812,"_21804":56995,"_5":15036,"_28646":56941,"_3122":56996},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3731":1830,"_31485":1812,"_21804":56998,"_5":15036,"_28646":56944,"_3122":56999},[],"Section",{"_3731":1831,"_31485":1812,"_21804":57001,"_5":15036,"_28646":56944,"_3122":57002},[],"What you manage",{"_3731":1832,"_31485":1812,"_21804":57004,"_5":15036,"_28646":56944,"_3122":57005},[],"Entry point",{"_3731":1833,"_31485":1812,"_21804":57007,"_5":15036,"_28646":56944,"_3122":57008},[],"**PKI**",{"_3731":1834,"_31485":1812,"_21804":57010,"_5":15036,"_28646":56944,"_3122":57011},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3731":1835,"_31485":1812,"_21804":57013,"_5":15036,"_28646":56944,"_3122":57014},[],"PKI overview",{"_3731":1836,"_31485":1812,"_21804":57016,"_5":15036,"_28646":56944,"_3122":57017},[],"**IoT Fleets**",{"_3731":1837,"_31485":1812,"_21804":57019,"_5":15036,"_28646":56944,"_3122":57020},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3731":1838,"_31485":1812,"_21804":57022,"_5":15036,"_28646":56944,"_3122":57023},[],"IoT Fleets overview",{"_3731":1839,"_31485":1812,"_21804":57025,"_5":15036,"_28646":56944,"_3122":57026},[],"**Administration**",{"_3731":1840,"_31485":1812,"_21804":57028,"_5":15036,"_28646":56944,"_3122":57029},[],"Operator permissions, audit and event subscriptions.",{"_3731":1841,"_31485":1812,"_21804":57031,"_5":15036,"_28646":56944,"_3122":52913},[],{"_3731":1842,"_31485":1812,"_21804":57033,"_5":15036,"_28646":56944,"_3122":57034},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3731":1843,"_31485":1812,"_21804":57036,"_5":15036,"_28646":56948,"_3122":57037},[],"An identity's journey connects four responsibilities:",{"_3731":1844,"_31485":1812,"_21804":57039,"_5":15036,"_28646":56948,"_3122":57040},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3731":1845,"_31485":1812,"_21804":57042,"_5":15036,"_28646":56948,"_3122":57043},[],"The provisioning administrator configures the DMS and initial trust.",{"_3731":1846,"_31485":1812,"_21804":57045,"_5":15036,"_28646":56948,"_3122":57046},[],"The device client requests a certificate and installs it with the matching key.",{"_3731":1847,"_31485":1812,"_21804":57048,"_5":15036,"_28646":56948,"_3122":57049},[],"The consumer validates the identity and applies its access permissions.",{"_3731":1848,"_31485":1812,"_21804":57051,"_5":15036,"_28646":56948,"_3122":57052},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3731":1849,"_31485":1812,"_21804":57054,"_5":15036,"_28646":56956,"_3122":57055},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3731":1850,"_31485":1812,"_21804":57057,"_5":15036,"_28646":56960,"_3122":57058},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3731":1851,"_31485":1812,"_21804":57060,"_5":15036,"_28646":56964,"_3122":57061},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3731":1852,"_31485":1812,"_21804":57063,"_5":15036,"_28646":56968,"_3122":57064},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3731":1853,"_31485":1812,"_21804":57066,"_5":15036,"_28646":56972,"_3122":57067},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3731":1854,"_31485":1812,"_21804":57069,"_5":15036,"_28646":56976,"_3122":57070},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3731":1855,"_31485":1812,"_21804":57072,"_5":15036,"_28646":56980,"_3122":56514},[],{"_3731":1856,"_31485":1812,"_21804":57074,"_5":15036,"_28646":56980,"_3122":57075},[],"What it prepares or checks",{"_3731":1857,"_31485":1812,"_21804":57077,"_5":15036,"_28646":56980,"_3122":56517},[],{"_3731":1858,"_31485":1812,"_21804":57079,"_5":15036,"_28646":56980,"_3122":57080},[],"Key custody, CA hierarchy, profiles and validation.",{"_3731":1859,"_31485":1812,"_21804":57082,"_5":15036,"_28646":56980,"_3122":57083},[],"Fleet administrator",{"_3731":1860,"_31485":1812,"_21804":57085,"_5":15036,"_28646":56980,"_3122":57086},[],"DMS, device admission, renewal policy and inventory.",{"_3731":1861,"_31485":1812,"_21804":57088,"_5":15036,"_28646":56980,"_3122":56529},[],{"_3731":1862,"_31485":1812,"_21804":57090,"_5":15036,"_28646":56980,"_3122":57091},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3731":1863,"_31485":1812,"_21804":57093,"_5":15036,"_28646":56980,"_3122":56535},[],{"_3731":1864,"_31485":1812,"_21804":57095,"_5":15036,"_28646":56980,"_3122":57096},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3731":1865,"_31485":1812,"_21804":57098,"_5":15036,"_28646":56980,"_3122":57099},[],"Infrastructure operator",{"_3731":1866,"_31485":1812,"_21804":57101,"_5":15036,"_28646":56980,"_3122":57102},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3731":1867,"_31485":1812,"_21804":57104,"_5":15036,"_28646":56980,"_3122":57105},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3731":1868,"_31485":1868,"_5":15390,"_3122":57107,"_31812":57108,"_21804":57111,"_28646":1868},"CA hierarchy and rotation",[51373,52911,57109,57110],"PKI","Keys, authorities and certificates",[],{"_3731":1869,"_31485":1868,"_21804":57113,"_5":15036,"_28646":1868,"_3122":57114},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3731":1870,"_31485":1868,"_5":31809,"_21804":57116,"_28646":57117,"_3122":57118},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3731":1871,"_31485":1868,"_5":31809,"_21804":57120,"_28646":57121,"_3122":57122},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3731":1872,"_31485":1868,"_5":31809,"_21804":57124,"_28646":57125,"_3122":57126},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3731":1873,"_31485":1868,"_5":31809,"_21804":57128,"_28646":57129,"_3122":57130},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3731":1874,"_31485":1868,"_5":31809,"_21804":57132,"_28646":57133,"_3122":57134},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3731":1875,"_31485":1868,"_5":31809,"_21804":57136,"_28646":57137,"_3122":57138},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3731":1876,"_31485":1868,"_5":31809,"_21804":57140,"_28646":57141,"_3122":57142},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3731":1877,"_31485":1868,"_5":31809,"_21804":57144,"_28646":57145,"_3122":57146},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3731":1878,"_31485":1868,"_5":31809,"_21804":57148,"_28646":57149,"_3122":57150},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3731":1879,"_31485":1868,"_5":31809,"_21804":57152,"_28646":57153,"_3122":57154},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3731":1880,"_31485":1868,"_5":31809,"_21804":57156,"_28646":57157,"_3122":57158},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3731":1881,"_31485":1868,"_5":31809,"_21804":57160,"_28646":57161,"_3122":57162},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3731":1882,"_31485":1868,"_21804":57164,"_5":15036,"_28646":1868,"_3122":57165},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3731":1883,"_31485":1868,"_21804":57167,"_5":15036,"_28646":1868,"_3122":57168},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3731":1884,"_31485":1868,"_21804":57170,"_5":15036,"_28646":57117,"_3122":57171},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3731":1885,"_31485":1868,"_21804":57173,"_5":15036,"_28646":57117,"_3122":57174},[],"environment, such as production and preproduction;",{"_3731":1886,"_31485":1868,"_21804":57176,"_5":15036,"_28646":57117,"_3122":57177},[],"owner or operating team;",{"_3731":1887,"_31485":1868,"_21804":57179,"_5":15036,"_28646":57117,"_3122":57180},[],"device family or manufacturing process;",{"_3731":1888,"_31485":1868,"_21804":57182,"_5":15036,"_28646":57117,"_3122":57183},[],"region or regulatory requirement;",{"_3731":1889,"_31485":1868,"_21804":57185,"_5":15036,"_28646":57117,"_3122":57186},[],"cryptographic engine or key policy;",{"_3731":1890,"_31485":1868,"_21804":57188,"_5":15036,"_28646":57117,"_3122":57189},[],"maintenance window and renewal cadence.",{"_3731":1891,"_31485":1868,"_21804":57191,"_5":15036,"_28646":57117,"_3122":57192},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3731":1892,"_31485":1868,"_21804":57194,"_5":15036,"_28646":57117,"_3122":57195},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3731":1893,"_31485":1868,"_21804":57197,"_5":15036,"_28646":57121,"_3122":57198},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3731":1894,"_31485":1868,"_21804":57200,"_5":15036,"_28646":57121,"_3122":57201},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3731":1895,"_31485":1868,"_21804":57203,"_5":15036,"_28646":57121,"_3122":57204},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3731":1896,"_31485":1868,"_21804":57206,"_5":15036,"_28646":57121,"_3122":57207},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3731":1897,"_31485":1868,"_21804":57209,"_5":15036,"_28646":57125,"_3122":57210},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3731":1898,"_31485":1868,"_21804":57212,"_5":15036,"_28646":57125,"_3122":57213},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3731":1899,"_31485":1868,"_21804":57215,"_5":15036,"_28646":57125,"_3122":57216},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3731":1900,"_31485":1868,"_21804":57218,"_5":15036,"_28646":57125,"_3122":57219},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3731":1901,"_31485":1868,"_21804":57221,"_5":15036,"_28646":57133,"_3122":57222},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3731":1902,"_31485":1868,"_21804":57224,"_5":15036,"_28646":57137,"_3122":57225},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3731":1903,"_31485":1868,"_21804":57227,"_5":15036,"_28646":57141,"_3122":57228},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3731":1904,"_31485":1868,"_21804":57230,"_5":15036,"_28646":57145,"_3122":57231},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3731":1905,"_31485":1868,"_21804":57233,"_5":15036,"_28646":57149,"_3122":57234},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3731":1906,"_31485":1868,"_21804":57236,"_5":15036,"_28646":57153,"_3122":57237},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3731":1907,"_31485":1868,"_21804":57239,"_5":15036,"_28646":57157,"_3122":57240},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3731":1908,"_31485":1868,"_21804":57242,"_5":15036,"_28646":57157,"_3122":57243},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3731":1909,"_31485":1868,"_21804":57245,"_5":15036,"_28646":57157,"_3122":57246},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3731":1910,"_31485":1868,"_21804":57248,"_5":15036,"_28646":57157,"_3122":57249},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3731":1911,"_31485":1868,"_21804":57251,"_5":15036,"_28646":57161,"_3122":57252},[],"The new chain ends in an anchor installed by the consumer.",{"_3731":1912,"_31485":1868,"_21804":57254,"_5":15036,"_28646":57161,"_3122":57255},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3731":1913,"_31485":1868,"_21804":57257,"_5":15036,"_28646":57161,"_3122":57258},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3731":1914,"_31485":1868,"_21804":57260,"_5":15036,"_28646":57161,"_3122":57261},[],"Re-enrollment accepts the old identity during the planned period.",{"_3731":1915,"_31485":1868,"_21804":57263,"_5":15036,"_28646":57161,"_3122":57264},[],"OCSP and CRL respond for the authorities that remain active.",{"_3731":1916,"_31485":1868,"_21804":57266,"_5":15036,"_28646":57161,"_3122":57267},[],"No DMS is left accidentally issuing from the old CA.",{"_3731":1917,"_31485":1868,"_21804":57269,"_5":15036,"_28646":57161,"_3122":57270},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3731":1918,"_31485":1918,"_5":15390,"_3122":57272,"_31812":57273,"_21804":57274,"_28646":1918},"Certification authorities",[51373,52911,57109,57110],[],{"_3731":1919,"_31485":1918,"_21804":57276,"_5":15036,"_28646":1918,"_3122":57277},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3731":1920,"_31485":1918,"_5":31809,"_21804":57279,"_28646":57280,"_3122":57281},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3731":1921,"_31485":1918,"_5":31809,"_21804":57283,"_28646":57284,"_3122":57285},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3731":1922,"_31485":1918,"_5":31809,"_21804":57287,"_28646":57288,"_3122":51383},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3731":1923,"_31485":1918,"_5":31809,"_21804":57290,"_28646":57291,"_3122":57292},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3731":1924,"_31485":1918,"_5":31809,"_21804":57294,"_28646":57295,"_3122":57296},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3731":1925,"_31485":1918,"_5":31809,"_21804":57298,"_28646":57299,"_3122":57300},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3731":1926,"_31485":1918,"_5":31809,"_21804":57302,"_28646":57303,"_3122":57304},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3731":1927,"_31485":1918,"_5":31809,"_21804":57306,"_28646":57307,"_3122":57308},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3731":1928,"_31485":1918,"_5":31809,"_21804":57310,"_28646":57311,"_3122":57312},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3731":1929,"_31485":1918,"_5":31809,"_21804":57314,"_28646":57315,"_3122":57316},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3731":1930,"_31485":1918,"_5":31809,"_21804":57318,"_28646":57319,"_3122":57320},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3731":1931,"_31485":1918,"_5":31809,"_21804":57322,"_28646":57323,"_3122":57324},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3731":1932,"_31485":1918,"_5":31809,"_21804":57326,"_28646":57327,"_3122":57328},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3731":1933,"_31485":1918,"_5":31809,"_21804":57330,"_28646":57331,"_3122":57332},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3731":1934,"_31485":1918,"_5":31809,"_21804":57334,"_28646":57335,"_3122":57336},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3731":1935,"_31485":1918,"_5":31809,"_21804":57338,"_28646":57339,"_3122":57340},[],"/docs/platform/pki/certificate-authorities#ca-states","CA states",{"_3731":1936,"_31485":1918,"_5":31809,"_21804":57342,"_28646":57343,"_3122":57344},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3731":1937,"_31485":1918,"_5":31809,"_21804":57346,"_28646":57347,"_3122":57348},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3731":1938,"_31485":1918,"_5":31809,"_21804":57350,"_28646":57351,"_3122":57352},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3731":1939,"_31485":1918,"_5":31809,"_21804":57354,"_28646":57355,"_3122":57356},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3731":1940,"_31485":1918,"_5":31809,"_21804":57358,"_28646":57359,"_3122":57360},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3731":1941,"_31485":1918,"_5":31809,"_21804":57362,"_28646":57363,"_3122":57364},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3731":1942,"_31485":1918,"_5":31809,"_21804":57366,"_28646":57367,"_3122":57368},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3731":1943,"_31485":1918,"_5":31809,"_21804":57370,"_28646":57371,"_3122":57372},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3731":1944,"_31485":1918,"_21804":57374,"_5":15036,"_28646":1918,"_3122":57375},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3731":1945,"_31485":1918,"_21804":57377,"_5":15036,"_28646":1918,"_3122":57378},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3731":1946,"_31485":1918,"_21804":57380,"_5":15036,"_28646":1918,"_3122":57381},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3731":1947,"_31485":1918,"_21804":57383,"_5":15036,"_28646":57280,"_3122":57384},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3731":1948,"_31485":1918,"_21804":57386,"_5":15036,"_28646":57280,"_3122":57387},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3731":1949,"_31485":1918,"_21804":57389,"_5":15036,"_28646":57280,"_3122":57390},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3731":1950,"_31485":1918,"_21804":57392,"_5":15036,"_28646":57280,"_3122":57393},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3731":1951,"_31485":1918,"_21804":57395,"_5":15036,"_28646":57280,"_3122":57396},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3731":1952,"_31485":1918,"_21804":57398,"_5":15036,"_28646":57288,"_3122":57399},[],"Decide whether the CA will be a root or an intermediate.",{"_3731":1953,"_31485":1918,"_21804":57401,"_5":15036,"_28646":57288,"_3122":57402},[],"Choose the engine that will keep the key.",{"_3731":1954,"_31485":1918,"_21804":57404,"_5":15036,"_28646":57288,"_3122":57405},[],"Define a validity longer than that of the certificates it will issue.",{"_3731":1955,"_31485":1918,"_21804":57407,"_5":15036,"_28646":57288,"_3122":57408},[],"For an intermediate CA, make sure the parent CA is active.",{"_3731":1956,"_31485":1918,"_21804":57410,"_5":15036,"_28646":57291,"_3122":57411},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3731":1957,"_31485":1918,"_21804":57413,"_5":15036,"_28646":57295,"_3122":57414},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3731":1958,"_31485":1918,"_21804":57416,"_5":15036,"_28646":57295,"_3122":57417},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3731":1959,"_31485":1918,"_21804":57419,"_5":15036,"_28646":57299,"_3122":57420},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3731":1960,"_31485":1918,"_21804":57422,"_5":15036,"_28646":57303,"_3122":57423},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3731":1961,"_31485":1918,"_21804":57425,"_5":15036,"_28646":57303,"_3122":57426},[],"`C`: two-letter ISO 3166-1 country code.",{"_3731":1962,"_31485":1918,"_21804":57428,"_5":15036,"_28646":57303,"_3122":57429},[],"`ST`: state or province.",{"_3731":1963,"_31485":1918,"_21804":57431,"_5":15036,"_28646":57303,"_3122":57432},[],"`L`: locality.",{"_3731":1964,"_31485":1918,"_21804":57434,"_5":15036,"_28646":57303,"_3122":57435},[],"`O`: organization.",{"_3731":1965,"_31485":1918,"_21804":57437,"_5":15036,"_28646":57303,"_3122":57438},[],"`OU`: organizational unit.",{"_3731":1966,"_31485":1918,"_21804":57440,"_5":15036,"_28646":57303,"_3122":57441},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3731":1967,"_31485":1918,"_21804":57443,"_5":15036,"_28646":57307,"_3122":57444},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3731":1968,"_31485":1918,"_21804":57446,"_5":15036,"_28646":57307,"_3122":57447},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3731":1969,"_31485":1918,"_21804":57449,"_5":15036,"_28646":57311,"_3122":57450},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3731":1970,"_31485":1918,"_21804":57452,"_5":15036,"_28646":57311,"_3122":57453},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3731":1971,"_31485":1918,"_21804":57455,"_5":15036,"_28646":57315,"_3122":57456},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3731":1972,"_31485":1918,"_21804":57458,"_5":15036,"_28646":57315,"_3122":57459},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3731":1973,"_31485":1918,"_21804":57461,"_5":15036,"_28646":57319,"_3122":57462},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3731":1974,"_31485":1918,"_21804":57464,"_5":15036,"_28646":57319,"_3122":57465},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3731":1975,"_31485":1918,"_21804":57467,"_5":15036,"_28646":57319,"_3122":57468},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3731":1976,"_31485":1918,"_21804":57470,"_5":15036,"_28646":57319,"_3122":57471},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3731":1977,"_31485":1918,"_21804":57473,"_5":15036,"_28646":57323,"_3122":57474},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3731":1978,"_31485":1918,"_21804":57476,"_5":15036,"_28646":57327,"_3122":57477},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3731":1979,"_31485":1918,"_21804":57479,"_5":15036,"_28646":57327,"_3122":57480},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3731":1980,"_31485":1918,"_21804":57482,"_5":15036,"_28646":57331,"_3122":57483},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3731":1981,"_31485":1918,"_21804":57485,"_5":15036,"_28646":57335,"_3122":57486},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3731":1982,"_31485":1918,"_21804":57488,"_5":15036,"_28646":57335,"_3122":57489},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3731":1983,"_31485":1918,"_21804":57491,"_5":15036,"_28646":57335,"_3122":57492},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3731":1984,"_31485":1918,"_21804":57494,"_5":15036,"_28646":57339,"_3122":57495},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3731":1985,"_31485":1918,"_21804":57497,"_5":15036,"_28646":57339,"_3122":57498},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3731":1986,"_31485":1918,"_21804":57500,"_5":15036,"_28646":57339,"_3122":57501},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3731":1987,"_31485":1918,"_21804":57503,"_5":15036,"_28646":57339,"_3122":57504},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3731":1988,"_31485":1918,"_21804":57506,"_5":15036,"_28646":57343,"_3122":57507},[],"Open a CA from the inventory to review:",{"_3731":1989,"_31485":1918,"_21804":57509,"_5":15036,"_28646":57343,"_3122":57510},[],"Status and validity period.",{"_3731":1990,"_31485":1918,"_21804":57512,"_5":15036,"_28646":57343,"_3122":57513},[],"Certificate and chain in PEM format.",{"_3731":1991,"_31485":1918,"_21804":57515,"_5":15036,"_28646":57343,"_3122":57516},[],"Number of active, expired and revoked certificates.",{"_3731":1992,"_31485":1918,"_21804":57518,"_5":15036,"_28646":57343,"_3122":57519},[],"Certificates issued in **Issued Certificates**.",{"_3731":1993,"_31485":1918,"_21804":57521,"_5":15036,"_28646":57343,"_3122":57522},[],"The CRL linked to the authority.",{"_3731":1994,"_31485":1918,"_21804":57524,"_5":15036,"_28646":57343,"_3122":57525},[],"Metadata and the associated cryptographic engine.",{"_3731":1995,"_31485":1918,"_21804":57527,"_5":15036,"_28646":57343,"_3122":57528},[],"You can filter the inventory by name, status and CA type.",{"_3731":1996,"_31485":1918,"_21804":57530,"_5":15036,"_28646":57347,"_3122":57531},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3731":1997,"_31485":1918,"_21804":57533,"_5":15036,"_28646":57347,"_3122":57534},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3731":1998,"_31485":1918,"_21804":57536,"_5":15036,"_28646":57347,"_3122":57537},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3731":1999,"_31485":1918,"_21804":57539,"_5":15036,"_28646":57347,"_3122":57540},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3731":2000,"_31485":1918,"_21804":57542,"_5":15036,"_28646":57347,"_3122":57543},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3731":2001,"_31485":1918,"_21804":57545,"_5":15036,"_28646":57347,"_3122":57546},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3731":2002,"_31485":1918,"_21804":57548,"_5":15036,"_28646":57351,"_3122":57549},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3731":2003,"_31485":1918,"_21804":57551,"_5":15036,"_28646":57355,"_3122":57552},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3731":2004,"_31485":1918,"_21804":57554,"_5":15036,"_28646":57359,"_3122":57555},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3731":2005,"_31485":1918,"_21804":57557,"_5":15036,"_28646":57363,"_3122":57558},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3731":2006,"_31485":1918,"_21804":57560,"_5":15036,"_28646":57367,"_3122":57561},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3731":2007,"_31485":1918,"_21804":57563,"_5":15036,"_28646":57371,"_3122":57564},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3731":2008,"_31485":1918,"_21804":57566,"_5":15036,"_28646":57371,"_3122":57567},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3731":2009,"_31485":1918,"_21804":57569,"_5":15036,"_28646":57371,"_3122":57570},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3731":2010,"_31485":1918,"_21804":57572,"_5":15036,"_28646":57371,"_3122":57573},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3731":2011,"_31485":1918,"_21804":57575,"_5":15036,"_28646":57371,"_3122":57576},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3731":2012,"_31485":2012,"_5":15390,"_3122":57578,"_31812":57579,"_21804":57580,"_28646":2012},"Certificate profiles",[51373,52911,57109,57110],[],{"_3731":2013,"_31485":2012,"_21804":57582,"_5":15036,"_28646":2012,"_3122":57583},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3731":2014,"_31485":2012,"_5":31809,"_21804":57585,"_28646":57586,"_3122":57587},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3731":2015,"_31485":2012,"_5":31809,"_21804":57589,"_28646":57590,"_3122":57591},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3731":2016,"_31485":2012,"_5":31809,"_21804":57593,"_28646":57594,"_3122":57595},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3731":2017,"_31485":2012,"_5":31809,"_21804":57597,"_28646":57598,"_3122":57599},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3731":2018,"_31485":2012,"_5":31809,"_21804":57601,"_28646":57602,"_3122":57603},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3731":2019,"_31485":2012,"_5":31809,"_21804":57605,"_28646":57606,"_3122":57607},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3731":2020,"_31485":2012,"_5":31809,"_21804":57609,"_28646":57610,"_3122":57611},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3731":2021,"_31485":2012,"_5":31809,"_21804":57613,"_28646":57614,"_3122":57615},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3731":2022,"_31485":2012,"_5":31809,"_21804":57617,"_28646":57618,"_3122":57619},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3731":2023,"_31485":2012,"_5":31809,"_21804":57621,"_28646":57622,"_3122":57623},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3731":2024,"_31485":2012,"_5":31809,"_21804":57625,"_28646":57626,"_3122":57627},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3731":2025,"_31485":2012,"_5":31809,"_21804":57629,"_28646":57630,"_3122":57631},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3731":2026,"_31485":2012,"_5":31809,"_21804":57633,"_28646":57634,"_3122":57635},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3731":2027,"_31485":2012,"_5":31809,"_21804":57637,"_28646":57638,"_3122":57639},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3731":2028,"_31485":2012,"_5":31809,"_21804":57641,"_28646":57642,"_3122":57643},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3731":2029,"_31485":2012,"_5":31809,"_21804":57645,"_28646":57646,"_3122":57647},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3731":2030,"_31485":2012,"_21804":57649,"_5":15036,"_28646":2012,"_3122":57650},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3731":2031,"_31485":2012,"_21804":57652,"_5":15036,"_28646":2012,"_3122":57653},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3731":2032,"_31485":2012,"_21804":57655,"_5":15036,"_28646":57590,"_3122":57656},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3731":2033,"_31485":2012,"_21804":57658,"_5":15036,"_28646":57590,"_3122":57659},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3731":2034,"_31485":2012,"_21804":57661,"_5":15036,"_28646":57594,"_3122":57662},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3731":2035,"_31485":2012,"_21804":57664,"_5":15036,"_28646":57598,"_3122":57665},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3731":2036,"_31485":2012,"_21804":57667,"_5":15036,"_28646":57598,"_3122":57668},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3731":2037,"_31485":2012,"_21804":57670,"_5":15036,"_28646":57598,"_3122":57671},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3731":2038,"_31485":2012,"_21804":57673,"_5":15036,"_28646":57602,"_3122":57674},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3731":2039,"_31485":2012,"_21804":57676,"_5":15036,"_28646":57606,"_3122":57677},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3731":2040,"_31485":2012,"_21804":57679,"_5":15036,"_28646":57606,"_3122":57680},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3731":2041,"_31485":2012,"_21804":57682,"_5":15036,"_28646":57610,"_3122":57683},[],"The cryptographic enforcement can:",{"_3731":2042,"_31485":2012,"_21804":57685,"_5":15036,"_28646":57610,"_3122":57686},[],"allow or block RSA keys;",{"_3731":2043,"_31485":2012,"_21804":57688,"_5":15036,"_28646":57610,"_3122":57689},[],"limit the supported RSA sizes;",{"_3731":2044,"_31485":2012,"_21804":57691,"_5":15036,"_28646":57610,"_3122":57692},[],"allow or block ECDSA keys;",{"_3731":2045,"_31485":2012,"_21804":57694,"_5":15036,"_28646":57610,"_3122":57695},[],"limit the supported ECDSA sizes or curves.",{"_3731":2046,"_31485":2012,"_21804":57697,"_5":15036,"_28646":57610,"_3122":57698},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3731":2047,"_31485":2012,"_21804":57700,"_5":15036,"_28646":57614,"_3122":57701},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3731":2048,"_31485":2012,"_21804":57703,"_5":15036,"_28646":57614,"_3122":54698},[],{"_3731":2049,"_31485":2012,"_21804":57705,"_5":15036,"_28646":57614,"_3122":57706},[],"First choice",{"_3731":2050,"_31485":2012,"_21804":57708,"_5":15036,"_28646":57614,"_3122":57709},[],"Second choice",{"_3731":2051,"_31485":2012,"_21804":57711,"_5":15036,"_28646":57614,"_3122":57712},[],"If neither is supplied",{"_3731":2052,"_31485":2012,"_21804":57714,"_5":15036,"_28646":57614,"_3122":57715},[],"Direct signing with a CA",{"_3731":2053,"_31485":2012,"_21804":57717,"_5":15036,"_28646":57614,"_3122":57718},[],"`issuance_profile` embedded in the request",{"_3731":2054,"_31485":2012,"_21804":57720,"_5":15036,"_28646":57614,"_3122":57721},[],"Request `issuance_profile_id`",{"_3731":2055,"_31485":2012,"_21804":57723,"_5":15036,"_28646":57614,"_3122":57724},[],"CA default profile (`profile_id`).",{"_3731":2056,"_31485":2012,"_21804":57726,"_5":15036,"_28646":57614,"_3122":57727},[],"Issuance through a DMS",{"_3731":2057,"_31485":2012,"_21804":57729,"_5":15036,"_28646":57614,"_3122":57730},[],"`settings.issuance_profile_id`",{"_3731":2058,"_31485":2012,"_21804":57732,"_5":15036,"_28646":57614,"_3122":57733},[],"`settings.issuance_profile` embedded in the DMS",{"_3731":2059,"_31485":2012,"_21804":57735,"_5":15036,"_28646":57614,"_3122":57736},[],"Enrollment CA default profile.",{"_3731":2060,"_31485":2012,"_21804":57738,"_5":15036,"_28646":57614,"_3122":57739},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3731":2061,"_31485":2012,"_21804":57741,"_5":15036,"_28646":57614,"_3122":57742},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3731":2062,"_31485":2012,"_21804":57744,"_5":15036,"_28646":57622,"_3122":57745},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3731":2063,"_31485":2012,"_21804":57747,"_5":15036,"_28646":57626,"_3122":57748},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3731":2064,"_31485":2012,"_21804":57750,"_5":15036,"_28646":57630,"_3122":57751},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3731":2065,"_31485":2012,"_21804":57753,"_5":15036,"_28646":57634,"_3122":57754},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3731":2066,"_31485":2012,"_21804":57756,"_5":15036,"_28646":57638,"_3122":57757},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3731":2067,"_31485":2012,"_21804":57759,"_5":15036,"_28646":57638,"_3122":57760},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3731":2068,"_31485":2012,"_21804":57762,"_5":15036,"_28646":57642,"_3122":57763},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3731":2069,"_31485":2012,"_21804":57765,"_5":15036,"_28646":57642,"_3122":57766},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3731":2070,"_31485":2012,"_21804":57768,"_5":15036,"_28646":57642,"_3122":57769},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3731":2071,"_31485":2012,"_21804":57771,"_5":15036,"_28646":57642,"_3122":57772},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3731":2072,"_31485":2012,"_21804":57774,"_5":15036,"_28646":57646,"_3122":57775},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3731":2073,"_31485":2012,"_21804":57777,"_5":15036,"_28646":57646,"_3122":57778},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3731":2074,"_31485":2074,"_5":15390,"_3122":57780,"_31812":57781,"_21804":57783,"_28646":2074},"Certificate validation",[51373,52911,57109,57782],"Validation",[],{"_3731":2075,"_31485":2074,"_21804":57785,"_5":15036,"_28646":2074,"_3122":57786},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3731":2076,"_31485":2074,"_5":31809,"_21804":57788,"_28646":57789,"_3122":57790},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3731":2077,"_31485":2074,"_5":31809,"_21804":57792,"_28646":57793,"_3122":57794},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3731":2078,"_31485":2074,"_5":31809,"_21804":57796,"_28646":57797,"_3122":57798},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3731":2079,"_31485":2074,"_21804":57800,"_5":15036,"_28646":2074,"_3122":57801},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3731":2080,"_31485":2074,"_21804":57803,"_5":15036,"_28646":57789,"_3122":57804},[],"Verify these criteria together:",{"_3731":2081,"_31485":2074,"_21804":57806,"_5":15036,"_28646":57789,"_3122":56735},[],{"_3731":2082,"_31485":2074,"_21804":57808,"_5":15036,"_28646":57789,"_3122":57809},[],"Required result",{"_3731":2083,"_31485":2074,"_21804":57811,"_5":15036,"_28646":57789,"_3122":57812},[],"Chain and signature",{"_3731":2084,"_31485":2074,"_21804":57814,"_5":15036,"_28646":57789,"_3122":57815},[],"Valid chain to a root deliberately installed in the consumer.",{"_3731":2085,"_31485":2074,"_21804":57817,"_5":15036,"_28646":57789,"_3122":57818},[],"Dates",{"_3731":2086,"_31485":2074,"_21804":57820,"_5":15036,"_28646":57789,"_3122":57821},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3731":2087,"_31485":2074,"_21804":57823,"_5":15036,"_28646":57789,"_3122":52580},[],{"_3731":2088,"_31485":2074,"_21804":57825,"_5":15036,"_28646":57789,"_3122":57826},[],"Name, SAN or identifier matches the expected peer.",{"_3731":2089,"_31485":2074,"_21804":57828,"_5":15036,"_28646":57789,"_3122":51763},[],{"_3731":2090,"_31485":2074,"_21804":57830,"_5":15036,"_28646":57789,"_3122":57831},[],"KU, EKU and constraints permit the specific operation.",{"_3731":2091,"_31485":2074,"_21804":57833,"_5":15036,"_28646":57789,"_3122":57834},[],"Revocation",{"_3731":2092,"_31485":2074,"_21804":57836,"_5":15036,"_28646":57789,"_3122":57837},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3731":2093,"_31485":2074,"_21804":57839,"_5":15036,"_28646":57789,"_3122":57840},[],"Authorization",{"_3731":2094,"_31485":2074,"_21804":57842,"_5":15036,"_28646":57789,"_3122":57843},[],"The application permits that identity to perform the action.",{"_3731":2095,"_31485":2074,"_21804":57845,"_5":15036,"_28646":57789,"_3122":57846},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3731":2096,"_31485":2074,"_21804":57848,"_5":15036,"_28646":57793,"_3122":57849},[],"Mechanism",{"_3731":2097,"_31485":2074,"_21804":57851,"_5":15036,"_28646":57793,"_3122":57852},[],"When to use it",{"_3731":2098,"_31485":2074,"_21804":57854,"_5":15036,"_28646":57793,"_3122":57855},[],"What you must maintain",{"_3731":2099,"_31485":2074,"_21804":57857,"_5":15036,"_28646":57793,"_3122":57858},[],"OCSP",{"_3731":2100,"_31485":2074,"_21804":57860,"_5":15036,"_28646":57793,"_3122":57861},[],"Status query for a specific certificate.",{"_3731":2101,"_31485":2074,"_21804":57863,"_5":15036,"_28646":57793,"_3122":57864},[],"Responder access, signature verification and cache/freshness policy.",{"_3731":2102,"_31485":2074,"_21804":57866,"_5":15036,"_28646":57793,"_3122":57867},[],"CRL",{"_3731":2103,"_31485":2074,"_21804":57869,"_5":15036,"_28646":57793,"_3122":57870},[],"Local checks for many certificates or offline operation.",{"_3731":2104,"_31485":2074,"_21804":57872,"_5":15036,"_28646":57793,"_3122":57873},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3731":2105,"_31485":2074,"_21804":57875,"_5":15036,"_28646":57793,"_3122":57876},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3731":2106,"_31485":2074,"_21804":57878,"_5":15036,"_28646":57793,"_3122":57879},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3731":2107,"_31485":2074,"_21804":57881,"_5":15036,"_28646":57797,"_3122":57882},[],"Accept a current, authorized certificate with a known chain.",{"_3731":2108,"_31485":2074,"_21804":57884,"_5":15036,"_28646":57797,"_3122":57885},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3731":2109,"_31485":2074,"_21804":57887,"_5":15036,"_28646":57797,"_3122":57888},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3731":2110,"_31485":2074,"_21804":57890,"_5":15036,"_28646":57797,"_3122":57891},[],"Check that a new connection with that identity is rejected.",{"_3731":2111,"_31485":2074,"_21804":57893,"_5":15036,"_28646":57797,"_3122":57894},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3731":2112,"_31485":2074,"_21804":57896,"_5":15036,"_28646":57797,"_3122":57897},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3731":2113,"_31485":2074,"_21804":57899,"_5":15036,"_28646":57797,"_3122":57900},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3731":2114,"_31485":2074,"_21804":57902,"_5":15036,"_28646":57797,"_3122":57903},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3731":2115,"_31485":2074,"_21804":57905,"_5":15036,"_28646":57797,"_3122":57906},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3731":2116,"_31485":2116,"_5":15390,"_3122":57908,"_31812":57909,"_21804":57910,"_28646":2116},"Certificates",[51373,52911,57109,57110],[],{"_3731":2117,"_31485":2116,"_21804":57912,"_5":15036,"_28646":2116,"_3122":57913},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3731":2118,"_31485":2116,"_5":31809,"_21804":57915,"_28646":57916,"_3122":57917},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3731":2119,"_31485":2116,"_5":31809,"_21804":57919,"_28646":57920,"_3122":57921},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3731":2120,"_31485":2116,"_5":31809,"_21804":57923,"_28646":57924,"_3122":57925},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3731":2121,"_31485":2116,"_5":31809,"_21804":57927,"_28646":57928,"_3122":57929},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3731":2122,"_31485":2116,"_5":31809,"_21804":57931,"_28646":57932,"_3122":57933},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3731":2123,"_31485":2116,"_5":31809,"_21804":57935,"_28646":57936,"_3122":57937},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3731":2124,"_31485":2116,"_5":31809,"_21804":57939,"_28646":57940,"_3122":57941},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3731":2125,"_31485":2116,"_5":31809,"_21804":57943,"_28646":57944,"_3122":57945},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3731":2126,"_31485":2116,"_5":31809,"_21804":57947,"_28646":57948,"_3122":57949},[],"/docs/platform/pki/certificates#continue","Continue",{"_3731":2127,"_31485":2116,"_21804":57951,"_5":15036,"_28646":2116,"_3122":57952},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3731":2128,"_31485":2116,"_21804":57954,"_5":15036,"_28646":57916,"_3122":57955},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3731":2129,"_31485":2116,"_21804":57957,"_5":15036,"_28646":57916,"_3122":57958},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3731":2130,"_31485":2116,"_21804":57960,"_5":15036,"_28646":57916,"_3122":57961},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3731":2131,"_31485":2116,"_21804":57963,"_5":15036,"_28646":57916,"_3122":57964},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3731":2132,"_31485":2116,"_21804":57966,"_5":15036,"_28646":57916,"_3122":57967},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3731":2133,"_31485":2116,"_21804":57969,"_5":15036,"_28646":57916,"_3122":57970},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3731":2134,"_31485":2116,"_21804":57972,"_5":15036,"_28646":57916,"_3122":57973},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3731":2135,"_31485":2116,"_21804":57975,"_5":15036,"_28646":57920,"_3122":57976},[],"Download the PEM and inspect it:",{"_3731":2136,"_31485":2116,"_21804":57978,"_5":15036,"_28646":57920,"_3122":57979},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3731":2137,"_31485":2116,"_21804":57981,"_5":15036,"_28646":57924,"_3122":57982},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3731":2138,"_31485":2116,"_21804":57984,"_5":15036,"_28646":57924,"_3122":57985},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3731":2139,"_31485":2116,"_21804":57987,"_5":15036,"_28646":57924,"_3122":57988},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3731":2140,"_31485":2116,"_21804":57990,"_5":15036,"_28646":57924,"_3122":57991},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3731":2141,"_31485":2116,"_21804":57993,"_5":15036,"_28646":57924,"_3122":57994},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3731":2142,"_31485":2116,"_21804":57996,"_5":15036,"_28646":57924,"_3122":57997},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3731":2143,"_31485":2116,"_21804":57999,"_5":15036,"_28646":57924,"_3122":58000},[],"For browser key generation, follow Issue your first certificate.",{"_3731":2144,"_31485":2116,"_21804":58002,"_5":15036,"_28646":57928,"_3122":58003},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3731":2145,"_31485":2116,"_21804":58005,"_5":15036,"_28646":57932,"_3122":58006},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3731":2146,"_31485":2116,"_21804":58008,"_5":15036,"_28646":57936,"_3122":58009},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3731":2147,"_31485":2116,"_21804":58011,"_5":15036,"_28646":57940,"_3122":58012},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3731":2148,"_31485":2116,"_21804":58014,"_5":15036,"_28646":57940,"_3122":58015},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3731":2149,"_31485":2116,"_21804":58017,"_5":15036,"_28646":57940,"_3122":58018},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3731":2150,"_31485":2116,"_21804":58020,"_5":15036,"_28646":57944,"_3122":58021},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3731":2151,"_31485":2116,"_21804":58023,"_5":15036,"_28646":57944,"_3122":58024},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3731":2152,"_31485":2116,"_21804":58026,"_5":15036,"_28646":57944,"_3122":58027},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3731":2153,"_31485":2116,"_21804":58029,"_5":15036,"_28646":57948,"_3122":58030},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3731":2154,"_31485":2116,"_21804":58032,"_5":15036,"_28646":57948,"_3122":58033},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3731":2155,"_31485":2155,"_5":15390,"_3122":58035,"_31812":58036,"_21804":58038,"_28646":2155},"Certificate lifecycle",[51373,52911,57109,58037],"Concepts",[],{"_3731":2156,"_31485":2155,"_21804":58040,"_5":15036,"_28646":2155,"_3122":58041},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3731":2157,"_31485":2155,"_5":31809,"_21804":58043,"_28646":58044,"_3122":58045},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3731":2158,"_31485":2155,"_5":31809,"_21804":58047,"_28646":58048,"_3122":58049},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3731":2159,"_31485":2155,"_5":31809,"_21804":58051,"_28646":58052,"_3122":58053},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3731":2160,"_31485":2155,"_5":31809,"_21804":58055,"_28646":58056,"_3122":58057},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3731":2161,"_31485":2155,"_5":31809,"_21804":58059,"_28646":58060,"_3122":58061},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3731":2162,"_31485":2155,"_5":31809,"_21804":58063,"_28646":58064,"_3122":58065},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3731":2163,"_31485":2155,"_5":31809,"_21804":58067,"_28646":58068,"_3122":58069},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3731":2164,"_31485":2155,"_5":31809,"_21804":58071,"_28646":58072,"_3122":58073},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3731":2165,"_31485":2155,"_5":31809,"_21804":58075,"_28646":58076,"_3122":58077},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3731":2166,"_31485":2155,"_5":31809,"_21804":58079,"_28646":58080,"_3122":58081},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3731":2167,"_31485":2155,"_21804":58083,"_5":15036,"_28646":2155,"_3122":58084},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3731":2168,"_31485":2155,"_21804":58086,"_5":15036,"_28646":58048,"_3122":58087},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3731":2169,"_31485":2155,"_21804":58089,"_5":15036,"_28646":58052,"_3122":58090},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3731":2170,"_31485":2155,"_21804":58092,"_5":15036,"_28646":58056,"_3122":58093},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3731":2171,"_31485":2155,"_21804":58095,"_5":15036,"_28646":58060,"_3122":58096},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3731":2172,"_31485":2155,"_21804":58098,"_5":15036,"_28646":58064,"_3122":58099},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3731":2173,"_31485":2155,"_21804":58101,"_5":15036,"_28646":58068,"_3122":58102},[],"Lamassu persists four X.509 states:",{"_3731":2174,"_31485":2155,"_21804":58104,"_5":15036,"_28646":58068,"_3122":58105},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3731":2175,"_31485":2155,"_21804":58107,"_5":15036,"_28646":58068,"_3122":58108},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3731":2176,"_31485":2155,"_21804":58110,"_5":15036,"_28646":58068,"_3122":58111},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3731":2177,"_31485":2155,"_21804":58113,"_5":15036,"_28646":58068,"_3122":58114},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3731":2178,"_31485":2155,"_21804":58116,"_5":15036,"_28646":58068,"_3122":58117},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3731":2179,"_31485":2155,"_21804":58119,"_5":15036,"_28646":58072,"_3122":58120},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3731":2180,"_31485":2155,"_21804":58122,"_5":15036,"_28646":58072,"_3122":58123},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3731":2181,"_31485":2155,"_21804":58125,"_5":15036,"_28646":58072,"_3122":58126},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3731":2182,"_31485":2155,"_21804":58128,"_5":15036,"_28646":58076,"_3122":58129},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3731":2183,"_31485":2155,"_21804":58131,"_5":15036,"_28646":58076,"_3122":58132},[],"Before confirming:",{"_3731":2184,"_31485":2155,"_21804":58134,"_5":15036,"_28646":58076,"_3122":58135},[],"Identify DMSs, devices and services that trust that chain.",{"_3731":2185,"_31485":2155,"_21804":58137,"_5":15036,"_28646":58076,"_3122":58138},[],"Distribute the new chain of trust.",{"_3731":2186,"_31485":2155,"_21804":58140,"_5":15036,"_28646":58076,"_3122":58141},[],"Reissue the necessary identities.",{"_3731":2187,"_31485":2155,"_21804":58143,"_5":15036,"_28646":58076,"_3122":58144},[],"Check OCSP and CRL from a real consumer.",{"_3731":2188,"_31485":2155,"_21804":58146,"_5":15036,"_28646":58076,"_3122":58147},[],"Revoke the old CA once no legitimate traffic remains.",{"_3731":2189,"_31485":2155,"_21804":58149,"_5":15036,"_28646":58076,"_3122":58150},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3731":2190,"_31485":2155,"_21804":58152,"_5":15036,"_28646":58080,"_3122":58153},[],"Certificates entering the preventive or critical renewal window.",{"_3731":2191,"_31485":2155,"_21804":58155,"_5":15036,"_28646":58080,"_3122":58156},[],"Repeated enrollment or re-enrollment failures.",{"_3731":2192,"_31485":2155,"_21804":58158,"_5":15036,"_28646":58080,"_3122":58159},[],"Status changes and revocation reasons.",{"_3731":2193,"_31485":2155,"_21804":58161,"_5":15036,"_28646":58080,"_3122":58162},[],"OCSP and CRL publication and validity.",{"_3731":2194,"_31485":2155,"_21804":58164,"_5":15036,"_28646":58080,"_3122":58165},[],"Dependencies still presenting a replaced certificate.",{"_3731":2195,"_31485":2155,"_21804":58167,"_5":15036,"_28646":58080,"_3122":58168},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3731":2196,"_31485":2196,"_5":15390,"_3122":58170,"_31812":58171,"_21804":58172,"_28646":2196},"Trust model",[51373,52911,57109,58037],[],{"_3731":2197,"_31485":2196,"_21804":58174,"_5":15036,"_28646":2196,"_3122":58175},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3731":2198,"_31485":2196,"_5":31809,"_21804":58177,"_28646":58178,"_3122":58179},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3731":2199,"_31485":2196,"_5":31809,"_21804":58181,"_28646":58182,"_3122":58183},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3731":2200,"_31485":2196,"_5":31809,"_21804":58185,"_28646":58186,"_3122":58187},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3731":2201,"_31485":2196,"_5":31809,"_21804":58189,"_28646":58190,"_3122":58191},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3731":2202,"_31485":2196,"_5":31809,"_21804":58193,"_28646":58194,"_3122":58195},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3731":2203,"_31485":2196,"_5":31809,"_21804":58197,"_28646":58198,"_3122":58199},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3731":2204,"_31485":2196,"_5":31809,"_21804":58201,"_28646":58202,"_3122":58203},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3731":2205,"_31485":2196,"_5":31809,"_21804":58205,"_28646":58206,"_3122":58207},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3731":2206,"_31485":2196,"_5":31809,"_21804":58209,"_28646":58210,"_3122":58211},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3731":2207,"_31485":2196,"_5":31809,"_21804":58213,"_28646":58214,"_3122":58215},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3731":2208,"_31485":2196,"_21804":58217,"_5":15036,"_28646":2196,"_3122":58218},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3731":2209,"_31485":2196,"_21804":58220,"_5":15036,"_28646":58182,"_3122":58221},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3731":2210,"_31485":2196,"_21804":58223,"_5":15036,"_28646":58186,"_3122":58224},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3731":2211,"_31485":2196,"_21804":58226,"_5":15036,"_28646":58190,"_3122":58227},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3731":2212,"_31485":2196,"_21804":58229,"_5":15036,"_28646":58194,"_3122":58230},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3731":2213,"_31485":2196,"_21804":58232,"_5":15036,"_28646":58198,"_3122":58233},[],"The device proves it can enroll according to the DMS policy.",{"_3731":2214,"_31485":2196,"_21804":58235,"_5":15036,"_28646":58198,"_3122":58236},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3731":2215,"_31485":2196,"_21804":58238,"_5":15036,"_28646":58198,"_3122":58239},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3731":2216,"_31485":2196,"_21804":58241,"_5":15036,"_28646":58198,"_3122":58242},[],"The device installs the certificate and the chain it needs.",{"_3731":2217,"_31485":2196,"_21804":58244,"_5":15036,"_28646":58198,"_3122":58245},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3731":2218,"_31485":2196,"_21804":58247,"_5":15036,"_28646":58198,"_3122":58248},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3731":2219,"_31485":2196,"_21804":58250,"_5":15036,"_28646":58202,"_3122":58251},[],"A DMS relates three sets that are worth designing separately:",{"_3731":2220,"_31485":2196,"_21804":58253,"_5":15036,"_28646":58202,"_3122":58254},[],"**Enrollment CA:** signs the new identities.",{"_3731":2221,"_31485":2196,"_21804":58256,"_5":15036,"_28646":58202,"_3122":58257},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3731":2222,"_31485":2196,"_21804":58259,"_5":15036,"_28646":58202,"_3122":58260},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3731":2223,"_31485":2196,"_21804":58262,"_5":15036,"_28646":58202,"_3122":58263},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3731":2224,"_31485":2196,"_21804":58265,"_5":15036,"_28646":58206,"_3122":58266},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3731":2225,"_31485":2196,"_21804":58268,"_5":15036,"_28646":58206,"_3122":58269},[],"that the current date is between `Not Before` and `Not After`;",{"_3731":2226,"_31485":2196,"_21804":58271,"_5":15036,"_28646":58206,"_3122":58272},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3731":2227,"_31485":2196,"_21804":58274,"_5":15036,"_28646":58206,"_3122":58275},[],"that names, SANs and subject match the expected identity;",{"_3731":2228,"_31485":2196,"_21804":58277,"_5":15036,"_28646":58206,"_3122":58278},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3731":2229,"_31485":2196,"_21804":58280,"_5":15036,"_28646":58206,"_3122":58281},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3731":2230,"_31485":2196,"_21804":58283,"_5":15036,"_28646":58206,"_3122":58284},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3731":2231,"_31485":2196,"_21804":58286,"_5":15036,"_28646":58210,"_3122":58287},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3731":2232,"_31485":2196,"_21804":58289,"_5":15036,"_28646":58214,"_3122":58290},[],"Keep the root out of daily operations, or with very restricted access.",{"_3731":2233,"_31485":2196,"_21804":58292,"_5":15036,"_28646":58214,"_3122":58293},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3731":2234,"_31485":2196,"_21804":58295,"_5":15036,"_28646":58214,"_3122":58296},[],"Assign explicit profiles to every use case.",{"_3731":2235,"_31485":2196,"_21804":58298,"_5":15036,"_28646":58214,"_3122":58299},[],"Distribute the new trust before starting a rotation.",{"_3731":2236,"_31485":2196,"_21804":58301,"_5":15036,"_28646":58214,"_3122":58302},[],"Keep enough overlap to renew a disconnected fleet.",{"_3731":2237,"_31485":2196,"_21804":58304,"_5":15036,"_28646":58214,"_3122":58305},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3731":2238,"_31485":2196,"_21804":58307,"_5":15036,"_28646":58214,"_3122":58308},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3731":2239,"_31485":2239,"_5":15390,"_3122":58310,"_31812":58311,"_21804":58312,"_28646":2239},"Revocation lists (CRL)",[51373,52911,57109,57782],[],{"_3731":2240,"_31485":2239,"_21804":58314,"_5":15036,"_28646":2239,"_3122":58315},[],"Generate and distribute signed lists to validate certificates offline.",{"_3731":2241,"_31485":2239,"_5":31809,"_21804":58317,"_28646":58318,"_3122":58319},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3731":2242,"_31485":2239,"_5":31809,"_21804":58321,"_28646":58322,"_3122":58323},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3731":2243,"_31485":2239,"_5":31809,"_21804":58325,"_28646":58326,"_3122":58327},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3731":2244,"_31485":2239,"_5":31809,"_21804":58329,"_28646":58330,"_3122":58331},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3731":2245,"_31485":2239,"_5":31809,"_21804":58333,"_28646":58334,"_3122":58335},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3731":2246,"_31485":2239,"_5":31809,"_21804":58337,"_28646":58338,"_3122":58339},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3731":2247,"_31485":2239,"_5":31809,"_21804":58341,"_28646":58342,"_3122":58343},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3731":2248,"_31485":2239,"_5":31809,"_21804":58345,"_28646":58346,"_3122":58347},[],"/docs/platform/pki/crl#references","References",{"_3731":2249,"_31485":2239,"_21804":58349,"_5":15036,"_28646":2239,"_3122":58350},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3731":2250,"_31485":2239,"_21804":58352,"_5":15036,"_28646":58318,"_3122":58353},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3731":2251,"_31485":2239,"_21804":58355,"_5":15036,"_28646":58318,"_3122":58356},[],"Field",{"_3731":2252,"_31485":2239,"_21804":58358,"_5":15036,"_28646":58318,"_3122":51763},[],{"_3731":2253,"_31485":2239,"_21804":58360,"_5":15036,"_28646":58318,"_3122":53031},[],{"_3731":2254,"_31485":2239,"_21804":58362,"_5":15036,"_28646":58318,"_3122":58363},[],"ID of the CA the settings belong to.",{"_3731":2255,"_31485":2239,"_21804":58365,"_5":15036,"_28646":58318,"_3122":58366},[],"`status`",{"_3731":2256,"_31485":2239,"_21804":58368,"_5":15036,"_28646":58318,"_3122":58369},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3731":2257,"_31485":2239,"_21804":58371,"_5":15036,"_28646":58318,"_3122":58372},[],"`legacy_ski`",{"_3731":2258,"_31485":2239,"_21804":58374,"_5":15036,"_28646":58318,"_3122":58375},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3731":2259,"_31485":2239,"_21804":58377,"_5":15036,"_28646":58318,"_3122":58378},[],"`latest_crl`",{"_3731":2260,"_31485":2239,"_21804":58380,"_5":15036,"_28646":58318,"_3122":58381},[],"Version, validity start and end of the last published list. Read-only.",{"_3731":2261,"_31485":2239,"_21804":58383,"_5":15036,"_28646":58318,"_3122":58384},[],"`crl_options` field",{"_3731":2262,"_31485":2239,"_21804":58386,"_5":15036,"_28646":58318,"_3122":51763},[],{"_3731":2263,"_31485":2239,"_21804":58388,"_5":15036,"_28646":58318,"_3122":58389},[],"Initial value",{"_3731":2264,"_31485":2239,"_21804":58391,"_5":15036,"_28646":58318,"_3122":58392},[],"`validity`",{"_3731":2265,"_31485":2239,"_21804":58394,"_5":15036,"_28646":58318,"_3122":58395},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3731":2266,"_31485":2239,"_21804":58397,"_5":15036,"_28646":58318,"_3122":58398},[],"7 days.",{"_3731":2267,"_31485":2239,"_21804":58400,"_5":15036,"_28646":58318,"_3122":58401},[],"`refresh_interval`",{"_3731":2268,"_31485":2239,"_21804":58403,"_5":15036,"_28646":58318,"_3122":58404},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3731":2269,"_31485":2239,"_21804":58406,"_5":15036,"_28646":58318,"_3122":58407},[],"6 days and 23 hours.",{"_3731":2270,"_31485":2239,"_21804":58409,"_5":15036,"_28646":58318,"_3122":58410},[],"`regenerate_on_revoke`",{"_3731":2271,"_31485":2239,"_21804":58412,"_5":15036,"_28646":58318,"_3122":58413},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3731":2272,"_31485":2239,"_21804":58415,"_5":15036,"_28646":58318,"_3122":58416},[],"`true`.",{"_3731":2273,"_31485":2239,"_21804":58418,"_5":15036,"_28646":58318,"_3122":58419},[],"`signer_serial_number`",{"_3731":2274,"_31485":2239,"_21804":58421,"_5":15036,"_28646":58318,"_3122":58422},[],"Serial number of the existing certificate that signs the CRL.",{"_3731":2275,"_31485":2239,"_21804":58424,"_5":15036,"_28646":58318,"_3122":58425},[],"Serial number of the CA’s current certificate.",{"_3731":2276,"_31485":2239,"_21804":58427,"_5":15036,"_28646":58318,"_3122":58428},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3731":2277,"_31485":2239,"_21804":58430,"_5":15036,"_28646":58318,"_3122":58431},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3731":2278,"_31485":2239,"_21804":58433,"_5":15036,"_28646":58318,"_3122":58434},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3731":2279,"_31485":2239,"_21804":58436,"_5":15036,"_28646":58318,"_3122":58437},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3731":2280,"_31485":2239,"_21804":58439,"_5":15036,"_28646":58318,"_3122":58440},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3731":2281,"_31485":2239,"_21804":58442,"_5":15036,"_28646":58318,"_3122":58443},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3731":2282,"_31485":2239,"_21804":58445,"_5":15036,"_28646":58318,"_3122":58446},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3731":2283,"_31485":2239,"_21804":58448,"_5":15036,"_28646":58318,"_3122":58449},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3731":2284,"_31485":2239,"_21804":58451,"_5":15036,"_28646":58318,"_3122":58452},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3731":2285,"_31485":2239,"_21804":58454,"_5":15036,"_28646":58318,"_3122":58455},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3731":2286,"_31485":2239,"_21804":58457,"_5":15036,"_28646":58318,"_3122":58458},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3731":2287,"_31485":2239,"_21804":58460,"_5":15036,"_28646":58322,"_3122":58461},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3731":2288,"_31485":2239,"_21804":58463,"_5":15036,"_28646":58322,"_3122":58464},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3731":2289,"_31485":2239,"_21804":58466,"_5":15036,"_28646":58322,"_3122":58467},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3731":2290,"_31485":2239,"_21804":58469,"_5":15036,"_28646":58322,"_3122":58470},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3731":2291,"_31485":2239,"_21804":58472,"_5":15036,"_28646":58326,"_3122":58473},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3731":2292,"_31485":2239,"_21804":58475,"_5":15036,"_28646":58326,"_3122":58476},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3731":2293,"_31485":2239,"_21804":58478,"_5":15036,"_28646":58326,"_3122":58479},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3731":2294,"_31485":2239,"_21804":58481,"_5":15036,"_28646":58326,"_3122":58482},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3731":2295,"_31485":2239,"_21804":58484,"_5":15036,"_28646":58326,"_3122":58485},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3731":2296,"_31485":2239,"_21804":58487,"_5":15036,"_28646":58326,"_3122":58488},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3731":2297,"_31485":2239,"_21804":58490,"_5":15036,"_28646":58326,"_3122":58491},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3731":2298,"_31485":2239,"_21804":58493,"_5":15036,"_28646":58326,"_3122":58494},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3731":2299,"_31485":2239,"_21804":58496,"_5":15036,"_28646":58326,"_3122":58497},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3731":2300,"_31485":2239,"_21804":58499,"_5":15036,"_28646":58330,"_3122":58500},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3731":2301,"_31485":2239,"_21804":58502,"_5":15036,"_28646":58330,"_3122":58503},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3731":2302,"_31485":2239,"_21804":58505,"_5":15036,"_28646":58334,"_3122":58506},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3731":2303,"_31485":2239,"_21804":58508,"_5":15036,"_28646":58334,"_3122":58509},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3731":2304,"_31485":2239,"_21804":58511,"_5":15036,"_28646":58334,"_3122":58512},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3731":2305,"_31485":2239,"_21804":58514,"_5":15036,"_28646":58334,"_3122":58515},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3731":2306,"_31485":2239,"_21804":58517,"_5":15036,"_28646":58334,"_3122":58518},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3731":2307,"_31485":2239,"_21804":58520,"_5":15036,"_28646":58338,"_3122":58521},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3731":2308,"_31485":2239,"_21804":58523,"_5":15036,"_28646":58338,"_3122":54701},[],{"_3731":2309,"_31485":2239,"_21804":58525,"_5":15036,"_28646":58338,"_3122":58526},[],"Relative path",{"_3731":2310,"_31485":2239,"_21804":58528,"_5":15036,"_28646":58338,"_3122":54698},[],{"_3731":2311,"_31485":2239,"_21804":58530,"_5":15036,"_28646":58338,"_3122":58531},[],"`GET`",{"_3731":2312,"_31485":2239,"_21804":58533,"_5":15036,"_28646":58338,"_3122":58534},[],"`/v1/crl-settings`",{"_3731":2313,"_31485":2239,"_21804":58536,"_5":15036,"_28646":58338,"_3122":58537},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3731":2314,"_31485":2239,"_21804":58539,"_5":15036,"_28646":58338,"_3122":58531},[],{"_3731":2315,"_31485":2239,"_21804":58541,"_5":15036,"_28646":58338,"_3122":58542},[],"`/v1/crl-settings/{ca-id}`",{"_3731":2316,"_31485":2239,"_21804":58544,"_5":15036,"_28646":58338,"_3122":58545},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3731":2317,"_31485":2239,"_21804":58547,"_5":15036,"_28646":58338,"_3122":58548},[],"`PUT`",{"_3731":2318,"_31485":2239,"_21804":58550,"_5":15036,"_28646":58338,"_3122":58542},[],{"_3731":2319,"_31485":2239,"_21804":58552,"_5":15036,"_28646":58338,"_3122":58553},[],"Replace the CRL configuration of a CA.",{"_3731":2320,"_31485":2239,"_21804":58555,"_5":15036,"_28646":58338,"_3122":58556},[],"`DELETE`",{"_3731":2321,"_31485":2239,"_21804":58558,"_5":15036,"_28646":58338,"_3122":58542},[],{"_3731":2322,"_31485":2239,"_21804":58560,"_5":15036,"_28646":58338,"_3122":58561},[],"Remove the archived CRL settings of a CA.",{"_3731":2323,"_31485":2239,"_21804":58563,"_5":15036,"_28646":58338,"_3122":58564},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3731":2324,"_31485":2239,"_21804":58566,"_5":15036,"_28646":58338,"_3122":58567},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3731":2325,"_31485":2239,"_21804":58569,"_5":15036,"_28646":58338,"_3122":58570},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3731":2326,"_31485":2239,"_21804":58572,"_5":15036,"_28646":58342,"_3122":58573},[],"Symptom",{"_3731":2327,"_31485":2239,"_21804":58575,"_5":15036,"_28646":58342,"_3122":58576},[],"Cause",{"_3731":2328,"_31485":2239,"_21804":58578,"_5":15036,"_28646":58342,"_3122":58579},[],"Action",{"_3731":2329,"_31485":2239,"_21804":58581,"_5":15036,"_28646":58342,"_3122":58582},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3731":2330,"_31485":2239,"_21804":58584,"_5":15036,"_28646":58342,"_3122":58585},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3731":2331,"_31485":2239,"_21804":58587,"_5":15036,"_28646":58342,"_3122":58588},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3731":2332,"_31485":2239,"_21804":58590,"_5":15036,"_28646":58342,"_3122":58591},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3731":2333,"_31485":2239,"_21804":58593,"_5":15036,"_28646":58342,"_3122":58594},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3731":2334,"_31485":2239,"_21804":58596,"_5":15036,"_28646":58342,"_3122":58597},[],"Delete the CA first; deleting it archives its settings.",{"_3731":2335,"_31485":2239,"_21804":58599,"_5":15036,"_28646":58342,"_3122":58600},[],"`PUT` returns 400.",{"_3731":2336,"_31485":2239,"_21804":58602,"_5":15036,"_28646":58342,"_3122":58603},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3731":2337,"_31485":2239,"_21804":58605,"_5":15036,"_28646":58342,"_3122":58606},[],"Set the serial number of a valid certificate of that CA.",{"_3731":2338,"_31485":2239,"_21804":58608,"_5":15036,"_28646":58342,"_3122":58609},[],"`PUT` returns 404.",{"_3731":2339,"_31485":2239,"_21804":58611,"_5":15036,"_28646":58342,"_3122":58612},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3731":2340,"_31485":2239,"_21804":58614,"_5":15036,"_28646":58342,"_3122":58615},[],"Check the CA ID and the signer serial number.",{"_3731":2341,"_31485":2239,"_21804":58617,"_5":15036,"_28646":58342,"_3122":58618},[],"`PUT` returns 400 from a 3.x client.",{"_3731":2342,"_31485":2239,"_21804":58620,"_5":15036,"_28646":58342,"_3122":58621},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3731":2343,"_31485":2239,"_21804":58623,"_5":15036,"_28646":58342,"_3122":58624},[],"Update the client to send the new field.",{"_3731":2344,"_31485":2239,"_21804":58626,"_5":15036,"_28646":58342,"_3122":58627},[],"The CRL does not change after revoking a certificate.",{"_3731":2345,"_31485":2239,"_21804":58629,"_5":15036,"_28646":58342,"_3122":58630},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3731":2346,"_31485":2239,"_21804":58632,"_5":15036,"_28646":58342,"_3122":58633},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3731":2347,"_31485":2239,"_21804":58635,"_5":15036,"_28646":58342,"_3122":58636},[],"A verifier rejects the CRL because of the issuer.",{"_3731":2348,"_31485":2239,"_21804":58638,"_5":15036,"_28646":58342,"_3122":58639},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3731":2349,"_31485":2239,"_21804":58641,"_5":15036,"_28646":58342,"_3122":58642},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3731":2350,"_31485":2239,"_21804":58644,"_5":15036,"_28646":58346,"_3122":58645},[],"RFC 5280: X.509 and CRL profile.",{"_3731":2351,"_31485":2239,"_21804":58647,"_5":15036,"_28646":58346,"_3122":58648},[],"OpenSSL: openssl-crl.",{"_3731":2352,"_31485":2239,"_21804":58650,"_5":15036,"_28646":58346,"_3122":58651},[],"OpenSSL: openssl-verify.",{"_3731":2353,"_31485":2239,"_21804":58653,"_5":15036,"_28646":58346,"_3122":58654},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3731":2354,"_31485":2239,"_21804":58656,"_5":15036,"_28646":58346,"_3122":58657},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3731":2355,"_31485":2355,"_5":15390,"_3122":58659,"_31812":58660,"_21804":58661,"_28646":2355},"Enrollment protocols",[51373,52911,57109,57110],[],{"_3731":2356,"_31485":2355,"_21804":58663,"_5":15036,"_28646":2355,"_3122":58664},[],"Request and renew certificates from a Lamassu CA.",{"_3731":2357,"_31485":2355,"_21804":58666,"_5":15036,"_28646":2355,"_3122":58667},[],"Lamassu supports EST (Enrollment over Secure Transport), defined in RFC 7030. The DMS applies the enrollment policy and the configured CA issues the certificates.",{"_3731":2358,"_31485":2355,"_21804":58669,"_5":15036,"_28646":2355,"_3122":58670},[],"Core endpoint",{"_3731":2359,"_31485":2355,"_21804":58672,"_5":15036,"_28646":2355,"_3122":51763},[],{"_3731":2360,"_31485":2355,"_21804":58674,"_5":15036,"_28646":2355,"_3122":58675},[],"`GET /cacerts`",{"_3731":2361,"_31485":2355,"_21804":58677,"_5":15036,"_28646":2355,"_3122":58678},[],"Retrieve the CA certificates published by the DMS.",{"_3731":2362,"_31485":2355,"_21804":58680,"_5":15036,"_28646":2355,"_3122":58681},[],"`POST /simpleenroll`",{"_3731":2363,"_31485":2355,"_21804":58683,"_5":15036,"_28646":2355,"_3122":55333},[],{"_3731":2364,"_31485":2355,"_21804":58685,"_5":15036,"_28646":2355,"_3122":58686},[],"`POST /simplereenroll`",{"_3731":2365,"_31485":2355,"_21804":58688,"_5":15036,"_28646":2355,"_3122":58689},[],"Request a successor to an existing certificate.",{"_3731":2366,"_31485":2355,"_21804":58691,"_5":15036,"_28646":2355,"_3122":58692},[],"See EST (RFC 7030) for client setup, authentication, request formats and optional server-side key generation.",{"_3731":2367,"_31485":2367,"_5":15390,"_3122":58694,"_31812":58695,"_21804":58696,"_28646":2367},"Keys and cryptographic engines",[51373,52911,57109,57110],[],{"_3731":2368,"_31485":2367,"_21804":58698,"_5":15036,"_28646":2367,"_3122":58699},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3731":2369,"_31485":2367,"_5":31809,"_21804":58701,"_28646":58702,"_3122":58703},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3731":2370,"_31485":2367,"_5":31809,"_21804":58705,"_28646":58706,"_3122":58707},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3731":2371,"_31485":2367,"_5":31809,"_21804":58709,"_28646":58710,"_3122":58711},[],"/docs/platform/pki/key-management#file-system","File System",{"_3731":2372,"_31485":2367,"_5":31809,"_21804":58713,"_28646":58714,"_3122":58715},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3731":2373,"_31485":2367,"_5":31809,"_21804":58717,"_28646":58718,"_3122":58719},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3731":2374,"_31485":2367,"_5":31809,"_21804":58721,"_28646":58722,"_3122":58723},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3731":2375,"_31485":2367,"_5":31809,"_21804":58725,"_28646":58726,"_3122":58727},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3731":2376,"_31485":2367,"_5":31809,"_21804":58729,"_28646":58730,"_3122":58731},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3731":2377,"_31485":2367,"_5":31809,"_21804":58733,"_28646":58734,"_3122":58735},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3731":2378,"_31485":2367,"_5":31809,"_21804":58737,"_28646":58738,"_3122":58739},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3731":2379,"_31485":2367,"_5":31809,"_21804":58741,"_28646":58742,"_3122":58743},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3731":2380,"_31485":2367,"_5":31809,"_21804":58745,"_28646":58746,"_3122":58747},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3731":2381,"_31485":2367,"_5":31809,"_21804":58749,"_28646":58750,"_3122":58751},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3731":2382,"_31485":2367,"_5":31809,"_21804":58753,"_28646":58754,"_3122":58755},[],"/docs/platform/pki/key-management#view-details","View details",{"_3731":2383,"_31485":2367,"_5":31809,"_21804":58757,"_28646":58758,"_3122":58759},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3731":2384,"_31485":2367,"_5":31809,"_21804":58761,"_28646":58762,"_3122":58763},[],"/docs/platform/pki/key-management#sign","Sign",{"_3731":2385,"_31485":2367,"_5":31809,"_21804":58765,"_28646":58766,"_3122":58767},[],"/docs/platform/pki/key-management#verify","Verify",{"_3731":2386,"_31485":2367,"_5":31809,"_21804":58769,"_28646":58770,"_3122":58771},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3731":2387,"_31485":2367,"_5":31809,"_21804":58773,"_28646":58774,"_3122":58775},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3731":2388,"_31485":2367,"_5":31809,"_21804":58777,"_28646":58778,"_3122":58779},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3731":2389,"_31485":2367,"_21804":58781,"_5":15036,"_28646":2367,"_3122":58782},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3731":2390,"_31485":2367,"_21804":58784,"_5":15036,"_28646":2367,"_3122":58785},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3731":2391,"_31485":2367,"_21804":58787,"_5":15036,"_28646":58702,"_3122":58788},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3731":2392,"_31485":2367,"_21804":58790,"_5":15036,"_28646":58702,"_3122":58791},[],"In practice, it lets you:",{"_3731":2393,"_31485":2367,"_21804":58793,"_5":15036,"_28646":58702,"_3122":58794},[],"Generate new key pairs from Lamassu IoT.",{"_3731":2394,"_31485":2367,"_21804":58796,"_5":15036,"_28646":58702,"_3122":58797},[],"Import keys created externally.",{"_3731":2395,"_31485":2367,"_21804":58799,"_5":15036,"_28646":58702,"_3122":58800},[],"Delegate custody and cryptographic operations to external engines.",{"_3731":2396,"_31485":2367,"_21804":58802,"_5":15036,"_28646":58702,"_3122":58803},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3731":2397,"_31485":2367,"_21804":58805,"_5":15036,"_28646":58706,"_3122":58806},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3731":2398,"_31485":2367,"_21804":58808,"_5":15036,"_28646":58706,"_3122":58809},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3731":2399,"_31485":2367,"_21804":58811,"_5":15036,"_28646":58706,"_3122":58812},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3731":2400,"_31485":2367,"_21804":58814,"_5":15036,"_28646":58710,"_3122":58815},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3731":2401,"_31485":2367,"_21804":58817,"_5":15036,"_28646":58714,"_3122":58818},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3731":2402,"_31485":2367,"_21804":58820,"_5":15036,"_28646":58714,"_3122":58821},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3731":2403,"_31485":2367,"_21804":58823,"_5":15036,"_28646":58718,"_3122":58824},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3731":2404,"_31485":2367,"_21804":58826,"_5":15036,"_28646":58722,"_3122":58827},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3731":2405,"_31485":2367,"_21804":58829,"_5":15036,"_28646":58726,"_3122":58830},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3731":2406,"_31485":2367,"_21804":58832,"_5":15036,"_28646":58730,"_3122":58833},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3731":2407,"_31485":2367,"_21804":58835,"_5":15036,"_28646":58730,"_3122":58836},[],"Lamassu shows the enabled engines in the console.",{"_3731":2408,"_31485":2367,"_21804":58838,"_5":15036,"_28646":58730,"_3122":58839},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3731":2409,"_31485":2367,"_21804":58841,"_5":15036,"_28646":58730,"_3122":58842},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3731":2410,"_31485":2367,"_21804":58844,"_5":15036,"_28646":58734,"_3122":58845},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3731":2411,"_31485":2367,"_21804":58847,"_5":15036,"_28646":58734,"_3122":58848},[],"The table includes the following fields:",{"_3731":2412,"_31485":2367,"_21804":58850,"_5":15036,"_28646":58734,"_3122":58851},[],"**Name**: descriptive name of the key.",{"_3731":2413,"_31485":2367,"_21804":58853,"_5":15036,"_28646":58734,"_3122":58854},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3731":2414,"_31485":2367,"_21804":58856,"_5":15036,"_28646":58734,"_3122":58857},[],"**Strength**: visual indicator of cryptographic strength.",{"_3731":2415,"_31485":2367,"_21804":58859,"_5":15036,"_28646":58734,"_3122":58860},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3731":2416,"_31485":2367,"_21804":58862,"_5":15036,"_28646":58734,"_3122":58863},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3731":2417,"_31485":2367,"_21804":58865,"_5":15036,"_28646":58734,"_3122":58866},[],"**Aliases**: alternative names associated with the key.",{"_3731":2418,"_31485":2367,"_21804":58868,"_5":15036,"_28646":58734,"_3122":58869},[],"**Tags**: labels for classification and search.",{"_3731":2419,"_31485":2367,"_21804":58871,"_5":15036,"_28646":58734,"_3122":58872},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3731":2420,"_31485":2367,"_21804":58874,"_5":15036,"_28646":58734,"_3122":58875},[],"From this view you also reach the most common actions:",{"_3731":2421,"_31485":2367,"_21804":58877,"_5":15036,"_28646":58734,"_3122":58878},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3731":2422,"_31485":2367,"_21804":58880,"_5":15036,"_28646":58734,"_3122":58881},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3731":2423,"_31485":2367,"_21804":58883,"_5":15036,"_28646":58734,"_3122":58884},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3731":2424,"_31485":2367,"_21804":58886,"_5":15036,"_28646":58734,"_3122":58887},[],"**Delete Key** to remove the key from the system.",{"_3731":2425,"_31485":2367,"_21804":58889,"_5":15036,"_28646":58738,"_3122":58890},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3731":2426,"_31485":2367,"_21804":58892,"_5":15036,"_28646":58742,"_3122":58893},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3731":2427,"_31485":2367,"_21804":58895,"_5":15036,"_28646":58742,"_3122":58896},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3731":2428,"_31485":2367,"_21804":58898,"_5":15036,"_28646":58742,"_3122":58899},[],"**Key Name**: unique and descriptive name.",{"_3731":2429,"_31485":2367,"_21804":58901,"_5":15036,"_28646":58742,"_3122":58902},[],"**Crypto Engine**: engine that will keep the key.",{"_3731":2430,"_31485":2367,"_21804":58904,"_5":15036,"_28646":58742,"_3122":58905},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3731":2431,"_31485":2367,"_21804":58907,"_5":15036,"_28646":58742,"_3122":58908},[],"**Tags**: metadata to classify the key.",{"_3731":2432,"_31485":2367,"_21804":58910,"_5":15036,"_28646":58742,"_3122":58911},[],"**Metadata**: additional information for advanced uses.",{"_3731":2433,"_31485":2367,"_21804":58913,"_5":15036,"_28646":58746,"_3122":58914},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3731":2434,"_31485":2367,"_21804":58916,"_5":15036,"_28646":58746,"_3122":58917},[],"When you have an exportable private key and the destination engine supports import.",{"_3731":2435,"_31485":2367,"_21804":58919,"_5":15036,"_28646":58746,"_3122":58920},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3731":2436,"_31485":2367,"_21804":58922,"_5":15036,"_28646":58746,"_3122":58923},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3731":2437,"_31485":2367,"_21804":58925,"_5":15036,"_28646":58746,"_3122":58926},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3731":2438,"_31485":2367,"_21804":58928,"_5":15036,"_28646":58746,"_3122":58929},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3731":2439,"_31485":2367,"_21804":58931,"_5":15036,"_28646":58746,"_3122":58932},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3731":2440,"_31485":2367,"_21804":58934,"_5":15036,"_28646":58746,"_3122":58935},[],"**Tags**: labels for organization and search.",{"_3731":2441,"_31485":2367,"_21804":58937,"_5":15036,"_28646":58746,"_3122":58938},[],"**Metadata**: additional optional information.",{"_3731":2442,"_31485":2367,"_21804":58940,"_5":15036,"_28646":58746,"_3122":58941},[],"**Private Key (PEM)**: private key in PEM format.",{"_3731":2443,"_31485":2367,"_21804":58943,"_5":15036,"_28646":58746,"_3122":58944},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3731":2444,"_31485":2367,"_21804":58946,"_5":15036,"_28646":58750,"_3122":58947},[],"Each registered key has a detail view and several operational actions.",{"_3731":2445,"_31485":2367,"_21804":58949,"_5":15036,"_28646":58754,"_3122":58950},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3731":2446,"_31485":2367,"_21804":58952,"_5":15036,"_28646":58754,"_3122":58953},[],"The **Overview** tab shows, among others, these fields:",{"_3731":2447,"_31485":2367,"_21804":58955,"_5":15036,"_28646":58754,"_3122":58956},[],"**Key Name**: descriptive name.",{"_3731":2448,"_31485":2367,"_21804":58958,"_5":15036,"_28646":58754,"_3122":58959},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3731":2449,"_31485":2367,"_21804":58961,"_5":15036,"_28646":58754,"_3122":58962},[],"**Tags**: associated labels.",{"_3731":2450,"_31485":2367,"_21804":58964,"_5":15036,"_28646":58754,"_3122":58965},[],"**Aliases**: alternative names.",{"_3731":2451,"_31485":2367,"_21804":58967,"_5":15036,"_28646":58754,"_3122":58968},[],"**Crypto Engine**: engine where the key resides.",{"_3731":2452,"_31485":2367,"_21804":58970,"_5":15036,"_28646":58754,"_3122":58971},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3731":2453,"_31485":2367,"_21804":58973,"_5":15036,"_28646":58754,"_3122":58974},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3731":2454,"_31485":2367,"_21804":58976,"_5":15036,"_28646":58754,"_3122":58977},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3731":2455,"_31485":2367,"_21804":58979,"_5":15036,"_28646":58758,"_3122":58980},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3731":2456,"_31485":2367,"_21804":58982,"_5":15036,"_28646":58758,"_3122":58983},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3731":2457,"_31485":2367,"_21804":58985,"_5":15036,"_28646":58758,"_3122":58986},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3731":2458,"_31485":2367,"_21804":58988,"_5":15036,"_28646":58762,"_3122":58989},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3731":2459,"_31485":2367,"_21804":58991,"_5":15036,"_28646":58762,"_3122":58992},[],"Main fields:",{"_3731":2460,"_31485":2367,"_21804":58994,"_5":15036,"_28646":58762,"_3122":58995},[],"**Algorithm**: signing algorithm available for the key type.",{"_3731":2461,"_31485":2367,"_21804":58997,"_5":15036,"_28646":58762,"_3122":58998},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3731":2462,"_31485":2367,"_21804":59000,"_5":15036,"_28646":58762,"_3122":59001},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3731":2463,"_31485":2367,"_21804":59003,"_5":15036,"_28646":58762,"_3122":59004},[],"**Message**: content to sign.",{"_3731":2464,"_31485":2367,"_21804":59006,"_5":15036,"_28646":58762,"_3122":59007},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3731":2465,"_31485":2367,"_21804":59009,"_5":15036,"_28646":58766,"_3122":59010},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3731":2466,"_31485":2367,"_21804":59012,"_5":15036,"_28646":58766,"_3122":58992},[],{"_3731":2467,"_31485":2367,"_21804":59014,"_5":15036,"_28646":58766,"_3122":59015},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3731":2468,"_31485":2367,"_21804":59017,"_5":15036,"_28646":58766,"_3122":59018},[],"**Message Type**: `Raw` or `Digest`.",{"_3731":2469,"_31485":2367,"_21804":59020,"_5":15036,"_28646":58766,"_3122":59021},[],"**Payload Encoding**: encoding of the message.",{"_3731":2470,"_31485":2367,"_21804":59023,"_5":15036,"_28646":58766,"_3122":59024},[],"**Message**: original message or hash.",{"_3731":2471,"_31485":2367,"_21804":59026,"_5":15036,"_28646":58766,"_3122":59027},[],"**Signature**: signature to check.",{"_3731":2472,"_31485":2367,"_21804":59029,"_5":15036,"_28646":58766,"_3122":59030},[],"**Result**: indicator of the validation result.",{"_3731":2473,"_31485":2367,"_21804":59032,"_5":15036,"_28646":58770,"_3122":59033},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3731":2474,"_31485":2367,"_21804":59035,"_5":15036,"_28646":58770,"_3122":59036},[],"This flow is useful for:",{"_3731":2475,"_31485":2367,"_21804":59038,"_5":15036,"_28646":58770,"_3122":59039},[],"Requesting certificates from an external CA.",{"_3731":2476,"_31485":2367,"_21804":59041,"_5":15036,"_28646":58770,"_3122":59042},[],"Renewing an identity while keeping the same key.",{"_3731":2477,"_31485":2367,"_21804":59044,"_5":15036,"_28646":58770,"_3122":59045},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3731":2478,"_31485":2367,"_21804":59047,"_5":15036,"_28646":58770,"_3122":59048},[],"**Common Name (CN)**: main name of the identity.",{"_3731":2479,"_31485":2367,"_21804":59050,"_5":15036,"_28646":58770,"_3122":59051},[],"**Organization (O)**: organization or company.",{"_3731":2480,"_31485":2367,"_21804":59053,"_5":15036,"_28646":58770,"_3122":59054},[],"**Organizational Unit (OU)**: department or unit.",{"_3731":2481,"_31485":2367,"_21804":59056,"_5":15036,"_28646":58770,"_3122":59057},[],"**Country (C)**: two-letter country code.",{"_3731":2482,"_31485":2367,"_21804":59059,"_5":15036,"_28646":58770,"_3122":59060},[],"**State / Province (ST)**: state or province.",{"_3731":2483,"_31485":2367,"_21804":59062,"_5":15036,"_28646":58770,"_3122":59063},[],"**Locality (L)**: city or locality.",{"_3731":2484,"_31485":2367,"_21804":59065,"_5":15036,"_28646":58770,"_3122":59066},[],"**Email Address**: contact email.",{"_3731":2485,"_31485":2367,"_21804":59068,"_5":15036,"_28646":58770,"_3122":59069},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3731":2486,"_31485":2367,"_21804":59071,"_5":15036,"_28646":58770,"_3122":59072},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3731":2487,"_31485":2367,"_21804":59074,"_5":15036,"_28646":58774,"_3122":59075},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3731":2488,"_31485":2367,"_21804":59077,"_5":15036,"_28646":58774,"_3122":59078},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3731":2489,"_31485":2367,"_21804":59080,"_5":15036,"_28646":58778,"_3122":59081},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3731":2490,"_31485":2367,"_21804":59083,"_5":15036,"_28646":58778,"_3122":59084},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3731":2491,"_31485":2491,"_5":15390,"_3122":59086,"_31812":59087,"_21804":59088,"_28646":2491},"Online validation with OCSP",[51373,52911,57109,57782],[],{"_3731":2492,"_31485":2491,"_21804":59090,"_5":15036,"_28646":2491,"_3122":59091},[],"Query signed status and verify the responder’s response.",{"_3731":2493,"_31485":2491,"_5":31809,"_21804":59093,"_28646":59094,"_3122":59095},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3731":2494,"_31485":2491,"_5":31809,"_21804":59097,"_28646":59098,"_3122":59099},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3731":2495,"_31485":2491,"_5":31809,"_21804":59101,"_28646":59102,"_3122":59103},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3731":2496,"_31485":2491,"_5":31809,"_21804":59105,"_28646":59106,"_3122":59107},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3731":2497,"_31485":2491,"_5":31809,"_21804":59109,"_28646":59110,"_3122":59111},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3731":2498,"_31485":2491,"_5":31809,"_21804":59113,"_28646":59114,"_3122":58347},[],"/docs/platform/pki/ocsp#references",{"_3731":2499,"_31485":2491,"_21804":59116,"_5":15036,"_28646":2491,"_3122":59117},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3731":2500,"_31485":2491,"_21804":59119,"_5":15036,"_28646":59094,"_3122":59120},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3731":2501,"_31485":2491,"_21804":59122,"_5":15036,"_28646":59094,"_3122":59123},[],"Record status",{"_3731":2502,"_31485":2491,"_21804":59125,"_5":15036,"_28646":59094,"_3122":59126},[],"Signed response",{"_3731":2503,"_31485":2491,"_21804":59128,"_5":15036,"_28646":59094,"_3122":56245},[],{"_3731":2504,"_31485":2491,"_21804":59130,"_5":15036,"_28646":59094,"_3122":59131},[],"`Good`.",{"_3731":2505,"_31485":2491,"_21804":59133,"_5":15036,"_28646":59094,"_3122":56262},[],{"_3731":2506,"_31485":2491,"_21804":59135,"_5":15036,"_28646":59094,"_3122":59136},[],"`Revoked`, with revocation reason and timestamp.",{"_3731":2507,"_31485":2491,"_21804":59138,"_5":15036,"_28646":59094,"_3122":59139},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3731":2508,"_31485":2491,"_21804":59141,"_5":15036,"_28646":59094,"_3122":59142},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3731":2509,"_31485":2491,"_21804":59144,"_5":15036,"_28646":59094,"_3122":59145},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3731":2510,"_31485":2491,"_21804":59147,"_5":15036,"_28646":59094,"_3122":59148},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3731":2511,"_31485":2491,"_21804":59150,"_5":15036,"_28646":59094,"_3122":59151},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3731":2512,"_31485":2491,"_21804":59153,"_5":15036,"_28646":59098,"_3122":59154},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3731":2513,"_31485":2491,"_21804":59156,"_5":15036,"_28646":59098,"_3122":59157},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3731":2514,"_31485":2491,"_21804":59159,"_5":15036,"_28646":59102,"_3122":59160},[],"The service accepts:",{"_3731":2515,"_31485":2491,"_21804":59162,"_5":15036,"_28646":59102,"_3122":54701},[],{"_3731":2516,"_31485":2491,"_21804":59164,"_5":15036,"_28646":59102,"_3122":59165},[],"VA service path",{"_3731":2517,"_31485":2491,"_21804":59167,"_5":15036,"_28646":59102,"_3122":59168},[],"Format",{"_3731":2518,"_31485":2491,"_21804":59170,"_5":15036,"_28646":59102,"_3122":59171},[],"`POST`",{"_3731":2519,"_31485":2491,"_21804":59173,"_5":15036,"_28646":59102,"_3122":59174},[],"`/ocsp`",{"_3731":2520,"_31485":2491,"_21804":59176,"_5":15036,"_28646":59102,"_3122":59177},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3731":2521,"_31485":2491,"_21804":59179,"_5":15036,"_28646":59102,"_3122":58531},[],{"_3731":2522,"_31485":2491,"_21804":59181,"_5":15036,"_28646":59102,"_3122":59182},[],"`/ocsp/{ocsp_request}`",{"_3731":2523,"_31485":2491,"_21804":59184,"_5":15036,"_28646":59102,"_3122":59185},[],"DER request encoded using padded URL Base64.",{"_3731":2524,"_31485":2491,"_21804":59187,"_5":15036,"_28646":59102,"_3122":59188},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3731":2525,"_31485":2491,"_21804":59190,"_5":15036,"_28646":59106,"_3122":59191},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3731":2526,"_31485":2491,"_21804":59193,"_5":15036,"_28646":59106,"_3122":59194},[],"Generate the request:",{"_3731":2527,"_31485":2491,"_21804":59196,"_5":15036,"_28646":59106,"_3122":59197},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3731":2528,"_31485":2491,"_21804":59199,"_5":15036,"_28646":59106,"_3122":59200},[],"Replace the example URL with the inspected endpoint:",{"_3731":2529,"_31485":2491,"_21804":59202,"_5":15036,"_28646":59106,"_3122":59203},[],"Verify the returned DER:",{"_3731":2530,"_31485":2491,"_21804":59205,"_5":15036,"_28646":59106,"_3122":59206},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3731":2531,"_31485":2491,"_21804":59208,"_5":15036,"_28646":59110,"_3122":59209},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3731":2532,"_31485":2491,"_21804":59211,"_5":15036,"_28646":59110,"_3122":59212},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3731":2533,"_31485":2491,"_21804":59214,"_5":15036,"_28646":59114,"_3122":59215},[],"RFC 6960: OCSP.",{"_3731":2534,"_31485":2491,"_21804":59217,"_5":15036,"_28646":59114,"_3122":59218},[],"OpenSSL: openssl-ocsp.",{"_3731":2535,"_31485":2491,"_21804":59220,"_5":15036,"_28646":59114,"_3122":59221},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3731":2536,"_31485":2491,"_21804":59223,"_5":15036,"_28646":59114,"_3122":58657},[],{"_3731":2537,"_31485":2537,"_5":15390,"_3122":57109,"_31812":59225,"_21804":59226,"_28646":2537},[51373,52911,57109],[],{"_3731":2538,"_31485":2537,"_21804":59228,"_5":15036,"_28646":2537,"_3122":59229},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3731":2539,"_31485":2537,"_5":31809,"_21804":59231,"_28646":59232,"_3122":56420},[],"/docs/platform/pki/overview#start-here",{"_3731":2540,"_31485":2537,"_5":31809,"_21804":59234,"_28646":59235,"_3122":59236},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3731":2541,"_31485":2537,"_5":31809,"_21804":59238,"_28646":59239,"_3122":56953},[],"/docs/platform/pki/overview#core-capabilities",{"_3731":2542,"_31485":2537,"_5":31809,"_21804":59241,"_28646":59242,"_3122":56957},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3731":2543,"_31485":2537,"_5":31809,"_21804":59244,"_28646":59245,"_3122":56961},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3731":2544,"_31485":2537,"_5":31809,"_21804":59247,"_28646":59248,"_3122":56965},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3731":2545,"_31485":2537,"_5":31809,"_21804":59250,"_28646":59251,"_3122":56973},[],"/docs/platform/pki/overview#publish-validation-status",{"_3731":2546,"_31485":2537,"_5":31809,"_21804":59253,"_28646":59254,"_3122":59255},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3731":2547,"_31485":2537,"_5":31809,"_21804":59257,"_28646":59258,"_3122":57949},[],"/docs/platform/pki/overview#continue",{"_3731":2548,"_31485":2537,"_21804":59260,"_5":15036,"_28646":2537,"_3122":59261},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3731":2549,"_31485":2537,"_21804":59263,"_5":15036,"_28646":59232,"_3122":59264},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3731":2550,"_31485":2537,"_21804":59266,"_5":15036,"_28646":59232,"_3122":59267},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3731":2551,"_31485":2537,"_21804":59269,"_5":15036,"_28646":59235,"_3122":59270},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3731":2552,"_31485":2537,"_21804":59272,"_5":15036,"_28646":59235,"_3122":59273},[],"An available cryptographic engine to keep the authority's key.",{"_3731":2553,"_31485":2537,"_21804":59275,"_5":15036,"_28646":59235,"_3122":59276},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3731":2554,"_31485":2537,"_21804":59278,"_5":15036,"_28646":59235,"_3122":59279},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3731":2555,"_31485":2537,"_21804":59281,"_5":15036,"_28646":59235,"_3122":59282},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3731":2556,"_31485":2537,"_21804":59284,"_5":15036,"_28646":59242,"_3122":59285},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3731":2557,"_31485":2537,"_21804":59287,"_5":15036,"_28646":59245,"_3122":59288},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3731":2558,"_31485":2537,"_21804":59290,"_5":15036,"_28646":59248,"_3122":59291},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3731":2559,"_31485":2537,"_21804":59293,"_5":15036,"_28646":59248,"_3122":59294},[],"Enrollment protocols let clients obtain and renew certificates from a Lamassu CA.",{"_3731":2560,"_31485":2537,"_21804":59296,"_5":15036,"_28646":59251,"_3122":59297},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3731":2561,"_31485":2537,"_21804":59299,"_5":15036,"_28646":59254,"_3122":59300},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3731":2562,"_31485":2537,"_21804":59302,"_5":15036,"_28646":59254,"_3122":59303},[],"its subject and extensions identify the expected client;",{"_3731":2563,"_31485":2537,"_21804":59305,"_5":15036,"_28646":59254,"_3122":59306},[],"its public key matches the client's private key;",{"_3731":2564,"_31485":2537,"_21804":59308,"_5":15036,"_28646":59254,"_3122":59309},[],"its chain reaches a root trusted by the consumer;",{"_3731":2565,"_31485":2537,"_21804":59311,"_5":15036,"_28646":59254,"_3122":59312},[],"its dates and usages allow the operation;",{"_3731":2566,"_31485":2537,"_21804":59314,"_5":15036,"_28646":59254,"_3122":59315},[],"the consumer applies revocation checks and authorization.",{"_3731":2567,"_31485":2537,"_21804":59317,"_5":15036,"_28646":59254,"_3122":59318},[],"The issuance path includes the first independent checks.",{"_3731":2568,"_31485":2537,"_21804":59320,"_5":15036,"_28646":59258,"_3122":59321},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3731":2569,"_31485":2537,"_21804":59323,"_5":15036,"_28646":59258,"_3122":59324},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3731":2570,"_31485":2537,"_21804":59326,"_5":15036,"_28646":59258,"_3122":59327},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3731":2571,"_31485":2571,"_5":15390,"_3122":59329,"_31812":59330,"_21804":59331,"_28646":2571},"Create your first CA",[51373,52911,57109,56545],[],{"_3731":2572,"_31485":2571,"_21804":59333,"_5":15036,"_28646":2571,"_3122":59334},[],"Create an evaluation root and check its certificate before issuing.",{"_3731":2573,"_31485":2571,"_5":31809,"_21804":59336,"_28646":59337,"_3122":51383},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3731":2574,"_31485":2571,"_5":31809,"_21804":59339,"_28646":59340,"_3122":59341},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3731":2575,"_31485":2571,"_5":31809,"_21804":59343,"_28646":59344,"_3122":59345},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3731":2576,"_31485":2571,"_5":31809,"_21804":59347,"_28646":59348,"_3122":59349},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3731":2577,"_31485":2571,"_5":31809,"_21804":59351,"_28646":59352,"_3122":59353},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3731":2578,"_31485":2571,"_5":31809,"_21804":59355,"_28646":59356,"_3122":59357},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3731":2579,"_31485":2571,"_5":31809,"_21804":59359,"_28646":59360,"_3122":59361},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3731":2580,"_31485":2571,"_5":31809,"_21804":59363,"_28646":59364,"_3122":56803},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3731":2581,"_31485":2571,"_5":31809,"_21804":59366,"_28646":59367,"_3122":51407},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3731":2582,"_31485":2571,"_21804":59369,"_5":15036,"_28646":2571,"_3122":59370},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3731":2583,"_31485":2571,"_21804":59372,"_5":15036,"_28646":59337,"_3122":59373},[],"Console access and permission to create keys and authorities.",{"_3731":2584,"_31485":2571,"_21804":59375,"_5":15036,"_28646":59337,"_3122":59376},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3731":2585,"_31485":2571,"_21804":59378,"_5":15036,"_28646":59337,"_3122":59379},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3731":2586,"_31485":2571,"_21804":59381,"_5":15036,"_28646":59337,"_3122":59382},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3731":2587,"_31485":2571,"_21804":59384,"_5":15036,"_28646":59340,"_3122":59385},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3731":2588,"_31485":2571,"_21804":59387,"_5":15036,"_28646":59340,"_3122":59388},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3731":2589,"_31485":2571,"_21804":59390,"_5":15036,"_28646":59344,"_3122":59391},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3731":2590,"_31485":2571,"_21804":59393,"_5":15036,"_28646":59344,"_3122":59394},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3731":2591,"_31485":2571,"_21804":59396,"_5":15036,"_28646":59348,"_3122":59397},[],"Select **Root CA** and complete:",{"_3731":2592,"_31485":2571,"_21804":59399,"_5":15036,"_28646":59348,"_3122":59400},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3731":2593,"_31485":2571,"_21804":59402,"_5":15036,"_28646":59348,"_3122":59403},[],"**Subject**: organization and country details for your evaluation.",{"_3731":2594,"_31485":2571,"_21804":59405,"_5":15036,"_28646":59348,"_3122":59406},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3731":2595,"_31485":2571,"_21804":59408,"_5":15036,"_28646":59348,"_3122":59409},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3731":2596,"_31485":2571,"_21804":59411,"_5":15036,"_28646":59348,"_3122":59412},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3731":2597,"_31485":2571,"_21804":59414,"_5":15036,"_28646":59352,"_3122":59415},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3731":2598,"_31485":2571,"_21804":59417,"_5":15036,"_28646":59356,"_3122":59418},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3731":2599,"_31485":2571,"_21804":59420,"_5":15036,"_28646":59356,"_3122":59421},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3731":2600,"_31485":2571,"_21804":59423,"_5":15036,"_28646":59360,"_3122":59424},[],"Run from the directory where you saved `ca.pem`:",{"_3731":2601,"_31485":2571,"_21804":59426,"_5":15036,"_28646":59360,"_3122":59427},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3731":2602,"_31485":2571,"_21804":59429,"_5":15036,"_28646":59360,"_3122":59430},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3731":2603,"_31485":2571,"_21804":59432,"_5":15036,"_28646":59364,"_3122":59433},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3731":2604,"_31485":2571,"_21804":59435,"_5":15036,"_28646":59364,"_3122":59436},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3731":2605,"_31485":2571,"_21804":59438,"_5":15036,"_28646":59364,"_3122":59439},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3731":2606,"_31485":2571,"_21804":59441,"_5":15036,"_28646":59364,"_3122":59442},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3731":2607,"_31485":2571,"_21804":59444,"_5":15036,"_28646":59367,"_3122":59445},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3731":2608,"_31485":2608,"_5":15390,"_3122":59447,"_31812":59448,"_21804":59449,"_28646":2608},"Issue and verify a certificate",[51373,52911,57109,56545],[],{"_3731":2609,"_31485":2608,"_21804":59451,"_5":15036,"_28646":2608,"_3122":59452},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3731":2610,"_31485":2608,"_5":31809,"_21804":59454,"_28646":59455,"_3122":51383},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3731":2611,"_31485":2608,"_5":31809,"_21804":59457,"_28646":59458,"_3122":59459},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3731":2612,"_31485":2608,"_5":31809,"_21804":59461,"_28646":59462,"_3122":59463},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3731":2613,"_31485":2608,"_5":31809,"_21804":59465,"_28646":59466,"_3122":59467},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3731":2614,"_31485":2608,"_5":31809,"_21804":59469,"_28646":59470,"_3122":59471},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3731":2615,"_31485":2608,"_5":31809,"_21804":59473,"_28646":59474,"_3122":59475},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3731":2616,"_31485":2608,"_5":31809,"_21804":59477,"_28646":59478,"_3122":59479},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3731":2617,"_31485":2608,"_5":31809,"_21804":59481,"_28646":59482,"_3122":59483},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3731":2618,"_31485":2608,"_5":31809,"_21804":59485,"_28646":59486,"_3122":59487},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3731":2619,"_31485":2608,"_5":31809,"_21804":59489,"_28646":59490,"_3122":59491},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3731":2620,"_31485":2608,"_5":31809,"_21804":59493,"_28646":59494,"_3122":56803},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3731":2621,"_31485":2608,"_5":31809,"_21804":59496,"_28646":59497,"_3122":51407},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3731":2622,"_31485":2608,"_21804":59499,"_5":15036,"_28646":2608,"_3122":59500},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3731":2623,"_31485":2608,"_21804":59502,"_5":15036,"_28646":59455,"_3122":59503},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3731":2624,"_31485":2608,"_21804":59505,"_5":15036,"_28646":59455,"_3122":59506},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3731":2625,"_31485":2608,"_21804":59508,"_5":15036,"_28646":59455,"_3122":59509},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3731":2626,"_31485":2608,"_21804":59511,"_5":15036,"_28646":59455,"_3122":59512},[],"A client identifier: here we use `device-001`.",{"_3731":2627,"_31485":2608,"_21804":59514,"_5":15036,"_28646":59455,"_3122":59515},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3731":2628,"_31485":2608,"_21804":59517,"_5":15036,"_28646":59458,"_3122":59518},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3731":2629,"_31485":2608,"_21804":59520,"_5":15036,"_28646":59462,"_3122":59521},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3731":2630,"_31485":2608,"_21804":59523,"_5":15036,"_28646":59462,"_3122":59524},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3731":2631,"_31485":2608,"_21804":59526,"_5":15036,"_28646":59466,"_3122":59527},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3731":2632,"_31485":2608,"_21804":59529,"_5":15036,"_28646":59466,"_3122":59530},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3731":2633,"_31485":2608,"_21804":59532,"_5":15036,"_28646":59470,"_3122":59533},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3731":2634,"_31485":2608,"_21804":59535,"_5":15036,"_28646":59470,"_3122":59536},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3731":2635,"_31485":2608,"_21804":59538,"_5":15036,"_28646":59474,"_3122":59539},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3731":2636,"_31485":2608,"_21804":59541,"_5":15036,"_28646":59478,"_3122":59542},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3731":2637,"_31485":2608,"_21804":59544,"_5":15036,"_28646":59482,"_3122":59545},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3731":2638,"_31485":2608,"_21804":59547,"_5":15036,"_28646":59486,"_3122":59548},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3731":2639,"_31485":2608,"_21804":59550,"_5":15036,"_28646":59486,"_3122":59551},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3731":2640,"_31485":2608,"_21804":59553,"_5":15036,"_28646":59486,"_3122":59554},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3731":2641,"_31485":2608,"_21804":59556,"_5":15036,"_28646":59490,"_3122":59557},[],"In Bash, compare the two public-key digests:",{"_3731":2642,"_31485":2608,"_21804":59559,"_5":15036,"_28646":59490,"_3122":59560},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3731":2643,"_31485":2608,"_21804":59562,"_5":15036,"_28646":59490,"_3122":59563},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3731":2644,"_31485":2608,"_21804":59565,"_5":15036,"_28646":59494,"_3122":56887},[],{"_3731":2645,"_31485":2608,"_21804":59567,"_5":15036,"_28646":59494,"_3122":59568},[],"What to review",{"_3731":2646,"_31485":2608,"_21804":59570,"_5":15036,"_28646":59494,"_3122":59571},[],"The CA rejects issuance",{"_3731":2647,"_31485":2608,"_21804":59573,"_5":15036,"_28646":59494,"_3122":59574},[],"Permissions, CA state and key, algorithm and profile.",{"_3731":2648,"_31485":2608,"_21804":59576,"_5":15036,"_28646":59494,"_3122":59577},[],"Different subject or usages",{"_3731":2649,"_31485":2608,"_21804":59579,"_5":15036,"_28646":59494,"_3122":59580},[],"Applied profile and requested values.",{"_3731":2650,"_31485":2608,"_21804":59582,"_5":15036,"_28646":59494,"_3122":59583},[],"Issuer cannot be found",{"_3731":2651,"_31485":2608,"_21804":59585,"_5":15036,"_28646":59494,"_3122":59586},[],"Downloaded CA and required intermediate chain.",{"_3731":2652,"_31485":2608,"_21804":59588,"_5":15036,"_28646":59494,"_3122":59589},[],"Validity fails",{"_3731":2653,"_31485":2608,"_21804":59591,"_5":15036,"_28646":59494,"_3122":59592},[],"Certificate and CA dates, and the computer's clock.",{"_3731":2654,"_31485":2608,"_21804":59594,"_5":15036,"_28646":59494,"_3122":59595},[],"Public-key digests differ",{"_3731":2655,"_31485":2608,"_21804":59597,"_5":15036,"_28646":59494,"_3122":59598},[],"Certificate and key files from the same issuance.",{"_3731":2656,"_31485":2608,"_21804":59600,"_5":15036,"_28646":59494,"_3122":59601},[],"See PKI diagnostics to narrow an issuance failure.",{"_3731":2657,"_31485":2608,"_21804":59603,"_5":15036,"_28646":59497,"_3122":59604},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3731":2658,"_31485":2608,"_21804":59606,"_5":15036,"_28646":59497,"_3122":59607},[],"Manage certificates for inspection, status and revocation.",{"_3731":2659,"_31485":2608,"_21804":59609,"_5":15036,"_28646":59497,"_3122":59610},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3731":2660,"_31485":2608,"_21804":59612,"_5":15036,"_28646":59497,"_3122":59613},[],"Prepare EST for the device to request its next identities.",{"_3731":2661,"_31485":2608,"_21804":59615,"_5":15036,"_28646":59497,"_3122":59616},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3731":2662,"_31485":2662,"_5":15390,"_3122":59618,"_31812":59619,"_21804":59620,"_28646":2662},"PKI getting started",[51373,52911,57109,56545],[],{"_3731":2663,"_31485":2662,"_21804":59622,"_5":15036,"_28646":2662,"_3122":59623},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3731":2664,"_31485":2662,"_5":31809,"_21804":59625,"_28646":59626,"_3122":51383},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3731":2665,"_31485":2662,"_5":31809,"_21804":59628,"_28646":59629,"_3122":59630},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3731":2666,"_31485":2662,"_5":31809,"_21804":59632,"_28646":59633,"_3122":56738},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3731":2667,"_31485":2662,"_5":31809,"_21804":59635,"_28646":59636,"_3122":59637},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3731":2668,"_31485":2662,"_21804":59639,"_5":15036,"_28646":2662,"_3122":59640},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3731":2669,"_31485":2662,"_21804":59642,"_5":15036,"_28646":59626,"_3122":59643},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3731":2670,"_31485":2662,"_21804":59645,"_5":15036,"_28646":59626,"_3122":59646},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3731":2671,"_31485":2662,"_21804":59648,"_5":15036,"_28646":59626,"_3122":59649},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3731":2672,"_31485":2662,"_21804":59651,"_5":15036,"_28646":59626,"_3122":59652},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3731":2673,"_31485":2662,"_21804":59654,"_5":15036,"_28646":59626,"_3122":59655},[],"A working directory with restricted access for the downloaded key.",{"_3731":2674,"_31485":2662,"_21804":59657,"_5":15036,"_28646":59629,"_3122":59658},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3731":2675,"_31485":2662,"_21804":59660,"_5":15036,"_28646":59629,"_3122":59661},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3731":2676,"_31485":2662,"_21804":59663,"_5":15036,"_28646":59629,"_3122":59664},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3731":2677,"_31485":2662,"_21804":59666,"_5":15036,"_28646":59629,"_3122":59667},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3731":2678,"_31485":2662,"_21804":59669,"_5":15036,"_28646":59633,"_3122":59670},[],"File or resource",{"_3731":2679,"_31485":2662,"_21804":59672,"_5":15036,"_28646":59633,"_3122":56735},[],{"_3731":2680,"_31485":2662,"_21804":59674,"_5":15036,"_28646":59633,"_3122":59675},[],"Active root CA and `ca.pem`",{"_3731":2681,"_31485":2662,"_21804":59677,"_5":15036,"_28646":59633,"_3122":59678},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3731":2682,"_31485":2662,"_21804":59680,"_5":15036,"_28646":59633,"_3122":59681},[],"End-entity certificate and `device.crt`",{"_3731":2683,"_31485":2662,"_21804":59683,"_5":15036,"_28646":59633,"_3122":59684},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3731":2684,"_31485":2662,"_21804":59686,"_5":15036,"_28646":59633,"_3122":59687},[],"Private key `device.key`",{"_3731":2685,"_31485":2662,"_21804":59689,"_5":15036,"_28646":59633,"_3122":59690},[],"Its public key matches the one included in `device.crt`.",{"_3731":2686,"_31485":2662,"_21804":59692,"_5":15036,"_28646":59633,"_3122":59693},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3731":2687,"_31485":2662,"_21804":59695,"_5":15036,"_28646":59636,"_3122":59696},[],"To operate certificates, continue with Certificates and Validation.",{"_3731":2688,"_31485":2662,"_21804":59698,"_5":15036,"_28646":59636,"_3122":59699},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3731":2689,"_31485":2662,"_21804":59701,"_5":15036,"_28646":59636,"_3122":59702},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3731":2690,"_31485":2690,"_5":15390,"_3122":59704,"_31812":59705,"_21804":59706,"_28646":2690},"PKI troubleshooting",[51373,52911,57109,55683],[],{"_3731":2691,"_31485":2690,"_21804":59708,"_5":15036,"_28646":2690,"_3122":59709},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3731":2692,"_31485":2690,"_5":31809,"_21804":59711,"_28646":59712,"_3122":59713},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3731":2693,"_31485":2690,"_5":31809,"_21804":59715,"_28646":59716,"_3122":59717},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3731":2694,"_31485":2690,"_5":31809,"_21804":59719,"_28646":59720,"_3122":59721},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3731":2695,"_31485":2690,"_21804":59723,"_5":15036,"_28646":2690,"_3122":59724},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3731":2696,"_31485":2690,"_21804":59726,"_5":15036,"_28646":2690,"_3122":59727},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3731":2697,"_31485":2690,"_21804":59729,"_5":15036,"_28646":59712,"_3122":56735},[],{"_3731":2698,"_31485":2690,"_21804":59731,"_5":15036,"_28646":59712,"_3122":59732},[],"What to inspect",{"_3731":2699,"_31485":2690,"_21804":59734,"_5":15036,"_28646":59712,"_3122":51407},[],{"_3731":2700,"_31485":2690,"_21804":59736,"_5":15036,"_28646":59712,"_3122":55950},[],{"_3731":2701,"_31485":2690,"_21804":59738,"_5":15036,"_28646":59712,"_3122":59739},[],"Exists, is active and has usable dates.",{"_3731":2702,"_31485":2690,"_21804":59741,"_5":15036,"_28646":59712,"_3122":59742},[],"Authorities.",{"_3731":2703,"_31485":2690,"_21804":59744,"_5":15036,"_28646":59712,"_3122":59745},[],"Key",{"_3731":2704,"_31485":2690,"_21804":59747,"_5":15036,"_28646":59712,"_3122":59748},[],"The record has a usable private key and the engine can sign.",{"_3731":2705,"_31485":2690,"_21804":59750,"_5":15036,"_28646":59712,"_3122":59751},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3731":2706,"_31485":2690,"_21804":59753,"_5":15036,"_28646":59712,"_3122":59754},[],"CSR",{"_3731":2707,"_31485":2690,"_21804":59756,"_5":15036,"_28646":59712,"_3122":59757},[],"Correct PEM and verifiable signature.",{"_3731":2708,"_31485":2690,"_21804":59759,"_5":15036,"_28646":59712,"_3122":59760},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3731":2709,"_31485":2690,"_21804":59762,"_5":15036,"_28646":59712,"_3122":59763},[],"Profile",{"_3731":2710,"_31485":2690,"_21804":59765,"_5":15036,"_28646":59712,"_3122":59766},[],"Selected source, existing ID, allowed algorithm and size.",{"_3731":2711,"_31485":2690,"_21804":59768,"_5":15036,"_28646":59712,"_3122":59769},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3731":2712,"_31485":2690,"_21804":59771,"_5":15036,"_28646":59712,"_3122":56887},[],{"_3731":2713,"_31485":2690,"_21804":59773,"_5":15036,"_28646":59712,"_3122":59774},[],"Appropriate subject, SAN, usages and dates.",{"_3731":2714,"_31485":2690,"_21804":59776,"_5":15036,"_28646":59712,"_3122":59777},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3731":2715,"_31485":2690,"_21804":59779,"_5":15036,"_28646":59712,"_3122":59780},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3731":2716,"_31485":2690,"_21804":59782,"_5":15036,"_28646":59712,"_3122":59783},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3731":2717,"_31485":2690,"_21804":59785,"_5":15036,"_28646":59712,"_3122":59786},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3731":2718,"_31485":2690,"_21804":59788,"_5":15036,"_28646":59716,"_3122":59789},[],"Check each boundary independently:",{"_3731":2719,"_31485":2690,"_21804":59791,"_5":15036,"_28646":59716,"_3122":59792},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3731":2720,"_31485":2690,"_21804":59794,"_5":15036,"_28646":59716,"_3122":59795},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3731":2721,"_31485":2690,"_21804":59797,"_5":15036,"_28646":59716,"_3122":59798},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3731":2722,"_31485":2690,"_21804":59800,"_5":15036,"_28646":59716,"_3122":59801},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3731":2723,"_31485":2690,"_21804":59803,"_5":15036,"_28646":59716,"_3122":59804},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3731":2724,"_31485":2690,"_21804":59806,"_5":15036,"_28646":59716,"_3122":59807},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3731":2725,"_31485":2690,"_21804":59809,"_5":15036,"_28646":59720,"_3122":59810},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3731":2726,"_31485":2690,"_21804":59812,"_5":15036,"_28646":59720,"_3122":59813},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3731":2727,"_31485":2727,"_5":15390,"_3122":59815,"_31812":59816,"_21804":59817,"_28646":2727},"Security",[51373],[],{"_3731":2728,"_31485":2727,"_21804":59819,"_5":15036,"_28646":2727,"_3122":59820},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3731":2729,"_31485":2727,"_5":31809,"_21804":59822,"_28646":59823,"_3122":59824},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3731":2730,"_31485":2727,"_5":31809,"_21804":59826,"_28646":59827,"_3122":59828},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3731":2731,"_31485":2727,"_5":31809,"_21804":59830,"_28646":59831,"_3122":59832},[],"/docs/security#supported-versions","Supported versions",{"_3731":2732,"_31485":2727,"_5":31809,"_21804":59834,"_28646":59835,"_3122":59836},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3731":2733,"_31485":2727,"_21804":59838,"_5":15036,"_28646":2727,"_3122":59839},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3731":2734,"_31485":2727,"_21804":59841,"_5":15036,"_28646":59823,"_3122":59842},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3731":2735,"_31485":2727,"_21804":59844,"_5":15036,"_28646":59823,"_3122":59845},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3731":2736,"_31485":2727,"_21804":59847,"_5":15036,"_28646":59823,"_3122":15664},[],{"_3731":2737,"_31485":2727,"_21804":59849,"_5":15036,"_28646":59823,"_3122":15593},[],{"_3731":2738,"_31485":2727,"_21804":59851,"_5":15036,"_28646":59823,"_3122":15651},[],{"_3731":2739,"_31485":2727,"_21804":59853,"_5":15036,"_28646":59823,"_3122":59854},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3731":2740,"_31485":2727,"_21804":59856,"_5":15036,"_28646":59823,"_3122":59857},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3731":2741,"_31485":2727,"_21804":59859,"_5":15036,"_28646":59827,"_3122":59860},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3731":2742,"_31485":2727,"_21804":59862,"_5":15036,"_28646":59827,"_3122":59863},[],"Do not include in the report:",{"_3731":2743,"_31485":2727,"_21804":59865,"_5":15036,"_28646":59827,"_3122":59866},[],"Credentials, tokens, or private keys",{"_3731":2744,"_31485":2727,"_21804":59868,"_5":15036,"_28646":59827,"_3122":59869},[],"Customer data or customer-identifiable information",{"_3731":2745,"_31485":2727,"_21804":59871,"_5":15036,"_28646":59827,"_3122":59872},[],"Confidential architecture or internal infrastructure details",{"_3731":2746,"_31485":2727,"_21804":59874,"_5":15036,"_28646":59831,"_3122":59875},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3731":2747,"_31485":2727,"_21804":59877,"_5":15036,"_28646":59831,"_3122":59878},[],"For upgrade guidance, see Upgrades.",{"_3731":2748,"_31485":2727,"_21804":59880,"_5":15036,"_28646":59835,"_3122":59881},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3731":2749,"_31485":2727,"_21804":59883,"_5":15036,"_28646":59835,"_3122":59884},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3731":2750,"_31485":2727,"_21804":59886,"_5":15036,"_28646":59835,"_3122":59887},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3731":2751,"_31485":2727,"_21804":59889,"_5":15036,"_28646":59835,"_3122":59890},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3731":2752,"_31485":2727,"_21804":59892,"_5":15036,"_28646":59835,"_3122":59893},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3731":2753,"_31485":2753,"_5":15390,"_3122":59895,"_31812":59896,"_21804":59898,"_28646":2753},"3.8.0 to 4.0.0",[51373,59897],"Upgrades",[],{"_3731":2754,"_31485":2753,"_21804":59900,"_5":15036,"_28646":2753,"_3122":59901},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3731":2755,"_31485":2753,"_5":31809,"_21804":59903,"_28646":59904,"_3122":59905},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3731":2756,"_31485":2753,"_5":31809,"_21804":59907,"_28646":59908,"_3122":59909},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3731":2757,"_31485":2753,"_5":31809,"_21804":59911,"_28646":59912,"_3122":59913},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3731":2758,"_31485":2753,"_5":31809,"_21804":59915,"_28646":59916,"_3122":59917},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3731":2759,"_31485":2753,"_5":31809,"_21804":59919,"_28646":59920,"_3122":59921},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3731":2760,"_31485":2753,"_5":31809,"_21804":59923,"_28646":59924,"_3122":59925},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3731":2761,"_31485":2753,"_5":31809,"_21804":59927,"_28646":59928,"_3122":59929},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3731":2762,"_31485":2753,"_5":31809,"_21804":59931,"_28646":59932,"_3122":59933},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3731":2763,"_31485":2753,"_5":31809,"_21804":59935,"_28646":59936,"_3122":59937},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3731":2764,"_31485":2753,"_5":31809,"_21804":59939,"_28646":59940,"_3122":59941},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3731":2765,"_31485":2753,"_5":31809,"_21804":59943,"_28646":59944,"_3122":52011},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3731":2766,"_31485":2753,"_5":31809,"_21804":59946,"_28646":59947,"_3122":59948},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3731":2767,"_31485":2753,"_5":31809,"_21804":59950,"_28646":59951,"_3122":59952},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3731":2768,"_31485":2753,"_5":31809,"_21804":59954,"_28646":59955,"_3122":59956},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3731":2769,"_31485":2753,"_5":31809,"_21804":59958,"_28646":59959,"_3122":59960},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3731":2770,"_31485":2753,"_5":31809,"_21804":59962,"_28646":59963,"_3122":59964},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3731":2771,"_31485":2753,"_5":31809,"_21804":59966,"_28646":59967,"_3122":59968},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3731":2772,"_31485":2753,"_5":31809,"_21804":59970,"_28646":59971,"_3122":59972},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3731":2773,"_31485":2753,"_5":31809,"_21804":59974,"_28646":59975,"_3122":59976},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3731":2774,"_31485":2753,"_5":31809,"_21804":59978,"_28646":59979,"_3122":59980},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3731":2775,"_31485":2753,"_5":31809,"_21804":59982,"_28646":59983,"_3122":59984},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3731":2776,"_31485":2753,"_5":31809,"_21804":59986,"_28646":59987,"_3122":59988},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3731":2777,"_31485":2753,"_5":31809,"_21804":59990,"_28646":59991,"_3122":59992},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3731":2778,"_31485":2753,"_5":31809,"_21804":59994,"_28646":59995,"_3122":59996},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3731":2779,"_31485":2753,"_5":31809,"_21804":59998,"_28646":59999,"_3122":60000},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3731":2780,"_31485":2753,"_5":31809,"_21804":60002,"_28646":60003,"_3122":60004},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3731":2781,"_31485":2753,"_5":31809,"_21804":60006,"_28646":60007,"_3122":60008},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3731":2782,"_31485":2753,"_5":31809,"_21804":60010,"_28646":60011,"_3122":60012},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3731":2783,"_31485":2753,"_5":31809,"_21804":60014,"_28646":60015,"_3122":60016},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3731":2784,"_31485":2753,"_5":31809,"_21804":60018,"_28646":60019,"_3122":60020},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3731":2785,"_31485":2753,"_5":31809,"_21804":60022,"_28646":60023,"_3122":60024},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3731":2786,"_31485":2753,"_5":31809,"_21804":60026,"_28646":60027,"_3122":60028},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3731":2787,"_31485":2753,"_5":31809,"_21804":60030,"_28646":60031,"_3122":60032},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3731":2788,"_31485":2753,"_5":31809,"_21804":60034,"_28646":60035,"_3122":60036},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3731":2789,"_31485":2753,"_5":31809,"_21804":60038,"_28646":60039,"_3122":60032},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3731":2790,"_31485":2753,"_5":31809,"_21804":60041,"_28646":60042,"_3122":60043},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3731":2791,"_31485":2753,"_5":31809,"_21804":60045,"_28646":60046,"_3122":60047},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3731":2792,"_31485":2753,"_5":31809,"_21804":60049,"_28646":60050,"_3122":60051},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3731":2793,"_31485":2753,"_5":31809,"_21804":60053,"_28646":60054,"_3122":60055},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3731":2794,"_31485":2753,"_5":31809,"_21804":60057,"_28646":60058,"_3122":60059},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3731":2795,"_31485":2753,"_5":31809,"_21804":60061,"_28646":60062,"_3122":60063},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3731":2796,"_31485":2753,"_5":31809,"_21804":60065,"_28646":60066,"_3122":60067},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3731":2797,"_31485":2753,"_5":31809,"_21804":60069,"_28646":60070,"_3122":60071},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3731":2798,"_31485":2753,"_5":31809,"_21804":60073,"_28646":60074,"_3122":60075},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3731":2799,"_31485":2753,"_5":31809,"_21804":60077,"_28646":60078,"_3122":55683},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3731":2800,"_31485":2753,"_5":31809,"_21804":60080,"_28646":60081,"_3122":60082},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3731":2801,"_31485":2753,"_5":31809,"_21804":60084,"_28646":60085,"_3122":60086},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3731":2802,"_31485":2753,"_21804":60088,"_5":15036,"_28646":2753,"_3122":60089},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3731":2803,"_31485":2753,"_21804":60091,"_5":15036,"_28646":2753,"_3122":60092},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3731":2804,"_31485":2753,"_21804":60094,"_5":15036,"_28646":2753,"_3122":60095},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3731":2805,"_31485":2753,"_21804":60097,"_5":15036,"_28646":2753,"_3122":60098},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3731":2806,"_31485":2753,"_21804":60100,"_5":15036,"_28646":2753,"_3122":60101},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3731":2807,"_31485":2753,"_21804":60103,"_5":15036,"_28646":2753,"_3122":60104},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3731":2808,"_31485":2753,"_21804":60106,"_5":15036,"_28646":2753,"_3122":60107},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3731":2809,"_31485":2753,"_21804":60109,"_5":15036,"_28646":59908,"_3122":60110},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3731":2810,"_31485":2753,"_21804":60112,"_5":15036,"_28646":59908,"_3122":60113},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3731":2811,"_31485":2753,"_21804":60115,"_5":15036,"_28646":59912,"_3122":60116},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3731":2812,"_31485":2753,"_21804":60118,"_5":15036,"_28646":59912,"_3122":60119},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3731":2813,"_31485":2753,"_21804":60121,"_5":15036,"_28646":59916,"_3122":60122},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own AMQP queue, which on AMQP the broker removes automatically when the instance stops (see Device events).",{"_3731":2814,"_31485":2753,"_21804":60124,"_5":15036,"_28646":59920,"_3122":60125},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3731":2815,"_31485":2753,"_21804":60127,"_5":15036,"_28646":59920,"_3122":60128},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3731":2816,"_31485":2753,"_21804":60130,"_5":15036,"_28646":59920,"_3122":60131},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3731":2817,"_31485":2753,"_21804":60133,"_5":15036,"_28646":59920,"_3122":60134},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3731":2818,"_31485":2753,"_21804":60136,"_5":15036,"_28646":59920,"_3122":60137},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3731":2819,"_31485":2753,"_21804":60139,"_5":15036,"_28646":59924,"_3122":60140},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3731":2820,"_31485":2753,"_21804":60142,"_5":15036,"_28646":59924,"_3122":60143},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3731":2821,"_31485":2753,"_21804":60145,"_5":15036,"_28646":59924,"_3122":60146},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3731":2822,"_31485":2753,"_21804":60148,"_5":15036,"_28646":59924,"_3122":60149},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3731":2823,"_31485":2753,"_21804":60151,"_5":15036,"_28646":59924,"_3122":60152},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3731":2824,"_31485":2753,"_21804":60154,"_5":15036,"_28646":59924,"_3122":60155},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3731":2825,"_31485":2753,"_21804":60157,"_5":15036,"_28646":59928,"_3122":60158},[],"Change",{"_3731":2826,"_31485":2753,"_21804":60160,"_5":15036,"_28646":59928,"_3122":60161},[],"Who is affected",{"_3731":2827,"_31485":2753,"_21804":60163,"_5":15036,"_28646":59928,"_3122":60164},[],"Severity",{"_3731":2828,"_31485":2753,"_21804":60166,"_5":15036,"_28646":59928,"_3122":58579},[],{"_3731":2829,"_31485":2753,"_21804":60168,"_5":15036,"_28646":59928,"_3122":59937},[],{"_3731":2830,"_31485":2753,"_21804":60170,"_5":15036,"_28646":59928,"_3122":60171},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3731":2831,"_31485":2753,"_21804":60173,"_5":15036,"_28646":59928,"_3122":60174},[],"High: KMS and VA start on empty volumes",{"_3731":2832,"_31485":2753,"_21804":60176,"_5":15036,"_28646":59928,"_3122":60177},[],"Copy the data into the new volumes",{"_3731":2833,"_31485":2753,"_21804":60179,"_5":15036,"_28646":59928,"_3122":59941},[],{"_3731":2834,"_31485":2753,"_21804":60181,"_5":15036,"_28646":59928,"_3122":60182},[],"Every Helm release",{"_3731":2835,"_31485":2753,"_21804":60184,"_5":15036,"_28646":59928,"_3122":60185},[],"High: `helm upgrade` fails",{"_3731":2836,"_31485":2753,"_21804":60187,"_5":15036,"_28646":59928,"_3122":60188},[],"Remove or rename legacy keys",{"_3731":2837,"_31485":2753,"_21804":60190,"_5":15036,"_28646":59928,"_3122":52011},[],{"_3731":2838,"_31485":2753,"_21804":60192,"_5":15036,"_28646":59928,"_3122":60182},[],{"_3731":2839,"_31485":2753,"_21804":60194,"_5":15036,"_28646":59928,"_3122":60195},[],"High: `helm upgrade` fails on inline credentials",{"_3731":2840,"_31485":2753,"_21804":60197,"_5":15036,"_28646":59928,"_3122":60198},[],"Create the Secrets first; see Step 2",{"_3731":2841,"_31485":2753,"_21804":60200,"_5":15036,"_28646":59928,"_3122":59948},[],{"_3731":2842,"_31485":2753,"_21804":60202,"_5":15036,"_28646":59928,"_3122":60203},[],"Every deployment",{"_3731":2843,"_31485":2753,"_21804":60205,"_5":15036,"_28646":59928,"_3122":60206},[],"High: without a bootstrap principal there is no administrator",{"_3731":2844,"_31485":2753,"_21804":60208,"_5":15036,"_28646":59928,"_3122":60209},[],"Configure `services.authz`",{"_3731":2845,"_31485":2753,"_21804":60211,"_5":15036,"_28646":59928,"_3122":59952},[],{"_3731":2846,"_31485":2753,"_21804":60213,"_5":15036,"_28646":59928,"_3122":60182},[],{"_3731":2847,"_31485":2753,"_21804":60215,"_5":15036,"_28646":59928,"_3122":60216},[],"High: `helm upgrade` fails on the old keys",{"_3731":2848,"_31485":2753,"_21804":60218,"_5":15036,"_28646":59928,"_3122":60219},[],"Move JWKS and roles into `services.authz`",{"_3731":2849,"_31485":2753,"_21804":60221,"_5":15036,"_28646":59928,"_3122":59972},[],{"_3731":2850,"_31485":2753,"_21804":60223,"_5":15036,"_28646":59928,"_3122":60224},[],"3.8.0 deployments with per-service databases",{"_3731":2851,"_31485":2753,"_21804":60226,"_5":15036,"_28646":59928,"_3122":60227},[],"High: services find no data, or a migration aborts",{"_3731":2852,"_31485":2753,"_21804":60229,"_5":15036,"_28646":59928,"_3122":60230},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3731":2853,"_31485":2753,"_21804":60232,"_5":15036,"_28646":59928,"_3122":59976},[],{"_3731":2854,"_31485":2753,"_21804":60234,"_5":15036,"_28646":59928,"_3122":60235},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3731":2855,"_31485":2753,"_21804":60237,"_5":15036,"_28646":59928,"_3122":60238},[],"High: the backend no longer starts with them",{"_3731":2856,"_31485":2753,"_21804":60240,"_5":15036,"_28646":59928,"_3122":60241},[],"Move to PostgreSQL before upgrading",{"_3731":2857,"_31485":2753,"_21804":60243,"_5":15036,"_28646":59928,"_3122":60024},[],{"_3731":2858,"_31485":2753,"_21804":60245,"_5":15036,"_28646":59928,"_3122":60246},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3731":2859,"_31485":2753,"_21804":60248,"_5":15036,"_28646":59928,"_3122":60249},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3731":2860,"_31485":2753,"_21804":60251,"_5":15036,"_28646":59928,"_3122":60252},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3731":2861,"_31485":2753,"_21804":60254,"_5":15036,"_28646":59928,"_3122":60255},[],"Webhooks with file references",{"_3731":2862,"_31485":2753,"_21804":60257,"_5":15036,"_28646":59928,"_3122":60258},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3731":2863,"_31485":2753,"_21804":60260,"_5":15036,"_28646":59928,"_3122":60261},[],"High: enrollments calling the webhook fail",{"_3731":2864,"_31485":2753,"_21804":60263,"_5":15036,"_28646":59928,"_3122":60264},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3731":2865,"_31485":2753,"_21804":60266,"_5":15036,"_28646":59928,"_3122":59956},[],{"_3731":2866,"_31485":2753,"_21804":60268,"_5":15036,"_28646":59928,"_3122":60269},[],"Releases with per-service identity overrides or mounted key material",{"_3731":2867,"_31485":2753,"_21804":60271,"_5":15036,"_28646":59928,"_3122":60272},[],"Medium: services cannot read their files",{"_3731":2868,"_31485":2753,"_21804":60274,"_5":15036,"_28646":59928,"_3122":60275},[],"Remove the overrides and fix volume ownership",{"_3731":2869,"_31485":2753,"_21804":60277,"_5":15036,"_28646":59928,"_3122":59960},[],{"_3731":2870,"_31485":2753,"_21804":60279,"_5":15036,"_28646":59928,"_3122":60280},[],"Releases that set `amqp.tls`",{"_3731":2871,"_31485":2753,"_21804":60282,"_5":15036,"_28646":59928,"_3122":60283},[],"Medium: clients connect to the wrong port",{"_3731":2872,"_31485":2753,"_21804":60285,"_5":15036,"_28646":59928,"_3122":60286},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3731":2873,"_31485":2753,"_21804":60288,"_5":15036,"_28646":59928,"_3122":59980},[],{"_3731":2874,"_31485":2753,"_21804":60290,"_5":15036,"_28646":59928,"_3122":60291},[],"Installations whose CA keys predate the KMS",{"_3731":2875,"_31485":2753,"_21804":60293,"_5":15036,"_28646":59928,"_3122":60294},[],"Medium: CA keys stay unmanaged",{"_3731":2876,"_31485":2753,"_21804":60296,"_5":15036,"_28646":59928,"_3122":60297},[],"Run the CA-to-KMS migration",{"_3731":2877,"_31485":2753,"_21804":60299,"_5":15036,"_28646":59928,"_3122":60300},[],"Receiver certificate verification",{"_3731":2878,"_31485":2753,"_21804":60302,"_5":15036,"_28646":59928,"_3122":60303},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3731":2879,"_31485":2753,"_21804":60305,"_5":15036,"_28646":59928,"_3122":60306},[],"Medium: credentials go to an unverified receiver",{"_3731":2880,"_31485":2753,"_21804":60308,"_5":15036,"_28646":59928,"_3122":60309},[],"Set `insecure_skip_verify` to `false`",{"_3731":2881,"_31485":2753,"_21804":60311,"_5":15036,"_28646":59928,"_3122":59996},[],{"_3731":2882,"_31485":2753,"_21804":60313,"_5":15036,"_28646":59928,"_3122":60314},[],"Scripts and consoles that edit DMSs through the API",{"_3731":2883,"_31485":2753,"_21804":60316,"_5":15036,"_28646":59928,"_3122":60317},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3731":2884,"_31485":2753,"_21804":60319,"_5":15036,"_28646":59928,"_3122":60320},[],"Read the DMS before editing and use the new field",{"_3731":2885,"_31485":2753,"_21804":60322,"_5":15036,"_28646":59928,"_3122":60000},[],{"_3731":2886,"_31485":2753,"_21804":60324,"_5":15036,"_28646":59928,"_3122":60325},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3731":2887,"_31485":2753,"_21804":60327,"_5":15036,"_28646":59928,"_3122":60328},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3731":2888,"_31485":2753,"_21804":60330,"_5":15036,"_28646":59928,"_3122":60331},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3731":2889,"_31485":2753,"_21804":60333,"_5":15036,"_28646":59928,"_3122":60020},[],{"_3731":2890,"_31485":2753,"_21804":60335,"_5":15036,"_28646":59928,"_3122":60336},[],"Clients that create or update CRL settings through the API",{"_3731":2891,"_31485":2753,"_21804":60338,"_5":15036,"_28646":59928,"_3122":60339},[],"Medium: requests with the old field return an error",{"_3731":2892,"_31485":2753,"_21804":60341,"_5":15036,"_28646":59928,"_3122":60342},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3731":2893,"_31485":2753,"_21804":60344,"_5":15036,"_28646":59928,"_3122":60028},[],{"_3731":2894,"_31485":2753,"_21804":60346,"_5":15036,"_28646":59928,"_3122":60347},[],"Alert subscriptions and consumers of the VA events",{"_3731":2895,"_31485":2753,"_21804":60349,"_5":15036,"_28646":59928,"_3122":60350},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3731":2896,"_31485":2753,"_21804":60352,"_5":15036,"_28646":59928,"_3122":60353},[],"Review conditions filtering on the old event payload or subject",{"_3731":2897,"_31485":2753,"_21804":60355,"_5":15036,"_28646":59928,"_3122":60032},[],{"_3731":2898,"_31485":2753,"_21804":60357,"_5":15036,"_28646":59928,"_3122":60358},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3731":2899,"_31485":2753,"_21804":60360,"_5":15036,"_28646":59928,"_3122":60361},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3731":2900,"_31485":2753,"_21804":60363,"_5":15036,"_28646":59928,"_3122":60364},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3731":2901,"_31485":2753,"_21804":60366,"_5":15036,"_28646":59928,"_3122":60016},[],{"_3731":2902,"_31485":2753,"_21804":60368,"_5":15036,"_28646":59928,"_3122":60369},[],"Consumers that read the device `events` field",{"_3731":2903,"_31485":2753,"_21804":60371,"_5":15036,"_28646":59928,"_3122":60372},[],"Medium: the field disappears",{"_3731":2904,"_31485":2753,"_21804":60374,"_5":15036,"_28646":59928,"_3122":60375},[],"Use the new event endpoints",{"_3731":2905,"_31485":2753,"_21804":60377,"_5":15036,"_28646":59928,"_3122":60043},[],{"_3731":2906,"_31485":2753,"_21804":60379,"_5":15036,"_28646":59928,"_3122":60380},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3731":2907,"_31485":2753,"_21804":60382,"_5":15036,"_28646":59928,"_3122":60383},[],"Medium: the VA migration aborts",{"_3731":2908,"_31485":2753,"_21804":60385,"_5":15036,"_28646":59928,"_3122":60386},[],"Fix the affected roles before upgrading",{"_3731":2909,"_31485":2753,"_21804":60388,"_5":15036,"_28646":59928,"_3122":59964},[],{"_3731":2910,"_31485":2753,"_21804":60390,"_5":15036,"_28646":59928,"_3122":60391},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3731":2911,"_31485":2753,"_21804":60393,"_5":15036,"_28646":59928,"_3122":60394},[],"Low to medium: validation errors or changed defaults",{"_3731":2912,"_31485":2753,"_21804":60396,"_5":15036,"_28646":59928,"_3122":60397},[],"Update the values file",{"_3731":2913,"_31485":2753,"_21804":60399,"_5":15036,"_28646":59928,"_3122":60008},[],{"_3731":2914,"_31485":2753,"_21804":60401,"_5":15036,"_28646":59928,"_3122":60402},[],"Clients that send the DMS ID in the update body",{"_3731":2915,"_31485":2753,"_21804":60404,"_5":15036,"_28646":59928,"_3122":60405},[],"Low: the ID in the URL wins",{"_3731":2916,"_31485":2753,"_21804":60407,"_5":15036,"_28646":59928,"_3122":60408},[],"Send the ID in the URL",{"_3731":2917,"_31485":2753,"_21804":60410,"_5":15036,"_28646":59928,"_3122":60036},[],{"_3731":2918,"_31485":2753,"_21804":60412,"_5":15036,"_28646":59928,"_3122":60413},[],"Clients that send an `id` when creating or importing CAs",{"_3731":2919,"_31485":2753,"_21804":60415,"_5":15036,"_28646":59928,"_3122":60416},[],"Low: the ID in the body is ignored, and the field is removed",{"_3731":2920,"_31485":2753,"_21804":60418,"_5":15036,"_28646":59928,"_3122":60419},[],"Let the backend assign the ID and use the returned one",{"_3731":2921,"_31485":2753,"_21804":60421,"_5":15036,"_28646":59928,"_3122":60032},[],{"_3731":2922,"_31485":2753,"_21804":60423,"_5":15036,"_28646":59928,"_3122":60424},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3731":2923,"_31485":2753,"_21804":60426,"_5":15036,"_28646":59928,"_3122":60427},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3731":2924,"_31485":2753,"_21804":60429,"_5":15036,"_28646":59928,"_3122":60430},[],"Use the KMS `sign` and `verify` operations",{"_3731":2925,"_31485":2753,"_21804":60432,"_5":15036,"_28646":59928,"_3122":60012},[],{"_3731":2926,"_31485":2753,"_21804":60434,"_5":15036,"_28646":59928,"_3122":60435},[],"Consumers that match on certificate `type`",{"_3731":2927,"_31485":2753,"_21804":60437,"_5":15036,"_28646":59928,"_3122":60438},[],"Low: two values are renamed",{"_3731":2928,"_31485":2753,"_21804":60440,"_5":15036,"_28646":59928,"_3122":60441},[],"Adapt consumers",{"_3731":2929,"_31485":2753,"_21804":60443,"_5":15036,"_28646":59928,"_3122":60004},[],{"_3731":2930,"_31485":2753,"_21804":60445,"_5":15036,"_28646":59928,"_3122":60446},[],"Any DMS",{"_3731":2931,"_31485":2753,"_21804":60448,"_5":15036,"_28646":59928,"_3122":60449},[],"Low: informational",{"_3731":2932,"_31485":2753,"_21804":60451,"_5":15036,"_28646":59928,"_3122":60452},[],"Read both blocks before editing",{"_3731":2933,"_31485":2753,"_21804":60454,"_5":15036,"_28646":59936,"_3122":60455},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3731":2934,"_31485":2753,"_21804":60457,"_5":15036,"_28646":59936,"_3122":60458},[],"Step 4 of the migration guide copies the data.",{"_3731":2935,"_31485":2753,"_21804":60460,"_5":15036,"_28646":59940,"_3122":60461},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3731":2936,"_31485":2753,"_21804":60463,"_5":15036,"_28646":59944,"_3122":60464},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3731":2937,"_31485":2753,"_21804":60466,"_5":15036,"_28646":59944,"_3122":60467},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3731":2938,"_31485":2753,"_21804":60469,"_5":15036,"_28646":59947,"_3122":60470},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3731":2939,"_31485":2753,"_21804":60472,"_5":15036,"_28646":59951,"_3122":60473},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3731":2940,"_31485":2753,"_21804":60475,"_5":15036,"_28646":59955,"_3122":60476},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3731":2941,"_31485":2753,"_21804":60478,"_5":15036,"_28646":59955,"_3122":60479},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3731":2942,"_31485":2753,"_21804":60481,"_5":15036,"_28646":59955,"_3122":60482},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3731":2943,"_31485":2753,"_21804":60484,"_5":15036,"_28646":59959,"_3122":60485},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3731":2944,"_31485":2753,"_21804":60487,"_5":15036,"_28646":59963,"_3122":60488},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3731":2945,"_31485":2753,"_21804":60490,"_5":15036,"_28646":59963,"_3122":60491},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3731":2946,"_31485":2753,"_21804":60493,"_5":15036,"_28646":59963,"_3122":60494},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3731":2947,"_31485":2753,"_21804":60496,"_5":15036,"_28646":59963,"_3122":60497},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3731":2948,"_31485":2753,"_21804":60499,"_5":15036,"_28646":59963,"_3122":60500},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3731":2949,"_31485":2753,"_21804":60502,"_5":15036,"_28646":59963,"_3122":60503},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3731":2950,"_31485":2753,"_21804":60505,"_5":15036,"_28646":59971,"_3122":60506},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3731":2951,"_31485":2753,"_21804":60508,"_5":15036,"_28646":59971,"_3122":60509},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3731":2952,"_31485":2753,"_21804":60511,"_5":15036,"_28646":59971,"_3122":60512},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3731":2953,"_31485":2753,"_21804":60514,"_5":15036,"_28646":59971,"_3122":60515},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3731":2954,"_31485":2753,"_21804":60517,"_5":15036,"_28646":59971,"_3122":60518},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3731":2955,"_31485":2753,"_21804":60520,"_5":15036,"_28646":59975,"_3122":60521},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3731":2956,"_31485":2753,"_21804":60523,"_5":15036,"_28646":59979,"_3122":60524},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3731":2957,"_31485":2753,"_21804":60526,"_5":15036,"_28646":59979,"_3122":60527},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3731":2958,"_31485":2753,"_21804":60529,"_5":15036,"_28646":59979,"_3122":60530},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3731":2959,"_31485":2753,"_21804":60532,"_5":15036,"_28646":59979,"_3122":60533},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3731":2960,"_31485":2753,"_21804":60535,"_5":15036,"_28646":59979,"_3122":60536},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3731":2961,"_31485":2753,"_21804":60538,"_5":15036,"_28646":59979,"_3122":60539},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3731":2962,"_31485":2753,"_21804":60541,"_5":15036,"_28646":59979,"_3122":60542},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3731":2963,"_31485":2753,"_21804":60544,"_5":15036,"_28646":59979,"_3122":60545},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3731":2964,"_31485":2753,"_21804":60547,"_5":15036,"_28646":59983,"_3122":60548},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3731":2965,"_31485":2753,"_21804":60550,"_5":15036,"_28646":59991,"_3122":60551},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3731":2966,"_31485":2753,"_21804":60553,"_5":15036,"_28646":59991,"_3122":60554},[],"Field in 3.8.0",{"_3731":2967,"_31485":2753,"_21804":60556,"_5":15036,"_28646":59991,"_3122":60557},[],"Field in 4.0.0",{"_3731":2968,"_31485":2753,"_21804":60559,"_5":15036,"_28646":59991,"_3122":60560},[],"`validate_server_cert`",{"_3731":2969,"_31485":2753,"_21804":60562,"_5":15036,"_28646":59991,"_3122":60563},[],"`insecure_skip_verify` (value negated)",{"_3731":2970,"_31485":2753,"_21804":60565,"_5":15036,"_28646":59991,"_3122":60566},[],"`oidc`",{"_3731":2971,"_31485":2753,"_21804":60568,"_5":15036,"_28646":59991,"_3122":60569},[],"`jwt_options`",{"_3731":2972,"_31485":2753,"_21804":60571,"_5":15036,"_28646":59991,"_3122":60572},[],"`apikey`",{"_3731":2973,"_31485":2753,"_21804":60574,"_5":15036,"_28646":59991,"_3122":60575},[],"`apikey_options`",{"_3731":2974,"_31485":2753,"_21804":60577,"_5":15036,"_28646":59991,"_3122":60578},[],"`mtls`",{"_3731":2975,"_31485":2753,"_21804":60580,"_5":15036,"_28646":59991,"_3122":60581},[],"`mtls_options`",{"_3731":2976,"_31485":2753,"_21804":60583,"_5":15036,"_28646":59991,"_3122":60584},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3731":2977,"_31485":2753,"_21804":60586,"_5":15036,"_28646":59991,"_3122":60587},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3731":2978,"_31485":2753,"_21804":60589,"_5":15036,"_28646":59991,"_3122":60590},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3731":2979,"_31485":2753,"_21804":60592,"_5":15036,"_28646":59995,"_3122":60593},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3731":2980,"_31485":2753,"_21804":60595,"_5":15036,"_28646":59995,"_3122":60596},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3731":2981,"_31485":2753,"_21804":60598,"_5":15036,"_28646":59995,"_3122":60599},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3731":2982,"_31485":2753,"_21804":60601,"_5":15036,"_28646":59999,"_3122":60602},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3731":2983,"_31485":2753,"_21804":60604,"_5":15036,"_28646":59999,"_3122":60605},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3731":2984,"_31485":2753,"_21804":60607,"_5":15036,"_28646":60003,"_3122":60608},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3731":2985,"_31485":2753,"_21804":60610,"_5":15036,"_28646":60007,"_3122":60611},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3731":2986,"_31485":2753,"_21804":60613,"_5":15036,"_28646":60011,"_3122":60614},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3731":2987,"_31485":2753,"_21804":60616,"_5":15036,"_28646":60015,"_3122":60617},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3731":2988,"_31485":2753,"_21804":60619,"_5":15036,"_28646":60015,"_3122":60620},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3731":2989,"_31485":2753,"_21804":60622,"_5":15036,"_28646":60015,"_3122":60623},[],"`POST /v1/devices/:id/events` creates an event.",{"_3731":2990,"_31485":2753,"_21804":60625,"_5":15036,"_28646":60015,"_3122":60626},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Delivery is best effort: events emitted while no client is connected are not replayed on the next connection. The server closes each stream after a maximum lifetime, 10 minutes by default and configurable with the Device Manager `sse_max_stream_duration` setting, and the client reconnects to keep receiving events. When an instance has reached its subscriber limit, set by the Device Manager `sse_max_subscribers` setting (default 1000 and shared by all streams of the instance), new streams receive a `503` response with a `Retry-After` header. Each stream also re-checks the reader's permission to read the device, and closes it when the permission is revoked or cannot be verified; reconnecting goes through the regular authorization checks again. In a Helm deployment, set `services.deviceManager.sseEnabled` to `false` to disable SSE (default `true`); see Device event stream (SSE).",{"_3731":2991,"_31485":2753,"_21804":60628,"_5":15036,"_28646":60015,"_3122":60629},[],"On AMQP, each Device Manager instance binds a subscriber queue named after its service ID, `device-manager-sse-<uuid>`. The queue is durable and auto-delete, with a one-hour expiration (`x-expires`), so the broker removes it when the instance stops or its connection dies and no cleanup policy is needed. Only on event-bus providers without ephemeral-subscriber support can a per-process durable queue linger after its instance stops; check those providers if you observe leftover queues.",{"_3731":2992,"_31485":2753,"_21804":60631,"_5":15036,"_28646":60019,"_3122":60632},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3731":2993,"_31485":2753,"_21804":60634,"_5":15036,"_28646":60023,"_3122":60635},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3731":2994,"_31485":2753,"_21804":60637,"_5":15036,"_28646":60023,"_3122":60638},[],"Route",{"_3731":2995,"_31485":2753,"_21804":60640,"_5":15036,"_28646":60023,"_3122":54698},[],{"_3731":2996,"_31485":2753,"_21804":60642,"_5":15036,"_28646":60023,"_3122":60643},[],"`GET /v1/crl-settings`",{"_3731":2997,"_31485":2753,"_21804":60645,"_5":15036,"_28646":60023,"_3122":60646},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3731":2998,"_31485":2753,"_21804":60648,"_5":15036,"_28646":60023,"_3122":60649},[],"`GET /v1/crl-settings/{ca-id}`",{"_3731":2999,"_31485":2753,"_21804":60651,"_5":15036,"_28646":60023,"_3122":60652},[],"Reads the settings of a CA.",{"_3731":3000,"_31485":2753,"_21804":60654,"_5":15036,"_28646":60023,"_3122":60655},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3731":3001,"_31485":2753,"_21804":60657,"_5":15036,"_28646":60023,"_3122":60658},[],"Replaces `crl_options`.",{"_3731":3002,"_31485":2753,"_21804":60660,"_5":15036,"_28646":60023,"_3122":60661},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3731":3003,"_31485":2753,"_21804":60663,"_5":15036,"_28646":60023,"_3122":60664},[],"Removes the archived settings of a CA.",{"_3731":3004,"_31485":2753,"_21804":60666,"_5":15036,"_28646":60023,"_3122":60667},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3731":3005,"_31485":2753,"_21804":60669,"_5":15036,"_28646":60023,"_3122":60670},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3731":3006,"_31485":2753,"_21804":60672,"_5":15036,"_28646":60023,"_3122":60673},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3731":3007,"_31485":2753,"_21804":60675,"_5":15036,"_28646":60023,"_3122":60676},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3731":3008,"_31485":2753,"_21804":60678,"_5":15036,"_28646":60023,"_3122":60679},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3731":3009,"_31485":2753,"_21804":60681,"_5":15036,"_28646":60023,"_3122":60682},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3731":3010,"_31485":2753,"_21804":60684,"_5":15036,"_28646":60023,"_3122":60685},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3731":3011,"_31485":2753,"_21804":60687,"_5":15036,"_28646":60023,"_3122":60688},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3731":3012,"_31485":2753,"_21804":60690,"_5":15036,"_28646":60023,"_3122":60691},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3731":3013,"_31485":2753,"_21804":60693,"_5":15036,"_28646":60023,"_3122":60694},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3731":3014,"_31485":2753,"_21804":60696,"_5":15036,"_28646":60023,"_3122":60697},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3731":3015,"_31485":2753,"_21804":60699,"_5":15036,"_28646":60027,"_3122":60700},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3731":3016,"_31485":2753,"_21804":60702,"_5":15036,"_28646":60031,"_3122":60703},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3731":3017,"_31485":2753,"_21804":60705,"_5":15036,"_28646":60035,"_3122":60706},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3731":3018,"_31485":2753,"_21804":60708,"_5":15036,"_28646":60039,"_3122":60709},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3731":3019,"_31485":2753,"_21804":60711,"_5":15036,"_28646":60039,"_3122":60712},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3731":3020,"_31485":2753,"_21804":60714,"_5":15036,"_28646":60042,"_3122":60715},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3731":3021,"_31485":2753,"_21804":60717,"_5":15036,"_28646":60046,"_3122":60718},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3731":3022,"_31485":2753,"_21804":60720,"_5":15036,"_28646":60050,"_3122":60721},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3731":3023,"_31485":2753,"_21804":60723,"_5":15036,"_28646":60050,"_3122":60724},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3731":3024,"_31485":2753,"_21804":60726,"_5":15036,"_28646":60050,"_3122":60727},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3731":3025,"_31485":2753,"_21804":60729,"_5":15036,"_28646":60050,"_3122":60730},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3731":3026,"_31485":2753,"_21804":60732,"_5":15036,"_28646":60050,"_3122":60733},[],"Record the names of your local-storage PVCs:",{"_3731":3027,"_31485":2753,"_21804":60735,"_5":15036,"_28646":60050,"_3122":60736},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3731":3028,"_31485":2753,"_21804":60738,"_5":15036,"_28646":60054,"_3122":60739},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3731":3029,"_31485":2753,"_21804":60741,"_5":15036,"_28646":60054,"_3122":60742},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3731":3030,"_31485":2753,"_21804":60744,"_5":15036,"_28646":60054,"_3122":60745},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3731":3031,"_31485":2753,"_21804":60747,"_5":15036,"_28646":60054,"_3122":60748},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3731":3032,"_31485":2753,"_21804":60750,"_5":15036,"_28646":60054,"_3122":60751},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3731":3033,"_31485":2753,"_21804":60753,"_5":15036,"_28646":60058,"_3122":60754},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3731":3034,"_31485":2753,"_21804":60756,"_5":15036,"_28646":60058,"_3122":60757},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3731":3035,"_31485":2753,"_21804":60759,"_5":15036,"_28646":60058,"_3122":60760},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3731":3036,"_31485":2753,"_21804":60762,"_5":15036,"_28646":60058,"_3122":60763},[],"Secret (`existingSecret`)",{"_3731":3037,"_31485":2753,"_21804":60765,"_5":15036,"_28646":60058,"_3122":60766},[],"Required data keys",{"_3731":3038,"_31485":2753,"_21804":60768,"_5":15036,"_28646":60058,"_3122":60769},[],"When",{"_3731":3039,"_31485":2753,"_21804":60771,"_5":15036,"_28646":60058,"_3122":60772},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3731":3040,"_31485":2753,"_21804":60774,"_5":15036,"_28646":60058,"_3122":60775},[],"`username`, `password`",{"_3731":3041,"_31485":2753,"_21804":60777,"_5":15036,"_28646":60058,"_3122":60778},[],"Always",{"_3731":3042,"_31485":2753,"_21804":60780,"_5":15036,"_28646":60058,"_3122":60781},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3731":3043,"_31485":2753,"_21804":60783,"_5":15036,"_28646":60058,"_3122":60775},[],{"_3731":3044,"_31485":2753,"_21804":60785,"_5":15036,"_28646":60058,"_3122":60778},[],{"_3731":3045,"_31485":2753,"_21804":60787,"_5":15036,"_28646":60058,"_3122":60788},[],"`services.alerts.smtp_server.existingSecret`",{"_3731":3046,"_31485":2753,"_21804":60790,"_5":15036,"_28646":60058,"_3122":60775},[],{"_3731":3047,"_31485":2753,"_21804":60792,"_5":15036,"_28646":60058,"_3122":60793},[],"Only when SMTP authentication is enabled",{"_3731":3048,"_31485":2753,"_21804":60795,"_5":15036,"_28646":60058,"_3122":60796},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3731":3049,"_31485":2753,"_21804":60798,"_5":15036,"_28646":60058,"_3122":60799},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3731":3050,"_31485":2753,"_21804":60801,"_5":15036,"_28646":60058,"_3122":60802},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3731":3051,"_31485":2753,"_21804":60804,"_5":15036,"_28646":60058,"_3122":60805},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3731":3052,"_31485":2753,"_21804":60807,"_5":15036,"_28646":60058,"_3122":60808},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3731":3053,"_31485":2753,"_21804":60810,"_5":15036,"_28646":60058,"_3122":60811},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3731":3054,"_31485":2753,"_21804":60813,"_5":15036,"_28646":60058,"_3122":60814},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3731":3055,"_31485":2753,"_21804":60816,"_5":15036,"_28646":60058,"_3122":60817},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3731":3056,"_31485":2753,"_21804":60819,"_5":15036,"_28646":60058,"_3122":60820},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3731":3057,"_31485":2753,"_21804":60822,"_5":15036,"_28646":60058,"_3122":60823},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3731":3058,"_31485":2753,"_21804":60825,"_5":15036,"_28646":60058,"_3122":60826},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3731":3059,"_31485":2753,"_21804":60828,"_5":15036,"_28646":60058,"_3122":60829},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3731":3060,"_31485":2753,"_21804":60831,"_5":15036,"_28646":60058,"_3122":60832},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3731":3061,"_31485":2753,"_21804":60834,"_5":15036,"_28646":60058,"_3122":60835},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3731":3062,"_31485":2753,"_21804":60837,"_5":15036,"_28646":60058,"_3122":60838},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3731":3063,"_31485":2753,"_21804":60840,"_5":15036,"_28646":60062,"_3122":60841},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3731":3064,"_31485":2753,"_21804":60843,"_5":15036,"_28646":60062,"_3122":60844},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3731":3065,"_31485":2753,"_21804":60846,"_5":15036,"_28646":60066,"_3122":60847},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3731":3066,"_31485":2753,"_21804":60849,"_5":15036,"_28646":60066,"_3122":60850},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3731":3067,"_31485":2753,"_21804":60852,"_5":15036,"_28646":60066,"_3122":60853},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3731":3068,"_31485":2753,"_21804":60855,"_5":15036,"_28646":60066,"_3122":60856},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3731":3069,"_31485":2753,"_21804":60858,"_5":15036,"_28646":60066,"_3122":60859},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3731":3070,"_31485":2753,"_21804":60861,"_5":15036,"_28646":60066,"_3122":60862},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3731":3071,"_31485":2753,"_21804":60864,"_5":15036,"_28646":60066,"_3122":60865},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3731":3072,"_31485":2753,"_21804":60867,"_5":15036,"_28646":60066,"_3122":60868},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3731":3073,"_31485":2753,"_21804":60870,"_5":15036,"_28646":60066,"_3122":60871},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3731":3074,"_31485":2753,"_21804":60873,"_5":15036,"_28646":60066,"_3122":60874},[],"**Remove the helper and restore the recorded replica counts:**",{"_3731":3075,"_31485":2753,"_21804":60876,"_5":15036,"_28646":60066,"_3122":60877},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3731":3076,"_31485":2753,"_21804":60879,"_5":15036,"_28646":60070,"_3122":60880},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3731":3077,"_31485":2753,"_21804":60882,"_5":15036,"_28646":60070,"_3122":60883},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3731":3078,"_31485":2753,"_21804":60885,"_5":15036,"_28646":60074,"_3122":60886},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3731":3079,"_31485":2753,"_21804":60888,"_5":15036,"_28646":60074,"_3122":60889},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3731":3080,"_31485":2753,"_21804":60891,"_5":15036,"_28646":60074,"_3122":60892},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3731":3081,"_31485":2753,"_21804":60894,"_5":15036,"_28646":60074,"_3122":60895},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3731":3082,"_31485":2753,"_21804":60897,"_5":15036,"_28646":60074,"_3122":60898},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3731":3083,"_31485":2753,"_21804":60900,"_5":15036,"_28646":60074,"_3122":60901},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3731":3084,"_31485":2753,"_21804":60903,"_5":15036,"_28646":60074,"_3122":60904},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3731":3085,"_31485":2753,"_21804":60906,"_5":15036,"_28646":60074,"_3122":60907},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3731":3086,"_31485":2753,"_21804":60909,"_5":15036,"_28646":60078,"_3122":60910},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3731":3087,"_31485":2753,"_21804":60912,"_5":15036,"_28646":60078,"_3122":60913},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3731":3088,"_31485":2753,"_21804":60915,"_5":15036,"_28646":60078,"_3122":60916},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3731":3089,"_31485":2753,"_21804":60918,"_5":15036,"_28646":60078,"_3122":60919},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3731":3090,"_31485":2753,"_21804":60921,"_5":15036,"_28646":60078,"_3122":60922},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3731":3091,"_31485":2753,"_21804":60924,"_5":15036,"_28646":60078,"_3122":60925},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3731":3092,"_31485":2753,"_21804":60927,"_5":15036,"_28646":60078,"_3122":60928},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3731":3093,"_31485":2753,"_21804":60930,"_5":15036,"_28646":60078,"_3122":60931},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3731":3094,"_31485":2753,"_21804":60933,"_5":15036,"_28646":60078,"_3122":60934},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3731":3095,"_31485":2753,"_21804":60936,"_5":15036,"_28646":60078,"_3122":60937},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3731":3096,"_31485":2753,"_21804":60939,"_5":15036,"_28646":60078,"_3122":60940},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3731":3097,"_31485":2753,"_21804":60942,"_5":15036,"_28646":60081,"_3122":60943},[],"After the upgrade, check in this order:",{"_3731":3098,"_31485":2753,"_21804":60945,"_5":15036,"_28646":60081,"_3122":60946},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3731":3099,"_31485":2753,"_21804":60948,"_5":15036,"_28646":60081,"_3122":60949},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3731":3100,"_31485":2753,"_21804":60951,"_5":15036,"_28646":60081,"_3122":60952},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3731":3101,"_31485":2753,"_21804":60954,"_5":15036,"_28646":60081,"_3122":60955},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3731":3102,"_31485":2753,"_21804":60957,"_5":15036,"_28646":60081,"_3122":60958},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3731":3103,"_31485":2753,"_21804":60960,"_5":15036,"_28646":60081,"_3122":60961},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3731":3104,"_31485":2753,"_21804":60963,"_5":15036,"_28646":60081,"_3122":60964},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3731":3105,"_31485":2753,"_21804":60966,"_5":15036,"_28646":60081,"_3122":60967},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3731":3106,"_31485":2753,"_21804":60969,"_5":15036,"_28646":60081,"_3122":60970},[],"**AMQP.** The backend connects to the broker with the expected TLS settings. On AMQP the SSE subscriber queues are auto-delete and disappear when their instance stops; on event-bus providers without ephemeral-subscriber support, check that leftover per-process SSE queues are not accumulating.",{"_3731":3107,"_31485":2753,"_21804":60972,"_5":15036,"_28646":60081,"_3122":60973},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3731":3108,"_31485":2753,"_21804":60975,"_5":15036,"_28646":60081,"_3122":60976},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3731":3109,"_31485":2753,"_21804":60978,"_5":15036,"_28646":60081,"_3122":60979},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3731":3110,"_31485":2753,"_21804":60981,"_5":15036,"_28646":60081,"_3122":60982},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3731":3111,"_31485":2753,"_21804":60984,"_5":15036,"_28646":60081,"_3122":60985},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3731":3112,"_31485":2753,"_21804":60987,"_5":15036,"_28646":60081,"_3122":60988},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3731":3113,"_31485":2753,"_21804":60990,"_5":15036,"_28646":60085,"_3122":60991},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3731":3114,"_31485":2753,"_21804":60993,"_5":15036,"_28646":60085,"_3122":60994},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3731":3115,"_31485":2753,"_21804":60996,"_5":15036,"_28646":60085,"_3122":60997},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3731":3116,"_31485":2753,"_21804":60999,"_5":15036,"_28646":60085,"_3122":61000},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3731":3117,"_31485":2753,"_21804":61002,"_5":15036,"_28646":60085,"_3122":61003},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_61006":61007,"_61008":61009,"_61010":61011,"_61012":61013,"_18932":3157,"_73439":3157},"language","english","sortableProperties",[3122,31485,5,28646],"sortablePropertiesWithTypes",{"_3122":26006,"_31485":26006,"_5":26006,"_28646":26006},"sorts",{"_3122":61014,"_31485":64121,"_5":67227,"_28646":70333},{"_4898":61015,"_61016":61017,"_5":26006},{"_15117":18928,"_15490":14692,"_15509":33