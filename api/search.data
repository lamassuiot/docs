43,"_41554":129146,"_41556":129149,"_41558":129152,"_41560":129155,"_41562":129158,"_41564":129161,"_41566":129164,"_41568":129167,"_41570":129170,"_41572":129173,"_41574":129176,"_41577":129179,"_41579":129182,"_41581":129185},{"_3610":72509,"_31119":72509,"_5":15171,"_3066":119937,"_31457":119938,"_21540":119941,"_28300":72509},"Despliega desde AWS Marketplace",[50802,119939,119940],"Despliegue","Otros modelos",[],{"_3610":72510,"_31119":72509,"_21540":119943,"_5":14806,"_28300":72509,"_3066":119944},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3610":72511,"_31119":72509,"_5":31454,"_21540":119946,"_28300":119947,"_3066":119948},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3610":72512,"_31119":72509,"_5":31454,"_21540":119950,"_28300":119951,"_3066":119952},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3610":72513,"_31119":72509,"_5":31454,"_21540":119954,"_28300":119955,"_3066":119956},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3610":72514,"_31119":72509,"_5":31454,"_21540":119958,"_28300":119959,"_3066":119960},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3610":72515,"_31119":72509,"_5":31454,"_21540":119962,"_28300":119963,"_3066":119964},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3610":72516,"_31119":72509,"_5":31454,"_21540":119966,"_28300":119967,"_3066":119968},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3610":72517,"_31119":72509,"_5":31454,"_21540":119970,"_28300":119971,"_3066":119972},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3610":72518,"_31119":72509,"_21540":119974,"_5":14806,"_28300":72509,"_3066":119975},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3610":72519,"_31119":72509,"_21540":119977,"_5":14806,"_28300":119947,"_3066":119978},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3610":72520,"_31119":72509,"_21540":119980,"_5":14806,"_28300":119947,"_3066":119981},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3610":72521,"_31119":72509,"_21540":119983,"_5":14806,"_28300":119947,"_3066":119984},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3610":72522,"_31119":72509,"_21540":119986,"_5":14806,"_28300":119951,"_3066":119987},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3610":72523,"_31119":72509,"_21540":119989,"_5":14806,"_28300":119951,"_3066":119990},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3610":72524,"_31119":72509,"_21540":119992,"_5":14806,"_28300":119951,"_3066":119993},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3610":72525,"_31119":72509,"_21540":119995,"_5":14806,"_28300":119955,"_3066":119996},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3610":72526,"_31119":72509,"_21540":119998,"_5":14806,"_28300":119959,"_3066":119999},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3610":72527,"_31119":72509,"_21540":120001,"_5":14806,"_28300":119963,"_3066":120002},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3610":72528,"_31119":72509,"_21540":120004,"_5":14806,"_28300":119967,"_3066":120005},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3610":72529,"_31119":72509,"_21540":120007,"_5":14806,"_28300":119971,"_3066":120008},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3610":72530,"_31119":72530,"_5":15171,"_3066":120010,"_31457":120011,"_21540":120012,"_28300":72530},"Despliega Lamassu",[50802,119939],[],{"_3610":72531,"_31119":72530,"_21540":120014,"_5":14806,"_28300":72530,"_3066":120015},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3610":72532,"_31119":72530,"_5":31454,"_21540":120017,"_28300":120018,"_3066":120019},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3610":72533,"_31119":72530,"_5":31454,"_21540":120021,"_28300":120022,"_3066":120023},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3610":72534,"_31119":72530,"_5":31454,"_21540":120025,"_28300":120026,"_3066":120027},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3610":72535,"_31119":72530,"_21540":120029,"_5":14806,"_28300":72530,"_3066":120030},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3610":72536,"_31119":72530,"_21540":120032,"_5":14806,"_28300":120018,"_3066":120033},[],"Modelo",{"_3610":72537,"_31119":72530,"_21540":120035,"_5":14806,"_28300":120018,"_3066":120036},[],"Recomendado para",{"_3610":72538,"_31119":72530,"_21540":120038,"_5":14806,"_28300":120018,"_3066":120039},[],"Quién opera la infraestructura",{"_3610":72539,"_31119":72530,"_21540":120041,"_5":14806,"_28300":120018,"_3066":120042},[],"Punto de partida",{"_3610":72540,"_31119":72530,"_21540":120044,"_5":14806,"_28300":120018,"_3066":50909},[],{"_3610":72541,"_31119":72530,"_21540":120046,"_5":14806,"_28300":120018,"_3066":120047},[],"Producción, entornos regulados y despliegues personalizados",{"_3610":72542,"_31119":72530,"_21540":120049,"_5":14806,"_28300":120018,"_3066":120050},[],"Tu equipo",{"_3610":72543,"_31119":72530,"_21540":120052,"_5":14806,"_28300":120018,"_3066":120053},[],"Helm o Fastlane",{"_3610":72544,"_31119":72530,"_21540":120055,"_5":14806,"_28300":120018,"_3066":50921},[],{"_3610":72545,"_31119":72530,"_21540":120057,"_5":14806,"_28300":120018,"_3066":120058},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3610":72546,"_31119":72530,"_21540":120060,"_5":14806,"_28300":120018,"_3066":120050},[],{"_3610":72547,"_31119":72530,"_21540":120062,"_5":14806,"_28300":120018,"_3066":120063},[],"Imagen preconfigurada en EC2",{"_3610":72548,"_31119":72530,"_21540":120065,"_5":14806,"_28300":120018,"_3066":50932},[],{"_3610":72549,"_31119":72530,"_21540":120067,"_5":14806,"_28300":120018,"_3066":120068},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3610":72550,"_31119":72530,"_21540":120070,"_5":14806,"_28300":120018,"_3066":50938},[],{"_3610":72551,"_31119":72530,"_21540":120072,"_5":14806,"_28300":120018,"_3066":120073},[],"Suscripción gestionada",{"_3610":72552,"_31119":72530,"_21540":120075,"_5":14806,"_28300":120018,"_3066":120076},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3610":72553,"_31119":72530,"_21540":120078,"_5":14806,"_28300":120018,"_3066":120079},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3610":72554,"_31119":72530,"_21540":120081,"_5":14806,"_28300":120018,"_3066":120082},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3610":72555,"_31119":72530,"_21540":120084,"_5":14806,"_28300":120022,"_3066":120085},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3610":72556,"_31119":72530,"_21540":120087,"_5":14806,"_28300":120026,"_3066":120088},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3610":72557,"_31119":72557,"_5":15171,"_3066":120090,"_31457":120091,"_21540":120092,"_28300":72557},"Utiliza Lamassu como SaaS",[50802,119939,119940],[],{"_3610":72558,"_31119":72557,"_21540":120094,"_5":14806,"_28300":72557,"_3066":120095},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3610":72559,"_31119":72557,"_5":31454,"_21540":120097,"_28300":120098,"_3066":120099},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3610":72560,"_31119":72557,"_5":31454,"_21540":120101,"_28300":120102,"_3066":120103},[],"/docs/es/deployment/saas#planes","Planes",{"_3610":72561,"_31119":72557,"_5":31454,"_21540":120105,"_28300":120106,"_3066":120107},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3610":72562,"_31119":72557,"_21540":120109,"_5":14806,"_28300":72557,"_3066":120110},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3610":72563,"_31119":72557,"_21540":120112,"_5":14806,"_28300":120098,"_3066":120113},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3610":72564,"_31119":72557,"_21540":120115,"_5":14806,"_28300":120098,"_3066":120116},[],"Copias de seguridad automáticas.",{"_3610":72565,"_31119":72557,"_21540":120118,"_5":14806,"_28300":120098,"_3066":120119},[],"Actualizaciones de versión.",{"_3610":72566,"_31119":72557,"_21540":120121,"_5":14806,"_28300":120098,"_3066":120122},[],"Soporte técnico y SLA según el plan contratado.",{"_3610":72567,"_31119":72557,"_21540":120124,"_5":14806,"_28300":120102,"_3066":50993},[],{"_3610":72568,"_31119":72557,"_21540":120126,"_5":14806,"_28300":120102,"_3066":120127},[],"Dispositivos",{"_3610":72569,"_31119":72557,"_21540":120129,"_5":14806,"_28300":120102,"_3066":120130},[],"Soporte",{"_3610":72570,"_31119":72557,"_21540":120132,"_5":14806,"_28300":120102,"_3066":51002},[],{"_3610":72571,"_31119":72557,"_21540":120134,"_5":14806,"_28300":120102,"_3066":51005},[],{"_3610":72572,"_31119":72557,"_21540":120136,"_5":14806,"_28300":120102,"_3066":120137},[],"Hasta 1.000",{"_3610":72573,"_31119":72557,"_21540":120139,"_5":14806,"_28300":120102,"_3066":51011},[],{"_3610":72574,"_31119":72557,"_21540":120141,"_5":14806,"_28300":120102,"_3066":120142},[],"99,5 %",{"_3610":72575,"_31119":72557,"_21540":120144,"_5":14806,"_28300":120102,"_3066":51017},[],{"_3610":72576,"_31119":72557,"_21540":120146,"_5":14806,"_28300":120102,"_3066":120147},[],"Hasta 10.000",{"_3610":72577,"_31119":72557,"_21540":120149,"_5":14806,"_28300":120102,"_3066":120150},[],"Email y chat",{"_3610":72578,"_31119":72557,"_21540":120152,"_5":14806,"_28300":120102,"_3066":120153},[],"99,9 %",{"_3610":72579,"_31119":72557,"_21540":120155,"_5":14806,"_28300":120102,"_3066":51029},[],{"_3610":72580,"_31119":72557,"_21540":120157,"_5":14806,"_28300":120102,"_3066":120158},[],"Ilimitados",{"_3610":72581,"_31119":72557,"_21540":120160,"_5":14806,"_28300":120102,"_3066":120161},[],"Dedicado",{"_3610":72582,"_31119":72557,"_21540":120163,"_5":14806,"_28300":120102,"_3066":120164},[],"99,99 %",{"_3610":72583,"_31119":72557,"_21540":120166,"_5":14806,"_28300":120106,"_3066":120167},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3610":72584,"_31119":72557,"_21540":120169,"_5":14806,"_28300":120106,"_3066":120170},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3610":72585,"_31119":72585,"_5":15171,"_3066":51046,"_31457":120172,"_21540":120174,"_28300":72585},[50802,119939,120173],"Kubernetes autogestionado",[],{"_3610":72586,"_31119":72585,"_21540":120176,"_5":14806,"_28300":72585,"_3066":120177},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3610":72587,"_31119":72585,"_5":31454,"_21540":120179,"_28300":120180,"_3066":120181},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3610":72588,"_31119":72585,"_5":31454,"_21540":120183,"_28300":120184,"_3066":120185},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3610":72589,"_31119":72585,"_5":31454,"_21540":120187,"_28300":120188,"_3066":120189},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3610":72590,"_31119":72585,"_5":31454,"_21540":120191,"_28300":120192,"_3066":120193},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3610":72591,"_31119":72585,"_5":31454,"_21540":120195,"_28300":120196,"_3066":120197},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3610":72592,"_31119":72585,"_5":31454,"_21540":120199,"_28300":120200,"_3066":120201},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3610":72593,"_31119":72585,"_5":31454,"_21540":120203,"_28300":120204,"_3066":120205},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3610":72594,"_31119":72585,"_5":31454,"_21540":120207,"_28300":120208,"_3066":120209},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3610":72595,"_31119":72585,"_5":31454,"_21540":120211,"_28300":120212,"_3066":120213},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3610":72596,"_31119":72585,"_5":31454,"_21540":120215,"_28300":120216,"_3066":120217},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3610":72597,"_31119":72585,"_5":31454,"_21540":120219,"_28300":120220,"_3066":120221},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3610":72598,"_31119":72585,"_21540":120223,"_5":14806,"_28300":120180,"_3066":120224},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3610":72599,"_31119":72585,"_21540":120226,"_5":14806,"_28300":120180,"_3066":120227},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3610":72600,"_31119":72585,"_21540":120229,"_5":14806,"_28300":120184,"_3066":120230},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3610":72601,"_31119":72585,"_21540":120232,"_5":14806,"_28300":120184,"_3066":120233},[],"Fastlane instala o configura",{"_3610":72602,"_31119":72585,"_21540":120235,"_5":14806,"_28300":120184,"_3066":120236},[],"Tú sigues proporcionando",{"_3610":72603,"_31119":72585,"_21540":120238,"_5":14806,"_28300":120184,"_3066":120239},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3610":72604,"_31119":72585,"_21540":120241,"_5":14806,"_28300":120184,"_3066":120242},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3610":72605,"_31119":72585,"_21540":120244,"_5":14806,"_28300":120184,"_3066":120245},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3610":72606,"_31119":72585,"_21540":120247,"_5":14806,"_28300":120184,"_3066":120248},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3610":72607,"_31119":72585,"_21540":120250,"_5":14806,"_28300":120184,"_3066":120251},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3610":72608,"_31119":72585,"_21540":120253,"_5":14806,"_28300":120184,"_3066":120254},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3610":72609,"_31119":72585,"_21540":120256,"_5":14806,"_28300":120184,"_3066":120257},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3610":72610,"_31119":72585,"_21540":120259,"_5":14806,"_28300":120184,"_3066":120260},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3610":72611,"_31119":72585,"_21540":120262,"_5":14806,"_28300":120184,"_3066":120263},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3610":72612,"_31119":72585,"_21540":120265,"_5":14806,"_28300":120188,"_3066":120266},[],"Necesitas:",{"_3610":72613,"_31119":72585,"_21540":120268,"_5":14806,"_28300":120188,"_3066":120269},[],"un clúster Kubernetes existente",{"_3610":72614,"_31119":72585,"_21540":120271,"_5":14806,"_28300":120188,"_3066":120272},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3610":72615,"_31119":72585,"_21540":120274,"_5":14806,"_28300":120188,"_3066":51148},[],{"_3610":72616,"_31119":72585,"_21540":120276,"_5":14806,"_28300":120188,"_3066":24346},[],{"_3610":72617,"_31119":72585,"_21540":120278,"_5":14806,"_28300":120188,"_3066":120279},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3610":72618,"_31119":72585,"_21540":120281,"_5":14806,"_28300":120188,"_3066":120282},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3610":72619,"_31119":72585,"_21540":120284,"_5":14806,"_28300":120188,"_3066":120285},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3610":72620,"_31119":72585,"_21540":120287,"_5":14806,"_28300":120188,"_3066":120288},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3610":72621,"_31119":72585,"_21540":120290,"_5":14806,"_28300":120188,"_3066":120291},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3610":72622,"_31119":72585,"_21540":120293,"_5":14806,"_28300":120192,"_3066":120294},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3610":72623,"_31119":72585,"_21540":120296,"_5":14806,"_28300":120192,"_3066":120297},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3610":72624,"_31119":72585,"_21540":120299,"_5":14806,"_28300":120196,"_3066":120300},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3610":72625,"_31119":72585,"_21540":120302,"_5":14806,"_28300":120196,"_3066":120303},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3610":72626,"_31119":72585,"_21540":120305,"_5":14806,"_28300":120196,"_3066":120306},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3610":72627,"_31119":72585,"_21540":120308,"_5":14806,"_28300":120196,"_3066":120309},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3610":72628,"_31119":72585,"_21540":120311,"_5":14806,"_28300":120200,"_3066":120312},[],"Opción",{"_3610":72629,"_31119":72585,"_21540":120314,"_5":14806,"_28300":120200,"_3066":120315},[],"Valor predeterminado",{"_3610":72630,"_31119":72585,"_21540":120317,"_5":14806,"_28300":120200,"_3066":120318},[],"Propósito",{"_3610":72631,"_31119":72585,"_21540":120320,"_5":14806,"_28300":120200,"_3066":51195},[],{"_3610":72632,"_31119":72585,"_21540":120322,"_5":14806,"_28300":120200,"_3066":51198},[],{"_3610":72633,"_31119":72585,"_21540":120324,"_5":14806,"_28300":120200,"_3066":120325},[],"Muestra la ayuda",{"_3610":72634,"_31119":72585,"_21540":120327,"_5":14806,"_28300":120200,"_3066":51204},[],{"_3610":72635,"_31119":72585,"_21540":120329,"_5":14806,"_28300":120200,"_3066":120330},[],"contexto actual",{"_3610":72636,"_31119":72585,"_21540":120332,"_5":14806,"_28300":120200,"_3066":120333},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3610":72637,"_31119":72585,"_21540":120335,"_5":14806,"_28300":120200,"_3066":51213},[],{"_3610":72638,"_31119":72585,"_21540":120337,"_5":14806,"_28300":120200,"_3066":6772},[],{"_3610":72639,"_31119":72585,"_21540":120339,"_5":14806,"_28300":120200,"_3066":120340},[],"Omite prompts y genera credenciales para las dependencias",{"_3610":72640,"_31119":72585,"_21540":120342,"_5":14806,"_28300":120200,"_3066":51221},[],{"_3610":72641,"_31119":72585,"_21540":120344,"_5":14806,"_28300":120200,"_3066":51224},[],{"_3610":72642,"_31119":72585,"_21540":120346,"_5":14806,"_28300":120200,"_3066":120347},[],"Namespace de la instalación",{"_3610":72643,"_31119":72585,"_21540":120349,"_5":14806,"_28300":120200,"_3066":51230},[],{"_3610":72644,"_31119":72585,"_21540":120351,"_5":14806,"_28300":120200,"_3066":51233},[],{"_3610":72645,"_31119":72585,"_21540":120353,"_5":14806,"_28300":120200,"_3066":120354},[],"Dominio usado por la UI, OIDC y el certificado",{"_3610":72646,"_31119":72585,"_21540":120356,"_5":14806,"_28300":120200,"_3066":51239},[],{"_3610":72647,"_31119":72585,"_21540":120358,"_5":14806,"_28300":120200,"_3066":15518},[],{"_3610":72648,"_31119":72585,"_21540":120360,"_5":14806,"_28300":120200,"_3066":120361},[],"Versión del chart de Lamassu",{"_3610":72649,"_31119":72585,"_21540":120363,"_5":14806,"_28300":120200,"_3066":51247},[],{"_3610":72650,"_31119":72585,"_21540":120365,"_5":14806,"_28300":120200,"_3066":51250},[],{"_3610":72651,"_31119":72585,"_21540":120367,"_5":14806,"_28300":120200,"_3066":120368},[],"Puerto del listener HTTPS",{"_3610":72652,"_31119":72585,"_21540":120370,"_5":14806,"_28300":120200,"_3066":51256},[],{"_3610":72653,"_31119":72585,"_21540":120372,"_5":14806,"_28300":120200,"_3066":51259},[],{"_3610":72654,"_31119":72585,"_21540":120374,"_5":14806,"_28300":120200,"_3066":120375},[],"Puerto del listener HTTP",{"_3610":72655,"_31119":72585,"_21540":120377,"_5":14806,"_28300":120200,"_3066":51265},[],{"_3610":72656,"_31119":72585,"_21540":120379,"_5":14806,"_28300":120200,"_3066":51198},[],{"_3610":72657,"_31119":72585,"_21540":120381,"_5":14806,"_28300":120200,"_3066":120382},[],"Certificado PEM para TLS downstream",{"_3610":72658,"_31119":72585,"_21540":120384,"_5":14806,"_28300":120200,"_3066":51273},[],{"_3610":72659,"_31119":72585,"_21540":120386,"_5":14806,"_28300":120200,"_3066":51198},[],{"_3610":72660,"_31119":72585,"_21540":120388,"_5":14806,"_28300":120200,"_3066":120389},[],"Clave privada PEM para TLS downstream",{"_3610":72661,"_31119":72585,"_21540":120391,"_5":14806,"_28300":120200,"_3066":51281},[],{"_3610":72662,"_31119":72585,"_21540":120393,"_5":14806,"_28300":120200,"_3066":120394},[],"chart del repositorio",{"_3610":72663,"_31119":72585,"_21540":120396,"_5":14806,"_28300":120200,"_3066":120397},[],"Usa un chart local de Lamassu sin empaquetar",{"_3610":72664,"_31119":72585,"_21540":120399,"_5":14806,"_28300":120200,"_3066":51290},[],{"_3610":72665,"_31119":72585,"_21540":120401,"_5":14806,"_28300":120200,"_3066":120402},[],"detección automática",{"_3610":72666,"_31119":72585,"_21540":120404,"_5":14806,"_28300":120200,"_3066":120405},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3610":72667,"_31119":72585,"_21540":120407,"_5":14806,"_28300":120200,"_3066":51298},[],{"_3610":72668,"_31119":72585,"_21540":120409,"_5":14806,"_28300":120200,"_3066":6772},[],{"_3610":72669,"_31119":72585,"_21540":120411,"_5":14806,"_28300":120200,"_3066":120412},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3610":72670,"_31119":72585,"_21540":120414,"_5":14806,"_28300":120200,"_3066":51306},[],{"_3610":72671,"_31119":72585,"_21540":120416,"_5":14806,"_28300":120200,"_3066":6772},[],{"_3610":72672,"_31119":72585,"_21540":120418,"_5":14806,"_28300":120200,"_3066":120419},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3610":72673,"_31119":72585,"_21540":120421,"_5":14806,"_28300":120200,"_3066":51314},[],{"_3610":72674,"_31119":72585,"_21540":120423,"_5":14806,"_28300":120200,"_3066":6772},[],{"_3610":72675,"_31119":72585,"_21540":120425,"_5":14806,"_28300":120200,"_3066":120426},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3610":72676,"_31119":72585,"_21540":120428,"_5":14806,"_28300":120200,"_3066":51322},[],{"_3610":72677,"_31119":72585,"_21540":120430,"_5":14806,"_28300":120200,"_3066":6772},[],{"_3610":72678,"_31119":72585,"_21540":120432,"_5":14806,"_28300":120200,"_3066":120433},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3610":72679,"_31119":72585,"_21540":120435,"_5":14806,"_28300":120200,"_3066":51330},[],{"_3610":72680,"_31119":72585,"_21540":120437,"_5":14806,"_28300":120200,"_3066":51333},[],{"_3610":72681,"_31119":72585,"_21540":120439,"_5":14806,"_28300":120200,"_3066":120440},[],"Usa otro chart local de SoftHSM",{"_3610":72682,"_31119":72585,"_21540":120442,"_5":14806,"_28300":120200,"_3066":120443},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3610":72683,"_31119":72585,"_21540":120445,"_5":14806,"_28300":120204,"_3066":120446},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3610":72684,"_31119":72585,"_21540":120448,"_5":14806,"_28300":120204,"_3066":120449},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3610":72685,"_31119":72585,"_21540":120451,"_5":14806,"_28300":120204,"_3066":120452},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3610":72686,"_31119":72585,"_21540":120454,"_5":14806,"_28300":120204,"_3066":120455},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3610":72687,"_31119":72585,"_21540":120457,"_5":14806,"_28300":120204,"_3066":120458},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3610":72688,"_31119":72585,"_21540":120460,"_5":14806,"_28300":120204,"_3066":120461},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3610":72689,"_31119":72585,"_21540":120463,"_5":14806,"_28300":120208,"_3066":51360},[],{"_3610":72690,"_31119":72585,"_21540":120465,"_5":14806,"_28300":120208,"_3066":120466},[],"valida las herramientas locales y el clúster seleccionado",{"_3610":72691,"_31119":72585,"_21540":120468,"_5":14806,"_28300":120208,"_3066":120469},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3610":72692,"_31119":72585,"_21540":120471,"_5":14806,"_28300":120208,"_3066":120472},[],"crea el namespace",{"_3610":72693,"_31119":72585,"_21540":120474,"_5":14806,"_28300":120208,"_3066":120475},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3610":72694,"_31119":72585,"_21540":120477,"_5":14806,"_28300":120208,"_3066":120478},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3610":72695,"_31119":72585,"_21540":120480,"_5":14806,"_28300":120208,"_3066":120481},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3610":72696,"_31119":72585,"_21540":120483,"_5":14806,"_28300":120208,"_3066":120484},[],"instala RabbitMQ",{"_3610":72697,"_31119":72585,"_21540":120486,"_5":14806,"_28300":120208,"_3066":120487},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3610":72698,"_31119":72585,"_21540":120489,"_5":14806,"_28300":120208,"_3066":120490},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3610":72699,"_31119":72585,"_21540":120492,"_5":14806,"_28300":120208,"_3066":120493},[],"carga datos de ejemplo opcionalmente",{"_3610":72700,"_31119":72585,"_21540":120495,"_5":14806,"_28300":120208,"_3066":120496},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3610":72701,"_31119":72585,"_21540":120498,"_5":14806,"_28300":120212,"_3066":120499},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3610":72702,"_31119":72585,"_21540":120501,"_5":14806,"_28300":120212,"_3066":120502},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3610":72703,"_31119":72585,"_21540":120504,"_5":14806,"_28300":120216,"_3066":120505},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3610":72704,"_31119":72585,"_21540":120507,"_5":14806,"_28300":120216,"_3066":120508},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3610":72705,"_31119":72585,"_21540":120510,"_5":14806,"_28300":120216,"_3066":120511},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3610":72706,"_31119":72585,"_21540":120513,"_5":14806,"_28300":120216,"_3066":120514},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3610":72707,"_31119":72585,"_21540":120516,"_5":14806,"_28300":120220,"_3066":120517},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3610":72708,"_31119":72708,"_5":15171,"_3066":120519,"_31457":120520,"_21540":120521,"_28300":72708},"Instala con Helm",[50802,119939,120173],[],{"_3610":72709,"_31119":72708,"_21540":120523,"_5":14806,"_28300":72708,"_3066":120524},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3610":72710,"_31119":72708,"_5":31454,"_21540":120526,"_28300":120527,"_3066":120528},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3610":72711,"_31119":72708,"_5":31454,"_21540":120530,"_28300":120531,"_3066":120189},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3610":72712,"_31119":72708,"_5":31454,"_21540":120533,"_28300":120534,"_3066":120535},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3610":72713,"_31119":72708,"_5":31454,"_21540":120537,"_28300":120538,"_3066":120539},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3610":72714,"_31119":72708,"_5":31454,"_21540":120541,"_28300":120542,"_3066":120543},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3610":72715,"_31119":72708,"_5":31454,"_21540":120545,"_28300":120546,"_3066":120547},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3610":72716,"_31119":72708,"_5":31454,"_21540":120549,"_28300":120550,"_3066":120551},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3610":72717,"_31119":72708,"_5":31454,"_21540":120553,"_28300":120554,"_3066":120555},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3610":72718,"_31119":72708,"_5":31454,"_21540":120557,"_28300":120558,"_3066":120559},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3610":72719,"_31119":72708,"_5":31454,"_21540":120561,"_28300":120562,"_3066":120563},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3610":72720,"_31119":72708,"_5":31454,"_21540":120565,"_28300":120566,"_3066":120567},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3610":72721,"_31119":72708,"_5":31454,"_21540":120569,"_28300":120570,"_3066":120571},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3610":72722,"_31119":72708,"_21540":120573,"_5":14806,"_28300":120527,"_3066":120574},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3610":72723,"_31119":72708,"_21540":120576,"_5":14806,"_28300":120531,"_3066":120577},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3610":72724,"_31119":72708,"_21540":120579,"_5":14806,"_28300":120531,"_3066":120580},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3610":72725,"_31119":72708,"_21540":120582,"_5":14806,"_28300":120531,"_3066":120583},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3610":72726,"_31119":72708,"_21540":120585,"_5":14806,"_28300":120531,"_3066":120586},[],"un broker RabbitMQ accesible y sus credenciales",{"_3610":72727,"_31119":72708,"_21540":120588,"_5":14806,"_28300":120531,"_3066":120589},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3610":72728,"_31119":72708,"_21540":120591,"_5":14806,"_28300":120531,"_3066":120592},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3610":72729,"_31119":72708,"_21540":120594,"_5":14806,"_28300":120531,"_3066":120595},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3610":72730,"_31119":72708,"_21540":120597,"_5":14806,"_28300":120531,"_3066":120598},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3610":72731,"_31119":72708,"_21540":120600,"_5":14806,"_28300":120531,"_3066":120601},[],"una StorageClass y un diseño de tráfico externo",{"_3610":72732,"_31119":72708,"_21540":120603,"_5":14806,"_28300":120531,"_3066":120604},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3610":72733,"_31119":72708,"_21540":120606,"_5":14806,"_28300":120531,"_3066":120607},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3610":72734,"_31119":72708,"_21540":120609,"_5":14806,"_28300":120531,"_3066":120610},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3610":72735,"_31119":72708,"_21540":120612,"_5":14806,"_28300":120534,"_3066":120613},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3610":72736,"_31119":72708,"_21540":120615,"_5":14806,"_28300":120534,"_3066":120616},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3610":72737,"_31119":72708,"_21540":120618,"_5":14806,"_28300":120534,"_3066":120619},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3610":72738,"_31119":72708,"_21540":120621,"_5":14806,"_28300":120538,"_3066":120622},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3610":72739,"_31119":72708,"_21540":120624,"_5":14806,"_28300":120538,"_3066":120625},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3610":72740,"_31119":72708,"_21540":120627,"_5":14806,"_28300":120538,"_3066":120628},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3610":72741,"_31119":72708,"_21540":120630,"_5":14806,"_28300":120538,"_3066":120631},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3610":72742,"_31119":72708,"_21540":120633,"_5":14806,"_28300":120542,"_3066":120634},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3610":72743,"_31119":72708,"_21540":120636,"_5":14806,"_28300":120542,"_3066":120637},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3610":72744,"_31119":72708,"_21540":120639,"_5":14806,"_28300":120542,"_3066":120640},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3610":72745,"_31119":72708,"_21540":120642,"_5":14806,"_28300":120542,"_3066":120643},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3610":72746,"_31119":72708,"_21540":120645,"_5":14806,"_28300":120542,"_3066":120646},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3610":72747,"_31119":72708,"_21540":120648,"_5":14806,"_28300":120542,"_3066":120649},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3610":72748,"_31119":72708,"_21540":120651,"_5":14806,"_28300":120542,"_3066":120652},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3610":72749,"_31119":72708,"_21540":120654,"_5":14806,"_28300":120542,"_3066":120655},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3610":72750,"_31119":72708,"_21540":120657,"_5":14806,"_28300":120546,"_3066":120658},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3610":72751,"_31119":72708,"_21540":120660,"_5":14806,"_28300":120550,"_3066":120661},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3610":72752,"_31119":72708,"_21540":120663,"_5":14806,"_28300":120550,"_3066":120664},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3610":72753,"_31119":72708,"_21540":120666,"_5":14806,"_28300":120550,"_3066":120667},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3610":72754,"_31119":72708,"_21540":120669,"_5":14806,"_28300":120550,"_3066":120670},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3610":72755,"_31119":72708,"_21540":120672,"_5":14806,"_28300":120550,"_3066":120673},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3610":72756,"_31119":72708,"_21540":120675,"_5":14806,"_28300":120550,"_3066":120676},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3610":72757,"_31119":72708,"_21540":120678,"_5":14806,"_28300":120550,"_3066":120679},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3610":72758,"_31119":72708,"_21540":120681,"_5":14806,"_28300":120554,"_3066":120682},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3610":72759,"_31119":72708,"_21540":120684,"_5":14806,"_28300":120554,"_3066":120685},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3610":72760,"_31119":72708,"_21540":120687,"_5":14806,"_28300":120554,"_3066":120688},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3610":72761,"_31119":72708,"_21540":120690,"_5":14806,"_28300":120554,"_3066":120691},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3610":72762,"_31119":72708,"_21540":120693,"_5":14806,"_28300":120558,"_3066":120694},[],"Para instalar un checkout local:",{"_3610":72763,"_31119":72708,"_21540":120696,"_5":14806,"_28300":120562,"_3066":120697},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3610":72764,"_31119":72708,"_21540":120699,"_5":14806,"_28300":120562,"_3066":120700},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3610":72765,"_31119":72708,"_21540":120702,"_5":14806,"_28300":120566,"_3066":120703},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3610":72766,"_31119":72708,"_21540":120705,"_5":14806,"_28300":120566,"_3066":120706},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3610":72767,"_31119":72708,"_21540":120708,"_5":14806,"_28300":120566,"_3066":120709},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3610":72768,"_31119":72708,"_21540":120711,"_5":14806,"_28300":120566,"_3066":120712},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3610":72769,"_31119":72708,"_21540":120714,"_5":14806,"_28300":120566,"_3066":120715},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3610":72770,"_31119":72708,"_21540":120717,"_5":14806,"_28300":120570,"_3066":120718},[],"Antes de pasar a producción, revisa:",{"_3610":72771,"_31119":72708,"_21540":120720,"_5":14806,"_28300":120570,"_3066":120721},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3610":72772,"_31119":72708,"_21540":120723,"_5":14806,"_28300":120570,"_3066":120724},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3610":72773,"_31119":72708,"_21540":120726,"_5":14806,"_28300":120570,"_3066":120727},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3610":72774,"_31119":72708,"_21540":120729,"_5":14806,"_28300":120570,"_3066":120730},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3610":72775,"_31119":72708,"_21540":120732,"_5":14806,"_28300":120570,"_3066":120733},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3610":72776,"_31119":72708,"_21540":120735,"_5":14806,"_28300":120570,"_3066":120736},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3610":72777,"_31119":72708,"_21540":120738,"_5":14806,"_28300":120570,"_3066":120739},[],"SMTP, observabilidad y entrega de alertas",{"_3610":72778,"_31119":72708,"_21540":120741,"_5":14806,"_28300":120570,"_3066":120742},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3610":72779,"_31119":72708,"_21540":120744,"_5":14806,"_28300":120570,"_3066":120745},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3610":72780,"_31119":72780,"_5":15171,"_3066":120747,"_31457":120748,"_21540":120749,"_28300":72780},"Expón el Gateway",[50802,119939,120173],[],{"_3610":72781,"_31119":72780,"_21540":120751,"_5":14806,"_28300":72780,"_3066":120752},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3610":72782,"_31119":72780,"_5":31454,"_21540":120754,"_28300":120755,"_3066":120756},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3610":72783,"_31119":72780,"_5":31454,"_21540":120758,"_28300":120759,"_3066":120760},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3610":72784,"_31119":72780,"_5":31454,"_21540":120762,"_28300":120763,"_3066":120764},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3610":72785,"_31119":72780,"_5":31454,"_21540":120766,"_28300":120767,"_3066":51665},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3610":72786,"_31119":72780,"_5":31454,"_21540":120769,"_28300":120770,"_3066":120771},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3610":72787,"_31119":72780,"_5":31454,"_21540":120773,"_28300":120774,"_3066":120775},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3610":72788,"_31119":72780,"_5":31454,"_21540":120777,"_28300":120778,"_3066":120779},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3610":72789,"_31119":72780,"_5":31454,"_21540":120781,"_28300":120782,"_3066":120783},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3610":72790,"_31119":72780,"_5":31454,"_21540":120785,"_28300":120786,"_3066":120787},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3610":72791,"_31119":72780,"_5":31454,"_21540":120789,"_28300":120790,"_3066":120791},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3610":72792,"_31119":72780,"_5":31454,"_21540":120793,"_28300":120794,"_3066":120795},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3610":72793,"_31119":72780,"_21540":120797,"_5":14806,"_28300":120755,"_3066":120798},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3610":72794,"_31119":72780,"_21540":120800,"_5":14806,"_28300":120755,"_3066":120801},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3610":72795,"_31119":72780,"_21540":120803,"_5":14806,"_28300":120759,"_3066":120804},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3610":72796,"_31119":72780,"_21540":120806,"_5":14806,"_28300":120759,"_3066":120807},[],"Defínelo únicamente cuando:",{"_3610":72797,"_31119":72780,"_21540":120809,"_5":14806,"_28300":120759,"_3066":120810},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3610":72798,"_31119":72780,"_21540":120812,"_5":14806,"_28300":120759,"_3066":120813},[],"esa dirección está asignada a este Gateway",{"_3610":72799,"_31119":72780,"_21540":120815,"_5":14806,"_28300":120759,"_3066":120816},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3610":72800,"_31119":72780,"_21540":120818,"_5":14806,"_28300":120759,"_3066":120819},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3610":72801,"_31119":72780,"_21540":120821,"_5":14806,"_28300":120759,"_3066":120822},[],"No confundas estos valores:",{"_3610":72802,"_31119":72780,"_21540":120824,"_5":14806,"_28300":120759,"_3066":120825},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3610":72803,"_31119":72780,"_21540":120827,"_5":14806,"_28300":120759,"_3066":120828},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3610":72804,"_31119":72780,"_21540":120830,"_5":14806,"_28300":120759,"_3066":120831},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3610":72805,"_31119":72780,"_21540":120833,"_5":14806,"_28300":120763,"_3066":120834},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3610":72806,"_31119":72780,"_21540":120836,"_5":14806,"_28300":120763,"_3066":120837},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3610":72807,"_31119":72780,"_21540":120839,"_5":14806,"_28300":120767,"_3066":120840},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3610":72808,"_31119":72780,"_21540":120842,"_5":14806,"_28300":120767,"_3066":120843},[],"Para el diseño recomendado:",{"_3610":72809,"_31119":72780,"_21540":120845,"_5":14806,"_28300":120767,"_3066":120846},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3610":72810,"_31119":72780,"_21540":120848,"_5":14806,"_28300":120767,"_3066":120849},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3610":72811,"_31119":72780,"_21540":120851,"_5":14806,"_28300":120767,"_3066":120852},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3610":72812,"_31119":72780,"_21540":120854,"_5":14806,"_28300":120767,"_3066":120855},[],"Apunta DNS a la dirección accesible de la VM.",{"_3610":72813,"_31119":72780,"_21540":120857,"_5":14806,"_28300":120767,"_3066":120858},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3610":72814,"_31119":72780,"_21540":120860,"_5":14806,"_28300":120770,"_3066":120861},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3610":72815,"_31119":72780,"_21540":120863,"_5":14806,"_28300":120774,"_3066":120864},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3610":72816,"_31119":72780,"_21540":120866,"_5":14806,"_28300":120774,"_3066":120867},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3610":72817,"_31119":72780,"_21540":120869,"_5":14806,"_28300":120778,"_3066":120870},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3610":72818,"_31119":72780,"_21540":120872,"_5":14806,"_28300":120778,"_3066":120873},[],"Requisito",{"_3610":72819,"_31119":72780,"_21540":120875,"_5":14806,"_28300":120778,"_3066":120876},[],"Diseño recomendado",{"_3610":72820,"_31119":72780,"_21540":120878,"_5":14806,"_28300":120778,"_3066":120879},[],"Consecuencia",{"_3610":72821,"_31119":72780,"_21540":120881,"_5":14806,"_28300":120778,"_3066":120882},[],"Varias URL o servicios de Lamassu",{"_3610":72822,"_31119":72780,"_21540":120884,"_5":14806,"_28300":120778,"_3066":120885},[],"Un Gateway con varias rutas",{"_3610":72823,"_31119":72780,"_21540":120887,"_5":14806,"_28300":120778,"_3066":120888},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3610":72824,"_31119":72780,"_21540":120890,"_5":14806,"_28300":120778,"_3066":120891},[],"Gateways independientes e IP externas distintas",{"_3610":72825,"_31119":72780,"_21540":120893,"_5":14806,"_28300":120778,"_3066":120894},[],"Una VIP por Gateway",{"_3610":72826,"_31119":72780,"_21540":120896,"_5":14806,"_28300":120778,"_3066":120897},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3610":72827,"_31119":72780,"_21540":120899,"_5":14806,"_28300":120778,"_3066":120900},[],"Gateways independientes, un nodo y una IP",{"_3610":72828,"_31119":72780,"_21540":120902,"_5":14806,"_28300":120778,"_3066":120903},[],"Puertos externos diferentes",{"_3610":72829,"_31119":72780,"_21540":120905,"_5":14806,"_28300":120778,"_3066":120906},[],"Los clientes deben indicar puertos no estándar",{"_3610":72830,"_31119":72780,"_21540":120908,"_5":14806,"_28300":120778,"_3066":120909},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3610":72831,"_31119":72780,"_21540":120911,"_5":14806,"_28300":120778,"_3066":120912},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3610":72832,"_31119":72780,"_21540":120914,"_5":14806,"_28300":120778,"_3066":120915},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3610":72833,"_31119":72780,"_21540":120917,"_5":14806,"_28300":120778,"_3066":120918},[],"Recursos Gateway separados pero proxy compartido",{"_3610":72834,"_31119":72780,"_21540":120920,"_5":14806,"_28300":120778,"_3066":120921},[],"Modo merged Gateway de Envoy",{"_3610":72835,"_31119":72780,"_21540":120923,"_5":14806,"_28300":120778,"_3066":120924},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3610":72836,"_31119":72780,"_21540":120926,"_5":14806,"_28300":120778,"_3066":120927},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3610":72837,"_31119":72780,"_21540":120929,"_5":14806,"_28300":120778,"_3066":120930},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3610":72838,"_31119":72780,"_21540":120932,"_5":14806,"_28300":120778,"_3066":120933},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3610":72839,"_31119":72780,"_21540":120935,"_5":14806,"_28300":120778,"_3066":120936},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3610":72840,"_31119":72780,"_21540":120938,"_5":14806,"_28300":120782,"_3066":120939},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3610":72841,"_31119":72780,"_21540":120941,"_5":14806,"_28300":120786,"_3066":120942},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3610":72842,"_31119":72780,"_21540":120944,"_5":14806,"_28300":120786,"_3066":120945},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3610":72843,"_31119":72780,"_21540":120947,"_5":14806,"_28300":120786,"_3066":120948},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3610":72844,"_31119":72780,"_21540":120950,"_5":14806,"_28300":120786,"_3066":120951},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3610":72845,"_31119":72780,"_21540":120953,"_5":14806,"_28300":120786,"_3066":120954},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3610":72846,"_31119":72780,"_21540":120956,"_5":14806,"_28300":120790,"_3066":120957},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3610":72847,"_31119":72780,"_21540":120959,"_5":14806,"_28300":120790,"_3066":120960},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3610":72848,"_31119":72780,"_21540":120962,"_5":14806,"_28300":120794,"_3066":120963},[],"Comprueba, en orden:",{"_3610":72849,"_31119":72780,"_21540":120965,"_5":14806,"_28300":120794,"_3066":120966},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3610":72850,"_31119":72780,"_21540":120968,"_5":14806,"_28300":120794,"_3066":120969},[],"Su estado contiene la dirección esperada.",{"_3610":72851,"_31119":72780,"_21540":120971,"_5":14806,"_28300":120794,"_3066":120972},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3610":72852,"_31119":72780,"_21540":120974,"_5":14806,"_28300":120794,"_3066":120975},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3610":72853,"_31119":72780,"_21540":120977,"_5":14806,"_28300":120794,"_3066":120978},[],"DNS resuelve al endpoint accesible externamente.",{"_3610":72854,"_31119":72780,"_21540":120980,"_5":14806,"_28300":120794,"_3066":120981},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3610":72855,"_31119":72780,"_21540":120983,"_5":14806,"_28300":120794,"_3066":120984},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3610":72856,"_31119":72856,"_5":15171,"_3066":50909,"_31457":120986,"_21540":120987,"_28300":72856},[50802,119939,120173],[],{"_3610":72857,"_31119":72856,"_21540":120989,"_5":14806,"_28300":72856,"_3066":120990},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3610":72858,"_31119":72856,"_5":31454,"_21540":120992,"_28300":120993,"_3066":120994},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3610":72859,"_31119":72856,"_5":31454,"_21540":120996,"_28300":120997,"_3066":120998},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3610":72860,"_31119":72856,"_5":31454,"_21540":121000,"_28300":121001,"_3066":121002},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3610":72861,"_31119":72856,"_5":31454,"_21540":121004,"_28300":121005,"_3066":121006},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3610":72862,"_31119":72856,"_5":31454,"_21540":121008,"_28300":121009,"_3066":121010},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3610":72863,"_31119":72856,"_5":31454,"_21540":121012,"_28300":121013,"_3066":121014},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3610":72864,"_31119":72856,"_21540":121016,"_5":14806,"_28300":120993,"_3066":121017},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3610":72865,"_31119":72856,"_21540":121019,"_5":14806,"_28300":120997,"_3066":121020},[],"Flujo",{"_3610":72866,"_31119":72856,"_21540":121022,"_5":14806,"_28300":120997,"_3066":121023},[],"Úsalo para",{"_3610":72867,"_31119":72856,"_21540":121025,"_5":14806,"_28300":120997,"_3066":121026},[],"Qué instala",{"_3610":72868,"_31119":72856,"_21540":121028,"_5":14806,"_28300":120997,"_3066":51927},[],{"_3610":72869,"_31119":72856,"_21540":121030,"_5":14806,"_28300":120997,"_3066":121031},[],"Producción y entornos controlados",{"_3610":72870,"_31119":72856,"_21540":121033,"_5":14806,"_28300":120997,"_3066":121034},[],"Servicios de Lamassu y recursos de Gateway API",{"_3610":72871,"_31119":72856,"_21540":121036,"_5":14806,"_28300":120997,"_3066":51046},[],{"_3610":72872,"_31119":72856,"_21540":121038,"_5":14806,"_28300":120997,"_3066":121039},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3610":72873,"_31119":72856,"_21540":121041,"_5":14806,"_28300":120997,"_3066":121042},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3610":72874,"_31119":72856,"_21540":121044,"_5":14806,"_28300":121001,"_3066":121045},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3610":72875,"_31119":72856,"_21540":121047,"_5":14806,"_28300":121001,"_3066":121048},[],"Área",{"_3610":72876,"_31119":72856,"_21540":121050,"_5":14806,"_28300":121001,"_3066":121051},[],"El chart de Lamassu proporciona",{"_3610":72877,"_31119":72856,"_21540":121053,"_5":14806,"_28300":121001,"_3066":121054},[],"Tú proporcionas",{"_3610":72878,"_31119":72856,"_21540":121056,"_5":14806,"_28300":121001,"_3066":121057},[],"Aplicaciones Lamassu",{"_3610":72879,"_31119":72856,"_21540":121059,"_5":14806,"_28300":121001,"_3066":121060},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3610":72880,"_31119":72856,"_21540":121062,"_5":14806,"_28300":121001,"_3066":121063},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3610":72881,"_31119":72856,"_21540":121065,"_5":14806,"_28300":121001,"_3066":121066},[],"Datos PostgreSQL",{"_3610":72882,"_31119":72856,"_21540":121068,"_5":14806,"_28300":121001,"_3066":121069},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3610":72883,"_31119":72856,"_21540":121071,"_5":14806,"_28300":121001,"_3066":121072},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3610":72884,"_31119":72856,"_21540":121074,"_5":14806,"_28300":121001,"_3066":121075},[],"Mensajería",{"_3610":72885,"_31119":72856,"_21540":121077,"_5":14806,"_28300":121001,"_3066":121078},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3610":72886,"_31119":72856,"_21540":121080,"_5":14806,"_28300":121001,"_3066":121081},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3610":72887,"_31119":72856,"_21540":121083,"_5":14806,"_28300":121001,"_3066":121084},[],"Identidad",{"_3610":72888,"_31119":72856,"_21540":121086,"_5":14806,"_28300":121001,"_3066":121087},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3610":72889,"_31119":72856,"_21540":121089,"_5":14806,"_28300":121001,"_3066":121090},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3610":72890,"_31119":72856,"_21540":121092,"_5":14806,"_28300":121001,"_3066":121093},[],"Enrutamiento externo",{"_3610":72891,"_31119":72856,"_21540":121095,"_5":14806,"_28300":121001,"_3066":121096},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3610":72892,"_31119":72856,"_21540":121098,"_5":14806,"_28300":121001,"_3066":121099},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3610":72893,"_31119":72856,"_21540":121101,"_5":14806,"_28300":121001,"_3066":52001},[],{"_3610":72894,"_31119":72856,"_21540":121103,"_5":14806,"_28300":121001,"_3066":121104},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3610":72895,"_31119":72856,"_21540":121106,"_5":14806,"_28300":121001,"_3066":121107},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3610":72896,"_31119":72856,"_21540":121109,"_5":14806,"_28300":121001,"_3066":121110},[],"Datos persistentes de la aplicación",{"_3610":72897,"_31119":72856,"_21540":121112,"_5":14806,"_28300":121001,"_3066":121113},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3610":72898,"_31119":72856,"_21540":121115,"_5":14806,"_28300":121001,"_3066":121116},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3610":72899,"_31119":72856,"_21540":121118,"_5":14806,"_28300":121001,"_3066":121119},[],"Integraciones opcionales",{"_3610":72900,"_31119":72856,"_21540":121121,"_5":14806,"_28300":121001,"_3066":121122},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3610":72901,"_31119":72856,"_21540":121124,"_5":14806,"_28300":121001,"_3066":121125},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3610":72902,"_31119":72856,"_21540":121127,"_5":14806,"_28300":121001,"_3066":121128},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3610":72903,"_31119":72856,"_21540":121130,"_5":14806,"_28300":121001,"_3066":121131},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3610":72904,"_31119":72856,"_21540":121133,"_5":14806,"_28300":121005,"_3066":121134},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3610":72905,"_31119":72856,"_21540":121136,"_5":14806,"_28300":121005,"_3066":121137},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3610":72906,"_31119":72856,"_21540":121139,"_5":14806,"_28300":121009,"_3066":121140},[],"Kubernetes 1.24 o posterior",{"_3610":72907,"_31119":72856,"_21540":121142,"_5":14806,"_28300":121009,"_3066":121143},[],"Helm 3.2 o posterior",{"_3610":72908,"_31119":72856,"_21540":121145,"_5":14806,"_28300":121009,"_3066":121146},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3610":72909,"_31119":72856,"_21540":121148,"_5":14806,"_28300":121009,"_3066":121149},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3610":72910,"_31119":72856,"_21540":121151,"_5":14806,"_28300":121009,"_3066":121152},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3610":72911,"_31119":72856,"_21540":121154,"_5":14806,"_28300":121009,"_3066":121155},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3610":72912,"_31119":72856,"_21540":121157,"_5":14806,"_28300":121009,"_3066":121158},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3610":72913,"_31119":72856,"_21540":121160,"_5":14806,"_28300":121013,"_3066":121161},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3610":72914,"_31119":72856,"_21540":121163,"_5":14806,"_28300":121013,"_3066":121164},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3610":72915,"_31119":72856,"_21540":121166,"_5":14806,"_28300":121013,"_3066":121167},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3610":72916,"_31119":72856,"_21540":121169,"_5":14806,"_28300":121013,"_3066":121170},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3610":72917,"_31119":72917,"_5":15171,"_3066":121172,"_31457":121173,"_21540":121175,"_28300":72917},"Resolución de problemas de despliegue",[50802,119939,121174],"Operación",[],{"_3610":72918,"_31119":72917,"_21540":121177,"_5":14806,"_28300":72917,"_3066":121178},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3610":72919,"_31119":72917,"_5":31454,"_21540":121180,"_28300":121181,"_3066":121182},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3610":72920,"_31119":72917,"_5":31454,"_21540":121184,"_28300":121185,"_3066":121186},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3610":72921,"_31119":72917,"_5":31454,"_21540":121188,"_28300":121189,"_3066":121190},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3610":72922,"_31119":72917,"_5":31454,"_21540":121192,"_28300":121193,"_3066":121194},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3610":72923,"_31119":72917,"_5":31454,"_21540":121196,"_28300":121197,"_3066":121198},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3610":72924,"_31119":72917,"_5":31454,"_21540":121200,"_28300":121201,"_3066":121202},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3610":72925,"_31119":72917,"_5":31454,"_21540":121204,"_28300":121205,"_3066":121206},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3610":72926,"_31119":72917,"_5":31454,"_21540":121208,"_28300":121209,"_3066":121210},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3610":72927,"_31119":72917,"_5":31454,"_21540":121212,"_28300":121213,"_3066":121214},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3610":72928,"_31119":72917,"_5":31454,"_21540":121216,"_28300":121217,"_3066":121218},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3610":72929,"_31119":72917,"_5":31454,"_21540":121220,"_28300":121221,"_3066":121222},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3610":72930,"_31119":72917,"_5":31454,"_21540":121224,"_28300":121225,"_3066":121226},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3610":72931,"_31119":72917,"_5":31454,"_21540":121228,"_28300":121229,"_3066":121230},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3610":72932,"_31119":72917,"_21540":121232,"_5":14806,"_28300":72917,"_3066":121233},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3610":72933,"_31119":72917,"_21540":121235,"_5":14806,"_28300":121185,"_3066":121236},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3610":72934,"_31119":72917,"_21540":121238,"_5":14806,"_28300":121189,"_3066":121239},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3610":72935,"_31119":72917,"_21540":121241,"_5":14806,"_28300":121193,"_3066":121242},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3610":72936,"_31119":72917,"_21540":121244,"_5":14806,"_28300":121197,"_3066":121245},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3610":72937,"_31119":72917,"_21540":121247,"_5":14806,"_28300":121201,"_3066":121248},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3610":72938,"_31119":72917,"_21540":121250,"_5":14806,"_28300":121205,"_3066":121251},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3610":72939,"_31119":72917,"_21540":121253,"_5":14806,"_28300":121205,"_3066":121254},[],"Ejecuta también la prueba de conectividad del chart:",{"_3610":72940,"_31119":72917,"_21540":121256,"_5":14806,"_28300":121205,"_3066":121257},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3610":72941,"_31119":72917,"_21540":121259,"_5":14806,"_28300":121205,"_3066":121260},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3610":72942,"_31119":72917,"_21540":121262,"_5":14806,"_28300":121209,"_3066":121263},[],"Si recibes un 401:",{"_3610":72943,"_31119":72917,"_21540":121265,"_5":14806,"_28300":121209,"_3066":121266},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3610":72944,"_31119":72917,"_21540":121268,"_5":14806,"_28300":121209,"_3066":121269},[],"verifica emisor, audiencia y expiración del token;",{"_3610":72945,"_31119":72917,"_21540":121271,"_5":14806,"_28300":121209,"_3066":121272},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3610":72946,"_31119":72917,"_21540":121274,"_5":14806,"_28300":121209,"_3066":121275},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3610":72947,"_31119":72917,"_21540":121277,"_5":14806,"_28300":121209,"_3066":121278},[],"Si el login termina pero las APIs devuelven 403:",{"_3610":72948,"_31119":72917,"_21540":121280,"_5":14806,"_28300":121209,"_3066":121281},[],"inspecciona los claims reales del token;",{"_3610":72949,"_31119":72917,"_21540":121283,"_5":14806,"_28300":121209,"_3066":121284},[],"confirma que coinciden con un principal activo;",{"_3610":72950,"_31119":72917,"_21540":121286,"_5":14806,"_28300":121209,"_3066":121287},[],"revisa las políticas concedidas al principal;",{"_3610":72951,"_31119":72917,"_21540":121289,"_5":14806,"_28300":121209,"_3066":121290},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3610":72952,"_31119":72917,"_21540":121292,"_5":14806,"_28300":121209,"_3066":121293},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3610":72953,"_31119":72917,"_21540":121295,"_5":14806,"_28300":121213,"_3066":121296},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3610":72954,"_31119":72917,"_21540":121298,"_5":14806,"_28300":121213,"_3066":121299},[],"Localiza el pod y Service de authz.",{"_3610":72955,"_31119":72917,"_21540":121301,"_5":14806,"_28300":121213,"_3066":121302},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3610":72956,"_31119":72917,"_21540":121304,"_5":14806,"_28300":121213,"_3066":121305},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3610":72957,"_31119":72917,"_21540":121307,"_5":14806,"_28300":121213,"_3066":121308},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3610":72958,"_31119":72917,"_21540":121310,"_5":14806,"_28300":121213,"_3066":121311},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3610":72959,"_31119":72917,"_21540":121313,"_5":14806,"_28300":121217,"_3066":121314},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3610":72960,"_31119":72917,"_21540":121316,"_5":14806,"_28300":121221,"_3066":121317},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3610":72961,"_31119":72917,"_21540":121319,"_5":14806,"_28300":121221,"_3066":121320},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3610":72962,"_31119":72917,"_21540":121322,"_5":14806,"_28300":121221,"_3066":121323},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3610":72963,"_31119":72917,"_21540":121325,"_5":14806,"_28300":121221,"_3066":121326},[],"volumen persistente sin enlazar;",{"_3610":72964,"_31119":72917,"_21540":121328,"_5":14806,"_28300":121221,"_3066":121329},[],"imagen inaccesible o política de pull incorrecta;",{"_3610":72965,"_31119":72917,"_21540":121331,"_5":14806,"_28300":121221,"_3066":121332},[],"configuración inválida del motor criptográfico;",{"_3610":72966,"_31119":72917,"_21540":121334,"_5":14806,"_28300":121221,"_3066":121335},[],"límites de CPU o memoria demasiado bajos;",{"_3610":72967,"_31119":72917,"_21540":121337,"_5":14806,"_28300":121221,"_3066":121338},[],"migración previa incompleta.",{"_3610":72968,"_31119":72917,"_21540":121340,"_5":14806,"_28300":121221,"_3066":121341},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3610":72969,"_31119":72917,"_21540":121343,"_5":14806,"_28300":121221,"_3066":121344},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3610":72970,"_31119":72917,"_21540":121346,"_5":14806,"_28300":121221,"_3066":121347},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3610":72971,"_31119":72917,"_21540":121349,"_5":14806,"_28300":121225,"_3066":121350},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3610":72972,"_31119":72917,"_21540":121352,"_5":14806,"_28300":121225,"_3066":121353},[],"verifica que esté habilitado en el servicio emisor;",{"_3610":72973,"_31119":72917,"_21540":121355,"_5":14806,"_28300":121225,"_3066":121356},[],"comprueba conectividad y credenciales AMQP;",{"_3610":72974,"_31119":72917,"_21540":121358,"_5":14806,"_28300":121225,"_3066":121359},[],"revisa exchange, routing key, colas y consumidores;",{"_3610":72975,"_31119":72917,"_21540":121361,"_5":14806,"_28300":121225,"_3066":121362},[],"inspecciona dead-letter queues;",{"_3610":72976,"_31119":72917,"_21540":121364,"_5":14806,"_28300":121225,"_3066":121365},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3610":72977,"_31119":72917,"_21540":121367,"_5":14806,"_28300":121225,"_3066":121368},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3610":72978,"_31119":72917,"_21540":121370,"_5":14806,"_28300":121225,"_3066":121371},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3610":72979,"_31119":72917,"_21540":121373,"_5":14806,"_28300":121225,"_3066":121374},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3610":72980,"_31119":72917,"_21540":121376,"_5":14806,"_28300":121225,"_3066":121377},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3610":72981,"_31119":72917,"_21540":121379,"_5":14806,"_28300":121225,"_3066":121380},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3610":72982,"_31119":72917,"_21540":121382,"_5":14806,"_28300":121225,"_3066":121383},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3610":72983,"_31119":72917,"_21540":121385,"_5":14806,"_28300":121225,"_3066":121386},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3610":72984,"_31119":72917,"_21540":121388,"_5":14806,"_28300":121229,"_3066":121389},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3610":72985,"_31119":72917,"_21540":121391,"_5":14806,"_28300":121229,"_3066":121392},[],"Antes de cerrar una incidencia, guarda:",{"_3610":72986,"_31119":72917,"_21540":121394,"_5":14806,"_28300":121229,"_3066":121395},[],"causa confirmada;",{"_3610":72987,"_31119":72917,"_21540":121397,"_5":14806,"_28300":121229,"_3066":121398},[],"alcance temporal y recursos afectados;",{"_3610":72988,"_31119":72917,"_21540":121400,"_5":14806,"_28300":121229,"_3066":121401},[],"comandos o consultas utilizados;",{"_3610":72989,"_31119":72917,"_21540":121403,"_5":14806,"_28300":121229,"_3066":121404},[],"cambio aplicado y forma de revertirlo;",{"_3610":72990,"_31119":72917,"_21540":121406,"_5":14806,"_28300":121229,"_3066":121407},[],"validación desde un consumidor;",{"_3610":72991,"_31119":72917,"_21540":121409,"_5":14806,"_28300":121229,"_3066":121410},[],"acción preventiva y propietario.",{"_3610":72992,"_31119":72992,"_5":15171,"_3066":121412,"_31457":121413,"_21540":121417,"_28300":72992},"Modelo de datos",[50802,121414,121415,121416],"Plataforma","Administración","Control de acceso",[],{"_3610":72993,"_31119":72992,"_21540":121419,"_5":14806,"_28300":72992,"_3066":121420},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3610":72994,"_31119":72992,"_5":31454,"_21540":121422,"_28300":121423,"_3066":121424},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3610":72995,"_31119":72992,"_5":31454,"_21540":121426,"_28300":121427,"_3066":121428},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3610":72996,"_31119":72992,"_21540":121430,"_5":14806,"_28300":72992,"_3066":121431},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3610":72997,"_31119":72992,"_21540":121433,"_5":14806,"_28300":121423,"_3066":121434},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3610":72998,"_31119":72992,"_21540":121436,"_5":14806,"_28300":121423,"_3066":121437},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3610":72999,"_31119":72992,"_21540":121439,"_5":14806,"_28300":121423,"_3066":121440},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3610":73000,"_31119":72992,"_21540":121442,"_5":14806,"_28300":121427,"_3066":121443},[],"Entidad (`schema_name.entity_type`)",{"_3610":73001,"_31119":72992,"_21540":121445,"_5":14806,"_28300":121427,"_3066":121446},[],"Tabla (`table_name`)",{"_3610":73002,"_31119":72992,"_21540":121448,"_5":14806,"_28300":121427,"_3066":121449},[],"Clave (`primary_key`)",{"_3610":73003,"_31119":72992,"_21540":121451,"_5":14806,"_28300":121427,"_3066":52352},[],{"_3610":73004,"_31119":72992,"_21540":121453,"_5":14806,"_28300":121427,"_3066":52355},[],{"_3610":73005,"_31119":72992,"_21540":121455,"_5":14806,"_28300":121427,"_3066":52358},[],{"_3610":73006,"_31119":72992,"_21540":121457,"_5":14806,"_28300":121427,"_3066":52361},[],{"_3610":73007,"_31119":72992,"_21540":121459,"_5":14806,"_28300":121427,"_3066":52364},[],{"_3610":73008,"_31119":72992,"_21540":121461,"_5":14806,"_28300":121427,"_3066":52367},[],{"_3610":73009,"_31119":72992,"_21540":121463,"_5":14806,"_28300":121427,"_3066":52370},[],{"_3610":73010,"_31119":72992,"_21540":121465,"_5":14806,"_28300":121427,"_3066":52373},[],{"_3610":73011,"_31119":72992,"_21540":121467,"_5":14806,"_28300":121427,"_3066":52367},[],{"_3610":73012,"_31119":72992,"_21540":121469,"_5":14806,"_28300":121427,"_3066":52378},[],{"_3610":73013,"_31119":72992,"_21540":121471,"_5":14806,"_28300":121427,"_3066":52381},[],{"_3610":73014,"_31119":72992,"_21540":121473,"_5":14806,"_28300":121427,"_3066":52384},[],{"_3610":73015,"_31119":72992,"_21540":121475,"_5":14806,"_28300":121427,"_3066":52387},[],{"_3610":73016,"_31119":72992,"_21540":121477,"_5":14806,"_28300":121427,"_3066":52390},[],{"_3610":73017,"_31119":72992,"_21540":121479,"_5":14806,"_28300":121427,"_3066":52367},[],{"_3610":73018,"_31119":72992,"_21540":121481,"_5":14806,"_28300":121427,"_3066":52395},[],{"_3610":73019,"_31119":72992,"_21540":121483,"_5":14806,"_28300":121427,"_3066":52398},[],{"_3610":73020,"_31119":72992,"_21540":121485,"_5":14806,"_28300":121427,"_3066":52367},[],{"_3610":73021,"_31119":72992,"_21540":121487,"_5":14806,"_28300":121427,"_3066":52403},[],{"_3610":73022,"_31119":72992,"_21540":121489,"_5":14806,"_28300":121427,"_3066":52406},[],{"_3610":73023,"_31119":72992,"_21540":121491,"_5":14806,"_28300":121427,"_3066":52367},[],{"_3610":73024,"_31119":72992,"_21540":121493,"_5":14806,"_28300":121427,"_3066":52411},[],{"_3610":73025,"_31119":72992,"_21540":121495,"_5":14806,"_28300":121427,"_3066":52414},[],{"_3610":73026,"_31119":72992,"_21540":121497,"_5":14806,"_28300":121427,"_3066":52367},[],{"_3610":73027,"_31119":72992,"_21540":121499,"_5":14806,"_28300":121427,"_3066":52419},[],{"_3610":73028,"_31119":72992,"_21540":121501,"_5":14806,"_28300":121427,"_3066":52422},[],{"_3610":73029,"_31119":72992,"_21540":121503,"_5":14806,"_28300":121427,"_3066":52425},[],{"_3610":73030,"_31119":72992,"_21540":121505,"_5":14806,"_28300":121427,"_3066":52428},[],{"_3610":73031,"_31119":72992,"_21540":121507,"_5":14806,"_28300":121427,"_3066":52431},[],{"_3610":73032,"_31119":72992,"_21540":121509,"_5":14806,"_28300":121427,"_3066":52434},[],{"_3610":73033,"_31119":72992,"_21540":121511,"_5":14806,"_28300":121427,"_3066":121512},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3610":73034,"_31119":72992,"_21540":121514,"_5":14806,"_28300":121427,"_3066":121515},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3610":73035,"_31119":72992,"_21540":121517,"_5":14806,"_28300":121427,"_3066":121518},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3610":73036,"_31119":73036,"_5":15171,"_3066":121520,"_31457":121521,"_21540":121522,"_28300":73036},"Visión general del control de acceso",[50802,121414,121415,121416],[],{"_3610":73037,"_31119":73036,"_21540":121524,"_5":14806,"_28300":73036,"_3066":121525},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3610":73038,"_31119":73036,"_5":31454,"_21540":121527,"_28300":121528,"_3066":121529},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3610":73039,"_31119":73036,"_5":31454,"_21540":121531,"_28300":121532,"_3066":121533},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3610":73040,"_31119":73036,"_5":31454,"_21540":121535,"_28300":121536,"_3066":121537},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3610":73041,"_31119":73036,"_5":31454,"_21540":121539,"_28300":121540,"_3066":121541},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3610":73042,"_31119":73036,"_5":31454,"_21540":121543,"_28300":121544,"_3066":121545},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3610":73043,"_31119":73036,"_5":31454,"_21540":121547,"_28300":121548,"_3066":121549},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3610":73044,"_31119":73036,"_5":31454,"_21540":121551,"_28300":121552,"_3066":121553},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3610":73045,"_31119":73036,"_5":31454,"_21540":121555,"_28300":121556,"_3066":121557},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3610":73046,"_31119":73036,"_5":31454,"_21540":121559,"_28300":121560,"_3066":121561},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3610":73047,"_31119":73036,"_5":31454,"_21540":121563,"_28300":121564,"_3066":121565},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3610":73048,"_31119":73036,"_5":31454,"_21540":121567,"_28300":121568,"_3066":121569},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3610":73049,"_31119":73036,"_5":31454,"_21540":121571,"_28300":121572,"_3066":121573},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3610":73050,"_31119":73036,"_5":31454,"_21540":121575,"_28300":121576,"_3066":121577},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3610":73051,"_31119":73036,"_5":31454,"_21540":121579,"_28300":121580,"_3066":121581},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3610":73052,"_31119":73036,"_5":31454,"_21540":121583,"_28300":121584,"_3066":121585},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3610":73053,"_31119":73036,"_5":31454,"_21540":121587,"_28300":121588,"_3066":120555},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3610":73054,"_31119":73036,"_5":31454,"_21540":121590,"_28300":121591,"_3066":121592},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3610":73055,"_31119":73036,"_5":31454,"_21540":121594,"_28300":121595,"_3066":121596},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3610":73056,"_31119":73036,"_5":31454,"_21540":121598,"_28300":121599,"_3066":121600},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3610":73057,"_31119":73036,"_5":31454,"_21540":121602,"_28300":121603,"_3066":121604},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3610":73058,"_31119":73036,"_5":31454,"_21540":121606,"_28300":121607,"_3066":121608},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3610":73059,"_31119":73036,"_5":31454,"_21540":121610,"_28300":121611,"_3066":121612},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3610":73060,"_31119":73036,"_5":31454,"_21540":121614,"_28300":121615,"_3066":121616},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3610":73061,"_31119":73036,"_5":31454,"_21540":121618,"_28300":121619,"_3066":121620},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3610":73062,"_31119":73036,"_5":31454,"_21540":121622,"_28300":121623,"_3066":121624},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3610":73063,"_31119":73036,"_5":31454,"_21540":121626,"_28300":121627,"_3066":121628},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3610":73064,"_31119":73036,"_5":31454,"_21540":121630,"_28300":121631,"_3066":121632},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3610":73065,"_31119":73036,"_5":31454,"_21540":121634,"_28300":121635,"_3066":121636},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3610":73066,"_31119":73036,"_5":31454,"_21540":121638,"_28300":121639,"_3066":121640},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3610":73067,"_31119":73036,"_5":31454,"_21540":121642,"_28300":121643,"_3066":121644},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3610":73068,"_31119":73036,"_5":31454,"_21540":121646,"_28300":121647,"_3066":121648},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3610":73069,"_31119":73036,"_21540":121650,"_5":14806,"_28300":73036,"_3066":121651},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3610":73070,"_31119":73036,"_21540":121653,"_5":14806,"_28300":73036,"_3066":121654},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3610":73071,"_31119":73036,"_21540":121656,"_5":14806,"_28300":73036,"_3066":121657},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3610":73072,"_31119":73036,"_21540":121659,"_5":14806,"_28300":121528,"_3066":121660},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3610":73073,"_31119":73036,"_21540":121662,"_5":14806,"_28300":121528,"_3066":121663},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3610":73074,"_31119":73036,"_21540":121665,"_5":14806,"_28300":121528,"_3066":121666},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3610":73075,"_31119":73036,"_21540":121668,"_5":14806,"_28300":121528,"_3066":121669},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3610":73076,"_31119":73036,"_21540":121671,"_5":14806,"_28300":121528,"_3066":121672},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3610":73077,"_31119":73036,"_21540":121674,"_5":14806,"_28300":121528,"_3066":121675},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3610":73078,"_31119":73036,"_21540":121677,"_5":14806,"_28300":121532,"_3066":121678},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3610":73079,"_31119":73036,"_21540":121680,"_5":14806,"_28300":121532,"_3066":121681},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3610":73080,"_31119":73036,"_21540":121683,"_5":14806,"_28300":121536,"_3066":121684},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3610":73081,"_31119":73036,"_21540":121686,"_5":14806,"_28300":121536,"_3066":121687},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3610":73082,"_31119":73036,"_21540":121689,"_5":14806,"_28300":121536,"_3066":121690},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3610":73083,"_31119":73036,"_21540":121692,"_5":14806,"_28300":121536,"_3066":121693},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3610":73084,"_31119":73036,"_21540":121695,"_5":14806,"_28300":121536,"_3066":121696},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3610":73085,"_31119":73036,"_21540":121698,"_5":14806,"_28300":121536,"_3066":121699},[],"Carga por separado las políticas concedidas a cada principal.",{"_3610":73086,"_31119":73036,"_21540":121701,"_5":14806,"_28300":121536,"_3066":121702},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3610":73087,"_31119":73036,"_21540":121704,"_5":14806,"_28300":121536,"_3066":121705},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3610":73088,"_31119":73036,"_21540":121707,"_5":14806,"_28300":121536,"_3066":121708},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3610":73089,"_31119":73036,"_21540":121710,"_5":14806,"_28300":121536,"_3066":121711},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3610":73090,"_31119":73036,"_21540":121713,"_5":14806,"_28300":121536,"_3066":121714},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3610":73091,"_31119":73036,"_21540":121716,"_5":14806,"_28300":121536,"_3066":121717},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3610":73092,"_31119":73036,"_21540":121719,"_5":14806,"_28300":121540,"_3066":121720},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3610":73093,"_31119":73036,"_21540":121722,"_5":14806,"_28300":121540,"_3066":121723},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3610":73094,"_31119":73036,"_21540":121725,"_5":14806,"_28300":121540,"_3066":121726},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3610":73095,"_31119":73036,"_21540":121728,"_5":14806,"_28300":121540,"_3066":121729},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3610":73096,"_31119":73036,"_21540":121731,"_5":14806,"_28300":121540,"_3066":121732},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3610":73097,"_31119":73036,"_21540":121734,"_5":14806,"_28300":121540,"_3066":121735},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3610":73098,"_31119":73036,"_21540":121737,"_5":14806,"_28300":121540,"_3066":121738},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3610":73099,"_31119":73036,"_21540":121740,"_5":14806,"_28300":121540,"_3066":121741},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3610":73100,"_31119":73036,"_21540":121743,"_5":14806,"_28300":121540,"_3066":121744},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3610":73101,"_31119":73036,"_21540":121746,"_5":14806,"_28300":121540,"_3066":121747},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3610":73102,"_31119":73036,"_21540":121749,"_5":14806,"_28300":121544,"_3066":121750},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3610":73103,"_31119":73036,"_21540":121752,"_5":14806,"_28300":121544,"_3066":121753},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3610":73104,"_31119":73036,"_21540":121755,"_5":14806,"_28300":121544,"_3066":121756},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3610":73105,"_31119":73036,"_21540":121758,"_5":14806,"_28300":121544,"_3066":121759},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3610":73106,"_31119":73036,"_21540":121761,"_5":14806,"_28300":121544,"_3066":121762},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3610":73107,"_31119":73036,"_21540":121764,"_5":14806,"_28300":121544,"_3066":121765},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3610":73108,"_31119":73036,"_21540":121767,"_5":14806,"_28300":121544,"_3066":121768},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3610":73109,"_31119":73036,"_21540":121770,"_5":14806,"_28300":121544,"_3066":121771},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3610":73110,"_31119":73036,"_21540":121773,"_5":14806,"_28300":121544,"_3066":121774},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3610":73111,"_31119":73036,"_21540":121776,"_5":14806,"_28300":121544,"_3066":121777},[],"Las acciones se dividen en dos grupos:",{"_3610":73112,"_31119":73036,"_21540":121779,"_5":14806,"_28300":121544,"_3066":121780},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3610":73113,"_31119":73036,"_21540":121782,"_5":14806,"_28300":121544,"_3066":121783},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3610":73114,"_31119":73036,"_21540":121785,"_5":14806,"_28300":121544,"_3066":121786},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3610":73115,"_31119":73036,"_21540":121788,"_5":14806,"_28300":121548,"_3066":121789},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3610":73116,"_31119":73036,"_21540":121791,"_5":14806,"_28300":121548,"_3066":121792},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3610":73117,"_31119":73036,"_21540":121794,"_5":14806,"_28300":121548,"_3066":121795},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3610":73118,"_31119":73036,"_21540":121797,"_5":14806,"_28300":121552,"_3066":121798},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3610":73119,"_31119":73036,"_21540":121800,"_5":14806,"_28300":121552,"_3066":121801},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3610":73120,"_31119":73036,"_21540":121803,"_5":14806,"_28300":121552,"_3066":121804},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3610":73121,"_31119":73036,"_21540":121806,"_5":14806,"_28300":121552,"_3066":121807},[],"Los operadores implementados son:",{"_3610":73122,"_31119":73036,"_21540":121809,"_5":14806,"_28300":121552,"_3066":121810},[],"`equals`, para igualdad exacta;",{"_3610":73123,"_31119":73036,"_21540":121812,"_5":14806,"_28300":121552,"_3066":121813},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3610":73124,"_31119":73036,"_21540":121815,"_5":14806,"_28300":121552,"_3066":121816},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3610":73125,"_31119":73036,"_21540":121818,"_5":14806,"_28300":121552,"_3066":121819},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3610":73126,"_31119":73036,"_21540":121821,"_5":14806,"_28300":121556,"_3066":121822},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3610":73127,"_31119":73036,"_21540":121824,"_5":14806,"_28300":121556,"_3066":121825},[],"Los modos disponibles son:",{"_3610":73128,"_31119":73036,"_21540":121827,"_5":14806,"_28300":121556,"_3066":121828},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3610":73129,"_31119":73036,"_21540":121830,"_5":14806,"_28300":121556,"_3066":121831},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3610":73130,"_31119":73036,"_21540":121833,"_5":14806,"_28300":121556,"_3066":121834},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3610":73131,"_31119":73036,"_21540":121836,"_5":14806,"_28300":121556,"_3066":121837},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3610":73132,"_31119":73036,"_21540":121839,"_5":14806,"_28300":121556,"_3066":121840},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3610":73133,"_31119":73036,"_21540":121842,"_5":14806,"_28300":121556,"_3066":121843},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3610":73134,"_31119":73036,"_21540":121845,"_5":14806,"_28300":121560,"_3066":121846},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3610":73135,"_31119":73036,"_21540":121848,"_5":14806,"_28300":121560,"_3066":121849},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3610":73136,"_31119":73036,"_21540":121851,"_5":14806,"_28300":121560,"_3066":121852},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3610":73137,"_31119":73036,"_21540":121854,"_5":14806,"_28300":121560,"_3066":121855},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3610":73138,"_31119":73036,"_21540":121857,"_5":14806,"_28300":121568,"_3066":121858},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3610":73139,"_31119":73036,"_21540":121860,"_5":14806,"_28300":121568,"_3066":121861},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3610":73140,"_31119":73036,"_21540":121863,"_5":14806,"_28300":121572,"_3066":121864},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3610":73141,"_31119":73036,"_21540":121866,"_5":14806,"_28300":121572,"_3066":121867},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3610":73142,"_31119":73036,"_21540":121869,"_5":14806,"_28300":121572,"_3066":121870},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3610":73143,"_31119":73036,"_21540":121872,"_5":14806,"_28300":121572,"_3066":121873},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3610":73144,"_31119":73036,"_21540":121875,"_5":14806,"_28300":121572,"_3066":121876},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3610":73145,"_31119":73036,"_21540":121878,"_5":14806,"_28300":121576,"_3066":121879},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3610":73146,"_31119":73036,"_21540":121881,"_5":14806,"_28300":121576,"_3066":121882},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3610":73147,"_31119":73036,"_21540":121884,"_5":14806,"_28300":121576,"_3066":121885},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3610":73148,"_31119":73036,"_21540":121887,"_5":14806,"_28300":121580,"_3066":121888},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3610":73149,"_31119":73036,"_21540":121890,"_5":14806,"_28300":121580,"_3066":121891},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3610":73150,"_31119":73036,"_21540":121893,"_5":14806,"_28300":121580,"_3066":121894},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3610":73151,"_31119":73036,"_21540":121896,"_5":14806,"_28300":121580,"_3066":121897},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3610":73152,"_31119":73036,"_21540":121899,"_5":14806,"_28300":121580,"_3066":121900},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3610":73153,"_31119":73036,"_21540":121902,"_5":14806,"_28300":121580,"_3066":121903},[],"Ten en cuenta que:",{"_3610":73154,"_31119":73036,"_21540":121905,"_5":14806,"_28300":121580,"_3066":121906},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3610":73155,"_31119":73036,"_21540":121908,"_5":14806,"_28300":121580,"_3066":121909},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3610":73156,"_31119":73036,"_21540":121911,"_5":14806,"_28300":121580,"_3066":121912},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3610":73157,"_31119":73036,"_21540":121914,"_5":14806,"_28300":121584,"_3066":121915},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3610":73158,"_31119":73036,"_21540":121917,"_5":14806,"_28300":121584,"_3066":121918},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3610":73159,"_31119":73036,"_21540":121920,"_5":14806,"_28300":121584,"_3066":121921},[],"acceso completo y de solo lectura a KMS;",{"_3610":73160,"_31119":73036,"_21540":121923,"_5":14806,"_28300":121584,"_3066":121924},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3610":73161,"_31119":73036,"_21540":121926,"_5":14806,"_28300":121584,"_3066":121927},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3610":73162,"_31119":73036,"_21540":121929,"_5":14806,"_28300":121584,"_3066":121930},[],"acceso a la interfaz;",{"_3610":73163,"_31119":73036,"_21540":121932,"_5":14806,"_28300":121584,"_3066":121933},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3610":73164,"_31119":73036,"_21540":121935,"_5":14806,"_28300":121584,"_3066":121936},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3610":73165,"_31119":73036,"_21540":121938,"_5":14806,"_28300":121584,"_3066":121939},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3610":73166,"_31119":73036,"_21540":121941,"_5":14806,"_28300":121584,"_3066":121942},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3610":73167,"_31119":73036,"_21540":121944,"_5":14806,"_28300":121584,"_3066":121945},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3610":73168,"_31119":73036,"_21540":121947,"_5":14806,"_28300":121588,"_3066":121948},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3610":73169,"_31119":73036,"_21540":121950,"_5":14806,"_28300":121588,"_3066":121951},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3610":73170,"_31119":73036,"_21540":121953,"_5":14806,"_28300":121588,"_3066":121954},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3610":73171,"_31119":73036,"_21540":121956,"_5":14806,"_28300":121591,"_3066":121957},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3610":73172,"_31119":73036,"_21540":121959,"_5":14806,"_28300":121595,"_3066":121960},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3610":73173,"_31119":73036,"_21540":121962,"_5":14806,"_28300":121595,"_3066":121963},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3610":73174,"_31119":73036,"_21540":121965,"_5":14806,"_28300":121599,"_3066":121966},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3610":73175,"_31119":73036,"_21540":121968,"_5":14806,"_28300":121603,"_3066":121969},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3610":73176,"_31119":73036,"_21540":121971,"_5":14806,"_28300":121607,"_3066":121972},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3610":73177,"_31119":73036,"_21540":121974,"_5":14806,"_28300":121611,"_3066":121975},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3610":73178,"_31119":73036,"_21540":121977,"_5":14806,"_28300":121611,"_3066":121978},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3610":73179,"_31119":73036,"_21540":121980,"_5":14806,"_28300":121615,"_3066":121981},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3610":73180,"_31119":73036,"_21540":121983,"_5":14806,"_28300":121615,"_3066":121984},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3610":73181,"_31119":73036,"_21540":121986,"_5":14806,"_28300":121615,"_3066":121987},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3610":73182,"_31119":73036,"_21540":121989,"_5":14806,"_28300":121615,"_3066":121990},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3610":73183,"_31119":73036,"_21540":121992,"_5":14806,"_28300":121615,"_3066":121993},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3610":73184,"_31119":73036,"_21540":121995,"_5":14806,"_28300":121615,"_3066":121996},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3610":73185,"_31119":73036,"_21540":121998,"_5":14806,"_28300":121615,"_3066":121999},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3610":73186,"_31119":73036,"_21540":122001,"_5":14806,"_28300":121615,"_3066":122002},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3610":73187,"_31119":73036,"_21540":122004,"_5":14806,"_28300":121619,"_3066":122005},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3610":73188,"_31119":73036,"_21540":122007,"_5":14806,"_28300":121619,"_3066":122008},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3610":73189,"_31119":73036,"_21540":122010,"_5":14806,"_28300":121619,"_3066":122011},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3610":73190,"_31119":73036,"_21540":122013,"_5":14806,"_28300":121623,"_3066":122014},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3610":73191,"_31119":73036,"_21540":122016,"_5":14806,"_28300":121623,"_3066":122017},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3610":73192,"_31119":73036,"_21540":122019,"_5":14806,"_28300":121623,"_3066":122020},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3610":73193,"_31119":73036,"_21540":122022,"_5":14806,"_28300":121623,"_3066":122023},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3610":73194,"_31119":73036,"_21540":122025,"_5":14806,"_28300":121623,"_3066":122026},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3610":73195,"_31119":73036,"_21540":122028,"_5":14806,"_28300":121623,"_3066":122029},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3610":73196,"_31119":73036,"_21540":122031,"_5":14806,"_28300":121623,"_3066":122032},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3610":73197,"_31119":73036,"_21540":122034,"_5":14806,"_28300":121623,"_3066":122035},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3610":73198,"_31119":73036,"_21540":122037,"_5":14806,"_28300":121631,"_3066":122038},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3610":73199,"_31119":73036,"_21540":122040,"_5":14806,"_28300":121635,"_3066":122041},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3610":73200,"_31119":73036,"_21540":122043,"_5":14806,"_28300":121635,"_3066":122044},[],"que exista un principal activo del tipo correcto;",{"_3610":73201,"_31119":73036,"_21540":122046,"_5":14806,"_28300":121635,"_3066":122047},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3610":73202,"_31119":73036,"_21540":122049,"_5":14806,"_28300":121635,"_3066":122050},[],"que todas las condiciones del principal se cumplan;",{"_3610":73203,"_31119":73036,"_21540":122052,"_5":14806,"_28300":121635,"_3066":122053},[],"que el principal tenga concedida la política esperada;",{"_3610":73204,"_31119":73036,"_21540":122055,"_5":14806,"_28300":121635,"_3066":122056},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3610":73205,"_31119":73036,"_21540":122058,"_5":14806,"_28300":121635,"_3066":122059},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3610":73206,"_31119":73036,"_21540":122061,"_5":14806,"_28300":121635,"_3066":122062},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3610":73207,"_31119":73036,"_21540":122064,"_5":14806,"_28300":121635,"_3066":122065},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3610":73208,"_31119":73036,"_21540":122067,"_5":14806,"_28300":121639,"_3066":122068},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3610":73209,"_31119":73036,"_21540":122070,"_5":14806,"_28300":121643,"_3066":122071},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3610":73210,"_31119":73036,"_21540":122073,"_5":14806,"_28300":121647,"_3066":122074},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3610":73211,"_31119":73036,"_21540":122076,"_5":14806,"_28300":121647,"_3066":122077},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3610":73212,"_31119":73212,"_5":15171,"_3066":122079,"_31457":122080,"_21540":122081,"_28300":73212},"Alertas y suscripciones",[50802,121414,121415],[],{"_3610":73213,"_31119":73212,"_21540":122083,"_5":14806,"_28300":73212,"_3066":122084},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3610":73214,"_31119":73212,"_5":31454,"_21540":122086,"_28300":122087,"_3066":122088},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3610":73215,"_31119":73212,"_5":31454,"_21540":122090,"_28300":122091,"_3066":122092},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3610":73216,"_31119":73212,"_5":31454,"_21540":122094,"_28300":122095,"_3066":122096},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3610":73217,"_31119":73212,"_5":31454,"_21540":122098,"_28300":122099,"_3066":122100},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3610":73218,"_31119":73212,"_5":31454,"_21540":122102,"_28300":122103,"_3066":122104},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3610":73219,"_31119":73212,"_5":31454,"_21540":122106,"_28300":122107,"_3066":122108},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3610":73220,"_31119":73212,"_5":31454,"_21540":122110,"_28300":122111,"_3066":122112},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3610":73221,"_31119":73212,"_5":31454,"_21540":122114,"_28300":122115,"_3066":122116},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3610":73222,"_31119":73212,"_5":31454,"_21540":122118,"_28300":122119,"_3066":122120},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3610":73223,"_31119":73212,"_5":31454,"_21540":122122,"_28300":122123,"_3066":122124},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3610":73224,"_31119":73212,"_5":31454,"_21540":122126,"_28300":122127,"_3066":122128},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3610":73225,"_31119":73212,"_21540":122130,"_5":14806,"_28300":73212,"_3066":122131},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3610":73226,"_31119":73212,"_21540":122133,"_5":14806,"_28300":122087,"_3066":122134},[],"Un servicio publica un evento de dominio.",{"_3610":73227,"_31119":73212,"_21540":122136,"_5":14806,"_28300":122087,"_3066":122137},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3610":73228,"_31119":73212,"_21540":122139,"_5":14806,"_28300":122087,"_3066":122140},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3610":73229,"_31119":73212,"_21540":122142,"_5":14806,"_28300":122087,"_3066":122143},[],"Lamassu entrega el evento al canal configurado.",{"_3610":73230,"_31119":73212,"_21540":122145,"_5":14806,"_28300":122087,"_3066":122146},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3610":73231,"_31119":73212,"_21540":122148,"_5":14806,"_28300":122091,"_3066":122149},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3610":73232,"_31119":73212,"_21540":122151,"_5":14806,"_28300":122091,"_3066":122152},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3610":73233,"_31119":73212,"_21540":122154,"_5":14806,"_28300":122091,"_3066":122155},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3610":73234,"_31119":73212,"_21540":122157,"_5":14806,"_28300":122091,"_3066":122158},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3610":73235,"_31119":73212,"_21540":122160,"_5":14806,"_28300":122091,"_3066":122161},[],"`apikey_options` necesita `header` y `key`.",{"_3610":73236,"_31119":73212,"_21540":122163,"_5":14806,"_28300":122091,"_3066":122164},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3610":73237,"_31119":73212,"_21540":122166,"_5":14806,"_28300":122091,"_3066":122167},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3610":73238,"_31119":73212,"_21540":122169,"_5":14806,"_28300":122091,"_3066":122170},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3610":73239,"_31119":73212,"_21540":122172,"_5":14806,"_28300":122099,"_3066":122173},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3610":73240,"_31119":73212,"_21540":122175,"_5":14806,"_28300":122103,"_3066":122176},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3610":73241,"_31119":73212,"_21540":122178,"_5":14806,"_28300":122107,"_3066":122179},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3610":73242,"_31119":73212,"_21540":122181,"_5":14806,"_28300":122107,"_3066":122182},[],"**None** notifica todas las instancias del evento.",{"_3610":73243,"_31119":73212,"_21540":122184,"_5":14806,"_28300":122107,"_3066":122185},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3610":73244,"_31119":73212,"_21540":122187,"_5":14806,"_28300":122107,"_3066":122188},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3610":73245,"_31119":73212,"_21540":122190,"_5":14806,"_28300":122107,"_3066":122191},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3610":73246,"_31119":73212,"_21540":122193,"_5":14806,"_28300":122107,"_3066":122194},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3610":73247,"_31119":73212,"_21540":122196,"_5":14806,"_28300":122107,"_3066":122197},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3610":73248,"_31119":73212,"_21540":122199,"_5":14806,"_28300":122111,"_3066":122200},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3610":73249,"_31119":73212,"_21540":122202,"_5":14806,"_28300":122115,"_3066":122203},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3610":73250,"_31119":73212,"_21540":122205,"_5":14806,"_28300":122115,"_3066":122206},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3610":73251,"_31119":73212,"_21540":122208,"_5":14806,"_28300":122115,"_3066":122209},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3610":73252,"_31119":73212,"_21540":122211,"_5":14806,"_28300":122115,"_3066":122212},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3610":73253,"_31119":73212,"_21540":122214,"_5":14806,"_28300":122115,"_3066":122215},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3610":73254,"_31119":73212,"_21540":122217,"_5":14806,"_28300":122115,"_3066":122218},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3610":73255,"_31119":73212,"_21540":122220,"_5":14806,"_28300":122115,"_3066":122221},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3610":73256,"_31119":73212,"_21540":122223,"_5":14806,"_28300":122115,"_3066":122224},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3610":73257,"_31119":73212,"_21540":122226,"_5":14806,"_28300":122119,"_3066":122227},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3610":73258,"_31119":73212,"_21540":122229,"_5":14806,"_28300":122119,"_3066":122230},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3610":73259,"_31119":73212,"_21540":122232,"_5":14806,"_28300":122119,"_3066":122233},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3610":73260,"_31119":73212,"_21540":122235,"_5":14806,"_28300":122119,"_3066":122236},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3610":73261,"_31119":73212,"_21540":122238,"_5":14806,"_28300":122119,"_3066":122239},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3610":73262,"_31119":73212,"_21540":122241,"_5":14806,"_28300":122119,"_3066":122242},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3610":73263,"_31119":73212,"_21540":122244,"_5":14806,"_28300":122119,"_3066":122245},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3610":73264,"_31119":73212,"_21540":122247,"_5":14806,"_28300":122119,"_3066":122248},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3610":73265,"_31119":73212,"_21540":122250,"_5":14806,"_28300":122123,"_3066":122251},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3610":73266,"_31119":73212,"_21540":122253,"_5":14806,"_28300":122123,"_3066":122254},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3610":73267,"_31119":73212,"_21540":122256,"_5":14806,"_28300":122127,"_3066":122257},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3610":73268,"_31119":73212,"_21540":122259,"_5":14806,"_28300":122127,"_3066":122260},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3610":73269,"_31119":73212,"_21540":122262,"_5":14806,"_28300":122127,"_3066":122263},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3610":73270,"_31119":73212,"_21540":122265,"_5":14806,"_28300":122127,"_3066":122266},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3610":73271,"_31119":73212,"_21540":122268,"_5":14806,"_28300":122127,"_3066":122269},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3610":73272,"_31119":73212,"_21540":122271,"_5":14806,"_28300":122127,"_3066":122272},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3610":73273,"_31119":73212,"_21540":122274,"_5":14806,"_28300":122127,"_3066":122275},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3610":73274,"_31119":73212,"_21540":122277,"_5":14806,"_28300":122127,"_3066":122278},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3610":73275,"_31119":73212,"_21540":122280,"_5":14806,"_28300":122127,"_3066":122281},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3610":73276,"_31119":73212,"_21540":122283,"_5":14806,"_28300":122127,"_3066":122284},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3610":73277,"_31119":73277,"_5":15171,"_3066":122286,"_31457":122287,"_21540":122288,"_28300":73277},"Registros de auditoría",[50802,121414,121415],[],{"_3610":73278,"_31119":73277,"_21540":122290,"_5":14806,"_28300":73277,"_3066":122291},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3610":73279,"_31119":73277,"_5":31454,"_21540":122293,"_28300":122294,"_3066":122295},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3610":73280,"_31119":73277,"_5":31454,"_21540":122297,"_28300":122298,"_3066":122299},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3610":73281,"_31119":73277,"_5":31454,"_21540":122301,"_28300":122302,"_3066":122303},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3610":73282,"_31119":73277,"_5":31454,"_21540":122305,"_28300":122306,"_3066":122307},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3610":73283,"_31119":73277,"_5":31454,"_21540":122309,"_28300":122310,"_3066":122311},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3610":73284,"_31119":73277,"_5":31454,"_21540":122313,"_28300":122314,"_3066":122315},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3610":73285,"_31119":73277,"_5":31454,"_21540":122317,"_28300":122318,"_3066":122319},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3610":73286,"_31119":73277,"_5":31454,"_21540":122321,"_28300":122322,"_3066":122323},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3610":73287,"_31119":73277,"_5":31454,"_21540":122325,"_28300":122326,"_3066":122327},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3610":73288,"_31119":73277,"_5":31454,"_21540":122329,"_28300":122330,"_3066":122331},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3610":73289,"_31119":73277,"_5":31454,"_21540":122333,"_28300":122334,"_3066":122335},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3610":73290,"_31119":73277,"_21540":122337,"_5":14806,"_28300":73277,"_3066":122338},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3610":73291,"_31119":73277,"_21540":122340,"_5":14806,"_28300":122294,"_3066":122341},[],"El cuerpo de auditoría incluye:",{"_3610":73292,"_31119":73277,"_21540":122343,"_5":14806,"_28300":122294,"_3066":122344},[],"input: datos recibidos por la operación;",{"_3610":73293,"_31119":73277,"_21540":122346,"_5":14806,"_28300":122294,"_3066":122347},[],"has\\_error: indica si el servicio devolvió un error;",{"_3610":73294,"_31119":73277,"_21540":122349,"_5":14806,"_28300":122294,"_3066":122350},[],"output: resultado producido o mensaje de error;",{"_3610":73295,"_31119":73277,"_21540":122352,"_5":14806,"_28300":122294,"_3066":122353},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3610":73296,"_31119":73277,"_21540":122355,"_5":14806,"_28300":122294,"_3066":122356},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3610":73297,"_31119":73277,"_21540":122358,"_5":14806,"_28300":122294,"_3066":122359},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3610":73298,"_31119":73277,"_21540":122361,"_5":14806,"_28300":122298,"_3066":122362},[],"El backend aplica auditoría a mutaciones de:",{"_3610":73299,"_31119":73277,"_21540":122364,"_5":14806,"_28300":122298,"_3066":122365},[],"autoridades, certificados y perfiles de emisión;",{"_3610":73300,"_31119":73277,"_21540":122367,"_5":14806,"_28300":122298,"_3066":122368},[],"claves y motores KMS;",{"_3610":73301,"_31119":73277,"_21540":122370,"_5":14806,"_28300":122298,"_3066":122371},[],"dispositivos e identidades;",{"_3610":73302,"_31119":73277,"_21540":122373,"_5":14806,"_28300":122298,"_3066":122374},[],"DMS y operaciones de enrolamiento;",{"_3610":73303,"_31119":73277,"_21540":122376,"_5":14806,"_28300":122298,"_3066":122377},[],"funciones de validación y CRL;",{"_3610":73304,"_31119":73277,"_21540":122379,"_5":14806,"_28300":122298,"_3066":122380},[],"principales, políticas y concesiones de autorización.",{"_3610":73305,"_31119":73277,"_21540":122382,"_5":14806,"_28300":122298,"_3066":122383},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3610":73306,"_31119":73277,"_21540":122385,"_5":14806,"_28300":122302,"_3066":122386},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3610":73307,"_31119":73277,"_21540":122388,"_5":14806,"_28300":122302,"_3066":122389},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3610":73308,"_31119":73277,"_21540":122391,"_5":14806,"_28300":122302,"_3066":122392},[],"Diseña el consumidor para:",{"_3610":73309,"_31119":73277,"_21540":122394,"_5":14806,"_28300":122302,"_3066":122395},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3610":73310,"_31119":73277,"_21540":122397,"_5":14806,"_28300":122302,"_3066":122398},[],"conservar el CloudEvent completo sin modificar;",{"_3610":73311,"_31119":73277,"_21540":122400,"_5":14806,"_28300":122302,"_3066":122401},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3610":73312,"_31119":73277,"_21540":122403,"_5":14806,"_28300":122302,"_3066":122404},[],"cifrar en tránsito y en reposo;",{"_3610":73313,"_31119":73277,"_21540":122406,"_5":14806,"_28300":122302,"_3066":122407},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3610":73314,"_31119":73277,"_21540":122409,"_5":14806,"_28300":122302,"_3066":122410},[],"aplicar una política explícita de retención y legal hold;",{"_3610":73315,"_31119":73277,"_21540":122412,"_5":14806,"_28300":122302,"_3066":122413},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3610":73316,"_31119":73277,"_21540":122415,"_5":14806,"_28300":122306,"_3066":122416},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3610":73317,"_31119":73277,"_21540":122418,"_5":14806,"_28300":122306,"_3066":122419},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3610":73318,"_31119":73277,"_21540":122421,"_5":14806,"_28300":122314,"_3066":122422},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3610":73319,"_31119":73277,"_21540":122424,"_5":14806,"_28300":122318,"_3066":122425},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3610":73320,"_31119":73277,"_21540":122427,"_5":14806,"_28300":122322,"_3066":122428},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3610":73321,"_31119":73277,"_21540":122430,"_5":14806,"_28300":122326,"_3066":122431},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3610":73322,"_31119":73277,"_21540":122433,"_5":14806,"_28300":122330,"_3066":122434},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3610":73323,"_31119":73277,"_21540":122436,"_5":14806,"_28300":122334,"_3066":122437},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3610":73324,"_31119":73277,"_21540":122439,"_5":14806,"_28300":122334,"_3066":122440},[],"aparece un evento de auditoría correcto;",{"_3610":73325,"_31119":73277,"_21540":122442,"_5":14806,"_28300":122334,"_3066":122443},[],"el principal coincide con la identidad utilizada;",{"_3610":73326,"_31119":73277,"_21540":122445,"_5":14806,"_28300":122334,"_3066":122446},[],"el consumidor lo persiste una sola vez;",{"_3610":73327,"_31119":73277,"_21540":122448,"_5":14806,"_28300":122334,"_3066":122449},[],"puede recuperarse por recurso, actor y periodo;",{"_3610":73328,"_31119":73277,"_21540":122451,"_5":14806,"_28300":122334,"_3066":122452},[],"una interrupción del consumidor produce una alerta.",{"_3610":73329,"_31119":73277,"_21540":122454,"_5":14806,"_28300":122334,"_3066":122455},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3610":73330,"_31119":73330,"_5":15171,"_3066":122457,"_31457":122458,"_21540":122459,"_28300":73330},"Arquitectura de la plataforma",[50802,121414],[],{"_3610":73331,"_31119":73330,"_21540":122461,"_5":14806,"_28300":73330,"_3066":122462},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3610":73332,"_31119":73330,"_5":31454,"_21540":122464,"_28300":122465,"_3066":122466},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3610":73333,"_31119":73330,"_5":31454,"_21540":122468,"_28300":122469,"_3066":122470},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3610":73334,"_31119":73330,"_5":31454,"_21540":122472,"_28300":122473,"_3066":122474},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3610":73335,"_31119":73330,"_5":31454,"_21540":122476,"_28300":122477,"_3066":122478},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3610":73336,"_31119":73330,"_5":31454,"_21540":122480,"_28300":122481,"_3066":122482},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3610":73337,"_31119":73330,"_21540":122484,"_5":14806,"_28300":73330,"_3066":122485},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3610":73338,"_31119":73330,"_21540":122487,"_5":14806,"_28300":73330,"_3066":122488},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3610":73339,"_31119":73330,"_21540":122490,"_5":14806,"_28300":122465,"_3066":122491},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3610":73340,"_31119":73330,"_21540":122493,"_5":14806,"_28300":122469,"_3066":122494},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3610":73341,"_31119":73330,"_21540":122496,"_5":14806,"_28300":122473,"_3066":122497},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3610":73342,"_31119":73330,"_21540":122499,"_5":14806,"_28300":122477,"_3066":122500},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3610":73343,"_31119":73330,"_21540":122502,"_5":14806,"_28300":122481,"_3066":122503},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3610":73344,"_31119":73344,"_5":15171,"_3066":122505,"_31457":122506,"_21540":122507,"_28300":73344},"Cómo funciona Lamassu",[50802,121414],[],{"_3610":73345,"_31119":73344,"_21540":122509,"_5":14806,"_28300":73344,"_3066":122510},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3610":73346,"_31119":73344,"_5":31454,"_21540":122512,"_28300":122513,"_3066":122514},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3610":73347,"_31119":73344,"_5":31454,"_21540":122516,"_28300":122517,"_3066":122518},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3610":73348,"_31119":73344,"_21540":122520,"_5":14806,"_28300":73344,"_3066":122521},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3610":73349,"_31119":73344,"_21540":122523,"_5":14806,"_28300":122513,"_3066":122524},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3610":73350,"_31119":73344,"_21540":122526,"_5":14806,"_28300":122513,"_3066":122527},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3610":73351,"_31119":73344,"_21540":122529,"_5":14806,"_28300":122513,"_3066":122530},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3610":73352,"_31119":73344,"_21540":122532,"_5":14806,"_28300":122513,"_3066":122533},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3610":73353,"_31119":73344,"_21540":122535,"_5":14806,"_28300":122513,"_3066":122536},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3610":73354,"_31119":73344,"_21540":122538,"_5":14806,"_28300":122517,"_3066":122539},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3610":73355,"_31119":73344,"_21540":122541,"_5":14806,"_28300":122517,"_3066":122542},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3610":73356,"_31119":73344,"_21540":122544,"_5":14806,"_28300":122517,"_3066":122545},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3610":73357,"_31119":73344,"_21540":122547,"_5":14806,"_28300":122517,"_3066":122548},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3610":73358,"_31119":73344,"_21540":122550,"_5":14806,"_28300":122517,"_3066":122551},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3610":73359,"_31119":73344,"_21540":122553,"_5":14806,"_28300":122517,"_3066":122554},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3610":73360,"_31119":73344,"_21540":122556,"_5":14806,"_28300":122517,"_3066":122557},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3610":73361,"_31119":73361,"_5":15171,"_3066":122559,"_31457":122560,"_21540":122561,"_28300":73361},"Dispositivos e identidades",[50802,121414,53486,122559],[],{"_3610":73362,"_31119":73361,"_21540":122563,"_5":14806,"_28300":73361,"_3066":122564},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3610":73363,"_31119":73361,"_5":31454,"_21540":122566,"_28300":122567,"_3066":122568},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3610":73364,"_31119":73361,"_5":31454,"_21540":122570,"_28300":122571,"_3066":122572},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3610":73365,"_31119":73361,"_5":31454,"_21540":122574,"_28300":122575,"_3066":122576},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3610":73366,"_31119":73361,"_5":31454,"_21540":122578,"_28300":122579,"_3066":122580},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3610":73367,"_31119":73361,"_5":31454,"_21540":122582,"_28300":122583,"_3066":122584},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3610":73368,"_31119":73361,"_5":31454,"_21540":122586,"_28300":122587,"_3066":122588},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3610":73369,"_31119":73361,"_5":31454,"_21540":122590,"_28300":122591,"_3066":122592},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3610":73370,"_31119":73361,"_5":31454,"_21540":122594,"_28300":122595,"_3066":122596},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3610":73371,"_31119":73361,"_5":31454,"_21540":122598,"_28300":122599,"_3066":122600},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3610":73372,"_31119":73361,"_5":31454,"_21540":122602,"_28300":122603,"_3066":122604},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3610":73373,"_31119":73361,"_5":31454,"_21540":122606,"_28300":122607,"_3066":122608},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3610":73374,"_31119":73361,"_21540":122610,"_5":14806,"_28300":73361,"_3066":122611},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3610":73375,"_31119":73361,"_21540":122613,"_5":14806,"_28300":73361,"_3066":122614},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3610":73376,"_31119":73361,"_21540":122616,"_5":14806,"_28300":122567,"_3066":122617},[],"Vista operativa",{"_3610":73377,"_31119":73361,"_21540":122619,"_5":14806,"_28300":122567,"_3066":122620},[],"Interpretación",{"_3610":73378,"_31119":73361,"_21540":122622,"_5":14806,"_28300":122567,"_3066":53549},[],{"_3610":73379,"_31119":73361,"_21540":122624,"_5":14806,"_28300":122567,"_3066":122625},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3610":73380,"_31119":73361,"_21540":122627,"_5":14806,"_28300":122567,"_3066":53555},[],{"_3610":73381,"_31119":73361,"_21540":122629,"_5":14806,"_28300":122567,"_3066":122630},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3610":73382,"_31119":73361,"_21540":122632,"_5":14806,"_28300":122567,"_3066":53561},[],{"_3610":73383,"_31119":73361,"_21540":122634,"_5":14806,"_28300":122567,"_3066":122635},[],"La identidad está en la ventana operativa de renovación.",{"_3610":73384,"_31119":73361,"_21540":122637,"_5":14806,"_28300":122567,"_3066":53567},[],{"_3610":73385,"_31119":73361,"_21540":122639,"_5":14806,"_28300":122567,"_3066":122640},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3610":73386,"_31119":73361,"_21540":122642,"_5":14806,"_28300":122567,"_3066":53573},[],{"_3610":73387,"_31119":73361,"_21540":122644,"_5":14806,"_28300":122567,"_3066":122645},[],"La identidad ha vencido.",{"_3610":73388,"_31119":73361,"_21540":122647,"_5":14806,"_28300":122567,"_3066":53579},[],{"_3610":73389,"_31119":73361,"_21540":122649,"_5":14806,"_28300":122567,"_3066":122650},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3610":73390,"_31119":73361,"_21540":122652,"_5":14806,"_28300":122567,"_3066":53585},[],{"_3610":73391,"_31119":73361,"_21540":122654,"_5":14806,"_28300":122567,"_3066":122655},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3610":73392,"_31119":73361,"_21540":122657,"_5":14806,"_28300":122567,"_3066":122658},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3610":73393,"_31119":73361,"_21540":122660,"_5":14806,"_28300":122571,"_3066":122661},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3610":73394,"_31119":73361,"_21540":122663,"_5":14806,"_28300":122571,"_3066":122664},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3610":73395,"_31119":73361,"_21540":122666,"_5":14806,"_28300":122571,"_3066":122667},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3610":73396,"_31119":73361,"_21540":122669,"_5":14806,"_28300":122571,"_3066":122670},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3610":73397,"_31119":73361,"_21540":122672,"_5":14806,"_28300":122575,"_3066":122673},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3610":73398,"_31119":73361,"_21540":122675,"_5":14806,"_28300":122579,"_3066":122676},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3610":73399,"_31119":73361,"_21540":122678,"_5":14806,"_28300":122583,"_3066":122679},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3610":73400,"_31119":73361,"_21540":122681,"_5":14806,"_28300":122587,"_3066":122682},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3610":73401,"_31119":73361,"_21540":122684,"_5":14806,"_28300":122591,"_3066":122685},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3610":73402,"_31119":73361,"_21540":122687,"_5":14806,"_28300":122591,"_3066":122688},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3610":73403,"_31119":73361,"_21540":122690,"_5":14806,"_28300":122595,"_3066":122691},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3610":73404,"_31119":73361,"_21540":122693,"_5":14806,"_28300":122595,"_3066":122694},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3610":73405,"_31119":73361,"_21540":122696,"_5":14806,"_28300":122595,"_3066":122697},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3610":73406,"_31119":73361,"_21540":122699,"_5":14806,"_28300":122595,"_3066":122700},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3610":73407,"_31119":73361,"_21540":122702,"_5":14806,"_28300":122595,"_3066":122703},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3610":73408,"_31119":73361,"_21540":122705,"_5":14806,"_28300":122595,"_3066":122706},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3610":73409,"_31119":73361,"_21540":122708,"_5":14806,"_28300":122599,"_3066":122709},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3610":73410,"_31119":73361,"_21540":122711,"_5":14806,"_28300":122599,"_3066":122712},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3610":73411,"_31119":73361,"_21540":122714,"_5":14806,"_28300":122599,"_3066":122715},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3610":73412,"_31119":73361,"_21540":122717,"_5":14806,"_28300":122603,"_3066":122718},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3610":73413,"_31119":73361,"_21540":122720,"_5":14806,"_28300":122603,"_3066":122721},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3610":73414,"_31119":73361,"_21540":122723,"_5":14806,"_28300":122603,"_3066":122724},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3610":73415,"_31119":73361,"_21540":122726,"_5":14806,"_28300":122603,"_3066":122727},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3610":73416,"_31119":73361,"_21540":122729,"_5":14806,"_28300":122607,"_3066":122730},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3610":73417,"_31119":73361,"_21540":122732,"_5":14806,"_28300":122607,"_3066":122733},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3610":73418,"_31119":73418,"_5":15171,"_3066":122735,"_31457":122736,"_21540":122738,"_28300":73418},"Identidad inicial y autenticación",[50802,121414,53486,122559,122737],"Enrolamiento con PKI",[],{"_3610":73419,"_31119":73418,"_21540":122740,"_5":14806,"_28300":73418,"_3066":122741},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3610":73420,"_31119":73418,"_5":31454,"_21540":122743,"_28300":122744,"_3066":122745},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3610":73421,"_31119":73418,"_5":31454,"_21540":122747,"_28300":122748,"_3066":122749},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3610":73422,"_31119":73418,"_5":31454,"_21540":122751,"_28300":122752,"_3066":122753},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3610":73423,"_31119":73418,"_5":31454,"_21540":122755,"_28300":122756,"_3066":122757},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3610":73424,"_31119":73418,"_5":31454,"_21540":122759,"_28300":122760,"_3066":122761},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3610":73425,"_31119":73418,"_21540":122763,"_5":14806,"_28300":73418,"_3066":122764},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3610":73426,"_31119":73418,"_21540":122766,"_5":14806,"_28300":122744,"_3066":122767},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3610":73427,"_31119":73418,"_21540":122769,"_5":14806,"_28300":122744,"_3066":122770},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3610":73428,"_31119":73418,"_21540":122772,"_5":14806,"_28300":122748,"_3066":122773},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3610":73429,"_31119":73418,"_21540":122775,"_5":14806,"_28300":122748,"_3066":122776},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3610":73430,"_31119":73418,"_21540":122778,"_5":14806,"_28300":122748,"_3066":122779},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3610":73431,"_31119":73418,"_21540":122781,"_5":14806,"_28300":122752,"_3066":122782},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3610":73432,"_31119":73418,"_21540":122784,"_5":14806,"_28300":122752,"_3066":122785},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3610":73433,"_31119":73418,"_21540":122787,"_5":14806,"_28300":122756,"_3066":122788},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3610":73434,"_31119":73418,"_21540":122790,"_5":14806,"_28300":122756,"_3066":122791},[],"Ejemplo de cuerpo:",{"_3610":73435,"_31119":73418,"_21540":122793,"_5":14806,"_28300":122756,"_3066":122794},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3610":73436,"_31119":73418,"_21540":122796,"_5":14806,"_28300":122756,"_3066":122797},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3610":73437,"_31119":73418,"_21540":122799,"_5":14806,"_28300":122756,"_3066":122800},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3610":73438,"_31119":73418,"_21540":122802,"_5":14806,"_28300":122756,"_3066":122803},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3610":73439,"_31119":73418,"_21540":122805,"_5":14806,"_28300":122760,"_3066":122806},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3610":73440,"_31119":73418,"_21540":122808,"_5":14806,"_28300":122760,"_3066":122809},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3610":73441,"_31119":73441,"_5":15171,"_3066":122811,"_31457":122812,"_21540":122813,"_28300":73441},"Configura y opera el DMS",[50802,121414,53486,122559,122737],[],{"_3610":73442,"_31119":73441,"_21540":122815,"_5":14806,"_28300":73441,"_3066":122816},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3610":73443,"_31119":73441,"_5":31454,"_21540":122818,"_28300":122819,"_3066":119948},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3610":73444,"_31119":73441,"_5":31454,"_21540":122821,"_28300":122822,"_3066":122823},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3610":73445,"_31119":73441,"_5":31454,"_21540":122825,"_28300":122826,"_3066":122827},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3610":73446,"_31119":73441,"_5":31454,"_21540":122829,"_28300":122830,"_3066":122831},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3610":73447,"_31119":73441,"_5":31454,"_21540":122833,"_28300":122834,"_3066":122835},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3610":73448,"_31119":73441,"_5":31454,"_21540":122837,"_28300":122838,"_3066":122839},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3610":73449,"_31119":73441,"_5":31454,"_21540":122841,"_28300":122842,"_3066":122843},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3610":73450,"_31119":73441,"_5":31454,"_21540":122845,"_28300":122846,"_3066":122847},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3610":73451,"_31119":73441,"_5":31454,"_21540":122849,"_28300":122850,"_3066":53784},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3610":73452,"_31119":73441,"_5":31454,"_21540":122852,"_28300":122853,"_3066":53788},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3610":73453,"_31119":73441,"_5":31454,"_21540":122855,"_28300":122856,"_3066":122857},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3610":73454,"_31119":73441,"_5":31454,"_21540":122859,"_28300":122860,"_3066":122861},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3610":73455,"_31119":73441,"_5":31454,"_21540":122863,"_28300":122864,"_3066":122865},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3610":73456,"_31119":73441,"_5":31454,"_21540":122867,"_28300":122868,"_3066":122869},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3610":73457,"_31119":73441,"_5":31454,"_21540":122871,"_28300":122872,"_3066":53808},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3610":73458,"_31119":73441,"_5":31454,"_21540":122874,"_28300":122875,"_3066":122876},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3610":73459,"_31119":73441,"_5":31454,"_21540":122878,"_28300":122879,"_3066":122880},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3610":73460,"_31119":73441,"_5":31454,"_21540":122882,"_28300":122883,"_3066":122884},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3610":73461,"_31119":73441,"_21540":122886,"_5":14806,"_28300":73441,"_3066":122887},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3610":73462,"_31119":73441,"_21540":122889,"_5":14806,"_28300":122819,"_3066":122890},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3610":73463,"_31119":73441,"_21540":122892,"_5":14806,"_28300":122819,"_3066":122893},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3610":73464,"_31119":73441,"_21540":122895,"_5":14806,"_28300":122826,"_3066":122896},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3610":73465,"_31119":73441,"_21540":122898,"_5":14806,"_28300":122830,"_3066":122899},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3610":73466,"_31119":73441,"_21540":122901,"_5":14806,"_28300":122834,"_3066":122902},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3610":73467,"_31119":73441,"_21540":122904,"_5":14806,"_28300":122838,"_3066":122905},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3610":73468,"_31119":73441,"_21540":122907,"_5":14806,"_28300":122842,"_3066":122908},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3610":73469,"_31119":73441,"_21540":122910,"_5":14806,"_28300":122850,"_3066":122911},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3610":73470,"_31119":73441,"_21540":122913,"_5":14806,"_28300":122850,"_3066":122914},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3610":73471,"_31119":73441,"_21540":122916,"_5":14806,"_28300":122853,"_3066":122917},[],"Campo de `settings.enrollment_settings`",{"_3610":73472,"_31119":73441,"_21540":122919,"_5":14806,"_28300":122853,"_3066":122920},[],"Decisión",{"_3610":73473,"_31119":73441,"_21540":122922,"_5":14806,"_28300":122853,"_3066":53859},[],{"_3610":73474,"_31119":73441,"_21540":122924,"_5":14806,"_28300":122853,"_3066":122925},[],"`EST_RFC7030` para estas operaciones.",{"_3610":73475,"_31119":73441,"_21540":122927,"_5":14806,"_28300":122853,"_3066":53865},[],{"_3610":73476,"_31119":73441,"_21540":122929,"_5":14806,"_28300":122853,"_3066":122930},[],"ID de la CA que firmará.",{"_3610":73477,"_31119":73441,"_21540":122932,"_5":14806,"_28300":122853,"_3066":53871},[],{"_3610":73478,"_31119":73441,"_21540":122934,"_5":14806,"_28300":122853,"_3066":122935},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3610":73479,"_31119":73441,"_21540":122937,"_5":14806,"_28300":122853,"_3066":53877},[],{"_3610":73480,"_31119":73441,"_21540":122939,"_5":14806,"_28300":122853,"_3066":122940},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3610":73481,"_31119":73441,"_21540":122942,"_5":14806,"_28300":122853,"_3066":53883},[],{"_3610":73482,"_31119":73441,"_21540":122944,"_5":14806,"_28300":122853,"_3066":122945},[],"Uno de los cuatro modos de autenticación.",{"_3610":73483,"_31119":73441,"_21540":122947,"_5":14806,"_28300":122853,"_3066":122948},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3610":73484,"_31119":73441,"_21540":122950,"_5":14806,"_28300":122856,"_3066":122951},[],"Los bloques son independientes:",{"_3610":73485,"_31119":73441,"_21540":122953,"_5":14806,"_28300":122856,"_3066":122954},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3610":73486,"_31119":73441,"_21540":122956,"_5":14806,"_28300":122856,"_3066":122957},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3610":73487,"_31119":73441,"_21540":122959,"_5":14806,"_28300":122856,"_3066":53901},[],{"_3610":73488,"_31119":73441,"_21540":122961,"_5":14806,"_28300":122856,"_3066":122962},[],"Control aplicado en la operación configurada",{"_3610":73489,"_31119":73441,"_21540":122964,"_5":14806,"_28300":122856,"_3066":53907},[],{"_3610":73490,"_31119":73441,"_21540":122966,"_5":14806,"_28300":122856,"_3066":122967},[],"Validación del certificado presentado.",{"_3610":73491,"_31119":73441,"_21540":122969,"_5":14806,"_28300":122856,"_3066":53913},[],{"_3610":73492,"_31119":73441,"_21540":122971,"_5":14806,"_28300":122856,"_3066":122972},[],"Autorización del webhook configurado.",{"_3610":73493,"_31119":73441,"_21540":122974,"_5":14806,"_28300":122856,"_3066":53919},[],{"_3610":73494,"_31119":73441,"_21540":122976,"_5":14806,"_28300":122856,"_3066":122977},[],"Validación del certificado y, después, aprobación del webhook.",{"_3610":73495,"_31119":73441,"_21540":122979,"_5":14806,"_28300":122856,"_3066":53925},[],{"_3610":73496,"_31119":73441,"_21540":122981,"_5":14806,"_28300":122856,"_3066":122982},[],"Sin autenticación del solicitante por el DMS.",{"_3610":73497,"_31119":73441,"_21540":122984,"_5":14806,"_28300":122856,"_3066":122985},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3610":73498,"_31119":73441,"_21540":122987,"_5":14806,"_28300":122856,"_3066":122988},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3610":73499,"_31119":73441,"_21540":122990,"_5":14806,"_28300":122856,"_3066":122991},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3610":73500,"_31119":73441,"_21540":122993,"_5":14806,"_28300":122856,"_3066":122994},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3610":73501,"_31119":73441,"_21540":122996,"_5":14806,"_28300":122860,"_3066":122997},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3610":73502,"_31119":73441,"_21540":122999,"_5":14806,"_28300":122860,"_3066":123000},[],"Campo de `external_webhook_settings`",{"_3610":73503,"_31119":73441,"_21540":123002,"_5":14806,"_28300":122860,"_3066":122920},[],{"_3610":73504,"_31119":73441,"_21540":123004,"_5":14806,"_28300":122860,"_3066":53951},[],{"_3610":73505,"_31119":73441,"_21540":123006,"_5":14806,"_28300":122860,"_3066":123007},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3610":73506,"_31119":73441,"_21540":123009,"_5":14806,"_28300":122860,"_3066":53957},[],{"_3610":73507,"_31119":73441,"_21540":123011,"_5":14806,"_28300":122860,"_3066":123012},[],"`POST` o `PUT`; `POST` por defecto.",{"_3610":73508,"_31119":73441,"_21540":123014,"_5":14806,"_28300":122860,"_3066":53963},[],{"_3610":73509,"_31119":73441,"_21540":123016,"_5":14806,"_28300":122860,"_3066":123017},[],"Etiqueta usada en los logs del servicio.",{"_3610":73510,"_31119":73441,"_21540":123019,"_5":14806,"_28300":122860,"_3066":53969},[],{"_3610":73511,"_31119":73441,"_21540":123021,"_5":14806,"_28300":122860,"_3066":123022},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3610":73512,"_31119":73441,"_21540":123024,"_5":14806,"_28300":122860,"_3066":53975},[],{"_3610":73513,"_31119":73441,"_21540":123026,"_5":14806,"_28300":122860,"_3066":123027},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3610":73514,"_31119":73441,"_21540":123029,"_5":14806,"_28300":122860,"_3066":53981},[],{"_3610":73515,"_31119":73441,"_21540":123031,"_5":14806,"_28300":122860,"_3066":123032},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3610":73516,"_31119":73441,"_21540":123034,"_5":14806,"_28300":122860,"_3066":53987},[],{"_3610":73517,"_31119":73441,"_21540":123036,"_5":14806,"_28300":122860,"_3066":123037},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3610":73518,"_31119":73441,"_21540":123039,"_5":14806,"_28300":122860,"_3066":53993},[],{"_3610":73519,"_31119":73441,"_21540":123041,"_5":14806,"_28300":122860,"_3066":123042},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3610":73520,"_31119":73441,"_21540":123044,"_5":14806,"_28300":122860,"_3066":53999},[],{"_3610":73521,"_31119":73441,"_21540":123046,"_5":14806,"_28300":122860,"_3066":123047},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3610":73522,"_31119":73441,"_21540":123049,"_5":14806,"_28300":122860,"_3066":54005},[],{"_3610":73523,"_31119":73441,"_21540":123051,"_5":14806,"_28300":122860,"_3066":123052},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3610":73524,"_31119":73441,"_21540":123054,"_5":14806,"_28300":122860,"_3066":123055},[],"Reglas de esa configuración:",{"_3610":73525,"_31119":73441,"_21540":123057,"_5":14806,"_28300":122860,"_3066":123058},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3610":73526,"_31119":73441,"_21540":123060,"_5":14806,"_28300":122860,"_3066":123061},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3610":73527,"_31119":73441,"_21540":123063,"_5":14806,"_28300":122860,"_3066":123064},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3610":73528,"_31119":73441,"_21540":123066,"_5":14806,"_28300":122860,"_3066":123067},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3610":73529,"_31119":73441,"_21540":123069,"_5":14806,"_28300":122860,"_3066":123070},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3610":73530,"_31119":73441,"_21540":123072,"_5":14806,"_28300":122860,"_3066":123073},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3610":73531,"_31119":73441,"_21540":123075,"_5":14806,"_28300":122860,"_3066":123076},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3610":73532,"_31119":73441,"_21540":123078,"_5":14806,"_28300":122860,"_3066":123079},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3610":73533,"_31119":73441,"_21540":123081,"_5":14806,"_28300":122860,"_3066":123082},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3610":73534,"_31119":73441,"_21540":123084,"_5":14806,"_28300":122864,"_3066":123085},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3610":73535,"_31119":73441,"_21540":123087,"_5":14806,"_28300":122868,"_3066":123088},[],"Campo de `settings.reenrollment_settings`",{"_3610":73536,"_31119":73441,"_21540":123090,"_5":14806,"_28300":122868,"_3066":123091},[],"Función",{"_3610":73537,"_31119":73441,"_21540":123093,"_5":14806,"_28300":122868,"_3066":54049},[],{"_3610":73538,"_31119":73441,"_21540":123095,"_5":14806,"_28300":122868,"_3066":123096},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3610":73539,"_31119":73441,"_21540":123098,"_5":14806,"_28300":122868,"_3066":54055},[],{"_3610":73540,"_31119":73441,"_21540":123100,"_5":14806,"_28300":122868,"_3066":123101},[],"Umbral operativo preventivo de monitorización.",{"_3610":73541,"_31119":73441,"_21540":123103,"_5":14806,"_28300":122868,"_3066":54061},[],{"_3610":73542,"_31119":73441,"_21540":123105,"_5":14806,"_28300":122868,"_3066":123106},[],"Umbral operativo crítico de monitorización.",{"_3610":73543,"_31119":73441,"_21540":123108,"_5":14806,"_28300":122868,"_3066":54067},[],{"_3610":73544,"_31119":73441,"_21540":123110,"_5":14806,"_28300":122868,"_3066":123111},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3610":73545,"_31119":73441,"_21540":123113,"_5":14806,"_28300":122868,"_3066":54073},[],{"_3610":73546,"_31119":73441,"_21540":123115,"_5":14806,"_28300":122868,"_3066":123116},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3610":73547,"_31119":73441,"_21540":123118,"_5":14806,"_28300":122868,"_3066":54079},[],{"_3610":73548,"_31119":73441,"_21540":123120,"_5":14806,"_28300":122868,"_3066":123121},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3610":73549,"_31119":73441,"_21540":123123,"_5":14806,"_28300":122868,"_3066":123124},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3610":73550,"_31119":73441,"_21540":123126,"_5":14806,"_28300":122872,"_3066":123127},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3610":73551,"_31119":73441,"_21540":123129,"_5":14806,"_28300":122875,"_3066":120312},[],{"_3610":73552,"_31119":73441,"_21540":123131,"_5":14806,"_28300":122875,"_3066":123132},[],"Qué publica",{"_3610":73553,"_31119":73441,"_21540":123134,"_5":14806,"_28300":122875,"_3066":54096},[],{"_3610":73554,"_31119":73441,"_21540":123136,"_5":14806,"_28300":122875,"_3066":123137},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3610":73555,"_31119":73441,"_21540":123139,"_5":14806,"_28300":122875,"_3066":54102},[],{"_3610":73556,"_31119":73441,"_21540":123141,"_5":14806,"_28300":122875,"_3066":123142},[],"Certificado de la CA emisora seleccionada.",{"_3610":73557,"_31119":73441,"_21540":123144,"_5":14806,"_28300":122875,"_3066":54108},[],{"_3610":73558,"_31119":73441,"_21540":123146,"_5":14806,"_28300":122875,"_3066":123147},[],"Certificados de las CAs elegidas explícitamente.",{"_3610":73559,"_31119":73441,"_21540":123149,"_5":14806,"_28300":122875,"_3066":123150},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3610":73560,"_31119":73441,"_21540":123152,"_5":14806,"_28300":122879,"_3066":123153},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3610":73561,"_31119":73441,"_21540":123155,"_5":14806,"_28300":122879,"_3066":123156},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3610":73562,"_31119":73441,"_21540":123158,"_5":14806,"_28300":122879,"_3066":123159},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3610":73563,"_31119":73441,"_21540":123161,"_5":14806,"_28300":122883,"_3066":123162},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3610":73564,"_31119":73564,"_5":15171,"_3066":123164,"_31457":123165,"_21540":123166,"_28300":73564},"Integra el cliente EST",[50802,121414,53486,122559,122737],[],{"_3610":73565,"_31119":73564,"_21540":123168,"_5":14806,"_28300":73564,"_3066":123169},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3610":73566,"_31119":73564,"_5":31454,"_21540":123171,"_28300":123172,"_3066":119948},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3610":73567,"_31119":73564,"_5":31454,"_21540":123174,"_28300":123175,"_3066":123176},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3610":73568,"_31119":73564,"_5":31454,"_21540":123178,"_28300":123179,"_3066":123180},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3610":73569,"_31119":73564,"_5":31454,"_21540":123182,"_28300":123183,"_3066":123184},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3610":73570,"_31119":73564,"_5":31454,"_21540":123186,"_28300":123187,"_3066":123188},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3610":73571,"_31119":73564,"_5":31454,"_21540":123190,"_28300":123191,"_3066":123192},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3610":73572,"_31119":73564,"_21540":123194,"_5":14806,"_28300":73564,"_3066":123195},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3610":73573,"_31119":73564,"_21540":123197,"_5":14806,"_28300":123172,"_3066":123198},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3610":73574,"_31119":73564,"_21540":123200,"_5":14806,"_28300":123172,"_3066":123201},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3610":73575,"_31119":73564,"_21540":123203,"_5":14806,"_28300":123172,"_3066":123204},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3610":73576,"_31119":73564,"_21540":123206,"_5":14806,"_28300":123175,"_3066":123207},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3610":73577,"_31119":73564,"_21540":123209,"_5":14806,"_28300":123175,"_3066":123210},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3610":73578,"_31119":73564,"_21540":123212,"_5":14806,"_28300":123179,"_3066":123213},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3610":73579,"_31119":73564,"_21540":123215,"_5":14806,"_28300":123179,"_3066":123216},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3610":73580,"_31119":73564,"_21540":123218,"_5":14806,"_28300":123183,"_3066":123219},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3610":73581,"_31119":73564,"_21540":123221,"_5":14806,"_28300":123183,"_3066":123222},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3610":73582,"_31119":73564,"_21540":123224,"_5":14806,"_28300":123187,"_3066":123225},[],"Para el caso de una raíz que emite directamente:",{"_3610":73583,"_31119":73564,"_21540":123227,"_5":14806,"_28300":123187,"_3066":123228},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3610":73584,"_31119":73564,"_21540":123230,"_5":14806,"_28300":123187,"_3066":123231},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3610":73585,"_31119":73564,"_21540":123233,"_5":14806,"_28300":123191,"_3066":123234},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3610":73586,"_31119":73586,"_5":15171,"_3066":123236,"_31457":123237,"_21540":123238,"_28300":73586},"Referencia EST",[50802,121414,53486,122559,122737],[],{"_3610":73587,"_31119":73586,"_21540":123240,"_5":14806,"_28300":73586,"_3066":123241},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3610":73588,"_31119":73586,"_5":31454,"_21540":123243,"_28300":123244,"_3066":123245},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3610":73589,"_31119":73586,"_5":31454,"_21540":123247,"_28300":123248,"_3066":23342},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3610":73590,"_31119":73586,"_5":31454,"_21540":123250,"_28300":123251,"_3066":26846},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3610":73591,"_31119":73586,"_5":31454,"_21540":123253,"_28300":123254,"_3066":26853},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3610":73592,"_31119":73586,"_5":31454,"_21540":123256,"_28300":123257,"_3066":26110},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3610":73593,"_31119":73586,"_5":31454,"_21540":123259,"_28300":123260,"_3066":123261},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3610":73594,"_31119":73586,"_5":31454,"_21540":123263,"_28300":123264,"_3066":123265},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3610":73595,"_31119":73586,"_5":31454,"_21540":123267,"_28300":123268,"_3066":123269},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3610":73596,"_31119":73586,"_21540":123271,"_5":14806,"_28300":73586,"_3066":123272},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3610":73597,"_31119":73586,"_21540":123274,"_5":14806,"_28300":123244,"_3066":123275},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3610":73598,"_31119":73586,"_21540":123277,"_5":14806,"_28300":123244,"_3066":121174},[],{"_3610":73599,"_31119":73586,"_21540":123279,"_5":14806,"_28300":123244,"_3066":123280},[],"Método",{"_3610":73600,"_31119":73586,"_21540":123282,"_5":14806,"_28300":123244,"_3066":123283},[],"Autenticación y condición",{"_3610":73601,"_31119":73586,"_21540":123285,"_5":14806,"_28300":123244,"_3066":54251},[],{"_3610":73602,"_31119":73586,"_21540":123287,"_5":14806,"_28300":123244,"_3066":54254},[],{"_3610":73603,"_31119":73586,"_21540":123289,"_5":14806,"_28300":123244,"_3066":123290},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3610":73604,"_31119":73586,"_21540":123292,"_5":14806,"_28300":123244,"_3066":54260},[],{"_3610":73605,"_31119":73586,"_21540":123294,"_5":14806,"_28300":123244,"_3066":54263},[],{"_3610":73606,"_31119":73586,"_21540":123296,"_5":14806,"_28300":123244,"_3066":123297},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3610":73607,"_31119":73586,"_21540":123299,"_5":14806,"_28300":123244,"_3066":54269},[],{"_3610":73608,"_31119":73586,"_21540":123301,"_5":14806,"_28300":123244,"_3066":54263},[],{"_3610":73609,"_31119":73586,"_21540":123303,"_5":14806,"_28300":123244,"_3066":123304},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3610":73610,"_31119":73586,"_21540":123306,"_5":14806,"_28300":123244,"_3066":54277},[],{"_3610":73611,"_31119":73586,"_21540":123308,"_5":14806,"_28300":123244,"_3066":54263},[],{"_3610":73612,"_31119":73586,"_21540":123310,"_5":14806,"_28300":123244,"_3066":123311},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3610":73613,"_31119":73586,"_21540":123313,"_5":14806,"_28300":123244,"_3066":123314},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3610":73614,"_31119":73586,"_21540":123316,"_5":14806,"_28300":123248,"_3066":123317},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3610":73615,"_31119":73586,"_21540":123319,"_5":14806,"_28300":123248,"_3066":123320},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3610":73616,"_31119":73586,"_21540":123322,"_5":14806,"_28300":123251,"_3066":123323},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3610":73617,"_31119":73586,"_21540":123325,"_5":14806,"_28300":123251,"_3066":123326},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3610":73618,"_31119":73586,"_21540":123328,"_5":14806,"_28300":123254,"_3066":123329},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3610":73619,"_31119":73586,"_21540":123331,"_5":14806,"_28300":123254,"_3066":123332},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3610":73620,"_31119":73586,"_21540":123334,"_5":14806,"_28300":123257,"_3066":123335},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3610":73621,"_31119":73586,"_21540":123337,"_5":14806,"_28300":123257,"_3066":123338},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3610":73622,"_31119":73586,"_21540":123340,"_5":14806,"_28300":123260,"_3066":123341},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3610":73623,"_31119":73586,"_21540":123343,"_5":14806,"_28300":123260,"_3066":123344},[],"Parte",{"_3610":73624,"_31119":73586,"_21540":123346,"_5":14806,"_28300":123260,"_3066":123347},[],"Contenido tras decodificar su Base64",{"_3610":73625,"_31119":73586,"_21540":123349,"_5":14806,"_28300":123260,"_3066":54321},[],{"_3610":73626,"_31119":73586,"_21540":123351,"_5":14806,"_28300":123260,"_3066":123352},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3610":73627,"_31119":73586,"_21540":123354,"_5":14806,"_28300":123260,"_3066":54327},[],{"_3610":73628,"_31119":73586,"_21540":123356,"_5":14806,"_28300":123260,"_3066":123357},[],"PKCS#7 DER con el certificado emitido.",{"_3610":73629,"_31119":73586,"_21540":123359,"_5":14806,"_28300":123260,"_3066":123360},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3610":73630,"_31119":73586,"_21540":123362,"_5":14806,"_28300":123264,"_3066":123363},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3610":73631,"_31119":73586,"_21540":123365,"_5":14806,"_28300":123264,"_3066":123366},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3610":73632,"_31119":73586,"_21540":123368,"_5":14806,"_28300":123264,"_3066":123369},[],"Convierte y comprueba el resultado:",{"_3610":73633,"_31119":73586,"_21540":123371,"_5":14806,"_28300":123264,"_3066":123372},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3610":73634,"_31119":73586,"_21540":123374,"_5":14806,"_28300":123268,"_3066":123375},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3610":73635,"_31119":73586,"_21540":123377,"_5":14806,"_28300":123268,"_3066":123378},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3610":73636,"_31119":73636,"_5":15171,"_3066":122737,"_31457":123380,"_21540":123381,"_28300":73636},[50802,121414,53486,122559,122737],[],{"_3610":73637,"_31119":73636,"_21540":123383,"_5":14806,"_28300":73636,"_3066":123384},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3610":73638,"_31119":73636,"_5":31454,"_21540":123386,"_28300":123387,"_3066":123388},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3610":73639,"_31119":73636,"_5":31454,"_21540":123390,"_28300":123391,"_3066":123392},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3610":73640,"_31119":73636,"_5":31454,"_21540":123394,"_28300":123395,"_3066":123396},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3610":73641,"_31119":73636,"_5":31454,"_21540":123398,"_28300":123399,"_3066":123400},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3610":73642,"_31119":73636,"_21540":123402,"_5":14806,"_28300":73636,"_3066":123403},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3610":73643,"_31119":73636,"_21540":123405,"_5":14806,"_28300":123387,"_3066":123406},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3610":73644,"_31119":73636,"_21540":123408,"_5":14806,"_28300":123387,"_3066":123409},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3610":73645,"_31119":73636,"_21540":123411,"_5":14806,"_28300":123387,"_3066":123412},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3610":73646,"_31119":73636,"_21540":123414,"_5":14806,"_28300":123387,"_3066":123415},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3610":73647,"_31119":73636,"_21540":123417,"_5":14806,"_28300":123387,"_3066":123418},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3610":73648,"_31119":73636,"_21540":123420,"_5":14806,"_28300":123387,"_3066":123421},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3610":73649,"_31119":73636,"_21540":123423,"_5":14806,"_28300":123391,"_3066":123424},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3610":73650,"_31119":73636,"_21540":123426,"_5":14806,"_28300":123391,"_3066":123427},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3610":73651,"_31119":73636,"_21540":123429,"_5":14806,"_28300":123391,"_3066":123430},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3610":73652,"_31119":73636,"_21540":123432,"_5":14806,"_28300":123391,"_3066":123433},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3610":73653,"_31119":73636,"_21540":123435,"_5":14806,"_28300":123395,"_3066":123436},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3610":73654,"_31119":73636,"_21540":123438,"_5":14806,"_28300":123395,"_3066":123439},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3610":73655,"_31119":73636,"_21540":123441,"_5":14806,"_28300":123395,"_3066":123442},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3610":73656,"_31119":73636,"_21540":123444,"_5":14806,"_28300":123395,"_3066":123445},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3610":73657,"_31119":73636,"_21540":123447,"_5":14806,"_28300":123399,"_3066":123448},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3610":73658,"_31119":73636,"_21540":123450,"_5":14806,"_28300":123399,"_3066":123451},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3610":73659,"_31119":73659,"_5":15171,"_3066":123453,"_31457":123454,"_21540":123455,"_28300":73659},"Estrategias de aprovisionamiento",[50802,121414,53486,122559,122737],[],{"_3610":73660,"_31119":73659,"_21540":123457,"_5":14806,"_28300":73659,"_3066":123458},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3610":73661,"_31119":73659,"_5":31454,"_21540":123460,"_28300":123461,"_3066":123462},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3610":73662,"_31119":73659,"_5":31454,"_21540":123464,"_28300":123465,"_3066":123466},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3610":73663,"_31119":73659,"_5":31454,"_21540":123468,"_28300":123469,"_3066":123470},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3610":73664,"_31119":73659,"_5":31454,"_21540":123472,"_28300":123473,"_3066":123474},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3610":73665,"_31119":73659,"_5":31454,"_21540":123476,"_28300":123477,"_3066":123478},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3610":73666,"_31119":73659,"_21540":123480,"_5":14806,"_28300":73659,"_3066":123481},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3610":73667,"_31119":73659,"_21540":123483,"_5":14806,"_28300":123461,"_3066":123484},[],"Recorrido",{"_3610":73668,"_31119":73659,"_21540":123486,"_5":14806,"_28300":123461,"_3066":123487},[],"Cuándo existe el dispositivo",{"_3610":73669,"_31119":73659,"_21540":123489,"_5":14806,"_28300":123461,"_3066":123490},[],"Qué compruebas",{"_3610":73670,"_31119":73659,"_21540":123492,"_5":14806,"_28300":123461,"_3066":123493},[],"Asignación manual",{"_3610":73671,"_31119":73659,"_21540":123495,"_5":14806,"_28300":123461,"_3066":123496},[],"El operador lo crea antes de asociar un certificado.",{"_3610":73672,"_31119":73659,"_21540":123498,"_5":14806,"_28300":123461,"_3066":123499},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3610":73673,"_31119":73659,"_21540":123501,"_5":14806,"_28300":123461,"_3066":123502},[],"EST con `JITP`",{"_3610":73674,"_31119":73659,"_21540":123504,"_5":14806,"_28300":123461,"_3066":123505},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3610":73675,"_31119":73659,"_21540":123507,"_5":14806,"_28300":123461,"_3066":123508},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3610":73676,"_31119":73659,"_21540":123510,"_5":14806,"_28300":123461,"_3066":123511},[],"EST con `PRE_REGISTRATION`",{"_3610":73677,"_31119":73659,"_21540":123513,"_5":14806,"_28300":123461,"_3066":123514},[],"Debe existir antes de `/simpleenroll`.",{"_3610":73678,"_31119":73659,"_21540":123516,"_5":14806,"_28300":123461,"_3066":123517},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3610":73679,"_31119":73659,"_21540":123519,"_5":14806,"_28300":123461,"_3066":123520},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3610":73680,"_31119":73659,"_21540":123522,"_5":14806,"_28300":123461,"_3066":123523},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3610":73681,"_31119":73659,"_21540":123525,"_5":14806,"_28300":123465,"_3066":123526},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3610":73682,"_31119":73659,"_21540":123528,"_5":14806,"_28300":123465,"_3066":123529},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3610":73683,"_31119":73659,"_21540":123531,"_5":14806,"_28300":123465,"_3066":123532},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3610":73684,"_31119":73659,"_21540":123534,"_5":14806,"_28300":123469,"_3066":123535},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3610":73685,"_31119":73659,"_21540":123537,"_5":14806,"_28300":123469,"_3066":123538},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3610":73686,"_31119":73659,"_21540":123540,"_5":14806,"_28300":123469,"_3066":123541},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3610":73687,"_31119":73659,"_21540":123543,"_5":14806,"_28300":123469,"_3066":123544},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3610":73688,"_31119":73659,"_21540":123546,"_5":14806,"_28300":123469,"_3066":123547},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3610":73689,"_31119":73659,"_21540":123549,"_5":14806,"_28300":123469,"_3066":123550},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3610":73690,"_31119":73659,"_21540":123552,"_5":14806,"_28300":123473,"_3066":120312},[],{"_3610":73691,"_31119":73659,"_21540":123554,"_5":14806,"_28300":123473,"_3066":123555},[],"Material que atraviesa EST",{"_3610":73692,"_31119":73659,"_21540":123557,"_5":14806,"_28300":123473,"_3066":123558},[],"Clave generada por el dispositivo",{"_3610":73693,"_31119":73659,"_21540":123560,"_5":14806,"_28300":123473,"_3066":123561},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3610":73694,"_31119":73659,"_21540":123563,"_5":14806,"_28300":123473,"_3066":123564},[],"Clave ya disponible en el dispositivo",{"_3610":73695,"_31119":73659,"_21540":123566,"_5":14806,"_28300":123473,"_3066":123567},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3610":73696,"_31119":73659,"_21540":123569,"_5":14806,"_28300":123473,"_3066":53808},[],{"_3610":73697,"_31119":73659,"_21540":123571,"_5":14806,"_28300":123473,"_3066":123572},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3610":73698,"_31119":73659,"_21540":123574,"_5":14806,"_28300":123473,"_3066":123575},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3610":73699,"_31119":73659,"_21540":123577,"_5":14806,"_28300":123477,"_3066":123578},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3610":73700,"_31119":73700,"_5":15171,"_3066":123580,"_31457":123581,"_21540":123582,"_28300":73700},"Renovación y recuperación",[50802,121414,53486,122559,122737],[],{"_3610":73701,"_31119":73700,"_21540":123584,"_5":14806,"_28300":73700,"_3066":123585},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3610":73702,"_31119":73700,"_5":31454,"_21540":123587,"_28300":123588,"_3066":123589},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3610":73703,"_31119":73700,"_5":31454,"_21540":123591,"_28300":123592,"_3066":123593},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3610":73704,"_31119":73700,"_5":31454,"_21540":123595,"_28300":123596,"_3066":123597},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3610":73705,"_31119":73700,"_5":31454,"_21540":123599,"_28300":123600,"_3066":123601},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3610":73706,"_31119":73700,"_5":31454,"_21540":123603,"_28300":123604,"_3066":123605},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3610":73707,"_31119":73700,"_21540":123607,"_5":14806,"_28300":73700,"_3066":123608},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3610":73708,"_31119":73700,"_21540":123610,"_5":14806,"_28300":123588,"_3066":123611},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3610":73709,"_31119":73700,"_21540":123613,"_5":14806,"_28300":123588,"_3066":123614},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3610":73710,"_31119":73700,"_21540":123616,"_5":14806,"_28300":123588,"_3066":123617},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3610":73711,"_31119":73700,"_21540":123619,"_5":14806,"_28300":123588,"_3066":123620},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3610":73712,"_31119":73700,"_21540":123622,"_5":14806,"_28300":123592,"_3066":123623},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3610":73713,"_31119":73700,"_21540":123625,"_5":14806,"_28300":123592,"_3066":123626},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3610":73714,"_31119":73700,"_21540":123628,"_5":14806,"_28300":123596,"_3066":123629},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3610":73715,"_31119":73700,"_21540":123631,"_5":14806,"_28300":123596,"_3066":123632},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3610":73716,"_31119":73700,"_21540":123634,"_5":14806,"_28300":123596,"_3066":123635},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3610":73717,"_31119":73700,"_21540":123637,"_5":14806,"_28300":123600,"_3066":123638},[],"Situación",{"_3610":73718,"_31119":73700,"_21540":123640,"_5":14806,"_28300":123600,"_3066":123641},[],"Procedimiento",{"_3610":73719,"_31119":73700,"_21540":123643,"_5":14806,"_28300":123600,"_3066":123644},[],"Certificado vigente, fuera de ventana",{"_3610":73720,"_31119":73700,"_21540":123646,"_5":14806,"_28300":123600,"_3066":123647},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3610":73721,"_31119":73700,"_21540":123649,"_5":14806,"_28300":123600,"_3066":123650},[],"Certificado vencido, clave disponible",{"_3610":73722,"_31119":73700,"_21540":123652,"_5":14806,"_28300":123600,"_3066":123653},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3610":73723,"_31119":73700,"_21540":123655,"_5":14806,"_28300":123600,"_3066":123656},[],"Renovación por webhook o `NO_AUTH`",{"_3610":73724,"_31119":73700,"_21540":123658,"_5":14806,"_28300":123600,"_3066":123659},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3610":73725,"_31119":73700,"_21540":123661,"_5":14806,"_28300":123600,"_3066":123662},[],"Clave perdida o inaccesible",{"_3610":73726,"_31119":73700,"_21540":123664,"_5":14806,"_28300":123600,"_3066":123665},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3610":73727,"_31119":73700,"_21540":123667,"_5":14806,"_28300":123600,"_3066":123668},[],"Identidad actual revocada",{"_3610":73728,"_31119":73700,"_21540":123670,"_5":14806,"_28300":123600,"_3066":123671},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3610":73729,"_31119":73700,"_21540":123673,"_5":14806,"_28300":123600,"_3066":123674},[],"Dispositivo sin identidad",{"_3610":73730,"_31119":73700,"_21540":123676,"_5":14806,"_28300":123600,"_3066":123677},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3610":73731,"_31119":73700,"_21540":123679,"_5":14806,"_28300":123600,"_3066":123680},[],"Dispositivo retirado",{"_3610":73732,"_31119":73700,"_21540":123682,"_5":14806,"_28300":123600,"_3066":123683},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3610":73733,"_31119":73700,"_21540":123685,"_5":14806,"_28300":123600,"_3066":123686},[],"Timeout, HTTP 500 o fallo de instalación",{"_3610":73734,"_31119":73700,"_21540":123688,"_5":14806,"_28300":123600,"_3066":123689},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3610":73735,"_31119":73700,"_21540":123691,"_5":14806,"_28300":123604,"_3066":123692},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3610":73736,"_31119":73700,"_21540":123694,"_5":14806,"_28300":123604,"_3066":123695},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3610":73737,"_31119":73737,"_5":15171,"_3066":123697,"_31457":123698,"_21540":123699,"_28300":73737},"Diagnóstico de enrolamiento",[50802,121414,53486,122559,122737],[],{"_3610":73738,"_31119":73737,"_21540":123701,"_5":14806,"_28300":73737,"_3066":123702},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3610":73739,"_31119":73737,"_5":31454,"_21540":123704,"_28300":123705,"_3066":123706},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3610":73740,"_31119":73737,"_5":31454,"_21540":123708,"_28300":123709,"_3066":123710},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3610":73741,"_31119":73737,"_5":31454,"_21540":123712,"_28300":123713,"_3066":123269},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3610":73742,"_31119":73737,"_5":31454,"_21540":123715,"_28300":123716,"_3066":123717},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3610":73743,"_31119":73737,"_21540":123719,"_5":14806,"_28300":73737,"_3066":123720},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3610":73744,"_31119":73737,"_21540":123722,"_5":14806,"_28300":123709,"_3066":123723},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3610":73745,"_31119":73737,"_21540":123725,"_5":14806,"_28300":123709,"_3066":123726},[],"Síntoma o mensaje",{"_3610":73746,"_31119":73737,"_21540":123728,"_5":14806,"_28300":123709,"_3066":123729},[],"Qué revisar",{"_3610":73747,"_31119":73737,"_21540":123731,"_5":14806,"_28300":123709,"_3066":123732},[],"curl rechaza TLS, nombre o emisor",{"_3610":73748,"_31119":73737,"_21540":123734,"_5":14806,"_28300":123709,"_3066":123735},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3610":73749,"_31119":73737,"_21540":123737,"_5":14806,"_28300":123709,"_3066":123738},[],"404 o APS ausente",{"_3610":73750,"_31119":73737,"_21540":123740,"_5":14806,"_28300":123709,"_3066":123741},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3610":73751,"_31119":73737,"_21540":123743,"_5":14806,"_28300":123709,"_3066":123744},[],"400, error de CSR o formato",{"_3610":73752,"_31119":73737,"_21540":123746,"_5":14806,"_28300":123709,"_3066":123747},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3610":73753,"_31119":73737,"_21540":123749,"_5":14806,"_28300":123709,"_3066":123750},[],"Credencial ausente o certificado no válido",{"_3610":73754,"_31119":73737,"_21540":123752,"_5":14806,"_28300":123709,"_3066":123753},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3610":73755,"_31119":73737,"_21540":123755,"_5":14806,"_28300":123709,"_3066":123756},[],"Webhook deniega, expira o responde sin autorización",{"_3610":73756,"_31119":73737,"_21540":123758,"_5":14806,"_28300":123709,"_3066":123759},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3610":73757,"_31119":73737,"_21540":123761,"_5":14806,"_28300":123709,"_3066":54734},[],{"_3610":73758,"_31119":73737,"_21540":123763,"_5":14806,"_28300":123709,"_3066":123764},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3610":73759,"_31119":73737,"_21540":123766,"_5":14806,"_28300":123709,"_3066":54740},[],{"_3610":73760,"_31119":73737,"_21540":123768,"_5":14806,"_28300":123709,"_3066":123769},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3610":73761,"_31119":73737,"_21540":123771,"_5":14806,"_28300":123709,"_3066":54746},[],{"_3610":73762,"_31119":73737,"_21540":123773,"_5":14806,"_28300":123709,"_3066":123774},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3610":73763,"_31119":73737,"_21540":123776,"_5":14806,"_28300":123709,"_3066":54752},[],{"_3610":73764,"_31119":73737,"_21540":123778,"_5":14806,"_28300":123709,"_3066":123779},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3610":73765,"_31119":73737,"_21540":123781,"_5":14806,"_28300":123709,"_3066":54758},[],{"_3610":73766,"_31119":73737,"_21540":123783,"_5":14806,"_28300":123709,"_3066":123784},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3610":73767,"_31119":73737,"_21540":123786,"_5":14806,"_28300":123709,"_3066":123787},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3610":73768,"_31119":73737,"_21540":123789,"_5":14806,"_28300":123709,"_3066":123790},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3610":73769,"_31119":73737,"_21540":123792,"_5":14806,"_28300":123709,"_3066":123793},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3610":73770,"_31119":73737,"_21540":123795,"_5":14806,"_28300":123709,"_3066":123796},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3610":73771,"_31119":73737,"_21540":123798,"_5":14806,"_28300":123709,"_3066":54776},[],{"_3610":73772,"_31119":73737,"_21540":123800,"_5":14806,"_28300":123709,"_3066":123801},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3610":73773,"_31119":73737,"_21540":123803,"_5":14806,"_28300":123709,"_3066":54782},[],{"_3610":73774,"_31119":73737,"_21540":123805,"_5":14806,"_28300":123709,"_3066":123806},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3610":73775,"_31119":73737,"_21540":123808,"_5":14806,"_28300":123709,"_3066":123809},[],"DMS propietario distinto",{"_3610":73776,"_31119":73737,"_21540":123811,"_5":14806,"_28300":123709,"_3066":123812},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3610":73777,"_31119":73737,"_21540":123814,"_5":14806,"_28300":123709,"_3066":54794},[],{"_3610":73778,"_31119":73737,"_21540":123816,"_5":14806,"_28300":123709,"_3066":123817},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3610":73779,"_31119":73737,"_21540":123819,"_5":14806,"_28300":123709,"_3066":54800},[],{"_3610":73780,"_31119":73737,"_21540":123821,"_5":14806,"_28300":123709,"_3066":123822},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3610":73781,"_31119":73737,"_21540":123824,"_5":14806,"_28300":123709,"_3066":123825},[],"Certificado actual revocado",{"_3610":73782,"_31119":73737,"_21540":123827,"_5":14806,"_28300":123709,"_3066":123828},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3610":73783,"_31119":73737,"_21540":123830,"_5":14806,"_28300":123709,"_3066":123831},[],"Error de CA, perfil o firma",{"_3610":73784,"_31119":73737,"_21540":123833,"_5":14806,"_28300":123709,"_3066":123834},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3610":73785,"_31119":73737,"_21540":123836,"_5":14806,"_28300":123709,"_3066":123837},[],"HTTP 200 sin conexión del dispositivo",{"_3610":73786,"_31119":73737,"_21540":123839,"_5":14806,"_28300":123709,"_3066":123840},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3610":73787,"_31119":73737,"_21540":123842,"_5":14806,"_28300":123709,"_3066":123843},[],"Timeout o error después de emitir",{"_3610":73788,"_31119":73737,"_21540":123845,"_5":14806,"_28300":123709,"_3066":123846},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3610":73789,"_31119":73737,"_21540":123848,"_5":14806,"_28300":123713,"_3066":123849},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3610":73790,"_31119":73737,"_21540":123851,"_5":14806,"_28300":123713,"_3066":123852},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3610":73791,"_31119":73737,"_21540":123854,"_5":14806,"_28300":123716,"_3066":123855},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3610":73792,"_31119":73737,"_21540":123857,"_5":14806,"_28300":123716,"_3066":123858},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3610":73793,"_31119":73737,"_21540":123860,"_5":14806,"_28300":123716,"_3066":123861},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3610":73794,"_31119":73737,"_21540":123863,"_5":14806,"_28300":123716,"_3066":123864},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3610":73795,"_31119":73737,"_21540":123866,"_5":14806,"_28300":123716,"_3066":123867},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3610":73796,"_31119":73737,"_21540":123869,"_5":14806,"_28300":123716,"_3066":123870},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3610":73797,"_31119":73737,"_21540":123872,"_5":14806,"_28300":123716,"_3066":123873},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3610":73798,"_31119":73798,"_5":15171,"_3066":123875,"_31457":123876,"_21540":123877,"_28300":73798},"Distribución y actualización de confianza",[50802,121414,53486,122559,122737],[],{"_3610":73799,"_31119":73798,"_21540":123879,"_5":14806,"_28300":73798,"_3066":123880},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3610":73800,"_31119":73798,"_5":31454,"_21540":123882,"_28300":123883,"_3066":123884},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3610":73801,"_31119":73798,"_5":31454,"_21540":123886,"_28300":123887,"_3066":123888},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3610":73802,"_31119":73798,"_5":31454,"_21540":123890,"_28300":123891,"_3066":123892},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3610":73803,"_31119":73798,"_5":31454,"_21540":123894,"_28300":123895,"_3066":123896},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3610":73804,"_31119":73798,"_5":31454,"_21540":123898,"_28300":123899,"_3066":123900},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3610":73805,"_31119":73798,"_21540":123902,"_5":14806,"_28300":73798,"_3066":123903},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3610":73806,"_31119":73798,"_21540":123905,"_5":14806,"_28300":123883,"_3066":123906},[],"Relación",{"_3610":73807,"_31119":73798,"_21540":123908,"_5":14806,"_28300":123883,"_3066":123909},[],"Material que prepara el responsable",{"_3610":73808,"_31119":73798,"_21540":123911,"_5":14806,"_28300":123883,"_3066":123912},[],"Dispositivo → servidor EST",{"_3610":73809,"_31119":73798,"_21540":123914,"_5":14806,"_28300":123883,"_3066":123915},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3610":73810,"_31119":73798,"_21540":123917,"_5":14806,"_28300":123883,"_3066":123918},[],"DMS → solicitante",{"_3610":73811,"_31119":73798,"_21540":123920,"_5":14806,"_28300":123883,"_3066":123921},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3610":73812,"_31119":73798,"_21540":123923,"_5":14806,"_28300":123883,"_3066":123924},[],"Consumidor → dispositivo",{"_3610":73813,"_31119":73798,"_21540":123926,"_5":14806,"_28300":123883,"_3066":123927},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3610":73814,"_31119":73798,"_21540":123929,"_5":14806,"_28300":123883,"_3066":123930},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3610":73815,"_31119":73798,"_21540":123932,"_5":14806,"_28300":123887,"_3066":123933},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3610":73816,"_31119":73798,"_21540":123935,"_5":14806,"_28300":123887,"_3066":123936},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3610":73817,"_31119":73798,"_21540":123938,"_5":14806,"_28300":123891,"_3066":123939},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3610":73818,"_31119":73798,"_21540":123941,"_5":14806,"_28300":123891,"_3066":123942},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3610":73819,"_31119":73798,"_21540":123944,"_5":14806,"_28300":123891,"_3066":123945},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3610":73820,"_31119":73798,"_21540":123947,"_5":14806,"_28300":123891,"_3066":123948},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3610":73821,"_31119":73798,"_21540":123950,"_5":14806,"_28300":123891,"_3066":123951},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3610":73822,"_31119":73798,"_21540":123953,"_5":14806,"_28300":123891,"_3066":123954},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3610":73823,"_31119":73798,"_21540":123956,"_5":14806,"_28300":123895,"_3066":123957},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3610":73824,"_31119":73798,"_21540":123959,"_5":14806,"_28300":123895,"_3066":123960},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3610":73825,"_31119":73798,"_21540":123962,"_5":14806,"_28300":123895,"_3066":123963},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3610":73826,"_31119":73798,"_21540":123965,"_5":14806,"_28300":123899,"_3066":123966},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3610":73827,"_31119":73827,"_5":15171,"_3066":54949,"_31457":123968,"_21540":123970,"_28300":73827},[50802,121414,53486,122559,123969],"Integraciones",[],{"_3610":73828,"_31119":73827,"_21540":123972,"_5":14806,"_28300":73827,"_3066":123973},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3610":73829,"_31119":73827,"_5":31454,"_21540":123975,"_28300":123976,"_3066":123977},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3610":73830,"_31119":73827,"_5":31454,"_21540":123979,"_28300":123980,"_3066":123981},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3610":73831,"_31119":73827,"_5":31454,"_21540":123983,"_28300":123984,"_3066":123985},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3610":73832,"_31119":73827,"_5":31454,"_21540":123987,"_28300":123988,"_3066":123989},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3610":73833,"_31119":73827,"_5":31454,"_21540":123991,"_28300":123992,"_3066":123993},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3610":73834,"_31119":73827,"_5":31454,"_21540":123995,"_28300":123996,"_3066":123997},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3610":73835,"_31119":73827,"_5":31454,"_21540":123999,"_28300":124000,"_3066":124001},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3610":73836,"_31119":73827,"_5":31454,"_21540":124003,"_28300":124004,"_3066":124005},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3610":73837,"_31119":73827,"_5":31454,"_21540":124007,"_28300":124008,"_3066":54991},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3610":73838,"_31119":73827,"_5":31454,"_21540":124010,"_28300":124011,"_3066":54995},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3610":73839,"_31119":73827,"_5":31454,"_21540":124013,"_28300":124014,"_3066":124015},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3610":73840,"_31119":73827,"_5":31454,"_21540":124017,"_28300":124018,"_3066":124019},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3610":73841,"_31119":73827,"_5":31454,"_21540":124021,"_28300":124022,"_3066":124023},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3610":73842,"_31119":73827,"_5":31454,"_21540":124025,"_28300":124026,"_3066":124027},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3610":73843,"_31119":73827,"_5":31454,"_21540":124029,"_28300":124030,"_3066":124031},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3610":73844,"_31119":73827,"_5":31454,"_21540":124033,"_28300":124034,"_3066":124035},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3610":73845,"_31119":73827,"_5":31454,"_21540":124037,"_28300":124038,"_3066":124039},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3610":73846,"_31119":73827,"_5":31454,"_21540":124041,"_28300":124042,"_3066":124043},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3610":73847,"_31119":73827,"_5":31454,"_21540":124045,"_28300":124046,"_3066":124047},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3610":73848,"_31119":73827,"_5":31454,"_21540":124049,"_28300":124050,"_3066":124051},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3610":73849,"_31119":73827,"_5":31454,"_21540":124053,"_28300":124054,"_3066":124055},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3610":73850,"_31119":73827,"_5":31454,"_21540":124057,"_28300":124058,"_3066":124059},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3610":73851,"_31119":73827,"_5":31454,"_21540":124061,"_28300":124062,"_3066":124063},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3610":73852,"_31119":73827,"_5":31454,"_21540":124065,"_28300":124066,"_3066":124067},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3610":73853,"_31119":73827,"_5":31454,"_21540":124069,"_28300":124070,"_3066":124071},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3610":73854,"_31119":73827,"_21540":124073,"_5":14806,"_28300":73827,"_3066":124074},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3610":73855,"_31119":73827,"_21540":124076,"_5":14806,"_28300":73827,"_3066":124077},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3610":73856,"_31119":73827,"_21540":124079,"_5":14806,"_28300":73827,"_3066":124080},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3610":73857,"_31119":73827,"_21540":124082,"_5":14806,"_28300":123976,"_3066":124083},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3610":73858,"_31119":73827,"_21540":124085,"_5":14806,"_28300":123976,"_3066":124086},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3610":73859,"_31119":73827,"_21540":124088,"_5":14806,"_28300":123976,"_3066":124089},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3610":73860,"_31119":73827,"_21540":124091,"_5":14806,"_28300":123976,"_3066":124092},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3610":73861,"_31119":73827,"_21540":124094,"_5":14806,"_28300":123980,"_3066":124095},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3610":73862,"_31119":73827,"_21540":124097,"_5":14806,"_28300":123984,"_3066":124098},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3610":73863,"_31119":73827,"_21540":124100,"_5":14806,"_28300":123984,"_3066":124101},[],"Acción IAM",{"_3610":73864,"_31119":73827,"_21540":124103,"_5":14806,"_28300":123984,"_3066":120318},[],{"_3610":73865,"_31119":73827,"_21540":124105,"_5":14806,"_28300":123984,"_3066":55090},[],{"_3610":73866,"_31119":73827,"_21540":124107,"_5":14806,"_28300":123984,"_3066":124108},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3610":73867,"_31119":73827,"_21540":124110,"_5":14806,"_28300":123984,"_3066":55096},[],{"_3610":73868,"_31119":73827,"_21540":124112,"_5":14806,"_28300":123984,"_3066":124113},[],"Registrar la CA en AWS IoT",{"_3610":73869,"_31119":73827,"_21540":124115,"_5":14806,"_28300":123984,"_3066":55102},[],{"_3610":73870,"_31119":73827,"_21540":124117,"_5":14806,"_28300":123984,"_3066":124118},[],"Consultar el estado del registro de la CA",{"_3610":73871,"_31119":73827,"_21540":124120,"_5":14806,"_28300":123984,"_3066":55108},[],{"_3610":73872,"_31119":73827,"_21540":124122,"_5":14806,"_28300":123984,"_3066":124123},[],"Crear o actualizar Things en IoT Core",{"_3610":73873,"_31119":73827,"_21540":124125,"_5":14806,"_28300":123984,"_3066":55114},[],{"_3610":73874,"_31119":73827,"_21540":124127,"_5":14806,"_28300":123984,"_3066":124128},[],"Aprovisionar Things mediante plantilla",{"_3610":73875,"_31119":73827,"_21540":124130,"_5":14806,"_28300":123984,"_3066":55120},[],{"_3610":73876,"_31119":73827,"_21540":124132,"_5":14806,"_28300":123984,"_3066":124133},[],"Registrar certificados de dispositivo",{"_3610":73877,"_31119":73827,"_21540":124135,"_5":14806,"_28300":123984,"_3066":55126},[],{"_3610":73878,"_31119":73827,"_21540":124137,"_5":14806,"_28300":123984,"_3066":124138},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3610":73879,"_31119":73827,"_21540":124140,"_5":14806,"_28300":123984,"_3066":55132},[],{"_3610":73880,"_31119":73827,"_21540":124142,"_5":14806,"_28300":123984,"_3066":124143},[],"Crear y adjuntar políticas IoT",{"_3610":73881,"_31119":73827,"_21540":124145,"_5":14806,"_28300":123984,"_3066":55138},[],{"_3610":73882,"_31119":73827,"_21540":124147,"_5":14806,"_28300":123984,"_3066":124148},[],"Gestionar grupos de Things",{"_3610":73883,"_31119":73827,"_21540":124150,"_5":14806,"_28300":123984,"_3066":55144},[],{"_3610":73884,"_31119":73827,"_21540":124152,"_5":14806,"_28300":123984,"_3066":124153},[],"Crear plantillas JITP",{"_3610":73885,"_31119":73827,"_21540":124155,"_5":14806,"_28300":123984,"_3066":55150},[],{"_3610":73886,"_31119":73827,"_21540":124157,"_5":14806,"_28300":123984,"_3066":124158},[],"Leer y escribir el Device Shadow",{"_3610":73887,"_31119":73827,"_21540":124160,"_5":14806,"_28300":123984,"_3066":124161},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3610":73888,"_31119":73827,"_21540":124163,"_5":14806,"_28300":123988,"_3066":124164},[],"Parámetro",{"_3610":73889,"_31119":73827,"_21540":124166,"_5":14806,"_28300":123988,"_3066":124167},[],"Tipo",{"_3610":73890,"_31119":73827,"_21540":124169,"_5":14806,"_28300":123988,"_3066":124170},[],"Requerido",{"_3610":73891,"_31119":73827,"_21540":124172,"_5":14806,"_28300":123988,"_3066":124173},[],"Descripción",{"_3610":73892,"_31119":73827,"_21540":124175,"_5":14806,"_28300":123988,"_3066":55171},[],{"_3610":73893,"_31119":73827,"_21540":124177,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73894,"_31119":73827,"_21540":124179,"_5":14806,"_28300":123988,"_3066":124180},[],"Sí",{"_3610":73895,"_31119":73827,"_21540":124182,"_5":14806,"_28300":123988,"_3066":124183},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3610":73896,"_31119":73827,"_21540":124185,"_5":14806,"_28300":123988,"_3066":55182},[],{"_3610":73897,"_31119":73827,"_21540":124187,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73898,"_31119":73827,"_21540":124189,"_5":14806,"_28300":123988,"_3066":124180},[],{"_3610":73899,"_31119":73827,"_21540":124191,"_5":14806,"_28300":123988,"_3066":124192},[],"Región AWS donde opera el conector.",{"_3610":73900,"_31119":73827,"_21540":124194,"_5":14806,"_28300":123988,"_3066":55192},[],{"_3610":73901,"_31119":73827,"_21540":124196,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73902,"_31119":73827,"_21540":124198,"_5":14806,"_28300":123988,"_3066":124180},[],{"_3610":73903,"_31119":73827,"_21540":124200,"_5":14806,"_28300":123988,"_3066":124201},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3610":73904,"_31119":73827,"_21540":124203,"_5":14806,"_28300":123988,"_3066":55202},[],{"_3610":73905,"_31119":73827,"_21540":124205,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73906,"_31119":73827,"_21540":124207,"_5":14806,"_28300":123988,"_3066":124208},[],"Solo con `auth_method=static`",{"_3610":73907,"_31119":73827,"_21540":124210,"_5":14806,"_28300":123988,"_3066":124211},[],"Clave de acceso AWS.",{"_3610":73908,"_31119":73827,"_21540":124213,"_5":14806,"_28300":123988,"_3066":55213},[],{"_3610":73909,"_31119":73827,"_21540":124215,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73910,"_31119":73827,"_21540":124217,"_5":14806,"_28300":123988,"_3066":124208},[],{"_3610":73911,"_31119":73827,"_21540":124219,"_5":14806,"_28300":123988,"_3066":124220},[],"Clave secreta AWS.",{"_3610":73912,"_31119":73827,"_21540":124222,"_5":14806,"_28300":123988,"_3066":55223},[],{"_3610":73913,"_31119":73827,"_21540":124224,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73914,"_31119":73827,"_21540":124226,"_5":14806,"_28300":123988,"_3066":55228},[],{"_3610":73915,"_31119":73827,"_21540":124228,"_5":14806,"_28300":123988,"_3066":124229},[],"Token de sesión (con `auth_method=static`).",{"_3610":73916,"_31119":73827,"_21540":124231,"_5":14806,"_28300":123988,"_3066":55234},[],{"_3610":73917,"_31119":73827,"_21540":124233,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73918,"_31119":73827,"_21540":124235,"_5":14806,"_28300":123988,"_3066":124236},[],"Solo con `auth_method=role`",{"_3610":73919,"_31119":73827,"_21540":124238,"_5":14806,"_28300":123988,"_3066":124239},[],"ARN del rol a asumir.",{"_3610":73920,"_31119":73827,"_21540":124241,"_5":14806,"_28300":123988,"_3066":55245},[],{"_3610":73921,"_31119":73827,"_21540":124243,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73922,"_31119":73827,"_21540":124245,"_5":14806,"_28300":123988,"_3066":55228},[],{"_3610":73923,"_31119":73827,"_21540":124247,"_5":14806,"_28300":123988,"_3066":124248},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3610":73924,"_31119":73827,"_21540":124250,"_5":14806,"_28300":123988,"_3066":55255},[],{"_3610":73925,"_31119":73827,"_21540":124252,"_5":14806,"_28300":123988,"_3066":92628},[],{"_3610":73926,"_31119":73827,"_21540":124254,"_5":14806,"_28300":123988,"_3066":124180},[],{"_3610":73927,"_31119":73827,"_21540":124256,"_5":14806,"_28300":123988,"_3066":124257},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3610":73928,"_31119":73827,"_21540":124259,"_5":14806,"_28300":123988,"_3066":55265},[],{"_3610":73929,"_31119":73827,"_21540":124261,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73930,"_31119":73827,"_21540":124263,"_5":14806,"_28300":123988,"_3066":124180},[],{"_3610":73931,"_31119":73827,"_21540":124265,"_5":14806,"_28300":123988,"_3066":124266},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3610":73932,"_31119":73827,"_21540":124268,"_5":14806,"_28300":123988,"_3066":55275},[],{"_3610":73933,"_31119":73827,"_21540":124270,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73934,"_31119":73827,"_21540":124272,"_5":14806,"_28300":123988,"_3066":124180},[],{"_3610":73935,"_31119":73827,"_21540":124274,"_5":14806,"_28300":123988,"_3066":124275},[],"URL HTTP del Device Manager de Lamassu.",{"_3610":73936,"_31119":73827,"_21540":124277,"_5":14806,"_28300":123988,"_3066":55285},[],{"_3610":73937,"_31119":73827,"_21540":124279,"_5":14806,"_28300":123988,"_3066":25720},[],{"_3610":73938,"_31119":73827,"_21540":124281,"_5":14806,"_28300":123988,"_3066":124180},[],{"_3610":73939,"_31119":73827,"_21540":124283,"_5":14806,"_28300":123988,"_3066":124284},[],"URL HTTP del servicio de CA de Lamassu.",{"_3610":73940,"_31119":73827,"_21540":124286,"_5":14806,"_28300":123992,"_3066":124287},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3610":73941,"_31119":73827,"_21540":124289,"_5":14806,"_28300":123992,"_3066":124290},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3610":73942,"_31119":73827,"_21540":124292,"_5":14806,"_28300":123992,"_3066":124293},[],"Tipo de CloudEvent",{"_3610":73943,"_31119":73827,"_21540":124295,"_5":14806,"_28300":123992,"_3066":124296},[],"Recurso en Lamassu",{"_3610":73944,"_31119":73827,"_21540":124298,"_5":14806,"_28300":123992,"_3066":124299},[],"Recurso AWS",{"_3610":73945,"_31119":73827,"_21540":124301,"_5":14806,"_28300":123992,"_3066":124302},[],"Acciones IAM",{"_3610":73946,"_31119":73827,"_21540":124304,"_5":14806,"_28300":123992,"_3066":124305},[],"Llamadas AWS y efecto",{"_3610":73947,"_31119":73827,"_21540":124307,"_5":14806,"_28300":123992,"_3066":124308},[],"Dónde en esta página",{"_3610":73948,"_31119":73827,"_21540":124310,"_5":14806,"_28300":123992,"_3066":55319},[],{"_3610":73949,"_31119":73827,"_21540":124312,"_5":14806,"_28300":123992,"_3066":55322},[],{"_3610":73950,"_31119":73827,"_21540":124314,"_5":14806,"_28300":123992,"_3066":55325},[],{"_3610":73951,"_31119":73827,"_21540":124316,"_5":14806,"_28300":123992,"_3066":55328},[],{"_3610":73952,"_31119":73827,"_21540":124318,"_5":14806,"_28300":123992,"_3066":124319},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3610":73953,"_31119":73827,"_21540":124321,"_5":14806,"_28300":123992,"_3066":124005},[],{"_3610":73954,"_31119":73827,"_21540":124323,"_5":14806,"_28300":123992,"_3066":55336},[],{"_3610":73955,"_31119":73827,"_21540":124325,"_5":14806,"_28300":123992,"_3066":55339},[],{"_3610":73956,"_31119":73827,"_21540":124327,"_5":14806,"_28300":123992,"_3066":55342},[],{"_3610":73957,"_31119":73827,"_21540":124329,"_5":14806,"_28300":123992,"_3066":55345},[],{"_3610":73958,"_31119":73827,"_21540":124331,"_5":14806,"_28300":123992,"_3066":124332},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3610":73959,"_31119":73827,"_21540":124334,"_5":14806,"_28300":123992,"_3066":124031},[],{"_3610":73960,"_31119":73827,"_21540":124336,"_5":14806,"_28300":123992,"_3066":55353},[],{"_3610":73961,"_31119":73827,"_21540":124338,"_5":14806,"_28300":123992,"_3066":124339},[],"Dispositivo",{"_3610":73962,"_31119":73827,"_21540":124341,"_5":14806,"_28300":123992,"_3066":55359},[],{"_3610":73963,"_31119":73827,"_21540":124343,"_5":14806,"_28300":123992,"_3066":55362},[],{"_3610":73964,"_31119":73827,"_21540":124345,"_5":14806,"_28300":123992,"_3066":124346},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3610":73965,"_31119":73827,"_21540":124348,"_5":14806,"_28300":123992,"_3066":124039},[],{"_3610":73966,"_31119":73827,"_21540":124350,"_5":14806,"_28300":123992,"_3066":55370},[],{"_3610":73967,"_31119":73827,"_21540":124352,"_5":14806,"_28300":123992,"_3066":124353},[],"Certificado",{"_3610":73968,"_31119":73827,"_21540":124355,"_5":14806,"_28300":123992,"_3066":55376},[],{"_3610":73969,"_31119":73827,"_21540":124357,"_5":14806,"_28300":123992,"_3066":124358},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3610":73970,"_31119":73827,"_21540":124360,"_5":14806,"_28300":123992,"_3066":124361},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3610":73971,"_31119":73827,"_21540":124363,"_5":14806,"_28300":123992,"_3066":124051},[],{"_3610":73972,"_31119":73827,"_21540":124365,"_5":14806,"_28300":123992,"_3066":55387},[],{"_3610":73973,"_31119":73827,"_21540":124367,"_5":14806,"_28300":123992,"_3066":124368},[],"Certificado / Dispositivo",{"_3610":73974,"_31119":73827,"_21540":124370,"_5":14806,"_28300":123992,"_3066":55393},[],{"_3610":73975,"_31119":73827,"_21540":124372,"_5":14806,"_28300":123992,"_3066":51198},[],{"_3610":73976,"_31119":73827,"_21540":124374,"_5":14806,"_28300":123992,"_3066":124375},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3610":73977,"_31119":73827,"_21540":124377,"_5":14806,"_28300":123992,"_3066":124059},[],{"_3610":73978,"_31119":73827,"_21540":124379,"_5":14806,"_28300":123996,"_3066":124380},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3610":73979,"_31119":73827,"_21540":124382,"_5":14806,"_28300":124000,"_3066":124383},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3610":73980,"_31119":73827,"_21540":124385,"_5":14806,"_28300":124000,"_3066":124386},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3610":73981,"_31119":73827,"_21540":124388,"_5":14806,"_28300":124004,"_3066":124389},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3610":73982,"_31119":73827,"_21540":124391,"_5":14806,"_28300":124004,"_3066":124392},[],"Transición",{"_3610":73983,"_31119":73827,"_21540":124394,"_5":14806,"_28300":124004,"_3066":124395},[],"Llamadas AWS",{"_3610":73984,"_31119":73827,"_21540":124397,"_5":14806,"_28300":124004,"_3066":124398},[],"`NoRegistrada` → `Solicitada`",{"_3610":73985,"_31119":73827,"_21540":124400,"_5":14806,"_28300":124004,"_3066":124401},[],"ninguna (solo escritura de metadatos)",{"_3610":73986,"_31119":73827,"_21540":124403,"_5":14806,"_28300":124004,"_3066":124404},[],"`Solicitada` → `Registrando`",{"_3610":73987,"_31119":73827,"_21540":124406,"_5":14806,"_28300":124004,"_3066":124407},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3610":73988,"_31119":73827,"_21540":124409,"_5":14806,"_28300":124004,"_3066":124410},[],"`Registrando` → `Completada`",{"_3610":73989,"_31119":73827,"_21540":124412,"_5":14806,"_28300":124004,"_3066":124413},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3610":73990,"_31119":73827,"_21540":124415,"_5":14806,"_28300":124004,"_3066":124416},[],"`Registrando` → `Fallida`",{"_3610":73991,"_31119":73827,"_21540":124418,"_5":14806,"_28300":124004,"_3066":124419},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3610":73992,"_31119":73827,"_21540":124421,"_5":14806,"_28300":124004,"_3066":124422},[],"`Fallida` / `Completada` → `Solicitada`",{"_3610":73993,"_31119":73827,"_21540":124424,"_5":14806,"_28300":124004,"_3066":124425},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3610":73994,"_31119":73827,"_21540":124427,"_5":14806,"_28300":124008,"_3066":124428},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3610":73995,"_31119":73827,"_21540":124430,"_5":14806,"_28300":124008,"_3066":124431},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3610":73996,"_31119":73827,"_21540":124433,"_5":14806,"_28300":124008,"_3066":124434},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3610":73997,"_31119":73827,"_21540":124436,"_5":14806,"_28300":124008,"_3066":124437},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3610":73998,"_31119":73827,"_21540":124439,"_5":14806,"_28300":124008,"_3066":124440},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3610":73999,"_31119":73827,"_21540":124442,"_5":14806,"_28300":124008,"_3066":124443},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3610":74000,"_31119":73827,"_21540":124445,"_5":14806,"_28300":124011,"_3066":124446},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3610":74001,"_31119":73827,"_21540":124448,"_5":14806,"_28300":124014,"_3066":124449},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3610":74002,"_31119":73827,"_21540":124451,"_5":14806,"_28300":124014,"_3066":124452},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3610":74003,"_31119":73827,"_21540":124454,"_5":14806,"_28300":124018,"_3066":124455},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3610":74004,"_31119":73827,"_21540":124457,"_5":14806,"_28300":124022,"_3066":124458},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3610":74005,"_31119":73827,"_21540":124460,"_5":14806,"_28300":124022,"_3066":124461},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3610":74006,"_31119":73827,"_21540":124463,"_5":14806,"_28300":124022,"_3066":124464},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3610":74007,"_31119":73827,"_21540":124466,"_5":14806,"_28300":124022,"_3066":124467},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3610":74008,"_31119":73827,"_21540":124469,"_5":14806,"_28300":124022,"_3066":124470},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3610":74009,"_31119":73827,"_21540":124472,"_5":14806,"_28300":124022,"_3066":124473},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3610":74010,"_31119":73827,"_21540":124475,"_5":14806,"_28300":124026,"_3066":124476},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3610":74011,"_31119":73827,"_21540":124478,"_5":14806,"_28300":124026,"_3066":124479},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3610":74012,"_31119":73827,"_21540":124481,"_5":14806,"_28300":124026,"_3066":124482},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3610":74013,"_31119":73827,"_21540":124484,"_5":14806,"_28300":124026,"_3066":124485},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3610":74014,"_31119":73827,"_21540":124487,"_5":14806,"_28300":124026,"_3066":124488},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3610":74015,"_31119":73827,"_21540":124490,"_5":14806,"_28300":124030,"_3066":124491},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3610":74016,"_31119":73827,"_21540":124493,"_5":14806,"_28300":124030,"_3066":124392},[],{"_3610":74017,"_31119":73827,"_21540":124495,"_5":14806,"_28300":124030,"_3066":124395},[],{"_3610":74018,"_31119":73827,"_21540":124497,"_5":14806,"_28300":124030,"_3066":124498},[],"`SinConfigurar` → `None` / `Auto`",{"_3610":74019,"_31119":73827,"_21540":124500,"_5":14806,"_28300":124030,"_3066":124501},[],"ninguna (solo configuración)",{"_3610":74020,"_31119":73827,"_21540":124503,"_5":14806,"_28300":124030,"_3066":55530},[],{"_3610":74021,"_31119":73827,"_21540":124505,"_5":14806,"_28300":124030,"_3066":124501},[],{"_3610":74022,"_31119":73827,"_21540":124507,"_5":14806,"_28300":124030,"_3066":124508},[],"Cualquiera → `Jitp`",{"_3610":74023,"_31119":73827,"_21540":124510,"_5":14806,"_28300":124030,"_3066":124511},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3610":74024,"_31119":73827,"_21540":124513,"_5":14806,"_28300":124030,"_3066":55541},[],{"_3610":74025,"_31119":73827,"_21540":124515,"_5":14806,"_28300":124030,"_3066":124516},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3610":74026,"_31119":73827,"_21540":124518,"_5":14806,"_28300":124034,"_3066":124519},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3610":74027,"_31119":73827,"_21540":124521,"_5":14806,"_28300":124034,"_3066":124522},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3610":74028,"_31119":73827,"_21540":124524,"_5":14806,"_28300":124034,"_3066":124525},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3610":74029,"_31119":73827,"_21540":124527,"_5":14806,"_28300":124038,"_3066":124528},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3610":74030,"_31119":73827,"_21540":124530,"_5":14806,"_28300":124038,"_3066":124392},[],{"_3610":74031,"_31119":73827,"_21540":124532,"_5":14806,"_28300":124038,"_3066":124395},[],{"_3610":74032,"_31119":73827,"_21540":124534,"_5":14806,"_28300":124038,"_3066":124535},[],"`Ausente` → `Aprovisionado`",{"_3610":74033,"_31119":73827,"_21540":124537,"_5":14806,"_28300":124038,"_3066":124538},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3610":74034,"_31119":73827,"_21540":124540,"_5":14806,"_28300":124038,"_3066":124541},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3610":74035,"_31119":73827,"_21540":124543,"_5":14806,"_28300":124038,"_3066":124544},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3610":74036,"_31119":73827,"_21540":124546,"_5":14806,"_28300":124038,"_3066":124547},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3610":74037,"_31119":73827,"_21540":124549,"_5":14806,"_28300":124042,"_3066":124550},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3610":74038,"_31119":73827,"_21540":124552,"_5":14806,"_28300":124042,"_3066":124553},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3610":74039,"_31119":73827,"_21540":124555,"_5":14806,"_28300":124042,"_3066":124556},[],"Para que el flujo JITP funcione correctamente:",{"_3610":74040,"_31119":73827,"_21540":124558,"_5":14806,"_28300":124042,"_3066":124559},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3610":74041,"_31119":73827,"_21540":124561,"_5":14806,"_28300":124042,"_3066":124562},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3610":74042,"_31119":73827,"_21540":124564,"_5":14806,"_28300":124042,"_3066":124565},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3610":74043,"_31119":73827,"_21540":124567,"_5":14806,"_28300":124042,"_3066":124568},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3610":74044,"_31119":73827,"_21540":124570,"_5":14806,"_28300":124046,"_3066":124571},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3610":74045,"_31119":73827,"_21540":124573,"_5":14806,"_28300":124046,"_3066":124574},[],"Estado en Lamassu",{"_3610":74046,"_31119":73827,"_21540":124576,"_5":14806,"_28300":124046,"_3066":124577},[],"Razón de revocación",{"_3610":74047,"_31119":73827,"_21540":124579,"_5":14806,"_28300":124046,"_3066":124580},[],"Estado en AWS IoT Core",{"_3610":74048,"_31119":73827,"_21540":124582,"_5":14806,"_28300":124046,"_3066":55611},[],{"_3610":74049,"_31119":73827,"_21540":124584,"_5":14806,"_28300":124046,"_3066":124585},[],"Ninguna",{"_3610":74050,"_31119":73827,"_21540":124587,"_5":14806,"_28300":124046,"_3066":55617},[],{"_3610":74051,"_31119":73827,"_21540":124589,"_5":14806,"_28300":124046,"_3066":55620},[],{"_3610":74052,"_31119":73827,"_21540":124591,"_5":14806,"_28300":124046,"_3066":55623},[],{"_3610":74053,"_31119":73827,"_21540":124593,"_5":14806,"_28300":124046,"_3066":55626},[],{"_3610":74054,"_31119":73827,"_21540":124595,"_5":14806,"_28300":124046,"_3066":55620},[],{"_3610":74055,"_31119":73827,"_21540":124597,"_5":14806,"_28300":124046,"_3066":124598},[],"Cualquier otra razón",{"_3610":74056,"_31119":73827,"_21540":124600,"_5":14806,"_28300":124046,"_3066":55634},[],{"_3610":74057,"_31119":73827,"_21540":124602,"_5":14806,"_28300":124046,"_3066":124603},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3610":74058,"_31119":73827,"_21540":124605,"_5":14806,"_28300":124050,"_3066":124606},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3610":74059,"_31119":73827,"_21540":124608,"_5":14806,"_28300":124050,"_3066":124392},[],{"_3610":74060,"_31119":73827,"_21540":124610,"_5":14806,"_28300":124050,"_3066":124395},[],{"_3610":74061,"_31119":73827,"_21540":124612,"_5":14806,"_28300":124050,"_3066":124613},[],"`NoSincronizado` → `Active`",{"_3610":74062,"_31119":73827,"_21540":124615,"_5":14806,"_28300":124050,"_3066":55126},[],{"_3610":74063,"_31119":73827,"_21540":124617,"_5":14806,"_28300":124050,"_3066":55652},[],{"_3610":74064,"_31119":73827,"_21540":124619,"_5":14806,"_28300":124050,"_3066":124620},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3610":74065,"_31119":73827,"_21540":124622,"_5":14806,"_28300":124050,"_3066":55658},[],{"_3610":74066,"_31119":73827,"_21540":124624,"_5":14806,"_28300":124050,"_3066":124620},[],{"_3610":74067,"_31119":73827,"_21540":124626,"_5":14806,"_28300":124050,"_3066":55663},[],{"_3610":74068,"_31119":73827,"_21540":124628,"_5":14806,"_28300":124050,"_3066":55126},[],{"_3610":74069,"_31119":73827,"_21540":124630,"_5":14806,"_28300":124050,"_3066":55668},[],{"_3610":74070,"_31119":73827,"_21540":124632,"_5":14806,"_28300":124050,"_3066":124633},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3610":74071,"_31119":73827,"_21540":124635,"_5":14806,"_28300":124054,"_3066":124636},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3610":74072,"_31119":73827,"_21540":124638,"_5":14806,"_28300":124054,"_3066":124639},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3610":74073,"_31119":73827,"_21540":124641,"_5":14806,"_28300":124054,"_3066":124642},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3610":74074,"_31119":73827,"_21540":124644,"_5":14806,"_28300":124058,"_3066":124645},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3610":74075,"_31119":73827,"_21540":124647,"_5":14806,"_28300":124058,"_3066":124648},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3610":74076,"_31119":73827,"_21540":124650,"_5":14806,"_28300":124062,"_3066":124651},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3610":74077,"_31119":73827,"_21540":124653,"_5":14806,"_28300":124062,"_3066":124654},[],"Existen dos tipos de acciones:",{"_3610":74078,"_31119":73827,"_21540":124656,"_5":14806,"_28300":124062,"_3066":124657},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3610":74079,"_31119":73827,"_21540":124659,"_5":14806,"_28300":124062,"_3066":124660},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3610":74080,"_31119":73827,"_21540":124662,"_5":14806,"_28300":124062,"_3066":124663},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3610":74081,"_31119":73827,"_21540":124665,"_5":14806,"_28300":124066,"_3066":124666},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3610":74082,"_31119":73827,"_21540":124668,"_5":14806,"_28300":124066,"_3066":124669},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3610":74083,"_31119":73827,"_21540":124671,"_5":14806,"_28300":124066,"_3066":124672},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3610":74084,"_31119":73827,"_21540":124674,"_5":14806,"_28300":124070,"_3066":124675},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3610":74085,"_31119":73827,"_21540":124677,"_5":14806,"_28300":124070,"_3066":124678},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3610":74086,"_31119":73827,"_21540":124680,"_5":14806,"_28300":124070,"_3066":124681},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3610":74087,"_31119":73827,"_21540":124683,"_5":14806,"_28300":124070,"_3066":124684},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3610":74088,"_31119":73827,"_21540":124686,"_5":14806,"_28300":124070,"_3066":124687},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3610":74089,"_31119":73827,"_21540":124689,"_5":14806,"_28300":124070,"_3066":124690},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3610":74090,"_31119":73827,"_21540":124692,"_5":14806,"_28300":124070,"_3066":124693},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3610":74091,"_31119":73827,"_21540":124695,"_5":14806,"_28300":124070,"_3066":124696},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3610":74092,"_31119":73827,"_21540":124698,"_5":14806,"_28300":124070,"_3066":124699},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3610":74093,"_31119":73827,"_21540":124701,"_5":14806,"_28300":124070,"_3066":124702},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3610":74094,"_31119":73827,"_21540":124704,"_5":14806,"_28300":124070,"_3066":124705},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3610":74095,"_31119":73827,"_21540":124707,"_5":14806,"_28300":124070,"_3066":124708},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3610":74096,"_31119":73827,"_21540":124710,"_5":14806,"_28300":124070,"_3066":124711},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3610":74097,"_31119":73827,"_21540":124713,"_5":14806,"_28300":124070,"_3066":124714},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3610":74098,"_31119":73827,"_21540":124716,"_5":14806,"_28300":124070,"_3066":124717},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3610":74099,"_31119":73827,"_21540":124719,"_5":14806,"_28300":124070,"_3066":124720},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3610":74100,"_31119":73827,"_21540":124722,"_5":14806,"_28300":124070,"_3066":124723},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3610":74101,"_31119":73827,"_21540":124725,"_5":14806,"_28300":124070,"_3066":124726},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3610":74102,"_31119":73827,"_21540":124728,"_5":14806,"_28300":124070,"_3066":124729},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3610":74103,"_31119":73827,"_21540":124731,"_5":14806,"_28300":124070,"_3066":124732},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3610":74104,"_31119":73827,"_21540":124734,"_5":14806,"_28300":124070,"_3066":124735},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3610":74105,"_31119":73827,"_21540":124737,"_5":14806,"_28300":124070,"_3066":124738},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3610":74106,"_31119":73827,"_21540":124740,"_5":14806,"_28300":124070,"_3066":124741},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3610":74107,"_31119":73827,"_21540":124743,"_5":14806,"_28300":124070,"_3066":124744},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3610":74108,"_31119":74108,"_5":15171,"_3066":53486,"_31457":124746,"_21540":124747,"_28300":74108},[50802,121414,53486],[],{"_3610":74109,"_31119":74108,"_21540":124749,"_5":14806,"_28300":74108,"_3066":124750},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3610":74110,"_31119":74108,"_5":31454,"_21540":124752,"_28300":124753,"_3066":124754},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3610":74111,"_31119":74108,"_5":31454,"_21540":124756,"_28300":124757,"_3066":122559},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3610":74112,"_31119":74108,"_5":31454,"_21540":124759,"_28300":124760,"_3066":122737},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3610":74113,"_31119":74108,"_5":31454,"_21540":124762,"_28300":124763,"_3066":123969},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3610":74114,"_31119":74108,"_5":31454,"_21540":124765,"_28300":124766,"_3066":124767},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3610":74115,"_31119":74108,"_21540":124769,"_5":14806,"_28300":74108,"_3066":124770},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3610":74116,"_31119":74108,"_21540":124772,"_5":14806,"_28300":124753,"_3066":124773},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3610":74117,"_31119":74108,"_21540":124775,"_5":14806,"_28300":124753,"_3066":124776},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3610":74118,"_31119":74108,"_21540":124778,"_5":14806,"_28300":124757,"_3066":124779},[],"Recurso",{"_3610":74119,"_31119":74108,"_21540":124781,"_5":14806,"_28300":124757,"_3066":124782},[],"Qué representa",{"_3610":74120,"_31119":74108,"_21540":124784,"_5":14806,"_28300":124757,"_3066":124785},[],"**Dispositivo**",{"_3610":74121,"_31119":74108,"_21540":124787,"_5":14806,"_28300":124757,"_3066":124788},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3610":74122,"_31119":74108,"_21540":124790,"_5":14806,"_28300":124757,"_3066":124791},[],"**Identidad**",{"_3610":74123,"_31119":74108,"_21540":124793,"_5":14806,"_28300":124757,"_3066":124794},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3610":74124,"_31119":74108,"_21540":124796,"_5":14806,"_28300":124757,"_3066":55835},[],{"_3610":74125,"_31119":74108,"_21540":124798,"_5":14806,"_28300":124757,"_3066":124799},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3610":74126,"_31119":74108,"_21540":124801,"_5":14806,"_28300":124757,"_3066":124802},[],"**Flota**",{"_3610":74127,"_31119":74108,"_21540":124804,"_5":14806,"_28300":124757,"_3066":124805},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3610":74128,"_31119":74108,"_21540":124807,"_5":14806,"_28300":124757,"_3066":124808},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3610":74129,"_31119":74108,"_21540":124810,"_5":14806,"_28300":124757,"_3066":124811},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3610":74130,"_31119":74108,"_21540":124813,"_5":14806,"_28300":124760,"_3066":124814},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3610":74131,"_31119":74108,"_21540":124816,"_5":14806,"_28300":124760,"_3066":124817},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3610":74132,"_31119":74108,"_21540":124819,"_5":14806,"_28300":124760,"_3066":124820},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3610":74133,"_31119":74108,"_21540":124822,"_5":14806,"_28300":124760,"_3066":124823},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3610":74134,"_31119":74108,"_21540":124825,"_5":14806,"_28300":124760,"_3066":124826},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3610":74135,"_31119":74108,"_21540":124828,"_5":14806,"_28300":124760,"_3066":124829},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3610":74136,"_31119":74108,"_21540":124831,"_5":14806,"_28300":124760,"_3066":124832},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3610":74137,"_31119":74108,"_21540":124834,"_5":14806,"_28300":124760,"_3066":124835},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3610":74138,"_31119":74108,"_21540":124837,"_5":14806,"_28300":124763,"_3066":124838},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3610":74139,"_31119":74108,"_21540":124840,"_5":14806,"_28300":124763,"_3066":124841},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3610":74140,"_31119":74108,"_21540":124843,"_5":14806,"_28300":124766,"_3066":124844},[],"Participante",{"_3610":74141,"_31119":74108,"_21540":124846,"_5":14806,"_28300":124766,"_3066":124847},[],"Responsabilidad",{"_3610":74142,"_31119":74108,"_21540":124849,"_5":14806,"_28300":124766,"_3066":124850},[],"Administrador PKI",{"_3610":74143,"_31119":74108,"_21540":124852,"_5":14806,"_28300":124766,"_3066":124853},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3610":74144,"_31119":74108,"_21540":124855,"_5":14806,"_28300":124766,"_3066":124856},[],"Administrador del aprovisionamiento",{"_3610":74145,"_31119":74108,"_21540":124858,"_5":14806,"_28300":124766,"_3066":124859},[],"DMS, admisión, autenticación por operación e inventario.",{"_3610":74146,"_31119":74108,"_21540":124861,"_5":14806,"_28300":124766,"_3066":124862},[],"Integrador del dispositivo",{"_3610":74147,"_31119":74108,"_21540":124864,"_5":14806,"_28300":124766,"_3066":124865},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3610":74148,"_31119":74108,"_21540":124867,"_5":14806,"_28300":124766,"_3066":124868},[],"Integrador del consumidor",{"_3610":74149,"_31119":74108,"_21540":124870,"_5":14806,"_28300":124766,"_3066":124871},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3610":74150,"_31119":74108,"_21540":124873,"_5":14806,"_28300":124766,"_3066":124874},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3610":74151,"_31119":74151,"_5":15171,"_3066":124876,"_31457":124877,"_21540":124879,"_28300":74151},"Enrola y conecta tu primer dispositivo",[50802,121414,53486,124878],"Primeros pasos",[],{"_3610":74152,"_31119":74151,"_21540":124881,"_5":14806,"_28300":74151,"_3066":124882},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3610":74153,"_31119":74151,"_5":31454,"_21540":124884,"_28300":124885,"_3066":119948},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3610":74154,"_31119":74151,"_5":31454,"_21540":124887,"_28300":124888,"_3066":124889},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3610":74155,"_31119":74151,"_5":31454,"_21540":124891,"_28300":124892,"_3066":124893},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3610":74156,"_31119":74151,"_5":31454,"_21540":124895,"_28300":124896,"_3066":124897},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3610":74157,"_31119":74151,"_5":31454,"_21540":124899,"_28300":124900,"_3066":124901},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3610":74158,"_31119":74151,"_5":31454,"_21540":124903,"_28300":124904,"_3066":124905},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3610":74159,"_31119":74151,"_5":31454,"_21540":124907,"_28300":124908,"_3066":124909},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3610":74160,"_31119":74151,"_5":31454,"_21540":124911,"_28300":124912,"_3066":124913},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3610":74161,"_31119":74151,"_21540":124915,"_5":14806,"_28300":74151,"_3066":124916},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3610":74162,"_31119":74151,"_21540":124918,"_5":14806,"_28300":124885,"_3066":124919},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3610":74163,"_31119":74151,"_21540":124921,"_5":14806,"_28300":124885,"_3066":124922},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3610":74164,"_31119":74151,"_21540":124924,"_5":14806,"_28300":124885,"_3066":124925},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3610":74165,"_31119":74151,"_21540":124927,"_5":14806,"_28300":124885,"_3066":124928},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3610":74166,"_31119":74151,"_21540":124930,"_5":14806,"_28300":124885,"_3066":124931},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3610":74167,"_31119":74151,"_21540":124933,"_5":14806,"_28300":124888,"_3066":124934},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3610":74168,"_31119":74151,"_21540":124936,"_5":14806,"_28300":124888,"_3066":124937},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3610":74169,"_31119":74151,"_21540":124939,"_5":14806,"_28300":124892,"_3066":124940},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3610":74170,"_31119":74151,"_21540":124942,"_5":14806,"_28300":124892,"_3066":124943},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3610":74171,"_31119":74151,"_21540":124945,"_5":14806,"_28300":124892,"_3066":124946},[],"Ajuste",{"_3610":74172,"_31119":74151,"_21540":124948,"_5":14806,"_28300":124892,"_3066":124949},[],"Valor de evaluación",{"_3610":74173,"_31119":74151,"_21540":124951,"_5":14806,"_28300":124892,"_3066":55991},[],{"_3610":74174,"_31119":74151,"_21540":124953,"_5":14806,"_28300":124892,"_3066":124954},[],"Raíz emisora de `device-root.pem`.",{"_3610":74175,"_31119":74151,"_21540":124956,"_5":14806,"_28300":124892,"_3066":122865},[],{"_3610":74176,"_31119":74151,"_21540":124958,"_5":14806,"_28300":124892,"_3066":124959},[],"Perfil final de 1 hora que acabas de preparar.",{"_3610":74177,"_31119":74151,"_21540":124961,"_5":14806,"_28300":124892,"_3066":56002},[],{"_3610":74178,"_31119":74151,"_21540":124963,"_5":14806,"_28300":124892,"_3066":56005},[],{"_3610":74179,"_31119":74151,"_21540":124965,"_5":14806,"_28300":124892,"_3066":56008},[],{"_3610":74180,"_31119":74151,"_21540":124967,"_5":14806,"_28300":124892,"_3066":124968},[],"Habilitado.",{"_3610":74181,"_31119":74151,"_21540":124970,"_5":14806,"_28300":124892,"_3066":56014},[],{"_3610":74182,"_31119":74151,"_21540":124972,"_5":14806,"_28300":124892,"_3066":124973},[],"Deshabilitado; el ID debe ser nuevo.",{"_3610":74183,"_31119":74151,"_21540":124975,"_5":14806,"_28300":124892,"_3066":124976},[],"Autenticación inicial",{"_3610":74184,"_31119":74151,"_21540":124978,"_5":14806,"_28300":124892,"_3066":124979},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3610":74185,"_31119":74151,"_21540":124981,"_5":14806,"_28300":124892,"_3066":124982},[],"Autenticación de renovación",{"_3610":74186,"_31119":74151,"_21540":124984,"_5":14806,"_28300":124892,"_3066":124985},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3610":74187,"_31119":74151,"_21540":124987,"_5":14806,"_28300":124892,"_3066":56032},[],{"_3610":74188,"_31119":74151,"_21540":124989,"_5":14806,"_28300":124892,"_3066":124990},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3610":74189,"_31119":74151,"_21540":124992,"_5":14806,"_28300":124892,"_3066":56038},[],{"_3610":74190,"_31119":74151,"_21540":124994,"_5":14806,"_28300":124892,"_3066":124995},[],"1 hora.",{"_3610":74191,"_31119":74151,"_21540":124997,"_5":14806,"_28300":124892,"_3066":56044},[],{"_3610":74192,"_31119":74151,"_21540":124999,"_5":14806,"_28300":124892,"_3066":125000},[],"30 minutos / 10 minutos.",{"_3610":74193,"_31119":74151,"_21540":125002,"_5":14806,"_28300":124892,"_3066":56050},[],{"_3610":74194,"_31119":74151,"_21540":125004,"_5":14806,"_28300":124892,"_3066":125005},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3610":74195,"_31119":74151,"_21540":125007,"_5":14806,"_28300":124892,"_3066":53808},[],{"_3610":74196,"_31119":74151,"_21540":125009,"_5":14806,"_28300":124892,"_3066":125010},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3610":74197,"_31119":74151,"_21540":125012,"_5":14806,"_28300":124892,"_3066":56061},[],{"_3610":74198,"_31119":74151,"_21540":125014,"_5":14806,"_28300":124892,"_3066":125015},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3610":74199,"_31119":74151,"_21540":125017,"_5":14806,"_28300":124892,"_3066":125018},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3610":74200,"_31119":74151,"_21540":125020,"_5":14806,"_28300":124896,"_3066":125021},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3610":74201,"_31119":74151,"_21540":125023,"_5":14806,"_28300":124896,"_3066":125024},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3610":74202,"_31119":74151,"_21540":125026,"_5":14806,"_28300":124900,"_3066":125027},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3610":74203,"_31119":74151,"_21540":125029,"_5":14806,"_28300":124900,"_3066":125030},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3610":74204,"_31119":74151,"_21540":125032,"_5":14806,"_28300":124900,"_3066":125033},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3610":74205,"_31119":74151,"_21540":125035,"_5":14806,"_28300":124904,"_3066":125036},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3610":74206,"_31119":74151,"_21540":125038,"_5":14806,"_28300":124904,"_3066":125039},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3610":74207,"_31119":74151,"_21540":125041,"_5":14806,"_28300":124908,"_3066":125042},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3610":74208,"_31119":74151,"_21540":125044,"_5":14806,"_28300":124908,"_3066":125045},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3610":74209,"_31119":74151,"_21540":125047,"_5":14806,"_28300":124908,"_3066":125048},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3610":74210,"_31119":74151,"_21540":125050,"_5":14806,"_28300":124908,"_3066":125051},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3610":74211,"_31119":74151,"_21540":125053,"_5":14806,"_28300":124908,"_3066":125054},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3610":74212,"_31119":74151,"_21540":125056,"_5":14806,"_28300":124912,"_3066":125057},[],"Comprobación",{"_3610":74213,"_31119":74151,"_21540":125059,"_5":14806,"_28300":124912,"_3066":125060},[],"Resultado esperado",{"_3610":74214,"_31119":74151,"_21540":125062,"_5":14806,"_28300":124912,"_3066":125063},[],"Registro",{"_3610":74215,"_31119":74151,"_21540":125065,"_5":14806,"_28300":124912,"_3066":125066},[],"ID creado automáticamente y DMS correcto.",{"_3610":74216,"_31119":74151,"_21540":125068,"_5":14806,"_28300":124912,"_3066":124353},[],{"_3610":74217,"_31119":74151,"_21540":125070,"_5":14806,"_28300":124912,"_3066":125071},[],"CN, perfil, serie y clave verificados.",{"_3610":74218,"_31119":74151,"_21540":125073,"_5":14806,"_28300":124912,"_3066":125074},[],"Inventario",{"_3610":74219,"_31119":74151,"_21540":125076,"_5":14806,"_28300":124912,"_3066":125077},[],"Serie recibida visible como identidad actual y en el historial.",{"_3610":74220,"_31119":74151,"_21540":125079,"_5":14806,"_28300":124912,"_3066":125080},[],"Consumidor",{"_3610":74221,"_31119":74151,"_21540":125082,"_5":14806,"_28300":124912,"_3066":125083},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3610":74222,"_31119":74151,"_21540":125085,"_5":14806,"_28300":124912,"_3066":125086},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3610":74223,"_31119":74151,"_21540":125088,"_5":14806,"_28300":124912,"_3066":125089},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3610":74224,"_31119":74224,"_5":15171,"_3066":122576,"_31457":125091,"_21540":125092,"_28300":74224},[50802,121414,53486,124878],[],{"_3610":74225,"_31119":74224,"_21540":125094,"_5":14806,"_28300":74224,"_3066":125095},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3610":74226,"_31119":74224,"_5":31454,"_21540":125097,"_28300":125098,"_3066":119948},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3610":74227,"_31119":74224,"_5":31454,"_21540":125100,"_28300":125101,"_3066":125102},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3610":74228,"_31119":74224,"_5":31454,"_21540":125104,"_28300":125105,"_3066":125106},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3610":74229,"_31119":74224,"_5":31454,"_21540":125108,"_28300":125109,"_3066":125110},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3610":74230,"_31119":74224,"_5":31454,"_21540":125112,"_28300":125113,"_3066":125114},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3610":74231,"_31119":74224,"_5":31454,"_21540":125116,"_28300":125117,"_3066":125118},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3610":74232,"_31119":74224,"_5":31454,"_21540":125120,"_28300":125121,"_3066":125060},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3610":74233,"_31119":74224,"_5":31454,"_21540":125123,"_28300":125124,"_3066":125125},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3610":74234,"_31119":74224,"_5":31454,"_21540":125127,"_28300":125128,"_3066":125129},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3610":74235,"_31119":74224,"_21540":125131,"_5":14806,"_28300":74224,"_3066":125132},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3610":74236,"_31119":74224,"_21540":125134,"_5":14806,"_28300":74224,"_3066":125135},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3610":74237,"_31119":74224,"_21540":125137,"_5":14806,"_28300":125098,"_3066":125138},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3610":74238,"_31119":74224,"_21540":125140,"_5":14806,"_28300":125098,"_3066":125141},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3610":74239,"_31119":74224,"_21540":125143,"_5":14806,"_28300":125098,"_3066":125144},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3610":74240,"_31119":74224,"_21540":125146,"_5":14806,"_28300":125098,"_3066":125147},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3610":74241,"_31119":74224,"_21540":125149,"_5":14806,"_28300":125101,"_3066":125150},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3610":74242,"_31119":74224,"_21540":125152,"_5":14806,"_28300":125101,"_3066":125153},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3610":74243,"_31119":74224,"_21540":125155,"_5":14806,"_28300":125101,"_3066":125156},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3610":74244,"_31119":74224,"_21540":125158,"_5":14806,"_28300":125101,"_3066":125159},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3610":74245,"_31119":74224,"_21540":125161,"_5":14806,"_28300":125101,"_3066":125162},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3610":74246,"_31119":74224,"_21540":125164,"_5":14806,"_28300":125101,"_3066":125165},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3610":74247,"_31119":74224,"_21540":125167,"_5":14806,"_28300":125101,"_3066":125168},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3610":74248,"_31119":74224,"_21540":125170,"_5":14806,"_28300":125101,"_3066":125171},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3610":74249,"_31119":74224,"_21540":125173,"_5":14806,"_28300":125105,"_3066":125174},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3610":74250,"_31119":74224,"_21540":125176,"_5":14806,"_28300":125105,"_3066":56226},[],{"_3610":74251,"_31119":74224,"_21540":125178,"_5":14806,"_28300":125105,"_3066":125179},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3610":74252,"_31119":74224,"_21540":125181,"_5":14806,"_28300":125105,"_3066":125182},[],"**Icon** y **Tags**: clasificación opcional.",{"_3610":74253,"_31119":74224,"_21540":125184,"_5":14806,"_28300":125105,"_3066":125185},[],"Confirma el registro.",{"_3610":74254,"_31119":74224,"_21540":125187,"_5":14806,"_28300":125109,"_3066":125188},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3610":74255,"_31119":74224,"_21540":125190,"_5":14806,"_28300":125109,"_3066":125191},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3610":74256,"_31119":74224,"_21540":125193,"_5":14806,"_28300":125113,"_3066":125194},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3610":74257,"_31119":74224,"_21540":125196,"_5":14806,"_28300":125113,"_3066":125197},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3610":74258,"_31119":74224,"_21540":125199,"_5":14806,"_28300":125117,"_3066":125200},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3610":74259,"_31119":74224,"_21540":125202,"_5":14806,"_28300":125117,"_3066":125203},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3610":74260,"_31119":74224,"_21540":125205,"_5":14806,"_28300":125121,"_3066":125057},[],{"_3610":74261,"_31119":74224,"_21540":125207,"_5":14806,"_28300":125121,"_3066":125208},[],"Resultado",{"_3610":74262,"_31119":74224,"_21540":125210,"_5":14806,"_28300":125121,"_3066":124339},[],{"_3610":74263,"_31119":74224,"_21540":125212,"_5":14806,"_28300":125121,"_3066":125213},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3610":74264,"_31119":74224,"_21540":125215,"_5":14806,"_28300":125121,"_3066":125216},[],"Identidad actual",{"_3610":74265,"_31119":74224,"_21540":125218,"_5":14806,"_28300":125121,"_3066":125219},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3610":74266,"_31119":74224,"_21540":125221,"_5":14806,"_28300":125121,"_3066":125222},[],"Historial",{"_3610":74267,"_31119":74224,"_21540":125224,"_5":14806,"_28300":125121,"_3066":125225},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3610":74268,"_31119":74224,"_21540":125227,"_5":14806,"_28300":125121,"_3066":125228},[],"Clave y certificado",{"_3610":74269,"_31119":74224,"_21540":125230,"_5":14806,"_28300":125121,"_3066":125231},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3610":74270,"_31119":74224,"_21540":125233,"_5":14806,"_28300":125124,"_3066":125234},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3610":74271,"_31119":74224,"_21540":125236,"_5":14806,"_28300":125124,"_3066":125237},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3610":74272,"_31119":74224,"_21540":125239,"_5":14806,"_28300":125124,"_3066":125240},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3610":74273,"_31119":74224,"_21540":125242,"_5":14806,"_28300":125124,"_3066":125243},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3610":74274,"_31119":74224,"_21540":125245,"_5":14806,"_28300":125128,"_3066":125246},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3610":74275,"_31119":74224,"_21540":125248,"_5":14806,"_28300":125128,"_3066":125249},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3610":74276,"_31119":74224,"_21540":125251,"_5":14806,"_28300":125128,"_3066":125252},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3610":74277,"_31119":74277,"_5":15171,"_3066":125254,"_31457":125255,"_21540":125256,"_28300":74277},"Plataforma Lamassu IoT",[50802,121414],[],{"_3610":74278,"_31119":74277,"_21540":125258,"_5":14806,"_28300":74277,"_3066":125259},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3610":74279,"_31119":74277,"_5":31454,"_21540":125261,"_28300":125262,"_3066":124754},[],"/docs/es/platform/overview#empieza-aquí",{"_3610":74280,"_31119":74277,"_5":31454,"_21540":125264,"_28300":125265,"_3066":125266},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3610":74281,"_31119":74277,"_5":31454,"_21540":125268,"_28300":125269,"_3066":125270},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3610":74282,"_31119":74277,"_5":31454,"_21540":125272,"_28300":125273,"_3066":125274},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3610":74283,"_31119":74277,"_5":31454,"_21540":125276,"_28300":125277,"_3066":125278},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3610":74284,"_31119":74277,"_5":31454,"_21540":125280,"_28300":125281,"_3066":125282},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3610":74285,"_31119":74277,"_5":31454,"_21540":125284,"_28300":125285,"_3066":125286},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3610":74286,"_31119":74277,"_5":31454,"_21540":125288,"_28300":125289,"_3066":125290},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3610":74287,"_31119":74277,"_5":31454,"_21540":125292,"_28300":125293,"_3066":125294},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3610":74288,"_31119":74277,"_5":31454,"_21540":125296,"_28300":125297,"_3066":125298},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3610":74289,"_31119":74277,"_5":31454,"_21540":125300,"_28300":125301,"_3066":125302},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3610":74290,"_31119":74277,"_21540":125304,"_5":14806,"_28300":74277,"_3066":125305},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3610":74291,"_31119":74277,"_21540":125307,"_5":14806,"_28300":125262,"_3066":125308},[],"Elige el resultado que necesitas obtener:",{"_3610":74292,"_31119":74277,"_21540":125310,"_5":14806,"_28300":125262,"_3066":125311},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3610":74293,"_31119":74277,"_21540":125313,"_5":14806,"_28300":125262,"_3066":125314},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3610":74294,"_31119":74277,"_21540":125316,"_5":14806,"_28300":125262,"_3066":125317},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3610":74295,"_31119":74277,"_21540":125319,"_5":14806,"_28300":125265,"_3066":125320},[],"Bloque",{"_3610":74296,"_31119":74277,"_21540":125322,"_5":14806,"_28300":125265,"_3066":125323},[],"Qué gestionas",{"_3610":74297,"_31119":74277,"_21540":125325,"_5":14806,"_28300":125265,"_3066":125326},[],"Punto de entrada",{"_3610":74298,"_31119":74277,"_21540":125328,"_5":14806,"_28300":125265,"_3066":56379},[],{"_3610":74299,"_31119":74277,"_21540":125330,"_5":14806,"_28300":125265,"_3066":125331},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3610":74300,"_31119":74277,"_21540":125333,"_5":14806,"_28300":125265,"_3066":125334},[],"Visión general de PKI",{"_3610":74301,"_31119":74277,"_21540":125336,"_5":14806,"_28300":125265,"_3066":56388},[],{"_3610":74302,"_31119":74277,"_21540":125338,"_5":14806,"_28300":125265,"_3066":125339},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3610":74303,"_31119":74277,"_21540":125341,"_5":14806,"_28300":125265,"_3066":125342},[],"Visión general de IoT Fleets",{"_3610":74304,"_31119":74277,"_21540":125344,"_5":14806,"_28300":125265,"_3066":125345},[],"**Administración**",{"_3610":74305,"_31119":74277,"_21540":125347,"_5":14806,"_28300":125265,"_3066":125348},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3610":74306,"_31119":74277,"_21540":125350,"_5":14806,"_28300":125265,"_3066":121416},[],{"_3610":74307,"_31119":74277,"_21540":125352,"_5":14806,"_28300":125265,"_3066":125353},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3610":74308,"_31119":74277,"_21540":125355,"_5":14806,"_28300":125269,"_3066":125356},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3610":74309,"_31119":74277,"_21540":125358,"_5":14806,"_28300":125269,"_3066":125359},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3610":74310,"_31119":74277,"_21540":125361,"_5":14806,"_28300":125269,"_3066":125362},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3610":74311,"_31119":74277,"_21540":125364,"_5":14806,"_28300":125269,"_3066":125365},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3610":74312,"_31119":74277,"_21540":125367,"_5":14806,"_28300":125269,"_3066":125368},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3610":74313,"_31119":74277,"_21540":125370,"_5":14806,"_28300":125269,"_3066":125371},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3610":74314,"_31119":74277,"_21540":125373,"_5":14806,"_28300":125277,"_3066":125374},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3610":74315,"_31119":74277,"_21540":125376,"_5":14806,"_28300":125281,"_3066":125377},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3610":74316,"_31119":74277,"_21540":125379,"_5":14806,"_28300":125285,"_3066":125380},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3610":74317,"_31119":74277,"_21540":125382,"_5":14806,"_28300":125289,"_3066":125383},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3610":74318,"_31119":74277,"_21540":125385,"_5":14806,"_28300":125293,"_3066":125386},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3610":74319,"_31119":74277,"_21540":125388,"_5":14806,"_28300":125297,"_3066":125389},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3610":74320,"_31119":74277,"_21540":125391,"_5":14806,"_28300":125301,"_3066":124847},[],{"_3610":74321,"_31119":74277,"_21540":125393,"_5":14806,"_28300":125301,"_3066":125394},[],"Qué prepara o comprueba",{"_3610":74322,"_31119":74277,"_21540":125396,"_5":14806,"_28300":125301,"_3066":124850},[],{"_3610":74323,"_31119":74277,"_21540":125398,"_5":14806,"_28300":125301,"_3066":125399},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3610":74324,"_31119":74277,"_21540":125401,"_5":14806,"_28300":125301,"_3066":125402},[],"Administrador de la flota",{"_3610":74325,"_31119":74277,"_21540":125404,"_5":14806,"_28300":125301,"_3066":125405},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3610":74326,"_31119":74277,"_21540":125407,"_5":14806,"_28300":125301,"_3066":124862},[],{"_3610":74327,"_31119":74277,"_21540":125409,"_5":14806,"_28300":125301,"_3066":125410},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3610":74328,"_31119":74277,"_21540":125412,"_5":14806,"_28300":125301,"_3066":124868},[],{"_3610":74329,"_31119":74277,"_21540":125414,"_5":14806,"_28300":125301,"_3066":125415},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3610":74330,"_31119":74277,"_21540":125417,"_5":14806,"_28300":125301,"_3066":125418},[],"Operador de infraestructura",{"_3610":74331,"_31119":74277,"_21540":125420,"_5":14806,"_28300":125301,"_3066":125421},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3610":74332,"_31119":74277,"_21540":125423,"_5":14806,"_28300":125301,"_3066":125424},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3610":74333,"_31119":74333,"_5":15171,"_3066":125426,"_31457":125427,"_21540":125429,"_28300":74333},"Jerarquía y rotación de CAs",[50802,121414,56480,125428],"Claves, autoridades y certificados",[],{"_3610":74334,"_31119":74333,"_21540":125431,"_5":14806,"_28300":74333,"_3066":125432},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3610":74335,"_31119":74333,"_5":31454,"_21540":125434,"_28300":125435,"_3066":125436},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3610":74336,"_31119":74333,"_5":31454,"_21540":125438,"_28300":125439,"_3066":125440},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3610":74337,"_31119":74333,"_5":31454,"_21540":125442,"_28300":125443,"_3066":125444},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3610":74338,"_31119":74333,"_5":31454,"_21540":125446,"_28300":125447,"_3066":125448},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3610":74339,"_31119":74333,"_5":31454,"_21540":125450,"_28300":125451,"_3066":125452},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3610":74340,"_31119":74333,"_5":31454,"_21540":125454,"_28300":125455,"_3066":125456},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3610":74341,"_31119":74333,"_5":31454,"_21540":125458,"_28300":125459,"_3066":125460},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3610":74342,"_31119":74333,"_5":31454,"_21540":125462,"_28300":125463,"_3066":125464},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3610":74343,"_31119":74333,"_5":31454,"_21540":125466,"_28300":125467,"_3066":125468},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3610":74344,"_31119":74333,"_5":31454,"_21540":125470,"_28300":125471,"_3066":125472},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3610":74345,"_31119":74333,"_5":31454,"_21540":125474,"_28300":125475,"_3066":125476},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3610":74346,"_31119":74333,"_5":31454,"_21540":125478,"_28300":125479,"_3066":125480},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3610":74347,"_31119":74333,"_21540":125482,"_5":14806,"_28300":74333,"_3066":125483},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3610":74348,"_31119":74333,"_21540":125485,"_5":14806,"_28300":74333,"_3066":125486},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3610":74349,"_31119":74333,"_21540":125488,"_5":14806,"_28300":125435,"_3066":125489},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3610":74350,"_31119":74333,"_21540":125491,"_5":14806,"_28300":125435,"_3066":125492},[],"entorno, como producción y preproducción;",{"_3610":74351,"_31119":74333,"_21540":125494,"_5":14806,"_28300":125435,"_3066":125495},[],"propietario o equipo operador;",{"_3610":74352,"_31119":74333,"_21540":125497,"_5":14806,"_28300":125435,"_3066":125498},[],"familia de dispositivos o proceso de fabricación;",{"_3610":74353,"_31119":74333,"_21540":125500,"_5":14806,"_28300":125435,"_3066":125501},[],"región o requisito regulatorio;",{"_3610":74354,"_31119":74333,"_21540":125503,"_5":14806,"_28300":125435,"_3066":125504},[],"motor criptográfico o política de clave;",{"_3610":74355,"_31119":74333,"_21540":125506,"_5":14806,"_28300":125435,"_3066":125507},[],"ventana de mantenimiento y ritmo de renovación.",{"_3610":74356,"_31119":74333,"_21540":125509,"_5":14806,"_28300":125435,"_3066":125510},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3610":74357,"_31119":74333,"_21540":125512,"_5":14806,"_28300":125435,"_3066":125513},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3610":74358,"_31119":74333,"_21540":125515,"_5":14806,"_28300":125439,"_3066":125516},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3610":74359,"_31119":74333,"_21540":125518,"_5":14806,"_28300":125439,"_3066":125519},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3610":74360,"_31119":74333,"_21540":125521,"_5":14806,"_28300":125439,"_3066":125522},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3610":74361,"_31119":74333,"_21540":125524,"_5":14806,"_28300":125439,"_3066":125525},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3610":74362,"_31119":74333,"_21540":125527,"_5":14806,"_28300":125443,"_3066":125528},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3610":74363,"_31119":74333,"_21540":125530,"_5":14806,"_28300":125443,"_3066":125531},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3610":74364,"_31119":74333,"_21540":125533,"_5":14806,"_28300":125443,"_3066":125534},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3610":74365,"_31119":74333,"_21540":125536,"_5":14806,"_28300":125443,"_3066":125537},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3610":74366,"_31119":74333,"_21540":125539,"_5":14806,"_28300":125451,"_3066":125540},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3610":74367,"_31119":74333,"_21540":125542,"_5":14806,"_28300":125455,"_3066":125543},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3610":74368,"_31119":74333,"_21540":125545,"_5":14806,"_28300":125459,"_3066":125546},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3610":74369,"_31119":74333,"_21540":125548,"_5":14806,"_28300":125463,"_3066":125549},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3610":74370,"_31119":74333,"_21540":125551,"_5":14806,"_28300":125467,"_3066":125552},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3610":74371,"_31119":74333,"_21540":125554,"_5":14806,"_28300":125471,"_3066":125555},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3610":74372,"_31119":74333,"_21540":125557,"_5":14806,"_28300":125475,"_3066":125558},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3610":74373,"_31119":74333,"_21540":125560,"_5":14806,"_28300":125475,"_3066":125561},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3610":74374,"_31119":74333,"_21540":125563,"_5":14806,"_28300":125475,"_3066":125564},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3610":74375,"_31119":74333,"_21540":125566,"_5":14806,"_28300":125475,"_3066":125567},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3610":74376,"_31119":74333,"_21540":125569,"_5":14806,"_28300":125479,"_3066":125570},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3610":74377,"_31119":74333,"_21540":125572,"_5":14806,"_28300":125479,"_3066":125573},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3610":74378,"_31119":74333,"_21540":125575,"_5":14806,"_28300":125479,"_3066":125576},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3610":74379,"_31119":74333,"_21540":125578,"_5":14806,"_28300":125479,"_3066":125579},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3610":74380,"_31119":74333,"_21540":125581,"_5":14806,"_28300":125479,"_3066":125582},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3610":74381,"_31119":74333,"_21540":125584,"_5":14806,"_28300":125479,"_3066":125585},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3610":74382,"_31119":74333,"_21540":125587,"_5":14806,"_28300":125479,"_3066":125588},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3610":74383,"_31119":74383,"_5":15171,"_3066":125590,"_31457":125591,"_21540":125592,"_28300":74383},"Autoridades de certificación",[50802,121414,56480,125428],[],{"_3610":74384,"_31119":74383,"_21540":125594,"_5":14806,"_28300":74383,"_3066":125595},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3610":74385,"_31119":74383,"_5":31454,"_21540":125597,"_28300":125598,"_3066":125599},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3610":74386,"_31119":74383,"_5":31454,"_21540":125601,"_28300":125602,"_3066":125603},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3610":74387,"_31119":74383,"_5":31454,"_21540":125605,"_28300":125606,"_3066":119948},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3610":74388,"_31119":74383,"_5":31454,"_21540":125608,"_28300":125609,"_3066":125610},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3610":74389,"_31119":74383,"_5":31454,"_21540":125612,"_28300":125613,"_3066":125614},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3610":74390,"_31119":74383,"_5":31454,"_21540":125616,"_28300":125617,"_3066":125618},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3610":74391,"_31119":74383,"_5":31454,"_21540":125620,"_28300":125621,"_3066":125622},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3610":74392,"_31119":74383,"_5":31454,"_21540":125624,"_28300":125625,"_3066":125626},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3610":74393,"_31119":74383,"_5":31454,"_21540":125628,"_28300":125629,"_3066":125630},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3610":74394,"_31119":74383,"_5":31454,"_21540":125632,"_28300":125633,"_3066":125634},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3610":74395,"_31119":74383,"_5":31454,"_21540":125636,"_28300":125637,"_3066":125638},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3610":74396,"_31119":74383,"_5":31454,"_21540":125640,"_28300":125641,"_3066":125642},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3610":74397,"_31119":74383,"_5":31454,"_21540":125644,"_28300":125645,"_3066":125646},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3610":74398,"_31119":74383,"_5":31454,"_21540":125648,"_28300":125649,"_3066":125650},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3610":74399,"_31119":74383,"_5":31454,"_21540":125652,"_28300":125653,"_3066":125654},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3610":74400,"_31119":74383,"_5":31454,"_21540":125656,"_28300":125657,"_3066":125658},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3610":74401,"_31119":74383,"_5":31454,"_21540":125660,"_28300":125661,"_3066":125662},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3610":74402,"_31119":74383,"_5":31454,"_21540":125664,"_28300":125665,"_3066":125666},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3610":74403,"_31119":74383,"_5":31454,"_21540":125668,"_28300":125669,"_3066":125670},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3610":74404,"_31119":74383,"_5":31454,"_21540":125672,"_28300":125673,"_3066":125674},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3610":74405,"_31119":74383,"_5":31454,"_21540":125676,"_28300":125677,"_3066":125678},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3610":74406,"_31119":74383,"_5":31454,"_21540":125680,"_28300":125681,"_3066":125682},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3610":74407,"_31119":74383,"_5":31454,"_21540":125684,"_28300":125685,"_3066":125686},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3610":74408,"_31119":74383,"_21540":125688,"_5":14806,"_28300":74383,"_3066":125689},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3610":74409,"_31119":74383,"_21540":125691,"_5":14806,"_28300":74383,"_3066":125692},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3610":74410,"_31119":74383,"_21540":125694,"_5":14806,"_28300":74383,"_3066":125695},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3610":74411,"_31119":74383,"_21540":125697,"_5":14806,"_28300":125598,"_3066":125698},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3610":74412,"_31119":74383,"_21540":125700,"_5":14806,"_28300":125598,"_3066":125701},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3610":74413,"_31119":74383,"_21540":125703,"_5":14806,"_28300":125598,"_3066":125704},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3610":74414,"_31119":74383,"_21540":125706,"_5":14806,"_28300":125598,"_3066":125707},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3610":74415,"_31119":74383,"_21540":125709,"_5":14806,"_28300":125598,"_3066":125710},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3610":74416,"_31119":74383,"_21540":125712,"_5":14806,"_28300":125606,"_3066":125713},[],"Decide si la CA será raíz o intermedia.",{"_3610":74417,"_31119":74383,"_21540":125715,"_5":14806,"_28300":125606,"_3066":125716},[],"Elige el motor que custodiará la clave.",{"_3610":74418,"_31119":74383,"_21540":125718,"_5":14806,"_28300":125606,"_3066":125719},[],"Define una validez superior a la de los certificados que emitirá.",{"_3610":74419,"_31119":74383,"_21540":125721,"_5":14806,"_28300":125606,"_3066":125722},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3610":74420,"_31119":74383,"_21540":125724,"_5":14806,"_28300":125609,"_3066":125725},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3610":74421,"_31119":74383,"_21540":125727,"_5":14806,"_28300":125613,"_3066":125728},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3610":74422,"_31119":74383,"_21540":125730,"_5":14806,"_28300":125613,"_3066":125731},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3610":74423,"_31119":74383,"_21540":125733,"_5":14806,"_28300":125617,"_3066":125734},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3610":74424,"_31119":74383,"_21540":125736,"_5":14806,"_28300":125621,"_3066":125737},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3610":74425,"_31119":74383,"_21540":125739,"_5":14806,"_28300":125621,"_3066":125740},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3610":74426,"_31119":74383,"_21540":125742,"_5":14806,"_28300":125621,"_3066":125743},[],"`ST`: estado o provincia.",{"_3610":74427,"_31119":74383,"_21540":125745,"_5":14806,"_28300":125621,"_3066":125746},[],"`L`: localidad.",{"_3610":74428,"_31119":74383,"_21540":125748,"_5":14806,"_28300":125621,"_3066":125749},[],"`O`: organización.",{"_3610":74429,"_31119":74383,"_21540":125751,"_5":14806,"_28300":125621,"_3066":125752},[],"`OU`: unidad organizativa.",{"_3610":74430,"_31119":74383,"_21540":125754,"_5":14806,"_28300":125621,"_3066":125755},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3610":74431,"_31119":74383,"_21540":125757,"_5":14806,"_28300":125625,"_3066":125758},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3610":74432,"_31119":74383,"_21540":125760,"_5":14806,"_28300":125625,"_3066":125761},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3610":74433,"_31119":74383,"_21540":125763,"_5":14806,"_28300":125629,"_3066":125764},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3610":74434,"_31119":74383,"_21540":125766,"_5":14806,"_28300":125629,"_3066":125767},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3610":74435,"_31119":74383,"_21540":125769,"_5":14806,"_28300":125633,"_3066":125770},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3610":74436,"_31119":74383,"_21540":125772,"_5":14806,"_28300":125633,"_3066":125773},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3610":74437,"_31119":74383,"_21540":125775,"_5":14806,"_28300":125637,"_3066":125776},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3610":74438,"_31119":74383,"_21540":125778,"_5":14806,"_28300":125637,"_3066":125779},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3610":74439,"_31119":74383,"_21540":125781,"_5":14806,"_28300":125637,"_3066":125782},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3610":74440,"_31119":74383,"_21540":125784,"_5":14806,"_28300":125641,"_3066":125785},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3610":74441,"_31119":74383,"_21540":125787,"_5":14806,"_28300":125645,"_3066":125788},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3610":74442,"_31119":74383,"_21540":125790,"_5":14806,"_28300":125645,"_3066":125791},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3610":74443,"_31119":74383,"_21540":125793,"_5":14806,"_28300":125649,"_3066":125794},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3610":74444,"_31119":74383,"_21540":125796,"_5":14806,"_28300":125653,"_3066":125797},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3610":74445,"_31119":74383,"_21540":125799,"_5":14806,"_28300":125653,"_3066":125800},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3610":74446,"_31119":74383,"_21540":125802,"_5":14806,"_28300":125653,"_3066":125803},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3610":74447,"_31119":74383,"_21540":125805,"_5":14806,"_28300":125657,"_3066":125806},[],"Abre una CA desde el inventario para consultar:",{"_3610":74448,"_31119":74383,"_21540":125808,"_5":14806,"_28300":125657,"_3066":125809},[],"Estado y periodo de validez.",{"_3610":74449,"_31119":74383,"_21540":125811,"_5":14806,"_28300":125657,"_3066":125812},[],"Certificado y cadena en formato PEM.",{"_3610":74450,"_31119":74383,"_21540":125814,"_5":14806,"_28300":125657,"_3066":125815},[],"Número de certificados activos, expirados y revocados.",{"_3610":74451,"_31119":74383,"_21540":125817,"_5":14806,"_28300":125657,"_3066":125818},[],"Certificados emitidos en **Issued Certificates**.",{"_3610":74452,"_31119":74383,"_21540":125820,"_5":14806,"_28300":125657,"_3066":125821},[],"CRL vinculada a la autoridad.",{"_3610":74453,"_31119":74383,"_21540":125823,"_5":14806,"_28300":125657,"_3066":125824},[],"Metadatos y motor criptográfico asociado.",{"_3610":74454,"_31119":74383,"_21540":125826,"_5":14806,"_28300":125657,"_3066":125827},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3610":74455,"_31119":74383,"_21540":125829,"_5":14806,"_28300":125661,"_3066":125830},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3610":74456,"_31119":74383,"_21540":125832,"_5":14806,"_28300":125661,"_3066":125833},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3610":74457,"_31119":74383,"_21540":125835,"_5":14806,"_28300":125661,"_3066":125836},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3610":74458,"_31119":74383,"_21540":125838,"_5":14806,"_28300":125661,"_3066":125839},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3610":74459,"_31119":74383,"_21540":125841,"_5":14806,"_28300":125661,"_3066":125842},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3610":74460,"_31119":74383,"_21540":125844,"_5":14806,"_28300":125661,"_3066":125845},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3610":74461,"_31119":74383,"_21540":125847,"_5":14806,"_28300":125665,"_3066":125848},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3610":74462,"_31119":74383,"_21540":125850,"_5":14806,"_28300":125669,"_3066":125851},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3610":74463,"_31119":74383,"_21540":125853,"_5":14806,"_28300":125673,"_3066":125854},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3610":74464,"_31119":74383,"_21540":125856,"_5":14806,"_28300":125677,"_3066":125857},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3610":74465,"_31119":74383,"_21540":125859,"_5":14806,"_28300":125681,"_3066":125860},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3610":74466,"_31119":74383,"_21540":125862,"_5":14806,"_28300":125685,"_3066":125863},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3610":74467,"_31119":74383,"_21540":125865,"_5":14806,"_28300":125685,"_3066":125866},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3610":74468,"_31119":74383,"_21540":125868,"_5":14806,"_28300":125685,"_3066":125869},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3610":74469,"_31119":74383,"_21540":125871,"_5":14806,"_28300":125685,"_3066":125872},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3610":74470,"_31119":74470,"_5":15171,"_3066":125874,"_31457":125875,"_21540":125876,"_28300":74470},"Perfiles de certificado",[50802,121414,56480,125428],[],{"_3610":74471,"_31119":74470,"_21540":125878,"_5":14806,"_28300":74470,"_3066":125879},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3610":74472,"_31119":74470,"_5":31454,"_21540":125881,"_28300":125882,"_3066":125883},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3610":74473,"_31119":74470,"_5":31454,"_21540":125885,"_28300":125886,"_3066":125887},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3610":74474,"_31119":74470,"_5":31454,"_21540":125889,"_28300":125890,"_3066":125891},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3610":74475,"_31119":74470,"_5":31454,"_21540":125893,"_28300":125894,"_3066":125895},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3610":74476,"_31119":74470,"_5":31454,"_21540":125897,"_28300":125898,"_3066":125899},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3610":74477,"_31119":74470,"_5":31454,"_21540":125901,"_28300":125902,"_3066":125903},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3610":74478,"_31119":74470,"_5":31454,"_21540":125905,"_28300":125906,"_3066":125907},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3610":74479,"_31119":74470,"_5":31454,"_21540":125909,"_28300":125910,"_3066":125911},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3610":74480,"_31119":74470,"_5":31454,"_21540":125913,"_28300":125914,"_3066":125915},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3610":74481,"_31119":74470,"_5":31454,"_21540":125917,"_28300":125918,"_3066":125919},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3610":74482,"_31119":74470,"_5":31454,"_21540":125921,"_28300":125922,"_3066":125923},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3610":74483,"_31119":74470,"_5":31454,"_21540":125925,"_28300":125926,"_3066":125927},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3610":74484,"_31119":74470,"_5":31454,"_21540":125929,"_28300":125930,"_3066":125931},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3610":74485,"_31119":74470,"_5":31454,"_21540":125933,"_28300":125934,"_3066":125935},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3610":74486,"_31119":74470,"_5":31454,"_21540":125937,"_28300":125938,"_3066":125939},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3610":74487,"_31119":74470,"_5":31454,"_21540":125941,"_28300":125942,"_3066":125943},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3610":74488,"_31119":74470,"_21540":125945,"_5":14806,"_28300":74470,"_3066":125946},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3610":74489,"_31119":74470,"_21540":125948,"_5":14806,"_28300":74470,"_3066":125949},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3610":74490,"_31119":74470,"_21540":125951,"_5":14806,"_28300":125886,"_3066":125952},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3610":74491,"_31119":74470,"_21540":125954,"_5":14806,"_28300":125886,"_3066":125955},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3610":74492,"_31119":74470,"_21540":125957,"_5":14806,"_28300":125890,"_3066":125958},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3610":74493,"_31119":74470,"_21540":125960,"_5":14806,"_28300":125894,"_3066":125961},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3610":74494,"_31119":74470,"_21540":125963,"_5":14806,"_28300":125894,"_3066":125964},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3610":74495,"_31119":74470,"_21540":125966,"_5":14806,"_28300":125894,"_3066":125967},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3610":74496,"_31119":74470,"_21540":125969,"_5":14806,"_28300":125898,"_3066":125970},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3610":74497,"_31119":74470,"_21540":125972,"_5":14806,"_28300":125902,"_3066":125973},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3610":74498,"_31119":74470,"_21540":125975,"_5":14806,"_28300":125902,"_3066":125976},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3610":74499,"_31119":74470,"_21540":125978,"_5":14806,"_28300":125906,"_3066":125979},[],"La aplicación criptográfica puede:",{"_3610":74500,"_31119":74470,"_21540":125981,"_5":14806,"_28300":125906,"_3066":125982},[],"permitir o bloquear claves RSA;",{"_3610":74501,"_31119":74470,"_21540":125984,"_5":14806,"_28300":125906,"_3066":125985},[],"limitar los tamaños RSA admitidos;",{"_3610":74502,"_31119":74470,"_21540":125987,"_5":14806,"_28300":125906,"_3066":125988},[],"permitir o bloquear claves ECDSA;",{"_3610":74503,"_31119":74470,"_21540":125990,"_5":14806,"_28300":125906,"_3066":125991},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3610":74504,"_31119":74470,"_21540":125993,"_5":14806,"_28300":125906,"_3066":125994},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3610":74505,"_31119":74470,"_21540":125996,"_5":14806,"_28300":125910,"_3066":125997},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3610":74506,"_31119":74470,"_21540":125999,"_5":14806,"_28300":125910,"_3066":121174},[],{"_3610":74507,"_31119":74470,"_21540":126001,"_5":14806,"_28300":125910,"_3066":126002},[],"Primera opción",{"_3610":74508,"_31119":74470,"_21540":126004,"_5":14806,"_28300":125910,"_3066":126005},[],"Segunda opción",{"_3610":74509,"_31119":74470,"_21540":126007,"_5":14806,"_28300":125910,"_3066":126008},[],"Si no hay ninguna",{"_3610":74510,"_31119":74470,"_21540":126010,"_5":14806,"_28300":125910,"_3066":126011},[],"Firma directa con una CA",{"_3610":74511,"_31119":74470,"_21540":126013,"_5":14806,"_28300":125910,"_3066":126014},[],"`issuance_profile` incluido en la solicitud",{"_3610":74512,"_31119":74470,"_21540":126016,"_5":14806,"_28300":125910,"_3066":126017},[],"`issuance_profile_id` de la solicitud",{"_3610":74513,"_31119":74470,"_21540":126019,"_5":14806,"_28300":125910,"_3066":126020},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3610":74514,"_31119":74470,"_21540":126022,"_5":14806,"_28300":125910,"_3066":126023},[],"Emisión mediante DMS",{"_3610":74515,"_31119":74470,"_21540":126025,"_5":14806,"_28300":125910,"_3066":57079},[],{"_3610":74516,"_31119":74470,"_21540":126027,"_5":14806,"_28300":125910,"_3066":126028},[],"`settings.issuance_profile` incluido en el DMS",{"_3610":74517,"_31119":74470,"_21540":126030,"_5":14806,"_28300":125910,"_3066":126031},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3610":74518,"_31119":74470,"_21540":126033,"_5":14806,"_28300":125910,"_3066":126034},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3610":74519,"_31119":74470,"_21540":126036,"_5":14806,"_28300":125910,"_3066":126037},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3610":74520,"_31119":74470,"_21540":126039,"_5":14806,"_28300":125918,"_3066":126040},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3610":74521,"_31119":74470,"_21540":126042,"_5":14806,"_28300":125922,"_3066":126043},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3610":74522,"_31119":74470,"_21540":126045,"_5":14806,"_28300":125926,"_3066":126046},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3610":74523,"_31119":74470,"_21540":126048,"_5":14806,"_28300":125930,"_3066":126049},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3610":74524,"_31119":74470,"_21540":126051,"_5":14806,"_28300":125934,"_3066":126052},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3610":74525,"_31119":74470,"_21540":126054,"_5":14806,"_28300":125934,"_3066":126055},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3610":74526,"_31119":74470,"_21540":126057,"_5":14806,"_28300":125938,"_3066":126058},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3610":74527,"_31119":74470,"_21540":126060,"_5":14806,"_28300":125938,"_3066":126061},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3610":74528,"_31119":74470,"_21540":126063,"_5":14806,"_28300":125938,"_3066":126064},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3610":74529,"_31119":74470,"_21540":126066,"_5":14806,"_28300":125938,"_3066":126067},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3610":74530,"_31119":74470,"_21540":126069,"_5":14806,"_28300":125942,"_3066":126070},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3610":74531,"_31119":74470,"_21540":126072,"_5":14806,"_28300":125942,"_3066":126073},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3610":74532,"_31119":74532,"_5":15171,"_3066":126075,"_31457":126076,"_21540":126078,"_28300":74532},"Validación de certificados",[50802,121414,56480,126077],"Validación",[],{"_3610":74533,"_31119":74532,"_21540":126080,"_5":14806,"_28300":74532,"_3066":126081},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3610":74534,"_31119":74532,"_5":31454,"_21540":126083,"_28300":126084,"_3066":126085},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3610":74535,"_31119":74532,"_5":31454,"_21540":126087,"_28300":126088,"_3066":126089},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3610":74536,"_31119":74532,"_5":31454,"_21540":126091,"_28300":126092,"_3066":126093},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3610":74537,"_31119":74532,"_21540":126095,"_5":14806,"_28300":74532,"_3066":126096},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3610":74538,"_31119":74532,"_21540":126098,"_5":14806,"_28300":126084,"_3066":126099},[],"Verifica estos criterios juntos:",{"_3610":74539,"_31119":74532,"_21540":126101,"_5":14806,"_28300":126084,"_3066":125057},[],{"_3610":74540,"_31119":74532,"_21540":126103,"_5":14806,"_28300":126084,"_3066":126104},[],"Resultado necesario",{"_3610":74541,"_31119":74532,"_21540":126106,"_5":14806,"_28300":126084,"_3066":126107},[],"Cadena y firma",{"_3610":74542,"_31119":74532,"_21540":126109,"_5":14806,"_28300":126084,"_3066":126110},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3610":74543,"_31119":74532,"_21540":126112,"_5":14806,"_28300":126084,"_3066":126113},[],"Fechas",{"_3610":74544,"_31119":74532,"_21540":126115,"_5":14806,"_28300":126084,"_3066":126116},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3610":74545,"_31119":74532,"_21540":126118,"_5":14806,"_28300":126084,"_3066":121084},[],{"_3610":74546,"_31119":74532,"_21540":126120,"_5":14806,"_28300":126084,"_3066":126121},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3610":74547,"_31119":74532,"_21540":126123,"_5":14806,"_28300":126084,"_3066":126124},[],"Uso",{"_3610":74548,"_31119":74532,"_21540":126126,"_5":14806,"_28300":126084,"_3066":126127},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3610":74549,"_31119":74532,"_21540":126129,"_5":14806,"_28300":126084,"_3066":126130},[],"Revocación",{"_3610":74550,"_31119":74532,"_21540":126132,"_5":14806,"_28300":126084,"_3066":126133},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3610":74551,"_31119":74532,"_21540":126135,"_5":14806,"_28300":126084,"_3066":126136},[],"Autorización",{"_3610":74552,"_31119":74532,"_21540":126138,"_5":14806,"_28300":126084,"_3066":126139},[],"La aplicación permite la acción a esa identidad.",{"_3610":74553,"_31119":74532,"_21540":126141,"_5":14806,"_28300":126084,"_3066":126142},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3610":74554,"_31119":74532,"_21540":126144,"_5":14806,"_28300":126088,"_3066":126145},[],"Mecanismo",{"_3610":74555,"_31119":74532,"_21540":126147,"_5":14806,"_28300":126088,"_3066":126148},[],"Cuándo utilizarlo",{"_3610":74556,"_31119":74532,"_21540":126150,"_5":14806,"_28300":126088,"_3066":126151},[],"Qué debes mantener",{"_3610":74557,"_31119":74532,"_21540":126153,"_5":14806,"_28300":126088,"_3066":57207},[],{"_3610":74558,"_31119":74532,"_21540":126155,"_5":14806,"_28300":126088,"_3066":126156},[],"Consulta del estado de un certificado concreto.",{"_3610":74559,"_31119":74532,"_21540":126158,"_5":14806,"_28300":126088,"_3066":126159},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3610":74560,"_31119":74532,"_21540":126161,"_5":14806,"_28300":126088,"_3066":57216},[],{"_3610":74561,"_31119":74532,"_21540":126163,"_5":14806,"_28300":126088,"_3066":126164},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3610":74562,"_31119":74532,"_21540":126166,"_5":14806,"_28300":126088,"_3066":126167},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3610":74563,"_31119":74532,"_21540":126169,"_5":14806,"_28300":126088,"_3066":126170},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3610":74564,"_31119":74532,"_21540":126172,"_5":14806,"_28300":126088,"_3066":126173},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3610":74565,"_31119":74532,"_21540":126175,"_5":14806,"_28300":126092,"_3066":126176},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3610":74566,"_31119":74532,"_21540":126178,"_5":14806,"_28300":126092,"_3066":126179},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3610":74567,"_31119":74532,"_21540":126181,"_5":14806,"_28300":126092,"_3066":126182},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3610":74568,"_31119":74532,"_21540":126184,"_5":14806,"_28300":126092,"_3066":126185},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3610":74569,"_31119":74532,"_21540":126187,"_5":14806,"_28300":126092,"_3066":126188},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3610":74570,"_31119":74532,"_21540":126190,"_5":14806,"_28300":126092,"_3066":126191},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3610":74571,"_31119":74532,"_21540":126193,"_5":14806,"_28300":126092,"_3066":126194},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3610":74572,"_31119":74532,"_21540":126196,"_5":14806,"_28300":126092,"_3066":126197},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3610":74573,"_31119":74532,"_21540":126199,"_5":14806,"_28300":126092,"_3066":126200},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3610":74574,"_31119":74574,"_5":15171,"_3066":126202,"_31457":126203,"_21540":126204,"_28300":74574},"Certificados",[50802,121414,56480,125428],[],{"_3610":74575,"_31119":74574,"_21540":126206,"_5":14806,"_28300":74574,"_3066":126207},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3610":74576,"_31119":74574,"_5":31454,"_21540":126209,"_28300":126210,"_3066":126211},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3610":74577,"_31119":74574,"_5":31454,"_21540":126213,"_28300":126214,"_3066":126215},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3610":74578,"_31119":74574,"_5":31454,"_21540":126217,"_28300":126218,"_3066":126219},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3610":74579,"_31119":74574,"_5":31454,"_21540":126221,"_28300":126222,"_3066":126223},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3610":74580,"_31119":74574,"_5":31454,"_21540":126225,"_28300":126226,"_3066":126227},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3610":74581,"_31119":74574,"_5":31454,"_21540":126229,"_28300":126230,"_3066":126231},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3610":74582,"_31119":74574,"_5":31454,"_21540":126233,"_28300":126234,"_3066":126235},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3610":74583,"_31119":74574,"_5":31454,"_21540":126237,"_28300":126238,"_3066":126239},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3610":74584,"_31119":74574,"_5":31454,"_21540":126241,"_28300":126242,"_3066":126243},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3610":74585,"_31119":74574,"_21540":126245,"_5":14806,"_28300":74574,"_3066":126246},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3610":74586,"_31119":74574,"_21540":126248,"_5":14806,"_28300":126210,"_3066":126249},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3610":74587,"_31119":74574,"_21540":126251,"_5":14806,"_28300":126210,"_3066":126252},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3610":74588,"_31119":74574,"_21540":126254,"_5":14806,"_28300":126210,"_3066":126255},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3610":74589,"_31119":74574,"_21540":126257,"_5":14806,"_28300":126210,"_3066":126258},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3610":74590,"_31119":74574,"_21540":126260,"_5":14806,"_28300":126210,"_3066":126261},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3610":74591,"_31119":74574,"_21540":126263,"_5":14806,"_28300":126210,"_3066":126264},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3610":74592,"_31119":74574,"_21540":126266,"_5":14806,"_28300":126210,"_3066":126267},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3610":74593,"_31119":74574,"_21540":126269,"_5":14806,"_28300":126214,"_3066":126270},[],"Descarga el PEM e inspecciónalo:",{"_3610":74594,"_31119":74574,"_21540":126272,"_5":14806,"_28300":126214,"_3066":126273},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3610":74595,"_31119":74574,"_21540":126275,"_5":14806,"_28300":126218,"_3066":126276},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3610":74596,"_31119":74574,"_21540":126278,"_5":14806,"_28300":126218,"_3066":126279},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3610":74597,"_31119":74574,"_21540":126281,"_5":14806,"_28300":126218,"_3066":126282},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3610":74598,"_31119":74574,"_21540":126284,"_5":14806,"_28300":126218,"_3066":126285},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3610":74599,"_31119":74574,"_21540":126287,"_5":14806,"_28300":126218,"_3066":126288},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3610":74600,"_31119":74574,"_21540":126290,"_5":14806,"_28300":126218,"_3066":126291},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3610":74601,"_31119":74574,"_21540":126293,"_5":14806,"_28300":126218,"_3066":126294},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3610":74602,"_31119":74574,"_21540":126296,"_5":14806,"_28300":126222,"_3066":126297},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3610":74603,"_31119":74574,"_21540":126299,"_5":14806,"_28300":126226,"_3066":126300},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3610":74604,"_31119":74574,"_21540":126302,"_5":14806,"_28300":126230,"_3066":126303},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3610":74605,"_31119":74574,"_21540":126305,"_5":14806,"_28300":126234,"_3066":126306},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3610":74606,"_31119":74574,"_21540":126308,"_5":14806,"_28300":126234,"_3066":126309},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3610":74607,"_31119":74574,"_21540":126311,"_5":14806,"_28300":126234,"_3066":126312},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3610":74608,"_31119":74574,"_21540":126314,"_5":14806,"_28300":126238,"_3066":126315},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3610":74609,"_31119":74574,"_21540":126317,"_5":14806,"_28300":126238,"_3066":126318},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3610":74610,"_31119":74574,"_21540":126320,"_5":14806,"_28300":126238,"_3066":126321},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3610":74611,"_31119":74574,"_21540":126323,"_5":14806,"_28300":126242,"_3066":126324},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3610":74612,"_31119":74574,"_21540":126326,"_5":14806,"_28300":126242,"_3066":126327},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3610":74613,"_31119":74613,"_5":15171,"_3066":126329,"_31457":126330,"_21540":126332,"_28300":74613},"Ciclo de vida de un certificado",[50802,121414,56480,126331],"Conceptos",[],{"_3610":74614,"_31119":74613,"_21540":126334,"_5":14806,"_28300":74613,"_3066":126335},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3610":74615,"_31119":74613,"_5":31454,"_21540":126337,"_28300":126338,"_3066":126339},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3610":74616,"_31119":74613,"_5":31454,"_21540":126341,"_28300":126342,"_3066":126343},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3610":74617,"_31119":74613,"_5":31454,"_21540":126345,"_28300":126346,"_3066":126347},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3610":74618,"_31119":74613,"_5":31454,"_21540":126349,"_28300":126350,"_3066":126351},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3610":74619,"_31119":74613,"_5":31454,"_21540":126353,"_28300":126354,"_3066":126355},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3610":74620,"_31119":74613,"_5":31454,"_21540":126357,"_28300":126358,"_3066":126359},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3610":74621,"_31119":74613,"_5":31454,"_21540":126361,"_28300":126362,"_3066":124051},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3610":74622,"_31119":74613,"_5":31454,"_21540":126364,"_28300":126365,"_3066":126366},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3610":74623,"_31119":74613,"_5":31454,"_21540":126368,"_28300":126369,"_3066":126370},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3610":74624,"_31119":74613,"_5":31454,"_21540":126372,"_28300":126373,"_3066":126374},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3610":74625,"_31119":74613,"_21540":126376,"_5":14806,"_28300":74613,"_3066":126377},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3610":74626,"_31119":74613,"_21540":126379,"_5":14806,"_28300":126342,"_3066":126380},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3610":74627,"_31119":74613,"_21540":126382,"_5":14806,"_28300":126346,"_3066":126383},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3610":74628,"_31119":74613,"_21540":126385,"_5":14806,"_28300":126350,"_3066":126386},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3610":74629,"_31119":74613,"_21540":126388,"_5":14806,"_28300":126354,"_3066":126389},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3610":74630,"_31119":74613,"_21540":126391,"_5":14806,"_28300":126358,"_3066":126392},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3610":74631,"_31119":74613,"_21540":126394,"_5":14806,"_28300":126362,"_3066":126395},[],"Lamassu persiste cuatro estados X.509:",{"_3610":74632,"_31119":74613,"_21540":126397,"_5":14806,"_28300":126362,"_3066":126398},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3610":74633,"_31119":74613,"_21540":126400,"_5":14806,"_28300":126362,"_3066":126401},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3610":74634,"_31119":74613,"_21540":126403,"_5":14806,"_28300":126362,"_3066":126404},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3610":74635,"_31119":74613,"_21540":126406,"_5":14806,"_28300":126362,"_3066":126407},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3610":74636,"_31119":74613,"_21540":126409,"_5":14806,"_28300":126362,"_3066":126410},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3610":74637,"_31119":74613,"_21540":126412,"_5":14806,"_28300":126365,"_3066":126413},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3610":74638,"_31119":74613,"_21540":126415,"_5":14806,"_28300":126365,"_3066":126416},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3610":74639,"_31119":74613,"_21540":126418,"_5":14806,"_28300":126365,"_3066":126419},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3610":74640,"_31119":74613,"_21540":126421,"_5":14806,"_28300":126369,"_3066":126422},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3610":74641,"_31119":74613,"_21540":126424,"_5":14806,"_28300":126369,"_3066":126425},[],"Antes de confirmar:",{"_3610":74642,"_31119":74613,"_21540":126427,"_5":14806,"_28300":126369,"_3066":126428},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3610":74643,"_31119":74613,"_21540":126430,"_5":14806,"_28300":126369,"_3066":126431},[],"Distribuye la nueva cadena de confianza.",{"_3610":74644,"_31119":74613,"_21540":126433,"_5":14806,"_28300":126369,"_3066":126434},[],"Reemite las identidades necesarias.",{"_3610":74645,"_31119":74613,"_21540":126436,"_5":14806,"_28300":126369,"_3066":126437},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3610":74646,"_31119":74613,"_21540":126439,"_5":14806,"_28300":126369,"_3066":126440},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3610":74647,"_31119":74613,"_21540":126442,"_5":14806,"_28300":126369,"_3066":126443},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3610":74648,"_31119":74613,"_21540":126445,"_5":14806,"_28300":126373,"_3066":126446},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3610":74649,"_31119":74613,"_21540":126448,"_5":14806,"_28300":126373,"_3066":126449},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3610":74650,"_31119":74613,"_21540":126451,"_5":14806,"_28300":126373,"_3066":126452},[],"Cambios de estado y razones de revocación.",{"_3610":74651,"_31119":74613,"_21540":126454,"_5":14806,"_28300":126373,"_3066":126455},[],"Publicación y vigencia de OCSP y CRLs.",{"_3610":74652,"_31119":74613,"_21540":126457,"_5":14806,"_28300":126373,"_3066":126458},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3610":74653,"_31119":74613,"_21540":126460,"_5":14806,"_28300":126373,"_3066":126461},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3610":74654,"_31119":74654,"_5":15171,"_3066":126463,"_31457":126464,"_21540":126465,"_28300":74654},"Modelo de confianza",[50802,121414,56480,126331],[],{"_3610":74655,"_31119":74654,"_21540":126467,"_5":14806,"_28300":74654,"_3066":126468},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3610":74656,"_31119":74654,"_5":31454,"_21540":126470,"_28300":126471,"_3066":126472},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3610":74657,"_31119":74654,"_5":31454,"_21540":126474,"_28300":126475,"_3066":126476},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3610":74658,"_31119":74654,"_5":31454,"_21540":126478,"_28300":126479,"_3066":126480},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3610":74659,"_31119":74654,"_5":31454,"_21540":126482,"_28300":126483,"_3066":126484},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3610":74660,"_31119":74654,"_5":31454,"_21540":126486,"_28300":126487,"_3066":126488},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3610":74661,"_31119":74654,"_5":31454,"_21540":126490,"_28300":126491,"_3066":126492},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3610":74662,"_31119":74654,"_5":31454,"_21540":126494,"_28300":126495,"_3066":126496},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3610":74663,"_31119":74654,"_5":31454,"_21540":126498,"_28300":126499,"_3066":126500},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3610":74664,"_31119":74654,"_5":31454,"_21540":126502,"_28300":126503,"_3066":126504},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3610":74665,"_31119":74654,"_5":31454,"_21540":126506,"_28300":126507,"_3066":126508},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3610":74666,"_31119":74654,"_21540":126510,"_5":14806,"_28300":74654,"_3066":126511},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3610":74667,"_31119":74654,"_21540":126513,"_5":14806,"_28300":126475,"_3066":126514},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3610":74668,"_31119":74654,"_21540":126516,"_5":14806,"_28300":126479,"_3066":126517},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3610":74669,"_31119":74654,"_21540":126519,"_5":14806,"_28300":126483,"_3066":126520},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3610":74670,"_31119":74654,"_21540":126522,"_5":14806,"_28300":126487,"_3066":126523},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3610":74671,"_31119":74654,"_21540":126525,"_5":14806,"_28300":126491,"_3066":126526},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3610":74672,"_31119":74654,"_21540":126528,"_5":14806,"_28300":126491,"_3066":126529},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3610":74673,"_31119":74654,"_21540":126531,"_5":14806,"_28300":126491,"_3066":126532},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3610":74674,"_31119":74654,"_21540":126534,"_5":14806,"_28300":126491,"_3066":126535},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3610":74675,"_31119":74654,"_21540":126537,"_5":14806,"_28300":126491,"_3066":126538},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3610":74676,"_31119":74654,"_21540":126540,"_5":14806,"_28300":126491,"_3066":126541},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3610":74677,"_31119":74654,"_21540":126543,"_5":14806,"_28300":126495,"_3066":126544},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3610":74678,"_31119":74654,"_21540":126546,"_5":14806,"_28300":126495,"_3066":126547},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3610":74679,"_31119":74654,"_21540":126549,"_5":14806,"_28300":126495,"_3066":126550},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3610":74680,"_31119":74654,"_21540":126552,"_5":14806,"_28300":126495,"_3066":126553},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3610":74681,"_31119":74654,"_21540":126555,"_5":14806,"_28300":126495,"_3066":126556},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3610":74682,"_31119":74654,"_21540":126558,"_5":14806,"_28300":126499,"_3066":126559},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3610":74683,"_31119":74654,"_21540":126561,"_5":14806,"_28300":126499,"_3066":126562},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3610":74684,"_31119":74654,"_21540":126564,"_5":14806,"_28300":126499,"_3066":126565},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3610":74685,"_31119":74654,"_21540":126567,"_5":14806,"_28300":126499,"_3066":126568},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3610":74686,"_31119":74654,"_21540":126570,"_5":14806,"_28300":126499,"_3066":126571},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3610":74687,"_31119":74654,"_21540":126573,"_5":14806,"_28300":126499,"_3066":126574},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3610":74688,"_31119":74654,"_21540":126576,"_5":14806,"_28300":126499,"_3066":126577},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3610":74689,"_31119":74654,"_21540":126579,"_5":14806,"_28300":126503,"_3066":126580},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3610":74690,"_31119":74654,"_21540":126582,"_5":14806,"_28300":126507,"_3066":126583},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3610":74691,"_31119":74654,"_21540":126585,"_5":14806,"_28300":126507,"_3066":126586},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3610":74692,"_31119":74654,"_21540":126588,"_5":14806,"_28300":126507,"_3066":126589},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3610":74693,"_31119":74654,"_21540":126591,"_5":14806,"_28300":126507,"_3066":126592},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3610":74694,"_31119":74654,"_21540":126594,"_5":14806,"_28300":126507,"_3066":126595},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3610":74695,"_31119":74654,"_21540":126597,"_5":14806,"_28300":126507,"_3066":126598},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3610":74696,"_31119":74654,"_21540":126600,"_5":14806,"_28300":126507,"_3066":126601},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3610":74697,"_31119":74697,"_5":15171,"_3066":126603,"_31457":126604,"_21540":126605,"_28300":74697},"Listas de revocación (CRL)",[50802,121414,56480,126077],[],{"_3610":74698,"_31119":74697,"_21540":126607,"_5":14806,"_28300":74697,"_3066":126608},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3610":74699,"_31119":74697,"_5":31454,"_21540":126610,"_28300":126611,"_3066":126612},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3610":74700,"_31119":74697,"_5":31454,"_21540":126614,"_28300":126615,"_3066":126616},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3610":74701,"_31119":74697,"_5":31454,"_21540":126618,"_28300":126619,"_3066":126620},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3610":74702,"_31119":74697,"_5":31454,"_21540":126622,"_28300":126623,"_3066":126624},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3610":74703,"_31119":74697,"_5":31454,"_21540":126626,"_28300":126627,"_3066":126628},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3610":74704,"_31119":74697,"_5":31454,"_21540":126630,"_28300":126631,"_3066":126632},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3610":74705,"_31119":74697,"_5":31454,"_21540":126634,"_28300":126635,"_3066":126636},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3610":74706,"_31119":74697,"_5":31454,"_21540":126638,"_28300":126639,"_3066":126640},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3610":74707,"_31119":74697,"_21540":126642,"_5":14806,"_28300":74697,"_3066":126643},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3610":74708,"_31119":74697,"_21540":126645,"_5":14806,"_28300":126611,"_3066":126646},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3610":74709,"_31119":74697,"_21540":126648,"_5":14806,"_28300":126611,"_3066":126649},[],"Campo",{"_3610":74710,"_31119":74697,"_21540":126651,"_5":14806,"_28300":126611,"_3066":123091},[],{"_3610":74711,"_31119":74697,"_21540":126653,"_5":14806,"_28300":126611,"_3066":52434},[],{"_3610":74712,"_31119":74697,"_21540":126655,"_5":14806,"_28300":126611,"_3066":126656},[],"ID de la CA a la que pertenecen los ajustes.",{"_3610":74713,"_31119":74697,"_21540":126658,"_5":14806,"_28300":126611,"_3066":57715},[],{"_3610":74714,"_31119":74697,"_21540":126660,"_5":14806,"_28300":126611,"_3066":126661},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3610":74715,"_31119":74697,"_21540":126663,"_5":14806,"_28300":126611,"_3066":57721},[],{"_3610":74716,"_31119":74697,"_21540":126665,"_5":14806,"_28300":126611,"_3066":126666},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3610":74717,"_31119":74697,"_21540":126668,"_5":14806,"_28300":126611,"_3066":57727},[],{"_3610":74718,"_31119":74697,"_21540":126670,"_5":14806,"_28300":126611,"_3066":126671},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3610":74719,"_31119":74697,"_21540":126673,"_5":14806,"_28300":126611,"_3066":126674},[],"Campo de `crl_options`",{"_3610":74720,"_31119":74697,"_21540":126676,"_5":14806,"_28300":126611,"_3066":123091},[],{"_3610":74721,"_31119":74697,"_21540":126678,"_5":14806,"_28300":126611,"_3066":126679},[],"Valor inicial",{"_3610":74722,"_31119":74697,"_21540":126681,"_5":14806,"_28300":126611,"_3066":57741},[],{"_3610":74723,"_31119":74697,"_21540":126683,"_5":14806,"_28300":126611,"_3066":126684},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3610":74724,"_31119":74697,"_21540":126686,"_5":14806,"_28300":126611,"_3066":126687},[],"7 días.",{"_3610":74725,"_31119":74697,"_21540":126689,"_5":14806,"_28300":126611,"_3066":57750},[],{"_3610":74726,"_31119":74697,"_21540":126691,"_5":14806,"_28300":126611,"_3066":126692},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3610":74727,"_31119":74697,"_21540":126694,"_5":14806,"_28300":126611,"_3066":126695},[],"6 días y 23 horas.",{"_3610":74728,"_31119":74697,"_21540":126697,"_5":14806,"_28300":126611,"_3066":57759},[],{"_3610":74729,"_31119":74697,"_21540":126699,"_5":14806,"_28300":126611,"_3066":126700},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3610":74730,"_31119":74697,"_21540":126702,"_5":14806,"_28300":126611,"_3066":57765},[],{"_3610":74731,"_31119":74697,"_21540":126704,"_5":14806,"_28300":126611,"_3066":57768},[],{"_3610":74732,"_31119":74697,"_21540":126706,"_5":14806,"_28300":126611,"_3066":126707},[],"Número de serie del certificado existente que firma la CRL.",{"_3610":74733,"_31119":74697,"_21540":126709,"_5":14806,"_28300":126611,"_3066":126710},[],"Número de serie del certificado actual de la CA.",{"_3610":74734,"_31119":74697,"_21540":126712,"_5":14806,"_28300":126611,"_3066":126713},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3610":74735,"_31119":74697,"_21540":126715,"_5":14806,"_28300":126611,"_3066":126716},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3610":74736,"_31119":74697,"_21540":126718,"_5":14806,"_28300":126611,"_3066":126719},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3610":74737,"_31119":74697,"_21540":126721,"_5":14806,"_28300":126611,"_3066":126722},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3610":74738,"_31119":74697,"_21540":126724,"_5":14806,"_28300":126611,"_3066":126725},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3610":74739,"_31119":74697,"_21540":126727,"_5":14806,"_28300":126611,"_3066":126728},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3610":74740,"_31119":74697,"_21540":126730,"_5":14806,"_28300":126611,"_3066":126731},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3610":74741,"_31119":74697,"_21540":126733,"_5":14806,"_28300":126611,"_3066":126734},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3610":74742,"_31119":74697,"_21540":126736,"_5":14806,"_28300":126611,"_3066":126737},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3610":74743,"_31119":74697,"_21540":126739,"_5":14806,"_28300":126611,"_3066":126740},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3610":74744,"_31119":74697,"_21540":126742,"_5":14806,"_28300":126611,"_3066":126743},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3610":74745,"_31119":74697,"_21540":126745,"_5":14806,"_28300":126615,"_3066":126746},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3610":74746,"_31119":74697,"_21540":126748,"_5":14806,"_28300":126615,"_3066":126749},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3610":74747,"_31119":74697,"_21540":126751,"_5":14806,"_28300":126615,"_3066":126752},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3610":74748,"_31119":74697,"_21540":126754,"_5":14806,"_28300":126615,"_3066":126755},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3610":74749,"_31119":74697,"_21540":126757,"_5":14806,"_28300":126619,"_3066":126758},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3610":74750,"_31119":74697,"_21540":126760,"_5":14806,"_28300":126619,"_3066":126761},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3610":74751,"_31119":74697,"_21540":126763,"_5":14806,"_28300":126619,"_3066":126764},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3610":74752,"_31119":74697,"_21540":126766,"_5":14806,"_28300":126619,"_3066":126767},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3610":74753,"_31119":74697,"_21540":126769,"_5":14806,"_28300":126619,"_3066":126770},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3610":74754,"_31119":74697,"_21540":126772,"_5":14806,"_28300":126619,"_3066":126773},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3610":74755,"_31119":74697,"_21540":126775,"_5":14806,"_28300":126619,"_3066":126776},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3610":74756,"_31119":74697,"_21540":126778,"_5":14806,"_28300":126619,"_3066":126779},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3610":74757,"_31119":74697,"_21540":126781,"_5":14806,"_28300":126619,"_3066":126782},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3610":74758,"_31119":74697,"_21540":126784,"_5":14806,"_28300":126623,"_3066":126785},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3610":74759,"_31119":74697,"_21540":126787,"_5":14806,"_28300":126623,"_3066":126788},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3610":74760,"_31119":74697,"_21540":126790,"_5":14806,"_28300":126627,"_3066":126791},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3610":74761,"_31119":74697,"_21540":126793,"_5":14806,"_28300":126627,"_3066":126794},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3610":74762,"_31119":74697,"_21540":126796,"_5":14806,"_28300":126627,"_3066":126797},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3610":74763,"_31119":74697,"_21540":126799,"_5":14806,"_28300":126627,"_3066":126800},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3610":74764,"_31119":74697,"_21540":126802,"_5":14806,"_28300":126627,"_3066":126803},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3610":74765,"_31119":74697,"_21540":126805,"_5":14806,"_28300":126631,"_3066":126806},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3610":74766,"_31119":74697,"_21540":126808,"_5":14806,"_28300":126631,"_3066":123280},[],{"_3610":74767,"_31119":74697,"_21540":126810,"_5":14806,"_28300":126631,"_3066":126811},[],"Path relativo",{"_3610":74768,"_31119":74697,"_21540":126813,"_5":14806,"_28300":126631,"_3066":121174},[],{"_3610":74769,"_31119":74697,"_21540":126815,"_5":14806,"_28300":126631,"_3066":57880},[],{"_3610":74770,"_31119":74697,"_21540":126817,"_5":14806,"_28300":126631,"_3066":57883},[],{"_3610":74771,"_31119":74697,"_21540":126819,"_5":14806,"_28300":126631,"_3066":126820},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3610":74772,"_31119":74697,"_21540":126822,"_5":14806,"_28300":126631,"_3066":57880},[],{"_3610":74773,"_31119":74697,"_21540":126824,"_5":14806,"_28300":126631,"_3066":57891},[],{"_3610":74774,"_31119":74697,"_21540":126826,"_5":14806,"_28300":126631,"_3066":126827},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3610":74775,"_31119":74697,"_21540":126829,"_5":14806,"_28300":126631,"_3066":57897},[],{"_3610":74776,"_31119":74697,"_21540":126831,"_5":14806,"_28300":126631,"_3066":57891},[],{"_3610":74777,"_31119":74697,"_21540":126833,"_5":14806,"_28300":126631,"_3066":126834},[],"Sustituir la configuración de CRL de una CA.",{"_3610":74778,"_31119":74697,"_21540":126836,"_5":14806,"_28300":126631,"_3066":57905},[],{"_3610":74779,"_31119":74697,"_21540":126838,"_5":14806,"_28300":126631,"_3066":57891},[],{"_3610":74780,"_31119":74697,"_21540":126840,"_5":14806,"_28300":126631,"_3066":126841},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3610":74781,"_31119":74697,"_21540":126843,"_5":14806,"_28300":126631,"_3066":126844},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3610":74782,"_31119":74697,"_21540":126846,"_5":14806,"_28300":126631,"_3066":126847},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3610":74783,"_31119":74697,"_21540":126849,"_5":14806,"_28300":126631,"_3066":126850},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3610":74784,"_31119":74697,"_21540":126852,"_5":14806,"_28300":126635,"_3066":126853},[],"Síntoma",{"_3610":74785,"_31119":74697,"_21540":126855,"_5":14806,"_28300":126635,"_3066":126856},[],"Causa",{"_3610":74786,"_31119":74697,"_21540":126858,"_5":14806,"_28300":126635,"_3066":126859},[],"Acción",{"_3610":74787,"_31119":74697,"_21540":126861,"_5":14806,"_28300":126635,"_3066":126862},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3610":74788,"_31119":74697,"_21540":126864,"_5":14806,"_28300":126635,"_3066":126865},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3610":74789,"_31119":74697,"_21540":126867,"_5":14806,"_28300":126635,"_3066":126868},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3610":74790,"_31119":74697,"_21540":126870,"_5":14806,"_28300":126635,"_3066":126871},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3610":74791,"_31119":74697,"_21540":126873,"_5":14806,"_28300":126635,"_3066":126874},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3610":74792,"_31119":74697,"_21540":126876,"_5":14806,"_28300":126635,"_3066":126877},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3610":74793,"_31119":74697,"_21540":126879,"_5":14806,"_28300":126635,"_3066":126880},[],"`PUT` devuelve 400.",{"_3610":74794,"_31119":74697,"_21540":126882,"_5":14806,"_28300":126635,"_3066":126883},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3610":74795,"_31119":74697,"_21540":126885,"_5":14806,"_28300":126635,"_3066":126886},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3610":74796,"_31119":74697,"_21540":126888,"_5":14806,"_28300":126635,"_3066":126889},[],"`PUT` devuelve 404.",{"_3610":74797,"_31119":74697,"_21540":126891,"_5":14806,"_28300":126635,"_3066":126892},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3610":74798,"_31119":74697,"_21540":126894,"_5":14806,"_28300":126635,"_3066":126895},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3610":74799,"_31119":74697,"_21540":126897,"_5":14806,"_28300":126635,"_3066":126898},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3610":74800,"_31119":74697,"_21540":126900,"_5":14806,"_28300":126635,"_3066":126901},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3610":74801,"_31119":74697,"_21540":126903,"_5":14806,"_28300":126635,"_3066":126904},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3610":74802,"_31119":74697,"_21540":126906,"_5":14806,"_28300":126635,"_3066":126907},[],"La CRL no cambia tras revocar un certificado.",{"_3610":74803,"_31119":74697,"_21540":126909,"_5":14806,"_28300":126635,"_3066":126910},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3610":74804,"_31119":74697,"_21540":126912,"_5":14806,"_28300":126635,"_3066":126913},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3610":74805,"_31119":74697,"_21540":126915,"_5":14806,"_28300":126635,"_3066":126916},[],"Un verificador rechaza la CRL por el emisor.",{"_3610":74806,"_31119":74697,"_21540":126918,"_5":14806,"_28300":126635,"_3066":126919},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3610":74807,"_31119":74697,"_21540":126921,"_5":14806,"_28300":126635,"_3066":126922},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3610":74808,"_31119":74697,"_21540":126924,"_5":14806,"_28300":126639,"_3066":126925},[],"RFC 5280: perfil X.509 y CRL.",{"_3610":74809,"_31119":74697,"_21540":126927,"_5":14806,"_28300":126639,"_3066":57997},[],{"_3610":74810,"_31119":74697,"_21540":126929,"_5":14806,"_28300":126639,"_3066":58000},[],{"_3610":74811,"_31119":74697,"_21540":126931,"_5":14806,"_28300":126639,"_3066":126932},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3610":74812,"_31119":74697,"_21540":126934,"_5":14806,"_28300":126639,"_3066":126935},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3610":74813,"_31119":74813,"_5":15171,"_3066":126937,"_31457":126938,"_21540":126939,"_28300":74813},"Claves y motores criptográficos",[50802,121414,56480,125428],[],{"_3610":74814,"_31119":74813,"_21540":126941,"_5":14806,"_28300":74813,"_3066":126942},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3610":74815,"_31119":74813,"_5":31454,"_21540":126944,"_28300":126945,"_3066":126946},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3610":74816,"_31119":74813,"_5":31454,"_21540":126948,"_28300":126949,"_3066":126950},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3610":74817,"_31119":74813,"_5":31454,"_21540":126952,"_28300":126953,"_3066":58025},[],"/docs/es/platform/pki/key-management#file-system",{"_3610":74818,"_31119":74813,"_5":31454,"_21540":126955,"_28300":126956,"_3066":58029},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3610":74819,"_31119":74813,"_5":31454,"_21540":126958,"_28300":126959,"_3066":58033},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3610":74820,"_31119":74813,"_5":31454,"_21540":126961,"_28300":126962,"_3066":58037},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3610":74821,"_31119":74813,"_5":31454,"_21540":126964,"_28300":126965,"_3066":58041},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3610":74822,"_31119":74813,"_5":31454,"_21540":126967,"_28300":126968,"_3066":58045},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3610":74823,"_31119":74813,"_5":31454,"_21540":126970,"_28300":126971,"_3066":126972},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3610":74824,"_31119":74813,"_5":31454,"_21540":126974,"_28300":126975,"_3066":126976},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3610":74825,"_31119":74813,"_5":31454,"_21540":126978,"_28300":126979,"_3066":126980},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3610":74826,"_31119":74813,"_5":31454,"_21540":126982,"_28300":126983,"_3066":126984},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3610":74827,"_31119":74813,"_5":31454,"_21540":126986,"_28300":126987,"_3066":126988},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3610":74828,"_31119":74813,"_5":31454,"_21540":126990,"_28300":126991,"_3066":126992},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3610":74829,"_31119":74813,"_5":31454,"_21540":126994,"_28300":126995,"_3066":126996},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3610":74830,"_31119":74813,"_5":31454,"_21540":126998,"_28300":126999,"_3066":58077},[],"/docs/es/platform/pki/key-management#sign",{"_3610":74831,"_31119":74813,"_5":31454,"_21540":127001,"_28300":127002,"_3066":58081},[],"/docs/es/platform/pki/key-management#verify",{"_3610":74832,"_31119":74813,"_5":31454,"_21540":127004,"_28300":127005,"_3066":127006},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3610":74833,"_31119":74813,"_5":31454,"_21540":127008,"_28300":127009,"_3066":127010},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3610":74834,"_31119":74813,"_5":31454,"_21540":127012,"_28300":127013,"_3066":127014},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3610":74835,"_31119":74813,"_21540":127016,"_5":14806,"_28300":74813,"_3066":127017},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3610":74836,"_31119":74813,"_21540":127019,"_5":14806,"_28300":74813,"_3066":127020},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3610":74837,"_31119":74813,"_21540":127022,"_5":14806,"_28300":126945,"_3066":127023},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3610":74838,"_31119":74813,"_21540":127025,"_5":14806,"_28300":126945,"_3066":127026},[],"En la práctica, permite:",{"_3610":74839,"_31119":74813,"_21540":127028,"_5":14806,"_28300":126945,"_3066":127029},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3610":74840,"_31119":74813,"_21540":127031,"_5":14806,"_28300":126945,"_3066":127032},[],"Importar claves creadas externamente.",{"_3610":74841,"_31119":74813,"_21540":127034,"_5":14806,"_28300":126945,"_3066":127035},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3610":74842,"_31119":74813,"_21540":127037,"_5":14806,"_28300":126945,"_3066":127038},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3610":74843,"_31119":74813,"_21540":127040,"_5":14806,"_28300":126949,"_3066":127041},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3610":74844,"_31119":74813,"_21540":127043,"_5":14806,"_28300":126949,"_3066":127044},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3610":74845,"_31119":74813,"_21540":127046,"_5":14806,"_28300":126949,"_3066":127047},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3610":74846,"_31119":74813,"_21540":127049,"_5":14806,"_28300":126953,"_3066":127050},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3610":74847,"_31119":74813,"_21540":127052,"_5":14806,"_28300":126956,"_3066":127053},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3610":74848,"_31119":74813,"_21540":127055,"_5":14806,"_28300":126956,"_3066":127056},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3610":74849,"_31119":74813,"_21540":127058,"_5":14806,"_28300":126959,"_3066":127059},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3610":74850,"_31119":74813,"_21540":127061,"_5":14806,"_28300":126962,"_3066":127062},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3610":74851,"_31119":74813,"_21540":127064,"_5":14806,"_28300":126965,"_3066":127065},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3610":74852,"_31119":74813,"_21540":127067,"_5":14806,"_28300":126968,"_3066":127068},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3610":74853,"_31119":74813,"_21540":127070,"_5":14806,"_28300":126968,"_3066":127071},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3610":74854,"_31119":74813,"_21540":127073,"_5":14806,"_28300":126968,"_3066":127074},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3610":74855,"_31119":74813,"_21540":127076,"_5":14806,"_28300":126968,"_3066":127077},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3610":74856,"_31119":74813,"_21540":127079,"_5":14806,"_28300":126971,"_3066":127080},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3610":74857,"_31119":74813,"_21540":127082,"_5":14806,"_28300":126971,"_3066":127083},[],"La tabla incluye los siguientes campos:",{"_3610":74858,"_31119":74813,"_21540":127085,"_5":14806,"_28300":126971,"_3066":127086},[],"**Name**: nombre descriptivo de la clave.",{"_3610":74859,"_31119":74813,"_21540":127088,"_5":14806,"_28300":126971,"_3066":127089},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3610":74860,"_31119":74813,"_21540":127091,"_5":14806,"_28300":126971,"_3066":127092},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3610":74861,"_31119":74813,"_21540":127094,"_5":14806,"_28300":126971,"_3066":127095},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3610":74862,"_31119":74813,"_21540":127097,"_5":14806,"_28300":126971,"_3066":127098},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3610":74863,"_31119":74813,"_21540":127100,"_5":14806,"_28300":126971,"_3066":127101},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3610":74864,"_31119":74813,"_21540":127103,"_5":14806,"_28300":126971,"_3066":127104},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3610":74865,"_31119":74813,"_21540":127106,"_5":14806,"_28300":126971,"_3066":127107},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3610":74866,"_31119":74813,"_21540":127109,"_5":14806,"_28300":126971,"_3066":127110},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3610":74867,"_31119":74813,"_21540":127112,"_5":14806,"_28300":126971,"_3066":127113},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3610":74868,"_31119":74813,"_21540":127115,"_5":14806,"_28300":126971,"_3066":127116},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3610":74869,"_31119":74813,"_21540":127118,"_5":14806,"_28300":126971,"_3066":127119},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3610":74870,"_31119":74813,"_21540":127121,"_5":14806,"_28300":126971,"_3066":127122},[],"**Delete Key** para eliminar la clave del sistema.",{"_3610":74871,"_31119":74813,"_21540":127124,"_5":14806,"_28300":126975,"_3066":127125},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3610":74872,"_31119":74813,"_21540":127127,"_5":14806,"_28300":126979,"_3066":127128},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3610":74873,"_31119":74813,"_21540":127130,"_5":14806,"_28300":126979,"_3066":127131},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3610":74874,"_31119":74813,"_21540":127133,"_5":14806,"_28300":126979,"_3066":127134},[],"**Key Name**: nombre único y descriptivo.",{"_3610":74875,"_31119":74813,"_21540":127136,"_5":14806,"_28300":126979,"_3066":127137},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3610":74876,"_31119":74813,"_21540":127139,"_5":14806,"_28300":126979,"_3066":127140},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3610":74877,"_31119":74813,"_21540":127142,"_5":14806,"_28300":126979,"_3066":127143},[],"**Tags**: metadatos para clasificar la clave.",{"_3610":74878,"_31119":74813,"_21540":127145,"_5":14806,"_28300":126979,"_3066":127146},[],"**Metadata**: información adicional para usos avanzados.",{"_3610":74879,"_31119":74813,"_21540":127148,"_5":14806,"_28300":126983,"_3066":127149},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3610":74880,"_31119":74813,"_21540":127151,"_5":14806,"_28300":126983,"_3066":127152},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3610":74881,"_31119":74813,"_21540":127154,"_5":14806,"_28300":126983,"_3066":127155},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3610":74882,"_31119":74813,"_21540":127157,"_5":14806,"_28300":126983,"_3066":127158},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3610":74883,"_31119":74813,"_21540":127160,"_5":14806,"_28300":126983,"_3066":127161},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3610":74884,"_31119":74813,"_21540":127163,"_5":14806,"_28300":126983,"_3066":127164},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3610":74885,"_31119":74813,"_21540":127166,"_5":14806,"_28300":126983,"_3066":127167},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3610":74886,"_31119":74813,"_21540":127169,"_5":14806,"_28300":126983,"_3066":127170},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3610":74887,"_31119":74813,"_21540":127172,"_5":14806,"_28300":126983,"_3066":127173},[],"**Metadata**: información adicional opcional.",{"_3610":74888,"_31119":74813,"_21540":127175,"_5":14806,"_28300":126983,"_3066":127176},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3610":74889,"_31119":74813,"_21540":127178,"_5":14806,"_28300":126983,"_3066":127179},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3610":74890,"_31119":74813,"_21540":127181,"_5":14806,"_28300":126987,"_3066":127182},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3610":74891,"_31119":74813,"_21540":127184,"_5":14806,"_28300":126991,"_3066":127185},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3610":74892,"_31119":74813,"_21540":127187,"_5":14806,"_28300":126991,"_3066":127188},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3610":74893,"_31119":74813,"_21540":127190,"_5":14806,"_28300":126991,"_3066":127191},[],"**Key Name**: nombre descriptivo.",{"_3610":74894,"_31119":74813,"_21540":127193,"_5":14806,"_28300":126991,"_3066":127194},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3610":74895,"_31119":74813,"_21540":127196,"_5":14806,"_28300":126991,"_3066":127197},[],"**Tags**: etiquetas asociadas.",{"_3610":74896,"_31119":74813,"_21540":127199,"_5":14806,"_28300":126991,"_3066":127200},[],"**Aliases**: nombres alternativos.",{"_3610":74897,"_31119":74813,"_21540":127202,"_5":14806,"_28300":126991,"_3066":127203},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3610":74898,"_31119":74813,"_21540":127205,"_5":14806,"_28300":126991,"_3066":127206},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3610":74899,"_31119":74813,"_21540":127208,"_5":14806,"_28300":126991,"_3066":127209},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3610":74900,"_31119":74813,"_21540":127211,"_5":14806,"_28300":126991,"_3066":127212},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3610":74901,"_31119":74813,"_21540":127214,"_5":14806,"_28300":126995,"_3066":127215},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3610":74902,"_31119":74813,"_21540":127217,"_5":14806,"_28300":126995,"_3066":127218},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3610":74903,"_31119":74813,"_21540":127220,"_5":14806,"_28300":126995,"_3066":127221},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3610":74904,"_31119":74813,"_21540":127223,"_5":14806,"_28300":126999,"_3066":127224},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3610":74905,"_31119":74813,"_21540":127226,"_5":14806,"_28300":126999,"_3066":127227},[],"Campos principales:",{"_3610":74906,"_31119":74813,"_21540":127229,"_5":14806,"_28300":126999,"_3066":127230},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3610":74907,"_31119":74813,"_21540":127232,"_5":14806,"_28300":126999,"_3066":127233},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3610":74908,"_31119":74813,"_21540":127235,"_5":14806,"_28300":126999,"_3066":127236},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3610":74909,"_31119":74813,"_21540":127238,"_5":14806,"_28300":126999,"_3066":127239},[],"**Message**: contenido que se va a firmar.",{"_3610":74910,"_31119":74813,"_21540":127241,"_5":14806,"_28300":126999,"_3066":127242},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3610":74911,"_31119":74813,"_21540":127244,"_5":14806,"_28300":127002,"_3066":127245},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3610":74912,"_31119":74813,"_21540":127247,"_5":14806,"_28300":127002,"_3066":127227},[],{"_3610":74913,"_31119":74813,"_21540":127249,"_5":14806,"_28300":127002,"_3066":127250},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3610":74914,"_31119":74813,"_21540":127252,"_5":14806,"_28300":127002,"_3066":127253},[],"**Message Type**: `Raw` o `Digest`.",{"_3610":74915,"_31119":74813,"_21540":127255,"_5":14806,"_28300":127002,"_3066":127256},[],"**Payload Encoding**: codificación del mensaje.",{"_3610":74916,"_31119":74813,"_21540":127258,"_5":14806,"_28300":127002,"_3066":127259},[],"**Message**: mensaje original o hash.",{"_3610":74917,"_31119":74813,"_21540":127261,"_5":14806,"_28300":127002,"_3066":127262},[],"**Signature**: firma que se desea comprobar.",{"_3610":74918,"_31119":74813,"_21540":127264,"_5":14806,"_28300":127002,"_3066":127265},[],"**Result**: indicador del resultado de la validación.",{"_3610":74919,"_31119":74813,"_21540":127267,"_5":14806,"_28300":127005,"_3066":127268},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3610":74920,"_31119":74813,"_21540":127270,"_5":14806,"_28300":127005,"_3066":127271},[],"Este flujo es útil para:",{"_3610":74921,"_31119":74813,"_21540":127273,"_5":14806,"_28300":127005,"_3066":127274},[],"Solicitar certificados a una CA externa.",{"_3610":74922,"_31119":74813,"_21540":127276,"_5":14806,"_28300":127005,"_3066":127277},[],"Renovar una identidad manteniendo la misma clave.",{"_3610":74923,"_31119":74813,"_21540":127279,"_5":14806,"_28300":127005,"_3066":127280},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3610":74924,"_31119":74813,"_21540":127282,"_5":14806,"_28300":127005,"_3066":127283},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3610":74925,"_31119":74813,"_21540":127285,"_5":14806,"_28300":127005,"_3066":127286},[],"**Organization (O)**: organización o empresa.",{"_3610":74926,"_31119":74813,"_21540":127288,"_5":14806,"_28300":127005,"_3066":127289},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3610":74927,"_31119":74813,"_21540":127291,"_5":14806,"_28300":127005,"_3066":127292},[],"**Country (C)**: código de país de dos letras.",{"_3610":74928,"_31119":74813,"_21540":127294,"_5":14806,"_28300":127005,"_3066":127295},[],"**State / Province (ST)**: estado o provincia.",{"_3610":74929,"_31119":74813,"_21540":127297,"_5":14806,"_28300":127005,"_3066":127298},[],"**Locality (L)**: ciudad o localidad.",{"_3610":74930,"_31119":74813,"_21540":127300,"_5":14806,"_28300":127005,"_3066":127301},[],"**Email Address**: correo de contacto.",{"_3610":74931,"_31119":74813,"_21540":127303,"_5":14806,"_28300":127005,"_3066":127304},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3610":74932,"_31119":74813,"_21540":127306,"_5":14806,"_28300":127005,"_3066":127307},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3610":74933,"_31119":74813,"_21540":127309,"_5":14806,"_28300":127009,"_3066":127310},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3610":74934,"_31119":74813,"_21540":127312,"_5":14806,"_28300":127009,"_3066":127313},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3610":74935,"_31119":74813,"_21540":127315,"_5":14806,"_28300":127013,"_3066":127316},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3610":74936,"_31119":74813,"_21540":127318,"_5":14806,"_28300":127013,"_3066":127319},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3610":74937,"_31119":74937,"_5":15171,"_3066":127321,"_31457":127322,"_21540":127323,"_28300":74937},"Validación online con OCSP",[50802,121414,56480,126077],[],{"_3610":74938,"_31119":74937,"_21540":127325,"_5":14806,"_28300":74937,"_3066":127326},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3610":74939,"_31119":74937,"_5":31454,"_21540":127328,"_28300":127329,"_3066":127330},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3610":74940,"_31119":74937,"_5":31454,"_21540":127332,"_28300":127333,"_3066":127334},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3610":74941,"_31119":74937,"_5":31454,"_21540":127336,"_28300":127337,"_3066":127338},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3610":74942,"_31119":74937,"_5":31454,"_21540":127340,"_28300":127341,"_3066":127342},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3610":74943,"_31119":74937,"_5":31454,"_21540":127344,"_28300":127345,"_3066":127346},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3610":74944,"_31119":74937,"_5":31454,"_21540":127348,"_28300":127349,"_3066":126640},[],"/docs/es/platform/pki/ocsp#referencias",{"_3610":74945,"_31119":74937,"_21540":127351,"_5":14806,"_28300":74937,"_3066":127352},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3610":74946,"_31119":74937,"_21540":127354,"_5":14806,"_28300":127329,"_3066":127355},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3610":74947,"_31119":74937,"_21540":127357,"_5":14806,"_28300":127329,"_3066":127358},[],"Estado del registro",{"_3610":74948,"_31119":74937,"_21540":127360,"_5":14806,"_28300":127329,"_3066":127361},[],"Respuesta firmada",{"_3610":74949,"_31119":74937,"_21540":127363,"_5":14806,"_28300":127329,"_3066":55617},[],{"_3610":74950,"_31119":74937,"_21540":127365,"_5":14806,"_28300":127329,"_3066":58445},[],{"_3610":74951,"_31119":74937,"_21540":127367,"_5":14806,"_28300":127329,"_3066":55634},[],{"_3610":74952,"_31119":74937,"_21540":127369,"_5":14806,"_28300":127329,"_3066":127370},[],"`Revoked`, con razón y fecha de revocación.",{"_3610":74953,"_31119":74937,"_21540":127372,"_5":14806,"_28300":127329,"_3066":127373},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3610":74954,"_31119":74937,"_21540":127375,"_5":14806,"_28300":127329,"_3066":127376},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3610":74955,"_31119":74937,"_21540":127378,"_5":14806,"_28300":127329,"_3066":127379},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3610":74956,"_31119":74937,"_21540":127381,"_5":14806,"_28300":127329,"_3066":127382},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3610":74957,"_31119":74937,"_21540":127384,"_5":14806,"_28300":127329,"_3066":127385},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3610":74958,"_31119":74937,"_21540":127387,"_5":14806,"_28300":127333,"_3066":127388},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3610":74959,"_31119":74937,"_21540":127390,"_5":14806,"_28300":127333,"_3066":127391},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3610":74960,"_31119":74937,"_21540":127393,"_5":14806,"_28300":127337,"_3066":127394},[],"El servicio acepta:",{"_3610":74961,"_31119":74937,"_21540":127396,"_5":14806,"_28300":127337,"_3066":123280},[],{"_3610":74962,"_31119":74937,"_21540":127398,"_5":14806,"_28300":127337,"_3066":127399},[],"Ruta del servicio VA",{"_3610":74963,"_31119":74937,"_21540":127401,"_5":14806,"_28300":127337,"_3066":127402},[],"Formato",{"_3610":74964,"_31119":74937,"_21540":127404,"_5":14806,"_28300":127337,"_3066":58485},[],{"_3610":74965,"_31119":74937,"_21540":127406,"_5":14806,"_28300":127337,"_3066":58488},[],{"_3610":74966,"_31119":74937,"_21540":127408,"_5":14806,"_28300":127337,"_3066":127409},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3610":74967,"_31119":74937,"_21540":127411,"_5":14806,"_28300":127337,"_3066":57880},[],{"_3610":74968,"_31119":74937,"_21540":127413,"_5":14806,"_28300":127337,"_3066":58496},[],{"_3610":74969,"_31119":74937,"_21540":127415,"_5":14806,"_28300":127337,"_3066":127416},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3610":74970,"_31119":74937,"_21540":127418,"_5":14806,"_28300":127337,"_3066":127419},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3610":74971,"_31119":74937,"_21540":127421,"_5":14806,"_28300":127341,"_3066":127422},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3610":74972,"_31119":74937,"_21540":127424,"_5":14806,"_28300":127341,"_3066":127425},[],"Genera la solicitud:",{"_3610":74973,"_31119":74937,"_21540":127427,"_5":14806,"_28300":127341,"_3066":127428},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3610":74974,"_31119":74937,"_21540":127430,"_5":14806,"_28300":127341,"_3066":127431},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3610":74975,"_31119":74937,"_21540":127433,"_5":14806,"_28300":127341,"_3066":127434},[],"Verifica el DER recibido:",{"_3610":74976,"_31119":74937,"_21540":127436,"_5":14806,"_28300":127341,"_3066":127437},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3610":74977,"_31119":74937,"_21540":127439,"_5":14806,"_28300":127345,"_3066":127440},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3610":74978,"_31119":74937,"_21540":127442,"_5":14806,"_28300":127345,"_3066":127443},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3610":74979,"_31119":74937,"_21540":127445,"_5":14806,"_28300":127349,"_3066":58529},[],{"_3610":74980,"_31119":74937,"_21540":127447,"_5":14806,"_28300":127349,"_3066":58532},[],{"_3610":74981,"_31119":74937,"_21540":127449,"_5":14806,"_28300":127349,"_3066":127450},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3610":74982,"_31119":74937,"_21540":127452,"_5":14806,"_28300":127349,"_3066":126935},[],{"_3610":74983,"_31119":74983,"_5":15171,"_3066":56480,"_31457":127454,"_21540":127455,"_28300":74983},[50802,121414,56480],[],{"_3610":74984,"_31119":74983,"_21540":127457,"_5":14806,"_28300":74983,"_3066":127458},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3610":74985,"_31119":74983,"_5":31454,"_21540":127460,"_28300":127461,"_3066":124754},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3610":74986,"_31119":74983,"_5":31454,"_21540":127463,"_28300":127464,"_3066":127465},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3610":74987,"_31119":74983,"_5":31454,"_21540":127467,"_28300":127468,"_3066":125274},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3610":74988,"_31119":74983,"_5":31454,"_21540":127470,"_28300":127471,"_3066":125278},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3610":74989,"_31119":74983,"_5":31454,"_21540":127473,"_28300":127474,"_3066":125282},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3610":74990,"_31119":74983,"_5":31454,"_21540":127476,"_28300":127477,"_3066":125286},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3610":74991,"_31119":74983,"_5":31454,"_21540":127479,"_28300":127480,"_3066":125294},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3610":74992,"_31119":74983,"_5":31454,"_21540":127482,"_28300":127483,"_3066":127484},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3610":74993,"_31119":74983,"_5":31454,"_21540":127486,"_28300":127487,"_3066":126243},[],"/docs/es/platform/pki/overview#continúa",{"_3610":74994,"_31119":74983,"_21540":127489,"_5":14806,"_28300":74983,"_3066":127490},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3610":74995,"_31119":74983,"_21540":127492,"_5":14806,"_28300":127461,"_3066":127493},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3610":74996,"_31119":74983,"_21540":127495,"_5":14806,"_28300":127461,"_3066":127496},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3610":74997,"_31119":74983,"_21540":127498,"_5":14806,"_28300":127464,"_3066":127499},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3610":74998,"_31119":74983,"_21540":127501,"_5":14806,"_28300":127464,"_3066":127502},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3610":74999,"_31119":74983,"_21540":127504,"_5":14806,"_28300":127464,"_3066":127505},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3610":75000,"_31119":74983,"_21540":127507,"_5":14806,"_28300":127464,"_3066":127508},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3610":75001,"_31119":74983,"_21540":127510,"_5":14806,"_28300":127464,"_3066":127511},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3610":75002,"_31119":74983,"_21540":127513,"_5":14806,"_28300":127471,"_3066":127514},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3610":75003,"_31119":74983,"_21540":127516,"_5":14806,"_28300":127474,"_3066":127517},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3610":75004,"_31119":74983,"_21540":127519,"_5":14806,"_28300":127477,"_3066":127520},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3610":75005,"_31119":74983,"_21540":127522,"_5":14806,"_28300":127480,"_3066":127523},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3610":75006,"_31119":74983,"_21540":127525,"_5":14806,"_28300":127483,"_3066":127526},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3610":75007,"_31119":74983,"_21540":127528,"_5":14806,"_28300":127483,"_3066":127529},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3610":75008,"_31119":74983,"_21540":127531,"_5":14806,"_28300":127483,"_3066":127532},[],"su clave pública corresponda a la clave privada del cliente;",{"_3610":75009,"_31119":74983,"_21540":127534,"_5":14806,"_28300":127483,"_3066":127535},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3610":75010,"_31119":74983,"_21540":127537,"_5":14806,"_28300":127483,"_3066":127538},[],"sus fechas y usos permitan la operación;",{"_3610":75011,"_31119":74983,"_21540":127540,"_5":14806,"_28300":127483,"_3066":127541},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3610":75012,"_31119":74983,"_21540":127543,"_5":14806,"_28300":127483,"_3066":127544},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3610":75013,"_31119":74983,"_21540":127546,"_5":14806,"_28300":127487,"_3066":127547},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3610":75014,"_31119":74983,"_21540":127549,"_5":14806,"_28300":127487,"_3066":127550},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3610":75015,"_31119":74983,"_21540":127552,"_5":14806,"_28300":127487,"_3066":127553},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3610":75016,"_31119":75016,"_5":15171,"_3066":127555,"_31457":127556,"_21540":127557,"_28300":75016},"Crea tu primera CA",[50802,121414,56480,124878],[],{"_3610":75017,"_31119":75016,"_21540":127559,"_5":14806,"_28300":75016,"_3066":127560},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3610":75018,"_31119":75016,"_5":31454,"_21540":127562,"_28300":127563,"_3066":119948},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3610":75019,"_31119":75016,"_5":31454,"_21540":127565,"_28300":127566,"_3066":127567},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3610":75020,"_31119":75016,"_5":31454,"_21540":127569,"_28300":127570,"_3066":127571},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3610":75021,"_31119":75016,"_5":31454,"_21540":127573,"_28300":127574,"_3066":127575},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3610":75022,"_31119":75016,"_5":31454,"_21540":127577,"_28300":127578,"_3066":127579},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3610":75023,"_31119":75016,"_5":31454,"_21540":127581,"_28300":127582,"_3066":127583},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3610":75024,"_31119":75016,"_5":31454,"_21540":127585,"_28300":127586,"_3066":127587},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3610":75025,"_31119":75016,"_5":31454,"_21540":127589,"_28300":127590,"_3066":125125},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3610":75026,"_31119":75016,"_5":31454,"_21540":127592,"_28300":127593,"_3066":119972},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3610":75027,"_31119":75016,"_21540":127595,"_5":14806,"_28300":75016,"_3066":127596},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3610":75028,"_31119":75016,"_21540":127598,"_5":14806,"_28300":127563,"_3066":127599},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3610":75029,"_31119":75016,"_21540":127601,"_5":14806,"_28300":127563,"_3066":127602},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3610":75030,"_31119":75016,"_21540":127604,"_5":14806,"_28300":127563,"_3066":127605},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3610":75031,"_31119":75016,"_21540":127607,"_5":14806,"_28300":127563,"_3066":127608},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3610":75032,"_31119":75016,"_21540":127610,"_5":14806,"_28300":127566,"_3066":127611},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3610":75033,"_31119":75016,"_21540":127613,"_5":14806,"_28300":127566,"_3066":127614},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3610":75034,"_31119":75016,"_21540":127616,"_5":14806,"_28300":127570,"_3066":127617},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3610":75035,"_31119":75016,"_21540":127619,"_5":14806,"_28300":127570,"_3066":127620},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3610":75036,"_31119":75016,"_21540":127622,"_5":14806,"_28300":127574,"_3066":127623},[],"Selecciona **Root CA** y completa:",{"_3610":75037,"_31119":75016,"_21540":127625,"_5":14806,"_28300":127574,"_3066":58711},[],{"_3610":75038,"_31119":75016,"_21540":127627,"_5":14806,"_28300":127574,"_3066":127628},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3610":75039,"_31119":75016,"_21540":127630,"_5":14806,"_28300":127574,"_3066":127631},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3610":75040,"_31119":75016,"_21540":127633,"_5":14806,"_28300":127574,"_3066":127634},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3610":75041,"_31119":75016,"_21540":127636,"_5":14806,"_28300":127574,"_3066":127637},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3610":75042,"_31119":75016,"_21540":127639,"_5":14806,"_28300":127578,"_3066":127640},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3610":75043,"_31119":75016,"_21540":127642,"_5":14806,"_28300":127582,"_3066":127643},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3610":75044,"_31119":75016,"_21540":127645,"_5":14806,"_28300":127582,"_3066":127646},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3610":75045,"_31119":75016,"_21540":127648,"_5":14806,"_28300":127586,"_3066":127649},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3610":75046,"_31119":75016,"_21540":127651,"_5":14806,"_28300":127586,"_3066":127652},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3610":75047,"_31119":75016,"_21540":127654,"_5":14806,"_28300":127586,"_3066":127655},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3610":75048,"_31119":75016,"_21540":127657,"_5":14806,"_28300":127590,"_3066":127658},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3610":75049,"_31119":75016,"_21540":127660,"_5":14806,"_28300":127590,"_3066":127661},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3610":75050,"_31119":75016,"_21540":127663,"_5":14806,"_28300":127590,"_3066":127664},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3610":75051,"_31119":75016,"_21540":127666,"_5":14806,"_28300":127590,"_3066":127667},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3610":75052,"_31119":75016,"_21540":127669,"_5":14806,"_28300":127593,"_3066":127670},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3610":75053,"_31119":75053,"_5":15171,"_3066":127672,"_31457":127673,"_21540":127674,"_28300":75053},"Emite y verifica un certificado",[50802,121414,56480,124878],[],{"_3610":75054,"_31119":75053,"_21540":127676,"_5":14806,"_28300":75053,"_3066":127677},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3610":75055,"_31119":75053,"_5":31454,"_21540":127679,"_28300":127680,"_3066":119948},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3610":75056,"_31119":75053,"_5":31454,"_21540":127682,"_28300":127683,"_3066":127684},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3610":75057,"_31119":75053,"_5":31454,"_21540":127686,"_28300":127687,"_3066":127688},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3610":75058,"_31119":75053,"_5":31454,"_21540":127690,"_28300":127691,"_3066":127692},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3610":75059,"_31119":75053,"_5":31454,"_21540":127694,"_28300":127695,"_3066":127696},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3610":75060,"_31119":75053,"_5":31454,"_21540":127698,"_28300":127699,"_3066":127700},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3610":75061,"_31119":75053,"_5":31454,"_21540":127702,"_28300":127703,"_3066":127704},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3610":75062,"_31119":75053,"_5":31454,"_21540":127706,"_28300":127707,"_3066":127708},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3610":75063,"_31119":75053,"_5":31454,"_21540":127710,"_28300":127711,"_3066":127712},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3610":75064,"_31119":75053,"_5":31454,"_21540":127714,"_28300":127715,"_3066":127716},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3610":75065,"_31119":75053,"_5":31454,"_21540":127718,"_28300":127719,"_3066":125125},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3610":75066,"_31119":75053,"_5":31454,"_21540":127721,"_28300":127722,"_3066":119972},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3610":75067,"_31119":75053,"_21540":127724,"_5":14806,"_28300":75053,"_3066":127725},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3610":75068,"_31119":75053,"_21540":127727,"_5":14806,"_28300":127680,"_3066":127728},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3610":75069,"_31119":75053,"_21540":127730,"_5":14806,"_28300":127680,"_3066":127731},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3610":75070,"_31119":75053,"_21540":127733,"_5":14806,"_28300":127680,"_3066":127734},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3610":75071,"_31119":75053,"_21540":127736,"_5":14806,"_28300":127680,"_3066":127737},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3610":75072,"_31119":75053,"_21540":127739,"_5":14806,"_28300":127680,"_3066":127740},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3610":75073,"_31119":75053,"_21540":127742,"_5":14806,"_28300":127683,"_3066":127743},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3610":75074,"_31119":75053,"_21540":127745,"_5":14806,"_28300":127687,"_3066":127746},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3610":75075,"_31119":75053,"_21540":127748,"_5":14806,"_28300":127687,"_3066":127749},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3610":75076,"_31119":75053,"_21540":127751,"_5":14806,"_28300":127691,"_3066":127752},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3610":75077,"_31119":75053,"_21540":127754,"_5":14806,"_28300":127691,"_3066":127755},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3610":75078,"_31119":75053,"_21540":127757,"_5":14806,"_28300":127695,"_3066":127758},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3610":75079,"_31119":75053,"_21540":127760,"_5":14806,"_28300":127695,"_3066":127761},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3610":75080,"_31119":75053,"_21540":127763,"_5":14806,"_28300":127699,"_3066":127764},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3610":75081,"_31119":75053,"_21540":127766,"_5":14806,"_28300":127703,"_3066":127767},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3610":75082,"_31119":75053,"_21540":127769,"_5":14806,"_28300":127707,"_3066":127770},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3610":75083,"_31119":75053,"_21540":127772,"_5":14806,"_28300":127711,"_3066":127773},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3610":75084,"_31119":75053,"_21540":127775,"_5":14806,"_28300":127711,"_3066":127776},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3610":75085,"_31119":75053,"_21540":127778,"_5":14806,"_28300":127711,"_3066":127779},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3610":75086,"_31119":75053,"_21540":127781,"_5":14806,"_28300":127715,"_3066":127782},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3610":75087,"_31119":75053,"_21540":127784,"_5":14806,"_28300":127715,"_3066":127785},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3610":75088,"_31119":75053,"_21540":127787,"_5":14806,"_28300":127715,"_3066":127788},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3610":75089,"_31119":75053,"_21540":127790,"_5":14806,"_28300":127719,"_3066":125208},[],{"_3610":75090,"_31119":75053,"_21540":127792,"_5":14806,"_28300":127719,"_3066":123729},[],{"_3610":75091,"_31119":75053,"_21540":127794,"_5":14806,"_28300":127719,"_3066":127795},[],"La CA rechaza la emisión",{"_3610":75092,"_31119":75053,"_21540":127797,"_5":14806,"_28300":127719,"_3066":127798},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3610":75093,"_31119":75053,"_21540":127800,"_5":14806,"_28300":127719,"_3066":127801},[],"Sujeto o usos diferentes",{"_3610":75094,"_31119":75053,"_21540":127803,"_5":14806,"_28300":127719,"_3066":127804},[],"Perfil aplicado y valores solicitados.",{"_3610":75095,"_31119":75053,"_21540":127806,"_5":14806,"_28300":127719,"_3066":127807},[],"No se encuentra el emisor",{"_3610":75096,"_31119":75053,"_21540":127809,"_5":14806,"_28300":127719,"_3066":127810},[],"CA descargada y cadena intermedia necesaria.",{"_3610":75097,"_31119":75053,"_21540":127812,"_5":14806,"_28300":127719,"_3066":127813},[],"Falla la vigencia",{"_3610":75098,"_31119":75053,"_21540":127815,"_5":14806,"_28300":127719,"_3066":127816},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3610":75099,"_31119":75053,"_21540":127818,"_5":14806,"_28300":127719,"_3066":127819},[],"Los resúmenes de clave difieren",{"_3610":75100,"_31119":75053,"_21540":127821,"_5":14806,"_28300":127719,"_3066":127822},[],"Archivos de certificado y clave de la misma emisión.",{"_3610":75101,"_31119":75053,"_21540":127824,"_5":14806,"_28300":127719,"_3066":127825},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3610":75102,"_31119":75053,"_21540":127827,"_5":14806,"_28300":127722,"_3066":127828},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3610":75103,"_31119":75053,"_21540":127830,"_5":14806,"_28300":127722,"_3066":127831},[],"Gestionar certificados para inspección, estado y revocación.",{"_3610":75104,"_31119":75053,"_21540":127833,"_5":14806,"_28300":127722,"_3066":127834},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3610":75105,"_31119":75053,"_21540":127836,"_5":14806,"_28300":127722,"_3066":127837},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3610":75106,"_31119":75053,"_21540":127839,"_5":14806,"_28300":127722,"_3066":127840},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3610":75107,"_31119":75107,"_5":15171,"_3066":127842,"_31457":127843,"_21540":127844,"_28300":75107},"Primeros pasos de PKI",[50802,121414,56480,124878],[],{"_3610":75108,"_31119":75107,"_21540":127846,"_5":14806,"_28300":75107,"_3066":127847},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3610":75109,"_31119":75107,"_5":31454,"_21540":127849,"_28300":127850,"_3066":119948},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3610":75110,"_31119":75107,"_5":31454,"_21540":127852,"_28300":127853,"_3066":127854},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3610":75111,"_31119":75107,"_5":31454,"_21540":127856,"_28300":127857,"_3066":125060},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3610":75112,"_31119":75107,"_5":31454,"_21540":127859,"_28300":127860,"_3066":127861},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3610":75113,"_31119":75107,"_21540":127863,"_5":14806,"_28300":75107,"_3066":127864},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3610":75114,"_31119":75107,"_21540":127866,"_5":14806,"_28300":127850,"_3066":127867},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3610":75115,"_31119":75107,"_21540":127869,"_5":14806,"_28300":127850,"_3066":127870},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3610":75116,"_31119":75107,"_21540":127872,"_5":14806,"_28300":127850,"_3066":127873},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3610":75117,"_31119":75107,"_21540":127875,"_5":14806,"_28300":127850,"_3066":127876},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3610":75118,"_31119":75107,"_21540":127878,"_5":14806,"_28300":127850,"_3066":127879},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3610":75119,"_31119":75107,"_21540":127881,"_5":14806,"_28300":127853,"_3066":127882},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3610":75120,"_31119":75107,"_21540":127884,"_5":14806,"_28300":127853,"_3066":127885},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3610":75121,"_31119":75107,"_21540":127887,"_5":14806,"_28300":127853,"_3066":127888},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3610":75122,"_31119":75107,"_21540":127890,"_5":14806,"_28300":127853,"_3066":127891},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3610":75123,"_31119":75107,"_21540":127893,"_5":14806,"_28300":127857,"_3066":127894},[],"Archivo o recurso",{"_3610":75124,"_31119":75107,"_21540":127896,"_5":14806,"_28300":127857,"_3066":125057},[],{"_3610":75125,"_31119":75107,"_21540":127898,"_5":14806,"_28300":127857,"_3066":127899},[],"CA raíz activa y `ca.pem`",{"_3610":75126,"_31119":75107,"_21540":127901,"_5":14806,"_28300":127857,"_3066":127902},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3610":75127,"_31119":75107,"_21540":127904,"_5":14806,"_28300":127857,"_3066":127905},[],"Certificado final y `device.crt`",{"_3610":75128,"_31119":75107,"_21540":127907,"_5":14806,"_28300":127857,"_3066":127908},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3610":75129,"_31119":75107,"_21540":127910,"_5":14806,"_28300":127857,"_3066":127911},[],"Clave privada `device.key`",{"_3610":75130,"_31119":75107,"_21540":127913,"_5":14806,"_28300":127857,"_3066":127914},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3610":75131,"_31119":75107,"_21540":127916,"_5":14806,"_28300":127857,"_3066":127917},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3610":75132,"_31119":75107,"_21540":127919,"_5":14806,"_28300":127860,"_3066":127920},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3610":75133,"_31119":75107,"_21540":127922,"_5":14806,"_28300":127860,"_3066":127923},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3610":75134,"_31119":75107,"_21540":127925,"_5":14806,"_28300":127860,"_3066":127926},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3610":75135,"_31119":75135,"_5":15171,"_3066":127928,"_31457":127929,"_21540":127931,"_28300":75135},"Resolución de problemas PKI",[50802,121414,56480,127930],"Resolución de problemas",[],{"_3610":75136,"_31119":75135,"_21540":127933,"_5":14806,"_28300":75135,"_3066":127934},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3610":75137,"_31119":75135,"_5":31454,"_21540":127936,"_28300":127937,"_3066":127938},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3610":75138,"_31119":75135,"_5":31454,"_21540":127940,"_28300":127941,"_3066":127942},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3610":75139,"_31119":75135,"_5":31454,"_21540":127944,"_28300":127945,"_3066":127946},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3610":75140,"_31119":75135,"_21540":127948,"_5":14806,"_28300":75135,"_3066":127949},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3610":75141,"_31119":75135,"_21540":127951,"_5":14806,"_28300":75135,"_3066":127952},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3610":75142,"_31119":75135,"_21540":127954,"_5":14806,"_28300":127937,"_3066":125057},[],{"_3610":75143,"_31119":75135,"_21540":127956,"_5":14806,"_28300":127937,"_3066":123729},[],{"_3610":75144,"_31119":75135,"_21540":127958,"_5":14806,"_28300":127937,"_3066":119972},[],{"_3610":75145,"_31119":75135,"_21540":127960,"_5":14806,"_28300":127937,"_3066":55322},[],{"_3610":75146,"_31119":75135,"_21540":127962,"_5":14806,"_28300":127937,"_3066":127963},[],"Existe, está activa y sus fechas son utilizables.",{"_3610":75147,"_31119":75135,"_21540":127965,"_5":14806,"_28300":127937,"_3066":127966},[],"Autoridades.",{"_3610":75148,"_31119":75135,"_21540":127968,"_5":14806,"_28300":127937,"_3066":127969},[],"Clave",{"_3610":75149,"_31119":75135,"_21540":127971,"_5":14806,"_28300":127937,"_3066":127972},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3610":75150,"_31119":75135,"_21540":127974,"_5":14806,"_28300":127937,"_3066":127975},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3610":75151,"_31119":75135,"_21540":127977,"_5":14806,"_28300":127937,"_3066":59065},[],{"_3610":75152,"_31119":75135,"_21540":127979,"_5":14806,"_28300":127937,"_3066":127980},[],"PEM correcto y firma verificable.",{"_3610":75153,"_31119":75135,"_21540":127982,"_5":14806,"_28300":127937,"_3066":59071},[],{"_3610":75154,"_31119":75135,"_21540":127984,"_5":14806,"_28300":127937,"_3066":127985},[],"Perfil",{"_3610":75155,"_31119":75135,"_21540":127987,"_5":14806,"_28300":127937,"_3066":127988},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3610":75156,"_31119":75135,"_21540":127990,"_5":14806,"_28300":127937,"_3066":127991},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3610":75157,"_31119":75135,"_21540":127993,"_5":14806,"_28300":127937,"_3066":125208},[],{"_3610":75158,"_31119":75135,"_21540":127995,"_5":14806,"_28300":127937,"_3066":127996},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3610":75159,"_31119":75135,"_21540":127998,"_5":14806,"_28300":127937,"_3066":127999},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3610":75160,"_31119":75135,"_21540":128001,"_5":14806,"_28300":127937,"_3066":128002},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3610":75161,"_31119":75135,"_21540":128004,"_5":14806,"_28300":127937,"_3066":128005},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3610":75162,"_31119":75135,"_21540":128007,"_5":14806,"_28300":127937,"_3066":128008},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3610":75163,"_31119":75135,"_21540":128010,"_5":14806,"_28300":127941,"_3066":128011},[],"Revisa cada frontera por separado:",{"_3610":75164,"_31119":75135,"_21540":128013,"_5":14806,"_28300":127941,"_3066":128014},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3610":75165,"_31119":75135,"_21540":128016,"_5":14806,"_28300":127941,"_3066":128017},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3610":75166,"_31119":75135,"_21540":128019,"_5":14806,"_28300":127941,"_3066":128020},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3610":75167,"_31119":75135,"_21540":128022,"_5":14806,"_28300":127941,"_3066":128023},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3610":75168,"_31119":75135,"_21540":128025,"_5":14806,"_28300":127941,"_3066":128026},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3610":75169,"_31119":75135,"_21540":128028,"_5":14806,"_28300":127941,"_3066":128029},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3610":75170,"_31119":75135,"_21540":128031,"_5":14806,"_28300":127945,"_3066":128032},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3610":75171,"_31119":75135,"_21540":128034,"_5":14806,"_28300":127945,"_3066":128035},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3610":75172,"_31119":75172,"_5":15171,"_3066":128037,"_31457":128038,"_21540":128039,"_28300":75172},"Seguridad",[50802],[],{"_3610":75173,"_31119":75172,"_21540":128041,"_5":14806,"_28300":75172,"_3066":128042},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3610":75174,"_31119":75172,"_5":31454,"_21540":128044,"_28300":128045,"_3066":128046},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3610":75175,"_31119":75172,"_5":31454,"_21540":128048,"_28300":128049,"_3066":128050},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3610":75176,"_31119":75172,"_5":31454,"_21540":128052,"_28300":128053,"_3066":128054},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3610":75177,"_31119":75172,"_5":31454,"_21540":128056,"_28300":128057,"_3066":128058},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3610":75178,"_31119":75172,"_21540":128060,"_5":14806,"_28300":75172,"_3066":128061},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3610":75179,"_31119":75172,"_21540":128063,"_5":14806,"_28300":128045,"_3066":128064},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3610":75180,"_31119":75172,"_21540":128066,"_5":14806,"_28300":128045,"_3066":128067},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3610":75181,"_31119":75172,"_21540":128069,"_5":14806,"_28300":128045,"_3066":15445},[],{"_3610":75182,"_31119":75172,"_21540":128071,"_5":14806,"_28300":128045,"_3066":15374},[],{"_3610":75183,"_31119":75172,"_21540":128073,"_5":14806,"_28300":128045,"_3066":15432},[],{"_3610":75184,"_31119":75172,"_21540":128075,"_5":14806,"_28300":128045,"_3066":128076},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3610":75185,"_31119":75172,"_21540":128078,"_5":14806,"_28300":128045,"_3066":128079},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3610":75186,"_31119":75172,"_21540":128081,"_5":14806,"_28300":128049,"_3066":128082},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3610":75187,"_31119":75172,"_21540":128084,"_5":14806,"_28300":128049,"_3066":128085},[],"No incluyas en el reporte:",{"_3610":75188,"_31119":75172,"_21540":128087,"_5":14806,"_28300":128049,"_3066":128088},[],"Credenciales, tokens o claves privadas",{"_3610":75189,"_31119":75172,"_21540":128090,"_5":14806,"_28300":128049,"_3066":128091},[],"Datos de clientes o información identificable de clientes",{"_3610":75190,"_31119":75172,"_21540":128093,"_5":14806,"_28300":128049,"_3066":128094},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3610":75191,"_31119":75172,"_21540":128096,"_5":14806,"_28300":128053,"_3066":128097},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3610":75192,"_31119":75172,"_21540":128099,"_5":14806,"_28300":128053,"_3066":128100},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3610":75193,"_31119":75172,"_21540":128102,"_5":14806,"_28300":128057,"_3066":128103},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3610":75194,"_31119":75172,"_21540":128105,"_5":14806,"_28300":128057,"_3066":128106},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3610":75195,"_31119":75172,"_21540":128108,"_5":14806,"_28300":128057,"_3066":128109},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3610":75196,"_31119":75172,"_21540":128111,"_5":14806,"_28300":128057,"_3066":128112},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3610":75197,"_31119":75172,"_21540":128114,"_5":14806,"_28300":128057,"_3066":128115},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3610":75198,"_31119":75198,"_5":15171,"_3066":128117,"_31457":128118,"_21540":128120,"_28300":75198},"3.8.0 a 4.0.0",[50802,128119],"Actualizaciones",[],{"_3610":75199,"_31119":75198,"_21540":128122,"_5":14806,"_28300":75198,"_3066":128123},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3610":75200,"_31119":75198,"_5":31454,"_21540":128125,"_28300":128126,"_3066":128127},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3610":75201,"_31119":75198,"_5":31454,"_21540":128129,"_28300":128130,"_3066":128131},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3610":75202,"_31119":75198,"_5":31454,"_21540":128133,"_28300":128134,"_3066":128135},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3610":75203,"_31119":75198,"_5":31454,"_21540":128137,"_28300":128138,"_3066":128139},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3610":75204,"_31119":75198,"_5":31454,"_21540":128141,"_28300":128142,"_3066":128143},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3610":75205,"_31119":75198,"_5":31454,"_21540":128145,"_28300":128146,"_3066":128147},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3610":75206,"_31119":75198,"_5":31454,"_21540":128149,"_28300":128150,"_3066":59240},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3610":75207,"_31119":75198,"_5":31454,"_21540":128152,"_28300":128153,"_3066":128154},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3610":75208,"_31119":75198,"_5":31454,"_21540":128156,"_28300":128157,"_3066":128158},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3610":75209,"_31119":75198,"_5":31454,"_21540":128160,"_28300":128161,"_3066":128162},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3610":75210,"_31119":75198,"_5":31454,"_21540":128164,"_28300":128165,"_3066":120543},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3610":75211,"_31119":75198,"_5":31454,"_21540":128167,"_28300":128168,"_3066":128169},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3610":75212,"_31119":75198,"_5":31454,"_21540":128171,"_28300":128172,"_3066":128173},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3610":75213,"_31119":75198,"_5":31454,"_21540":128175,"_28300":128176,"_3066":128177},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3610":75214,"_31119":75198,"_5":31454,"_21540":128179,"_28300":128180,"_3066":128181},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3610":75215,"_31119":75198,"_5":31454,"_21540":128183,"_28300":128184,"_3066":128185},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3610":75216,"_31119":75198,"_5":31454,"_21540":128187,"_28300":128188,"_3066":128189},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3610":75217,"_31119":75198,"_5":31454,"_21540":128191,"_28300":128192,"_3066":128193},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3610":75218,"_31119":75198,"_5":31454,"_21540":128195,"_28300":128196,"_3066":128197},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3610":75219,"_31119":75198,"_5":31454,"_21540":128199,"_28300":128200,"_3066":128201},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3610":75220,"_31119":75198,"_5":31454,"_21540":128203,"_28300":128204,"_3066":128205},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3610":75221,"_31119":75198,"_5":31454,"_21540":128207,"_28300":128208,"_3066":128209},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3610":75222,"_31119":75198,"_5":31454,"_21540":128211,"_28300":128212,"_3066":128213},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3610":75223,"_31119":75198,"_5":31454,"_21540":128215,"_28300":128216,"_3066":128217},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3610":75224,"_31119":75198,"_5":31454,"_21540":128219,"_28300":128220,"_3066":128221},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3610":75225,"_31119":75198,"_5":31454,"_21540":128223,"_28300":128224,"_3066":128225},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3610":75226,"_31119":75198,"_5":31454,"_21540":128227,"_28300":128228,"_3066":128229},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3610":75227,"_31119":75198,"_5":31454,"_21540":128231,"_28300":128232,"_3066":128233},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3610":75228,"_31119":75198,"_5":31454,"_21540":128235,"_28300":128236,"_3066":128237},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3610":75229,"_31119":75198,"_5":31454,"_21540":128239,"_28300":128240,"_3066":128241},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3610":75230,"_31119":75198,"_5":31454,"_21540":128243,"_28300":128244,"_3066":128245},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3610":75231,"_31119":75198,"_5":31454,"_21540":128247,"_28300":128248,"_3066":128249},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3610":75232,"_31119":75198,"_5":31454,"_21540":128251,"_28300":128252,"_3066":128253},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3610":75233,"_31119":75198,"_5":31454,"_21540":128255,"_28300":128256,"_3066":128257},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3610":75234,"_31119":75198,"_5":31454,"_21540":128259,"_28300":128260,"_3066":128261},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3610":75235,"_31119":75198,"_5":31454,"_21540":128263,"_28300":128264,"_3066":128265},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3610":75236,"_31119":75198,"_5":31454,"_21540":128267,"_28300":128268,"_3066":128269},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3610":75237,"_31119":75198,"_5":31454,"_21540":128271,"_28300":128272,"_3066":128273},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3610":75238,"_31119":75198,"_5":31454,"_21540":128275,"_28300":128276,"_3066":128277},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3610":75239,"_31119":75198,"_5":31454,"_21540":128279,"_28300":128280,"_3066":128281},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3610":75240,"_31119":75198,"_5":31454,"_21540":128283,"_28300":128284,"_3066":128285},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3610":75241,"_31119":75198,"_5":31454,"_21540":128287,"_28300":128288,"_3066":128289},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3610":75242,"_31119":75198,"_5":31454,"_21540":128291,"_28300":128292,"_3066":128293},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3610":75243,"_31119":75198,"_5":31454,"_21540":128295,"_28300":128296,"_3066":124071},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3610":75244,"_31119":75198,"_5":31454,"_21540":128298,"_28300":128299,"_3066":128300},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3610":75245,"_31119":75198,"_5":31454,"_21540":128302,"_28300":128303,"_3066":128304},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3610":75246,"_31119":75198,"_21540":128306,"_5":14806,"_28300":75198,"_3066":128307},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3610":75247,"_31119":75198,"_21540":128309,"_5":14806,"_28300":75198,"_3066":128310},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3610":75248,"_31119":75198,"_21540":128312,"_5":14806,"_28300":75198,"_3066":128313},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3610":75249,"_31119":75198,"_21540":128315,"_5":14806,"_28300":75198,"_3066":128316},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3610":75250,"_31119":75198,"_21540":128318,"_5":14806,"_28300":75198,"_3066":128319},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3610":75251,"_31119":75198,"_21540":128321,"_5":14806,"_28300":75198,"_3066":128322},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3610":75252,"_31119":75198,"_21540":128324,"_5":14806,"_28300":75198,"_3066":128325},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3610":75253,"_31119":75198,"_21540":128327,"_5":14806,"_28300":128130,"_3066":128328},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3610":75254,"_31119":75198,"_21540":128330,"_5":14806,"_28300":128130,"_3066":128331},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3610":75255,"_31119":75198,"_21540":128333,"_5":14806,"_28300":128134,"_3066":128334},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3610":75256,"_31119":75198,"_21540":128336,"_5":14806,"_28300":128134,"_3066":128337},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3610":75257,"_31119":75198,"_21540":128339,"_5":14806,"_28300":128138,"_3066":128340},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3610":75258,"_31119":75198,"_21540":128342,"_5":14806,"_28300":128142,"_3066":128343},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3610":75259,"_31119":75198,"_21540":128345,"_5":14806,"_28300":128142,"_3066":128346},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3610":75260,"_31119":75198,"_21540":128348,"_5":14806,"_28300":128142,"_3066":128349},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3610":75261,"_31119":75198,"_21540":128351,"_5":14806,"_28300":128142,"_3066":128352},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3610":75262,"_31119":75198,"_21540":128354,"_5":14806,"_28300":128142,"_3066":128355},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3610":75263,"_31119":75198,"_21540":128357,"_5":14806,"_28300":128146,"_3066":128358},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3610":75264,"_31119":75198,"_21540":128360,"_5":14806,"_28300":128146,"_3066":128361},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3610":75265,"_31119":75198,"_21540":128363,"_5":14806,"_28300":128146,"_3066":128364},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3610":75266,"_31119":75198,"_21540":128366,"_5":14806,"_28300":128146,"_3066":128367},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3610":75267,"_31119":75198,"_21540":128369,"_5":14806,"_28300":128146,"_3066":128370},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3610":75268,"_31119":75198,"_21540":128372,"_5":14806,"_28300":128146,"_3066":128373},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3610":75269,"_31119":75198,"_21540":128375,"_5":14806,"_28300":128150,"_3066":128376},[],"Cambio",{"_3610":75270,"_31119":75198,"_21540":128378,"_5":14806,"_28300":128150,"_3066":128379},[],"A quién afecta",{"_3610":75271,"_31119":75198,"_21540":128381,"_5":14806,"_28300":128150,"_3066":128382},[],"Gravedad",{"_3610":75272,"_31119":75198,"_21540":128384,"_5":14806,"_28300":128150,"_3066":126859},[],{"_3610":75273,"_31119":75198,"_21540":128386,"_5":14806,"_28300":128150,"_3066":128158},[],{"_3610":75274,"_31119":75198,"_21540":128388,"_5":14806,"_28300":128150,"_3066":128389},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3610":75275,"_31119":75198,"_21540":128391,"_5":14806,"_28300":128150,"_3066":128392},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3610":75276,"_31119":75198,"_21540":128394,"_5":14806,"_28300":128150,"_3066":128395},[],"Copiar los datos a los volúmenes nuevos",{"_3610":75277,"_31119":75198,"_21540":128397,"_5":14806,"_28300":128150,"_3066":128162},[],{"_3610":75278,"_31119":75198,"_21540":128399,"_5":14806,"_28300":128150,"_3066":128400},[],"Todas las releases de Helm",{"_3610":75279,"_31119":75198,"_21540":128402,"_5":14806,"_28300":128150,"_3066":128403},[],"Alta: `helm upgrade` falla",{"_3610":75280,"_31119":75198,"_21540":128405,"_5":14806,"_28300":128150,"_3066":128406},[],"Eliminar o renombrar las claves heredadas",{"_3610":75281,"_31119":75198,"_21540":128408,"_5":14806,"_28300":128150,"_3066":120543},[],{"_3610":75282,"_31119":75198,"_21540":128410,"_5":14806,"_28300":128150,"_3066":128400},[],{"_3610":75283,"_31119":75198,"_21540":128412,"_5":14806,"_28300":128150,"_3066":128413},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3610":75284,"_31119":75198,"_21540":128415,"_5":14806,"_28300":128150,"_3066":128416},[],"Crear primero los Secrets; consulta el paso 2",{"_3610":75285,"_31119":75198,"_21540":128418,"_5":14806,"_28300":128150,"_3066":128169},[],{"_3610":75286,"_31119":75198,"_21540":128420,"_5":14806,"_28300":128150,"_3066":128421},[],"Todos los despliegues",{"_3610":75287,"_31119":75198,"_21540":128423,"_5":14806,"_28300":128150,"_3066":128424},[],"Alta: sin principal de bootstrap no hay administrador",{"_3610":75288,"_31119":75198,"_21540":128426,"_5":14806,"_28300":128150,"_3066":128427},[],"Configurar `services.authz`",{"_3610":75289,"_31119":75198,"_21540":128429,"_5":14806,"_28300":128150,"_3066":128173},[],{"_3610":75290,"_31119":75198,"_21540":128431,"_5":14806,"_28300":128150,"_3066":128400},[],{"_3610":75291,"_31119":75198,"_21540":128433,"_5":14806,"_28300":128150,"_3066":128434},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3610":75292,"_31119":75198,"_21540":128436,"_5":14806,"_28300":128150,"_3066":128437},[],"Mover JWKS y roles a `services.authz`",{"_3610":75293,"_31119":75198,"_21540":128439,"_5":14806,"_28300":128150,"_3066":128193},[],{"_3610":75294,"_31119":75198,"_21540":128441,"_5":14806,"_28300":128150,"_3066":128442},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3610":75295,"_31119":75198,"_21540":128444,"_5":14806,"_28300":128150,"_3066":128445},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3610":75296,"_31119":75198,"_21540":128447,"_5":14806,"_28300":128150,"_3066":128448},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3610":75297,"_31119":75198,"_21540":128450,"_5":14806,"_28300":128150,"_3066":128197},[],{"_3610":75298,"_31119":75198,"_21540":128452,"_5":14806,"_28300":128150,"_3066":128453},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3610":75299,"_31119":75198,"_21540":128455,"_5":14806,"_28300":128150,"_3066":128456},[],"Alta: el backend ya no arranca con ellos",{"_3610":75300,"_31119":75198,"_21540":128458,"_5":14806,"_28300":128150,"_3066":128459},[],"Pasar a PostgreSQL antes de actualizar",{"_3610":75301,"_31119":75198,"_21540":128461,"_5":14806,"_28300":128150,"_3066":128241},[],{"_3610":75302,"_31119":75198,"_21540":128463,"_5":14806,"_28300":128150,"_3066":128464},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3610":75303,"_31119":75198,"_21540":128466,"_5":14806,"_28300":128150,"_3066":128467},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3610":75304,"_31119":75198,"_21540":128469,"_5":14806,"_28300":128150,"_3066":128470},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3610":75305,"_31119":75198,"_21540":128472,"_5":14806,"_28300":128150,"_3066":128473},[],"Webhooks con referencias a archivos",{"_3610":75306,"_31119":75198,"_21540":128475,"_5":14806,"_28300":128150,"_3066":128476},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3610":75307,"_31119":75198,"_21540":128478,"_5":14806,"_28300":128150,"_3066":128479},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3610":75308,"_31119":75198,"_21540":128481,"_5":14806,"_28300":128150,"_3066":128482},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3610":75309,"_31119":75198,"_21540":128484,"_5":14806,"_28300":128150,"_3066":128177},[],{"_3610":75310,"_31119":75198,"_21540":128486,"_5":14806,"_28300":128150,"_3066":128487},[],"Releases con identidades por servicio o material de claves montado",{"_3610":75311,"_31119":75198,"_21540":128489,"_5":14806,"_28300":128150,"_3066":128490},[],"Media: los servicios no pueden leer sus archivos",{"_3610":75312,"_31119":75198,"_21540":128492,"_5":14806,"_28300":128150,"_3066":128493},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3610":75313,"_31119":75198,"_21540":128495,"_5":14806,"_28300":128150,"_3066":128181},[],{"_3610":75314,"_31119":75198,"_21540":128497,"_5":14806,"_28300":128150,"_3066":128498},[],"Releases que definen `amqp.tls`",{"_3610":75315,"_31119":75198,"_21540":128500,"_5":14806,"_28300":128150,"_3066":128501},[],"Media: los clientes se conectan al puerto equivocado",{"_3610":75316,"_31119":75198,"_21540":128503,"_5":14806,"_28300":128150,"_3066":128504},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3610":75317,"_31119":75198,"_21540":128506,"_5":14806,"_28300":128150,"_3066":128201},[],{"_3610":75318,"_31119":75198,"_21540":128508,"_5":14806,"_28300":128150,"_3066":128509},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3610":75319,"_31119":75198,"_21540":128511,"_5":14806,"_28300":128150,"_3066":128512},[],"Media: las claves de CA quedan sin gestionar",{"_3610":75320,"_31119":75198,"_21540":128514,"_5":14806,"_28300":128150,"_3066":128515},[],"Ejecutar la migración de CA a KMS",{"_3610":75321,"_31119":75198,"_21540":128517,"_5":14806,"_28300":128150,"_3066":128518},[],"Verificación del certificado del receptor",{"_3610":75322,"_31119":75198,"_21540":128520,"_5":14806,"_28300":128150,"_3066":128521},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3610":75323,"_31119":75198,"_21540":128523,"_5":14806,"_28300":128150,"_3066":128524},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3610":75324,"_31119":75198,"_21540":128526,"_5":14806,"_28300":128150,"_3066":128527},[],"Poner `insecure_skip_verify` a `false`",{"_3610":75325,"_31119":75198,"_21540":128529,"_5":14806,"_28300":128150,"_3066":128217},[],{"_3610":75326,"_31119":75198,"_21540":128531,"_5":14806,"_28300":128150,"_3066":128532},[],"Scripts y consolas que editan DMS por API",{"_3610":75327,"_31119":75198,"_21540":128534,"_5":14806,"_28300":128150,"_3066":128535},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3610":75328,"_31119":75198,"_21540":128537,"_5":14806,"_28300":128150,"_3066":128538},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3610":75329,"_31119":75198,"_21540":128540,"_5":14806,"_28300":128150,"_3066":128237},[],{"_3610":75330,"_31119":75198,"_21540":128542,"_5":14806,"_28300":128150,"_3066":128543},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3610":75331,"_31119":75198,"_21540":128545,"_5":14806,"_28300":128150,"_3066":128546},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3610":75332,"_31119":75198,"_21540":128548,"_5":14806,"_28300":128150,"_3066":128549},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3610":75333,"_31119":75198,"_21540":128551,"_5":14806,"_28300":128150,"_3066":128245},[],{"_3610":75334,"_31119":75198,"_21540":128553,"_5":14806,"_28300":128150,"_3066":128554},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3610":75335,"_31119":75198,"_21540":128556,"_5":14806,"_28300":128150,"_3066":128557},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3610":75336,"_31119":75198,"_21540":128559,"_5":14806,"_28300":128150,"_3066":128560},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3610":75337,"_31119":75198,"_21540":128562,"_5":14806,"_28300":128150,"_3066":128249},[],{"_3610":75338,"_31119":75198,"_21540":128564,"_5":14806,"_28300":128150,"_3066":128565},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3610":75339,"_31119":75198,"_21540":128567,"_5":14806,"_28300":128150,"_3066":128568},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3610":75340,"_31119":75198,"_21540":128570,"_5":14806,"_28300":128150,"_3066":128571},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3610":75341,"_31119":75198,"_21540":128573,"_5":14806,"_28300":128150,"_3066":128233},[],{"_3610":75342,"_31119":75198,"_21540":128575,"_5":14806,"_28300":128150,"_3066":128576},[],"Consumidores que leen el campo `events` del dispositivo",{"_3610":75343,"_31119":75198,"_21540":128578,"_5":14806,"_28300":128150,"_3066":128579},[],"Media: el campo desaparece",{"_3610":75344,"_31119":75198,"_21540":128581,"_5":14806,"_28300":128150,"_3066":128582},[],"Usar los nuevos endpoints de eventos",{"_3610":75345,"_31119":75198,"_21540":128584,"_5":14806,"_28300":128150,"_3066":128261},[],{"_3610":75346,"_31119":75198,"_21540":128586,"_5":14806,"_28300":128150,"_3066":128587},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3610":75347,"_31119":75198,"_21540":128589,"_5":14806,"_28300":128150,"_3066":128590},[],"Media: la migración de la VA aborta",{"_3610":75348,"_31119":75198,"_21540":128592,"_5":14806,"_28300":128150,"_3066":128593},[],"Corregir los roles afectados antes de actualizar",{"_3610":75349,"_31119":75198,"_21540":128595,"_5":14806,"_28300":128150,"_3066":128185},[],{"_3610":75350,"_31119":75198,"_21540":128597,"_5":14806,"_28300":128150,"_3066":128598},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3610":75351,"_31119":75198,"_21540":128600,"_5":14806,"_28300":128150,"_3066":128601},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3610":75352,"_31119":75198,"_21540":128603,"_5":14806,"_28300":128150,"_3066":128604},[],"Actualizar el archivo de values",{"_3610":75353,"_31119":75198,"_21540":128606,"_5":14806,"_28300":128150,"_3066":128225},[],{"_3610":75354,"_31119":75198,"_21540":128608,"_5":14806,"_28300":128150,"_3066":128609},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3610":75355,"_31119":75198,"_21540":128611,"_5":14806,"_28300":128150,"_3066":128612},[],"Baja: prevalece el ID de la URL",{"_3610":75356,"_31119":75198,"_21540":128614,"_5":14806,"_28300":128150,"_3066":128615},[],"Enviar el ID en la URL",{"_3610":75357,"_31119":75198,"_21540":128617,"_5":14806,"_28300":128150,"_3066":128253},[],{"_3610":75358,"_31119":75198,"_21540":128619,"_5":14806,"_28300":128150,"_3066":128620},[],"Clientes que envían un `id` al crear o importar CAs",{"_3610":75359,"_31119":75198,"_21540":128622,"_5":14806,"_28300":128150,"_3066":128623},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3610":75360,"_31119":75198,"_21540":128625,"_5":14806,"_28300":128150,"_3066":128626},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3610":75361,"_31119":75198,"_21540":128628,"_5":14806,"_28300":128150,"_3066":128257},[],{"_3610":75362,"_31119":75198,"_21540":128630,"_5":14806,"_28300":128150,"_3066":128631},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3610":75363,"_31119":75198,"_21540":128633,"_5":14806,"_28300":128150,"_3066":128634},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3610":75364,"_31119":75198,"_21540":128636,"_5":14806,"_28300":128150,"_3066":128637},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3610":75365,"_31119":75198,"_21540":128639,"_5":14806,"_28300":128150,"_3066":128229},[],{"_3610":75366,"_31119":75198,"_21540":128641,"_5":14806,"_28300":128150,"_3066":128642},[],"Consumidores que comparan el `type` del certificado",{"_3610":75367,"_31119":75198,"_21540":128644,"_5":14806,"_28300":128150,"_3066":128645},[],"Baja: dos valores cambian de nombre",{"_3610":75368,"_31119":75198,"_21540":128647,"_5":14806,"_28300":128150,"_3066":128648},[],"Adaptar los consumidores",{"_3610":75369,"_31119":75198,"_21540":128650,"_5":14806,"_28300":128150,"_3066":128221},[],{"_3610":75370,"_31119":75198,"_21540":128652,"_5":14806,"_28300":128150,"_3066":128653},[],"Cualquier DMS",{"_3610":75371,"_31119":75198,"_21540":128655,"_5":14806,"_28300":128150,"_3066":128656},[],"Baja: solo informativo",{"_3610":75372,"_31119":75198,"_21540":128658,"_5":14806,"_28300":128150,"_3066":128659},[],"Revisar ambos bloques antes de editar",{"_3610":75373,"_31119":75198,"_21540":128661,"_5":14806,"_28300":128157,"_3066":128662},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3610":75374,"_31119":75198,"_21540":128664,"_5":14806,"_28300":128157,"_3066":128665},[],"El paso 4 de la guía de migración copia los datos.",{"_3610":75375,"_31119":75198,"_21540":128667,"_5":14806,"_28300":128161,"_3066":128668},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3610":75376,"_31119":75198,"_21540":128670,"_5":14806,"_28300":128165,"_3066":128671},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3610":75377,"_31119":75198,"_21540":128673,"_5":14806,"_28300":128165,"_3066":128674},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3610":75378,"_31119":75198,"_21540":128676,"_5":14806,"_28300":128168,"_3066":128677},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3610":75379,"_31119":75198,"_21540":128679,"_5":14806,"_28300":128172,"_3066":128680},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3610":75380,"_31119":75198,"_21540":128682,"_5":14806,"_28300":128176,"_3066":128683},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3610":75381,"_31119":75198,"_21540":128685,"_5":14806,"_28300":128176,"_3066":128686},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3610":75382,"_31119":75198,"_21540":128688,"_5":14806,"_28300":128176,"_3066":128689},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3610":75383,"_31119":75198,"_21540":128691,"_5":14806,"_28300":128180,"_3066":128692},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3610":75384,"_31119":75198,"_21540":128694,"_5":14806,"_28300":128184,"_3066":128695},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3610":75385,"_31119":75198,"_21540":128697,"_5":14806,"_28300":128184,"_3066":128698},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3610":75386,"_31119":75198,"_21540":128700,"_5":14806,"_28300":128184,"_3066":128701},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3610":75387,"_31119":75198,"_21540":128703,"_5":14806,"_28300":128184,"_3066":128704},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3610":75388,"_31119":75198,"_21540":128706,"_5":14806,"_28300":128184,"_3066":128707},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3610":75389,"_31119":75198,"_21540":128709,"_5":14806,"_28300":128184,"_3066":128710},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3610":75390,"_31119":75198,"_21540":128712,"_5":14806,"_28300":128192,"_3066":128713},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3610":75391,"_31119":75198,"_21540":128715,"_5":14806,"_28300":128192,"_3066":128716},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3610":75392,"_31119":75198,"_21540":128718,"_5":14806,"_28300":128192,"_3066":128719},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3610":75393,"_31119":75198,"_21540":128721,"_5":14806,"_28300":128192,"_3066":128722},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3610":75394,"_31119":75198,"_21540":128724,"_5":14806,"_28300":128192,"_3066":128725},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3610":75395,"_31119":75198,"_21540":128727,"_5":14806,"_28300":128196,"_3066":128728},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3610":75396,"_31119":75198,"_21540":128730,"_5":14806,"_28300":128200,"_3066":128731},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3610":75397,"_31119":75198,"_21540":128733,"_5":14806,"_28300":128200,"_3066":128734},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3610":75398,"_31119":75198,"_21540":128736,"_5":14806,"_28300":128200,"_3066":128737},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3610":75399,"_31119":75198,"_21540":128739,"_5":14806,"_28300":128200,"_3066":128740},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3610":75400,"_31119":75198,"_21540":128742,"_5":14806,"_28300":128200,"_3066":128743},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3610":75401,"_31119":75198,"_21540":128745,"_5":14806,"_28300":128200,"_3066":128746},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3610":75402,"_31119":75198,"_21540":128748,"_5":14806,"_28300":128200,"_3066":128749},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3610":75403,"_31119":75198,"_21540":128751,"_5":14806,"_28300":128200,"_3066":128752},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3610":75404,"_31119":75198,"_21540":128754,"_5":14806,"_28300":128204,"_3066":128755},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3610":75405,"_31119":75198,"_21540":128757,"_5":14806,"_28300":128212,"_3066":128758},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3610":75406,"_31119":75198,"_21540":128760,"_5":14806,"_28300":128212,"_3066":128761},[],"Campo en 3.8.0",{"_3610":75407,"_31119":75198,"_21540":128763,"_5":14806,"_28300":128212,"_3066":128764},[],"Campo en 4.0.0",{"_3610":75408,"_31119":75198,"_21540":128766,"_5":14806,"_28300":128212,"_3066":59856},[],{"_3610":75409,"_31119":75198,"_21540":128768,"_5":14806,"_28300":128212,"_3066":128769},[],"`insecure_skip_verify` (con el valor negado)",{"_3610":75410,"_31119":75198,"_21540":128771,"_5":14806,"_28300":128212,"_3066":59862},[],{"_3610":75411,"_31119":75198,"_21540":128773,"_5":14806,"_28300":128212,"_3066":59865},[],{"_3610":75412,"_31119":75198,"_21540":128775,"_5":14806,"_28300":128212,"_3066":59868},[],{"_3610":75413,"_31119":75198,"_21540":128777,"_5":14806,"_28300":128212,"_3066":59871},[],{"_3610":75414,"_31119":75198,"_21540":128779,"_5":14806,"_28300":128212,"_3066":59874},[],{"_3610":75415,"_31119":75198,"_21540":128781,"_5":14806,"_28300":128212,"_3066":59877},[],{"_3610":75416,"_31119":75198,"_21540":128783,"_5":14806,"_28300":128212,"_3066":128784},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3610":75417,"_31119":75198,"_21540":128786,"_5":14806,"_28300":128212,"_3066":128787},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3610":75418,"_31119":75198,"_21540":128789,"_5":14806,"_28300":128212,"_3066":128790},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3610":75419,"_31119":75198,"_21540":128792,"_5":14806,"_28300":128216,"_3066":128793},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3610":75420,"_31119":75198,"_21540":128795,"_5":14806,"_28300":128216,"_3066":128796},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3610":75421,"_31119":75198,"_21540":128798,"_5":14806,"_28300":128216,"_3066":128799},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3610":75422,"_31119":75198,"_21540":128801,"_5":14806,"_28300":128220,"_3066":128802},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3610":75423,"_31119":75198,"_21540":128804,"_5":14806,"_28300":128224,"_3066":128805},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3610":75424,"_31119":75198,"_21540":128807,"_5":14806,"_28300":128228,"_3066":128808},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3610":75425,"_31119":75198,"_21540":128810,"_5":14806,"_28300":128232,"_3066":128811},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3610":75426,"_31119":75198,"_21540":128813,"_5":14806,"_28300":128232,"_3066":128814},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3610":75427,"_31119":75198,"_21540":128816,"_5":14806,"_28300":128232,"_3066":128817},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3610":75428,"_31119":75198,"_21540":128819,"_5":14806,"_28300":128232,"_3066":128820},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3610":75429,"_31119":75198,"_21540":128822,"_5":14806,"_28300":128236,"_3066":128823},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3610":75430,"_31119":75198,"_21540":128825,"_5":14806,"_28300":128240,"_3066":128826},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3610":75431,"_31119":75198,"_21540":128828,"_5":14806,"_28300":128240,"_3066":128829},[],"Ruta",{"_3610":75432,"_31119":75198,"_21540":128831,"_5":14806,"_28300":128240,"_3066":121174},[],{"_3610":75433,"_31119":75198,"_21540":128833,"_5":14806,"_28300":128240,"_3066":59930},[],{"_3610":75434,"_31119":75198,"_21540":128835,"_5":14806,"_28300":128240,"_3066":128836},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3610":75435,"_31119":75198,"_21540":128838,"_5":14806,"_28300":128240,"_3066":59936},[],{"_3610":75436,"_31119":75198,"_21540":128840,"_5":14806,"_28300":128240,"_3066":128841},[],"Lee los ajustes de una CA.",{"_3610":75437,"_31119":75198,"_21540":128843,"_5":14806,"_28300":128240,"_3066":59942},[],{"_3610":75438,"_31119":75198,"_21540":128845,"_5":14806,"_28300":128240,"_3066":128846},[],"Sustituye los `crl_options`.",{"_3610":75439,"_31119":75198,"_21540":128848,"_5":14806,"_28300":128240,"_3066":59948},[],{"_3610":75440,"_31119":75198,"_21540":128850,"_5":14806,"_28300":128240,"_3066":128851},[],"Elimina los ajustes archivados de una CA.",{"_3610":75441,"_31119":75198,"_21540":128853,"_5":14806,"_28300":128240,"_3066":128854},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3610":75442,"_31119":75198,"_21540":128856,"_5":14806,"_28300":128240,"_3066":128857},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3610":75443,"_31119":75198,"_21540":128859,"_5":14806,"_28300":128240,"_3066":128860},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3610":75444,"_31119":75198,"_21540":128862,"_5":14806,"_28300":128240,"_3066":128863},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3610":75445,"_31119":75198,"_21540":128865,"_5":14806,"_28300":128240,"_3066":128866},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3610":75446,"_31119":75198,"_21540":128868,"_5":14806,"_28300":128240,"_3066":128869},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3610":75447,"_31119":75198,"_21540":128871,"_5":14806,"_28300":128240,"_3066":128872},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3610":75448,"_31119":75198,"_21540":128874,"_5":14806,"_28300":128240,"_3066":128875},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3610":75449,"_31119":75198,"_21540":128877,"_5":14806,"_28300":128240,"_3066":128878},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3610":75450,"_31119":75198,"_21540":128880,"_5":14806,"_28300":128240,"_3066":128881},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3610":75451,"_31119":75198,"_21540":128883,"_5":14806,"_28300":128240,"_3066":128884},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3610":75452,"_31119":75198,"_21540":128886,"_5":14806,"_28300":128244,"_3066":128887},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3610":75453,"_31119":75198,"_21540":128889,"_5":14806,"_28300":128248,"_3066":128890},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3610":75454,"_31119":75198,"_21540":128892,"_5":14806,"_28300":128252,"_3066":128893},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3610":75455,"_31119":75198,"_21540":128895,"_5":14806,"_28300":128256,"_3066":128896},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3610":75456,"_31119":75198,"_21540":128898,"_5":14806,"_28300":128256,"_3066":128899},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3610":75457,"_31119":75198,"_21540":128901,"_5":14806,"_28300":128260,"_3066":128902},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3610":75458,"_31119":75198,"_21540":128904,"_5":14806,"_28300":128264,"_3066":128905},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3610":75459,"_31119":75198,"_21540":128907,"_5":14806,"_28300":128268,"_3066":128908},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3610":75460,"_31119":75198,"_21540":128910,"_5":14806,"_28300":128268,"_3066":128911},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3610":75461,"_31119":75198,"_21540":128913,"_5":14806,"_28300":128268,"_3066":128914},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3610":75462,"_31119":75198,"_21540":128916,"_5":14806,"_28300":128268,"_3066":128917},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3610":75463,"_31119":75198,"_21540":128919,"_5":14806,"_28300":128268,"_3066":128920},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3610":75464,"_31119":75198,"_21540":128922,"_5":14806,"_28300":128268,"_3066":128923},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3610":75465,"_31119":75198,"_21540":128925,"_5":14806,"_28300":128272,"_3066":128926},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3610":75466,"_31119":75198,"_21540":128928,"_5":14806,"_28300":128272,"_3066":128929},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3610":75467,"_31119":75198,"_21540":128931,"_5":14806,"_28300":128272,"_3066":128932},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3610":75468,"_31119":75198,"_21540":128934,"_5":14806,"_28300":128272,"_3066":128935},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3610":75469,"_31119":75198,"_21540":128937,"_5":14806,"_28300":128272,"_3066":128938},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3610":75470,"_31119":75198,"_21540":128940,"_5":14806,"_28300":128276,"_3066":128941},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3610":75471,"_31119":75198,"_21540":128943,"_5":14806,"_28300":128276,"_3066":128944},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3610":75472,"_31119":75198,"_21540":128946,"_5":14806,"_28300":128276,"_3066":128947},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3610":75473,"_31119":75198,"_21540":128949,"_5":14806,"_28300":128276,"_3066":60050},[],{"_3610":75474,"_31119":75198,"_21540":128951,"_5":14806,"_28300":128276,"_3066":128952},[],"Claves de datos obligatorias",{"_3610":75475,"_31119":75198,"_21540":128954,"_5":14806,"_28300":128276,"_3066":128955},[],"Cuándo",{"_3610":75476,"_31119":75198,"_21540":128957,"_5":14806,"_28300":128276,"_3066":128958},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3610":75477,"_31119":75198,"_21540":128960,"_5":14806,"_28300":128276,"_3066":60062},[],{"_3610":75478,"_31119":75198,"_21540":128962,"_5":14806,"_28300":128276,"_3066":128963},[],"Siempre",{"_3610":75479,"_31119":75198,"_21540":128965,"_5":14806,"_28300":128276,"_3066":128966},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3610":75480,"_31119":75198,"_21540":128968,"_5":14806,"_28300":128276,"_3066":60062},[],{"_3610":75481,"_31119":75198,"_21540":128970,"_5":14806,"_28300":128276,"_3066":128963},[],{"_3610":75482,"_31119":75198,"_21540":128972,"_5":14806,"_28300":128276,"_3066":60075},[],{"_3610":75483,"_31119":75198,"_21540":128974,"_5":14806,"_28300":128276,"_3066":60062},[],{"_3610":75484,"_31119":75198,"_21540":128976,"_5":14806,"_28300":128276,"_3066":128977},[],"Solo cuando hay autenticación SMTP",{"_3610":75485,"_31119":75198,"_21540":128979,"_5":14806,"_28300":128276,"_3066":128980},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3610":75486,"_31119":75198,"_21540":128982,"_5":14806,"_28300":128276,"_3066":128983},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3610":75487,"_31119":75198,"_21540":128985,"_5":14806,"_28300":128276,"_3066":128986},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3610":75488,"_31119":75198,"_21540":128988,"_5":14806,"_28300":128276,"_3066":128989},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3610":75489,"_31119":75198,"_21540":128991,"_5":14806,"_28300":128276,"_3066":128992},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3610":75490,"_31119":75198,"_21540":128994,"_5":14806,"_28300":128276,"_3066":128995},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3610":75491,"_31119":75198,"_21540":128997,"_5":14806,"_28300":128276,"_3066":128998},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3610":75492,"_31119":75198,"_21540":129000,"_5":14806,"_28300":128276,"_3066":129001},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3610":75493,"_31119":75198,"_21540":129003,"_5":14806,"_28300":128276,"_3066":129004},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3610":75494,"_31119":75198,"_21540":129006,"_5":14806,"_28300":128276,"_3066":129007},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3610":75495,"_31119":75198,"_21540":129009,"_5":14806,"_28300":128276,"_3066":129010},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3610":75496,"_31119":75198,"_21540":129012,"_5":14806,"_28300":128276,"_3066":129013},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3610":75497,"_31119":75198,"_21540":129015,"_5":14806,"_28300":128276,"_3066":129016},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3610":75498,"_31119":75198,"_21540":129018,"_5":14806,"_28300":128276,"_3066":129019},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3610":75499,"_31119":75198,"_21540":129021,"_5":14806,"_28300":128276,"_3066":129022},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3610":75500,"_31119":75198,"_21540":129024,"_5":14806,"_28300":128280,"_3066":129025},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3610":75501,"_31119":75198,"_21540":129027,"_5":14806,"_28300":128280,"_3066":129028},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3610":75502,"_31119":75198,"_21540":129030,"_5":14806,"_28300":128284,"_3066":129031},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3610":75503,"_31119":75198,"_21540":129033,"_5":14806,"_28300":128284,"_3066":129034},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3610":75504,"_31119":75198,"_21540":129036,"_5":14806,"_28300":128284,"_3066":129037},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3610":75505,"_31119":75198,"_21540":129039,"_5":14806,"_28300":128284,"_3066":129040},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3610":75506,"_31119":75198,"_21540":129042,"_5":14806,"_28300":128284,"_3066":129043},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3610":75507,"_31119":75198,"_21540":129045,"_5":14806,"_28300":128284,"_3066":129046},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3610":75508,"_31119":75198,"_21540":129048,"_5":14806,"_28300":128284,"_3066":129049},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3610":75509,"_31119":75198,"_21540":129051,"_5":14806,"_28300":128284,"_3066":129052},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3610":75510,"_31119":75198,"_21540":129054,"_5":14806,"_28300":128284,"_3066":129055},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3610":75511,"_31119":75198,"_21540":129057,"_5":14806,"_28300":128284,"_3066":129058},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3610":75512,"_31119":75198,"_21540":129060,"_5":14806,"_28300":128284,"_3066":129061},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3610":75513,"_31119":75198,"_21540":129063,"_5":14806,"_28300":128288,"_3066":129064},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3610":75514,"_31119":75198,"_21540":129066,"_5":14806,"_28300":128288,"_3066":129067},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3610":75515,"_31119":75198,"_21540":129069,"_5":14806,"_28300":128292,"_3066":129070},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3610":75516,"_31119":75198,"_21540":129072,"_5":14806,"_28300":128292,"_3066":129073},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3610":75517,"_31119":75198,"_21540":129075,"_5":14806,"_28300":128292,"_3066":129076},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3610":75518,"_31119":75198,"_21540":129078,"_5":14806,"_28300":128292,"_3066":129079},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3610":75519,"_31119":75198,"_21540":129081,"_5":14806,"_28300":128292,"_3066":129082},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3610":75520,"_31119":75198,"_21540":129084,"_5":14806,"_28300":128292,"_3066":129085},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3610":75521,"_31119":75198,"_21540":129087,"_5":14806,"_28300":128292,"_3066":129088},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3610":75522,"_31119":75198,"_21540":129090,"_5":14806,"_28300":128292,"_3066":129091},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3610":75523,"_31119":75198,"_21540":129093,"_5":14806,"_28300":128296,"_3066":129094},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3610":75524,"_31119":75198,"_21540":129096,"_5":14806,"_28300":128296,"_3066":129097},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3610":75525,"_31119":75198,"_21540":129099,"_5":14806,"_28300":128296,"_3066":129100},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3610":75526,"_31119":75198,"_21540":129102,"_5":14806,"_28300":128296,"_3066":129103},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3610":75527,"_31119":75198,"_21540":129105,"_5":14806,"_28300":128296,"_3066":129106},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3610":75528,"_31119":75198,"_21540":129108,"_5":14806,"_28300":128296,"_3066":129109},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3610":75529,"_31119":75198,"_21540":129111,"_5":14806,"_28300":128296,"_3066":129112},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3610":75530,"_31119":75198,"_21540":129114,"_5":14806,"_28300":128296,"_3066":129115},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3610":75531,"_31119":75198,"_21540":129117,"_5":14806,"_28300":128296,"_3066":129118},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3610":75532,"_31119":75198,"_21540":129120,"_5":14806,"_28300":128296,"_3066":129121},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3610":75533,"_31119":75198,"_21540":129123,"_5":14806,"_28300":128296,"_3066":129124},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3610":75534,"_31119":75198,"_21540":129126,"_5":14806,"_28300":128299,"_3066":129127},[],"Tras la actualización, comprueba en este orden:",{"_3610":75535,"_31119":75198,"_21540":129129,"_5":14806,"_28300":128299,"_3066":129130},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3610":75536,"_31119":75198,"_21540":129132,"_5":14806,"_28300":128299,"_3066":129133},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3610":75537,"_31119":75198,"_21540":129135,"_5":14806,"_28300":128299,"_3066":129136},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3610":75538,"_31119":75198,"_21540":129138,"_5":14806,"_28300":128299,"_3066":129139},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3610":75539,"_31119":75198,"_21540":129141,"_5":14806,"_28300":128299,"_3066":129142},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3610":75540,"_31119":75198,"_21540":129144,"_5":14806,"_28300":128299,"_3066":129145},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3610":75541,"_31119":75198,"_21540":129147,"_5":14806,"_28300":128299,"_3066":129148},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3610":75542,"_31119":75198,"_21540":129150,"_5":14806,"_28300":128299,"_3066":129151},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3610":75543,"_31119":75198,"_21540":129153,"_5":14806,"_28300":128299,"_3066":129154},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3610":75544,"_31119":75198,"_21540":129156,"_5":14806,"_28300":128299,"_3066":129157},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3610":75545,"_31119":75198,"_21540":129159,"_5":14806,"_28300":128299,"_3066":129160},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3610":75546,"_31119":75198,"_21540":129162,"_5":14806,"_28300":128299,"_3066":129163},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3610":75547,"_31119":75198,"_21540":129165,"_5":14806,"_28300":128299,"_3066":129166},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3610":75548,"_31119":75198,"_21540":129168,"_5":14806,"_28300":128299,"_3066":129169},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3610":75549,"_31119":75198,"_21540":129171,"_5":14806,"_28300":128299,"_3066":129172},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3610":75550,"_31119":75198,"_21540":129174,"_5":14806,"_28300":128303,"_3066":129175},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3610":75551,"_31119":75198,"_21540":129177,"_5":14806,"_28300":128303,"_3066":129178},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3610":75552,"_31119":75198,"_21540":129180,"_5":14806,"_28300":128303,"_3066":129181},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3610":75553,"_31119":75198,"_21540":129183,"_5":14806,"_28300":128303,"_3066":129184},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3610":75554,"_31119":75198,"_21540":129186,"_5":14806,"_28300":128303,"_3066":129187},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60293":129189,"_60295":129190,"_60297":129191,"_60299":129192,"_18665":3101,"_72502":3101},"spanish",[3066,31119,5,28300],{"_3066":25720,"_31119":25720,"_5":25720,"_28300":25720},{"_3066":129193,"_31119":132242,"_5":135291,"_28300":138340},{"_4809":129194,"_60303":129195,"_5":25720},{"_14887":7202,"_15266":3385,"_15285":4646,"_30118":7702,"_15272":4196,"_20447":6707,"_14908":5959,"_14915":20753,"_30060":3514,"_30474":6202,"_30495":7245,"_30094":4551,"_35492":6839,"_30197":20933,"_30539":10175,"_35499":5431,"_35502":4197,"_35505":7936,"_35508":5624,"_30941":12377,"_35513":5935,"_35515":3376,"_30976":5321,"_15281":16273,"_35519":7776,"_35522":7566,"_35524":6222,"_30523":11666,"_30961":17649,"_30989":4710,"_35529":13796,"_35531":3252,"_35533":4087,"_30214":7950,"_35536":8706,"_35538":6170,"_35540":5335,"_35542":7951,"_35544":25529,"_30131":7569,"_35547":7207,"_35549":3874,"_30125":3178,"_30560":14596,"_35553":18541,"_35555":6438,"_35558":4553,"_30171":6027,"_35562":8447,"_30051":4466,"_35565":6224,"_30099":5770,"_35568":5128,"_35570":26392,"_35573":3380,"_15275":4888,"_35576":6158,"_35578":11357,"_35581":7917,"_35583":5499,"_35585":7673,"_35587":21302,"_35589":6533,"_20450":4783,"_35592":12015,"_35594":4299,"_30072":6729,"_30517":3556,"_35598":7749,"_35600":7171,"_35602":9486,"_31006":14763,"_35605":3780,"_35607":5114,"_35609":12831,"_31099":7198,"_30576":18667,"_35613":7818,"_35615":26116,"_30109":5284,"_35618":6165,"_35620":3783,"_35622":7265,"_31022":4446,"_30191":3237,"_29571":3152,"_35627":4884,"_35629":5305,"_35631"