7,"_33676":45130,"_33678":45133,"_33680":45136,"_33682":45139,"_33684":45142,"_33686":45145,"_33688":45148,"_33690":45151,"_33692":45154,"_33694":45157,"_33696":45160,"_33698":45163,"_33700":45166,"_33702":45169,"_33704":45172,"_33706":45175,"_33708":45178,"_33710":45182,"_33712":45186,"_33714":45190,"_33716":45193,"_33718":45196,"_33720":45199,"_33722":45202},{"_3805":11,"_26540":11,"_5":26779,"_1869":39344,"_26792":39345,"_22543":39349,"_10604":11},"Despliega desde AWS Marketplace",[39346,39347,39348],"Docs","Despliegue","Otros modelos",[],{"_3805":12,"_26540":11,"_22543":39351,"_5":26784,"_10604":11,"_1869":39352},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3805":13,"_26540":11,"_5":26789,"_22543":39354,"_10604":39355,"_1869":39356},[],"/docs/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3805":14,"_26540":11,"_5":26789,"_22543":39358,"_10604":39359,"_1869":39360},[],"/docs/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3805":15,"_26540":11,"_5":26789,"_22543":39362,"_10604":39363,"_1869":39364},[],"/docs/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3805":16,"_26540":11,"_5":26789,"_22543":39366,"_10604":39367,"_1869":39368},[],"/docs/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3805":17,"_26540":11,"_5":26789,"_22543":39370,"_10604":39371,"_1869":39372},[],"/docs/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3805":18,"_26540":11,"_5":26789,"_22543":39374,"_10604":39375,"_1869":39376},[],"/docs/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3805":19,"_26540":11,"_5":26789,"_22543":39378,"_10604":39379,"_1869":39380},[],"/docs/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3805":20,"_26540":11,"_22543":39382,"_5":26784,"_10604":11,"_1869":39383},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3805":21,"_26540":11,"_22543":39385,"_5":26784,"_10604":39355,"_1869":39386},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3805":22,"_26540":11,"_22543":39388,"_5":26784,"_10604":39355,"_1869":39389},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3805":23,"_26540":11,"_22543":39391,"_5":26784,"_10604":39355,"_1869":39392},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3805":24,"_26540":11,"_22543":39394,"_5":26784,"_10604":39359,"_1869":39395},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3805":25,"_26540":11,"_22543":39397,"_5":26784,"_10604":39359,"_1869":39398},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3805":26,"_26540":11,"_22543":39400,"_5":26784,"_10604":39359,"_1869":39401},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3805":27,"_26540":11,"_22543":39403,"_5":26784,"_10604":39363,"_1869":39404},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3805":28,"_26540":11,"_22543":39406,"_5":26784,"_10604":39367,"_1869":39407},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3805":29,"_26540":11,"_22543":39409,"_5":26784,"_10604":39371,"_1869":39410},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3805":30,"_26540":11,"_22543":39412,"_5":26784,"_10604":39375,"_1869":39413},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3805":31,"_26540":11,"_22543":39415,"_5":26784,"_10604":39379,"_1869":39416},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3805":32,"_26540":32,"_5":26779,"_1869":39418,"_26792":39419,"_22543":39420,"_10604":32},"Despliega Lamassu",[39346,39347],[],{"_3805":33,"_26540":32,"_22543":39422,"_5":26784,"_10604":32,"_1869":39423},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3805":34,"_26540":32,"_5":26789,"_22543":39425,"_10604":39426,"_1869":39427},[],"/docs/deployment/overview#elige-un-modelo","Elige un modelo",{"_3805":35,"_26540":32,"_5":26789,"_22543":39429,"_10604":39430,"_1869":39431},[],"/docs/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3805":36,"_26540":32,"_5":26789,"_22543":39433,"_10604":39434,"_1869":39435},[],"/docs/deployment/overview#después-del-despliegue","Después del despliegue",{"_3805":37,"_26540":32,"_22543":39437,"_5":26784,"_10604":32,"_1869":39438},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3805":38,"_26540":32,"_22543":39440,"_5":26784,"_10604":39426,"_1869":39441},[],"Modelo",{"_3805":39,"_26540":32,"_22543":39443,"_5":26784,"_10604":39426,"_1869":39444},[],"Recomendado para",{"_3805":40,"_26540":32,"_22543":39446,"_5":26784,"_10604":39426,"_1869":39447},[],"Quién opera la infraestructura",{"_3805":41,"_26540":32,"_22543":39449,"_5":26784,"_10604":39426,"_1869":39450},[],"Punto de partida",{"_3805":42,"_26540":32,"_22543":39452,"_5":26784,"_10604":39426,"_1869":39453},[],"Kubernetes self-managed",{"_3805":43,"_26540":32,"_22543":39455,"_5":26784,"_10604":39426,"_1869":39456},[],"Producción, entornos regulados y despliegues personalizados",{"_3805":44,"_26540":32,"_22543":39458,"_5":26784,"_10604":39426,"_1869":39459},[],"Tu equipo",{"_3805":45,"_26540":32,"_22543":39461,"_5":26784,"_10604":39426,"_1869":39462},[],"Helm o Fastlane",{"_3805":46,"_26540":32,"_22543":39464,"_5":26784,"_10604":39426,"_1869":39465},[],"AWS Marketplace",{"_3805":47,"_26540":32,"_22543":39467,"_5":26784,"_10604":39426,"_1869":39468},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3805":48,"_26540":32,"_22543":39470,"_5":26784,"_10604":39426,"_1869":39459},[],{"_3805":49,"_26540":32,"_22543":39472,"_5":26784,"_10604":39426,"_1869":39473},[],"Imagen preconfigurada en EC2",{"_3805":50,"_26540":32,"_22543":39475,"_5":26784,"_10604":39426,"_1869":39476},[],"SaaS",{"_3805":51,"_26540":32,"_22543":39478,"_5":26784,"_10604":39426,"_1869":39479},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3805":52,"_26540":32,"_22543":39481,"_5":26784,"_10604":39426,"_1869":39482},[],"Lamassu",{"_3805":53,"_26540":32,"_22543":39484,"_5":26784,"_10604":39426,"_1869":39485},[],"Suscripción gestionada",{"_3805":54,"_26540":32,"_22543":39487,"_5":26784,"_10604":39426,"_1869":39488},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3805":55,"_26540":32,"_22543":39490,"_5":26784,"_10604":39426,"_1869":39491},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3805":56,"_26540":32,"_22543":39493,"_5":26784,"_10604":39426,"_1869":39494},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3805":57,"_26540":32,"_22543":39496,"_5":26784,"_10604":39430,"_1869":39497},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3805":58,"_26540":32,"_22543":39499,"_5":26784,"_10604":39434,"_1869":39500},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3805":59,"_26540":59,"_5":26779,"_1869":39502,"_26792":39503,"_22543":39504,"_10604":59},"Utiliza Lamassu como SaaS",[39346,39347,39348],[],{"_3805":60,"_26540":59,"_22543":39506,"_5":26784,"_10604":59,"_1869":39507},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3805":61,"_26540":59,"_5":26789,"_22543":39509,"_10604":39510,"_1869":39511},[],"/docs/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3805":62,"_26540":59,"_5":26789,"_22543":39513,"_10604":39514,"_1869":39515},[],"/docs/deployment/saas#planes","Planes",{"_3805":63,"_26540":59,"_5":26789,"_22543":39517,"_10604":39518,"_1869":39519},[],"/docs/deployment/saas#solicita-acceso","Solicita acceso",{"_3805":64,"_26540":59,"_22543":39521,"_5":26784,"_10604":59,"_1869":39522},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3805":65,"_26540":59,"_22543":39524,"_5":26784,"_10604":39510,"_1869":39525},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3805":66,"_26540":59,"_22543":39527,"_5":26784,"_10604":39510,"_1869":39528},[],"Copias de seguridad automáticas.",{"_3805":67,"_26540":59,"_22543":39530,"_5":26784,"_10604":39510,"_1869":39531},[],"Actualizaciones de versión.",{"_3805":68,"_26540":59,"_22543":39533,"_5":26784,"_10604":39510,"_1869":39534},[],"Soporte técnico y SLA según el plan contratado.",{"_3805":69,"_26540":59,"_22543":39536,"_5":26784,"_10604":39514,"_1869":39537},[],"Plan",{"_3805":70,"_26540":59,"_22543":39539,"_5":26784,"_10604":39514,"_1869":39540},[],"Dispositivos",{"_3805":71,"_26540":59,"_22543":39542,"_5":26784,"_10604":39514,"_1869":39543},[],"Soporte",{"_3805":72,"_26540":59,"_22543":39545,"_5":26784,"_10604":39514,"_1869":39546},[],"SLA",{"_3805":73,"_26540":59,"_22543":39548,"_5":26784,"_10604":39514,"_1869":39549},[],"Starter",{"_3805":74,"_26540":59,"_22543":39551,"_5":26784,"_10604":39514,"_1869":39552},[],"Hasta 1.000",{"_3805":75,"_26540":59,"_22543":39554,"_5":26784,"_10604":39514,"_1869":39555},[],"Email",{"_3805":76,"_26540":59,"_22543":39557,"_5":26784,"_10604":39514,"_1869":39558},[],"99,5 %",{"_3805":77,"_26540":59,"_22543":39560,"_5":26784,"_10604":39514,"_1869":39561},[],"Professional",{"_3805":78,"_26540":59,"_22543":39563,"_5":26784,"_10604":39514,"_1869":39564},[],"Hasta 10.000",{"_3805":79,"_26540":59,"_22543":39566,"_5":26784,"_10604":39514,"_1869":39567},[],"Email y chat",{"_3805":80,"_26540":59,"_22543":39569,"_5":26784,"_10604":39514,"_1869":39570},[],"99,9 %",{"_3805":81,"_26540":59,"_22543":39572,"_5":26784,"_10604":39514,"_1869":39573},[],"Enterprise",{"_3805":82,"_26540":59,"_22543":39575,"_5":26784,"_10604":39514,"_1869":39576},[],"Ilimitados",{"_3805":83,"_26540":59,"_22543":39578,"_5":26784,"_10604":39514,"_1869":39579},[],"Dedicado",{"_3805":84,"_26540":59,"_22543":39581,"_5":26784,"_10604":39514,"_1869":39582},[],"99,99 %",{"_3805":85,"_26540":59,"_22543":39584,"_5":26784,"_10604":39518,"_1869":39585},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3805":86,"_26540":59,"_22543":39587,"_5":26784,"_10604":39518,"_1869":39588},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3805":87,"_26540":87,"_5":26779,"_1869":39590,"_26792":39591,"_22543":39592,"_10604":87},"Fastlane",[39346,39347,39453],[],{"_3805":88,"_26540":87,"_22543":39594,"_5":26784,"_10604":87,"_1869":39595},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_3805":89,"_26540":87,"_5":26789,"_22543":39597,"_10604":39598,"_1869":39599},[],"/docs/deployment/self-hosted/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_3805":90,"_26540":87,"_5":26789,"_22543":39601,"_10604":39602,"_1869":39603},[],"/docs/deployment/self-hosted/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_3805":91,"_26540":87,"_5":26789,"_22543":39605,"_10604":39606,"_1869":39607},[],"/docs/deployment/self-hosted/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_3805":92,"_26540":87,"_5":26789,"_22543":39609,"_10604":39610,"_1869":39611},[],"/docs/deployment/self-hosted/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_3805":93,"_26540":87,"_5":26789,"_22543":39613,"_10604":39614,"_1869":39615},[],"/docs/deployment/self-hosted/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_3805":94,"_26540":87,"_5":26789,"_22543":39617,"_10604":39618,"_1869":39619},[],"/docs/deployment/self-hosted/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_3805":95,"_26540":87,"_5":26789,"_22543":39621,"_10604":39622,"_1869":39623},[],"/docs/deployment/self-hosted/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_3805":96,"_26540":87,"_5":26789,"_22543":39625,"_10604":39626,"_1869":39627},[],"/docs/deployment/self-hosted/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_3805":97,"_26540":87,"_5":26789,"_22543":39629,"_10604":39630,"_1869":39631},[],"/docs/deployment/self-hosted/fastlane#modo-online-vs-offline","Modo online vs offline",{"_3805":98,"_26540":87,"_5":26789,"_22543":39633,"_10604":39634,"_1869":39635},[],"/docs/deployment/self-hosted/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_3805":99,"_26540":87,"_5":26789,"_22543":39637,"_10604":39638,"_1869":39639},[],"/docs/deployment/self-hosted/fastlane#modo-offline","Modo offline",{"_3805":100,"_26540":87,"_5":26789,"_22543":39641,"_10604":39642,"_1869":39643},[],"/docs/deployment/self-hosted/fastlane#instalación-de-componentes","Instalación de componentes",{"_3805":101,"_26540":87,"_5":26789,"_22543":39645,"_10604":39646,"_1869":39647},[],"/docs/deployment/self-hosted/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_3805":102,"_26540":87,"_5":26789,"_22543":39649,"_10604":39650,"_1869":39651},[],"/docs/deployment/self-hosted/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_3805":103,"_26540":87,"_5":26789,"_22543":39653,"_10604":39654,"_1869":39655},[],"/docs/deployment/self-hosted/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_3805":104,"_26540":87,"_5":26789,"_22543":39657,"_10604":39658,"_1869":39659},[],"/docs/deployment/self-hosted/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_3805":105,"_26540":87,"_5":26789,"_22543":39661,"_10604":39662,"_1869":39663},[],"/docs/deployment/self-hosted/fastlane#configuración-tls","Configuración TLS",{"_3805":106,"_26540":87,"_5":26789,"_22543":39665,"_10604":39666,"_1869":39667},[],"/docs/deployment/self-hosted/fastlane#certificado-externo","Certificado externo",{"_3805":107,"_26540":87,"_5":26789,"_22543":39669,"_10604":39670,"_1869":39671},[],"/docs/deployment/self-hosted/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_3805":108,"_26540":87,"_5":26789,"_22543":39673,"_10604":39674,"_1869":39675},[],"/docs/deployment/self-hosted/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_3805":109,"_26540":87,"_5":26789,"_22543":39677,"_10604":39678,"_1869":39679},[],"/docs/deployment/self-hosted/fastlane#uso-en-ci","Uso en CI",{"_3805":110,"_26540":87,"_5":26789,"_22543":39681,"_10604":39682,"_1869":39683},[],"/docs/deployment/self-hosted/fastlane#ejemplo-rápido","Ejemplo rápido",{"_3805":111,"_26540":87,"_5":26789,"_22543":39685,"_10604":39686,"_1869":39687},[],"/docs/deployment/self-hosted/fastlane#resumen","Resumen",{"_3805":112,"_26540":87,"_22543":39689,"_5":26784,"_10604":39598,"_1869":39690},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_3805":113,"_26540":87,"_22543":39692,"_5":26784,"_10604":39598,"_1869":39693},[],"La instalación incluye:",{"_3805":114,"_26540":87,"_22543":39695,"_5":26784,"_10604":39598,"_1869":39696},[],"PostgreSQL",{"_3805":115,"_26540":87,"_22543":39698,"_5":26784,"_10604":39598,"_1869":39699},[],"Keycloak",{"_3805":116,"_26540":87,"_22543":39701,"_5":26784,"_10604":39598,"_1869":39702},[],"RabbitMQ",{"_3805":117,"_26540":87,"_22543":39704,"_5":26784,"_10604":39598,"_1869":39705},[],"Chart Helm de Lamassu",{"_3805":118,"_26540":87,"_22543":39707,"_5":26784,"_10604":39602,"_1869":39708},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_3805":119,"_26540":87,"_22543":39710,"_5":26784,"_10604":39602,"_1869":39711},[],"Flag",{"_3805":120,"_26540":87,"_22543":39713,"_5":26784,"_10604":39602,"_1869":39714},[],"Valor por defecto",{"_3805":121,"_26540":87,"_22543":39716,"_5":26784,"_10604":39602,"_1869":39717},[],"Descripción",{"_3805":122,"_26540":87,"_22543":39719,"_5":26784,"_10604":39602,"_1869":39720},[],"`-h`, `--help`",{"_3805":123,"_26540":87,"_22543":39722,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":124,"_26540":87,"_22543":39724,"_5":26784,"_10604":39602,"_1869":39725},[],"Muestra la ayuda y finaliza",{"_3805":125,"_26540":87,"_22543":39727,"_5":26784,"_10604":39602,"_1869":39728},[],"`-n`, `--non-interactive`",{"_3805":126,"_26540":87,"_22543":39730,"_5":26784,"_10604":39602,"_1869":39731},[],"`false`",{"_3805":127,"_26540":87,"_22543":39733,"_5":26784,"_10604":39602,"_1869":39734},[],"Omite prompts y genera/usa credenciales por defecto",{"_3805":128,"_26540":87,"_22543":39736,"_5":26784,"_10604":39602,"_1869":39737},[],"`-ns`, `--namespace`",{"_3805":129,"_26540":87,"_22543":39739,"_5":26784,"_10604":39602,"_1869":39740},[],"`lamassu-dev`",{"_3805":130,"_26540":87,"_22543":39742,"_5":26784,"_10604":39602,"_1869":39743},[],"Namespace Kubernetes donde se despliegan los recursos",{"_3805":131,"_26540":87,"_22543":39745,"_5":26784,"_10604":39602,"_1869":39746},[],"`-d`, `--domain`",{"_3805":132,"_26540":87,"_22543":39748,"_5":26784,"_10604":39602,"_1869":39749},[],"`dev.lamassu.io`",{"_3805":133,"_26540":87,"_22543":39751,"_5":26784,"_10604":39602,"_1869":39752},[],"Dominio usado para endpoint y certificados TLS",{"_3805":134,"_26540":87,"_22543":39754,"_5":26784,"_10604":39602,"_1869":39755},[],"`-v`, `--version`",{"_3805":135,"_26540":87,"_22543":39757,"_5":26784,"_10604":39602,"_1869":39758},[],"`latest`",{"_3805":136,"_26540":87,"_22543":39760,"_5":26784,"_10604":39602,"_1869":39761},[],"Versión del chart Helm de Lamassu",{"_3805":137,"_26540":87,"_22543":39763,"_5":26784,"_10604":39602,"_1869":39764},[],"`--https-port`",{"_3805":138,"_26540":87,"_22543":39766,"_5":26784,"_10604":39602,"_1869":39767},[],"`443`",{"_3805":139,"_26540":87,"_22543":39769,"_5":26784,"_10604":39602,"_1869":39770},[],"Puerto HTTPS del gateway",{"_3805":140,"_26540":87,"_22543":39772,"_5":26784,"_10604":39602,"_1869":39773},[],"`--http-port`",{"_3805":141,"_26540":87,"_22543":39775,"_5":26784,"_10604":39602,"_1869":39776},[],"`80`",{"_3805":142,"_26540":87,"_22543":39778,"_5":26784,"_10604":39602,"_1869":39779},[],"Puerto HTTP del gateway",{"_3805":143,"_26540":87,"_22543":39781,"_5":26784,"_10604":39602,"_1869":39782},[],"`--offline`",{"_3805":144,"_26540":87,"_22543":39784,"_5":26784,"_10604":39602,"_1869":39731},[],{"_3805":145,"_26540":87,"_22543":39786,"_5":26784,"_10604":39602,"_1869":39787},[],"Activa modo offline",{"_3805":146,"_26540":87,"_22543":39789,"_5":26784,"_10604":39602,"_1869":39790},[],"`--tls-crt`",{"_3805":147,"_26540":87,"_22543":39792,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":148,"_26540":87,"_22543":39794,"_5":26784,"_10604":39602,"_1869":39795},[],"Ruta al certificado TLS (PEM)",{"_3805":149,"_26540":87,"_22543":39797,"_5":26784,"_10604":39602,"_1869":39798},[],"`--tls-key`",{"_3805":150,"_26540":87,"_22543":39800,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":151,"_26540":87,"_22543":39802,"_5":26784,"_10604":39602,"_1869":39803},[],"Ruta a la clave privada TLS (PEM)",{"_3805":152,"_26540":87,"_22543":39805,"_5":26784,"_10604":39602,"_1869":39806},[],"`--helm-chart-lamassu`",{"_3805":153,"_26540":87,"_22543":39808,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":154,"_26540":87,"_22543":39810,"_5":26784,"_10604":39602,"_1869":39811},[],"Ruta a chart local Lamassu (`.tgz`)",{"_3805":155,"_26540":87,"_22543":39813,"_5":26784,"_10604":39602,"_1869":39814},[],"`--helm-chart-postgres`",{"_3805":156,"_26540":87,"_22543":39816,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":157,"_26540":87,"_22543":39818,"_5":26784,"_10604":39602,"_1869":39819},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_3805":158,"_26540":87,"_22543":39821,"_5":26784,"_10604":39602,"_1869":39822},[],"`--helm-chart-keycloak`",{"_3805":159,"_26540":87,"_22543":39824,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":160,"_26540":87,"_22543":39826,"_5":26784,"_10604":39602,"_1869":39827},[],"Ruta a chart local Keycloak (`.tgz`)",{"_3805":161,"_26540":87,"_22543":39829,"_5":26784,"_10604":39602,"_1869":39830},[],"`--helm-chart-rabbitmq`",{"_3805":162,"_26540":87,"_22543":39832,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":163,"_26540":87,"_22543":39834,"_5":26784,"_10604":39602,"_1869":39835},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_3805":164,"_26540":87,"_22543":39837,"_5":26784,"_10604":39602,"_1869":39838},[],"`-l`, `--local-chart-path`",{"_3805":165,"_26540":87,"_22543":39840,"_5":26784,"_10604":39602,"_1869":3751},[],{"_3805":166,"_26540":87,"_22543":39842,"_5":26784,"_10604":39602,"_1869":39843},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_3805":167,"_26540":87,"_22543":39845,"_5":26784,"_10604":39606,"_1869":39846},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_3805":168,"_26540":87,"_22543":39848,"_5":26784,"_10604":39606,"_1869":39849},[],"`microk8s`",{"_3805":169,"_26540":87,"_22543":39851,"_5":26784,"_10604":39606,"_1869":39852},[],"`k3s`",{"_3805":170,"_26540":87,"_22543":39854,"_5":26784,"_10604":39606,"_1869":39855},[],"`kind`",{"_3805":171,"_26540":87,"_22543":39857,"_5":26784,"_10604":39606,"_1869":39858},[],"Kubernetes estándar",{"_3805":172,"_26540":87,"_22543":39860,"_5":26784,"_10604":39606,"_1869":39861},[],"Comportamientos específicos:",{"_3805":173,"_26540":87,"_22543":39863,"_5":26784,"_10604":39606,"_1869":39864},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_3805":174,"_26540":87,"_22543":39866,"_5":26784,"_10604":39606,"_1869":39867},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_3805":175,"_26540":87,"_22543":39869,"_5":26784,"_10604":39610,"_1869":39870},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_3805":176,"_26540":87,"_22543":39872,"_5":26784,"_10604":39610,"_1869":39873},[],"Requisitos generales:",{"_3805":177,"_26540":87,"_22543":39875,"_5":26784,"_10604":39610,"_1869":39876},[],"`yq`",{"_3805":178,"_26540":87,"_22543":39878,"_5":26784,"_10604":39610,"_1869":39879},[],"CLI de la distribución detectada",{"_3805":179,"_26540":87,"_22543":39881,"_5":26784,"_10604":39610,"_1869":39882},[],"Los requisitos específicos dependen de la distribución: `k3s` necesita `kubectl` y `helm`, mientras que `microk8s` utiliza `microk8s kubectl` y `microk8s helm`.",{"_3805":180,"_26540":87,"_22543":39884,"_5":26784,"_10604":39614,"_1869":39885},[],"Se valida que estén habilitados:",{"_3805":181,"_26540":87,"_22543":39887,"_5":26784,"_10604":39614,"_1869":39888},[],"`helm`",{"_3805":182,"_26540":87,"_22543":39890,"_5":26784,"_10604":39614,"_1869":39891},[],"`hostpath-storage`",{"_3805":183,"_26540":87,"_22543":39893,"_5":26784,"_10604":39614,"_1869":39894},[],"`dns`",{"_3805":184,"_26540":87,"_22543":39896,"_5":26784,"_10604":39614,"_1869":39897},[],"`cert-manager`",{"_3805":185,"_26540":87,"_22543":39899,"_5":26784,"_10604":39614,"_1869":39900},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_3805":186,"_26540":87,"_22543":39902,"_5":26784,"_10604":39622,"_1869":39903},[],"La función `request_config_data` solicita:",{"_3805":187,"_26540":87,"_22543":39905,"_5":26784,"_10604":39622,"_1869":39906},[],"Dominio Lamassu",{"_3805":188,"_26540":87,"_22543":39908,"_5":26784,"_10604":39622,"_1869":39909},[],"Usuario y contraseña admin PostgreSQL",{"_3805":189,"_26540":87,"_22543":39911,"_5":26784,"_10604":39622,"_1869":39912},[],"Usuario y contraseña admin RabbitMQ",{"_3805":190,"_26540":87,"_22543":39914,"_5":26784,"_10604":39622,"_1869":39915},[],"Usuario y contraseña admin Keycloak",{"_3805":191,"_26540":87,"_22543":39917,"_5":26784,"_10604":39622,"_1869":39918},[],"Namespace Kubernetes",{"_3805":192,"_26540":87,"_22543":39920,"_5":26784,"_10604":39626,"_1869":39921},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_3805":193,"_26540":87,"_22543":39923,"_5":26784,"_10604":39626,"_1869":39924},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_3805":194,"_26540":87,"_22543":39926,"_5":26784,"_10604":39630,"_1869":39927},[],"El script admite dos estrategias para obtener charts Helm.",{"_3805":195,"_26540":87,"_22543":39929,"_5":26784,"_10604":39634,"_1869":39930},[],"Los charts se descargan desde repositorios remotos.",{"_3805":196,"_26540":87,"_22543":39932,"_5":26784,"_10604":39638,"_1869":39933},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_3805":197,"_26540":87,"_22543":39935,"_5":26784,"_10604":39638,"_1869":39806},[],{"_3805":198,"_26540":87,"_22543":39937,"_5":26784,"_10604":39638,"_1869":39814},[],{"_3805":199,"_26540":87,"_22543":39939,"_5":26784,"_10604":39638,"_1869":39822},[],{"_3805":200,"_26540":87,"_22543":39941,"_5":26784,"_10604":39638,"_1869":39830},[],{"_3805":201,"_26540":87,"_22543":39943,"_5":26784,"_10604":39638,"_1869":39944},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_3805":202,"_26540":87,"_22543":39946,"_5":26784,"_10604":39638,"_1869":39947},[],"En este modo se fuerza:",{"_3805":203,"_26540":87,"_22543":39949,"_5":26784,"_10604":39646,"_1869":39950},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_3805":204,"_26540":87,"_22543":39952,"_5":26784,"_10604":39646,"_1869":39953},[],"Versión del chart: `0.19.0`",{"_3805":205,"_26540":87,"_22543":39955,"_5":26784,"_10604":39646,"_1869":39956},[],"Release: `postgres`",{"_3805":206,"_26540":87,"_22543":39958,"_5":26784,"_10604":39646,"_1869":39959},[],"`fullnameOverride: \"postgresql\"`",{"_3805":207,"_26540":87,"_22543":39961,"_5":26784,"_10604":39646,"_1869":39962},[],"El script SQL de inicialización crea una base de datos por servicio: `auth` para Keycloak, `alerts` para Alerts, `ca` para CA, `va` para VA, `cloudproxy` para Cloud Proxy, `devicemanager` para Device Manager, `dmsmanager` para DMS Manager y `kms` para KMS.",{"_3805":208,"_26540":87,"_22543":39964,"_5":26784,"_10604":39650,"_1869":39965},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_3805":209,"_26540":87,"_22543":39967,"_5":26784,"_10604":39650,"_1869":39968},[],"Versión del chart: `0.20.0`",{"_3805":210,"_26540":87,"_22543":39970,"_5":26784,"_10604":39650,"_1869":39971},[],"Release: `auth`",{"_3805":211,"_26540":87,"_22543":39973,"_5":26784,"_10604":39650,"_1869":39974},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_3805":212,"_26540":87,"_22543":39976,"_5":26784,"_10604":39650,"_1869":39977},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_3805":213,"_26540":87,"_22543":39979,"_5":26784,"_10604":39650,"_1869":39980},[],"`httpRelativePath: /auth/`",{"_3805":214,"_26540":87,"_22543":39982,"_5":26784,"_10604":39650,"_1869":39983},[],"`proxyHeaders: xforwarded`",{"_3805":215,"_26540":87,"_22543":39985,"_5":26784,"_10604":39650,"_1869":39986},[],"Configuración automática del realm `lamassu`:",{"_3805":216,"_26540":87,"_22543":39988,"_5":26784,"_10604":39650,"_1869":39989},[],"Rol: `pki-admin`",{"_3805":217,"_26540":87,"_22543":39991,"_5":26784,"_10604":39650,"_1869":39992},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_3805":218,"_26540":87,"_22543":39994,"_5":26784,"_10604":39650,"_1869":39995},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_3805":219,"_26540":87,"_22543":39997,"_5":26784,"_10604":39650,"_1869":39998},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_3805":220,"_26540":87,"_22543":40000,"_5":26784,"_10604":39650,"_1869":40001},[],"`github.com/lamassuiot/keycloak-theme`",{"_3805":221,"_26540":87,"_22543":40003,"_5":26784,"_10604":39654,"_1869":40004},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_3805":222,"_26540":87,"_22543":40006,"_5":26784,"_10604":39654,"_1869":39968},[],{"_3805":223,"_26540":87,"_22543":40008,"_5":26784,"_10604":39654,"_1869":40009},[],"Release: `rabbitmq`",{"_3805":224,"_26540":87,"_22543":40011,"_5":26784,"_10604":39654,"_1869":40012},[],"`fullnameOverride: \"rabbitmq\"`",{"_3805":225,"_26540":87,"_22543":40014,"_5":26784,"_10604":39654,"_1869":40015},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_3805":226,"_26540":87,"_22543":40017,"_5":26784,"_10604":39658,"_1869":40018},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_3805":227,"_26540":87,"_22543":40020,"_5":26784,"_10604":39658,"_1869":40021},[],"Configuraciones principales:",{"_3805":228,"_26540":87,"_22543":40023,"_5":26784,"_10604":39658,"_1869":40024},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_3805":229,"_26540":87,"_22543":40026,"_5":26784,"_10604":39658,"_1869":40027},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_3805":230,"_26540":87,"_22543":40029,"_5":26784,"_10604":39658,"_1869":40030},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_3805":231,"_26540":87,"_22543":40032,"_5":26784,"_10604":39658,"_1869":40033},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_3805":232,"_26540":87,"_22543":40035,"_5":26784,"_10604":39658,"_1869":40036},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_3805":233,"_26540":87,"_22543":40038,"_5":26784,"_10604":39658,"_1869":40039},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_3805":234,"_26540":87,"_22543":40041,"_5":26784,"_10604":39658,"_1869":40042},[],"Dominios CA: valor de `--domain`",{"_3805":235,"_26540":87,"_22543":40044,"_5":26784,"_10604":39658,"_1869":40045},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_3805":236,"_26540":87,"_22543":40047,"_5":26784,"_10604":39658,"_1869":40048},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_3805":237,"_26540":87,"_22543":40050,"_5":26784,"_10604":39658,"_1869":40051},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_3805":238,"_26540":87,"_22543":40053,"_5":26784,"_10604":39666,"_1869":40054},[],"Si se proporcionan:",{"_3805":239,"_26540":87,"_22543":40056,"_5":26784,"_10604":39666,"_1869":39790},[],{"_3805":240,"_26540":87,"_22543":40058,"_5":26784,"_10604":39666,"_1869":39798},[],{"_3805":241,"_26540":87,"_22543":40060,"_5":26784,"_10604":39666,"_1869":40061},[],"Se crea un secret Kubernetes:",{"_3805":242,"_26540":87,"_22543":40063,"_5":26784,"_10604":39666,"_1869":40064},[],"`downstream-provided-crt`",{"_3805":243,"_26540":87,"_22543":40066,"_5":26784,"_10604":39666,"_1869":40067},[],"Y se configura:",{"_3805":244,"_26540":87,"_22543":40069,"_5":26784,"_10604":39670,"_1869":40070},[],"Si no se proporciona certificado:",{"_3805":245,"_26540":87,"_22543":40072,"_5":26784,"_10604":39670,"_1869":40073},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_3805":246,"_26540":87,"_22543":40075,"_5":26784,"_10604":39670,"_1869":40076},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_3805":247,"_26540":87,"_22543":40078,"_5":26784,"_10604":39674,"_1869":40079},[],"En caso de éxito, se muestra:",{"_3805":248,"_26540":87,"_22543":40081,"_5":26784,"_10604":39674,"_1869":40082},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_3805":249,"_26540":87,"_22543":40084,"_5":26784,"_10604":39674,"_1869":40085},[],"Credenciales iniciales: `lamassu / lamassu`",{"_3805":250,"_26540":87,"_22543":40087,"_5":26784,"_10604":39674,"_1869":40088},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_3805":251,"_26540":87,"_22543":40090,"_5":26784,"_10604":39674,"_1869":40091},[],"Credenciales admin de Keycloak",{"_3805":252,"_26540":87,"_22543":40093,"_5":26784,"_10604":39674,"_1869":40094},[],"El usuario `lamassu` se crea con:",{"_3805":253,"_26540":87,"_22543":40096,"_5":26784,"_10604":39674,"_1869":40097},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_3805":254,"_26540":87,"_22543":40099,"_5":26784,"_10604":39674,"_1869":40100},[],"Fastlane también provisiona un principal de autorización `oidc:lamassu` que coincide con el claim `preferred_username=lamassu` y le concede la política `SUPER ADMIN`. Si activas los datos de ejemplo, crea además un principal independiente para la cuenta de servicio correspondiente.",{"_3805":255,"_26540":87,"_22543":40102,"_5":26784,"_10604":39674,"_1869":40103},[],"Este bootstrap está pensado para laboratorio, demos y CI. En producción, sustituye el principal por un rol o grupo administrado en tu proveedor OIDC y sigue Control de acceso.",{"_3805":256,"_26540":87,"_22543":40105,"_5":26784,"_10604":39678,"_1869":40106},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_3805":257,"_26540":87,"_22543":40108,"_5":26784,"_10604":39678,"_1869":40109},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_3805":258,"_26540":87,"_22543":40111,"_5":26784,"_10604":39678,"_1869":40112},[],"Ejemplo:",{"_3805":259,"_26540":87,"_22543":40114,"_5":26784,"_10604":39678,"_1869":40115},[],"En este escenario:",{"_3805":260,"_26540":87,"_22543":40117,"_5":26784,"_10604":39678,"_1869":40118},[],"`-n`: modo no interactivo",{"_3805":261,"_26540":87,"_22543":40120,"_5":26784,"_10604":39678,"_1869":40121},[],"`-ns`: namespace específico",{"_3805":262,"_26540":87,"_22543":40123,"_5":26784,"_10604":39678,"_1869":40124},[],"`-d`: dominio de CI",{"_3805":263,"_26540":87,"_22543":40126,"_5":26784,"_10604":39678,"_1869":40127},[],"`-l`: chart local",{"_3805":264,"_26540":87,"_22543":40129,"_5":26784,"_10604":39686,"_1869":40130},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_3805":265,"_26540":87,"_22543":40132,"_5":26784,"_10604":39686,"_1869":40133},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_3805":266,"_26540":266,"_5":26779,"_1869":39453,"_26792":40135,"_22543":40136,"_10604":266},[39346,39347,39453],[],{"_3805":267,"_26540":266,"_22543":40138,"_5":26784,"_10604":266,"_1869":40139},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_3805":268,"_26540":266,"_5":26789,"_22543":40141,"_10604":40142,"_1869":40143},[],"/docs/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3805":269,"_26540":266,"_5":26789,"_22543":40145,"_10604":40146,"_1869":40147},[],"/docs/deployment/self-hosted/overview#quickstart","Quickstart",{"_3805":270,"_26540":266,"_5":26789,"_22543":40149,"_10604":40150,"_1869":40151},[],"/docs/deployment/self-hosted/overview#qué-se-despliega","Qué se despliega",{"_3805":271,"_26540":266,"_5":26789,"_22543":40153,"_10604":40154,"_1869":40155},[],"/docs/deployment/self-hosted/overview#requisitos-previos","Requisitos previos",{"_3805":272,"_26540":266,"_5":26789,"_22543":40157,"_10604":40158,"_1869":40159},[],"/docs/deployment/self-hosted/overview#opciones-de-despliegue","Opciones de despliegue",{"_3805":273,"_26540":266,"_5":26789,"_22543":40161,"_10604":40162,"_1869":40163},[],"/docs/deployment/self-hosted/overview#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_3805":274,"_26540":266,"_5":26789,"_22543":40165,"_10604":40166,"_1869":40167},[],"/docs/deployment/self-hosted/overview#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_3805":275,"_26540":266,"_5":26789,"_22543":40169,"_10604":40170,"_1869":40171},[],"/docs/deployment/self-hosted/overview#arquitectura","Arquitectura",{"_3805":276,"_26540":266,"_5":26789,"_22543":40173,"_10604":40174,"_1869":40175},[],"/docs/deployment/self-hosted/overview#instalación-manual-con-helm","Instalación manual con Helm",{"_3805":277,"_26540":266,"_5":26789,"_22543":40177,"_10604":40178,"_1869":40179},[],"/docs/deployment/self-hosted/overview#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_3805":278,"_26540":266,"_5":26789,"_22543":40181,"_10604":40182,"_1869":40183},[],"/docs/deployment/self-hosted/overview#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3805":279,"_26540":266,"_5":26789,"_22543":40185,"_10604":40186,"_1869":40187},[],"/docs/deployment/self-hosted/overview#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_3805":280,"_26540":266,"_5":26789,"_22543":40189,"_10604":40190,"_1869":40191},[],"/docs/deployment/self-hosted/overview#verificación-del-despliegue","Verificación del despliegue",{"_3805":281,"_26540":266,"_5":26789,"_22543":40193,"_10604":40194,"_1869":40195},[],"/docs/deployment/self-hosted/overview#repositorio-helm","Repositorio Helm",{"_3805":282,"_26540":266,"_5":26789,"_22543":40197,"_10604":40198,"_1869":40199},[],"/docs/deployment/self-hosted/overview#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_3805":283,"_26540":266,"_5":26789,"_22543":40201,"_10604":40202,"_1869":40203},[],"/docs/deployment/self-hosted/overview#versionado-y-migraciones","Versionado y migraciones",{"_3805":284,"_26540":266,"_22543":40205,"_5":26784,"_10604":40142,"_1869":40206},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_3805":285,"_26540":266,"_22543":40208,"_5":26784,"_10604":40142,"_1869":40209},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_3805":286,"_26540":266,"_22543":40211,"_5":26784,"_10604":40142,"_1869":40212},[],"el chart principal de Lamassu",{"_3805":287,"_26540":266,"_22543":40214,"_5":26784,"_10604":40142,"_1869":40215},[],"un chart auxiliar de SoftHSM",{"_3805":288,"_26540":266,"_22543":40217,"_5":26784,"_10604":40142,"_1869":40218},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_3805":289,"_26540":266,"_22543":40220,"_5":26784,"_10604":40146,"_1869":40221},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_3805":290,"_26540":266,"_22543":40223,"_5":26784,"_10604":40146,"_1869":40224},[],"Ese flujo:",{"_3805":291,"_26540":266,"_22543":40226,"_5":26784,"_10604":40146,"_1869":40227},[],"crea o reutiliza el namespace indicado",{"_3805":292,"_26540":266,"_22543":40229,"_5":26784,"_10604":40146,"_1869":40230},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_3805":293,"_26540":266,"_22543":40232,"_5":26784,"_10604":40146,"_1869":40233},[],"despliega el chart de Lamassu",{"_3805":294,"_26540":266,"_22543":40235,"_5":26784,"_10604":40146,"_1869":40236},[],"deja la UI expuesta en `https://<dominio>`",{"_3805":295,"_26540":266,"_22543":40238,"_5":26784,"_10604":40146,"_1869":40239},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_3805":296,"_26540":266,"_22543":40241,"_5":26784,"_10604":40150,"_1869":40242},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_3805":297,"_26540":266,"_22543":40244,"_5":26784,"_10604":40150,"_1869":40245},[],"`ui`",{"_3805":298,"_26540":266,"_22543":40247,"_5":26784,"_10604":40150,"_1869":40248},[],"`ca`",{"_3805":299,"_26540":266,"_22543":40250,"_5":26784,"_10604":40150,"_1869":40251},[],"`va`",{"_3805":300,"_26540":266,"_22543":40253,"_5":26784,"_10604":40150,"_1869":40254},[],"`kms`",{"_3805":301,"_26540":266,"_22543":40256,"_5":26784,"_10604":40150,"_1869":40257},[],"`device-manager`",{"_3805":302,"_26540":266,"_22543":40259,"_5":26784,"_10604":40150,"_1869":40260},[],"`dms-manager`",{"_3805":303,"_26540":266,"_22543":40262,"_5":26784,"_10604":40150,"_1869":40263},[],"`alerts`",{"_3805":304,"_26540":266,"_22543":40265,"_5":26784,"_10604":40150,"_1869":40266},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_3805":305,"_26540":266,"_22543":40268,"_5":26784,"_10604":40150,"_1869":40269},[],"job de migraciones de base de datos",{"_3805":306,"_26540":266,"_22543":40271,"_5":26784,"_10604":40154,"_1869":40272},[],"Clúster Kubernetes `1.19+`",{"_3805":307,"_26540":266,"_22543":40274,"_5":26784,"_10604":40154,"_1869":40275},[],"`kubectl` configurado con acceso al clúster",{"_3805":308,"_26540":266,"_22543":40277,"_5":26784,"_10604":40154,"_1869":40278},[],"Helm `3.2.0+`",{"_3805":309,"_26540":266,"_22543":40280,"_5":26784,"_10604":40154,"_1869":40281},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_3805":310,"_26540":266,"_22543":40283,"_5":26784,"_10604":40154,"_1869":40284},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_3805":311,"_26540":266,"_22543":40286,"_5":26784,"_10604":40154,"_1869":40287},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_3805":312,"_26540":266,"_22543":40289,"_5":26784,"_10604":40154,"_1869":40290},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_3805":313,"_26540":266,"_22543":40292,"_5":26784,"_10604":40158,"_1869":40293},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_3805":314,"_26540":266,"_22543":40295,"_5":26784,"_10604":40162,"_1869":40296},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_3805":315,"_26540":266,"_22543":40298,"_5":26784,"_10604":40166,"_1869":40299},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_3805":316,"_26540":266,"_22543":40301,"_5":26784,"_10604":40170,"_1869":40302},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_3805":317,"_26540":266,"_22543":40304,"_5":26784,"_10604":40170,"_1869":40305},[],"Dependencias externas requeridas por el chart principal:",{"_3805":318,"_26540":266,"_22543":40307,"_5":26784,"_10604":40170,"_1869":39696},[],{"_3805":319,"_26540":266,"_22543":40309,"_5":26784,"_10604":40170,"_1869":39702},[],{"_3805":320,"_26540":266,"_22543":40311,"_5":26784,"_10604":40170,"_1869":40312},[],"proveedor OIDC, típicamente Keycloak",{"_3805":321,"_26540":266,"_22543":40314,"_5":26784,"_10604":40170,"_1869":40315},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_3805":322,"_26540":266,"_22543":40317,"_5":26784,"_10604":40174,"_1869":40318},[],"Agregar el repositorio Helm:",{"_3805":323,"_26540":266,"_22543":40320,"_5":26784,"_10604":40174,"_1869":40321},[],"O instalar desde una copia local del repositorio:",{"_3805":324,"_26540":266,"_22543":40323,"_5":26784,"_10604":40178,"_1869":40324},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_3805":325,"_26540":266,"_22543":40326,"_5":26784,"_10604":40178,"_1869":40327},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_3805":326,"_26540":266,"_22543":40329,"_5":26784,"_10604":40178,"_1869":40330},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_3805":327,"_26540":266,"_22543":40332,"_5":26784,"_10604":40178,"_1869":40333},[],"`auth.oidc.frontend.authority`",{"_3805":328,"_26540":266,"_22543":40335,"_5":26784,"_10604":40178,"_1869":40336},[],"`auth.oidc.apiGateway.jwks`",{"_3805":329,"_26540":266,"_22543":40338,"_5":26784,"_10604":40178,"_1869":40339},[],"`services.authz.jwkUrl` y un principal de bootstrap que coincida con un administrador real",{"_3805":330,"_26540":266,"_22543":40341,"_5":26784,"_10604":40178,"_1869":40342},[],"`services.ca.domains`",{"_3805":331,"_26540":266,"_22543":40344,"_5":26784,"_10604":40178,"_1869":40345},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_3805":332,"_26540":266,"_22543":40347,"_5":26784,"_10604":40178,"_1869":40348},[],"`tls.*` según se use `certManager` o certificado externo",{"_3805":333,"_26540":266,"_22543":40350,"_5":26784,"_10604":40178,"_1869":40351},[],"Ejemplo base:",{"_3805":334,"_26540":266,"_22543":40353,"_5":26784,"_10604":40182,"_1869":40354},[],"No hay un superusuario implícito. Antes de instalar, crea el rol `pki-admin` en el proveedor OIDC y asígnalo al grupo que administrará Lamassu. El principal del ejemplo concede la política `SUPER ADMIN` a cualquier token que contenga ese rol.",{"_3805":335,"_26540":266,"_22543":40356,"_5":26784,"_10604":40182,"_1869":40357},[],"El Job `pre-install` y `pre-upgrade` prepara las bases de datos, ejecuta las migraciones de authz, precarga las políticas y aplica `services.authz.bootstrap` antes de que arranquen los Deployments. El bootstrap es idempotente: conserva los principales existentes y añade únicamente los grants que falten.",{"_3805":336,"_26540":266,"_22543":40359,"_5":26784,"_10604":40182,"_1869":40360},[],"Si ningún token coincide con un principal activo, nadie podrá administrar la PKI. Prueba una identidad autorizada y otra denegada, y conserva un procedimiento de recuperación.",{"_3805":337,"_26540":266,"_22543":40362,"_5":26784,"_10604":40182,"_1869":40363},[],"Consulta Control de acceso para diseñar principales y políticas.",{"_3805":338,"_26540":266,"_22543":40365,"_5":26784,"_10604":40186,"_1869":40366},[],"**TLS:** `tls.type`, `tls.certManagerOptions.*` y `tls.externalOptions.secretName` controlan el certificado *downstream* del Gateway.",{"_3805":339,"_26540":266,"_22543":40368,"_5":26784,"_10604":40186,"_1869":40369},[],"**Gateway:** `gateway.addresses`, `gateway.ports.*` y `gateway.extraRouting` publican la UI y las APIs mediante Envoy Gateway.",{"_3805":340,"_26540":266,"_22543":40371,"_5":26784,"_10604":40186,"_1869":40372},[],"**Persistencia:** `postgres.*` define la conexión a PostgreSQL.",{"_3805":341,"_26540":266,"_22543":40374,"_5":26784,"_10604":40186,"_1869":40375},[],"**Mensajería:** `amqp.*` configura la conexión a RabbitMQ.",{"_3805":342,"_26540":266,"_22543":40377,"_5":26784,"_10604":40186,"_1869":40378},[],"**Identidad y autorización:** `auth.oidc.*`, `services.authz.jwkUrl` y `services.authz.bootstrap` configuran login, validación JWT y permisos iniciales.",{"_3805":343,"_26540":266,"_22543":40380,"_5":26784,"_10604":40186,"_1869":40381},[],"**Autoridades:** `services.ca.domains` establece los dominios autorizados para CA y certificados.",{"_3805":344,"_26540":266,"_22543":40383,"_5":26784,"_10604":40186,"_1869":40384},[],"**Claves:** `services.kms.cryptoEngines.*` configura los motores criptográficos y su almacenamiento.",{"_3805":345,"_26540":266,"_22543":40386,"_5":26784,"_10604":40186,"_1869":40387},[],"**Alertas:** `services.alerts.smtp_server.*` prepara el envío de correo.",{"_3805":346,"_26540":266,"_22543":40389,"_5":26784,"_10604":40190,"_1869":40390},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_3805":347,"_26540":266,"_22543":40392,"_5":26784,"_10604":40190,"_1869":40393},[],"La prueba comprueba al menos:",{"_3805":348,"_26540":266,"_22543":40395,"_5":26784,"_10604":40190,"_1869":40396},[],"salud de `ca`",{"_3805":349,"_26540":266,"_22543":40398,"_5":26784,"_10604":40190,"_1869":40399},[],"salud de `dms-manager`",{"_3805":350,"_26540":266,"_22543":40401,"_5":26784,"_10604":40190,"_1869":40402},[],"salud de `device-manager`",{"_3805":351,"_26540":266,"_22543":40404,"_5":26784,"_10604":40190,"_1869":40405},[],"salud de `va`",{"_3805":352,"_26540":266,"_22543":40407,"_5":26784,"_10604":40190,"_1869":40408},[],"respuesta HTML esperada del servicio `ui`",{"_3805":353,"_26540":266,"_22543":40410,"_5":26784,"_10604":40194,"_1869":40411},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_3805":354,"_26540":266,"_22543":40413,"_5":26784,"_10604":40194,"_1869":40414},[],"`charts/lamassu`: chart principal de Lamassu",{"_3805":355,"_26540":266,"_22543":40416,"_5":26784,"_10604":40194,"_1869":40417},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_3805":356,"_26540":266,"_22543":40419,"_5":26784,"_10604":40194,"_1869":40420},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_3805":357,"_26540":266,"_22543":40422,"_5":26784,"_10604":40198,"_1869":40423},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_3805":358,"_26540":266,"_22543":40425,"_5":26784,"_10604":40202,"_1869":40426},[],"La versión actual del chart en el repositorio es `3.8.0`. Para upgrades entre versiones, consulta las guías de `charts/lamassu/CHANGELOG/` y revisa especialmente las migraciones de base de datos y el bootstrap de authz.",{"_3805":359,"_26540":359,"_5":26779,"_1869":40428,"_26792":40429,"_22543":40432,"_10604":359},"Control de acceso",[39346,40430,40431],"Plataforma","Administrar Lamassu",[],{"_3805":360,"_26540":359,"_22543":40434,"_5":26784,"_10604":359,"_1869":40435},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3805":361,"_26540":359,"_5":26789,"_22543":40437,"_10604":40438,"_1869":40439},[],"/docs/platform/pki/access-control#conceptos-esenciales","Conceptos esenciales",{"_3805":362,"_26540":359,"_5":26789,"_22543":40441,"_10604":40442,"_1869":40443},[],"/docs/platform/pki/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3805":363,"_26540":359,"_5":26789,"_22543":40445,"_10604":40446,"_1869":40447},[],"/docs/platform/pki/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3805":364,"_26540":359,"_5":26789,"_22543":40449,"_10604":40450,"_1869":40451},[],"/docs/platform/pki/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3805":365,"_26540":359,"_5":26789,"_22543":40453,"_10604":40454,"_1869":40455},[],"/docs/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3805":366,"_26540":359,"_5":26789,"_22543":40457,"_10604":40458,"_1869":40459},[],"/docs/platform/pki/access-control#principales-oidc","Principales OIDC",{"_3805":367,"_26540":359,"_5":26789,"_22543":40461,"_10604":40462,"_1869":40463},[],"/docs/platform/pki/access-control#principales-x509","Principales X.509",{"_3805":368,"_26540":359,"_5":26789,"_22543":40465,"_10604":40466,"_1869":40467},[],"/docs/platform/pki/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3805":369,"_26540":359,"_5":26789,"_22543":40469,"_10604":40470,"_1869":40471},[],"/docs/platform/pki/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3805":370,"_26540":359,"_5":26789,"_22543":40473,"_10604":40474,"_1869":40475},[],"/docs/platform/pki/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3805":371,"_26540":359,"_5":26789,"_22543":40477,"_10604":40478,"_1869":40479},[],"/docs/platform/pki/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3805":372,"_26540":359,"_5":26789,"_22543":40481,"_10604":40482,"_1869":40483},[],"/docs/platform/pki/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3805":373,"_26540":359,"_5":26789,"_22543":40485,"_10604":40486,"_1869":40487},[],"/docs/platform/pki/access-control#reglas-http","Reglas HTTP",{"_3805":374,"_26540":359,"_5":26789,"_22543":40489,"_10604":40490,"_1869":40491},[],"/docs/platform/pki/access-control#políticas-incluidas","Políticas incluidas",{"_3805":375,"_26540":359,"_5":26789,"_22543":40493,"_10604":40494,"_1869":40183},[],"/docs/platform/pki/access-control#provisiona-el-primer-administrador",{"_3805":376,"_26540":359,"_5":26789,"_22543":40496,"_10604":40497,"_1869":40498},[],"/docs/platform/pki/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3805":377,"_26540":359,"_5":26789,"_22543":40500,"_10604":40501,"_1869":40502},[],"/docs/platform/pki/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_3805":378,"_26540":359,"_5":26789,"_22543":40504,"_10604":40505,"_1869":40506},[],"/docs/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3805":379,"_26540":359,"_5":26789,"_22543":40508,"_10604":40509,"_1869":40510},[],"/docs/platform/pki/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3805":380,"_26540":359,"_5":26789,"_22543":40512,"_10604":40513,"_1869":40514},[],"/docs/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3805":381,"_26540":359,"_5":26789,"_22543":40516,"_10604":40517,"_1869":40518},[],"/docs/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3805":382,"_26540":359,"_5":26789,"_22543":40520,"_10604":40521,"_1869":40522},[],"/docs/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3805":383,"_26540":359,"_5":26789,"_22543":40524,"_10604":40525,"_1869":40526},[],"/docs/platform/pki/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3805":384,"_26540":359,"_5":26789,"_22543":40528,"_10604":40529,"_1869":40530},[],"/docs/platform/pki/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3805":385,"_26540":359,"_5":26789,"_22543":40532,"_10604":40533,"_1869":40534},[],"/docs/platform/pki/access-control#diagnóstico","Diagnóstico",{"_3805":386,"_26540":359,"_5":26789,"_22543":40536,"_10604":40537,"_1869":40538},[],"/docs/platform/pki/access-control#la-respuesta-es-401","La respuesta es 401",{"_3805":387,"_26540":359,"_5":26789,"_22543":40540,"_10604":40541,"_1869":40542},[],"/docs/platform/pki/access-control#la-respuesta-es-403","La respuesta es 403",{"_3805":388,"_26540":359,"_5":26789,"_22543":40544,"_10604":40545,"_1869":40546},[],"/docs/platform/pki/access-control#todo-devuelve-403","Todo devuelve 403",{"_3805":389,"_26540":359,"_5":26789,"_22543":40548,"_10604":40549,"_1869":40550},[],"/docs/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3805":390,"_26540":359,"_22543":40552,"_5":26784,"_10604":359,"_1869":40553},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3805":391,"_26540":359,"_22543":40555,"_5":26784,"_10604":359,"_1869":40556},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3805":392,"_26540":359,"_22543":40558,"_5":26784,"_10604":359,"_1869":40559},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3805":393,"_26540":359,"_22543":40561,"_5":26784,"_10604":40438,"_1869":40562},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3805":394,"_26540":359,"_22543":40564,"_5":26784,"_10604":40438,"_1869":40565},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3805":395,"_26540":359,"_22543":40567,"_5":26784,"_10604":40438,"_1869":40568},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3805":396,"_26540":359,"_22543":40570,"_5":26784,"_10604":40438,"_1869":40571},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3805":397,"_26540":359,"_22543":40573,"_5":26784,"_10604":40438,"_1869":40574},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3805":398,"_26540":359,"_22543":40576,"_5":26784,"_10604":40438,"_1869":40577},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_3805":399,"_26540":359,"_22543":40579,"_5":26784,"_10604":40442,"_1869":40580},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3805":400,"_26540":359,"_22543":40582,"_5":26784,"_10604":40442,"_1869":40583},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3805":401,"_26540":359,"_22543":40585,"_5":26784,"_10604":40446,"_1869":40586},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3805":402,"_26540":359,"_22543":40588,"_5":26784,"_10604":40446,"_1869":40589},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3805":403,"_26540":359,"_22543":40591,"_5":26784,"_10604":40446,"_1869":40592},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3805":404,"_26540":359,"_22543":40594,"_5":26784,"_10604":40446,"_1869":40595},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3805":405,"_26540":359,"_22543":40597,"_5":26784,"_10604":40446,"_1869":40598},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3805":406,"_26540":359,"_22543":40600,"_5":26784,"_10604":40446,"_1869":40601},[],"Carga por separado las políticas concedidas a cada principal.",{"_3805":407,"_26540":359,"_22543":40603,"_5":26784,"_10604":40446,"_1869":40604},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3805":408,"_26540":359,"_22543":40606,"_5":26784,"_10604":40446,"_1869":40607},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3805":409,"_26540":359,"_22543":40609,"_5":26784,"_10604":40446,"_1869":40610},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_3805":410,"_26540":359,"_22543":40612,"_5":26784,"_10604":40446,"_1869":40613},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3805":411,"_26540":359,"_22543":40615,"_5":26784,"_10604":40446,"_1869":40616},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3805":412,"_26540":359,"_22543":40618,"_5":26784,"_10604":40446,"_1869":40619},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_3805":413,"_26540":359,"_22543":40621,"_5":26784,"_10604":40450,"_1869":40622},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3805":414,"_26540":359,"_22543":40624,"_5":26784,"_10604":40450,"_1869":40625},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3805":415,"_26540":359,"_22543":40627,"_5":26784,"_10604":40450,"_1869":40628},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3805":416,"_26540":359,"_22543":40630,"_5":26784,"_10604":40450,"_1869":40631},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3805":417,"_26540":359,"_22543":40633,"_5":26784,"_10604":40450,"_1869":40634},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3805":418,"_26540":359,"_22543":40636,"_5":26784,"_10604":40450,"_1869":40637},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3805":419,"_26540":359,"_22543":40639,"_5":26784,"_10604":40450,"_1869":40640},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3805":420,"_26540":359,"_22543":40642,"_5":26784,"_10604":40450,"_1869":40643},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3805":421,"_26540":359,"_22543":40645,"_5":26784,"_10604":40450,"_1869":40646},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3805":422,"_26540":359,"_22543":40648,"_5":26784,"_10604":40450,"_1869":40649},[],"Las acciones se dividen en dos grupos:",{"_3805":423,"_26540":359,"_22543":40651,"_5":26784,"_10604":40450,"_1869":40652},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3805":424,"_26540":359,"_22543":40654,"_5":26784,"_10604":40450,"_1869":40655},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3805":425,"_26540":359,"_22543":40657,"_5":26784,"_10604":40450,"_1869":40658},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3805":426,"_26540":359,"_22543":40660,"_5":26784,"_10604":40454,"_1869":40661},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3805":427,"_26540":359,"_22543":40663,"_5":26784,"_10604":40454,"_1869":40664},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3805":428,"_26540":359,"_22543":40666,"_5":26784,"_10604":40454,"_1869":40667},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3805":429,"_26540":359,"_22543":40669,"_5":26784,"_10604":40458,"_1869":40670},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3805":430,"_26540":359,"_22543":40672,"_5":26784,"_10604":40458,"_1869":40673},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3805":431,"_26540":359,"_22543":40675,"_5":26784,"_10604":40458,"_1869":40676},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3805":432,"_26540":359,"_22543":40678,"_5":26784,"_10604":40458,"_1869":40679},[],"Los operadores implementados son:",{"_3805":433,"_26540":359,"_22543":40681,"_5":26784,"_10604":40458,"_1869":40682},[],"`equals`, para igualdad exacta;",{"_3805":434,"_26540":359,"_22543":40684,"_5":26784,"_10604":40458,"_1869":40685},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3805":435,"_26540":359,"_22543":40687,"_5":26784,"_10604":40458,"_1869":40688},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3805":436,"_26540":359,"_22543":40690,"_5":26784,"_10604":40458,"_1869":40691},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3805":437,"_26540":359,"_22543":40693,"_5":26784,"_10604":40462,"_1869":40694},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3805":438,"_26540":359,"_22543":40696,"_5":26784,"_10604":40462,"_1869":40697},[],"Los modos disponibles son:",{"_3805":439,"_26540":359,"_22543":40699,"_5":26784,"_10604":40462,"_1869":40700},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3805":440,"_26540":359,"_22543":40702,"_5":26784,"_10604":40462,"_1869":40703},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3805":441,"_26540":359,"_22543":40705,"_5":26784,"_10604":40462,"_1869":40706},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3805":442,"_26540":359,"_22543":40708,"_5":26784,"_10604":40462,"_1869":40709},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3805":443,"_26540":359,"_22543":40711,"_5":26784,"_10604":40462,"_1869":40712},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3805":444,"_26540":359,"_22543":40714,"_5":26784,"_10604":40462,"_1869":40715},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3805":445,"_26540":359,"_22543":40717,"_5":26784,"_10604":40466,"_1869":40718},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3805":446,"_26540":359,"_22543":40720,"_5":26784,"_10604":40466,"_1869":40721},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3805":447,"_26540":359,"_22543":40723,"_5":26784,"_10604":40466,"_1869":40724},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3805":448,"_26540":359,"_22543":40726,"_5":26784,"_10604":40466,"_1869":40727},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3805":449,"_26540":359,"_22543":40729,"_5":26784,"_10604":40474,"_1869":40730},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3805":450,"_26540":359,"_22543":40732,"_5":26784,"_10604":40474,"_1869":40733},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3805":451,"_26540":359,"_22543":40735,"_5":26784,"_10604":40478,"_1869":40736},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3805":452,"_26540":359,"_22543":40738,"_5":26784,"_10604":40478,"_1869":40739},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3805":453,"_26540":359,"_22543":40741,"_5":26784,"_10604":40482,"_1869":40742},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3805":454,"_26540":359,"_22543":40744,"_5":26784,"_10604":40482,"_1869":40745},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3805":455,"_26540":359,"_22543":40747,"_5":26784,"_10604":40482,"_1869":40748},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3805":456,"_26540":359,"_22543":40750,"_5":26784,"_10604":40486,"_1869":40751},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3805":457,"_26540":359,"_22543":40753,"_5":26784,"_10604":40486,"_1869":40754},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3805":458,"_26540":359,"_22543":40756,"_5":26784,"_10604":40486,"_1869":40757},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3805":459,"_26540":359,"_22543":40759,"_5":26784,"_10604":40490,"_1869":40760},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3805":460,"_26540":359,"_22543":40762,"_5":26784,"_10604":40490,"_1869":40763},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3805":461,"_26540":359,"_22543":40765,"_5":26784,"_10604":40490,"_1869":40766},[],"acceso completo y de solo lectura a KMS;",{"_3805":462,"_26540":359,"_22543":40768,"_5":26784,"_10604":40490,"_1869":40769},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3805":463,"_26540":359,"_22543":40771,"_5":26784,"_10604":40490,"_1869":40772},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3805":464,"_26540":359,"_22543":40774,"_5":26784,"_10604":40490,"_1869":40775},[],"acceso a la interfaz;",{"_3805":465,"_26540":359,"_22543":40777,"_5":26784,"_10604":40490,"_1869":40778},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3805":466,"_26540":359,"_22543":40780,"_5":26784,"_10604":40490,"_1869":40781},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3805":467,"_26540":359,"_22543":40783,"_5":26784,"_10604":40490,"_1869":40784},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3805":468,"_26540":359,"_22543":40786,"_5":26784,"_10604":40494,"_1869":40787},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3805":469,"_26540":359,"_22543":40789,"_5":26784,"_10604":40494,"_1869":40790},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3805":470,"_26540":359,"_22543":40792,"_5":26784,"_10604":40494,"_1869":40793},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3805":471,"_26540":359,"_22543":40795,"_5":26784,"_10604":40497,"_1869":40796},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3805":472,"_26540":359,"_22543":40798,"_5":26784,"_10604":40501,"_1869":40799},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_3805":473,"_26540":359,"_22543":40801,"_5":26784,"_10604":40505,"_1869":40802},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3805":474,"_26540":359,"_22543":40804,"_5":26784,"_10604":40509,"_1869":40805},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3805":475,"_26540":359,"_22543":40807,"_5":26784,"_10604":40513,"_1869":40808},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3805":476,"_26540":359,"_22543":40810,"_5":26784,"_10604":40517,"_1869":40811},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3805":477,"_26540":359,"_22543":40813,"_5":26784,"_10604":40517,"_1869":40814},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3805":478,"_26540":359,"_22543":40816,"_5":26784,"_10604":40521,"_1869":40817},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3805":479,"_26540":359,"_22543":40819,"_5":26784,"_10604":40521,"_1869":40820},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3805":480,"_26540":359,"_22543":40822,"_5":26784,"_10604":40521,"_1869":40823},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3805":481,"_26540":359,"_22543":40825,"_5":26784,"_10604":40521,"_1869":40826},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3805":482,"_26540":359,"_22543":40828,"_5":26784,"_10604":40521,"_1869":40829},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3805":483,"_26540":359,"_22543":40831,"_5":26784,"_10604":40521,"_1869":40832},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3805":484,"_26540":359,"_22543":40834,"_5":26784,"_10604":40521,"_1869":40835},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3805":485,"_26540":359,"_22543":40837,"_5":26784,"_10604":40521,"_1869":40838},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3805":486,"_26540":359,"_22543":40840,"_5":26784,"_10604":40525,"_1869":40841},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3805":487,"_26540":359,"_22543":40843,"_5":26784,"_10604":40525,"_1869":40844},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3805":488,"_26540":359,"_22543":40846,"_5":26784,"_10604":40525,"_1869":40847},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3805":489,"_26540":359,"_22543":40849,"_5":26784,"_10604":40529,"_1869":40850},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3805":490,"_26540":359,"_22543":40852,"_5":26784,"_10604":40529,"_1869":40853},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3805":491,"_26540":359,"_22543":40855,"_5":26784,"_10604":40529,"_1869":40856},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3805":492,"_26540":359,"_22543":40858,"_5":26784,"_10604":40529,"_1869":40859},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3805":493,"_26540":359,"_22543":40861,"_5":26784,"_10604":40529,"_1869":40862},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3805":494,"_26540":359,"_22543":40864,"_5":26784,"_10604":40529,"_1869":40865},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3805":495,"_26540":359,"_22543":40867,"_5":26784,"_10604":40529,"_1869":40868},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3805":496,"_26540":359,"_22543":40870,"_5":26784,"_10604":40537,"_1869":40871},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3805":497,"_26540":359,"_22543":40873,"_5":26784,"_10604":40541,"_1869":40874},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3805":498,"_26540":359,"_22543":40876,"_5":26784,"_10604":40541,"_1869":40877},[],"que exista un principal activo del tipo correcto;",{"_3805":499,"_26540":359,"_22543":40879,"_5":26784,"_10604":40541,"_1869":40880},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3805":500,"_26540":359,"_22543":40882,"_5":26784,"_10604":40541,"_1869":40883},[],"que todas las condiciones del principal se cumplan;",{"_3805":501,"_26540":359,"_22543":40885,"_5":26784,"_10604":40541,"_1869":40886},[],"que el principal tenga concedida la política esperada;",{"_3805":502,"_26540":359,"_22543":40888,"_5":26784,"_10604":40541,"_1869":40889},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3805":503,"_26540":359,"_22543":40891,"_5":26784,"_10604":40541,"_1869":40892},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3805":504,"_26540":359,"_22543":40894,"_5":26784,"_10604":40541,"_1869":40895},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_3805":505,"_26540":359,"_22543":40897,"_5":26784,"_10604":40545,"_1869":40898},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3805":506,"_26540":359,"_22543":40900,"_5":26784,"_10604":40549,"_1869":40901},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3805":507,"_26540":359,"_22543":40903,"_5":26784,"_10604":40549,"_1869":40904},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3805":508,"_26540":508,"_5":26779,"_1869":40906,"_26792":40907,"_22543":40909,"_10604":508},"Alertas y suscripciones",[39346,40430,40908],"Operar Lamassu",[],{"_3805":509,"_26540":508,"_22543":40911,"_5":26784,"_10604":508,"_1869":40912},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3805":510,"_26540":508,"_5":26789,"_22543":40914,"_10604":40915,"_1869":40916},[],"/docs/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_3805":511,"_26540":508,"_5":26789,"_22543":40918,"_10604":40919,"_1869":40920},[],"/docs/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_3805":512,"_26540":508,"_5":26789,"_22543":40922,"_10604":40923,"_1869":40924},[],"/docs/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_3805":513,"_26540":508,"_5":26789,"_22543":40926,"_10604":40927,"_1869":40928},[],"/docs/platform/pki/alerts#elige-el-evento","Elige el evento",{"_3805":514,"_26540":508,"_5":26789,"_22543":40930,"_10604":40931,"_1869":40932},[],"/docs/platform/pki/alerts#configura-el-destino","Configura el destino",{"_3805":515,"_26540":508,"_5":26789,"_22543":40934,"_10604":40935,"_1869":40936},[],"/docs/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3805":516,"_26540":508,"_5":26789,"_22543":40938,"_10604":40939,"_1869":40940},[],"/docs/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_3805":517,"_26540":508,"_5":26789,"_22543":40942,"_10604":40943,"_1869":40944},[],"/docs/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3805":518,"_26540":508,"_5":26789,"_22543":40946,"_10604":40947,"_1869":40948},[],"/docs/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_3805":519,"_26540":508,"_22543":40950,"_5":26784,"_10604":508,"_1869":40951},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3805":520,"_26540":508,"_22543":40953,"_5":26784,"_10604":40915,"_1869":40954},[],"Un servicio publica un evento de dominio.",{"_3805":521,"_26540":508,"_22543":40956,"_5":26784,"_10604":40915,"_1869":40957},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3805":522,"_26540":508,"_22543":40959,"_5":26784,"_10604":40915,"_1869":40960},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3805":523,"_26540":508,"_22543":40962,"_5":26784,"_10604":40915,"_1869":40963},[],"Lamassu entrega el evento al canal configurado.",{"_3805":524,"_26540":508,"_22543":40965,"_5":26784,"_10604":40915,"_1869":40966},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3805":525,"_26540":508,"_22543":40968,"_5":26784,"_10604":40919,"_1869":40969},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_3805":526,"_26540":508,"_22543":40971,"_5":26784,"_10604":40919,"_1869":40972},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3805":527,"_26540":508,"_22543":40974,"_5":26784,"_10604":40919,"_1869":40975},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3805":528,"_26540":508,"_22543":40977,"_5":26784,"_10604":40927,"_1869":40978},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3805":529,"_26540":508,"_22543":40980,"_5":26784,"_10604":40931,"_1869":40981},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3805":530,"_26540":508,"_22543":40983,"_5":26784,"_10604":40935,"_1869":40984},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3805":531,"_26540":508,"_22543":40986,"_5":26784,"_10604":40935,"_1869":40987},[],"**None** notifica todas las instancias del evento.",{"_3805":532,"_26540":508,"_22543":40989,"_5":26784,"_10604":40935,"_1869":40990},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3805":533,"_26540":508,"_22543":40992,"_5":26784,"_10604":40935,"_1869":40993},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3805":534,"_26540":508,"_22543":40995,"_5":26784,"_10604":40935,"_1869":40996},[],"**JavaScript** permite expresar lógica personalizada.",{"_3805":535,"_26540":508,"_22543":40998,"_5":26784,"_10604":40935,"_1869":40999},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3805":536,"_26540":508,"_22543":41001,"_5":26784,"_10604":40939,"_1869":41002},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3805":537,"_26540":508,"_22543":41004,"_5":26784,"_10604":40943,"_1869":41005},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3805":538,"_26540":508,"_22543":41007,"_5":26784,"_10604":40947,"_1869":41008},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3805":539,"_26540":508,"_22543":41010,"_5":26784,"_10604":40947,"_1869":41011},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3805":540,"_26540":508,"_22543":41013,"_5":26784,"_10604":40947,"_1869":41014},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_3805":541,"_26540":508,"_22543":41016,"_5":26784,"_10604":40947,"_1869":41017},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3805":542,"_26540":508,"_22543":41019,"_5":26784,"_10604":40947,"_1869":41020},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3805":543,"_26540":508,"_22543":41022,"_5":26784,"_10604":40947,"_1869":41023},[],"**Validación:** `va.role.crl.create`.",{"_3805":544,"_26540":508,"_22543":41025,"_5":26784,"_10604":40947,"_1869":41026},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_3805":545,"_26540":508,"_22543":41028,"_5":26784,"_10604":40947,"_1869":41029},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3805":546,"_26540":546,"_5":26779,"_1869":41031,"_26792":41032,"_22543":41033,"_10604":546},"Registros de auditoría",[39346,40430,40431],[],{"_3805":547,"_26540":546,"_22543":41035,"_5":26784,"_10604":546,"_1869":41036},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3805":548,"_26540":546,"_5":26789,"_22543":41038,"_10604":41039,"_1869":41040},[],"/docs/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3805":549,"_26540":546,"_5":26789,"_22543":41042,"_10604":41043,"_1869":41044},[],"/docs/platform/pki/audit-logs#cobertura","Cobertura",{"_3805":550,"_26540":546,"_5":26789,"_22543":41046,"_10604":41047,"_1869":41048},[],"/docs/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3805":551,"_26540":546,"_5":26789,"_22543":41050,"_10604":41051,"_1869":41052},[],"/docs/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_3805":552,"_26540":546,"_5":26789,"_22543":41054,"_10604":41055,"_1869":41056},[],"/docs/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3805":553,"_26540":546,"_5":26789,"_22543":41058,"_10604":41059,"_1869":41060},[],"/docs/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3805":554,"_26540":546,"_5":26789,"_22543":41062,"_10604":41063,"_1869":41064},[],"/docs/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_3805":555,"_26540":546,"_5":26789,"_22543":41066,"_10604":41067,"_1869":41068},[],"/docs/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3805":556,"_26540":546,"_5":26789,"_22543":41070,"_10604":41071,"_1869":41072},[],"/docs/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3805":557,"_26540":546,"_5":26789,"_22543":41074,"_10604":41075,"_1869":41076},[],"/docs/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3805":558,"_26540":546,"_5":26789,"_22543":41078,"_10604":41079,"_1869":41080},[],"/docs/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_3805":559,"_26540":546,"_22543":41082,"_5":26784,"_10604":546,"_1869":41083},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3805":560,"_26540":546,"_22543":41085,"_5":26784,"_10604":41039,"_1869":41086},[],"El cuerpo de auditoría incluye:",{"_3805":561,"_26540":546,"_22543":41088,"_5":26784,"_10604":41039,"_1869":41089},[],"input: datos recibidos por la operación;",{"_3805":562,"_26540":546,"_22543":41091,"_5":26784,"_10604":41039,"_1869":41092},[],"has\\_error: indica si el servicio devolvió un error;",{"_3805":563,"_26540":546,"_22543":41094,"_5":26784,"_10604":41039,"_1869":41095},[],"output: resultado producido o mensaje de error;",{"_3805":564,"_26540":546,"_22543":41097,"_5":26784,"_10604":41039,"_1869":41098},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3805":565,"_26540":546,"_22543":41100,"_5":26784,"_10604":41039,"_1869":41101},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3805":566,"_26540":546,"_22543":41103,"_5":26784,"_10604":41039,"_1869":41104},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3805":567,"_26540":546,"_22543":41106,"_5":26784,"_10604":41043,"_1869":41107},[],"El backend aplica auditoría a mutaciones de:",{"_3805":568,"_26540":546,"_22543":41109,"_5":26784,"_10604":41043,"_1869":41110},[],"autoridades, certificados y perfiles de emisión;",{"_3805":569,"_26540":546,"_22543":41112,"_5":26784,"_10604":41043,"_1869":41113},[],"claves y motores KMS;",{"_3805":570,"_26540":546,"_22543":41115,"_5":26784,"_10604":41043,"_1869":41116},[],"dispositivos e identidades;",{"_3805":571,"_26540":546,"_22543":41118,"_5":26784,"_10604":41043,"_1869":41119},[],"DMS y operaciones de enrolamiento;",{"_3805":572,"_26540":546,"_22543":41121,"_5":26784,"_10604":41043,"_1869":41122},[],"funciones de validación y CRL;",{"_3805":573,"_26540":546,"_22543":41124,"_5":26784,"_10604":41043,"_1869":41125},[],"principales, políticas y concesiones de autorización.",{"_3805":574,"_26540":546,"_22543":41127,"_5":26784,"_10604":41043,"_1869":41128},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3805":575,"_26540":546,"_22543":41130,"_5":26784,"_10604":41047,"_1869":41131},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3805":576,"_26540":546,"_22543":41133,"_5":26784,"_10604":41047,"_1869":41134},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3805":577,"_26540":546,"_22543":41136,"_5":26784,"_10604":41047,"_1869":41137},[],"Diseña el consumidor para:",{"_3805":578,"_26540":546,"_22543":41139,"_5":26784,"_10604":41047,"_1869":41140},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3805":579,"_26540":546,"_22543":41142,"_5":26784,"_10604":41047,"_1869":41143},[],"conservar el CloudEvent completo sin modificar;",{"_3805":580,"_26540":546,"_22543":41145,"_5":26784,"_10604":41047,"_1869":41146},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3805":581,"_26540":546,"_22543":41148,"_5":26784,"_10604":41047,"_1869":41149},[],"cifrar en tránsito y en reposo;",{"_3805":582,"_26540":546,"_22543":41151,"_5":26784,"_10604":41047,"_1869":41152},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3805":583,"_26540":546,"_22543":41154,"_5":26784,"_10604":41047,"_1869":41155},[],"aplicar una política explícita de retención y legal hold;",{"_3805":584,"_26540":546,"_22543":41157,"_5":26784,"_10604":41047,"_1869":41158},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3805":585,"_26540":546,"_22543":41160,"_5":26784,"_10604":41051,"_1869":41161},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3805":586,"_26540":546,"_22543":41163,"_5":26784,"_10604":41051,"_1869":41164},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3805":587,"_26540":546,"_22543":41166,"_5":26784,"_10604":41059,"_1869":41167},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3805":588,"_26540":546,"_22543":41169,"_5":26784,"_10604":41063,"_1869":41170},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3805":589,"_26540":546,"_22543":41172,"_5":26784,"_10604":41067,"_1869":41173},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3805":590,"_26540":546,"_22543":41175,"_5":26784,"_10604":41071,"_1869":41176},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3805":591,"_26540":546,"_22543":41178,"_5":26784,"_10604":41075,"_1869":41179},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3805":592,"_26540":546,"_22543":41181,"_5":26784,"_10604":41079,"_1869":41182},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3805":593,"_26540":546,"_22543":41184,"_5":26784,"_10604":41079,"_1869":41185},[],"aparece un evento de auditoría correcto;",{"_3805":594,"_26540":546,"_22543":41187,"_5":26784,"_10604":41079,"_1869":41188},[],"el principal coincide con la identidad utilizada;",{"_3805":595,"_26540":546,"_22543":41190,"_5":26784,"_10604":41079,"_1869":41191},[],"el consumidor lo persiste una sola vez;",{"_3805":596,"_26540":546,"_22543":41193,"_5":26784,"_10604":41079,"_1869":41194},[],"puede recuperarse por recurso, actor y periodo;",{"_3805":597,"_26540":546,"_22543":41196,"_5":26784,"_10604":41079,"_1869":41197},[],"una interrupción del consumidor produce una alerta.",{"_3805":598,"_26540":546,"_22543":41199,"_5":26784,"_10604":41079,"_1869":41200},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3805":599,"_26540":599,"_5":26779,"_1869":41202,"_26792":41203,"_22543":41204,"_10604":599},"Jerarquía y rotación de CAs",[39346,40430,40908],[],{"_3805":600,"_26540":599,"_22543":41206,"_5":26784,"_10604":599,"_1869":41207},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3805":601,"_26540":599,"_5":26789,"_22543":41209,"_10604":41210,"_1869":41211},[],"/docs/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3805":602,"_26540":599,"_5":26789,"_22543":41213,"_10604":41214,"_1869":41215},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3805":603,"_26540":599,"_5":26789,"_22543":41217,"_10604":41218,"_1869":41219},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3805":604,"_26540":599,"_5":26789,"_22543":41221,"_10604":41222,"_1869":41223},[],"/docs/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3805":605,"_26540":599,"_5":26789,"_22543":41225,"_10604":41226,"_1869":41227},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3805":606,"_26540":599,"_5":26789,"_22543":41229,"_10604":41230,"_1869":41231},[],"/docs/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3805":607,"_26540":599,"_5":26789,"_22543":41233,"_10604":41234,"_1869":41235},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3805":608,"_26540":599,"_5":26789,"_22543":41237,"_10604":41238,"_1869":41239},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3805":609,"_26540":599,"_5":26789,"_22543":41241,"_10604":41242,"_1869":41243},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3805":610,"_26540":599,"_5":26789,"_22543":41245,"_10604":41246,"_1869":41247},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3805":611,"_26540":599,"_5":26789,"_22543":41249,"_10604":41250,"_1869":41251},[],"/docs/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3805":612,"_26540":599,"_5":26789,"_22543":41253,"_10604":41254,"_1869":41255},[],"/docs/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3805":613,"_26540":599,"_22543":41257,"_5":26784,"_10604":599,"_1869":41258},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3805":614,"_26540":599,"_22543":41260,"_5":26784,"_10604":41210,"_1869":41261},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3805":615,"_26540":599,"_22543":41263,"_5":26784,"_10604":41210,"_1869":41264},[],"entorno, como producción y preproducción;",{"_3805":616,"_26540":599,"_22543":41266,"_5":26784,"_10604":41210,"_1869":41267},[],"propietario o equipo operador;",{"_3805":617,"_26540":599,"_22543":41269,"_5":26784,"_10604":41210,"_1869":41270},[],"familia de dispositivos o proceso de fabricación;",{"_3805":618,"_26540":599,"_22543":41272,"_5":26784,"_10604":41210,"_1869":41273},[],"región o requisito regulatorio;",{"_3805":619,"_26540":599,"_22543":41275,"_5":26784,"_10604":41210,"_1869":41276},[],"motor criptográfico o política de clave;",{"_3805":620,"_26540":599,"_22543":41278,"_5":26784,"_10604":41210,"_1869":41279},[],"ventana de mantenimiento y ritmo de renovación.",{"_3805":621,"_26540":599,"_22543":41281,"_5":26784,"_10604":41210,"_1869":41282},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3805":622,"_26540":599,"_22543":41284,"_5":26784,"_10604":41210,"_1869":41285},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3805":623,"_26540":599,"_22543":41287,"_5":26784,"_10604":41214,"_1869":41288},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3805":624,"_26540":599,"_22543":41290,"_5":26784,"_10604":41214,"_1869":41291},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3805":625,"_26540":599,"_22543":41293,"_5":26784,"_10604":41214,"_1869":41294},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3805":626,"_26540":599,"_22543":41296,"_5":26784,"_10604":41218,"_1869":41297},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3805":627,"_26540":599,"_22543":41299,"_5":26784,"_10604":41218,"_1869":41300},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3805":628,"_26540":599,"_22543":41302,"_5":26784,"_10604":41218,"_1869":41303},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3805":629,"_26540":599,"_22543":41305,"_5":26784,"_10604":41218,"_1869":41306},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3805":630,"_26540":599,"_22543":41308,"_5":26784,"_10604":41226,"_1869":41309},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3805":631,"_26540":599,"_22543":41311,"_5":26784,"_10604":41230,"_1869":41312},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3805":632,"_26540":599,"_22543":41314,"_5":26784,"_10604":41234,"_1869":41315},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_3805":633,"_26540":599,"_22543":41317,"_5":26784,"_10604":41238,"_1869":41318},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_3805":634,"_26540":599,"_22543":41320,"_5":26784,"_10604":41242,"_1869":41321},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3805":635,"_26540":599,"_22543":41323,"_5":26784,"_10604":41246,"_1869":41324},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3805":636,"_26540":599,"_22543":41326,"_5":26784,"_10604":41250,"_1869":41327},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_3805":637,"_26540":599,"_22543":41329,"_5":26784,"_10604":41250,"_1869":41330},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_3805":638,"_26540":599,"_22543":41332,"_5":26784,"_10604":41254,"_1869":41333},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3805":639,"_26540":599,"_22543":41335,"_5":26784,"_10604":41254,"_1869":41336},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3805":640,"_26540":599,"_22543":41338,"_5":26784,"_10604":41254,"_1869":41339},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3805":641,"_26540":599,"_22543":41341,"_5":26784,"_10604":41254,"_1869":41342},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3805":642,"_26540":599,"_22543":41344,"_5":26784,"_10604":41254,"_1869":41345},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3805":643,"_26540":599,"_22543":41347,"_5":26784,"_10604":41254,"_1869":41348},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3805":644,"_26540":599,"_22543":41350,"_5":26784,"_10604":41254,"_1869":41351},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3805":645,"_26540":645,"_5":26779,"_1869":41353,"_26792":41354,"_22543":41355,"_10604":645},"Autoridades de certificación",[39346,40430,40908],[],{"_3805":646,"_26540":645,"_22543":41357,"_5":26784,"_10604":645,"_1869":41358},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3805":647,"_26540":645,"_5":26789,"_22543":41360,"_10604":41361,"_1869":41362},[],"/docs/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3805":648,"_26540":645,"_5":26789,"_22543":41364,"_10604":41365,"_1869":41366},[],"/docs/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3805":649,"_26540":645,"_5":26789,"_22543":41368,"_10604":41369,"_1869":39356},[],"/docs/platform/pki/certificate-authorities#antes-de-empezar",{"_3805":650,"_26540":645,"_5":26789,"_22543":41371,"_10604":41372,"_1869":41373},[],"/docs/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3805":651,"_26540":645,"_5":26789,"_22543":41375,"_10604":41376,"_1869":41377},[],"/docs/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3805":652,"_26540":645,"_5":26789,"_22543":41379,"_10604":41380,"_1869":41381},[],"/docs/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3805":653,"_26540":645,"_5":26789,"_22543":41383,"_10604":41384,"_1869":41385},[],"/docs/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3805":654,"_26540":645,"_5":26789,"_22543":41387,"_10604":41388,"_1869":41389},[],"/docs/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3805":655,"_26540":645,"_5":26789,"_22543":41391,"_10604":41392,"_1869":41393},[],"/docs/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3805":656,"_26540":645,"_5":26789,"_22543":41395,"_10604":41396,"_1869":41397},[],"/docs/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3805":657,"_26540":645,"_5":26789,"_22543":41399,"_10604":41400,"_1869":41401},[],"/docs/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3805":658,"_26540":645,"_5":26789,"_22543":41403,"_10604":41404,"_1869":41405},[],"/docs/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3805":659,"_26540":645,"_5":26789,"_22543":41407,"_10604":41408,"_1869":41409},[],"/docs/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3805":660,"_26540":645,"_5":26789,"_22543":41411,"_10604":41412,"_1869":41413},[],"/docs/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3805":661,"_26540":645,"_5":26789,"_22543":41415,"_10604":41416,"_1869":41417},[],"/docs/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3805":662,"_26540":645,"_5":26789,"_22543":41419,"_10604":41420,"_1869":41421},[],"/docs/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3805":663,"_26540":645,"_5":26789,"_22543":41423,"_10604":41424,"_1869":41425},[],"/docs/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3805":664,"_26540":645,"_5":26789,"_22543":41427,"_10604":41428,"_1869":41429},[],"/docs/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3805":665,"_26540":645,"_5":26789,"_22543":41431,"_10604":41432,"_1869":41433},[],"/docs/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3805":666,"_26540":645,"_5":26789,"_22543":41435,"_10604":41436,"_1869":41437},[],"/docs/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3805":667,"_26540":645,"_5":26789,"_22543":41439,"_10604":41440,"_1869":41441},[],"/docs/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3805":668,"_26540":645,"_5":26789,"_22543":41443,"_10604":41444,"_1869":41445},[],"/docs/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3805":669,"_26540":645,"_22543":41447,"_5":26784,"_10604":645,"_1869":41448},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3805":670,"_26540":645,"_22543":41450,"_5":26784,"_10604":645,"_1869":41451},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3805":671,"_26540":645,"_22543":41453,"_5":26784,"_10604":41361,"_1869":41454},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3805":672,"_26540":645,"_22543":41456,"_5":26784,"_10604":41361,"_1869":41457},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3805":673,"_26540":645,"_22543":41459,"_5":26784,"_10604":41361,"_1869":41460},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3805":674,"_26540":645,"_22543":41462,"_5":26784,"_10604":41361,"_1869":41463},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_3805":675,"_26540":645,"_22543":41465,"_5":26784,"_10604":41361,"_1869":41466},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3805":676,"_26540":645,"_22543":41468,"_5":26784,"_10604":41369,"_1869":41469},[],"Decide si la CA será raíz o intermedia.",{"_3805":677,"_26540":645,"_22543":41471,"_5":26784,"_10604":41369,"_1869":41472},[],"Elige el motor que custodiará la clave.",{"_3805":678,"_26540":645,"_22543":41474,"_5":26784,"_10604":41369,"_1869":41475},[],"Define una validez superior a la de los certificados que emitirá.",{"_3805":679,"_26540":645,"_22543":41477,"_5":26784,"_10604":41369,"_1869":41478},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3805":680,"_26540":645,"_22543":41480,"_5":26784,"_10604":41372,"_1869":41481},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3805":681,"_26540":645,"_22543":41483,"_5":26784,"_10604":41376,"_1869":41484},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3805":682,"_26540":645,"_22543":41486,"_5":26784,"_10604":41376,"_1869":41487},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_3805":683,"_26540":645,"_22543":41489,"_5":26784,"_10604":41380,"_1869":41490},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3805":684,"_26540":645,"_22543":41492,"_5":26784,"_10604":41384,"_1869":41493},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3805":685,"_26540":645,"_22543":41495,"_5":26784,"_10604":41384,"_1869":41496},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3805":686,"_26540":645,"_22543":41498,"_5":26784,"_10604":41384,"_1869":41499},[],"`ST`: estado o provincia.",{"_3805":687,"_26540":645,"_22543":41501,"_5":26784,"_10604":41384,"_1869":41502},[],"`L`: localidad.",{"_3805":688,"_26540":645,"_22543":41504,"_5":26784,"_10604":41384,"_1869":41505},[],"`O`: organización.",{"_3805":689,"_26540":645,"_22543":41507,"_5":26784,"_10604":41384,"_1869":41508},[],"`OU`: unidad organizativa.",{"_3805":690,"_26540":645,"_22543":41510,"_5":26784,"_10604":41384,"_1869":41511},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3805":691,"_26540":645,"_22543":41513,"_5":26784,"_10604":41388,"_1869":41514},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3805":692,"_26540":645,"_22543":41516,"_5":26784,"_10604":41388,"_1869":41517},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_3805":693,"_26540":645,"_22543":41519,"_5":26784,"_10604":41392,"_1869":41520},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_3805":694,"_26540":645,"_22543":41522,"_5":26784,"_10604":41392,"_1869":41523},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_3805":695,"_26540":645,"_22543":41525,"_5":26784,"_10604":41396,"_1869":41526},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3805":696,"_26540":645,"_22543":41528,"_5":26784,"_10604":41396,"_1869":41529},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3805":697,"_26540":645,"_22543":41531,"_5":26784,"_10604":41400,"_1869":41532},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_3805":698,"_26540":645,"_22543":41534,"_5":26784,"_10604":41404,"_1869":41535},[],"Elige el motor que custodiará la clave importada.",{"_3805":699,"_26540":645,"_22543":41537,"_5":26784,"_10604":41408,"_1869":41538},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_3805":700,"_26540":645,"_22543":41540,"_5":26784,"_10604":41412,"_1869":41541},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_3805":701,"_26540":645,"_22543":41543,"_5":26784,"_10604":41416,"_1869":41544},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_3805":702,"_26540":645,"_22543":41546,"_5":26784,"_10604":41416,"_1869":41547},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_3805":703,"_26540":645,"_22543":41549,"_5":26784,"_10604":41420,"_1869":41550},[],"Abre una CA desde el inventario para consultar:",{"_3805":704,"_26540":645,"_22543":41552,"_5":26784,"_10604":41420,"_1869":41553},[],"Estado y periodo de validez.",{"_3805":705,"_26540":645,"_22543":41555,"_5":26784,"_10604":41420,"_1869":41556},[],"Certificado y cadena en formato PEM.",{"_3805":706,"_26540":645,"_22543":41558,"_5":26784,"_10604":41420,"_1869":41559},[],"Número de certificados activos, expirados y revocados.",{"_3805":707,"_26540":645,"_22543":41561,"_5":26784,"_10604":41420,"_1869":41562},[],"Certificados emitidos en **Issued Certificates**.",{"_3805":708,"_26540":645,"_22543":41564,"_5":26784,"_10604":41420,"_1869":41565},[],"CRL vinculada a la autoridad.",{"_3805":709,"_26540":645,"_22543":41567,"_5":26784,"_10604":41420,"_1869":41568},[],"Metadatos y motor criptográfico asociado.",{"_3805":710,"_26540":645,"_22543":41570,"_5":26784,"_10604":41420,"_1869":41571},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3805":711,"_26540":645,"_22543":41573,"_5":26784,"_10604":41424,"_1869":41574},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3805":712,"_26540":645,"_22543":41576,"_5":26784,"_10604":41424,"_1869":41577},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3805":713,"_26540":645,"_22543":41579,"_5":26784,"_10604":41424,"_1869":41580},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3805":714,"_26540":645,"_22543":41582,"_5":26784,"_10604":41424,"_1869":41583},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3805":715,"_26540":645,"_22543":41585,"_5":26784,"_10604":41428,"_1869":41586},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_3805":716,"_26540":645,"_22543":41588,"_5":26784,"_10604":41432,"_1869":41589},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3805":717,"_26540":645,"_22543":41591,"_5":26784,"_10604":41436,"_1869":41592},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3805":718,"_26540":645,"_22543":41594,"_5":26784,"_10604":41440,"_1869":41595},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3805":719,"_26540":645,"_22543":41597,"_5":26784,"_10604":41444,"_1869":41598},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_3805":720,"_26540":645,"_22543":41600,"_5":26784,"_10604":41444,"_1869":41601},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3805":721,"_26540":721,"_5":26779,"_1869":41603,"_26792":41604,"_22543":41605,"_10604":721},"Perfiles de certificado",[39346,40430,40908],[],{"_3805":722,"_26540":721,"_22543":41607,"_5":26784,"_10604":721,"_1869":41608},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3805":723,"_26540":721,"_5":26789,"_22543":41610,"_10604":41611,"_1869":41612},[],"/docs/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3805":724,"_26540":721,"_5":26789,"_22543":41614,"_10604":41615,"_1869":41616},[],"/docs/platform/pki/certificate-profiles#validez","Validez",{"_3805":725,"_26540":721,"_5":26789,"_22543":41618,"_10604":41619,"_1869":41620},[],"/docs/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3805":726,"_26540":721,"_5":26789,"_22543":41622,"_10604":41623,"_1869":41624},[],"/docs/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3805":727,"_26540":721,"_5":26789,"_22543":41626,"_10604":41627,"_1869":41628},[],"/docs/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3805":728,"_26540":721,"_5":26789,"_22543":41630,"_10604":41631,"_1869":41632},[],"/docs/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3805":729,"_26540":721,"_5":26789,"_22543":41634,"_10604":41635,"_1869":41636},[],"/docs/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3805":730,"_26540":721,"_5":26789,"_22543":41638,"_10604":41639,"_1869":41640},[],"/docs/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3805":731,"_26540":721,"_5":26789,"_22543":41642,"_10604":41643,"_1869":41644},[],"/docs/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3805":732,"_26540":721,"_5":26789,"_22543":41646,"_10604":41647,"_1869":41648},[],"/docs/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3805":733,"_26540":721,"_5":26789,"_22543":41650,"_10604":41651,"_1869":41652},[],"/docs/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3805":734,"_26540":721,"_5":26789,"_22543":41654,"_10604":41655,"_1869":41656},[],"/docs/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3805":735,"_26540":721,"_5":26789,"_22543":41658,"_10604":41659,"_1869":41660},[],"/docs/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3805":736,"_26540":721,"_5":26789,"_22543":41662,"_10604":41663,"_1869":41664},[],"/docs/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3805":737,"_26540":721,"_5":26789,"_22543":41666,"_10604":41667,"_1869":41668},[],"/docs/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3805":738,"_26540":721,"_5":26789,"_22543":41670,"_10604":41671,"_1869":41672},[],"/docs/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3805":739,"_26540":721,"_22543":41674,"_5":26784,"_10604":721,"_1869":41675},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3805":740,"_26540":721,"_22543":41677,"_5":26784,"_10604":41615,"_1869":41678},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3805":741,"_26540":721,"_22543":41680,"_5":26784,"_10604":41615,"_1869":41681},[],"La fecha final nunca debe superar la de la CA emisora.",{"_3805":742,"_26540":721,"_22543":41683,"_5":26784,"_10604":41619,"_1869":41684},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3805":743,"_26540":721,"_22543":41686,"_5":26784,"_10604":41623,"_1869":41687},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3805":744,"_26540":721,"_22543":41689,"_5":26784,"_10604":41623,"_1869":41690},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3805":745,"_26540":721,"_22543":41692,"_5":26784,"_10604":41623,"_1869":41693},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3805":746,"_26540":721,"_22543":41695,"_5":26784,"_10604":41627,"_1869":41696},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3805":747,"_26540":721,"_22543":41698,"_5":26784,"_10604":41631,"_1869":41699},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3805":748,"_26540":721,"_22543":41701,"_5":26784,"_10604":41631,"_1869":41702},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_3805":749,"_26540":721,"_22543":41704,"_5":26784,"_10604":41635,"_1869":41705},[],"La aplicación criptográfica puede:",{"_3805":750,"_26540":721,"_22543":41707,"_5":26784,"_10604":41635,"_1869":41708},[],"permitir o bloquear claves RSA;",{"_3805":751,"_26540":721,"_22543":41710,"_5":26784,"_10604":41635,"_1869":41711},[],"limitar los tamaños RSA admitidos;",{"_3805":752,"_26540":721,"_22543":41713,"_5":26784,"_10604":41635,"_1869":41714},[],"permitir o bloquear claves ECDSA;",{"_3805":753,"_26540":721,"_22543":41716,"_5":26784,"_10604":41635,"_1869":41717},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3805":754,"_26540":721,"_22543":41719,"_5":26784,"_10604":41635,"_1869":41720},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3805":755,"_26540":721,"_22543":41722,"_5":26784,"_10604":41639,"_1869":41723},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_3805":756,"_26540":721,"_22543":41725,"_5":26784,"_10604":41639,"_1869":41726},[],"Perfil enviado dentro de la operación.",{"_3805":757,"_26540":721,"_22543":41728,"_5":26784,"_10604":41639,"_1869":41729},[],"Identificador de perfil enviado en la operación.",{"_3805":758,"_26540":721,"_22543":41731,"_5":26784,"_10604":41639,"_1869":41732},[],"Perfil predeterminado asociado a la CA.",{"_3805":759,"_26540":721,"_22543":41734,"_5":26784,"_10604":41639,"_1869":41735},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_3805":760,"_26540":721,"_22543":41737,"_5":26784,"_10604":41647,"_1869":41738},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3805":761,"_26540":721,"_22543":41740,"_5":26784,"_10604":41651,"_1869":41741},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3805":762,"_26540":721,"_22543":41743,"_5":26784,"_10604":41655,"_1869":41744},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3805":763,"_26540":721,"_22543":41746,"_5":26784,"_10604":41659,"_1869":41747},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3805":764,"_26540":721,"_22543":41749,"_5":26784,"_10604":41663,"_1869":41750},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_3805":765,"_26540":721,"_22543":41752,"_5":26784,"_10604":41667,"_1869":41753},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3805":766,"_26540":721,"_22543":41755,"_5":26784,"_10604":41667,"_1869":41756},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3805":767,"_26540":721,"_22543":41758,"_5":26784,"_10604":41667,"_1869":41759},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3805":768,"_26540":721,"_22543":41761,"_5":26784,"_10604":41667,"_1869":41762},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_3805":769,"_26540":721,"_22543":41764,"_5":26784,"_10604":41671,"_1869":41765},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3805":770,"_26540":721,"_22543":41767,"_5":26784,"_10604":41671,"_1869":41768},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3805":771,"_26540":771,"_5":26779,"_1869":41770,"_26792":41771,"_22543":41772,"_10604":771},"Validación de certificados",[39346,40430,40908],[],{"_3805":772,"_26540":771,"_22543":41774,"_5":26784,"_10604":771,"_1869":41775},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_3805":773,"_26540":771,"_5":26789,"_22543":41777,"_10604":41778,"_1869":41779},[],"/docs/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3805":774,"_26540":771,"_22543":41781,"_5":26784,"_10604":771,"_1869":41782},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_3805":775,"_26540":771,"_22543":41784,"_5":26784,"_10604":41778,"_1869":41785},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_3805":776,"_26540":771,"_22543":41787,"_5":26784,"_10604":41778,"_1869":41788},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_3805":777,"_26540":771,"_22543":41790,"_5":26784,"_10604":41778,"_1869":41791},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_3805":778,"_26540":771,"_22543":41793,"_5":26784,"_10604":41778,"_1869":41794},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":779,"_26540":771,"_22543":41796,"_5":26784,"_10604":41778,"_1869":41797},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_3805":780,"_26540":780,"_5":26779,"_1869":41799,"_26792":41800,"_22543":41801,"_10604":780},"Certificados",[39346,40430,40908],[],{"_3805":781,"_26540":780,"_22543":41803,"_5":26784,"_10604":780,"_1869":41804},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3805":782,"_26540":780,"_5":26789,"_22543":41806,"_10604":41807,"_1869":41808},[],"/docs/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3805":783,"_26540":780,"_5":26789,"_22543":41810,"_10604":41811,"_1869":41812},[],"/docs/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3805":784,"_26540":780,"_5":26789,"_22543":41814,"_10604":41815,"_1869":41816},[],"/docs/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3805":785,"_26540":780,"_5":26789,"_22543":41818,"_10604":41819,"_1869":41820},[],"/docs/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3805":786,"_26540":780,"_5":26789,"_22543":41822,"_10604":41823,"_1869":41824},[],"/docs/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3805":787,"_26540":780,"_5":26789,"_22543":41826,"_10604":41827,"_1869":41828},[],"/docs/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3805":788,"_26540":780,"_5":26789,"_22543":41830,"_10604":41831,"_1869":41832},[],"/docs/platform/pki/certificates#continúa","Continúa",{"_3805":789,"_26540":780,"_22543":41834,"_5":26784,"_10604":780,"_1869":41835},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_3805":790,"_26540":780,"_22543":41837,"_5":26784,"_10604":41807,"_1869":41838},[],"Abre **Certificates** y filtra por:",{"_3805":791,"_26540":780,"_22543":41840,"_5":26784,"_10604":41807,"_1869":41841},[],"`Common Name` del sujeto.",{"_3805":792,"_26540":780,"_22543":41843,"_5":26784,"_10604":41807,"_1869":41844},[],"Número de serie.",{"_3805":793,"_26540":780,"_22543":41846,"_5":26784,"_10604":41807,"_1869":41847},[],"Estado.",{"_3805":794,"_26540":780,"_22543":41849,"_5":26784,"_10604":41807,"_1869":41850},[],"Autoridad emisora.",{"_3805":795,"_26540":780,"_22543":41852,"_5":26784,"_10604":41807,"_1869":41853},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_3805":796,"_26540":780,"_22543":41855,"_5":26784,"_10604":41811,"_1869":41856},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_3805":797,"_26540":780,"_22543":41858,"_5":26784,"_10604":41815,"_1869":41859},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_3805":798,"_26540":780,"_22543":41861,"_5":26784,"_10604":41819,"_1869":41862},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_3805":799,"_26540":780,"_22543":41864,"_5":26784,"_10604":41823,"_1869":41865},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_3805":800,"_26540":780,"_22543":41867,"_5":26784,"_10604":41827,"_1869":41868},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_3805":801,"_26540":780,"_22543":41870,"_5":26784,"_10604":41827,"_1869":41871},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_3805":802,"_26540":780,"_22543":41873,"_5":26784,"_10604":41831,"_1869":41874},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":803,"_26540":780,"_22543":41876,"_5":26784,"_10604":41831,"_1869":41877},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_3805":804,"_26540":804,"_5":26779,"_1869":41879,"_26792":41880,"_22543":41882,"_10604":804},"Arquitectura de la plataforma",[39346,40430,41881],"Conceptos",[],{"_3805":805,"_26540":804,"_22543":41884,"_5":26784,"_10604":804,"_1869":41885},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3805":806,"_26540":804,"_5":26789,"_22543":41887,"_10604":41888,"_1869":41889},[],"/docs/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_3805":807,"_26540":804,"_5":26789,"_22543":41891,"_10604":41892,"_1869":41893},[],"/docs/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3805":808,"_26540":804,"_5":26789,"_22543":41895,"_10604":41896,"_1869":41897},[],"/docs/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3805":809,"_26540":804,"_5":26789,"_22543":41899,"_10604":41900,"_1869":41901},[],"/docs/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_3805":810,"_26540":804,"_5":26789,"_22543":41903,"_10604":41904,"_1869":41905},[],"/docs/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3805":811,"_26540":804,"_22543":41907,"_5":26784,"_10604":804,"_1869":41908},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3805":812,"_26540":804,"_22543":41910,"_5":26784,"_10604":41888,"_1869":41911},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3805":813,"_26540":804,"_22543":41913,"_5":26784,"_10604":41892,"_1869":41914},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3805":814,"_26540":804,"_22543":41916,"_5":26784,"_10604":41896,"_1869":41917},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3805":815,"_26540":804,"_22543":41919,"_5":26784,"_10604":41900,"_1869":41920},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3805":816,"_26540":804,"_22543":41922,"_5":26784,"_10604":41904,"_1869":41923},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3805":817,"_26540":817,"_5":26779,"_1869":41925,"_26792":41926,"_22543":41927,"_10604":817},"Ciclo de vida de un certificado",[39346,40430,41881],[],{"_3805":818,"_26540":817,"_22543":41929,"_5":26784,"_10604":817,"_1869":41930},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3805":819,"_26540":817,"_5":26789,"_22543":41932,"_10604":41933,"_1869":41934},[],"/docs/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3805":820,"_26540":817,"_5":26789,"_22543":41936,"_10604":41937,"_1869":41938},[],"/docs/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3805":821,"_26540":817,"_5":26789,"_22543":41940,"_10604":41941,"_1869":41942},[],"/docs/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3805":822,"_26540":817,"_5":26789,"_22543":41944,"_10604":41945,"_1869":41946},[],"/docs/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3805":823,"_26540":817,"_5":26789,"_22543":41948,"_10604":41949,"_1869":41950},[],"/docs/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3805":824,"_26540":817,"_5":26789,"_22543":41952,"_10604":41953,"_1869":41954},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3805":825,"_26540":817,"_5":26789,"_22543":41956,"_10604":41957,"_1869":41958},[],"/docs/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3805":826,"_26540":817,"_5":26789,"_22543":41960,"_10604":41961,"_1869":41962},[],"/docs/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3805":827,"_26540":817,"_5":26789,"_22543":41964,"_10604":41965,"_1869":41966},[],"/docs/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3805":828,"_26540":817,"_5":26789,"_22543":41968,"_10604":41969,"_1869":41970},[],"/docs/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3805":829,"_26540":817,"_22543":41972,"_5":26784,"_10604":817,"_1869":41973},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3805":830,"_26540":817,"_22543":41975,"_5":26784,"_10604":41937,"_1869":41976},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3805":831,"_26540":817,"_22543":41978,"_5":26784,"_10604":41941,"_1869":41979},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3805":832,"_26540":817,"_22543":41981,"_5":26784,"_10604":41945,"_1869":41982},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3805":833,"_26540":817,"_22543":41984,"_5":26784,"_10604":41949,"_1869":41985},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3805":834,"_26540":817,"_22543":41987,"_5":26784,"_10604":41953,"_1869":41988},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3805":835,"_26540":817,"_22543":41990,"_5":26784,"_10604":41957,"_1869":41991},[],"Lamassu persiste cuatro estados X.509:",{"_3805":836,"_26540":817,"_22543":41993,"_5":26784,"_10604":41957,"_1869":41994},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_3805":837,"_26540":817,"_22543":41996,"_5":26784,"_10604":41957,"_1869":41997},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3805":838,"_26540":817,"_22543":41999,"_5":26784,"_10604":41957,"_1869":42000},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3805":839,"_26540":817,"_22543":42002,"_5":26784,"_10604":41957,"_1869":42003},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3805":840,"_26540":817,"_22543":42005,"_5":26784,"_10604":41957,"_1869":42006},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3805":841,"_26540":817,"_22543":42008,"_5":26784,"_10604":41961,"_1869":42009},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3805":842,"_26540":817,"_22543":42011,"_5":26784,"_10604":41961,"_1869":42012},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_3805":843,"_26540":817,"_22543":42014,"_5":26784,"_10604":41961,"_1869":42015},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3805":844,"_26540":817,"_22543":42017,"_5":26784,"_10604":41965,"_1869":42018},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_3805":845,"_26540":817,"_22543":42020,"_5":26784,"_10604":41965,"_1869":42021},[],"Antes de confirmar:",{"_3805":846,"_26540":817,"_22543":42023,"_5":26784,"_10604":41965,"_1869":42024},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3805":847,"_26540":817,"_22543":42026,"_5":26784,"_10604":41965,"_1869":42027},[],"Distribuye la nueva cadena de confianza.",{"_3805":848,"_26540":817,"_22543":42029,"_5":26784,"_10604":41965,"_1869":42030},[],"Reemite las identidades necesarias.",{"_3805":849,"_26540":817,"_22543":42032,"_5":26784,"_10604":41965,"_1869":42033},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3805":850,"_26540":817,"_22543":42035,"_5":26784,"_10604":41965,"_1869":42036},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3805":851,"_26540":817,"_22543":42038,"_5":26784,"_10604":41965,"_1869":42039},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_3805":852,"_26540":817,"_22543":42041,"_5":26784,"_10604":41969,"_1869":42042},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3805":853,"_26540":817,"_22543":42044,"_5":26784,"_10604":41969,"_1869":42045},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3805":854,"_26540":817,"_22543":42047,"_5":26784,"_10604":41969,"_1869":42048},[],"Cambios de estado y razones de revocación.",{"_3805":855,"_26540":817,"_22543":42050,"_5":26784,"_10604":41969,"_1869":42051},[],"Publicación y vigencia de OCSP y CRLs.",{"_3805":856,"_26540":817,"_22543":42053,"_5":26784,"_10604":41969,"_1869":42054},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3805":857,"_26540":817,"_22543":42056,"_5":26784,"_10604":41969,"_1869":42057},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3805":858,"_26540":858,"_5":26779,"_1869":42059,"_26792":42060,"_22543":42061,"_10604":858},"Glosario",[39346,40430,41881],[],{"_3805":859,"_26540":858,"_22543":42063,"_5":26784,"_10604":858,"_1869":42064},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_3805":860,"_26540":858,"_5":26789,"_22543":42066,"_10604":42067,"_1869":42068},[],"/docs/platform/pki/concepts/glossary#ac","A–C",{"_3805":861,"_26540":858,"_5":26789,"_22543":42070,"_10604":42071,"_1869":42072},[],"/docs/platform/pki/concepts/glossary#dk","D–K",{"_3805":862,"_26540":858,"_5":26789,"_22543":42074,"_10604":42075,"_1869":42076},[],"/docs/platform/pki/concepts/glossary#mr","M–R",{"_3805":863,"_26540":858,"_5":26789,"_22543":42078,"_10604":42079,"_1869":42080},[],"/docs/platform/pki/concepts/glossary#sz","S–Z",{"_3805":864,"_26540":858,"_22543":42082,"_5":26784,"_10604":42067,"_1869":42083},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_3805":865,"_26540":858,"_22543":42085,"_5":26784,"_10604":42067,"_1869":42086},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_3805":866,"_26540":858,"_22543":42088,"_5":26784,"_10604":42067,"_1869":42089},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_3805":867,"_26540":858,"_22543":42091,"_5":26784,"_10604":42067,"_1869":42092},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_3805":868,"_26540":858,"_22543":42094,"_5":26784,"_10604":42067,"_1869":42095},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_3805":869,"_26540":858,"_22543":42097,"_5":26784,"_10604":42067,"_1869":42098},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_3805":870,"_26540":858,"_22543":42100,"_5":26784,"_10604":42067,"_1869":42101},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_3805":871,"_26540":858,"_22543":42103,"_5":26784,"_10604":42067,"_1869":42104},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_3805":872,"_26540":858,"_22543":42106,"_5":26784,"_10604":42071,"_1869":42107},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_3805":873,"_26540":858,"_22543":42109,"_5":26784,"_10604":42071,"_1869":42110},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_3805":874,"_26540":858,"_22543":42112,"_5":26784,"_10604":42071,"_1869":42113},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_3805":875,"_26540":858,"_22543":42115,"_5":26784,"_10604":42071,"_1869":42116},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_3805":876,"_26540":858,"_22543":42118,"_5":26784,"_10604":42071,"_1869":42119},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_3805":877,"_26540":858,"_22543":42121,"_5":26784,"_10604":42071,"_1869":42122},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_3805":878,"_26540":858,"_22543":42124,"_5":26784,"_10604":42071,"_1869":42125},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_3805":879,"_26540":858,"_22543":42127,"_5":26784,"_10604":42071,"_1869":42128},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_3805":880,"_26540":858,"_22543":42130,"_5":26784,"_10604":42071,"_1869":42131},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_3805":881,"_26540":858,"_22543":42133,"_5":26784,"_10604":42075,"_1869":42134},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_3805":882,"_26540":858,"_22543":42136,"_5":26784,"_10604":42075,"_1869":42137},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_3805":883,"_26540":858,"_22543":42139,"_5":26784,"_10604":42075,"_1869":42140},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_3805":884,"_26540":858,"_22543":42142,"_5":26784,"_10604":42075,"_1869":42143},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_3805":885,"_26540":858,"_22543":42145,"_5":26784,"_10604":42075,"_1869":42146},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_3805":886,"_26540":858,"_22543":42148,"_5":26784,"_10604":42075,"_1869":42149},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_3805":887,"_26540":858,"_22543":42151,"_5":26784,"_10604":42075,"_1869":42152},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_3805":888,"_26540":858,"_22543":42154,"_5":26784,"_10604":42075,"_1869":42155},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_3805":889,"_26540":858,"_22543":42157,"_5":26784,"_10604":42079,"_1869":42158},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_3805":890,"_26540":858,"_22543":42160,"_5":26784,"_10604":42079,"_1869":42161},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_3805":891,"_26540":858,"_22543":42163,"_5":26784,"_10604":42079,"_1869":42164},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_3805":892,"_26540":858,"_22543":42166,"_5":26784,"_10604":42079,"_1869":42167},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_3805":893,"_26540":858,"_22543":42169,"_5":26784,"_10604":42079,"_1869":42170},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_3805":894,"_26540":894,"_5":26779,"_1869":42172,"_26792":42173,"_22543":42174,"_10604":894},"Cómo funciona Lamassu",[39346,40430,41881],[],{"_3805":895,"_26540":894,"_22543":42176,"_5":26784,"_10604":894,"_1869":42177},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3805":896,"_26540":894,"_5":26789,"_22543":42179,"_10604":42180,"_1869":42181},[],"/docs/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3805":897,"_26540":894,"_5":26789,"_22543":42183,"_10604":42184,"_1869":42185},[],"/docs/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3805":898,"_26540":894,"_22543":42187,"_5":26784,"_10604":894,"_1869":42188},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3805":899,"_26540":894,"_22543":42190,"_5":26784,"_10604":42180,"_1869":42191},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3805":900,"_26540":894,"_22543":42193,"_5":26784,"_10604":42180,"_1869":42194},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3805":901,"_26540":894,"_22543":42196,"_5":26784,"_10604":42180,"_1869":42197},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3805":902,"_26540":894,"_22543":42199,"_5":26784,"_10604":42180,"_1869":42200},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3805":903,"_26540":894,"_22543":42202,"_5":26784,"_10604":42180,"_1869":42203},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3805":904,"_26540":894,"_22543":42205,"_5":26784,"_10604":42184,"_1869":42206},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3805":905,"_26540":894,"_22543":42208,"_5":26784,"_10604":42184,"_1869":42209},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3805":906,"_26540":894,"_22543":42211,"_5":26784,"_10604":42184,"_1869":42212},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3805":907,"_26540":894,"_22543":42214,"_5":26784,"_10604":42184,"_1869":42215},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3805":908,"_26540":894,"_22543":42217,"_5":26784,"_10604":42184,"_1869":42218},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3805":909,"_26540":894,"_22543":42220,"_5":26784,"_10604":42184,"_1869":42221},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_3805":910,"_26540":894,"_22543":42223,"_5":26784,"_10604":42184,"_1869":42224},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3805":911,"_26540":911,"_5":26779,"_1869":42226,"_26792":42227,"_22543":42228,"_10604":911},"Modelo de confianza",[39346,40430,41881],[],{"_3805":912,"_26540":911,"_22543":42230,"_5":26784,"_10604":911,"_1869":42231},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3805":913,"_26540":911,"_5":26789,"_22543":42233,"_10604":42234,"_1869":42235},[],"/docs/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3805":914,"_26540":911,"_5":26789,"_22543":42237,"_10604":42238,"_1869":42239},[],"/docs/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3805":915,"_26540":911,"_5":26789,"_22543":42241,"_10604":42242,"_1869":42243},[],"/docs/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3805":916,"_26540":911,"_5":26789,"_22543":42245,"_10604":42246,"_1869":42247},[],"/docs/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3805":917,"_26540":911,"_5":26789,"_22543":42249,"_10604":42250,"_1869":42251},[],"/docs/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3805":918,"_26540":911,"_5":26789,"_22543":42253,"_10604":42254,"_1869":42255},[],"/docs/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3805":919,"_26540":911,"_5":26789,"_22543":42257,"_10604":42258,"_1869":42259},[],"/docs/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3805":920,"_26540":911,"_5":26789,"_22543":42261,"_10604":42262,"_1869":42263},[],"/docs/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3805":921,"_26540":911,"_5":26789,"_22543":42265,"_10604":42266,"_1869":42267},[],"/docs/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3805":922,"_26540":911,"_5":26789,"_22543":42269,"_10604":42270,"_1869":42271},[],"/docs/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3805":923,"_26540":911,"_22543":42273,"_5":26784,"_10604":911,"_1869":42274},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3805":924,"_26540":911,"_22543":42276,"_5":26784,"_10604":42238,"_1869":42277},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3805":925,"_26540":911,"_22543":42279,"_5":26784,"_10604":42242,"_1869":42280},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3805":926,"_26540":911,"_22543":42282,"_5":26784,"_10604":42246,"_1869":42283},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3805":927,"_26540":911,"_22543":42285,"_5":26784,"_10604":42250,"_1869":42286},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_3805":928,"_26540":911,"_22543":42288,"_5":26784,"_10604":42254,"_1869":42289},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3805":929,"_26540":911,"_22543":42291,"_5":26784,"_10604":42254,"_1869":42292},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3805":930,"_26540":911,"_22543":42294,"_5":26784,"_10604":42254,"_1869":42295},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_3805":931,"_26540":911,"_22543":42297,"_5":26784,"_10604":42254,"_1869":42298},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3805":932,"_26540":911,"_22543":42300,"_5":26784,"_10604":42254,"_1869":42301},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3805":933,"_26540":911,"_22543":42303,"_5":26784,"_10604":42254,"_1869":42304},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3805":934,"_26540":911,"_22543":42306,"_5":26784,"_10604":42258,"_1869":42307},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3805":935,"_26540":911,"_22543":42309,"_5":26784,"_10604":42258,"_1869":42310},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3805":936,"_26540":911,"_22543":42312,"_5":26784,"_10604":42258,"_1869":42313},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_3805":937,"_26540":911,"_22543":42315,"_5":26784,"_10604":42258,"_1869":42316},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_3805":938,"_26540":911,"_22543":42318,"_5":26784,"_10604":42258,"_1869":42319},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3805":939,"_26540":911,"_22543":42321,"_5":26784,"_10604":42262,"_1869":42322},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3805":940,"_26540":911,"_22543":42324,"_5":26784,"_10604":42262,"_1869":42325},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3805":941,"_26540":911,"_22543":42327,"_5":26784,"_10604":42262,"_1869":42328},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3805":942,"_26540":911,"_22543":42330,"_5":26784,"_10604":42262,"_1869":42331},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3805":943,"_26540":911,"_22543":42333,"_5":26784,"_10604":42262,"_1869":42334},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3805":944,"_26540":911,"_22543":42336,"_5":26784,"_10604":42262,"_1869":42337},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3805":945,"_26540":911,"_22543":42339,"_5":26784,"_10604":42266,"_1869":42340},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3805":946,"_26540":911,"_22543":42342,"_5":26784,"_10604":42270,"_1869":42343},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3805":947,"_26540":911,"_22543":42345,"_5":26784,"_10604":42270,"_1869":42346},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3805":948,"_26540":911,"_22543":42348,"_5":26784,"_10604":42270,"_1869":42349},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3805":949,"_26540":911,"_22543":42351,"_5":26784,"_10604":42270,"_1869":42352},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3805":950,"_26540":911,"_22543":42354,"_5":26784,"_10604":42270,"_1869":42355},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3805":951,"_26540":911,"_22543":42357,"_5":26784,"_10604":42270,"_1869":42358},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3805":952,"_26540":911,"_22543":42360,"_5":26784,"_10604":42270,"_1869":42361},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3805":953,"_26540":953,"_5":26779,"_1869":42363,"_26792":42364,"_22543":42365,"_10604":953},"Listas de revocación (CRL)",[39346,40430,40908],[],{"_3805":954,"_26540":953,"_22543":42367,"_5":26784,"_10604":953,"_1869":42368},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3805":955,"_26540":953,"_5":26789,"_22543":42370,"_10604":42371,"_1869":42372},[],"/docs/platform/pki/crl#servicio-crl","Servicio CRL",{"_3805":956,"_26540":953,"_5":26789,"_22543":42374,"_10604":42375,"_1869":42376},[],"/docs/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3805":957,"_26540":953,"_5":26789,"_22543":42378,"_10604":42379,"_1869":42380},[],"/docs/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3805":958,"_26540":953,"_5":26789,"_22543":42382,"_10604":42383,"_1869":42384},[],"/docs/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3805":959,"_26540":953,"_5":26789,"_22543":42386,"_10604":42387,"_1869":42388},[],"/docs/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3805":960,"_26540":953,"_5":26789,"_22543":42390,"_10604":42391,"_1869":42392},[],"/docs/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3805":961,"_26540":953,"_5":26789,"_22543":42394,"_10604":42395,"_1869":42396},[],"/docs/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3805":962,"_26540":953,"_5":26789,"_22543":42398,"_10604":42399,"_1869":42400},[],"/docs/platform/pki/crl#referencias","Referencias",{"_3805":963,"_26540":953,"_22543":42402,"_5":26784,"_10604":42371,"_1869":42403},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_3805":964,"_26540":953,"_22543":42405,"_5":26784,"_10604":42371,"_1869":42406},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_3805":965,"_26540":953,"_22543":42408,"_5":26784,"_10604":42375,"_1869":42409},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_3805":966,"_26540":953,"_22543":42411,"_5":26784,"_10604":42375,"_1869":42412},[],"Los parámetros principales son:",{"_3805":967,"_26540":953,"_22543":42414,"_5":26784,"_10604":42375,"_1869":42415},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_3805":968,"_26540":953,"_22543":42417,"_5":26784,"_10604":42375,"_1869":42418},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_3805":969,"_26540":953,"_22543":42420,"_5":26784,"_10604":42375,"_1869":42421},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_3805":970,"_26540":953,"_22543":42423,"_5":26784,"_10604":42375,"_1869":42424},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_3805":971,"_26540":953,"_22543":42426,"_5":26784,"_10604":42375,"_1869":42427},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_3805":972,"_26540":953,"_22543":42429,"_5":26784,"_10604":42379,"_1869":42430},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_3805":973,"_26540":953,"_22543":42432,"_5":26784,"_10604":42379,"_1869":42433},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_3805":974,"_26540":953,"_22543":42435,"_5":26784,"_10604":42383,"_1869":42436},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_3805":975,"_26540":953,"_22543":42438,"_5":26784,"_10604":42383,"_1869":42439},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_3805":976,"_26540":953,"_22543":42441,"_5":26784,"_10604":42387,"_1869":42442},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_3805":977,"_26540":953,"_22543":42444,"_5":26784,"_10604":42387,"_1869":42445},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_3805":978,"_26540":953,"_22543":42447,"_5":26784,"_10604":42391,"_1869":42448},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_3805":979,"_26540":953,"_22543":42450,"_5":26784,"_10604":42391,"_1869":42451},[],"Método",{"_3805":980,"_26540":953,"_22543":42453,"_5":26784,"_10604":42391,"_1869":42454},[],"Ruta",{"_3805":981,"_26540":953,"_22543":42456,"_5":26784,"_10604":42391,"_1869":39717},[],{"_3805":982,"_26540":953,"_22543":42458,"_5":26784,"_10604":42391,"_1869":42459},[],"`GET`",{"_3805":983,"_26540":953,"_22543":42461,"_5":26784,"_10604":42391,"_1869":42462},[],"`/v1/roles/{ca-ski}`",{"_3805":984,"_26540":953,"_22543":42464,"_5":26784,"_10604":42391,"_1869":42465},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_3805":985,"_26540":953,"_22543":42467,"_5":26784,"_10604":42391,"_1869":42468},[],"`PUT`",{"_3805":986,"_26540":953,"_22543":42470,"_5":26784,"_10604":42391,"_1869":42462},[],{"_3805":987,"_26540":953,"_22543":42472,"_5":26784,"_10604":42391,"_1869":42473},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_3805":988,"_26540":953,"_22543":42475,"_5":26784,"_10604":42391,"_1869":42476},[],"Ejemplo de consulta del rol VA:",{"_3805":989,"_26540":953,"_22543":42478,"_5":26784,"_10604":42391,"_1869":42479},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_3805":990,"_26540":953,"_22543":42481,"_5":26784,"_10604":42395,"_1869":42482},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_3805":991,"_26540":953,"_22543":42484,"_5":26784,"_10604":42399,"_1869":42485},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_3805":992,"_26540":953,"_22543":42487,"_5":26784,"_10604":42399,"_1869":42488},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":993,"_26540":953,"_22543":42490,"_5":26784,"_10604":42399,"_1869":42491},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3805":994,"_26540":994,"_5":26779,"_1869":42493,"_26792":42494,"_22543":42495,"_10604":994},"Device Management Service",[39346,40430,40908],[],{"_3805":995,"_26540":994,"_22543":42497,"_5":26784,"_10604":994,"_1869":42498},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_3805":996,"_26540":994,"_5":26789,"_22543":42500,"_10604":42501,"_1869":39356},[],"/docs/platform/pki/device-enrollment#antes-de-empezar",{"_3805":997,"_26540":994,"_5":26789,"_22543":42503,"_10604":42504,"_1869":42505},[],"/docs/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_3805":998,"_26540":994,"_5":26789,"_22543":42507,"_10604":42508,"_1869":42509},[],"/docs/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_3805":999,"_26540":994,"_5":26789,"_22543":42511,"_10604":42512,"_1869":42513},[],"/docs/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3805":1000,"_26540":994,"_5":26789,"_22543":42515,"_10604":42516,"_1869":42517},[],"/docs/platform/pki/device-enrollment#configura-est","Configura EST",{"_3805":1001,"_26540":994,"_5":26789,"_22543":42519,"_10604":42520,"_1869":42521},[],"/docs/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_3805":1002,"_26540":994,"_5":26789,"_22543":42523,"_10604":42524,"_1869":42525},[],"/docs/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_3805":1003,"_26540":994,"_5":26789,"_22543":42527,"_10604":42528,"_1869":42529},[],"/docs/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_3805":1004,"_26540":994,"_5":26789,"_22543":42531,"_10604":42532,"_1869":42533},[],"/docs/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3805":1005,"_26540":994,"_5":26789,"_22543":42535,"_10604":42536,"_1869":42537},[],"/docs/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_3805":1006,"_26540":994,"_22543":42539,"_5":26784,"_10604":994,"_1869":42540},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_3805":1007,"_26540":994,"_22543":42542,"_5":26784,"_10604":994,"_1869":42543},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_3805":1008,"_26540":994,"_22543":42545,"_5":26784,"_10604":42501,"_1869":42546},[],"Crea o importa al menos una CA activa.",{"_3805":1009,"_26540":994,"_22543":42548,"_5":26784,"_10604":42501,"_1869":42549},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_3805":1010,"_26540":994,"_22543":42551,"_5":26784,"_10604":42501,"_1869":42552},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_3805":1011,"_26540":994,"_22543":42554,"_5":26784,"_10604":42501,"_1869":42555},[],"Asegúrate de tener permisos para administrar DMS.",{"_3805":1012,"_26540":994,"_22543":42557,"_5":26784,"_10604":42508,"_1869":42558},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_3805":1013,"_26540":994,"_22543":42560,"_5":26784,"_10604":42512,"_1869":42561},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_3805":1014,"_26540":994,"_22543":42563,"_5":26784,"_10604":42516,"_1869":42564},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_3805":1015,"_26540":994,"_22543":42566,"_5":26784,"_10604":42520,"_1869":42567},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_3805":1016,"_26540":994,"_22543":42569,"_5":26784,"_10604":42524,"_1869":42570},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_3805":1017,"_26540":994,"_22543":42572,"_5":26784,"_10604":42528,"_1869":42573},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_3805":1018,"_26540":994,"_22543":42575,"_5":26784,"_10604":42528,"_1869":42576},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_3805":1019,"_26540":994,"_22543":42578,"_5":26784,"_10604":42528,"_1869":42579},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_3805":1020,"_26540":994,"_22543":42581,"_5":26784,"_10604":42532,"_1869":42582},[],"**Edit** modifica la política del DMS.",{"_3805":1021,"_26540":994,"_22543":42584,"_5":26784,"_10604":42532,"_1869":42585},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_3805":1022,"_26540":994,"_22543":42587,"_5":26784,"_10604":42532,"_1869":42588},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_3805":1023,"_26540":994,"_22543":42590,"_5":26784,"_10604":42532,"_1869":42591},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_3805":1024,"_26540":994,"_22543":42593,"_5":26784,"_10604":42532,"_1869":42594},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_3805":1025,"_26540":994,"_22543":42596,"_5":26784,"_10604":42536,"_1869":42597},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3805":1026,"_26540":994,"_22543":42599,"_5":26784,"_10604":42536,"_1869":42600},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_3805":1027,"_26540":1027,"_5":26779,"_1869":42602,"_26792":42603,"_22543":42604,"_10604":1027},"Dispositivos e identidades",[39346,40430,40908],[],{"_3805":1028,"_26540":1027,"_22543":42606,"_5":26784,"_10604":1027,"_1869":42607},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_3805":1029,"_26540":1027,"_5":26789,"_22543":42609,"_10604":42610,"_1869":42611},[],"/docs/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3805":1030,"_26540":1027,"_5":26789,"_22543":42613,"_10604":42614,"_1869":42615},[],"/docs/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3805":1031,"_26540":1027,"_5":26789,"_22543":42617,"_10604":42618,"_1869":42619},[],"/docs/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3805":1032,"_26540":1027,"_5":26789,"_22543":42621,"_10604":42622,"_1869":42623},[],"/docs/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3805":1033,"_26540":1027,"_5":26789,"_22543":42625,"_10604":42626,"_1869":42627},[],"/docs/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_3805":1034,"_26540":1027,"_5":26789,"_22543":42629,"_10604":42630,"_1869":42631},[],"/docs/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3805":1035,"_26540":1027,"_5":26789,"_22543":42633,"_10604":42634,"_1869":42635},[],"/docs/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_3805":1036,"_26540":1027,"_5":26789,"_22543":42637,"_10604":42638,"_1869":42639},[],"/docs/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3805":1037,"_26540":1027,"_5":26789,"_22543":42641,"_10604":42642,"_1869":42643},[],"/docs/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3805":1038,"_26540":1027,"_5":26789,"_22543":42645,"_10604":42646,"_1869":42647},[],"/docs/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3805":1039,"_26540":1027,"_5":26789,"_22543":42649,"_10604":42650,"_1869":42651},[],"/docs/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3805":1040,"_26540":1027,"_22543":42653,"_5":26784,"_10604":1027,"_1869":42654},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_3805":1041,"_26540":1027,"_22543":42656,"_5":26784,"_10604":42610,"_1869":42657},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_3805":1042,"_26540":1027,"_22543":42659,"_5":26784,"_10604":42610,"_1869":42660},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_3805":1043,"_26540":1027,"_22543":42662,"_5":26784,"_10604":42610,"_1869":42663},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_3805":1044,"_26540":1027,"_22543":42665,"_5":26784,"_10604":42610,"_1869":42666},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_3805":1045,"_26540":1027,"_22543":42668,"_5":26784,"_10604":42610,"_1869":42669},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_3805":1046,"_26540":1027,"_22543":42671,"_5":26784,"_10604":42610,"_1869":42672},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_3805":1047,"_26540":1027,"_22543":42674,"_5":26784,"_10604":42610,"_1869":42675},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_3805":1048,"_26540":1027,"_22543":42677,"_5":26784,"_10604":42610,"_1869":42678},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_3805":1049,"_26540":1027,"_22543":42680,"_5":26784,"_10604":42614,"_1869":42681},[],"La vista de detalle separa dos perspectivas:",{"_3805":1050,"_26540":1027,"_22543":42683,"_5":26784,"_10604":42614,"_1869":42684},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_3805":1051,"_26540":1027,"_22543":42686,"_5":26784,"_10604":42614,"_1869":42687},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_3805":1052,"_26540":1027,"_22543":42689,"_5":26784,"_10604":42614,"_1869":42690},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_3805":1053,"_26540":1027,"_22543":42692,"_5":26784,"_10604":42618,"_1869":42693},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_3805":1054,"_26540":1027,"_22543":42695,"_5":26784,"_10604":42622,"_1869":42696},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_3805":1055,"_26540":1027,"_22543":42698,"_5":26784,"_10604":42626,"_1869":42699},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_3805":1056,"_26540":1027,"_22543":42701,"_5":26784,"_10604":42630,"_1869":42702},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_3805":1057,"_26540":1027,"_22543":42704,"_5":26784,"_10604":42634,"_1869":42705},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_3805":1058,"_26540":1027,"_22543":42707,"_5":26784,"_10604":42638,"_1869":42708},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_3805":1059,"_26540":1027,"_22543":42710,"_5":26784,"_10604":42638,"_1869":42711},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_3805":1060,"_26540":1027,"_22543":42713,"_5":26784,"_10604":42638,"_1869":42714},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_3805":1061,"_26540":1027,"_22543":42716,"_5":26784,"_10604":42638,"_1869":42717},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_3805":1062,"_26540":1027,"_22543":42719,"_5":26784,"_10604":42638,"_1869":42720},[],"Confirma la asignación.",{"_3805":1063,"_26540":1027,"_22543":42722,"_5":26784,"_10604":42638,"_1869":42723},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_3805":1064,"_26540":1027,"_22543":42725,"_5":26784,"_10604":42642,"_1869":42726},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_3805":1065,"_26540":1027,"_22543":42728,"_5":26784,"_10604":42642,"_1869":42729},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_3805":1066,"_26540":1027,"_22543":42731,"_5":26784,"_10604":42646,"_1869":42732},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_3805":1067,"_26540":1027,"_22543":42734,"_5":26784,"_10604":42646,"_1869":42735},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_3805":1068,"_26540":1027,"_22543":42737,"_5":26784,"_10604":42650,"_1869":42738},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1069,"_26540":1027,"_22543":42740,"_5":26784,"_10604":42650,"_1869":42741},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3805":1070,"_26540":1070,"_5":26779,"_1869":42743,"_26792":42744,"_22543":42745,"_10604":1070},"Enrolamiento de dispositivos con EST",[39346,40430,40908],[],{"_3805":1071,"_26540":1070,"_22543":42747,"_5":26784,"_10604":1070,"_1869":42748},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_3805":1072,"_26540":1070,"_5":26789,"_22543":42750,"_10604":42751,"_1869":42752},[],"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_3805":1073,"_26540":1070,"_5":26789,"_22543":42754,"_10604":42755,"_1869":42756},[],"/docs/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_3805":1074,"_26540":1070,"_5":26789,"_22543":42758,"_10604":42759,"_1869":40155},[],"/docs/platform/pki/est-enrollment#requisitos-previos",{"_3805":1075,"_26540":1070,"_5":26789,"_22543":42761,"_10604":42762,"_1869":42763},[],"/docs/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_3805":1076,"_26540":1070,"_5":26789,"_22543":42765,"_10604":42766,"_1869":42767},[],"/docs/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_3805":1077,"_26540":1070,"_5":26789,"_22543":42769,"_10604":42770,"_1869":42771},[],"/docs/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_3805":1078,"_26540":1070,"_5":26789,"_22543":42773,"_10604":42774,"_1869":42775},[],"/docs/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_3805":1079,"_26540":1070,"_5":26789,"_22543":42777,"_10604":42778,"_1869":42779},[],"/docs/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3805":1080,"_26540":1070,"_5":26789,"_22543":42781,"_10604":42782,"_1869":42783},[],"/docs/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_3805":1081,"_26540":1070,"_5":26789,"_22543":42785,"_10604":42786,"_1869":42787},[],"/docs/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_3805":1082,"_26540":1070,"_5":26789,"_22543":42789,"_10604":42790,"_1869":42791},[],"/docs/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_3805":1083,"_26540":1070,"_5":26789,"_22543":42793,"_10604":42794,"_1869":39356},[],"/docs/platform/pki/est-enrollment#antes-de-empezar",{"_3805":1084,"_26540":1070,"_5":26789,"_22543":42796,"_10604":42797,"_1869":42798},[],"/docs/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_3805":1085,"_26540":1070,"_5":26789,"_22543":42800,"_10604":42801,"_1869":42802},[],"/docs/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_3805":1086,"_26540":1070,"_5":26789,"_22543":42804,"_10604":42805,"_1869":42806},[],"/docs/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_3805":1087,"_26540":1070,"_5":26789,"_22543":42808,"_10604":42809,"_1869":42810},[],"/docs/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_3805":1088,"_26540":1070,"_5":26789,"_22543":42812,"_10604":42813,"_1869":42814},[],"/docs/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_3805":1089,"_26540":1070,"_5":26789,"_22543":42816,"_10604":42817,"_1869":42818},[],"/docs/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_3805":1090,"_26540":1070,"_5":26789,"_22543":42820,"_10604":42821,"_1869":42822},[],"/docs/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_3805":1091,"_26540":1070,"_5":26789,"_22543":42824,"_10604":42825,"_1869":42826},[],"/docs/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_3805":1092,"_26540":1070,"_5":26789,"_22543":42828,"_10604":42829,"_1869":42830},[],"/docs/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_3805":1093,"_26540":1070,"_5":26789,"_22543":42832,"_10604":42833,"_1869":42834},[],"/docs/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_3805":1094,"_26540":1070,"_5":26789,"_22543":42836,"_10604":42837,"_1869":42838},[],"/docs/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_3805":1095,"_26540":1070,"_5":26789,"_22543":42840,"_10604":42841,"_1869":42842},[],"/docs/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3805":1096,"_26540":1070,"_5":26789,"_22543":42844,"_10604":42845,"_1869":42846},[],"/docs/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3805":1097,"_26540":1070,"_5":26789,"_22543":42848,"_10604":42849,"_1869":42850},[],"/docs/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_3805":1098,"_26540":1070,"_22543":42852,"_5":26784,"_10604":42751,"_1869":42853},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_3805":1099,"_26540":1070,"_22543":42855,"_5":26784,"_10604":42751,"_1869":42856},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_3805":1100,"_26540":1070,"_22543":42858,"_5":26784,"_10604":42751,"_1869":42859},[],"Esta guía está dividida en dos partes:",{"_3805":1101,"_26540":1070,"_22543":42861,"_5":26784,"_10604":42751,"_1869":42862},[],"Configuración del DMS, para el administrador PKI.",{"_3805":1102,"_26540":1070,"_22543":42864,"_5":26784,"_10604":42751,"_1869":42865},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_3805":1103,"_26540":1070,"_22543":42867,"_5":26784,"_10604":42751,"_1869":42868},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_3805":1104,"_26540":1070,"_22543":42870,"_5":26784,"_10604":42751,"_1869":42871},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_3805":1105,"_26540":1070,"_22543":42873,"_5":26784,"_10604":42751,"_1869":42874},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_3805":1106,"_26540":1070,"_22543":42876,"_5":26784,"_10604":42759,"_1869":42877},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_3805":1107,"_26540":1070,"_22543":42879,"_5":26784,"_10604":42759,"_1869":42880},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_3805":1108,"_26540":1070,"_22543":42882,"_5":26784,"_10604":42759,"_1869":42883},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_3805":1109,"_26540":1070,"_22543":42885,"_5":26784,"_10604":42759,"_1869":42886},[],"Conviene separar cuatro bloques de configuración:",{"_3805":1110,"_26540":1070,"_22543":42888,"_5":26784,"_10604":42759,"_1869":42889},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_3805":1111,"_26540":1070,"_22543":42891,"_5":26784,"_10604":42759,"_1869":42892},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_3805":1112,"_26540":1070,"_22543":42894,"_5":26784,"_10604":42759,"_1869":42895},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_3805":1113,"_26540":1070,"_22543":42897,"_5":26784,"_10604":42759,"_1869":42898},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_3805":1114,"_26540":1070,"_22543":42900,"_5":26784,"_10604":42766,"_1869":42901},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_3805":1115,"_26540":1070,"_22543":42903,"_5":26784,"_10604":42766,"_1869":42904},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_3805":1116,"_26540":1070,"_22543":42906,"_5":26784,"_10604":42766,"_1869":42907},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_3805":1117,"_26540":1070,"_22543":42909,"_5":26784,"_10604":42766,"_1869":42910},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_3805":1118,"_26540":1070,"_22543":42912,"_5":26784,"_10604":42770,"_1869":42913},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_3805":1119,"_26540":1070,"_22543":42915,"_5":26784,"_10604":42770,"_1869":42916},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_3805":1120,"_26540":1070,"_22543":42918,"_5":26784,"_10604":42770,"_1869":42919},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_3805":1121,"_26540":1070,"_22543":42921,"_5":26784,"_10604":42770,"_1869":42922},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_3805":1122,"_26540":1070,"_22543":42924,"_5":26784,"_10604":42770,"_1869":42925},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3805":1123,"_26540":1070,"_22543":42927,"_5":26784,"_10604":42770,"_1869":42928},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_3805":1124,"_26540":1070,"_22543":42930,"_5":26784,"_10604":42770,"_1869":42931},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_3805":1125,"_26540":1070,"_22543":42933,"_5":26784,"_10604":42770,"_1869":42934},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_3805":1126,"_26540":1070,"_22543":42936,"_5":26784,"_10604":42770,"_1869":42937},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3805":1127,"_26540":1070,"_22543":42939,"_5":26784,"_10604":42770,"_1869":42940},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_3805":1128,"_26540":1070,"_22543":42942,"_5":26784,"_10604":42770,"_1869":42943},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_3805":1129,"_26540":1070,"_22543":42945,"_5":26784,"_10604":42770,"_1869":42946},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_3805":1130,"_26540":1070,"_22543":42948,"_5":26784,"_10604":42770,"_1869":42949},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_3805":1131,"_26540":1070,"_22543":42951,"_5":26784,"_10604":42770,"_1869":42952},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_3805":1132,"_26540":1070,"_22543":42954,"_5":26784,"_10604":42774,"_1869":42955},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_3805":1133,"_26540":1070,"_22543":42957,"_5":26784,"_10604":42774,"_1869":42958},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_3805":1134,"_26540":1070,"_22543":42960,"_5":26784,"_10604":42774,"_1869":42961},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_3805":1135,"_26540":1070,"_22543":42963,"_5":26784,"_10604":42774,"_1869":42964},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_3805":1136,"_26540":1070,"_22543":42966,"_5":26784,"_10604":42774,"_1869":42967},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_3805":1137,"_26540":1070,"_22543":42969,"_5":26784,"_10604":42774,"_1869":42970},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_3805":1138,"_26540":1070,"_22543":42972,"_5":26784,"_10604":42778,"_1869":42973},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_3805":1139,"_26540":1070,"_22543":42975,"_5":26784,"_10604":42778,"_1869":42976},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_3805":1140,"_26540":1070,"_22543":42978,"_5":26784,"_10604":42778,"_1869":42979},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_3805":1141,"_26540":1070,"_22543":42981,"_5":26784,"_10604":42778,"_1869":42982},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_3805":1142,"_26540":1070,"_22543":42984,"_5":26784,"_10604":42778,"_1869":42985},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_3805":1143,"_26540":1070,"_22543":42987,"_5":26784,"_10604":42778,"_1869":42988},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_3805":1144,"_26540":1070,"_22543":42990,"_5":26784,"_10604":42778,"_1869":42991},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_3805":1145,"_26540":1070,"_22543":42993,"_5":26784,"_10604":42782,"_1869":42994},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_3805":1146,"_26540":1070,"_22543":42996,"_5":26784,"_10604":42782,"_1869":42997},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_3805":1147,"_26540":1070,"_22543":42999,"_5":26784,"_10604":42782,"_1869":43000},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_3805":1148,"_26540":1070,"_22543":43002,"_5":26784,"_10604":42782,"_1869":43003},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_3805":1149,"_26540":1070,"_22543":43005,"_5":26784,"_10604":42786,"_1869":43006},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_3805":1150,"_26540":1070,"_22543":43008,"_5":26784,"_10604":42786,"_1869":43009},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_3805":1151,"_26540":1070,"_22543":43011,"_5":26784,"_10604":42786,"_1869":43012},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_3805":1152,"_26540":1070,"_22543":43014,"_5":26784,"_10604":42786,"_1869":43015},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_3805":1153,"_26540":1070,"_22543":43017,"_5":26784,"_10604":42790,"_1869":43018},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_3805":1154,"_26540":1070,"_22543":43020,"_5":26784,"_10604":42790,"_1869":43021},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_3805":1155,"_26540":1070,"_22543":43023,"_5":26784,"_10604":42790,"_1869":43024},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_3805":1156,"_26540":1070,"_22543":43026,"_5":26784,"_10604":42794,"_1869":43027},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_3805":1157,"_26540":1070,"_22543":43029,"_5":26784,"_10604":42794,"_1869":43030},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_3805":1158,"_26540":1070,"_22543":43032,"_5":26784,"_10604":42794,"_1869":43033},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_3805":1159,"_26540":1070,"_22543":43035,"_5":26784,"_10604":42794,"_1869":43036},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_3805":1160,"_26540":1070,"_22543":43038,"_5":26784,"_10604":42794,"_1869":43039},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_3805":1161,"_26540":1070,"_22543":43041,"_5":26784,"_10604":42794,"_1869":43042},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_3805":1162,"_26540":1070,"_22543":43044,"_5":26784,"_10604":42797,"_1869":43045},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_3805":1163,"_26540":1070,"_22543":43047,"_5":26784,"_10604":42797,"_1869":43048},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_3805":1164,"_26540":1070,"_22543":43050,"_5":26784,"_10604":42797,"_1869":43051},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_3805":1165,"_26540":1070,"_22543":43053,"_5":26784,"_10604":42797,"_1869":43054},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_3805":1166,"_26540":1070,"_22543":43056,"_5":26784,"_10604":42801,"_1869":43057},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_3805":1167,"_26540":1070,"_22543":43059,"_5":26784,"_10604":42801,"_1869":43060},[],"Modo (`AuthMode`)",{"_3805":1168,"_26540":1070,"_22543":43062,"_5":26784,"_10604":42801,"_1869":39717},[],{"_3805":1169,"_26540":1070,"_22543":43064,"_5":26784,"_10604":42801,"_1869":43065},[],"Credencial esperada",{"_3805":1170,"_26540":1070,"_22543":43067,"_5":26784,"_10604":42801,"_1869":43068},[],"Aplica en enroll",{"_3805":1171,"_26540":1070,"_22543":43070,"_5":26784,"_10604":42801,"_1869":43071},[],"Aplica en reenroll",{"_3805":1172,"_26540":1070,"_22543":43073,"_5":26784,"_10604":42801,"_1869":43074},[],"`CLIENT_CERTIFICATE`",{"_3805":1173,"_26540":1070,"_22543":43076,"_5":26784,"_10604":42801,"_1869":43077},[],"mTLS con certificado X.509",{"_3805":1174,"_26540":1070,"_22543":43079,"_5":26784,"_10604":42801,"_1869":43080},[],"Certificado y clave privada cliente",{"_3805":1175,"_26540":1070,"_22543":43082,"_5":26784,"_10604":42801,"_1869":43083},[],"Sí",{"_3805":1176,"_26540":1070,"_22543":43085,"_5":26784,"_10604":42801,"_1869":43086},[],"Sí (con el certificado en vigor)",{"_3805":1177,"_26540":1070,"_22543":43088,"_5":26784,"_10604":42801,"_1869":43089},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3805":1178,"_26540":1070,"_22543":43091,"_5":26784,"_10604":42801,"_1869":43092},[],"mTLS más validación por webhook",{"_3805":1179,"_26540":1070,"_22543":43094,"_5":26784,"_10604":42801,"_1869":43095},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_3805":1180,"_26540":1070,"_22543":43097,"_5":26784,"_10604":42801,"_1869":43083},[],{"_3805":1181,"_26540":1070,"_22543":43099,"_5":26784,"_10604":42801,"_1869":43100},[],"No como combinación; en reenroll no mantiene ambos controles",{"_3805":1182,"_26540":1070,"_22543":43102,"_5":26784,"_10604":42801,"_1869":43103},[],"`EXTERNAL_WEBHOOK`",{"_3805":1183,"_26540":1070,"_22543":43105,"_5":26784,"_10604":42801,"_1869":43106},[],"Webhook externo de autorización",{"_3805":1184,"_26540":1070,"_22543":43108,"_5":26784,"_10604":42801,"_1869":43109},[],"Ninguna en el canal TLS",{"_3805":1185,"_26540":1070,"_22543":43111,"_5":26784,"_10604":42801,"_1869":43083},[],{"_3805":1186,"_26540":1070,"_22543":43113,"_5":26784,"_10604":42801,"_1869":43114},[],"No, degrada a `NO_AUTH`",{"_3805":1187,"_26540":1070,"_22543":43116,"_5":26784,"_10604":42801,"_1869":43117},[],"`NO_AUTH`",{"_3805":1188,"_26540":1070,"_22543":43119,"_5":26784,"_10604":42801,"_1869":43120},[],"Sin autenticación",{"_3805":1189,"_26540":1070,"_22543":43122,"_5":26784,"_10604":42801,"_1869":43123},[],"Ninguna",{"_3805":1190,"_26540":1070,"_22543":43125,"_5":26784,"_10604":42801,"_1869":43126},[],"Sí (uso restringido)",{"_3805":1191,"_26540":1070,"_22543":43128,"_5":26784,"_10604":42801,"_1869":43126},[],{"_3805":1192,"_26540":1070,"_22543":43130,"_5":26784,"_10604":42801,"_1869":43131},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_3805":1193,"_26540":1070,"_22543":43133,"_5":26784,"_10604":42801,"_1869":43134},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_3805":1194,"_26540":1070,"_22543":43136,"_5":26784,"_10604":42801,"_1869":43137},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_3805":1195,"_26540":1070,"_22543":43139,"_5":26784,"_10604":42801,"_1869":43140},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_3805":1196,"_26540":1070,"_22543":43142,"_5":26784,"_10604":42801,"_1869":43143},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_3805":1197,"_26540":1070,"_22543":43145,"_5":26784,"_10604":42801,"_1869":43146},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_3805":1198,"_26540":1070,"_22543":43148,"_5":26784,"_10604":42801,"_1869":43149},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_3805":1199,"_26540":1070,"_22543":43151,"_5":26784,"_10604":42805,"_1869":43152},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_3805":1200,"_26540":1070,"_22543":43154,"_5":26784,"_10604":42805,"_1869":43155},[],"`/cacerts`: descarga de la cadena de confianza.",{"_3805":1201,"_26540":1070,"_22543":43157,"_5":26784,"_10604":42805,"_1869":43158},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_3805":1202,"_26540":1070,"_22543":43160,"_5":26784,"_10604":42805,"_1869":43161},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_3805":1203,"_26540":1070,"_22543":43163,"_5":26784,"_10604":42805,"_1869":43164},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_3805":1204,"_26540":1070,"_22543":43166,"_5":26784,"_10604":42809,"_1869":43167},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_3805":1205,"_26540":1070,"_22543":43169,"_5":26784,"_10604":42809,"_1869":43170},[],"`CADistributionSettings` permite decidir qué se publica:",{"_3805":1206,"_26540":1070,"_22543":43172,"_5":26784,"_10604":42809,"_1869":43173},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_3805":1207,"_26540":1070,"_22543":43175,"_5":26784,"_10604":42809,"_1869":43176},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_3805":1208,"_26540":1070,"_22543":43178,"_5":26784,"_10604":42809,"_1869":43179},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_3805":1209,"_26540":1070,"_22543":43181,"_5":26784,"_10604":42809,"_1869":43182},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_3805":1210,"_26540":1070,"_22543":43184,"_5":26784,"_10604":42809,"_1869":43185},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_3805":1211,"_26540":1070,"_22543":43187,"_5":26784,"_10604":42809,"_1869":43188},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_3805":1212,"_26540":1070,"_22543":43190,"_5":26784,"_10604":42809,"_1869":43191},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_3805":1213,"_26540":1070,"_22543":43193,"_5":26784,"_10604":42813,"_1869":43194},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_3805":1214,"_26540":1070,"_22543":43196,"_5":26784,"_10604":42813,"_1869":43197},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_3805":1215,"_26540":1070,"_22543":43199,"_5":26784,"_10604":42813,"_1869":43200},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_3805":1216,"_26540":1070,"_22543":43202,"_5":26784,"_10604":42813,"_1869":43203},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_3805":1217,"_26540":1070,"_22543":43205,"_5":26784,"_10604":42813,"_1869":43206},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_3805":1218,"_26540":1070,"_22543":43208,"_5":26784,"_10604":42813,"_1869":43209},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_3805":1219,"_26540":1070,"_22543":43211,"_5":26784,"_10604":42813,"_1869":43212},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_3805":1220,"_26540":1070,"_22543":43214,"_5":26784,"_10604":42817,"_1869":43215},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_3805":1221,"_26540":1070,"_22543":43217,"_5":26784,"_10604":42817,"_1869":43218},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_3805":1222,"_26540":1070,"_22543":43220,"_5":26784,"_10604":42817,"_1869":43221},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_3805":1223,"_26540":1070,"_22543":43223,"_5":26784,"_10604":42817,"_1869":43224},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_3805":1224,"_26540":1070,"_22543":43226,"_5":26784,"_10604":42817,"_1869":43227},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_3805":1225,"_26540":1070,"_22543":43229,"_5":26784,"_10604":42817,"_1869":43230},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_3805":1226,"_26540":1070,"_22543":43232,"_5":26784,"_10604":42817,"_1869":43233},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_3805":1227,"_26540":1070,"_22543":43235,"_5":26784,"_10604":42817,"_1869":43236},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_3805":1228,"_26540":1070,"_22543":43238,"_5":26784,"_10604":42817,"_1869":43239},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_3805":1229,"_26540":1070,"_22543":43241,"_5":26784,"_10604":42821,"_1869":43242},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_3805":1230,"_26540":1070,"_22543":43244,"_5":26784,"_10604":42821,"_1869":43245},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_3805":1231,"_26540":1070,"_22543":43247,"_5":26784,"_10604":42821,"_1869":43248},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_3805":1232,"_26540":1070,"_22543":43250,"_5":26784,"_10604":42821,"_1869":43251},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_3805":1233,"_26540":1070,"_22543":43253,"_5":26784,"_10604":42821,"_1869":43254},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_3805":1234,"_26540":1070,"_22543":43256,"_5":26784,"_10604":42821,"_1869":43257},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_3805":1235,"_26540":1070,"_22543":43259,"_5":26784,"_10604":42821,"_1869":43260},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_3805":1236,"_26540":1070,"_22543":43262,"_5":26784,"_10604":42821,"_1869":43263},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_3805":1237,"_26540":1070,"_22543":43265,"_5":26784,"_10604":42821,"_1869":43266},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_3805":1238,"_26540":1070,"_22543":43268,"_5":26784,"_10604":42821,"_1869":43269},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_3805":1239,"_26540":1070,"_22543":43271,"_5":26784,"_10604":42821,"_1869":43272},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_3805":1240,"_26540":1070,"_22543":43274,"_5":26784,"_10604":42821,"_1869":43275},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_3805":1241,"_26540":1070,"_22543":43277,"_5":26784,"_10604":42825,"_1869":43278},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_3805":1242,"_26540":1070,"_22543":43280,"_5":26784,"_10604":42829,"_1869":43281},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_3805":1243,"_26540":1070,"_22543":43283,"_5":26784,"_10604":42833,"_1869":43284},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_3805":1244,"_26540":1070,"_22543":43286,"_5":26784,"_10604":42837,"_1869":43287},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_3805":1245,"_26540":1070,"_22543":43289,"_5":26784,"_10604":42837,"_1869":43290},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_3805":1246,"_26540":1070,"_22543":43292,"_5":26784,"_10604":42837,"_1869":43293},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_3805":1247,"_26540":1070,"_22543":43295,"_5":26784,"_10604":42837,"_1869":43296},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_3805":1248,"_26540":1070,"_22543":43298,"_5":26784,"_10604":42845,"_1869":43299},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_3805":1249,"_26540":1070,"_22543":43301,"_5":26784,"_10604":42845,"_1869":43302},[],"HTTP",{"_3805":1250,"_26540":1070,"_22543":43304,"_5":26784,"_10604":42845,"_1869":43305},[],"Mensaje",{"_3805":1251,"_26540":1070,"_22543":43307,"_5":26784,"_10604":42845,"_1869":43308},[],"Causa",{"_3805":1252,"_26540":1070,"_22543":43310,"_5":26784,"_10604":42845,"_1869":43311},[],"Acción del integrador",{"_3805":1253,"_26540":1070,"_22543":43313,"_5":26784,"_10604":42845,"_1869":24837},[],{"_3805":1254,"_26540":1070,"_22543":43315,"_5":26784,"_10604":42845,"_1869":43316},[],"`Field validation for 'APS' failed`",{"_3805":1255,"_26540":1070,"_22543":43318,"_5":26784,"_10604":42845,"_1869":43319},[],"El segmento `{aps}` falta en la URL.",{"_3805":1256,"_26540":1070,"_22543":43321,"_5":26784,"_10604":42845,"_1869":43322},[],"Incluir el ID del DMS en la ruta.",{"_3805":1257,"_26540":1070,"_22543":43324,"_5":26784,"_10604":42845,"_1869":24837},[],{"_3805":1258,"_26540":1070,"_22543":43326,"_5":26784,"_10604":42845,"_1869":43327},[],"`content-type must be application/pkcs10`",{"_3805":1259,"_26540":1070,"_22543":43329,"_5":26784,"_10604":42845,"_1869":43330},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_3805":1260,"_26540":1070,"_22543":43332,"_5":26784,"_10604":42845,"_1869":43333},[],"Fijar `Content-Type: application/pkcs10`.",{"_3805":1261,"_26540":1070,"_22543":43335,"_5":26784,"_10604":42845,"_1869":24837},[],{"_3805":1262,"_26540":1070,"_22543":43337,"_5":26784,"_10604":42845,"_1869":43338},[],"`body payload must be base64 encoded`",{"_3805":1263,"_26540":1070,"_22543":43340,"_5":26784,"_10604":42845,"_1869":43341},[],"El cuerpo no es base64 válido.",{"_3805":1264,"_26540":1070,"_22543":43343,"_5":26784,"_10604":42845,"_1869":43344},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_3805":1265,"_26540":1070,"_22543":43346,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1266,"_26540":1070,"_22543":43348,"_5":26784,"_10604":42845,"_1869":43349},[],"`DMS not found`",{"_3805":1267,"_26540":1070,"_22543":43351,"_5":26784,"_10604":42845,"_1869":43352},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_3805":1268,"_26540":1070,"_22543":43354,"_5":26784,"_10604":42845,"_1869":43355},[],"Verificar el identificador con el administrador PKI.",{"_3805":1269,"_26540":1070,"_22543":43357,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1270,"_26540":1070,"_22543":43359,"_5":26784,"_10604":42845,"_1869":43360},[],"`invalid certificate`",{"_3805":1271,"_26540":1070,"_22543":43362,"_5":26784,"_10604":42845,"_1869":43363},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_3805":1272,"_26540":1070,"_22543":43365,"_5":26784,"_10604":42845,"_1869":43366},[],"Comprobar la cadena del certificado bootstrap.",{"_3805":1273,"_26540":1070,"_22543":43368,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1274,"_26540":1070,"_22543":43370,"_5":26784,"_10604":42845,"_1869":43371},[],"`certificate is revoked`",{"_3805":1275,"_26540":1070,"_22543":43373,"_5":26784,"_10604":42845,"_1869":43374},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_3805":1276,"_26540":1070,"_22543":43376,"_5":26784,"_10604":42845,"_1869":43377},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_3805":1277,"_26540":1070,"_22543":43379,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1278,"_26540":1070,"_22543":43381,"_5":26784,"_10604":42845,"_1869":43382},[],"`revoked certificate`",{"_3805":1279,"_26540":1070,"_22543":43384,"_5":26784,"_10604":42845,"_1869":43385},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_3805":1280,"_26540":1070,"_22543":43387,"_5":26784,"_10604":42845,"_1869":43388},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_3805":1281,"_26540":1070,"_22543":43390,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1282,"_26540":1070,"_22543":43392,"_5":26784,"_10604":42845,"_1869":43393},[],"`expired certificate`",{"_3805":1283,"_26540":1070,"_22543":43395,"_5":26784,"_10604":42845,"_1869":43396},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_3805":1284,"_26540":1070,"_22543":43398,"_5":26784,"_10604":42845,"_1869":43399},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_3805":1285,"_26540":1070,"_22543":43401,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1286,"_26540":1070,"_22543":43403,"_5":26784,"_10604":42845,"_1869":43404},[],"`forbiddenNewEnrollment`",{"_3805":1287,"_26540":1070,"_22543":43406,"_5":26784,"_10604":42845,"_1869":43407},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_3805":1288,"_26540":1070,"_22543":43409,"_5":26784,"_10604":42845,"_1869":43410},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_3805":1289,"_26540":1070,"_22543":43412,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1290,"_26540":1070,"_22543":43414,"_5":26784,"_10604":42845,"_1869":43415},[],"`device not preregistered`",{"_3805":1291,"_26540":1070,"_22543":43417,"_5":26784,"_10604":42845,"_1869":43418},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_3805":1292,"_26540":1070,"_22543":43420,"_5":26784,"_10604":42845,"_1869":43421},[],"Registrar el dispositivo antes de inscribirlo.",{"_3805":1293,"_26540":1070,"_22543":43423,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1294,"_26540":1070,"_22543":43425,"_5":26784,"_10604":42845,"_1869":43426},[],"`invalid reenroll window`",{"_3805":1295,"_26540":1070,"_22543":43428,"_5":26784,"_10604":42845,"_1869":43429},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_3805":1296,"_26540":1070,"_22543":43431,"_5":26784,"_10604":42845,"_1869":43432},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_3805":1297,"_26540":1070,"_22543":43434,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1298,"_26540":1070,"_22543":43436,"_5":26784,"_10604":42845,"_1869":43437},[],"`invalid RawSubject bytes`",{"_3805":1299,"_26540":1070,"_22543":43439,"_5":26784,"_10604":42845,"_1869":43440},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_3805":1300,"_26540":1070,"_22543":43442,"_5":26784,"_10604":42845,"_1869":43443},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_3805":1301,"_26540":1070,"_22543":43445,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1302,"_26540":1070,"_22543":43447,"_5":26784,"_10604":42845,"_1869":43448},[],"`external webhook denied enrollment`",{"_3805":1303,"_26540":1070,"_22543":43450,"_5":26784,"_10604":42845,"_1869":43451},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_3805":1304,"_26540":1070,"_22543":43453,"_5":26784,"_10604":42845,"_1869":43454},[],"Revisar los logs del servicio webhook.",{"_3805":1305,"_26540":1070,"_22543":43456,"_5":26784,"_10604":42845,"_1869":24283},[],{"_3805":1306,"_26540":1070,"_22543":43458,"_5":26784,"_10604":42845,"_1869":43459},[],"`server key generation not enabled`",{"_3805":1307,"_26540":1070,"_22543":43461,"_5":26784,"_10604":42845,"_1869":43462},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_3805":1308,"_26540":1070,"_22543":43464,"_5":26784,"_10604":42845,"_1869":43465},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_3805":1309,"_26540":1070,"_22543":43467,"_5":26784,"_10604":42845,"_1869":43468},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_3805":1310,"_26540":1070,"_22543":43470,"_5":26784,"_10604":42849,"_1869":43471},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_3805":1311,"_26540":1070,"_22543":43473,"_5":26784,"_10604":42849,"_1869":43474},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_3805":1312,"_26540":1070,"_22543":43476,"_5":26784,"_10604":42849,"_1869":43477},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_3805":1313,"_26540":1070,"_22543":43479,"_5":26784,"_10604":42849,"_1869":43480},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_3805":1314,"_26540":1070,"_22543":43482,"_5":26784,"_10604":42849,"_1869":43483},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_3805":1315,"_26540":1070,"_22543":43485,"_5":26784,"_10604":42849,"_1869":43486},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_3805":1316,"_26540":1070,"_22543":43488,"_5":26784,"_10604":42849,"_1869":43489},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_3805":1317,"_26540":1070,"_22543":43491,"_5":26784,"_10604":42849,"_1869":43492},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1318,"_26540":1070,"_22543":43494,"_5":26784,"_10604":42849,"_1869":43495},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3805":1319,"_26540":1070,"_22543":43497,"_5":26784,"_10604":42849,"_1869":43498},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_3805":1320,"_26540":1320,"_5":26779,"_1869":43500,"_26792":43501,"_22543":43503,"_10604":1320},"AWS IoT Core",[39346,40430,43502],"Integraciones",[],{"_3805":1321,"_26540":1320,"_22543":43505,"_5":26784,"_10604":1320,"_1869":43506},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3805":1322,"_26540":1320,"_5":26789,"_22543":43508,"_10604":43509,"_1869":43510},[],"/docs/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3805":1323,"_26540":1320,"_5":26789,"_22543":43512,"_10604":43513,"_1869":43514},[],"/docs/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3805":1324,"_26540":1320,"_5":26789,"_22543":43516,"_10604":43517,"_1869":43518},[],"/docs/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3805":1325,"_26540":1320,"_5":26789,"_22543":43520,"_10604":43521,"_1869":43522},[],"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3805":1326,"_26540":1320,"_5":26789,"_22543":43524,"_10604":43525,"_1869":43526},[],"/docs/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3805":1327,"_26540":1320,"_5":26789,"_22543":43528,"_10604":43529,"_1869":43530},[],"/docs/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3805":1328,"_26540":1320,"_5":26789,"_22543":43532,"_10604":43533,"_1869":43534},[],"/docs/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_3805":1329,"_26540":1320,"_5":26789,"_22543":43536,"_10604":43537,"_1869":43538},[],"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3805":1330,"_26540":1320,"_5":26789,"_22543":43540,"_10604":43541,"_1869":42756},[],"/docs/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_3805":1331,"_26540":1320,"_5":26789,"_22543":43543,"_10604":43544,"_1869":43545},[],"/docs/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_3805":1332,"_26540":1320,"_5":26789,"_22543":43547,"_10604":43548,"_1869":43549},[],"/docs/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3805":1333,"_26540":1320,"_5":26789,"_22543":43551,"_10604":43552,"_1869":43553},[],"/docs/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3805":1334,"_26540":1320,"_5":26789,"_22543":43555,"_10604":43556,"_1869":43557},[],"/docs/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3805":1335,"_26540":1320,"_5":26789,"_22543":43559,"_10604":43560,"_1869":43561},[],"/docs/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3805":1336,"_26540":1320,"_5":26789,"_22543":43563,"_10604":43564,"_1869":43565},[],"/docs/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3805":1337,"_26540":1320,"_5":26789,"_22543":43567,"_10604":43568,"_1869":43569},[],"/docs/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3805":1338,"_26540":1320,"_5":26789,"_22543":43571,"_10604":43572,"_1869":43573},[],"/docs/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3805":1339,"_26540":1320,"_5":26789,"_22543":43575,"_10604":43576,"_1869":43577},[],"/docs/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3805":1340,"_26540":1320,"_5":26789,"_22543":43579,"_10604":43580,"_1869":43581},[],"/docs/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3805":1341,"_26540":1320,"_5":26789,"_22543":43583,"_10604":43584,"_1869":43585},[],"/docs/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3805":1342,"_26540":1320,"_22543":43587,"_5":26784,"_10604":1320,"_1869":43588},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3805":1343,"_26540":1320,"_22543":43590,"_5":26784,"_10604":1320,"_1869":43591},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3805":1344,"_26540":1320,"_22543":43593,"_5":26784,"_10604":1320,"_1869":43594},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3805":1345,"_26540":1320,"_22543":43596,"_5":26784,"_10604":43509,"_1869":43597},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3805":1346,"_26540":1320,"_22543":43599,"_5":26784,"_10604":43509,"_1869":43600},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3805":1347,"_26540":1320,"_22543":43602,"_5":26784,"_10604":43509,"_1869":43603},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3805":1348,"_26540":1320,"_22543":43605,"_5":26784,"_10604":43509,"_1869":43606},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3805":1349,"_26540":1320,"_22543":43608,"_5":26784,"_10604":43513,"_1869":43609},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3805":1350,"_26540":1320,"_22543":43611,"_5":26784,"_10604":43517,"_1869":43612},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3805":1351,"_26540":1320,"_22543":43614,"_5":26784,"_10604":43517,"_1869":43615},[],"Acción IAM",{"_3805":1352,"_26540":1320,"_22543":43617,"_5":26784,"_10604":43517,"_1869":43618},[],"Propósito",{"_3805":1353,"_26540":1320,"_22543":43620,"_5":26784,"_10604":43517,"_1869":43621},[],"`iot:GetRegistrationCode`",{"_3805":1354,"_26540":1320,"_22543":43623,"_5":26784,"_10604":43517,"_1869":43624},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3805":1355,"_26540":1320,"_22543":43626,"_5":26784,"_10604":43517,"_1869":43627},[],"`iot:RegisterCACertificate`",{"_3805":1356,"_26540":1320,"_22543":43629,"_5":26784,"_10604":43517,"_1869":43630},[],"Registrar la CA en AWS IoT",{"_3805":1357,"_26540":1320,"_22543":43632,"_5":26784,"_10604":43517,"_1869":43633},[],"`iot:DescribeCACertificate`",{"_3805":1358,"_26540":1320,"_22543":43635,"_5":26784,"_10604":43517,"_1869":43636},[],"Consultar el estado del registro de la CA",{"_3805":1359,"_26540":1320,"_22543":43638,"_5":26784,"_10604":43517,"_1869":43639},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3805":1360,"_26540":1320,"_22543":43641,"_5":26784,"_10604":43517,"_1869":43642},[],"Crear o actualizar Things en IoT Core",{"_3805":1361,"_26540":1320,"_22543":43644,"_5":26784,"_10604":43517,"_1869":43645},[],"`iot:RegisterThing`",{"_3805":1362,"_26540":1320,"_22543":43647,"_5":26784,"_10604":43517,"_1869":43648},[],"Aprovisionar Things mediante plantilla",{"_3805":1363,"_26540":1320,"_22543":43650,"_5":26784,"_10604":43517,"_1869":43651},[],"`iot:RegisterCertificate`",{"_3805":1364,"_26540":1320,"_22543":43653,"_5":26784,"_10604":43517,"_1869":43654},[],"Registrar certificados de dispositivo",{"_3805":1365,"_26540":1320,"_22543":43656,"_5":26784,"_10604":43517,"_1869":43657},[],"`iot:UpdateCertificate`",{"_3805":1366,"_26540":1320,"_22543":43659,"_5":26784,"_10604":43517,"_1869":43660},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3805":1367,"_26540":1320,"_22543":43662,"_5":26784,"_10604":43517,"_1869":43663},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3805":1368,"_26540":1320,"_22543":43665,"_5":26784,"_10604":43517,"_1869":43666},[],"Crear y adjuntar políticas IoT",{"_3805":1369,"_26540":1320,"_22543":43668,"_5":26784,"_10604":43517,"_1869":43669},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3805":1370,"_26540":1320,"_22543":43671,"_5":26784,"_10604":43517,"_1869":43672},[],"Gestionar grupos de Things",{"_3805":1371,"_26540":1320,"_22543":43674,"_5":26784,"_10604":43517,"_1869":43675},[],"`iot:CreateProvisioningTemplate`",{"_3805":1372,"_26540":1320,"_22543":43677,"_5":26784,"_10604":43517,"_1869":43678},[],"Crear plantillas JITP",{"_3805":1373,"_26540":1320,"_22543":43680,"_5":26784,"_10604":43517,"_1869":43681},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3805":1374,"_26540":1320,"_22543":43683,"_5":26784,"_10604":43517,"_1869":43684},[],"Leer y escribir el Device Shadow",{"_3805":1375,"_26540":1320,"_22543":43686,"_5":26784,"_10604":43517,"_1869":43687},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3805":1376,"_26540":1320,"_22543":43689,"_5":26784,"_10604":43521,"_1869":43690},[],"Parámetro",{"_3805":1377,"_26540":1320,"_22543":43692,"_5":26784,"_10604":43521,"_1869":43693},[],"Tipo",{"_3805":1378,"_26540":1320,"_22543":43695,"_5":26784,"_10604":43521,"_1869":43696},[],"Requerido",{"_3805":1379,"_26540":1320,"_22543":43698,"_5":26784,"_10604":43521,"_1869":39717},[],{"_3805":1380,"_26540":1320,"_22543":43700,"_5":26784,"_10604":43521,"_1869":43701},[],"`connector_id`",{"_3805":1381,"_26540":1320,"_22543":43703,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1382,"_26540":1320,"_22543":43705,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1383,"_26540":1320,"_22543":43707,"_5":26784,"_10604":43521,"_1869":43708},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3805":1384,"_26540":1320,"_22543":43710,"_5":26784,"_10604":43521,"_1869":43711},[],"`aws_config.region`",{"_3805":1385,"_26540":1320,"_22543":43713,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1386,"_26540":1320,"_22543":43715,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1387,"_26540":1320,"_22543":43717,"_5":26784,"_10604":43521,"_1869":43718},[],"Región AWS donde opera el conector.",{"_3805":1388,"_26540":1320,"_22543":43720,"_5":26784,"_10604":43521,"_1869":43721},[],"`aws_config.auth_method`",{"_3805":1389,"_26540":1320,"_22543":43723,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1390,"_26540":1320,"_22543":43725,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1391,"_26540":1320,"_22543":43727,"_5":26784,"_10604":43521,"_1869":43728},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3805":1392,"_26540":1320,"_22543":43730,"_5":26784,"_10604":43521,"_1869":43731},[],"`aws_config.access_key_id`",{"_3805":1393,"_26540":1320,"_22543":43733,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1394,"_26540":1320,"_22543":43735,"_5":26784,"_10604":43521,"_1869":43736},[],"Solo con `auth_method=static`",{"_3805":1395,"_26540":1320,"_22543":43738,"_5":26784,"_10604":43521,"_1869":43739},[],"Clave de acceso AWS.",{"_3805":1396,"_26540":1320,"_22543":43741,"_5":26784,"_10604":43521,"_1869":43742},[],"`aws_config.secret_access_key`",{"_3805":1397,"_26540":1320,"_22543":43744,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1398,"_26540":1320,"_22543":43746,"_5":26784,"_10604":43521,"_1869":43736},[],{"_3805":1399,"_26540":1320,"_22543":43748,"_5":26784,"_10604":43521,"_1869":43749},[],"Clave secreta AWS.",{"_3805":1400,"_26540":1320,"_22543":43751,"_5":26784,"_10604":43521,"_1869":43752},[],"`aws_config.session_token`",{"_3805":1401,"_26540":1320,"_22543":43754,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1402,"_26540":1320,"_22543":43756,"_5":26784,"_10604":43521,"_1869":43757},[],"No",{"_3805":1403,"_26540":1320,"_22543":43759,"_5":26784,"_10604":43521,"_1869":43760},[],"Token de sesión (con `auth_method=static`).",{"_3805":1404,"_26540":1320,"_22543":43762,"_5":26784,"_10604":43521,"_1869":43763},[],"`aws_config.role_arn`",{"_3805":1405,"_26540":1320,"_22543":43765,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1406,"_26540":1320,"_22543":43767,"_5":26784,"_10604":43521,"_1869":43768},[],"Solo con `auth_method=role`",{"_3805":1407,"_26540":1320,"_22543":43770,"_5":26784,"_10604":43521,"_1869":43771},[],"ARN del rol a asumir.",{"_3805":1408,"_26540":1320,"_22543":43773,"_5":26784,"_10604":43521,"_1869":43774},[],"`aws_config.endpoint_url`",{"_3805":1409,"_26540":1320,"_22543":43776,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1410,"_26540":1320,"_22543":43778,"_5":26784,"_10604":43521,"_1869":43757},[],{"_3805":1411,"_26540":1320,"_22543":43780,"_5":26784,"_10604":43521,"_1869":43781},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3805":1412,"_26540":1320,"_22543":43783,"_5":26784,"_10604":43521,"_1869":43784},[],"`subscriber_event_bus`",{"_3805":1413,"_26540":1320,"_22543":43786,"_5":26784,"_10604":43521,"_1869":17170},[],{"_3805":1414,"_26540":1320,"_22543":43788,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1415,"_26540":1320,"_22543":43790,"_5":26784,"_10604":43521,"_1869":43791},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3805":1416,"_26540":1320,"_22543":43793,"_5":26784,"_10604":43521,"_1869":43794},[],"`dms_manager_client`",{"_3805":1417,"_26540":1320,"_22543":43796,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1418,"_26540":1320,"_22543":43798,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1419,"_26540":1320,"_22543":43800,"_5":26784,"_10604":43521,"_1869":43801},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3805":1420,"_26540":1320,"_22543":43803,"_5":26784,"_10604":43521,"_1869":43804},[],"`device_manager_client`",{"_3805":1421,"_26540":1320,"_22543":43806,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1422,"_26540":1320,"_22543":43808,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1423,"_26540":1320,"_22543":43810,"_5":26784,"_10604":43521,"_1869":43811},[],"URL HTTP del Device Manager de Lamassu.",{"_3805":1424,"_26540":1320,"_22543":43813,"_5":26784,"_10604":43521,"_1869":43814},[],"`ca_client`",{"_3805":1425,"_26540":1320,"_22543":43816,"_5":26784,"_10604":43521,"_1869":22180},[],{"_3805":1426,"_26540":1320,"_22543":43818,"_5":26784,"_10604":43521,"_1869":43083},[],{"_3805":1427,"_26540":1320,"_22543":43820,"_5":26784,"_10604":43521,"_1869":43821},[],"URL HTTP del servicio de CA de Lamassu.",{"_3805":1428,"_26540":1320,"_22543":43823,"_5":26784,"_10604":43525,"_1869":43824},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3805":1429,"_26540":1320,"_22543":43826,"_5":26784,"_10604":43529,"_1869":43827},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3805":1430,"_26540":1320,"_22543":43829,"_5":26784,"_10604":43529,"_1869":43830},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3805":1431,"_26540":1320,"_22543":43832,"_5":26784,"_10604":43533,"_1869":43833},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3805":1432,"_26540":1320,"_22543":43835,"_5":26784,"_10604":43533,"_1869":43836},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3805":1433,"_26540":1320,"_22543":43838,"_5":26784,"_10604":43533,"_1869":43839},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3805":1434,"_26540":1320,"_22543":43841,"_5":26784,"_10604":43533,"_1869":43842},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3805":1435,"_26540":1320,"_22543":43844,"_5":26784,"_10604":43533,"_1869":43845},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3805":1436,"_26540":1320,"_22543":43847,"_5":26784,"_10604":43533,"_1869":43848},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3805":1437,"_26540":1320,"_22543":43850,"_5":26784,"_10604":43537,"_1869":43851},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3805":1438,"_26540":1320,"_22543":43853,"_5":26784,"_10604":43541,"_1869":43854},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3805":1439,"_26540":1320,"_22543":43856,"_5":26784,"_10604":43541,"_1869":43857},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3805":1440,"_26540":1320,"_22543":43859,"_5":26784,"_10604":43544,"_1869":43860},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3805":1441,"_26540":1320,"_22543":43862,"_5":26784,"_10604":43548,"_1869":43863},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3805":1442,"_26540":1320,"_22543":43865,"_5":26784,"_10604":43548,"_1869":43866},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3805":1443,"_26540":1320,"_22543":43868,"_5":26784,"_10604":43548,"_1869":43869},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3805":1444,"_26540":1320,"_22543":43871,"_5":26784,"_10604":43548,"_1869":43872},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3805":1445,"_26540":1320,"_22543":43874,"_5":26784,"_10604":43548,"_1869":43875},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3805":1446,"_26540":1320,"_22543":43877,"_5":26784,"_10604":43548,"_1869":43878},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3805":1447,"_26540":1320,"_22543":43880,"_5":26784,"_10604":43552,"_1869":43881},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3805":1448,"_26540":1320,"_22543":43883,"_5":26784,"_10604":43552,"_1869":43884},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3805":1449,"_26540":1320,"_22543":43886,"_5":26784,"_10604":43552,"_1869":43887},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3805":1450,"_26540":1320,"_22543":43889,"_5":26784,"_10604":43556,"_1869":43890},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3805":1451,"_26540":1320,"_22543":43892,"_5":26784,"_10604":43556,"_1869":43893},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3805":1452,"_26540":1320,"_22543":43895,"_5":26784,"_10604":43556,"_1869":43896},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3805":1453,"_26540":1320,"_22543":43898,"_5":26784,"_10604":43560,"_1869":43899},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3805":1454,"_26540":1320,"_22543":43901,"_5":26784,"_10604":43560,"_1869":43902},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3805":1455,"_26540":1320,"_22543":43904,"_5":26784,"_10604":43560,"_1869":43905},[],"Para que el flujo JITP funcione correctamente:",{"_3805":1456,"_26540":1320,"_22543":43907,"_5":26784,"_10604":43560,"_1869":43908},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3805":1457,"_26540":1320,"_22543":43910,"_5":26784,"_10604":43560,"_1869":43911},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3805":1458,"_26540":1320,"_22543":43913,"_5":26784,"_10604":43560,"_1869":43914},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3805":1459,"_26540":1320,"_22543":43916,"_5":26784,"_10604":43560,"_1869":43917},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3805":1460,"_26540":1320,"_22543":43919,"_5":26784,"_10604":43564,"_1869":43920},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3805":1461,"_26540":1320,"_22543":43922,"_5":26784,"_10604":43564,"_1869":43923},[],"Estado en Lamassu",{"_3805":1462,"_26540":1320,"_22543":43925,"_5":26784,"_10604":43564,"_1869":43926},[],"Razón de revocación",{"_3805":1463,"_26540":1320,"_22543":43928,"_5":26784,"_10604":43564,"_1869":43929},[],"Estado en AWS IoT Core",{"_3805":1464,"_26540":1320,"_22543":43931,"_5":26784,"_10604":43564,"_1869":43932},[],"`Active`",{"_3805":1465,"_26540":1320,"_22543":43934,"_5":26784,"_10604":43564,"_1869":43123},[],{"_3805":1466,"_26540":1320,"_22543":43936,"_5":26784,"_10604":43564,"_1869":43937},[],"`ACTIVE`",{"_3805":1467,"_26540":1320,"_22543":43939,"_5":26784,"_10604":43564,"_1869":43940},[],"`Revoked`",{"_3805":1468,"_26540":1320,"_22543":43942,"_5":26784,"_10604":43564,"_1869":43943},[],"`certificateHold`",{"_3805":1469,"_26540":1320,"_22543":43945,"_5":26784,"_10604":43564,"_1869":43946},[],"`INACTIVE`",{"_3805":1470,"_26540":1320,"_22543":43948,"_5":26784,"_10604":43564,"_1869":43940},[],{"_3805":1471,"_26540":1320,"_22543":43950,"_5":26784,"_10604":43564,"_1869":43951},[],"Cualquier otra razón",{"_3805":1472,"_26540":1320,"_22543":43953,"_5":26784,"_10604":43564,"_1869":43954},[],"`REVOKED`",{"_3805":1473,"_26540":1320,"_22543":43956,"_5":26784,"_10604":43564,"_1869":43957},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3805":1474,"_26540":1320,"_22543":43959,"_5":26784,"_10604":43568,"_1869":43960},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3805":1475,"_26540":1320,"_22543":43962,"_5":26784,"_10604":43568,"_1869":43963},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3805":1476,"_26540":1320,"_22543":43965,"_5":26784,"_10604":43568,"_1869":43966},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3805":1477,"_26540":1320,"_22543":43968,"_5":26784,"_10604":43572,"_1869":43969},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3805":1478,"_26540":1320,"_22543":43971,"_5":26784,"_10604":43572,"_1869":43972},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3805":1479,"_26540":1320,"_22543":43974,"_5":26784,"_10604":43576,"_1869":43975},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3805":1480,"_26540":1320,"_22543":43977,"_5":26784,"_10604":43576,"_1869":43978},[],"Existen dos tipos de acciones:",{"_3805":1481,"_26540":1320,"_22543":43980,"_5":26784,"_10604":43576,"_1869":43981},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3805":1482,"_26540":1320,"_22543":43983,"_5":26784,"_10604":43576,"_1869":43984},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3805":1483,"_26540":1320,"_22543":43986,"_5":26784,"_10604":43576,"_1869":43987},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3805":1484,"_26540":1320,"_22543":43989,"_5":26784,"_10604":43580,"_1869":43990},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3805":1485,"_26540":1320,"_22543":43992,"_5":26784,"_10604":43580,"_1869":43993},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3805":1486,"_26540":1320,"_22543":43995,"_5":26784,"_10604":43580,"_1869":43996},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3805":1487,"_26540":1320,"_22543":43998,"_5":26784,"_10604":43584,"_1869":43999},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3805":1488,"_26540":1320,"_22543":44001,"_5":26784,"_10604":43584,"_1869":44002},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3805":1489,"_26540":1320,"_22543":44004,"_5":26784,"_10604":43584,"_1869":44005},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3805":1490,"_26540":1320,"_22543":44007,"_5":26784,"_10604":43584,"_1869":44008},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3805":1491,"_26540":1320,"_22543":44010,"_5":26784,"_10604":43584,"_1869":44011},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3805":1492,"_26540":1320,"_22543":44013,"_5":26784,"_10604":43584,"_1869":44014},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3805":1493,"_26540":1320,"_22543":44016,"_5":26784,"_10604":43584,"_1869":44017},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3805":1494,"_26540":1320,"_22543":44019,"_5":26784,"_10604":43584,"_1869":44020},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3805":1495,"_26540":1320,"_22543":44022,"_5":26784,"_10604":43584,"_1869":44023},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3805":1496,"_26540":1320,"_22543":44025,"_5":26784,"_10604":43584,"_1869":44026},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3805":1497,"_26540":1320,"_22543":44028,"_5":26784,"_10604":43584,"_1869":44029},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3805":1498,"_26540":1320,"_22543":44031,"_5":26784,"_10604":43584,"_1869":44032},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3805":1499,"_26540":1320,"_22543":44034,"_5":26784,"_10604":43584,"_1869":44035},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3805":1500,"_26540":1320,"_22543":44037,"_5":26784,"_10604":43584,"_1869":44038},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3805":1501,"_26540":1320,"_22543":44040,"_5":26784,"_10604":43584,"_1869":44041},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3805":1502,"_26540":1320,"_22543":44043,"_5":26784,"_10604":43584,"_1869":44044},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3805":1503,"_26540":1320,"_22543":44046,"_5":26784,"_10604":43584,"_1869":44047},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3805":1504,"_26540":1320,"_22543":44049,"_5":26784,"_10604":43584,"_1869":44050},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3805":1505,"_26540":1320,"_22543":44052,"_5":26784,"_10604":43584,"_1869":44053},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1506,"_26540":1320,"_22543":44055,"_5":26784,"_10604":43584,"_1869":44056},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3805":1507,"_26540":1320,"_22543":44058,"_5":26784,"_10604":43584,"_1869":44059},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3805":1508,"_26540":1508,"_5":26779,"_1869":44061,"_26792":44062,"_22543":44063,"_10604":1508},"Claves y motores criptográficos",[39346,40430,40908],[],{"_3805":1509,"_26540":1508,"_22543":44065,"_5":26784,"_10604":1508,"_1869":44066},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3805":1510,"_26540":1508,"_5":26789,"_22543":44068,"_10604":44069,"_1869":44070},[],"/docs/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_3805":1511,"_26540":1508,"_5":26789,"_22543":44072,"_10604":44073,"_1869":44074},[],"/docs/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3805":1512,"_26540":1508,"_5":26789,"_22543":44076,"_10604":44077,"_1869":44078},[],"/docs/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3805":1513,"_26540":1508,"_5":26789,"_22543":44080,"_10604":44081,"_1869":44082},[],"/docs/platform/pki/key-management#file-system","File System",{"_3805":1514,"_26540":1508,"_5":26789,"_22543":44084,"_10604":44085,"_1869":44086},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3805":1515,"_26540":1508,"_5":26789,"_22543":44088,"_10604":44089,"_1869":44090},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3805":1516,"_26540":1508,"_5":26789,"_22543":44092,"_10604":44093,"_1869":44094},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3805":1517,"_26540":1508,"_5":26789,"_22543":44096,"_10604":44097,"_1869":44098},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3805":1518,"_26540":1508,"_5":26789,"_22543":44100,"_10604":44101,"_1869":44102},[],"/docs/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3805":1519,"_26540":1508,"_5":26789,"_22543":44104,"_10604":44105,"_1869":44106},[],"/docs/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3805":1520,"_26540":1508,"_5":26789,"_22543":44108,"_10604":44109,"_1869":44110},[],"/docs/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3805":1521,"_26540":1508,"_5":26789,"_22543":44112,"_10604":44113,"_1869":44114},[],"/docs/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3805":1522,"_26540":1508,"_5":26789,"_22543":44116,"_10604":44117,"_1869":44118},[],"/docs/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3805":1523,"_26540":1508,"_5":26789,"_22543":44120,"_10604":44121,"_1869":44122},[],"/docs/platform/pki/key-management#ver-detalles","Ver detalles",{"_3805":1524,"_26540":1508,"_5":26789,"_22543":44124,"_10604":44125,"_1869":44126},[],"/docs/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3805":1525,"_26540":1508,"_5":26789,"_22543":44128,"_10604":44129,"_1869":44130},[],"/docs/platform/pki/key-management#sign","Sign",{"_3805":1526,"_26540":1508,"_5":26789,"_22543":44132,"_10604":44133,"_1869":44134},[],"/docs/platform/pki/key-management#verify","Verify",{"_3805":1527,"_26540":1508,"_5":26789,"_22543":44136,"_10604":44137,"_1869":44138},[],"/docs/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3805":1528,"_26540":1508,"_5":26789,"_22543":44140,"_10604":44141,"_1869":44142},[],"/docs/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3805":1529,"_26540":1508,"_22543":44144,"_5":26784,"_10604":44069,"_1869":44145},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3805":1530,"_26540":1508,"_22543":44147,"_5":26784,"_10604":44069,"_1869":44148},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3805":1531,"_26540":1508,"_22543":44150,"_5":26784,"_10604":44073,"_1869":44151},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3805":1532,"_26540":1508,"_22543":44153,"_5":26784,"_10604":44073,"_1869":44154},[],"En la práctica, permite:",{"_3805":1533,"_26540":1508,"_22543":44156,"_5":26784,"_10604":44073,"_1869":44157},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3805":1534,"_26540":1508,"_22543":44159,"_5":26784,"_10604":44073,"_1869":44160},[],"Importar claves creadas externamente.",{"_3805":1535,"_26540":1508,"_22543":44162,"_5":26784,"_10604":44073,"_1869":44163},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3805":1536,"_26540":1508,"_22543":44165,"_5":26784,"_10604":44073,"_1869":44166},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3805":1537,"_26540":1508,"_22543":44168,"_5":26784,"_10604":44077,"_1869":44169},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3805":1538,"_26540":1508,"_22543":44171,"_5":26784,"_10604":44077,"_1869":44172},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3805":1539,"_26540":1508,"_22543":44174,"_5":26784,"_10604":44077,"_1869":44175},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_3805":1540,"_26540":1508,"_22543":44177,"_5":26784,"_10604":44081,"_1869":44178},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_3805":1541,"_26540":1508,"_22543":44180,"_5":26784,"_10604":44085,"_1869":44181},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_3805":1542,"_26540":1508,"_22543":44183,"_5":26784,"_10604":44089,"_1869":44184},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3805":1543,"_26540":1508,"_22543":44186,"_5":26784,"_10604":44093,"_1869":44187},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_3805":1544,"_26540":1508,"_22543":44189,"_5":26784,"_10604":44097,"_1869":44190},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3805":1545,"_26540":1508,"_22543":44192,"_5":26784,"_10604":44097,"_1869":44193},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_3805":1546,"_26540":1508,"_22543":44195,"_5":26784,"_10604":44097,"_1869":44196},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3805":1547,"_26540":1508,"_22543":44198,"_5":26784,"_10604":44097,"_1869":44199},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3805":1548,"_26540":1508,"_22543":44201,"_5":26784,"_10604":44101,"_1869":44202},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3805":1549,"_26540":1508,"_22543":44204,"_5":26784,"_10604":44101,"_1869":44205},[],"La tabla incluye los siguientes campos:",{"_3805":1550,"_26540":1508,"_22543":44207,"_5":26784,"_10604":44101,"_1869":44208},[],"**Name**: nombre descriptivo de la clave.",{"_3805":1551,"_26540":1508,"_22543":44210,"_5":26784,"_10604":44101,"_1869":44211},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3805":1552,"_26540":1508,"_22543":44213,"_5":26784,"_10604":44101,"_1869":44214},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3805":1553,"_26540":1508,"_22543":44216,"_5":26784,"_10604":44101,"_1869":44217},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3805":1554,"_26540":1508,"_22543":44219,"_5":26784,"_10604":44101,"_1869":44220},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3805":1555,"_26540":1508,"_22543":44222,"_5":26784,"_10604":44101,"_1869":44223},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3805":1556,"_26540":1508,"_22543":44225,"_5":26784,"_10604":44101,"_1869":44226},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3805":1557,"_26540":1508,"_22543":44228,"_5":26784,"_10604":44101,"_1869":44229},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3805":1558,"_26540":1508,"_22543":44231,"_5":26784,"_10604":44101,"_1869":44232},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3805":1559,"_26540":1508,"_22543":44234,"_5":26784,"_10604":44101,"_1869":44235},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3805":1560,"_26540":1508,"_22543":44237,"_5":26784,"_10604":44101,"_1869":44238},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3805":1561,"_26540":1508,"_22543":44240,"_5":26784,"_10604":44101,"_1869":44241},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3805":1562,"_26540":1508,"_22543":44243,"_5":26784,"_10604":44101,"_1869":44244},[],"**Delete Key** para eliminar la clave del sistema.",{"_3805":1563,"_26540":1508,"_22543":44246,"_5":26784,"_10604":44105,"_1869":44247},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_3805":1564,"_26540":1508,"_22543":44249,"_5":26784,"_10604":44109,"_1869":44250},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3805":1565,"_26540":1508,"_22543":44252,"_5":26784,"_10604":44109,"_1869":44253},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_3805":1566,"_26540":1508,"_22543":44255,"_5":26784,"_10604":44109,"_1869":44256},[],"**Key Name**: nombre único y descriptivo.",{"_3805":1567,"_26540":1508,"_22543":44258,"_5":26784,"_10604":44109,"_1869":44259},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3805":1568,"_26540":1508,"_22543":44261,"_5":26784,"_10604":44109,"_1869":44262},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3805":1569,"_26540":1508,"_22543":44264,"_5":26784,"_10604":44109,"_1869":44265},[],"**Tags**: metadatos para clasificar la clave.",{"_3805":1570,"_26540":1508,"_22543":44267,"_5":26784,"_10604":44109,"_1869":44268},[],"**Metadata**: información adicional para usos avanzados.",{"_3805":1571,"_26540":1508,"_22543":44270,"_5":26784,"_10604":44113,"_1869":44271},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3805":1572,"_26540":1508,"_22543":44273,"_5":26784,"_10604":44113,"_1869":44274},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_3805":1573,"_26540":1508,"_22543":44276,"_5":26784,"_10604":44113,"_1869":44277},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3805":1574,"_26540":1508,"_22543":44279,"_5":26784,"_10604":44113,"_1869":44280},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3805":1575,"_26540":1508,"_22543":44282,"_5":26784,"_10604":44113,"_1869":44283},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_3805":1576,"_26540":1508,"_22543":44285,"_5":26784,"_10604":44113,"_1869":44286},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3805":1577,"_26540":1508,"_22543":44288,"_5":26784,"_10604":44113,"_1869":44289},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3805":1578,"_26540":1508,"_22543":44291,"_5":26784,"_10604":44113,"_1869":44292},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3805":1579,"_26540":1508,"_22543":44294,"_5":26784,"_10604":44113,"_1869":44295},[],"**Metadata**: información adicional opcional.",{"_3805":1580,"_26540":1508,"_22543":44297,"_5":26784,"_10604":44113,"_1869":44298},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3805":1581,"_26540":1508,"_22543":44300,"_5":26784,"_10604":44113,"_1869":44301},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_3805":1582,"_26540":1508,"_22543":44303,"_5":26784,"_10604":44117,"_1869":44304},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3805":1583,"_26540":1508,"_22543":44306,"_5":26784,"_10604":44121,"_1869":44307},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3805":1584,"_26540":1508,"_22543":44309,"_5":26784,"_10604":44121,"_1869":44310},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3805":1585,"_26540":1508,"_22543":44312,"_5":26784,"_10604":44121,"_1869":44313},[],"**Key Name**: nombre descriptivo.",{"_3805":1586,"_26540":1508,"_22543":44315,"_5":26784,"_10604":44121,"_1869":44316},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3805":1587,"_26540":1508,"_22543":44318,"_5":26784,"_10604":44121,"_1869":44319},[],"**Tags**: etiquetas asociadas.",{"_3805":1588,"_26540":1508,"_22543":44321,"_5":26784,"_10604":44121,"_1869":44322},[],"**Aliases**: nombres alternativos.",{"_3805":1589,"_26540":1508,"_22543":44324,"_5":26784,"_10604":44121,"_1869":44325},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3805":1590,"_26540":1508,"_22543":44327,"_5":26784,"_10604":44121,"_1869":44328},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3805":1591,"_26540":1508,"_22543":44330,"_5":26784,"_10604":44121,"_1869":44331},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3805":1592,"_26540":1508,"_22543":44333,"_5":26784,"_10604":44121,"_1869":44334},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_3805":1593,"_26540":1508,"_22543":44336,"_5":26784,"_10604":44125,"_1869":44337},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3805":1594,"_26540":1508,"_22543":44339,"_5":26784,"_10604":44125,"_1869":44340},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3805":1595,"_26540":1508,"_22543":44342,"_5":26784,"_10604":44129,"_1869":44343},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3805":1596,"_26540":1508,"_22543":44345,"_5":26784,"_10604":44129,"_1869":44346},[],"Campos principales:",{"_3805":1597,"_26540":1508,"_22543":44348,"_5":26784,"_10604":44129,"_1869":44349},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3805":1598,"_26540":1508,"_22543":44351,"_5":26784,"_10604":44129,"_1869":44352},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3805":1599,"_26540":1508,"_22543":44354,"_5":26784,"_10604":44129,"_1869":44355},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3805":1600,"_26540":1508,"_22543":44357,"_5":26784,"_10604":44129,"_1869":44358},[],"**Message**: contenido que se va a firmar.",{"_3805":1601,"_26540":1508,"_22543":44360,"_5":26784,"_10604":44129,"_1869":44361},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3805":1602,"_26540":1508,"_22543":44363,"_5":26784,"_10604":44133,"_1869":44364},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3805":1603,"_26540":1508,"_22543":44366,"_5":26784,"_10604":44133,"_1869":44346},[],{"_3805":1604,"_26540":1508,"_22543":44368,"_5":26784,"_10604":44133,"_1869":44369},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3805":1605,"_26540":1508,"_22543":44371,"_5":26784,"_10604":44133,"_1869":44372},[],"**Message Type**: `Raw` o `Digest`.",{"_3805":1606,"_26540":1508,"_22543":44374,"_5":26784,"_10604":44133,"_1869":44375},[],"**Payload Encoding**: codificación del mensaje.",{"_3805":1607,"_26540":1508,"_22543":44377,"_5":26784,"_10604":44133,"_1869":44378},[],"**Message**: mensaje original o hash.",{"_3805":1608,"_26540":1508,"_22543":44380,"_5":26784,"_10604":44133,"_1869":44381},[],"**Signature**: firma que se desea comprobar.",{"_3805":1609,"_26540":1508,"_22543":44383,"_5":26784,"_10604":44133,"_1869":44384},[],"**Result**: indicador del resultado de la validación.",{"_3805":1610,"_26540":1508,"_22543":44386,"_5":26784,"_10604":44137,"_1869":44387},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3805":1611,"_26540":1508,"_22543":44389,"_5":26784,"_10604":44137,"_1869":44390},[],"Este flujo es útil para:",{"_3805":1612,"_26540":1508,"_22543":44392,"_5":26784,"_10604":44137,"_1869":44393},[],"Solicitar certificados a una CA externa.",{"_3805":1613,"_26540":1508,"_22543":44395,"_5":26784,"_10604":44137,"_1869":44396},[],"Renovar una identidad manteniendo la misma clave.",{"_3805":1614,"_26540":1508,"_22543":44398,"_5":26784,"_10604":44137,"_1869":44399},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3805":1615,"_26540":1508,"_22543":44401,"_5":26784,"_10604":44137,"_1869":44402},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3805":1616,"_26540":1508,"_22543":44404,"_5":26784,"_10604":44137,"_1869":44405},[],"**Organization (O)**: organización o empresa.",{"_3805":1617,"_26540":1508,"_22543":44407,"_5":26784,"_10604":44137,"_1869":44408},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3805":1618,"_26540":1508,"_22543":44410,"_5":26784,"_10604":44137,"_1869":44411},[],"**Country (C)**: código de país de dos letras.",{"_3805":1619,"_26540":1508,"_22543":44413,"_5":26784,"_10604":44137,"_1869":44414},[],"**State / Province (ST)**: estado o provincia.",{"_3805":1620,"_26540":1508,"_22543":44416,"_5":26784,"_10604":44137,"_1869":44417},[],"**Locality (L)**: ciudad o localidad.",{"_3805":1621,"_26540":1508,"_22543":44419,"_5":26784,"_10604":44137,"_1869":44420},[],"**Email Address**: correo de contacto.",{"_3805":1622,"_26540":1508,"_22543":44422,"_5":26784,"_10604":44137,"_1869":44423},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3805":1623,"_26540":1508,"_22543":44425,"_5":26784,"_10604":44137,"_1869":44426},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_3805":1624,"_26540":1508,"_22543":44428,"_5":26784,"_10604":44141,"_1869":44429},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3805":1625,"_26540":1508,"_22543":44431,"_5":26784,"_10604":44141,"_1869":44432},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_3805":1626,"_26540":1626,"_5":26779,"_1869":44434,"_26792":44435,"_22543":44436,"_10604":1626},"Validación online con OCSP",[39346,40430,40908],[],{"_3805":1627,"_26540":1626,"_22543":44438,"_5":26784,"_10604":1626,"_1869":44439},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_3805":1628,"_26540":1626,"_5":26789,"_22543":44441,"_10604":44442,"_1869":44443},[],"/docs/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_3805":1629,"_26540":1626,"_5":26789,"_22543":44445,"_10604":44446,"_1869":44447},[],"/docs/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3805":1630,"_26540":1626,"_5":26789,"_22543":44449,"_10604":44450,"_1869":44451},[],"/docs/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3805":1631,"_26540":1626,"_5":26789,"_22543":44453,"_10604":44454,"_1869":44455},[],"/docs/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3805":1632,"_26540":1626,"_5":26789,"_22543":44457,"_10604":44458,"_1869":44459},[],"/docs/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3805":1633,"_26540":1626,"_5":26789,"_22543":44461,"_10604":44462,"_1869":42400},[],"/docs/platform/pki/ocsp#referencias",{"_3805":1634,"_26540":1626,"_22543":44464,"_5":26784,"_10604":44442,"_1869":44465},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_3805":1635,"_26540":1626,"_22543":44467,"_5":26784,"_10604":44442,"_1869":44468},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_3805":1636,"_26540":1626,"_22543":44470,"_5":26784,"_10604":44446,"_1869":44471},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_3805":1637,"_26540":1626,"_22543":44473,"_5":26784,"_10604":44446,"_1869":44474},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_3805":1638,"_26540":1626,"_22543":44476,"_5":26784,"_10604":44446,"_1869":44477},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_3805":1639,"_26540":1626,"_22543":44479,"_5":26784,"_10604":44446,"_1869":44480},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_3805":1640,"_26540":1626,"_22543":44482,"_5":26784,"_10604":44446,"_1869":44483},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_3805":1641,"_26540":1626,"_22543":44485,"_5":26784,"_10604":44446,"_1869":44486},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_3805":1642,"_26540":1626,"_22543":44488,"_5":26784,"_10604":44450,"_1869":44489},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_3805":1643,"_26540":1626,"_22543":44491,"_5":26784,"_10604":44454,"_1869":44492},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_3805":1644,"_26540":1626,"_22543":44494,"_5":26784,"_10604":44454,"_1869":44495},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_3805":1645,"_26540":1626,"_22543":44497,"_5":26784,"_10604":44454,"_1869":44498},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_3805":1646,"_26540":1626,"_22543":44500,"_5":26784,"_10604":44454,"_1869":44501},[],"Ejemplo de consulta con `curl` mediante POST:",{"_3805":1647,"_26540":1626,"_22543":44503,"_5":26784,"_10604":44454,"_1869":44504},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_3805":1648,"_26540":1626,"_22543":44506,"_5":26784,"_10604":44458,"_1869":44507},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_3805":1649,"_26540":1626,"_22543":44509,"_5":26784,"_10604":44462,"_1869":44510},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_3805":1650,"_26540":1626,"_22543":44512,"_5":26784,"_10604":44462,"_1869":44513},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_3805":1651,"_26540":1626,"_22543":44515,"_5":26784,"_10604":44462,"_1869":44516},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3805":1652,"_26540":1626,"_22543":44518,"_5":26784,"_10604":44462,"_1869":42491},[],{"_3805":1653,"_26540":1653,"_5":26779,"_1869":44520,"_26792":44521,"_22543":44522,"_10604":1653},"Plataforma Lamassu IoT",[39346,40430],[],{"_3805":1654,"_26540":1653,"_22543":44524,"_5":26784,"_10604":1653,"_1869":44525},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_3805":1655,"_26540":1653,"_5":26789,"_22543":44527,"_10604":44528,"_1869":44529},[],"/docs/platform/pki/overview#empieza-aquí","Empieza aquí",{"_3805":1656,"_26540":1653,"_5":26789,"_22543":44531,"_10604":44532,"_1869":44533},[],"/docs/platform/pki/overview#capacidades-principales","Capacidades principales",{"_3805":1657,"_26540":1653,"_5":26789,"_22543":44535,"_10604":44536,"_1869":44537},[],"/docs/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3805":1658,"_26540":1653,"_5":26789,"_22543":44539,"_10604":44540,"_1869":44541},[],"/docs/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3805":1659,"_26540":1653,"_5":26789,"_22543":44543,"_10604":44544,"_1869":44545},[],"/docs/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3805":1660,"_26540":1653,"_5":26789,"_22543":44547,"_10604":44548,"_1869":44549},[],"/docs/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3805":1661,"_26540":1653,"_5":26789,"_22543":44551,"_10604":44552,"_1869":44553},[],"/docs/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3805":1662,"_26540":1653,"_5":26789,"_22543":44555,"_10604":44556,"_1869":44557},[],"/docs/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3805":1663,"_26540":1653,"_5":26789,"_22543":44559,"_10604":44560,"_1869":44561},[],"/docs/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_3805":1664,"_26540":1653,"_5":26789,"_22543":44563,"_10604":44564,"_1869":44565},[],"/docs/platform/pki/overview#referencia-operativa","Referencia operativa",{"_3805":1665,"_26540":1653,"_22543":44567,"_5":26784,"_10604":1653,"_1869":44568},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_3805":1666,"_26540":1653,"_22543":44570,"_5":26784,"_10604":44528,"_1869":44571},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3805":1667,"_26540":1653,"_22543":44573,"_5":26784,"_10604":44528,"_1869":44574},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_3805":1668,"_26540":1653,"_22543":44576,"_5":26784,"_10604":44536,"_1869":44577},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_3805":1669,"_26540":1653,"_22543":44579,"_5":26784,"_10604":44540,"_1869":44580},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_3805":1670,"_26540":1653,"_22543":44582,"_5":26784,"_10604":44544,"_1869":44583},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_3805":1671,"_26540":1653,"_22543":44585,"_5":26784,"_10604":44548,"_1869":44586},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_3805":1672,"_26540":1653,"_22543":44588,"_5":26784,"_10604":44552,"_1869":44589},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_3805":1673,"_26540":1653,"_22543":44591,"_5":26784,"_10604":44556,"_1869":44592},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_3805":1674,"_26540":1653,"_22543":44594,"_5":26784,"_10604":44560,"_1869":44595},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_3805":1675,"_26540":1653,"_22543":44597,"_5":26784,"_10604":44560,"_1869":44598},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3805":1676,"_26540":1653,"_22543":44600,"_5":26784,"_10604":44560,"_1869":44601},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_3805":1677,"_26540":1653,"_22543":44603,"_5":26784,"_10604":44560,"_1869":44604},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_3805":1678,"_26540":1653,"_22543":44606,"_5":26784,"_10604":44564,"_1869":44607},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_3805":1679,"_26540":1653,"_22543":44609,"_5":26784,"_10604":44564,"_1869":44610},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_3805":1680,"_26540":1653,"_22543":44612,"_5":26784,"_10604":44564,"_1869":44613},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_3805":1681,"_26540":1653,"_22543":44615,"_5":26784,"_10604":44564,"_1869":44616},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3805":1682,"_26540":1682,"_5":26779,"_1869":44618,"_26792":44619,"_22543":44621,"_10604":1682},"Crea tu primera CA",[39346,40430,44620],"Primeros pasos",[],{"_3805":1683,"_26540":1682,"_22543":44623,"_5":26784,"_10604":1682,"_1869":44624},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_3805":1684,"_26540":1682,"_5":26789,"_22543":44626,"_10604":44627,"_1869":39356},[],"/docs/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3805":1685,"_26540":1682,"_5":26789,"_22543":44629,"_10604":44630,"_1869":44631},[],"/docs/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3805":1686,"_26540":1682,"_5":26789,"_22543":44633,"_10604":44634,"_1869":44635},[],"/docs/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3805":1687,"_26540":1682,"_5":26789,"_22543":44637,"_10604":44638,"_1869":44639},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3805":1688,"_26540":1682,"_5":26789,"_22543":44641,"_10604":44642,"_1869":44643},[],"/docs/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3805":1689,"_26540":1682,"_5":26789,"_22543":44645,"_10604":44646,"_1869":44647},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3805":1690,"_26540":1682,"_5":26789,"_22543":44649,"_10604":44650,"_1869":39380},[],"/docs/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3805":1691,"_26540":1682,"_22543":44652,"_5":26784,"_10604":1682,"_1869":44653},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_3805":1692,"_26540":1682,"_22543":44655,"_5":26784,"_10604":44627,"_1869":44656},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_3805":1693,"_26540":1682,"_22543":44658,"_5":26784,"_10604":44627,"_1869":44659},[],"Al menos un motor criptográfico disponible.",{"_3805":1694,"_26540":1682,"_22543":44661,"_5":26784,"_10604":44627,"_1869":44662},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_3805":1695,"_26540":1682,"_22543":44664,"_5":26784,"_10604":44627,"_1869":44665},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_3805":1696,"_26540":1682,"_22543":44667,"_5":26784,"_10604":44630,"_1869":44668},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_3805":1697,"_26540":1682,"_22543":44670,"_5":26784,"_10604":44630,"_1869":44671},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_3805":1698,"_26540":1682,"_22543":44673,"_5":26784,"_10604":44634,"_1869":44674},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_3805":1699,"_26540":1682,"_22543":44676,"_5":26784,"_10604":44634,"_1869":44677},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_3805":1700,"_26540":1682,"_22543":44679,"_5":26784,"_10604":44638,"_1869":44680},[],"Selecciona **Root CA** y completa:",{"_3805":1701,"_26540":1682,"_22543":44682,"_5":26784,"_10604":44638,"_1869":44683},[],"**CA Name**: un nombre único y reconocible.",{"_3805":1702,"_26540":1682,"_22543":44685,"_5":26784,"_10604":44638,"_1869":44686},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_3805":1703,"_26540":1682,"_22543":44688,"_5":26784,"_10604":44638,"_1869":44689},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_3805":1704,"_26540":1682,"_22543":44691,"_5":26784,"_10604":44638,"_1869":44692},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_3805":1705,"_26540":1682,"_22543":44694,"_5":26784,"_10604":44638,"_1869":44695},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_3805":1706,"_26540":1682,"_22543":44697,"_5":26784,"_10604":44642,"_1869":44698},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_3805":1707,"_26540":1682,"_22543":44700,"_5":26784,"_10604":44646,"_1869":44701},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_3805":1708,"_26540":1682,"_22543":44703,"_5":26784,"_10604":44650,"_1869":44704},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_3805":1709,"_26540":1709,"_5":26779,"_1869":44706,"_26792":44707,"_22543":44708,"_10604":1709},"Emite tu primer certificado",[39346,40430,44620],[],{"_3805":1710,"_26540":1709,"_22543":44710,"_5":26784,"_10604":1709,"_1869":44711},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_3805":1711,"_26540":1709,"_5":26789,"_22543":44713,"_10604":44714,"_1869":39356},[],"/docs/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3805":1712,"_26540":1709,"_5":26789,"_22543":44716,"_10604":44717,"_1869":44718},[],"/docs/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3805":1713,"_26540":1709,"_5":26789,"_22543":44720,"_10604":44721,"_1869":44722},[],"/docs/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3805":1714,"_26540":1709,"_5":26789,"_22543":44724,"_10604":44725,"_1869":44726},[],"/docs/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3805":1715,"_26540":1709,"_5":26789,"_22543":44728,"_10604":44729,"_1869":44730},[],"/docs/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3805":1716,"_26540":1709,"_5":26789,"_22543":44732,"_10604":44733,"_1869":44734},[],"/docs/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3805":1717,"_26540":1709,"_5":26789,"_22543":44736,"_10604":44737,"_1869":44647},[],"/docs/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3805":1718,"_26540":1709,"_5":26789,"_22543":44739,"_10604":44740,"_1869":39380},[],"/docs/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3805":1719,"_26540":1709,"_22543":44742,"_5":26784,"_10604":1709,"_1869":44743},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_3805":1720,"_26540":1709,"_22543":44745,"_5":26784,"_10604":44714,"_1869":44746},[],"Una CA activa con permiso para emitir certificados.",{"_3805":1721,"_26540":1709,"_22543":44748,"_5":26784,"_10604":44714,"_1869":44749},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_3805":1722,"_26540":1709,"_22543":44751,"_5":26784,"_10604":44714,"_1869":44752},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_3805":1723,"_26540":1709,"_22543":44754,"_5":26784,"_10604":44714,"_1869":44755},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_3805":1724,"_26540":1709,"_22543":44757,"_5":26784,"_10604":44717,"_1869":44758},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3805":1725,"_26540":1709,"_22543":44760,"_5":26784,"_10604":44721,"_1869":44761},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_3805":1726,"_26540":1709,"_22543":44763,"_5":26784,"_10604":44725,"_1869":44764},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_3805":1727,"_26540":1709,"_22543":44766,"_5":26784,"_10604":44729,"_1869":44767},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_3805":1728,"_26540":1709,"_22543":44769,"_5":26784,"_10604":44729,"_1869":44770},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_3805":1729,"_26540":1709,"_22543":44772,"_5":26784,"_10604":44733,"_1869":44773},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_3805":1730,"_26540":1709,"_22543":44775,"_5":26784,"_10604":44737,"_1869":44776},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_3805":1731,"_26540":1709,"_22543":44778,"_5":26784,"_10604":44740,"_1869":44779},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_3805":1732,"_26540":1732,"_5":26779,"_1869":44620,"_26792":44781,"_22543":44782,"_10604":1732},[39346,40430,44620],[],{"_3805":1733,"_26540":1732,"_22543":44784,"_5":26784,"_10604":1732,"_1869":44785},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_3805":1734,"_26540":1732,"_5":26789,"_22543":44787,"_10604":44788,"_1869":44789},[],"/docs/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3805":1735,"_26540":1732,"_5":26789,"_22543":44791,"_10604":44792,"_1869":39356},[],"/docs/platform/pki/quickstarts/overview#antes-de-empezar",{"_3805":1736,"_26540":1732,"_22543":44794,"_5":26784,"_10604":1732,"_1869":44795},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_3805":1737,"_26540":1732,"_22543":44797,"_5":26784,"_10604":44788,"_1869":44798},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3805":1738,"_26540":1732,"_22543":44800,"_5":26784,"_10604":44788,"_1869":44801},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3805":1739,"_26540":1732,"_22543":44803,"_5":26784,"_10604":44788,"_1869":44804},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_3805":1740,"_26540":1732,"_22543":44806,"_5":26784,"_10604":44792,"_1869":44807},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_3805":1741,"_26540":1732,"_22543":44809,"_5":26784,"_10604":44792,"_1869":44810},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_3805":1742,"_26540":1742,"_5":26779,"_1869":44812,"_26792":44813,"_22543":44814,"_10604":1742},"Registra tu primer dispositivo",[39346,40430,44620],[],{"_3805":1743,"_26540":1742,"_22543":44816,"_5":26784,"_10604":1742,"_1869":44817},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_3805":1744,"_26540":1742,"_5":26789,"_22543":44819,"_10604":44820,"_1869":39356},[],"/docs/platform/pki/quickstarts/register-device#antes-de-empezar",{"_3805":1745,"_26540":1742,"_5":26789,"_22543":44822,"_10604":44823,"_1869":44824},[],"/docs/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3805":1746,"_26540":1742,"_5":26789,"_22543":44826,"_10604":44827,"_1869":44828},[],"/docs/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3805":1747,"_26540":1742,"_5":26789,"_22543":44830,"_10604":44831,"_1869":44832},[],"/docs/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3805":1748,"_26540":1742,"_5":26789,"_22543":44834,"_10604":44835,"_1869":44836},[],"/docs/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3805":1749,"_26540":1742,"_5":26789,"_22543":44838,"_10604":44839,"_1869":44840},[],"/docs/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3805":1750,"_26540":1742,"_22543":44842,"_5":26784,"_10604":1742,"_1869":44843},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_3805":1751,"_26540":1742,"_22543":44845,"_5":26784,"_10604":44820,"_1869":44846},[],"Un DMS configurado.",{"_3805":1752,"_26540":1742,"_22543":44848,"_5":26784,"_10604":44820,"_1869":44849},[],"Una CA asociada al DMS.",{"_3805":1753,"_26540":1742,"_22543":44851,"_5":26784,"_10604":44820,"_1869":44852},[],"Un identificador único para el dispositivo.",{"_3805":1754,"_26540":1742,"_22543":44854,"_5":26784,"_10604":44823,"_1869":44855},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_3805":1755,"_26540":1742,"_22543":44857,"_5":26784,"_10604":44823,"_1869":44858},[],"**Device ID**: identificador único del dispositivo.",{"_3805":1756,"_26540":1742,"_22543":44860,"_5":26784,"_10604":44823,"_1869":44861},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_3805":1757,"_26540":1742,"_22543":44863,"_5":26784,"_10604":44823,"_1869":44864},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_3805":1758,"_26540":1742,"_22543":44866,"_5":26784,"_10604":44827,"_1869":44867},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_3805":1759,"_26540":1742,"_22543":44869,"_5":26784,"_10604":44831,"_1869":44870},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_3805":1760,"_26540":1742,"_22543":44872,"_5":26784,"_10604":44831,"_1869":44873},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_3805":1761,"_26540":1742,"_22543":44875,"_5":26784,"_10604":44835,"_1869":44876},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_3805":1762,"_26540":1742,"_22543":44878,"_5":26784,"_10604":44839,"_1869":44879},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_3805":1763,"_26540":1763,"_5":26779,"_1869":44881,"_26792":44882,"_22543":44883,"_10604":1763},"Resolución de problemas",[39346,40430,40431],[],{"_3805":1764,"_26540":1763,"_22543":44885,"_5":26784,"_10604":1763,"_1869":44886},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_3805":1765,"_26540":1763,"_5":26789,"_22543":44888,"_10604":44889,"_1869":44890},[],"/docs/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3805":1766,"_26540":1763,"_5":26789,"_22543":44892,"_10604":44893,"_1869":44894},[],"/docs/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3805":1767,"_26540":1763,"_5":26789,"_22543":44896,"_10604":44897,"_1869":44898},[],"/docs/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3805":1768,"_26540":1763,"_5":26789,"_22543":44900,"_10604":44901,"_1869":44902},[],"/docs/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3805":1769,"_26540":1763,"_5":26789,"_22543":44904,"_10604":44905,"_1869":44906},[],"/docs/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3805":1770,"_26540":1763,"_5":26789,"_22543":44908,"_10604":44909,"_1869":44910},[],"/docs/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3805":1771,"_26540":1763,"_5":26789,"_22543":44912,"_10604":44913,"_1869":44914},[],"/docs/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3805":1772,"_26540":1763,"_5":26789,"_22543":44916,"_10604":44917,"_1869":44918},[],"/docs/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3805":1773,"_26540":1763,"_5":26789,"_22543":44920,"_10604":44921,"_1869":44922},[],"/docs/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3805":1774,"_26540":1763,"_5":26789,"_22543":44924,"_10604":44925,"_1869":44926},[],"/docs/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3805":1775,"_26540":1763,"_5":26789,"_22543":44928,"_10604":44929,"_1869":44930},[],"/docs/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3805":1776,"_26540":1763,"_5":26789,"_22543":44932,"_10604":44933,"_1869":44934},[],"/docs/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3805":1777,"_26540":1763,"_5":26789,"_22543":44936,"_10604":44937,"_1869":44938},[],"/docs/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3805":1778,"_26540":1763,"_5":26789,"_22543":44940,"_10604":44941,"_1869":44942},[],"/docs/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3805":1779,"_26540":1763,"_5":26789,"_22543":44944,"_10604":44945,"_1869":44946},[],"/docs/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_3805":1780,"_26540":1763,"_22543":44948,"_5":26784,"_10604":1763,"_1869":44949},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_3805":1781,"_26540":1763,"_22543":44951,"_5":26784,"_10604":44893,"_1869":44952},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3805":1782,"_26540":1763,"_22543":44954,"_5":26784,"_10604":44897,"_1869":44955},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3805":1783,"_26540":1763,"_22543":44957,"_5":26784,"_10604":44901,"_1869":44958},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3805":1784,"_26540":1763,"_22543":44960,"_5":26784,"_10604":44905,"_1869":44961},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3805":1785,"_26540":1763,"_22543":44963,"_5":26784,"_10604":44909,"_1869":44964},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3805":1786,"_26540":1763,"_22543":44966,"_5":26784,"_10604":44913,"_1869":44967},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3805":1787,"_26540":1763,"_22543":44969,"_5":26784,"_10604":44913,"_1869":44970},[],"Ejecuta también la prueba de conectividad del chart:",{"_3805":1788,"_26540":1763,"_22543":44972,"_5":26784,"_10604":44913,"_1869":44973},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3805":1789,"_26540":1763,"_22543":44975,"_5":26784,"_10604":44913,"_1869":44976},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3805":1790,"_26540":1763,"_22543":44978,"_5":26784,"_10604":44917,"_1869":44979},[],"Si recibes un 401:",{"_3805":1791,"_26540":1763,"_22543":44981,"_5":26784,"_10604":44917,"_1869":44982},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3805":1792,"_26540":1763,"_22543":44984,"_5":26784,"_10604":44917,"_1869":44985},[],"verifica emisor, audiencia y expiración del token;",{"_3805":1793,"_26540":1763,"_22543":44987,"_5":26784,"_10604":44917,"_1869":44988},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3805":1794,"_26540":1763,"_22543":44990,"_5":26784,"_10604":44917,"_1869":44991},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3805":1795,"_26540":1763,"_22543":44993,"_5":26784,"_10604":44917,"_1869":44994},[],"Si el login termina pero las APIs devuelven 403:",{"_3805":1796,"_26540":1763,"_22543":44996,"_5":26784,"_10604":44917,"_1869":44997},[],"inspecciona los claims reales del token;",{"_3805":1797,"_26540":1763,"_22543":44999,"_5":26784,"_10604":44917,"_1869":45000},[],"confirma que coinciden con un principal activo;",{"_3805":1798,"_26540":1763,"_22543":45002,"_5":26784,"_10604":44917,"_1869":45003},[],"revisa las políticas concedidas al principal;",{"_3805":1799,"_26540":1763,"_22543":45005,"_5":26784,"_10604":44917,"_1869":45006},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3805":1800,"_26540":1763,"_22543":45008,"_5":26784,"_10604":44917,"_1869":45009},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3805":1801,"_26540":1763,"_22543":45011,"_5":26784,"_10604":44921,"_1869":45012},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3805":1802,"_26540":1763,"_22543":45014,"_5":26784,"_10604":44921,"_1869":45015},[],"Localiza el pod y Service de authz.",{"_3805":1803,"_26540":1763,"_22543":45017,"_5":26784,"_10604":44921,"_1869":45018},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3805":1804,"_26540":1763,"_22543":45020,"_5":26784,"_10604":44921,"_1869":45021},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3805":1805,"_26540":1763,"_22543":45023,"_5":26784,"_10604":44921,"_1869":45024},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3805":1806,"_26540":1763,"_22543":45026,"_5":26784,"_10604":44921,"_1869":45027},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3805":1807,"_26540":1763,"_22543":45029,"_5":26784,"_10604":44925,"_1869":45030},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3805":1808,"_26540":1763,"_22543":45032,"_5":26784,"_10604":44925,"_1869":45033},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3805":1809,"_26540":1763,"_22543":45035,"_5":26784,"_10604":44925,"_1869":45036},[],"volumen persistente sin enlazar;",{"_3805":1810,"_26540":1763,"_22543":45038,"_5":26784,"_10604":44925,"_1869":45039},[],"imagen inaccesible o política de pull incorrecta;",{"_3805":1811,"_26540":1763,"_22543":45041,"_5":26784,"_10604":44925,"_1869":45042},[],"configuración inválida del motor criptográfico;",{"_3805":1812,"_26540":1763,"_22543":45044,"_5":26784,"_10604":44925,"_1869":45045},[],"límites de CPU o memoria demasiado bajos;",{"_3805":1813,"_26540":1763,"_22543":45047,"_5":26784,"_10604":44925,"_1869":45048},[],"migración previa incompleta.",{"_3805":1814,"_26540":1763,"_22543":45050,"_5":26784,"_10604":44925,"_1869":45051},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3805":1815,"_26540":1763,"_22543":45053,"_5":26784,"_10604":44925,"_1869":45054},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3805":1816,"_26540":1763,"_22543":45056,"_5":26784,"_10604":44929,"_1869":45057},[],"Acota el error siguiendo este orden:",{"_3805":1817,"_26540":1763,"_22543":45059,"_5":26784,"_10604":44929,"_1869":45060},[],"La CA existe, está activa y no ha expirado.",{"_3805":1818,"_26540":1763,"_22543":45062,"_5":26784,"_10604":44929,"_1869":45063},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_3805":1819,"_26540":1763,"_22543":45065,"_5":26784,"_10604":44929,"_1869":45066},[],"La CSR tiene una firma válida.",{"_3805":1820,"_26540":1763,"_22543":45068,"_5":26784,"_10604":44929,"_1869":45069},[],"El perfil permite el tipo y tamaño de clave.",{"_3805":1821,"_26540":1763,"_22543":45071,"_5":26784,"_10604":44929,"_1869":45072},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_3805":1822,"_26540":1763,"_22543":45074,"_5":26784,"_10604":44929,"_1869":45075},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_3805":1823,"_26540":1763,"_22543":45077,"_5":26784,"_10604":44929,"_1869":45078},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_3805":1824,"_26540":1763,"_22543":45080,"_5":26784,"_10604":44933,"_1869":45081},[],"Comprueba:",{"_3805":1825,"_26540":1763,"_22543":45083,"_5":26784,"_10604":44933,"_1869":45084},[],"el identificador del DMS en el path EST;",{"_3805":1826,"_26540":1763,"_22543":45086,"_5":26784,"_10604":44933,"_1869":45087},[],"el método de autenticación configurado;",{"_3805":1827,"_26540":1763,"_22543":45089,"_5":26784,"_10604":44933,"_1869":45090},[],"la cadena presentada por el cliente;",{"_3805":1828,"_26540":1763,"_22543":45092,"_5":26784,"_10604":44933,"_1869":45093},[],"las CAs de validación y el límite de niveles;",{"_3805":1829,"_26540":1763,"_22543":45095,"_5":26784,"_10604":44933,"_1869":45096},[],"el estado de revocación del certificado cliente;",{"_3805":1830,"_26540":1763,"_22543":45098,"_5":26784,"_10604":44933,"_1869":45099},[],"la firma de la CSR;",{"_3805":1831,"_26540":1763,"_22543":45101,"_5":26784,"_10604":44933,"_1869":45102},[],"la CA y el perfil usados para emitir;",{"_3805":1832,"_26540":1763,"_22543":45104,"_5":26784,"_10604":44933,"_1869":45105},[],"la ventana de re-enrolamiento.",{"_3805":1833,"_26540":1763,"_22543":45107,"_5":26784,"_10604":44933,"_1869":45108},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_3805":1834,"_26540":1763,"_22543":45110,"_5":26784,"_10604":44937,"_1869":45111},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_3805":1835,"_26540":1763,"_22543":45113,"_5":26784,"_10604":44937,"_1869":45114},[],"Revisa la configuración y logs de VA.",{"_3805":1836,"_26540":1763,"_22543":45116,"_5":26784,"_10604":44937,"_1869":45117},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_3805":1837,"_26540":1763,"_22543":45119,"_5":26784,"_10604":44937,"_1869":45120},[],"Descarta cachés intermedias en proxy y cliente.",{"_3805":1838,"_26540":1763,"_22543":45122,"_5":26784,"_10604":44937,"_1869":45123},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_3805":1839,"_26540":1763,"_22543":45125,"_5":26784,"_10604":44937,"_1869":45126},[],"Consulta por número de serie y emisor correctos.",{"_3805":1840,"_26540":1763,"_22543":45128,"_5":26784,"_10604":44941,"_1869":45129},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3805":1841,"_26540":1763,"_22543":45131,"_5":26784,"_10604":44941,"_1869":45132},[],"verifica que esté habilitado en el servicio emisor;",{"_3805":1842,"_26540":1763,"_22543":45134,"_5":26784,"_10604":44941,"_1869":45135},[],"comprueba conectividad y credenciales AMQP;",{"_3805":1843,"_26540":1763,"_22543":45137,"_5":26784,"_10604":44941,"_1869":45138},[],"revisa exchange, routing key, colas y consumidores;",{"_3805":1844,"_26540":1763,"_22543":45140,"_5":26784,"_10604":44941,"_1869":45141},[],"inspecciona dead-letter queues;",{"_3805":1845,"_26540":1763,"_22543":45143,"_5":26784,"_10604":44941,"_1869":45144},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3805":1846,"_26540":1763,"_22543":45146,"_5":26784,"_10604":44941,"_1869":45147},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3805":1847,"_26540":1763,"_22543":45149,"_5":26784,"_10604":44945,"_1869":45150},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3805":1848,"_26540":1763,"_22543":45152,"_5":26784,"_10604":44945,"_1869":45153},[],"Antes de cerrar una incidencia, guarda:",{"_3805":1849,"_26540":1763,"_22543":45155,"_5":26784,"_10604":44945,"_1869":45156},[],"causa confirmada;",{"_3805":1850,"_26540":1763,"_22543":45158,"_5":26784,"_10604":44945,"_1869":45159},[],"alcance temporal y recursos afectados;",{"_3805":1851,"_26540":1763,"_22543":45161,"_5":26784,"_10604":44945,"_1869":45162},[],"comandos o consultas utilizados;",{"_3805":1852,"_26540":1763,"_22543":45164,"_5":26784,"_10604":44945,"_1869":45165},[],"cambio aplicado y forma de revertirlo;",{"_3805":1853,"_26540":1763,"_22543":45167,"_5":26784,"_10604":44945,"_1869":45168},[],"validación desde un consumidor;",{"_3805":1854,"_26540":1763,"_22543":45170,"_5":26784,"_10604":44945,"_1869":45171},[],"acción preventiva y propietario.",{"_3805":1855,"_26540":1855,"_5":26779,"_1869":45173,"_22543":45174,"_10604":1855},"Test",[],{"_3805":1856,"_26540":1855,"_22543":45176,"_5":26784,"_10604":1855,"_1869":45177},[],"A document to test Fumadocs",{"_3805":1857,"_26540":1855,"_5":26789,"_22543":45179,"_10604":45180,"_1869":45181},[],"/docs/test#cards","Cards",{"_3805":1858,"_26540":1855,"_5":26789,"_22543":45183,"_10604":45184,"_1869":45185},[],"/docs/test#codeblock","CodeBlock",{"_3805":1859,"_26540":1855,"_5":26789,"_22543":45187,"_10604":45188,"_1869":45189},[],"/docs/test#list","List",{"_3805":1860,"_26540":1855,"_22543":45191,"_5":26784,"_10604":1855,"_1869":45192},[],"Hey there!",{"_3805":1861,"_26540":1855,"_22543":45194,"_5":26784,"_10604":45180,"_1869":45195},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_3805":1862,"_26540":1855,"_22543":45197,"_5":26784,"_10604":45180,"_1869":45198},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_3805":1863,"_26540":1855,"_22543":45200,"_5":26784,"_10604":45188,"_1869":45201},[],"Hello",{"_3805":1864,"_26540":1855,"_22543":45203,"_5":26784,"_10604":45188,"_1869":45204},[],"World","count","sorting",{"_45208":45209,"_45210":45211,"_45212":45213,"_45214":45215,"_8763":1886,"_52646":1886},"language","english","sortableProperties",[1869,26540,5,10604],"sortablePropertiesWithTypes",{"_1869":22180,"_26540":2218