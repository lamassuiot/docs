241":128187,"_41243":128190,"_41245":128193,"_41247":128196,"_41249":128199,"_41251":128202,"_41253":128205,"_41255":128208,"_41258":128211,"_41260":128214,"_41262":128217},{"_3588":71971,"_30857":71971,"_5":15054,"_3044":119035,"_31195":119036,"_21381":119039,"_28049":71971},"Despliega desde AWS Marketplace",[50417,119037,119038],"Despliegue","Otros modelos",[],{"_3588":71972,"_30857":71971,"_21381":119041,"_5":14694,"_28049":71971,"_3044":119042},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3588":71973,"_30857":71971,"_5":31192,"_21381":119044,"_28049":119045,"_3044":119046},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3588":71974,"_30857":71971,"_5":31192,"_21381":119048,"_28049":119049,"_3044":119050},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3588":71975,"_30857":71971,"_5":31192,"_21381":119052,"_28049":119053,"_3044":119054},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3588":71976,"_30857":71971,"_5":31192,"_21381":119056,"_28049":119057,"_3044":119058},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3588":71977,"_30857":71971,"_5":31192,"_21381":119060,"_28049":119061,"_3044":119062},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3588":71978,"_30857":71971,"_5":31192,"_21381":119064,"_28049":119065,"_3044":119066},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3588":71979,"_30857":71971,"_5":31192,"_21381":119068,"_28049":119069,"_3044":119070},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3588":71980,"_30857":71971,"_21381":119072,"_5":14694,"_28049":71971,"_3044":119073},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3588":71981,"_30857":71971,"_21381":119075,"_5":14694,"_28049":119045,"_3044":119076},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3588":71982,"_30857":71971,"_21381":119078,"_5":14694,"_28049":119045,"_3044":119079},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3588":71983,"_30857":71971,"_21381":119081,"_5":14694,"_28049":119045,"_3044":119082},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3588":71984,"_30857":71971,"_21381":119084,"_5":14694,"_28049":119049,"_3044":119085},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3588":71985,"_30857":71971,"_21381":119087,"_5":14694,"_28049":119049,"_3044":119088},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3588":71986,"_30857":71971,"_21381":119090,"_5":14694,"_28049":119049,"_3044":119091},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3588":71987,"_30857":71971,"_21381":119093,"_5":14694,"_28049":119053,"_3044":119094},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3588":71988,"_30857":71971,"_21381":119096,"_5":14694,"_28049":119057,"_3044":119097},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3588":71989,"_30857":71971,"_21381":119099,"_5":14694,"_28049":119061,"_3044":119100},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3588":71990,"_30857":71971,"_21381":119102,"_5":14694,"_28049":119065,"_3044":119103},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3588":71991,"_30857":71971,"_21381":119105,"_5":14694,"_28049":119069,"_3044":119106},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3588":71992,"_30857":71992,"_5":15054,"_3044":119108,"_31195":119109,"_21381":119110,"_28049":71992},"Despliega Lamassu",[50417,119037],[],{"_3588":71993,"_30857":71992,"_21381":119112,"_5":14694,"_28049":71992,"_3044":119113},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3588":71994,"_30857":71992,"_5":31192,"_21381":119115,"_28049":119116,"_3044":119117},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3588":71995,"_30857":71992,"_5":31192,"_21381":119119,"_28049":119120,"_3044":119121},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3588":71996,"_30857":71992,"_5":31192,"_21381":119123,"_28049":119124,"_3044":119125},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3588":71997,"_30857":71992,"_21381":119127,"_5":14694,"_28049":71992,"_3044":119128},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3588":71998,"_30857":71992,"_21381":119130,"_5":14694,"_28049":119116,"_3044":119131},[],"Modelo",{"_3588":71999,"_30857":71992,"_21381":119133,"_5":14694,"_28049":119116,"_3044":119134},[],"Recomendado para",{"_3588":72000,"_30857":71992,"_21381":119136,"_5":14694,"_28049":119116,"_3044":119137},[],"Quién opera la infraestructura",{"_3588":72001,"_30857":71992,"_21381":119139,"_5":14694,"_28049":119116,"_3044":119140},[],"Punto de partida",{"_3588":72002,"_30857":71992,"_21381":119142,"_5":14694,"_28049":119116,"_3044":50524},[],{"_3588":72003,"_30857":71992,"_21381":119144,"_5":14694,"_28049":119116,"_3044":119145},[],"Producción, entornos regulados y despliegues personalizados",{"_3588":72004,"_30857":71992,"_21381":119147,"_5":14694,"_28049":119116,"_3044":119148},[],"Tu equipo",{"_3588":72005,"_30857":71992,"_21381":119150,"_5":14694,"_28049":119116,"_3044":119151},[],"Helm o Fastlane",{"_3588":72006,"_30857":71992,"_21381":119153,"_5":14694,"_28049":119116,"_3044":50536},[],{"_3588":72007,"_30857":71992,"_21381":119155,"_5":14694,"_28049":119116,"_3044":119156},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3588":72008,"_30857":71992,"_21381":119158,"_5":14694,"_28049":119116,"_3044":119148},[],{"_3588":72009,"_30857":71992,"_21381":119160,"_5":14694,"_28049":119116,"_3044":119161},[],"Imagen preconfigurada en EC2",{"_3588":72010,"_30857":71992,"_21381":119163,"_5":14694,"_28049":119116,"_3044":50547},[],{"_3588":72011,"_30857":71992,"_21381":119165,"_5":14694,"_28049":119116,"_3044":119166},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3588":72012,"_30857":71992,"_21381":119168,"_5":14694,"_28049":119116,"_3044":50553},[],{"_3588":72013,"_30857":71992,"_21381":119170,"_5":14694,"_28049":119116,"_3044":119171},[],"Suscripción gestionada",{"_3588":72014,"_30857":71992,"_21381":119173,"_5":14694,"_28049":119116,"_3044":119174},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3588":72015,"_30857":71992,"_21381":119176,"_5":14694,"_28049":119116,"_3044":119177},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3588":72016,"_30857":71992,"_21381":119179,"_5":14694,"_28049":119116,"_3044":119180},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3588":72017,"_30857":71992,"_21381":119182,"_5":14694,"_28049":119120,"_3044":119183},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3588":72018,"_30857":71992,"_21381":119185,"_5":14694,"_28049":119124,"_3044":119186},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3588":72019,"_30857":72019,"_5":15054,"_3044":119188,"_31195":119189,"_21381":119190,"_28049":72019},"Utiliza Lamassu como SaaS",[50417,119037,119038],[],{"_3588":72020,"_30857":72019,"_21381":119192,"_5":14694,"_28049":72019,"_3044":119193},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3588":72021,"_30857":72019,"_5":31192,"_21381":119195,"_28049":119196,"_3044":119197},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3588":72022,"_30857":72019,"_5":31192,"_21381":119199,"_28049":119200,"_3044":119201},[],"/docs/es/deployment/saas#planes","Planes",{"_3588":72023,"_30857":72019,"_5":31192,"_21381":119203,"_28049":119204,"_3044":119205},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3588":72024,"_30857":72019,"_21381":119207,"_5":14694,"_28049":72019,"_3044":119208},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3588":72025,"_30857":72019,"_21381":119210,"_5":14694,"_28049":119196,"_3044":119211},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3588":72026,"_30857":72019,"_21381":119213,"_5":14694,"_28049":119196,"_3044":119214},[],"Copias de seguridad automáticas.",{"_3588":72027,"_30857":72019,"_21381":119216,"_5":14694,"_28049":119196,"_3044":119217},[],"Actualizaciones de versión.",{"_3588":72028,"_30857":72019,"_21381":119219,"_5":14694,"_28049":119196,"_3044":119220},[],"Soporte técnico y SLA según el plan contratado.",{"_3588":72029,"_30857":72019,"_21381":119222,"_5":14694,"_28049":119200,"_3044":50608},[],{"_3588":72030,"_30857":72019,"_21381":119224,"_5":14694,"_28049":119200,"_3044":119225},[],"Dispositivos",{"_3588":72031,"_30857":72019,"_21381":119227,"_5":14694,"_28049":119200,"_3044":119228},[],"Soporte",{"_3588":72032,"_30857":72019,"_21381":119230,"_5":14694,"_28049":119200,"_3044":50617},[],{"_3588":72033,"_30857":72019,"_21381":119232,"_5":14694,"_28049":119200,"_3044":50620},[],{"_3588":72034,"_30857":72019,"_21381":119234,"_5":14694,"_28049":119200,"_3044":119235},[],"Hasta 1.000",{"_3588":72035,"_30857":72019,"_21381":119237,"_5":14694,"_28049":119200,"_3044":50626},[],{"_3588":72036,"_30857":72019,"_21381":119239,"_5":14694,"_28049":119200,"_3044":119240},[],"99,5 %",{"_3588":72037,"_30857":72019,"_21381":119242,"_5":14694,"_28049":119200,"_3044":50632},[],{"_3588":72038,"_30857":72019,"_21381":119244,"_5":14694,"_28049":119200,"_3044":119245},[],"Hasta 10.000",{"_3588":72039,"_30857":72019,"_21381":119247,"_5":14694,"_28049":119200,"_3044":119248},[],"Email y chat",{"_3588":72040,"_30857":72019,"_21381":119250,"_5":14694,"_28049":119200,"_3044":119251},[],"99,9 %",{"_3588":72041,"_30857":72019,"_21381":119253,"_5":14694,"_28049":119200,"_3044":50644},[],{"_3588":72042,"_30857":72019,"_21381":119255,"_5":14694,"_28049":119200,"_3044":119256},[],"Ilimitados",{"_3588":72043,"_30857":72019,"_21381":119258,"_5":14694,"_28049":119200,"_3044":119259},[],"Dedicado",{"_3588":72044,"_30857":72019,"_21381":119261,"_5":14694,"_28049":119200,"_3044":119262},[],"99,99 %",{"_3588":72045,"_30857":72019,"_21381":119264,"_5":14694,"_28049":119204,"_3044":119265},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3588":72046,"_30857":72019,"_21381":119267,"_5":14694,"_28049":119204,"_3044":119268},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3588":72047,"_30857":72047,"_5":15054,"_3044":50661,"_31195":119270,"_21381":119272,"_28049":72047},[50417,119037,119271],"Kubernetes autogestionado",[],{"_3588":72048,"_30857":72047,"_21381":119274,"_5":14694,"_28049":72047,"_3044":119275},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3588":72049,"_30857":72047,"_5":31192,"_21381":119277,"_28049":119278,"_3044":119279},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3588":72050,"_30857":72047,"_5":31192,"_21381":119281,"_28049":119282,"_3044":119283},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3588":72051,"_30857":72047,"_5":31192,"_21381":119285,"_28049":119286,"_3044":119287},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3588":72052,"_30857":72047,"_5":31192,"_21381":119289,"_28049":119290,"_3044":119291},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3588":72053,"_30857":72047,"_5":31192,"_21381":119293,"_28049":119294,"_3044":119295},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3588":72054,"_30857":72047,"_5":31192,"_21381":119297,"_28049":119298,"_3044":119299},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3588":72055,"_30857":72047,"_5":31192,"_21381":119301,"_28049":119302,"_3044":119303},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3588":72056,"_30857":72047,"_5":31192,"_21381":119305,"_28049":119306,"_3044":119307},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3588":72057,"_30857":72047,"_5":31192,"_21381":119309,"_28049":119310,"_3044":119311},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3588":72058,"_30857":72047,"_5":31192,"_21381":119313,"_28049":119314,"_3044":119315},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3588":72059,"_30857":72047,"_5":31192,"_21381":119317,"_28049":119318,"_3044":119319},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3588":72060,"_30857":72047,"_21381":119321,"_5":14694,"_28049":119278,"_3044":119322},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3588":72061,"_30857":72047,"_21381":119324,"_5":14694,"_28049":119278,"_3044":119325},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3588":72062,"_30857":72047,"_21381":119327,"_5":14694,"_28049":119282,"_3044":119328},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3588":72063,"_30857":72047,"_21381":119330,"_5":14694,"_28049":119282,"_3044":119331},[],"Fastlane instala o configura",{"_3588":72064,"_30857":72047,"_21381":119333,"_5":14694,"_28049":119282,"_3044":119334},[],"Tú sigues proporcionando",{"_3588":72065,"_30857":72047,"_21381":119336,"_5":14694,"_28049":119282,"_3044":119337},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3588":72066,"_30857":72047,"_21381":119339,"_5":14694,"_28049":119282,"_3044":119340},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3588":72067,"_30857":72047,"_21381":119342,"_5":14694,"_28049":119282,"_3044":119343},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3588":72068,"_30857":72047,"_21381":119345,"_5":14694,"_28049":119282,"_3044":119346},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3588":72069,"_30857":72047,"_21381":119348,"_5":14694,"_28049":119282,"_3044":119349},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3588":72070,"_30857":72047,"_21381":119351,"_5":14694,"_28049":119282,"_3044":119352},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3588":72071,"_30857":72047,"_21381":119354,"_5":14694,"_28049":119282,"_3044":119355},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3588":72072,"_30857":72047,"_21381":119357,"_5":14694,"_28049":119282,"_3044":119358},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3588":72073,"_30857":72047,"_21381":119360,"_5":14694,"_28049":119282,"_3044":119361},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3588":72074,"_30857":72047,"_21381":119363,"_5":14694,"_28049":119286,"_3044":119364},[],"Necesitas:",{"_3588":72075,"_30857":72047,"_21381":119366,"_5":14694,"_28049":119286,"_3044":119367},[],"un clúster Kubernetes existente",{"_3588":72076,"_30857":72047,"_21381":119369,"_5":14694,"_28049":119286,"_3044":119370},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3588":72077,"_30857":72047,"_21381":119372,"_5":14694,"_28049":119286,"_3044":50763},[],{"_3588":72078,"_30857":72047,"_21381":119374,"_5":14694,"_28049":119286,"_3044":24156},[],{"_3588":72079,"_30857":72047,"_21381":119376,"_5":14694,"_28049":119286,"_3044":119377},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3588":72080,"_30857":72047,"_21381":119379,"_5":14694,"_28049":119286,"_3044":119380},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3588":72081,"_30857":72047,"_21381":119382,"_5":14694,"_28049":119286,"_3044":119383},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3588":72082,"_30857":72047,"_21381":119385,"_5":14694,"_28049":119286,"_3044":119386},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3588":72083,"_30857":72047,"_21381":119388,"_5":14694,"_28049":119286,"_3044":119389},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3588":72084,"_30857":72047,"_21381":119391,"_5":14694,"_28049":119290,"_3044":119392},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3588":72085,"_30857":72047,"_21381":119394,"_5":14694,"_28049":119290,"_3044":119395},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3588":72086,"_30857":72047,"_21381":119397,"_5":14694,"_28049":119294,"_3044":119398},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3588":72087,"_30857":72047,"_21381":119400,"_5":14694,"_28049":119294,"_3044":119401},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3588":72088,"_30857":72047,"_21381":119403,"_5":14694,"_28049":119294,"_3044":119404},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3588":72089,"_30857":72047,"_21381":119406,"_5":14694,"_28049":119294,"_3044":119407},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3588":72090,"_30857":72047,"_21381":119409,"_5":14694,"_28049":119298,"_3044":119410},[],"Opción",{"_3588":72091,"_30857":72047,"_21381":119412,"_5":14694,"_28049":119298,"_3044":119413},[],"Valor predeterminado",{"_3588":72092,"_30857":72047,"_21381":119415,"_5":14694,"_28049":119298,"_3044":119416},[],"Propósito",{"_3588":72093,"_30857":72047,"_21381":119418,"_5":14694,"_28049":119298,"_3044":50810},[],{"_3588":72094,"_30857":72047,"_21381":119420,"_5":14694,"_28049":119298,"_3044":50813},[],{"_3588":72095,"_30857":72047,"_21381":119422,"_5":14694,"_28049":119298,"_3044":119423},[],"Muestra la ayuda",{"_3588":72096,"_30857":72047,"_21381":119425,"_5":14694,"_28049":119298,"_3044":50819},[],{"_3588":72097,"_30857":72047,"_21381":119427,"_5":14694,"_28049":119298,"_3044":119428},[],"contexto actual",{"_3588":72098,"_30857":72047,"_21381":119430,"_5":14694,"_28049":119298,"_3044":119431},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3588":72099,"_30857":72047,"_21381":119433,"_5":14694,"_28049":119298,"_3044":50828},[],{"_3588":72100,"_30857":72047,"_21381":119435,"_5":14694,"_28049":119298,"_3044":6730},[],{"_3588":72101,"_30857":72047,"_21381":119437,"_5":14694,"_28049":119298,"_3044":119438},[],"Omite prompts y genera credenciales para las dependencias",{"_3588":72102,"_30857":72047,"_21381":119440,"_5":14694,"_28049":119298,"_3044":50836},[],{"_3588":72103,"_30857":72047,"_21381":119442,"_5":14694,"_28049":119298,"_3044":50839},[],{"_3588":72104,"_30857":72047,"_21381":119444,"_5":14694,"_28049":119298,"_3044":119445},[],"Namespace de la instalación",{"_3588":72105,"_30857":72047,"_21381":119447,"_5":14694,"_28049":119298,"_3044":50845},[],{"_3588":72106,"_30857":72047,"_21381":119449,"_5":14694,"_28049":119298,"_3044":50848},[],{"_3588":72107,"_30857":72047,"_21381":119451,"_5":14694,"_28049":119298,"_3044":119452},[],"Dominio usado por la UI, OIDC y el certificado",{"_3588":72108,"_30857":72047,"_21381":119454,"_5":14694,"_28049":119298,"_3044":50854},[],{"_3588":72109,"_30857":72047,"_21381":119456,"_5":14694,"_28049":119298,"_3044":15405},[],{"_3588":72110,"_30857":72047,"_21381":119458,"_5":14694,"_28049":119298,"_3044":119459},[],"Versión del chart de Lamassu",{"_3588":72111,"_30857":72047,"_21381":119461,"_5":14694,"_28049":119298,"_3044":50862},[],{"_3588":72112,"_30857":72047,"_21381":119463,"_5":14694,"_28049":119298,"_3044":50865},[],{"_3588":72113,"_30857":72047,"_21381":119465,"_5":14694,"_28049":119298,"_3044":119466},[],"Puerto del listener HTTPS",{"_3588":72114,"_30857":72047,"_21381":119468,"_5":14694,"_28049":119298,"_3044":50871},[],{"_3588":72115,"_30857":72047,"_21381":119470,"_5":14694,"_28049":119298,"_3044":50874},[],{"_3588":72116,"_30857":72047,"_21381":119472,"_5":14694,"_28049":119298,"_3044":119473},[],"Puerto del listener HTTP",{"_3588":72117,"_30857":72047,"_21381":119475,"_5":14694,"_28049":119298,"_3044":50880},[],{"_3588":72118,"_30857":72047,"_21381":119477,"_5":14694,"_28049":119298,"_3044":50813},[],{"_3588":72119,"_30857":72047,"_21381":119479,"_5":14694,"_28049":119298,"_3044":119480},[],"Certificado PEM para TLS downstream",{"_3588":72120,"_30857":72047,"_21381":119482,"_5":14694,"_28049":119298,"_3044":50888},[],{"_3588":72121,"_30857":72047,"_21381":119484,"_5":14694,"_28049":119298,"_3044":50813},[],{"_3588":72122,"_30857":72047,"_21381":119486,"_5":14694,"_28049":119298,"_3044":119487},[],"Clave privada PEM para TLS downstream",{"_3588":72123,"_30857":72047,"_21381":119489,"_5":14694,"_28049":119298,"_3044":50896},[],{"_3588":72124,"_30857":72047,"_21381":119491,"_5":14694,"_28049":119298,"_3044":119492},[],"chart del repositorio",{"_3588":72125,"_30857":72047,"_21381":119494,"_5":14694,"_28049":119298,"_3044":119495},[],"Usa un chart local de Lamassu sin empaquetar",{"_3588":72126,"_30857":72047,"_21381":119497,"_5":14694,"_28049":119298,"_3044":50905},[],{"_3588":72127,"_30857":72047,"_21381":119499,"_5":14694,"_28049":119298,"_3044":119500},[],"detección automática",{"_3588":72128,"_30857":72047,"_21381":119502,"_5":14694,"_28049":119298,"_3044":119503},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3588":72129,"_30857":72047,"_21381":119505,"_5":14694,"_28049":119298,"_3044":50913},[],{"_3588":72130,"_30857":72047,"_21381":119507,"_5":14694,"_28049":119298,"_3044":6730},[],{"_3588":72131,"_30857":72047,"_21381":119509,"_5":14694,"_28049":119298,"_3044":119510},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3588":72132,"_30857":72047,"_21381":119512,"_5":14694,"_28049":119298,"_3044":50921},[],{"_3588":72133,"_30857":72047,"_21381":119514,"_5":14694,"_28049":119298,"_3044":6730},[],{"_3588":72134,"_30857":72047,"_21381":119516,"_5":14694,"_28049":119298,"_3044":119517},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3588":72135,"_30857":72047,"_21381":119519,"_5":14694,"_28049":119298,"_3044":50929},[],{"_3588":72136,"_30857":72047,"_21381":119521,"_5":14694,"_28049":119298,"_3044":6730},[],{"_3588":72137,"_30857":72047,"_21381":119523,"_5":14694,"_28049":119298,"_3044":119524},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3588":72138,"_30857":72047,"_21381":119526,"_5":14694,"_28049":119298,"_3044":50937},[],{"_3588":72139,"_30857":72047,"_21381":119528,"_5":14694,"_28049":119298,"_3044":6730},[],{"_3588":72140,"_30857":72047,"_21381":119530,"_5":14694,"_28049":119298,"_3044":119531},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3588":72141,"_30857":72047,"_21381":119533,"_5":14694,"_28049":119298,"_3044":50945},[],{"_3588":72142,"_30857":72047,"_21381":119535,"_5":14694,"_28049":119298,"_3044":50948},[],{"_3588":72143,"_30857":72047,"_21381":119537,"_5":14694,"_28049":119298,"_3044":119538},[],"Usa otro chart local de SoftHSM",{"_3588":72144,"_30857":72047,"_21381":119540,"_5":14694,"_28049":119298,"_3044":119541},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3588":72145,"_30857":72047,"_21381":119543,"_5":14694,"_28049":119302,"_3044":119544},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3588":72146,"_30857":72047,"_21381":119546,"_5":14694,"_28049":119302,"_3044":119547},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3588":72147,"_30857":72047,"_21381":119549,"_5":14694,"_28049":119302,"_3044":119550},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3588":72148,"_30857":72047,"_21381":119552,"_5":14694,"_28049":119302,"_3044":119553},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3588":72149,"_30857":72047,"_21381":119555,"_5":14694,"_28049":119302,"_3044":119556},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3588":72150,"_30857":72047,"_21381":119558,"_5":14694,"_28049":119302,"_3044":119559},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3588":72151,"_30857":72047,"_21381":119561,"_5":14694,"_28049":119306,"_3044":50975},[],{"_3588":72152,"_30857":72047,"_21381":119563,"_5":14694,"_28049":119306,"_3044":119564},[],"valida las herramientas locales y el clúster seleccionado",{"_3588":72153,"_30857":72047,"_21381":119566,"_5":14694,"_28049":119306,"_3044":119567},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3588":72154,"_30857":72047,"_21381":119569,"_5":14694,"_28049":119306,"_3044":119570},[],"crea el namespace",{"_3588":72155,"_30857":72047,"_21381":119572,"_5":14694,"_28049":119306,"_3044":119573},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3588":72156,"_30857":72047,"_21381":119575,"_5":14694,"_28049":119306,"_3044":119576},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3588":72157,"_30857":72047,"_21381":119578,"_5":14694,"_28049":119306,"_3044":119579},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3588":72158,"_30857":72047,"_21381":119581,"_5":14694,"_28049":119306,"_3044":119582},[],"instala RabbitMQ",{"_3588":72159,"_30857":72047,"_21381":119584,"_5":14694,"_28049":119306,"_3044":119585},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3588":72160,"_30857":72047,"_21381":119587,"_5":14694,"_28049":119306,"_3044":119588},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3588":72161,"_30857":72047,"_21381":119590,"_5":14694,"_28049":119306,"_3044":119591},[],"carga datos de ejemplo opcionalmente",{"_3588":72162,"_30857":72047,"_21381":119593,"_5":14694,"_28049":119306,"_3044":119594},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3588":72163,"_30857":72047,"_21381":119596,"_5":14694,"_28049":119310,"_3044":119597},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3588":72164,"_30857":72047,"_21381":119599,"_5":14694,"_28049":119310,"_3044":119600},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3588":72165,"_30857":72047,"_21381":119602,"_5":14694,"_28049":119314,"_3044":119603},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3588":72166,"_30857":72047,"_21381":119605,"_5":14694,"_28049":119314,"_3044":119606},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3588":72167,"_30857":72047,"_21381":119608,"_5":14694,"_28049":119314,"_3044":119609},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3588":72168,"_30857":72047,"_21381":119611,"_5":14694,"_28049":119314,"_3044":119612},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3588":72169,"_30857":72047,"_21381":119614,"_5":14694,"_28049":119318,"_3044":119615},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3588":72170,"_30857":72170,"_5":15054,"_3044":119617,"_31195":119618,"_21381":119619,"_28049":72170},"Instala con Helm",[50417,119037,119271],[],{"_3588":72171,"_30857":72170,"_21381":119621,"_5":14694,"_28049":72170,"_3044":119622},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3588":72172,"_30857":72170,"_5":31192,"_21381":119624,"_28049":119625,"_3044":119626},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3588":72173,"_30857":72170,"_5":31192,"_21381":119628,"_28049":119629,"_3044":119287},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3588":72174,"_30857":72170,"_5":31192,"_21381":119631,"_28049":119632,"_3044":119633},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3588":72175,"_30857":72170,"_5":31192,"_21381":119635,"_28049":119636,"_3044":119637},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3588":72176,"_30857":72170,"_5":31192,"_21381":119639,"_28049":119640,"_3044":119641},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3588":72177,"_30857":72170,"_5":31192,"_21381":119643,"_28049":119644,"_3044":119645},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3588":72178,"_30857":72170,"_5":31192,"_21381":119647,"_28049":119648,"_3044":119649},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3588":72179,"_30857":72170,"_5":31192,"_21381":119651,"_28049":119652,"_3044":119653},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3588":72180,"_30857":72170,"_5":31192,"_21381":119655,"_28049":119656,"_3044":119657},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3588":72181,"_30857":72170,"_5":31192,"_21381":119659,"_28049":119660,"_3044":119661},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3588":72182,"_30857":72170,"_5":31192,"_21381":119663,"_28049":119664,"_3044":119665},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3588":72183,"_30857":72170,"_5":31192,"_21381":119667,"_28049":119668,"_3044":119669},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3588":72184,"_30857":72170,"_21381":119671,"_5":14694,"_28049":119625,"_3044":119672},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3588":72185,"_30857":72170,"_21381":119674,"_5":14694,"_28049":119629,"_3044":119675},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3588":72186,"_30857":72170,"_21381":119677,"_5":14694,"_28049":119629,"_3044":119678},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3588":72187,"_30857":72170,"_21381":119680,"_5":14694,"_28049":119629,"_3044":119681},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3588":72188,"_30857":72170,"_21381":119683,"_5":14694,"_28049":119629,"_3044":119684},[],"un broker RabbitMQ accesible y sus credenciales",{"_3588":72189,"_30857":72170,"_21381":119686,"_5":14694,"_28049":119629,"_3044":119687},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3588":72190,"_30857":72170,"_21381":119689,"_5":14694,"_28049":119629,"_3044":119690},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3588":72191,"_30857":72170,"_21381":119692,"_5":14694,"_28049":119629,"_3044":119693},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3588":72192,"_30857":72170,"_21381":119695,"_5":14694,"_28049":119629,"_3044":119696},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3588":72193,"_30857":72170,"_21381":119698,"_5":14694,"_28049":119629,"_3044":119699},[],"una StorageClass y un diseño de tráfico externo",{"_3588":72194,"_30857":72170,"_21381":119701,"_5":14694,"_28049":119629,"_3044":119702},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3588":72195,"_30857":72170,"_21381":119704,"_5":14694,"_28049":119629,"_3044":119705},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3588":72196,"_30857":72170,"_21381":119707,"_5":14694,"_28049":119629,"_3044":119708},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3588":72197,"_30857":72170,"_21381":119710,"_5":14694,"_28049":119632,"_3044":119711},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3588":72198,"_30857":72170,"_21381":119713,"_5":14694,"_28049":119632,"_3044":119714},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3588":72199,"_30857":72170,"_21381":119716,"_5":14694,"_28049":119632,"_3044":119717},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3588":72200,"_30857":72170,"_21381":119719,"_5":14694,"_28049":119636,"_3044":119720},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3588":72201,"_30857":72170,"_21381":119722,"_5":14694,"_28049":119636,"_3044":119723},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3588":72202,"_30857":72170,"_21381":119725,"_5":14694,"_28049":119636,"_3044":119726},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3588":72203,"_30857":72170,"_21381":119728,"_5":14694,"_28049":119636,"_3044":119729},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3588":72204,"_30857":72170,"_21381":119731,"_5":14694,"_28049":119640,"_3044":119732},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3588":72205,"_30857":72170,"_21381":119734,"_5":14694,"_28049":119640,"_3044":119735},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3588":72206,"_30857":72170,"_21381":119737,"_5":14694,"_28049":119640,"_3044":119738},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3588":72207,"_30857":72170,"_21381":119740,"_5":14694,"_28049":119640,"_3044":119741},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3588":72208,"_30857":72170,"_21381":119743,"_5":14694,"_28049":119640,"_3044":119744},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3588":72209,"_30857":72170,"_21381":119746,"_5":14694,"_28049":119640,"_3044":119747},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3588":72210,"_30857":72170,"_21381":119749,"_5":14694,"_28049":119640,"_3044":119750},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3588":72211,"_30857":72170,"_21381":119752,"_5":14694,"_28049":119640,"_3044":119753},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3588":72212,"_30857":72170,"_21381":119755,"_5":14694,"_28049":119644,"_3044":119756},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3588":72213,"_30857":72170,"_21381":119758,"_5":14694,"_28049":119648,"_3044":119759},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3588":72214,"_30857":72170,"_21381":119761,"_5":14694,"_28049":119648,"_3044":119762},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3588":72215,"_30857":72170,"_21381":119764,"_5":14694,"_28049":119648,"_3044":119765},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3588":72216,"_30857":72170,"_21381":119767,"_5":14694,"_28049":119648,"_3044":119768},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3588":72217,"_30857":72170,"_21381":119770,"_5":14694,"_28049":119648,"_3044":119771},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3588":72218,"_30857":72170,"_21381":119773,"_5":14694,"_28049":119648,"_3044":119774},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3588":72219,"_30857":72170,"_21381":119776,"_5":14694,"_28049":119648,"_3044":119777},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3588":72220,"_30857":72170,"_21381":119779,"_5":14694,"_28049":119652,"_3044":119780},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3588":72221,"_30857":72170,"_21381":119782,"_5":14694,"_28049":119652,"_3044":119783},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3588":72222,"_30857":72170,"_21381":119785,"_5":14694,"_28049":119652,"_3044":119786},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3588":72223,"_30857":72170,"_21381":119788,"_5":14694,"_28049":119652,"_3044":119789},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3588":72224,"_30857":72170,"_21381":119791,"_5":14694,"_28049":119656,"_3044":119792},[],"Para instalar un checkout local:",{"_3588":72225,"_30857":72170,"_21381":119794,"_5":14694,"_28049":119660,"_3044":119795},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3588":72226,"_30857":72170,"_21381":119797,"_5":14694,"_28049":119660,"_3044":119798},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3588":72227,"_30857":72170,"_21381":119800,"_5":14694,"_28049":119664,"_3044":119801},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3588":72228,"_30857":72170,"_21381":119803,"_5":14694,"_28049":119664,"_3044":119804},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3588":72229,"_30857":72170,"_21381":119806,"_5":14694,"_28049":119664,"_3044":119807},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3588":72230,"_30857":72170,"_21381":119809,"_5":14694,"_28049":119664,"_3044":119810},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3588":72231,"_30857":72170,"_21381":119812,"_5":14694,"_28049":119664,"_3044":119813},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3588":72232,"_30857":72170,"_21381":119815,"_5":14694,"_28049":119668,"_3044":119816},[],"Antes de pasar a producción, revisa:",{"_3588":72233,"_30857":72170,"_21381":119818,"_5":14694,"_28049":119668,"_3044":119819},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3588":72234,"_30857":72170,"_21381":119821,"_5":14694,"_28049":119668,"_3044":119822},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3588":72235,"_30857":72170,"_21381":119824,"_5":14694,"_28049":119668,"_3044":119825},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3588":72236,"_30857":72170,"_21381":119827,"_5":14694,"_28049":119668,"_3044":119828},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3588":72237,"_30857":72170,"_21381":119830,"_5":14694,"_28049":119668,"_3044":119831},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3588":72238,"_30857":72170,"_21381":119833,"_5":14694,"_28049":119668,"_3044":119834},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3588":72239,"_30857":72170,"_21381":119836,"_5":14694,"_28049":119668,"_3044":119837},[],"SMTP, observabilidad y entrega de alertas",{"_3588":72240,"_30857":72170,"_21381":119839,"_5":14694,"_28049":119668,"_3044":119840},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3588":72241,"_30857":72170,"_21381":119842,"_5":14694,"_28049":119668,"_3044":119843},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3588":72242,"_30857":72242,"_5":15054,"_3044":119845,"_31195":119846,"_21381":119847,"_28049":72242},"Expón el Gateway",[50417,119037,119271],[],{"_3588":72243,"_30857":72242,"_21381":119849,"_5":14694,"_28049":72242,"_3044":119850},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3588":72244,"_30857":72242,"_5":31192,"_21381":119852,"_28049":119853,"_3044":119854},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3588":72245,"_30857":72242,"_5":31192,"_21381":119856,"_28049":119857,"_3044":119858},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3588":72246,"_30857":72242,"_5":31192,"_21381":119860,"_28049":119861,"_3044":119862},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3588":72247,"_30857":72242,"_5":31192,"_21381":119864,"_28049":119865,"_3044":51280},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3588":72248,"_30857":72242,"_5":31192,"_21381":119867,"_28049":119868,"_3044":119869},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3588":72249,"_30857":72242,"_5":31192,"_21381":119871,"_28049":119872,"_3044":119873},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3588":72250,"_30857":72242,"_5":31192,"_21381":119875,"_28049":119876,"_3044":119877},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3588":72251,"_30857":72242,"_5":31192,"_21381":119879,"_28049":119880,"_3044":119881},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3588":72252,"_30857":72242,"_5":31192,"_21381":119883,"_28049":119884,"_3044":119885},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3588":72253,"_30857":72242,"_5":31192,"_21381":119887,"_28049":119888,"_3044":119889},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3588":72254,"_30857":72242,"_5":31192,"_21381":119891,"_28049":119892,"_3044":119893},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3588":72255,"_30857":72242,"_21381":119895,"_5":14694,"_28049":119853,"_3044":119896},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3588":72256,"_30857":72242,"_21381":119898,"_5":14694,"_28049":119853,"_3044":119899},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3588":72257,"_30857":72242,"_21381":119901,"_5":14694,"_28049":119857,"_3044":119902},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3588":72258,"_30857":72242,"_21381":119904,"_5":14694,"_28049":119857,"_3044":119905},[],"Defínelo únicamente cuando:",{"_3588":72259,"_30857":72242,"_21381":119907,"_5":14694,"_28049":119857,"_3044":119908},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3588":72260,"_30857":72242,"_21381":119910,"_5":14694,"_28049":119857,"_3044":119911},[],"esa dirección está asignada a este Gateway",{"_3588":72261,"_30857":72242,"_21381":119913,"_5":14694,"_28049":119857,"_3044":119914},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3588":72262,"_30857":72242,"_21381":119916,"_5":14694,"_28049":119857,"_3044":119917},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3588":72263,"_30857":72242,"_21381":119919,"_5":14694,"_28049":119857,"_3044":119920},[],"No confundas estos valores:",{"_3588":72264,"_30857":72242,"_21381":119922,"_5":14694,"_28049":119857,"_3044":119923},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3588":72265,"_30857":72242,"_21381":119925,"_5":14694,"_28049":119857,"_3044":119926},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3588":72266,"_30857":72242,"_21381":119928,"_5":14694,"_28049":119857,"_3044":119929},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3588":72267,"_30857":72242,"_21381":119931,"_5":14694,"_28049":119861,"_3044":119932},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3588":72268,"_30857":72242,"_21381":119934,"_5":14694,"_28049":119861,"_3044":119935},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3588":72269,"_30857":72242,"_21381":119937,"_5":14694,"_28049":119865,"_3044":119938},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3588":72270,"_30857":72242,"_21381":119940,"_5":14694,"_28049":119865,"_3044":119941},[],"Para el diseño recomendado:",{"_3588":72271,"_30857":72242,"_21381":119943,"_5":14694,"_28049":119865,"_3044":119944},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3588":72272,"_30857":72242,"_21381":119946,"_5":14694,"_28049":119865,"_3044":119947},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3588":72273,"_30857":72242,"_21381":119949,"_5":14694,"_28049":119865,"_3044":119950},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3588":72274,"_30857":72242,"_21381":119952,"_5":14694,"_28049":119865,"_3044":119953},[],"Apunta DNS a la dirección accesible de la VM.",{"_3588":72275,"_30857":72242,"_21381":119955,"_5":14694,"_28049":119865,"_3044":119956},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3588":72276,"_30857":72242,"_21381":119958,"_5":14694,"_28049":119868,"_3044":119959},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3588":72277,"_30857":72242,"_21381":119961,"_5":14694,"_28049":119872,"_3044":119962},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3588":72278,"_30857":72242,"_21381":119964,"_5":14694,"_28049":119872,"_3044":119965},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3588":72279,"_30857":72242,"_21381":119967,"_5":14694,"_28049":119876,"_3044":119968},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3588":72280,"_30857":72242,"_21381":119970,"_5":14694,"_28049":119876,"_3044":119971},[],"Requisito",{"_3588":72281,"_30857":72242,"_21381":119973,"_5":14694,"_28049":119876,"_3044":119974},[],"Diseño recomendado",{"_3588":72282,"_30857":72242,"_21381":119976,"_5":14694,"_28049":119876,"_3044":119977},[],"Consecuencia",{"_3588":72283,"_30857":72242,"_21381":119979,"_5":14694,"_28049":119876,"_3044":119980},[],"Varias URL o servicios de Lamassu",{"_3588":72284,"_30857":72242,"_21381":119982,"_5":14694,"_28049":119876,"_3044":119983},[],"Un Gateway con varias rutas",{"_3588":72285,"_30857":72242,"_21381":119985,"_5":14694,"_28049":119876,"_3044":119986},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3588":72286,"_30857":72242,"_21381":119988,"_5":14694,"_28049":119876,"_3044":119989},[],"Gateways independientes e IP externas distintas",{"_3588":72287,"_30857":72242,"_21381":119991,"_5":14694,"_28049":119876,"_3044":119992},[],"Una VIP por Gateway",{"_3588":72288,"_30857":72242,"_21381":119994,"_5":14694,"_28049":119876,"_3044":119995},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3588":72289,"_30857":72242,"_21381":119997,"_5":14694,"_28049":119876,"_3044":119998},[],"Gateways independientes, un nodo y una IP",{"_3588":72290,"_30857":72242,"_21381":120000,"_5":14694,"_28049":119876,"_3044":120001},[],"Puertos externos diferentes",{"_3588":72291,"_30857":72242,"_21381":120003,"_5":14694,"_28049":119876,"_3044":120004},[],"Los clientes deben indicar puertos no estándar",{"_3588":72292,"_30857":72242,"_21381":120006,"_5":14694,"_28049":119876,"_3044":120007},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3588":72293,"_30857":72242,"_21381":120009,"_5":14694,"_28049":119876,"_3044":120010},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3588":72294,"_30857":72242,"_21381":120012,"_5":14694,"_28049":119876,"_3044":120013},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3588":72295,"_30857":72242,"_21381":120015,"_5":14694,"_28049":119876,"_3044":120016},[],"Recursos Gateway separados pero proxy compartido",{"_3588":72296,"_30857":72242,"_21381":120018,"_5":14694,"_28049":119876,"_3044":120019},[],"Modo merged Gateway de Envoy",{"_3588":72297,"_30857":72242,"_21381":120021,"_5":14694,"_28049":119876,"_3044":120022},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3588":72298,"_30857":72242,"_21381":120024,"_5":14694,"_28049":119876,"_3044":120025},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3588":72299,"_30857":72242,"_21381":120027,"_5":14694,"_28049":119876,"_3044":120028},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3588":72300,"_30857":72242,"_21381":120030,"_5":14694,"_28049":119876,"_3044":120031},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3588":72301,"_30857":72242,"_21381":120033,"_5":14694,"_28049":119876,"_3044":120034},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3588":72302,"_30857":72242,"_21381":120036,"_5":14694,"_28049":119880,"_3044":120037},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3588":72303,"_30857":72242,"_21381":120039,"_5":14694,"_28049":119884,"_3044":120040},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3588":72304,"_30857":72242,"_21381":120042,"_5":14694,"_28049":119884,"_3044":120043},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3588":72305,"_30857":72242,"_21381":120045,"_5":14694,"_28049":119884,"_3044":120046},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3588":72306,"_30857":72242,"_21381":120048,"_5":14694,"_28049":119884,"_3044":120049},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3588":72307,"_30857":72242,"_21381":120051,"_5":14694,"_28049":119884,"_3044":120052},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3588":72308,"_30857":72242,"_21381":120054,"_5":14694,"_28049":119888,"_3044":120055},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3588":72309,"_30857":72242,"_21381":120057,"_5":14694,"_28049":119888,"_3044":120058},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3588":72310,"_30857":72242,"_21381":120060,"_5":14694,"_28049":119892,"_3044":120061},[],"Comprueba, en orden:",{"_3588":72311,"_30857":72242,"_21381":120063,"_5":14694,"_28049":119892,"_3044":120064},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3588":72312,"_30857":72242,"_21381":120066,"_5":14694,"_28049":119892,"_3044":120067},[],"Su estado contiene la dirección esperada.",{"_3588":72313,"_30857":72242,"_21381":120069,"_5":14694,"_28049":119892,"_3044":120070},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3588":72314,"_30857":72242,"_21381":120072,"_5":14694,"_28049":119892,"_3044":120073},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3588":72315,"_30857":72242,"_21381":120075,"_5":14694,"_28049":119892,"_3044":120076},[],"DNS resuelve al endpoint accesible externamente.",{"_3588":72316,"_30857":72242,"_21381":120078,"_5":14694,"_28049":119892,"_3044":120079},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3588":72317,"_30857":72242,"_21381":120081,"_5":14694,"_28049":119892,"_3044":120082},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3588":72318,"_30857":72318,"_5":15054,"_3044":50524,"_31195":120084,"_21381":120085,"_28049":72318},[50417,119037,119271],[],{"_3588":72319,"_30857":72318,"_21381":120087,"_5":14694,"_28049":72318,"_3044":120088},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3588":72320,"_30857":72318,"_5":31192,"_21381":120090,"_28049":120091,"_3044":120092},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3588":72321,"_30857":72318,"_5":31192,"_21381":120094,"_28049":120095,"_3044":120096},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3588":72322,"_30857":72318,"_5":31192,"_21381":120098,"_28049":120099,"_3044":120100},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3588":72323,"_30857":72318,"_5":31192,"_21381":120102,"_28049":120103,"_3044":120104},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3588":72324,"_30857":72318,"_5":31192,"_21381":120106,"_28049":120107,"_3044":120108},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3588":72325,"_30857":72318,"_5":31192,"_21381":120110,"_28049":120111,"_3044":120112},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3588":72326,"_30857":72318,"_21381":120114,"_5":14694,"_28049":120091,"_3044":120115},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3588":72327,"_30857":72318,"_21381":120117,"_5":14694,"_28049":120095,"_3044":120118},[],"Flujo",{"_3588":72328,"_30857":72318,"_21381":120120,"_5":14694,"_28049":120095,"_3044":120121},[],"Úsalo para",{"_3588":72329,"_30857":72318,"_21381":120123,"_5":14694,"_28049":120095,"_3044":120124},[],"Qué instala",{"_3588":72330,"_30857":72318,"_21381":120126,"_5":14694,"_28049":120095,"_3044":51542},[],{"_3588":72331,"_30857":72318,"_21381":120128,"_5":14694,"_28049":120095,"_3044":120129},[],"Producción y entornos controlados",{"_3588":72332,"_30857":72318,"_21381":120131,"_5":14694,"_28049":120095,"_3044":120132},[],"Servicios de Lamassu y recursos de Gateway API",{"_3588":72333,"_30857":72318,"_21381":120134,"_5":14694,"_28049":120095,"_3044":50661},[],{"_3588":72334,"_30857":72318,"_21381":120136,"_5":14694,"_28049":120095,"_3044":120137},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3588":72335,"_30857":72318,"_21381":120139,"_5":14694,"_28049":120095,"_3044":120140},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3588":72336,"_30857":72318,"_21381":120142,"_5":14694,"_28049":120099,"_3044":120143},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3588":72337,"_30857":72318,"_21381":120145,"_5":14694,"_28049":120099,"_3044":120146},[],"Área",{"_3588":72338,"_30857":72318,"_21381":120148,"_5":14694,"_28049":120099,"_3044":120149},[],"El chart de Lamassu proporciona",{"_3588":72339,"_30857":72318,"_21381":120151,"_5":14694,"_28049":120099,"_3044":120152},[],"Tú proporcionas",{"_3588":72340,"_30857":72318,"_21381":120154,"_5":14694,"_28049":120099,"_3044":120155},[],"Aplicaciones Lamassu",{"_3588":72341,"_30857":72318,"_21381":120157,"_5":14694,"_28049":120099,"_3044":120158},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3588":72342,"_30857":72318,"_21381":120160,"_5":14694,"_28049":120099,"_3044":120161},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3588":72343,"_30857":72318,"_21381":120163,"_5":14694,"_28049":120099,"_3044":120164},[],"Datos PostgreSQL",{"_3588":72344,"_30857":72318,"_21381":120166,"_5":14694,"_28049":120099,"_3044":120167},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3588":72345,"_30857":72318,"_21381":120169,"_5":14694,"_28049":120099,"_3044":120170},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3588":72346,"_30857":72318,"_21381":120172,"_5":14694,"_28049":120099,"_3044":120173},[],"Mensajería",{"_3588":72347,"_30857":72318,"_21381":120175,"_5":14694,"_28049":120099,"_3044":120176},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3588":72348,"_30857":72318,"_21381":120178,"_5":14694,"_28049":120099,"_3044":120179},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3588":72349,"_30857":72318,"_21381":120181,"_5":14694,"_28049":120099,"_3044":120182},[],"Identidad",{"_3588":72350,"_30857":72318,"_21381":120184,"_5":14694,"_28049":120099,"_3044":120185},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3588":72351,"_30857":72318,"_21381":120187,"_5":14694,"_28049":120099,"_3044":120188},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3588":72352,"_30857":72318,"_21381":120190,"_5":14694,"_28049":120099,"_3044":120191},[],"Enrutamiento externo",{"_3588":72353,"_30857":72318,"_21381":120193,"_5":14694,"_28049":120099,"_3044":120194},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3588":72354,"_30857":72318,"_21381":120196,"_5":14694,"_28049":120099,"_3044":120197},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3588":72355,"_30857":72318,"_21381":120199,"_5":14694,"_28049":120099,"_3044":51616},[],{"_3588":72356,"_30857":72318,"_21381":120201,"_5":14694,"_28049":120099,"_3044":120202},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3588":72357,"_30857":72318,"_21381":120204,"_5":14694,"_28049":120099,"_3044":120205},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3588":72358,"_30857":72318,"_21381":120207,"_5":14694,"_28049":120099,"_3044":120208},[],"Datos persistentes de la aplicación",{"_3588":72359,"_30857":72318,"_21381":120210,"_5":14694,"_28049":120099,"_3044":120211},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3588":72360,"_30857":72318,"_21381":120213,"_5":14694,"_28049":120099,"_3044":120214},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3588":72361,"_30857":72318,"_21381":120216,"_5":14694,"_28049":120099,"_3044":120217},[],"Integraciones opcionales",{"_3588":72362,"_30857":72318,"_21381":120219,"_5":14694,"_28049":120099,"_3044":120220},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3588":72363,"_30857":72318,"_21381":120222,"_5":14694,"_28049":120099,"_3044":120223},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3588":72364,"_30857":72318,"_21381":120225,"_5":14694,"_28049":120099,"_3044":120226},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3588":72365,"_30857":72318,"_21381":120228,"_5":14694,"_28049":120099,"_3044":120229},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3588":72366,"_30857":72318,"_21381":120231,"_5":14694,"_28049":120103,"_3044":120232},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3588":72367,"_30857":72318,"_21381":120234,"_5":14694,"_28049":120103,"_3044":120235},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3588":72368,"_30857":72318,"_21381":120237,"_5":14694,"_28049":120107,"_3044":120238},[],"Kubernetes 1.24 o posterior",{"_3588":72369,"_30857":72318,"_21381":120240,"_5":14694,"_28049":120107,"_3044":120241},[],"Helm 3.2 o posterior",{"_3588":72370,"_30857":72318,"_21381":120243,"_5":14694,"_28049":120107,"_3044":120244},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3588":72371,"_30857":72318,"_21381":120246,"_5":14694,"_28049":120107,"_3044":120247},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3588":72372,"_30857":72318,"_21381":120249,"_5":14694,"_28049":120107,"_3044":120250},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3588":72373,"_30857":72318,"_21381":120252,"_5":14694,"_28049":120107,"_3044":120253},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3588":72374,"_30857":72318,"_21381":120255,"_5":14694,"_28049":120107,"_3044":120256},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3588":72375,"_30857":72318,"_21381":120258,"_5":14694,"_28049":120111,"_3044":120259},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3588":72376,"_30857":72318,"_21381":120261,"_5":14694,"_28049":120111,"_3044":120262},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3588":72377,"_30857":72318,"_21381":120264,"_5":14694,"_28049":120111,"_3044":120265},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3588":72378,"_30857":72318,"_21381":120267,"_5":14694,"_28049":120111,"_3044":120268},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3588":72379,"_30857":72379,"_5":15054,"_3044":120270,"_31195":120271,"_21381":120273,"_28049":72379},"Resolución de problemas de despliegue",[50417,119037,120272],"Operación",[],{"_3588":72380,"_30857":72379,"_21381":120275,"_5":14694,"_28049":72379,"_3044":120276},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3588":72381,"_30857":72379,"_5":31192,"_21381":120278,"_28049":120279,"_3044":120280},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3588":72382,"_30857":72379,"_5":31192,"_21381":120282,"_28049":120283,"_3044":120284},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3588":72383,"_30857":72379,"_5":31192,"_21381":120286,"_28049":120287,"_3044":120288},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3588":72384,"_30857":72379,"_5":31192,"_21381":120290,"_28049":120291,"_3044":120292},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3588":72385,"_30857":72379,"_5":31192,"_21381":120294,"_28049":120295,"_3044":120296},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3588":72386,"_30857":72379,"_5":31192,"_21381":120298,"_28049":120299,"_3044":120300},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3588":72387,"_30857":72379,"_5":31192,"_21381":120302,"_28049":120303,"_3044":120304},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3588":72388,"_30857":72379,"_5":31192,"_21381":120306,"_28049":120307,"_3044":120308},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3588":72389,"_30857":72379,"_5":31192,"_21381":120310,"_28049":120311,"_3044":120312},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3588":72390,"_30857":72379,"_5":31192,"_21381":120314,"_28049":120315,"_3044":120316},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3588":72391,"_30857":72379,"_5":31192,"_21381":120318,"_28049":120319,"_3044":120320},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3588":72392,"_30857":72379,"_5":31192,"_21381":120322,"_28049":120323,"_3044":120324},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3588":72393,"_30857":72379,"_5":31192,"_21381":120326,"_28049":120327,"_3044":120328},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3588":72394,"_30857":72379,"_21381":120330,"_5":14694,"_28049":72379,"_3044":120331},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3588":72395,"_30857":72379,"_21381":120333,"_5":14694,"_28049":120283,"_3044":120334},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3588":72396,"_30857":72379,"_21381":120336,"_5":14694,"_28049":120287,"_3044":120337},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3588":72397,"_30857":72379,"_21381":120339,"_5":14694,"_28049":120291,"_3044":120340},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3588":72398,"_30857":72379,"_21381":120342,"_5":14694,"_28049":120295,"_3044":120343},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3588":72399,"_30857":72379,"_21381":120345,"_5":14694,"_28049":120299,"_3044":120346},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3588":72400,"_30857":72379,"_21381":120348,"_5":14694,"_28049":120303,"_3044":120349},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3588":72401,"_30857":72379,"_21381":120351,"_5":14694,"_28049":120303,"_3044":120352},[],"Ejecuta también la prueba de conectividad del chart:",{"_3588":72402,"_30857":72379,"_21381":120354,"_5":14694,"_28049":120303,"_3044":120355},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3588":72403,"_30857":72379,"_21381":120357,"_5":14694,"_28049":120303,"_3044":120358},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3588":72404,"_30857":72379,"_21381":120360,"_5":14694,"_28049":120307,"_3044":120361},[],"Si recibes un 401:",{"_3588":72405,"_30857":72379,"_21381":120363,"_5":14694,"_28049":120307,"_3044":120364},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3588":72406,"_30857":72379,"_21381":120366,"_5":14694,"_28049":120307,"_3044":120367},[],"verifica emisor, audiencia y expiración del token;",{"_3588":72407,"_30857":72379,"_21381":120369,"_5":14694,"_28049":120307,"_3044":120370},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3588":72408,"_30857":72379,"_21381":120372,"_5":14694,"_28049":120307,"_3044":120373},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3588":72409,"_30857":72379,"_21381":120375,"_5":14694,"_28049":120307,"_3044":120376},[],"Si el login termina pero las APIs devuelven 403:",{"_3588":72410,"_30857":72379,"_21381":120378,"_5":14694,"_28049":120307,"_3044":120379},[],"inspecciona los claims reales del token;",{"_3588":72411,"_30857":72379,"_21381":120381,"_5":14694,"_28049":120307,"_3044":120382},[],"confirma que coinciden con un principal activo;",{"_3588":72412,"_30857":72379,"_21381":120384,"_5":14694,"_28049":120307,"_3044":120385},[],"revisa las políticas concedidas al principal;",{"_3588":72413,"_30857":72379,"_21381":120387,"_5":14694,"_28049":120307,"_3044":120388},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3588":72414,"_30857":72379,"_21381":120390,"_5":14694,"_28049":120307,"_3044":120391},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3588":72415,"_30857":72379,"_21381":120393,"_5":14694,"_28049":120311,"_3044":120394},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3588":72416,"_30857":72379,"_21381":120396,"_5":14694,"_28049":120311,"_3044":120397},[],"Localiza el pod y Service de authz.",{"_3588":72417,"_30857":72379,"_21381":120399,"_5":14694,"_28049":120311,"_3044":120400},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3588":72418,"_30857":72379,"_21381":120402,"_5":14694,"_28049":120311,"_3044":120403},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3588":72419,"_30857":72379,"_21381":120405,"_5":14694,"_28049":120311,"_3044":120406},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3588":72420,"_30857":72379,"_21381":120408,"_5":14694,"_28049":120311,"_3044":120409},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3588":72421,"_30857":72379,"_21381":120411,"_5":14694,"_28049":120315,"_3044":120412},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3588":72422,"_30857":72379,"_21381":120414,"_5":14694,"_28049":120319,"_3044":120415},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3588":72423,"_30857":72379,"_21381":120417,"_5":14694,"_28049":120319,"_3044":120418},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3588":72424,"_30857":72379,"_21381":120420,"_5":14694,"_28049":120319,"_3044":120421},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3588":72425,"_30857":72379,"_21381":120423,"_5":14694,"_28049":120319,"_3044":120424},[],"volumen persistente sin enlazar;",{"_3588":72426,"_30857":72379,"_21381":120426,"_5":14694,"_28049":120319,"_3044":120427},[],"imagen inaccesible o política de pull incorrecta;",{"_3588":72427,"_30857":72379,"_21381":120429,"_5":14694,"_28049":120319,"_3044":120430},[],"configuración inválida del motor criptográfico;",{"_3588":72428,"_30857":72379,"_21381":120432,"_5":14694,"_28049":120319,"_3044":120433},[],"límites de CPU o memoria demasiado bajos;",{"_3588":72429,"_30857":72379,"_21381":120435,"_5":14694,"_28049":120319,"_3044":120436},[],"migración previa incompleta.",{"_3588":72430,"_30857":72379,"_21381":120438,"_5":14694,"_28049":120319,"_3044":120439},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3588":72431,"_30857":72379,"_21381":120441,"_5":14694,"_28049":120319,"_3044":120442},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3588":72432,"_30857":72379,"_21381":120444,"_5":14694,"_28049":120319,"_3044":120445},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3588":72433,"_30857":72379,"_21381":120447,"_5":14694,"_28049":120323,"_3044":120448},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3588":72434,"_30857":72379,"_21381":120450,"_5":14694,"_28049":120323,"_3044":120451},[],"verifica que esté habilitado en el servicio emisor;",{"_3588":72435,"_30857":72379,"_21381":120453,"_5":14694,"_28049":120323,"_3044":120454},[],"comprueba conectividad y credenciales AMQP;",{"_3588":72436,"_30857":72379,"_21381":120456,"_5":14694,"_28049":120323,"_3044":120457},[],"revisa exchange, routing key, colas y consumidores;",{"_3588":72437,"_30857":72379,"_21381":120459,"_5":14694,"_28049":120323,"_3044":120460},[],"inspecciona dead-letter queues;",{"_3588":72438,"_30857":72379,"_21381":120462,"_5":14694,"_28049":120323,"_3044":120463},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3588":72439,"_30857":72379,"_21381":120465,"_5":14694,"_28049":120323,"_3044":120466},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3588":72440,"_30857":72379,"_21381":120468,"_5":14694,"_28049":120323,"_3044":120469},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3588":72441,"_30857":72379,"_21381":120471,"_5":14694,"_28049":120323,"_3044":120472},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3588":72442,"_30857":72379,"_21381":120474,"_5":14694,"_28049":120323,"_3044":120475},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3588":72443,"_30857":72379,"_21381":120477,"_5":14694,"_28049":120323,"_3044":120478},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3588":72444,"_30857":72379,"_21381":120480,"_5":14694,"_28049":120323,"_3044":120481},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3588":72445,"_30857":72379,"_21381":120483,"_5":14694,"_28049":120323,"_3044":120484},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3588":72446,"_30857":72379,"_21381":120486,"_5":14694,"_28049":120327,"_3044":120487},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3588":72447,"_30857":72379,"_21381":120489,"_5":14694,"_28049":120327,"_3044":120490},[],"Antes de cerrar una incidencia, guarda:",{"_3588":72448,"_30857":72379,"_21381":120492,"_5":14694,"_28049":120327,"_3044":120493},[],"causa confirmada;",{"_3588":72449,"_30857":72379,"_21381":120495,"_5":14694,"_28049":120327,"_3044":120496},[],"alcance temporal y recursos afectados;",{"_3588":72450,"_30857":72379,"_21381":120498,"_5":14694,"_28049":120327,"_3044":120499},[],"comandos o consultas utilizados;",{"_3588":72451,"_30857":72379,"_21381":120501,"_5":14694,"_28049":120327,"_3044":120502},[],"cambio aplicado y forma de revertirlo;",{"_3588":72452,"_30857":72379,"_21381":120504,"_5":14694,"_28049":120327,"_3044":120505},[],"validación desde un consumidor;",{"_3588":72453,"_30857":72379,"_21381":120507,"_5":14694,"_28049":120327,"_3044":120508},[],"acción preventiva y propietario.",{"_3588":72454,"_30857":72454,"_5":15054,"_3044":120510,"_31195":120511,"_21381":120515,"_28049":72454},"Modelo de datos",[50417,120512,120513,120514],"Plataforma","Administración","Control de acceso",[],{"_3588":72455,"_30857":72454,"_21381":120517,"_5":14694,"_28049":72454,"_3044":120518},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3588":72456,"_30857":72454,"_5":31192,"_21381":120520,"_28049":120521,"_3044":120522},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3588":72457,"_30857":72454,"_5":31192,"_21381":120524,"_28049":120525,"_3044":120526},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3588":72458,"_30857":72454,"_21381":120528,"_5":14694,"_28049":72454,"_3044":120529},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3588":72459,"_30857":72454,"_21381":120531,"_5":14694,"_28049":120521,"_3044":120532},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3588":72460,"_30857":72454,"_21381":120534,"_5":14694,"_28049":120521,"_3044":120535},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3588":72461,"_30857":72454,"_21381":120537,"_5":14694,"_28049":120521,"_3044":120538},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3588":72462,"_30857":72454,"_21381":120540,"_5":14694,"_28049":120525,"_3044":120541},[],"Entidad (`schema_name.entity_type`)",{"_3588":72463,"_30857":72454,"_21381":120543,"_5":14694,"_28049":120525,"_3044":120544},[],"Tabla (`table_name`)",{"_3588":72464,"_30857":72454,"_21381":120546,"_5":14694,"_28049":120525,"_3044":120547},[],"Clave (`primary_key`)",{"_3588":72465,"_30857":72454,"_21381":120549,"_5":14694,"_28049":120525,"_3044":51967},[],{"_3588":72466,"_30857":72454,"_21381":120551,"_5":14694,"_28049":120525,"_3044":51970},[],{"_3588":72467,"_30857":72454,"_21381":120553,"_5":14694,"_28049":120525,"_3044":51973},[],{"_3588":72468,"_30857":72454,"_21381":120555,"_5":14694,"_28049":120525,"_3044":51976},[],{"_3588":72469,"_30857":72454,"_21381":120557,"_5":14694,"_28049":120525,"_3044":51979},[],{"_3588":72470,"_30857":72454,"_21381":120559,"_5":14694,"_28049":120525,"_3044":51982},[],{"_3588":72471,"_30857":72454,"_21381":120561,"_5":14694,"_28049":120525,"_3044":51985},[],{"_3588":72472,"_30857":72454,"_21381":120563,"_5":14694,"_28049":120525,"_3044":51988},[],{"_3588":72473,"_30857":72454,"_21381":120565,"_5":14694,"_28049":120525,"_3044":51982},[],{"_3588":72474,"_30857":72454,"_21381":120567,"_5":14694,"_28049":120525,"_3044":51993},[],{"_3588":72475,"_30857":72454,"_21381":120569,"_5":14694,"_28049":120525,"_3044":51996},[],{"_3588":72476,"_30857":72454,"_21381":120571,"_5":14694,"_28049":120525,"_3044":51999},[],{"_3588":72477,"_30857":72454,"_21381":120573,"_5":14694,"_28049":120525,"_3044":52002},[],{"_3588":72478,"_30857":72454,"_21381":120575,"_5":14694,"_28049":120525,"_3044":52005},[],{"_3588":72479,"_30857":72454,"_21381":120577,"_5":14694,"_28049":120525,"_3044":51982},[],{"_3588":72480,"_30857":72454,"_21381":120579,"_5":14694,"_28049":120525,"_3044":52010},[],{"_3588":72481,"_30857":72454,"_21381":120581,"_5":14694,"_28049":120525,"_3044":52013},[],{"_3588":72482,"_30857":72454,"_21381":120583,"_5":14694,"_28049":120525,"_3044":51982},[],{"_3588":72483,"_30857":72454,"_21381":120585,"_5":14694,"_28049":120525,"_3044":52018},[],{"_3588":72484,"_30857":72454,"_21381":120587,"_5":14694,"_28049":120525,"_3044":52021},[],{"_3588":72485,"_30857":72454,"_21381":120589,"_5":14694,"_28049":120525,"_3044":51982},[],{"_3588":72486,"_30857":72454,"_21381":120591,"_5":14694,"_28049":120525,"_3044":52026},[],{"_3588":72487,"_30857":72454,"_21381":120593,"_5":14694,"_28049":120525,"_3044":52029},[],{"_3588":72488,"_30857":72454,"_21381":120595,"_5":14694,"_28049":120525,"_3044":51982},[],{"_3588":72489,"_30857":72454,"_21381":120597,"_5":14694,"_28049":120525,"_3044":52034},[],{"_3588":72490,"_30857":72454,"_21381":120599,"_5":14694,"_28049":120525,"_3044":52037},[],{"_3588":72491,"_30857":72454,"_21381":120601,"_5":14694,"_28049":120525,"_3044":52040},[],{"_3588":72492,"_30857":72454,"_21381":120603,"_5":14694,"_28049":120525,"_3044":52043},[],{"_3588":72493,"_30857":72454,"_21381":120605,"_5":14694,"_28049":120525,"_3044":52046},[],{"_3588":72494,"_30857":72454,"_21381":120607,"_5":14694,"_28049":120525,"_3044":52049},[],{"_3588":72495,"_30857":72454,"_21381":120609,"_5":14694,"_28049":120525,"_3044":120610},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3588":72496,"_30857":72454,"_21381":120612,"_5":14694,"_28049":120525,"_3044":120613},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3588":72497,"_30857":72454,"_21381":120615,"_5":14694,"_28049":120525,"_3044":120616},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3588":72498,"_30857":72498,"_5":15054,"_3044":120618,"_31195":120619,"_21381":120620,"_28049":72498},"Visión general del control de acceso",[50417,120512,120513,120514],[],{"_3588":72499,"_30857":72498,"_21381":120622,"_5":14694,"_28049":72498,"_3044":120623},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3588":72500,"_30857":72498,"_5":31192,"_21381":120625,"_28049":120626,"_3044":120627},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3588":72501,"_30857":72498,"_5":31192,"_21381":120629,"_28049":120630,"_3044":120631},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3588":72502,"_30857":72498,"_5":31192,"_21381":120633,"_28049":120634,"_3044":120635},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3588":72503,"_30857":72498,"_5":31192,"_21381":120637,"_28049":120638,"_3044":120639},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3588":72504,"_30857":72498,"_5":31192,"_21381":120641,"_28049":120642,"_3044":120643},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3588":72505,"_30857":72498,"_5":31192,"_21381":120645,"_28049":120646,"_3044":120647},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3588":72506,"_30857":72498,"_5":31192,"_21381":120649,"_28049":120650,"_3044":120651},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3588":72507,"_30857":72498,"_5":31192,"_21381":120653,"_28049":120654,"_3044":120655},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3588":72508,"_30857":72498,"_5":31192,"_21381":120657,"_28049":120658,"_3044":120659},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3588":72509,"_30857":72498,"_5":31192,"_21381":120661,"_28049":120662,"_3044":120663},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3588":72510,"_30857":72498,"_5":31192,"_21381":120665,"_28049":120666,"_3044":120667},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3588":72511,"_30857":72498,"_5":31192,"_21381":120669,"_28049":120670,"_3044":120671},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3588":72512,"_30857":72498,"_5":31192,"_21381":120673,"_28049":120674,"_3044":120675},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3588":72513,"_30857":72498,"_5":31192,"_21381":120677,"_28049":120678,"_3044":120679},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3588":72514,"_30857":72498,"_5":31192,"_21381":120681,"_28049":120682,"_3044":120683},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3588":72515,"_30857":72498,"_5":31192,"_21381":120685,"_28049":120686,"_3044":119653},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3588":72516,"_30857":72498,"_5":31192,"_21381":120688,"_28049":120689,"_3044":120690},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3588":72517,"_30857":72498,"_5":31192,"_21381":120692,"_28049":120693,"_3044":120694},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3588":72518,"_30857":72498,"_5":31192,"_21381":120696,"_28049":120697,"_3044":120698},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3588":72519,"_30857":72498,"_5":31192,"_21381":120700,"_28049":120701,"_3044":120702},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3588":72520,"_30857":72498,"_5":31192,"_21381":120704,"_28049":120705,"_3044":120706},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3588":72521,"_30857":72498,"_5":31192,"_21381":120708,"_28049":120709,"_3044":120710},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3588":72522,"_30857":72498,"_5":31192,"_21381":120712,"_28049":120713,"_3044":120714},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3588":72523,"_30857":72498,"_5":31192,"_21381":120716,"_28049":120717,"_3044":120718},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3588":72524,"_30857":72498,"_5":31192,"_21381":120720,"_28049":120721,"_3044":120722},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3588":72525,"_30857":72498,"_5":31192,"_21381":120724,"_28049":120725,"_3044":120726},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3588":72526,"_30857":72498,"_5":31192,"_21381":120728,"_28049":120729,"_3044":120730},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3588":72527,"_30857":72498,"_5":31192,"_21381":120732,"_28049":120733,"_3044":120734},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3588":72528,"_30857":72498,"_5":31192,"_21381":120736,"_28049":120737,"_3044":120738},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3588":72529,"_30857":72498,"_5":31192,"_21381":120740,"_28049":120741,"_3044":120742},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3588":72530,"_30857":72498,"_5":31192,"_21381":120744,"_28049":120745,"_3044":120746},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3588":72531,"_30857":72498,"_21381":120748,"_5":14694,"_28049":72498,"_3044":120749},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3588":72532,"_30857":72498,"_21381":120751,"_5":14694,"_28049":72498,"_3044":120752},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3588":72533,"_30857":72498,"_21381":120754,"_5":14694,"_28049":72498,"_3044":120755},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3588":72534,"_30857":72498,"_21381":120757,"_5":14694,"_28049":120626,"_3044":120758},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3588":72535,"_30857":72498,"_21381":120760,"_5":14694,"_28049":120626,"_3044":120761},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3588":72536,"_30857":72498,"_21381":120763,"_5":14694,"_28049":120626,"_3044":120764},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3588":72537,"_30857":72498,"_21381":120766,"_5":14694,"_28049":120626,"_3044":120767},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3588":72538,"_30857":72498,"_21381":120769,"_5":14694,"_28049":120626,"_3044":120770},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3588":72539,"_30857":72498,"_21381":120772,"_5":14694,"_28049":120626,"_3044":120773},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3588":72540,"_30857":72498,"_21381":120775,"_5":14694,"_28049":120630,"_3044":120776},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3588":72541,"_30857":72498,"_21381":120778,"_5":14694,"_28049":120630,"_3044":120779},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3588":72542,"_30857":72498,"_21381":120781,"_5":14694,"_28049":120634,"_3044":120782},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3588":72543,"_30857":72498,"_21381":120784,"_5":14694,"_28049":120634,"_3044":120785},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3588":72544,"_30857":72498,"_21381":120787,"_5":14694,"_28049":120634,"_3044":120788},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3588":72545,"_30857":72498,"_21381":120790,"_5":14694,"_28049":120634,"_3044":120791},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3588":72546,"_30857":72498,"_21381":120793,"_5":14694,"_28049":120634,"_3044":120794},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3588":72547,"_30857":72498,"_21381":120796,"_5":14694,"_28049":120634,"_3044":120797},[],"Carga por separado las políticas concedidas a cada principal.",{"_3588":72548,"_30857":72498,"_21381":120799,"_5":14694,"_28049":120634,"_3044":120800},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3588":72549,"_30857":72498,"_21381":120802,"_5":14694,"_28049":120634,"_3044":120803},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3588":72550,"_30857":72498,"_21381":120805,"_5":14694,"_28049":120634,"_3044":120806},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3588":72551,"_30857":72498,"_21381":120808,"_5":14694,"_28049":120634,"_3044":120809},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3588":72552,"_30857":72498,"_21381":120811,"_5":14694,"_28049":120634,"_3044":120812},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3588":72553,"_30857":72498,"_21381":120814,"_5":14694,"_28049":120634,"_3044":120815},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3588":72554,"_30857":72498,"_21381":120817,"_5":14694,"_28049":120638,"_3044":120818},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3588":72555,"_30857":72498,"_21381":120820,"_5":14694,"_28049":120638,"_3044":120821},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3588":72556,"_30857":72498,"_21381":120823,"_5":14694,"_28049":120638,"_3044":120824},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3588":72557,"_30857":72498,"_21381":120826,"_5":14694,"_28049":120638,"_3044":120827},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3588":72558,"_30857":72498,"_21381":120829,"_5":14694,"_28049":120638,"_3044":120830},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3588":72559,"_30857":72498,"_21381":120832,"_5":14694,"_28049":120638,"_3044":120833},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3588":72560,"_30857":72498,"_21381":120835,"_5":14694,"_28049":120638,"_3044":120836},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3588":72561,"_30857":72498,"_21381":120838,"_5":14694,"_28049":120638,"_3044":120839},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3588":72562,"_30857":72498,"_21381":120841,"_5":14694,"_28049":120642,"_3044":120842},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3588":72563,"_30857":72498,"_21381":120844,"_5":14694,"_28049":120642,"_3044":120845},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3588":72564,"_30857":72498,"_21381":120847,"_5":14694,"_28049":120642,"_3044":120848},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3588":72565,"_30857":72498,"_21381":120850,"_5":14694,"_28049":120642,"_3044":120851},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3588":72566,"_30857":72498,"_21381":120853,"_5":14694,"_28049":120642,"_3044":120854},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3588":72567,"_30857":72498,"_21381":120856,"_5":14694,"_28049":120642,"_3044":120857},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3588":72568,"_30857":72498,"_21381":120859,"_5":14694,"_28049":120642,"_3044":120860},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3588":72569,"_30857":72498,"_21381":120862,"_5":14694,"_28049":120642,"_3044":120863},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3588":72570,"_30857":72498,"_21381":120865,"_5":14694,"_28049":120642,"_3044":120866},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3588":72571,"_30857":72498,"_21381":120868,"_5":14694,"_28049":120642,"_3044":120869},[],"Las acciones se dividen en dos grupos:",{"_3588":72572,"_30857":72498,"_21381":120871,"_5":14694,"_28049":120642,"_3044":120872},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3588":72573,"_30857":72498,"_21381":120874,"_5":14694,"_28049":120642,"_3044":120875},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3588":72574,"_30857":72498,"_21381":120877,"_5":14694,"_28049":120642,"_3044":120878},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3588":72575,"_30857":72498,"_21381":120880,"_5":14694,"_28049":120646,"_3044":120881},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3588":72576,"_30857":72498,"_21381":120883,"_5":14694,"_28049":120646,"_3044":120884},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3588":72577,"_30857":72498,"_21381":120886,"_5":14694,"_28049":120646,"_3044":120887},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3588":72578,"_30857":72498,"_21381":120889,"_5":14694,"_28049":120650,"_3044":120890},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3588":72579,"_30857":72498,"_21381":120892,"_5":14694,"_28049":120650,"_3044":120893},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3588":72580,"_30857":72498,"_21381":120895,"_5":14694,"_28049":120650,"_3044":120896},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3588":72581,"_30857":72498,"_21381":120898,"_5":14694,"_28049":120650,"_3044":120899},[],"Los operadores implementados son:",{"_3588":72582,"_30857":72498,"_21381":120901,"_5":14694,"_28049":120650,"_3044":120902},[],"`equals`, para igualdad exacta;",{"_3588":72583,"_30857":72498,"_21381":120904,"_5":14694,"_28049":120650,"_3044":120905},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3588":72584,"_30857":72498,"_21381":120907,"_5":14694,"_28049":120650,"_3044":120908},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3588":72585,"_30857":72498,"_21381":120910,"_5":14694,"_28049":120650,"_3044":120911},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3588":72586,"_30857":72498,"_21381":120913,"_5":14694,"_28049":120654,"_3044":120914},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3588":72587,"_30857":72498,"_21381":120916,"_5":14694,"_28049":120654,"_3044":120917},[],"Los modos disponibles son:",{"_3588":72588,"_30857":72498,"_21381":120919,"_5":14694,"_28049":120654,"_3044":120920},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3588":72589,"_30857":72498,"_21381":120922,"_5":14694,"_28049":120654,"_3044":120923},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3588":72590,"_30857":72498,"_21381":120925,"_5":14694,"_28049":120654,"_3044":120926},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3588":72591,"_30857":72498,"_21381":120928,"_5":14694,"_28049":120654,"_3044":120929},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3588":72592,"_30857":72498,"_21381":120931,"_5":14694,"_28049":120654,"_3044":120932},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3588":72593,"_30857":72498,"_21381":120934,"_5":14694,"_28049":120654,"_3044":120935},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3588":72594,"_30857":72498,"_21381":120937,"_5":14694,"_28049":120658,"_3044":120938},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3588":72595,"_30857":72498,"_21381":120940,"_5":14694,"_28049":120658,"_3044":120941},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3588":72596,"_30857":72498,"_21381":120943,"_5":14694,"_28049":120658,"_3044":120944},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3588":72597,"_30857":72498,"_21381":120946,"_5":14694,"_28049":120658,"_3044":120947},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3588":72598,"_30857":72498,"_21381":120949,"_5":14694,"_28049":120666,"_3044":120950},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3588":72599,"_30857":72498,"_21381":120952,"_5":14694,"_28049":120666,"_3044":120953},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3588":72600,"_30857":72498,"_21381":120955,"_5":14694,"_28049":120670,"_3044":120956},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3588":72601,"_30857":72498,"_21381":120958,"_5":14694,"_28049":120670,"_3044":120959},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3588":72602,"_30857":72498,"_21381":120961,"_5":14694,"_28049":120670,"_3044":120962},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3588":72603,"_30857":72498,"_21381":120964,"_5":14694,"_28049":120670,"_3044":120965},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3588":72604,"_30857":72498,"_21381":120967,"_5":14694,"_28049":120670,"_3044":120968},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3588":72605,"_30857":72498,"_21381":120970,"_5":14694,"_28049":120674,"_3044":120971},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3588":72606,"_30857":72498,"_21381":120973,"_5":14694,"_28049":120674,"_3044":120974},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3588":72607,"_30857":72498,"_21381":120976,"_5":14694,"_28049":120674,"_3044":120977},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3588":72608,"_30857":72498,"_21381":120979,"_5":14694,"_28049":120678,"_3044":120980},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3588":72609,"_30857":72498,"_21381":120982,"_5":14694,"_28049":120678,"_3044":120983},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3588":72610,"_30857":72498,"_21381":120985,"_5":14694,"_28049":120678,"_3044":120986},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3588":72611,"_30857":72498,"_21381":120988,"_5":14694,"_28049":120678,"_3044":120989},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3588":72612,"_30857":72498,"_21381":120991,"_5":14694,"_28049":120678,"_3044":120992},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3588":72613,"_30857":72498,"_21381":120994,"_5":14694,"_28049":120678,"_3044":120995},[],"Ten en cuenta que:",{"_3588":72614,"_30857":72498,"_21381":120997,"_5":14694,"_28049":120678,"_3044":120998},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3588":72615,"_30857":72498,"_21381":121000,"_5":14694,"_28049":120678,"_3044":121001},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3588":72616,"_30857":72498,"_21381":121003,"_5":14694,"_28049":120678,"_3044":121004},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3588":72617,"_30857":72498,"_21381":121006,"_5":14694,"_28049":120682,"_3044":121007},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3588":72618,"_30857":72498,"_21381":121009,"_5":14694,"_28049":120682,"_3044":121010},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3588":72619,"_30857":72498,"_21381":121012,"_5":14694,"_28049":120682,"_3044":121013},[],"acceso completo y de solo lectura a KMS;",{"_3588":72620,"_30857":72498,"_21381":121015,"_5":14694,"_28049":120682,"_3044":121016},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3588":72621,"_30857":72498,"_21381":121018,"_5":14694,"_28049":120682,"_3044":121019},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3588":72622,"_30857":72498,"_21381":121021,"_5":14694,"_28049":120682,"_3044":121022},[],"acceso a la interfaz;",{"_3588":72623,"_30857":72498,"_21381":121024,"_5":14694,"_28049":120682,"_3044":121025},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3588":72624,"_30857":72498,"_21381":121027,"_5":14694,"_28049":120682,"_3044":121028},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3588":72625,"_30857":72498,"_21381":121030,"_5":14694,"_28049":120682,"_3044":121031},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3588":72626,"_30857":72498,"_21381":121033,"_5":14694,"_28049":120686,"_3044":121034},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3588":72627,"_30857":72498,"_21381":121036,"_5":14694,"_28049":120686,"_3044":121037},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3588":72628,"_30857":72498,"_21381":121039,"_5":14694,"_28049":120686,"_3044":121040},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3588":72629,"_30857":72498,"_21381":121042,"_5":14694,"_28049":120689,"_3044":121043},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3588":72630,"_30857":72498,"_21381":121045,"_5":14694,"_28049":120693,"_3044":121046},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3588":72631,"_30857":72498,"_21381":121048,"_5":14694,"_28049":120693,"_3044":121049},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3588":72632,"_30857":72498,"_21381":121051,"_5":14694,"_28049":120697,"_3044":121052},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3588":72633,"_30857":72498,"_21381":121054,"_5":14694,"_28049":120701,"_3044":121055},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3588":72634,"_30857":72498,"_21381":121057,"_5":14694,"_28049":120705,"_3044":121058},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3588":72635,"_30857":72498,"_21381":121060,"_5":14694,"_28049":120709,"_3044":121061},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3588":72636,"_30857":72498,"_21381":121063,"_5":14694,"_28049":120709,"_3044":121064},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3588":72637,"_30857":72498,"_21381":121066,"_5":14694,"_28049":120713,"_3044":121067},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3588":72638,"_30857":72498,"_21381":121069,"_5":14694,"_28049":120713,"_3044":121070},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3588":72639,"_30857":72498,"_21381":121072,"_5":14694,"_28049":120713,"_3044":121073},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3588":72640,"_30857":72498,"_21381":121075,"_5":14694,"_28049":120713,"_3044":121076},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3588":72641,"_30857":72498,"_21381":121078,"_5":14694,"_28049":120713,"_3044":121079},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3588":72642,"_30857":72498,"_21381":121081,"_5":14694,"_28049":120713,"_3044":121082},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3588":72643,"_30857":72498,"_21381":121084,"_5":14694,"_28049":120713,"_3044":121085},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3588":72644,"_30857":72498,"_21381":121087,"_5":14694,"_28049":120713,"_3044":121088},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3588":72645,"_30857":72498,"_21381":121090,"_5":14694,"_28049":120717,"_3044":121091},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3588":72646,"_30857":72498,"_21381":121093,"_5":14694,"_28049":120717,"_3044":121094},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3588":72647,"_30857":72498,"_21381":121096,"_5":14694,"_28049":120717,"_3044":121097},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3588":72648,"_30857":72498,"_21381":121099,"_5":14694,"_28049":120721,"_3044":121100},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3588":72649,"_30857":72498,"_21381":121102,"_5":14694,"_28049":120721,"_3044":121103},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3588":72650,"_30857":72498,"_21381":121105,"_5":14694,"_28049":120721,"_3044":121106},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3588":72651,"_30857":72498,"_21381":121108,"_5":14694,"_28049":120721,"_3044":121109},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3588":72652,"_30857":72498,"_21381":121111,"_5":14694,"_28049":120721,"_3044":121112},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3588":72653,"_30857":72498,"_21381":121114,"_5":14694,"_28049":120721,"_3044":121115},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3588":72654,"_30857":72498,"_21381":121117,"_5":14694,"_28049":120721,"_3044":121118},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3588":72655,"_30857":72498,"_21381":121120,"_5":14694,"_28049":120721,"_3044":121121},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3588":72656,"_30857":72498,"_21381":121123,"_5":14694,"_28049":120729,"_3044":121124},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3588":72657,"_30857":72498,"_21381":121126,"_5":14694,"_28049":120733,"_3044":121127},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3588":72658,"_30857":72498,"_21381":121129,"_5":14694,"_28049":120733,"_3044":121130},[],"que exista un principal activo del tipo correcto;",{"_3588":72659,"_30857":72498,"_21381":121132,"_5":14694,"_28049":120733,"_3044":121133},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3588":72660,"_30857":72498,"_21381":121135,"_5":14694,"_28049":120733,"_3044":121136},[],"que todas las condiciones del principal se cumplan;",{"_3588":72661,"_30857":72498,"_21381":121138,"_5":14694,"_28049":120733,"_3044":121139},[],"que el principal tenga concedida la política esperada;",{"_3588":72662,"_30857":72498,"_21381":121141,"_5":14694,"_28049":120733,"_3044":121142},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3588":72663,"_30857":72498,"_21381":121144,"_5":14694,"_28049":120733,"_3044":121145},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3588":72664,"_30857":72498,"_21381":121147,"_5":14694,"_28049":120733,"_3044":121148},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3588":72665,"_30857":72498,"_21381":121150,"_5":14694,"_28049":120733,"_3044":121151},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3588":72666,"_30857":72498,"_21381":121153,"_5":14694,"_28049":120737,"_3044":121154},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3588":72667,"_30857":72498,"_21381":121156,"_5":14694,"_28049":120741,"_3044":121157},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3588":72668,"_30857":72498,"_21381":121159,"_5":14694,"_28049":120745,"_3044":121160},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3588":72669,"_30857":72498,"_21381":121162,"_5":14694,"_28049":120745,"_3044":121163},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3588":72670,"_30857":72670,"_5":15054,"_3044":121165,"_31195":121166,"_21381":121167,"_28049":72670},"Alertas y suscripciones",[50417,120512,120513],[],{"_3588":72671,"_30857":72670,"_21381":121169,"_5":14694,"_28049":72670,"_3044":121170},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3588":72672,"_30857":72670,"_5":31192,"_21381":121172,"_28049":121173,"_3044":121174},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3588":72673,"_30857":72670,"_5":31192,"_21381":121176,"_28049":121177,"_3044":121178},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3588":72674,"_30857":72670,"_5":31192,"_21381":121180,"_28049":121181,"_3044":121182},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3588":72675,"_30857":72670,"_5":31192,"_21381":121184,"_28049":121185,"_3044":121186},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3588":72676,"_30857":72670,"_5":31192,"_21381":121188,"_28049":121189,"_3044":121190},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3588":72677,"_30857":72670,"_5":31192,"_21381":121192,"_28049":121193,"_3044":121194},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3588":72678,"_30857":72670,"_5":31192,"_21381":121196,"_28049":121197,"_3044":121198},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3588":72679,"_30857":72670,"_5":31192,"_21381":121200,"_28049":121201,"_3044":121202},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3588":72680,"_30857":72670,"_5":31192,"_21381":121204,"_28049":121205,"_3044":121206},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3588":72681,"_30857":72670,"_5":31192,"_21381":121208,"_28049":121209,"_3044":121210},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3588":72682,"_30857":72670,"_5":31192,"_21381":121212,"_28049":121213,"_3044":121214},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3588":72683,"_30857":72670,"_21381":121216,"_5":14694,"_28049":72670,"_3044":121217},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3588":72684,"_30857":72670,"_21381":121219,"_5":14694,"_28049":121173,"_3044":121220},[],"Un servicio publica un evento de dominio.",{"_3588":72685,"_30857":72670,"_21381":121222,"_5":14694,"_28049":121173,"_3044":121223},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3588":72686,"_30857":72670,"_21381":121225,"_5":14694,"_28049":121173,"_3044":121226},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3588":72687,"_30857":72670,"_21381":121228,"_5":14694,"_28049":121173,"_3044":121229},[],"Lamassu entrega el evento al canal configurado.",{"_3588":72688,"_30857":72670,"_21381":121231,"_5":14694,"_28049":121173,"_3044":121232},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3588":72689,"_30857":72670,"_21381":121234,"_5":14694,"_28049":121177,"_3044":121235},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3588":72690,"_30857":72670,"_21381":121237,"_5":14694,"_28049":121177,"_3044":121238},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3588":72691,"_30857":72670,"_21381":121240,"_5":14694,"_28049":121177,"_3044":121241},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3588":72692,"_30857":72670,"_21381":121243,"_5":14694,"_28049":121177,"_3044":121244},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3588":72693,"_30857":72670,"_21381":121246,"_5":14694,"_28049":121177,"_3044":121247},[],"`apikey_options` necesita `header` y `key`.",{"_3588":72694,"_30857":72670,"_21381":121249,"_5":14694,"_28049":121177,"_3044":121250},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3588":72695,"_30857":72670,"_21381":121252,"_5":14694,"_28049":121177,"_3044":121253},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3588":72696,"_30857":72670,"_21381":121255,"_5":14694,"_28049":121177,"_3044":121256},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3588":72697,"_30857":72670,"_21381":121258,"_5":14694,"_28049":121185,"_3044":121259},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3588":72698,"_30857":72670,"_21381":121261,"_5":14694,"_28049":121189,"_3044":121262},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3588":72699,"_30857":72670,"_21381":121264,"_5":14694,"_28049":121193,"_3044":121265},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3588":72700,"_30857":72670,"_21381":121267,"_5":14694,"_28049":121193,"_3044":121268},[],"**None** notifica todas las instancias del evento.",{"_3588":72701,"_30857":72670,"_21381":121270,"_5":14694,"_28049":121193,"_3044":121271},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3588":72702,"_30857":72670,"_21381":121273,"_5":14694,"_28049":121193,"_3044":121274},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3588":72703,"_30857":72670,"_21381":121276,"_5":14694,"_28049":121193,"_3044":121277},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3588":72704,"_30857":72670,"_21381":121279,"_5":14694,"_28049":121193,"_3044":121280},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3588":72705,"_30857":72670,"_21381":121282,"_5":14694,"_28049":121193,"_3044":121283},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3588":72706,"_30857":72670,"_21381":121285,"_5":14694,"_28049":121197,"_3044":121286},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3588":72707,"_30857":72670,"_21381":121288,"_5":14694,"_28049":121201,"_3044":121289},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3588":72708,"_30857":72670,"_21381":121291,"_5":14694,"_28049":121201,"_3044":121292},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3588":72709,"_30857":72670,"_21381":121294,"_5":14694,"_28049":121201,"_3044":121295},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3588":72710,"_30857":72670,"_21381":121297,"_5":14694,"_28049":121201,"_3044":121298},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3588":72711,"_30857":72670,"_21381":121300,"_5":14694,"_28049":121201,"_3044":121301},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3588":72712,"_30857":72670,"_21381":121303,"_5":14694,"_28049":121201,"_3044":121304},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3588":72713,"_30857":72670,"_21381":121306,"_5":14694,"_28049":121201,"_3044":121307},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3588":72714,"_30857":72670,"_21381":121309,"_5":14694,"_28049":121201,"_3044":121310},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3588":72715,"_30857":72670,"_21381":121312,"_5":14694,"_28049":121205,"_3044":121313},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3588":72716,"_30857":72670,"_21381":121315,"_5":14694,"_28049":121205,"_3044":121316},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3588":72717,"_30857":72670,"_21381":121318,"_5":14694,"_28049":121205,"_3044":121319},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3588":72718,"_30857":72670,"_21381":121321,"_5":14694,"_28049":121205,"_3044":121322},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3588":72719,"_30857":72670,"_21381":121324,"_5":14694,"_28049":121205,"_3044":121325},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3588":72720,"_30857":72670,"_21381":121327,"_5":14694,"_28049":121205,"_3044":121328},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3588":72721,"_30857":72670,"_21381":121330,"_5":14694,"_28049":121205,"_3044":121331},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3588":72722,"_30857":72670,"_21381":121333,"_5":14694,"_28049":121205,"_3044":121334},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3588":72723,"_30857":72670,"_21381":121336,"_5":14694,"_28049":121209,"_3044":121337},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3588":72724,"_30857":72670,"_21381":121339,"_5":14694,"_28049":121209,"_3044":121340},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3588":72725,"_30857":72670,"_21381":121342,"_5":14694,"_28049":121213,"_3044":121343},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3588":72726,"_30857":72670,"_21381":121345,"_5":14694,"_28049":121213,"_3044":121346},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3588":72727,"_30857":72670,"_21381":121348,"_5":14694,"_28049":121213,"_3044":121349},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3588":72728,"_30857":72670,"_21381":121351,"_5":14694,"_28049":121213,"_3044":121352},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3588":72729,"_30857":72670,"_21381":121354,"_5":14694,"_28049":121213,"_3044":121355},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3588":72730,"_30857":72670,"_21381":121357,"_5":14694,"_28049":121213,"_3044":121358},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3588":72731,"_30857":72670,"_21381":121360,"_5":14694,"_28049":121213,"_3044":121361},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3588":72732,"_30857":72670,"_21381":121363,"_5":14694,"_28049":121213,"_3044":121364},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3588":72733,"_30857":72670,"_21381":121366,"_5":14694,"_28049":121213,"_3044":121367},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3588":72734,"_30857":72670,"_21381":121369,"_5":14694,"_28049":121213,"_3044":121370},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3588":72735,"_30857":72735,"_5":15054,"_3044":121372,"_31195":121373,"_21381":121374,"_28049":72735},"Registros de auditoría",[50417,120512,120513],[],{"_3588":72736,"_30857":72735,"_21381":121376,"_5":14694,"_28049":72735,"_3044":121377},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3588":72737,"_30857":72735,"_5":31192,"_21381":121379,"_28049":121380,"_3044":121381},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3588":72738,"_30857":72735,"_5":31192,"_21381":121383,"_28049":121384,"_3044":121385},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3588":72739,"_30857":72735,"_5":31192,"_21381":121387,"_28049":121388,"_3044":121389},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3588":72740,"_30857":72735,"_5":31192,"_21381":121391,"_28049":121392,"_3044":121393},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3588":72741,"_30857":72735,"_5":31192,"_21381":121395,"_28049":121396,"_3044":121397},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3588":72742,"_30857":72735,"_5":31192,"_21381":121399,"_28049":121400,"_3044":121401},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3588":72743,"_30857":72735,"_5":31192,"_21381":121403,"_28049":121404,"_3044":121405},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3588":72744,"_30857":72735,"_5":31192,"_21381":121407,"_28049":121408,"_3044":121409},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3588":72745,"_30857":72735,"_5":31192,"_21381":121411,"_28049":121412,"_3044":121413},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3588":72746,"_30857":72735,"_5":31192,"_21381":121415,"_28049":121416,"_3044":121417},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3588":72747,"_30857":72735,"_5":31192,"_21381":121419,"_28049":121420,"_3044":121421},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3588":72748,"_30857":72735,"_21381":121423,"_5":14694,"_28049":72735,"_3044":121424},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3588":72749,"_30857":72735,"_21381":121426,"_5":14694,"_28049":121380,"_3044":121427},[],"El cuerpo de auditoría incluye:",{"_3588":72750,"_30857":72735,"_21381":121429,"_5":14694,"_28049":121380,"_3044":121430},[],"input: datos recibidos por la operación;",{"_3588":72751,"_30857":72735,"_21381":121432,"_5":14694,"_28049":121380,"_3044":121433},[],"has\\_error: indica si el servicio devolvió un error;",{"_3588":72752,"_30857":72735,"_21381":121435,"_5":14694,"_28049":121380,"_3044":121436},[],"output: resultado producido o mensaje de error;",{"_3588":72753,"_30857":72735,"_21381":121438,"_5":14694,"_28049":121380,"_3044":121439},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3588":72754,"_30857":72735,"_21381":121441,"_5":14694,"_28049":121380,"_3044":121442},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3588":72755,"_30857":72735,"_21381":121444,"_5":14694,"_28049":121380,"_3044":121445},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3588":72756,"_30857":72735,"_21381":121447,"_5":14694,"_28049":121384,"_3044":121448},[],"El backend aplica auditoría a mutaciones de:",{"_3588":72757,"_30857":72735,"_21381":121450,"_5":14694,"_28049":121384,"_3044":121451},[],"autoridades, certificados y perfiles de emisión;",{"_3588":72758,"_30857":72735,"_21381":121453,"_5":14694,"_28049":121384,"_3044":121454},[],"claves y motores KMS;",{"_3588":72759,"_30857":72735,"_21381":121456,"_5":14694,"_28049":121384,"_3044":121457},[],"dispositivos e identidades;",{"_3588":72760,"_30857":72735,"_21381":121459,"_5":14694,"_28049":121384,"_3044":121460},[],"DMS y operaciones de enrolamiento;",{"_3588":72761,"_30857":72735,"_21381":121462,"_5":14694,"_28049":121384,"_3044":121463},[],"funciones de validación y CRL;",{"_3588":72762,"_30857":72735,"_21381":121465,"_5":14694,"_28049":121384,"_3044":121466},[],"principales, políticas y concesiones de autorización.",{"_3588":72763,"_30857":72735,"_21381":121468,"_5":14694,"_28049":121384,"_3044":121469},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3588":72764,"_30857":72735,"_21381":121471,"_5":14694,"_28049":121388,"_3044":121472},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3588":72765,"_30857":72735,"_21381":121474,"_5":14694,"_28049":121388,"_3044":121475},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3588":72766,"_30857":72735,"_21381":121477,"_5":14694,"_28049":121388,"_3044":121478},[],"Diseña el consumidor para:",{"_3588":72767,"_30857":72735,"_21381":121480,"_5":14694,"_28049":121388,"_3044":121481},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3588":72768,"_30857":72735,"_21381":121483,"_5":14694,"_28049":121388,"_3044":121484},[],"conservar el CloudEvent completo sin modificar;",{"_3588":72769,"_30857":72735,"_21381":121486,"_5":14694,"_28049":121388,"_3044":121487},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3588":72770,"_30857":72735,"_21381":121489,"_5":14694,"_28049":121388,"_3044":121490},[],"cifrar en tránsito y en reposo;",{"_3588":72771,"_30857":72735,"_21381":121492,"_5":14694,"_28049":121388,"_3044":121493},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3588":72772,"_30857":72735,"_21381":121495,"_5":14694,"_28049":121388,"_3044":121496},[],"aplicar una política explícita de retención y legal hold;",{"_3588":72773,"_30857":72735,"_21381":121498,"_5":14694,"_28049":121388,"_3044":121499},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3588":72774,"_30857":72735,"_21381":121501,"_5":14694,"_28049":121392,"_3044":121502},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3588":72775,"_30857":72735,"_21381":121504,"_5":14694,"_28049":121392,"_3044":121505},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3588":72776,"_30857":72735,"_21381":121507,"_5":14694,"_28049":121400,"_3044":121508},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3588":72777,"_30857":72735,"_21381":121510,"_5":14694,"_28049":121404,"_3044":121511},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3588":72778,"_30857":72735,"_21381":121513,"_5":14694,"_28049":121408,"_3044":121514},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3588":72779,"_30857":72735,"_21381":121516,"_5":14694,"_28049":121412,"_3044":121517},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3588":72780,"_30857":72735,"_21381":121519,"_5":14694,"_28049":121416,"_3044":121520},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3588":72781,"_30857":72735,"_21381":121522,"_5":14694,"_28049":121420,"_3044":121523},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3588":72782,"_30857":72735,"_21381":121525,"_5":14694,"_28049":121420,"_3044":121526},[],"aparece un evento de auditoría correcto;",{"_3588":72783,"_30857":72735,"_21381":121528,"_5":14694,"_28049":121420,"_3044":121529},[],"el principal coincide con la identidad utilizada;",{"_3588":72784,"_30857":72735,"_21381":121531,"_5":14694,"_28049":121420,"_3044":121532},[],"el consumidor lo persiste una sola vez;",{"_3588":72785,"_30857":72735,"_21381":121534,"_5":14694,"_28049":121420,"_3044":121535},[],"puede recuperarse por recurso, actor y periodo;",{"_3588":72786,"_30857":72735,"_21381":121537,"_5":14694,"_28049":121420,"_3044":121538},[],"una interrupción del consumidor produce una alerta.",{"_3588":72787,"_30857":72735,"_21381":121540,"_5":14694,"_28049":121420,"_3044":121541},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3588":72788,"_30857":72788,"_5":15054,"_3044":121543,"_31195":121544,"_21381":121545,"_28049":72788},"Arquitectura de la plataforma",[50417,120512],[],{"_3588":72789,"_30857":72788,"_21381":121547,"_5":14694,"_28049":72788,"_3044":121548},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3588":72790,"_30857":72788,"_5":31192,"_21381":121550,"_28049":121551,"_3044":121552},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3588":72791,"_30857":72788,"_5":31192,"_21381":121554,"_28049":121555,"_3044":121556},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3588":72792,"_30857":72788,"_5":31192,"_21381":121558,"_28049":121559,"_3044":121560},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3588":72793,"_30857":72788,"_5":31192,"_21381":121562,"_28049":121563,"_3044":121564},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3588":72794,"_30857":72788,"_5":31192,"_21381":121566,"_28049":121567,"_3044":121568},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3588":72795,"_30857":72788,"_21381":121570,"_5":14694,"_28049":72788,"_3044":121571},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3588":72796,"_30857":72788,"_21381":121573,"_5":14694,"_28049":72788,"_3044":121574},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3588":72797,"_30857":72788,"_21381":121576,"_5":14694,"_28049":121551,"_3044":121577},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3588":72798,"_30857":72788,"_21381":121579,"_5":14694,"_28049":121555,"_3044":121580},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3588":72799,"_30857":72788,"_21381":121582,"_5":14694,"_28049":121559,"_3044":121583},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3588":72800,"_30857":72788,"_21381":121585,"_5":14694,"_28049":121563,"_3044":121586},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3588":72801,"_30857":72788,"_21381":121588,"_5":14694,"_28049":121567,"_3044":121589},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3588":72802,"_30857":72802,"_5":15054,"_3044":121591,"_31195":121592,"_21381":121593,"_28049":72802},"Cómo funciona Lamassu",[50417,120512],[],{"_3588":72803,"_30857":72802,"_21381":121595,"_5":14694,"_28049":72802,"_3044":121596},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3588":72804,"_30857":72802,"_5":31192,"_21381":121598,"_28049":121599,"_3044":121600},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3588":72805,"_30857":72802,"_5":31192,"_21381":121602,"_28049":121603,"_3044":121604},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3588":72806,"_30857":72802,"_21381":121606,"_5":14694,"_28049":72802,"_3044":121607},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3588":72807,"_30857":72802,"_21381":121609,"_5":14694,"_28049":121599,"_3044":121610},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3588":72808,"_30857":72802,"_21381":121612,"_5":14694,"_28049":121599,"_3044":121613},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3588":72809,"_30857":72802,"_21381":121615,"_5":14694,"_28049":121599,"_3044":121616},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3588":72810,"_30857":72802,"_21381":121618,"_5":14694,"_28049":121599,"_3044":121619},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3588":72811,"_30857":72802,"_21381":121621,"_5":14694,"_28049":121599,"_3044":121622},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3588":72812,"_30857":72802,"_21381":121624,"_5":14694,"_28049":121603,"_3044":121625},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3588":72813,"_30857":72802,"_21381":121627,"_5":14694,"_28049":121603,"_3044":121628},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3588":72814,"_30857":72802,"_21381":121630,"_5":14694,"_28049":121603,"_3044":121631},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3588":72815,"_30857":72802,"_21381":121633,"_5":14694,"_28049":121603,"_3044":121634},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3588":72816,"_30857":72802,"_21381":121636,"_5":14694,"_28049":121603,"_3044":121637},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3588":72817,"_30857":72802,"_21381":121639,"_5":14694,"_28049":121603,"_3044":121640},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3588":72818,"_30857":72802,"_21381":121642,"_5":14694,"_28049":121603,"_3044":121643},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3588":72819,"_30857":72819,"_5":15054,"_3044":121645,"_31195":121646,"_21381":121647,"_28049":72819},"Dispositivos e identidades",[50417,120512,53089,121645],[],{"_3588":72820,"_30857":72819,"_21381":121649,"_5":14694,"_28049":72819,"_3044":121650},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3588":72821,"_30857":72819,"_5":31192,"_21381":121652,"_28049":121653,"_3044":121654},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3588":72822,"_30857":72819,"_5":31192,"_21381":121656,"_28049":121657,"_3044":121658},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3588":72823,"_30857":72819,"_5":31192,"_21381":121660,"_28049":121661,"_3044":121662},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3588":72824,"_30857":72819,"_5":31192,"_21381":121664,"_28049":121665,"_3044":121666},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3588":72825,"_30857":72819,"_5":31192,"_21381":121668,"_28049":121669,"_3044":121670},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3588":72826,"_30857":72819,"_5":31192,"_21381":121672,"_28049":121673,"_3044":121674},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3588":72827,"_30857":72819,"_5":31192,"_21381":121676,"_28049":121677,"_3044":121678},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3588":72828,"_30857":72819,"_5":31192,"_21381":121680,"_28049":121681,"_3044":121682},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3588":72829,"_30857":72819,"_5":31192,"_21381":121684,"_28049":121685,"_3044":121686},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3588":72830,"_30857":72819,"_5":31192,"_21381":121688,"_28049":121689,"_3044":121690},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3588":72831,"_30857":72819,"_5":31192,"_21381":121692,"_28049":121693,"_3044":121694},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3588":72832,"_30857":72819,"_21381":121696,"_5":14694,"_28049":72819,"_3044":121697},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3588":72833,"_30857":72819,"_21381":121699,"_5":14694,"_28049":72819,"_3044":121700},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3588":72834,"_30857":72819,"_21381":121702,"_5":14694,"_28049":121653,"_3044":121703},[],"Vista operativa",{"_3588":72835,"_30857":72819,"_21381":121705,"_5":14694,"_28049":121653,"_3044":121706},[],"Interpretación",{"_3588":72836,"_30857":72819,"_21381":121708,"_5":14694,"_28049":121653,"_3044":53152},[],{"_3588":72837,"_30857":72819,"_21381":121710,"_5":14694,"_28049":121653,"_3044":121711},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3588":72838,"_30857":72819,"_21381":121713,"_5":14694,"_28049":121653,"_3044":53158},[],{"_3588":72839,"_30857":72819,"_21381":121715,"_5":14694,"_28049":121653,"_3044":121716},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3588":72840,"_30857":72819,"_21381":121718,"_5":14694,"_28049":121653,"_3044":53164},[],{"_3588":72841,"_30857":72819,"_21381":121720,"_5":14694,"_28049":121653,"_3044":121721},[],"La identidad está en la ventana operativa de renovación.",{"_3588":72842,"_30857":72819,"_21381":121723,"_5":14694,"_28049":121653,"_3044":53170},[],{"_3588":72843,"_30857":72819,"_21381":121725,"_5":14694,"_28049":121653,"_3044":121726},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3588":72844,"_30857":72819,"_21381":121728,"_5":14694,"_28049":121653,"_3044":53176},[],{"_3588":72845,"_30857":72819,"_21381":121730,"_5":14694,"_28049":121653,"_3044":121731},[],"La identidad ha vencido.",{"_3588":72846,"_30857":72819,"_21381":121733,"_5":14694,"_28049":121653,"_3044":53182},[],{"_3588":72847,"_30857":72819,"_21381":121735,"_5":14694,"_28049":121653,"_3044":121736},[],"La identidad está marcada como revocada.",{"_3588":72848,"_30857":72819,"_21381":121738,"_5":14694,"_28049":121653,"_3044":53188},[],{"_3588":72849,"_30857":72819,"_21381":121740,"_5":14694,"_28049":121653,"_3044":121741},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3588":72850,"_30857":72819,"_21381":121743,"_5":14694,"_28049":121653,"_3044":121744},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3588":72851,"_30857":72819,"_21381":121746,"_5":14694,"_28049":121657,"_3044":121747},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3588":72852,"_30857":72819,"_21381":121749,"_5":14694,"_28049":121657,"_3044":121750},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3588":72853,"_30857":72819,"_21381":121752,"_5":14694,"_28049":121657,"_3044":121753},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3588":72854,"_30857":72819,"_21381":121755,"_5":14694,"_28049":121657,"_3044":121756},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3588":72855,"_30857":72819,"_21381":121758,"_5":14694,"_28049":121661,"_3044":121759},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3588":72856,"_30857":72819,"_21381":121761,"_5":14694,"_28049":121665,"_3044":121762},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3588":72857,"_30857":72819,"_21381":121764,"_5":14694,"_28049":121669,"_3044":121765},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3588":72858,"_30857":72819,"_21381":121767,"_5":14694,"_28049":121673,"_3044":121768},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3588":72859,"_30857":72819,"_21381":121770,"_5":14694,"_28049":121677,"_3044":121771},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3588":72860,"_30857":72819,"_21381":121773,"_5":14694,"_28049":121677,"_3044":121774},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3588":72861,"_30857":72819,"_21381":121776,"_5":14694,"_28049":121681,"_3044":121777},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3588":72862,"_30857":72819,"_21381":121779,"_5":14694,"_28049":121681,"_3044":121780},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3588":72863,"_30857":72819,"_21381":121782,"_5":14694,"_28049":121681,"_3044":121783},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3588":72864,"_30857":72819,"_21381":121785,"_5":14694,"_28049":121681,"_3044":121786},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3588":72865,"_30857":72819,"_21381":121788,"_5":14694,"_28049":121681,"_3044":121789},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3588":72866,"_30857":72819,"_21381":121791,"_5":14694,"_28049":121681,"_3044":121792},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3588":72867,"_30857":72819,"_21381":121794,"_5":14694,"_28049":121685,"_3044":121795},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3588":72868,"_30857":72819,"_21381":121797,"_5":14694,"_28049":121685,"_3044":121798},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3588":72869,"_30857":72819,"_21381":121800,"_5":14694,"_28049":121689,"_3044":121801},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3588":72870,"_30857":72819,"_21381":121803,"_5":14694,"_28049":121689,"_3044":121804},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3588":72871,"_30857":72819,"_21381":121806,"_5":14694,"_28049":121689,"_3044":121807},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3588":72872,"_30857":72819,"_21381":121809,"_5":14694,"_28049":121689,"_3044":121810},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3588":72873,"_30857":72819,"_21381":121812,"_5":14694,"_28049":121693,"_3044":121813},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3588":72874,"_30857":72819,"_21381":121815,"_5":14694,"_28049":121693,"_3044":121816},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3588":72875,"_30857":72875,"_5":15054,"_3044":121818,"_31195":121819,"_21381":121821,"_28049":72875},"Identidad inicial y autenticación",[50417,120512,53089,121645,121820],"Enrolamiento con PKI",[],{"_3588":72876,"_30857":72875,"_21381":121823,"_5":14694,"_28049":72875,"_3044":121824},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3588":72877,"_30857":72875,"_5":31192,"_21381":121826,"_28049":121827,"_3044":121828},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3588":72878,"_30857":72875,"_5":31192,"_21381":121830,"_28049":121831,"_3044":121832},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3588":72879,"_30857":72875,"_5":31192,"_21381":121834,"_28049":121835,"_3044":121836},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3588":72880,"_30857":72875,"_5":31192,"_21381":121838,"_28049":121839,"_3044":121840},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3588":72881,"_30857":72875,"_5":31192,"_21381":121842,"_28049":121843,"_3044":121844},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3588":72882,"_30857":72875,"_21381":121846,"_5":14694,"_28049":72875,"_3044":121847},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3588":72883,"_30857":72875,"_21381":121849,"_5":14694,"_28049":121827,"_3044":121850},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3588":72884,"_30857":72875,"_21381":121852,"_5":14694,"_28049":121827,"_3044":121853},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3588":72885,"_30857":72875,"_21381":121855,"_5":14694,"_28049":121831,"_3044":121856},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3588":72886,"_30857":72875,"_21381":121858,"_5":14694,"_28049":121831,"_3044":121859},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3588":72887,"_30857":72875,"_21381":121861,"_5":14694,"_28049":121831,"_3044":121862},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3588":72888,"_30857":72875,"_21381":121864,"_5":14694,"_28049":121835,"_3044":121865},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3588":72889,"_30857":72875,"_21381":121867,"_5":14694,"_28049":121835,"_3044":121868},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3588":72890,"_30857":72875,"_21381":121870,"_5":14694,"_28049":121839,"_3044":121871},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3588":72891,"_30857":72875,"_21381":121873,"_5":14694,"_28049":121839,"_3044":121874},[],"Ejemplo de cuerpo:",{"_3588":72892,"_30857":72875,"_21381":121876,"_5":14694,"_28049":121839,"_3044":121877},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3588":72893,"_30857":72875,"_21381":121879,"_5":14694,"_28049":121839,"_3044":121880},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3588":72894,"_30857":72875,"_21381":121882,"_5":14694,"_28049":121839,"_3044":121883},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3588":72895,"_30857":72875,"_21381":121885,"_5":14694,"_28049":121839,"_3044":121886},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3588":72896,"_30857":72875,"_21381":121888,"_5":14694,"_28049":121843,"_3044":121889},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3588":72897,"_30857":72875,"_21381":121891,"_5":14694,"_28049":121843,"_3044":121892},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3588":72898,"_30857":72898,"_5":15054,"_3044":121894,"_31195":121895,"_21381":121896,"_28049":72898},"Configura y opera el DMS",[50417,120512,53089,121645,121820],[],{"_3588":72899,"_30857":72898,"_21381":121898,"_5":14694,"_28049":72898,"_3044":121899},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3588":72900,"_30857":72898,"_5":31192,"_21381":121901,"_28049":121902,"_3044":119046},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3588":72901,"_30857":72898,"_5":31192,"_21381":121904,"_28049":121905,"_3044":121906},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3588":72902,"_30857":72898,"_5":31192,"_21381":121908,"_28049":121909,"_3044":121910},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3588":72903,"_30857":72898,"_5":31192,"_21381":121912,"_28049":121913,"_3044":121914},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3588":72904,"_30857":72898,"_5":31192,"_21381":121916,"_28049":121917,"_3044":121918},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3588":72905,"_30857":72898,"_5":31192,"_21381":121920,"_28049":121921,"_3044":121922},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3588":72906,"_30857":72898,"_5":31192,"_21381":121924,"_28049":121925,"_3044":121926},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3588":72907,"_30857":72898,"_5":31192,"_21381":121928,"_28049":121929,"_3044":121930},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3588":72908,"_30857":72898,"_5":31192,"_21381":121932,"_28049":121933,"_3044":53384},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3588":72909,"_30857":72898,"_5":31192,"_21381":121935,"_28049":121936,"_3044":53388},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3588":72910,"_30857":72898,"_5":31192,"_21381":121938,"_28049":121939,"_3044":121940},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3588":72911,"_30857":72898,"_5":31192,"_21381":121942,"_28049":121943,"_3044":121944},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3588":72912,"_30857":72898,"_5":31192,"_21381":121946,"_28049":121947,"_3044":121948},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3588":72913,"_30857":72898,"_5":31192,"_21381":121950,"_28049":121951,"_3044":121952},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3588":72914,"_30857":72898,"_5":31192,"_21381":121954,"_28049":121955,"_3044":53408},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3588":72915,"_30857":72898,"_5":31192,"_21381":121957,"_28049":121958,"_3044":121959},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3588":72916,"_30857":72898,"_5":31192,"_21381":121961,"_28049":121962,"_3044":121963},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3588":72917,"_30857":72898,"_5":31192,"_21381":121965,"_28049":121966,"_3044":121967},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3588":72918,"_30857":72898,"_21381":121969,"_5":14694,"_28049":72898,"_3044":121970},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3588":72919,"_30857":72898,"_21381":121972,"_5":14694,"_28049":121902,"_3044":121973},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3588":72920,"_30857":72898,"_21381":121975,"_5":14694,"_28049":121902,"_3044":121976},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3588":72921,"_30857":72898,"_21381":121978,"_5":14694,"_28049":121909,"_3044":121979},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3588":72922,"_30857":72898,"_21381":121981,"_5":14694,"_28049":121913,"_3044":121982},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3588":72923,"_30857":72898,"_21381":121984,"_5":14694,"_28049":121917,"_3044":121985},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3588":72924,"_30857":72898,"_21381":121987,"_5":14694,"_28049":121921,"_3044":121988},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3588":72925,"_30857":72898,"_21381":121990,"_5":14694,"_28049":121925,"_3044":121991},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3588":72926,"_30857":72898,"_21381":121993,"_5":14694,"_28049":121933,"_3044":121994},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3588":72927,"_30857":72898,"_21381":121996,"_5":14694,"_28049":121933,"_3044":121997},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3588":72928,"_30857":72898,"_21381":121999,"_5":14694,"_28049":121936,"_3044":122000},[],"Campo de `settings.enrollment_settings`",{"_3588":72929,"_30857":72898,"_21381":122002,"_5":14694,"_28049":121936,"_3044":122003},[],"Decisión",{"_3588":72930,"_30857":72898,"_21381":122005,"_5":14694,"_28049":121936,"_3044":53459},[],{"_3588":72931,"_30857":72898,"_21381":122007,"_5":14694,"_28049":121936,"_3044":122008},[],"`EST_RFC7030` para estas operaciones.",{"_3588":72932,"_30857":72898,"_21381":122010,"_5":14694,"_28049":121936,"_3044":53465},[],{"_3588":72933,"_30857":72898,"_21381":122012,"_5":14694,"_28049":121936,"_3044":122013},[],"ID de la CA que firmará.",{"_3588":72934,"_30857":72898,"_21381":122015,"_5":14694,"_28049":121936,"_3044":53471},[],{"_3588":72935,"_30857":72898,"_21381":122017,"_5":14694,"_28049":121936,"_3044":122018},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3588":72936,"_30857":72898,"_21381":122020,"_5":14694,"_28049":121936,"_3044":53477},[],{"_3588":72937,"_30857":72898,"_21381":122022,"_5":14694,"_28049":121936,"_3044":122023},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3588":72938,"_30857":72898,"_21381":122025,"_5":14694,"_28049":121936,"_3044":53483},[],{"_3588":72939,"_30857":72898,"_21381":122027,"_5":14694,"_28049":121936,"_3044":122028},[],"Uno de los cuatro modos de autenticación.",{"_3588":72940,"_30857":72898,"_21381":122030,"_5":14694,"_28049":121936,"_3044":122031},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3588":72941,"_30857":72898,"_21381":122033,"_5":14694,"_28049":121939,"_3044":122034},[],"Los bloques son independientes:",{"_3588":72942,"_30857":72898,"_21381":122036,"_5":14694,"_28049":121939,"_3044":122037},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3588":72943,"_30857":72898,"_21381":122039,"_5":14694,"_28049":121939,"_3044":122040},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3588":72944,"_30857":72898,"_21381":122042,"_5":14694,"_28049":121939,"_3044":53501},[],{"_3588":72945,"_30857":72898,"_21381":122044,"_5":14694,"_28049":121939,"_3044":122045},[],"Control aplicado en la operación configurada",{"_3588":72946,"_30857":72898,"_21381":122047,"_5":14694,"_28049":121939,"_3044":53507},[],{"_3588":72947,"_30857":72898,"_21381":122049,"_5":14694,"_28049":121939,"_3044":122050},[],"Validación del certificado presentado.",{"_3588":72948,"_30857":72898,"_21381":122052,"_5":14694,"_28049":121939,"_3044":53513},[],{"_3588":72949,"_30857":72898,"_21381":122054,"_5":14694,"_28049":121939,"_3044":122055},[],"Autorización del webhook configurado.",{"_3588":72950,"_30857":72898,"_21381":122057,"_5":14694,"_28049":121939,"_3044":53519},[],{"_3588":72951,"_30857":72898,"_21381":122059,"_5":14694,"_28049":121939,"_3044":122060},[],"Validación del certificado y, después, aprobación del webhook.",{"_3588":72952,"_30857":72898,"_21381":122062,"_5":14694,"_28049":121939,"_3044":53525},[],{"_3588":72953,"_30857":72898,"_21381":122064,"_5":14694,"_28049":121939,"_3044":122065},[],"Sin autenticación del solicitante por el DMS.",{"_3588":72954,"_30857":72898,"_21381":122067,"_5":14694,"_28049":121939,"_3044":122068},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3588":72955,"_30857":72898,"_21381":122070,"_5":14694,"_28049":121939,"_3044":122071},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3588":72956,"_30857":72898,"_21381":122073,"_5":14694,"_28049":121939,"_3044":122074},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3588":72957,"_30857":72898,"_21381":122076,"_5":14694,"_28049":121939,"_3044":122077},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3588":72958,"_30857":72898,"_21381":122079,"_5":14694,"_28049":121943,"_3044":122080},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3588":72959,"_30857":72898,"_21381":122082,"_5":14694,"_28049":121943,"_3044":122083},[],"Campo de `external_webhook_settings`",{"_3588":72960,"_30857":72898,"_21381":122085,"_5":14694,"_28049":121943,"_3044":122003},[],{"_3588":72961,"_30857":72898,"_21381":122087,"_5":14694,"_28049":121943,"_3044":53551},[],{"_3588":72962,"_30857":72898,"_21381":122089,"_5":14694,"_28049":121943,"_3044":122090},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3588":72963,"_30857":72898,"_21381":122092,"_5":14694,"_28049":121943,"_3044":53557},[],{"_3588":72964,"_30857":72898,"_21381":122094,"_5":14694,"_28049":121943,"_3044":122095},[],"`POST` o `PUT`; `POST` por defecto.",{"_3588":72965,"_30857":72898,"_21381":122097,"_5":14694,"_28049":121943,"_3044":53563},[],{"_3588":72966,"_30857":72898,"_21381":122099,"_5":14694,"_28049":121943,"_3044":122100},[],"Etiqueta usada en los logs del servicio.",{"_3588":72967,"_30857":72898,"_21381":122102,"_5":14694,"_28049":121943,"_3044":53569},[],{"_3588":72968,"_30857":72898,"_21381":122104,"_5":14694,"_28049":121943,"_3044":122105},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3588":72969,"_30857":72898,"_21381":122107,"_5":14694,"_28049":121943,"_3044":53575},[],{"_3588":72970,"_30857":72898,"_21381":122109,"_5":14694,"_28049":121943,"_3044":122110},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3588":72971,"_30857":72898,"_21381":122112,"_5":14694,"_28049":121943,"_3044":53581},[],{"_3588":72972,"_30857":72898,"_21381":122114,"_5":14694,"_28049":121943,"_3044":122115},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3588":72973,"_30857":72898,"_21381":122117,"_5":14694,"_28049":121943,"_3044":53587},[],{"_3588":72974,"_30857":72898,"_21381":122119,"_5":14694,"_28049":121943,"_3044":122120},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3588":72975,"_30857":72898,"_21381":122122,"_5":14694,"_28049":121943,"_3044":53593},[],{"_3588":72976,"_30857":72898,"_21381":122124,"_5":14694,"_28049":121943,"_3044":122125},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3588":72977,"_30857":72898,"_21381":122127,"_5":14694,"_28049":121943,"_3044":53599},[],{"_3588":72978,"_30857":72898,"_21381":122129,"_5":14694,"_28049":121943,"_3044":122130},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3588":72979,"_30857":72898,"_21381":122132,"_5":14694,"_28049":121943,"_3044":53605},[],{"_3588":72980,"_30857":72898,"_21381":122134,"_5":14694,"_28049":121943,"_3044":122135},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3588":72981,"_30857":72898,"_21381":122137,"_5":14694,"_28049":121943,"_3044":122138},[],"Reglas de esa configuración:",{"_3588":72982,"_30857":72898,"_21381":122140,"_5":14694,"_28049":121943,"_3044":122141},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3588":72983,"_30857":72898,"_21381":122143,"_5":14694,"_28049":121943,"_3044":122144},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3588":72984,"_30857":72898,"_21381":122146,"_5":14694,"_28049":121943,"_3044":122147},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3588":72985,"_30857":72898,"_21381":122149,"_5":14694,"_28049":121943,"_3044":122150},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3588":72986,"_30857":72898,"_21381":122152,"_5":14694,"_28049":121943,"_3044":122153},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3588":72987,"_30857":72898,"_21381":122155,"_5":14694,"_28049":121943,"_3044":122156},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3588":72988,"_30857":72898,"_21381":122158,"_5":14694,"_28049":121943,"_3044":122159},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3588":72989,"_30857":72898,"_21381":122161,"_5":14694,"_28049":121943,"_3044":122162},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3588":72990,"_30857":72898,"_21381":122164,"_5":14694,"_28049":121943,"_3044":122165},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3588":72991,"_30857":72898,"_21381":122167,"_5":14694,"_28049":121947,"_3044":122168},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3588":72992,"_30857":72898,"_21381":122170,"_5":14694,"_28049":121951,"_3044":122171},[],"Campo de `settings.reenrollment_settings`",{"_3588":72993,"_30857":72898,"_21381":122173,"_5":14694,"_28049":121951,"_3044":122174},[],"Función",{"_3588":72994,"_30857":72898,"_21381":122176,"_5":14694,"_28049":121951,"_3044":53649},[],{"_3588":72995,"_30857":72898,"_21381":122178,"_5":14694,"_28049":121951,"_3044":122179},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3588":72996,"_30857":72898,"_21381":122181,"_5":14694,"_28049":121951,"_3044":53655},[],{"_3588":72997,"_30857":72898,"_21381":122183,"_5":14694,"_28049":121951,"_3044":122184},[],"Umbral operativo preventivo de monitorización.",{"_3588":72998,"_30857":72898,"_21381":122186,"_5":14694,"_28049":121951,"_3044":53661},[],{"_3588":72999,"_30857":72898,"_21381":122188,"_5":14694,"_28049":121951,"_3044":122189},[],"Umbral operativo crítico de monitorización.",{"_3588":73000,"_30857":72898,"_21381":122191,"_5":14694,"_28049":121951,"_3044":53667},[],{"_3588":73001,"_30857":72898,"_21381":122193,"_5":14694,"_28049":121951,"_3044":122194},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3588":73002,"_30857":72898,"_21381":122196,"_5":14694,"_28049":121951,"_3044":53673},[],{"_3588":73003,"_30857":72898,"_21381":122198,"_5":14694,"_28049":121951,"_3044":122199},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3588":73004,"_30857":72898,"_21381":122201,"_5":14694,"_28049":121951,"_3044":53679},[],{"_3588":73005,"_30857":72898,"_21381":122203,"_5":14694,"_28049":121951,"_3044":122204},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3588":73006,"_30857":72898,"_21381":122206,"_5":14694,"_28049":121951,"_3044":122207},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3588":73007,"_30857":72898,"_21381":122209,"_5":14694,"_28049":121955,"_3044":122210},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3588":73008,"_30857":72898,"_21381":122212,"_5":14694,"_28049":121958,"_3044":119410},[],{"_3588":73009,"_30857":72898,"_21381":122214,"_5":14694,"_28049":121958,"_3044":122215},[],"Qué publica",{"_3588":73010,"_30857":72898,"_21381":122217,"_5":14694,"_28049":121958,"_3044":53696},[],{"_3588":73011,"_30857":72898,"_21381":122219,"_5":14694,"_28049":121958,"_3044":122220},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3588":73012,"_30857":72898,"_21381":122222,"_5":14694,"_28049":121958,"_3044":53702},[],{"_3588":73013,"_30857":72898,"_21381":122224,"_5":14694,"_28049":121958,"_3044":122225},[],"Certificado de la CA emisora seleccionada.",{"_3588":73014,"_30857":72898,"_21381":122227,"_5":14694,"_28049":121958,"_3044":53708},[],{"_3588":73015,"_30857":72898,"_21381":122229,"_5":14694,"_28049":121958,"_3044":122230},[],"Certificados de las CAs elegidas explícitamente.",{"_3588":73016,"_30857":72898,"_21381":122232,"_5":14694,"_28049":121958,"_3044":122233},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3588":73017,"_30857":72898,"_21381":122235,"_5":14694,"_28049":121962,"_3044":122236},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3588":73018,"_30857":72898,"_21381":122238,"_5":14694,"_28049":121962,"_3044":122239},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3588":73019,"_30857":72898,"_21381":122241,"_5":14694,"_28049":121962,"_3044":122242},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3588":73020,"_30857":72898,"_21381":122244,"_5":14694,"_28049":121966,"_3044":122245},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3588":73021,"_30857":73021,"_5":15054,"_3044":122247,"_31195":122248,"_21381":122249,"_28049":73021},"Integra el cliente EST",[50417,120512,53089,121645,121820],[],{"_3588":73022,"_30857":73021,"_21381":122251,"_5":14694,"_28049":73021,"_3044":122252},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3588":73023,"_30857":73021,"_5":31192,"_21381":122254,"_28049":122255,"_3044":119046},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3588":73024,"_30857":73021,"_5":31192,"_21381":122257,"_28049":122258,"_3044":122259},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3588":73025,"_30857":73021,"_5":31192,"_21381":122261,"_28049":122262,"_3044":122263},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3588":73026,"_30857":73021,"_5":31192,"_21381":122265,"_28049":122266,"_3044":122267},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3588":73027,"_30857":73021,"_5":31192,"_21381":122269,"_28049":122270,"_3044":122271},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3588":73028,"_30857":73021,"_5":31192,"_21381":122273,"_28049":122274,"_3044":122275},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3588":73029,"_30857":73021,"_21381":122277,"_5":14694,"_28049":73021,"_3044":122278},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3588":73030,"_30857":73021,"_21381":122280,"_5":14694,"_28049":122255,"_3044":122281},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3588":73031,"_30857":73021,"_21381":122283,"_5":14694,"_28049":122255,"_3044":122284},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3588":73032,"_30857":73021,"_21381":122286,"_5":14694,"_28049":122255,"_3044":122287},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3588":73033,"_30857":73021,"_21381":122289,"_5":14694,"_28049":122258,"_3044":122290},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3588":73034,"_30857":73021,"_21381":122292,"_5":14694,"_28049":122258,"_3044":122293},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3588":73035,"_30857":73021,"_21381":122295,"_5":14694,"_28049":122262,"_3044":122296},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3588":73036,"_30857":73021,"_21381":122298,"_5":14694,"_28049":122262,"_3044":122299},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3588":73037,"_30857":73021,"_21381":122301,"_5":14694,"_28049":122266,"_3044":122302},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3588":73038,"_30857":73021,"_21381":122304,"_5":14694,"_28049":122266,"_3044":122305},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3588":73039,"_30857":73021,"_21381":122307,"_5":14694,"_28049":122270,"_3044":122308},[],"Para el caso de una raíz que emite directamente:",{"_3588":73040,"_30857":73021,"_21381":122310,"_5":14694,"_28049":122270,"_3044":122311},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3588":73041,"_30857":73021,"_21381":122313,"_5":14694,"_28049":122270,"_3044":122314},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3588":73042,"_30857":73021,"_21381":122316,"_5":14694,"_28049":122274,"_3044":122317},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3588":73043,"_30857":73043,"_5":15054,"_3044":122319,"_31195":122320,"_21381":122321,"_28049":73043},"Referencia EST",[50417,120512,53089,121645,121820],[],{"_3588":73044,"_30857":73043,"_21381":122323,"_5":14694,"_28049":73043,"_3044":122324},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3588":73045,"_30857":73043,"_5":31192,"_21381":122326,"_28049":122327,"_3044":122328},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3588":73046,"_30857":73043,"_5":31192,"_21381":122330,"_28049":122331,"_3044":23162},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3588":73047,"_30857":73043,"_5":31192,"_21381":122333,"_28049":122334,"_3044":26605},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3588":73048,"_30857":73043,"_5":31192,"_21381":122336,"_28049":122337,"_3044":26612},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3588":73049,"_30857":73043,"_5":31192,"_21381":122339,"_28049":122340,"_3044":25898},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3588":73050,"_30857":73043,"_5":31192,"_21381":122342,"_28049":122343,"_3044":122344},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3588":73051,"_30857":73043,"_5":31192,"_21381":122346,"_28049":122347,"_3044":122348},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3588":73052,"_30857":73043,"_5":31192,"_21381":122350,"_28049":122351,"_3044":122352},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3588":73053,"_30857":73043,"_21381":122354,"_5":14694,"_28049":73043,"_3044":122355},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3588":73054,"_30857":73043,"_21381":122357,"_5":14694,"_28049":122327,"_3044":122358},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3588":73055,"_30857":73043,"_21381":122360,"_5":14694,"_28049":122327,"_3044":120272},[],{"_3588":73056,"_30857":73043,"_21381":122362,"_5":14694,"_28049":122327,"_3044":122363},[],"Método",{"_3588":73057,"_30857":73043,"_21381":122365,"_5":14694,"_28049":122327,"_3044":122366},[],"Autenticación y condición",{"_3588":73058,"_30857":73043,"_21381":122368,"_5":14694,"_28049":122327,"_3044":53851},[],{"_3588":73059,"_30857":73043,"_21381":122370,"_5":14694,"_28049":122327,"_3044":53854},[],{"_3588":73060,"_30857":73043,"_21381":122372,"_5":14694,"_28049":122327,"_3044":122373},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3588":73061,"_30857":73043,"_21381":122375,"_5":14694,"_28049":122327,"_3044":53860},[],{"_3588":73062,"_30857":73043,"_21381":122377,"_5":14694,"_28049":122327,"_3044":53863},[],{"_3588":73063,"_30857":73043,"_21381":122379,"_5":14694,"_28049":122327,"_3044":122380},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3588":73064,"_30857":73043,"_21381":122382,"_5":14694,"_28049":122327,"_3044":53869},[],{"_3588":73065,"_30857":73043,"_21381":122384,"_5":14694,"_28049":122327,"_3044":53863},[],{"_3588":73066,"_30857":73043,"_21381":122386,"_5":14694,"_28049":122327,"_3044":122387},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3588":73067,"_30857":73043,"_21381":122389,"_5":14694,"_28049":122327,"_3044":53877},[],{"_3588":73068,"_30857":73043,"_21381":122391,"_5":14694,"_28049":122327,"_3044":53863},[],{"_3588":73069,"_30857":73043,"_21381":122393,"_5":14694,"_28049":122327,"_3044":122394},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3588":73070,"_30857":73043,"_21381":122396,"_5":14694,"_28049":122327,"_3044":122397},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3588":73071,"_30857":73043,"_21381":122399,"_5":14694,"_28049":122331,"_3044":122400},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3588":73072,"_30857":73043,"_21381":122402,"_5":14694,"_28049":122331,"_3044":122403},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3588":73073,"_30857":73043,"_21381":122405,"_5":14694,"_28049":122334,"_3044":122406},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3588":73074,"_30857":73043,"_21381":122408,"_5":14694,"_28049":122334,"_3044":122409},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3588":73075,"_30857":73043,"_21381":122411,"_5":14694,"_28049":122337,"_3044":122412},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3588":73076,"_30857":73043,"_21381":122414,"_5":14694,"_28049":122337,"_3044":122415},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3588":73077,"_30857":73043,"_21381":122417,"_5":14694,"_28049":122340,"_3044":122418},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3588":73078,"_30857":73043,"_21381":122420,"_5":14694,"_28049":122340,"_3044":122421},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3588":73079,"_30857":73043,"_21381":122423,"_5":14694,"_28049":122343,"_3044":122424},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3588":73080,"_30857":73043,"_21381":122426,"_5":14694,"_28049":122343,"_3044":122427},[],"Parte",{"_3588":73081,"_30857":73043,"_21381":122429,"_5":14694,"_28049":122343,"_3044":122430},[],"Contenido tras decodificar su Base64",{"_3588":73082,"_30857":73043,"_21381":122432,"_5":14694,"_28049":122343,"_3044":53921},[],{"_3588":73083,"_30857":73043,"_21381":122434,"_5":14694,"_28049":122343,"_3044":122435},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3588":73084,"_30857":73043,"_21381":122437,"_5":14694,"_28049":122343,"_3044":53927},[],{"_3588":73085,"_30857":73043,"_21381":122439,"_5":14694,"_28049":122343,"_3044":122440},[],"PKCS#7 DER con el certificado emitido.",{"_3588":73086,"_30857":73043,"_21381":122442,"_5":14694,"_28049":122343,"_3044":122443},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3588":73087,"_30857":73043,"_21381":122445,"_5":14694,"_28049":122347,"_3044":122446},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3588":73088,"_30857":73043,"_21381":122448,"_5":14694,"_28049":122347,"_3044":122449},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3588":73089,"_30857":73043,"_21381":122451,"_5":14694,"_28049":122347,"_3044":122452},[],"Convierte y comprueba el resultado:",{"_3588":73090,"_30857":73043,"_21381":122454,"_5":14694,"_28049":122347,"_3044":122455},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3588":73091,"_30857":73043,"_21381":122457,"_5":14694,"_28049":122351,"_3044":122458},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3588":73092,"_30857":73043,"_21381":122460,"_5":14694,"_28049":122351,"_3044":122461},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3588":73093,"_30857":73093,"_5":15054,"_3044":121820,"_31195":122463,"_21381":122464,"_28049":73093},[50417,120512,53089,121645,121820],[],{"_3588":73094,"_30857":73093,"_21381":122466,"_5":14694,"_28049":73093,"_3044":122467},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3588":73095,"_30857":73093,"_5":31192,"_21381":122469,"_28049":122470,"_3044":122471},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3588":73096,"_30857":73093,"_5":31192,"_21381":122473,"_28049":122474,"_3044":122475},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3588":73097,"_30857":73093,"_5":31192,"_21381":122477,"_28049":122478,"_3044":122479},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3588":73098,"_30857":73093,"_5":31192,"_21381":122481,"_28049":122482,"_3044":122483},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3588":73099,"_30857":73093,"_21381":122485,"_5":14694,"_28049":73093,"_3044":122486},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3588":73100,"_30857":73093,"_21381":122488,"_5":14694,"_28049":122470,"_3044":122489},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3588":73101,"_30857":73093,"_21381":122491,"_5":14694,"_28049":122470,"_3044":122492},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3588":73102,"_30857":73093,"_21381":122494,"_5":14694,"_28049":122470,"_3044":122495},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3588":73103,"_30857":73093,"_21381":122497,"_5":14694,"_28049":122470,"_3044":122498},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3588":73104,"_30857":73093,"_21381":122500,"_5":14694,"_28049":122470,"_3044":122501},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3588":73105,"_30857":73093,"_21381":122503,"_5":14694,"_28049":122470,"_3044":122504},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3588":73106,"_30857":73093,"_21381":122506,"_5":14694,"_28049":122474,"_3044":122507},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3588":73107,"_30857":73093,"_21381":122509,"_5":14694,"_28049":122474,"_3044":122510},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3588":73108,"_30857":73093,"_21381":122512,"_5":14694,"_28049":122474,"_3044":122513},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3588":73109,"_30857":73093,"_21381":122515,"_5":14694,"_28049":122474,"_3044":122516},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3588":73110,"_30857":73093,"_21381":122518,"_5":14694,"_28049":122478,"_3044":122519},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3588":73111,"_30857":73093,"_21381":122521,"_5":14694,"_28049":122478,"_3044":122522},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3588":73112,"_30857":73093,"_21381":122524,"_5":14694,"_28049":122478,"_3044":122525},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3588":73113,"_30857":73093,"_21381":122527,"_5":14694,"_28049":122478,"_3044":122528},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3588":73114,"_30857":73093,"_21381":122530,"_5":14694,"_28049":122482,"_3044":122531},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3588":73115,"_30857":73093,"_21381":122533,"_5":14694,"_28049":122482,"_3044":122534},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3588":73116,"_30857":73116,"_5":15054,"_3044":122536,"_31195":122537,"_21381":122538,"_28049":73116},"Estrategias de aprovisionamiento",[50417,120512,53089,121645,121820],[],{"_3588":73117,"_30857":73116,"_21381":122540,"_5":14694,"_28049":73116,"_3044":122541},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3588":73118,"_30857":73116,"_5":31192,"_21381":122543,"_28049":122544,"_3044":122545},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3588":73119,"_30857":73116,"_5":31192,"_21381":122547,"_28049":122548,"_3044":122549},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3588":73120,"_30857":73116,"_5":31192,"_21381":122551,"_28049":122552,"_3044":122553},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3588":73121,"_30857":73116,"_5":31192,"_21381":122555,"_28049":122556,"_3044":122557},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3588":73122,"_30857":73116,"_5":31192,"_21381":122559,"_28049":122560,"_3044":122561},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3588":73123,"_30857":73116,"_21381":122563,"_5":14694,"_28049":73116,"_3044":122564},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3588":73124,"_30857":73116,"_21381":122566,"_5":14694,"_28049":122544,"_3044":122567},[],"Recorrido",{"_3588":73125,"_30857":73116,"_21381":122569,"_5":14694,"_28049":122544,"_3044":122570},[],"Cuándo existe el dispositivo",{"_3588":73126,"_30857":73116,"_21381":122572,"_5":14694,"_28049":122544,"_3044":122573},[],"Qué compruebas",{"_3588":73127,"_30857":73116,"_21381":122575,"_5":14694,"_28049":122544,"_3044":122576},[],"Asignación manual",{"_3588":73128,"_30857":73116,"_21381":122578,"_5":14694,"_28049":122544,"_3044":122579},[],"El operador lo crea antes de asociar un certificado.",{"_3588":73129,"_30857":73116,"_21381":122581,"_5":14694,"_28049":122544,"_3044":122582},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3588":73130,"_30857":73116,"_21381":122584,"_5":14694,"_28049":122544,"_3044":122585},[],"EST con `JITP`",{"_3588":73131,"_30857":73116,"_21381":122587,"_5":14694,"_28049":122544,"_3044":122588},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3588":73132,"_30857":73116,"_21381":122590,"_5":14694,"_28049":122544,"_3044":122591},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3588":73133,"_30857":73116,"_21381":122593,"_5":14694,"_28049":122544,"_3044":122594},[],"EST con `PRE_REGISTRATION`",{"_3588":73134,"_30857":73116,"_21381":122596,"_5":14694,"_28049":122544,"_3044":122597},[],"Debe existir antes de `/simpleenroll`.",{"_3588":73135,"_30857":73116,"_21381":122599,"_5":14694,"_28049":122544,"_3044":122600},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3588":73136,"_30857":73116,"_21381":122602,"_5":14694,"_28049":122544,"_3044":122603},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3588":73137,"_30857":73116,"_21381":122605,"_5":14694,"_28049":122544,"_3044":122606},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3588":73138,"_30857":73116,"_21381":122608,"_5":14694,"_28049":122548,"_3044":122609},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3588":73139,"_30857":73116,"_21381":122611,"_5":14694,"_28049":122548,"_3044":122612},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3588":73140,"_30857":73116,"_21381":122614,"_5":14694,"_28049":122548,"_3044":122615},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3588":73141,"_30857":73116,"_21381":122617,"_5":14694,"_28049":122552,"_3044":122618},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3588":73142,"_30857":73116,"_21381":122620,"_5":14694,"_28049":122552,"_3044":122621},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3588":73143,"_30857":73116,"_21381":122623,"_5":14694,"_28049":122552,"_3044":122624},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3588":73144,"_30857":73116,"_21381":122626,"_5":14694,"_28049":122552,"_3044":122627},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3588":73145,"_30857":73116,"_21381":122629,"_5":14694,"_28049":122552,"_3044":122630},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3588":73146,"_30857":73116,"_21381":122632,"_5":14694,"_28049":122552,"_3044":122633},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3588":73147,"_30857":73116,"_21381":122635,"_5":14694,"_28049":122556,"_3044":119410},[],{"_3588":73148,"_30857":73116,"_21381":122637,"_5":14694,"_28049":122556,"_3044":122638},[],"Material que atraviesa EST",{"_3588":73149,"_30857":73116,"_21381":122640,"_5":14694,"_28049":122556,"_3044":122641},[],"Clave generada por el dispositivo",{"_3588":73150,"_30857":73116,"_21381":122643,"_5":14694,"_28049":122556,"_3044":122644},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3588":73151,"_30857":73116,"_21381":122646,"_5":14694,"_28049":122556,"_3044":122647},[],"Clave ya disponible en el dispositivo",{"_3588":73152,"_30857":73116,"_21381":122649,"_5":14694,"_28049":122556,"_3044":122650},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3588":73153,"_30857":73116,"_21381":122652,"_5":14694,"_28049":122556,"_3044":53408},[],{"_3588":73154,"_30857":73116,"_21381":122654,"_5":14694,"_28049":122556,"_3044":122655},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3588":73155,"_30857":73116,"_21381":122657,"_5":14694,"_28049":122556,"_3044":122658},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3588":73156,"_30857":73116,"_21381":122660,"_5":14694,"_28049":122560,"_3044":122661},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3588":73157,"_30857":73157,"_5":15054,"_3044":122663,"_31195":122664,"_21381":122665,"_28049":73157},"Renovación y recuperación",[50417,120512,53089,121645,121820],[],{"_3588":73158,"_30857":73157,"_21381":122667,"_5":14694,"_28049":73157,"_3044":122668},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3588":73159,"_30857":73157,"_5":31192,"_21381":122670,"_28049":122671,"_3044":122672},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3588":73160,"_30857":73157,"_5":31192,"_21381":122674,"_28049":122675,"_3044":122676},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3588":73161,"_30857":73157,"_5":31192,"_21381":122678,"_28049":122679,"_3044":122680},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3588":73162,"_30857":73157,"_5":31192,"_21381":122682,"_28049":122683,"_3044":122684},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3588":73163,"_30857":73157,"_5":31192,"_21381":122686,"_28049":122687,"_3044":122688},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3588":73164,"_30857":73157,"_21381":122690,"_5":14694,"_28049":73157,"_3044":122691},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3588":73165,"_30857":73157,"_21381":122693,"_5":14694,"_28049":122671,"_3044":122694},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3588":73166,"_30857":73157,"_21381":122696,"_5":14694,"_28049":122671,"_3044":122697},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3588":73167,"_30857":73157,"_21381":122699,"_5":14694,"_28049":122671,"_3044":122700},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3588":73168,"_30857":73157,"_21381":122702,"_5":14694,"_28049":122671,"_3044":122703},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3588":73169,"_30857":73157,"_21381":122705,"_5":14694,"_28049":122675,"_3044":122706},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3588":73170,"_30857":73157,"_21381":122708,"_5":14694,"_28049":122675,"_3044":122709},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3588":73171,"_30857":73157,"_21381":122711,"_5":14694,"_28049":122679,"_3044":122712},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3588":73172,"_30857":73157,"_21381":122714,"_5":14694,"_28049":122679,"_3044":122715},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3588":73173,"_30857":73157,"_21381":122717,"_5":14694,"_28049":122679,"_3044":122718},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3588":73174,"_30857":73157,"_21381":122720,"_5":14694,"_28049":122683,"_3044":122721},[],"Situación",{"_3588":73175,"_30857":73157,"_21381":122723,"_5":14694,"_28049":122683,"_3044":122724},[],"Procedimiento",{"_3588":73176,"_30857":73157,"_21381":122726,"_5":14694,"_28049":122683,"_3044":122727},[],"Certificado vigente, fuera de ventana",{"_3588":73177,"_30857":73157,"_21381":122729,"_5":14694,"_28049":122683,"_3044":122730},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3588":73178,"_30857":73157,"_21381":122732,"_5":14694,"_28049":122683,"_3044":122733},[],"Certificado vencido, clave disponible",{"_3588":73179,"_30857":73157,"_21381":122735,"_5":14694,"_28049":122683,"_3044":122736},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3588":73180,"_30857":73157,"_21381":122738,"_5":14694,"_28049":122683,"_3044":122739},[],"Renovación por webhook o `NO_AUTH`",{"_3588":73181,"_30857":73157,"_21381":122741,"_5":14694,"_28049":122683,"_3044":122742},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3588":73182,"_30857":73157,"_21381":122744,"_5":14694,"_28049":122683,"_3044":122745},[],"Clave perdida o inaccesible",{"_3588":73183,"_30857":73157,"_21381":122747,"_5":14694,"_28049":122683,"_3044":122748},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3588":73184,"_30857":73157,"_21381":122750,"_5":14694,"_28049":122683,"_3044":122751},[],"Identidad actual revocada",{"_3588":73185,"_30857":73157,"_21381":122753,"_5":14694,"_28049":122683,"_3044":122754},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3588":73186,"_30857":73157,"_21381":122756,"_5":14694,"_28049":122683,"_3044":122757},[],"Dispositivo sin identidad",{"_3588":73187,"_30857":73157,"_21381":122759,"_5":14694,"_28049":122683,"_3044":122760},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3588":73188,"_30857":73157,"_21381":122762,"_5":14694,"_28049":122683,"_3044":122763},[],"Dispositivo retirado",{"_3588":73189,"_30857":73157,"_21381":122765,"_5":14694,"_28049":122683,"_3044":122766},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3588":73190,"_30857":73157,"_21381":122768,"_5":14694,"_28049":122683,"_3044":122769},[],"Timeout, HTTP 500 o fallo de instalación",{"_3588":73191,"_30857":73157,"_21381":122771,"_5":14694,"_28049":122683,"_3044":122772},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3588":73192,"_30857":73157,"_21381":122774,"_5":14694,"_28049":122687,"_3044":122775},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3588":73193,"_30857":73157,"_21381":122777,"_5":14694,"_28049":122687,"_3044":122778},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3588":73194,"_30857":73194,"_5":15054,"_3044":122780,"_31195":122781,"_21381":122782,"_28049":73194},"Diagnóstico de enrolamiento",[50417,120512,53089,121645,121820],[],{"_3588":73195,"_30857":73194,"_21381":122784,"_5":14694,"_28049":73194,"_3044":122785},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3588":73196,"_30857":73194,"_5":31192,"_21381":122787,"_28049":122788,"_3044":122789},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3588":73197,"_30857":73194,"_5":31192,"_21381":122791,"_28049":122792,"_3044":122793},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3588":73198,"_30857":73194,"_5":31192,"_21381":122795,"_28049":122796,"_3044":122352},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3588":73199,"_30857":73194,"_5":31192,"_21381":122798,"_28049":122799,"_3044":122800},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3588":73200,"_30857":73194,"_21381":122802,"_5":14694,"_28049":73194,"_3044":122803},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3588":73201,"_30857":73194,"_21381":122805,"_5":14694,"_28049":122792,"_3044":122806},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3588":73202,"_30857":73194,"_21381":122808,"_5":14694,"_28049":122792,"_3044":122809},[],"Síntoma o mensaje",{"_3588":73203,"_30857":73194,"_21381":122811,"_5":14694,"_28049":122792,"_3044":122812},[],"Qué revisar",{"_3588":73204,"_30857":73194,"_21381":122814,"_5":14694,"_28049":122792,"_3044":122815},[],"curl rechaza TLS, nombre o emisor",{"_3588":73205,"_30857":73194,"_21381":122817,"_5":14694,"_28049":122792,"_3044":122818},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3588":73206,"_30857":73194,"_21381":122820,"_5":14694,"_28049":122792,"_3044":122821},[],"404 o APS ausente",{"_3588":73207,"_30857":73194,"_21381":122823,"_5":14694,"_28049":122792,"_3044":122824},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3588":73208,"_30857":73194,"_21381":122826,"_5":14694,"_28049":122792,"_3044":122827},[],"400, error de CSR o formato",{"_3588":73209,"_30857":73194,"_21381":122829,"_5":14694,"_28049":122792,"_3044":122830},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3588":73210,"_30857":73194,"_21381":122832,"_5":14694,"_28049":122792,"_3044":122833},[],"Credencial ausente o certificado no válido",{"_3588":73211,"_30857":73194,"_21381":122835,"_5":14694,"_28049":122792,"_3044":122836},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3588":73212,"_30857":73194,"_21381":122838,"_5":14694,"_28049":122792,"_3044":122839},[],"Webhook deniega, expira o responde sin autorización",{"_3588":73213,"_30857":73194,"_21381":122841,"_5":14694,"_28049":122792,"_3044":122842},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3588":73214,"_30857":73194,"_21381":122844,"_5":14694,"_28049":122792,"_3044":54334},[],{"_3588":73215,"_30857":73194,"_21381":122846,"_5":14694,"_28049":122792,"_3044":122847},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3588":73216,"_30857":73194,"_21381":122849,"_5":14694,"_28049":122792,"_3044":54340},[],{"_3588":73217,"_30857":73194,"_21381":122851,"_5":14694,"_28049":122792,"_3044":122852},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3588":73218,"_30857":73194,"_21381":122854,"_5":14694,"_28049":122792,"_3044":54346},[],{"_3588":73219,"_30857":73194,"_21381":122856,"_5":14694,"_28049":122792,"_3044":122857},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3588":73220,"_30857":73194,"_21381":122859,"_5":14694,"_28049":122792,"_3044":54352},[],{"_3588":73221,"_30857":73194,"_21381":122861,"_5":14694,"_28049":122792,"_3044":122862},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3588":73222,"_30857":73194,"_21381":122864,"_5":14694,"_28049":122792,"_3044":54358},[],{"_3588":73223,"_30857":73194,"_21381":122866,"_5":14694,"_28049":122792,"_3044":122867},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3588":73224,"_30857":73194,"_21381":122869,"_5":14694,"_28049":122792,"_3044":122870},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3588":73225,"_30857":73194,"_21381":122872,"_5":14694,"_28049":122792,"_3044":122873},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3588":73226,"_30857":73194,"_21381":122875,"_5":14694,"_28049":122792,"_3044":122876},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3588":73227,"_30857":73194,"_21381":122878,"_5":14694,"_28049":122792,"_3044":122879},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3588":73228,"_30857":73194,"_21381":122881,"_5":14694,"_28049":122792,"_3044":54376},[],{"_3588":73229,"_30857":73194,"_21381":122883,"_5":14694,"_28049":122792,"_3044":122884},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3588":73230,"_30857":73194,"_21381":122886,"_5":14694,"_28049":122792,"_3044":54382},[],{"_3588":73231,"_30857":73194,"_21381":122888,"_5":14694,"_28049":122792,"_3044":122889},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3588":73232,"_30857":73194,"_21381":122891,"_5":14694,"_28049":122792,"_3044":122892},[],"DMS propietario distinto",{"_3588":73233,"_30857":73194,"_21381":122894,"_5":14694,"_28049":122792,"_3044":122895},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3588":73234,"_30857":73194,"_21381":122897,"_5":14694,"_28049":122792,"_3044":54394},[],{"_3588":73235,"_30857":73194,"_21381":122899,"_5":14694,"_28049":122792,"_3044":122900},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3588":73236,"_30857":73194,"_21381":122902,"_5":14694,"_28049":122792,"_3044":54400},[],{"_3588":73237,"_30857":73194,"_21381":122904,"_5":14694,"_28049":122792,"_3044":122905},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3588":73238,"_30857":73194,"_21381":122907,"_5":14694,"_28049":122792,"_3044":122908},[],"Certificado actual revocado",{"_3588":73239,"_30857":73194,"_21381":122910,"_5":14694,"_28049":122792,"_3044":122911},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3588":73240,"_30857":73194,"_21381":122913,"_5":14694,"_28049":122792,"_3044":122914},[],"Error de CA, perfil o firma",{"_3588":73241,"_30857":73194,"_21381":122916,"_5":14694,"_28049":122792,"_3044":122917},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3588":73242,"_30857":73194,"_21381":122919,"_5":14694,"_28049":122792,"_3044":122920},[],"HTTP 200 sin conexión del dispositivo",{"_3588":73243,"_30857":73194,"_21381":122922,"_5":14694,"_28049":122792,"_3044":122923},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3588":73244,"_30857":73194,"_21381":122925,"_5":14694,"_28049":122792,"_3044":122926},[],"Timeout o error después de emitir",{"_3588":73245,"_30857":73194,"_21381":122928,"_5":14694,"_28049":122792,"_3044":122929},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3588":73246,"_30857":73194,"_21381":122931,"_5":14694,"_28049":122796,"_3044":122932},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3588":73247,"_30857":73194,"_21381":122934,"_5":14694,"_28049":122796,"_3044":122935},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3588":73248,"_30857":73194,"_21381":122937,"_5":14694,"_28049":122799,"_3044":122938},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3588":73249,"_30857":73194,"_21381":122940,"_5":14694,"_28049":122799,"_3044":122941},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3588":73250,"_30857":73194,"_21381":122943,"_5":14694,"_28049":122799,"_3044":122944},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3588":73251,"_30857":73194,"_21381":122946,"_5":14694,"_28049":122799,"_3044":122947},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3588":73252,"_30857":73194,"_21381":122949,"_5":14694,"_28049":122799,"_3044":122950},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3588":73253,"_30857":73194,"_21381":122952,"_5":14694,"_28049":122799,"_3044":122953},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3588":73254,"_30857":73194,"_21381":122955,"_5":14694,"_28049":122799,"_3044":122956},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3588":73255,"_30857":73255,"_5":15054,"_3044":122958,"_31195":122959,"_21381":122960,"_28049":73255},"Distribución y actualización de confianza",[50417,120512,53089,121645,121820],[],{"_3588":73256,"_30857":73255,"_21381":122962,"_5":14694,"_28049":73255,"_3044":122963},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3588":73257,"_30857":73255,"_5":31192,"_21381":122965,"_28049":122966,"_3044":122967},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3588":73258,"_30857":73255,"_5":31192,"_21381":122969,"_28049":122970,"_3044":122971},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3588":73259,"_30857":73255,"_5":31192,"_21381":122973,"_28049":122974,"_3044":122975},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3588":73260,"_30857":73255,"_5":31192,"_21381":122977,"_28049":122978,"_3044":122979},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3588":73261,"_30857":73255,"_5":31192,"_21381":122981,"_28049":122982,"_3044":122983},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3588":73262,"_30857":73255,"_21381":122985,"_5":14694,"_28049":73255,"_3044":122986},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3588":73263,"_30857":73255,"_21381":122988,"_5":14694,"_28049":122966,"_3044":122989},[],"Relación",{"_3588":73264,"_30857":73255,"_21381":122991,"_5":14694,"_28049":122966,"_3044":122992},[],"Material que prepara el responsable",{"_3588":73265,"_30857":73255,"_21381":122994,"_5":14694,"_28049":122966,"_3044":122995},[],"Dispositivo → servidor EST",{"_3588":73266,"_30857":73255,"_21381":122997,"_5":14694,"_28049":122966,"_3044":122998},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3588":73267,"_30857":73255,"_21381":123000,"_5":14694,"_28049":122966,"_3044":123001},[],"DMS → solicitante",{"_3588":73268,"_30857":73255,"_21381":123003,"_5":14694,"_28049":122966,"_3044":123004},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3588":73269,"_30857":73255,"_21381":123006,"_5":14694,"_28049":122966,"_3044":123007},[],"Consumidor → dispositivo",{"_3588":73270,"_30857":73255,"_21381":123009,"_5":14694,"_28049":122966,"_3044":123010},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3588":73271,"_30857":73255,"_21381":123012,"_5":14694,"_28049":122966,"_3044":123013},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3588":73272,"_30857":73255,"_21381":123015,"_5":14694,"_28049":122970,"_3044":123016},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3588":73273,"_30857":73255,"_21381":123018,"_5":14694,"_28049":122970,"_3044":123019},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3588":73274,"_30857":73255,"_21381":123021,"_5":14694,"_28049":122974,"_3044":123022},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3588":73275,"_30857":73255,"_21381":123024,"_5":14694,"_28049":122974,"_3044":123025},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3588":73276,"_30857":73255,"_21381":123027,"_5":14694,"_28049":122974,"_3044":123028},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3588":73277,"_30857":73255,"_21381":123030,"_5":14694,"_28049":122974,"_3044":123031},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3588":73278,"_30857":73255,"_21381":123033,"_5":14694,"_28049":122974,"_3044":123034},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3588":73279,"_30857":73255,"_21381":123036,"_5":14694,"_28049":122974,"_3044":123037},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3588":73280,"_30857":73255,"_21381":123039,"_5":14694,"_28049":122978,"_3044":123040},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3588":73281,"_30857":73255,"_21381":123042,"_5":14694,"_28049":122978,"_3044":123043},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3588":73282,"_30857":73255,"_21381":123045,"_5":14694,"_28049":122978,"_3044":123046},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3588":73283,"_30857":73255,"_21381":123048,"_5":14694,"_28049":122982,"_3044":123049},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3588":73284,"_30857":73284,"_5":15054,"_3044":54549,"_31195":123051,"_21381":123053,"_28049":73284},[50417,120512,53089,121645,123052],"Integraciones",[],{"_3588":73285,"_30857":73284,"_21381":123055,"_5":14694,"_28049":73284,"_3044":123056},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3588":73286,"_30857":73284,"_5":31192,"_21381":123058,"_28049":123059,"_3044":123060},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3588":73287,"_30857":73284,"_5":31192,"_21381":123062,"_28049":123063,"_3044":123064},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3588":73288,"_30857":73284,"_5":31192,"_21381":123066,"_28049":123067,"_3044":123068},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3588":73289,"_30857":73284,"_5":31192,"_21381":123070,"_28049":123071,"_3044":123072},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3588":73290,"_30857":73284,"_5":31192,"_21381":123074,"_28049":123075,"_3044":123076},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3588":73291,"_30857":73284,"_5":31192,"_21381":123078,"_28049":123079,"_3044":123080},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3588":73292,"_30857":73284,"_5":31192,"_21381":123082,"_28049":123083,"_3044":123084},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3588":73293,"_30857":73284,"_5":31192,"_21381":123086,"_28049":123087,"_3044":123088},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3588":73294,"_30857":73284,"_5":31192,"_21381":123090,"_28049":123091,"_3044":54591},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3588":73295,"_30857":73284,"_5":31192,"_21381":123093,"_28049":123094,"_3044":54595},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3588":73296,"_30857":73284,"_5":31192,"_21381":123096,"_28049":123097,"_3044":123098},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3588":73297,"_30857":73284,"_5":31192,"_21381":123100,"_28049":123101,"_3044":123102},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3588":73298,"_30857":73284,"_5":31192,"_21381":123104,"_28049":123105,"_3044":123106},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3588":73299,"_30857":73284,"_5":31192,"_21381":123108,"_28049":123109,"_3044":123110},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3588":73300,"_30857":73284,"_5":31192,"_21381":123112,"_28049":123113,"_3044":123114},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3588":73301,"_30857":73284,"_5":31192,"_21381":123116,"_28049":123117,"_3044":123118},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3588":73302,"_30857":73284,"_5":31192,"_21381":123120,"_28049":123121,"_3044":123122},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3588":73303,"_30857":73284,"_5":31192,"_21381":123124,"_28049":123125,"_3044":123126},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3588":73304,"_30857":73284,"_5":31192,"_21381":123128,"_28049":123129,"_3044":123130},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3588":73305,"_30857":73284,"_5":31192,"_21381":123132,"_28049":123133,"_3044":123134},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3588":73306,"_30857":73284,"_5":31192,"_21381":123136,"_28049":123137,"_3044":123138},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3588":73307,"_30857":73284,"_5":31192,"_21381":123140,"_28049":123141,"_3044":123142},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3588":73308,"_30857":73284,"_5":31192,"_21381":123144,"_28049":123145,"_3044":123146},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3588":73309,"_30857":73284,"_5":31192,"_21381":123148,"_28049":123149,"_3044":123150},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3588":73310,"_30857":73284,"_5":31192,"_21381":123152,"_28049":123153,"_3044":123154},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3588":73311,"_30857":73284,"_21381":123156,"_5":14694,"_28049":73284,"_3044":123157},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3588":73312,"_30857":73284,"_21381":123159,"_5":14694,"_28049":73284,"_3044":123160},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3588":73313,"_30857":73284,"_21381":123162,"_5":14694,"_28049":73284,"_3044":123163},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3588":73314,"_30857":73284,"_21381":123165,"_5":14694,"_28049":123059,"_3044":123166},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3588":73315,"_30857":73284,"_21381":123168,"_5":14694,"_28049":123059,"_3044":123169},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3588":73316,"_30857":73284,"_21381":123171,"_5":14694,"_28049":123059,"_3044":123172},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3588":73317,"_30857":73284,"_21381":123174,"_5":14694,"_28049":123059,"_3044":123175},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3588":73318,"_30857":73284,"_21381":123177,"_5":14694,"_28049":123063,"_3044":123178},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3588":73319,"_30857":73284,"_21381":123180,"_5":14694,"_28049":123067,"_3044":123181},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3588":73320,"_30857":73284,"_21381":123183,"_5":14694,"_28049":123067,"_3044":123184},[],"Acción IAM",{"_3588":73321,"_30857":73284,"_21381":123186,"_5":14694,"_28049":123067,"_3044":119416},[],{"_3588":73322,"_30857":73284,"_21381":123188,"_5":14694,"_28049":123067,"_3044":54690},[],{"_3588":73323,"_30857":73284,"_21381":123190,"_5":14694,"_28049":123067,"_3044":123191},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3588":73324,"_30857":73284,"_21381":123193,"_5":14694,"_28049":123067,"_3044":54696},[],{"_3588":73325,"_30857":73284,"_21381":123195,"_5":14694,"_28049":123067,"_3044":123196},[],"Registrar la CA en AWS IoT",{"_3588":73326,"_30857":73284,"_21381":123198,"_5":14694,"_28049":123067,"_3044":54702},[],{"_3588":73327,"_30857":73284,"_21381":123200,"_5":14694,"_28049":123067,"_3044":123201},[],"Consultar el estado del registro de la CA",{"_3588":73328,"_30857":73284,"_21381":123203,"_5":14694,"_28049":123067,"_3044":54708},[],{"_3588":73329,"_30857":73284,"_21381":123205,"_5":14694,"_28049":123067,"_3044":123206},[],"Crear o actualizar Things en IoT Core",{"_3588":73330,"_30857":73284,"_21381":123208,"_5":14694,"_28049":123067,"_3044":54714},[],{"_3588":73331,"_30857":73284,"_21381":123210,"_5":14694,"_28049":123067,"_3044":123211},[],"Aprovisionar Things mediante plantilla",{"_3588":73332,"_30857":73284,"_21381":123213,"_5":14694,"_28049":123067,"_3044":54720},[],{"_3588":73333,"_30857":73284,"_21381":123215,"_5":14694,"_28049":123067,"_3044":123216},[],"Registrar certificados de dispositivo",{"_3588":73334,"_30857":73284,"_21381":123218,"_5":14694,"_28049":123067,"_3044":54726},[],{"_3588":73335,"_30857":73284,"_21381":123220,"_5":14694,"_28049":123067,"_3044":123221},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3588":73336,"_30857":73284,"_21381":123223,"_5":14694,"_28049":123067,"_3044":54732},[],{"_3588":73337,"_30857":73284,"_21381":123225,"_5":14694,"_28049":123067,"_3044":123226},[],"Crear y adjuntar políticas IoT",{"_3588":73338,"_30857":73284,"_21381":123228,"_5":14694,"_28049":123067,"_3044":54738},[],{"_3588":73339,"_30857":73284,"_21381":123230,"_5":14694,"_28049":123067,"_3044":123231},[],"Gestionar grupos de Things",{"_3588":73340,"_30857":73284,"_21381":123233,"_5":14694,"_28049":123067,"_3044":54744},[],{"_3588":73341,"_30857":73284,"_21381":123235,"_5":14694,"_28049":123067,"_3044":123236},[],"Crear plantillas JITP",{"_3588":73342,"_30857":73284,"_21381":123238,"_5":14694,"_28049":123067,"_3044":54750},[],{"_3588":73343,"_30857":73284,"_21381":123240,"_5":14694,"_28049":123067,"_3044":123241},[],"Leer y escribir el Device Shadow",{"_3588":73344,"_30857":73284,"_21381":123243,"_5":14694,"_28049":123067,"_3044":123244},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3588":73345,"_30857":73284,"_21381":123246,"_5":14694,"_28049":123071,"_3044":123247},[],"Parámetro",{"_3588":73346,"_30857":73284,"_21381":123249,"_5":14694,"_28049":123071,"_3044":123250},[],"Tipo",{"_3588":73347,"_30857":73284,"_21381":123252,"_5":14694,"_28049":123071,"_3044":123253},[],"Requerido",{"_3588":73348,"_30857":73284,"_21381":123255,"_5":14694,"_28049":123071,"_3044":123256},[],"Descripción",{"_3588":73349,"_30857":73284,"_21381":123258,"_5":14694,"_28049":123071,"_3044":54771},[],{"_3588":73350,"_30857":73284,"_21381":123260,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73351,"_30857":73284,"_21381":123262,"_5":14694,"_28049":123071,"_3044":123263},[],"Sí",{"_3588":73352,"_30857":73284,"_21381":123265,"_5":14694,"_28049":123071,"_3044":123266},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3588":73353,"_30857":73284,"_21381":123268,"_5":14694,"_28049":123071,"_3044":54782},[],{"_3588":73354,"_30857":73284,"_21381":123270,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73355,"_30857":73284,"_21381":123272,"_5":14694,"_28049":123071,"_3044":123263},[],{"_3588":73356,"_30857":73284,"_21381":123274,"_5":14694,"_28049":123071,"_3044":123275},[],"Región AWS donde opera el conector.",{"_3588":73357,"_30857":73284,"_21381":123277,"_5":14694,"_28049":123071,"_3044":54792},[],{"_3588":73358,"_30857":73284,"_21381":123279,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73359,"_30857":73284,"_21381":123281,"_5":14694,"_28049":123071,"_3044":123263},[],{"_3588":73360,"_30857":73284,"_21381":123283,"_5":14694,"_28049":123071,"_3044":123284},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3588":73361,"_30857":73284,"_21381":123286,"_5":14694,"_28049":123071,"_3044":54802},[],{"_3588":73362,"_30857":73284,"_21381":123288,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73363,"_30857":73284,"_21381":123290,"_5":14694,"_28049":123071,"_3044":123291},[],"Solo con `auth_method=static`",{"_3588":73364,"_30857":73284,"_21381":123293,"_5":14694,"_28049":123071,"_3044":123294},[],"Clave de acceso AWS.",{"_3588":73365,"_30857":73284,"_21381":123296,"_5":14694,"_28049":123071,"_3044":54813},[],{"_3588":73366,"_30857":73284,"_21381":123298,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73367,"_30857":73284,"_21381":123300,"_5":14694,"_28049":123071,"_3044":123291},[],{"_3588":73368,"_30857":73284,"_21381":123302,"_5":14694,"_28049":123071,"_3044":123303},[],"Clave secreta AWS.",{"_3588":73369,"_30857":73284,"_21381":123305,"_5":14694,"_28049":123071,"_3044":54823},[],{"_3588":73370,"_30857":73284,"_21381":123307,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73371,"_30857":73284,"_21381":123309,"_5":14694,"_28049":123071,"_3044":54828},[],{"_3588":73372,"_30857":73284,"_21381":123311,"_5":14694,"_28049":123071,"_3044":123312},[],"Token de sesión (con `auth_method=static`).",{"_3588":73373,"_30857":73284,"_21381":123314,"_5":14694,"_28049":123071,"_3044":54834},[],{"_3588":73374,"_30857":73284,"_21381":123316,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73375,"_30857":73284,"_21381":123318,"_5":14694,"_28049":123071,"_3044":123319},[],"Solo con `auth_method=role`",{"_3588":73376,"_30857":73284,"_21381":123321,"_5":14694,"_28049":123071,"_3044":123322},[],"ARN del rol a asumir.",{"_3588":73377,"_30857":73284,"_21381":123324,"_5":14694,"_28049":123071,"_3044":54845},[],{"_3588":73378,"_30857":73284,"_21381":123326,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73379,"_30857":73284,"_21381":123328,"_5":14694,"_28049":123071,"_3044":54828},[],{"_3588":73380,"_30857":73284,"_21381":123330,"_5":14694,"_28049":123071,"_3044":123331},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3588":73381,"_30857":73284,"_21381":123333,"_5":14694,"_28049":123071,"_3044":54855},[],{"_3588":73382,"_30857":73284,"_21381":123335,"_5":14694,"_28049":123071,"_3044":91930},[],{"_3588":73383,"_30857":73284,"_21381":123337,"_5":14694,"_28049":123071,"_3044":123263},[],{"_3588":73384,"_30857":73284,"_21381":123339,"_5":14694,"_28049":123071,"_3044":123340},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3588":73385,"_30857":73284,"_21381":123342,"_5":14694,"_28049":123071,"_3044":54865},[],{"_3588":73386,"_30857":73284,"_21381":123344,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73387,"_30857":73284,"_21381":123346,"_5":14694,"_28049":123071,"_3044":123263},[],{"_3588":73388,"_30857":73284,"_21381":123348,"_5":14694,"_28049":123071,"_3044":123349},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3588":73389,"_30857":73284,"_21381":123351,"_5":14694,"_28049":123071,"_3044":54875},[],{"_3588":73390,"_30857":73284,"_21381":123353,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73391,"_30857":73284,"_21381":123355,"_5":14694,"_28049":123071,"_3044":123263},[],{"_3588":73392,"_30857":73284,"_21381":123357,"_5":14694,"_28049":123071,"_3044":123358},[],"URL HTTP del Device Manager de Lamassu.",{"_3588":73393,"_30857":73284,"_21381":123360,"_5":14694,"_28049":123071,"_3044":54885},[],{"_3588":73394,"_30857":73284,"_21381":123362,"_5":14694,"_28049":123071,"_3044":25523},[],{"_3588":73395,"_30857":73284,"_21381":123364,"_5":14694,"_28049":123071,"_3044":123263},[],{"_3588":73396,"_30857":73284,"_21381":123366,"_5":14694,"_28049":123071,"_3044":123367},[],"URL HTTP del servicio de CA de Lamassu.",{"_3588":73397,"_30857":73284,"_21381":123369,"_5":14694,"_28049":123075,"_3044":123370},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3588":73398,"_30857":73284,"_21381":123372,"_5":14694,"_28049":123075,"_3044":123373},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3588":73399,"_30857":73284,"_21381":123375,"_5":14694,"_28049":123075,"_3044":123376},[],"Tipo de CloudEvent",{"_3588":73400,"_30857":73284,"_21381":123378,"_5":14694,"_28049":123075,"_3044":123379},[],"Recurso en Lamassu",{"_3588":73401,"_30857":73284,"_21381":123381,"_5":14694,"_28049":123075,"_3044":123382},[],"Recurso AWS",{"_3588":73402,"_30857":73284,"_21381":123384,"_5":14694,"_28049":123075,"_3044":123385},[],"Acciones IAM",{"_3588":73403,"_30857":73284,"_21381":123387,"_5":14694,"_28049":123075,"_3044":123388},[],"Llamadas AWS y efecto",{"_3588":73404,"_30857":73284,"_21381":123390,"_5":14694,"_28049":123075,"_3044":123391},[],"Dónde en esta página",{"_3588":73405,"_30857":73284,"_21381":123393,"_5":14694,"_28049":123075,"_3044":54919},[],{"_3588":73406,"_30857":73284,"_21381":123395,"_5":14694,"_28049":123075,"_3044":54922},[],{"_3588":73407,"_30857":73284,"_21381":123397,"_5":14694,"_28049":123075,"_3044":54925},[],{"_3588":73408,"_30857":73284,"_21381":123399,"_5":14694,"_28049":123075,"_3044":54928},[],{"_3588":73409,"_30857":73284,"_21381":123401,"_5":14694,"_28049":123075,"_3044":123402},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3588":73410,"_30857":73284,"_21381":123404,"_5":14694,"_28049":123075,"_3044":123088},[],{"_3588":73411,"_30857":73284,"_21381":123406,"_5":14694,"_28049":123075,"_3044":54936},[],{"_3588":73412,"_30857":73284,"_21381":123408,"_5":14694,"_28049":123075,"_3044":54939},[],{"_3588":73413,"_30857":73284,"_21381":123410,"_5":14694,"_28049":123075,"_3044":54942},[],{"_3588":73414,"_30857":73284,"_21381":123412,"_5":14694,"_28049":123075,"_3044":54945},[],{"_3588":73415,"_30857":73284,"_21381":123414,"_5":14694,"_28049":123075,"_3044":123415},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3588":73416,"_30857":73284,"_21381":123417,"_5":14694,"_28049":123075,"_3044":123114},[],{"_3588":73417,"_30857":73284,"_21381":123419,"_5":14694,"_28049":123075,"_3044":54953},[],{"_3588":73418,"_30857":73284,"_21381":123421,"_5":14694,"_28049":123075,"_3044":123422},[],"Dispositivo",{"_3588":73419,"_30857":73284,"_21381":123424,"_5":14694,"_28049":123075,"_3044":54959},[],{"_3588":73420,"_30857":73284,"_21381":123426,"_5":14694,"_28049":123075,"_3044":54962},[],{"_3588":73421,"_30857":73284,"_21381":123428,"_5":14694,"_28049":123075,"_3044":123429},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3588":73422,"_30857":73284,"_21381":123431,"_5":14694,"_28049":123075,"_3044":123122},[],{"_3588":73423,"_30857":73284,"_21381":123433,"_5":14694,"_28049":123075,"_3044":54970},[],{"_3588":73424,"_30857":73284,"_21381":123435,"_5":14694,"_28049":123075,"_3044":123436},[],"Certificado",{"_3588":73425,"_30857":73284,"_21381":123438,"_5":14694,"_28049":123075,"_3044":54976},[],{"_3588":73426,"_30857":73284,"_21381":123440,"_5":14694,"_28049":123075,"_3044":123441},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3588":73427,"_30857":73284,"_21381":123443,"_5":14694,"_28049":123075,"_3044":123444},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3588":73428,"_30857":73284,"_21381":123446,"_5":14694,"_28049":123075,"_3044":123134},[],{"_3588":73429,"_30857":73284,"_21381":123448,"_5":14694,"_28049":123075,"_3044":54987},[],{"_3588":73430,"_30857":73284,"_21381":123450,"_5":14694,"_28049":123075,"_3044":123451},[],"Certificado / Dispositivo",{"_3588":73431,"_30857":73284,"_21381":123453,"_5":14694,"_28049":123075,"_3044":54993},[],{"_3588":73432,"_30857":73284,"_21381":123455,"_5":14694,"_28049":123075,"_3044":50813},[],{"_3588":73433,"_30857":73284,"_21381":123457,"_5":14694,"_28049":123075,"_3044":123458},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3588":73434,"_30857":73284,"_21381":123460,"_5":14694,"_28049":123075,"_3044":123142},[],{"_3588":73435,"_30857":73284,"_21381":123462,"_5":14694,"_28049":123079,"_3044":123463},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3588":73436,"_30857":73284,"_21381":123465,"_5":14694,"_28049":123083,"_3044":123466},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3588":73437,"_30857":73284,"_21381":123468,"_5":14694,"_28049":123083,"_3044":123469},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3588":73438,"_30857":73284,"_21381":123471,"_5":14694,"_28049":123087,"_3044":123472},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3588":73439,"_30857":73284,"_21381":123474,"_5":14694,"_28049":123087,"_3044":123475},[],"Transición",{"_3588":73440,"_30857":73284,"_21381":123477,"_5":14694,"_28049":123087,"_3044":123478},[],"Llamadas AWS",{"_3588":73441,"_30857":73284,"_21381":123480,"_5":14694,"_28049":123087,"_3044":123481},[],"`NoRegistrada` → `Solicitada`",{"_3588":73442,"_30857":73284,"_21381":123483,"_5":14694,"_28049":123087,"_3044":123484},[],"ninguna (solo escritura de metadatos)",{"_3588":73443,"_30857":73284,"_21381":123486,"_5":14694,"_28049":123087,"_3044":123487},[],"`Solicitada` → `Registrando`",{"_3588":73444,"_30857":73284,"_21381":123489,"_5":14694,"_28049":123087,"_3044":123490},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3588":73445,"_30857":73284,"_21381":123492,"_5":14694,"_28049":123087,"_3044":123493},[],"`Registrando` → `Completada`",{"_3588":73446,"_30857":73284,"_21381":123495,"_5":14694,"_28049":123087,"_3044":123496},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3588":73447,"_30857":73284,"_21381":123498,"_5":14694,"_28049":123087,"_3044":123499},[],"`Registrando` → `Fallida`",{"_3588":73448,"_30857":73284,"_21381":123501,"_5":14694,"_28049":123087,"_3044":123502},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3588":73449,"_30857":73284,"_21381":123504,"_5":14694,"_28049":123087,"_3044":123505},[],"`Fallida` / `Completada` → `Solicitada`",{"_3588":73450,"_30857":73284,"_21381":123507,"_5":14694,"_28049":123087,"_3044":123508},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3588":73451,"_30857":73284,"_21381":123510,"_5":14694,"_28049":123091,"_3044":123511},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3588":73452,"_30857":73284,"_21381":123513,"_5":14694,"_28049":123091,"_3044":123514},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3588":73453,"_30857":73284,"_21381":123516,"_5":14694,"_28049":123091,"_3044":123517},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3588":73454,"_30857":73284,"_21381":123519,"_5":14694,"_28049":123091,"_3044":123520},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3588":73455,"_30857":73284,"_21381":123522,"_5":14694,"_28049":123091,"_3044":123523},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3588":73456,"_30857":73284,"_21381":123525,"_5":14694,"_28049":123091,"_3044":123526},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3588":73457,"_30857":73284,"_21381":123528,"_5":14694,"_28049":123094,"_3044":123529},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3588":73458,"_30857":73284,"_21381":123531,"_5":14694,"_28049":123097,"_3044":123532},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3588":73459,"_30857":73284,"_21381":123534,"_5":14694,"_28049":123097,"_3044":123535},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3588":73460,"_30857":73284,"_21381":123537,"_5":14694,"_28049":123101,"_3044":123538},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3588":73461,"_30857":73284,"_21381":123540,"_5":14694,"_28049":123105,"_3044":123541},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3588":73462,"_30857":73284,"_21381":123543,"_5":14694,"_28049":123105,"_3044":123544},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3588":73463,"_30857":73284,"_21381":123546,"_5":14694,"_28049":123105,"_3044":123547},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3588":73464,"_30857":73284,"_21381":123549,"_5":14694,"_28049":123105,"_3044":123550},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3588":73465,"_30857":73284,"_21381":123552,"_5":14694,"_28049":123105,"_3044":123553},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3588":73466,"_30857":73284,"_21381":123555,"_5":14694,"_28049":123105,"_3044":123556},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3588":73467,"_30857":73284,"_21381":123558,"_5":14694,"_28049":123109,"_3044":123559},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3588":73468,"_30857":73284,"_21381":123561,"_5":14694,"_28049":123109,"_3044":123562},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3588":73469,"_30857":73284,"_21381":123564,"_5":14694,"_28049":123109,"_3044":123565},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3588":73470,"_30857":73284,"_21381":123567,"_5":14694,"_28049":123109,"_3044":123568},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3588":73471,"_30857":73284,"_21381":123570,"_5":14694,"_28049":123109,"_3044":123571},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3588":73472,"_30857":73284,"_21381":123573,"_5":14694,"_28049":123113,"_3044":123574},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3588":73473,"_30857":73284,"_21381":123576,"_5":14694,"_28049":123113,"_3044":123475},[],{"_3588":73474,"_30857":73284,"_21381":123578,"_5":14694,"_28049":123113,"_3044":123478},[],{"_3588":73475,"_30857":73284,"_21381":123580,"_5":14694,"_28049":123113,"_3044":123581},[],"`SinConfigurar` → `None` / `Auto`",{"_3588":73476,"_30857":73284,"_21381":123583,"_5":14694,"_28049":123113,"_3044":123584},[],"ninguna (solo configuración)",{"_3588":73477,"_30857":73284,"_21381":123586,"_5":14694,"_28049":123113,"_3044":55130},[],{"_3588":73478,"_30857":73284,"_21381":123588,"_5":14694,"_28049":123113,"_3044":123584},[],{"_3588":73479,"_30857":73284,"_21381":123590,"_5":14694,"_28049":123113,"_3044":123591},[],"Cualquiera → `Jitp`",{"_3588":73480,"_30857":73284,"_21381":123593,"_5":14694,"_28049":123113,"_3044":123594},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3588":73481,"_30857":73284,"_21381":123596,"_5":14694,"_28049":123113,"_3044":55141},[],{"_3588":73482,"_30857":73284,"_21381":123598,"_5":14694,"_28049":123113,"_3044":123599},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3588":73483,"_30857":73284,"_21381":123601,"_5":14694,"_28049":123117,"_3044":123602},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3588":73484,"_30857":73284,"_21381":123604,"_5":14694,"_28049":123117,"_3044":123605},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3588":73485,"_30857":73284,"_21381":123607,"_5":14694,"_28049":123117,"_3044":123608},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3588":73486,"_30857":73284,"_21381":123610,"_5":14694,"_28049":123121,"_3044":123611},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3588":73487,"_30857":73284,"_21381":123613,"_5":14694,"_28049":123121,"_3044":123475},[],{"_3588":73488,"_30857":73284,"_21381":123615,"_5":14694,"_28049":123121,"_3044":123478},[],{"_3588":73489,"_30857":73284,"_21381":123617,"_5":14694,"_28049":123121,"_3044":123618},[],"`Ausente` → `Aprovisionado`",{"_3588":73490,"_30857":73284,"_21381":123620,"_5":14694,"_28049":123121,"_3044":123621},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3588":73491,"_30857":73284,"_21381":123623,"_5":14694,"_28049":123121,"_3044":123624},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3588":73492,"_30857":73284,"_21381":123626,"_5":14694,"_28049":123121,"_3044":123627},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3588":73493,"_30857":73284,"_21381":123629,"_5":14694,"_28049":123121,"_3044":123630},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3588":73494,"_30857":73284,"_21381":123632,"_5":14694,"_28049":123125,"_3044":123633},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3588":73495,"_30857":73284,"_21381":123635,"_5":14694,"_28049":123125,"_3044":123636},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3588":73496,"_30857":73284,"_21381":123638,"_5":14694,"_28049":123125,"_3044":123639},[],"Para que el flujo JITP funcione correctamente:",{"_3588":73497,"_30857":73284,"_21381":123641,"_5":14694,"_28049":123125,"_3044":123642},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3588":73498,"_30857":73284,"_21381":123644,"_5":14694,"_28049":123125,"_3044":123645},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3588":73499,"_30857":73284,"_21381":123647,"_5":14694,"_28049":123125,"_3044":123648},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3588":73500,"_30857":73284,"_21381":123650,"_5":14694,"_28049":123125,"_3044":123651},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3588":73501,"_30857":73284,"_21381":123653,"_5":14694,"_28049":123129,"_3044":123654},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3588":73502,"_30857":73284,"_21381":123656,"_5":14694,"_28049":123129,"_3044":123657},[],"Estado en Lamassu",{"_3588":73503,"_30857":73284,"_21381":123659,"_5":14694,"_28049":123129,"_3044":123660},[],"Razón de revocación",{"_3588":73504,"_30857":73284,"_21381":123662,"_5":14694,"_28049":123129,"_3044":123663},[],"Estado en AWS IoT Core",{"_3588":73505,"_30857":73284,"_21381":123665,"_5":14694,"_28049":123129,"_3044":55211},[],{"_3588":73506,"_30857":73284,"_21381":123667,"_5":14694,"_28049":123129,"_3044":123668},[],"Ninguna",{"_3588":73507,"_30857":73284,"_21381":123670,"_5":14694,"_28049":123129,"_3044":55217},[],{"_3588":73508,"_30857":73284,"_21381":123672,"_5":14694,"_28049":123129,"_3044":55220},[],{"_3588":73509,"_30857":73284,"_21381":123674,"_5":14694,"_28049":123129,"_3044":55223},[],{"_3588":73510,"_30857":73284,"_21381":123676,"_5":14694,"_28049":123129,"_3044":55226},[],{"_3588":73511,"_30857":73284,"_21381":123678,"_5":14694,"_28049":123129,"_3044":55220},[],{"_3588":73512,"_30857":73284,"_21381":123680,"_5":14694,"_28049":123129,"_3044":123681},[],"Cualquier otra razón",{"_3588":73513,"_30857":73284,"_21381":123683,"_5":14694,"_28049":123129,"_3044":55234},[],{"_3588":73514,"_30857":73284,"_21381":123685,"_5":14694,"_28049":123129,"_3044":123686},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3588":73515,"_30857":73284,"_21381":123688,"_5":14694,"_28049":123133,"_3044":123689},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3588":73516,"_30857":73284,"_21381":123691,"_5":14694,"_28049":123133,"_3044":123475},[],{"_3588":73517,"_30857":73284,"_21381":123693,"_5":14694,"_28049":123133,"_3044":123478},[],{"_3588":73518,"_30857":73284,"_21381":123695,"_5":14694,"_28049":123133,"_3044":123696},[],"`NoSincronizado` → `Active`",{"_3588":73519,"_30857":73284,"_21381":123698,"_5":14694,"_28049":123133,"_3044":54726},[],{"_3588":73520,"_30857":73284,"_21381":123700,"_5":14694,"_28049":123133,"_3044":55252},[],{"_3588":73521,"_30857":73284,"_21381":123702,"_5":14694,"_28049":123133,"_3044":123703},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3588":73522,"_30857":73284,"_21381":123705,"_5":14694,"_28049":123133,"_3044":55258},[],{"_3588":73523,"_30857":73284,"_21381":123707,"_5":14694,"_28049":123133,"_3044":123703},[],{"_3588":73524,"_30857":73284,"_21381":123709,"_5":14694,"_28049":123133,"_3044":55263},[],{"_3588":73525,"_30857":73284,"_21381":123711,"_5":14694,"_28049":123133,"_3044":54726},[],{"_3588":73526,"_30857":73284,"_21381":123713,"_5":14694,"_28049":123133,"_3044":55268},[],{"_3588":73527,"_30857":73284,"_21381":123715,"_5":14694,"_28049":123133,"_3044":123716},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3588":73528,"_30857":73284,"_21381":123718,"_5":14694,"_28049":123137,"_3044":123719},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3588":73529,"_30857":73284,"_21381":123721,"_5":14694,"_28049":123137,"_3044":123722},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3588":73530,"_30857":73284,"_21381":123724,"_5":14694,"_28049":123137,"_3044":123725},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3588":73531,"_30857":73284,"_21381":123727,"_5":14694,"_28049":123141,"_3044":123728},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3588":73532,"_30857":73284,"_21381":123730,"_5":14694,"_28049":123141,"_3044":123731},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3588":73533,"_30857":73284,"_21381":123733,"_5":14694,"_28049":123145,"_3044":123734},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3588":73534,"_30857":73284,"_21381":123736,"_5":14694,"_28049":123145,"_3044":123737},[],"Existen dos tipos de acciones:",{"_3588":73535,"_30857":73284,"_21381":123739,"_5":14694,"_28049":123145,"_3044":123740},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3588":73536,"_30857":73284,"_21381":123742,"_5":14694,"_28049":123145,"_3044":123743},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3588":73537,"_30857":73284,"_21381":123745,"_5":14694,"_28049":123145,"_3044":123746},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3588":73538,"_30857":73284,"_21381":123748,"_5":14694,"_28049":123149,"_3044":123749},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3588":73539,"_30857":73284,"_21381":123751,"_5":14694,"_28049":123149,"_3044":123752},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3588":73540,"_30857":73284,"_21381":123754,"_5":14694,"_28049":123149,"_3044":123755},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3588":73541,"_30857":73284,"_21381":123757,"_5":14694,"_28049":123153,"_3044":123758},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3588":73542,"_30857":73284,"_21381":123760,"_5":14694,"_28049":123153,"_3044":123761},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3588":73543,"_30857":73284,"_21381":123763,"_5":14694,"_28049":123153,"_3044":123764},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3588":73544,"_30857":73284,"_21381":123766,"_5":14694,"_28049":123153,"_3044":123767},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3588":73545,"_30857":73284,"_21381":123769,"_5":14694,"_28049":123153,"_3044":123770},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3588":73546,"_30857":73284,"_21381":123772,"_5":14694,"_28049":123153,"_3044":123773},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3588":73547,"_30857":73284,"_21381":123775,"_5":14694,"_28049":123153,"_3044":123776},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3588":73548,"_30857":73284,"_21381":123778,"_5":14694,"_28049":123153,"_3044":123779},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3588":73549,"_30857":73284,"_21381":123781,"_5":14694,"_28049":123153,"_3044":123782},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3588":73550,"_30857":73284,"_21381":123784,"_5":14694,"_28049":123153,"_3044":123785},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3588":73551,"_30857":73284,"_21381":123787,"_5":14694,"_28049":123153,"_3044":123788},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3588":73552,"_30857":73284,"_21381":123790,"_5":14694,"_28049":123153,"_3044":123791},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3588":73553,"_30857":73284,"_21381":123793,"_5":14694,"_28049":123153,"_3044":123794},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3588":73554,"_30857":73284,"_21381":123796,"_5":14694,"_28049":123153,"_3044":123797},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3588":73555,"_30857":73284,"_21381":123799,"_5":14694,"_28049":123153,"_3044":123800},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3588":73556,"_30857":73284,"_21381":123802,"_5":14694,"_28049":123153,"_3044":123803},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3588":73557,"_30857":73284,"_21381":123805,"_5":14694,"_28049":123153,"_3044":123806},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3588":73558,"_30857":73284,"_21381":123808,"_5":14694,"_28049":123153,"_3044":123809},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3588":73559,"_30857":73284,"_21381":123811,"_5":14694,"_28049":123153,"_3044":123812},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3588":73560,"_30857":73284,"_21381":123814,"_5":14694,"_28049":123153,"_3044":123815},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3588":73561,"_30857":73284,"_21381":123817,"_5":14694,"_28049":123153,"_3044":123818},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3588":73562,"_30857":73284,"_21381":123820,"_5":14694,"_28049":123153,"_3044":123821},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3588":73563,"_30857":73284,"_21381":123823,"_5":14694,"_28049":123153,"_3044":123824},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3588":73564,"_30857":73284,"_21381":123826,"_5":14694,"_28049":123153,"_3044":123827},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3588":73565,"_30857":73565,"_5":15054,"_3044":53089,"_31195":123829,"_21381":123830,"_28049":73565},[50417,120512,53089],[],{"_3588":73566,"_30857":73565,"_21381":123832,"_5":14694,"_28049":73565,"_3044":123833},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3588":73567,"_30857":73565,"_5":31192,"_21381":123835,"_28049":123836,"_3044":123837},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3588":73568,"_30857":73565,"_5":31192,"_21381":123839,"_28049":123840,"_3044":121645},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3588":73569,"_30857":73565,"_5":31192,"_21381":123842,"_28049":123843,"_3044":121820},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3588":73570,"_30857":73565,"_5":31192,"_21381":123845,"_28049":123846,"_3044":123052},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3588":73571,"_30857":73565,"_5":31192,"_21381":123848,"_28049":123849,"_3044":123850},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3588":73572,"_30857":73565,"_21381":123852,"_5":14694,"_28049":73565,"_3044":123853},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3588":73573,"_30857":73565,"_21381":123855,"_5":14694,"_28049":123836,"_3044":123856},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3588":73574,"_30857":73565,"_21381":123858,"_5":14694,"_28049":123836,"_3044":123859},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3588":73575,"_30857":73565,"_21381":123861,"_5":14694,"_28049":123840,"_3044":123862},[],"Recurso",{"_3588":73576,"_30857":73565,"_21381":123864,"_5":14694,"_28049":123840,"_3044":123865},[],"Qué representa",{"_3588":73577,"_30857":73565,"_21381":123867,"_5":14694,"_28049":123840,"_3044":123868},[],"**Dispositivo**",{"_3588":73578,"_30857":73565,"_21381":123870,"_5":14694,"_28049":123840,"_3044":123871},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3588":73579,"_30857":73565,"_21381":123873,"_5":14694,"_28049":123840,"_3044":123874},[],"**Identidad**",{"_3588":73580,"_30857":73565,"_21381":123876,"_5":14694,"_28049":123840,"_3044":123877},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3588":73581,"_30857":73565,"_21381":123879,"_5":14694,"_28049":123840,"_3044":55435},[],{"_3588":73582,"_30857":73565,"_21381":123881,"_5":14694,"_28049":123840,"_3044":123882},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3588":73583,"_30857":73565,"_21381":123884,"_5":14694,"_28049":123840,"_3044":123885},[],"**Flota**",{"_3588":73584,"_30857":73565,"_21381":123887,"_5":14694,"_28049":123840,"_3044":123888},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3588":73585,"_30857":73565,"_21381":123890,"_5":14694,"_28049":123840,"_3044":123891},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3588":73586,"_30857":73565,"_21381":123893,"_5":14694,"_28049":123840,"_3044":123894},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3588":73587,"_30857":73565,"_21381":123896,"_5":14694,"_28049":123843,"_3044":123897},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3588":73588,"_30857":73565,"_21381":123899,"_5":14694,"_28049":123843,"_3044":123900},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3588":73589,"_30857":73565,"_21381":123902,"_5":14694,"_28049":123843,"_3044":123903},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3588":73590,"_30857":73565,"_21381":123905,"_5":14694,"_28049":123843,"_3044":123906},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3588":73591,"_30857":73565,"_21381":123908,"_5":14694,"_28049":123843,"_3044":123909},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3588":73592,"_30857":73565,"_21381":123911,"_5":14694,"_28049":123843,"_3044":123912},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3588":73593,"_30857":73565,"_21381":123914,"_5":14694,"_28049":123843,"_3044":123915},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3588":73594,"_30857":73565,"_21381":123917,"_5":14694,"_28049":123843,"_3044":123918},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3588":73595,"_30857":73565,"_21381":123920,"_5":14694,"_28049":123846,"_3044":123921},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3588":73596,"_30857":73565,"_21381":123923,"_5":14694,"_28049":123846,"_3044":123924},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3588":73597,"_30857":73565,"_21381":123926,"_5":14694,"_28049":123849,"_3044":123927},[],"Participante",{"_3588":73598,"_30857":73565,"_21381":123929,"_5":14694,"_28049":123849,"_3044":123930},[],"Responsabilidad",{"_3588":73599,"_30857":73565,"_21381":123932,"_5":14694,"_28049":123849,"_3044":123933},[],"Administrador PKI",{"_3588":73600,"_30857":73565,"_21381":123935,"_5":14694,"_28049":123849,"_3044":123936},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3588":73601,"_30857":73565,"_21381":123938,"_5":14694,"_28049":123849,"_3044":123939},[],"Administrador del aprovisionamiento",{"_3588":73602,"_30857":73565,"_21381":123941,"_5":14694,"_28049":123849,"_3044":123942},[],"DMS, admisión, autenticación por operación e inventario.",{"_3588":73603,"_30857":73565,"_21381":123944,"_5":14694,"_28049":123849,"_3044":123945},[],"Integrador del dispositivo",{"_3588":73604,"_30857":73565,"_21381":123947,"_5":14694,"_28049":123849,"_3044":123948},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3588":73605,"_30857":73565,"_21381":123950,"_5":14694,"_28049":123849,"_3044":123951},[],"Integrador del consumidor",{"_3588":73606,"_30857":73565,"_21381":123953,"_5":14694,"_28049":123849,"_3044":123954},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3588":73607,"_30857":73565,"_21381":123956,"_5":14694,"_28049":123849,"_3044":123957},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3588":73608,"_30857":73608,"_5":15054,"_3044":123959,"_31195":123960,"_21381":123962,"_28049":73608},"Enrola y conecta tu primer dispositivo",[50417,120512,53089,123961],"Primeros pasos",[],{"_3588":73609,"_30857":73608,"_21381":123964,"_5":14694,"_28049":73608,"_3044":123965},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3588":73610,"_30857":73608,"_5":31192,"_21381":123967,"_28049":123968,"_3044":119046},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3588":73611,"_30857":73608,"_5":31192,"_21381":123970,"_28049":123971,"_3044":123972},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3588":73612,"_30857":73608,"_5":31192,"_21381":123974,"_28049":123975,"_3044":123976},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3588":73613,"_30857":73608,"_5":31192,"_21381":123978,"_28049":123979,"_3044":123980},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3588":73614,"_30857":73608,"_5":31192,"_21381":123982,"_28049":123983,"_3044":123984},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3588":73615,"_30857":73608,"_5":31192,"_21381":123986,"_28049":123987,"_3044":123988},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3588":73616,"_30857":73608,"_5":31192,"_21381":123990,"_28049":123991,"_3044":123992},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3588":73617,"_30857":73608,"_5":31192,"_21381":123994,"_28049":123995,"_3044":123996},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3588":73618,"_30857":73608,"_21381":123998,"_5":14694,"_28049":73608,"_3044":123999},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3588":73619,"_30857":73608,"_21381":124001,"_5":14694,"_28049":123968,"_3044":124002},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3588":73620,"_30857":73608,"_21381":124004,"_5":14694,"_28049":123968,"_3044":124005},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3588":73621,"_30857":73608,"_21381":124007,"_5":14694,"_28049":123968,"_3044":124008},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3588":73622,"_30857":73608,"_21381":124010,"_5":14694,"_28049":123968,"_3044":124011},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3588":73623,"_30857":73608,"_21381":124013,"_5":14694,"_28049":123968,"_3044":124014},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3588":73624,"_30857":73608,"_21381":124016,"_5":14694,"_28049":123971,"_3044":124017},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3588":73625,"_30857":73608,"_21381":124019,"_5":14694,"_28049":123971,"_3044":124020},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3588":73626,"_30857":73608,"_21381":124022,"_5":14694,"_28049":123975,"_3044":124023},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3588":73627,"_30857":73608,"_21381":124025,"_5":14694,"_28049":123975,"_3044":124026},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3588":73628,"_30857":73608,"_21381":124028,"_5":14694,"_28049":123975,"_3044":124029},[],"Ajuste",{"_3588":73629,"_30857":73608,"_21381":124031,"_5":14694,"_28049":123975,"_3044":124032},[],"Valor de evaluación",{"_3588":73630,"_30857":73608,"_21381":124034,"_5":14694,"_28049":123975,"_3044":55591},[],{"_3588":73631,"_30857":73608,"_21381":124036,"_5":14694,"_28049":123975,"_3044":124037},[],"Raíz emisora de `device-root.pem`.",{"_3588":73632,"_30857":73608,"_21381":124039,"_5":14694,"_28049":123975,"_3044":121948},[],{"_3588":73633,"_30857":73608,"_21381":124041,"_5":14694,"_28049":123975,"_3044":124042},[],"Perfil final de 1 hora que acabas de preparar.",{"_3588":73634,"_30857":73608,"_21381":124044,"_5":14694,"_28049":123975,"_3044":55602},[],{"_3588":73635,"_30857":73608,"_21381":124046,"_5":14694,"_28049":123975,"_3044":55605},[],{"_3588":73636,"_30857":73608,"_21381":124048,"_5":14694,"_28049":123975,"_3044":55608},[],{"_3588":73637,"_30857":73608,"_21381":124050,"_5":14694,"_28049":123975,"_3044":124051},[],"Habilitado.",{"_3588":73638,"_30857":73608,"_21381":124053,"_5":14694,"_28049":123975,"_3044":55614},[],{"_3588":73639,"_30857":73608,"_21381":124055,"_5":14694,"_28049":123975,"_3044":124056},[],"Deshabilitado; el ID debe ser nuevo.",{"_3588":73640,"_30857":73608,"_21381":124058,"_5":14694,"_28049":123975,"_3044":124059},[],"Autenticación inicial",{"_3588":73641,"_30857":73608,"_21381":124061,"_5":14694,"_28049":123975,"_3044":124062},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3588":73642,"_30857":73608,"_21381":124064,"_5":14694,"_28049":123975,"_3044":124065},[],"Autenticación de renovación",{"_3588":73643,"_30857":73608,"_21381":124067,"_5":14694,"_28049":123975,"_3044":124068},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3588":73644,"_30857":73608,"_21381":124070,"_5":14694,"_28049":123975,"_3044":55632},[],{"_3588":73645,"_30857":73608,"_21381":124072,"_5":14694,"_28049":123975,"_3044":124073},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3588":73646,"_30857":73608,"_21381":124075,"_5":14694,"_28049":123975,"_3044":55638},[],{"_3588":73647,"_30857":73608,"_21381":124077,"_5":14694,"_28049":123975,"_3044":124078},[],"1 hora.",{"_3588":73648,"_30857":73608,"_21381":124080,"_5":14694,"_28049":123975,"_3044":55644},[],{"_3588":73649,"_30857":73608,"_21381":124082,"_5":14694,"_28049":123975,"_3044":124083},[],"30 minutos / 10 minutos.",{"_3588":73650,"_30857":73608,"_21381":124085,"_5":14694,"_28049":123975,"_3044":55650},[],{"_3588":73651,"_30857":73608,"_21381":124087,"_5":14694,"_28049":123975,"_3044":124088},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3588":73652,"_30857":73608,"_21381":124090,"_5":14694,"_28049":123975,"_3044":53408},[],{"_3588":73653,"_30857":73608,"_21381":124092,"_5":14694,"_28049":123975,"_3044":124093},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3588":73654,"_30857":73608,"_21381":124095,"_5":14694,"_28049":123975,"_3044":55661},[],{"_3588":73655,"_30857":73608,"_21381":124097,"_5":14694,"_28049":123975,"_3044":124098},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3588":73656,"_30857":73608,"_21381":124100,"_5":14694,"_28049":123975,"_3044":124101},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3588":73657,"_30857":73608,"_21381":124103,"_5":14694,"_28049":123979,"_3044":124104},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3588":73658,"_30857":73608,"_21381":124106,"_5":14694,"_28049":123979,"_3044":124107},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3588":73659,"_30857":73608,"_21381":124109,"_5":14694,"_28049":123983,"_3044":124110},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3588":73660,"_30857":73608,"_21381":124112,"_5":14694,"_28049":123983,"_3044":124113},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3588":73661,"_30857":73608,"_21381":124115,"_5":14694,"_28049":123983,"_3044":124116},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3588":73662,"_30857":73608,"_21381":124118,"_5":14694,"_28049":123987,"_3044":124119},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3588":73663,"_30857":73608,"_21381":124121,"_5":14694,"_28049":123987,"_3044":124122},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3588":73664,"_30857":73608,"_21381":124124,"_5":14694,"_28049":123991,"_3044":124125},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3588":73665,"_30857":73608,"_21381":124127,"_5":14694,"_28049":123991,"_3044":124128},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3588":73666,"_30857":73608,"_21381":124130,"_5":14694,"_28049":123991,"_3044":124131},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3588":73667,"_30857":73608,"_21381":124133,"_5":14694,"_28049":123991,"_3044":124134},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3588":73668,"_30857":73608,"_21381":124136,"_5":14694,"_28049":123991,"_3044":124137},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3588":73669,"_30857":73608,"_21381":124139,"_5":14694,"_28049":123995,"_3044":124140},[],"Comprobación",{"_3588":73670,"_30857":73608,"_21381":124142,"_5":14694,"_28049":123995,"_3044":124143},[],"Resultado esperado",{"_3588":73671,"_30857":73608,"_21381":124145,"_5":14694,"_28049":123995,"_3044":124146},[],"Registro",{"_3588":73672,"_30857":73608,"_21381":124148,"_5":14694,"_28049":123995,"_3044":124149},[],"ID creado automáticamente y DMS correcto.",{"_3588":73673,"_30857":73608,"_21381":124151,"_5":14694,"_28049":123995,"_3044":123436},[],{"_3588":73674,"_30857":73608,"_21381":124153,"_5":14694,"_28049":123995,"_3044":124154},[],"CN, perfil, serie y clave verificados.",{"_3588":73675,"_30857":73608,"_21381":124156,"_5":14694,"_28049":123995,"_3044":124157},[],"Inventario",{"_3588":73676,"_30857":73608,"_21381":124159,"_5":14694,"_28049":123995,"_3044":124160},[],"Serie recibida visible como identidad actual y en el historial.",{"_3588":73677,"_30857":73608,"_21381":124162,"_5":14694,"_28049":123995,"_3044":124163},[],"Consumidor",{"_3588":73678,"_30857":73608,"_21381":124165,"_5":14694,"_28049":123995,"_3044":124166},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3588":73679,"_30857":73608,"_21381":124168,"_5":14694,"_28049":123995,"_3044":124169},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3588":73680,"_30857":73608,"_21381":124171,"_5":14694,"_28049":123995,"_3044":124172},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3588":73681,"_30857":73681,"_5":15054,"_3044":121662,"_31195":124174,"_21381":124175,"_28049":73681},[50417,120512,53089,123961],[],{"_3588":73682,"_30857":73681,"_21381":124177,"_5":14694,"_28049":73681,"_3044":124178},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3588":73683,"_30857":73681,"_5":31192,"_21381":124180,"_28049":124181,"_3044":119046},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3588":73684,"_30857":73681,"_5":31192,"_21381":124183,"_28049":124184,"_3044":124185},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3588":73685,"_30857":73681,"_5":31192,"_21381":124187,"_28049":124188,"_3044":124189},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3588":73686,"_30857":73681,"_5":31192,"_21381":124191,"_28049":124192,"_3044":124193},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3588":73687,"_30857":73681,"_5":31192,"_21381":124195,"_28049":124196,"_3044":124197},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3588":73688,"_30857":73681,"_5":31192,"_21381":124199,"_28049":124200,"_3044":124201},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3588":73689,"_30857":73681,"_5":31192,"_21381":124203,"_28049":124204,"_3044":124143},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3588":73690,"_30857":73681,"_5":31192,"_21381":124206,"_28049":124207,"_3044":124208},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3588":73691,"_30857":73681,"_5":31192,"_21381":124210,"_28049":124211,"_3044":124212},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3588":73692,"_30857":73681,"_21381":124214,"_5":14694,"_28049":73681,"_3044":124215},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3588":73693,"_30857":73681,"_21381":124217,"_5":14694,"_28049":73681,"_3044":124218},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3588":73694,"_30857":73681,"_21381":124220,"_5":14694,"_28049":124181,"_3044":124221},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3588":73695,"_30857":73681,"_21381":124223,"_5":14694,"_28049":124181,"_3044":124224},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3588":73696,"_30857":73681,"_21381":124226,"_5":14694,"_28049":124181,"_3044":124227},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3588":73697,"_30857":73681,"_21381":124229,"_5":14694,"_28049":124181,"_3044":124230},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3588":73698,"_30857":73681,"_21381":124232,"_5":14694,"_28049":124184,"_3044":124233},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3588":73699,"_30857":73681,"_21381":124235,"_5":14694,"_28049":124184,"_3044":124236},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3588":73700,"_30857":73681,"_21381":124238,"_5":14694,"_28049":124184,"_3044":124239},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3588":73701,"_30857":73681,"_21381":124241,"_5":14694,"_28049":124184,"_3044":124242},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3588":73702,"_30857":73681,"_21381":124244,"_5":14694,"_28049":124184,"_3044":124245},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3588":73703,"_30857":73681,"_21381":124247,"_5":14694,"_28049":124184,"_3044":124248},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3588":73704,"_30857":73681,"_21381":124250,"_5":14694,"_28049":124184,"_3044":124251},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3588":73705,"_30857":73681,"_21381":124253,"_5":14694,"_28049":124184,"_3044":124254},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3588":73706,"_30857":73681,"_21381":124256,"_5":14694,"_28049":124188,"_3044":124257},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3588":73707,"_30857":73681,"_21381":124259,"_5":14694,"_28049":124188,"_3044":55826},[],{"_3588":73708,"_30857":73681,"_21381":124261,"_5":14694,"_28049":124188,"_3044":124262},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3588":73709,"_30857":73681,"_21381":124264,"_5":14694,"_28049":124188,"_3044":124265},[],"**Icon** y **Tags**: clasificación opcional.",{"_3588":73710,"_30857":73681,"_21381":124267,"_5":14694,"_28049":124188,"_3044":124268},[],"Confirma el registro.",{"_3588":73711,"_30857":73681,"_21381":124270,"_5":14694,"_28049":124192,"_3044":124271},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3588":73712,"_30857":73681,"_21381":124273,"_5":14694,"_28049":124192,"_3044":124274},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3588":73713,"_30857":73681,"_21381":124276,"_5":14694,"_28049":124196,"_3044":124277},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3588":73714,"_30857":73681,"_21381":124279,"_5":14694,"_28049":124196,"_3044":124280},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3588":73715,"_30857":73681,"_21381":124282,"_5":14694,"_28049":124200,"_3044":124283},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3588":73716,"_30857":73681,"_21381":124285,"_5":14694,"_28049":124200,"_3044":124286},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3588":73717,"_30857":73681,"_21381":124288,"_5":14694,"_28049":124204,"_3044":124140},[],{"_3588":73718,"_30857":73681,"_21381":124290,"_5":14694,"_28049":124204,"_3044":124291},[],"Resultado",{"_3588":73719,"_30857":73681,"_21381":124293,"_5":14694,"_28049":124204,"_3044":123422},[],{"_3588":73720,"_30857":73681,"_21381":124295,"_5":14694,"_28049":124204,"_3044":124296},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3588":73721,"_30857":73681,"_21381":124298,"_5":14694,"_28049":124204,"_3044":124299},[],"Identidad actual",{"_3588":73722,"_30857":73681,"_21381":124301,"_5":14694,"_28049":124204,"_3044":124302},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3588":73723,"_30857":73681,"_21381":124304,"_5":14694,"_28049":124204,"_3044":124305},[],"Historial",{"_3588":73724,"_30857":73681,"_21381":124307,"_5":14694,"_28049":124204,"_3044":124308},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3588":73725,"_30857":73681,"_21381":124310,"_5":14694,"_28049":124204,"_3044":124311},[],"Clave y certificado",{"_3588":73726,"_30857":73681,"_21381":124313,"_5":14694,"_28049":124204,"_3044":124314},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3588":73727,"_30857":73681,"_21381":124316,"_5":14694,"_28049":124207,"_3044":124317},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3588":73728,"_30857":73681,"_21381":124319,"_5":14694,"_28049":124207,"_3044":124320},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3588":73729,"_30857":73681,"_21381":124322,"_5":14694,"_28049":124207,"_3044":124323},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3588":73730,"_30857":73681,"_21381":124325,"_5":14694,"_28049":124207,"_3044":124326},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3588":73731,"_30857":73681,"_21381":124328,"_5":14694,"_28049":124211,"_3044":124329},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3588":73732,"_30857":73681,"_21381":124331,"_5":14694,"_28049":124211,"_3044":124332},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3588":73733,"_30857":73681,"_21381":124334,"_5":14694,"_28049":124211,"_3044":124335},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3588":73734,"_30857":73734,"_5":15054,"_3044":124337,"_31195":124338,"_21381":124339,"_28049":73734},"Plataforma Lamassu IoT",[50417,120512],[],{"_3588":73735,"_30857":73734,"_21381":124341,"_5":14694,"_28049":73734,"_3044":124342},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3588":73736,"_30857":73734,"_5":31192,"_21381":124344,"_28049":124345,"_3044":123837},[],"/docs/es/platform/overview#empieza-aquí",{"_3588":73737,"_30857":73734,"_5":31192,"_21381":124347,"_28049":124348,"_3044":124349},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3588":73738,"_30857":73734,"_5":31192,"_21381":124351,"_28049":124352,"_3044":124353},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3588":73739,"_30857":73734,"_5":31192,"_21381":124355,"_28049":124356,"_3044":124357},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3588":73740,"_30857":73734,"_5":31192,"_21381":124359,"_28049":124360,"_3044":124361},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3588":73741,"_30857":73734,"_5":31192,"_21381":124363,"_28049":124364,"_3044":124365},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3588":73742,"_30857":73734,"_5":31192,"_21381":124367,"_28049":124368,"_3044":124369},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3588":73743,"_30857":73734,"_5":31192,"_21381":124371,"_28049":124372,"_3044":124373},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3588":73744,"_30857":73734,"_5":31192,"_21381":124375,"_28049":124376,"_3044":124377},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3588":73745,"_30857":73734,"_5":31192,"_21381":124379,"_28049":124380,"_3044":124381},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3588":73746,"_30857":73734,"_5":31192,"_21381":124383,"_28049":124384,"_3044":124385},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3588":73747,"_30857":73734,"_21381":124387,"_5":14694,"_28049":73734,"_3044":124388},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3588":73748,"_30857":73734,"_21381":124390,"_5":14694,"_28049":124345,"_3044":124391},[],"Elige el resultado que necesitas obtener:",{"_3588":73749,"_30857":73734,"_21381":124393,"_5":14694,"_28049":124345,"_3044":124394},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3588":73750,"_30857":73734,"_21381":124396,"_5":14694,"_28049":124345,"_3044":124397},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3588":73751,"_30857":73734,"_21381":124399,"_5":14694,"_28049":124345,"_3044":124400},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3588":73752,"_30857":73734,"_21381":124402,"_5":14694,"_28049":124348,"_3044":124403},[],"Bloque",{"_3588":73753,"_30857":73734,"_21381":124405,"_5":14694,"_28049":124348,"_3044":124406},[],"Qué gestionas",{"_3588":73754,"_30857":73734,"_21381":124408,"_5":14694,"_28049":124348,"_3044":124409},[],"Punto de entrada",{"_3588":73755,"_30857":73734,"_21381":124411,"_5":14694,"_28049":124348,"_3044":55979},[],{"_3588":73756,"_30857":73734,"_21381":124413,"_5":14694,"_28049":124348,"_3044":124414},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3588":73757,"_30857":73734,"_21381":124416,"_5":14694,"_28049":124348,"_3044":124417},[],"Visión general de PKI",{"_3588":73758,"_30857":73734,"_21381":124419,"_5":14694,"_28049":124348,"_3044":55988},[],{"_3588":73759,"_30857":73734,"_21381":124421,"_5":14694,"_28049":124348,"_3044":124422},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3588":73760,"_30857":73734,"_21381":124424,"_5":14694,"_28049":124348,"_3044":124425},[],"Visión general de IoT Fleets",{"_3588":73761,"_30857":73734,"_21381":124427,"_5":14694,"_28049":124348,"_3044":124428},[],"**Administración**",{"_3588":73762,"_30857":73734,"_21381":124430,"_5":14694,"_28049":124348,"_3044":124431},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3588":73763,"_30857":73734,"_21381":124433,"_5":14694,"_28049":124348,"_3044":120514},[],{"_3588":73764,"_30857":73734,"_21381":124435,"_5":14694,"_28049":124348,"_3044":124436},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3588":73765,"_30857":73734,"_21381":124438,"_5":14694,"_28049":124352,"_3044":124439},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3588":73766,"_30857":73734,"_21381":124441,"_5":14694,"_28049":124352,"_3044":124442},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3588":73767,"_30857":73734,"_21381":124444,"_5":14694,"_28049":124352,"_3044":124445},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3588":73768,"_30857":73734,"_21381":124447,"_5":14694,"_28049":124352,"_3044":124448},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3588":73769,"_30857":73734,"_21381":124450,"_5":14694,"_28049":124352,"_3044":124451},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3588":73770,"_30857":73734,"_21381":124453,"_5":14694,"_28049":124352,"_3044":124454},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3588":73771,"_30857":73734,"_21381":124456,"_5":14694,"_28049":124360,"_3044":124457},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3588":73772,"_30857":73734,"_21381":124459,"_5":14694,"_28049":124364,"_3044":124460},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3588":73773,"_30857":73734,"_21381":124462,"_5":14694,"_28049":124368,"_3044":124463},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3588":73774,"_30857":73734,"_21381":124465,"_5":14694,"_28049":124372,"_3044":124466},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3588":73775,"_30857":73734,"_21381":124468,"_5":14694,"_28049":124376,"_3044":124469},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3588":73776,"_30857":73734,"_21381":124471,"_5":14694,"_28049":124380,"_3044":124472},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3588":73777,"_30857":73734,"_21381":124474,"_5":14694,"_28049":124384,"_3044":123930},[],{"_3588":73778,"_30857":73734,"_21381":124476,"_5":14694,"_28049":124384,"_3044":124477},[],"Qué prepara o comprueba",{"_3588":73779,"_30857":73734,"_21381":124479,"_5":14694,"_28049":124384,"_3044":123933},[],{"_3588":73780,"_30857":73734,"_21381":124481,"_5":14694,"_28049":124384,"_3044":124482},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3588":73781,"_30857":73734,"_21381":124484,"_5":14694,"_28049":124384,"_3044":124485},[],"Administrador de la flota",{"_3588":73782,"_30857":73734,"_21381":124487,"_5":14694,"_28049":124384,"_3044":124488},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3588":73783,"_30857":73734,"_21381":124490,"_5":14694,"_28049":124384,"_3044":123945},[],{"_3588":73784,"_30857":73734,"_21381":124492,"_5":14694,"_28049":124384,"_3044":124493},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3588":73785,"_30857":73734,"_21381":124495,"_5":14694,"_28049":124384,"_3044":123951},[],{"_3588":73786,"_30857":73734,"_21381":124497,"_5":14694,"_28049":124384,"_3044":124498},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3588":73787,"_30857":73734,"_21381":124500,"_5":14694,"_28049":124384,"_3044":124501},[],"Operador de infraestructura",{"_3588":73788,"_30857":73734,"_21381":124503,"_5":14694,"_28049":124384,"_3044":124504},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3588":73789,"_30857":73734,"_21381":124506,"_5":14694,"_28049":124384,"_3044":124507},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3588":73790,"_30857":73790,"_5":15054,"_3044":124509,"_31195":124510,"_21381":124512,"_28049":73790},"Jerarquía y rotación de CAs",[50417,120512,56080,124511],"Claves, autoridades y certificados",[],{"_3588":73791,"_30857":73790,"_21381":124514,"_5":14694,"_28049":73790,"_3044":124515},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3588":73792,"_30857":73790,"_5":31192,"_21381":124517,"_28049":124518,"_3044":124519},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3588":73793,"_30857":73790,"_5":31192,"_21381":124521,"_28049":124522,"_3044":124523},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3588":73794,"_30857":73790,"_5":31192,"_21381":124525,"_28049":124526,"_3044":124527},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3588":73795,"_30857":73790,"_5":31192,"_21381":124529,"_28049":124530,"_3044":124531},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3588":73796,"_30857":73790,"_5":31192,"_21381":124533,"_28049":124534,"_3044":124535},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3588":73797,"_30857":73790,"_5":31192,"_21381":124537,"_28049":124538,"_3044":124539},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3588":73798,"_30857":73790,"_5":31192,"_21381":124541,"_28049":124542,"_3044":124543},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3588":73799,"_30857":73790,"_5":31192,"_21381":124545,"_28049":124546,"_3044":124547},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3588":73800,"_30857":73790,"_5":31192,"_21381":124549,"_28049":124550,"_3044":124551},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3588":73801,"_30857":73790,"_5":31192,"_21381":124553,"_28049":124554,"_3044":124555},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3588":73802,"_30857":73790,"_5":31192,"_21381":124557,"_28049":124558,"_3044":124559},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3588":73803,"_30857":73790,"_5":31192,"_21381":124561,"_28049":124562,"_3044":124563},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3588":73804,"_30857":73790,"_21381":124565,"_5":14694,"_28049":73790,"_3044":124566},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3588":73805,"_30857":73790,"_21381":124568,"_5":14694,"_28049":73790,"_3044":124569},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3588":73806,"_30857":73790,"_21381":124571,"_5":14694,"_28049":124518,"_3044":124572},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3588":73807,"_30857":73790,"_21381":124574,"_5":14694,"_28049":124518,"_3044":124575},[],"entorno, como producción y preproducción;",{"_3588":73808,"_30857":73790,"_21381":124577,"_5":14694,"_28049":124518,"_3044":124578},[],"propietario o equipo operador;",{"_3588":73809,"_30857":73790,"_21381":124580,"_5":14694,"_28049":124518,"_3044":124581},[],"familia de dispositivos o proceso de fabricación;",{"_3588":73810,"_30857":73790,"_21381":124583,"_5":14694,"_28049":124518,"_3044":124584},[],"región o requisito regulatorio;",{"_3588":73811,"_30857":73790,"_21381":124586,"_5":14694,"_28049":124518,"_3044":124587},[],"motor criptográfico o política de clave;",{"_3588":73812,"_30857":73790,"_21381":124589,"_5":14694,"_28049":124518,"_3044":124590},[],"ventana de mantenimiento y ritmo de renovación.",{"_3588":73813,"_30857":73790,"_21381":124592,"_5":14694,"_28049":124518,"_3044":124593},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3588":73814,"_30857":73790,"_21381":124595,"_5":14694,"_28049":124518,"_3044":124596},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3588":73815,"_30857":73790,"_21381":124598,"_5":14694,"_28049":124522,"_3044":124599},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3588":73816,"_30857":73790,"_21381":124601,"_5":14694,"_28049":124522,"_3044":124602},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3588":73817,"_30857":73790,"_21381":124604,"_5":14694,"_28049":124522,"_3044":124605},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3588":73818,"_30857":73790,"_21381":124607,"_5":14694,"_28049":124522,"_3044":124608},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3588":73819,"_30857":73790,"_21381":124610,"_5":14694,"_28049":124526,"_3044":124611},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3588":73820,"_30857":73790,"_21381":124613,"_5":14694,"_28049":124526,"_3044":124614},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3588":73821,"_30857":73790,"_21381":124616,"_5":14694,"_28049":124526,"_3044":124617},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3588":73822,"_30857":73790,"_21381":124619,"_5":14694,"_28049":124526,"_3044":124620},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3588":73823,"_30857":73790,"_21381":124622,"_5":14694,"_28049":124534,"_3044":124623},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3588":73824,"_30857":73790,"_21381":124625,"_5":14694,"_28049":124538,"_3044":124626},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3588":73825,"_30857":73790,"_21381":124628,"_5":14694,"_28049":124542,"_3044":124629},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3588":73826,"_30857":73790,"_21381":124631,"_5":14694,"_28049":124546,"_3044":124632},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3588":73827,"_30857":73790,"_21381":124634,"_5":14694,"_28049":124550,"_3044":124635},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3588":73828,"_30857":73790,"_21381":124637,"_5":14694,"_28049":124554,"_3044":124638},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3588":73829,"_30857":73790,"_21381":124640,"_5":14694,"_28049":124558,"_3044":124641},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3588":73830,"_30857":73790,"_21381":124643,"_5":14694,"_28049":124558,"_3044":124644},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3588":73831,"_30857":73790,"_21381":124646,"_5":14694,"_28049":124558,"_3044":124647},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3588":73832,"_30857":73790,"_21381":124649,"_5":14694,"_28049":124558,"_3044":124650},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3588":73833,"_30857":73790,"_21381":124652,"_5":14694,"_28049":124562,"_3044":124653},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3588":73834,"_30857":73790,"_21381":124655,"_5":14694,"_28049":124562,"_3044":124656},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3588":73835,"_30857":73790,"_21381":124658,"_5":14694,"_28049":124562,"_3044":124659},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3588":73836,"_30857":73790,"_21381":124661,"_5":14694,"_28049":124562,"_3044":124662},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3588":73837,"_30857":73790,"_21381":124664,"_5":14694,"_28049":124562,"_3044":124665},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3588":73838,"_30857":73790,"_21381":124667,"_5":14694,"_28049":124562,"_3044":124668},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3588":73839,"_30857":73790,"_21381":124670,"_5":14694,"_28049":124562,"_3044":124671},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3588":73840,"_30857":73840,"_5":15054,"_3044":124673,"_31195":124674,"_21381":124675,"_28049":73840},"Autoridades de certificación",[50417,120512,56080,124511],[],{"_3588":73841,"_30857":73840,"_21381":124677,"_5":14694,"_28049":73840,"_3044":124678},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3588":73842,"_30857":73840,"_5":31192,"_21381":124680,"_28049":124681,"_3044":124682},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3588":73843,"_30857":73840,"_5":31192,"_21381":124684,"_28049":124685,"_3044":124686},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3588":73844,"_30857":73840,"_5":31192,"_21381":124688,"_28049":124689,"_3044":119046},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3588":73845,"_30857":73840,"_5":31192,"_21381":124691,"_28049":124692,"_3044":124693},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3588":73846,"_30857":73840,"_5":31192,"_21381":124695,"_28049":124696,"_3044":124697},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3588":73847,"_30857":73840,"_5":31192,"_21381":124699,"_28049":124700,"_3044":124701},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3588":73848,"_30857":73840,"_5":31192,"_21381":124703,"_28049":124704,"_3044":124705},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3588":73849,"_30857":73840,"_5":31192,"_21381":124707,"_28049":124708,"_3044":124709},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3588":73850,"_30857":73840,"_5":31192,"_21381":124711,"_28049":124712,"_3044":124713},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3588":73851,"_30857":73840,"_5":31192,"_21381":124715,"_28049":124716,"_3044":124717},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3588":73852,"_30857":73840,"_5":31192,"_21381":124719,"_28049":124720,"_3044":124721},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3588":73853,"_30857":73840,"_5":31192,"_21381":124723,"_28049":124724,"_3044":124725},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3588":73854,"_30857":73840,"_5":31192,"_21381":124727,"_28049":124728,"_3044":124729},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3588":73855,"_30857":73840,"_5":31192,"_21381":124731,"_28049":124732,"_3044":124733},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3588":73856,"_30857":73840,"_5":31192,"_21381":124735,"_28049":124736,"_3044":124737},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3588":73857,"_30857":73840,"_5":31192,"_21381":124739,"_28049":124740,"_3044":124741},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3588":73858,"_30857":73840,"_5":31192,"_21381":124743,"_28049":124744,"_3044":124745},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3588":73859,"_30857":73840,"_5":31192,"_21381":124747,"_28049":124748,"_3044":124749},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3588":73860,"_30857":73840,"_5":31192,"_21381":124751,"_28049":124752,"_3044":124753},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3588":73861,"_30857":73840,"_5":31192,"_21381":124755,"_28049":124756,"_3044":124757},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3588":73862,"_30857":73840,"_5":31192,"_21381":124759,"_28049":124760,"_3044":124761},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3588":73863,"_30857":73840,"_5":31192,"_21381":124763,"_28049":124764,"_3044":124765},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3588":73864,"_30857":73840,"_5":31192,"_21381":124767,"_28049":124768,"_3044":124769},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3588":73865,"_30857":73840,"_21381":124771,"_5":14694,"_28049":73840,"_3044":124772},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3588":73866,"_30857":73840,"_21381":124774,"_5":14694,"_28049":73840,"_3044":124775},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3588":73867,"_30857":73840,"_21381":124777,"_5":14694,"_28049":73840,"_3044":124778},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3588":73868,"_30857":73840,"_21381":124780,"_5":14694,"_28049":124681,"_3044":124781},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3588":73869,"_30857":73840,"_21381":124783,"_5":14694,"_28049":124681,"_3044":124784},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3588":73870,"_30857":73840,"_21381":124786,"_5":14694,"_28049":124681,"_3044":124787},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3588":73871,"_30857":73840,"_21381":124789,"_5":14694,"_28049":124681,"_3044":124790},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3588":73872,"_30857":73840,"_21381":124792,"_5":14694,"_28049":124681,"_3044":124793},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3588":73873,"_30857":73840,"_21381":124795,"_5":14694,"_28049":124689,"_3044":124796},[],"Decide si la CA será raíz o intermedia.",{"_3588":73874,"_30857":73840,"_21381":124798,"_5":14694,"_28049":124689,"_3044":124799},[],"Elige el motor que custodiará la clave.",{"_3588":73875,"_30857":73840,"_21381":124801,"_5":14694,"_28049":124689,"_3044":124802},[],"Define una validez superior a la de los certificados que emitirá.",{"_3588":73876,"_30857":73840,"_21381":124804,"_5":14694,"_28049":124689,"_3044":124805},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3588":73877,"_30857":73840,"_21381":124807,"_5":14694,"_28049":124692,"_3044":124808},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3588":73878,"_30857":73840,"_21381":124810,"_5":14694,"_28049":124696,"_3044":124811},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3588":73879,"_30857":73840,"_21381":124813,"_5":14694,"_28049":124696,"_3044":124814},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3588":73880,"_30857":73840,"_21381":124816,"_5":14694,"_28049":124700,"_3044":124817},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3588":73881,"_30857":73840,"_21381":124819,"_5":14694,"_28049":124704,"_3044":124820},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3588":73882,"_30857":73840,"_21381":124822,"_5":14694,"_28049":124704,"_3044":124823},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3588":73883,"_30857":73840,"_21381":124825,"_5":14694,"_28049":124704,"_3044":124826},[],"`ST`: estado o provincia.",{"_3588":73884,"_30857":73840,"_21381":124828,"_5":14694,"_28049":124704,"_3044":124829},[],"`L`: localidad.",{"_3588":73885,"_30857":73840,"_21381":124831,"_5":14694,"_28049":124704,"_3044":124832},[],"`O`: organización.",{"_3588":73886,"_30857":73840,"_21381":124834,"_5":14694,"_28049":124704,"_3044":124835},[],"`OU`: unidad organizativa.",{"_3588":73887,"_30857":73840,"_21381":124837,"_5":14694,"_28049":124704,"_3044":124838},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3588":73888,"_30857":73840,"_21381":124840,"_5":14694,"_28049":124708,"_3044":124841},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3588":73889,"_30857":73840,"_21381":124843,"_5":14694,"_28049":124708,"_3044":124844},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3588":73890,"_30857":73840,"_21381":124846,"_5":14694,"_28049":124712,"_3044":124847},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3588":73891,"_30857":73840,"_21381":124849,"_5":14694,"_28049":124712,"_3044":124850},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3588":73892,"_30857":73840,"_21381":124852,"_5":14694,"_28049":124716,"_3044":124853},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3588":73893,"_30857":73840,"_21381":124855,"_5":14694,"_28049":124716,"_3044":124856},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3588":73894,"_30857":73840,"_21381":124858,"_5":14694,"_28049":124720,"_3044":124859},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3588":73895,"_30857":73840,"_21381":124861,"_5":14694,"_28049":124720,"_3044":124862},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3588":73896,"_30857":73840,"_21381":124864,"_5":14694,"_28049":124720,"_3044":124865},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3588":73897,"_30857":73840,"_21381":124867,"_5":14694,"_28049":124724,"_3044":124868},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3588":73898,"_30857":73840,"_21381":124870,"_5":14694,"_28049":124728,"_3044":124871},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3588":73899,"_30857":73840,"_21381":124873,"_5":14694,"_28049":124728,"_3044":124874},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3588":73900,"_30857":73840,"_21381":124876,"_5":14694,"_28049":124732,"_3044":124877},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3588":73901,"_30857":73840,"_21381":124879,"_5":14694,"_28049":124736,"_3044":124880},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3588":73902,"_30857":73840,"_21381":124882,"_5":14694,"_28049":124736,"_3044":124883},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3588":73903,"_30857":73840,"_21381":124885,"_5":14694,"_28049":124740,"_3044":124886},[],"Abre una CA desde el inventario para consultar:",{"_3588":73904,"_30857":73840,"_21381":124888,"_5":14694,"_28049":124740,"_3044":124889},[],"Estado y periodo de validez.",{"_3588":73905,"_30857":73840,"_21381":124891,"_5":14694,"_28049":124740,"_3044":124892},[],"Certificado y cadena en formato PEM.",{"_3588":73906,"_30857":73840,"_21381":124894,"_5":14694,"_28049":124740,"_3044":124895},[],"Número de certificados activos, expirados y revocados.",{"_3588":73907,"_30857":73840,"_21381":124897,"_5":14694,"_28049":124740,"_3044":124898},[],"Certificados emitidos en **Issued Certificates**.",{"_3588":73908,"_30857":73840,"_21381":124900,"_5":14694,"_28049":124740,"_3044":124901},[],"CRL vinculada a la autoridad.",{"_3588":73909,"_30857":73840,"_21381":124903,"_5":14694,"_28049":124740,"_3044":124904},[],"Metadatos y motor criptográfico asociado.",{"_3588":73910,"_30857":73840,"_21381":124906,"_5":14694,"_28049":124740,"_3044":124907},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3588":73911,"_30857":73840,"_21381":124909,"_5":14694,"_28049":124744,"_3044":124910},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3588":73912,"_30857":73840,"_21381":124912,"_5":14694,"_28049":124744,"_3044":124913},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3588":73913,"_30857":73840,"_21381":124915,"_5":14694,"_28049":124744,"_3044":124916},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3588":73914,"_30857":73840,"_21381":124918,"_5":14694,"_28049":124744,"_3044":124919},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3588":73915,"_30857":73840,"_21381":124921,"_5":14694,"_28049":124748,"_3044":124922},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3588":73916,"_30857":73840,"_21381":124924,"_5":14694,"_28049":124752,"_3044":124925},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3588":73917,"_30857":73840,"_21381":124927,"_5":14694,"_28049":124756,"_3044":124928},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3588":73918,"_30857":73840,"_21381":124930,"_5":14694,"_28049":124760,"_3044":124931},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3588":73919,"_30857":73840,"_21381":124933,"_5":14694,"_28049":124764,"_3044":124934},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3588":73920,"_30857":73840,"_21381":124936,"_5":14694,"_28049":124768,"_3044":124937},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3588":73921,"_30857":73840,"_21381":124939,"_5":14694,"_28049":124768,"_3044":124940},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3588":73922,"_30857":73840,"_21381":124942,"_5":14694,"_28049":124768,"_3044":124943},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3588":73923,"_30857":73840,"_21381":124945,"_5":14694,"_28049":124768,"_3044":124946},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3588":73924,"_30857":73924,"_5":15054,"_3044":124948,"_31195":124949,"_21381":124950,"_28049":73924},"Perfiles de certificado",[50417,120512,56080,124511],[],{"_3588":73925,"_30857":73924,"_21381":124952,"_5":14694,"_28049":73924,"_3044":124953},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3588":73926,"_30857":73924,"_5":31192,"_21381":124955,"_28049":124956,"_3044":124957},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3588":73927,"_30857":73924,"_5":31192,"_21381":124959,"_28049":124960,"_3044":124961},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3588":73928,"_30857":73924,"_5":31192,"_21381":124963,"_28049":124964,"_3044":124965},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3588":73929,"_30857":73924,"_5":31192,"_21381":124967,"_28049":124968,"_3044":124969},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3588":73930,"_30857":73924,"_5":31192,"_21381":124971,"_28049":124972,"_3044":124973},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3588":73931,"_30857":73924,"_5":31192,"_21381":124975,"_28049":124976,"_3044":124977},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3588":73932,"_30857":73924,"_5":31192,"_21381":124979,"_28049":124980,"_3044":124981},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3588":73933,"_30857":73924,"_5":31192,"_21381":124983,"_28049":124984,"_3044":124985},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3588":73934,"_30857":73924,"_5":31192,"_21381":124987,"_28049":124988,"_3044":124989},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3588":73935,"_30857":73924,"_5":31192,"_21381":124991,"_28049":124992,"_3044":124993},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3588":73936,"_30857":73924,"_5":31192,"_21381":124995,"_28049":124996,"_3044":124997},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3588":73937,"_30857":73924,"_5":31192,"_21381":124999,"_28049":125000,"_3044":125001},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3588":73938,"_30857":73924,"_5":31192,"_21381":125003,"_28049":125004,"_3044":125005},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3588":73939,"_30857":73924,"_5":31192,"_21381":125007,"_28049":125008,"_3044":125009},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3588":73940,"_30857":73924,"_5":31192,"_21381":125011,"_28049":125012,"_3044":125013},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3588":73941,"_30857":73924,"_5":31192,"_21381":125015,"_28049":125016,"_3044":125017},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3588":73942,"_30857":73924,"_21381":125019,"_5":14694,"_28049":73924,"_3044":125020},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3588":73943,"_30857":73924,"_21381":125022,"_5":14694,"_28049":73924,"_3044":125023},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3588":73944,"_30857":73924,"_21381":125025,"_5":14694,"_28049":124960,"_3044":125026},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3588":73945,"_30857":73924,"_21381":125028,"_5":14694,"_28049":124960,"_3044":125029},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3588":73946,"_30857":73924,"_21381":125031,"_5":14694,"_28049":124964,"_3044":125032},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3588":73947,"_30857":73924,"_21381":125034,"_5":14694,"_28049":124968,"_3044":125035},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3588":73948,"_30857":73924,"_21381":125037,"_5":14694,"_28049":124968,"_3044":125038},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3588":73949,"_30857":73924,"_21381":125040,"_5":14694,"_28049":124968,"_3044":125041},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3588":73950,"_30857":73924,"_21381":125043,"_5":14694,"_28049":124972,"_3044":125044},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3588":73951,"_30857":73924,"_21381":125046,"_5":14694,"_28049":124976,"_3044":125047},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3588":73952,"_30857":73924,"_21381":125049,"_5":14694,"_28049":124976,"_3044":125050},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3588":73953,"_30857":73924,"_21381":125052,"_5":14694,"_28049":124980,"_3044":125053},[],"La aplicación criptográfica puede:",{"_3588":73954,"_30857":73924,"_21381":125055,"_5":14694,"_28049":124980,"_3044":125056},[],"permitir o bloquear claves RSA;",{"_3588":73955,"_30857":73924,"_21381":125058,"_5":14694,"_28049":124980,"_3044":125059},[],"limitar los tamaños RSA admitidos;",{"_3588":73956,"_30857":73924,"_21381":125061,"_5":14694,"_28049":124980,"_3044":125062},[],"permitir o bloquear claves ECDSA;",{"_3588":73957,"_30857":73924,"_21381":125064,"_5":14694,"_28049":124980,"_3044":125065},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3588":73958,"_30857":73924,"_21381":125067,"_5":14694,"_28049":124980,"_3044":125068},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3588":73959,"_30857":73924,"_21381":125070,"_5":14694,"_28049":124984,"_3044":125071},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3588":73960,"_30857":73924,"_21381":125073,"_5":14694,"_28049":124984,"_3044":120272},[],{"_3588":73961,"_30857":73924,"_21381":125075,"_5":14694,"_28049":124984,"_3044":125076},[],"Primera opción",{"_3588":73962,"_30857":73924,"_21381":125078,"_5":14694,"_28049":124984,"_3044":125079},[],"Segunda opción",{"_3588":73963,"_30857":73924,"_21381":125081,"_5":14694,"_28049":124984,"_3044":125082},[],"Si no hay ninguna",{"_3588":73964,"_30857":73924,"_21381":125084,"_5":14694,"_28049":124984,"_3044":125085},[],"Firma directa con una CA",{"_3588":73965,"_30857":73924,"_21381":125087,"_5":14694,"_28049":124984,"_3044":125088},[],"`issuance_profile` incluido en la solicitud",{"_3588":73966,"_30857":73924,"_21381":125090,"_5":14694,"_28049":124984,"_3044":125091},[],"`issuance_profile_id` de la solicitud",{"_3588":73967,"_30857":73924,"_21381":125093,"_5":14694,"_28049":124984,"_3044":125094},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3588":73968,"_30857":73924,"_21381":125096,"_5":14694,"_28049":124984,"_3044":125097},[],"Emisión mediante DMS",{"_3588":73969,"_30857":73924,"_21381":125099,"_5":14694,"_28049":124984,"_3044":56670},[],{"_3588":73970,"_30857":73924,"_21381":125101,"_5":14694,"_28049":124984,"_3044":125102},[],"`settings.issuance_profile` incluido en el DMS",{"_3588":73971,"_30857":73924,"_21381":125104,"_5":14694,"_28049":124984,"_3044":125105},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3588":73972,"_30857":73924,"_21381":125107,"_5":14694,"_28049":124984,"_3044":125108},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3588":73973,"_30857":73924,"_21381":125110,"_5":14694,"_28049":124984,"_3044":125111},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3588":73974,"_30857":73924,"_21381":125113,"_5":14694,"_28049":124992,"_3044":125114},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3588":73975,"_30857":73924,"_21381":125116,"_5":14694,"_28049":124996,"_3044":125117},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3588":73976,"_30857":73924,"_21381":125119,"_5":14694,"_28049":125000,"_3044":125120},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3588":73977,"_30857":73924,"_21381":125122,"_5":14694,"_28049":125004,"_3044":125123},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3588":73978,"_30857":73924,"_21381":125125,"_5":14694,"_28049":125008,"_3044":125126},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3588":73979,"_30857":73924,"_21381":125128,"_5":14694,"_28049":125008,"_3044":125129},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3588":73980,"_30857":73924,"_21381":125131,"_5":14694,"_28049":125012,"_3044":125132},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3588":73981,"_30857":73924,"_21381":125134,"_5":14694,"_28049":125012,"_3044":125135},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3588":73982,"_30857":73924,"_21381":125137,"_5":14694,"_28049":125012,"_3044":125138},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3588":73983,"_30857":73924,"_21381":125140,"_5":14694,"_28049":125012,"_3044":125141},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3588":73984,"_30857":73924,"_21381":125143,"_5":14694,"_28049":125016,"_3044":125144},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3588":73985,"_30857":73924,"_21381":125146,"_5":14694,"_28049":125016,"_3044":125147},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3588":73986,"_30857":73986,"_5":15054,"_3044":125149,"_31195":125150,"_21381":125152,"_28049":73986},"Validación de certificados",[50417,120512,56080,125151],"Validación",[],{"_3588":73987,"_30857":73986,"_21381":125154,"_5":14694,"_28049":73986,"_3044":125155},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3588":73988,"_30857":73986,"_5":31192,"_21381":125157,"_28049":125158,"_3044":125159},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3588":73989,"_30857":73986,"_5":31192,"_21381":125161,"_28049":125162,"_3044":125163},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3588":73990,"_30857":73986,"_5":31192,"_21381":125165,"_28049":125166,"_3044":125167},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3588":73991,"_30857":73986,"_21381":125169,"_5":14694,"_28049":73986,"_3044":125170},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3588":73992,"_30857":73986,"_21381":125172,"_5":14694,"_28049":125158,"_3044":125173},[],"Verifica estos criterios juntos:",{"_3588":73993,"_30857":73986,"_21381":125175,"_5":14694,"_28049":125158,"_3044":124140},[],{"_3588":73994,"_30857":73986,"_21381":125177,"_5":14694,"_28049":125158,"_3044":125178},[],"Resultado necesario",{"_3588":73995,"_30857":73986,"_21381":125180,"_5":14694,"_28049":125158,"_3044":125181},[],"Cadena y firma",{"_3588":73996,"_30857":73986,"_21381":125183,"_5":14694,"_28049":125158,"_3044":125184},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3588":73997,"_30857":73986,"_21381":125186,"_5":14694,"_28049":125158,"_3044":125187},[],"Fechas",{"_3588":73998,"_30857":73986,"_21381":125189,"_5":14694,"_28049":125158,"_3044":125190},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3588":73999,"_30857":73986,"_21381":125192,"_5":14694,"_28049":125158,"_3044":120182},[],{"_3588":74000,"_30857":73986,"_21381":125194,"_5":14694,"_28049":125158,"_3044":125195},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3588":74001,"_30857":73986,"_21381":125197,"_5":14694,"_28049":125158,"_3044":125198},[],"Uso",{"_3588":74002,"_30857":73986,"_21381":125200,"_5":14694,"_28049":125158,"_3044":125201},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3588":74003,"_30857":73986,"_21381":125203,"_5":14694,"_28049":125158,"_3044":125204},[],"Revocación",{"_3588":74004,"_30857":73986,"_21381":125206,"_5":14694,"_28049":125158,"_3044":125207},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3588":74005,"_30857":73986,"_21381":125209,"_5":14694,"_28049":125158,"_3044":125210},[],"Autorización",{"_3588":74006,"_30857":73986,"_21381":125212,"_5":14694,"_28049":125158,"_3044":125213},[],"La aplicación permite la acción a esa identidad.",{"_3588":74007,"_30857":73986,"_21381":125215,"_5":14694,"_28049":125158,"_3044":125216},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3588":74008,"_30857":73986,"_21381":125218,"_5":14694,"_28049":125162,"_3044":125219},[],"Mecanismo",{"_3588":74009,"_30857":73986,"_21381":125221,"_5":14694,"_28049":125162,"_3044":125222},[],"Cuándo utilizarlo",{"_3588":74010,"_30857":73986,"_21381":125224,"_5":14694,"_28049":125162,"_3044":125225},[],"Qué debes mantener",{"_3588":74011,"_30857":73986,"_21381":125227,"_5":14694,"_28049":125162,"_3044":56798},[],{"_3588":74012,"_30857":73986,"_21381":125229,"_5":14694,"_28049":125162,"_3044":125230},[],"Consulta del estado de un certificado concreto.",{"_3588":74013,"_30857":73986,"_21381":125232,"_5":14694,"_28049":125162,"_3044":125233},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3588":74014,"_30857":73986,"_21381":125235,"_5":14694,"_28049":125162,"_3044":56807},[],{"_3588":74015,"_30857":73986,"_21381":125237,"_5":14694,"_28049":125162,"_3044":125238},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3588":74016,"_30857":73986,"_21381":125240,"_5":14694,"_28049":125162,"_3044":125241},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3588":74017,"_30857":73986,"_21381":125243,"_5":14694,"_28049":125162,"_3044":125244},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3588":74018,"_30857":73986,"_21381":125246,"_5":14694,"_28049":125162,"_3044":125247},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3588":74019,"_30857":73986,"_21381":125249,"_5":14694,"_28049":125166,"_3044":125250},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3588":74020,"_30857":73986,"_21381":125252,"_5":14694,"_28049":125166,"_3044":125253},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3588":74021,"_30857":73986,"_21381":125255,"_5":14694,"_28049":125166,"_3044":125256},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3588":74022,"_30857":73986,"_21381":125258,"_5":14694,"_28049":125166,"_3044":125259},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3588":74023,"_30857":73986,"_21381":125261,"_5":14694,"_28049":125166,"_3044":125262},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3588":74024,"_30857":73986,"_21381":125264,"_5":14694,"_28049":125166,"_3044":125265},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3588":74025,"_30857":73986,"_21381":125267,"_5":14694,"_28049":125166,"_3044":125268},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3588":74026,"_30857":73986,"_21381":125270,"_5":14694,"_28049":125166,"_3044":125271},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3588":74027,"_30857":73986,"_21381":125273,"_5":14694,"_28049":125166,"_3044":125274},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3588":74028,"_30857":74028,"_5":15054,"_3044":125276,"_31195":125277,"_21381":125278,"_28049":74028},"Certificados",[50417,120512,56080,124511],[],{"_3588":74029,"_30857":74028,"_21381":125280,"_5":14694,"_28049":74028,"_3044":125281},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3588":74030,"_30857":74028,"_5":31192,"_21381":125283,"_28049":125284,"_3044":125285},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3588":74031,"_30857":74028,"_5":31192,"_21381":125287,"_28049":125288,"_3044":125289},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3588":74032,"_30857":74028,"_5":31192,"_21381":125291,"_28049":125292,"_3044":125293},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3588":74033,"_30857":74028,"_5":31192,"_21381":125295,"_28049":125296,"_3044":125297},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3588":74034,"_30857":74028,"_5":31192,"_21381":125299,"_28049":125300,"_3044":125301},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3588":74035,"_30857":74028,"_5":31192,"_21381":125303,"_28049":125304,"_3044":125305},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3588":74036,"_30857":74028,"_5":31192,"_21381":125307,"_28049":125308,"_3044":125309},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3588":74037,"_30857":74028,"_5":31192,"_21381":125311,"_28049":125312,"_3044":125313},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3588":74038,"_30857":74028,"_5":31192,"_21381":125315,"_28049":125316,"_3044":125317},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3588":74039,"_30857":74028,"_21381":125319,"_5":14694,"_28049":74028,"_3044":125320},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3588":74040,"_30857":74028,"_21381":125322,"_5":14694,"_28049":125284,"_3044":125323},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3588":74041,"_30857":74028,"_21381":125325,"_5":14694,"_28049":125284,"_3044":125326},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3588":74042,"_30857":74028,"_21381":125328,"_5":14694,"_28049":125284,"_3044":125329},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3588":74043,"_30857":74028,"_21381":125331,"_5":14694,"_28049":125284,"_3044":125332},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3588":74044,"_30857":74028,"_21381":125334,"_5":14694,"_28049":125284,"_3044":125335},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3588":74045,"_30857":74028,"_21381":125337,"_5":14694,"_28049":125284,"_3044":125338},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3588":74046,"_30857":74028,"_21381":125340,"_5":14694,"_28049":125284,"_3044":125341},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3588":74047,"_30857":74028,"_21381":125343,"_5":14694,"_28049":125288,"_3044":125344},[],"Descarga el PEM e inspecciónalo:",{"_3588":74048,"_30857":74028,"_21381":125346,"_5":14694,"_28049":125288,"_3044":125347},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3588":74049,"_30857":74028,"_21381":125349,"_5":14694,"_28049":125292,"_3044":125350},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3588":74050,"_30857":74028,"_21381":125352,"_5":14694,"_28049":125292,"_3044":125353},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3588":74051,"_30857":74028,"_21381":125355,"_5":14694,"_28049":125292,"_3044":125356},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3588":74052,"_30857":74028,"_21381":125358,"_5":14694,"_28049":125292,"_3044":125359},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3588":74053,"_30857":74028,"_21381":125361,"_5":14694,"_28049":125292,"_3044":125362},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3588":74054,"_30857":74028,"_21381":125364,"_5":14694,"_28049":125292,"_3044":125365},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3588":74055,"_30857":74028,"_21381":125367,"_5":14694,"_28049":125292,"_3044":125368},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3588":74056,"_30857":74028,"_21381":125370,"_5":14694,"_28049":125296,"_3044":125371},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3588":74057,"_30857":74028,"_21381":125373,"_5":14694,"_28049":125300,"_3044":125374},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3588":74058,"_30857":74028,"_21381":125376,"_5":14694,"_28049":125304,"_3044":125377},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3588":74059,"_30857":74028,"_21381":125379,"_5":14694,"_28049":125308,"_3044":125380},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3588":74060,"_30857":74028,"_21381":125382,"_5":14694,"_28049":125308,"_3044":125383},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3588":74061,"_30857":74028,"_21381":125385,"_5":14694,"_28049":125308,"_3044":125386},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3588":74062,"_30857":74028,"_21381":125388,"_5":14694,"_28049":125312,"_3044":125389},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3588":74063,"_30857":74028,"_21381":125391,"_5":14694,"_28049":125312,"_3044":125392},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3588":74064,"_30857":74028,"_21381":125394,"_5":14694,"_28049":125312,"_3044":125395},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3588":74065,"_30857":74028,"_21381":125397,"_5":14694,"_28049":125316,"_3044":125398},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3588":74066,"_30857":74028,"_21381":125400,"_5":14694,"_28049":125316,"_3044":125401},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3588":74067,"_30857":74067,"_5":15054,"_3044":125403,"_31195":125404,"_21381":125406,"_28049":74067},"Ciclo de vida de un certificado",[50417,120512,56080,125405],"Conceptos",[],{"_3588":74068,"_30857":74067,"_21381":125408,"_5":14694,"_28049":74067,"_3044":125409},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3588":74069,"_30857":74067,"_5":31192,"_21381":125411,"_28049":125412,"_3044":125413},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3588":74070,"_30857":74067,"_5":31192,"_21381":125415,"_28049":125416,"_3044":125417},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3588":74071,"_30857":74067,"_5":31192,"_21381":125419,"_28049":125420,"_3044":125421},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3588":74072,"_30857":74067,"_5":31192,"_21381":125423,"_28049":125424,"_3044":125425},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3588":74073,"_30857":74067,"_5":31192,"_21381":125427,"_28049":125428,"_3044":125429},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3588":74074,"_30857":74067,"_5":31192,"_21381":125431,"_28049":125432,"_3044":125433},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3588":74075,"_30857":74067,"_5":31192,"_21381":125435,"_28049":125436,"_3044":123134},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3588":74076,"_30857":74067,"_5":31192,"_21381":125438,"_28049":125439,"_3044":125440},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3588":74077,"_30857":74067,"_5":31192,"_21381":125442,"_28049":125443,"_3044":125444},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3588":74078,"_30857":74067,"_5":31192,"_21381":125446,"_28049":125447,"_3044":125448},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3588":74079,"_30857":74067,"_21381":125450,"_5":14694,"_28049":74067,"_3044":125451},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3588":74080,"_30857":74067,"_21381":125453,"_5":14694,"_28049":125416,"_3044":125454},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3588":74081,"_30857":74067,"_21381":125456,"_5":14694,"_28049":125420,"_3044":125457},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3588":74082,"_30857":74067,"_21381":125459,"_5":14694,"_28049":125424,"_3044":125460},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3588":74083,"_30857":74067,"_21381":125462,"_5":14694,"_28049":125428,"_3044":125463},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3588":74084,"_30857":74067,"_21381":125465,"_5":14694,"_28049":125432,"_3044":125466},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3588":74085,"_30857":74067,"_21381":125468,"_5":14694,"_28049":125436,"_3044":125469},[],"Lamassu persiste cuatro estados X.509:",{"_3588":74086,"_30857":74067,"_21381":125471,"_5":14694,"_28049":125436,"_3044":125472},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3588":74087,"_30857":74067,"_21381":125474,"_5":14694,"_28049":125436,"_3044":125475},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3588":74088,"_30857":74067,"_21381":125477,"_5":14694,"_28049":125436,"_3044":125478},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3588":74089,"_30857":74067,"_21381":125480,"_5":14694,"_28049":125436,"_3044":125481},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3588":74090,"_30857":74067,"_21381":125483,"_5":14694,"_28049":125436,"_3044":125484},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3588":74091,"_30857":74067,"_21381":125486,"_5":14694,"_28049":125439,"_3044":125487},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3588":74092,"_30857":74067,"_21381":125489,"_5":14694,"_28049":125439,"_3044":125490},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3588":74093,"_30857":74067,"_21381":125492,"_5":14694,"_28049":125439,"_3044":125493},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3588":74094,"_30857":74067,"_21381":125495,"_5":14694,"_28049":125443,"_3044":125496},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3588":74095,"_30857":74067,"_21381":125498,"_5":14694,"_28049":125443,"_3044":125499},[],"Antes de confirmar:",{"_3588":74096,"_30857":74067,"_21381":125501,"_5":14694,"_28049":125443,"_3044":125502},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3588":74097,"_30857":74067,"_21381":125504,"_5":14694,"_28049":125443,"_3044":125505},[],"Distribuye la nueva cadena de confianza.",{"_3588":74098,"_30857":74067,"_21381":125507,"_5":14694,"_28049":125443,"_3044":125508},[],"Reemite las identidades necesarias.",{"_3588":74099,"_30857":74067,"_21381":125510,"_5":14694,"_28049":125443,"_3044":125511},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3588":74100,"_30857":74067,"_21381":125513,"_5":14694,"_28049":125443,"_3044":125514},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3588":74101,"_30857":74067,"_21381":125516,"_5":14694,"_28049":125443,"_3044":125517},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3588":74102,"_30857":74067,"_21381":125519,"_5":14694,"_28049":125447,"_3044":125520},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3588":74103,"_30857":74067,"_21381":125522,"_5":14694,"_28049":125447,"_3044":125523},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3588":74104,"_30857":74067,"_21381":125525,"_5":14694,"_28049":125447,"_3044":125526},[],"Cambios de estado y razones de revocación.",{"_3588":74105,"_30857":74067,"_21381":125528,"_5":14694,"_28049":125447,"_3044":125529},[],"Publicación y vigencia de OCSP y CRLs.",{"_3588":74106,"_30857":74067,"_21381":125531,"_5":14694,"_28049":125447,"_3044":125532},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3588":74107,"_30857":74067,"_21381":125534,"_5":14694,"_28049":125447,"_3044":125535},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3588":74108,"_30857":74108,"_5":15054,"_3044":125537,"_31195":125538,"_21381":125539,"_28049":74108},"Modelo de confianza",[50417,120512,56080,125405],[],{"_3588":74109,"_30857":74108,"_21381":125541,"_5":14694,"_28049":74108,"_3044":125542},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3588":74110,"_30857":74108,"_5":31192,"_21381":125544,"_28049":125545,"_3044":125546},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3588":74111,"_30857":74108,"_5":31192,"_21381":125548,"_28049":125549,"_3044":125550},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3588":74112,"_30857":74108,"_5":31192,"_21381":125552,"_28049":125553,"_3044":125554},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3588":74113,"_30857":74108,"_5":31192,"_21381":125556,"_28049":125557,"_3044":125558},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3588":74114,"_30857":74108,"_5":31192,"_21381":125560,"_28049":125561,"_3044":125562},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3588":74115,"_30857":74108,"_5":31192,"_21381":125564,"_28049":125565,"_3044":125566},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3588":74116,"_30857":74108,"_5":31192,"_21381":125568,"_28049":125569,"_3044":125570},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3588":74117,"_30857":74108,"_5":31192,"_21381":125572,"_28049":125573,"_3044":125574},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3588":74118,"_30857":74108,"_5":31192,"_21381":125576,"_28049":125577,"_3044":125578},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3588":74119,"_30857":74108,"_5":31192,"_21381":125580,"_28049":125581,"_3044":125582},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3588":74120,"_30857":74108,"_21381":125584,"_5":14694,"_28049":74108,"_3044":125585},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3588":74121,"_30857":74108,"_21381":125587,"_5":14694,"_28049":125549,"_3044":125588},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3588":74122,"_30857":74108,"_21381":125590,"_5":14694,"_28049":125553,"_3044":125591},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3588":74123,"_30857":74108,"_21381":125593,"_5":14694,"_28049":125557,"_3044":125594},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3588":74124,"_30857":74108,"_21381":125596,"_5":14694,"_28049":125561,"_3044":125597},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3588":74125,"_30857":74108,"_21381":125599,"_5":14694,"_28049":125565,"_3044":125600},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3588":74126,"_30857":74108,"_21381":125602,"_5":14694,"_28049":125565,"_3044":125603},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3588":74127,"_30857":74108,"_21381":125605,"_5":14694,"_28049":125565,"_3044":125606},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3588":74128,"_30857":74108,"_21381":125608,"_5":14694,"_28049":125565,"_3044":125609},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3588":74129,"_30857":74108,"_21381":125611,"_5":14694,"_28049":125565,"_3044":125612},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3588":74130,"_30857":74108,"_21381":125614,"_5":14694,"_28049":125565,"_3044":125615},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3588":74131,"_30857":74108,"_21381":125617,"_5":14694,"_28049":125569,"_3044":125618},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3588":74132,"_30857":74108,"_21381":125620,"_5":14694,"_28049":125569,"_3044":125621},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3588":74133,"_30857":74108,"_21381":125623,"_5":14694,"_28049":125569,"_3044":125624},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3588":74134,"_30857":74108,"_21381":125626,"_5":14694,"_28049":125569,"_3044":125627},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3588":74135,"_30857":74108,"_21381":125629,"_5":14694,"_28049":125569,"_3044":125630},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3588":74136,"_30857":74108,"_21381":125632,"_5":14694,"_28049":125573,"_3044":125633},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3588":74137,"_30857":74108,"_21381":125635,"_5":14694,"_28049":125573,"_3044":125636},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3588":74138,"_30857":74108,"_21381":125638,"_5":14694,"_28049":125573,"_3044":125639},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3588":74139,"_30857":74108,"_21381":125641,"_5":14694,"_28049":125573,"_3044":125642},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3588":74140,"_30857":74108,"_21381":125644,"_5":14694,"_28049":125573,"_3044":125645},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3588":74141,"_30857":74108,"_21381":125647,"_5":14694,"_28049":125573,"_3044":125648},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3588":74142,"_30857":74108,"_21381":125650,"_5":14694,"_28049":125573,"_3044":125651},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3588":74143,"_30857":74108,"_21381":125653,"_5":14694,"_28049":125577,"_3044":125654},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3588":74144,"_30857":74108,"_21381":125656,"_5":14694,"_28049":125581,"_3044":125657},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3588":74145,"_30857":74108,"_21381":125659,"_5":14694,"_28049":125581,"_3044":125660},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3588":74146,"_30857":74108,"_21381":125662,"_5":14694,"_28049":125581,"_3044":125663},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3588":74147,"_30857":74108,"_21381":125665,"_5":14694,"_28049":125581,"_3044":125666},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3588":74148,"_30857":74108,"_21381":125668,"_5":14694,"_28049":125581,"_3044":125669},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3588":74149,"_30857":74108,"_21381":125671,"_5":14694,"_28049":125581,"_3044":125672},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3588":74150,"_30857":74108,"_21381":125674,"_5":14694,"_28049":125581,"_3044":125675},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3588":74151,"_30857":74151,"_5":15054,"_3044":125677,"_31195":125678,"_21381":125679,"_28049":74151},"Listas de revocación (CRL)",[50417,120512,56080,125151],[],{"_3588":74152,"_30857":74151,"_21381":125681,"_5":14694,"_28049":74151,"_3044":125682},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3588":74153,"_30857":74151,"_5":31192,"_21381":125684,"_28049":125685,"_3044":125686},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3588":74154,"_30857":74151,"_5":31192,"_21381":125688,"_28049":125689,"_3044":125690},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3588":74155,"_30857":74151,"_5":31192,"_21381":125692,"_28049":125693,"_3044":125694},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3588":74156,"_30857":74151,"_5":31192,"_21381":125696,"_28049":125697,"_3044":125698},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3588":74157,"_30857":74151,"_5":31192,"_21381":125700,"_28049":125701,"_3044":125702},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3588":74158,"_30857":74151,"_5":31192,"_21381":125704,"_28049":125705,"_3044":125706},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3588":74159,"_30857":74151,"_5":31192,"_21381":125708,"_28049":125709,"_3044":125710},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3588":74160,"_30857":74151,"_5":31192,"_21381":125712,"_28049":125713,"_3044":125714},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3588":74161,"_30857":74151,"_21381":125716,"_5":14694,"_28049":74151,"_3044":125717},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3588":74162,"_30857":74151,"_21381":125719,"_5":14694,"_28049":125685,"_3044":125720},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3588":74163,"_30857":74151,"_21381":125722,"_5":14694,"_28049":125685,"_3044":125723},[],"Campo",{"_3588":74164,"_30857":74151,"_21381":125725,"_5":14694,"_28049":125685,"_3044":122174},[],{"_3588":74165,"_30857":74151,"_21381":125727,"_5":14694,"_28049":125685,"_3044":52049},[],{"_3588":74166,"_30857":74151,"_21381":125729,"_5":14694,"_28049":125685,"_3044":125730},[],"ID de la CA a la que pertenecen los ajustes.",{"_3588":74167,"_30857":74151,"_21381":125732,"_5":14694,"_28049":125685,"_3044":57306},[],{"_3588":74168,"_30857":74151,"_21381":125734,"_5":14694,"_28049":125685,"_3044":125735},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3588":74169,"_30857":74151,"_21381":125737,"_5":14694,"_28049":125685,"_3044":57312},[],{"_3588":74170,"_30857":74151,"_21381":125739,"_5":14694,"_28049":125685,"_3044":125740},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3588":74171,"_30857":74151,"_21381":125742,"_5":14694,"_28049":125685,"_3044":57318},[],{"_3588":74172,"_30857":74151,"_21381":125744,"_5":14694,"_28049":125685,"_3044":125745},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3588":74173,"_30857":74151,"_21381":125747,"_5":14694,"_28049":125685,"_3044":125748},[],"Campo de `crl_options`",{"_3588":74174,"_30857":74151,"_21381":125750,"_5":14694,"_28049":125685,"_3044":122174},[],{"_3588":74175,"_30857":74151,"_21381":125752,"_5":14694,"_28049":125685,"_3044":125753},[],"Valor inicial",{"_3588":74176,"_30857":74151,"_21381":125755,"_5":14694,"_28049":125685,"_3044":57332},[],{"_3588":74177,"_30857":74151,"_21381":125757,"_5":14694,"_28049":125685,"_3044":125758},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3588":74178,"_30857":74151,"_21381":125760,"_5":14694,"_28049":125685,"_3044":125761},[],"7 días.",{"_3588":74179,"_30857":74151,"_21381":125763,"_5":14694,"_28049":125685,"_3044":57341},[],{"_3588":74180,"_30857":74151,"_21381":125765,"_5":14694,"_28049":125685,"_3044":125766},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3588":74181,"_30857":74151,"_21381":125768,"_5":14694,"_28049":125685,"_3044":125769},[],"6 días y 23 horas.",{"_3588":74182,"_30857":74151,"_21381":125771,"_5":14694,"_28049":125685,"_3044":57350},[],{"_3588":74183,"_30857":74151,"_21381":125773,"_5":14694,"_28049":125685,"_3044":125774},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3588":74184,"_30857":74151,"_21381":125776,"_5":14694,"_28049":125685,"_3044":57356},[],{"_3588":74185,"_30857":74151,"_21381":125778,"_5":14694,"_28049":125685,"_3044":57359},[],{"_3588":74186,"_30857":74151,"_21381":125780,"_5":14694,"_28049":125685,"_3044":125781},[],"Número de serie del certificado existente que firma la CRL.",{"_3588":74187,"_30857":74151,"_21381":125783,"_5":14694,"_28049":125685,"_3044":125784},[],"Número de serie del certificado actual de la CA.",{"_3588":74188,"_30857":74151,"_21381":125786,"_5":14694,"_28049":125685,"_3044":125787},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3588":74189,"_30857":74151,"_21381":125789,"_5":14694,"_28049":125685,"_3044":125790},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3588":74190,"_30857":74151,"_21381":125792,"_5":14694,"_28049":125685,"_3044":125793},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3588":74191,"_30857":74151,"_21381":125795,"_5":14694,"_28049":125685,"_3044":125796},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3588":74192,"_30857":74151,"_21381":125798,"_5":14694,"_28049":125685,"_3044":125799},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3588":74193,"_30857":74151,"_21381":125801,"_5":14694,"_28049":125685,"_3044":125802},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3588":74194,"_30857":74151,"_21381":125804,"_5":14694,"_28049":125685,"_3044":125805},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3588":74195,"_30857":74151,"_21381":125807,"_5":14694,"_28049":125685,"_3044":125808},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3588":74196,"_30857":74151,"_21381":125810,"_5":14694,"_28049":125685,"_3044":125811},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3588":74197,"_30857":74151,"_21381":125813,"_5":14694,"_28049":125685,"_3044":125814},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3588":74198,"_30857":74151,"_21381":125816,"_5":14694,"_28049":125685,"_3044":125817},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3588":74199,"_30857":74151,"_21381":125819,"_5":14694,"_28049":125689,"_3044":125820},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3588":74200,"_30857":74151,"_21381":125822,"_5":14694,"_28049":125689,"_3044":125823},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3588":74201,"_30857":74151,"_21381":125825,"_5":14694,"_28049":125689,"_3044":125826},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3588":74202,"_30857":74151,"_21381":125828,"_5":14694,"_28049":125689,"_3044":125829},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3588":74203,"_30857":74151,"_21381":125831,"_5":14694,"_28049":125693,"_3044":125832},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3588":74204,"_30857":74151,"_21381":125834,"_5":14694,"_28049":125693,"_3044":125835},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3588":74205,"_30857":74151,"_21381":125837,"_5":14694,"_28049":125693,"_3044":125838},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3588":74206,"_30857":74151,"_21381":125840,"_5":14694,"_28049":125693,"_3044":125841},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3588":74207,"_30857":74151,"_21381":125843,"_5":14694,"_28049":125693,"_3044":125844},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3588":74208,"_30857":74151,"_21381":125846,"_5":14694,"_28049":125693,"_3044":125847},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3588":74209,"_30857":74151,"_21381":125849,"_5":14694,"_28049":125693,"_3044":125850},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3588":74210,"_30857":74151,"_21381":125852,"_5":14694,"_28049":125693,"_3044":125853},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3588":74211,"_30857":74151,"_21381":125855,"_5":14694,"_28049":125693,"_3044":125856},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3588":74212,"_30857":74151,"_21381":125858,"_5":14694,"_28049":125697,"_3044":125859},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3588":74213,"_30857":74151,"_21381":125861,"_5":14694,"_28049":125697,"_3044":125862},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3588":74214,"_30857":74151,"_21381":125864,"_5":14694,"_28049":125701,"_3044":125865},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3588":74215,"_30857":74151,"_21381":125867,"_5":14694,"_28049":125701,"_3044":125868},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3588":74216,"_30857":74151,"_21381":125870,"_5":14694,"_28049":125701,"_3044":125871},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3588":74217,"_30857":74151,"_21381":125873,"_5":14694,"_28049":125701,"_3044":125874},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3588":74218,"_30857":74151,"_21381":125876,"_5":14694,"_28049":125701,"_3044":125877},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3588":74219,"_30857":74151,"_21381":125879,"_5":14694,"_28049":125705,"_3044":125880},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3588":74220,"_30857":74151,"_21381":125882,"_5":14694,"_28049":125705,"_3044":122363},[],{"_3588":74221,"_30857":74151,"_21381":125884,"_5":14694,"_28049":125705,"_3044":125885},[],"Path relativo",{"_3588":74222,"_30857":74151,"_21381":125887,"_5":14694,"_28049":125705,"_3044":120272},[],{"_3588":74223,"_30857":74151,"_21381":125889,"_5":14694,"_28049":125705,"_3044":57471},[],{"_3588":74224,"_30857":74151,"_21381":125891,"_5":14694,"_28049":125705,"_3044":57474},[],{"_3588":74225,"_30857":74151,"_21381":125893,"_5":14694,"_28049":125705,"_3044":125894},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3588":74226,"_30857":74151,"_21381":125896,"_5":14694,"_28049":125705,"_3044":57471},[],{"_3588":74227,"_30857":74151,"_21381":125898,"_5":14694,"_28049":125705,"_3044":57482},[],{"_3588":74228,"_30857":74151,"_21381":125900,"_5":14694,"_28049":125705,"_3044":125901},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3588":74229,"_30857":74151,"_21381":125903,"_5":14694,"_28049":125705,"_3044":57488},[],{"_3588":74230,"_30857":74151,"_21381":125905,"_5":14694,"_28049":125705,"_3044":57482},[],{"_3588":74231,"_30857":74151,"_21381":125907,"_5":14694,"_28049":125705,"_3044":125908},[],"Sustituir la configuración de CRL de una CA.",{"_3588":74232,"_30857":74151,"_21381":125910,"_5":14694,"_28049":125705,"_3044":57496},[],{"_3588":74233,"_30857":74151,"_21381":125912,"_5":14694,"_28049":125705,"_3044":57482},[],{"_3588":74234,"_30857":74151,"_21381":125914,"_5":14694,"_28049":125705,"_3044":125915},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3588":74235,"_30857":74151,"_21381":125917,"_5":14694,"_28049":125705,"_3044":125918},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3588":74236,"_30857":74151,"_21381":125920,"_5":14694,"_28049":125705,"_3044":125921},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3588":74237,"_30857":74151,"_21381":125923,"_5":14694,"_28049":125705,"_3044":125924},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3588":74238,"_30857":74151,"_21381":125926,"_5":14694,"_28049":125709,"_3044":125927},[],"Síntoma",{"_3588":74239,"_30857":74151,"_21381":125929,"_5":14694,"_28049":125709,"_3044":125930},[],"Causa",{"_3588":74240,"_30857":74151,"_21381":125932,"_5":14694,"_28049":125709,"_3044":125933},[],"Acción",{"_3588":74241,"_30857":74151,"_21381":125935,"_5":14694,"_28049":125709,"_3044":125936},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3588":74242,"_30857":74151,"_21381":125938,"_5":14694,"_28049":125709,"_3044":125939},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3588":74243,"_30857":74151,"_21381":125941,"_5":14694,"_28049":125709,"_3044":125942},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3588":74244,"_30857":74151,"_21381":125944,"_5":14694,"_28049":125709,"_3044":125945},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3588":74245,"_30857":74151,"_21381":125947,"_5":14694,"_28049":125709,"_3044":125948},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3588":74246,"_30857":74151,"_21381":125950,"_5":14694,"_28049":125709,"_3044":125951},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3588":74247,"_30857":74151,"_21381":125953,"_5":14694,"_28049":125709,"_3044":125954},[],"`PUT` devuelve 400.",{"_3588":74248,"_30857":74151,"_21381":125956,"_5":14694,"_28049":125709,"_3044":125957},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3588":74249,"_30857":74151,"_21381":125959,"_5":14694,"_28049":125709,"_3044":125960},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3588":74250,"_30857":74151,"_21381":125962,"_5":14694,"_28049":125709,"_3044":125963},[],"`PUT` devuelve 404.",{"_3588":74251,"_30857":74151,"_21381":125965,"_5":14694,"_28049":125709,"_3044":125966},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3588":74252,"_30857":74151,"_21381":125968,"_5":14694,"_28049":125709,"_3044":125969},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3588":74253,"_30857":74151,"_21381":125971,"_5":14694,"_28049":125709,"_3044":125972},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3588":74254,"_30857":74151,"_21381":125974,"_5":14694,"_28049":125709,"_3044":125975},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3588":74255,"_30857":74151,"_21381":125977,"_5":14694,"_28049":125709,"_3044":125978},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3588":74256,"_30857":74151,"_21381":125980,"_5":14694,"_28049":125709,"_3044":125981},[],"La CRL no cambia tras revocar un certificado.",{"_3588":74257,"_30857":74151,"_21381":125983,"_5":14694,"_28049":125709,"_3044":125984},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3588":74258,"_30857":74151,"_21381":125986,"_5":14694,"_28049":125709,"_3044":125987},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3588":74259,"_30857":74151,"_21381":125989,"_5":14694,"_28049":125709,"_3044":125990},[],"Un verificador rechaza la CRL por el emisor.",{"_3588":74260,"_30857":74151,"_21381":125992,"_5":14694,"_28049":125709,"_3044":125993},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3588":74261,"_30857":74151,"_21381":125995,"_5":14694,"_28049":125709,"_3044":125996},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3588":74262,"_30857":74151,"_21381":125998,"_5":14694,"_28049":125713,"_3044":125999},[],"RFC 5280: perfil X.509 y CRL.",{"_3588":74263,"_30857":74151,"_21381":126001,"_5":14694,"_28049":125713,"_3044":57588},[],{"_3588":74264,"_30857":74151,"_21381":126003,"_5":14694,"_28049":125713,"_3044":57591},[],{"_3588":74265,"_30857":74151,"_21381":126005,"_5":14694,"_28049":125713,"_3044":126006},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3588":74266,"_30857":74151,"_21381":126008,"_5":14694,"_28049":125713,"_3044":126009},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3588":74267,"_30857":74267,"_5":15054,"_3044":126011,"_31195":126012,"_21381":126013,"_28049":74267},"Claves y motores criptográficos",[50417,120512,56080,124511],[],{"_3588":74268,"_30857":74267,"_21381":126015,"_5":14694,"_28049":74267,"_3044":126016},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3588":74269,"_30857":74267,"_5":31192,"_21381":126018,"_28049":126019,"_3044":126020},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3588":74270,"_30857":74267,"_5":31192,"_21381":126022,"_28049":126023,"_3044":126024},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3588":74271,"_30857":74267,"_5":31192,"_21381":126026,"_28049":126027,"_3044":57616},[],"/docs/es/platform/pki/key-management#file-system",{"_3588":74272,"_30857":74267,"_5":31192,"_21381":126029,"_28049":126030,"_3044":57620},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3588":74273,"_30857":74267,"_5":31192,"_21381":126032,"_28049":126033,"_3044":57624},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3588":74274,"_30857":74267,"_5":31192,"_21381":126035,"_28049":126036,"_3044":57628},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3588":74275,"_30857":74267,"_5":31192,"_21381":126038,"_28049":126039,"_3044":57632},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3588":74276,"_30857":74267,"_5":31192,"_21381":126041,"_28049":126042,"_3044":57636},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3588":74277,"_30857":74267,"_5":31192,"_21381":126044,"_28049":126045,"_3044":126046},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3588":74278,"_30857":74267,"_5":31192,"_21381":126048,"_28049":126049,"_3044":126050},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3588":74279,"_30857":74267,"_5":31192,"_21381":126052,"_28049":126053,"_3044":126054},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3588":74280,"_30857":74267,"_5":31192,"_21381":126056,"_28049":126057,"_3044":126058},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3588":74281,"_30857":74267,"_5":31192,"_21381":126060,"_28049":126061,"_3044":126062},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3588":74282,"_30857":74267,"_5":31192,"_21381":126064,"_28049":126065,"_3044":126066},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3588":74283,"_30857":74267,"_5":31192,"_21381":126068,"_28049":126069,"_3044":126070},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3588":74284,"_30857":74267,"_5":31192,"_21381":126072,"_28049":126073,"_3044":57668},[],"/docs/es/platform/pki/key-management#sign",{"_3588":74285,"_30857":74267,"_5":31192,"_21381":126075,"_28049":126076,"_3044":57672},[],"/docs/es/platform/pki/key-management#verify",{"_3588":74286,"_30857":74267,"_5":31192,"_21381":126078,"_28049":126079,"_3044":126080},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3588":74287,"_30857":74267,"_5":31192,"_21381":126082,"_28049":126083,"_3044":126084},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3588":74288,"_30857":74267,"_5":31192,"_21381":126086,"_28049":126087,"_3044":126088},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3588":74289,"_30857":74267,"_21381":126090,"_5":14694,"_28049":74267,"_3044":126091},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3588":74290,"_30857":74267,"_21381":126093,"_5":14694,"_28049":74267,"_3044":126094},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3588":74291,"_30857":74267,"_21381":126096,"_5":14694,"_28049":126019,"_3044":126097},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3588":74292,"_30857":74267,"_21381":126099,"_5":14694,"_28049":126019,"_3044":126100},[],"En la práctica, permite:",{"_3588":74293,"_30857":74267,"_21381":126102,"_5":14694,"_28049":126019,"_3044":126103},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3588":74294,"_30857":74267,"_21381":126105,"_5":14694,"_28049":126019,"_3044":126106},[],"Importar claves creadas externamente.",{"_3588":74295,"_30857":74267,"_21381":126108,"_5":14694,"_28049":126019,"_3044":126109},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3588":74296,"_30857":74267,"_21381":126111,"_5":14694,"_28049":126019,"_3044":126112},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3588":74297,"_30857":74267,"_21381":126114,"_5":14694,"_28049":126023,"_3044":126115},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3588":74298,"_30857":74267,"_21381":126117,"_5":14694,"_28049":126023,"_3044":126118},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3588":74299,"_30857":74267,"_21381":126120,"_5":14694,"_28049":126023,"_3044":126121},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3588":74300,"_30857":74267,"_21381":126123,"_5":14694,"_28049":126027,"_3044":126124},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3588":74301,"_30857":74267,"_21381":126126,"_5":14694,"_28049":126030,"_3044":126127},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3588":74302,"_30857":74267,"_21381":126129,"_5":14694,"_28049":126030,"_3044":126130},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3588":74303,"_30857":74267,"_21381":126132,"_5":14694,"_28049":126033,"_3044":126133},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3588":74304,"_30857":74267,"_21381":126135,"_5":14694,"_28049":126036,"_3044":126136},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3588":74305,"_30857":74267,"_21381":126138,"_5":14694,"_28049":126039,"_3044":126139},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3588":74306,"_30857":74267,"_21381":126141,"_5":14694,"_28049":126042,"_3044":126142},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3588":74307,"_30857":74267,"_21381":126144,"_5":14694,"_28049":126042,"_3044":126145},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3588":74308,"_30857":74267,"_21381":126147,"_5":14694,"_28049":126042,"_3044":126148},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3588":74309,"_30857":74267,"_21381":126150,"_5":14694,"_28049":126042,"_3044":126151},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3588":74310,"_30857":74267,"_21381":126153,"_5":14694,"_28049":126045,"_3044":126154},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3588":74311,"_30857":74267,"_21381":126156,"_5":14694,"_28049":126045,"_3044":126157},[],"La tabla incluye los siguientes campos:",{"_3588":74312,"_30857":74267,"_21381":126159,"_5":14694,"_28049":126045,"_3044":126160},[],"**Name**: nombre descriptivo de la clave.",{"_3588":74313,"_30857":74267,"_21381":126162,"_5":14694,"_28049":126045,"_3044":126163},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3588":74314,"_30857":74267,"_21381":126165,"_5":14694,"_28049":126045,"_3044":126166},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3588":74315,"_30857":74267,"_21381":126168,"_5":14694,"_28049":126045,"_3044":126169},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3588":74316,"_30857":74267,"_21381":126171,"_5":14694,"_28049":126045,"_3044":126172},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3588":74317,"_30857":74267,"_21381":126174,"_5":14694,"_28049":126045,"_3044":126175},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3588":74318,"_30857":74267,"_21381":126177,"_5":14694,"_28049":126045,"_3044":126178},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3588":74319,"_30857":74267,"_21381":126180,"_5":14694,"_28049":126045,"_3044":126181},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3588":74320,"_30857":74267,"_21381":126183,"_5":14694,"_28049":126045,"_3044":126184},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3588":74321,"_30857":74267,"_21381":126186,"_5":14694,"_28049":126045,"_3044":126187},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3588":74322,"_30857":74267,"_21381":126189,"_5":14694,"_28049":126045,"_3044":126190},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3588":74323,"_30857":74267,"_21381":126192,"_5":14694,"_28049":126045,"_3044":126193},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3588":74324,"_30857":74267,"_21381":126195,"_5":14694,"_28049":126045,"_3044":126196},[],"**Delete Key** para eliminar la clave del sistema.",{"_3588":74325,"_30857":74267,"_21381":126198,"_5":14694,"_28049":126049,"_3044":126199},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3588":74326,"_30857":74267,"_21381":126201,"_5":14694,"_28049":126053,"_3044":126202},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3588":74327,"_30857":74267,"_21381":126204,"_5":14694,"_28049":126053,"_3044":126205},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3588":74328,"_30857":74267,"_21381":126207,"_5":14694,"_28049":126053,"_3044":126208},[],"**Key Name**: nombre único y descriptivo.",{"_3588":74329,"_30857":74267,"_21381":126210,"_5":14694,"_28049":126053,"_3044":126211},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3588":74330,"_30857":74267,"_21381":126213,"_5":14694,"_28049":126053,"_3044":126214},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3588":74331,"_30857":74267,"_21381":126216,"_5":14694,"_28049":126053,"_3044":126217},[],"**Tags**: metadatos para clasificar la clave.",{"_3588":74332,"_30857":74267,"_21381":126219,"_5":14694,"_28049":126053,"_3044":126220},[],"**Metadata**: información adicional para usos avanzados.",{"_3588":74333,"_30857":74267,"_21381":126222,"_5":14694,"_28049":126057,"_3044":126223},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3588":74334,"_30857":74267,"_21381":126225,"_5":14694,"_28049":126057,"_3044":126226},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3588":74335,"_30857":74267,"_21381":126228,"_5":14694,"_28049":126057,"_3044":126229},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3588":74336,"_30857":74267,"_21381":126231,"_5":14694,"_28049":126057,"_3044":126232},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3588":74337,"_30857":74267,"_21381":126234,"_5":14694,"_28049":126057,"_3044":126235},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3588":74338,"_30857":74267,"_21381":126237,"_5":14694,"_28049":126057,"_3044":126238},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3588":74339,"_30857":74267,"_21381":126240,"_5":14694,"_28049":126057,"_3044":126241},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3588":74340,"_30857":74267,"_21381":126243,"_5":14694,"_28049":126057,"_3044":126244},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3588":74341,"_30857":74267,"_21381":126246,"_5":14694,"_28049":126057,"_3044":126247},[],"**Metadata**: información adicional opcional.",{"_3588":74342,"_30857":74267,"_21381":126249,"_5":14694,"_28049":126057,"_3044":126250},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3588":74343,"_30857":74267,"_21381":126252,"_5":14694,"_28049":126057,"_3044":126253},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3588":74344,"_30857":74267,"_21381":126255,"_5":14694,"_28049":126061,"_3044":126256},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3588":74345,"_30857":74267,"_21381":126258,"_5":14694,"_28049":126065,"_3044":126259},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3588":74346,"_30857":74267,"_21381":126261,"_5":14694,"_28049":126065,"_3044":126262},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3588":74347,"_30857":74267,"_21381":126264,"_5":14694,"_28049":126065,"_3044":126265},[],"**Key Name**: nombre descriptivo.",{"_3588":74348,"_30857":74267,"_21381":126267,"_5":14694,"_28049":126065,"_3044":126268},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3588":74349,"_30857":74267,"_21381":126270,"_5":14694,"_28049":126065,"_3044":126271},[],"**Tags**: etiquetas asociadas.",{"_3588":74350,"_30857":74267,"_21381":126273,"_5":14694,"_28049":126065,"_3044":126274},[],"**Aliases**: nombres alternativos.",{"_3588":74351,"_30857":74267,"_21381":126276,"_5":14694,"_28049":126065,"_3044":126277},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3588":74352,"_30857":74267,"_21381":126279,"_5":14694,"_28049":126065,"_3044":126280},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3588":74353,"_30857":74267,"_21381":126282,"_5":14694,"_28049":126065,"_3044":126283},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3588":74354,"_30857":74267,"_21381":126285,"_5":14694,"_28049":126065,"_3044":126286},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3588":74355,"_30857":74267,"_21381":126288,"_5":14694,"_28049":126069,"_3044":126289},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3588":74356,"_30857":74267,"_21381":126291,"_5":14694,"_28049":126069,"_3044":126292},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3588":74357,"_30857":74267,"_21381":126294,"_5":14694,"_28049":126069,"_3044":126295},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3588":74358,"_30857":74267,"_21381":126297,"_5":14694,"_28049":126073,"_3044":126298},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3588":74359,"_30857":74267,"_21381":126300,"_5":14694,"_28049":126073,"_3044":126301},[],"Campos principales:",{"_3588":74360,"_30857":74267,"_21381":126303,"_5":14694,"_28049":126073,"_3044":126304},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3588":74361,"_30857":74267,"_21381":126306,"_5":14694,"_28049":126073,"_3044":126307},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3588":74362,"_30857":74267,"_21381":126309,"_5":14694,"_28049":126073,"_3044":126310},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3588":74363,"_30857":74267,"_21381":126312,"_5":14694,"_28049":126073,"_3044":126313},[],"**Message**: contenido que se va a firmar.",{"_3588":74364,"_30857":74267,"_21381":126315,"_5":14694,"_28049":126073,"_3044":126316},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3588":74365,"_30857":74267,"_21381":126318,"_5":14694,"_28049":126076,"_3044":126319},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3588":74366,"_30857":74267,"_21381":126321,"_5":14694,"_28049":126076,"_3044":126301},[],{"_3588":74367,"_30857":74267,"_21381":126323,"_5":14694,"_28049":126076,"_3044":126324},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3588":74368,"_30857":74267,"_21381":126326,"_5":14694,"_28049":126076,"_3044":126327},[],"**Message Type**: `Raw` o `Digest`.",{"_3588":74369,"_30857":74267,"_21381":126329,"_5":14694,"_28049":126076,"_3044":126330},[],"**Payload Encoding**: codificación del mensaje.",{"_3588":74370,"_30857":74267,"_21381":126332,"_5":14694,"_28049":126076,"_3044":126333},[],"**Message**: mensaje original o hash.",{"_3588":74371,"_30857":74267,"_21381":126335,"_5":14694,"_28049":126076,"_3044":126336},[],"**Signature**: firma que se desea comprobar.",{"_3588":74372,"_30857":74267,"_21381":126338,"_5":14694,"_28049":126076,"_3044":126339},[],"**Result**: indicador del resultado de la validación.",{"_3588":74373,"_30857":74267,"_21381":126341,"_5":14694,"_28049":126079,"_3044":126342},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3588":74374,"_30857":74267,"_21381":126344,"_5":14694,"_28049":126079,"_3044":126345},[],"Este flujo es útil para:",{"_3588":74375,"_30857":74267,"_21381":126347,"_5":14694,"_28049":126079,"_3044":126348},[],"Solicitar certificados a una CA externa.",{"_3588":74376,"_30857":74267,"_21381":126350,"_5":14694,"_28049":126079,"_3044":126351},[],"Renovar una identidad manteniendo la misma clave.",{"_3588":74377,"_30857":74267,"_21381":126353,"_5":14694,"_28049":126079,"_3044":126354},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3588":74378,"_30857":74267,"_21381":126356,"_5":14694,"_28049":126079,"_3044":126357},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3588":74379,"_30857":74267,"_21381":126359,"_5":14694,"_28049":126079,"_3044":126360},[],"**Organization (O)**: organización o empresa.",{"_3588":74380,"_30857":74267,"_21381":126362,"_5":14694,"_28049":126079,"_3044":126363},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3588":74381,"_30857":74267,"_21381":126365,"_5":14694,"_28049":126079,"_3044":126366},[],"**Country (C)**: código de país de dos letras.",{"_3588":74382,"_30857":74267,"_21381":126368,"_5":14694,"_28049":126079,"_3044":126369},[],"**State / Province (ST)**: estado o provincia.",{"_3588":74383,"_30857":74267,"_21381":126371,"_5":14694,"_28049":126079,"_3044":126372},[],"**Locality (L)**: ciudad o localidad.",{"_3588":74384,"_30857":74267,"_21381":126374,"_5":14694,"_28049":126079,"_3044":126375},[],"**Email Address**: correo de contacto.",{"_3588":74385,"_30857":74267,"_21381":126377,"_5":14694,"_28049":126079,"_3044":126378},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3588":74386,"_30857":74267,"_21381":126380,"_5":14694,"_28049":126079,"_3044":126381},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3588":74387,"_30857":74267,"_21381":126383,"_5":14694,"_28049":126083,"_3044":126384},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3588":74388,"_30857":74267,"_21381":126386,"_5":14694,"_28049":126083,"_3044":126387},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3588":74389,"_30857":74267,"_21381":126389,"_5":14694,"_28049":126087,"_3044":126390},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3588":74390,"_30857":74267,"_21381":126392,"_5":14694,"_28049":126087,"_3044":126393},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3588":74391,"_30857":74391,"_5":15054,"_3044":126395,"_31195":126396,"_21381":126397,"_28049":74391},"Validación online con OCSP",[50417,120512,56080,125151],[],{"_3588":74392,"_30857":74391,"_21381":126399,"_5":14694,"_28049":74391,"_3044":126400},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3588":74393,"_30857":74391,"_5":31192,"_21381":126402,"_28049":126403,"_3044":126404},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3588":74394,"_30857":74391,"_5":31192,"_21381":126406,"_28049":126407,"_3044":126408},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3588":74395,"_30857":74391,"_5":31192,"_21381":126410,"_28049":126411,"_3044":126412},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3588":74396,"_30857":74391,"_5":31192,"_21381":126414,"_28049":126415,"_3044":126416},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3588":74397,"_30857":74391,"_5":31192,"_21381":126418,"_28049":126419,"_3044":126420},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3588":74398,"_30857":74391,"_5":31192,"_21381":126422,"_28049":126423,"_3044":125714},[],"/docs/es/platform/pki/ocsp#referencias",{"_3588":74399,"_30857":74391,"_21381":126425,"_5":14694,"_28049":74391,"_3044":126426},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3588":74400,"_30857":74391,"_21381":126428,"_5":14694,"_28049":126403,"_3044":126429},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3588":74401,"_30857":74391,"_21381":126431,"_5":14694,"_28049":126403,"_3044":126432},[],"Estado del registro",{"_3588":74402,"_30857":74391,"_21381":126434,"_5":14694,"_28049":126403,"_3044":126435},[],"Respuesta firmada",{"_3588":74403,"_30857":74391,"_21381":126437,"_5":14694,"_28049":126403,"_3044":55217},[],{"_3588":74404,"_30857":74391,"_21381":126439,"_5":14694,"_28049":126403,"_3044":58036},[],{"_3588":74405,"_30857":74391,"_21381":126441,"_5":14694,"_28049":126403,"_3044":55234},[],{"_3588":74406,"_30857":74391,"_21381":126443,"_5":14694,"_28049":126403,"_3044":126444},[],"`Revoked`, con razón y fecha de revocación.",{"_3588":74407,"_30857":74391,"_21381":126446,"_5":14694,"_28049":126403,"_3044":126447},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3588":74408,"_30857":74391,"_21381":126449,"_5":14694,"_28049":126403,"_3044":126450},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3588":74409,"_30857":74391,"_21381":126452,"_5":14694,"_28049":126403,"_3044":126453},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3588":74410,"_30857":74391,"_21381":126455,"_5":14694,"_28049":126403,"_3044":126456},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3588":74411,"_30857":74391,"_21381":126458,"_5":14694,"_28049":126403,"_3044":126459},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3588":74412,"_30857":74391,"_21381":126461,"_5":14694,"_28049":126407,"_3044":126462},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3588":74413,"_30857":74391,"_21381":126464,"_5":14694,"_28049":126407,"_3044":126465},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3588":74414,"_30857":74391,"_21381":126467,"_5":14694,"_28049":126411,"_3044":126468},[],"El servicio acepta:",{"_3588":74415,"_30857":74391,"_21381":126470,"_5":14694,"_28049":126411,"_3044":122363},[],{"_3588":74416,"_30857":74391,"_21381":126472,"_5":14694,"_28049":126411,"_3044":126473},[],"Ruta del servicio VA",{"_3588":74417,"_30857":74391,"_21381":126475,"_5":14694,"_28049":126411,"_3044":126476},[],"Formato",{"_3588":74418,"_30857":74391,"_21381":126478,"_5":14694,"_28049":126411,"_3044":58076},[],{"_3588":74419,"_30857":74391,"_21381":126480,"_5":14694,"_28049":126411,"_3044":58079},[],{"_3588":74420,"_30857":74391,"_21381":126482,"_5":14694,"_28049":126411,"_3044":126483},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3588":74421,"_30857":74391,"_21381":126485,"_5":14694,"_28049":126411,"_3044":57471},[],{"_3588":74422,"_30857":74391,"_21381":126487,"_5":14694,"_28049":126411,"_3044":58087},[],{"_3588":74423,"_30857":74391,"_21381":126489,"_5":14694,"_28049":126411,"_3044":126490},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3588":74424,"_30857":74391,"_21381":126492,"_5":14694,"_28049":126411,"_3044":126493},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3588":74425,"_30857":74391,"_21381":126495,"_5":14694,"_28049":126415,"_3044":126496},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3588":74426,"_30857":74391,"_21381":126498,"_5":14694,"_28049":126415,"_3044":126499},[],"Genera la solicitud:",{"_3588":74427,"_30857":74391,"_21381":126501,"_5":14694,"_28049":126415,"_3044":126502},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3588":74428,"_30857":74391,"_21381":126504,"_5":14694,"_28049":126415,"_3044":126505},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3588":74429,"_30857":74391,"_21381":126507,"_5":14694,"_28049":126415,"_3044":126508},[],"Verifica el DER recibido:",{"_3588":74430,"_30857":74391,"_21381":126510,"_5":14694,"_28049":126415,"_3044":126511},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3588":74431,"_30857":74391,"_21381":126513,"_5":14694,"_28049":126419,"_3044":126514},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3588":74432,"_30857":74391,"_21381":126516,"_5":14694,"_28049":126419,"_3044":126517},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3588":74433,"_30857":74391,"_21381":126519,"_5":14694,"_28049":126423,"_3044":58120},[],{"_3588":74434,"_30857":74391,"_21381":126521,"_5":14694,"_28049":126423,"_3044":58123},[],{"_3588":74435,"_30857":74391,"_21381":126523,"_5":14694,"_28049":126423,"_3044":126524},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3588":74436,"_30857":74391,"_21381":126526,"_5":14694,"_28049":126423,"_3044":126009},[],{"_3588":74437,"_30857":74437,"_5":15054,"_3044":56080,"_31195":126528,"_21381":126529,"_28049":74437},[50417,120512,56080],[],{"_3588":74438,"_30857":74437,"_21381":126531,"_5":14694,"_28049":74437,"_3044":126532},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3588":74439,"_30857":74437,"_5":31192,"_21381":126534,"_28049":126535,"_3044":123837},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3588":74440,"_30857":74437,"_5":31192,"_21381":126537,"_28049":126538,"_3044":126539},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3588":74441,"_30857":74437,"_5":31192,"_21381":126541,"_28049":126542,"_3044":124357},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3588":74442,"_30857":74437,"_5":31192,"_21381":126544,"_28049":126545,"_3044":124361},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3588":74443,"_30857":74437,"_5":31192,"_21381":126547,"_28049":126548,"_3044":124365},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3588":74444,"_30857":74437,"_5":31192,"_21381":126550,"_28049":126551,"_3044":124369},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3588":74445,"_30857":74437,"_5":31192,"_21381":126553,"_28049":126554,"_3044":124377},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3588":74446,"_30857":74437,"_5":31192,"_21381":126556,"_28049":126557,"_3044":126558},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3588":74447,"_30857":74437,"_5":31192,"_21381":126560,"_28049":126561,"_3044":125317},[],"/docs/es/platform/pki/overview#continúa",{"_3588":74448,"_30857":74437,"_21381":126563,"_5":14694,"_28049":74437,"_3044":126564},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3588":74449,"_30857":74437,"_21381":126566,"_5":14694,"_28049":126535,"_3044":126567},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3588":74450,"_30857":74437,"_21381":126569,"_5":14694,"_28049":126535,"_3044":126570},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3588":74451,"_30857":74437,"_21381":126572,"_5":14694,"_28049":126538,"_3044":126573},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3588":74452,"_30857":74437,"_21381":126575,"_5":14694,"_28049":126538,"_3044":126576},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3588":74453,"_30857":74437,"_21381":126578,"_5":14694,"_28049":126538,"_3044":126579},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3588":74454,"_30857":74437,"_21381":126581,"_5":14694,"_28049":126538,"_3044":126582},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3588":74455,"_30857":74437,"_21381":126584,"_5":14694,"_28049":126538,"_3044":126585},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3588":74456,"_30857":74437,"_21381":126587,"_5":14694,"_28049":126545,"_3044":126588},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3588":74457,"_30857":74437,"_21381":126590,"_5":14694,"_28049":126548,"_3044":126591},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3588":74458,"_30857":74437,"_21381":126593,"_5":14694,"_28049":126551,"_3044":126594},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3588":74459,"_30857":74437,"_21381":126596,"_5":14694,"_28049":126554,"_3044":126597},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3588":74460,"_30857":74437,"_21381":126599,"_5":14694,"_28049":126557,"_3044":126600},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3588":74461,"_30857":74437,"_21381":126602,"_5":14694,"_28049":126557,"_3044":126603},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3588":74462,"_30857":74437,"_21381":126605,"_5":14694,"_28049":126557,"_3044":126606},[],"su clave pública corresponda a la clave privada del cliente;",{"_3588":74463,"_30857":74437,"_21381":126608,"_5":14694,"_28049":126557,"_3044":126609},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3588":74464,"_30857":74437,"_21381":126611,"_5":14694,"_28049":126557,"_3044":126612},[],"sus fechas y usos permitan la operación;",{"_3588":74465,"_30857":74437,"_21381":126614,"_5":14694,"_28049":126557,"_3044":126615},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3588":74466,"_30857":74437,"_21381":126617,"_5":14694,"_28049":126557,"_3044":126618},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3588":74467,"_30857":74437,"_21381":126620,"_5":14694,"_28049":126561,"_3044":126621},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3588":74468,"_30857":74437,"_21381":126623,"_5":14694,"_28049":126561,"_3044":126624},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3588":74469,"_30857":74437,"_21381":126626,"_5":14694,"_28049":126561,"_3044":126627},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3588":74470,"_30857":74470,"_5":15054,"_3044":126629,"_31195":126630,"_21381":126631,"_28049":74470},"Crea tu primera CA",[50417,120512,56080,123961],[],{"_3588":74471,"_30857":74470,"_21381":126633,"_5":14694,"_28049":74470,"_3044":126634},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3588":74472,"_30857":74470,"_5":31192,"_21381":126636,"_28049":126637,"_3044":119046},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3588":74473,"_30857":74470,"_5":31192,"_21381":126639,"_28049":126640,"_3044":126641},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3588":74474,"_30857":74470,"_5":31192,"_21381":126643,"_28049":126644,"_3044":126645},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3588":74475,"_30857":74470,"_5":31192,"_21381":126647,"_28049":126648,"_3044":126649},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3588":74476,"_30857":74470,"_5":31192,"_21381":126651,"_28049":126652,"_3044":126653},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3588":74477,"_30857":74470,"_5":31192,"_21381":126655,"_28049":126656,"_3044":126657},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3588":74478,"_30857":74470,"_5":31192,"_21381":126659,"_28049":126660,"_3044":126661},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3588":74479,"_30857":74470,"_5":31192,"_21381":126663,"_28049":126664,"_3044":124208},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3588":74480,"_30857":74470,"_5":31192,"_21381":126666,"_28049":126667,"_3044":119070},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3588":74481,"_30857":74470,"_21381":126669,"_5":14694,"_28049":74470,"_3044":126670},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3588":74482,"_30857":74470,"_21381":126672,"_5":14694,"_28049":126637,"_3044":126673},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3588":74483,"_30857":74470,"_21381":126675,"_5":14694,"_28049":126637,"_3044":126676},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3588":74484,"_30857":74470,"_21381":126678,"_5":14694,"_28049":126637,"_3044":126679},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3588":74485,"_30857":74470,"_21381":126681,"_5":14694,"_28049":126637,"_3044":126682},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3588":74486,"_30857":74470,"_21381":126684,"_5":14694,"_28049":126640,"_3044":126685},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3588":74487,"_30857":74470,"_21381":126687,"_5":14694,"_28049":126640,"_3044":126688},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3588":74488,"_30857":74470,"_21381":126690,"_5":14694,"_28049":126644,"_3044":126691},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3588":74489,"_30857":74470,"_21381":126693,"_5":14694,"_28049":126644,"_3044":126694},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3588":74490,"_30857":74470,"_21381":126696,"_5":14694,"_28049":126648,"_3044":126697},[],"Selecciona **Root CA** y completa:",{"_3588":74491,"_30857":74470,"_21381":126699,"_5":14694,"_28049":126648,"_3044":58302},[],{"_3588":74492,"_30857":74470,"_21381":126701,"_5":14694,"_28049":126648,"_3044":126702},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3588":74493,"_30857":74470,"_21381":126704,"_5":14694,"_28049":126648,"_3044":126705},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3588":74494,"_30857":74470,"_21381":126707,"_5":14694,"_28049":126648,"_3044":126708},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3588":74495,"_30857":74470,"_21381":126710,"_5":14694,"_28049":126648,"_3044":126711},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3588":74496,"_30857":74470,"_21381":126713,"_5":14694,"_28049":126652,"_3044":126714},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3588":74497,"_30857":74470,"_21381":126716,"_5":14694,"_28049":126656,"_3044":126717},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3588":74498,"_30857":74470,"_21381":126719,"_5":14694,"_28049":126656,"_3044":126720},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3588":74499,"_30857":74470,"_21381":126722,"_5":14694,"_28049":126660,"_3044":126723},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3588":74500,"_30857":74470,"_21381":126725,"_5":14694,"_28049":126660,"_3044":126726},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3588":74501,"_30857":74470,"_21381":126728,"_5":14694,"_28049":126660,"_3044":126729},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3588":74502,"_30857":74470,"_21381":126731,"_5":14694,"_28049":126664,"_3044":126732},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3588":74503,"_30857":74470,"_21381":126734,"_5":14694,"_28049":126664,"_3044":126735},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3588":74504,"_30857":74470,"_21381":126737,"_5":14694,"_28049":126664,"_3044":126738},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3588":74505,"_30857":74470,"_21381":126740,"_5":14694,"_28049":126664,"_3044":126741},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3588":74506,"_30857":74470,"_21381":126743,"_5":14694,"_28049":126667,"_3044":126744},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3588":74507,"_30857":74507,"_5":15054,"_3044":126746,"_31195":126747,"_21381":126748,"_28049":74507},"Emite y verifica un certificado",[50417,120512,56080,123961],[],{"_3588":74508,"_30857":74507,"_21381":126750,"_5":14694,"_28049":74507,"_3044":126751},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3588":74509,"_30857":74507,"_5":31192,"_21381":126753,"_28049":126754,"_3044":119046},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3588":74510,"_30857":74507,"_5":31192,"_21381":126756,"_28049":126757,"_3044":126758},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3588":74511,"_30857":74507,"_5":31192,"_21381":126760,"_28049":126761,"_3044":126762},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3588":74512,"_30857":74507,"_5":31192,"_21381":126764,"_28049":126765,"_3044":126766},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3588":74513,"_30857":74507,"_5":31192,"_21381":126768,"_28049":126769,"_3044":126770},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3588":74514,"_30857":74507,"_5":31192,"_21381":126772,"_28049":126773,"_3044":126774},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3588":74515,"_30857":74507,"_5":31192,"_21381":126776,"_28049":126777,"_3044":126778},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3588":74516,"_30857":74507,"_5":31192,"_21381":126780,"_28049":126781,"_3044":126782},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3588":74517,"_30857":74507,"_5":31192,"_21381":126784,"_28049":126785,"_3044":126786},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3588":74518,"_30857":74507,"_5":31192,"_21381":126788,"_28049":126789,"_3044":126790},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3588":74519,"_30857":74507,"_5":31192,"_21381":126792,"_28049":126793,"_3044":124208},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3588":74520,"_30857":74507,"_5":31192,"_21381":126795,"_28049":126796,"_3044":119070},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3588":74521,"_30857":74507,"_21381":126798,"_5":14694,"_28049":74507,"_3044":126799},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3588":74522,"_30857":74507,"_21381":126801,"_5":14694,"_28049":126754,"_3044":126802},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3588":74523,"_30857":74507,"_21381":126804,"_5":14694,"_28049":126754,"_3044":126805},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3588":74524,"_30857":74507,"_21381":126807,"_5":14694,"_28049":126754,"_3044":126808},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3588":74525,"_30857":74507,"_21381":126810,"_5":14694,"_28049":126754,"_3044":126811},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3588":74526,"_30857":74507,"_21381":126813,"_5":14694,"_28049":126754,"_3044":126814},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3588":74527,"_30857":74507,"_21381":126816,"_5":14694,"_28049":126757,"_3044":126817},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3588":74528,"_30857":74507,"_21381":126819,"_5":14694,"_28049":126761,"_3044":126820},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3588":74529,"_30857":74507,"_21381":126822,"_5":14694,"_28049":126761,"_3044":126823},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3588":74530,"_30857":74507,"_21381":126825,"_5":14694,"_28049":126765,"_3044":126826},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3588":74531,"_30857":74507,"_21381":126828,"_5":14694,"_28049":126765,"_3044":126829},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3588":74532,"_30857":74507,"_21381":126831,"_5":14694,"_28049":126769,"_3044":126832},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3588":74533,"_30857":74507,"_21381":126834,"_5":14694,"_28049":126769,"_3044":126835},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3588":74534,"_30857":74507,"_21381":126837,"_5":14694,"_28049":126773,"_3044":126838},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3588":74535,"_30857":74507,"_21381":126840,"_5":14694,"_28049":126777,"_3044":126841},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3588":74536,"_30857":74507,"_21381":126843,"_5":14694,"_28049":126781,"_3044":126844},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3588":74537,"_30857":74507,"_21381":126846,"_5":14694,"_28049":126785,"_3044":126847},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3588":74538,"_30857":74507,"_21381":126849,"_5":14694,"_28049":126785,"_3044":126850},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3588":74539,"_30857":74507,"_21381":126852,"_5":14694,"_28049":126785,"_3044":126853},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3588":74540,"_30857":74507,"_21381":126855,"_5":14694,"_28049":126789,"_3044":126856},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3588":74541,"_30857":74507,"_21381":126858,"_5":14694,"_28049":126789,"_3044":126859},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3588":74542,"_30857":74507,"_21381":126861,"_5":14694,"_28049":126789,"_3044":126862},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3588":74543,"_30857":74507,"_21381":126864,"_5":14694,"_28049":126793,"_3044":124291},[],{"_3588":74544,"_30857":74507,"_21381":126866,"_5":14694,"_28049":126793,"_3044":122812},[],{"_3588":74545,"_30857":74507,"_21381":126868,"_5":14694,"_28049":126793,"_3044":126869},[],"La CA rechaza la emisión",{"_3588":74546,"_30857":74507,"_21381":126871,"_5":14694,"_28049":126793,"_3044":126872},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3588":74547,"_30857":74507,"_21381":126874,"_5":14694,"_28049":126793,"_3044":126875},[],"Sujeto o usos diferentes",{"_3588":74548,"_30857":74507,"_21381":126877,"_5":14694,"_28049":126793,"_3044":126878},[],"Perfil aplicado y valores solicitados.",{"_3588":74549,"_30857":74507,"_21381":126880,"_5":14694,"_28049":126793,"_3044":126881},[],"No se encuentra el emisor",{"_3588":74550,"_30857":74507,"_21381":126883,"_5":14694,"_28049":126793,"_3044":126884},[],"CA descargada y cadena intermedia necesaria.",{"_3588":74551,"_30857":74507,"_21381":126886,"_5":14694,"_28049":126793,"_3044":126887},[],"Falla la vigencia",{"_3588":74552,"_30857":74507,"_21381":126889,"_5":14694,"_28049":126793,"_3044":126890},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3588":74553,"_30857":74507,"_21381":126892,"_5":14694,"_28049":126793,"_3044":126893},[],"Los resúmenes de clave difieren",{"_3588":74554,"_30857":74507,"_21381":126895,"_5":14694,"_28049":126793,"_3044":126896},[],"Archivos de certificado y clave de la misma emisión.",{"_3588":74555,"_30857":74507,"_21381":126898,"_5":14694,"_28049":126793,"_3044":126899},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3588":74556,"_30857":74507,"_21381":126901,"_5":14694,"_28049":126796,"_3044":126902},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3588":74557,"_30857":74507,"_21381":126904,"_5":14694,"_28049":126796,"_3044":126905},[],"Gestionar certificados para inspección, estado y revocación.",{"_3588":74558,"_30857":74507,"_21381":126907,"_5":14694,"_28049":126796,"_3044":126908},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3588":74559,"_30857":74507,"_21381":126910,"_5":14694,"_28049":126796,"_3044":126911},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3588":74560,"_30857":74507,"_21381":126913,"_5":14694,"_28049":126796,"_3044":126914},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3588":74561,"_30857":74561,"_5":15054,"_3044":126916,"_31195":126917,"_21381":126918,"_28049":74561},"Primeros pasos de PKI",[50417,120512,56080,123961],[],{"_3588":74562,"_30857":74561,"_21381":126920,"_5":14694,"_28049":74561,"_3044":126921},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3588":74563,"_30857":74561,"_5":31192,"_21381":126923,"_28049":126924,"_3044":119046},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3588":74564,"_30857":74561,"_5":31192,"_21381":126926,"_28049":126927,"_3044":126928},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3588":74565,"_30857":74561,"_5":31192,"_21381":126930,"_28049":126931,"_3044":124143},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3588":74566,"_30857":74561,"_5":31192,"_21381":126933,"_28049":126934,"_3044":126935},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3588":74567,"_30857":74561,"_21381":126937,"_5":14694,"_28049":74561,"_3044":126938},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3588":74568,"_30857":74561,"_21381":126940,"_5":14694,"_28049":126924,"_3044":126941},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3588":74569,"_30857":74561,"_21381":126943,"_5":14694,"_28049":126924,"_3044":126944},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3588":74570,"_30857":74561,"_21381":126946,"_5":14694,"_28049":126924,"_3044":126947},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3588":74571,"_30857":74561,"_21381":126949,"_5":14694,"_28049":126924,"_3044":126950},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3588":74572,"_30857":74561,"_21381":126952,"_5":14694,"_28049":126924,"_3044":126953},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3588":74573,"_30857":74561,"_21381":126955,"_5":14694,"_28049":126927,"_3044":126956},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3588":74574,"_30857":74561,"_21381":126958,"_5":14694,"_28049":126927,"_3044":126959},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3588":74575,"_30857":74561,"_21381":126961,"_5":14694,"_28049":126927,"_3044":126962},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3588":74576,"_30857":74561,"_21381":126964,"_5":14694,"_28049":126927,"_3044":126965},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3588":74577,"_30857":74561,"_21381":126967,"_5":14694,"_28049":126931,"_3044":126968},[],"Archivo o recurso",{"_3588":74578,"_30857":74561,"_21381":126970,"_5":14694,"_28049":126931,"_3044":124140},[],{"_3588":74579,"_30857":74561,"_21381":126972,"_5":14694,"_28049":126931,"_3044":126973},[],"CA raíz activa y `ca.pem`",{"_3588":74580,"_30857":74561,"_21381":126975,"_5":14694,"_28049":126931,"_3044":126976},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3588":74581,"_30857":74561,"_21381":126978,"_5":14694,"_28049":126931,"_3044":126979},[],"Certificado final y `device.crt`",{"_3588":74582,"_30857":74561,"_21381":126981,"_5":14694,"_28049":126931,"_3044":126982},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3588":74583,"_30857":74561,"_21381":126984,"_5":14694,"_28049":126931,"_3044":126985},[],"Clave privada `device.key`",{"_3588":74584,"_30857":74561,"_21381":126987,"_5":14694,"_28049":126931,"_3044":126988},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3588":74585,"_30857":74561,"_21381":126990,"_5":14694,"_28049":126931,"_3044":126991},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3588":74586,"_30857":74561,"_21381":126993,"_5":14694,"_28049":126934,"_3044":126994},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3588":74587,"_30857":74561,"_21381":126996,"_5":14694,"_28049":126934,"_3044":126997},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3588":74588,"_30857":74561,"_21381":126999,"_5":14694,"_28049":126934,"_3044":127000},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3588":74589,"_30857":74589,"_5":15054,"_3044":127002,"_31195":127003,"_21381":127005,"_28049":74589},"Resolución de problemas PKI",[50417,120512,56080,127004],"Resolución de problemas",[],{"_3588":74590,"_30857":74589,"_21381":127007,"_5":14694,"_28049":74589,"_3044":127008},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3588":74591,"_30857":74589,"_5":31192,"_21381":127010,"_28049":127011,"_3044":127012},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3588":74592,"_30857":74589,"_5":31192,"_21381":127014,"_28049":127015,"_3044":127016},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3588":74593,"_30857":74589,"_5":31192,"_21381":127018,"_28049":127019,"_3044":127020},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3588":74594,"_30857":74589,"_21381":127022,"_5":14694,"_28049":74589,"_3044":127023},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3588":74595,"_30857":74589,"_21381":127025,"_5":14694,"_28049":74589,"_3044":127026},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3588":74596,"_30857":74589,"_21381":127028,"_5":14694,"_28049":127011,"_3044":124140},[],{"_3588":74597,"_30857":74589,"_21381":127030,"_5":14694,"_28049":127011,"_3044":122812},[],{"_3588":74598,"_30857":74589,"_21381":127032,"_5":14694,"_28049":127011,"_3044":119070},[],{"_3588":74599,"_30857":74589,"_21381":127034,"_5":14694,"_28049":127011,"_3044":54922},[],{"_3588":74600,"_30857":74589,"_21381":127036,"_5":14694,"_28049":127011,"_3044":127037},[],"Existe, está activa y sus fechas son utilizables.",{"_3588":74601,"_30857":74589,"_21381":127039,"_5":14694,"_28049":127011,"_3044":127040},[],"Autoridades.",{"_3588":74602,"_30857":74589,"_21381":127042,"_5":14694,"_28049":127011,"_3044":127043},[],"Clave",{"_3588":74603,"_30857":74589,"_21381":127045,"_5":14694,"_28049":127011,"_3044":127046},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3588":74604,"_30857":74589,"_21381":127048,"_5":14694,"_28049":127011,"_3044":127049},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3588":74605,"_30857":74589,"_21381":127051,"_5":14694,"_28049":127011,"_3044":58656},[],{"_3588":74606,"_30857":74589,"_21381":127053,"_5":14694,"_28049":127011,"_3044":127054},[],"PEM correcto y firma verificable.",{"_3588":74607,"_30857":74589,"_21381":127056,"_5":14694,"_28049":127011,"_3044":58662},[],{"_3588":74608,"_30857":74589,"_21381":127058,"_5":14694,"_28049":127011,"_3044":127059},[],"Perfil",{"_3588":74609,"_30857":74589,"_21381":127061,"_5":14694,"_28049":127011,"_3044":127062},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3588":74610,"_30857":74589,"_21381":127064,"_5":14694,"_28049":127011,"_3044":127065},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3588":74611,"_30857":74589,"_21381":127067,"_5":14694,"_28049":127011,"_3044":124291},[],{"_3588":74612,"_30857":74589,"_21381":127069,"_5":14694,"_28049":127011,"_3044":127070},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3588":74613,"_30857":74589,"_21381":127072,"_5":14694,"_28049":127011,"_3044":127073},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3588":74614,"_30857":74589,"_21381":127075,"_5":14694,"_28049":127011,"_3044":127076},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3588":74615,"_30857":74589,"_21381":127078,"_5":14694,"_28049":127011,"_3044":127079},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3588":74616,"_30857":74589,"_21381":127081,"_5":14694,"_28049":127015,"_3044":127082},[],"Revisa cada frontera por separado:",{"_3588":74617,"_30857":74589,"_21381":127084,"_5":14694,"_28049":127015,"_3044":127085},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3588":74618,"_30857":74589,"_21381":127087,"_5":14694,"_28049":127015,"_3044":127088},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3588":74619,"_30857":74589,"_21381":127090,"_5":14694,"_28049":127015,"_3044":127091},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3588":74620,"_30857":74589,"_21381":127093,"_5":14694,"_28049":127015,"_3044":127094},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3588":74621,"_30857":74589,"_21381":127096,"_5":14694,"_28049":127015,"_3044":127097},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3588":74622,"_30857":74589,"_21381":127099,"_5":14694,"_28049":127015,"_3044":127100},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3588":74623,"_30857":74589,"_21381":127102,"_5":14694,"_28049":127019,"_3044":127103},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3588":74624,"_30857":74589,"_21381":127105,"_5":14694,"_28049":127019,"_3044":127106},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3588":74625,"_30857":74625,"_5":15054,"_3044":127108,"_31195":127109,"_21381":127110,"_28049":74625},"Seguridad",[50417],[],{"_3588":74626,"_30857":74625,"_21381":127112,"_5":14694,"_28049":74625,"_3044":127113},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3588":74627,"_30857":74625,"_5":31192,"_21381":127115,"_28049":127116,"_3044":127117},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3588":74628,"_30857":74625,"_5":31192,"_21381":127119,"_28049":127120,"_3044":127121},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3588":74629,"_30857":74625,"_5":31192,"_21381":127123,"_28049":127124,"_3044":127125},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3588":74630,"_30857":74625,"_5":31192,"_21381":127127,"_28049":127128,"_3044":127129},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3588":74631,"_30857":74625,"_21381":127131,"_5":14694,"_28049":74625,"_3044":127132},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3588":74632,"_30857":74625,"_21381":127134,"_5":14694,"_28049":127116,"_3044":127135},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3588":74633,"_30857":74625,"_21381":127137,"_5":14694,"_28049":127116,"_3044":127138},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3588":74634,"_30857":74625,"_21381":127140,"_5":14694,"_28049":127116,"_3044":15332},[],{"_3588":74635,"_30857":74625,"_21381":127142,"_5":14694,"_28049":127116,"_3044":15261},[],{"_3588":74636,"_30857":74625,"_21381":127144,"_5":14694,"_28049":127116,"_3044":15319},[],{"_3588":74637,"_30857":74625,"_21381":127146,"_5":14694,"_28049":127116,"_3044":127147},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3588":74638,"_30857":74625,"_21381":127149,"_5":14694,"_28049":127116,"_3044":127150},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3588":74639,"_30857":74625,"_21381":127152,"_5":14694,"_28049":127120,"_3044":127153},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3588":74640,"_30857":74625,"_21381":127155,"_5":14694,"_28049":127120,"_3044":127156},[],"No incluyas en el reporte:",{"_3588":74641,"_30857":74625,"_21381":127158,"_5":14694,"_28049":127120,"_3044":127159},[],"Credenciales, tokens o claves privadas",{"_3588":74642,"_30857":74625,"_21381":127161,"_5":14694,"_28049":127120,"_3044":127162},[],"Datos de clientes o información identificable de clientes",{"_3588":74643,"_30857":74625,"_21381":127164,"_5":14694,"_28049":127120,"_3044":127165},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3588":74644,"_30857":74625,"_21381":127167,"_5":14694,"_28049":127124,"_3044":127168},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3588":74645,"_30857":74625,"_21381":127170,"_5":14694,"_28049":127124,"_3044":127171},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3588":74646,"_30857":74625,"_21381":127173,"_5":14694,"_28049":127128,"_3044":127174},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3588":74647,"_30857":74625,"_21381":127176,"_5":14694,"_28049":127128,"_3044":127177},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3588":74648,"_30857":74625,"_21381":127179,"_5":14694,"_28049":127128,"_3044":127180},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3588":74649,"_30857":74625,"_21381":127182,"_5":14694,"_28049":127128,"_3044":127183},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3588":74650,"_30857":74625,"_21381":127185,"_5":14694,"_28049":127128,"_3044":127186},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3588":74651,"_30857":74651,"_5":15054,"_3044":127188,"_31195":127189,"_21381":127191,"_28049":74651},"3.8.0 a 4.0.0",[50417,127190],"Actualizaciones",[],{"_3588":74652,"_30857":74651,"_21381":127193,"_5":14694,"_28049":74651,"_3044":127194},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3588":74653,"_30857":74651,"_5":31192,"_21381":127196,"_28049":127197,"_3044":127198},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3588":74654,"_30857":74651,"_5":31192,"_21381":127200,"_28049":127201,"_3044":127202},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3588":74655,"_30857":74651,"_5":31192,"_21381":127204,"_28049":127205,"_3044":127206},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3588":74656,"_30857":74651,"_5":31192,"_21381":127208,"_28049":127209,"_3044":127210},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3588":74657,"_30857":74651,"_5":31192,"_21381":127212,"_28049":127213,"_3044":127214},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3588":74658,"_30857":74651,"_5":31192,"_21381":127216,"_28049":127217,"_3044":127218},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3588":74659,"_30857":74651,"_5":31192,"_21381":127220,"_28049":127221,"_3044":58828},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3588":74660,"_30857":74651,"_5":31192,"_21381":127223,"_28049":127224,"_3044":127225},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3588":74661,"_30857":74651,"_5":31192,"_21381":127227,"_28049":127228,"_3044":127229},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3588":74662,"_30857":74651,"_5":31192,"_21381":127231,"_28049":127232,"_3044":127233},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3588":74663,"_30857":74651,"_5":31192,"_21381":127235,"_28049":127236,"_3044":119641},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3588":74664,"_30857":74651,"_5":31192,"_21381":127238,"_28049":127239,"_3044":127240},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3588":74665,"_30857":74651,"_5":31192,"_21381":127242,"_28049":127243,"_3044":127244},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3588":74666,"_30857":74651,"_5":31192,"_21381":127246,"_28049":127247,"_3044":127248},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3588":74667,"_30857":74651,"_5":31192,"_21381":127250,"_28049":127251,"_3044":127252},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3588":74668,"_30857":74651,"_5":31192,"_21381":127254,"_28049":127255,"_3044":127256},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3588":74669,"_30857":74651,"_5":31192,"_21381":127258,"_28049":127259,"_3044":127260},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3588":74670,"_30857":74651,"_5":31192,"_21381":127262,"_28049":127263,"_3044":127264},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3588":74671,"_30857":74651,"_5":31192,"_21381":127266,"_28049":127267,"_3044":127268},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3588":74672,"_30857":74651,"_5":31192,"_21381":127270,"_28049":127271,"_3044":127272},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3588":74673,"_30857":74651,"_5":31192,"_21381":127274,"_28049":127275,"_3044":127276},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3588":74674,"_30857":74651,"_5":31192,"_21381":127278,"_28049":127279,"_3044":127280},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3588":74675,"_30857":74651,"_5":31192,"_21381":127282,"_28049":127283,"_3044":127284},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3588":74676,"_30857":74651,"_5":31192,"_21381":127286,"_28049":127287,"_3044":127288},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3588":74677,"_30857":74651,"_5":31192,"_21381":127290,"_28049":127291,"_3044":127292},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3588":74678,"_30857":74651,"_5":31192,"_21381":127294,"_28049":127295,"_3044":127296},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3588":74679,"_30857":74651,"_5":31192,"_21381":127298,"_28049":127299,"_3044":127300},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3588":74680,"_30857":74651,"_5":31192,"_21381":127302,"_28049":127303,"_3044":127304},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3588":74681,"_30857":74651,"_5":31192,"_21381":127306,"_28049":127307,"_3044":127308},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3588":74682,"_30857":74651,"_5":31192,"_21381":127310,"_28049":127311,"_3044":127312},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3588":74683,"_30857":74651,"_5":31192,"_21381":127314,"_28049":127315,"_3044":127316},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3588":74684,"_30857":74651,"_5":31192,"_21381":127318,"_28049":127319,"_3044":127320},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3588":74685,"_30857":74651,"_5":31192,"_21381":127322,"_28049":127323,"_3044":127324},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3588":74686,"_30857":74651,"_5":31192,"_21381":127326,"_28049":127327,"_3044":127328},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3588":74687,"_30857":74651,"_5":31192,"_21381":127330,"_28049":127331,"_3044":127332},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3588":74688,"_30857":74651,"_5":31192,"_21381":127334,"_28049":127335,"_3044":127336},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3588":74689,"_30857":74651,"_5":31192,"_21381":127338,"_28049":127339,"_3044":127340},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3588":74690,"_30857":74651,"_5":31192,"_21381":127342,"_28049":127343,"_3044":127344},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3588":74691,"_30857":74651,"_5":31192,"_21381":127346,"_28049":127347,"_3044":127348},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3588":74692,"_30857":74651,"_5":31192,"_21381":127350,"_28049":127351,"_3044":127352},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3588":74693,"_30857":74651,"_5":31192,"_21381":127354,"_28049":127355,"_3044":127356},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3588":74694,"_30857":74651,"_5":31192,"_21381":127358,"_28049":127359,"_3044":123154},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3588":74695,"_30857":74651,"_5":31192,"_21381":127361,"_28049":127362,"_3044":127363},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3588":74696,"_30857":74651,"_5":31192,"_21381":127365,"_28049":127366,"_3044":127367},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3588":74697,"_30857":74651,"_21381":127369,"_5":14694,"_28049":74651,"_3044":127370},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3588":74698,"_30857":74651,"_21381":127372,"_5":14694,"_28049":74651,"_3044":127373},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3588":74699,"_30857":74651,"_21381":127375,"_5":14694,"_28049":74651,"_3044":127376},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3588":74700,"_30857":74651,"_21381":127378,"_5":14694,"_28049":74651,"_3044":127379},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3588":74701,"_30857":74651,"_21381":127381,"_5":14694,"_28049":74651,"_3044":127382},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3588":74702,"_30857":74651,"_21381":127384,"_5":14694,"_28049":74651,"_3044":127385},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3588":74703,"_30857":74651,"_21381":127387,"_5":14694,"_28049":74651,"_3044":127388},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3588":74704,"_30857":74651,"_21381":127390,"_5":14694,"_28049":127201,"_3044":127391},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3588":74705,"_30857":74651,"_21381":127393,"_5":14694,"_28049":127201,"_3044":127394},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3588":74706,"_30857":74651,"_21381":127396,"_5":14694,"_28049":127205,"_3044":127397},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3588":74707,"_30857":74651,"_21381":127399,"_5":14694,"_28049":127205,"_3044":127400},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3588":74708,"_30857":74651,"_21381":127402,"_5":14694,"_28049":127209,"_3044":127403},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3588":74709,"_30857":74651,"_21381":127405,"_5":14694,"_28049":127213,"_3044":127406},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3588":74710,"_30857":74651,"_21381":127408,"_5":14694,"_28049":127213,"_3044":127409},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3588":74711,"_30857":74651,"_21381":127411,"_5":14694,"_28049":127213,"_3044":127412},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3588":74712,"_30857":74651,"_21381":127414,"_5":14694,"_28049":127213,"_3044":127415},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3588":74713,"_30857":74651,"_21381":127417,"_5":14694,"_28049":127213,"_3044":127418},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3588":74714,"_30857":74651,"_21381":127420,"_5":14694,"_28049":127217,"_3044":127421},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3588":74715,"_30857":74651,"_21381":127423,"_5":14694,"_28049":127217,"_3044":127424},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3588":74716,"_30857":74651,"_21381":127426,"_5":14694,"_28049":127217,"_3044":127427},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3588":74717,"_30857":74651,"_21381":127429,"_5":14694,"_28049":127217,"_3044":127430},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3588":74718,"_30857":74651,"_21381":127432,"_5":14694,"_28049":127217,"_3044":127433},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3588":74719,"_30857":74651,"_21381":127435,"_5":14694,"_28049":127217,"_3044":127436},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3588":74720,"_30857":74651,"_21381":127438,"_5":14694,"_28049":127221,"_3044":127439},[],"Cambio",{"_3588":74721,"_30857":74651,"_21381":127441,"_5":14694,"_28049":127221,"_3044":127442},[],"A quién afecta",{"_3588":74722,"_30857":74651,"_21381":127444,"_5":14694,"_28049":127221,"_3044":127445},[],"Gravedad",{"_3588":74723,"_30857":74651,"_21381":127447,"_5":14694,"_28049":127221,"_3044":125933},[],{"_3588":74724,"_30857":74651,"_21381":127449,"_5":14694,"_28049":127221,"_3044":127229},[],{"_3588":74725,"_30857":74651,"_21381":127451,"_5":14694,"_28049":127221,"_3044":127452},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3588":74726,"_30857":74651,"_21381":127454,"_5":14694,"_28049":127221,"_3044":127455},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3588":74727,"_30857":74651,"_21381":127457,"_5":14694,"_28049":127221,"_3044":127458},[],"Copiar los datos a los volúmenes nuevos",{"_3588":74728,"_30857":74651,"_21381":127460,"_5":14694,"_28049":127221,"_3044":127233},[],{"_3588":74729,"_30857":74651,"_21381":127462,"_5":14694,"_28049":127221,"_3044":127463},[],"Todas las releases de Helm",{"_3588":74730,"_30857":74651,"_21381":127465,"_5":14694,"_28049":127221,"_3044":127466},[],"Alta: `helm upgrade` falla",{"_3588":74731,"_30857":74651,"_21381":127468,"_5":14694,"_28049":127221,"_3044":127469},[],"Eliminar o renombrar las claves heredadas",{"_3588":74732,"_30857":74651,"_21381":127471,"_5":14694,"_28049":127221,"_3044":119641},[],{"_3588":74733,"_30857":74651,"_21381":127473,"_5":14694,"_28049":127221,"_3044":127463},[],{"_3588":74734,"_30857":74651,"_21381":127475,"_5":14694,"_28049":127221,"_3044":127476},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3588":74735,"_30857":74651,"_21381":127478,"_5":14694,"_28049":127221,"_3044":127479},[],"Crear primero los Secrets; consulta el paso 2",{"_3588":74736,"_30857":74651,"_21381":127481,"_5":14694,"_28049":127221,"_3044":127240},[],{"_3588":74737,"_30857":74651,"_21381":127483,"_5":14694,"_28049":127221,"_3044":127484},[],"Todos los despliegues",{"_3588":74738,"_30857":74651,"_21381":127486,"_5":14694,"_28049":127221,"_3044":127487},[],"Alta: sin principal de bootstrap no hay administrador",{"_3588":74739,"_30857":74651,"_21381":127489,"_5":14694,"_28049":127221,"_3044":127490},[],"Configurar `services.authz`",{"_3588":74740,"_30857":74651,"_21381":127492,"_5":14694,"_28049":127221,"_3044":127244},[],{"_3588":74741,"_30857":74651,"_21381":127494,"_5":14694,"_28049":127221,"_3044":127463},[],{"_3588":74742,"_30857":74651,"_21381":127496,"_5":14694,"_28049":127221,"_3044":127497},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3588":74743,"_30857":74651,"_21381":127499,"_5":14694,"_28049":127221,"_3044":127500},[],"Mover JWKS y roles a `services.authz`",{"_3588":74744,"_30857":74651,"_21381":127502,"_5":14694,"_28049":127221,"_3044":127264},[],{"_3588":74745,"_30857":74651,"_21381":127504,"_5":14694,"_28049":127221,"_3044":127505},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3588":74746,"_30857":74651,"_21381":127507,"_5":14694,"_28049":127221,"_3044":127508},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3588":74747,"_30857":74651,"_21381":127510,"_5":14694,"_28049":127221,"_3044":127511},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3588":74748,"_30857":74651,"_21381":127513,"_5":14694,"_28049":127221,"_3044":127268},[],{"_3588":74749,"_30857":74651,"_21381":127515,"_5":14694,"_28049":127221,"_3044":127516},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3588":74750,"_30857":74651,"_21381":127518,"_5":14694,"_28049":127221,"_3044":127519},[],"Alta: el backend ya no arranca con ellos",{"_3588":74751,"_30857":74651,"_21381":127521,"_5":14694,"_28049":127221,"_3044":127522},[],"Pasar a PostgreSQL antes de actualizar",{"_3588":74752,"_30857":74651,"_21381":127524,"_5":14694,"_28049":127221,"_3044":127312},[],{"_3588":74753,"_30857":74651,"_21381":127526,"_5":14694,"_28049":127221,"_3044":127527},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3588":74754,"_30857":74651,"_21381":127529,"_5":14694,"_28049":127221,"_3044":127530},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3588":74755,"_30857":74651,"_21381":127532,"_5":14694,"_28049":127221,"_3044":127533},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3588":74756,"_30857":74651,"_21381":127535,"_5":14694,"_28049":127221,"_3044":127536},[],"Webhooks con referencias a archivos",{"_3588":74757,"_30857":74651,"_21381":127538,"_5":14694,"_28049":127221,"_3044":127539},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3588":74758,"_30857":74651,"_21381":127541,"_5":14694,"_28049":127221,"_3044":127542},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3588":74759,"_30857":74651,"_21381":127544,"_5":14694,"_28049":127221,"_3044":127545},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3588":74760,"_30857":74651,"_21381":127547,"_5":14694,"_28049":127221,"_3044":127248},[],{"_3588":74761,"_30857":74651,"_21381":127549,"_5":14694,"_28049":127221,"_3044":127550},[],"Releases con identidades por servicio o material de claves montado",{"_3588":74762,"_30857":74651,"_21381":127552,"_5":14694,"_28049":127221,"_3044":127553},[],"Media: los servicios no pueden leer sus archivos",{"_3588":74763,"_30857":74651,"_21381":127555,"_5":14694,"_28049":127221,"_3044":127556},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3588":74764,"_30857":74651,"_21381":127558,"_5":14694,"_28049":127221,"_3044":127252},[],{"_3588":74765,"_30857":74651,"_21381":127560,"_5":14694,"_28049":127221,"_3044":127561},[],"Releases que definen `amqp.tls`",{"_3588":74766,"_30857":74651,"_21381":127563,"_5":14694,"_28049":127221,"_3044":127564},[],"Media: los clientes se conectan al puerto equivocado",{"_3588":74767,"_30857":74651,"_21381":127566,"_5":14694,"_28049":127221,"_3044":127567},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3588":74768,"_30857":74651,"_21381":127569,"_5":14694,"_28049":127221,"_3044":127272},[],{"_3588":74769,"_30857":74651,"_21381":127571,"_5":14694,"_28049":127221,"_3044":127572},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3588":74770,"_30857":74651,"_21381":127574,"_5":14694,"_28049":127221,"_3044":127575},[],"Media: las claves de CA quedan sin gestionar",{"_3588":74771,"_30857":74651,"_21381":127577,"_5":14694,"_28049":127221,"_3044":127578},[],"Ejecutar la migración de CA a KMS",{"_3588":74772,"_30857":74651,"_21381":127580,"_5":14694,"_28049":127221,"_3044":127581},[],"Verificación del certificado del receptor",{"_3588":74773,"_30857":74651,"_21381":127583,"_5":14694,"_28049":127221,"_3044":127584},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3588":74774,"_30857":74651,"_21381":127586,"_5":14694,"_28049":127221,"_3044":127587},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3588":74775,"_30857":74651,"_21381":127589,"_5":14694,"_28049":127221,"_3044":127590},[],"Poner `insecure_skip_verify` a `false`",{"_3588":74776,"_30857":74651,"_21381":127592,"_5":14694,"_28049":127221,"_3044":127288},[],{"_3588":74777,"_30857":74651,"_21381":127594,"_5":14694,"_28049":127221,"_3044":127595},[],"Scripts y consolas que editan DMS por API",{"_3588":74778,"_30857":74651,"_21381":127597,"_5":14694,"_28049":127221,"_3044":127598},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3588":74779,"_30857":74651,"_21381":127600,"_5":14694,"_28049":127221,"_3044":127601},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3588":74780,"_30857":74651,"_21381":127603,"_5":14694,"_28049":127221,"_3044":127308},[],{"_3588":74781,"_30857":74651,"_21381":127605,"_5":14694,"_28049":127221,"_3044":127606},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3588":74782,"_30857":74651,"_21381":127608,"_5":14694,"_28049":127221,"_3044":127609},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3588":74783,"_30857":74651,"_21381":127611,"_5":14694,"_28049":127221,"_3044":127612},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3588":74784,"_30857":74651,"_21381":127614,"_5":14694,"_28049":127221,"_3044":127316},[],{"_3588":74785,"_30857":74651,"_21381":127616,"_5":14694,"_28049":127221,"_3044":127617},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3588":74786,"_30857":74651,"_21381":127619,"_5":14694,"_28049":127221,"_3044":127620},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3588":74787,"_30857":74651,"_21381":127622,"_5":14694,"_28049":127221,"_3044":127623},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3588":74788,"_30857":74651,"_21381":127625,"_5":14694,"_28049":127221,"_3044":127304},[],{"_3588":74789,"_30857":74651,"_21381":127627,"_5":14694,"_28049":127221,"_3044":127628},[],"Consumidores que leen el campo `events` del dispositivo",{"_3588":74790,"_30857":74651,"_21381":127630,"_5":14694,"_28049":127221,"_3044":127631},[],"Media: el campo desaparece",{"_3588":74791,"_30857":74651,"_21381":127633,"_5":14694,"_28049":127221,"_3044":127634},[],"Usar los nuevos endpoints de eventos",{"_3588":74792,"_30857":74651,"_21381":127636,"_5":14694,"_28049":127221,"_3044":127324},[],{"_3588":74793,"_30857":74651,"_21381":127638,"_5":14694,"_28049":127221,"_3044":127639},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3588":74794,"_30857":74651,"_21381":127641,"_5":14694,"_28049":127221,"_3044":127642},[],"Media: la migración de la VA aborta",{"_3588":74795,"_30857":74651,"_21381":127644,"_5":14694,"_28049":127221,"_3044":127645},[],"Corregir los roles afectados antes de actualizar",{"_3588":74796,"_30857":74651,"_21381":127647,"_5":14694,"_28049":127221,"_3044":127256},[],{"_3588":74797,"_30857":74651,"_21381":127649,"_5":14694,"_28049":127221,"_3044":127650},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3588":74798,"_30857":74651,"_21381":127652,"_5":14694,"_28049":127221,"_3044":127653},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3588":74799,"_30857":74651,"_21381":127655,"_5":14694,"_28049":127221,"_3044":127656},[],"Actualizar el archivo de values",{"_3588":74800,"_30857":74651,"_21381":127658,"_5":14694,"_28049":127221,"_3044":127296},[],{"_3588":74801,"_30857":74651,"_21381":127660,"_5":14694,"_28049":127221,"_3044":127661},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3588":74802,"_30857":74651,"_21381":127663,"_5":14694,"_28049":127221,"_3044":127664},[],"Baja: prevalece el ID de la URL",{"_3588":74803,"_30857":74651,"_21381":127666,"_5":14694,"_28049":127221,"_3044":127667},[],"Enviar el ID en la URL",{"_3588":74804,"_30857":74651,"_21381":127669,"_5":14694,"_28049":127221,"_3044":127320},[],{"_3588":74805,"_30857":74651,"_21381":127671,"_5":14694,"_28049":127221,"_3044":127672},[],"Clientes que envían un `id` al crear o importar CAs",{"_3588":74806,"_30857":74651,"_21381":127674,"_5":14694,"_28049":127221,"_3044":127675},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3588":74807,"_30857":74651,"_21381":127677,"_5":14694,"_28049":127221,"_3044":127678},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3588":74808,"_30857":74651,"_21381":127680,"_5":14694,"_28049":127221,"_3044":127300},[],{"_3588":74809,"_30857":74651,"_21381":127682,"_5":14694,"_28049":127221,"_3044":127683},[],"Consumidores que comparan el `type` del certificado",{"_3588":74810,"_30857":74651,"_21381":127685,"_5":14694,"_28049":127221,"_3044":127686},[],"Baja: dos valores cambian de nombre",{"_3588":74811,"_30857":74651,"_21381":127688,"_5":14694,"_28049":127221,"_3044":127689},[],"Adaptar los consumidores",{"_3588":74812,"_30857":74651,"_21381":127691,"_5":14694,"_28049":127221,"_3044":127292},[],{"_3588":74813,"_30857":74651,"_21381":127693,"_5":14694,"_28049":127221,"_3044":127694},[],"Cualquier DMS",{"_3588":74814,"_30857":74651,"_21381":127696,"_5":14694,"_28049":127221,"_3044":127697},[],"Baja: solo informativo",{"_3588":74815,"_30857":74651,"_21381":127699,"_5":14694,"_28049":127221,"_3044":127700},[],"Revisar ambos bloques antes de editar",{"_3588":74816,"_30857":74651,"_21381":127702,"_5":14694,"_28049":127228,"_3044":127703},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3588":74817,"_30857":74651,"_21381":127705,"_5":14694,"_28049":127228,"_3044":127706},[],"El paso 4 de la guía de migración copia los datos.",{"_3588":74818,"_30857":74651,"_21381":127708,"_5":14694,"_28049":127232,"_3044":127709},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3588":74819,"_30857":74651,"_21381":127711,"_5":14694,"_28049":127236,"_3044":127712},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3588":74820,"_30857":74651,"_21381":127714,"_5":14694,"_28049":127236,"_3044":127715},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3588":74821,"_30857":74651,"_21381":127717,"_5":14694,"_28049":127239,"_3044":127718},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3588":74822,"_30857":74651,"_21381":127720,"_5":14694,"_28049":127243,"_3044":127721},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3588":74823,"_30857":74651,"_21381":127723,"_5":14694,"_28049":127247,"_3044":127724},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3588":74824,"_30857":74651,"_21381":127726,"_5":14694,"_28049":127247,"_3044":127727},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3588":74825,"_30857":74651,"_21381":127729,"_5":14694,"_28049":127247,"_3044":127730},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3588":74826,"_30857":74651,"_21381":127732,"_5":14694,"_28049":127251,"_3044":127733},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3588":74827,"_30857":74651,"_21381":127735,"_5":14694,"_28049":127255,"_3044":127736},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3588":74828,"_30857":74651,"_21381":127738,"_5":14694,"_28049":127255,"_3044":127739},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3588":74829,"_30857":74651,"_21381":127741,"_5":14694,"_28049":127255,"_3044":127742},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3588":74830,"_30857":74651,"_21381":127744,"_5":14694,"_28049":127255,"_3044":127745},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3588":74831,"_30857":74651,"_21381":127747,"_5":14694,"_28049":127255,"_3044":127748},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3588":74832,"_30857":74651,"_21381":127750,"_5":14694,"_28049":127255,"_3044":127751},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3588":74833,"_30857":74651,"_21381":127753,"_5":14694,"_28049":127263,"_3044":127754},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3588":74834,"_30857":74651,"_21381":127756,"_5":14694,"_28049":127263,"_3044":127757},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3588":74835,"_30857":74651,"_21381":127759,"_5":14694,"_28049":127263,"_3044":127760},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3588":74836,"_30857":74651,"_21381":127762,"_5":14694,"_28049":127263,"_3044":127763},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3588":74837,"_30857":74651,"_21381":127765,"_5":14694,"_28049":127263,"_3044":127766},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3588":74838,"_30857":74651,"_21381":127768,"_5":14694,"_28049":127267,"_3044":127769},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3588":74839,"_30857":74651,"_21381":127771,"_5":14694,"_28049":127271,"_3044":127772},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3588":74840,"_30857":74651,"_21381":127774,"_5":14694,"_28049":127271,"_3044":127775},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3588":74841,"_30857":74651,"_21381":127777,"_5":14694,"_28049":127271,"_3044":127778},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3588":74842,"_30857":74651,"_21381":127780,"_5":14694,"_28049":127271,"_3044":127781},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3588":74843,"_30857":74651,"_21381":127783,"_5":14694,"_28049":127271,"_3044":127784},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3588":74844,"_30857":74651,"_21381":127786,"_5":14694,"_28049":127271,"_3044":127787},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3588":74845,"_30857":74651,"_21381":127789,"_5":14694,"_28049":127271,"_3044":127790},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3588":74846,"_30857":74651,"_21381":127792,"_5":14694,"_28049":127271,"_3044":127793},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3588":74847,"_30857":74651,"_21381":127795,"_5":14694,"_28049":127275,"_3044":127796},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3588":74848,"_30857":74651,"_21381":127798,"_5":14694,"_28049":127283,"_3044":127799},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3588":74849,"_30857":74651,"_21381":127801,"_5":14694,"_28049":127283,"_3044":127802},[],"Campo en 3.8.0",{"_3588":74850,"_30857":74651,"_21381":127804,"_5":14694,"_28049":127283,"_3044":127805},[],"Campo en 4.0.0",{"_3588":74851,"_30857":74651,"_21381":127807,"_5":14694,"_28049":127283,"_3044":59415},[],{"_3588":74852,"_30857":74651,"_21381":127809,"_5":14694,"_28049":127283,"_3044":127810},[],"`insecure_skip_verify` (con el valor negado)",{"_3588":74853,"_30857":74651,"_21381":127812,"_5":14694,"_28049":127283,"_3044":59421},[],{"_3588":74854,"_30857":74651,"_21381":127814,"_5":14694,"_28049":127283,"_3044":59424},[],{"_3588":74855,"_30857":74651,"_21381":127816,"_5":14694,"_28049":127283,"_3044":59427},[],{"_3588":74856,"_30857":74651,"_21381":127818,"_5":14694,"_28049":127283,"_3044":59430},[],{"_3588":74857,"_30857":74651,"_21381":127820,"_5":14694,"_28049":127283,"_3044":59433},[],{"_3588":74858,"_30857":74651,"_21381":127822,"_5":14694,"_28049":127283,"_3044":59436},[],{"_3588":74859,"_30857":74651,"_21381":127824,"_5":14694,"_28049":127283,"_3044":127825},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3588":74860,"_30857":74651,"_21381":127827,"_5":14694,"_28049":127283,"_3044":127828},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3588":74861,"_30857":74651,"_21381":127830,"_5":14694,"_28049":127283,"_3044":127831},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3588":74862,"_30857":74651,"_21381":127833,"_5":14694,"_28049":127287,"_3044":127834},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3588":74863,"_30857":74651,"_21381":127836,"_5":14694,"_28049":127287,"_3044":127837},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3588":74864,"_30857":74651,"_21381":127839,"_5":14694,"_28049":127287,"_3044":127840},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3588":74865,"_30857":74651,"_21381":127842,"_5":14694,"_28049":127291,"_3044":127843},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3588":74866,"_30857":74651,"_21381":127845,"_5":14694,"_28049":127295,"_3044":127846},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3588":74867,"_30857":74651,"_21381":127848,"_5":14694,"_28049":127299,"_3044":127849},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3588":74868,"_30857":74651,"_21381":127851,"_5":14694,"_28049":127303,"_3044":127852},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3588":74869,"_30857":74651,"_21381":127854,"_5":14694,"_28049":127303,"_3044":127855},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3588":74870,"_30857":74651,"_21381":127857,"_5":14694,"_28049":127303,"_3044":127858},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3588":74871,"_30857":74651,"_21381":127860,"_5":14694,"_28049":127303,"_3044":127861},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3588":74872,"_30857":74651,"_21381":127863,"_5":14694,"_28049":127307,"_3044":127864},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3588":74873,"_30857":74651,"_21381":127866,"_5":14694,"_28049":127311,"_3044":127867},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3588":74874,"_30857":74651,"_21381":127869,"_5":14694,"_28049":127311,"_3044":127870},[],"Ruta",{"_3588":74875,"_30857":74651,"_21381":127872,"_5":14694,"_28049":127311,"_3044":120272},[],{"_3588":74876,"_30857":74651,"_21381":127874,"_5":14694,"_28049":127311,"_3044":59489},[],{"_3588":74877,"_30857":74651,"_21381":127876,"_5":14694,"_28049":127311,"_3044":127877},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3588":74878,"_30857":74651,"_21381":127879,"_5":14694,"_28049":127311,"_3044":59495},[],{"_3588":74879,"_30857":74651,"_21381":127881,"_5":14694,"_28049":127311,"_3044":127882},[],"Lee los ajustes de una CA.",{"_3588":74880,"_30857":74651,"_21381":127884,"_5":14694,"_28049":127311,"_3044":59501},[],{"_3588":74881,"_30857":74651,"_21381":127886,"_5":14694,"_28049":127311,"_3044":127887},[],"Sustituye los `crl_options`.",{"_3588":74882,"_30857":74651,"_21381":127889,"_5":14694,"_28049":127311,"_3044":59507},[],{"_3588":74883,"_30857":74651,"_21381":127891,"_5":14694,"_28049":127311,"_3044":127892},[],"Elimina los ajustes archivados de una CA.",{"_3588":74884,"_30857":74651,"_21381":127894,"_5":14694,"_28049":127311,"_3044":127895},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3588":74885,"_30857":74651,"_21381":127897,"_5":14694,"_28049":127311,"_3044":127898},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3588":74886,"_30857":74651,"_21381":127900,"_5":14694,"_28049":127311,"_3044":127901},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3588":74887,"_30857":74651,"_21381":127903,"_5":14694,"_28049":127311,"_3044":127904},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3588":74888,"_30857":74651,"_21381":127906,"_5":14694,"_28049":127311,"_3044":127907},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3588":74889,"_30857":74651,"_21381":127909,"_5":14694,"_28049":127311,"_3044":127910},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3588":74890,"_30857":74651,"_21381":127912,"_5":14694,"_28049":127311,"_3044":127913},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3588":74891,"_30857":74651,"_21381":127915,"_5":14694,"_28049":127311,"_3044":127916},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3588":74892,"_30857":74651,"_21381":127918,"_5":14694,"_28049":127311,"_3044":127919},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3588":74893,"_30857":74651,"_21381":127921,"_5":14694,"_28049":127311,"_3044":127922},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3588":74894,"_30857":74651,"_21381":127924,"_5":14694,"_28049":127311,"_3044":127925},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3588":74895,"_30857":74651,"_21381":127927,"_5":14694,"_28049":127315,"_3044":127928},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3588":74896,"_30857":74651,"_21381":127930,"_5":14694,"_28049":127319,"_3044":127931},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3588":74897,"_30857":74651,"_21381":127933,"_5":14694,"_28049":127323,"_3044":127934},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3588":74898,"_30857":74651,"_21381":127936,"_5":14694,"_28049":127327,"_3044":127937},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3588":74899,"_30857":74651,"_21381":127939,"_5":14694,"_28049":127331,"_3044":127940},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3588":74900,"_30857":74651,"_21381":127942,"_5":14694,"_28049":127331,"_3044":127943},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3588":74901,"_30857":74651,"_21381":127945,"_5":14694,"_28049":127331,"_3044":127946},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3588":74902,"_30857":74651,"_21381":127948,"_5":14694,"_28049":127331,"_3044":127949},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3588":74903,"_30857":74651,"_21381":127951,"_5":14694,"_28049":127331,"_3044":127952},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3588":74904,"_30857":74651,"_21381":127954,"_5":14694,"_28049":127331,"_3044":127955},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3588":74905,"_30857":74651,"_21381":127957,"_5":14694,"_28049":127335,"_3044":127958},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3588":74906,"_30857":74651,"_21381":127960,"_5":14694,"_28049":127335,"_3044":127961},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3588":74907,"_30857":74651,"_21381":127963,"_5":14694,"_28049":127335,"_3044":127964},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3588":74908,"_30857":74651,"_21381":127966,"_5":14694,"_28049":127335,"_3044":127967},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3588":74909,"_30857":74651,"_21381":127969,"_5":14694,"_28049":127335,"_3044":127970},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3588":74910,"_30857":74651,"_21381":127972,"_5":14694,"_28049":127339,"_3044":127973},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3588":74911,"_30857":74651,"_21381":127975,"_5":14694,"_28049":127339,"_3044":127976},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3588":74912,"_30857":74651,"_21381":127978,"_5":14694,"_28049":127339,"_3044":127979},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3588":74913,"_30857":74651,"_21381":127981,"_5":14694,"_28049":127339,"_3044":59600},[],{"_3588":74914,"_30857":74651,"_21381":127983,"_5":14694,"_28049":127339,"_3044":127984},[],"Claves de datos obligatorias",{"_3588":74915,"_30857":74651,"_21381":127986,"_5":14694,"_28049":127339,"_3044":127987},[],"Cuándo",{"_3588":74916,"_30857":74651,"_21381":127989,"_5":14694,"_28049":127339,"_3044":127990},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3588":74917,"_30857":74651,"_21381":127992,"_5":14694,"_28049":127339,"_3044":59612},[],{"_3588":74918,"_30857":74651,"_21381":127994,"_5":14694,"_28049":127339,"_3044":127995},[],"Siempre",{"_3588":74919,"_30857":74651,"_21381":127997,"_5":14694,"_28049":127339,"_3044":127998},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3588":74920,"_30857":74651,"_21381":128000,"_5":14694,"_28049":127339,"_3044":59612},[],{"_3588":74921,"_30857":74651,"_21381":128002,"_5":14694,"_28049":127339,"_3044":127995},[],{"_3588":74922,"_30857":74651,"_21381":128004,"_5":14694,"_28049":127339,"_3044":59625},[],{"_3588":74923,"_30857":74651,"_21381":128006,"_5":14694,"_28049":127339,"_3044":59612},[],{"_3588":74924,"_30857":74651,"_21381":128008,"_5":14694,"_28049":127339,"_3044":128009},[],"Solo cuando hay autenticación SMTP",{"_3588":74925,"_30857":74651,"_21381":128011,"_5":14694,"_28049":127339,"_3044":128012},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3588":74926,"_30857":74651,"_21381":128014,"_5":14694,"_28049":127339,"_3044":128015},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3588":74927,"_30857":74651,"_21381":128017,"_5":14694,"_28049":127339,"_3044":128018},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3588":74928,"_30857":74651,"_21381":128020,"_5":14694,"_28049":127339,"_3044":128021},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3588":74929,"_30857":74651,"_21381":128023,"_5":14694,"_28049":127339,"_3044":128024},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3588":74930,"_30857":74651,"_21381":128026,"_5":14694,"_28049":127339,"_3044":128027},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3588":74931,"_30857":74651,"_21381":128029,"_5":14694,"_28049":127339,"_3044":128030},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3588":74932,"_30857":74651,"_21381":128032,"_5":14694,"_28049":127339,"_3044":128033},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3588":74933,"_30857":74651,"_21381":128035,"_5":14694,"_28049":127339,"_3044":128036},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3588":74934,"_30857":74651,"_21381":128038,"_5":14694,"_28049":127339,"_3044":128039},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3588":74935,"_30857":74651,"_21381":128041,"_5":14694,"_28049":127339,"_3044":128042},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3588":74936,"_30857":74651,"_21381":128044,"_5":14694,"_28049":127339,"_3044":128045},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3588":74937,"_30857":74651,"_21381":128047,"_5":14694,"_28049":127339,"_3044":128048},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3588":74938,"_30857":74651,"_21381":128050,"_5":14694,"_28049":127339,"_3044":128051},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3588":74939,"_30857":74651,"_21381":128053,"_5":14694,"_28049":127339,"_3044":128054},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3588":74940,"_30857":74651,"_21381":128056,"_5":14694,"_28049":127343,"_3044":128057},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3588":74941,"_30857":74651,"_21381":128059,"_5":14694,"_28049":127343,"_3044":128060},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3588":74942,"_30857":74651,"_21381":128062,"_5":14694,"_28049":127347,"_3044":128063},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3588":74943,"_30857":74651,"_21381":128065,"_5":14694,"_28049":127347,"_3044":128066},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3588":74944,"_30857":74651,"_21381":128068,"_5":14694,"_28049":127347,"_3044":128069},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3588":74945,"_30857":74651,"_21381":128071,"_5":14694,"_28049":127347,"_3044":128072},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3588":74946,"_30857":74651,"_21381":128074,"_5":14694,"_28049":127347,"_3044":128075},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3588":74947,"_30857":74651,"_21381":128077,"_5":14694,"_28049":127347,"_3044":128078},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3588":74948,"_30857":74651,"_21381":128080,"_5":14694,"_28049":127347,"_3044":128081},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3588":74949,"_30857":74651,"_21381":128083,"_5":14694,"_28049":127347,"_3044":128084},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3588":74950,"_30857":74651,"_21381":128086,"_5":14694,"_28049":127347,"_3044":128087},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3588":74951,"_30857":74651,"_21381":128089,"_5":14694,"_28049":127347,"_3044":128090},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3588":74952,"_30857":74651,"_21381":128092,"_5":14694,"_28049":127347,"_3044":128093},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3588":74953,"_30857":74651,"_21381":128095,"_5":14694,"_28049":127351,"_3044":128096},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3588":74954,"_30857":74651,"_21381":128098,"_5":14694,"_28049":127351,"_3044":128099},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3588":74955,"_30857":74651,"_21381":128101,"_5":14694,"_28049":127355,"_3044":128102},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3588":74956,"_30857":74651,"_21381":128104,"_5":14694,"_28049":127355,"_3044":128105},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3588":74957,"_30857":74651,"_21381":128107,"_5":14694,"_28049":127355,"_3044":128108},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3588":74958,"_30857":74651,"_21381":128110,"_5":14694,"_28049":127355,"_3044":128111},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3588":74959,"_30857":74651,"_21381":128113,"_5":14694,"_28049":127355,"_3044":128114},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3588":74960,"_30857":74651,"_21381":128116,"_5":14694,"_28049":127355,"_3044":128117},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3588":74961,"_30857":74651,"_21381":128119,"_5":14694,"_28049":127355,"_3044":128120},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3588":74962,"_30857":74651,"_21381":128122,"_5":14694,"_28049":127355,"_3044":128123},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3588":74963,"_30857":74651,"_21381":128125,"_5":14694,"_28049":127359,"_3044":128126},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3588":74964,"_30857":74651,"_21381":128128,"_5":14694,"_28049":127359,"_3044":128129},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3588":74965,"_30857":74651,"_21381":128131,"_5":14694,"_28049":127359,"_3044":128132},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3588":74966,"_30857":74651,"_21381":128134,"_5":14694,"_28049":127359,"_3044":128135},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3588":74967,"_30857":74651,"_21381":128137,"_5":14694,"_28049":127359,"_3044":128138},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3588":74968,"_30857":74651,"_21381":128140,"_5":14694,"_28049":127359,"_3044":128141},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3588":74969,"_30857":74651,"_21381":128143,"_5":14694,"_28049":127359,"_3044":128144},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3588":74970,"_30857":74651,"_21381":128146,"_5":14694,"_28049":127359,"_3044":128147},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3588":74971,"_30857":74651,"_21381":128149,"_5":14694,"_28049":127359,"_3044":128150},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3588":74972,"_30857":74651,"_21381":128152,"_5":14694,"_28049":127359,"_3044":128153},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3588":74973,"_30857":74651,"_21381":128155,"_5":14694,"_28049":127359,"_3044":128156},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3588":74974,"_30857":74651,"_21381":128158,"_5":14694,"_28049":127362,"_3044":128159},[],"Tras la actualización, comprueba en este orden:",{"_3588":74975,"_30857":74651,"_21381":128161,"_5":14694,"_28049":127362,"_3044":128162},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3588":74976,"_30857":74651,"_21381":128164,"_5":14694,"_28049":127362,"_3044":128165},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3588":74977,"_30857":74651,"_21381":128167,"_5":14694,"_28049":127362,"_3044":128168},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3588":74978,"_30857":74651,"_21381":128170,"_5":14694,"_28049":127362,"_3044":128171},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3588":74979,"_30857":74651,"_21381":128173,"_5":14694,"_28049":127362,"_3044":128174},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3588":74980,"_30857":74651,"_21381":128176,"_5":14694,"_28049":127362,"_3044":128177},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3588":74981,"_30857":74651,"_21381":128179,"_5":14694,"_28049":127362,"_3044":128180},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3588":74982,"_30857":74651,"_21381":128182,"_5":14694,"_28049":127362,"_3044":128183},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3588":74983,"_30857":74651,"_21381":128185,"_5":14694,"_28049":127362,"_3044":128186},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3588":74984,"_30857":74651,"_21381":128188,"_5":14694,"_28049":127362,"_3044":128189},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3588":74985,"_30857":74651,"_21381":128191,"_5":14694,"_28049":127362,"_3044":128192},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3588":74986,"_30857":74651,"_21381":128194,"_5":14694,"_28049":127362,"_3044":128195},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3588":74987,"_30857":74651,"_21381":128197,"_5":14694,"_28049":127362,"_3044":128198},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3588":74988,"_30857":74651,"_21381":128200,"_5":14694,"_28049":127362,"_3044":128201},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3588":74989,"_30857":74651,"_21381":128203,"_5":14694,"_28049":127362,"_3044":128204},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3588":74990,"_30857":74651,"_21381":128206,"_5":14694,"_28049":127366,"_3044":128207},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3588":74991,"_30857":74651,"_21381":128209,"_5":14694,"_28049":127366,"_3044":128210},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3588":74992,"_30857":74651,"_21381":128212,"_5":14694,"_28049":127366,"_3044":128213},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3588":74993,"_30857":74651,"_21381":128215,"_5":14694,"_28049":127366,"_3044":