190":56472,"_39192":56475,"_39194":56478,"_39196":56481,"_39198":56484,"_39200":56487,"_39202":56490,"_39204":56493,"_39206":56496,"_39208":56499,"_39210":56502,"_39212":56505,"_39214":56508,"_39216":56511,"_39218":56514,"_39220":56517,"_39222":56520,"_39224":56523,"_39226":56526,"_39228":56529,"_39230":56532,"_39232":56535,"_39234":56538,"_39237":56541,"_39239":56544,"_39241":56547,"_39243":56550,"_39245":56553,"_39247":56556,"_39249":56559,"_39251":56562,"_39253":56565,"_39255":56568,"_39257":56571,"_39259":56574,"_39261":56577,"_39263":56580,"_39265":56583,"_39267":56586,"_39269":56589,"_39271":56592,"_39273":56595,"_39275":56598,"_39277":56601,"_39279":56604,"_39281":56607,"_39283":56610,"_39285":56613,"_39287":56616,"_39289":56619,"_39291":56622,"_39293":56625,"_39295":56628,"_39297":56631,"_39300":56634,"_39302":56637,"_39304":56640,"_39307":56643,"_39309":56646,"_39311":56649,"_39313":56652,"_39315":56655,"_39317":56658,"_39319":56661,"_39321":56664,"_39323":56667,"_39325":56670,"_39327":56673,"_39329":56676,"_39331":56679,"_39333":56682,"_39335":56685,"_39337":56688,"_39339":56691,"_39341":56694,"_39343":56697,"_39345":56700,"_39347":56703,"_39349":56706,"_39351":56709,"_39353":56712,"_39355":56715,"_39357":56718,"_39359":56721,"_39361":56724,"_39363":56727,"_39365":56730,"_39367":56733,"_39369":56736,"_39371":56739,"_39373":56742,"_39375":56745,"_39377":56748,"_39379":56751,"_39381":56754,"_39384":56757,"_39386":56760,"_39388":56763,"_39390":56766},{"_3355":15,"_29485":15,"_5":14411,"_2843":47937,"_29817":47938,"_20482":47942,"_26831":15},"Deploy from AWS Marketplace",[47939,47940,47941],"Docs","Deployment","Other models",[],{"_3355":16,"_29485":15,"_20482":47944,"_5":14053,"_26831":15,"_2843":47945},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3355":17,"_29485":15,"_5":29814,"_20482":47947,"_26831":47948,"_2843":47949},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3355":18,"_29485":15,"_5":29814,"_20482":47951,"_26831":47952,"_2843":47953},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3355":19,"_29485":15,"_5":29814,"_20482":47955,"_26831":47956,"_2843":47957},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3355":20,"_29485":15,"_5":29814,"_20482":47959,"_26831":47960,"_2843":47961},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3355":21,"_29485":15,"_5":29814,"_20482":47963,"_26831":47964,"_2843":47965},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3355":22,"_29485":15,"_5":29814,"_20482":47967,"_26831":47968,"_2843":47969},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3355":23,"_29485":15,"_5":29814,"_20482":47971,"_26831":47972,"_2843":47973},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3355":24,"_29485":15,"_20482":47975,"_5":14053,"_26831":15,"_2843":47976},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3355":25,"_29485":15,"_20482":47978,"_5":14053,"_26831":47948,"_2843":47979},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3355":26,"_29485":15,"_20482":47981,"_5":14053,"_26831":47948,"_2843":47982},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3355":27,"_29485":15,"_20482":47984,"_5":14053,"_26831":47948,"_2843":47985},[],"A security group allowing the necessary endpoints.",{"_3355":28,"_29485":15,"_20482":47987,"_5":14053,"_26831":47952,"_2843":47988},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3355":29,"_29485":15,"_20482":47990,"_5":14053,"_26831":47952,"_2843":47991},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3355":30,"_29485":15,"_20482":47993,"_5":14053,"_26831":47952,"_2843":47994},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3355":31,"_29485":15,"_20482":47996,"_5":14053,"_26831":47956,"_2843":47997},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3355":32,"_29485":15,"_20482":47999,"_5":14053,"_26831":47960,"_2843":48000},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3355":33,"_29485":15,"_20482":48002,"_5":14053,"_26831":47964,"_2843":48003},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3355":34,"_29485":15,"_20482":48005,"_5":14053,"_26831":47968,"_2843":48006},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3355":35,"_29485":15,"_20482":48008,"_5":14053,"_26831":47972,"_2843":48009},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3355":36,"_29485":36,"_5":14411,"_2843":48011,"_29817":48012,"_20482":48013,"_26831":36},"Deploy Lamassu",[47939,47940],[],{"_3355":37,"_29485":36,"_20482":48015,"_5":14053,"_26831":36,"_2843":48016},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3355":38,"_29485":36,"_5":29814,"_20482":48018,"_26831":48019,"_2843":48020},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3355":39,"_29485":36,"_5":29814,"_20482":48022,"_26831":48023,"_2843":48024},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3355":40,"_29485":36,"_5":29814,"_20482":48026,"_26831":48027,"_2843":48028},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3355":41,"_29485":36,"_20482":48030,"_5":14053,"_26831":36,"_2843":48031},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3355":42,"_29485":36,"_20482":48033,"_5":14053,"_26831":48019,"_2843":48034},[],"Model",{"_3355":43,"_29485":36,"_20482":48036,"_5":14053,"_26831":48019,"_2843":48037},[],"Recommended for",{"_3355":44,"_29485":36,"_20482":48039,"_5":14053,"_26831":48019,"_2843":48040},[],"Who operates the infrastructure",{"_3355":45,"_29485":36,"_20482":48042,"_5":14053,"_26831":48019,"_2843":48043},[],"Starting point",{"_3355":46,"_29485":36,"_20482":48045,"_5":14053,"_26831":48019,"_2843":48046},[],"Kubernetes self-managed",{"_3355":47,"_29485":36,"_20482":48048,"_5":14053,"_26831":48019,"_2843":48049},[],"Production, regulated environments and custom deployments",{"_3355":48,"_29485":36,"_20482":48051,"_5":14053,"_26831":48019,"_2843":48052},[],"Your team",{"_3355":49,"_29485":36,"_20482":48054,"_5":14053,"_26831":48019,"_2843":48055},[],"Helm or Fastlane",{"_3355":50,"_29485":36,"_20482":48057,"_5":14053,"_26831":48019,"_2843":48058},[],"AWS Marketplace",{"_3355":51,"_29485":36,"_20482":48060,"_5":14053,"_26831":48019,"_2843":48061},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3355":52,"_29485":36,"_20482":48063,"_5":14053,"_26831":48019,"_2843":48052},[],{"_3355":53,"_29485":36,"_20482":48065,"_5":14053,"_26831":48019,"_2843":48066},[],"Preconfigured image on EC2",{"_3355":54,"_29485":36,"_20482":48068,"_5":14053,"_26831":48019,"_2843":48069},[],"SaaS",{"_3355":55,"_29485":36,"_20482":48071,"_5":14053,"_26831":48019,"_2843":48072},[],"Teams that want to use the platform without operating it",{"_3355":56,"_29485":36,"_20482":48074,"_5":14053,"_26831":48019,"_2843":48075},[],"Lamassu",{"_3355":57,"_29485":36,"_20482":48077,"_5":14053,"_26831":48019,"_2843":48078},[],"Managed subscription",{"_3355":58,"_29485":36,"_20482":48080,"_5":14053,"_26831":48019,"_2843":48081},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3355":59,"_29485":36,"_20482":48083,"_5":14053,"_26831":48019,"_2843":48084},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3355":60,"_29485":36,"_20482":48086,"_5":14053,"_26831":48019,"_2843":48087},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3355":61,"_29485":36,"_20482":48089,"_5":14053,"_26831":48023,"_2843":48090},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3355":62,"_29485":36,"_20482":48092,"_5":14053,"_26831":48027,"_2843":48093},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3355":63,"_29485":63,"_5":14411,"_2843":48095,"_29817":48096,"_20482":48097,"_26831":63},"Use Lamassu as SaaS",[47939,47940,47941],[],{"_3355":64,"_29485":63,"_20482":48099,"_5":14053,"_26831":63,"_2843":48100},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3355":65,"_29485":63,"_5":29814,"_20482":48102,"_26831":48103,"_2843":48104},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3355":66,"_29485":63,"_5":29814,"_20482":48106,"_26831":48107,"_2843":48108},[],"/docs/deployment/saas#plans","Plans",{"_3355":67,"_29485":63,"_5":29814,"_20482":48110,"_26831":48111,"_2843":48112},[],"/docs/deployment/saas#request-access","Request access",{"_3355":68,"_29485":63,"_20482":48114,"_5":14053,"_26831":63,"_2843":48115},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3355":69,"_29485":63,"_20482":48117,"_5":14053,"_26831":48103,"_2843":48118},[],"Platform availability and maintenance.",{"_3355":70,"_29485":63,"_20482":48120,"_5":14053,"_26831":48103,"_2843":48121},[],"Automatic backups.",{"_3355":71,"_29485":63,"_20482":48123,"_5":14053,"_26831":48103,"_2843":48124},[],"Version upgrades.",{"_3355":72,"_29485":63,"_20482":48126,"_5":14053,"_26831":48103,"_2843":48127},[],"Technical support and SLA according to your plan.",{"_3355":73,"_29485":63,"_20482":48129,"_5":14053,"_26831":48107,"_2843":48130},[],"Plan",{"_3355":74,"_29485":63,"_20482":48132,"_5":14053,"_26831":48107,"_2843":48133},[],"Devices",{"_3355":75,"_29485":63,"_20482":48135,"_5":14053,"_26831":48107,"_2843":48136},[],"Support",{"_3355":76,"_29485":63,"_20482":48138,"_5":14053,"_26831":48107,"_2843":48139},[],"SLA",{"_3355":77,"_29485":63,"_20482":48141,"_5":14053,"_26831":48107,"_2843":48142},[],"Starter",{"_3355":78,"_29485":63,"_20482":48144,"_5":14053,"_26831":48107,"_2843":48145},[],"Up to 1,000",{"_3355":79,"_29485":63,"_20482":48147,"_5":14053,"_26831":48107,"_2843":48148},[],"Email",{"_3355":80,"_29485":63,"_20482":48150,"_5":14053,"_26831":48107,"_2843":48151},[],"99.5 %",{"_3355":81,"_29485":63,"_20482":48153,"_5":14053,"_26831":48107,"_2843":48154},[],"Professional",{"_3355":82,"_29485":63,"_20482":48156,"_5":14053,"_26831":48107,"_2843":48157},[],"Up to 10,000",{"_3355":83,"_29485":63,"_20482":48159,"_5":14053,"_26831":48107,"_2843":48160},[],"Email and chat",{"_3355":84,"_29485":63,"_20482":48162,"_5":14053,"_26831":48107,"_2843":48163},[],"99.9 %",{"_3355":85,"_29485":63,"_20482":48165,"_5":14053,"_26831":48107,"_2843":48166},[],"Enterprise",{"_3355":86,"_29485":63,"_20482":48168,"_5":14053,"_26831":48107,"_2843":48169},[],"Unlimited",{"_3355":87,"_29485":63,"_20482":48171,"_5":14053,"_26831":48107,"_2843":48172},[],"Dedicated",{"_3355":88,"_29485":63,"_20482":48174,"_5":14053,"_26831":48107,"_2843":48175},[],"99.99 %",{"_3355":89,"_29485":63,"_20482":48177,"_5":14053,"_26831":48111,"_2843":48178},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3355":90,"_29485":63,"_20482":48180,"_5":14053,"_26831":48111,"_2843":48181},[],"When you receive your instance's credentials, continue with Get started.",{"_3355":91,"_29485":91,"_5":14411,"_2843":48183,"_29817":48184,"_20482":48185,"_26831":91},"Fastlane",[47939,47940,48046],[],{"_3355":92,"_29485":91,"_20482":48187,"_5":14053,"_26831":91,"_2843":48188},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3355":93,"_29485":91,"_5":29814,"_20482":48190,"_26831":48191,"_2843":48192},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3355":94,"_29485":91,"_5":29814,"_20482":48194,"_26831":48195,"_2843":48196},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3355":95,"_29485":91,"_5":29814,"_20482":48198,"_26831":48199,"_2843":47949},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3355":96,"_29485":91,"_5":29814,"_20482":48201,"_26831":48202,"_2843":48203},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3355":97,"_29485":91,"_5":29814,"_20482":48205,"_26831":48206,"_2843":48207},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3355":98,"_29485":91,"_5":29814,"_20482":48209,"_26831":48210,"_2843":48211},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3355":99,"_29485":91,"_5":29814,"_20482":48213,"_26831":48214,"_2843":48215},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3355":100,"_29485":91,"_5":29814,"_20482":48217,"_26831":48218,"_2843":48219},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3355":101,"_29485":91,"_5":29814,"_20482":48221,"_26831":48222,"_2843":48223},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3355":102,"_29485":91,"_5":29814,"_20482":48225,"_26831":48226,"_2843":48227},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3355":103,"_29485":91,"_5":29814,"_20482":48229,"_26831":48230,"_2843":48231},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3355":104,"_29485":91,"_20482":48233,"_5":14053,"_26831":48191,"_2843":48234},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3355":105,"_29485":91,"_20482":48236,"_5":14053,"_26831":48191,"_2843":48237},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3355":106,"_29485":91,"_20482":48239,"_5":14053,"_26831":48195,"_2843":48240},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3355":107,"_29485":91,"_20482":48242,"_5":14053,"_26831":48195,"_2843":48243},[],"Fastlane installs or configures",{"_3355":108,"_29485":91,"_20482":48245,"_5":14053,"_26831":48195,"_2843":48246},[],"You still provide",{"_3355":109,"_29485":91,"_20482":48248,"_5":14053,"_26831":48195,"_2843":48249},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3355":110,"_29485":91,"_20482":48251,"_5":14053,"_26831":48195,"_2843":48252},[],"The Kubernetes cluster, nodes and persistent storage",{"_3355":111,"_29485":91,"_20482":48254,"_5":14053,"_26831":48195,"_2843":48255},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3355":112,"_29485":91,"_20482":48257,"_5":14053,"_26831":48195,"_2843":48258},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3355":113,"_29485":91,"_20482":48260,"_5":14053,"_26831":48195,"_2843":48261},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3355":114,"_29485":91,"_20482":48263,"_5":14053,"_26831":48195,"_2843":48264},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3355":115,"_29485":91,"_20482":48266,"_5":14053,"_26831":48195,"_2843":48267},[],"Optional observability and lab HSM components",{"_3355":116,"_29485":91,"_20482":48269,"_5":14053,"_26831":48195,"_2843":48270},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3355":117,"_29485":91,"_20482":48272,"_5":14053,"_26831":48195,"_2843":48273},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3355":118,"_29485":91,"_20482":48275,"_5":14053,"_26831":48199,"_2843":48276},[],"You need:",{"_3355":119,"_29485":91,"_20482":48278,"_5":14053,"_26831":48199,"_2843":48279},[],"an existing Kubernetes cluster",{"_3355":120,"_29485":91,"_20482":48281,"_5":14053,"_26831":48199,"_2843":48282},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3355":121,"_29485":91,"_20482":48284,"_5":14053,"_26831":48199,"_2843":48285},[],"`yq`",{"_3355":122,"_29485":91,"_20482":48287,"_5":14053,"_26831":48199,"_2843":23156},[],{"_3355":123,"_29485":91,"_20482":48289,"_5":14053,"_26831":48199,"_2843":48290},[],"`jq` only when using `--sample-data` or `--development`",{"_3355":124,"_29485":91,"_20482":48292,"_5":14053,"_26831":48199,"_2843":48293},[],"`ssh-keygen` only when using `--with-hsm`",{"_3355":125,"_29485":91,"_20482":48295,"_5":14053,"_26831":48199,"_2843":48296},[],"free external ports 80 and 443 on a single-node K3s host",{"_3355":126,"_29485":91,"_20482":48298,"_5":14053,"_26831":48199,"_2843":48299},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3355":127,"_29485":91,"_20482":48301,"_5":14053,"_26831":48199,"_2843":48302},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3355":128,"_29485":91,"_20482":48304,"_5":14053,"_26831":48202,"_2843":48305},[],"Run the script from a clone of the Helm repository:",{"_3355":129,"_29485":91,"_20482":48307,"_5":14053,"_26831":48202,"_2843":48308},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3355":130,"_29485":91,"_20482":48310,"_5":14053,"_26831":48206,"_2843":48311},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3355":131,"_29485":91,"_20482":48313,"_5":14053,"_26831":48206,"_2843":48314},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3355":132,"_29485":91,"_20482":48316,"_5":14053,"_26831":48206,"_2843":48317},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3355":133,"_29485":91,"_20482":48319,"_5":14053,"_26831":48206,"_2843":48320},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3355":134,"_29485":91,"_20482":48322,"_5":14053,"_26831":48210,"_2843":48323},[],"Option",{"_3355":135,"_29485":91,"_20482":48325,"_5":14053,"_26831":48210,"_2843":48326},[],"Default",{"_3355":136,"_29485":91,"_20482":48328,"_5":14053,"_26831":48210,"_2843":48329},[],"Purpose",{"_3355":137,"_29485":91,"_20482":48331,"_5":14053,"_26831":48210,"_2843":48332},[],"`-h`, `--help`",{"_3355":138,"_29485":91,"_20482":48334,"_5":14053,"_26831":48210,"_2843":48335},[],"—",{"_3355":139,"_29485":91,"_20482":48337,"_5":14053,"_26831":48210,"_2843":48338},[],"Show help",{"_3355":140,"_29485":91,"_20482":48340,"_5":14053,"_26831":48210,"_2843":48341},[],"`-c`, `--context`",{"_3355":141,"_29485":91,"_20482":48343,"_5":14053,"_26831":48210,"_2843":48344},[],"current context",{"_3355":142,"_29485":91,"_20482":48346,"_5":14053,"_26831":48210,"_2843":48347},[],"Select the kubeconfig context for kubectl and Helm",{"_3355":143,"_29485":91,"_20482":48349,"_5":14053,"_26831":48210,"_2843":48350},[],"`-n`, `--non-interactive`",{"_3355":144,"_29485":91,"_20482":48352,"_5":14053,"_26831":48210,"_2843":6342},[],{"_3355":145,"_29485":91,"_20482":48354,"_5":14053,"_26831":48210,"_2843":48355},[],"Skip prompts and generate dependency credentials",{"_3355":146,"_29485":91,"_20482":48357,"_5":14053,"_26831":48210,"_2843":48358},[],"`-ns`, `--namespace`",{"_3355":147,"_29485":91,"_20482":48360,"_5":14053,"_26831":48210,"_2843":48361},[],"`lamassu-dev`",{"_3355":148,"_29485":91,"_20482":48363,"_5":14053,"_26831":48210,"_2843":48364},[],"Namespace for the installation",{"_3355":149,"_29485":91,"_20482":48366,"_5":14053,"_26831":48210,"_2843":48367},[],"`-d`, `--domain`",{"_3355":150,"_29485":91,"_20482":48369,"_5":14053,"_26831":48210,"_2843":48370},[],"`dev.lamassu.io`",{"_3355":151,"_29485":91,"_20482":48372,"_5":14053,"_26831":48210,"_2843":48373},[],"Domain used by the UI, OIDC and certificate",{"_3355":152,"_29485":91,"_20482":48375,"_5":14053,"_26831":48210,"_2843":48376},[],"`-v`, `--version`",{"_3355":153,"_29485":91,"_20482":48378,"_5":14053,"_26831":48210,"_2843":14740},[],{"_3355":154,"_29485":91,"_20482":48380,"_5":14053,"_26831":48210,"_2843":48381},[],"Lamassu chart version",{"_3355":155,"_29485":91,"_20482":48383,"_5":14053,"_26831":48210,"_2843":48384},[],"`--https-port`",{"_3355":156,"_29485":91,"_20482":48386,"_5":14053,"_26831":48210,"_2843":48387},[],"`443`",{"_3355":157,"_29485":91,"_20482":48389,"_5":14053,"_26831":48210,"_2843":48390},[],"Gateway HTTPS listener port",{"_3355":158,"_29485":91,"_20482":48392,"_5":14053,"_26831":48210,"_2843":48393},[],"`--http-port`",{"_3355":159,"_29485":91,"_20482":48395,"_5":14053,"_26831":48210,"_2843":48396},[],"`80`",{"_3355":160,"_29485":91,"_20482":48398,"_5":14053,"_26831":48210,"_2843":48399},[],"Gateway HTTP listener port",{"_3355":161,"_29485":91,"_20482":48401,"_5":14053,"_26831":48210,"_2843":48402},[],"`--tls-crt`",{"_3355":162,"_29485":91,"_20482":48404,"_5":14053,"_26831":48210,"_2843":48335},[],{"_3355":163,"_29485":91,"_20482":48406,"_5":14053,"_26831":48210,"_2843":48407},[],"PEM certificate for downstream TLS",{"_3355":164,"_29485":91,"_20482":48409,"_5":14053,"_26831":48210,"_2843":48410},[],"`--tls-key`",{"_3355":165,"_29485":91,"_20482":48412,"_5":14053,"_26831":48210,"_2843":48335},[],{"_3355":166,"_29485":91,"_20482":48414,"_5":14053,"_26831":48210,"_2843":48415},[],"PEM private key for downstream TLS",{"_3355":167,"_29485":91,"_20482":48417,"_5":14053,"_26831":48210,"_2843":48418},[],"`-l`, `--local-chart-path`",{"_3355":168,"_29485":91,"_20482":48420,"_5":14053,"_26831":48210,"_2843":48421},[],"repository chart",{"_3355":169,"_29485":91,"_20482":48423,"_5":14053,"_26831":48210,"_2843":48424},[],"Use an unpacked local Lamassu chart",{"_3355":170,"_29485":91,"_20482":48426,"_5":14053,"_26831":48210,"_2843":48427},[],"`-ip`, `--gateway-ip`",{"_3355":171,"_29485":91,"_20482":48429,"_5":14053,"_26831":48210,"_2843":8507},[],{"_3355":172,"_29485":91,"_20482":48431,"_5":14053,"_26831":48210,"_2843":48432},[],"Override the address written to `gateway.addresses`",{"_3355":173,"_29485":91,"_20482":48434,"_5":14053,"_26831":48210,"_2843":48435},[],"`--otel`",{"_3355":174,"_29485":91,"_20482":48437,"_5":14053,"_26831":48210,"_2843":6342},[],{"_3355":175,"_29485":91,"_20482":48439,"_5":14053,"_26831":48210,"_2843":48440},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3355":176,"_29485":91,"_20482":48442,"_5":14053,"_26831":48210,"_2843":48443},[],"`--development`",{"_3355":177,"_29485":91,"_20482":48445,"_5":14053,"_26831":48210,"_2843":6342},[],{"_3355":178,"_29485":91,"_20482":48447,"_5":14053,"_26831":48210,"_2843":48448},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3355":179,"_29485":91,"_20482":48450,"_5":14053,"_26831":48210,"_2843":48451},[],"`--sample-data`",{"_3355":180,"_29485":91,"_20482":48453,"_5":14053,"_26831":48210,"_2843":6342},[],{"_3355":181,"_29485":91,"_20482":48455,"_5":14053,"_26831":48210,"_2843":48456},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3355":182,"_29485":91,"_20482":48458,"_5":14053,"_26831":48210,"_2843":48459},[],"`--with-hsm`",{"_3355":183,"_29485":91,"_20482":48461,"_5":14053,"_26831":48210,"_2843":6342},[],{"_3355":184,"_29485":91,"_20482":48463,"_5":14053,"_26831":48210,"_2843":48464},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3355":185,"_29485":91,"_20482":48466,"_5":14053,"_26831":48210,"_2843":48467},[],"`--softhsm-chart-path`",{"_3355":186,"_29485":91,"_20482":48469,"_5":14053,"_26831":48210,"_2843":48470},[],"`./charts/softhsm`",{"_3355":187,"_29485":91,"_20482":48472,"_5":14053,"_26831":48210,"_2843":48473},[],"Use a different local SoftHSM chart",{"_3355":188,"_29485":91,"_20482":48475,"_5":14053,"_26831":48210,"_2843":48476},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3355":189,"_29485":91,"_20482":48478,"_5":14053,"_26831":48214,"_2843":48479},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3355":190,"_29485":91,"_20482":48481,"_5":14053,"_26831":48214,"_2843":48482},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3355":191,"_29485":91,"_20482":48484,"_5":14053,"_26831":48214,"_2843":48485},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3355":192,"_29485":91,"_20482":48487,"_5":14053,"_26831":48214,"_2843":48488},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3355":193,"_29485":91,"_20482":48490,"_5":14053,"_26831":48214,"_2843":48491},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3355":194,"_29485":91,"_20482":48493,"_5":14053,"_26831":48214,"_2843":48494},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3355":195,"_29485":91,"_20482":48496,"_5":14053,"_26831":48218,"_2843":48497},[],"Fastlane:",{"_3355":196,"_29485":91,"_20482":48499,"_5":14053,"_26831":48218,"_2843":48500},[],"validates local tools and the selected cluster",{"_3355":197,"_29485":91,"_20482":48502,"_5":14053,"_26831":48218,"_2843":48503},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3355":198,"_29485":91,"_20482":48505,"_5":14053,"_26831":48218,"_2843":48506},[],"creates the namespace",{"_3355":199,"_29485":91,"_20482":48508,"_5":14053,"_26831":48218,"_2843":48509},[],"installs PostgreSQL and creates the required databases",{"_3355":200,"_29485":91,"_20482":48511,"_5":14053,"_26831":48218,"_2843":48512},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3355":201,"_29485":91,"_20482":48514,"_5":14053,"_26831":48218,"_2843":48515},[],"installs RabbitMQ",{"_3355":202,"_29485":91,"_20482":48517,"_5":14053,"_26831":48218,"_2843":48518},[],"optionally installs observability and lab HSM components",{"_3355":203,"_29485":91,"_20482":48520,"_5":14053,"_26831":48218,"_2843":48521},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3355":204,"_29485":91,"_20482":48523,"_5":14053,"_26831":48218,"_2843":48524},[],"optionally loads sample data",{"_3355":205,"_29485":91,"_20482":48526,"_5":14053,"_26831":48218,"_2843":48527},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3355":206,"_29485":91,"_20482":48529,"_5":14053,"_26831":48222,"_2843":48530},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3355":207,"_29485":91,"_20482":48532,"_5":14053,"_26831":48222,"_2843":48533},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3355":208,"_29485":91,"_20482":48535,"_5":14053,"_26831":48226,"_2843":48536},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3355":209,"_29485":91,"_20482":48538,"_5":14053,"_26831":48226,"_2843":48539},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3355":210,"_29485":91,"_20482":48541,"_5":14053,"_26831":48226,"_2843":48542},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3355":211,"_29485":91,"_20482":48544,"_5":14053,"_26831":48230,"_2843":48545},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3355":212,"_29485":212,"_5":14411,"_2843":48547,"_29817":48548,"_20482":48549,"_26831":212},"Install with Helm",[47939,47940,48046],[],{"_3355":213,"_29485":212,"_20482":48551,"_5":14053,"_26831":212,"_2843":48552},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3355":214,"_29485":212,"_5":29814,"_20482":48554,"_26831":48555,"_2843":48556},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3355":215,"_29485":212,"_5":29814,"_20482":48558,"_26831":48559,"_2843":47949},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3355":216,"_29485":212,"_5":29814,"_20482":48561,"_26831":48562,"_2843":48563},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3355":217,"_29485":212,"_5":29814,"_20482":48565,"_26831":48566,"_2843":48567},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3355":218,"_29485":212,"_5":29814,"_20482":48569,"_26831":48570,"_2843":48571},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3355":219,"_29485":212,"_5":29814,"_20482":48573,"_26831":48574,"_2843":48575},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3355":220,"_29485":212,"_5":29814,"_20482":48577,"_26831":48578,"_2843":48579},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3355":221,"_29485":212,"_5":29814,"_20482":48581,"_26831":48582,"_2843":48583},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3355":222,"_29485":212,"_5":29814,"_20482":48585,"_26831":48586,"_2843":48587},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3355":223,"_29485":212,"_5":29814,"_20482":48589,"_26831":48590,"_2843":48591},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3355":224,"_29485":212,"_5":29814,"_20482":48593,"_26831":48594,"_2843":48595},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3355":225,"_29485":212,"_20482":48597,"_5":14053,"_26831":48555,"_2843":48598},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3355":226,"_29485":212,"_20482":48600,"_5":14053,"_26831":48559,"_2843":48601},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3355":227,"_29485":212,"_20482":48603,"_5":14053,"_26831":48559,"_2843":48604},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3355":228,"_29485":212,"_20482":48606,"_5":14053,"_26831":48559,"_2843":48607},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3355":229,"_29485":212,"_20482":48609,"_5":14053,"_26831":48559,"_2843":48610},[],"a reachable RabbitMQ broker and credentials",{"_3355":230,"_29485":212,"_20482":48612,"_5":14053,"_26831":48559,"_2843":48613},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3355":231,"_29485":212,"_20482":48615,"_5":14053,"_26831":48559,"_2843":48616},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3355":232,"_29485":212,"_20482":48618,"_5":14053,"_26831":48559,"_2843":48619},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3355":233,"_29485":212,"_20482":48621,"_5":14053,"_26831":48559,"_2843":48622},[],"a StorageClass and an external traffic design",{"_3355":234,"_29485":212,"_20482":48624,"_5":14053,"_26831":48559,"_2843":48625},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3355":235,"_29485":212,"_20482":48627,"_5":14053,"_26831":48559,"_2843":48628},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3355":236,"_29485":212,"_20482":48630,"_5":14053,"_26831":48559,"_2843":48631},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3355":237,"_29485":212,"_20482":48633,"_5":14053,"_26831":48562,"_2843":48634},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3355":238,"_29485":212,"_20482":48636,"_5":14053,"_26831":48562,"_2843":48637},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3355":239,"_29485":212,"_20482":48639,"_5":14053,"_26831":48562,"_2843":48640},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3355":240,"_29485":212,"_20482":48642,"_5":14053,"_26831":48566,"_2843":48643},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3355":241,"_29485":212,"_20482":48645,"_5":14053,"_26831":48566,"_2843":48646},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3355":242,"_29485":212,"_20482":48648,"_5":14053,"_26831":48566,"_2843":48649},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3355":243,"_29485":212,"_20482":48651,"_5":14053,"_26831":48566,"_2843":48652},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3355":244,"_29485":212,"_20482":48654,"_5":14053,"_26831":48570,"_2843":48655},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3355":245,"_29485":212,"_20482":48657,"_5":14053,"_26831":48574,"_2843":48658},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3355":246,"_29485":212,"_20482":48660,"_5":14053,"_26831":48574,"_2843":48661},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3355":247,"_29485":212,"_20482":48663,"_5":14053,"_26831":48574,"_2843":48664},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3355":248,"_29485":212,"_20482":48666,"_5":14053,"_26831":48574,"_2843":48667},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3355":249,"_29485":212,"_20482":48669,"_5":14053,"_26831":48574,"_2843":48670},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3355":250,"_29485":212,"_20482":48672,"_5":14053,"_26831":48574,"_2843":48673},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3355":251,"_29485":212,"_20482":48675,"_5":14053,"_26831":48574,"_2843":48676},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3355":252,"_29485":212,"_20482":48678,"_5":14053,"_26831":48578,"_2843":48679},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3355":253,"_29485":212,"_20482":48681,"_5":14053,"_26831":48578,"_2843":48682},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3355":254,"_29485":212,"_20482":48684,"_5":14053,"_26831":48578,"_2843":48685},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3355":255,"_29485":212,"_20482":48687,"_5":14053,"_26831":48578,"_2843":48688},[],"See Access control for the principal and policy model.",{"_3355":256,"_29485":212,"_20482":48690,"_5":14053,"_26831":48582,"_2843":48691},[],"To install a local checkout instead:",{"_3355":257,"_29485":212,"_20482":48693,"_5":14053,"_26831":48586,"_2843":48694},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3355":258,"_29485":212,"_20482":48696,"_5":14053,"_26831":48586,"_2843":48697},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3355":259,"_29485":212,"_20482":48699,"_5":14053,"_26831":48590,"_2843":48700},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3355":260,"_29485":212,"_20482":48702,"_5":14053,"_26831":48590,"_2843":48703},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3355":261,"_29485":212,"_20482":48705,"_5":14053,"_26831":48590,"_2843":48706},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3355":262,"_29485":212,"_20482":48708,"_5":14053,"_26831":48590,"_2843":48709},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3355":263,"_29485":212,"_20482":48711,"_5":14053,"_26831":48590,"_2843":48712},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3355":264,"_29485":212,"_20482":48714,"_5":14053,"_26831":48594,"_2843":48715},[],"Before going live, review:",{"_3355":265,"_29485":212,"_20482":48717,"_5":14053,"_26831":48594,"_2843":48718},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3355":266,"_29485":212,"_20482":48720,"_5":14053,"_26831":48594,"_2843":48721},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3355":267,"_29485":212,"_20482":48723,"_5":14053,"_26831":48594,"_2843":48724},[],"shared VA storage before increasing VA replicas",{"_3355":268,"_29485":212,"_20482":48726,"_5":14053,"_26831":48594,"_2843":48727},[],"managed OIDC roles and removal of evaluation credentials",{"_3355":269,"_29485":212,"_20482":48729,"_5":14053,"_26831":48594,"_2843":48730},[],"a trusted TLS issuer or externally managed certificate",{"_3355":270,"_29485":212,"_20482":48732,"_5":14053,"_26831":48594,"_2843":48733},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3355":271,"_29485":212,"_20482":48735,"_5":14053,"_26831":48594,"_2843":48736},[],"SMTP, observability and alert delivery",{"_3355":272,"_29485":212,"_20482":48738,"_5":14053,"_26831":48594,"_2843":48739},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3355":273,"_29485":212,"_20482":48741,"_5":14053,"_26831":48594,"_2843":48742},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3355":274,"_29485":274,"_5":14411,"_2843":48744,"_29817":48745,"_20482":48746,"_26831":274},"Expose the Gateway",[47939,47940,48046],[],{"_3355":275,"_29485":274,"_20482":48748,"_5":14053,"_26831":274,"_2843":48749},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3355":276,"_29485":274,"_5":29814,"_20482":48751,"_26831":48752,"_2843":48753},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3355":277,"_29485":274,"_5":29814,"_20482":48755,"_26831":48756,"_2843":48757},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3355":278,"_29485":274,"_5":29814,"_20482":48759,"_26831":48760,"_2843":48761},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3355":279,"_29485":274,"_5":29814,"_20482":48763,"_26831":48764,"_2843":48765},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3355":280,"_29485":274,"_5":29814,"_20482":48767,"_26831":48768,"_2843":48769},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3355":281,"_29485":274,"_5":29814,"_20482":48771,"_26831":48772,"_2843":48773},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3355":282,"_29485":274,"_5":29814,"_20482":48775,"_26831":48776,"_2843":48777},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3355":283,"_29485":274,"_5":29814,"_20482":48779,"_26831":48780,"_2843":48781},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3355":284,"_29485":274,"_5":29814,"_20482":48783,"_26831":48784,"_2843":48785},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3355":285,"_29485":274,"_5":29814,"_20482":48787,"_26831":48788,"_2843":48789},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3355":286,"_29485":274,"_20482":48791,"_5":14053,"_26831":48752,"_2843":48792},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3355":287,"_29485":274,"_20482":48794,"_5":14053,"_26831":48752,"_2843":48795},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3355":288,"_29485":274,"_20482":48797,"_5":14053,"_26831":48756,"_2843":48798},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3355":289,"_29485":274,"_20482":48800,"_5":14053,"_26831":48756,"_2843":48801},[],"Set it only when:",{"_3355":290,"_29485":274,"_20482":48803,"_5":14053,"_26831":48756,"_2843":48804},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3355":291,"_29485":274,"_20482":48806,"_5":14053,"_26831":48756,"_2843":48807},[],"that address is allocated to this Gateway",{"_3355":292,"_29485":274,"_20482":48809,"_5":14053,"_26831":48756,"_2843":48810},[],"the surrounding network already routes traffic for it to the cluster",{"_3355":293,"_29485":274,"_20482":48812,"_5":14053,"_26831":48756,"_2843":48813},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3355":294,"_29485":274,"_20482":48815,"_5":14053,"_26831":48756,"_2843":48816},[],"Keep these two settings separate:",{"_3355":295,"_29485":274,"_20482":48818,"_5":14053,"_26831":48756,"_2843":48819},[],"`gateway.addresses` requests an address for the Gateway.",{"_3355":296,"_29485":274,"_20482":48821,"_5":14053,"_26831":48756,"_2843":48822},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3355":297,"_29485":274,"_20482":48824,"_5":14053,"_26831":48756,"_2843":48825},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3355":298,"_29485":274,"_20482":48827,"_5":14053,"_26831":48760,"_2843":48828},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3355":299,"_29485":274,"_20482":48830,"_5":14053,"_26831":48760,"_2843":48831},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3355":300,"_29485":274,"_20482":48833,"_5":14053,"_26831":48764,"_2843":48834},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3355":301,"_29485":274,"_20482":48836,"_5":14053,"_26831":48764,"_2843":48837},[],"For the recommended design:",{"_3355":302,"_29485":274,"_20482":48839,"_5":14053,"_26831":48764,"_2843":48840},[],"Use only one externally exposed Lamassu Gateway.",{"_3355":303,"_29485":274,"_20482":48842,"_5":14053,"_26831":48764,"_2843":48843},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3355":304,"_29485":274,"_20482":48845,"_5":14053,"_26831":48764,"_2843":48846},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3355":305,"_29485":274,"_20482":48848,"_5":14053,"_26831":48764,"_2843":48849},[],"Point DNS at the VM's reachable address.",{"_3355":306,"_29485":274,"_20482":48851,"_5":14053,"_26831":48764,"_2843":48852},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3355":307,"_29485":274,"_20482":48854,"_5":14053,"_26831":48768,"_2843":48855},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3355":308,"_29485":274,"_20482":48857,"_5":14053,"_26831":48772,"_2843":48858},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3355":309,"_29485":274,"_20482":48860,"_5":14053,"_26831":48772,"_2843":48861},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3355":310,"_29485":274,"_20482":48863,"_5":14053,"_26831":48776,"_2843":48864},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3355":311,"_29485":274,"_20482":48866,"_5":14053,"_26831":48776,"_2843":48867},[],"Requirement",{"_3355":312,"_29485":274,"_20482":48869,"_5":14053,"_26831":48776,"_2843":48870},[],"Recommended design",{"_3355":313,"_29485":274,"_20482":48872,"_5":14053,"_26831":48776,"_2843":48873},[],"Consequence",{"_3355":314,"_29485":274,"_20482":48875,"_5":14053,"_26831":48776,"_2843":48876},[],"Several Lamassu URLs or services",{"_3355":315,"_29485":274,"_20482":48878,"_5":14053,"_26831":48776,"_2843":48879},[],"One Gateway with multiple routes",{"_3355":316,"_29485":274,"_20482":48881,"_5":14053,"_26831":48776,"_2843":48882},[],"One IP and one proxy fleet; this is the chart default",{"_3355":317,"_29485":274,"_20482":48884,"_5":14053,"_26831":48776,"_2843":48885},[],"Independent Gateways and separate external IPs",{"_3355":318,"_29485":274,"_20482":48887,"_5":14053,"_26831":48776,"_2843":48888},[],"One VIP per Gateway",{"_3355":319,"_29485":274,"_20482":48890,"_5":14053,"_26831":48776,"_2843":48891},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3355":320,"_29485":274,"_20482":48893,"_5":14053,"_26831":48776,"_2843":48894},[],"Independent Gateways on one node and one IP",{"_3355":321,"_29485":274,"_20482":48896,"_5":14053,"_26831":48776,"_2843":48897},[],"Use different external ports",{"_3355":322,"_29485":274,"_20482":48899,"_5":14053,"_26831":48776,"_2843":48900},[],"Clients must include non-standard ports",{"_3355":323,"_29485":274,"_20482":48902,"_5":14053,"_26831":48776,"_2843":48903},[],"Separate TLS/mTLS termination behind one IP",{"_3355":324,"_29485":274,"_20482":48905,"_5":14053,"_26831":48776,"_2843":48906},[],"Front-door SNI routing to internal Gateways",{"_3355":325,"_29485":274,"_20482":48908,"_5":14053,"_26831":48776,"_2843":48909},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3355":326,"_29485":274,"_20482":48911,"_5":14053,"_26831":48776,"_2843":48912},[],"Separate Gateway resources but shared proxy infrastructure",{"_3355":327,"_29485":274,"_20482":48914,"_5":14053,"_26831":48776,"_2843":48915},[],"Envoy merged-Gateway mode",{"_3355":328,"_29485":274,"_20482":48917,"_5":14053,"_26831":48776,"_2843":48918},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3355":329,"_29485":274,"_20482":48920,"_5":14053,"_26831":48776,"_2843":48921},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3355":330,"_29485":274,"_20482":48923,"_5":14053,"_26831":48776,"_2843":48924},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3355":331,"_29485":274,"_20482":48926,"_5":14053,"_26831":48776,"_2843":48927},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3355":332,"_29485":274,"_20482":48929,"_5":14053,"_26831":48776,"_2843":48930},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3355":333,"_29485":274,"_20482":48932,"_5":14053,"_26831":48780,"_2843":48933},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3355":334,"_29485":274,"_20482":48935,"_5":14053,"_26831":48780,"_2843":48936},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3355":335,"_29485":274,"_20482":48938,"_5":14053,"_26831":48780,"_2843":48939},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3355":336,"_29485":274,"_20482":48941,"_5":14053,"_26831":48780,"_2843":48942},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3355":337,"_29485":274,"_20482":48944,"_5":14053,"_26831":48780,"_2843":48945},[],"If none of those are possible, use different external ports or change the external network design.",{"_3355":338,"_29485":274,"_20482":48947,"_5":14053,"_26831":48784,"_2843":48948},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3355":339,"_29485":274,"_20482":48950,"_5":14053,"_26831":48784,"_2843":48951},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3355":340,"_29485":274,"_20482":48953,"_5":14053,"_26831":48788,"_2843":48954},[],"Check, in order:",{"_3355":341,"_29485":274,"_20482":48956,"_5":14053,"_26831":48788,"_2843":48957},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3355":342,"_29485":274,"_20482":48959,"_5":14053,"_26831":48788,"_2843":48960},[],"Its status contains the expected address.",{"_3355":343,"_29485":274,"_20482":48962,"_5":14053,"_26831":48788,"_2843":48963},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3355":344,"_29485":274,"_20482":48965,"_5":14053,"_26831":48788,"_2843":48966},[],"Port 443 reaches that address from the client network.",{"_3355":345,"_29485":274,"_20482":48968,"_5":14053,"_26831":48788,"_2843":48969},[],"DNS resolves to the externally reachable endpoint.",{"_3355":346,"_29485":274,"_20482":48971,"_5":14053,"_26831":48788,"_2843":48972},[],"The certificate contains the DNS name or IP used by the client.",{"_3355":347,"_29485":274,"_20482":48974,"_5":14053,"_26831":48788,"_2843":48975},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3355":348,"_29485":348,"_5":14411,"_2843":48046,"_29817":48977,"_20482":48978,"_26831":348},[47939,47940,48046],[],{"_3355":349,"_29485":348,"_20482":48980,"_5":14053,"_26831":348,"_2843":48981},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3355":350,"_29485":348,"_5":29814,"_20482":48983,"_26831":48984,"_2843":48985},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3355":351,"_29485":348,"_5":29814,"_20482":48987,"_26831":48988,"_2843":48989},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3355":352,"_29485":348,"_5":29814,"_20482":48991,"_26831":48992,"_2843":48993},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3355":353,"_29485":348,"_5":29814,"_20482":48995,"_26831":48996,"_2843":48997},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3355":354,"_29485":348,"_5":29814,"_20482":48999,"_26831":49000,"_2843":49001},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3355":355,"_29485":348,"_5":29814,"_20482":49003,"_26831":49004,"_2843":49005},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3355":356,"_29485":348,"_20482":49007,"_5":14053,"_26831":48984,"_2843":49008},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3355":357,"_29485":348,"_20482":49010,"_5":14053,"_26831":48988,"_2843":49011},[],"Workflow",{"_3355":358,"_29485":348,"_20482":49013,"_5":14053,"_26831":48988,"_2843":49014},[],"Use it for",{"_3355":359,"_29485":348,"_20482":49016,"_5":14053,"_26831":48988,"_2843":49017},[],"What it installs",{"_3355":360,"_29485":348,"_20482":49019,"_5":14053,"_26831":48988,"_2843":49020},[],"Helm",{"_3355":361,"_29485":348,"_20482":49022,"_5":14053,"_26831":48988,"_2843":49023},[],"Production and controlled environments",{"_3355":362,"_29485":348,"_20482":49025,"_5":14053,"_26831":48988,"_2843":49026},[],"Lamassu services and Gateway API resources",{"_3355":363,"_29485":348,"_20482":49028,"_5":14053,"_26831":48988,"_2843":48183},[],{"_3355":364,"_29485":348,"_20482":49030,"_5":14053,"_26831":48988,"_2843":49031},[],"Evaluation, demos, CI and small lab clusters",{"_3355":365,"_29485":348,"_20482":49033,"_5":14053,"_26831":48988,"_2843":49034},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3355":366,"_29485":348,"_20482":49036,"_5":14053,"_26831":48992,"_2843":49037},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3355":367,"_29485":348,"_20482":49039,"_5":14053,"_26831":48992,"_2843":49040},[],"Area",{"_3355":368,"_29485":348,"_20482":49042,"_5":14053,"_26831":48992,"_2843":49043},[],"The Lamassu chart provides",{"_3355":369,"_29485":348,"_20482":49045,"_5":14053,"_26831":48992,"_2843":49046},[],"You provide",{"_3355":370,"_29485":348,"_20482":49048,"_5":14053,"_26831":48992,"_2843":49049},[],"Lamassu applications",{"_3355":371,"_29485":348,"_20482":49051,"_5":14053,"_26831":48992,"_2843":49052},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3355":372,"_29485":348,"_20482":49054,"_5":14053,"_26831":48992,"_2843":49055},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3355":373,"_29485":348,"_20482":49057,"_5":14053,"_26831":48992,"_2843":49058},[],"PostgreSQL data",{"_3355":374,"_29485":348,"_20482":49060,"_5":14053,"_26831":48992,"_2843":49061},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3355":375,"_29485":348,"_20482":49063,"_5":14053,"_26831":48992,"_2843":49064},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3355":376,"_29485":348,"_20482":49066,"_5":14053,"_26831":48992,"_2843":49067},[],"Messaging",{"_3355":377,"_29485":348,"_20482":49069,"_5":14053,"_26831":48992,"_2843":49070},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3355":378,"_29485":348,"_20482":49072,"_5":14053,"_26831":48992,"_2843":49073},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3355":379,"_29485":348,"_20482":49075,"_5":14053,"_26831":48992,"_2843":49076},[],"Identity",{"_3355":380,"_29485":348,"_20482":49078,"_5":14053,"_26831":48992,"_2843":49079},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3355":381,"_29485":348,"_20482":49081,"_5":14053,"_26831":48992,"_2843":49082},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3355":382,"_29485":348,"_20482":49084,"_5":14053,"_26831":48992,"_2843":49085},[],"External routing",{"_3355":383,"_29485":348,"_20482":49087,"_5":14053,"_26831":48992,"_2843":49088},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3355":384,"_29485":348,"_20482":49090,"_5":14053,"_26831":48992,"_2843":49091},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3355":385,"_29485":348,"_20482":49093,"_5":14053,"_26831":48992,"_2843":49094},[],"TLS",{"_3355":386,"_29485":348,"_20482":49096,"_5":14053,"_26831":48992,"_2843":49097},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3355":387,"_29485":348,"_20482":49099,"_5":14053,"_26831":48992,"_2843":49100},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3355":388,"_29485":348,"_20482":49102,"_5":14053,"_26831":48992,"_2843":49103},[],"Persistent application data",{"_3355":389,"_29485":348,"_20482":49105,"_5":14053,"_26831":48992,"_2843":49106},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3355":390,"_29485":348,"_20482":49108,"_5":14053,"_26831":48992,"_2843":49109},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3355":391,"_29485":348,"_20482":49111,"_5":14053,"_26831":48992,"_2843":49112},[],"Optional integrations",{"_3355":392,"_29485":348,"_20482":49114,"_5":14053,"_26831":48992,"_2843":49115},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3355":393,"_29485":348,"_20482":49117,"_5":14053,"_26831":48992,"_2843":49118},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3355":394,"_29485":348,"_20482":49120,"_5":14053,"_26831":48992,"_2843":49121},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3355":395,"_29485":348,"_20482":49123,"_5":14053,"_26831":48992,"_2843":49124},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3355":396,"_29485":348,"_20482":49126,"_5":14053,"_26831":48996,"_2843":49127},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3355":397,"_29485":348,"_20482":49129,"_5":14053,"_26831":48996,"_2843":49130},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3355":398,"_29485":348,"_20482":49132,"_5":14053,"_26831":49000,"_2843":49133},[],"Kubernetes 1.24 or newer",{"_3355":399,"_29485":348,"_20482":49135,"_5":14053,"_26831":49000,"_2843":49136},[],"Helm 3.2 or newer",{"_3355":400,"_29485":348,"_20482":49138,"_5":14053,"_26831":49000,"_2843":49139},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3355":401,"_29485":348,"_20482":49141,"_5":14053,"_26831":49000,"_2843":49142},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3355":402,"_29485":348,"_20482":49144,"_5":14053,"_26831":49000,"_2843":49145},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3355":403,"_29485":348,"_20482":49147,"_5":14053,"_26831":49000,"_2843":49148},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3355":404,"_29485":348,"_20482":49150,"_5":14053,"_26831":49000,"_2843":49151},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3355":405,"_29485":348,"_20482":49153,"_5":14053,"_26831":49004,"_2843":49154},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3355":406,"_29485":348,"_20482":49156,"_5":14053,"_26831":49004,"_2843":49157},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3355":407,"_29485":348,"_20482":49159,"_5":14053,"_26831":49004,"_2843":49160},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3355":408,"_29485":348,"_20482":49162,"_5":14053,"_26831":49004,"_2843":49163},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3355":409,"_29485":409,"_5":14411,"_2843":49165,"_29817":49166,"_20482":49168,"_26831":409},"Deployment troubleshooting",[47939,47940,49167],"Operations",[],{"_3355":410,"_29485":409,"_20482":49170,"_5":14053,"_26831":409,"_2843":49171},[],"Diagnose access, service health and infrastructure dependencies.",{"_3355":411,"_29485":409,"_5":29814,"_20482":49173,"_26831":49174,"_2843":49175},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3355":412,"_29485":409,"_5":29814,"_20482":49177,"_26831":49178,"_2843":49179},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3355":413,"_29485":409,"_5":29814,"_20482":49181,"_26831":49182,"_2843":49183},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3355":414,"_29485":409,"_5":29814,"_20482":49185,"_26831":49186,"_2843":49187},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3355":415,"_29485":409,"_5":29814,"_20482":49189,"_26831":49190,"_2843":49191},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3355":416,"_29485":409,"_5":29814,"_20482":49193,"_26831":49194,"_2843":49195},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3355":417,"_29485":409,"_5":29814,"_20482":49197,"_26831":49198,"_2843":49199},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3355":418,"_29485":409,"_5":29814,"_20482":49201,"_26831":49202,"_2843":49203},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3355":419,"_29485":409,"_5":29814,"_20482":49205,"_26831":49206,"_2843":49207},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3355":420,"_29485":409,"_5":29814,"_20482":49209,"_26831":49210,"_2843":49211},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3355":421,"_29485":409,"_5":29814,"_20482":49213,"_26831":49214,"_2843":49215},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3355":422,"_29485":409,"_5":29814,"_20482":49217,"_26831":49218,"_2843":49219},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3355":423,"_29485":409,"_5":29814,"_20482":49221,"_26831":49222,"_2843":49223},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3355":424,"_29485":409,"_20482":49225,"_5":14053,"_26831":409,"_2843":49226},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3355":425,"_29485":409,"_20482":49228,"_5":14053,"_26831":49178,"_2843":49229},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3355":426,"_29485":409,"_20482":49231,"_5":14053,"_26831":49182,"_2843":49232},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3355":427,"_29485":409,"_20482":49234,"_5":14053,"_26831":49186,"_2843":49235},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3355":428,"_29485":409,"_20482":49237,"_5":14053,"_26831":49190,"_2843":49238},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3355":429,"_29485":409,"_20482":49240,"_5":14053,"_26831":49194,"_2843":49241},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3355":430,"_29485":409,"_20482":49243,"_5":14053,"_26831":49198,"_2843":49244},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3355":431,"_29485":409,"_20482":49246,"_5":14053,"_26831":49198,"_2843":49247},[],"Also run the chart's connectivity test:",{"_3355":432,"_29485":409,"_20482":49249,"_5":14053,"_26831":49198,"_2843":49250},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3355":433,"_29485":409,"_20482":49252,"_5":14053,"_26831":49198,"_2843":49253},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3355":434,"_29485":409,"_20482":49255,"_5":14053,"_26831":49202,"_2843":49256},[],"If you receive a 401:",{"_3355":435,"_29485":409,"_20482":49258,"_5":14053,"_26831":49202,"_2843":49259},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3355":436,"_29485":409,"_20482":49261,"_5":14053,"_26831":49202,"_2843":49262},[],"verify issuer, audience and expiration of the token;",{"_3355":437,"_29485":409,"_20482":49264,"_5":14053,"_26831":49202,"_2843":49265},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3355":438,"_29485":409,"_20482":49267,"_5":14053,"_26831":49202,"_2843":49268},[],"check that the provider's public and internal routes point to the same realm.",{"_3355":439,"_29485":409,"_20482":49270,"_5":14053,"_26831":49202,"_2843":49271},[],"If login succeeds but the APIs return 403:",{"_3355":440,"_29485":409,"_20482":49273,"_5":14053,"_26831":49202,"_2843":49274},[],"inspect the token's real claims;",{"_3355":441,"_29485":409,"_20482":49276,"_5":14053,"_26831":49202,"_2843":49277},[],"confirm they match an active principal;",{"_3355":442,"_29485":409,"_20482":49279,"_5":14053,"_26831":49202,"_2843":49280},[],"review the policies granted to that principal;",{"_3355":443,"_29485":409,"_20482":49282,"_5":14053,"_26831":49202,"_2843":49283},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3355":444,"_29485":409,"_20482":49285,"_5":14053,"_26831":49202,"_2843":49286},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3355":445,"_29485":409,"_20482":49288,"_5":14053,"_26831":49206,"_2843":49289},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3355":446,"_29485":409,"_20482":49291,"_5":14053,"_26831":49206,"_2843":49292},[],"Locate the authz pod and Service.",{"_3355":447,"_29485":409,"_20482":49294,"_5":14053,"_26831":49206,"_2843":49295},[],"Check /health, logs and its database connection.",{"_3355":448,"_29485":409,"_20482":49297,"_5":14053,"_26831":49206,"_2843":49298},[],"Verify the DNS and port configured in externalAuthorization.",{"_3355":449,"_29485":409,"_20482":49300,"_5":14053,"_26831":49206,"_2843":49301},[],"Check the check route is /v1/ext\\_authz/check.",{"_3355":450,"_29485":409,"_20482":49303,"_5":14053,"_26831":49206,"_2843":49304},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3355":451,"_29485":409,"_20482":49306,"_5":14053,"_26831":49210,"_2843":49307},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3355":452,"_29485":409,"_20482":49309,"_5":14053,"_26831":49214,"_2843":49310},[],"Review kubectl describe pod first. Common causes are:",{"_3355":453,"_29485":409,"_20482":49312,"_5":14053,"_26831":49214,"_2843":49313},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3355":454,"_29485":409,"_20482":49315,"_5":14053,"_26831":49214,"_2843":49316},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3355":455,"_29485":409,"_20482":49318,"_5":14053,"_26831":49214,"_2843":49319},[],"unbound persistent volume;",{"_3355":456,"_29485":409,"_20482":49321,"_5":14053,"_26831":49214,"_2843":49322},[],"inaccessible image or incorrect pull policy;",{"_3355":457,"_29485":409,"_20482":49324,"_5":14053,"_26831":49214,"_2843":49325},[],"invalid cryptographic engine configuration;",{"_3355":458,"_29485":409,"_20482":49327,"_5":14053,"_26831":49214,"_2843":49328},[],"CPU or memory limits set too low;",{"_3355":459,"_29485":409,"_20482":49330,"_5":14053,"_26831":49214,"_2843":49331},[],"an incomplete prior migration.",{"_3355":460,"_29485":409,"_20482":49333,"_5":14053,"_26831":49214,"_2843":49334},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3355":461,"_29485":409,"_20482":49336,"_5":14053,"_26831":49214,"_2843":49337},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3355":462,"_29485":409,"_20482":49339,"_5":14053,"_26831":49214,"_2843":49340},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3355":463,"_29485":409,"_20482":49342,"_5":14053,"_26831":49218,"_2843":49343},[],"Domain and audit events depend on the bus publisher:",{"_3355":464,"_29485":409,"_20482":49345,"_5":14053,"_26831":49218,"_2843":49346},[],"verify it is enabled in the emitting service;",{"_3355":465,"_29485":409,"_20482":49348,"_5":14053,"_26831":49218,"_2843":49349},[],"check AMQP connectivity and credentials;",{"_3355":466,"_29485":409,"_20482":49351,"_5":14053,"_26831":49218,"_2843":49352},[],"review exchange, routing key, queues and consumers;",{"_3355":467,"_29485":409,"_20482":49354,"_5":14053,"_26831":49218,"_2843":49355},[],"inspect dead-letter queues;",{"_3355":468,"_29485":409,"_20482":49357,"_5":14053,"_26831":49218,"_2843":49358},[],"alert on orphan durable queues and backlog growth.",{"_3355":469,"_29485":409,"_20482":49360,"_5":14053,"_26831":49218,"_2843":49361},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3355":470,"_29485":409,"_20482":49363,"_5":14053,"_26831":49218,"_2843":49364},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3355":471,"_29485":409,"_20482":49366,"_5":14053,"_26831":49218,"_2843":49367},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3355":472,"_29485":409,"_20482":49369,"_5":14053,"_26831":49218,"_2843":49370},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3355":473,"_29485":409,"_20482":49372,"_5":14053,"_26831":49218,"_2843":49373},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3355":474,"_29485":409,"_20482":49375,"_5":14053,"_26831":49218,"_2843":49376},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3355":475,"_29485":409,"_20482":49378,"_5":14053,"_26831":49218,"_2843":49379},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3355":476,"_29485":409,"_20482":49381,"_5":14053,"_26831":49222,"_2843":49382},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3355":477,"_29485":409,"_20482":49384,"_5":14053,"_26831":49222,"_2843":49385},[],"Before closing an incident, record:",{"_3355":478,"_29485":409,"_20482":49387,"_5":14053,"_26831":49222,"_2843":49388},[],"the confirmed cause;",{"_3355":479,"_29485":409,"_20482":49390,"_5":14053,"_26831":49222,"_2843":49391},[],"the time scope and affected resources;",{"_3355":480,"_29485":409,"_20482":49393,"_5":14053,"_26831":49222,"_2843":49394},[],"the commands or queries used;",{"_3355":481,"_29485":409,"_20482":49396,"_5":14053,"_26831":49222,"_2843":49397},[],"the applied change and how to revert it;",{"_3355":482,"_29485":409,"_20482":49399,"_5":14053,"_26831":49222,"_2843":49400},[],"validation from a consumer;",{"_3355":483,"_29485":409,"_20482":49402,"_5":14053,"_26831":49222,"_2843":49403},[],"the preventive action and its owner.",{"_3355":484,"_29485":484,"_5":14411,"_2843":49405,"_29817":49406,"_20482":49409,"_26831":484},"Access control",[47939,49407,49408],"Platform","Administration",[],{"_3355":485,"_29485":484,"_20482":49411,"_5":14053,"_26831":484,"_2843":49412},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3355":486,"_29485":484,"_5":29814,"_20482":49414,"_26831":49415,"_2843":49416},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3355":487,"_29485":484,"_5":29814,"_20482":49418,"_26831":49419,"_2843":49420},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3355":488,"_29485":484,"_5":29814,"_20482":49422,"_26831":49423,"_2843":49424},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3355":489,"_29485":484,"_5":29814,"_20482":49426,"_26831":49427,"_2843":49428},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3355":490,"_29485":484,"_5":29814,"_20482":49430,"_26831":49431,"_2843":49432},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3355":491,"_29485":484,"_5":29814,"_20482":49434,"_26831":49435,"_2843":49436},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3355":492,"_29485":484,"_5":29814,"_20482":49438,"_26831":49439,"_2843":49440},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3355":493,"_29485":484,"_5":29814,"_20482":49442,"_26831":49443,"_2843":49444},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3355":494,"_29485":484,"_5":29814,"_20482":49446,"_26831":49447,"_2843":49448},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3355":495,"_29485":484,"_5":29814,"_20482":49450,"_26831":49451,"_2843":49452},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3355":496,"_29485":484,"_5":29814,"_20482":49454,"_26831":49455,"_2843":49456},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3355":497,"_29485":484,"_5":29814,"_20482":49458,"_26831":49459,"_2843":49460},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3355":498,"_29485":484,"_5":29814,"_20482":49462,"_26831":49463,"_2843":49464},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3355":499,"_29485":484,"_5":29814,"_20482":49466,"_26831":49467,"_2843":49468},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3355":500,"_29485":484,"_5":29814,"_20482":49470,"_26831":49471,"_2843":49472},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3355":501,"_29485":484,"_5":29814,"_20482":49474,"_26831":49475,"_2843":48579},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3355":502,"_29485":484,"_5":29814,"_20482":49477,"_26831":49478,"_2843":49479},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3355":503,"_29485":484,"_5":29814,"_20482":49481,"_26831":49482,"_2843":49483},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3355":504,"_29485":484,"_5":29814,"_20482":49485,"_26831":49486,"_2843":49487},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3355":505,"_29485":484,"_5":29814,"_20482":49489,"_26831":49490,"_2843":49491},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3355":506,"_29485":484,"_5":29814,"_20482":49493,"_26831":49494,"_2843":49495},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3355":507,"_29485":484,"_5":29814,"_20482":49497,"_26831":49498,"_2843":49499},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3355":508,"_29485":484,"_5":29814,"_20482":49501,"_26831":49502,"_2843":49503},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3355":509,"_29485":484,"_5":29814,"_20482":49505,"_26831":49506,"_2843":49507},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3355":510,"_29485":484,"_5":29814,"_20482":49509,"_26831":49510,"_2843":49511},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3355":511,"_29485":484,"_5":29814,"_20482":49513,"_26831":49514,"_2843":49515},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3355":512,"_29485":484,"_5":29814,"_20482":49517,"_26831":49518,"_2843":49519},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3355":513,"_29485":484,"_5":29814,"_20482":49521,"_26831":49522,"_2843":49523},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3355":514,"_29485":484,"_5":29814,"_20482":49525,"_26831":49526,"_2843":49527},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3355":515,"_29485":484,"_5":29814,"_20482":49529,"_26831":49530,"_2843":49531},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3355":516,"_29485":484,"_5":29814,"_20482":49533,"_26831":49534,"_2843":49535},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3355":517,"_29485":484,"_20482":49537,"_5":14053,"_26831":484,"_2843":49538},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3355":518,"_29485":484,"_20482":49540,"_5":14053,"_26831":484,"_2843":49541},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3355":519,"_29485":484,"_20482":49543,"_5":14053,"_26831":484,"_2843":49544},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3355":520,"_29485":484,"_20482":49546,"_5":14053,"_26831":49415,"_2843":49547},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3355":521,"_29485":484,"_20482":49549,"_5":14053,"_26831":49415,"_2843":49550},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3355":522,"_29485":484,"_20482":49552,"_5":14053,"_26831":49415,"_2843":49553},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3355":523,"_29485":484,"_20482":49555,"_5":14053,"_26831":49415,"_2843":49556},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3355":524,"_29485":484,"_20482":49558,"_5":14053,"_26831":49415,"_2843":49559},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3355":525,"_29485":484,"_20482":49561,"_5":14053,"_26831":49415,"_2843":49562},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3355":526,"_29485":484,"_20482":49564,"_5":14053,"_26831":49419,"_2843":49565},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3355":527,"_29485":484,"_20482":49567,"_5":14053,"_26831":49419,"_2843":49568},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3355":528,"_29485":484,"_20482":49570,"_5":14053,"_26831":49423,"_2843":49571},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3355":529,"_29485":484,"_20482":49573,"_5":14053,"_26831":49423,"_2843":49574},[],"The decision is made **before forwarding the request to the service**:",{"_3355":530,"_29485":484,"_20482":49576,"_5":14053,"_26831":49423,"_2843":49577},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3355":531,"_29485":484,"_20482":49579,"_5":14053,"_26831":49423,"_2843":49580},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3355":532,"_29485":484,"_20482":49582,"_5":14053,"_26831":49423,"_2843":49583},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3355":533,"_29485":484,"_20482":49585,"_5":14053,"_26831":49423,"_2843":49586},[],"It separately loads the policies granted to each principal.",{"_3355":534,"_29485":484,"_20482":49588,"_5":14053,"_26831":49423,"_2843":49589},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3355":535,"_29485":484,"_20482":49591,"_5":14053,"_26831":49423,"_2843":49592},[],"`authz` looks for an HTTP rule granting that action.",{"_3355":536,"_29485":484,"_20482":49594,"_5":14053,"_26831":49423,"_2843":49595},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3355":537,"_29485":484,"_20482":49597,"_5":14053,"_26831":49423,"_2843":49598},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3355":538,"_29485":484,"_20482":49600,"_5":14053,"_26831":49423,"_2843":49601},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3355":539,"_29485":484,"_20482":49603,"_5":14053,"_26831":49423,"_2843":49604},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3355":540,"_29485":484,"_20482":49606,"_5":14053,"_26831":49427,"_2843":49607},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3355":541,"_29485":484,"_20482":49609,"_5":14053,"_26831":49427,"_2843":49610},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3355":542,"_29485":484,"_20482":49612,"_5":14053,"_26831":49427,"_2843":49613},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3355":543,"_29485":484,"_20482":49615,"_5":14053,"_26831":49427,"_2843":49616},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3355":544,"_29485":484,"_20482":49618,"_5":14053,"_26831":49427,"_2843":49619},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3355":545,"_29485":484,"_20482":49621,"_5":14053,"_26831":49427,"_2843":49622},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3355":546,"_29485":484,"_20482":49624,"_5":14053,"_26831":49427,"_2843":49625},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3355":547,"_29485":484,"_20482":49627,"_5":14053,"_26831":49427,"_2843":49628},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3355":548,"_29485":484,"_20482":49630,"_5":14053,"_26831":49431,"_2843":49631},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3355":549,"_29485":484,"_20482":49633,"_5":14053,"_26831":49431,"_2843":49634},[],"The decision is made with the domain operation context:",{"_3355":550,"_29485":484,"_20482":49636,"_5":14053,"_26831":49431,"_2843":49637},[],"The middleware extracts the credential and resolves the matching principals.",{"_3355":551,"_29485":484,"_20482":49639,"_5":14053,"_26831":49431,"_2843":49640},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3355":552,"_29485":484,"_20482":49642,"_5":14053,"_26831":49431,"_2843":49643},[],"`authz` gathers the entity rules of the granted policies.",{"_3355":553,"_29485":484,"_20482":49645,"_5":14053,"_26831":49431,"_2843":49646},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3355":554,"_29485":484,"_20482":49648,"_5":14053,"_26831":49431,"_2843":49649},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3355":555,"_29485":484,"_20482":49651,"_5":14053,"_26831":49431,"_2843":49652},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3355":556,"_29485":484,"_20482":49654,"_5":14053,"_26831":49431,"_2843":49655},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3355":557,"_29485":484,"_20482":49657,"_5":14053,"_26831":49431,"_2843":49658},[],"Actions fall into two groups:",{"_3355":558,"_29485":484,"_20482":49660,"_5":14053,"_26831":49431,"_2843":49661},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3355":559,"_29485":484,"_20482":49663,"_5":14053,"_26831":49431,"_2843":49664},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3355":560,"_29485":484,"_20482":49666,"_5":14053,"_26831":49431,"_2843":49667},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3355":561,"_29485":484,"_20482":49669,"_5":14053,"_26831":49435,"_2843":49670},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3355":562,"_29485":484,"_20482":49672,"_5":14053,"_26831":49435,"_2843":49673},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3355":563,"_29485":484,"_20482":49675,"_5":14053,"_26831":49435,"_2843":49676},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3355":564,"_29485":484,"_20482":49678,"_5":14053,"_26831":49439,"_2843":49679},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3355":565,"_29485":484,"_20482":49681,"_5":14053,"_26831":49439,"_2843":49682},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3355":566,"_29485":484,"_20482":49684,"_5":14053,"_26831":49439,"_2843":49685},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3355":567,"_29485":484,"_20482":49687,"_5":14053,"_26831":49439,"_2843":49688},[],"The implemented operators are:",{"_3355":568,"_29485":484,"_20482":49690,"_5":14053,"_26831":49439,"_2843":49691},[],"`equals`, for exact equality;",{"_3355":569,"_29485":484,"_20482":49693,"_5":14053,"_26831":49439,"_2843":49694},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3355":570,"_29485":484,"_20482":49696,"_5":14053,"_26831":49439,"_2843":49697},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3355":571,"_29485":484,"_20482":49699,"_5":14053,"_26831":49439,"_2843":49700},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3355":572,"_29485":484,"_20482":49702,"_5":14053,"_26831":49443,"_2843":49703},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3355":573,"_29485":484,"_20482":49705,"_5":14053,"_26831":49443,"_2843":49706},[],"The available modes are:",{"_3355":574,"_29485":484,"_20482":49708,"_5":14053,"_26831":49443,"_2843":49709},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3355":575,"_29485":484,"_20482":49711,"_5":14053,"_26831":49443,"_2843":49712},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3355":576,"_29485":484,"_20482":49714,"_5":14053,"_26831":49443,"_2843":49715},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3355":577,"_29485":484,"_20482":49717,"_5":14053,"_26831":49443,"_2843":49718},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3355":578,"_29485":484,"_20482":49720,"_5":14053,"_26831":49443,"_2843":49721},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3355":579,"_29485":484,"_20482":49723,"_5":14053,"_26831":49443,"_2843":49724},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3355":580,"_29485":484,"_20482":49726,"_5":14053,"_26831":49447,"_2843":49727},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3355":581,"_29485":484,"_20482":49729,"_5":14053,"_26831":49447,"_2843":49730},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3355":582,"_29485":484,"_20482":49732,"_5":14053,"_26831":49447,"_2843":49733},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3355":583,"_29485":484,"_20482":49735,"_5":14053,"_26831":49447,"_2843":49736},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3355":584,"_29485":484,"_20482":49738,"_5":14053,"_26831":49455,"_2843":49739},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3355":585,"_29485":484,"_20482":49741,"_5":14053,"_26831":49455,"_2843":49742},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3355":586,"_29485":484,"_20482":49744,"_5":14053,"_26831":49459,"_2843":49745},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3355":587,"_29485":484,"_20482":49747,"_5":14053,"_26831":49459,"_2843":49748},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3355":588,"_29485":484,"_20482":49750,"_5":14053,"_26831":49463,"_2843":49751},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3355":589,"_29485":484,"_20482":49753,"_5":14053,"_26831":49463,"_2843":49754},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3355":590,"_29485":484,"_20482":49756,"_5":14053,"_26831":49463,"_2843":49757},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3355":591,"_29485":484,"_20482":49759,"_5":14053,"_26831":49467,"_2843":49760},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3355":592,"_29485":484,"_20482":49762,"_5":14053,"_26831":49467,"_2843":49763},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3355":593,"_29485":484,"_20482":49765,"_5":14053,"_26831":49467,"_2843":49766},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3355":594,"_29485":484,"_20482":49768,"_5":14053,"_26831":49467,"_2843":49769},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3355":595,"_29485":484,"_20482":49771,"_5":14053,"_26831":49467,"_2843":49772},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3355":596,"_29485":484,"_20482":49774,"_5":14053,"_26831":49467,"_2843":49775},[],"Note that:",{"_3355":597,"_29485":484,"_20482":49777,"_5":14053,"_26831":49467,"_2843":49778},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3355":598,"_29485":484,"_20482":49780,"_5":14053,"_26831":49467,"_2843":49781},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3355":599,"_29485":484,"_20482":49783,"_5":14053,"_26831":49467,"_2843":49784},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3355":600,"_29485":484,"_20482":49786,"_5":14053,"_26831":49471,"_2843":49787},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3355":601,"_29485":484,"_20482":49789,"_5":14053,"_26831":49471,"_2843":49790},[],"full and read-only access to certificates and authorities;",{"_3355":602,"_29485":484,"_20482":49792,"_5":14053,"_26831":49471,"_2843":49793},[],"full and read-only access to the KMS;",{"_3355":603,"_29485":484,"_20482":49795,"_5":14053,"_26831":49471,"_2843":49796},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3355":604,"_29485":484,"_20482":49798,"_5":14053,"_26831":49471,"_2843":49799},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3355":605,"_29485":484,"_20482":49801,"_5":14053,"_26831":49471,"_2843":49802},[],"console access;",{"_3355":606,"_29485":484,"_20482":49804,"_5":14053,"_26831":49471,"_2843":49805},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3355":607,"_29485":484,"_20482":49807,"_5":14053,"_26831":49471,"_2843":49808},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3355":608,"_29485":484,"_20482":49810,"_5":14053,"_26831":49471,"_2843":49811},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3355":609,"_29485":484,"_20482":49813,"_5":14053,"_26831":49475,"_2843":49814},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3355":610,"_29485":484,"_20482":49816,"_5":14053,"_26831":49475,"_2843":49817},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3355":611,"_29485":484,"_20482":49819,"_5":14053,"_26831":49475,"_2843":49820},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3355":612,"_29485":484,"_20482":49822,"_5":14053,"_26831":49478,"_2843":49823},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3355":613,"_29485":484,"_20482":49825,"_5":14053,"_26831":49482,"_2843":49826},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3355":614,"_29485":484,"_20482":49828,"_5":14053,"_26831":49482,"_2843":49829},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3355":615,"_29485":484,"_20482":49831,"_5":14053,"_26831":49486,"_2843":49832},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3355":616,"_29485":484,"_20482":49834,"_5":14053,"_26831":49490,"_2843":49835},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3355":617,"_29485":484,"_20482":49837,"_5":14053,"_26831":49494,"_2843":49838},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3355":618,"_29485":484,"_20482":49840,"_5":14053,"_26831":49498,"_2843":49841},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3355":619,"_29485":484,"_20482":49843,"_5":14053,"_26831":49498,"_2843":49844},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3355":620,"_29485":484,"_20482":49846,"_5":14053,"_26831":49502,"_2843":49847},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3355":621,"_29485":484,"_20482":49849,"_5":14053,"_26831":49502,"_2843":49850},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3355":622,"_29485":484,"_20482":49852,"_5":14053,"_26831":49502,"_2843":49853},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3355":623,"_29485":484,"_20482":49855,"_5":14053,"_26831":49502,"_2843":49856},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3355":624,"_29485":484,"_20482":49858,"_5":14053,"_26831":49502,"_2843":49859},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3355":625,"_29485":484,"_20482":49861,"_5":14053,"_26831":49502,"_2843":49862},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3355":626,"_29485":484,"_20482":49864,"_5":14053,"_26831":49502,"_2843":49865},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3355":627,"_29485":484,"_20482":49867,"_5":14053,"_26831":49502,"_2843":49868},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3355":628,"_29485":484,"_20482":49870,"_5":14053,"_26831":49506,"_2843":49871},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3355":629,"_29485":484,"_20482":49873,"_5":14053,"_26831":49506,"_2843":49874},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3355":630,"_29485":484,"_20482":49876,"_5":14053,"_26831":49506,"_2843":49877},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3355":631,"_29485":484,"_20482":49879,"_5":14053,"_26831":49510,"_2843":49880},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3355":632,"_29485":484,"_20482":49882,"_5":14053,"_26831":49510,"_2843":49883},[],"Use groups or stable roles for people and independent identities for automations.",{"_3355":633,"_29485":484,"_20482":49885,"_5":14053,"_26831":49510,"_2843":49886},[],"Keep at least two recovery administrators and test their access periodically.",{"_3355":634,"_29485":484,"_20482":49888,"_5":14053,"_26831":49510,"_2843":49889},[],"Review active principals, their matches and their grants after IdP changes.",{"_3355":635,"_29485":484,"_20482":49891,"_5":14053,"_26831":49510,"_2843":49892},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3355":636,"_29485":484,"_20482":49894,"_5":14053,"_26831":49510,"_2843":49895},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3355":637,"_29485":484,"_20482":49897,"_5":14053,"_26831":49510,"_2843":49898},[],"Always test one allowed and one denied operation for each role.",{"_3355":638,"_29485":484,"_20482":49900,"_5":14053,"_26831":49510,"_2843":49901},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3355":639,"_29485":484,"_20482":49903,"_5":14053,"_26831":49518,"_2843":49904},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3355":640,"_29485":484,"_20482":49906,"_5":14053,"_26831":49522,"_2843":49907},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3355":641,"_29485":484,"_20482":49909,"_5":14053,"_26831":49522,"_2843":49910},[],"that an active principal of the correct type exists;",{"_3355":642,"_29485":484,"_20482":49912,"_5":14053,"_26831":49522,"_2843":49913},[],"that the claim paths and values match the real token exactly;",{"_3355":643,"_29485":484,"_20482":49915,"_5":14053,"_26831":49522,"_2843":49916},[],"that all of the principal's conditions hold;",{"_3355":644,"_29485":484,"_20482":49918,"_5":14053,"_26831":49522,"_2843":49919},[],"that the principal has the expected policy granted;",{"_3355":645,"_29485":484,"_20482":49921,"_5":14053,"_26831":49522,"_2843":49922},[],"that the policy includes the action and the requested resource type or route;",{"_3355":646,"_29485":484,"_20482":49924,"_5":14053,"_26831":49522,"_2843":49925},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3355":647,"_29485":484,"_20482":49927,"_5":14053,"_26831":49522,"_2843":49928},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3355":648,"_29485":484,"_20482":49930,"_5":14053,"_26831":49526,"_2843":49931},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3355":649,"_29485":484,"_20482":49933,"_5":14053,"_26831":49530,"_2843":49934},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3355":650,"_29485":484,"_20482":49936,"_5":14053,"_26831":49534,"_2843":49937},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3355":651,"_29485":484,"_20482":49939,"_5":14053,"_26831":49534,"_2843":49940},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3355":652,"_29485":652,"_5":14411,"_2843":49942,"_29817":49943,"_20482":49944,"_26831":652},"Alerts and subscriptions",[47939,49407,49408],[],{"_3355":653,"_29485":652,"_20482":49946,"_5":14053,"_26831":652,"_2843":49947},[],"Send PKI events to people and external systems.",{"_3355":654,"_29485":652,"_5":29814,"_20482":49949,"_26831":49950,"_2843":49951},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3355":655,"_29485":652,"_5":29814,"_20482":49953,"_26831":49954,"_2843":49955},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3355":656,"_29485":652,"_5":29814,"_20482":49957,"_26831":49958,"_2843":49959},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3355":657,"_29485":652,"_5":29814,"_20482":49961,"_26831":49962,"_2843":49963},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3355":658,"_29485":652,"_5":29814,"_20482":49965,"_26831":49966,"_2843":49967},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3355":659,"_29485":652,"_5":29814,"_20482":49969,"_26831":49970,"_2843":49971},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3355":660,"_29485":652,"_5":29814,"_20482":49973,"_26831":49974,"_2843":49975},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3355":661,"_29485":652,"_5":29814,"_20482":49977,"_26831":49978,"_2843":49979},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3355":662,"_29485":652,"_5":29814,"_20482":49981,"_26831":49982,"_2843":49983},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3355":663,"_29485":652,"_5":29814,"_20482":49985,"_26831":49986,"_2843":49987},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3355":664,"_29485":652,"_5":29814,"_20482":49989,"_26831":49990,"_2843":49991},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3355":665,"_29485":652,"_20482":49993,"_5":14053,"_26831":652,"_2843":49994},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3355":666,"_29485":652,"_20482":49996,"_5":14053,"_26831":49950,"_2843":49997},[],"A service publishes a domain event.",{"_3355":667,"_29485":652,"_20482":49999,"_5":14053,"_26831":49950,"_2843":50000},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3355":668,"_29485":652,"_20482":50002,"_5":14053,"_26831":49950,"_2843":50003},[],"Each subscription's filter decides whether it should be notified.",{"_3355":669,"_29485":652,"_20482":50005,"_5":14053,"_26831":49950,"_2843":50006},[],"Lamassu delivers the event to the configured channel.",{"_3355":670,"_29485":652,"_20482":50008,"_5":14053,"_26831":49950,"_2843":50009},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3355":671,"_29485":652,"_20482":50011,"_5":14053,"_26831":49954,"_2843":50012},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3355":672,"_29485":652,"_20482":50014,"_5":14053,"_26831":49954,"_2843":50015},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3355":673,"_29485":652,"_20482":50017,"_5":14053,"_26831":49954,"_2843":50018},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3355":674,"_29485":652,"_20482":50020,"_5":14053,"_26831":49954,"_2843":50021},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3355":675,"_29485":652,"_20482":50023,"_5":14053,"_26831":49954,"_2843":50024},[],"`apikey_options` requires `header` and `key`.",{"_3355":676,"_29485":652,"_20482":50026,"_5":14053,"_26831":49954,"_2843":50027},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3355":677,"_29485":652,"_20482":50029,"_5":14053,"_26831":49954,"_2843":50030},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3355":678,"_29485":652,"_20482":50032,"_5":14053,"_26831":49954,"_2843":50033},[],"The alerts API reference documents the full `http_client` schema.",{"_3355":679,"_29485":652,"_20482":50035,"_5":14053,"_26831":49962,"_2843":50036},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3355":680,"_29485":652,"_20482":50038,"_5":14053,"_26831":49966,"_2843":50039},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3355":681,"_29485":652,"_20482":50041,"_5":14053,"_26831":49970,"_2843":50042},[],"Add a filter if you don't want to receive every instance of the event.",{"_3355":682,"_29485":652,"_20482":50044,"_5":14053,"_26831":49970,"_2843":50045},[],"**None** notifies all instances of the event.",{"_3355":683,"_29485":652,"_20482":50047,"_5":14053,"_26831":49970,"_2843":50048},[],"**JSON Path** evaluates one or more specific fields.",{"_3355":684,"_29485":652,"_20482":50050,"_5":14053,"_26831":49970,"_2843":50051},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3355":685,"_29485":652,"_20482":50053,"_5":14053,"_26831":49970,"_2843":50054},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3355":686,"_29485":652,"_20482":50056,"_5":14053,"_26831":49970,"_2843":50057},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3355":687,"_29485":652,"_20482":50059,"_5":14053,"_26831":49970,"_2843":50060},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3355":688,"_29485":652,"_20482":50062,"_5":14053,"_26831":49974,"_2843":50063},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3355":689,"_29485":652,"_20482":50065,"_5":14053,"_26831":49978,"_2843":50066},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3355":690,"_29485":652,"_20482":50068,"_5":14053,"_26831":49978,"_2843":50069},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3355":691,"_29485":652,"_20482":50071,"_5":14053,"_26831":49978,"_2843":50072},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3355":692,"_29485":652,"_20482":50074,"_5":14053,"_26831":49978,"_2843":50075},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3355":693,"_29485":652,"_20482":50077,"_5":14053,"_26831":49978,"_2843":50078},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3355":694,"_29485":652,"_20482":50080,"_5":14053,"_26831":49978,"_2843":50081},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3355":695,"_29485":652,"_20482":50083,"_5":14053,"_26831":49978,"_2843":50084},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3355":696,"_29485":652,"_20482":50086,"_5":14053,"_26831":49978,"_2843":50087},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3355":697,"_29485":652,"_20482":50089,"_5":14053,"_26831":49982,"_2843":50090},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3355":698,"_29485":652,"_20482":50092,"_5":14053,"_26831":49982,"_2843":50093},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3355":699,"_29485":652,"_20482":50095,"_5":14053,"_26831":49982,"_2843":50096},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3355":700,"_29485":652,"_20482":50098,"_5":14053,"_26831":49982,"_2843":50099},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3355":701,"_29485":652,"_20482":50101,"_5":14053,"_26831":49982,"_2843":50102},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3355":702,"_29485":652,"_20482":50104,"_5":14053,"_26831":49982,"_2843":50105},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3355":703,"_29485":652,"_20482":50107,"_5":14053,"_26831":49982,"_2843":50108},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3355":704,"_29485":652,"_20482":50110,"_5":14053,"_26831":49982,"_2843":50111},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3355":705,"_29485":652,"_20482":50113,"_5":14053,"_26831":49986,"_2843":50114},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3355":706,"_29485":652,"_20482":50116,"_5":14053,"_26831":49986,"_2843":50117},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3355":707,"_29485":652,"_20482":50119,"_5":14053,"_26831":49990,"_2843":50120},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3355":708,"_29485":652,"_20482":50122,"_5":14053,"_26831":49990,"_2843":50123},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3355":709,"_29485":652,"_20482":50125,"_5":14053,"_26831":49990,"_2843":50126},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3355":710,"_29485":652,"_20482":50128,"_5":14053,"_26831":49990,"_2843":50129},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3355":711,"_29485":652,"_20482":50131,"_5":14053,"_26831":49990,"_2843":50132},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3355":712,"_29485":652,"_20482":50134,"_5":14053,"_26831":49990,"_2843":50135},[],"**Validation:** `va.role.crl.create`.",{"_3355":713,"_29485":652,"_20482":50137,"_5":14053,"_26831":49990,"_2843":50138},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3355":714,"_29485":652,"_20482":50140,"_5":14053,"_26831":49990,"_2843":50141},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3355":715,"_29485":715,"_5":14411,"_2843":50143,"_29817":50144,"_20482":50145,"_26831":715},"Audit logs",[47939,49407,49408],[],{"_3355":716,"_29485":715,"_20482":50147,"_5":14053,"_26831":715,"_2843":50148},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3355":717,"_29485":715,"_5":29814,"_20482":50150,"_26831":50151,"_2843":50152},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3355":718,"_29485":715,"_5":29814,"_20482":50154,"_26831":50155,"_2843":50156},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3355":719,"_29485":715,"_5":29814,"_20482":50158,"_26831":50159,"_2843":50160},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3355":720,"_29485":715,"_5":29814,"_20482":50162,"_26831":50163,"_2843":50164},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3355":721,"_29485":715,"_5":29814,"_20482":50166,"_26831":50167,"_2843":50168},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3355":722,"_29485":715,"_5":29814,"_20482":50170,"_26831":50171,"_2843":50172},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3355":723,"_29485":715,"_5":29814,"_20482":50174,"_26831":50175,"_2843":50176},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3355":724,"_29485":715,"_5":29814,"_20482":50178,"_26831":50179,"_2843":50180},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3355":725,"_29485":715,"_5":29814,"_20482":50182,"_26831":50183,"_2843":50184},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3355":726,"_29485":715,"_5":29814,"_20482":50186,"_26831":50187,"_2843":50188},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3355":727,"_29485":715,"_5":29814,"_20482":50190,"_26831":50191,"_2843":50192},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3355":728,"_29485":715,"_20482":50194,"_5":14053,"_26831":715,"_2843":50195},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3355":729,"_29485":715,"_20482":50197,"_5":14053,"_26831":50151,"_2843":50198},[],"The audit body includes:",{"_3355":730,"_29485":715,"_20482":50200,"_5":14053,"_26831":50151,"_2843":50201},[],"input: data received by the operation;",{"_3355":731,"_29485":715,"_20482":50203,"_5":14053,"_26831":50151,"_2843":50204},[],"has\\_error: whether the service returned an error;",{"_3355":732,"_29485":715,"_20482":50206,"_5":14053,"_26831":50151,"_2843":50207},[],"output: produced result or error message;",{"_3355":733,"_29485":715,"_20482":50209,"_5":14053,"_26831":50151,"_2843":50210},[],"principals: identifiers of the principals that matched the request.",{"_3355":734,"_29485":715,"_20482":50212,"_5":14053,"_26831":50151,"_2843":50213},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3355":735,"_29485":715,"_20482":50215,"_5":14053,"_26831":50151,"_2843":50216},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3355":736,"_29485":715,"_20482":50218,"_5":14053,"_26831":50155,"_2843":50219},[],"The backend applies auditing to mutations of:",{"_3355":737,"_29485":715,"_20482":50221,"_5":14053,"_26831":50155,"_2843":50222},[],"authorities, certificates and issuance profiles;",{"_3355":738,"_29485":715,"_20482":50224,"_5":14053,"_26831":50155,"_2843":50225},[],"keys and KMS engines;",{"_3355":739,"_29485":715,"_20482":50227,"_5":14053,"_26831":50155,"_2843":50228},[],"devices and identities;",{"_3355":740,"_29485":715,"_20482":50230,"_5":14053,"_26831":50155,"_2843":50231},[],"DMSs and enrollment operations;",{"_3355":741,"_29485":715,"_20482":50233,"_5":14053,"_26831":50155,"_2843":50234},[],"validation functions and CRL;",{"_3355":742,"_29485":715,"_20482":50236,"_5":14053,"_26831":50155,"_2843":50237},[],"principals, policies and authorization grants.",{"_3355":743,"_29485":715,"_20482":50239,"_5":14053,"_26831":50155,"_2843":50240},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3355":744,"_29485":715,"_20482":50242,"_5":14053,"_26831":50159,"_2843":50243},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3355":745,"_29485":715,"_20482":50245,"_5":14053,"_26831":50159,"_2843":50246},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3355":746,"_29485":715,"_20482":50248,"_5":14053,"_26831":50159,"_2843":50249},[],"Design the consumer to:",{"_3355":747,"_29485":715,"_20482":50251,"_5":14053,"_26831":50159,"_2843":50252},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3355":748,"_29485":715,"_20482":50254,"_5":14053,"_26831":50159,"_2843":50255},[],"keep the complete CloudEvent unmodified;",{"_3355":749,"_29485":715,"_20482":50257,"_5":14053,"_26831":50159,"_2843":50258},[],"record the ingestion time and detect duplicates by ID;",{"_3355":750,"_29485":715,"_20482":50260,"_5":14053,"_26831":50159,"_2843":50261},[],"encrypt in transit and at rest;",{"_3355":751,"_29485":715,"_20482":50263,"_5":14053,"_26831":50159,"_2843":50264},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3355":752,"_29485":715,"_20482":50266,"_5":14053,"_26831":50159,"_2843":50267},[],"apply an explicit retention and legal hold policy;",{"_3355":753,"_29485":715,"_20482":50269,"_5":14053,"_26831":50159,"_2843":50270},[],"alert if it stops consuming or the pending queue grows.",{"_3355":754,"_29485":715,"_20482":50272,"_5":14053,"_26831":50163,"_2843":50273},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3355":755,"_29485":715,"_20482":50275,"_5":14053,"_26831":50163,"_2843":50276},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3355":756,"_29485":715,"_20482":50278,"_5":14053,"_26831":50171,"_2843":50279},[],"Start from the reported time and normalize every source to UTC.",{"_3355":757,"_29485":715,"_20482":50281,"_5":14053,"_26831":50175,"_2843":50282},[],"Filter by event type, service source and resource identifier.",{"_3355":758,"_29485":715,"_20482":50284,"_5":14053,"_26831":50179,"_2843":50285},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3355":759,"_29485":715,"_20482":50287,"_5":14053,"_26831":50183,"_2843":50288},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3355":760,"_29485":715,"_20482":50290,"_5":14053,"_26831":50187,"_2843":50291},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3355":761,"_29485":715,"_20482":50293,"_5":14053,"_26831":50191,"_2843":50294},[],"Generate a controlled mutation in a test environment and check that:",{"_3355":762,"_29485":715,"_20482":50296,"_5":14053,"_26831":50191,"_2843":50297},[],"a successful audit event appears;",{"_3355":763,"_29485":715,"_20482":50299,"_5":14053,"_26831":50191,"_2843":50300},[],"the principal matches the identity used;",{"_3355":764,"_29485":715,"_20482":50302,"_5":14053,"_26831":50191,"_2843":50303},[],"the consumer persists it exactly once;",{"_3355":765,"_29485":715,"_20482":50305,"_5":14053,"_26831":50191,"_2843":50306},[],"it can be retrieved by resource, actor and period;",{"_3355":766,"_29485":715,"_20482":50308,"_5":14053,"_26831":50191,"_2843":50309},[],"a consumer outage raises an alert.",{"_3355":767,"_29485":715,"_20482":50311,"_5":14053,"_26831":50191,"_2843":50312},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3355":768,"_29485":768,"_5":14411,"_2843":50314,"_29817":50315,"_20482":50316,"_26831":768},"Platform architecture",[47939,49407],[],{"_3355":769,"_29485":768,"_20482":50318,"_5":14053,"_26831":768,"_2843":50319},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3355":770,"_29485":768,"_5":29814,"_20482":50321,"_26831":50322,"_2843":50323},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3355":771,"_29485":768,"_5":29814,"_20482":50325,"_26831":50326,"_2843":50327},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3355":772,"_29485":768,"_5":29814,"_20482":50329,"_26831":50330,"_2843":50331},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3355":773,"_29485":768,"_5":29814,"_20482":50333,"_26831":50334,"_2843":50335},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3355":774,"_29485":768,"_5":29814,"_20482":50337,"_26831":50338,"_2843":50339},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3355":775,"_29485":768,"_20482":50341,"_5":14053,"_26831":768,"_2843":50342},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3355":776,"_29485":768,"_20482":50344,"_5":14053,"_26831":768,"_2843":50345},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3355":777,"_29485":768,"_20482":50347,"_5":14053,"_26831":50322,"_2843":50348},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3355":778,"_29485":768,"_20482":50350,"_5":14053,"_26831":50326,"_2843":50351},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3355":779,"_29485":768,"_20482":50353,"_5":14053,"_26831":50330,"_2843":50354},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3355":780,"_29485":768,"_20482":50356,"_5":14053,"_26831":50334,"_2843":50357},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3355":781,"_29485":768,"_20482":50359,"_5":14053,"_26831":50338,"_2843":50360},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3355":782,"_29485":782,"_5":14411,"_2843":50362,"_29817":50363,"_20482":50364,"_26831":782},"How Lamassu works",[47939,49407],[],{"_3355":783,"_29485":782,"_20482":50366,"_5":14053,"_26831":782,"_2843":50367},[],"The mental model of trust, keys, certificates and devices.",{"_3355":784,"_29485":782,"_5":29814,"_20482":50369,"_26831":50370,"_2843":50371},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3355":785,"_29485":782,"_5":29814,"_20482":50373,"_26831":50374,"_2843":50375},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3355":786,"_29485":782,"_20482":50377,"_5":14053,"_26831":782,"_2843":50378},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3355":787,"_29485":782,"_20482":50380,"_5":14053,"_26831":50370,"_2843":50381},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3355":788,"_29485":782,"_20482":50383,"_5":14053,"_26831":50370,"_2843":50384},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3355":789,"_29485":782,"_20482":50386,"_5":14053,"_26831":50370,"_2843":50387},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3355":790,"_29485":782,"_20482":50389,"_5":14053,"_26831":50370,"_2843":50390},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3355":791,"_29485":782,"_20482":50392,"_5":14053,"_26831":50370,"_2843":50393},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3355":792,"_29485":782,"_20482":50395,"_5":14053,"_26831":50374,"_2843":50396},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3355":793,"_29485":782,"_20482":50398,"_5":14053,"_26831":50374,"_2843":50399},[],"A DMS relates that CA to an enrollment policy.",{"_3355":794,"_29485":782,"_20482":50401,"_5":14053,"_26831":50374,"_2843":50402},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3355":795,"_29485":782,"_20482":50404,"_5":14053,"_26831":50374,"_2843":50405},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3355":796,"_29485":782,"_20482":50407,"_5":14053,"_26831":50374,"_2843":50408},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3355":797,"_29485":782,"_20482":50410,"_5":14053,"_26831":50374,"_2843":50411},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3355":798,"_29485":782,"_20482":50413,"_5":14053,"_26831":50374,"_2843":50414},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3355":799,"_29485":799,"_5":14411,"_2843":50416,"_29817":50417,"_20482":50419,"_26831":799},"Devices and identities",[47939,49407,50418,50416],"IoT Fleets",[],{"_3355":800,"_29485":799,"_20482":50421,"_5":14053,"_26831":799,"_2843":50422},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3355":801,"_29485":799,"_5":29814,"_20482":50424,"_26831":50425,"_2843":50426},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3355":802,"_29485":799,"_5":29814,"_20482":50428,"_26831":50429,"_2843":50430},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3355":803,"_29485":799,"_5":29814,"_20482":50432,"_26831":50433,"_2843":50434},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3355":804,"_29485":799,"_5":29814,"_20482":50436,"_26831":50437,"_2843":50438},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3355":805,"_29485":799,"_5":29814,"_20482":50440,"_26831":50441,"_2843":50442},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3355":806,"_29485":799,"_5":29814,"_20482":50444,"_26831":50445,"_2843":50446},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3355":807,"_29485":799,"_5":29814,"_20482":50448,"_26831":50449,"_2843":50450},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3355":808,"_29485":799,"_5":29814,"_20482":50452,"_26831":50453,"_2843":50454},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3355":809,"_29485":799,"_5":29814,"_20482":50456,"_26831":50457,"_2843":50458},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3355":810,"_29485":799,"_5":29814,"_20482":50460,"_26831":50461,"_2843":50462},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3355":811,"_29485":799,"_5":29814,"_20482":50464,"_26831":50465,"_2843":50466},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3355":812,"_29485":799,"_20482":50468,"_5":14053,"_26831":799,"_2843":50469},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3355":813,"_29485":799,"_20482":50471,"_5":14053,"_26831":799,"_2843":50472},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3355":814,"_29485":799,"_20482":50474,"_5":14053,"_26831":50425,"_2843":50475},[],"Operational view",{"_3355":815,"_29485":799,"_20482":50477,"_5":14053,"_26831":50425,"_2843":50478},[],"Meaning",{"_3355":816,"_29485":799,"_20482":50480,"_5":14053,"_26831":50425,"_2843":50481},[],"**No Identity**",{"_3355":817,"_29485":799,"_20482":50483,"_5":14053,"_26831":50425,"_2843":50484},[],"A record exists without an associated identity.",{"_3355":818,"_29485":799,"_20482":50486,"_5":14053,"_26831":50425,"_2843":50487},[],"**Active**",{"_3355":819,"_29485":799,"_20482":50489,"_5":14053,"_26831":50425,"_2843":50490},[],"The slot is active; also check certificate dates, status and usages.",{"_3355":820,"_29485":799,"_20482":50492,"_5":14053,"_26831":50425,"_2843":50493},[],"**Renewal Pending**",{"_3355":821,"_29485":799,"_20482":50495,"_5":14053,"_26831":50425,"_2843":50496},[],"The identity is in the operational renewal window.",{"_3355":822,"_29485":799,"_20482":50498,"_5":14053,"_26831":50425,"_2843":50499},[],"**Expiring Soon**",{"_3355":823,"_29485":799,"_20482":50501,"_5":14053,"_26831":50425,"_2843":50502},[],"Expiration is approaching according to configured thresholds.",{"_3355":824,"_29485":799,"_20482":50504,"_5":14053,"_26831":50425,"_2843":50505},[],"**Expired**",{"_3355":825,"_29485":799,"_20482":50507,"_5":14053,"_26831":50425,"_2843":50508},[],"The identity has expired.",{"_3355":826,"_29485":799,"_20482":50510,"_5":14053,"_26831":50425,"_2843":50511},[],"**Revoked**",{"_3355":827,"_29485":799,"_20482":50513,"_5":14053,"_26831":50425,"_2843":50514},[],"The identity is marked revoked.",{"_3355":828,"_29485":799,"_20482":50516,"_5":14053,"_26831":50425,"_2843":50517},[],"**Decommissioned**",{"_3355":829,"_29485":799,"_20482":50519,"_5":14053,"_26831":50425,"_2843":50520},[],"The record is retired and ordinary updates do not restore operation.",{"_3355":830,"_29485":799,"_20482":50522,"_5":14053,"_26831":50425,"_2843":50523},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3355":831,"_29485":799,"_20482":50525,"_5":14053,"_26831":50429,"_2843":50526},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3355":832,"_29485":799,"_20482":50528,"_5":14053,"_26831":50429,"_2843":50529},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3355":833,"_29485":799,"_20482":50531,"_5":14053,"_26831":50429,"_2843":50532},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3355":834,"_29485":799,"_20482":50534,"_5":14053,"_26831":50429,"_2843":50535},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3355":835,"_29485":799,"_20482":50537,"_5":14053,"_26831":50433,"_2843":50538},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3355":836,"_29485":799,"_20482":50540,"_5":14053,"_26831":50437,"_2843":50541},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3355":837,"_29485":799,"_20482":50543,"_5":14053,"_26831":50441,"_2843":50544},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3355":838,"_29485":799,"_20482":50546,"_5":14053,"_26831":50445,"_2843":50547},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3355":839,"_29485":799,"_20482":50549,"_5":14053,"_26831":50449,"_2843":50550},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3355":840,"_29485":799,"_20482":50552,"_5":14053,"_26831":50449,"_2843":50553},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3355":841,"_29485":799,"_20482":50555,"_5":14053,"_26831":50453,"_2843":50556},[],"From **No Identity**, use **Assign Identity**:",{"_3355":842,"_29485":799,"_20482":50558,"_5":14053,"_26831":50453,"_2843":50559},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3355":843,"_29485":799,"_20482":50561,"_5":14053,"_26831":50453,"_2843":50562},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3355":844,"_29485":799,"_20482":50564,"_5":14053,"_26831":50453,"_2843":50565},[],"Confirm and read the serial, active version and history again.",{"_3355":845,"_29485":799,"_20482":50567,"_5":14053,"_26831":50453,"_2843":50568},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3355":846,"_29485":799,"_20482":50570,"_5":14053,"_26831":50453,"_2843":50571},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3355":847,"_29485":799,"_20482":50573,"_5":14053,"_26831":50457,"_2843":50574},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3355":848,"_29485":799,"_20482":50576,"_5":14053,"_26831":50457,"_2843":50577},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3355":849,"_29485":799,"_20482":50579,"_5":14053,"_26831":50461,"_2843":50580},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3355":850,"_29485":799,"_20482":50582,"_5":14053,"_26831":50461,"_2843":50583},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3355":851,"_29485":799,"_20482":50585,"_5":14053,"_26831":50461,"_2843":50586},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3355":852,"_29485":799,"_20482":50588,"_5":14053,"_26831":50461,"_2843":50589},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3355":853,"_29485":799,"_20482":50591,"_5":14053,"_26831":50465,"_2843":50592},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3355":854,"_29485":799,"_20482":50594,"_5":14053,"_26831":50465,"_2843":50595},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3355":855,"_29485":855,"_5":14411,"_2843":50597,"_29817":50598,"_20482":50600,"_26831":855},"Bootstrap identity and authentication",[47939,49407,50418,50416,50599],"Enrollment with PKI",[],{"_3355":856,"_29485":855,"_20482":50602,"_5":14053,"_26831":855,"_2843":50603},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3355":857,"_29485":855,"_5":29814,"_20482":50605,"_26831":50606,"_2843":50607},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3355":858,"_29485":855,"_5":29814,"_20482":50609,"_26831":50610,"_2843":50611},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3355":859,"_29485":855,"_5":29814,"_20482":50613,"_26831":50614,"_2843":50615},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3355":860,"_29485":855,"_5":29814,"_20482":50617,"_26831":50618,"_2843":50619},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3355":861,"_29485":855,"_5":29814,"_20482":50621,"_26831":50622,"_2843":50623},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3355":862,"_29485":855,"_20482":50625,"_5":14053,"_26831":855,"_2843":50626},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3355":863,"_29485":855,"_20482":50628,"_5":14053,"_26831":50606,"_2843":50629},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3355":864,"_29485":855,"_20482":50631,"_5":14053,"_26831":50606,"_2843":50632},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3355":865,"_29485":855,"_20482":50634,"_5":14053,"_26831":50610,"_2843":50635},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3355":866,"_29485":855,"_20482":50637,"_5":14053,"_26831":50610,"_2843":50638},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3355":867,"_29485":855,"_20482":50640,"_5":14053,"_26831":50610,"_2843":50641},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3355":868,"_29485":855,"_20482":50643,"_5":14053,"_26831":50614,"_2843":50644},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3355":869,"_29485":855,"_20482":50646,"_5":14053,"_26831":50614,"_2843":50647},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3355":870,"_29485":855,"_20482":50649,"_5":14053,"_26831":50618,"_2843":50650},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3355":871,"_29485":855,"_20482":50652,"_5":14053,"_26831":50618,"_2843":50653},[],"Example body:",{"_3355":872,"_29485":855,"_20482":50655,"_5":14053,"_26831":50618,"_2843":50656},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3355":873,"_29485":855,"_20482":50658,"_5":14053,"_26831":50618,"_2843":50659},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3355":874,"_29485":855,"_20482":50661,"_5":14053,"_26831":50618,"_2843":50662},[],"Continuation requires a successful HTTP response and JSON:",{"_3355":875,"_29485":855,"_20482":50664,"_5":14053,"_26831":50618,"_2843":50665},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3355":876,"_29485":855,"_20482":50667,"_5":14053,"_26831":50622,"_2843":50668},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3355":877,"_29485":855,"_20482":50670,"_5":14053,"_26831":50622,"_2843":50671},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3355":878,"_29485":878,"_5":14411,"_2843":50673,"_29817":50674,"_20482":50675,"_26831":878},"Configure and operate the DMS",[47939,49407,50418,50416,50599],[],{"_3355":879,"_29485":878,"_20482":50677,"_5":14053,"_26831":878,"_2843":50678},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3355":880,"_29485":878,"_5":29814,"_20482":50680,"_26831":50681,"_2843":47949},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3355":881,"_29485":878,"_5":29814,"_20482":50683,"_26831":50684,"_2843":50685},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3355":882,"_29485":878,"_5":29814,"_20482":50687,"_26831":50688,"_2843":50689},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3355":883,"_29485":878,"_5":29814,"_20482":50691,"_26831":50692,"_2843":50693},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3355":884,"_29485":878,"_5":29814,"_20482":50695,"_26831":50696,"_2843":50697},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3355":885,"_29485":878,"_5":29814,"_20482":50699,"_26831":50700,"_2843":50701},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3355":886,"_29485":878,"_5":29814,"_20482":50703,"_26831":50704,"_2843":50705},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3355":887,"_29485":878,"_5":29814,"_20482":50707,"_26831":50708,"_2843":50709},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3355":888,"_29485":878,"_5":29814,"_20482":50711,"_26831":50712,"_2843":50713},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3355":889,"_29485":878,"_5":29814,"_20482":50715,"_26831":50716,"_2843":50717},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3355":890,"_29485":878,"_5":29814,"_20482":50719,"_26831":50720,"_2843":50721},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3355":891,"_29485":878,"_5":29814,"_20482":50723,"_26831":50724,"_2843":50725},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3355":892,"_29485":878,"_5":29814,"_20482":50727,"_26831":50728,"_2843":50729},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3355":893,"_29485":878,"_5":29814,"_20482":50731,"_26831":50732,"_2843":50733},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3355":894,"_29485":878,"_5":29814,"_20482":50735,"_26831":50736,"_2843":50737},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3355":895,"_29485":878,"_5":29814,"_20482":50739,"_26831":50740,"_2843":50741},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3355":896,"_29485":878,"_5":29814,"_20482":50743,"_26831":50744,"_2843":50745},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3355":897,"_29485":878,"_5":29814,"_20482":50747,"_26831":50748,"_2843":50749},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3355":898,"_29485":878,"_20482":50751,"_5":14053,"_26831":878,"_2843":50752},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3355":899,"_29485":878,"_20482":50754,"_5":14053,"_26831":50681,"_2843":50755},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3355":900,"_29485":878,"_20482":50757,"_5":14053,"_26831":50681,"_2843":50758},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3355":901,"_29485":878,"_20482":50760,"_5":14053,"_26831":50688,"_2843":50761},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3355":902,"_29485":878,"_20482":50763,"_5":14053,"_26831":50692,"_2843":50764},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3355":903,"_29485":878,"_20482":50766,"_5":14053,"_26831":50696,"_2843":50767},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3355":904,"_29485":878,"_20482":50769,"_5":14053,"_26831":50700,"_2843":50770},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3355":905,"_29485":878,"_20482":50772,"_5":14053,"_26831":50704,"_2843":50773},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3355":906,"_29485":878,"_20482":50775,"_5":14053,"_26831":50712,"_2843":50776},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3355":907,"_29485":878,"_20482":50778,"_5":14053,"_26831":50712,"_2843":50779},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3355":908,"_29485":878,"_20482":50781,"_5":14053,"_26831":50716,"_2843":50782},[],"`settings.enrollment_settings` field",{"_3355":909,"_29485":878,"_20482":50784,"_5":14053,"_26831":50716,"_2843":50785},[],"Decision",{"_3355":910,"_29485":878,"_20482":50787,"_5":14053,"_26831":50716,"_2843":50788},[],"`protocol`",{"_3355":911,"_29485":878,"_20482":50790,"_5":14053,"_26831":50716,"_2843":50791},[],"`EST_RFC7030` for these operations.",{"_3355":912,"_29485":878,"_20482":50793,"_5":14053,"_26831":50716,"_2843":50794},[],"`enrollment_ca`",{"_3355":913,"_29485":878,"_20482":50796,"_5":14053,"_26831":50716,"_2843":50797},[],"ID of the signing CA.",{"_3355":914,"_29485":878,"_20482":50799,"_5":14053,"_26831":50716,"_2843":50800},[],"`verify_csr_signature`",{"_3355":915,"_29485":878,"_20482":50802,"_5":14053,"_26831":50716,"_2843":50803},[],"Keep `true` to verify CSR key possession.",{"_3355":916,"_29485":878,"_20482":50805,"_5":14053,"_26831":50716,"_2843":50806},[],"`enable_replaceable_enrollment`",{"_3355":917,"_29485":878,"_20482":50808,"_5":14053,"_26831":50716,"_2843":50809},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3355":918,"_29485":878,"_20482":50811,"_5":14053,"_26831":50716,"_2843":50812},[],"`est_rfc7030_settings.auth_mode`",{"_3355":919,"_29485":878,"_20482":50814,"_5":14053,"_26831":50716,"_2843":50815},[],"One of the four authentication modes.",{"_3355":920,"_29485":878,"_20482":50817,"_5":14053,"_26831":50716,"_2843":50818},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3355":921,"_29485":878,"_20482":50820,"_5":14053,"_26831":50720,"_2843":50821},[],"The blocks are independent:",{"_3355":922,"_29485":878,"_20482":50823,"_5":14053,"_26831":50720,"_2843":50824},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3355":923,"_29485":878,"_20482":50826,"_5":14053,"_26831":50720,"_2843":50827},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3355":924,"_29485":878,"_20482":50829,"_5":14053,"_26831":50720,"_2843":50830},[],"`auth_mode`",{"_3355":925,"_29485":878,"_20482":50832,"_5":14053,"_26831":50720,"_2843":50833},[],"Control applied in the configured operation",{"_3355":926,"_29485":878,"_20482":50835,"_5":14053,"_26831":50720,"_2843":50836},[],"`CLIENT_CERTIFICATE`",{"_3355":927,"_29485":878,"_20482":50838,"_5":14053,"_26831":50720,"_2843":50839},[],"Presented certificate validation.",{"_3355":928,"_29485":878,"_20482":50841,"_5":14053,"_26831":50720,"_2843":50842},[],"`EXTERNAL_WEBHOOK`",{"_3355":929,"_29485":878,"_20482":50844,"_5":14053,"_26831":50720,"_2843":50845},[],"Configured webhook authorization.",{"_3355":930,"_29485":878,"_20482":50847,"_5":14053,"_26831":50720,"_2843":50848},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3355":931,"_29485":878,"_20482":50850,"_5":14053,"_26831":50720,"_2843":50851},[],"Certificate validation followed by webhook approval.",{"_3355":932,"_29485":878,"_20482":50853,"_5":14053,"_26831":50720,"_2843":50854},[],"`NO_AUTH`",{"_3355":933,"_29485":878,"_20482":50856,"_5":14053,"_26831":50720,"_2843":50857},[],"No DMS requester authentication.",{"_3355":934,"_29485":878,"_20482":50859,"_5":14053,"_26831":50720,"_2843":50860},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3355":935,"_29485":878,"_20482":50862,"_5":14053,"_26831":50720,"_2843":50863},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3355":936,"_29485":878,"_20482":50865,"_5":14053,"_26831":50720,"_2843":50866},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3355":937,"_29485":878,"_20482":50868,"_5":14053,"_26831":50720,"_2843":50869},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3355":938,"_29485":878,"_20482":50871,"_5":14053,"_26831":50724,"_2843":50872},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3355":939,"_29485":878,"_20482":50874,"_5":14053,"_26831":50724,"_2843":50875},[],"`external_webhook_settings` field",{"_3355":940,"_29485":878,"_20482":50877,"_5":14053,"_26831":50724,"_2843":50785},[],{"_3355":941,"_29485":878,"_20482":50879,"_5":14053,"_26831":50724,"_2843":50880},[],"`url`",{"_3355":942,"_29485":878,"_20482":50882,"_5":14053,"_26831":50724,"_2843":50883},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3355":943,"_29485":878,"_20482":50885,"_5":14053,"_26831":50724,"_2843":50886},[],"`method`",{"_3355":944,"_29485":878,"_20482":50888,"_5":14053,"_26831":50724,"_2843":50889},[],"`POST` or `PUT`; `POST` by default.",{"_3355":945,"_29485":878,"_20482":50891,"_5":14053,"_26831":50724,"_2843":50892},[],"`name`",{"_3355":946,"_29485":878,"_20482":50894,"_5":14053,"_26831":50724,"_2843":50895},[],"Label used in service logs.",{"_3355":947,"_29485":878,"_20482":50897,"_5":14053,"_26831":50724,"_2843":50898},[],"`config.auth_mode`",{"_3355":948,"_29485":878,"_20482":50900,"_5":14053,"_26831":50724,"_2843":50901},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3355":949,"_29485":878,"_20482":50903,"_5":14053,"_26831":50724,"_2843":50904},[],"`config.log_level`",{"_3355":950,"_29485":878,"_20482":50906,"_5":14053,"_26831":50724,"_2843":50907},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3355":951,"_29485":878,"_20482":50909,"_5":14053,"_26831":50724,"_2843":50910},[],"`config.apikey_options`",{"_3355":952,"_29485":878,"_20482":50912,"_5":14053,"_26831":50724,"_2843":50913},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3355":953,"_29485":878,"_20482":50915,"_5":14053,"_26831":50724,"_2843":50916},[],"`config.jwt_options`",{"_3355":954,"_29485":878,"_20482":50918,"_5":14053,"_26831":50724,"_2843":50919},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3355":955,"_29485":878,"_20482":50921,"_5":14053,"_26831":50724,"_2843":50922},[],"`config.mtls_options`",{"_3355":956,"_29485":878,"_20482":50924,"_5":14053,"_26831":50724,"_2843":50925},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3355":957,"_29485":878,"_20482":50927,"_5":14053,"_26831":50724,"_2843":50928},[],"`config.insecure_skip_verify`",{"_3355":958,"_29485":878,"_20482":50930,"_5":14053,"_26831":50724,"_2843":50931},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3355":959,"_29485":878,"_20482":50933,"_5":14053,"_26831":50724,"_2843":50934},[],"`config.call_timeout`",{"_3355":960,"_29485":878,"_20482":50936,"_5":14053,"_26831":50724,"_2843":50937},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3355":961,"_29485":878,"_20482":50939,"_5":14053,"_26831":50724,"_2843":50940},[],"Rules for that configuration:",{"_3355":962,"_29485":878,"_20482":50942,"_5":14053,"_26831":50724,"_2843":50943},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3355":963,"_29485":878,"_20482":50945,"_5":14053,"_26831":50724,"_2843":50946},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3355":964,"_29485":878,"_20482":50948,"_5":14053,"_26831":50724,"_2843":50949},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3355":965,"_29485":878,"_20482":50951,"_5":14053,"_26831":50724,"_2843":50952},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3355":966,"_29485":878,"_20482":50954,"_5":14053,"_26831":50724,"_2843":50955},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3355":967,"_29485":878,"_20482":50957,"_5":14053,"_26831":50724,"_2843":50958},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3355":968,"_29485":878,"_20482":50960,"_5":14053,"_26831":50724,"_2843":50961},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3355":969,"_29485":878,"_20482":50963,"_5":14053,"_26831":50724,"_2843":50964},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3355":970,"_29485":878,"_20482":50966,"_5":14053,"_26831":50724,"_2843":50967},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3355":971,"_29485":878,"_20482":50969,"_5":14053,"_26831":50728,"_2843":50970},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3355":972,"_29485":878,"_20482":50972,"_5":14053,"_26831":50732,"_2843":50973},[],"`settings.reenrollment_settings` field",{"_3355":973,"_29485":878,"_20482":50975,"_5":14053,"_26831":50732,"_2843":48329},[],{"_3355":974,"_29485":878,"_20482":50977,"_5":14053,"_26831":50732,"_2843":50978},[],"`reenrollment_delta`",{"_3355":975,"_29485":878,"_20482":50980,"_5":14053,"_26831":50732,"_2843":50981},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3355":976,"_29485":878,"_20482":50983,"_5":14053,"_26831":50732,"_2843":50984},[],"`preventive_delta`",{"_3355":977,"_29485":878,"_20482":50986,"_5":14053,"_26831":50732,"_2843":50987},[],"Preventive operational monitoring threshold.",{"_3355":978,"_29485":878,"_20482":50989,"_5":14053,"_26831":50732,"_2843":50990},[],"`critical_delta`",{"_3355":979,"_29485":878,"_20482":50992,"_5":14053,"_26831":50732,"_2843":50993},[],"Critical operational monitoring threshold.",{"_3355":980,"_29485":878,"_20482":50995,"_5":14053,"_26831":50732,"_2843":50996},[],"`enable_expired_renewal`",{"_3355":981,"_29485":878,"_20482":50998,"_5":14053,"_26831":50732,"_2843":50999},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3355":982,"_29485":878,"_20482":51001,"_5":14053,"_26831":50732,"_2843":51002},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3355":983,"_29485":878,"_20482":51004,"_5":14053,"_26831":50732,"_2843":51005},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3355":984,"_29485":878,"_20482":51007,"_5":14053,"_26831":50732,"_2843":51008},[],"`revoke_on_reenrollment`",{"_3355":985,"_29485":878,"_20482":51010,"_5":14053,"_26831":50732,"_2843":51011},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3355":986,"_29485":878,"_20482":51013,"_5":14053,"_26831":50732,"_2843":51014},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3355":987,"_29485":878,"_20482":51016,"_5":14053,"_26831":50736,"_2843":51017},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3355":988,"_29485":878,"_20482":51019,"_5":14053,"_26831":50740,"_2843":48323},[],{"_3355":989,"_29485":878,"_20482":51021,"_5":14053,"_26831":50740,"_2843":51022},[],"Published material",{"_3355":990,"_29485":878,"_20482":51024,"_5":14053,"_26831":50740,"_2843":51025},[],"**Include Lamassu System CA**",{"_3355":991,"_29485":878,"_20482":51027,"_5":14053,"_26831":50740,"_2843":51028},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3355":992,"_29485":878,"_20482":51030,"_5":14053,"_26831":50740,"_2843":51031},[],"**Include Enrollment CA**",{"_3355":993,"_29485":878,"_20482":51033,"_5":14053,"_26831":50740,"_2843":51034},[],"Selected issuing CA certificate.",{"_3355":994,"_29485":878,"_20482":51036,"_5":14053,"_26831":50740,"_2843":51037},[],"**Managed CAs**",{"_3355":995,"_29485":878,"_20482":51039,"_5":14053,"_26831":50740,"_2843":51040},[],"Explicitly selected CA certificates.",{"_3355":996,"_29485":878,"_20482":51042,"_5":14053,"_26831":50740,"_2843":51043},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3355":997,"_29485":878,"_20482":51045,"_5":14053,"_26831":50744,"_2843":51046},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3355":998,"_29485":878,"_20482":51048,"_5":14053,"_26831":50744,"_2843":51049},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3355":999,"_29485":878,"_20482":51051,"_5":14053,"_26831":50744,"_2843":51052},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3355":1000,"_29485":878,"_20482":51054,"_5":14053,"_26831":50748,"_2843":51055},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3355":1001,"_29485":1001,"_5":14411,"_2843":51057,"_29817":51058,"_20482":51059,"_26831":1001},"Integrate the EST client",[47939,49407,50418,50416,50599],[],{"_3355":1002,"_29485":1001,"_20482":51061,"_5":14053,"_26831":1001,"_2843":51062},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3355":1003,"_29485":1001,"_5":29814,"_20482":51064,"_26831":51065,"_2843":47949},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3355":1004,"_29485":1001,"_5":29814,"_20482":51067,"_26831":51068,"_2843":51069},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3355":1005,"_29485":1001,"_5":29814,"_20482":51071,"_26831":51072,"_2843":51073},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3355":1006,"_29485":1001,"_5":29814,"_20482":51075,"_26831":51076,"_2843":51077},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3355":1007,"_29485":1001,"_5":29814,"_20482":51079,"_26831":51080,"_2843":51081},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3355":1008,"_29485":1001,"_5":29814,"_20482":51083,"_26831":51084,"_2843":51085},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3355":1009,"_29485":1001,"_20482":51087,"_5":14053,"_26831":1001,"_2843":51088},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3355":1010,"_29485":1001,"_20482":51090,"_5":14053,"_26831":51065,"_2843":51091},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3355":1011,"_29485":1001,"_20482":51093,"_5":14053,"_26831":51065,"_2843":51094},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3355":1012,"_29485":1001,"_20482":51096,"_5":14053,"_26831":51065,"_2843":51097},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3355":1013,"_29485":1001,"_20482":51099,"_5":14053,"_26831":51068,"_2843":51100},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3355":1014,"_29485":1001,"_20482":51102,"_5":14053,"_26831":51068,"_2843":51103},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3355":1015,"_29485":1001,"_20482":51105,"_5":14053,"_26831":51072,"_2843":51106},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3355":1016,"_29485":1001,"_20482":51108,"_5":14053,"_26831":51072,"_2843":51109},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3355":1017,"_29485":1001,"_20482":51111,"_5":14053,"_26831":51076,"_2843":51112},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3355":1018,"_29485":1001,"_20482":51114,"_5":14053,"_26831":51076,"_2843":51115},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3355":1019,"_29485":1001,"_20482":51117,"_5":14053,"_26831":51080,"_2843":51118},[],"For a root that issues directly:",{"_3355":1020,"_29485":1001,"_20482":51120,"_5":14053,"_26831":51080,"_2843":51121},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3355":1021,"_29485":1001,"_20482":51123,"_5":14053,"_26831":51080,"_2843":51124},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3355":1022,"_29485":1001,"_20482":51126,"_5":14053,"_26831":51084,"_2843":51127},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3355":1023,"_29485":1023,"_5":14411,"_2843":51129,"_29817":51130,"_20482":51131,"_26831":1023},"EST reference",[47939,49407,50418,50416,50599],[],{"_3355":1024,"_29485":1023,"_20482":51133,"_5":14053,"_26831":1023,"_2843":51134},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3355":1025,"_29485":1023,"_5":29814,"_20482":51136,"_26831":51137,"_2843":51138},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3355":1026,"_29485":1023,"_5":29814,"_20482":51140,"_26831":51141,"_2843":22243},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3355":1027,"_29485":1023,"_5":29814,"_20482":51143,"_26831":51144,"_2843":25477},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3355":1028,"_29485":1023,"_5":29814,"_20482":51146,"_26831":51147,"_2843":25484},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3355":1029,"_29485":1023,"_5":29814,"_20482":51149,"_26831":51150,"_2843":24818},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3355":1030,"_29485":1023,"_5":29814,"_20482":51152,"_26831":51153,"_2843":51154},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3355":1031,"_29485":1023,"_5":29814,"_20482":51156,"_26831":51157,"_2843":51158},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3355":1032,"_29485":1023,"_5":29814,"_20482":51160,"_26831":51161,"_2843":51162},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3355":1033,"_29485":1023,"_20482":51164,"_5":14053,"_26831":1023,"_2843":51165},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3355":1034,"_29485":1023,"_20482":51167,"_5":14053,"_26831":51137,"_2843":51168},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3355":1035,"_29485":1023,"_20482":51170,"_5":14053,"_26831":51137,"_2843":51171},[],"Operation",{"_3355":1036,"_29485":1023,"_20482":51173,"_5":14053,"_26831":51137,"_2843":51174},[],"Method",{"_3355":1037,"_29485":1023,"_20482":51176,"_5":14053,"_26831":51137,"_2843":51177},[],"Authentication and condition",{"_3355":1038,"_29485":1023,"_20482":51179,"_5":14053,"_26831":51137,"_2843":51180},[],"`/cacerts`",{"_3355":1039,"_29485":1023,"_20482":51182,"_5":14053,"_26831":51137,"_2843":51183},[],"GET",{"_3355":1040,"_29485":1023,"_20482":51185,"_5":14053,"_26831":51137,"_2843":51186},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3355":1041,"_29485":1023,"_20482":51188,"_5":14053,"_26831":51137,"_2843":51189},[],"`/simpleenroll`",{"_3355":1042,"_29485":1023,"_20482":51191,"_5":14053,"_26831":51137,"_2843":51192},[],"POST",{"_3355":1043,"_29485":1023,"_20482":51194,"_5":14053,"_26831":51137,"_2843":51195},[],"Initial authentication and DMS registration/replacement policy.",{"_3355":1044,"_29485":1023,"_20482":51197,"_5":14053,"_26831":51137,"_2843":51198},[],"`/simplereenroll`",{"_3355":1045,"_29485":1023,"_20482":51200,"_5":14053,"_26831":51137,"_2843":51192},[],{"_3355":1046,"_29485":1023,"_20482":51202,"_5":14053,"_26831":51137,"_2843":51203},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3355":1047,"_29485":1023,"_20482":51205,"_5":14053,"_26831":51137,"_2843":51206},[],"`/serverkeygen`",{"_3355":1048,"_29485":1023,"_20482":51208,"_5":14053,"_26831":51137,"_2843":51192},[],{"_3355":1049,"_29485":1023,"_20482":51210,"_5":14053,"_26831":51137,"_2843":51211},[],"Initial authentication and admission; server generation enabled.",{"_3355":1050,"_29485":1023,"_20482":51213,"_5":14053,"_26831":51137,"_2843":51214},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3355":1051,"_29485":1023,"_20482":51216,"_5":14053,"_26831":51141,"_2843":51217},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3355":1052,"_29485":1023,"_20482":51219,"_5":14053,"_26831":51141,"_2843":51220},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3355":1053,"_29485":1023,"_20482":51222,"_5":14053,"_26831":51144,"_2843":51223},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3355":1054,"_29485":1023,"_20482":51225,"_5":14053,"_26831":51144,"_2843":51226},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3355":1055,"_29485":1023,"_20482":51228,"_5":14053,"_26831":51147,"_2843":51229},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3355":1056,"_29485":1023,"_20482":51231,"_5":14053,"_26831":51147,"_2843":51232},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3355":1057,"_29485":1023,"_20482":51234,"_5":14053,"_26831":51150,"_2843":51235},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3355":1058,"_29485":1023,"_20482":51237,"_5":14053,"_26831":51150,"_2843":51238},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3355":1059,"_29485":1023,"_20482":51240,"_5":14053,"_26831":51153,"_2843":51241},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3355":1060,"_29485":1023,"_20482":51243,"_5":14053,"_26831":51153,"_2843":51244},[],"Part",{"_3355":1061,"_29485":1023,"_20482":51246,"_5":14053,"_26831":51153,"_2843":51247},[],"Content after decoding its Base64",{"_3355":1062,"_29485":1023,"_20482":51249,"_5":14053,"_26831":51153,"_2843":51250},[],"`application/pkcs8`",{"_3355":1063,"_29485":1023,"_20482":51252,"_5":14053,"_26831":51153,"_2843":51253},[],"Unencrypted DER PKCS#8 private key.",{"_3355":1064,"_29485":1023,"_20482":51255,"_5":14053,"_26831":51153,"_2843":51256},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3355":1065,"_29485":1023,"_20482":51258,"_5":14053,"_26831":51153,"_2843":51259},[],"DER PKCS#7 containing the issued certificate.",{"_3355":1066,"_29485":1023,"_20482":51261,"_5":14053,"_26831":51153,"_2843":51262},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3355":1067,"_29485":1023,"_20482":51264,"_5":14053,"_26831":51157,"_2843":51265},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3355":1068,"_29485":1023,"_20482":51267,"_5":14053,"_26831":51157,"_2843":51268},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3355":1069,"_29485":1023,"_20482":51270,"_5":14053,"_26831":51157,"_2843":51271},[],"Convert and check the result:",{"_3355":1070,"_29485":1023,"_20482":51273,"_5":14053,"_26831":51157,"_2843":51274},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3355":1071,"_29485":1023,"_20482":51276,"_5":14053,"_26831":51161,"_2843":51277},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3355":1072,"_29485":1023,"_20482":51279,"_5":14053,"_26831":51161,"_2843":51280},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3355":1073,"_29485":1073,"_5":14411,"_2843":50599,"_29817":51282,"_20482":51283,"_26831":1073},[47939,49407,50418,50416,50599],[],{"_3355":1074,"_29485":1073,"_20482":51285,"_5":14053,"_26831":1073,"_2843":51286},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3355":1075,"_29485":1073,"_5":29814,"_20482":51288,"_26831":51289,"_2843":51290},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3355":1076,"_29485":1073,"_5":29814,"_20482":51292,"_26831":51293,"_2843":51294},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3355":1077,"_29485":1073,"_5":29814,"_20482":51296,"_26831":51297,"_2843":51298},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3355":1078,"_29485":1073,"_5":29814,"_20482":51300,"_26831":51301,"_2843":51302},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3355":1079,"_29485":1073,"_20482":51304,"_5":14053,"_26831":1073,"_2843":51305},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3355":1080,"_29485":1073,"_20482":51307,"_5":14053,"_26831":51289,"_2843":51308},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3355":1081,"_29485":1073,"_20482":51310,"_5":14053,"_26831":51289,"_2843":51311},[],"The integrator installs initial EST server trust and an admission credential.",{"_3355":1082,"_29485":1073,"_20482":51313,"_5":14053,"_26831":51289,"_2843":51314},[],"The client requests an identity for its `Device ID` through EST.",{"_3355":1083,"_29485":1073,"_20482":51316,"_5":14053,"_26831":51289,"_2843":51317},[],"Certificate, device binding and key/certificate installation are checked.",{"_3355":1084,"_29485":1073,"_20482":51319,"_5":14053,"_26831":51289,"_2843":51320},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3355":1085,"_29485":1073,"_20482":51322,"_5":14053,"_26831":51289,"_2843":51323},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3355":1086,"_29485":1073,"_20482":51325,"_5":14053,"_26831":51293,"_2843":51326},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3355":1087,"_29485":1073,"_20482":51328,"_5":14053,"_26831":51293,"_2843":51329},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3355":1088,"_29485":1073,"_20482":51331,"_5":14053,"_26831":51293,"_2843":51332},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3355":1089,"_29485":1073,"_20482":51334,"_5":14053,"_26831":51293,"_2843":51335},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3355":1090,"_29485":1073,"_20482":51337,"_5":14053,"_26831":51297,"_2843":51338},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3355":1091,"_29485":1073,"_20482":51340,"_5":14053,"_26831":51297,"_2843":51341},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3355":1092,"_29485":1073,"_20482":51343,"_5":14053,"_26831":51297,"_2843":51344},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3355":1093,"_29485":1073,"_20482":51346,"_5":14053,"_26831":51297,"_2843":51347},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3355":1094,"_29485":1073,"_20482":51349,"_5":14053,"_26831":51301,"_2843":51350},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3355":1095,"_29485":1073,"_20482":51352,"_5":14053,"_26831":51301,"_2843":51353},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3355":1096,"_29485":1096,"_5":14411,"_2843":51355,"_29817":51356,"_20482":51357,"_26831":1096},"Provisioning strategies",[47939,49407,50418,50416,50599],[],{"_3355":1097,"_29485":1096,"_20482":51359,"_5":14053,"_26831":1096,"_2843":51360},[],"Choose device registration, identity authorization and key generation.",{"_3355":1098,"_29485":1096,"_5":29814,"_20482":51362,"_26831":51363,"_2843":51364},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3355":1099,"_29485":1096,"_5":29814,"_20482":51366,"_26831":51367,"_2843":51368},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3355":1100,"_29485":1096,"_5":29814,"_20482":51370,"_26831":51371,"_2843":51372},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3355":1101,"_29485":1096,"_5":29814,"_20482":51374,"_26831":51375,"_2843":51376},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3355":1102,"_29485":1096,"_5":29814,"_20482":51378,"_26831":51379,"_2843":51380},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3355":1103,"_29485":1096,"_20482":51382,"_5":14053,"_26831":1096,"_2843":51383},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3355":1104,"_29485":1096,"_20482":51385,"_5":14053,"_26831":51363,"_2843":51386},[],"Path",{"_3355":1105,"_29485":1096,"_20482":51388,"_5":14053,"_26831":51363,"_2843":51389},[],"When the device exists",{"_3355":1106,"_29485":1096,"_20482":51391,"_5":14053,"_26831":51363,"_2843":51392},[],"What to check",{"_3355":1107,"_29485":1096,"_20482":51394,"_5":14053,"_26831":51363,"_2843":51395},[],"Manual assignment",{"_3355":1108,"_29485":1096,"_20482":51397,"_5":14053,"_26831":51363,"_2843":51398},[],"An operator creates it before associating a certificate.",{"_3355":1109,"_29485":1096,"_20482":51400,"_5":14053,"_26831":51363,"_2843":51401},[],"ID, owning DMS, certificate CN and bound serial.",{"_3355":1110,"_29485":1096,"_20482":51403,"_5":14053,"_26831":51363,"_2843":51404},[],"EST with `JITP`",{"_3355":1111,"_29485":1096,"_20482":51406,"_5":14053,"_26831":51363,"_2843":51407},[],"Created for an unknown CN during `/simpleenroll`.",{"_3355":1112,"_29485":1096,"_20482":51409,"_5":14053,"_26831":51363,"_2843":51410},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3355":1113,"_29485":1096,"_20482":51412,"_5":14053,"_26831":51363,"_2843":51413},[],"EST with `PRE_REGISTRATION`",{"_3355":1114,"_29485":1096,"_20482":51415,"_5":14053,"_26831":51363,"_2843":51416},[],"Must exist before `/simpleenroll`.",{"_3355":1115,"_29485":1096,"_20482":51418,"_5":14053,"_26831":51363,"_2843":51419},[],"Approved record, same DMS and replacement conditions for your version.",{"_3355":1116,"_29485":1096,"_20482":51421,"_5":14053,"_26831":51363,"_2843":51422},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3355":1117,"_29485":1096,"_20482":51424,"_5":14053,"_26831":51363,"_2843":51425},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3355":1118,"_29485":1096,"_20482":51427,"_5":14053,"_26831":51367,"_2843":51428},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3355":1119,"_29485":1096,"_20482":51430,"_5":14053,"_26831":51367,"_2843":51431},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3355":1120,"_29485":1096,"_20482":51433,"_5":14053,"_26831":51367,"_2843":51434},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3355":1121,"_29485":1096,"_20482":51436,"_5":14053,"_26831":51371,"_2843":51437},[],"Decide initial enrollment and re-enrollment separately:",{"_3355":1122,"_29485":1096,"_20482":51439,"_5":14053,"_26831":51371,"_2843":51440},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3355":1123,"_29485":1096,"_20482":51442,"_5":14053,"_26831":51371,"_2843":51443},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3355":1124,"_29485":1096,"_20482":51445,"_5":14053,"_26831":51371,"_2843":51446},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3355":1125,"_29485":1096,"_20482":51448,"_5":14053,"_26831":51371,"_2843":51449},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3355":1126,"_29485":1096,"_20482":51451,"_5":14053,"_26831":51371,"_2843":51452},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3355":1127,"_29485":1096,"_20482":51454,"_5":14053,"_26831":51375,"_2843":48323},[],{"_3355":1128,"_29485":1096,"_20482":51456,"_5":14053,"_26831":51375,"_2843":51457},[],"Material crossing EST",{"_3355":1129,"_29485":1096,"_20482":51459,"_5":14053,"_26831":51375,"_2843":51460},[],"Device-generated key",{"_3355":1130,"_29485":1096,"_20482":51462,"_5":14053,"_26831":51375,"_2843":51463},[],"Public CSR and certificate; the key stays on the client.",{"_3355":1131,"_29485":1096,"_20482":51465,"_5":14053,"_26831":51375,"_2843":51466},[],"Existing device key",{"_3355":1132,"_29485":1096,"_20482":51468,"_5":14053,"_26831":51375,"_2843":51469},[],"CSR signed with that key and a new certificate.",{"_3355":1133,"_29485":1096,"_20482":51471,"_5":14053,"_26831":51375,"_2843":50737},[],{"_3355":1134,"_29485":1096,"_20482":51473,"_5":14053,"_26831":51375,"_2843":51474},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3355":1135,"_29485":1096,"_20482":51476,"_5":14053,"_26831":51375,"_2843":51477},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3355":1136,"_29485":1096,"_20482":51479,"_5":14053,"_26831":51379,"_2843":51480},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3355":1137,"_29485":1137,"_5":14411,"_2843":51482,"_29817":51483,"_20482":51484,"_26831":1137},"Renewal and recovery",[47939,49407,50418,50416,50599],[],{"_3355":1138,"_29485":1137,"_20482":51486,"_5":14053,"_26831":1137,"_2843":51487},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3355":1139,"_29485":1137,"_5":29814,"_20482":51489,"_26831":51490,"_2843":51491},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3355":1140,"_29485":1137,"_5":29814,"_20482":51493,"_26831":51494,"_2843":51495},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3355":1141,"_29485":1137,"_5":29814,"_20482":51497,"_26831":51498,"_2843":51499},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3355":1142,"_29485":1137,"_5":29814,"_20482":51501,"_26831":51502,"_2843":51503},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3355":1143,"_29485":1137,"_5":29814,"_20482":51505,"_26831":51506,"_2843":51507},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3355":1144,"_29485":1137,"_20482":51509,"_5":14053,"_26831":1137,"_2843":51510},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3355":1145,"_29485":1137,"_20482":51512,"_5":14053,"_26831":51490,"_2843":51513},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3355":1146,"_29485":1137,"_20482":51515,"_5":14053,"_26831":51490,"_2843":51516},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3355":1147,"_29485":1137,"_20482":51518,"_5":14053,"_26831":51490,"_2843":51519},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3355":1148,"_29485":1137,"_20482":51521,"_5":14053,"_26831":51490,"_2843":51522},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3355":1149,"_29485":1137,"_20482":51524,"_5":14053,"_26831":51494,"_2843":51525},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3355":1150,"_29485":1137,"_20482":51527,"_5":14053,"_26831":51494,"_2843":51528},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3355":1151,"_29485":1137,"_20482":51530,"_5":14053,"_26831":51498,"_2843":51531},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3355":1152,"_29485":1137,"_20482":51533,"_5":14053,"_26831":51498,"_2843":51534},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3355":1153,"_29485":1137,"_20482":51536,"_5":14053,"_26831":51498,"_2843":51537},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3355":1154,"_29485":1137,"_20482":51539,"_5":14053,"_26831":51502,"_2843":51540},[],"Situation",{"_3355":1155,"_29485":1137,"_20482":51542,"_5":14053,"_26831":51502,"_2843":51543},[],"Procedure",{"_3355":1156,"_29485":1137,"_20482":51545,"_5":14053,"_26831":51502,"_2843":51546},[],"Valid certificate, outside the window",{"_3355":1157,"_29485":1137,"_20482":51548,"_5":14053,"_26831":51502,"_2843":51549},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3355":1158,"_29485":1137,"_20482":51551,"_5":14053,"_26831":51502,"_2843":51552},[],"Expired certificate, key available",{"_3355":1159,"_29485":1137,"_20482":51554,"_5":14053,"_26831":51502,"_2843":51555},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3355":1160,"_29485":1137,"_20482":51557,"_5":14053,"_26831":51502,"_2843":51558},[],"Renewal through webhook or `NO_AUTH`",{"_3355":1161,"_29485":1137,"_20482":51560,"_5":14053,"_26831":51502,"_2843":51561},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3355":1162,"_29485":1137,"_20482":51563,"_5":14053,"_26831":51502,"_2843":51564},[],"Lost or inaccessible key",{"_3355":1163,"_29485":1137,"_20482":51566,"_5":14053,"_26831":51502,"_2843":51567},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3355":1164,"_29485":1137,"_20482":51569,"_5":14053,"_26831":51502,"_2843":51570},[],"Current identity revoked",{"_3355":1165,"_29485":1137,"_20482":51572,"_5":14053,"_26831":51502,"_2843":51573},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3355":1166,"_29485":1137,"_20482":51575,"_5":14053,"_26831":51502,"_2843":51576},[],"Device without an identity",{"_3355":1167,"_29485":1137,"_20482":51578,"_5":14053,"_26831":51502,"_2843":51579},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3355":1168,"_29485":1137,"_20482":51581,"_5":14053,"_26831":51502,"_2843":51582},[],"Retired device",{"_3355":1169,"_29485":1137,"_20482":51584,"_5":14053,"_26831":51502,"_2843":51585},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3355":1170,"_29485":1137,"_20482":51587,"_5":14053,"_26831":51502,"_2843":51588},[],"Timeout, HTTP 500 or installation failure",{"_3355":1171,"_29485":1137,"_20482":51590,"_5":14053,"_26831":51502,"_2843":51591},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3355":1172,"_29485":1137,"_20482":51593,"_5":14053,"_26831":51506,"_2843":51594},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3355":1173,"_29485":1137,"_20482":51596,"_5":14053,"_26831":51506,"_2843":51597},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3355":1174,"_29485":1174,"_5":14411,"_2843":51599,"_29817":51600,"_20482":51601,"_26831":1174},"Enrollment troubleshooting",[47939,49407,50418,50416,50599],[],{"_3355":1175,"_29485":1174,"_20482":51603,"_5":14053,"_26831":1174,"_2843":51604},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3355":1176,"_29485":1174,"_5":29814,"_20482":51606,"_26831":51607,"_2843":51608},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3355":1177,"_29485":1174,"_5":29814,"_20482":51610,"_26831":51611,"_2843":51612},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3355":1178,"_29485":1174,"_5":29814,"_20482":51614,"_26831":51615,"_2843":51162},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3355":1179,"_29485":1174,"_5":29814,"_20482":51617,"_26831":51618,"_2843":51619},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3355":1180,"_29485":1174,"_20482":51621,"_5":14053,"_26831":1174,"_2843":51622},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3355":1181,"_29485":1174,"_20482":51624,"_5":14053,"_26831":51611,"_2843":51625},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3355":1182,"_29485":1174,"_20482":51627,"_5":14053,"_26831":51611,"_2843":51628},[],"Symptom or message",{"_3355":1183,"_29485":1174,"_20482":51630,"_5":14053,"_26831":51611,"_2843":51392},[],{"_3355":1184,"_29485":1174,"_20482":51632,"_5":14053,"_26831":51611,"_2843":51633},[],"curl rejects TLS, name or issuer",{"_3355":1185,"_29485":1174,"_20482":51635,"_5":14053,"_26831":51611,"_2843":51636},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3355":1186,"_29485":1174,"_20482":51638,"_5":14053,"_26831":51611,"_2843":51639},[],"404 or missing APS",{"_3355":1187,"_29485":1174,"_20482":51641,"_5":14053,"_26831":51611,"_2843":51642},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3355":1188,"_29485":1174,"_20482":51644,"_5":14053,"_26831":51611,"_2843":51645},[],"400, CSR or format error",{"_3355":1189,"_29485":1174,"_20482":51647,"_5":14053,"_26831":51611,"_2843":51648},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3355":1190,"_29485":1174,"_20482":51650,"_5":14053,"_26831":51611,"_2843":51651},[],"Missing credential or invalid certificate",{"_3355":1191,"_29485":1174,"_20482":51653,"_5":14053,"_26831":51611,"_2843":51654},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3355":1192,"_29485":1174,"_20482":51656,"_5":14053,"_26831":51611,"_2843":51657},[],"Webhook denies, times out or responds without authorization",{"_3355":1193,"_29485":1174,"_20482":51659,"_5":14053,"_26831":51611,"_2843":51660},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3355":1194,"_29485":1174,"_20482":51662,"_5":14053,"_26831":51611,"_2843":51663},[],"`unexpected status code: <n>: redirects are not followed`",{"_3355":1195,"_29485":1174,"_20482":51665,"_5":14053,"_26831":51611,"_2843":51666},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3355":1196,"_29485":1174,"_20482":51668,"_5":14053,"_26831":51611,"_2843":51669},[],"`webhook response exceeds 1048576 bytes`",{"_3355":1197,"_29485":1174,"_20482":51671,"_5":14053,"_26831":51611,"_2843":51672},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3355":1198,"_29485":1174,"_20482":51674,"_5":14053,"_26831":51611,"_2843":51675},[],"`webhook config must not reference files`",{"_3355":1199,"_29485":1174,"_20482":51677,"_5":14053,"_26831":51611,"_2843":51678},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3355":1200,"_29485":1174,"_20482":51680,"_5":14053,"_26831":51611,"_2843":51681},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3355":1201,"_29485":1174,"_20482":51683,"_5":14053,"_26831":51611,"_2843":51684},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3355":1202,"_29485":1174,"_20482":51686,"_5":14053,"_26831":51611,"_2843":51687},[],"`webhook mTLS certificate and key are invalid: …`",{"_3355":1203,"_29485":1174,"_20482":51689,"_5":14053,"_26831":51611,"_2843":51690},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3355":1204,"_29485":1174,"_20482":51692,"_5":14053,"_26831":51611,"_2843":51693},[],"400 `struct validation error` creating or updating a DMS",{"_3355":1205,"_29485":1174,"_20482":51695,"_5":14053,"_26831":51611,"_2843":51696},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3355":1206,"_29485":1174,"_20482":51698,"_5":14053,"_26831":51611,"_2843":51699},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3355":1207,"_29485":1174,"_20482":51701,"_5":14053,"_26831":51611,"_2843":51702},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3355":1208,"_29485":1174,"_20482":51704,"_5":14053,"_26831":51611,"_2843":51705},[],"`device not preregistered`",{"_3355":1209,"_29485":1174,"_20482":51707,"_5":14053,"_26831":51611,"_2843":51708},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3355":1210,"_29485":1174,"_20482":51710,"_5":14053,"_26831":51611,"_2843":51711},[],"`forbiddenNewEnrollment`",{"_3355":1211,"_29485":1174,"_20482":51713,"_5":14053,"_26831":51611,"_2843":51714},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3355":1212,"_29485":1174,"_20482":51716,"_5":14053,"_26831":51611,"_2843":51717},[],"Different owning DMS",{"_3355":1213,"_29485":1174,"_20482":51719,"_5":14053,"_26831":51611,"_2843":51720},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3355":1214,"_29485":1174,"_20482":51722,"_5":14053,"_26831":51611,"_2843":51723},[],"`invalid RawSubject bytes`",{"_3355":1215,"_29485":1174,"_20482":51725,"_5":14053,"_26831":51611,"_2843":51726},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3355":1216,"_29485":1174,"_20482":51728,"_5":14053,"_26831":51611,"_2843":51729},[],"`invalid reenroll window`",{"_3355":1217,"_29485":1174,"_20482":51731,"_5":14053,"_26831":51611,"_2843":51732},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3355":1218,"_29485":1174,"_20482":51734,"_5":14053,"_26831":51611,"_2843":51735},[],"Current certificate revoked",{"_3355":1219,"_29485":1174,"_20482":51737,"_5":14053,"_26831":51611,"_2843":51738},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3355":1220,"_29485":1174,"_20482":51740,"_5":14053,"_26831":51611,"_2843":51741},[],"CA, profile or signing error",{"_3355":1221,"_29485":1174,"_20482":51743,"_5":14053,"_26831":51611,"_2843":51744},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3355":1222,"_29485":1174,"_20482":51746,"_5":14053,"_26831":51611,"_2843":51747},[],"HTTP 200 without a device connection",{"_3355":1223,"_29485":1174,"_20482":51749,"_5":14053,"_26831":51611,"_2843":51750},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3355":1224,"_29485":1174,"_20482":51752,"_5":14053,"_26831":51611,"_2843":51753},[],"Timeout or error after issuance",{"_3355":1225,"_29485":1174,"_20482":51755,"_5":14053,"_26831":51611,"_2843":51756},[],"New certificates, current slot and previous identity's state before retrying.",{"_3355":1226,"_29485":1174,"_20482":51758,"_5":14053,"_26831":51615,"_2843":51759},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3355":1227,"_29485":1174,"_20482":51761,"_5":14053,"_26831":51615,"_2843":51762},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3355":1228,"_29485":1174,"_20482":51764,"_5":14053,"_26831":51618,"_2843":51765},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3355":1229,"_29485":1174,"_20482":51767,"_5":14053,"_26831":51618,"_2843":51768},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3355":1230,"_29485":1174,"_20482":51770,"_5":14053,"_26831":51618,"_2843":51771},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3355":1231,"_29485":1174,"_20482":51773,"_5":14053,"_26831":51618,"_2843":51774},[],"Make one request, save headers/body and query the device and certificates.",{"_3355":1232,"_29485":1174,"_20482":51776,"_5":14053,"_26831":51618,"_2843":51777},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3355":1233,"_29485":1174,"_20482":51779,"_5":14053,"_26831":51618,"_2843":51780},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3355":1234,"_29485":1174,"_20482":51782,"_5":14053,"_26831":51618,"_2843":51783},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3355":1235,"_29485":1235,"_5":14411,"_2843":51785,"_29817":51786,"_20482":51787,"_26831":1235},"Trust distribution and updates",[47939,49407,50418,50416,50599],[],{"_3355":1236,"_29485":1235,"_20482":51789,"_5":14053,"_26831":1235,"_2843":51790},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3355":1237,"_29485":1235,"_5":29814,"_20482":51792,"_26831":51793,"_2843":51794},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3355":1238,"_29485":1235,"_5":29814,"_20482":51796,"_26831":51797,"_2843":51798},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3355":1239,"_29485":1235,"_5":29814,"_20482":51800,"_26831":51801,"_2843":51802},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3355":1240,"_29485":1235,"_5":29814,"_20482":51804,"_26831":51805,"_2843":51806},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3355":1241,"_29485":1235,"_5":29814,"_20482":51808,"_26831":51809,"_2843":51810},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3355":1242,"_29485":1235,"_20482":51812,"_5":14053,"_26831":1235,"_2843":51813},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3355":1243,"_29485":1235,"_20482":51815,"_5":14053,"_26831":51793,"_2843":51816},[],"Relationship",{"_3355":1244,"_29485":1235,"_20482":51818,"_5":14053,"_26831":51793,"_2843":51819},[],"Material prepared by its owner",{"_3355":1245,"_29485":1235,"_20482":51821,"_5":14053,"_26831":51793,"_2843":51822},[],"Device → EST server",{"_3355":1246,"_29485":1235,"_20482":51824,"_5":14053,"_26831":51793,"_2843":51825},[],"Previously verified server root, chain or pin and TLS name.",{"_3355":1247,"_29485":1235,"_20482":51827,"_5":14053,"_26831":51793,"_2843":51828},[],"DMS → requester",{"_3355":1248,"_29485":1235,"_20482":51830,"_5":14053,"_26831":51793,"_2843":51831},[],"CAs and rules authorizing initial or renewal credentials.",{"_3355":1249,"_29485":1235,"_20482":51833,"_5":14053,"_26831":51793,"_2843":51834},[],"Consumer → device",{"_3355":1250,"_29485":1235,"_20482":51836,"_5":14053,"_26831":51793,"_2843":51837},[],"Operational identity roots, intermediates, validation and permissions.",{"_3355":1251,"_29485":1235,"_20482":51839,"_5":14053,"_26831":51793,"_2843":51840},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3355":1252,"_29485":1235,"_20482":51842,"_5":14053,"_26831":51797,"_2843":51843},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3355":1253,"_29485":1235,"_20482":51845,"_5":14053,"_26831":51797,"_2843":51846},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3355":1254,"_29485":1235,"_20482":51848,"_5":14053,"_26831":51801,"_2843":51849},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3355":1255,"_29485":1235,"_20482":51851,"_5":14053,"_26831":51801,"_2843":51852},[],"Select policy-approved roots as anchors.",{"_3355":1256,"_29485":1235,"_20482":51854,"_5":14053,"_26831":51801,"_2843":51855},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3355":1257,"_29485":1235,"_20482":51857,"_5":14053,"_26831":51801,"_2843":51858},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3355":1258,"_29485":1235,"_20482":51860,"_5":14053,"_26831":51801,"_2843":51861},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3355":1259,"_29485":1235,"_20482":51863,"_5":14053,"_26831":51801,"_2843":51864},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3355":1260,"_29485":1235,"_20482":51866,"_5":14053,"_26831":51805,"_2843":51867},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3355":1261,"_29485":1235,"_20482":51869,"_5":14053,"_26831":51805,"_2843":51870},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3355":1262,"_29485":1235,"_20482":51872,"_5":14053,"_26831":51805,"_2843":51873},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3355":1263,"_29485":1235,"_20482":51875,"_5":14053,"_26831":51809,"_2843":51876},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3355":1264,"_29485":1264,"_5":14411,"_2843":51878,"_29817":51879,"_20482":51881,"_26831":1264},"AWS IoT Core",[47939,49407,50418,50416,51880],"Integrations",[],{"_3355":1265,"_29485":1264,"_20482":51883,"_5":14053,"_26831":1264,"_2843":51884},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3355":1266,"_29485":1264,"_5":29814,"_20482":51886,"_26831":51887,"_2843":51888},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3355":1267,"_29485":1264,"_5":29814,"_20482":51890,"_26831":51891,"_2843":51892},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3355":1268,"_29485":1264,"_5":29814,"_20482":51894,"_26831":51895,"_2843":51896},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3355":1269,"_29485":1264,"_5":29814,"_20482":51898,"_26831":51899,"_2843":51900},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3355":1270,"_29485":1264,"_5":29814,"_20482":51902,"_26831":51903,"_2843":51904},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3355":1271,"_29485":1264,"_5":29814,"_20482":51906,"_26831":51907,"_2843":51908},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3355":1272,"_29485":1264,"_5":29814,"_20482":51910,"_26831":51911,"_2843":51912},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3355":1273,"_29485":1264,"_5":29814,"_20482":51914,"_26831":51915,"_2843":51916},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3355":1274,"_29485":1264,"_5":29814,"_20482":51918,"_26831":51919,"_2843":51920},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3355":1275,"_29485":1264,"_5":29814,"_20482":51922,"_26831":51923,"_2843":51924},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3355":1276,"_29485":1264,"_5":29814,"_20482":51926,"_26831":51927,"_2843":51928},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3355":1277,"_29485":1264,"_5":29814,"_20482":51930,"_26831":51931,"_2843":51932},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3355":1278,"_29485":1264,"_5":29814,"_20482":51934,"_26831":51935,"_2843":51936},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3355":1279,"_29485":1264,"_5":29814,"_20482":51938,"_26831":51939,"_2843":51940},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3355":1280,"_29485":1264,"_5":29814,"_20482":51942,"_26831":51943,"_2843":51944},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3355":1281,"_29485":1264,"_5":29814,"_20482":51946,"_26831":51947,"_2843":51948},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3355":1282,"_29485":1264,"_5":29814,"_20482":51950,"_26831":51951,"_2843":51952},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3355":1283,"_29485":1264,"_5":29814,"_20482":51954,"_26831":51955,"_2843":51956},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3355":1284,"_29485":1264,"_5":29814,"_20482":51958,"_26831":51959,"_2843":51960},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3355":1285,"_29485":1264,"_5":29814,"_20482":51962,"_26831":51963,"_2843":51964},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3355":1286,"_29485":1264,"_5":29814,"_20482":51966,"_26831":51967,"_2843":51968},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3355":1287,"_29485":1264,"_5":29814,"_20482":51970,"_26831":51971,"_2843":51972},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3355":1288,"_29485":1264,"_5":29814,"_20482":51974,"_26831":51975,"_2843":51976},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3355":1289,"_29485":1264,"_5":29814,"_20482":51978,"_26831":51979,"_2843":51980},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3355":1290,"_29485":1264,"_5":29814,"_20482":51982,"_26831":51983,"_2843":51984},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3355":1291,"_29485":1264,"_5":29814,"_20482":51986,"_26831":51987,"_2843":51988},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3355":1292,"_29485":1264,"_20482":51990,"_5":14053,"_26831":1264,"_2843":51991},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3355":1293,"_29485":1264,"_20482":51993,"_5":14053,"_26831":1264,"_2843":51994},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3355":1294,"_29485":1264,"_20482":51996,"_5":14053,"_26831":1264,"_2843":51997},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3355":1295,"_29485":1264,"_20482":51999,"_5":14053,"_26831":51887,"_2843":52000},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3355":1296,"_29485":1264,"_20482":52002,"_5":14053,"_26831":51887,"_2843":52003},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3355":1297,"_29485":1264,"_20482":52005,"_5":14053,"_26831":51887,"_2843":52006},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3355":1298,"_29485":1264,"_20482":52008,"_5":14053,"_26831":51887,"_2843":52009},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3355":1299,"_29485":1264,"_20482":52011,"_5":14053,"_26831":51891,"_2843":52012},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3355":1300,"_29485":1264,"_20482":52014,"_5":14053,"_26831":51895,"_2843":52015},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3355":1301,"_29485":1264,"_20482":52017,"_5":14053,"_26831":51895,"_2843":52018},[],"IAM action",{"_3355":1302,"_29485":1264,"_20482":52020,"_5":14053,"_26831":51895,"_2843":48329},[],{"_3355":1303,"_29485":1264,"_20482":52022,"_5":14053,"_26831":51895,"_2843":52023},[],"`iot:GetRegistrationCode`",{"_3355":1304,"_29485":1264,"_20482":52025,"_5":14053,"_26831":51895,"_2843":52026},[],"Obtain the verification code for CA registration in the Primary Account",{"_3355":1305,"_29485":1264,"_20482":52028,"_5":14053,"_26831":51895,"_2843":52029},[],"`iot:RegisterCACertificate`",{"_3355":1306,"_29485":1264,"_20482":52031,"_5":14053,"_26831":51895,"_2843":52032},[],"Register the CA in AWS IoT",{"_3355":1307,"_29485":1264,"_20482":52034,"_5":14053,"_26831":51895,"_2843":52035},[],"`iot:DescribeCACertificate`",{"_3355":1308,"_29485":1264,"_20482":52037,"_5":14053,"_26831":51895,"_2843":52038},[],"Check the CA registration status",{"_3355":1309,"_29485":1264,"_20482":52040,"_5":14053,"_26831":51895,"_2843":52041},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3355":1310,"_29485":1264,"_20482":52043,"_5":14053,"_26831":51895,"_2843":52044},[],"Create or update Things in IoT Core",{"_3355":1311,"_29485":1264,"_20482":52046,"_5":14053,"_26831":51895,"_2843":52047},[],"`iot:RegisterThing`",{"_3355":1312,"_29485":1264,"_20482":52049,"_5":14053,"_26831":51895,"_2843":52050},[],"Provision Things through a template",{"_3355":1313,"_29485":1264,"_20482":52052,"_5":14053,"_26831":51895,"_2843":52053},[],"`iot:RegisterCertificate`",{"_3355":1314,"_29485":1264,"_20482":52055,"_5":14053,"_26831":51895,"_2843":52056},[],"Register device certificates",{"_3355":1315,"_29485":1264,"_20482":52058,"_5":14053,"_26831":51895,"_2843":52059},[],"`iot:UpdateCertificate`",{"_3355":1316,"_29485":1264,"_20482":52061,"_5":14053,"_26831":51895,"_2843":52062},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3355":1317,"_29485":1264,"_20482":52064,"_5":14053,"_26831":51895,"_2843":52065},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3355":1318,"_29485":1264,"_20482":52067,"_5":14053,"_26831":51895,"_2843":52068},[],"Create and attach IoT policies",{"_3355":1319,"_29485":1264,"_20482":52070,"_5":14053,"_26831":51895,"_2843":52071},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3355":1320,"_29485":1264,"_20482":52073,"_5":14053,"_26831":51895,"_2843":52074},[],"Manage Thing groups",{"_3355":1321,"_29485":1264,"_20482":52076,"_5":14053,"_26831":51895,"_2843":52077},[],"`iot:CreateProvisioningTemplate`",{"_3355":1322,"_29485":1264,"_20482":52079,"_5":14053,"_26831":51895,"_2843":52080},[],"Create JITP templates",{"_3355":1323,"_29485":1264,"_20482":52082,"_5":14053,"_26831":51895,"_2843":52083},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3355":1324,"_29485":1264,"_20482":52085,"_5":14053,"_26831":51895,"_2843":52086},[],"Read and write the Device Shadow",{"_3355":1325,"_29485":1264,"_20482":52088,"_5":14053,"_26831":51895,"_2843":52089},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3355":1326,"_29485":1264,"_20482":52091,"_5":14053,"_26831":51899,"_2843":52092},[],"Parameter",{"_3355":1327,"_29485":1264,"_20482":52094,"_5":14053,"_26831":51899,"_2843":52095},[],"Type",{"_3355":1328,"_29485":1264,"_20482":52097,"_5":14053,"_26831":51899,"_2843":52098},[],"Required",{"_3355":1329,"_29485":1264,"_20482":52100,"_5":14053,"_26831":51899,"_2843":52101},[],"Description",{"_3355":1330,"_29485":1264,"_20482":52103,"_5":14053,"_26831":51899,"_2843":52104},[],"`connector_id`",{"_3355":1331,"_29485":1264,"_20482":52106,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1332,"_29485":1264,"_20482":52108,"_5":14053,"_26831":51899,"_2843":52109},[],"Yes",{"_3355":1333,"_29485":1264,"_20482":52111,"_5":14053,"_26831":51899,"_2843":52112},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3355":1334,"_29485":1264,"_20482":52114,"_5":14053,"_26831":51899,"_2843":52115},[],"`aws_config.region`",{"_3355":1335,"_29485":1264,"_20482":52117,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1336,"_29485":1264,"_20482":52119,"_5":14053,"_26831":51899,"_2843":52109},[],{"_3355":1337,"_29485":1264,"_20482":52121,"_5":14053,"_26831":51899,"_2843":52122},[],"AWS region where the connector operates.",{"_3355":1338,"_29485":1264,"_20482":52124,"_5":14053,"_26831":51899,"_2843":52125},[],"`aws_config.auth_method`",{"_3355":1339,"_29485":1264,"_20482":52127,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1340,"_29485":1264,"_20482":52129,"_5":14053,"_26831":51899,"_2843":52109},[],{"_3355":1341,"_29485":1264,"_20482":52131,"_5":14053,"_26831":51899,"_2843":52132},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3355":1342,"_29485":1264,"_20482":52134,"_5":14053,"_26831":51899,"_2843":52135},[],"`aws_config.access_key_id`",{"_3355":1343,"_29485":1264,"_20482":52137,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1344,"_29485":1264,"_20482":52139,"_5":14053,"_26831":51899,"_2843":52140},[],"Only with `auth_method=static`",{"_3355":1345,"_29485":1264,"_20482":52142,"_5":14053,"_26831":51899,"_2843":52143},[],"AWS access key.",{"_3355":1346,"_29485":1264,"_20482":52145,"_5":14053,"_26831":51899,"_2843":52146},[],"`aws_config.secret_access_key`",{"_3355":1347,"_29485":1264,"_20482":52148,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1348,"_29485":1264,"_20482":52150,"_5":14053,"_26831":51899,"_2843":52140},[],{"_3355":1349,"_29485":1264,"_20482":52152,"_5":14053,"_26831":51899,"_2843":52153},[],"AWS secret key.",{"_3355":1350,"_29485":1264,"_20482":52155,"_5":14053,"_26831":51899,"_2843":52156},[],"`aws_config.session_token`",{"_3355":1351,"_29485":1264,"_20482":52158,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1352,"_29485":1264,"_20482":52160,"_5":14053,"_26831":51899,"_2843":52161},[],"No",{"_3355":1353,"_29485":1264,"_20482":52163,"_5":14053,"_26831":51899,"_2843":52164},[],"Session token (with `auth_method=static`).",{"_3355":1354,"_29485":1264,"_20482":52166,"_5":14053,"_26831":51899,"_2843":52167},[],"`aws_config.role_arn`",{"_3355":1355,"_29485":1264,"_20482":52169,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1356,"_29485":1264,"_20482":52171,"_5":14053,"_26831":51899,"_2843":52172},[],"Only with `auth_method=role`",{"_3355":1357,"_29485":1264,"_20482":52174,"_5":14053,"_26831":51899,"_2843":52175},[],"ARN of the role to assume.",{"_3355":1358,"_29485":1264,"_20482":52177,"_5":14053,"_26831":51899,"_2843":52178},[],"`aws_config.endpoint_url`",{"_3355":1359,"_29485":1264,"_20482":52180,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1360,"_29485":1264,"_20482":52182,"_5":14053,"_26831":51899,"_2843":52161},[],{"_3355":1361,"_29485":1264,"_20482":52184,"_5":14053,"_26831":51899,"_2843":52185},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3355":1362,"_29485":1264,"_20482":52187,"_5":14053,"_26831":51899,"_2843":52188},[],"`subscriber_event_bus`",{"_3355":1363,"_29485":1264,"_20482":52190,"_5":14053,"_26831":51899,"_2843":17243},[],{"_3355":1364,"_29485":1264,"_20482":52192,"_5":14053,"_26831":51899,"_2843":52109},[],{"_3355":1365,"_29485":1264,"_20482":52194,"_5":14053,"_26831":51899,"_2843":52195},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3355":1366,"_29485":1264,"_20482":52197,"_5":14053,"_26831":51899,"_2843":52198},[],"`dms_manager_client`",{"_3355":1367,"_29485":1264,"_20482":52200,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1368,"_29485":1264,"_20482":52202,"_5":14053,"_26831":51899,"_2843":52109},[],{"_3355":1369,"_29485":1264,"_20482":52204,"_5":14053,"_26831":51899,"_2843":52205},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3355":1370,"_29485":1264,"_20482":52207,"_5":14053,"_26831":51899,"_2843":52208},[],"`device_manager_client`",{"_3355":1371,"_29485":1264,"_20482":52210,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1372,"_29485":1264,"_20482":52212,"_5":14053,"_26831":51899,"_2843":52109},[],{"_3355":1373,"_29485":1264,"_20482":52214,"_5":14053,"_26831":51899,"_2843":52215},[],"HTTP URL of Lamassu's Device Manager.",{"_3355":1374,"_29485":1264,"_20482":52217,"_5":14053,"_26831":51899,"_2843":52218},[],"`ca_client`",{"_3355":1375,"_29485":1264,"_20482":52220,"_5":14053,"_26831":51899,"_2843":24474},[],{"_3355":1376,"_29485":1264,"_20482":52222,"_5":14053,"_26831":51899,"_2843":52109},[],{"_3355":1377,"_29485":1264,"_20482":52224,"_5":14053,"_26831":51899,"_2843":52225},[],"HTTP URL of Lamassu's CA service.",{"_3355":1378,"_29485":1264,"_20482":52227,"_5":14053,"_26831":51903,"_2843":52228},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3355":1379,"_29485":1264,"_20482":52230,"_5":14053,"_26831":51907,"_2843":52231},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3355":1380,"_29485":1264,"_20482":52233,"_5":14053,"_26831":51907,"_2843":52234},[],"CloudEvent type",{"_3355":1381,"_29485":1264,"_20482":52236,"_5":14053,"_26831":51907,"_2843":52237},[],"Lamassu resource",{"_3355":1382,"_29485":1264,"_20482":52239,"_5":14053,"_26831":51907,"_2843":52240},[],"AWS Resource",{"_3355":1383,"_29485":1264,"_20482":52242,"_5":14053,"_26831":51907,"_2843":52243},[],"IAM actions",{"_3355":1384,"_29485":1264,"_20482":52245,"_5":14053,"_26831":51907,"_2843":52246},[],"AWS calls and effect",{"_3355":1385,"_29485":1264,"_20482":52248,"_5":14053,"_26831":51907,"_2843":52249},[],"Where in this page",{"_3355":1386,"_29485":1264,"_20482":52251,"_5":14053,"_26831":51907,"_2843":52252},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3355":1387,"_29485":1264,"_20482":52254,"_5":14053,"_26831":51907,"_2843":52255},[],"CA",{"_3355":1388,"_29485":1264,"_20482":52257,"_5":14053,"_26831":51907,"_2843":52258},[],"`IoTCore/CACertificate`",{"_3355":1389,"_29485":1264,"_20482":52260,"_5":14053,"_26831":51907,"_2843":52261},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3355":1390,"_29485":1264,"_20482":52263,"_5":14053,"_26831":51907,"_2843":52264},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3355":1391,"_29485":1264,"_20482":52266,"_5":14053,"_26831":51907,"_2843":51912},[],{"_3355":1392,"_29485":1264,"_20482":52268,"_5":14053,"_26831":51907,"_2843":52269},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3355":1393,"_29485":1264,"_20482":52271,"_5":14053,"_26831":51907,"_2843":52272},[],"DMS",{"_3355":1394,"_29485":1264,"_20482":52274,"_5":14053,"_26831":51907,"_2843":52275},[],"`IoTCore/ProvisioningTemplate`",{"_3355":1395,"_29485":1264,"_20482":52277,"_5":14053,"_26831":51907,"_2843":52278},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3355":1396,"_29485":1264,"_20482":52280,"_5":14053,"_26831":51907,"_2843":52281},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3355":1397,"_29485":1264,"_20482":52283,"_5":14053,"_26831":51907,"_2843":51916},[],{"_3355":1398,"_29485":1264,"_20482":52285,"_5":14053,"_26831":51907,"_2843":52286},[],"`EventBindDeviceIdentityKey`",{"_3355":1399,"_29485":1264,"_20482":52288,"_5":14053,"_26831":51907,"_2843":52289},[],"Device",{"_3355":1400,"_29485":1264,"_20482":52291,"_5":14053,"_26831":51907,"_2843":52292},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3355":1401,"_29485":1264,"_20482":52294,"_5":14053,"_26831":51907,"_2843":52295},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3355":1402,"_29485":1264,"_20482":52297,"_5":14053,"_26831":51907,"_2843":52298},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3355":1403,"_29485":1264,"_20482":52300,"_5":14053,"_26831":51907,"_2843":51924},[],{"_3355":1404,"_29485":1264,"_20482":52302,"_5":14053,"_26831":51907,"_2843":52303},[],"`EventUpdateCertificateStatusKey`",{"_3355":1405,"_29485":1264,"_20482":52305,"_5":14053,"_26831":51907,"_2843":52306},[],"Certificate",{"_3355":1406,"_29485":1264,"_20482":52308,"_5":14053,"_26831":51907,"_2843":52309},[],"`IoTCore/Certificate`",{"_3355":1407,"_29485":1264,"_20482":52311,"_5":14053,"_26831":51907,"_2843":52312},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3355":1408,"_29485":1264,"_20482":52314,"_5":14053,"_26831":51907,"_2843":52315},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3355":1409,"_29485":1264,"_20482":52317,"_5":14053,"_26831":51907,"_2843":51920},[],{"_3355":1410,"_29485":1264,"_20482":52319,"_5":14053,"_26831":51907,"_2843":52320},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3355":1411,"_29485":1264,"_20482":52322,"_5":14053,"_26831":51907,"_2843":52323},[],"Certificate / Device",{"_3355":1412,"_29485":1264,"_20482":52325,"_5":14053,"_26831":51907,"_2843":52326},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3355":1413,"_29485":1264,"_20482":52328,"_5":14053,"_26831":51907,"_2843":48335},[],{"_3355":1414,"_29485":1264,"_20482":52330,"_5":14053,"_26831":51907,"_2843":52331},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3355":1415,"_29485":1264,"_20482":52333,"_5":14053,"_26831":51907,"_2843":51976},[],{"_3355":1416,"_29485":1264,"_20482":52335,"_5":14053,"_26831":51911,"_2843":52336},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3355":1417,"_29485":1264,"_20482":52338,"_5":14053,"_26831":51911,"_2843":52339},[],"by the `registration.status` field of the CA's connector metadata:",{"_3355":1418,"_29485":1264,"_20482":52341,"_5":14053,"_26831":51911,"_2843":52342},[],"Transition",{"_3355":1419,"_29485":1264,"_20482":52344,"_5":14053,"_26831":51911,"_2843":52345},[],"AWS calls",{"_3355":1420,"_29485":1264,"_20482":52347,"_5":14053,"_26831":51911,"_2843":52348},[],"`NotRegistered` → `Requested`",{"_3355":1421,"_29485":1264,"_20482":52350,"_5":14053,"_26831":51911,"_2843":52351},[],"none (metadata write only)",{"_3355":1422,"_29485":1264,"_20482":52353,"_5":14053,"_26831":51911,"_2843":52354},[],"`Requested` → `Registering`",{"_3355":1423,"_29485":1264,"_20482":52356,"_5":14053,"_26831":51911,"_2843":52357},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3355":1424,"_29485":1264,"_20482":52359,"_5":14053,"_26831":51911,"_2843":52360},[],"`Registering` → `Succeeded`",{"_3355":1425,"_29485":1264,"_20482":52362,"_5":14053,"_26831":51911,"_2843":52363},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3355":1426,"_29485":1264,"_20482":52365,"_5":14053,"_26831":51911,"_2843":52366},[],"`Registering` → `Failed`",{"_3355":1427,"_29485":1264,"_20482":52368,"_5":14053,"_26831":51911,"_2843":52369},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3355":1428,"_29485":1264,"_20482":52371,"_5":14053,"_26831":51911,"_2843":52372},[],"`Failed` / `Succeeded` → `Requested`",{"_3355":1429,"_29485":1264,"_20482":52374,"_5":14053,"_26831":51911,"_2843":52375},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3355":1430,"_29485":1264,"_20482":52377,"_5":14053,"_26831":51915,"_2843":52378},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3355":1431,"_29485":1264,"_20482":52380,"_5":14053,"_26831":51915,"_2843":52342},[],{"_3355":1432,"_29485":1264,"_20482":52382,"_5":14053,"_26831":51915,"_2843":52345},[],{"_3355":1433,"_29485":1264,"_20482":52384,"_5":14053,"_26831":51915,"_2843":52385},[],"`Unconfigured` → `None` / `Auto`",{"_3355":1434,"_29485":1264,"_20482":52387,"_5":14053,"_26831":51915,"_2843":52388},[],"none (configuration only)",{"_3355":1435,"_29485":1264,"_20482":52390,"_5":14053,"_26831":51915,"_2843":52391},[],"`None` ↔ `Auto`",{"_3355":1436,"_29485":1264,"_20482":52393,"_5":14053,"_26831":51915,"_2843":52388},[],{"_3355":1437,"_29485":1264,"_20482":52395,"_5":14053,"_26831":51915,"_2843":52396},[],"Any → `Jitp`",{"_3355":1438,"_29485":1264,"_20482":52398,"_5":14053,"_26831":51915,"_2843":52399},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3355":1439,"_29485":1264,"_20482":52401,"_5":14053,"_26831":51915,"_2843":52402},[],"`Jitp` → `None` / `Auto`",{"_3355":1440,"_29485":1264,"_20482":52404,"_5":14053,"_26831":51915,"_2843":52405},[],"none (the template stays in the AWS account)",{"_3355":1441,"_29485":1264,"_20482":52407,"_5":14053,"_26831":51919,"_2843":52408},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3355":1442,"_29485":1264,"_20482":52410,"_5":14053,"_26831":51919,"_2843":52342},[],{"_3355":1443,"_29485":1264,"_20482":52412,"_5":14053,"_26831":51919,"_2843":52345},[],{"_3355":1444,"_29485":1264,"_20482":52414,"_5":14053,"_26831":51919,"_2843":52415},[],"`NotSynced` → `Active`",{"_3355":1445,"_29485":1264,"_20482":52417,"_5":14053,"_26831":51919,"_2843":52059},[],{"_3355":1446,"_29485":1264,"_20482":52419,"_5":14053,"_26831":51919,"_2843":52420},[],"`Active` → `Inactive`",{"_3355":1447,"_29485":1264,"_20482":52422,"_5":14053,"_26831":51919,"_2843":52423},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3355":1448,"_29485":1264,"_20482":52425,"_5":14053,"_26831":51919,"_2843":52426},[],"`Active` → `Revoked`",{"_3355":1449,"_29485":1264,"_20482":52428,"_5":14053,"_26831":51919,"_2843":52423},[],{"_3355":1450,"_29485":1264,"_20482":52430,"_5":14053,"_26831":51919,"_2843":52431},[],"`Inactive` / `Revoked` → `Active`",{"_3355":1451,"_29485":1264,"_20482":52433,"_5":14053,"_26831":51919,"_2843":52059},[],{"_3355":1452,"_29485":1264,"_20482":52435,"_5":14053,"_26831":51919,"_2843":52436},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3355":1453,"_29485":1264,"_20482":52438,"_5":14053,"_26831":51919,"_2843":52439},[],"none (these states are not synced to AWS)",{"_3355":1454,"_29485":1264,"_20482":52441,"_5":14053,"_26831":51923,"_2843":52442},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3355":1455,"_29485":1264,"_20482":52444,"_5":14053,"_26831":51923,"_2843":52342},[],{"_3355":1456,"_29485":1264,"_20482":52446,"_5":14053,"_26831":51923,"_2843":52345},[],{"_3355":1457,"_29485":1264,"_20482":52448,"_5":14053,"_26831":51923,"_2843":52449},[],"`Absent` → `Provisioned`",{"_3355":1458,"_29485":1264,"_20482":52451,"_5":14053,"_26831":51923,"_2843":52452},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3355":1459,"_29485":1264,"_20482":52454,"_5":14053,"_26831":51923,"_2843":52455},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3355":1460,"_29485":1264,"_20482":52457,"_5":14053,"_26831":51923,"_2843":52458},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3355":1461,"_29485":1264,"_20482":52460,"_5":14053,"_26831":51923,"_2843":52461},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3355":1462,"_29485":1264,"_20482":52463,"_5":14053,"_26831":51927,"_2843":52464},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3355":1463,"_29485":1264,"_20482":52466,"_5":14053,"_26831":51931,"_2843":52467},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3355":1464,"_29485":1264,"_20482":52469,"_5":14053,"_26831":51931,"_2843":52470},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3355":1465,"_29485":1264,"_20482":52472,"_5":14053,"_26831":51935,"_2843":52473},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3355":1466,"_29485":1264,"_20482":52475,"_5":14053,"_26831":51935,"_2843":52476},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3355":1467,"_29485":1264,"_20482":52478,"_5":14053,"_26831":51935,"_2843":52479},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3355":1468,"_29485":1264,"_20482":52481,"_5":14053,"_26831":51935,"_2843":52482},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3355":1469,"_29485":1264,"_20482":52484,"_5":14053,"_26831":51935,"_2843":52485},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3355":1470,"_29485":1264,"_20482":52487,"_5":14053,"_26831":51935,"_2843":52488},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3355":1471,"_29485":1264,"_20482":52490,"_5":14053,"_26831":51939,"_2843":52491},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3355":1472,"_29485":1264,"_20482":52493,"_5":14053,"_26831":51943,"_2843":52494},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3355":1473,"_29485":1264,"_20482":52496,"_5":14053,"_26831":51943,"_2843":52497},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3355":1474,"_29485":1264,"_20482":52499,"_5":14053,"_26831":51947,"_2843":52500},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3355":1475,"_29485":1264,"_20482":52502,"_5":14053,"_26831":51951,"_2843":52503},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3355":1476,"_29485":1264,"_20482":52505,"_5":14053,"_26831":51951,"_2843":52506},[],"Creates or updates the IoT policies configured in the DMS.",{"_3355":1477,"_29485":1264,"_20482":52508,"_5":14053,"_26831":51951,"_2843":52509},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3355":1478,"_29485":1264,"_20482":52511,"_5":14053,"_26831":51951,"_2843":52512},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3355":1479,"_29485":1264,"_20482":52514,"_5":14053,"_26831":51951,"_2843":52515},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3355":1480,"_29485":1264,"_20482":52517,"_5":14053,"_26831":51951,"_2843":52518},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3355":1481,"_29485":1264,"_20482":52520,"_5":14053,"_26831":51951,"_2843":52521},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3355":1482,"_29485":1264,"_20482":52523,"_5":14053,"_26831":51955,"_2843":52524},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3355":1483,"_29485":1264,"_20482":52526,"_5":14053,"_26831":51955,"_2843":52527},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3355":1484,"_29485":1264,"_20482":52529,"_5":14053,"_26831":51955,"_2843":52530},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3355":1485,"_29485":1264,"_20482":52532,"_5":14053,"_26831":51955,"_2843":52533},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3355":1486,"_29485":1264,"_20482":52535,"_5":14053,"_26831":51955,"_2843":52536},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3355":1487,"_29485":1264,"_20482":52538,"_5":14053,"_26831":51959,"_2843":52539},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3355":1488,"_29485":1264,"_20482":52541,"_5":14053,"_26831":51959,"_2843":52542},[],"The full flow from the device's perspective is:",{"_3355":1489,"_29485":1264,"_20482":52544,"_5":14053,"_26831":51959,"_2843":52545},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3355":1490,"_29485":1264,"_20482":52547,"_5":14053,"_26831":51963,"_2843":52548},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3355":1491,"_29485":1264,"_20482":52550,"_5":14053,"_26831":51963,"_2843":52551},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3355":1492,"_29485":1264,"_20482":52553,"_5":14053,"_26831":51963,"_2843":52554},[],"For the JITP flow to work correctly:",{"_3355":1493,"_29485":1264,"_20482":52556,"_5":14053,"_26831":51963,"_2843":52557},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3355":1494,"_29485":1264,"_20482":52559,"_5":14053,"_26831":51963,"_2843":52560},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3355":1495,"_29485":1264,"_20482":52562,"_5":14053,"_26831":51963,"_2843":52563},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3355":1496,"_29485":1264,"_20482":52565,"_5":14053,"_26831":51963,"_2843":52566},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3355":1497,"_29485":1264,"_20482":52568,"_5":14053,"_26831":51967,"_2843":52569},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3355":1498,"_29485":1264,"_20482":52571,"_5":14053,"_26831":51967,"_2843":52572},[],"Status in Lamassu",{"_3355":1499,"_29485":1264,"_20482":52574,"_5":14053,"_26831":51967,"_2843":52575},[],"Revocation reason",{"_3355":1500,"_29485":1264,"_20482":52577,"_5":14053,"_26831":51967,"_2843":52578},[],"Status in AWS IoT Core",{"_3355":1501,"_29485":1264,"_20482":52580,"_5":14053,"_26831":51967,"_2843":52581},[],"`Active`",{"_3355":1502,"_29485":1264,"_20482":52583,"_5":14053,"_26831":51967,"_2843":52584},[],"None",{"_3355":1503,"_29485":1264,"_20482":52586,"_5":14053,"_26831":51967,"_2843":52587},[],"`ACTIVE`",{"_3355":1504,"_29485":1264,"_20482":52589,"_5":14053,"_26831":51967,"_2843":52590},[],"`Revoked`",{"_3355":1505,"_29485":1264,"_20482":52592,"_5":14053,"_26831":51967,"_2843":52593},[],"`certificateHold`",{"_3355":1506,"_29485":1264,"_20482":52595,"_5":14053,"_26831":51967,"_2843":52596},[],"`INACTIVE`",{"_3355":1507,"_29485":1264,"_20482":52598,"_5":14053,"_26831":51967,"_2843":52590},[],{"_3355":1508,"_29485":1264,"_20482":52600,"_5":14053,"_26831":51967,"_2843":52601},[],"Any other reason",{"_3355":1509,"_29485":1264,"_20482":52603,"_5":14053,"_26831":51967,"_2843":52604},[],"`REVOKED`",{"_3355":1510,"_29485":1264,"_20482":52606,"_5":14053,"_26831":51967,"_2843":52607},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3355":1511,"_29485":1264,"_20482":52609,"_5":14053,"_26831":51971,"_2843":52610},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3355":1512,"_29485":1264,"_20482":52612,"_5":14053,"_26831":51971,"_2843":52613},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3355":1513,"_29485":1264,"_20482":52615,"_5":14053,"_26831":51971,"_2843":52616},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3355":1514,"_29485":1264,"_20482":52618,"_5":14053,"_26831":51975,"_2843":52619},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3355":1515,"_29485":1264,"_20482":52621,"_5":14053,"_26831":51975,"_2843":52622},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3355":1516,"_29485":1264,"_20482":52624,"_5":14053,"_26831":51979,"_2843":52625},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3355":1517,"_29485":1264,"_20482":52627,"_5":14053,"_26831":51979,"_2843":52628},[],"There are two action types:",{"_3355":1518,"_29485":1264,"_20482":52630,"_5":14053,"_26831":51979,"_2843":52631},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3355":1519,"_29485":1264,"_20482":52633,"_5":14053,"_26831":51979,"_2843":52634},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3355":1520,"_29485":1264,"_20482":52636,"_5":14053,"_26831":51979,"_2843":52637},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3355":1521,"_29485":1264,"_20482":52639,"_5":14053,"_26831":51983,"_2843":52640},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3355":1522,"_29485":1264,"_20482":52642,"_5":14053,"_26831":51983,"_2843":52643},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3355":1523,"_29485":1264,"_20482":52645,"_5":14053,"_26831":51983,"_2843":52646},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3355":1524,"_29485":1264,"_20482":52648,"_5":14053,"_26831":51987,"_2843":52649},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3355":1525,"_29485":1264,"_20482":52651,"_5":14053,"_26831":51987,"_2843":52652},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3355":1526,"_29485":1264,"_20482":52654,"_5":14053,"_26831":51987,"_2843":52655},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3355":1527,"_29485":1264,"_20482":52657,"_5":14053,"_26831":51987,"_2843":52658},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3355":1528,"_29485":1264,"_20482":52660,"_5":14053,"_26831":51987,"_2843":52661},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3355":1529,"_29485":1264,"_20482":52663,"_5":14053,"_26831":51987,"_2843":52664},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3355":1530,"_29485":1264,"_20482":52666,"_5":14053,"_26831":51987,"_2843":52667},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3355":1531,"_29485":1264,"_20482":52669,"_5":14053,"_26831":51987,"_2843":52670},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3355":1532,"_29485":1264,"_20482":52672,"_5":14053,"_26831":51987,"_2843":52673},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3355":1533,"_29485":1264,"_20482":52675,"_5":14053,"_26831":51987,"_2843":52676},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3355":1534,"_29485":1264,"_20482":52678,"_5":14053,"_26831":51987,"_2843":52679},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3355":1535,"_29485":1264,"_20482":52681,"_5":14053,"_26831":51987,"_2843":52682},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3355":1536,"_29485":1264,"_20482":52684,"_5":14053,"_26831":51987,"_2843":52685},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3355":1537,"_29485":1264,"_20482":52687,"_5":14053,"_26831":51987,"_2843":52688},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3355":1538,"_29485":1264,"_20482":52690,"_5":14053,"_26831":51987,"_2843":52691},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3355":1539,"_29485":1264,"_20482":52693,"_5":14053,"_26831":51987,"_2843":52694},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3355":1540,"_29485":1264,"_20482":52696,"_5":14053,"_26831":51987,"_2843":52697},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3355":1541,"_29485":1264,"_20482":52699,"_5":14053,"_26831":51987,"_2843":52700},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3355":1542,"_29485":1264,"_20482":52702,"_5":14053,"_26831":51987,"_2843":52703},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3355":1543,"_29485":1264,"_20482":52705,"_5":14053,"_26831":51987,"_2843":52706},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3355":1544,"_29485":1264,"_20482":52708,"_5":14053,"_26831":51987,"_2843":52709},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3355":1545,"_29485":1264,"_20482":52711,"_5":14053,"_26831":51987,"_2843":52712},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3355":1546,"_29485":1264,"_20482":52714,"_5":14053,"_26831":51987,"_2843":52715},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3355":1547,"_29485":1264,"_20482":52717,"_5":14053,"_26831":51987,"_2843":52718},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3355":1548,"_29485":1548,"_5":14411,"_2843":50418,"_29817":52720,"_20482":52721,"_26831":1548},[47939,49407,50418],[],{"_3355":1549,"_29485":1548,"_20482":52723,"_5":14053,"_26831":1548,"_2843":52724},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3355":1550,"_29485":1548,"_5":29814,"_20482":52726,"_26831":52727,"_2843":52728},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3355":1551,"_29485":1548,"_5":29814,"_20482":52730,"_26831":52731,"_2843":50416},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3355":1552,"_29485":1548,"_5":29814,"_20482":52733,"_26831":52734,"_2843":50599},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3355":1553,"_29485":1548,"_5":29814,"_20482":52736,"_26831":52737,"_2843":51880},[],"/docs/platform/iot-fleets/overview#integrations",{"_3355":1554,"_29485":1548,"_5":29814,"_20482":52739,"_26831":52740,"_2843":52741},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3355":1555,"_29485":1548,"_20482":52743,"_5":14053,"_26831":1548,"_2843":52744},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3355":1556,"_29485":1548,"_20482":52746,"_5":14053,"_26831":52727,"_2843":52747},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3355":1557,"_29485":1548,"_20482":52749,"_5":14053,"_26831":52727,"_2843":52750},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3355":1558,"_29485":1548,"_20482":52752,"_5":14053,"_26831":52731,"_2843":52753},[],"Resource",{"_3355":1559,"_29485":1548,"_20482":52755,"_5":14053,"_26831":52731,"_2843":52756},[],"What it represents",{"_3355":1560,"_29485":1548,"_20482":52758,"_5":14053,"_26831":52731,"_2843":52759},[],"**Device**",{"_3355":1561,"_29485":1548,"_20482":52761,"_5":14053,"_26831":52731,"_2843":52762},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3355":1562,"_29485":1548,"_20482":52764,"_5":14053,"_26831":52731,"_2843":52765},[],"**Identity**",{"_3355":1563,"_29485":1548,"_20482":52767,"_5":14053,"_26831":52731,"_2843":52768},[],"The device's association with its certificates: an active version and a history.",{"_3355":1564,"_29485":1548,"_20482":52770,"_5":14053,"_26831":52731,"_2843":52771},[],"**DMS**",{"_3355":1565,"_29485":1548,"_20482":52773,"_5":14053,"_26831":52731,"_2843":52774},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3355":1566,"_29485":1548,"_20482":52776,"_5":14053,"_26831":52731,"_2843":52777},[],"**Fleet**",{"_3355":1567,"_29485":1548,"_20482":52779,"_5":14053,"_26831":52731,"_2843":52780},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3355":1568,"_29485":1548,"_20482":52782,"_5":14053,"_26831":52731,"_2843":52783},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3355":1569,"_29485":1548,"_20482":52785,"_5":14053,"_26831":52731,"_2843":52786},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3355":1570,"_29485":1548,"_20482":52788,"_5":14053,"_26831":52734,"_2843":52789},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3355":1571,"_29485":1548,"_20482":52791,"_5":14053,"_26831":52734,"_2843":52792},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3355":1572,"_29485":1548,"_20482":52794,"_5":14053,"_26831":52734,"_2843":52795},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3355":1573,"_29485":1548,"_20482":52797,"_5":14053,"_26831":52734,"_2843":52798},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3355":1574,"_29485":1548,"_20482":52800,"_5":14053,"_26831":52734,"_2843":52801},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3355":1575,"_29485":1548,"_20482":52803,"_5":14053,"_26831":52734,"_2843":52804},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3355":1576,"_29485":1548,"_20482":52806,"_5":14053,"_26831":52734,"_2843":52807},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3355":1577,"_29485":1548,"_20482":52809,"_5":14053,"_26831":52734,"_2843":52810},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3355":1578,"_29485":1548,"_20482":52812,"_5":14053,"_26831":52737,"_2843":52813},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3355":1579,"_29485":1548,"_20482":52815,"_5":14053,"_26831":52737,"_2843":52816},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3355":1580,"_29485":1548,"_20482":52818,"_5":14053,"_26831":52740,"_2843":52819},[],"Participant",{"_3355":1581,"_29485":1548,"_20482":52821,"_5":14053,"_26831":52740,"_2843":52822},[],"Responsibility",{"_3355":1582,"_29485":1548,"_20482":52824,"_5":14053,"_26831":52740,"_2843":52825},[],"PKI administrator",{"_3355":1583,"_29485":1548,"_20482":52827,"_5":14053,"_26831":52740,"_2843":52828},[],"CA, issuance profile, chain and revocation publication.",{"_3355":1584,"_29485":1548,"_20482":52830,"_5":14053,"_26831":52740,"_2843":52831},[],"Provisioning administrator",{"_3355":1585,"_29485":1548,"_20482":52833,"_5":14053,"_26831":52740,"_2843":52834},[],"DMS, admission, authentication per operation and inventory.",{"_3355":1586,"_29485":1548,"_20482":52836,"_5":14053,"_26831":52740,"_2843":52837},[],"Device integrator",{"_3355":1587,"_29485":1548,"_20482":52839,"_5":14053,"_26831":52740,"_2843":52840},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3355":1588,"_29485":1548,"_20482":52842,"_5":14053,"_26831":52740,"_2843":52843},[],"Consumer integrator",{"_3355":1589,"_29485":1548,"_20482":52845,"_5":14053,"_26831":52740,"_2843":52846},[],"Trusted issuers, validation and device permissions in the destination.",{"_3355":1590,"_29485":1548,"_20482":52848,"_5":14053,"_26831":52740,"_2843":52849},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3355":1591,"_29485":1591,"_5":14411,"_2843":52851,"_29817":52852,"_20482":52854,"_26831":1591},"Enroll and connect your first device",[47939,49407,50418,52853],"Getting started",[],{"_3355":1592,"_29485":1591,"_20482":52856,"_5":14053,"_26831":1591,"_2843":52857},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3355":1593,"_29485":1591,"_5":29814,"_20482":52859,"_26831":52860,"_2843":47949},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3355":1594,"_29485":1591,"_5":29814,"_20482":52862,"_26831":52863,"_2843":52864},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3355":1595,"_29485":1591,"_5":29814,"_20482":52866,"_26831":52867,"_2843":52868},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3355":1596,"_29485":1591,"_5":29814,"_20482":52870,"_26831":52871,"_2843":52872},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3355":1597,"_29485":1591,"_5":29814,"_20482":52874,"_26831":52875,"_2843":52876},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3355":1598,"_29485":1591,"_5":29814,"_20482":52878,"_26831":52879,"_2843":52880},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3355":1599,"_29485":1591,"_5":29814,"_20482":52882,"_26831":52883,"_2843":52884},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3355":1600,"_29485":1591,"_5":29814,"_20482":52886,"_26831":52887,"_2843":52888},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3355":1601,"_29485":1591,"_20482":52890,"_5":14053,"_26831":1591,"_2843":52891},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3355":1602,"_29485":1591,"_20482":52893,"_5":14053,"_26831":52860,"_2843":52894},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3355":1603,"_29485":1591,"_20482":52896,"_5":14053,"_26831":52860,"_2843":52897},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3355":1604,"_29485":1591,"_20482":52899,"_5":14053,"_26831":52860,"_2843":52900},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3355":1605,"_29485":1591,"_20482":52902,"_5":14053,"_26831":52860,"_2843":52903},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3355":1606,"_29485":1591,"_20482":52905,"_5":14053,"_26831":52860,"_2843":52906},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3355":1607,"_29485":1591,"_20482":52908,"_5":14053,"_26831":52863,"_2843":52909},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3355":1608,"_29485":1591,"_20482":52911,"_5":14053,"_26831":52863,"_2843":52912},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3355":1609,"_29485":1591,"_20482":52914,"_5":14053,"_26831":52867,"_2843":52915},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3355":1610,"_29485":1591,"_20482":52917,"_5":14053,"_26831":52867,"_2843":52918},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3355":1611,"_29485":1591,"_20482":52920,"_5":14053,"_26831":52867,"_2843":52921},[],"Setting",{"_3355":1612,"_29485":1591,"_20482":52923,"_5":14053,"_26831":52867,"_2843":52924},[],"Evaluation value",{"_3355":1613,"_29485":1591,"_20482":52926,"_5":14053,"_26831":52867,"_2843":52927},[],"Enrollment CA",{"_3355":1614,"_29485":1591,"_20482":52929,"_5":14053,"_26831":52867,"_2843":52930},[],"Issuing root from `device-root.pem`.",{"_3355":1615,"_29485":1591,"_20482":52932,"_5":14053,"_26831":52867,"_2843":50729},[],{"_3355":1616,"_29485":1591,"_20482":52934,"_5":14053,"_26831":52867,"_2843":52935},[],"The 1-hour leaf profile you just prepared.",{"_3355":1617,"_29485":1591,"_20482":52937,"_5":14053,"_26831":52867,"_2843":52938},[],"Protocol / Registration Mode",{"_3355":1618,"_29485":1591,"_20482":52940,"_5":14053,"_26831":52867,"_2843":52941},[],"`EST_RFC7030` / `JITP`.",{"_3355":1619,"_29485":1591,"_20482":52943,"_5":14053,"_26831":52867,"_2843":52944},[],"Verify CSR Signature",{"_3355":1620,"_29485":1591,"_20482":52946,"_5":14053,"_26831":52867,"_2843":52947},[],"Enabled.",{"_3355":1621,"_29485":1591,"_20482":52949,"_5":14053,"_26831":52867,"_2843":52950},[],"Enable Replaceable Enrollment",{"_3355":1622,"_29485":1591,"_20482":52952,"_5":14053,"_26831":52867,"_2843":52953},[],"Disabled; the ID must be new.",{"_3355":1623,"_29485":1591,"_20482":52955,"_5":14053,"_26831":52867,"_2843":52956},[],"Initial authentication",{"_3355":1624,"_29485":1591,"_20482":52958,"_5":14053,"_26831":52867,"_2843":52959},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3355":1625,"_29485":1591,"_20482":52961,"_5":14053,"_26831":52867,"_2843":52962},[],"Renewal authentication",{"_3355":1626,"_29485":1591,"_20482":52964,"_5":14053,"_26831":52867,"_2843":52965},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3355":1627,"_29485":1591,"_20482":52967,"_5":14053,"_26831":52867,"_2843":52968},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3355":1628,"_29485":1591,"_20482":52970,"_5":14053,"_26831":52867,"_2843":52971},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3355":1629,"_29485":1591,"_20482":52973,"_5":14053,"_26831":52867,"_2843":52974},[],"Re-enrollment Delta",{"_3355":1630,"_29485":1591,"_20482":52976,"_5":14053,"_26831":52867,"_2843":52977},[],"1 hour.",{"_3355":1631,"_29485":1591,"_20482":52979,"_5":14053,"_26831":52867,"_2843":52980},[],"Preventive / Critical Delta",{"_3355":1632,"_29485":1591,"_20482":52982,"_5":14053,"_26831":52867,"_2843":52983},[],"30 minutes / 10 minutes.",{"_3355":1633,"_29485":1591,"_20482":52985,"_5":14053,"_26831":52867,"_2843":52986},[],"Revoke on Re-enrollment",{"_3355":1634,"_29485":1591,"_20482":52988,"_5":14053,"_26831":52867,"_2843":52989},[],"Disabled to test the successor before retiring the previous identity.",{"_3355":1635,"_29485":1591,"_20482":52991,"_5":14053,"_26831":52867,"_2843":50737},[],{"_3355":1636,"_29485":1591,"_20482":52993,"_5":14053,"_26831":52867,"_2843":52994},[],"Disabled; the operational key is generated in the client.",{"_3355":1637,"_29485":1591,"_20482":52996,"_5":14053,"_26831":52867,"_2843":52997},[],"CA Distribution",{"_3355":1638,"_29485":1591,"_20482":52999,"_5":14053,"_26831":52867,"_2843":53000},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3355":1639,"_29485":1591,"_20482":53002,"_5":14053,"_26831":52867,"_2843":53003},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3355":1640,"_29485":1591,"_20482":53005,"_5":14053,"_26831":52871,"_2843":53006},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3355":1641,"_29485":1591,"_20482":53008,"_5":14053,"_26831":52871,"_2843":53009},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3355":1642,"_29485":1591,"_20482":53011,"_5":14053,"_26831":52875,"_2843":53012},[],"Generate a new key and CSR with the selected identifier:",{"_3355":1643,"_29485":1591,"_20482":53014,"_5":14053,"_26831":52875,"_2843":53015},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3355":1644,"_29485":1591,"_20482":53017,"_5":14053,"_26831":52875,"_2843":53018},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3355":1645,"_29485":1591,"_20482":53020,"_5":14053,"_26831":52879,"_2843":53021},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3355":1646,"_29485":1591,"_20482":53023,"_5":14053,"_26831":52879,"_2843":53024},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3355":1647,"_29485":1591,"_20482":53026,"_5":14053,"_26831":52883,"_2843":53027},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3355":1648,"_29485":1591,"_20482":53029,"_5":14053,"_26831":52883,"_2843":53030},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3355":1649,"_29485":1591,"_20482":53032,"_5":14053,"_26831":52883,"_2843":53033},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3355":1650,"_29485":1591,"_20482":53035,"_5":14053,"_26831":52883,"_2843":53036},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3355":1651,"_29485":1591,"_20482":53038,"_5":14053,"_26831":52883,"_2843":53039},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3355":1652,"_29485":1591,"_20482":53041,"_5":14053,"_26831":52887,"_2843":53042},[],"Check",{"_3355":1653,"_29485":1591,"_20482":53044,"_5":14053,"_26831":52887,"_2843":53045},[],"Expected result",{"_3355":1654,"_29485":1591,"_20482":53047,"_5":14053,"_26831":52887,"_2843":53048},[],"Registration",{"_3355":1655,"_29485":1591,"_20482":53050,"_5":14053,"_26831":52887,"_2843":53051},[],"ID created automatically and correct DMS.",{"_3355":1656,"_29485":1591,"_20482":53053,"_5":14053,"_26831":52887,"_2843":52306},[],{"_3355":1657,"_29485":1591,"_20482":53055,"_5":14053,"_26831":52887,"_2843":53056},[],"CN, profile, serial and key verified.",{"_3355":1658,"_29485":1591,"_20482":53058,"_5":14053,"_26831":52887,"_2843":53059},[],"Inventory",{"_3355":1659,"_29485":1591,"_20482":53061,"_5":14053,"_26831":52887,"_2843":53062},[],"Received serial visible as the current identity and in history.",{"_3355":1660,"_29485":1591,"_20482":53064,"_5":14053,"_26831":52887,"_2843":53065},[],"Consumer",{"_3355":1661,"_29485":1591,"_20482":53067,"_5":14053,"_26831":52887,"_2843":53068},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3355":1662,"_29485":1591,"_20482":53070,"_5":14053,"_26831":52887,"_2843":53071},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3355":1663,"_29485":1591,"_20482":53073,"_5":14053,"_26831":52887,"_2843":53074},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3355":1664,"_29485":1664,"_5":14411,"_2843":50434,"_29817":53076,"_20482":53077,"_26831":1664},[47939,49407,50418,52853],[],{"_3355":1665,"_29485":1664,"_20482":53079,"_5":14053,"_26831":1664,"_2843":53080},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3355":1666,"_29485":1664,"_5":29814,"_20482":53082,"_26831":53083,"_2843":47949},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3355":1667,"_29485":1664,"_5":29814,"_20482":53085,"_26831":53086,"_2843":53087},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3355":1668,"_29485":1664,"_5":29814,"_20482":53089,"_26831":53090,"_2843":53091},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3355":1669,"_29485":1664,"_5":29814,"_20482":53093,"_26831":53094,"_2843":53095},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3355":1670,"_29485":1664,"_5":29814,"_20482":53097,"_26831":53098,"_2843":53099},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3355":1671,"_29485":1664,"_5":29814,"_20482":53101,"_26831":53102,"_2843":53103},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3355":1672,"_29485":1664,"_5":29814,"_20482":53105,"_26831":53106,"_2843":53045},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3355":1673,"_29485":1664,"_5":29814,"_20482":53108,"_26831":53109,"_2843":53110},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3355":1674,"_29485":1664,"_5":29814,"_20482":53112,"_26831":53113,"_2843":53114},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3355":1675,"_29485":1664,"_20482":53116,"_5":14053,"_26831":1664,"_2843":53117},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3355":1676,"_29485":1664,"_20482":53119,"_5":14053,"_26831":1664,"_2843":53120},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3355":1677,"_29485":1664,"_20482":53122,"_5":14053,"_26831":53083,"_2843":53123},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3355":1678,"_29485":1664,"_20482":53125,"_5":14053,"_26831":53083,"_2843":53126},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3355":1679,"_29485":1664,"_20482":53128,"_5":14053,"_26831":53083,"_2843":53129},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3355":1680,"_29485":1664,"_20482":53131,"_5":14053,"_26831":53083,"_2843":53132},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3355":1681,"_29485":1664,"_20482":53134,"_5":14053,"_26831":53086,"_2843":53135},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3355":1682,"_29485":1664,"_20482":53137,"_5":14053,"_26831":53086,"_2843":53138},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3355":1683,"_29485":1664,"_20482":53140,"_5":14053,"_26831":53086,"_2843":53141},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3355":1684,"_29485":1664,"_20482":53143,"_5":14053,"_26831":53086,"_2843":53144},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3355":1685,"_29485":1664,"_20482":53146,"_5":14053,"_26831":53086,"_2843":53147},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3355":1686,"_29485":1664,"_20482":53149,"_5":14053,"_26831":53086,"_2843":53150},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3355":1687,"_29485":1664,"_20482":53152,"_5":14053,"_26831":53086,"_2843":53153},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3355":1688,"_29485":1664,"_20482":53155,"_5":14053,"_26831":53086,"_2843":53156},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3355":1689,"_29485":1664,"_20482":53158,"_5":14053,"_26831":53090,"_2843":53159},[],"Open **Managed Devices** and the registration action. Complete:",{"_3355":1690,"_29485":1664,"_20482":53161,"_5":14053,"_26831":53090,"_2843":53162},[],"**Device ID**: `device-001`.",{"_3355":1691,"_29485":1664,"_20482":53164,"_5":14053,"_26831":53090,"_2843":53165},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3355":1692,"_29485":1664,"_20482":53167,"_5":14053,"_26831":53090,"_2843":53168},[],"**Icon** and **Tags**: optional classification.",{"_3355":1693,"_29485":1664,"_20482":53170,"_5":14053,"_26831":53090,"_2843":53171},[],"Confirm registration.",{"_3355":1694,"_29485":1664,"_20482":53173,"_5":14053,"_26831":53094,"_2843":53174},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3355":1695,"_29485":1664,"_20482":53176,"_5":14053,"_26831":53094,"_2843":53177},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3355":1696,"_29485":1664,"_20482":53179,"_5":14053,"_26831":53098,"_2843":53180},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3355":1697,"_29485":1664,"_20482":53182,"_5":14053,"_26831":53098,"_2843":53183},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3355":1698,"_29485":1664,"_20482":53185,"_5":14053,"_26831":53102,"_2843":53186},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3355":1699,"_29485":1664,"_20482":53188,"_5":14053,"_26831":53102,"_2843":53189},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3355":1700,"_29485":1664,"_20482":53191,"_5":14053,"_26831":53106,"_2843":53042},[],{"_3355":1701,"_29485":1664,"_20482":53193,"_5":14053,"_26831":53106,"_2843":53194},[],"Result",{"_3355":1702,"_29485":1664,"_20482":53196,"_5":14053,"_26831":53106,"_2843":52289},[],{"_3355":1703,"_29485":1664,"_20482":53198,"_5":14053,"_26831":53106,"_2843":53199},[],"`device-001` appears in inventory with the expected DMS.",{"_3355":1704,"_29485":1664,"_20482":53201,"_5":14053,"_26831":53106,"_2843":53202},[],"Current identity",{"_3355":1705,"_29485":1664,"_20482":53204,"_5":14053,"_26831":53106,"_2843":53205},[],"The associated certificate matches the one you verified in PKI.",{"_3355":1706,"_29485":1664,"_20482":53207,"_5":14053,"_26831":53106,"_2843":53208},[],"History",{"_3355":1707,"_29485":1664,"_20482":53210,"_5":14053,"_26831":53106,"_2843":53211},[],"The associated issuance appears with its serial number and dates.",{"_3355":1708,"_29485":1664,"_20482":53213,"_5":14053,"_26831":53106,"_2843":53214},[],"Key and certificate",{"_3355":1709,"_29485":1664,"_20482":53216,"_5":14053,"_26831":53106,"_2843":53217},[],"You have the verified pair ready to install on the device.",{"_3355":1710,"_29485":1664,"_20482":53219,"_5":14053,"_26831":53109,"_2843":53220},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3355":1711,"_29485":1664,"_20482":53222,"_5":14053,"_26831":53109,"_2843":53223},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3355":1712,"_29485":1664,"_20482":53225,"_5":14053,"_26831":53109,"_2843":53226},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3355":1713,"_29485":1664,"_20482":53228,"_5":14053,"_26831":53109,"_2843":53229},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3355":1714,"_29485":1664,"_20482":53231,"_5":14053,"_26831":53113,"_2843":53232},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3355":1715,"_29485":1664,"_20482":53234,"_5":14053,"_26831":53113,"_2843":53235},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3355":1716,"_29485":1664,"_20482":53237,"_5":14053,"_26831":53113,"_2843":53238},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3355":1717,"_29485":1717,"_5":14411,"_2843":53240,"_29817":53241,"_20482":53242,"_26831":1717},"Lamassu IoT Platform",[47939,49407],[],{"_3355":1718,"_29485":1717,"_20482":53244,"_5":14053,"_26831":1717,"_2843":53245},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3355":1719,"_29485":1717,"_5":29814,"_20482":53247,"_26831":53248,"_2843":52728},[],"/docs/platform/overview#start-here",{"_3355":1720,"_29485":1717,"_5":29814,"_20482":53250,"_26831":53251,"_2843":53252},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3355":1721,"_29485":1717,"_5":29814,"_20482":53254,"_26831":53255,"_2843":53256},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3355":1722,"_29485":1717,"_5":29814,"_20482":53258,"_26831":53259,"_2843":53260},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3355":1723,"_29485":1717,"_5":29814,"_20482":53262,"_26831":53263,"_2843":53264},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3355":1724,"_29485":1717,"_5":29814,"_20482":53266,"_26831":53267,"_2843":53268},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3355":1725,"_29485":1717,"_5":29814,"_20482":53270,"_26831":53271,"_2843":53272},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3355":1726,"_29485":1717,"_5":29814,"_20482":53274,"_26831":53275,"_2843":53276},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3355":1727,"_29485":1717,"_5":29814,"_20482":53278,"_26831":53279,"_2843":53280},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3355":1728,"_29485":1717,"_5":29814,"_20482":53282,"_26831":53283,"_2843":53284},[],"/docs/platform/overview#react-to-events","React to events",{"_3355":1729,"_29485":1717,"_5":29814,"_20482":53286,"_26831":53287,"_2843":53288},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3355":1730,"_29485":1717,"_20482":53290,"_5":14053,"_26831":1717,"_2843":53291},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3355":1731,"_29485":1717,"_20482":53293,"_5":14053,"_26831":53248,"_2843":53294},[],"Choose the result you need:",{"_3355":1732,"_29485":1717,"_20482":53296,"_5":14053,"_26831":53248,"_2843":53297},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3355":1733,"_29485":1717,"_20482":53299,"_5":14053,"_26831":53248,"_2843":53300},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3355":1734,"_29485":1717,"_20482":53302,"_5":14053,"_26831":53248,"_2843":53303},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3355":1735,"_29485":1717,"_20482":53305,"_5":14053,"_26831":53251,"_2843":53306},[],"Section",{"_3355":1736,"_29485":1717,"_20482":53308,"_5":14053,"_26831":53251,"_2843":53309},[],"What you manage",{"_3355":1737,"_29485":1717,"_20482":53311,"_5":14053,"_26831":53251,"_2843":53312},[],"Entry point",{"_3355":1738,"_29485":1717,"_20482":53314,"_5":14053,"_26831":53251,"_2843":53315},[],"**PKI**",{"_3355":1739,"_29485":1717,"_20482":53317,"_5":14053,"_26831":53251,"_2843":53318},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3355":1740,"_29485":1717,"_20482":53320,"_5":14053,"_26831":53251,"_2843":53321},[],"PKI overview",{"_3355":1741,"_29485":1717,"_20482":53323,"_5":14053,"_26831":53251,"_2843":53324},[],"**IoT Fleets**",{"_3355":1742,"_29485":1717,"_20482":53326,"_5":14053,"_26831":53251,"_2843":53327},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3355":1743,"_29485":1717,"_20482":53329,"_5":14053,"_26831":53251,"_2843":53330},[],"IoT Fleets overview",{"_3355":1744,"_29485":1717,"_20482":53332,"_5":14053,"_26831":53251,"_2843":53333},[],"**Administration**",{"_3355":1745,"_29485":1717,"_20482":53335,"_5":14053,"_26831":53251,"_2843":53336},[],"Operator permissions, audit and event subscriptions.",{"_3355":1746,"_29485":1717,"_20482":53338,"_5":14053,"_26831":53251,"_2843":49405},[],{"_3355":1747,"_29485":1717,"_20482":53340,"_5":14053,"_26831":53251,"_2843":53341},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3355":1748,"_29485":1717,"_20482":53343,"_5":14053,"_26831":53255,"_2843":53344},[],"An identity's journey connects four responsibilities:",{"_3355":1749,"_29485":1717,"_20482":53346,"_5":14053,"_26831":53255,"_2843":53347},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3355":1750,"_29485":1717,"_20482":53349,"_5":14053,"_26831":53255,"_2843":53350},[],"The provisioning administrator configures the DMS and initial trust.",{"_3355":1751,"_29485":1717,"_20482":53352,"_5":14053,"_26831":53255,"_2843":53353},[],"The device client requests a certificate and installs it with the matching key.",{"_3355":1752,"_29485":1717,"_20482":53355,"_5":14053,"_26831":53255,"_2843":53356},[],"The consumer validates the identity and applies its access permissions.",{"_3355":1753,"_29485":1717,"_20482":53358,"_5":14053,"_26831":53255,"_2843":53359},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3355":1754,"_29485":1717,"_20482":53361,"_5":14053,"_26831":53263,"_2843":53362},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3355":1755,"_29485":1717,"_20482":53364,"_5":14053,"_26831":53267,"_2843":53365},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3355":1756,"_29485":1717,"_20482":53367,"_5":14053,"_26831":53271,"_2843":53368},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3355":1757,"_29485":1717,"_20482":53370,"_5":14053,"_26831":53275,"_2843":53371},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3355":1758,"_29485":1717,"_20482":53373,"_5":14053,"_26831":53279,"_2843":53374},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3355":1759,"_29485":1717,"_20482":53376,"_5":14053,"_26831":53283,"_2843":53377},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3355":1760,"_29485":1717,"_20482":53379,"_5":14053,"_26831":53287,"_2843":52822},[],{"_3355":1761,"_29485":1717,"_20482":53381,"_5":14053,"_26831":53287,"_2843":53382},[],"What it prepares or checks",{"_3355":1762,"_29485":1717,"_20482":53384,"_5":14053,"_26831":53287,"_2843":52825},[],{"_3355":1763,"_29485":1717,"_20482":53386,"_5":14053,"_26831":53287,"_2843":53387},[],"Key custody, CA hierarchy, profiles and validation.",{"_3355":1764,"_29485":1717,"_20482":53389,"_5":14053,"_26831":53287,"_2843":53390},[],"Fleet administrator",{"_3355":1765,"_29485":1717,"_20482":53392,"_5":14053,"_26831":53287,"_2843":53393},[],"DMS, device admission, renewal policy and inventory.",{"_3355":1766,"_29485":1717,"_20482":53395,"_5":14053,"_26831":53287,"_2843":52837},[],{"_3355":1767,"_29485":1717,"_20482":53397,"_5":14053,"_26831":53287,"_2843":53398},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3355":1768,"_29485":1717,"_20482":53400,"_5":14053,"_26831":53287,"_2843":52843},[],{"_3355":1769,"_29485":1717,"_20482":53402,"_5":14053,"_26831":53287,"_2843":53403},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3355":1770,"_29485":1717,"_20482":53405,"_5":14053,"_26831":53287,"_2843":53406},[],"Infrastructure operator",{"_3355":1771,"_29485":1717,"_20482":53408,"_5":14053,"_26831":53287,"_2843":53409},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3355":1772,"_29485":1717,"_20482":53411,"_5":14053,"_26831":53287,"_2843":53412},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3355":1773,"_29485":1773,"_5":14411,"_2843":53414,"_29817":53415,"_20482":53418,"_26831":1773},"CA hierarchy and rotation",[47939,49407,53416,53417],"PKI","Keys, authorities and certificates",[],{"_3355":1774,"_29485":1773,"_20482":53420,"_5":14053,"_26831":1773,"_2843":53421},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3355":1775,"_29485":1773,"_5":29814,"_20482":53423,"_26831":53424,"_2843":53425},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3355":1776,"_29485":1773,"_5":29814,"_20482":53427,"_26831":53428,"_2843":53429},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3355":1777,"_29485":1773,"_5":29814,"_20482":53431,"_26831":53432,"_2843":53433},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3355":1778,"_29485":1773,"_5":29814,"_20482":53435,"_26831":53436,"_2843":53437},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3355":1779,"_29485":1773,"_5":29814,"_20482":53439,"_26831":53440,"_2843":53441},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3355":1780,"_29485":1773,"_5":29814,"_20482":53443,"_26831":53444,"_2843":53445},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3355":1781,"_29485":1773,"_5":29814,"_20482":53447,"_26831":53448,"_2843":53449},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3355":1782,"_29485":1773,"_5":29814,"_20482":53451,"_26831":53452,"_2843":53453},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3355":1783,"_29485":1773,"_5":29814,"_20482":53455,"_26831":53456,"_2843":53457},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3355":1784,"_29485":1773,"_5":29814,"_20482":53459,"_26831":53460,"_2843":53461},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3355":1785,"_29485":1773,"_5":29814,"_20482":53463,"_26831":53464,"_2843":53465},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3355":1786,"_29485":1773,"_5":29814,"_20482":53467,"_26831":53468,"_2843":53469},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3355":1787,"_29485":1773,"_20482":53471,"_5":14053,"_26831":1773,"_2843":53472},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3355":1788,"_29485":1773,"_20482":53474,"_5":14053,"_26831":1773,"_2843":53475},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3355":1789,"_29485":1773,"_20482":53477,"_5":14053,"_26831":53424,"_2843":53478},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3355":1790,"_29485":1773,"_20482":53480,"_5":14053,"_26831":53424,"_2843":53481},[],"environment, such as production and preproduction;",{"_3355":1791,"_29485":1773,"_20482":53483,"_5":14053,"_26831":53424,"_2843":53484},[],"owner or operating team;",{"_3355":1792,"_29485":1773,"_20482":53486,"_5":14053,"_26831":53424,"_2843":53487},[],"device family or manufacturing process;",{"_3355":1793,"_29485":1773,"_20482":53489,"_5":14053,"_26831":53424,"_2843":53490},[],"region or regulatory requirement;",{"_3355":1794,"_29485":1773,"_20482":53492,"_5":14053,"_26831":53424,"_2843":53493},[],"cryptographic engine or key policy;",{"_3355":1795,"_29485":1773,"_20482":53495,"_5":14053,"_26831":53424,"_2843":53496},[],"maintenance window and renewal cadence.",{"_3355":1796,"_29485":1773,"_20482":53498,"_5":14053,"_26831":53424,"_2843":53499},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3355":1797,"_29485":1773,"_20482":53501,"_5":14053,"_26831":53424,"_2843":53502},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3355":1798,"_29485":1773,"_20482":53504,"_5":14053,"_26831":53428,"_2843":53505},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3355":1799,"_29485":1773,"_20482":53507,"_5":14053,"_26831":53428,"_2843":53508},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3355":1800,"_29485":1773,"_20482":53510,"_5":14053,"_26831":53428,"_2843":53511},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3355":1801,"_29485":1773,"_20482":53513,"_5":14053,"_26831":53432,"_2843":53514},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3355":1802,"_29485":1773,"_20482":53516,"_5":14053,"_26831":53432,"_2843":53517},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3355":1803,"_29485":1773,"_20482":53519,"_5":14053,"_26831":53432,"_2843":53520},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3355":1804,"_29485":1773,"_20482":53522,"_5":14053,"_26831":53432,"_2843":53523},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3355":1805,"_29485":1773,"_20482":53525,"_5":14053,"_26831":53440,"_2843":53526},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3355":1806,"_29485":1773,"_20482":53528,"_5":14053,"_26831":53444,"_2843":53529},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3355":1807,"_29485":1773,"_20482":53531,"_5":14053,"_26831":53448,"_2843":53532},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3355":1808,"_29485":1773,"_20482":53534,"_5":14053,"_26831":53452,"_2843":53535},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3355":1809,"_29485":1773,"_20482":53537,"_5":14053,"_26831":53456,"_2843":53538},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3355":1810,"_29485":1773,"_20482":53540,"_5":14053,"_26831":53460,"_2843":53541},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3355":1811,"_29485":1773,"_20482":53543,"_5":14053,"_26831":53464,"_2843":53544},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3355":1812,"_29485":1773,"_20482":53546,"_5":14053,"_26831":53464,"_2843":53547},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3355":1813,"_29485":1773,"_20482":53549,"_5":14053,"_26831":53464,"_2843":53550},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3355":1814,"_29485":1773,"_20482":53552,"_5":14053,"_26831":53464,"_2843":53553},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3355":1815,"_29485":1773,"_20482":53555,"_5":14053,"_26831":53468,"_2843":53556},[],"The new chain ends in an anchor installed by the consumer.",{"_3355":1816,"_29485":1773,"_20482":53558,"_5":14053,"_26831":53468,"_2843":53559},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3355":1817,"_29485":1773,"_20482":53561,"_5":14053,"_26831":53468,"_2843":53562},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3355":1818,"_29485":1773,"_20482":53564,"_5":14053,"_26831":53468,"_2843":53565},[],"Re-enrollment accepts the old identity during the planned period.",{"_3355":1819,"_29485":1773,"_20482":53567,"_5":14053,"_26831":53468,"_2843":53568},[],"OCSP and CRL respond for the authorities that remain active.",{"_3355":1820,"_29485":1773,"_20482":53570,"_5":14053,"_26831":53468,"_2843":53571},[],"No DMS is left accidentally issuing from the old CA.",{"_3355":1821,"_29485":1773,"_20482":53573,"_5":14053,"_26831":53468,"_2843":53574},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3355":1822,"_29485":1822,"_5":14411,"_2843":53576,"_29817":53577,"_20482":53578,"_26831":1822},"Certification authorities",[47939,49407,53416,53417],[],{"_3355":1823,"_29485":1822,"_20482":53580,"_5":14053,"_26831":1822,"_2843":53581},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3355":1824,"_29485":1822,"_5":29814,"_20482":53583,"_26831":53584,"_2843":53585},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3355":1825,"_29485":1822,"_5":29814,"_20482":53587,"_26831":53588,"_2843":53589},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3355":1826,"_29485":1822,"_5":29814,"_20482":53591,"_26831":53592,"_2843":47949},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3355":1827,"_29485":1822,"_5":29814,"_20482":53594,"_26831":53595,"_2843":53596},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3355":1828,"_29485":1822,"_5":29814,"_20482":53598,"_26831":53599,"_2843":53600},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3355":1829,"_29485":1822,"_5":29814,"_20482":53602,"_26831":53603,"_2843":53604},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3355":1830,"_29485":1822,"_5":29814,"_20482":53606,"_26831":53607,"_2843":53608},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3355":1831,"_29485":1822,"_5":29814,"_20482":53610,"_26831":53611,"_2843":53612},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3355":1832,"_29485":1822,"_5":29814,"_20482":53614,"_26831":53615,"_2843":53616},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3355":1833,"_29485":1822,"_5":29814,"_20482":53618,"_26831":53619,"_2843":53620},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3355":1834,"_29485":1822,"_5":29814,"_20482":53622,"_26831":53623,"_2843":53624},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3355":1835,"_29485":1822,"_5":29814,"_20482":53626,"_26831":53627,"_2843":53628},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3355":1836,"_29485":1822,"_5":29814,"_20482":53630,"_26831":53631,"_2843":53632},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3355":1837,"_29485":1822,"_5":29814,"_20482":53634,"_26831":53635,"_2843":53636},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3355":1838,"_29485":1822,"_5":29814,"_20482":53638,"_26831":53639,"_2843":53640},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3355":1839,"_29485":1822,"_5":29814,"_20482":53642,"_26831":53643,"_2843":53644},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3355":1840,"_29485":1822,"_5":29814,"_20482":53646,"_26831":53647,"_2843":53648},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3355":1841,"_29485":1822,"_5":29814,"_20482":53650,"_26831":53651,"_2843":53652},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3355":1842,"_29485":1822,"_5":29814,"_20482":53654,"_26831":53655,"_2843":53656},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3355":1843,"_29485":1822,"_5":29814,"_20482":53658,"_26831":53659,"_2843":53660},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3355":1844,"_29485":1822,"_5":29814,"_20482":53662,"_26831":53663,"_2843":53664},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3355":1845,"_29485":1822,"_5":29814,"_20482":53666,"_26831":53667,"_2843":53668},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3355":1846,"_29485":1822,"_5":29814,"_20482":53670,"_26831":53671,"_2843":53672},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3355":1847,"_29485":1822,"_20482":53674,"_5":14053,"_26831":1822,"_2843":53675},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3355":1848,"_29485":1822,"_20482":53677,"_5":14053,"_26831":1822,"_2843":53678},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3355":1849,"_29485":1822,"_20482":53680,"_5":14053,"_26831":1822,"_2843":53681},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3355":1850,"_29485":1822,"_20482":53683,"_5":14053,"_26831":53584,"_2843":53684},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3355":1851,"_29485":1822,"_20482":53686,"_5":14053,"_26831":53584,"_2843":53687},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3355":1852,"_29485":1822,"_20482":53689,"_5":14053,"_26831":53584,"_2843":53690},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3355":1853,"_29485":1822,"_20482":53692,"_5":14053,"_26831":53584,"_2843":53693},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3355":1854,"_29485":1822,"_20482":53695,"_5":14053,"_26831":53584,"_2843":53696},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3355":1855,"_29485":1822,"_20482":53698,"_5":14053,"_26831":53592,"_2843":53699},[],"Decide whether the CA will be a root or an intermediate.",{"_3355":1856,"_29485":1822,"_20482":53701,"_5":14053,"_26831":53592,"_2843":53702},[],"Choose the engine that will keep the key.",{"_3355":1857,"_29485":1822,"_20482":53704,"_5":14053,"_26831":53592,"_2843":53705},[],"Define a validity longer than that of the certificates it will issue.",{"_3355":1858,"_29485":1822,"_20482":53707,"_5":14053,"_26831":53592,"_2843":53708},[],"For an intermediate CA, make sure the parent CA is active.",{"_3355":1859,"_29485":1822,"_20482":53710,"_5":14053,"_26831":53595,"_2843":53711},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3355":1860,"_29485":1822,"_20482":53713,"_5":14053,"_26831":53599,"_2843":53714},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3355":1861,"_29485":1822,"_20482":53716,"_5":14053,"_26831":53599,"_2843":53717},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3355":1862,"_29485":1822,"_20482":53719,"_5":14053,"_26831":53603,"_2843":53720},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3355":1863,"_29485":1822,"_20482":53722,"_5":14053,"_26831":53607,"_2843":53723},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3355":1864,"_29485":1822,"_20482":53725,"_5":14053,"_26831":53607,"_2843":53726},[],"`C`: two-letter ISO 3166-1 country code.",{"_3355":1865,"_29485":1822,"_20482":53728,"_5":14053,"_26831":53607,"_2843":53729},[],"`ST`: state or province.",{"_3355":1866,"_29485":1822,"_20482":53731,"_5":14053,"_26831":53607,"_2843":53732},[],"`L`: locality.",{"_3355":1867,"_29485":1822,"_20482":53734,"_5":14053,"_26831":53607,"_2843":53735},[],"`O`: organization.",{"_3355":1868,"_29485":1822,"_20482":53737,"_5":14053,"_26831":53607,"_2843":53738},[],"`OU`: organizational unit.",{"_3355":1869,"_29485":1822,"_20482":53740,"_5":14053,"_26831":53607,"_2843":53741},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3355":1870,"_29485":1822,"_20482":53743,"_5":14053,"_26831":53611,"_2843":53744},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3355":1871,"_29485":1822,"_20482":53746,"_5":14053,"_26831":53611,"_2843":53747},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3355":1872,"_29485":1822,"_20482":53749,"_5":14053,"_26831":53615,"_2843":53750},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3355":1873,"_29485":1822,"_20482":53752,"_5":14053,"_26831":53615,"_2843":53753},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3355":1874,"_29485":1822,"_20482":53755,"_5":14053,"_26831":53619,"_2843":53756},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3355":1875,"_29485":1822,"_20482":53758,"_5":14053,"_26831":53619,"_2843":53759},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3355":1876,"_29485":1822,"_20482":53761,"_5":14053,"_26831":53623,"_2843":53762},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3355":1877,"_29485":1822,"_20482":53764,"_5":14053,"_26831":53627,"_2843":53765},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3355":1878,"_29485":1822,"_20482":53767,"_5":14053,"_26831":53631,"_2843":53768},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3355":1879,"_29485":1822,"_20482":53770,"_5":14053,"_26831":53635,"_2843":53771},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3355":1880,"_29485":1822,"_20482":53773,"_5":14053,"_26831":53639,"_2843":53774},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3355":1881,"_29485":1822,"_20482":53776,"_5":14053,"_26831":53639,"_2843":53777},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3355":1882,"_29485":1822,"_20482":53779,"_5":14053,"_26831":53643,"_2843":53780},[],"Open a CA from the inventory to review:",{"_3355":1883,"_29485":1822,"_20482":53782,"_5":14053,"_26831":53643,"_2843":53783},[],"Status and validity period.",{"_3355":1884,"_29485":1822,"_20482":53785,"_5":14053,"_26831":53643,"_2843":53786},[],"Certificate and chain in PEM format.",{"_3355":1885,"_29485":1822,"_20482":53788,"_5":14053,"_26831":53643,"_2843":53789},[],"Number of active, expired and revoked certificates.",{"_3355":1886,"_29485":1822,"_20482":53791,"_5":14053,"_26831":53643,"_2843":53792},[],"Certificates issued in **Issued Certificates**.",{"_3355":1887,"_29485":1822,"_20482":53794,"_5":14053,"_26831":53643,"_2843":53795},[],"The CRL linked to the authority.",{"_3355":1888,"_29485":1822,"_20482":53797,"_5":14053,"_26831":53643,"_2843":53798},[],"Metadata and the associated cryptographic engine.",{"_3355":1889,"_29485":1822,"_20482":53800,"_5":14053,"_26831":53643,"_2843":53801},[],"You can filter the inventory by name, status and CA type.",{"_3355":1890,"_29485":1822,"_20482":53803,"_5":14053,"_26831":53647,"_2843":53804},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3355":1891,"_29485":1822,"_20482":53806,"_5":14053,"_26831":53647,"_2843":53807},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3355":1892,"_29485":1822,"_20482":53809,"_5":14053,"_26831":53647,"_2843":53810},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3355":1893,"_29485":1822,"_20482":53812,"_5":14053,"_26831":53647,"_2843":53813},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3355":1894,"_29485":1822,"_20482":53815,"_5":14053,"_26831":53651,"_2843":53816},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3355":1895,"_29485":1822,"_20482":53818,"_5":14053,"_26831":53655,"_2843":53819},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3355":1896,"_29485":1822,"_20482":53821,"_5":14053,"_26831":53659,"_2843":53822},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3355":1897,"_29485":1822,"_20482":53824,"_5":14053,"_26831":53663,"_2843":53825},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3355":1898,"_29485":1822,"_20482":53827,"_5":14053,"_26831":53667,"_2843":53828},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3355":1899,"_29485":1822,"_20482":53830,"_5":14053,"_26831":53671,"_2843":53831},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3355":1900,"_29485":1822,"_20482":53833,"_5":14053,"_26831":53671,"_2843":53834},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3355":1901,"_29485":1822,"_20482":53836,"_5":14053,"_26831":53671,"_2843":53837},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3355":1902,"_29485":1902,"_5":14411,"_2843":53839,"_29817":53840,"_20482":53841,"_26831":1902},"Certificate profiles",[47939,49407,53416,53417],[],{"_3355":1903,"_29485":1902,"_20482":53843,"_5":14053,"_26831":1902,"_2843":53844},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3355":1904,"_29485":1902,"_5":29814,"_20482":53846,"_26831":53847,"_2843":53848},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3355":1905,"_29485":1902,"_5":29814,"_20482":53850,"_26831":53851,"_2843":53852},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3355":1906,"_29485":1902,"_5":29814,"_20482":53854,"_26831":53855,"_2843":53856},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3355":1907,"_29485":1902,"_5":29814,"_20482":53858,"_26831":53859,"_2843":53860},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3355":1908,"_29485":1902,"_5":29814,"_20482":53862,"_26831":53863,"_2843":53864},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3355":1909,"_29485":1902,"_5":29814,"_20482":53866,"_26831":53867,"_2843":53868},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3355":1910,"_29485":1902,"_5":29814,"_20482":53870,"_26831":53871,"_2843":53872},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3355":1911,"_29485":1902,"_5":29814,"_20482":53874,"_26831":53875,"_2843":53876},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3355":1912,"_29485":1902,"_5":29814,"_20482":53878,"_26831":53879,"_2843":53880},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3355":1913,"_29485":1902,"_5":29814,"_20482":53882,"_26831":53883,"_2843":53884},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3355":1914,"_29485":1902,"_5":29814,"_20482":53886,"_26831":53887,"_2843":53888},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3355":1915,"_29485":1902,"_5":29814,"_20482":53890,"_26831":53891,"_2843":53892},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3355":1916,"_29485":1902,"_5":29814,"_20482":53894,"_26831":53895,"_2843":53896},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3355":1917,"_29485":1902,"_5":29814,"_20482":53898,"_26831":53899,"_2843":53900},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3355":1918,"_29485":1902,"_5":29814,"_20482":53902,"_26831":53903,"_2843":53904},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3355":1919,"_29485":1902,"_5":29814,"_20482":53906,"_26831":53907,"_2843":53908},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3355":1920,"_29485":1902,"_20482":53910,"_5":14053,"_26831":1902,"_2843":53911},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3355":1921,"_29485":1902,"_20482":53913,"_5":14053,"_26831":1902,"_2843":53914},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3355":1922,"_29485":1902,"_20482":53916,"_5":14053,"_26831":53851,"_2843":53917},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3355":1923,"_29485":1902,"_20482":53919,"_5":14053,"_26831":53851,"_2843":53920},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3355":1924,"_29485":1902,"_20482":53922,"_5":14053,"_26831":53855,"_2843":53923},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3355":1925,"_29485":1902,"_20482":53925,"_5":14053,"_26831":53859,"_2843":53926},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3355":1926,"_29485":1902,"_20482":53928,"_5":14053,"_26831":53859,"_2843":53929},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3355":1927,"_29485":1902,"_20482":53931,"_5":14053,"_26831":53859,"_2843":53932},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3355":1928,"_29485":1902,"_20482":53934,"_5":14053,"_26831":53863,"_2843":53935},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3355":1929,"_29485":1902,"_20482":53937,"_5":14053,"_26831":53867,"_2843":53938},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3355":1930,"_29485":1902,"_20482":53940,"_5":14053,"_26831":53867,"_2843":53941},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3355":1931,"_29485":1902,"_20482":53943,"_5":14053,"_26831":53871,"_2843":53944},[],"The cryptographic enforcement can:",{"_3355":1932,"_29485":1902,"_20482":53946,"_5":14053,"_26831":53871,"_2843":53947},[],"allow or block RSA keys;",{"_3355":1933,"_29485":1902,"_20482":53949,"_5":14053,"_26831":53871,"_2843":53950},[],"limit the supported RSA sizes;",{"_3355":1934,"_29485":1902,"_20482":53952,"_5":14053,"_26831":53871,"_2843":53953},[],"allow or block ECDSA keys;",{"_3355":1935,"_29485":1902,"_20482":53955,"_5":14053,"_26831":53871,"_2843":53956},[],"limit the supported ECDSA sizes or curves.",{"_3355":1936,"_29485":1902,"_20482":53958,"_5":14053,"_26831":53871,"_2843":53959},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3355":1937,"_29485":1902,"_20482":53961,"_5":14053,"_26831":53875,"_2843":53962},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3355":1938,"_29485":1902,"_20482":53964,"_5":14053,"_26831":53875,"_2843":51171},[],{"_3355":1939,"_29485":1902,"_20482":53966,"_5":14053,"_26831":53875,"_2843":53967},[],"First choice",{"_3355":1940,"_29485":1902,"_20482":53969,"_5":14053,"_26831":53875,"_2843":53970},[],"Second choice",{"_3355":1941,"_29485":1902,"_20482":53972,"_5":14053,"_26831":53875,"_2843":53973},[],"If neither is supplied",{"_3355":1942,"_29485":1902,"_20482":53975,"_5":14053,"_26831":53875,"_2843":53976},[],"Direct signing with a CA",{"_3355":1943,"_29485":1902,"_20482":53978,"_5":14053,"_26831":53875,"_2843":53979},[],"`issuance_profile` embedded in the request",{"_3355":1944,"_29485":1902,"_20482":53981,"_5":14053,"_26831":53875,"_2843":53982},[],"Request `issuance_profile_id`",{"_3355":1945,"_29485":1902,"_20482":53984,"_5":14053,"_26831":53875,"_2843":53985},[],"CA default profile (`profile_id`).",{"_3355":1946,"_29485":1902,"_20482":53987,"_5":14053,"_26831":53875,"_2843":53988},[],"Issuance through a DMS",{"_3355":1947,"_29485":1902,"_20482":53990,"_5":14053,"_26831":53875,"_2843":53991},[],"`settings.issuance_profile_id`",{"_3355":1948,"_29485":1902,"_20482":53993,"_5":14053,"_26831":53875,"_2843":53994},[],"`settings.issuance_profile` embedded in the DMS",{"_3355":1949,"_29485":1902,"_20482":53996,"_5":14053,"_26831":53875,"_2843":53997},[],"Enrollment CA default profile.",{"_3355":1950,"_29485":1902,"_20482":53999,"_5":14053,"_26831":53875,"_2843":54000},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3355":1951,"_29485":1902,"_20482":54002,"_5":14053,"_26831":53875,"_2843":54003},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3355":1952,"_29485":1902,"_20482":54005,"_5":14053,"_26831":53883,"_2843":54006},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3355":1953,"_29485":1902,"_20482":54008,"_5":14053,"_26831":53887,"_2843":54009},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3355":1954,"_29485":1902,"_20482":54011,"_5":14053,"_26831":53891,"_2843":54012},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3355":1955,"_29485":1902,"_20482":54014,"_5":14053,"_26831":53895,"_2843":54015},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3355":1956,"_29485":1902,"_20482":54017,"_5":14053,"_26831":53899,"_2843":54018},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3355":1957,"_29485":1902,"_20482":54020,"_5":14053,"_26831":53899,"_2843":54021},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3355":1958,"_29485":1902,"_20482":54023,"_5":14053,"_26831":53903,"_2843":54024},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3355":1959,"_29485":1902,"_20482":54026,"_5":14053,"_26831":53903,"_2843":54027},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3355":1960,"_29485":1902,"_20482":54029,"_5":14053,"_26831":53903,"_2843":54030},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3355":1961,"_29485":1902,"_20482":54032,"_5":14053,"_26831":53903,"_2843":54033},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3355":1962,"_29485":1902,"_20482":54035,"_5":14053,"_26831":53907,"_2843":54036},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3355":1963,"_29485":1902,"_20482":54038,"_5":14053,"_26831":53907,"_2843":54039},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3355":1964,"_29485":1964,"_5":14411,"_2843":54041,"_29817":54042,"_20482":54044,"_26831":1964},"Certificate validation",[47939,49407,53416,54043],"Validation",[],{"_3355":1965,"_29485":1964,"_20482":54046,"_5":14053,"_26831":1964,"_2843":54047},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3355":1966,"_29485":1964,"_5":29814,"_20482":54049,"_26831":54050,"_2843":54051},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3355":1967,"_29485":1964,"_5":29814,"_20482":54053,"_26831":54054,"_2843":54055},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3355":1968,"_29485":1964,"_5":29814,"_20482":54057,"_26831":54058,"_2843":54059},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3355":1969,"_29485":1964,"_20482":54061,"_5":14053,"_26831":1964,"_2843":54062},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3355":1970,"_29485":1964,"_20482":54064,"_5":14053,"_26831":54050,"_2843":54065},[],"Verify these criteria together:",{"_3355":1971,"_29485":1964,"_20482":54067,"_5":14053,"_26831":54050,"_2843":53042},[],{"_3355":1972,"_29485":1964,"_20482":54069,"_5":14053,"_26831":54050,"_2843":54070},[],"Required result",{"_3355":1973,"_29485":1964,"_20482":54072,"_5":14053,"_26831":54050,"_2843":54073},[],"Chain and signature",{"_3355":1974,"_29485":1964,"_20482":54075,"_5":14053,"_26831":54050,"_2843":54076},[],"Valid chain to a root deliberately installed in the consumer.",{"_3355":1975,"_29485":1964,"_20482":54078,"_5":14053,"_26831":54050,"_2843":54079},[],"Dates",{"_3355":1976,"_29485":1964,"_20482":54081,"_5":14053,"_26831":54050,"_2843":54082},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3355":1977,"_29485":1964,"_20482":54084,"_5":14053,"_26831":54050,"_2843":49076},[],{"_3355":1978,"_29485":1964,"_20482":54086,"_5":14053,"_26831":54050,"_2843":54087},[],"Name, SAN or identifier matches the expected peer.",{"_3355":1979,"_29485":1964,"_20482":54089,"_5":14053,"_26831":54050,"_2843":48329},[],{"_3355":1980,"_29485":1964,"_20482":54091,"_5":14053,"_26831":54050,"_2843":54092},[],"KU, EKU and constraints permit the specific operation.",{"_3355":1981,"_29485":1964,"_20482":54094,"_5":14053,"_26831":54050,"_2843":54095},[],"Revocation",{"_3355":1982,"_29485":1964,"_20482":54097,"_5":14053,"_26831":54050,"_2843":54098},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3355":1983,"_29485":1964,"_20482":54100,"_5":14053,"_26831":54050,"_2843":54101},[],"Authorization",{"_3355":1984,"_29485":1964,"_20482":54103,"_5":14053,"_26831":54050,"_2843":54104},[],"The application permits that identity to perform the action.",{"_3355":1985,"_29485":1964,"_20482":54106,"_5":14053,"_26831":54050,"_2843":54107},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3355":1986,"_29485":1964,"_20482":54109,"_5":14053,"_26831":54054,"_2843":54110},[],"Mechanism",{"_3355":1987,"_29485":1964,"_20482":54112,"_5":14053,"_26831":54054,"_2843":54113},[],"When to use it",{"_3355":1988,"_29485":1964,"_20482":54115,"_5":14053,"_26831":54054,"_2843":54116},[],"What you must maintain",{"_3355":1989,"_29485":1964,"_20482":54118,"_5":14053,"_26831":54054,"_2843":54119},[],"OCSP",{"_3355":1990,"_29485":1964,"_20482":54121,"_5":14053,"_26831":54054,"_2843":54122},[],"Status query for a specific certificate.",{"_3355":1991,"_29485":1964,"_20482":54124,"_5":14053,"_26831":54054,"_2843":54125},[],"Responder access, signature verification and cache/freshness policy.",{"_3355":1992,"_29485":1964,"_20482":54127,"_5":14053,"_26831":54054,"_2843":54128},[],"CRL",{"_3355":1993,"_29485":1964,"_20482":54130,"_5":14053,"_26831":54054,"_2843":54131},[],"Local checks for many certificates or offline operation.",{"_3355":1994,"_29485":1964,"_20482":54133,"_5":14053,"_26831":54054,"_2843":54134},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3355":1995,"_29485":1964,"_20482":54136,"_5":14053,"_26831":54054,"_2843":54137},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3355":1996,"_29485":1964,"_20482":54139,"_5":14053,"_26831":54054,"_2843":54140},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3355":1997,"_29485":1964,"_20482":54142,"_5":14053,"_26831":54058,"_2843":54143},[],"Accept a current, authorized certificate with a known chain.",{"_3355":1998,"_29485":1964,"_20482":54145,"_5":14053,"_26831":54058,"_2843":54146},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3355":1999,"_29485":1964,"_20482":54148,"_5":14053,"_26831":54058,"_2843":54149},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3355":2000,"_29485":1964,"_20482":54151,"_5":14053,"_26831":54058,"_2843":54152},[],"Check that a new connection with that identity is rejected.",{"_3355":2001,"_29485":1964,"_20482":54154,"_5":14053,"_26831":54058,"_2843":54155},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3355":2002,"_29485":1964,"_20482":54157,"_5":14053,"_26831":54058,"_2843":54158},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3355":2003,"_29485":1964,"_20482":54160,"_5":14053,"_26831":54058,"_2843":54161},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3355":2004,"_29485":1964,"_20482":54163,"_5":14053,"_26831":54058,"_2843":54164},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3355":2005,"_29485":1964,"_20482":54166,"_5":14053,"_26831":54058,"_2843":54167},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3355":2006,"_29485":2006,"_5":14411,"_2843":54169,"_29817":54170,"_20482":54171,"_26831":2006},"Certificates",[47939,49407,53416,53417],[],{"_3355":2007,"_29485":2006,"_20482":54173,"_5":14053,"_26831":2006,"_2843":54174},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3355":2008,"_29485":2006,"_5":29814,"_20482":54176,"_26831":54177,"_2843":54178},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3355":2009,"_29485":2006,"_5":29814,"_20482":54180,"_26831":54181,"_2843":54182},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3355":2010,"_29485":2006,"_5":29814,"_20482":54184,"_26831":54185,"_2843":54186},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3355":2011,"_29485":2006,"_5":29814,"_20482":54188,"_26831":54189,"_2843":54190},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3355":2012,"_29485":2006,"_5":29814,"_20482":54192,"_26831":54193,"_2843":54194},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3355":2013,"_29485":2006,"_5":29814,"_20482":54196,"_26831":54197,"_2843":54198},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3355":2014,"_29485":2006,"_5":29814,"_20482":54200,"_26831":54201,"_2843":54202},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3355":2015,"_29485":2006,"_5":29814,"_20482":54204,"_26831":54205,"_2843":54206},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3355":2016,"_29485":2006,"_5":29814,"_20482":54208,"_26831":54209,"_2843":54210},[],"/docs/platform/pki/certificates#continue","Continue",{"_3355":2017,"_29485":2006,"_20482":54212,"_5":14053,"_26831":2006,"_2843":54213},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3355":2018,"_29485":2006,"_20482":54215,"_5":14053,"_26831":54177,"_2843":54216},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3355":2019,"_29485":2006,"_20482":54218,"_5":14053,"_26831":54177,"_2843":54219},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3355":2020,"_29485":2006,"_20482":54221,"_5":14053,"_26831":54181,"_2843":54222},[],"Download the PEM and inspect it:",{"_3355":2021,"_29485":2006,"_20482":54224,"_5":14053,"_26831":54181,"_2843":54225},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3355":2022,"_29485":2006,"_20482":54227,"_5":14053,"_26831":54185,"_2843":54228},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3355":2023,"_29485":2006,"_20482":54230,"_5":14053,"_26831":54185,"_2843":54231},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3355":2024,"_29485":2006,"_20482":54233,"_5":14053,"_26831":54185,"_2843":54234},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3355":2025,"_29485":2006,"_20482":54236,"_5":14053,"_26831":54185,"_2843":54237},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3355":2026,"_29485":2006,"_20482":54239,"_5":14053,"_26831":54185,"_2843":54240},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3355":2027,"_29485":2006,"_20482":54242,"_5":14053,"_26831":54185,"_2843":54243},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3355":2028,"_29485":2006,"_20482":54245,"_5":14053,"_26831":54185,"_2843":54246},[],"For browser key generation, follow Issue your first certificate.",{"_3355":2029,"_29485":2006,"_20482":54248,"_5":14053,"_26831":54189,"_2843":54249},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3355":2030,"_29485":2006,"_20482":54251,"_5":14053,"_26831":54193,"_2843":54252},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3355":2031,"_29485":2006,"_20482":54254,"_5":14053,"_26831":54197,"_2843":54255},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3355":2032,"_29485":2006,"_20482":54257,"_5":14053,"_26831":54201,"_2843":54258},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3355":2033,"_29485":2006,"_20482":54260,"_5":14053,"_26831":54201,"_2843":54261},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3355":2034,"_29485":2006,"_20482":54263,"_5":14053,"_26831":54201,"_2843":54264},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3355":2035,"_29485":2006,"_20482":54266,"_5":14053,"_26831":54205,"_2843":54267},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3355":2036,"_29485":2006,"_20482":54269,"_5":14053,"_26831":54205,"_2843":54270},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3355":2037,"_29485":2006,"_20482":54272,"_5":14053,"_26831":54205,"_2843":54273},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3355":2038,"_29485":2006,"_20482":54275,"_5":14053,"_26831":54209,"_2843":54276},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3355":2039,"_29485":2006,"_20482":54278,"_5":14053,"_26831":54209,"_2843":54279},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3355":2040,"_29485":2040,"_5":14411,"_2843":54281,"_29817":54282,"_20482":54284,"_26831":2040},"Certificate lifecycle",[47939,49407,53416,54283],"Concepts",[],{"_3355":2041,"_29485":2040,"_20482":54286,"_5":14053,"_26831":2040,"_2843":54287},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3355":2042,"_29485":2040,"_5":29814,"_20482":54289,"_26831":54290,"_2843":54291},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3355":2043,"_29485":2040,"_5":29814,"_20482":54293,"_26831":54294,"_2843":54295},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3355":2044,"_29485":2040,"_5":29814,"_20482":54297,"_26831":54298,"_2843":54299},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3355":2045,"_29485":2040,"_5":29814,"_20482":54301,"_26831":54302,"_2843":54303},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3355":2046,"_29485":2040,"_5":29814,"_20482":54305,"_26831":54306,"_2843":54307},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3355":2047,"_29485":2040,"_5":29814,"_20482":54309,"_26831":54310,"_2843":54311},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3355":2048,"_29485":2040,"_5":29814,"_20482":54313,"_26831":54314,"_2843":54315},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3355":2049,"_29485":2040,"_5":29814,"_20482":54317,"_26831":54318,"_2843":54319},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3355":2050,"_29485":2040,"_5":29814,"_20482":54321,"_26831":54322,"_2843":54323},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3355":2051,"_29485":2040,"_5":29814,"_20482":54325,"_26831":54326,"_2843":54327},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3355":2052,"_29485":2040,"_20482":54329,"_5":14053,"_26831":2040,"_2843":54330},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3355":2053,"_29485":2040,"_20482":54332,"_5":14053,"_26831":54294,"_2843":54333},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3355":2054,"_29485":2040,"_20482":54335,"_5":14053,"_26831":54298,"_2843":54336},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3355":2055,"_29485":2040,"_20482":54338,"_5":14053,"_26831":54302,"_2843":54339},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3355":2056,"_29485":2040,"_20482":54341,"_5":14053,"_26831":54306,"_2843":54342},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3355":2057,"_29485":2040,"_20482":54344,"_5":14053,"_26831":54310,"_2843":54345},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3355":2058,"_29485":2040,"_20482":54347,"_5":14053,"_26831":54314,"_2843":54348},[],"Lamassu persists four X.509 states:",{"_3355":2059,"_29485":2040,"_20482":54350,"_5":14053,"_26831":54314,"_2843":54351},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3355":2060,"_29485":2040,"_20482":54353,"_5":14053,"_26831":54314,"_2843":54354},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3355":2061,"_29485":2040,"_20482":54356,"_5":14053,"_26831":54314,"_2843":54357},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3355":2062,"_29485":2040,"_20482":54359,"_5":14053,"_26831":54314,"_2843":54360},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3355":2063,"_29485":2040,"_20482":54362,"_5":14053,"_26831":54314,"_2843":54363},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3355":2064,"_29485":2040,"_20482":54365,"_5":14053,"_26831":54318,"_2843":54366},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3355":2065,"_29485":2040,"_20482":54368,"_5":14053,"_26831":54318,"_2843":54369},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3355":2066,"_29485":2040,"_20482":54371,"_5":14053,"_26831":54318,"_2843":54372},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3355":2067,"_29485":2040,"_20482":54374,"_5":14053,"_26831":54322,"_2843":54375},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3355":2068,"_29485":2040,"_20482":54377,"_5":14053,"_26831":54322,"_2843":54378},[],"Before confirming:",{"_3355":2069,"_29485":2040,"_20482":54380,"_5":14053,"_26831":54322,"_2843":54381},[],"Identify DMSs, devices and services that trust that chain.",{"_3355":2070,"_29485":2040,"_20482":54383,"_5":14053,"_26831":54322,"_2843":54384},[],"Distribute the new chain of trust.",{"_3355":2071,"_29485":2040,"_20482":54386,"_5":14053,"_26831":54322,"_2843":54387},[],"Reissue the necessary identities.",{"_3355":2072,"_29485":2040,"_20482":54389,"_5":14053,"_26831":54322,"_2843":54390},[],"Check OCSP and CRL from a real consumer.",{"_3355":2073,"_29485":2040,"_20482":54392,"_5":14053,"_26831":54322,"_2843":54393},[],"Revoke the old CA once no legitimate traffic remains.",{"_3355":2074,"_29485":2040,"_20482":54395,"_5":14053,"_26831":54322,"_2843":54396},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3355":2075,"_29485":2040,"_20482":54398,"_5":14053,"_26831":54326,"_2843":54399},[],"Certificates entering the preventive or critical renewal window.",{"_3355":2076,"_29485":2040,"_20482":54401,"_5":14053,"_26831":54326,"_2843":54402},[],"Repeated enrollment or re-enrollment failures.",{"_3355":2077,"_29485":2040,"_20482":54404,"_5":14053,"_26831":54326,"_2843":54405},[],"Status changes and revocation reasons.",{"_3355":2078,"_29485":2040,"_20482":54407,"_5":14053,"_26831":54326,"_2843":54408},[],"OCSP and CRL publication and validity.",{"_3355":2079,"_29485":2040,"_20482":54410,"_5":14053,"_26831":54326,"_2843":54411},[],"Dependencies still presenting a replaced certificate.",{"_3355":2080,"_29485":2040,"_20482":54413,"_5":14053,"_26831":54326,"_2843":54414},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3355":2081,"_29485":2081,"_5":14411,"_2843":54416,"_29817":54417,"_20482":54418,"_26831":2081},"Trust model",[47939,49407,53416,54283],[],{"_3355":2082,"_29485":2081,"_20482":54420,"_5":14053,"_26831":2081,"_2843":54421},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3355":2083,"_29485":2081,"_5":29814,"_20482":54423,"_26831":54424,"_2843":54425},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3355":2084,"_29485":2081,"_5":29814,"_20482":54427,"_26831":54428,"_2843":54429},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3355":2085,"_29485":2081,"_5":29814,"_20482":54431,"_26831":54432,"_2843":54433},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3355":2086,"_29485":2081,"_5":29814,"_20482":54435,"_26831":54436,"_2843":54437},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3355":2087,"_29485":2081,"_5":29814,"_20482":54439,"_26831":54440,"_2843":54441},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3355":2088,"_29485":2081,"_5":29814,"_20482":54443,"_26831":54444,"_2843":54445},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3355":2089,"_29485":2081,"_5":29814,"_20482":54447,"_26831":54448,"_2843":54449},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3355":2090,"_29485":2081,"_5":29814,"_20482":54451,"_26831":54452,"_2843":54453},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3355":2091,"_29485":2081,"_5":29814,"_20482":54455,"_26831":54456,"_2843":54457},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3355":2092,"_29485":2081,"_5":29814,"_20482":54459,"_26831":54460,"_2843":54461},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3355":2093,"_29485":2081,"_20482":54463,"_5":14053,"_26831":2081,"_2843":54464},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3355":2094,"_29485":2081,"_20482":54466,"_5":14053,"_26831":54428,"_2843":54467},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3355":2095,"_29485":2081,"_20482":54469,"_5":14053,"_26831":54432,"_2843":54470},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3355":2096,"_29485":2081,"_20482":54472,"_5":14053,"_26831":54436,"_2843":54473},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3355":2097,"_29485":2081,"_20482":54475,"_5":14053,"_26831":54440,"_2843":54476},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3355":2098,"_29485":2081,"_20482":54478,"_5":14053,"_26831":54444,"_2843":54479},[],"The device proves it can enroll according to the DMS policy.",{"_3355":2099,"_29485":2081,"_20482":54481,"_5":14053,"_26831":54444,"_2843":54482},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3355":2100,"_29485":2081,"_20482":54484,"_5":14053,"_26831":54444,"_2843":54485},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3355":2101,"_29485":2081,"_20482":54487,"_5":14053,"_26831":54444,"_2843":54488},[],"The device installs the certificate and the chain it needs.",{"_3355":2102,"_29485":2081,"_20482":54490,"_5":14053,"_26831":54444,"_2843":54491},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3355":2103,"_29485":2081,"_20482":54493,"_5":14053,"_26831":54444,"_2843":54494},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3355":2104,"_29485":2081,"_20482":54496,"_5":14053,"_26831":54448,"_2843":54497},[],"A DMS relates three sets that are worth designing separately:",{"_3355":2105,"_29485":2081,"_20482":54499,"_5":14053,"_26831":54448,"_2843":54500},[],"**Enrollment CA:** signs the new identities.",{"_3355":2106,"_29485":2081,"_20482":54502,"_5":14053,"_26831":54448,"_2843":54503},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3355":2107,"_29485":2081,"_20482":54505,"_5":14053,"_26831":54448,"_2843":54506},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3355":2108,"_29485":2081,"_20482":54508,"_5":14053,"_26831":54448,"_2843":54509},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3355":2109,"_29485":2081,"_20482":54511,"_5":14053,"_26831":54452,"_2843":54512},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3355":2110,"_29485":2081,"_20482":54514,"_5":14053,"_26831":54452,"_2843":54515},[],"that the current date is between `Not Before` and `Not After`;",{"_3355":2111,"_29485":2081,"_20482":54517,"_5":14053,"_26831":54452,"_2843":54518},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3355":2112,"_29485":2081,"_20482":54520,"_5":14053,"_26831":54452,"_2843":54521},[],"that names, SANs and subject match the expected identity;",{"_3355":2113,"_29485":2081,"_20482":54523,"_5":14053,"_26831":54452,"_2843":54524},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3355":2114,"_29485":2081,"_20482":54526,"_5":14053,"_26831":54452,"_2843":54527},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3355":2115,"_29485":2081,"_20482":54529,"_5":14053,"_26831":54452,"_2843":54530},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3355":2116,"_29485":2081,"_20482":54532,"_5":14053,"_26831":54456,"_2843":54533},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3355":2117,"_29485":2081,"_20482":54535,"_5":14053,"_26831":54460,"_2843":54536},[],"Keep the root out of daily operations, or with very restricted access.",{"_3355":2118,"_29485":2081,"_20482":54538,"_5":14053,"_26831":54460,"_2843":54539},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3355":2119,"_29485":2081,"_20482":54541,"_5":14053,"_26831":54460,"_2843":54542},[],"Assign explicit profiles to every use case.",{"_3355":2120,"_29485":2081,"_20482":54544,"_5":14053,"_26831":54460,"_2843":54545},[],"Distribute the new trust before starting a rotation.",{"_3355":2121,"_29485":2081,"_20482":54547,"_5":14053,"_26831":54460,"_2843":54548},[],"Keep enough overlap to renew a disconnected fleet.",{"_3355":2122,"_29485":2081,"_20482":54550,"_5":14053,"_26831":54460,"_2843":54551},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3355":2123,"_29485":2081,"_20482":54553,"_5":14053,"_26831":54460,"_2843":54554},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3355":2124,"_29485":2124,"_5":14411,"_2843":54556,"_29817":54557,"_20482":54558,"_26831":2124},"Revocation lists (CRL)",[47939,49407,53416,54043],[],{"_3355":2125,"_29485":2124,"_20482":54560,"_5":14053,"_26831":2124,"_2843":54561},[],"Generate and distribute signed lists to validate certificates offline.",{"_3355":2126,"_29485":2124,"_5":29814,"_20482":54563,"_26831":54564,"_2843":54565},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3355":2127,"_29485":2124,"_5":29814,"_20482":54567,"_26831":54568,"_2843":54569},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3355":2128,"_29485":2124,"_5":29814,"_20482":54571,"_26831":54572,"_2843":54573},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3355":2129,"_29485":2124,"_5":29814,"_20482":54575,"_26831":54576,"_2843":54577},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3355":2130,"_29485":2124,"_5":29814,"_20482":54579,"_26831":54580,"_2843":54581},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3355":2131,"_29485":2124,"_5":29814,"_20482":54583,"_26831":54584,"_2843":54585},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3355":2132,"_29485":2124,"_5":29814,"_20482":54587,"_26831":54588,"_2843":54589},[],"/docs/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3355":2133,"_29485":2124,"_5":29814,"_20482":54591,"_26831":54592,"_2843":54593},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3355":2134,"_29485":2124,"_5":29814,"_20482":54595,"_26831":54596,"_2843":54597},[],"/docs/platform/pki/crl#references","References",{"_3355":2135,"_29485":2124,"_20482":54599,"_5":14053,"_26831":2124,"_2843":54600},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3355":2136,"_29485":2124,"_20482":54602,"_5":14053,"_26831":54564,"_2843":54603},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3355":2137,"_29485":2124,"_20482":54605,"_5":14053,"_26831":54564,"_2843":54606},[],"`crl_options` field",{"_3355":2138,"_29485":2124,"_20482":54608,"_5":14053,"_26831":54564,"_2843":48329},[],{"_3355":2139,"_29485":2124,"_20482":54610,"_5":14053,"_26831":54564,"_2843":54611},[],"Backend initial value",{"_3355":2140,"_29485":2124,"_20482":54613,"_5":14053,"_26831":54564,"_2843":54614},[],"`validity`",{"_3355":2141,"_29485":2124,"_20482":54616,"_5":14053,"_26831":54564,"_2843":54617},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3355":2142,"_29485":2124,"_20482":54619,"_5":14053,"_26831":54564,"_2843":54620},[],"7 days.",{"_3355":2143,"_29485":2124,"_20482":54622,"_5":14053,"_26831":54564,"_2843":54623},[],"`refresh_interval`",{"_3355":2144,"_29485":2124,"_20482":54625,"_5":14053,"_26831":54564,"_2843":54626},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3355":2145,"_29485":2124,"_20482":54628,"_5":14053,"_26831":54564,"_2843":54629},[],"6 days and 23 hours.",{"_3355":2146,"_29485":2124,"_20482":54631,"_5":14053,"_26831":54564,"_2843":54632},[],"`regenerate_on_revoke`",{"_3355":2147,"_29485":2124,"_20482":54634,"_5":14053,"_26831":54564,"_2843":54635},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3355":2148,"_29485":2124,"_20482":54637,"_5":14053,"_26831":54564,"_2843":54638},[],"`true`.",{"_3355":2149,"_29485":2124,"_20482":54640,"_5":14053,"_26831":54564,"_2843":54641},[],"`signer_certificate_serial_number`",{"_3355":2150,"_29485":2124,"_20482":54643,"_5":14053,"_26831":54564,"_2843":54644},[],"Serial number of the existing certificate that signs the CRL.",{"_3355":2151,"_29485":2124,"_20482":54646,"_5":14053,"_26831":54564,"_2843":54647},[],"Serial number of the CA’s current certificate.",{"_3355":2152,"_29485":2124,"_20482":54649,"_5":14053,"_26831":54564,"_2843":54650},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3355":2153,"_29485":2124,"_20482":54652,"_5":14053,"_26831":54564,"_2843":54653},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3355":2154,"_29485":2124,"_20482":54655,"_5":14053,"_26831":54564,"_2843":54656},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3355":2155,"_29485":2124,"_20482":54658,"_5":14053,"_26831":54564,"_2843":54659},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3355":2156,"_29485":2124,"_20482":54661,"_5":14053,"_26831":54564,"_2843":54662},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3355":2157,"_29485":2124,"_20482":54664,"_5":14053,"_26831":54564,"_2843":54665},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3355":2158,"_29485":2124,"_20482":54667,"_5":14053,"_26831":54568,"_2843":54668},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3355":2159,"_29485":2124,"_20482":54670,"_5":14053,"_26831":54568,"_2843":54671},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3355":2160,"_29485":2124,"_20482":54673,"_5":14053,"_26831":54568,"_2843":54674},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3355":2161,"_29485":2124,"_20482":54676,"_5":14053,"_26831":54568,"_2843":54677},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3355":2162,"_29485":2124,"_20482":54679,"_5":14053,"_26831":54572,"_2843":54680},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3355":2163,"_29485":2124,"_20482":54682,"_5":14053,"_26831":54572,"_2843":54683},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3355":2164,"_29485":2124,"_20482":54685,"_5":14053,"_26831":54572,"_2843":54686},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3355":2165,"_29485":2124,"_20482":54688,"_5":14053,"_26831":54572,"_2843":54689},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3355":2166,"_29485":2124,"_20482":54691,"_5":14053,"_26831":54576,"_2843":54692},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3355":2167,"_29485":2124,"_20482":54694,"_5":14053,"_26831":54576,"_2843":54695},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3355":2168,"_29485":2124,"_20482":54697,"_5":14053,"_26831":54580,"_2843":54698},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3355":2169,"_29485":2124,"_20482":54700,"_5":14053,"_26831":54580,"_2843":54701},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3355":2170,"_29485":2124,"_20482":54703,"_5":14053,"_26831":54580,"_2843":54704},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3355":2171,"_29485":2124,"_20482":54706,"_5":14053,"_26831":54580,"_2843":54707},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3355":2172,"_29485":2124,"_20482":54709,"_5":14053,"_26831":54580,"_2843":54710},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3355":2173,"_29485":2124,"_20482":54712,"_5":14053,"_26831":54584,"_2843":54713},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3355":2174,"_29485":2124,"_20482":54715,"_5":14053,"_26831":54584,"_2843":51174},[],{"_3355":2175,"_29485":2124,"_20482":54717,"_5":14053,"_26831":54584,"_2843":54718},[],"Relative path",{"_3355":2176,"_29485":2124,"_20482":54720,"_5":14053,"_26831":54584,"_2843":51171},[],{"_3355":2177,"_29485":2124,"_20482":54722,"_5":14053,"_26831":54584,"_2843":54723},[],"`GET`",{"_3355":2178,"_29485":2124,"_20482":54725,"_5":14053,"_26831":54584,"_2843":54726},[],"`/v1/roles/{ca-ski}`",{"_3355":2179,"_29485":2124,"_20482":54728,"_5":14053,"_26831":54584,"_2843":54729},[],"Read `crl_options` and `latest_crl`.",{"_3355":2180,"_29485":2124,"_20482":54731,"_5":14053,"_26831":54584,"_2843":54732},[],"`PUT`",{"_3355":2181,"_29485":2124,"_20482":54734,"_5":14053,"_26831":54584,"_2843":54726},[],{"_3355":2182,"_29485":2124,"_20482":54736,"_5":14053,"_26831":54584,"_2843":54737},[],"Replace CRL configuration.",{"_3355":2183,"_29485":2124,"_20482":54739,"_5":14053,"_26831":54584,"_2843":54740},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3355":2184,"_29485":2124,"_20482":54742,"_5":14053,"_26831":54584,"_2843":54743},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3355":2185,"_29485":2124,"_20482":54745,"_5":14053,"_26831":54588,"_2843":54746},[],"Symptom",{"_3355":2186,"_29485":2124,"_20482":54748,"_5":14053,"_26831":54588,"_2843":54749},[],"Cause",{"_3355":2187,"_29485":2124,"_20482":54751,"_5":14053,"_26831":54588,"_2843":54752},[],"Action",{"_3355":2188,"_29485":2124,"_20482":54754,"_5":14053,"_26831":54588,"_2843":54755},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3355":2189,"_29485":2124,"_20482":54757,"_5":14053,"_26831":54588,"_2843":54758},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3355":2190,"_29485":2124,"_20482":54760,"_5":14053,"_26831":54588,"_2843":54761},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3355":2191,"_29485":2124,"_20482":54763,"_5":14053,"_26831":54588,"_2843":54764},[],"`PUT` returns 400.",{"_3355":2192,"_29485":2124,"_20482":54766,"_5":14053,"_26831":54588,"_2843":54767},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3355":2193,"_29485":2124,"_20482":54769,"_5":14053,"_26831":54588,"_2843":54770},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3355":2194,"_29485":2124,"_20482":54772,"_5":14053,"_26831":54588,"_2843":54773},[],"`PUT` returns 400 from a 3.x client.",{"_3355":2195,"_29485":2124,"_20482":54775,"_5":14053,"_26831":54588,"_2843":54776},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3355":2196,"_29485":2124,"_20482":54778,"_5":14053,"_26831":54588,"_2843":54779},[],"Update the client to send the new field.",{"_3355":2197,"_29485":2124,"_20482":54781,"_5":14053,"_26831":54588,"_2843":54782},[],"The CRL does not change after revoking a certificate.",{"_3355":2198,"_29485":2124,"_20482":54784,"_5":14053,"_26831":54588,"_2843":54785},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3355":2199,"_29485":2124,"_20482":54787,"_5":14053,"_26831":54588,"_2843":54788},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3355":2200,"_29485":2124,"_20482":54790,"_5":14053,"_26831":54588,"_2843":54791},[],"A verifier rejects the CRL because of the issuer.",{"_3355":2201,"_29485":2124,"_20482":54793,"_5":14053,"_26831":54588,"_2843":54794},[],"Several CAs share an SKI.",{"_3355":2202,"_29485":2124,"_20482":54796,"_5":14053,"_26831":54588,"_2843":54797},[],"See CAs that share a key.",{"_3355":2203,"_29485":2124,"_20482":54799,"_5":14053,"_26831":54592,"_2843":54800},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3355":2204,"_29485":2124,"_20482":54802,"_5":14053,"_26831":54596,"_2843":54803},[],"RFC 5280: X.509 and CRL profile.",{"_3355":2205,"_29485":2124,"_20482":54805,"_5":14053,"_26831":54596,"_2843":54806},[],"OpenSSL: openssl-crl.",{"_3355":2206,"_29485":2124,"_20482":54808,"_5":14053,"_26831":54596,"_2843":54809},[],"OpenSSL: openssl-verify.",{"_3355":2207,"_29485":2124,"_20482":54811,"_5":14053,"_26831":54596,"_2843":54812},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3355":2208,"_29485":2124,"_20482":54814,"_5":14053,"_26831":54596,"_2843":54815},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3355":2209,"_29485":2209,"_5":14411,"_2843":54817,"_29817":54818,"_20482":54819,"_26831":2209},"Keys and cryptographic engines",[47939,49407,53416,53417],[],{"_3355":2210,"_29485":2209,"_20482":54821,"_5":14053,"_26831":2209,"_2843":54822},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3355":2211,"_29485":2209,"_5":29814,"_20482":54824,"_26831":54825,"_2843":54826},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3355":2212,"_29485":2209,"_5":29814,"_20482":54828,"_26831":54829,"_2843":54830},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3355":2213,"_29485":2209,"_5":29814,"_20482":54832,"_26831":54833,"_2843":54834},[],"/docs/platform/pki/key-management#file-system","File System",{"_3355":2214,"_29485":2209,"_5":29814,"_20482":54836,"_26831":54837,"_2843":54838},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3355":2215,"_29485":2209,"_5":29814,"_20482":54840,"_26831":54841,"_2843":54842},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3355":2216,"_29485":2209,"_5":29814,"_20482":54844,"_26831":54845,"_2843":54846},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3355":2217,"_29485":2209,"_5":29814,"_20482":54848,"_26831":54849,"_2843":54850},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3355":2218,"_29485":2209,"_5":29814,"_20482":54852,"_26831":54853,"_2843":54854},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3355":2219,"_29485":2209,"_5":29814,"_20482":54856,"_26831":54857,"_2843":54858},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3355":2220,"_29485":2209,"_5":29814,"_20482":54860,"_26831":54861,"_2843":54862},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3355":2221,"_29485":2209,"_5":29814,"_20482":54864,"_26831":54865,"_2843":54866},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3355":2222,"_29485":2209,"_5":29814,"_20482":54868,"_26831":54869,"_2843":54870},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3355":2223,"_29485":2209,"_5":29814,"_20482":54872,"_26831":54873,"_2843":54874},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3355":2224,"_29485":2209,"_5":29814,"_20482":54876,"_26831":54877,"_2843":54878},[],"/docs/platform/pki/key-management#view-details","View details",{"_3355":2225,"_29485":2209,"_5":29814,"_20482":54880,"_26831":54881,"_2843":54882},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3355":2226,"_29485":2209,"_5":29814,"_20482":54884,"_26831":54885,"_2843":54886},[],"/docs/platform/pki/key-management#sign","Sign",{"_3355":2227,"_29485":2209,"_5":29814,"_20482":54888,"_26831":54889,"_2843":54890},[],"/docs/platform/pki/key-management#verify","Verify",{"_3355":2228,"_29485":2209,"_5":29814,"_20482":54892,"_26831":54893,"_2843":54894},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3355":2229,"_29485":2209,"_5":29814,"_20482":54896,"_26831":54897,"_2843":54898},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3355":2230,"_29485":2209,"_5":29814,"_20482":54900,"_26831":54901,"_2843":54902},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3355":2231,"_29485":2209,"_20482":54904,"_5":14053,"_26831":2209,"_2843":54905},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3355":2232,"_29485":2209,"_20482":54907,"_5":14053,"_26831":2209,"_2843":54908},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3355":2233,"_29485":2209,"_20482":54910,"_5":14053,"_26831":54825,"_2843":54911},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3355":2234,"_29485":2209,"_20482":54913,"_5":14053,"_26831":54825,"_2843":54914},[],"In practice, it lets you:",{"_3355":2235,"_29485":2209,"_20482":54916,"_5":14053,"_26831":54825,"_2843":54917},[],"Generate new key pairs from Lamassu IoT.",{"_3355":2236,"_29485":2209,"_20482":54919,"_5":14053,"_26831":54825,"_2843":54920},[],"Import keys created externally.",{"_3355":2237,"_29485":2209,"_20482":54922,"_5":14053,"_26831":54825,"_2843":54923},[],"Delegate custody and cryptographic operations to external engines.",{"_3355":2238,"_29485":2209,"_20482":54925,"_5":14053,"_26831":54825,"_2843":54926},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3355":2239,"_29485":2209,"_20482":54928,"_5":14053,"_26831":54829,"_2843":54929},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3355":2240,"_29485":2209,"_20482":54931,"_5":14053,"_26831":54829,"_2843":54932},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3355":2241,"_29485":2209,"_20482":54934,"_5":14053,"_26831":54829,"_2843":54935},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3355":2242,"_29485":2209,"_20482":54937,"_5":14053,"_26831":54833,"_2843":54938},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3355":2243,"_29485":2209,"_20482":54940,"_5":14053,"_26831":54837,"_2843":54941},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3355":2244,"_29485":2209,"_20482":54943,"_5":14053,"_26831":54837,"_2843":54944},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3355":2245,"_29485":2209,"_20482":54946,"_5":14053,"_26831":54841,"_2843":54947},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3355":2246,"_29485":2209,"_20482":54949,"_5":14053,"_26831":54845,"_2843":54950},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3355":2247,"_29485":2209,"_20482":54952,"_5":14053,"_26831":54849,"_2843":54953},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3355":2248,"_29485":2209,"_20482":54955,"_5":14053,"_26831":54853,"_2843":54956},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3355":2249,"_29485":2209,"_20482":54958,"_5":14053,"_26831":54853,"_2843":54959},[],"Lamassu shows the enabled engines in the console.",{"_3355":2250,"_29485":2209,"_20482":54961,"_5":14053,"_26831":54853,"_2843":54962},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3355":2251,"_29485":2209,"_20482":54964,"_5":14053,"_26831":54853,"_2843":54965},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3355":2252,"_29485":2209,"_20482":54967,"_5":14053,"_26831":54857,"_2843":54968},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3355":2253,"_29485":2209,"_20482":54970,"_5":14053,"_26831":54857,"_2843":54971},[],"The table includes the following fields:",{"_3355":2254,"_29485":2209,"_20482":54973,"_5":14053,"_26831":54857,"_2843":54974},[],"**Name**: descriptive name of the key.",{"_3355":2255,"_29485":2209,"_20482":54976,"_5":14053,"_26831":54857,"_2843":54977},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3355":2256,"_29485":2209,"_20482":54979,"_5":14053,"_26831":54857,"_2843":54980},[],"**Strength**: visual indicator of cryptographic strength.",{"_3355":2257,"_29485":2209,"_20482":54982,"_5":14053,"_26831":54857,"_2843":54983},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3355":2258,"_29485":2209,"_20482":54985,"_5":14053,"_26831":54857,"_2843":54986},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3355":2259,"_29485":2209,"_20482":54988,"_5":14053,"_26831":54857,"_2843":54989},[],"**Aliases**: alternative names associated with the key.",{"_3355":2260,"_29485":2209,"_20482":54991,"_5":14053,"_26831":54857,"_2843":54992},[],"**Tags**: labels for classification and search.",{"_3355":2261,"_29485":2209,"_20482":54994,"_5":14053,"_26831":54857,"_2843":54995},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3355":2262,"_29485":2209,"_20482":54997,"_5":14053,"_26831":54857,"_2843":54998},[],"From this view you also reach the most common actions:",{"_3355":2263,"_29485":2209,"_20482":55000,"_5":14053,"_26831":54857,"_2843":55001},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3355":2264,"_29485":2209,"_20482":55003,"_5":14053,"_26831":54857,"_2843":55004},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3355":2265,"_29485":2209,"_20482":55006,"_5":14053,"_26831":54857,"_2843":55007},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3355":2266,"_29485":2209,"_20482":55009,"_5":14053,"_26831":54857,"_2843":55010},[],"**Delete Key** to remove the key from the system.",{"_3355":2267,"_29485":2209,"_20482":55012,"_5":14053,"_26831":54861,"_2843":55013},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3355":2268,"_29485":2209,"_20482":55015,"_5":14053,"_26831":54865,"_2843":55016},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3355":2269,"_29485":2209,"_20482":55018,"_5":14053,"_26831":54865,"_2843":55019},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3355":2270,"_29485":2209,"_20482":55021,"_5":14053,"_26831":54865,"_2843":55022},[],"**Key Name**: unique and descriptive name.",{"_3355":2271,"_29485":2209,"_20482":55024,"_5":14053,"_26831":54865,"_2843":55025},[],"**Crypto Engine**: engine that will keep the key.",{"_3355":2272,"_29485":2209,"_20482":55027,"_5":14053,"_26831":54865,"_2843":55028},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3355":2273,"_29485":2209,"_20482":55030,"_5":14053,"_26831":54865,"_2843":55031},[],"**Tags**: metadata to classify the key.",{"_3355":2274,"_29485":2209,"_20482":55033,"_5":14053,"_26831":54865,"_2843":55034},[],"**Metadata**: additional information for advanced uses.",{"_3355":2275,"_29485":2209,"_20482":55036,"_5":14053,"_26831":54869,"_2843":55037},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3355":2276,"_29485":2209,"_20482":55039,"_5":14053,"_26831":54869,"_2843":55040},[],"When you have an exportable private key and the destination engine supports import.",{"_3355":2277,"_29485":2209,"_20482":55042,"_5":14053,"_26831":54869,"_2843":55043},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3355":2278,"_29485":2209,"_20482":55045,"_5":14053,"_26831":54869,"_2843":55046},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3355":2279,"_29485":2209,"_20482":55048,"_5":14053,"_26831":54869,"_2843":55049},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3355":2280,"_29485":2209,"_20482":55051,"_5":14053,"_26831":54869,"_2843":55052},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3355":2281,"_29485":2209,"_20482":55054,"_5":14053,"_26831":54869,"_2843":55055},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3355":2282,"_29485":2209,"_20482":55057,"_5":14053,"_26831":54869,"_2843":55058},[],"**Tags**: labels for organization and search.",{"_3355":2283,"_29485":2209,"_20482":55060,"_5":14053,"_26831":54869,"_2843":55061},[],"**Metadata**: additional optional information.",{"_3355":2284,"_29485":2209,"_20482":55063,"_5":14053,"_26831":54869,"_2843":55064},[],"**Private Key (PEM)**: private key in PEM format.",{"_3355":2285,"_29485":2209,"_20482":55066,"_5":14053,"_26831":54869,"_2843":55067},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3355":2286,"_29485":2209,"_20482":55069,"_5":14053,"_26831":54873,"_2843":55070},[],"Each registered key has a detail view and several operational actions.",{"_3355":2287,"_29485":2209,"_20482":55072,"_5":14053,"_26831":54877,"_2843":55073},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3355":2288,"_29485":2209,"_20482":55075,"_5":14053,"_26831":54877,"_2843":55076},[],"The **Overview** tab shows, among others, these fields:",{"_3355":2289,"_29485":2209,"_20482":55078,"_5":14053,"_26831":54877,"_2843":55079},[],"**Key Name**: descriptive name.",{"_3355":2290,"_29485":2209,"_20482":55081,"_5":14053,"_26831":54877,"_2843":55082},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3355":2291,"_29485":2209,"_20482":55084,"_5":14053,"_26831":54877,"_2843":55085},[],"**Tags**: associated labels.",{"_3355":2292,"_29485":2209,"_20482":55087,"_5":14053,"_26831":54877,"_2843":55088},[],"**Aliases**: alternative names.",{"_3355":2293,"_29485":2209,"_20482":55090,"_5":14053,"_26831":54877,"_2843":55091},[],"**Crypto Engine**: engine where the key resides.",{"_3355":2294,"_29485":2209,"_20482":55093,"_5":14053,"_26831":54877,"_2843":55094},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3355":2295,"_29485":2209,"_20482":55096,"_5":14053,"_26831":54877,"_2843":55097},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3355":2296,"_29485":2209,"_20482":55099,"_5":14053,"_26831":54877,"_2843":55100},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3355":2297,"_29485":2209,"_20482":55102,"_5":14053,"_26831":54881,"_2843":55103},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3355":2298,"_29485":2209,"_20482":55105,"_5":14053,"_26831":54881,"_2843":55106},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3355":2299,"_29485":2209,"_20482":55108,"_5":14053,"_26831":54881,"_2843":55109},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3355":2300,"_29485":2209,"_20482":55111,"_5":14053,"_26831":54885,"_2843":55112},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3355":2301,"_29485":2209,"_20482":55114,"_5":14053,"_26831":54885,"_2843":55115},[],"Main fields:",{"_3355":2302,"_29485":2209,"_20482":55117,"_5":14053,"_26831":54885,"_2843":55118},[],"**Algorithm**: signing algorithm available for the key type.",{"_3355":2303,"_29485":2209,"_20482":55120,"_5":14053,"_26831":54885,"_2843":55121},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3355":2304,"_29485":2209,"_20482":55123,"_5":14053,"_26831":54885,"_2843":55124},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3355":2305,"_29485":2209,"_20482":55126,"_5":14053,"_26831":54885,"_2843":55127},[],"**Message**: content to sign.",{"_3355":2306,"_29485":2209,"_20482":55129,"_5":14053,"_26831":54885,"_2843":55130},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3355":2307,"_29485":2209,"_20482":55132,"_5":14053,"_26831":54889,"_2843":55133},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3355":2308,"_29485":2209,"_20482":55135,"_5":14053,"_26831":54889,"_2843":55115},[],{"_3355":2309,"_29485":2209,"_20482":55137,"_5":14053,"_26831":54889,"_2843":55138},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3355":2310,"_29485":2209,"_20482":55140,"_5":14053,"_26831":54889,"_2843":55141},[],"**Message Type**: `Raw` or `Digest`.",{"_3355":2311,"_29485":2209,"_20482":55143,"_5":14053,"_26831":54889,"_2843":55144},[],"**Payload Encoding**: encoding of the message.",{"_3355":2312,"_29485":2209,"_20482":55146,"_5":14053,"_26831":54889,"_2843":55147},[],"**Message**: original message or hash.",{"_3355":2313,"_29485":2209,"_20482":55149,"_5":14053,"_26831":54889,"_2843":55150},[],"**Signature**: signature to check.",{"_3355":2314,"_29485":2209,"_20482":55152,"_5":14053,"_26831":54889,"_2843":55153},[],"**Result**: indicator of the validation result.",{"_3355":2315,"_29485":2209,"_20482":55155,"_5":14053,"_26831":54893,"_2843":55156},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3355":2316,"_29485":2209,"_20482":55158,"_5":14053,"_26831":54893,"_2843":55159},[],"This flow is useful for:",{"_3355":2317,"_29485":2209,"_20482":55161,"_5":14053,"_26831":54893,"_2843":55162},[],"Requesting certificates from an external CA.",{"_3355":2318,"_29485":2209,"_20482":55164,"_5":14053,"_26831":54893,"_2843":55165},[],"Renewing an identity while keeping the same key.",{"_3355":2319,"_29485":2209,"_20482":55167,"_5":14053,"_26831":54893,"_2843":55168},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3355":2320,"_29485":2209,"_20482":55170,"_5":14053,"_26831":54893,"_2843":55171},[],"**Common Name (CN)**: main name of the identity.",{"_3355":2321,"_29485":2209,"_20482":55173,"_5":14053,"_26831":54893,"_2843":55174},[],"**Organization (O)**: organization or company.",{"_3355":2322,"_29485":2209,"_20482":55176,"_5":14053,"_26831":54893,"_2843":55177},[],"**Organizational Unit (OU)**: department or unit.",{"_3355":2323,"_29485":2209,"_20482":55179,"_5":14053,"_26831":54893,"_2843":55180},[],"**Country (C)**: two-letter country code.",{"_3355":2324,"_29485":2209,"_20482":55182,"_5":14053,"_26831":54893,"_2843":55183},[],"**State / Province (ST)**: state or province.",{"_3355":2325,"_29485":2209,"_20482":55185,"_5":14053,"_26831":54893,"_2843":55186},[],"**Locality (L)**: city or locality.",{"_3355":2326,"_29485":2209,"_20482":55188,"_5":14053,"_26831":54893,"_2843":55189},[],"**Email Address**: contact email.",{"_3355":2327,"_29485":2209,"_20482":55191,"_5":14053,"_26831":54893,"_2843":55192},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3355":2328,"_29485":2209,"_20482":55194,"_5":14053,"_26831":54893,"_2843":55195},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3355":2329,"_29485":2209,"_20482":55197,"_5":14053,"_26831":54897,"_2843":55198},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3355":2330,"_29485":2209,"_20482":55200,"_5":14053,"_26831":54897,"_2843":55201},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3355":2331,"_29485":2209,"_20482":55203,"_5":14053,"_26831":54901,"_2843":55204},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3355":2332,"_29485":2332,"_5":14411,"_2843":55206,"_29817":55207,"_20482":55208,"_26831":2332},"Online validation with OCSP",[47939,49407,53416,54043],[],{"_3355":2333,"_29485":2332,"_20482":55210,"_5":14053,"_26831":2332,"_2843":55211},[],"Query signed status and verify the responder’s response.",{"_3355":2334,"_29485":2332,"_5":29814,"_20482":55213,"_26831":55214,"_2843":55215},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3355":2335,"_29485":2332,"_5":29814,"_20482":55217,"_26831":55218,"_2843":55219},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3355":2336,"_29485":2332,"_5":29814,"_20482":55221,"_26831":55222,"_2843":55223},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3355":2337,"_29485":2332,"_5":29814,"_20482":55225,"_26831":55226,"_2843":55227},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3355":2338,"_29485":2332,"_5":29814,"_20482":55229,"_26831":55230,"_2843":55231},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3355":2339,"_29485":2332,"_5":29814,"_20482":55233,"_26831":55234,"_2843":54597},[],"/docs/platform/pki/ocsp#references",{"_3355":2340,"_29485":2332,"_20482":55236,"_5":14053,"_26831":2332,"_2843":55237},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3355":2341,"_29485":2332,"_20482":55239,"_5":14053,"_26831":55214,"_2843":55240},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3355":2342,"_29485":2332,"_20482":55242,"_5":14053,"_26831":55214,"_2843":55243},[],"Record status",{"_3355":2343,"_29485":2332,"_20482":55245,"_5":14053,"_26831":55214,"_2843":55246},[],"Signed response",{"_3355":2344,"_29485":2332,"_20482":55248,"_5":14053,"_26831":55214,"_2843":52587},[],{"_3355":2345,"_29485":2332,"_20482":55250,"_5":14053,"_26831":55214,"_2843":55251},[],"`Good`.",{"_3355":2346,"_29485":2332,"_20482":55253,"_5":14053,"_26831":55214,"_2843":52604},[],{"_3355":2347,"_29485":2332,"_20482":55255,"_5":14053,"_26831":55214,"_2843":55256},[],"`Revoked`, with revocation reason and timestamp.",{"_3355":2348,"_29485":2332,"_20482":55258,"_5":14053,"_26831":55214,"_2843":55259},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3355":2349,"_29485":2332,"_20482":55261,"_5":14053,"_26831":55214,"_2843":55262},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3355":2350,"_29485":2332,"_20482":55264,"_5":14053,"_26831":55214,"_2843":55265},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3355":2351,"_29485":2332,"_20482":55267,"_5":14053,"_26831":55214,"_2843":55268},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3355":2352,"_29485":2332,"_20482":55270,"_5":14053,"_26831":55214,"_2843":55271},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3355":2353,"_29485":2332,"_20482":55273,"_5":14053,"_26831":55218,"_2843":55274},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3355":2354,"_29485":2332,"_20482":55276,"_5":14053,"_26831":55218,"_2843":55277},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3355":2355,"_29485":2332,"_20482":55279,"_5":14053,"_26831":55222,"_2843":55280},[],"The service accepts:",{"_3355":2356,"_29485":2332,"_20482":55282,"_5":14053,"_26831":55222,"_2843":51174},[],{"_3355":2357,"_29485":2332,"_20482":55284,"_5":14053,"_26831":55222,"_2843":55285},[],"VA service path",{"_3355":2358,"_29485":2332,"_20482":55287,"_5":14053,"_26831":55222,"_2843":55288},[],"Format",{"_3355":2359,"_29485":2332,"_20482":55290,"_5":14053,"_26831":55222,"_2843":55291},[],"`POST`",{"_3355":2360,"_29485":2332,"_20482":55293,"_5":14053,"_26831":55222,"_2843":55294},[],"`/ocsp`",{"_3355":2361,"_29485":2332,"_20482":55296,"_5":14053,"_26831":55222,"_2843":55297},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3355":2362,"_29485":2332,"_20482":55299,"_5":14053,"_26831":55222,"_2843":54723},[],{"_3355":2363,"_29485":2332,"_20482":55301,"_5":14053,"_26831":55222,"_2843":55302},[],"`/ocsp/{ocsp_request}`",{"_3355":2364,"_29485":2332,"_20482":55304,"_5":14053,"_26831":55222,"_2843":55305},[],"DER request encoded using padded URL Base64.",{"_3355":2365,"_29485":2332,"_20482":55307,"_5":14053,"_26831":55222,"_2843":55308},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3355":2366,"_29485":2332,"_20482":55310,"_5":14053,"_26831":55226,"_2843":55311},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3355":2367,"_29485":2332,"_20482":55313,"_5":14053,"_26831":55226,"_2843":55314},[],"Generate the request:",{"_3355":2368,"_29485":2332,"_20482":55316,"_5":14053,"_26831":55226,"_2843":55317},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3355":2369,"_29485":2332,"_20482":55319,"_5":14053,"_26831":55226,"_2843":55320},[],"Replace the example URL with the inspected endpoint:",{"_3355":2370,"_29485":2332,"_20482":55322,"_5":14053,"_26831":55226,"_2843":55323},[],"Verify the returned DER:",{"_3355":2371,"_29485":2332,"_20482":55325,"_5":14053,"_26831":55226,"_2843":55326},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3355":2372,"_29485":2332,"_20482":55328,"_5":14053,"_26831":55230,"_2843":55329},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3355":2373,"_29485":2332,"_20482":55331,"_5":14053,"_26831":55230,"_2843":55332},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3355":2374,"_29485":2332,"_20482":55334,"_5":14053,"_26831":55234,"_2843":55335},[],"RFC 6960: OCSP.",{"_3355":2375,"_29485":2332,"_20482":55337,"_5":14053,"_26831":55234,"_2843":55338},[],"OpenSSL: openssl-ocsp.",{"_3355":2376,"_29485":2332,"_20482":55340,"_5":14053,"_26831":55234,"_2843":55341},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3355":2377,"_29485":2332,"_20482":55343,"_5":14053,"_26831":55234,"_2843":54815},[],{"_3355":2378,"_29485":2378,"_5":14411,"_2843":53416,"_29817":55345,"_20482":55346,"_26831":2378},[47939,49407,53416],[],{"_3355":2379,"_29485":2378,"_20482":55348,"_5":14053,"_26831":2378,"_2843":55349},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3355":2380,"_29485":2378,"_5":29814,"_20482":55351,"_26831":55352,"_2843":52728},[],"/docs/platform/pki/overview#start-here",{"_3355":2381,"_29485":2378,"_5":29814,"_20482":55354,"_26831":55355,"_2843":55356},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3355":2382,"_29485":2378,"_5":29814,"_20482":55358,"_26831":55359,"_2843":53260},[],"/docs/platform/pki/overview#core-capabilities",{"_3355":2383,"_29485":2378,"_5":29814,"_20482":55361,"_26831":55362,"_2843":53264},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3355":2384,"_29485":2378,"_5":29814,"_20482":55364,"_26831":55365,"_2843":53268},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3355":2385,"_29485":2378,"_5":29814,"_20482":55367,"_26831":55368,"_2843":53272},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3355":2386,"_29485":2378,"_5":29814,"_20482":55370,"_26831":55371,"_2843":53280},[],"/docs/platform/pki/overview#publish-validation-status",{"_3355":2387,"_29485":2378,"_5":29814,"_20482":55373,"_26831":55374,"_2843":55375},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3355":2388,"_29485":2378,"_5":29814,"_20482":55377,"_26831":55378,"_2843":54210},[],"/docs/platform/pki/overview#continue",{"_3355":2389,"_29485":2378,"_20482":55380,"_5":14053,"_26831":2378,"_2843":55381},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3355":2390,"_29485":2378,"_20482":55383,"_5":14053,"_26831":55352,"_2843":55384},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3355":2391,"_29485":2378,"_20482":55386,"_5":14053,"_26831":55352,"_2843":55387},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3355":2392,"_29485":2378,"_20482":55389,"_5":14053,"_26831":55355,"_2843":55390},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3355":2393,"_29485":2378,"_20482":55392,"_5":14053,"_26831":55355,"_2843":55393},[],"An available cryptographic engine to keep the authority's key.",{"_3355":2394,"_29485":2378,"_20482":55395,"_5":14053,"_26831":55355,"_2843":55396},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3355":2395,"_29485":2378,"_20482":55398,"_5":14053,"_26831":55355,"_2843":55399},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3355":2396,"_29485":2378,"_20482":55401,"_5":14053,"_26831":55355,"_2843":55402},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3355":2397,"_29485":2378,"_20482":55404,"_5":14053,"_26831":55362,"_2843":55405},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3355":2398,"_29485":2378,"_20482":55407,"_5":14053,"_26831":55365,"_2843":55408},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3355":2399,"_29485":2378,"_20482":55410,"_5":14053,"_26831":55368,"_2843":55411},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3355":2400,"_29485":2378,"_20482":55413,"_5":14053,"_26831":55371,"_2843":55414},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3355":2401,"_29485":2378,"_20482":55416,"_5":14053,"_26831":55374,"_2843":55417},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3355":2402,"_29485":2378,"_20482":55419,"_5":14053,"_26831":55374,"_2843":55420},[],"its subject and extensions identify the expected client;",{"_3355":2403,"_29485":2378,"_20482":55422,"_5":14053,"_26831":55374,"_2843":55423},[],"its public key matches the client's private key;",{"_3355":2404,"_29485":2378,"_20482":55425,"_5":14053,"_26831":55374,"_2843":55426},[],"its chain reaches a root trusted by the consumer;",{"_3355":2405,"_29485":2378,"_20482":55428,"_5":14053,"_26831":55374,"_2843":55429},[],"its dates and usages allow the operation;",{"_3355":2406,"_29485":2378,"_20482":55431,"_5":14053,"_26831":55374,"_2843":55432},[],"the consumer applies revocation checks and authorization.",{"_3355":2407,"_29485":2378,"_20482":55434,"_5":14053,"_26831":55374,"_2843":55435},[],"The issuance path includes the first independent checks.",{"_3355":2408,"_29485":2378,"_20482":55437,"_5":14053,"_26831":55378,"_2843":55438},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3355":2409,"_29485":2378,"_20482":55440,"_5":14053,"_26831":55378,"_2843":55441},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3355":2410,"_29485":2378,"_20482":55443,"_5":14053,"_26831":55378,"_2843":55444},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3355":2411,"_29485":2411,"_5":14411,"_2843":55446,"_29817":55447,"_20482":55448,"_26831":2411},"Create your first CA",[47939,49407,53416,52853],[],{"_3355":2412,"_29485":2411,"_20482":55450,"_5":14053,"_26831":2411,"_2843":55451},[],"Create an evaluation root and check its certificate before issuing.",{"_3355":2413,"_29485":2411,"_5":29814,"_20482":55453,"_26831":55454,"_2843":47949},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3355":2414,"_29485":2411,"_5":29814,"_20482":55456,"_26831":55457,"_2843":55458},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3355":2415,"_29485":2411,"_5":29814,"_20482":55460,"_26831":55461,"_2843":55462},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3355":2416,"_29485":2411,"_5":29814,"_20482":55464,"_26831":55465,"_2843":55466},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3355":2417,"_29485":2411,"_5":29814,"_20482":55468,"_26831":55469,"_2843":55470},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3355":2418,"_29485":2411,"_5":29814,"_20482":55472,"_26831":55473,"_2843":55474},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3355":2419,"_29485":2411,"_5":29814,"_20482":55476,"_26831":55477,"_2843":55478},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3355":2420,"_29485":2411,"_5":29814,"_20482":55480,"_26831":55481,"_2843":53110},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3355":2421,"_29485":2411,"_5":29814,"_20482":55483,"_26831":55484,"_2843":47973},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3355":2422,"_29485":2411,"_20482":55486,"_5":14053,"_26831":2411,"_2843":55487},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3355":2423,"_29485":2411,"_20482":55489,"_5":14053,"_26831":55454,"_2843":55490},[],"Console access and permission to create keys and authorities.",{"_3355":2424,"_29485":2411,"_20482":55492,"_5":14053,"_26831":55454,"_2843":55493},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3355":2425,"_29485":2411,"_20482":55495,"_5":14053,"_26831":55454,"_2843":55496},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3355":2426,"_29485":2411,"_20482":55498,"_5":14053,"_26831":55454,"_2843":55499},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3355":2427,"_29485":2411,"_20482":55501,"_5":14053,"_26831":55457,"_2843":55502},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3355":2428,"_29485":2411,"_20482":55504,"_5":14053,"_26831":55457,"_2843":55505},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3355":2429,"_29485":2411,"_20482":55507,"_5":14053,"_26831":55461,"_2843":55508},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3355":2430,"_29485":2411,"_20482":55510,"_5":14053,"_26831":55461,"_2843":55511},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3355":2431,"_29485":2411,"_20482":55513,"_5":14053,"_26831":55465,"_2843":55514},[],"Select **Root CA** and complete:",{"_3355":2432,"_29485":2411,"_20482":55516,"_5":14053,"_26831":55465,"_2843":55517},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3355":2433,"_29485":2411,"_20482":55519,"_5":14053,"_26831":55465,"_2843":55520},[],"**Subject**: organization and country details for your evaluation.",{"_3355":2434,"_29485":2411,"_20482":55522,"_5":14053,"_26831":55465,"_2843":55523},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3355":2435,"_29485":2411,"_20482":55525,"_5":14053,"_26831":55465,"_2843":55526},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3355":2436,"_29485":2411,"_20482":55528,"_5":14053,"_26831":55465,"_2843":55529},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3355":2437,"_29485":2411,"_20482":55531,"_5":14053,"_26831":55469,"_2843":55532},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3355":2438,"_29485":2411,"_20482":55534,"_5":14053,"_26831":55473,"_2843":55535},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3355":2439,"_29485":2411,"_20482":55537,"_5":14053,"_26831":55473,"_2843":55538},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3355":2440,"_29485":2411,"_20482":55540,"_5":14053,"_26831":55477,"_2843":55541},[],"Run from the directory where you saved `ca.pem`:",{"_3355":2441,"_29485":2411,"_20482":55543,"_5":14053,"_26831":55477,"_2843":55544},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3355":2442,"_29485":2411,"_20482":55546,"_5":14053,"_26831":55477,"_2843":55547},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3355":2443,"_29485":2411,"_20482":55549,"_5":14053,"_26831":55481,"_2843":55550},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3355":2444,"_29485":2411,"_20482":55552,"_5":14053,"_26831":55481,"_2843":55553},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3355":2445,"_29485":2411,"_20482":55555,"_5":14053,"_26831":55481,"_2843":55556},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3355":2446,"_29485":2411,"_20482":55558,"_5":14053,"_26831":55481,"_2843":55559},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3355":2447,"_29485":2411,"_20482":55561,"_5":14053,"_26831":55484,"_2843":55562},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3355":2448,"_29485":2448,"_5":14411,"_2843":55564,"_29817":55565,"_20482":55566,"_26831":2448},"Issue and verify a certificate",[47939,49407,53416,52853],[],{"_3355":2449,"_29485":2448,"_20482":55568,"_5":14053,"_26831":2448,"_2843":55569},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3355":2450,"_29485":2448,"_5":29814,"_20482":55571,"_26831":55572,"_2843":47949},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3355":2451,"_29485":2448,"_5":29814,"_20482":55574,"_26831":55575,"_2843":55576},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3355":2452,"_29485":2448,"_5":29814,"_20482":55578,"_26831":55579,"_2843":55580},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3355":2453,"_29485":2448,"_5":29814,"_20482":55582,"_26831":55583,"_2843":55584},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3355":2454,"_29485":2448,"_5":29814,"_20482":55586,"_26831":55587,"_2843":55588},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3355":2455,"_29485":2448,"_5":29814,"_20482":55590,"_26831":55591,"_2843":55592},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3355":2456,"_29485":2448,"_5":29814,"_20482":55594,"_26831":55595,"_2843":55596},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3355":2457,"_29485":2448,"_5":29814,"_20482":55598,"_26831":55599,"_2843":55600},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3355":2458,"_29485":2448,"_5":29814,"_20482":55602,"_26831":55603,"_2843":55604},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3355":2459,"_29485":2448,"_5":29814,"_20482":55606,"_26831":55607,"_2843":55608},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3355":2460,"_29485":2448,"_5":29814,"_20482":55610,"_26831":55611,"_2843":53110},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3355":2461,"_29485":2448,"_5":29814,"_20482":55613,"_26831":55614,"_2843":47973},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3355":2462,"_29485":2448,"_20482":55616,"_5":14053,"_26831":2448,"_2843":55617},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3355":2463,"_29485":2448,"_20482":55619,"_5":14053,"_26831":55572,"_2843":55620},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3355":2464,"_29485":2448,"_20482":55622,"_5":14053,"_26831":55572,"_2843":55623},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3355":2465,"_29485":2448,"_20482":55625,"_5":14053,"_26831":55572,"_2843":55626},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3355":2466,"_29485":2448,"_20482":55628,"_5":14053,"_26831":55572,"_2843":55629},[],"A client identifier: here we use `device-001`.",{"_3355":2467,"_29485":2448,"_20482":55631,"_5":14053,"_26831":55572,"_2843":55632},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3355":2468,"_29485":2448,"_20482":55634,"_5":14053,"_26831":55575,"_2843":55635},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3355":2469,"_29485":2448,"_20482":55637,"_5":14053,"_26831":55579,"_2843":55638},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3355":2470,"_29485":2448,"_20482":55640,"_5":14053,"_26831":55579,"_2843":55641},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3355":2471,"_29485":2448,"_20482":55643,"_5":14053,"_26831":55583,"_2843":55644},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3355":2472,"_29485":2448,"_20482":55646,"_5":14053,"_26831":55583,"_2843":55647},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3355":2473,"_29485":2448,"_20482":55649,"_5":14053,"_26831":55587,"_2843":55650},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3355":2474,"_29485":2448,"_20482":55652,"_5":14053,"_26831":55587,"_2843":55653},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3355":2475,"_29485":2448,"_20482":55655,"_5":14053,"_26831":55591,"_2843":55656},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3355":2476,"_29485":2448,"_20482":55658,"_5":14053,"_26831":55595,"_2843":55659},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3355":2477,"_29485":2448,"_20482":55661,"_5":14053,"_26831":55599,"_2843":55662},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3355":2478,"_29485":2448,"_20482":55664,"_5":14053,"_26831":55603,"_2843":55665},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3355":2479,"_29485":2448,"_20482":55667,"_5":14053,"_26831":55603,"_2843":55668},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3355":2480,"_29485":2448,"_20482":55670,"_5":14053,"_26831":55603,"_2843":55671},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3355":2481,"_29485":2448,"_20482":55673,"_5":14053,"_26831":55607,"_2843":55674},[],"In Bash, compare the two public-key digests:",{"_3355":2482,"_29485":2448,"_20482":55676,"_5":14053,"_26831":55607,"_2843":55677},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3355":2483,"_29485":2448,"_20482":55679,"_5":14053,"_26831":55607,"_2843":55680},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3355":2484,"_29485":2448,"_20482":55682,"_5":14053,"_26831":55611,"_2843":53194},[],{"_3355":2485,"_29485":2448,"_20482":55684,"_5":14053,"_26831":55611,"_2843":55685},[],"What to review",{"_3355":2486,"_29485":2448,"_20482":55687,"_5":14053,"_26831":55611,"_2843":55688},[],"The CA rejects issuance",{"_3355":2487,"_29485":2448,"_20482":55690,"_5":14053,"_26831":55611,"_2843":55691},[],"Permissions, CA state and key, algorithm and profile.",{"_3355":2488,"_29485":2448,"_20482":55693,"_5":14053,"_26831":55611,"_2843":55694},[],"Different subject or usages",{"_3355":2489,"_29485":2448,"_20482":55696,"_5":14053,"_26831":55611,"_2843":55697},[],"Applied profile and requested values.",{"_3355":2490,"_29485":2448,"_20482":55699,"_5":14053,"_26831":55611,"_2843":55700},[],"Issuer cannot be found",{"_3355":2491,"_29485":2448,"_20482":55702,"_5":14053,"_26831":55611,"_2843":55703},[],"Downloaded CA and required intermediate chain.",{"_3355":2492,"_29485":2448,"_20482":55705,"_5":14053,"_26831":55611,"_2843":55706},[],"Validity fails",{"_3355":2493,"_29485":2448,"_20482":55708,"_5":14053,"_26831":55611,"_2843":55709},[],"Certificate and CA dates, and the computer's clock.",{"_3355":2494,"_29485":2448,"_20482":55711,"_5":14053,"_26831":55611,"_2843":55712},[],"Public-key digests differ",{"_3355":2495,"_29485":2448,"_20482":55714,"_5":14053,"_26831":55611,"_2843":55715},[],"Certificate and key files from the same issuance.",{"_3355":2496,"_29485":2448,"_20482":55717,"_5":14053,"_26831":55611,"_2843":55718},[],"See PKI diagnostics to narrow an issuance failure.",{"_3355":2497,"_29485":2448,"_20482":55720,"_5":14053,"_26831":55614,"_2843":55721},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3355":2498,"_29485":2448,"_20482":55723,"_5":14053,"_26831":55614,"_2843":55724},[],"Manage certificates for inspection, status and revocation.",{"_3355":2499,"_29485":2448,"_20482":55726,"_5":14053,"_26831":55614,"_2843":55727},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3355":2500,"_29485":2448,"_20482":55729,"_5":14053,"_26831":55614,"_2843":55730},[],"Prepare EST for the device to request its next identities.",{"_3355":2501,"_29485":2448,"_20482":55732,"_5":14053,"_26831":55614,"_2843":55733},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3355":2502,"_29485":2502,"_5":14411,"_2843":55735,"_29817":55736,"_20482":55737,"_26831":2502},"PKI getting started",[47939,49407,53416,52853],[],{"_3355":2503,"_29485":2502,"_20482":55739,"_5":14053,"_26831":2502,"_2843":55740},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3355":2504,"_29485":2502,"_5":29814,"_20482":55742,"_26831":55743,"_2843":47949},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3355":2505,"_29485":2502,"_5":29814,"_20482":55745,"_26831":55746,"_2843":55747},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3355":2506,"_29485":2502,"_5":29814,"_20482":55749,"_26831":55750,"_2843":53045},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3355":2507,"_29485":2502,"_5":29814,"_20482":55752,"_26831":55753,"_2843":55754},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3355":2508,"_29485":2502,"_20482":55756,"_5":14053,"_26831":2502,"_2843":55757},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3355":2509,"_29485":2502,"_20482":55759,"_5":14053,"_26831":55743,"_2843":55760},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3355":2510,"_29485":2502,"_20482":55762,"_5":14053,"_26831":55743,"_2843":55763},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3355":2511,"_29485":2502,"_20482":55765,"_5":14053,"_26831":55743,"_2843":55766},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3355":2512,"_29485":2502,"_20482":55768,"_5":14053,"_26831":55743,"_2843":55769},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3355":2513,"_29485":2502,"_20482":55771,"_5":14053,"_26831":55743,"_2843":55772},[],"A working directory with restricted access for the downloaded key.",{"_3355":2514,"_29485":2502,"_20482":55774,"_5":14053,"_26831":55746,"_2843":55775},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3355":2515,"_29485":2502,"_20482":55777,"_5":14053,"_26831":55746,"_2843":55778},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3355":2516,"_29485":2502,"_20482":55780,"_5":14053,"_26831":55746,"_2843":55781},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3355":2517,"_29485":2502,"_20482":55783,"_5":14053,"_26831":55746,"_2843":55784},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3355":2518,"_29485":2502,"_20482":55786,"_5":14053,"_26831":55750,"_2843":55787},[],"File or resource",{"_3355":2519,"_29485":2502,"_20482":55789,"_5":14053,"_26831":55750,"_2843":53042},[],{"_3355":2520,"_29485":2502,"_20482":55791,"_5":14053,"_26831":55750,"_2843":55792},[],"Active root CA and `ca.pem`",{"_3355":2521,"_29485":2502,"_20482":55794,"_5":14053,"_26831":55750,"_2843":55795},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3355":2522,"_29485":2502,"_20482":55797,"_5":14053,"_26831":55750,"_2843":55798},[],"End-entity certificate and `device.crt`",{"_3355":2523,"_29485":2502,"_20482":55800,"_5":14053,"_26831":55750,"_2843":55801},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3355":2524,"_29485":2502,"_20482":55803,"_5":14053,"_26831":55750,"_2843":55804},[],"Private key `device.key`",{"_3355":2525,"_29485":2502,"_20482":55806,"_5":14053,"_26831":55750,"_2843":55807},[],"Its public key matches the one included in `device.crt`.",{"_3355":2526,"_29485":2502,"_20482":55809,"_5":14053,"_26831":55750,"_2843":55810},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3355":2527,"_29485":2502,"_20482":55812,"_5":14053,"_26831":55753,"_2843":55813},[],"To operate certificates, continue with Certificates and Validation.",{"_3355":2528,"_29485":2502,"_20482":55815,"_5":14053,"_26831":55753,"_2843":55816},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3355":2529,"_29485":2502,"_20482":55818,"_5":14053,"_26831":55753,"_2843":55819},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3355":2530,"_29485":2530,"_5":14411,"_2843":55821,"_29817":55822,"_20482":55823,"_26831":2530},"PKI troubleshooting",[47939,49407,53416,51988],[],{"_3355":2531,"_29485":2530,"_20482":55825,"_5":14053,"_26831":2530,"_2843":55826},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3355":2532,"_29485":2530,"_5":29814,"_20482":55828,"_26831":55829,"_2843":55830},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3355":2533,"_29485":2530,"_5":29814,"_20482":55832,"_26831":55833,"_2843":55834},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3355":2534,"_29485":2530,"_5":29814,"_20482":55836,"_26831":55837,"_2843":55838},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3355":2535,"_29485":2530,"_20482":55840,"_5":14053,"_26831":2530,"_2843":55841},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3355":2536,"_29485":2530,"_20482":55843,"_5":14053,"_26831":2530,"_2843":55844},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3355":2537,"_29485":2530,"_20482":55846,"_5":14053,"_26831":55829,"_2843":53042},[],{"_3355":2538,"_29485":2530,"_20482":55848,"_5":14053,"_26831":55829,"_2843":55849},[],"What to inspect",{"_3355":2539,"_29485":2530,"_20482":55851,"_5":14053,"_26831":55829,"_2843":47973},[],{"_3355":2540,"_29485":2530,"_20482":55853,"_5":14053,"_26831":55829,"_2843":52255},[],{"_3355":2541,"_29485":2530,"_20482":55855,"_5":14053,"_26831":55829,"_2843":55856},[],"Exists, is active and has usable dates.",{"_3355":2542,"_29485":2530,"_20482":55858,"_5":14053,"_26831":55829,"_2843":55859},[],"Authorities.",{"_3355":2543,"_29485":2530,"_20482":55861,"_5":14053,"_26831":55829,"_2843":55862},[],"Key",{"_3355":2544,"_29485":2530,"_20482":55864,"_5":14053,"_26831":55829,"_2843":55865},[],"The record has a usable private key and the engine can sign.",{"_3355":2545,"_29485":2530,"_20482":55867,"_5":14053,"_26831":55829,"_2843":55868},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3355":2546,"_29485":2530,"_20482":55870,"_5":14053,"_26831":55829,"_2843":55871},[],"CSR",{"_3355":2547,"_29485":2530,"_20482":55873,"_5":14053,"_26831":55829,"_2843":55874},[],"Correct PEM and verifiable signature.",{"_3355":2548,"_29485":2530,"_20482":55876,"_5":14053,"_26831":55829,"_2843":55877},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3355":2549,"_29485":2530,"_20482":55879,"_5":14053,"_26831":55829,"_2843":55880},[],"Profile",{"_3355":2550,"_29485":2530,"_20482":55882,"_5":14053,"_26831":55829,"_2843":55883},[],"Selected source, existing ID, allowed algorithm and size.",{"_3355":2551,"_29485":2530,"_20482":55885,"_5":14053,"_26831":55829,"_2843":55886},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3355":2552,"_29485":2530,"_20482":55888,"_5":14053,"_26831":55829,"_2843":53194},[],{"_3355":2553,"_29485":2530,"_20482":55890,"_5":14053,"_26831":55829,"_2843":55891},[],"Appropriate subject, SAN, usages and dates.",{"_3355":2554,"_29485":2530,"_20482":55893,"_5":14053,"_26831":55829,"_2843":55894},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3355":2555,"_29485":2530,"_20482":55896,"_5":14053,"_26831":55829,"_2843":55897},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3355":2556,"_29485":2530,"_20482":55899,"_5":14053,"_26831":55829,"_2843":55900},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3355":2557,"_29485":2530,"_20482":55902,"_5":14053,"_26831":55833,"_2843":55903},[],"Check each boundary independently:",{"_3355":2558,"_29485":2530,"_20482":55905,"_5":14053,"_26831":55833,"_2843":55906},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3355":2559,"_29485":2530,"_20482":55908,"_5":14053,"_26831":55833,"_2843":55909},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3355":2560,"_29485":2530,"_20482":55911,"_5":14053,"_26831":55833,"_2843":55912},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3355":2561,"_29485":2530,"_20482":55914,"_5":14053,"_26831":55833,"_2843":55915},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3355":2562,"_29485":2530,"_20482":55917,"_5":14053,"_26831":55833,"_2843":55918},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3355":2563,"_29485":2530,"_20482":55920,"_5":14053,"_26831":55833,"_2843":55921},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3355":2564,"_29485":2530,"_20482":55923,"_5":14053,"_26831":55837,"_2843":55924},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3355":2565,"_29485":2530,"_20482":55926,"_5":14053,"_26831":55837,"_2843":55927},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3355":2566,"_29485":2566,"_5":14411,"_2843":55929,"_29817":55930,"_20482":55931,"_26831":2566},"Security",[47939],[],{"_3355":2567,"_29485":2566,"_20482":55933,"_5":14053,"_26831":2566,"_2843":55934},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3355":2568,"_29485":2566,"_5":29814,"_20482":55936,"_26831":55937,"_2843":55938},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3355":2569,"_29485":2566,"_5":29814,"_20482":55940,"_26831":55941,"_2843":55942},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3355":2570,"_29485":2566,"_5":29814,"_20482":55944,"_26831":55945,"_2843":55946},[],"/docs/security#supported-versions","Supported versions",{"_3355":2571,"_29485":2566,"_5":29814,"_20482":55948,"_26831":55949,"_2843":55950},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3355":2572,"_29485":2566,"_20482":55952,"_5":14053,"_26831":2566,"_2843":55953},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3355":2573,"_29485":2566,"_20482":55955,"_5":14053,"_26831":55937,"_2843":55956},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3355":2574,"_29485":2566,"_20482":55958,"_5":14053,"_26831":55937,"_2843":55959},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3355":2575,"_29485":2566,"_20482":55961,"_5":14053,"_26831":55937,"_2843":14673},[],{"_3355":2576,"_29485":2566,"_20482":55963,"_5":14053,"_26831":55937,"_2843":14619},[],{"_3355":2577,"_29485":2566,"_20482":55965,"_5":14053,"_26831":55937,"_2843":14666},[],{"_3355":2578,"_29485":2566,"_20482":55967,"_5":14053,"_26831":55937,"_2843":55968},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3355":2579,"_29485":2566,"_20482":55970,"_5":14053,"_26831":55937,"_2843":55971},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3355":2580,"_29485":2566,"_20482":55973,"_5":14053,"_26831":55941,"_2843":55974},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3355":2581,"_29485":2566,"_20482":55976,"_5":14053,"_26831":55941,"_2843":55977},[],"Do not include in the report:",{"_3355":2582,"_29485":2566,"_20482":55979,"_5":14053,"_26831":55941,"_2843":55980},[],"Credentials, tokens, or private keys",{"_3355":2583,"_29485":2566,"_20482":55982,"_5":14053,"_26831":55941,"_2843":55983},[],"Customer data or customer-identifiable information",{"_3355":2584,"_29485":2566,"_20482":55985,"_5":14053,"_26831":55941,"_2843":55986},[],"Confidential architecture or internal infrastructure details",{"_3355":2585,"_29485":2566,"_20482":55988,"_5":14053,"_26831":55945,"_2843":55989},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3355":2586,"_29485":2566,"_20482":55991,"_5":14053,"_26831":55945,"_2843":55992},[],"For upgrade guidance, see Upgrades.",{"_3355":2587,"_29485":2566,"_20482":55994,"_5":14053,"_26831":55949,"_2843":55995},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3355":2588,"_29485":2566,"_20482":55997,"_5":14053,"_26831":55949,"_2843":55998},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3355":2589,"_29485":2566,"_20482":56000,"_5":14053,"_26831":55949,"_2843":56001},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3355":2590,"_29485":2566,"_20482":56003,"_5":14053,"_26831":55949,"_2843":56004},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3355":2591,"_29485":2566,"_20482":56006,"_5":14053,"_26831":55949,"_2843":56007},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3355":2592,"_29485":2592,"_5":14411,"_2843":56009,"_29817":56010,"_20482":56012,"_26831":2592},"3.8.0 to 4.0.0",[47939,56011],"Upgrades",[],{"_3355":2593,"_29485":2592,"_20482":56014,"_5":14053,"_26831":2592,"_2843":56015},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3355":2594,"_29485":2592,"_5":29814,"_20482":56017,"_26831":56018,"_2843":56019},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3355":2595,"_29485":2592,"_5":29814,"_20482":56021,"_26831":56022,"_2843":56023},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3355":2596,"_29485":2592,"_5":29814,"_20482":56025,"_26831":56026,"_2843":56027},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3355":2597,"_29485":2592,"_5":29814,"_20482":56029,"_26831":56030,"_2843":56031},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3355":2598,"_29485":2592,"_5":29814,"_20482":56033,"_26831":56034,"_2843":56035},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3355":2599,"_29485":2592,"_5":29814,"_20482":56037,"_26831":56038,"_2843":56039},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3355":2600,"_29485":2592,"_5":29814,"_20482":56041,"_26831":56042,"_2843":56043},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3355":2601,"_29485":2592,"_5":29814,"_20482":56045,"_26831":56046,"_2843":56047},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3355":2602,"_29485":2592,"_5":29814,"_20482":56049,"_26831":56050,"_2843":56051},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3355":2603,"_29485":2592,"_5":29814,"_20482":56053,"_26831":56054,"_2843":56055},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3355":2604,"_29485":2592,"_5":29814,"_20482":56057,"_26831":56058,"_2843":56059},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3355":2605,"_29485":2592,"_5":29814,"_20482":56061,"_26831":56062,"_2843":56063},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3355":2606,"_29485":2592,"_5":29814,"_20482":56065,"_26831":56066,"_2843":56067},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3355":2607,"_29485":2592,"_5":29814,"_20482":56069,"_26831":56070,"_2843":56071},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3355":2608,"_29485":2592,"_5":29814,"_20482":56073,"_26831":56074,"_2843":56075},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3355":2609,"_29485":2592,"_5":29814,"_20482":56077,"_26831":56078,"_2843":56079},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3355":2610,"_29485":2592,"_5":29814,"_20482":56081,"_26831":56082,"_2843":56083},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3355":2611,"_29485":2592,"_5":29814,"_20482":56085,"_26831":56086,"_2843":56087},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3355":2612,"_29485":2592,"_5":29814,"_20482":56089,"_26831":56090,"_2843":56091},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3355":2613,"_29485":2592,"_5":29814,"_20482":56093,"_26831":56094,"_2843":56095},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3355":2614,"_29485":2592,"_5":29814,"_20482":56097,"_26831":56098,"_2843":56099},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3355":2615,"_29485":2592,"_5":29814,"_20482":56101,"_26831":56102,"_2843":56103},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3355":2616,"_29485":2592,"_5":29814,"_20482":56105,"_26831":56106,"_2843":56107},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3355":2617,"_29485":2592,"_5":29814,"_20482":56109,"_26831":56110,"_2843":56111},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3355":2618,"_29485":2592,"_5":29814,"_20482":56113,"_26831":56114,"_2843":56115},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3355":2619,"_29485":2592,"_5":29814,"_20482":56117,"_26831":56118,"_2843":56119},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3355":2620,"_29485":2592,"_5":29814,"_20482":56121,"_26831":56122,"_2843":56123},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3355":2621,"_29485":2592,"_5":29814,"_20482":56125,"_26831":56126,"_2843":56127},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3355":2622,"_29485":2592,"_5":29814,"_20482":56129,"_26831":56130,"_2843":56131},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3355":2623,"_29485":2592,"_5":29814,"_20482":56133,"_26831":56134,"_2843":56135},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3355":2624,"_29485":2592,"_5":29814,"_20482":56137,"_26831":56138,"_2843":56139},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3355":2625,"_29485":2592,"_5":29814,"_20482":56141,"_26831":56142,"_2843":56143},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3355":2626,"_29485":2592,"_5":29814,"_20482":56145,"_26831":56146,"_2843":56147},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3355":2627,"_29485":2592,"_5":29814,"_20482":56149,"_26831":56150,"_2843":51988},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3355":2628,"_29485":2592,"_5":29814,"_20482":56152,"_26831":56153,"_2843":56154},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3355":2629,"_29485":2592,"_5":29814,"_20482":56156,"_26831":56157,"_2843":56158},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3355":2630,"_29485":2592,"_20482":56160,"_5":14053,"_26831":2592,"_2843":56161},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3355":2631,"_29485":2592,"_20482":56163,"_5":14053,"_26831":2592,"_2843":56164},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3355":2632,"_29485":2592,"_20482":56166,"_5":14053,"_26831":2592,"_2843":56167},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3355":2633,"_29485":2592,"_20482":56169,"_5":14053,"_26831":2592,"_2843":56170},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3355":2634,"_29485":2592,"_20482":56172,"_5":14053,"_26831":2592,"_2843":56173},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3355":2635,"_29485":2592,"_20482":56175,"_5":14053,"_26831":2592,"_2843":56176},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3355":2636,"_29485":2592,"_20482":56178,"_5":14053,"_26831":2592,"_2843":56179},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3355":2637,"_29485":2592,"_20482":56181,"_5":14053,"_26831":56022,"_2843":56182},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3355":2638,"_29485":2592,"_20482":56184,"_5":14053,"_26831":56022,"_2843":56185},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3355":2639,"_29485":2592,"_20482":56187,"_5":14053,"_26831":56026,"_2843":56188},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3355":2640,"_29485":2592,"_20482":56190,"_5":14053,"_26831":56026,"_2843":56191},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3355":2641,"_29485":2592,"_20482":56193,"_5":14053,"_26831":56030,"_2843":56194},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3355":2642,"_29485":2592,"_20482":56196,"_5":14053,"_26831":56034,"_2843":56197},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3355":2643,"_29485":2592,"_20482":56199,"_5":14053,"_26831":56034,"_2843":56200},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3355":2644,"_29485":2592,"_20482":56202,"_5":14053,"_26831":56034,"_2843":56203},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3355":2645,"_29485":2592,"_20482":56205,"_5":14053,"_26831":56034,"_2843":56206},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3355":2646,"_29485":2592,"_20482":56208,"_5":14053,"_26831":56034,"_2843":56209},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3355":2647,"_29485":2592,"_20482":56211,"_5":14053,"_26831":56038,"_2843":56212},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3355":2648,"_29485":2592,"_20482":56214,"_5":14053,"_26831":56038,"_2843":56215},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3355":2649,"_29485":2592,"_20482":56217,"_5":14053,"_26831":56038,"_2843":56218},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3355":2650,"_29485":2592,"_20482":56220,"_5":14053,"_26831":56038,"_2843":56221},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3355":2651,"_29485":2592,"_20482":56223,"_5":14053,"_26831":56038,"_2843":56224},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3355":2652,"_29485":2592,"_20482":56226,"_5":14053,"_26831":56042,"_2843":56227},[],"Change",{"_3355":2653,"_29485":2592,"_20482":56229,"_5":14053,"_26831":56042,"_2843":56230},[],"Who is affected",{"_3355":2654,"_29485":2592,"_20482":56232,"_5":14053,"_26831":56042,"_2843":56233},[],"Severity",{"_3355":2655,"_29485":2592,"_20482":56235,"_5":14053,"_26831":56042,"_2843":54752},[],{"_3355":2656,"_29485":2592,"_20482":56237,"_5":14053,"_26831":56042,"_2843":56051},[],{"_3355":2657,"_29485":2592,"_20482":56239,"_5":14053,"_26831":56042,"_2843":56240},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3355":2658,"_29485":2592,"_20482":56242,"_5":14053,"_26831":56042,"_2843":56243},[],"High: KMS and VA start on empty volumes",{"_3355":2659,"_29485":2592,"_20482":56245,"_5":14053,"_26831":56042,"_2843":56246},[],"Copy the data into the new volumes",{"_3355":2660,"_29485":2592,"_20482":56248,"_5":14053,"_26831":56042,"_2843":56055},[],{"_3355":2661,"_29485":2592,"_20482":56250,"_5":14053,"_26831":56042,"_2843":56251},[],"Every Helm release",{"_3355":2662,"_29485":2592,"_20482":56253,"_5":14053,"_26831":56042,"_2843":56254},[],"High: `helm upgrade` fails",{"_3355":2663,"_29485":2592,"_20482":56256,"_5":14053,"_26831":56042,"_2843":56257},[],"Remove or rename legacy keys",{"_3355":2664,"_29485":2592,"_20482":56259,"_5":14053,"_26831":56042,"_2843":56059},[],{"_3355":2665,"_29485":2592,"_20482":56261,"_5":14053,"_26831":56042,"_2843":56262},[],"Every deployment",{"_3355":2666,"_29485":2592,"_20482":56264,"_5":14053,"_26831":56042,"_2843":56265},[],"High: without a bootstrap principal there is no administrator",{"_3355":2667,"_29485":2592,"_20482":56267,"_5":14053,"_26831":56042,"_2843":56268},[],"Configure `services.authz`",{"_3355":2668,"_29485":2592,"_20482":56270,"_5":14053,"_26831":56042,"_2843":56063},[],{"_3355":2669,"_29485":2592,"_20482":56272,"_5":14053,"_26831":56042,"_2843":56251},[],{"_3355":2670,"_29485":2592,"_20482":56274,"_5":14053,"_26831":56042,"_2843":56275},[],"High: `helm upgrade` fails on the old keys",{"_3355":2671,"_29485":2592,"_20482":56277,"_5":14053,"_26831":56042,"_2843":56278},[],"Move JWKS and roles into `services.authz`",{"_3355":2672,"_29485":2592,"_20482":56280,"_5":14053,"_26831":56042,"_2843":56083},[],{"_3355":2673,"_29485":2592,"_20482":56282,"_5":14053,"_26831":56042,"_2843":56283},[],"3.8.0 deployments with per-service databases",{"_3355":2674,"_29485":2592,"_20482":56285,"_5":14053,"_26831":56042,"_2843":56286},[],"High: services find no data, or a migration aborts",{"_3355":2675,"_29485":2592,"_20482":56288,"_5":14053,"_26831":56042,"_2843":56289},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3355":2676,"_29485":2592,"_20482":56291,"_5":14053,"_26831":56042,"_2843":56087},[],{"_3355":2677,"_29485":2592,"_20482":56293,"_5":14053,"_26831":56042,"_2843":56294},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3355":2678,"_29485":2592,"_20482":56296,"_5":14053,"_26831":56042,"_2843":56297},[],"High: the backend no longer starts with them",{"_3355":2679,"_29485":2592,"_20482":56299,"_5":14053,"_26831":56042,"_2843":56300},[],"Move to PostgreSQL before upgrading",{"_3355":2680,"_29485":2592,"_20482":56302,"_5":14053,"_26831":56042,"_2843":56303},[],"Webhooks with file references",{"_3355":2681,"_29485":2592,"_20482":56305,"_5":14053,"_26831":56042,"_2843":56306},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3355":2682,"_29485":2592,"_20482":56308,"_5":14053,"_26831":56042,"_2843":56309},[],"High: enrollments calling the webhook fail",{"_3355":2683,"_29485":2592,"_20482":56311,"_5":14053,"_26831":56042,"_2843":56312},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3355":2684,"_29485":2592,"_20482":56314,"_5":14053,"_26831":56042,"_2843":56067},[],{"_3355":2685,"_29485":2592,"_20482":56316,"_5":14053,"_26831":56042,"_2843":56317},[],"Releases with per-service identity overrides or mounted key material",{"_3355":2686,"_29485":2592,"_20482":56319,"_5":14053,"_26831":56042,"_2843":56320},[],"Medium: services cannot read their files",{"_3355":2687,"_29485":2592,"_20482":56322,"_5":14053,"_26831":56042,"_2843":56323},[],"Remove the overrides and fix volume ownership",{"_3355":2688,"_29485":2592,"_20482":56325,"_5":14053,"_26831":56042,"_2843":56071},[],{"_3355":2689,"_29485":2592,"_20482":56327,"_5":14053,"_26831":56042,"_2843":56328},[],"Releases that set `amqp.tls`",{"_3355":2690,"_29485":2592,"_20482":56330,"_5":14053,"_26831":56042,"_2843":56331},[],"Medium: clients connect to the wrong port",{"_3355":2691,"_29485":2592,"_20482":56333,"_5":14053,"_26831":56042,"_2843":56334},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3355":2692,"_29485":2592,"_20482":56336,"_5":14053,"_26831":56042,"_2843":56091},[],{"_3355":2693,"_29485":2592,"_20482":56338,"_5":14053,"_26831":56042,"_2843":56339},[],"Installations whose CA keys predate the KMS",{"_3355":2694,"_29485":2592,"_20482":56341,"_5":14053,"_26831":56042,"_2843":56342},[],"Medium: CA keys stay unmanaged",{"_3355":2695,"_29485":2592,"_20482":56344,"_5":14053,"_26831":56042,"_2843":56345},[],"Run the CA-to-KMS migration",{"_3355":2696,"_29485":2592,"_20482":56347,"_5":14053,"_26831":56042,"_2843":56348},[],"Receiver certificate verification",{"_3355":2697,"_29485":2592,"_20482":56350,"_5":14053,"_26831":56042,"_2843":56351},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3355":2698,"_29485":2592,"_20482":56353,"_5":14053,"_26831":56042,"_2843":56354},[],"Medium: credentials go to an unverified receiver",{"_3355":2699,"_29485":2592,"_20482":56356,"_5":14053,"_26831":56042,"_2843":56357},[],"Set `insecure_skip_verify` to `false`",{"_3355":2700,"_29485":2592,"_20482":56359,"_5":14053,"_26831":56042,"_2843":56103},[],{"_3355":2701,"_29485":2592,"_20482":56361,"_5":14053,"_26831":56042,"_2843":56362},[],"Scripts and consoles that edit DMSs through the API",{"_3355":2702,"_29485":2592,"_20482":56364,"_5":14053,"_26831":56042,"_2843":56365},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3355":2703,"_29485":2592,"_20482":56367,"_5":14053,"_26831":56042,"_2843":56368},[],"Read the DMS before editing and use the new field",{"_3355":2704,"_29485":2592,"_20482":56370,"_5":14053,"_26831":56042,"_2843":56119},[],{"_3355":2705,"_29485":2592,"_20482":56372,"_5":14053,"_26831":56042,"_2843":56373},[],"Consumers that read the device `events` field",{"_3355":2706,"_29485":2592,"_20482":56375,"_5":14053,"_26831":56042,"_2843":56376},[],"Medium: the field disappears",{"_3355":2707,"_29485":2592,"_20482":56378,"_5":14053,"_26831":56042,"_2843":56379},[],"Use the new event endpoints",{"_3355":2708,"_29485":2592,"_20482":56381,"_5":14053,"_26831":56042,"_2843":56075},[],{"_3355":2709,"_29485":2592,"_20482":56383,"_5":14053,"_26831":56042,"_2843":56384},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3355":2710,"_29485":2592,"_20482":56386,"_5":14053,"_26831":56042,"_2843":56387},[],"Low to medium: validation errors or changed defaults",{"_3355":2711,"_29485":2592,"_20482":56389,"_5":14053,"_26831":56042,"_2843":56390},[],"Update the values file",{"_3355":2712,"_29485":2592,"_20482":56392,"_5":14053,"_26831":56042,"_2843":56111},[],{"_3355":2713,"_29485":2592,"_20482":56394,"_5":14053,"_26831":56042,"_2843":56395},[],"Clients that send the DMS ID in the update body",{"_3355":2714,"_29485":2592,"_20482":56397,"_5":14053,"_26831":56042,"_2843":56398},[],"Low: the ID in the URL wins",{"_3355":2715,"_29485":2592,"_20482":56400,"_5":14053,"_26831":56042,"_2843":56401},[],"Send the ID in the URL",{"_3355":2716,"_29485":2592,"_20482":56403,"_5":14053,"_26831":56042,"_2843":56115},[],{"_3355":2717,"_29485":2592,"_20482":56405,"_5":14053,"_26831":56042,"_2843":56406},[],"Consumers that match on certificate `type`",{"_3355":2718,"_29485":2592,"_20482":56408,"_5":14053,"_26831":56042,"_2843":56409},[],"Low: two values are renamed",{"_3355":2719,"_29485":2592,"_20482":56411,"_5":14053,"_26831":56042,"_2843":56412},[],"Adapt consumers",{"_3355":2720,"_29485":2592,"_20482":56414,"_5":14053,"_26831":56042,"_2843":56107},[],{"_3355":2721,"_29485":2592,"_20482":56416,"_5":14053,"_26831":56042,"_2843":56417},[],"Any DMS",{"_3355":2722,"_29485":2592,"_20482":56419,"_5":14053,"_26831":56042,"_2843":56420},[],"Low: informational",{"_3355":2723,"_29485":2592,"_20482":56422,"_5":14053,"_26831":56042,"_2843":56423},[],"Read both blocks before editing",{"_3355":2724,"_29485":2592,"_20482":56425,"_5":14053,"_26831":56050,"_2843":56426},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3355":2725,"_29485":2592,"_20482":56428,"_5":14053,"_26831":56050,"_2843":56429},[],"Step 4 of the migration guide copies the data.",{"_3355":2726,"_29485":2592,"_20482":56431,"_5":14053,"_26831":56054,"_2843":56432},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3355":2727,"_29485":2592,"_20482":56434,"_5":14053,"_26831":56058,"_2843":56435},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3355":2728,"_29485":2592,"_20482":56437,"_5":14053,"_26831":56062,"_2843":56438},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3355":2729,"_29485":2592,"_20482":56440,"_5":14053,"_26831":56066,"_2843":56441},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3355":2730,"_29485":2592,"_20482":56443,"_5":14053,"_26831":56066,"_2843":56444},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3355":2731,"_29485":2592,"_20482":56446,"_5":14053,"_26831":56070,"_2843":56447},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3355":2732,"_29485":2592,"_20482":56449,"_5":14053,"_26831":56074,"_2843":56450},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3355":2733,"_29485":2592,"_20482":56452,"_5":14053,"_26831":56074,"_2843":56453},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3355":2734,"_29485":2592,"_20482":56455,"_5":14053,"_26831":56074,"_2843":56456},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3355":2735,"_29485":2592,"_20482":56458,"_5":14053,"_26831":56074,"_2843":56459},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3355":2736,"_29485":2592,"_20482":56461,"_5":14053,"_26831":56074,"_2843":56462},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3355":2737,"_29485":2592,"_20482":56464,"_5":14053,"_26831":56074,"_2843":56465},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3355":2738,"_29485":2592,"_20482":56467,"_5":14053,"_26831":56082,"_2843":56468},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3355":2739,"_29485":2592,"_20482":56470,"_5":14053,"_26831":56082,"_2843":56471},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3355":2740,"_29485":2592,"_20482":56473,"_5":14053,"_26831":56082,"_2843":56474},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3355":2741,"_29485":2592,"_20482":56476,"_5":14053,"_26831":56082,"_2843":56477},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3355":2742,"_29485":2592,"_20482":56479,"_5":14053,"_26831":56082,"_2843":56480},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3355":2743,"_29485":2592,"_20482":56482,"_5":14053,"_26831":56086,"_2843":56483},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3355":2744,"_29485":2592,"_20482":56485,"_5":14053,"_26831":56090,"_2843":56486},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3355":2745,"_29485":2592,"_20482":56488,"_5":14053,"_26831":56090,"_2843":56489},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3355":2746,"_29485":2592,"_20482":56491,"_5":14053,"_26831":56090,"_2843":56492},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3355":2747,"_29485":2592,"_20482":56494,"_5":14053,"_26831":56090,"_2843":56495},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3355":2748,"_29485":2592,"_20482":56497,"_5":14053,"_26831":56090,"_2843":56498},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3355":2749,"_29485":2592,"_20482":56500,"_5":14053,"_26831":56090,"_2843":56501},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3355":2750,"_29485":2592,"_20482":56503,"_5":14053,"_26831":56098,"_2843":56504},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3355":2751,"_29485":2592,"_20482":56506,"_5":14053,"_26831":56098,"_2843":56507},[],"Field in 3.8.0",{"_3355":2752,"_29485":2592,"_20482":56509,"_5":14053,"_26831":56098,"_2843":56510},[],"Field in 4.0.0",{"_3355":2753,"_29485":2592,"_20482":56512,"_5":14053,"_26831":56098,"_2843":56513},[],"`validate_server_cert`",{"_3355":2754,"_29485":2592,"_20482":56515,"_5":14053,"_26831":56098,"_2843":56516},[],"`insecure_skip_verify` (value negated)",{"_3355":2755,"_29485":2592,"_20482":56518,"_5":14053,"_26831":56098,"_2843":56519},[],"`oidc`",{"_3355":2756,"_29485":2592,"_20482":56521,"_5":14053,"_26831":56098,"_2843":56522},[],"`jwt_options`",{"_3355":2757,"_29485":2592,"_20482":56524,"_5":14053,"_26831":56098,"_2843":56525},[],"`apikey`",{"_3355":2758,"_29485":2592,"_20482":56527,"_5":14053,"_26831":56098,"_2843":56528},[],"`apikey_options`",{"_3355":2759,"_29485":2592,"_20482":56530,"_5":14053,"_26831":56098,"_2843":56531},[],"`mtls`",{"_3355":2760,"_29485":2592,"_20482":56533,"_5":14053,"_26831":56098,"_2843":56534},[],"`mtls_options`",{"_3355":2761,"_29485":2592,"_20482":56536,"_5":14053,"_26831":56098,"_2843":56537},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3355":2762,"_29485":2592,"_20482":56539,"_5":14053,"_26831":56098,"_2843":56540},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3355":2763,"_29485":2592,"_20482":56542,"_5":14053,"_26831":56098,"_2843":56543},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3355":2764,"_29485":2592,"_20482":56545,"_5":14053,"_26831":56102,"_2843":56546},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3355":2765,"_29485":2592,"_20482":56548,"_5":14053,"_26831":56102,"_2843":56549},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3355":2766,"_29485":2592,"_20482":56551,"_5":14053,"_26831":56102,"_2843":56552},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3355":2767,"_29485":2592,"_20482":56554,"_5":14053,"_26831":56106,"_2843":56555},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3355":2768,"_29485":2592,"_20482":56557,"_5":14053,"_26831":56110,"_2843":56558},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3355":2769,"_29485":2592,"_20482":56560,"_5":14053,"_26831":56114,"_2843":56561},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3355":2770,"_29485":2592,"_20482":56563,"_5":14053,"_26831":56118,"_2843":56564},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3355":2771,"_29485":2592,"_20482":56566,"_5":14053,"_26831":56118,"_2843":56567},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3355":2772,"_29485":2592,"_20482":56569,"_5":14053,"_26831":56118,"_2843":56570},[],"`POST /v1/devices/:id/events` creates an event.",{"_3355":2773,"_29485":2592,"_20482":56572,"_5":14053,"_26831":56118,"_2843":56573},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3355":2774,"_29485":2592,"_20482":56575,"_5":14053,"_26831":56122,"_2843":56576},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3355":2775,"_29485":2592,"_20482":56578,"_5":14053,"_26831":56126,"_2843":56579},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3355":2776,"_29485":2592,"_20482":56581,"_5":14053,"_26831":56126,"_2843":56582},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3355":2777,"_29485":2592,"_20482":56584,"_5":14053,"_26831":56126,"_2843":56585},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3355":2778,"_29485":2592,"_20482":56587,"_5":14053,"_26831":56126,"_2843":56588},[],"Record the names of your local-storage PVCs:",{"_3355":2779,"_29485":2592,"_20482":56590,"_5":14053,"_26831":56126,"_2843":56591},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3355":2780,"_29485":2592,"_20482":56593,"_5":14053,"_26831":56130,"_2843":56594},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3355":2781,"_29485":2592,"_20482":56596,"_5":14053,"_26831":56130,"_2843":56597},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3355":2782,"_29485":2592,"_20482":56599,"_5":14053,"_26831":56130,"_2843":56600},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3355":2783,"_29485":2592,"_20482":56602,"_5":14053,"_26831":56130,"_2843":56603},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3355":2784,"_29485":2592,"_20482":56605,"_5":14053,"_26831":56130,"_2843":56606},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3355":2785,"_29485":2592,"_20482":56608,"_5":14053,"_26831":56130,"_2843":56609},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3355":2786,"_29485":2592,"_20482":56611,"_5":14053,"_26831":56130,"_2843":56612},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3355":2787,"_29485":2592,"_20482":56614,"_5":14053,"_26831":56130,"_2843":56615},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3355":2788,"_29485":2592,"_20482":56617,"_5":14053,"_26831":56130,"_2843":56618},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3355":2789,"_29485":2592,"_20482":56620,"_5":14053,"_26831":56130,"_2843":56621},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3355":2790,"_29485":2592,"_20482":56623,"_5":14053,"_26831":56130,"_2843":56624},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3355":2791,"_29485":2592,"_20482":56626,"_5":14053,"_26831":56130,"_2843":56627},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3355":2792,"_29485":2592,"_20482":56629,"_5":14053,"_26831":56134,"_2843":56630},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3355":2793,"_29485":2592,"_20482":56632,"_5":14053,"_26831":56134,"_2843":56633},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3355":2794,"_29485":2592,"_20482":56635,"_5":14053,"_26831":56138,"_2843":56636},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3355":2795,"_29485":2592,"_20482":56638,"_5":14053,"_26831":56138,"_2843":56639},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3355":2796,"_29485":2592,"_20482":56641,"_5":14053,"_26831":56138,"_2843":56642},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3355":2797,"_29485":2592,"_20482":56644,"_5":14053,"_26831":56138,"_2843":56645},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3355":2798,"_29485":2592,"_20482":56647,"_5":14053,"_26831":56138,"_2843":56648},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3355":2799,"_29485":2592,"_20482":56650,"_5":14053,"_26831":56138,"_2843":56651},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3355":2800,"_29485":2592,"_20482":56653,"_5":14053,"_26831":56138,"_2843":56654},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3355":2801,"_29485":2592,"_20482":56656,"_5":14053,"_26831":56138,"_2843":56657},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3355":2802,"_29485":2592,"_20482":56659,"_5":14053,"_26831":56138,"_2843":56660},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3355":2803,"_29485":2592,"_20482":56662,"_5":14053,"_26831":56138,"_2843":56663},[],"**Remove the helper and restore the recorded replica counts:**",{"_3355":2804,"_29485":2592,"_20482":56665,"_5":14053,"_26831":56138,"_2843":56666},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3355":2805,"_29485":2592,"_20482":56668,"_5":14053,"_26831":56142,"_2843":56669},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3355":2806,"_29485":2592,"_20482":56671,"_5":14053,"_26831":56142,"_2843":56672},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3355":2807,"_29485":2592,"_20482":56674,"_5":14053,"_26831":56146,"_2843":56675},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3355":2808,"_29485":2592,"_20482":56677,"_5":14053,"_26831":56146,"_2843":56678},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3355":2809,"_29485":2592,"_20482":56680,"_5":14053,"_26831":56146,"_2843":56681},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3355":2810,"_29485":2592,"_20482":56683,"_5":14053,"_26831":56146,"_2843":56684},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3355":2811,"_29485":2592,"_20482":56686,"_5":14053,"_26831":56146,"_2843":56687},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3355":2812,"_29485":2592,"_20482":56689,"_5":14053,"_26831":56150,"_2843":56690},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3355":2813,"_29485":2592,"_20482":56692,"_5":14053,"_26831":56150,"_2843":56693},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3355":2814,"_29485":2592,"_20482":56695,"_5":14053,"_26831":56150,"_2843":56696},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3355":2815,"_29485":2592,"_20482":56698,"_5":14053,"_26831":56150,"_2843":56699},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3355":2816,"_29485":2592,"_20482":56701,"_5":14053,"_26831":56150,"_2843":56702},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3355":2817,"_29485":2592,"_20482":56704,"_5":14053,"_26831":56150,"_2843":56705},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3355":2818,"_29485":2592,"_20482":56707,"_5":14053,"_26831":56150,"_2843":56708},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3355":2819,"_29485":2592,"_20482":56710,"_5":14053,"_26831":56153,"_2843":56711},[],"After the upgrade, check in this order:",{"_3355":2820,"_29485":2592,"_20482":56713,"_5":14053,"_26831":56153,"_2843":56714},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3355":2821,"_29485":2592,"_20482":56716,"_5":14053,"_26831":56153,"_2843":56717},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3355":2822,"_29485":2592,"_20482":56719,"_5":14053,"_26831":56153,"_2843":56720},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3355":2823,"_29485":2592,"_20482":56722,"_5":14053,"_26831":56153,"_2843":56723},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3355":2824,"_29485":2592,"_20482":56725,"_5":14053,"_26831":56153,"_2843":56726},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3355":2825,"_29485":2592,"_20482":56728,"_5":14053,"_26831":56153,"_2843":56729},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3355":2826,"_29485":2592,"_20482":56731,"_5":14053,"_26831":56153,"_2843":56732},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3355":2827,"_29485":2592,"_20482":56734,"_5":14053,"_26831":56153,"_2843":56735},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3355":2828,"_29485":2592,"_20482":56737,"_5":14053,"_26831":56153,"_2843":56738},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3355":2829,"_29485":2592,"_20482":56740,"_5":14053,"_26831":56153,"_2843":56741},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3355":2830,"_29485":2592,"_20482":56743,"_5":14053,"_26831":56153,"_2843":56744},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3355":2831,"_29485":2592,"_20482":56746,"_5":14053,"_26831":56153,"_2843":56747},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3355":2832,"_29485":2592,"_20482":56749,"_5":14053,"_26831":56153,"_2843":56750},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3355":2833,"_29485":2592,"_20482":56752,"_5":14053,"_26831":56153,"_2843":56753},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3355":2834,"_29485":2592,"_20482":56755,"_5":14053,"_26831":56157,"_2843":56756},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3355":2835,"_29485":2592,"_20482":56758,"_5":14053,"_26831":56157,"_2843":56759},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3355":2836,"_29485":2592,"_20482":56761,"_5":14053,"_26831":56157,"_2843":56762},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3355":2837,"_29485":2592,"_20482":56764,"_5":14053,"_26831":56157,"_2843":56765},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3355":2838,"_29485":2592,"_20482":56767,"_5":14053,"_26831":56157,"_2843":56768},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_56771":56772,"_56773":56774,"_56775":56776,"_56777":56778,"_17756":2865,"_68088":2865},"language","english","sortableProperties",[2843,29485,5,26831],"sortablePropertiesWithTypes",{"_2843":24474,"_29485":24474,"_5":24474,"_26831":24474},"sorts",{"_2843":56779,"_29485":59607,"_5":62434,"_26831":65261},{"_4517":56780,"_56781":56782,"_5":24474},{"_14135":5814,"_14511":8768,"_14530":6297,"_12656":7191,"_14517":3027,"_19453":8299,"_14156":6392,"_14163":15668,"_28437":14099,"_28845":11105,"_28866":6774,"_28471":4106,"_33754