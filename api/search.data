Amazon EC2.",{"_3604":72398,"_31083":72396,"_5":31418,"_21524":119756,"_28264":119757,"_3060":119758},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3604":72399,"_31083":72396,"_5":31418,"_21524":119760,"_28264":119761,"_3060":119762},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3604":72400,"_31083":72396,"_5":31418,"_21524":119764,"_28264":119765,"_3060":119766},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3604":72401,"_31083":72396,"_5":31418,"_21524":119768,"_28264":119769,"_3060":119770},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3604":72402,"_31083":72396,"_5":31418,"_21524":119772,"_28264":119773,"_3060":119774},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3604":72403,"_31083":72396,"_5":31418,"_21524":119776,"_28264":119777,"_3060":119778},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3604":72404,"_31083":72396,"_5":31418,"_21524":119780,"_28264":119781,"_3060":119782},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3604":72405,"_31083":72396,"_21524":119784,"_5":14790,"_28264":72396,"_3060":119785},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3604":72406,"_31083":72396,"_21524":119787,"_5":14790,"_28264":119757,"_3060":119788},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3604":72407,"_31083":72396,"_21524":119790,"_5":14790,"_28264":119757,"_3060":119791},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3604":72408,"_31083":72396,"_21524":119793,"_5":14790,"_28264":119757,"_3060":119794},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3604":72409,"_31083":72396,"_21524":119796,"_5":14790,"_28264":119761,"_3060":119797},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3604":72410,"_31083":72396,"_21524":119799,"_5":14790,"_28264":119761,"_3060":119800},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3604":72411,"_31083":72396,"_21524":119802,"_5":14790,"_28264":119761,"_3060":119803},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3604":72412,"_31083":72396,"_21524":119805,"_5":14790,"_28264":119765,"_3060":119806},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3604":72413,"_31083":72396,"_21524":119808,"_5":14790,"_28264":119769,"_3060":119809},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3604":72414,"_31083":72396,"_21524":119811,"_5":14790,"_28264":119773,"_3060":119812},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3604":72415,"_31083":72396,"_21524":119814,"_5":14790,"_28264":119777,"_3060":119815},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3604":72416,"_31083":72396,"_21524":119817,"_5":14790,"_28264":119781,"_3060":119818},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3604":72417,"_31083":72417,"_5":15155,"_3060":119820,"_31421":119821,"_21524":119822,"_28264":72417},"Despliega Lamassu",[50730,119749],[],{"_3604":72418,"_31083":72417,"_21524":119824,"_5":14790,"_28264":72417,"_3060":119825},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3604":72419,"_31083":72417,"_5":31418,"_21524":119827,"_28264":119828,"_3060":119829},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3604":72420,"_31083":72417,"_5":31418,"_21524":119831,"_28264":119832,"_3060":119833},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3604":72421,"_31083":72417,"_5":31418,"_21524":119835,"_28264":119836,"_3060":119837},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3604":72422,"_31083":72417,"_21524":119839,"_5":14790,"_28264":72417,"_3060":119840},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3604":72423,"_31083":72417,"_21524":119842,"_5":14790,"_28264":119828,"_3060":119843},[],"Modelo",{"_3604":72424,"_31083":72417,"_21524":119845,"_5":14790,"_28264":119828,"_3060":119846},[],"Recomendado para",{"_3604":72425,"_31083":72417,"_21524":119848,"_5":14790,"_28264":119828,"_3060":119849},[],"Quién opera la infraestructura",{"_3604":72426,"_31083":72417,"_21524":119851,"_5":14790,"_28264":119828,"_3060":119852},[],"Punto de partida",{"_3604":72427,"_31083":72417,"_21524":119854,"_5":14790,"_28264":119828,"_3060":50837},[],{"_3604":72428,"_31083":72417,"_21524":119856,"_5":14790,"_28264":119828,"_3060":119857},[],"Producción, entornos regulados y despliegues personalizados",{"_3604":72429,"_31083":72417,"_21524":119859,"_5":14790,"_28264":119828,"_3060":119860},[],"Tu equipo",{"_3604":72430,"_31083":72417,"_21524":119862,"_5":14790,"_28264":119828,"_3060":119863},[],"Helm o Fastlane",{"_3604":72431,"_31083":72417,"_21524":119865,"_5":14790,"_28264":119828,"_3060":50849},[],{"_3604":72432,"_31083":72417,"_21524":119867,"_5":14790,"_28264":119828,"_3060":119868},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3604":72433,"_31083":72417,"_21524":119870,"_5":14790,"_28264":119828,"_3060":119860},[],{"_3604":72434,"_31083":72417,"_21524":119872,"_5":14790,"_28264":119828,"_3060":119873},[],"Imagen preconfigurada en EC2",{"_3604":72435,"_31083":72417,"_21524":119875,"_5":14790,"_28264":119828,"_3060":50860},[],{"_3604":72436,"_31083":72417,"_21524":119877,"_5":14790,"_28264":119828,"_3060":119878},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3604":72437,"_31083":72417,"_21524":119880,"_5":14790,"_28264":119828,"_3060":50866},[],{"_3604":72438,"_31083":72417,"_21524":119882,"_5":14790,"_28264":119828,"_3060":119883},[],"Suscripción gestionada",{"_3604":72439,"_31083":72417,"_21524":119885,"_5":14790,"_28264":119828,"_3060":119886},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3604":72440,"_31083":72417,"_21524":119888,"_5":14790,"_28264":119828,"_3060":119889},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3604":72441,"_31083":72417,"_21524":119891,"_5":14790,"_28264":119828,"_3060":119892},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3604":72442,"_31083":72417,"_21524":119894,"_5":14790,"_28264":119832,"_3060":119895},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3604":72443,"_31083":72417,"_21524":119897,"_5":14790,"_28264":119836,"_3060":119898},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3604":72444,"_31083":72444,"_5":15155,"_3060":119900,"_31421":119901,"_21524":119902,"_28264":72444},"Utiliza Lamassu como SaaS",[50730,119749,119750],[],{"_3604":72445,"_31083":72444,"_21524":119904,"_5":14790,"_28264":72444,"_3060":119905},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3604":72446,"_31083":72444,"_5":31418,"_21524":119907,"_28264":119908,"_3060":119909},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3604":72447,"_31083":72444,"_5":31418,"_21524":119911,"_28264":119912,"_3060":119913},[],"/docs/es/deployment/saas#planes","Planes",{"_3604":72448,"_31083":72444,"_5":31418,"_21524":119915,"_28264":119916,"_3060":119917},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3604":72449,"_31083":72444,"_21524":119919,"_5":14790,"_28264":72444,"_3060":119920},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3604":72450,"_31083":72444,"_21524":119922,"_5":14790,"_28264":119908,"_3060":119923},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3604":72451,"_31083":72444,"_21524":119925,"_5":14790,"_28264":119908,"_3060":119926},[],"Copias de seguridad automáticas.",{"_3604":72452,"_31083":72444,"_21524":119928,"_5":14790,"_28264":119908,"_3060":119929},[],"Actualizaciones de versión.",{"_3604":72453,"_31083":72444,"_21524":119931,"_5":14790,"_28264":119908,"_3060":119932},[],"Soporte técnico y SLA según el plan contratado.",{"_3604":72454,"_31083":72444,"_21524":119934,"_5":14790,"_28264":119912,"_3060":50921},[],{"_3604":72455,"_31083":72444,"_21524":119936,"_5":14790,"_28264":119912,"_3060":119937},[],"Dispositivos",{"_3604":72456,"_31083":72444,"_21524":119939,"_5":14790,"_28264":119912,"_3060":119940},[],"Soporte",{"_3604":72457,"_31083":72444,"_21524":119942,"_5":14790,"_28264":119912,"_3060":50930},[],{"_3604":72458,"_31083":72444,"_21524":119944,"_5":14790,"_28264":119912,"_3060":50933},[],{"_3604":72459,"_31083":72444,"_21524":119946,"_5":14790,"_28264":119912,"_3060":119947},[],"Hasta 1.000",{"_3604":72460,"_31083":72444,"_21524":119949,"_5":14790,"_28264":119912,"_3060":50939},[],{"_3604":72461,"_31083":72444,"_21524":119951,"_5":14790,"_28264":119912,"_3060":119952},[],"99,5 %",{"_3604":72462,"_31083":72444,"_21524":119954,"_5":14790,"_28264":119912,"_3060":50945},[],{"_3604":72463,"_31083":72444,"_21524":119956,"_5":14790,"_28264":119912,"_3060":119957},[],"Hasta 10.000",{"_3604":72464,"_31083":72444,"_21524":119959,"_5":14790,"_28264":119912,"_3060":119960},[],"Email y chat",{"_3604":72465,"_31083":72444,"_21524":119962,"_5":14790,"_28264":119912,"_3060":119963},[],"99,9 %",{"_3604":72466,"_31083":72444,"_21524":119965,"_5":14790,"_28264":119912,"_3060":50957},[],{"_3604":72467,"_31083":72444,"_21524":119967,"_5":14790,"_28264":119912,"_3060":119968},[],"Ilimitados",{"_3604":72468,"_31083":72444,"_21524":119970,"_5":14790,"_28264":119912,"_3060":119971},[],"Dedicado",{"_3604":72469,"_31083":72444,"_21524":119973,"_5":14790,"_28264":119912,"_3060":119974},[],"99,99 %",{"_3604":72470,"_31083":72444,"_21524":119976,"_5":14790,"_28264":119916,"_3060":119977},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3604":72471,"_31083":72444,"_21524":119979,"_5":14790,"_28264":119916,"_3060":119980},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3604":72472,"_31083":72472,"_5":15155,"_3060":50974,"_31421":119982,"_21524":119984,"_28264":72472},[50730,119749,119983],"Kubernetes autogestionado",[],{"_3604":72473,"_31083":72472,"_21524":119986,"_5":14790,"_28264":72472,"_3060":119987},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3604":72474,"_31083":72472,"_5":31418,"_21524":119989,"_28264":119990,"_3060":119991},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3604":72475,"_31083":72472,"_5":31418,"_21524":119993,"_28264":119994,"_3060":119995},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3604":72476,"_31083":72472,"_5":31418,"_21524":119997,"_28264":119998,"_3060":119999},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3604":72477,"_31083":72472,"_5":31418,"_21524":120001,"_28264":120002,"_3060":120003},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3604":72478,"_31083":72472,"_5":31418,"_21524":120005,"_28264":120006,"_3060":120007},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3604":72479,"_31083":72472,"_5":31418,"_21524":120009,"_28264":120010,"_3060":120011},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3604":72480,"_31083":72472,"_5":31418,"_21524":120013,"_28264":120014,"_3060":120015},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3604":72481,"_31083":72472,"_5":31418,"_21524":120017,"_28264":120018,"_3060":120019},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3604":72482,"_31083":72472,"_5":31418,"_21524":120021,"_28264":120022,"_3060":120023},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3604":72483,"_31083":72472,"_5":31418,"_21524":120025,"_28264":120026,"_3060":120027},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3604":72484,"_31083":72472,"_5":31418,"_21524":120029,"_28264":120030,"_3060":120031},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3604":72485,"_31083":72472,"_21524":120033,"_5":14790,"_28264":119990,"_3060":120034},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3604":72486,"_31083":72472,"_21524":120036,"_5":14790,"_28264":119990,"_3060":120037},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3604":72487,"_31083":72472,"_21524":120039,"_5":14790,"_28264":119994,"_3060":120040},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3604":72488,"_31083":72472,"_21524":120042,"_5":14790,"_28264":119994,"_3060":120043},[],"Fastlane instala o configura",{"_3604":72489,"_31083":72472,"_21524":120045,"_5":14790,"_28264":119994,"_3060":120046},[],"Tú sigues proporcionando",{"_3604":72490,"_31083":72472,"_21524":120048,"_5":14790,"_28264":119994,"_3060":120049},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3604":72491,"_31083":72472,"_21524":120051,"_5":14790,"_28264":119994,"_3060":120052},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3604":72492,"_31083":72472,"_21524":120054,"_5":14790,"_28264":119994,"_3060":120055},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3604":72493,"_31083":72472,"_21524":120057,"_5":14790,"_28264":119994,"_3060":120058},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3604":72494,"_31083":72472,"_21524":120060,"_5":14790,"_28264":119994,"_3060":120061},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3604":72495,"_31083":72472,"_21524":120063,"_5":14790,"_28264":119994,"_3060":120064},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3604":72496,"_31083":72472,"_21524":120066,"_5":14790,"_28264":119994,"_3060":120067},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3604":72497,"_31083":72472,"_21524":120069,"_5":14790,"_28264":119994,"_3060":120070},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3604":72498,"_31083":72472,"_21524":120072,"_5":14790,"_28264":119994,"_3060":120073},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3604":72499,"_31083":72472,"_21524":120075,"_5":14790,"_28264":119998,"_3060":120076},[],"Necesitas:",{"_3604":72500,"_31083":72472,"_21524":120078,"_5":14790,"_28264":119998,"_3060":120079},[],"un clúster Kubernetes existente",{"_3604":72501,"_31083":72472,"_21524":120081,"_5":14790,"_28264":119998,"_3060":120082},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3604":72502,"_31083":72472,"_21524":120084,"_5":14790,"_28264":119998,"_3060":51076},[],{"_3604":72503,"_31083":72472,"_21524":120086,"_5":14790,"_28264":119998,"_3060":24330},[],{"_3604":72504,"_31083":72472,"_21524":120088,"_5":14790,"_28264":119998,"_3060":120089},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3604":72505,"_31083":72472,"_21524":120091,"_5":14790,"_28264":119998,"_3060":120092},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3604":72506,"_31083":72472,"_21524":120094,"_5":14790,"_28264":119998,"_3060":120095},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3604":72507,"_31083":72472,"_21524":120097,"_5":14790,"_28264":119998,"_3060":120098},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3604":72508,"_31083":72472,"_21524":120100,"_5":14790,"_28264":119998,"_3060":120101},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3604":72509,"_31083":72472,"_21524":120103,"_5":14790,"_28264":120002,"_3060":120104},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3604":72510,"_31083":72472,"_21524":120106,"_5":14790,"_28264":120002,"_3060":120107},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3604":72511,"_31083":72472,"_21524":120109,"_5":14790,"_28264":120006,"_3060":120110},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3604":72512,"_31083":72472,"_21524":120112,"_5":14790,"_28264":120006,"_3060":120113},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3604":72513,"_31083":72472,"_21524":120115,"_5":14790,"_28264":120006,"_3060":120116},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3604":72514,"_31083":72472,"_21524":120118,"_5":14790,"_28264":120006,"_3060":120119},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3604":72515,"_31083":72472,"_21524":120121,"_5":14790,"_28264":120010,"_3060":120122},[],"Opción",{"_3604":72516,"_31083":72472,"_21524":120124,"_5":14790,"_28264":120010,"_3060":120125},[],"Valor predeterminado",{"_3604":72517,"_31083":72472,"_21524":120127,"_5":14790,"_28264":120010,"_3060":120128},[],"Propósito",{"_3604":72518,"_31083":72472,"_21524":120130,"_5":14790,"_28264":120010,"_3060":51123},[],{"_3604":72519,"_31083":72472,"_21524":120132,"_5":14790,"_28264":120010,"_3060":51126},[],{"_3604":72520,"_31083":72472,"_21524":120134,"_5":14790,"_28264":120010,"_3060":120135},[],"Muestra la ayuda",{"_3604":72521,"_31083":72472,"_21524":120137,"_5":14790,"_28264":120010,"_3060":51132},[],{"_3604":72522,"_31083":72472,"_21524":120139,"_5":14790,"_28264":120010,"_3060":120140},[],"contexto actual",{"_3604":72523,"_31083":72472,"_21524":120142,"_5":14790,"_28264":120010,"_3060":120143},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3604":72524,"_31083":72472,"_21524":120145,"_5":14790,"_28264":120010,"_3060":51141},[],{"_3604":72525,"_31083":72472,"_21524":120147,"_5":14790,"_28264":120010,"_3060":6764},[],{"_3604":72526,"_31083":72472,"_21524":120149,"_5":14790,"_28264":120010,"_3060":120150},[],"Omite prompts y genera credenciales para las dependencias",{"_3604":72527,"_31083":72472,"_21524":120152,"_5":14790,"_28264":120010,"_3060":51149},[],{"_3604":72528,"_31083":72472,"_21524":120154,"_5":14790,"_28264":120010,"_3060":51152},[],{"_3604":72529,"_31083":72472,"_21524":120156,"_5":14790,"_28264":120010,"_3060":120157},[],"Namespace de la instalación",{"_3604":72530,"_31083":72472,"_21524":120159,"_5":14790,"_28264":120010,"_3060":51158},[],{"_3604":72531,"_31083":72472,"_21524":120161,"_5":14790,"_28264":120010,"_3060":51161},[],{"_3604":72532,"_31083":72472,"_21524":120163,"_5":14790,"_28264":120010,"_3060":120164},[],"Dominio usado por la UI, OIDC y el certificado",{"_3604":72533,"_31083":72472,"_21524":120166,"_5":14790,"_28264":120010,"_3060":51167},[],{"_3604":72534,"_31083":72472,"_21524":120168,"_5":14790,"_28264":120010,"_3060":15502},[],{"_3604":72535,"_31083":72472,"_21524":120170,"_5":14790,"_28264":120010,"_3060":120171},[],"Versión del chart de Lamassu",{"_3604":72536,"_31083":72472,"_21524":120173,"_5":14790,"_28264":120010,"_3060":51175},[],{"_3604":72537,"_31083":72472,"_21524":120175,"_5":14790,"_28264":120010,"_3060":51178},[],{"_3604":72538,"_31083":72472,"_21524":120177,"_5":14790,"_28264":120010,"_3060":120178},[],"Puerto del listener HTTPS",{"_3604":72539,"_31083":72472,"_21524":120180,"_5":14790,"_28264":120010,"_3060":51184},[],{"_3604":72540,"_31083":72472,"_21524":120182,"_5":14790,"_28264":120010,"_3060":51187},[],{"_3604":72541,"_31083":72472,"_21524":120184,"_5":14790,"_28264":120010,"_3060":120185},[],"Puerto del listener HTTP",{"_3604":72542,"_31083":72472,"_21524":120187,"_5":14790,"_28264":120010,"_3060":51193},[],{"_3604":72543,"_31083":72472,"_21524":120189,"_5":14790,"_28264":120010,"_3060":51126},[],{"_3604":72544,"_31083":72472,"_21524":120191,"_5":14790,"_28264":120010,"_3060":120192},[],"Certificado PEM para TLS downstream",{"_3604":72545,"_31083":72472,"_21524":120194,"_5":14790,"_28264":120010,"_3060":51201},[],{"_3604":72546,"_31083":72472,"_21524":120196,"_5":14790,"_28264":120010,"_3060":51126},[],{"_3604":72547,"_31083":72472,"_21524":120198,"_5":14790,"_28264":120010,"_3060":120199},[],"Clave privada PEM para TLS downstream",{"_3604":72548,"_31083":72472,"_21524":120201,"_5":14790,"_28264":120010,"_3060":51209},[],{"_3604":72549,"_31083":72472,"_21524":120203,"_5":14790,"_28264":120010,"_3060":120204},[],"chart del repositorio",{"_3604":72550,"_31083":72472,"_21524":120206,"_5":14790,"_28264":120010,"_3060":120207},[],"Usa un chart local de Lamassu sin empaquetar",{"_3604":72551,"_31083":72472,"_21524":120209,"_5":14790,"_28264":120010,"_3060":51218},[],{"_3604":72552,"_31083":72472,"_21524":120211,"_5":14790,"_28264":120010,"_3060":120212},[],"detección automática",{"_3604":72553,"_31083":72472,"_21524":120214,"_5":14790,"_28264":120010,"_3060":120215},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3604":72554,"_31083":72472,"_21524":120217,"_5":14790,"_28264":120010,"_3060":51226},[],{"_3604":72555,"_31083":72472,"_21524":120219,"_5":14790,"_28264":120010,"_3060":6764},[],{"_3604":72556,"_31083":72472,"_21524":120221,"_5":14790,"_28264":120010,"_3060":120222},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3604":72557,"_31083":72472,"_21524":120224,"_5":14790,"_28264":120010,"_3060":51234},[],{"_3604":72558,"_31083":72472,"_21524":120226,"_5":14790,"_28264":120010,"_3060":6764},[],{"_3604":72559,"_31083":72472,"_21524":120228,"_5":14790,"_28264":120010,"_3060":120229},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3604":72560,"_31083":72472,"_21524":120231,"_5":14790,"_28264":120010,"_3060":51242},[],{"_3604":72561,"_31083":72472,"_21524":120233,"_5":14790,"_28264":120010,"_3060":6764},[],{"_3604":72562,"_31083":72472,"_21524":120235,"_5":14790,"_28264":120010,"_3060":120236},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3604":72563,"_31083":72472,"_21524":120238,"_5":14790,"_28264":120010,"_3060":51250},[],{"_3604":72564,"_31083":72472,"_21524":120240,"_5":14790,"_28264":120010,"_3060":6764},[],{"_3604":72565,"_31083":72472,"_21524":120242,"_5":14790,"_28264":120010,"_3060":120243},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3604":72566,"_31083":72472,"_21524":120245,"_5":14790,"_28264":120010,"_3060":51258},[],{"_3604":72567,"_31083":72472,"_21524":120247,"_5":14790,"_28264":120010,"_3060":51261},[],{"_3604":72568,"_31083":72472,"_21524":120249,"_5":14790,"_28264":120010,"_3060":120250},[],"Usa otro chart local de SoftHSM",{"_3604":72569,"_31083":72472,"_21524":120252,"_5":14790,"_28264":120010,"_3060":120253},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3604":72570,"_31083":72472,"_21524":120255,"_5":14790,"_28264":120014,"_3060":120256},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3604":72571,"_31083":72472,"_21524":120258,"_5":14790,"_28264":120014,"_3060":120259},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3604":72572,"_31083":72472,"_21524":120261,"_5":14790,"_28264":120014,"_3060":120262},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3604":72573,"_31083":72472,"_21524":120264,"_5":14790,"_28264":120014,"_3060":120265},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3604":72574,"_31083":72472,"_21524":120267,"_5":14790,"_28264":120014,"_3060":120268},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3604":72575,"_31083":72472,"_21524":120270,"_5":14790,"_28264":120014,"_3060":120271},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3604":72576,"_31083":72472,"_21524":120273,"_5":14790,"_28264":120018,"_3060":51288},[],{"_3604":72577,"_31083":72472,"_21524":120275,"_5":14790,"_28264":120018,"_3060":120276},[],"valida las herramientas locales y el clúster seleccionado",{"_3604":72578,"_31083":72472,"_21524":120278,"_5":14790,"_28264":120018,"_3060":120279},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3604":72579,"_31083":72472,"_21524":120281,"_5":14790,"_28264":120018,"_3060":120282},[],"crea el namespace",{"_3604":72580,"_31083":72472,"_21524":120284,"_5":14790,"_28264":120018,"_3060":120285},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3604":72581,"_31083":72472,"_21524":120287,"_5":14790,"_28264":120018,"_3060":120288},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3604":72582,"_31083":72472,"_21524":120290,"_5":14790,"_28264":120018,"_3060":120291},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3604":72583,"_31083":72472,"_21524":120293,"_5":14790,"_28264":120018,"_3060":120294},[],"instala RabbitMQ",{"_3604":72584,"_31083":72472,"_21524":120296,"_5":14790,"_28264":120018,"_3060":120297},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3604":72585,"_31083":72472,"_21524":120299,"_5":14790,"_28264":120018,"_3060":120300},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3604":72586,"_31083":72472,"_21524":120302,"_5":14790,"_28264":120018,"_3060":120303},[],"carga datos de ejemplo opcionalmente",{"_3604":72587,"_31083":72472,"_21524":120305,"_5":14790,"_28264":120018,"_3060":120306},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3604":72588,"_31083":72472,"_21524":120308,"_5":14790,"_28264":120022,"_3060":120309},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3604":72589,"_31083":72472,"_21524":120311,"_5":14790,"_28264":120022,"_3060":120312},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3604":72590,"_31083":72472,"_21524":120314,"_5":14790,"_28264":120026,"_3060":120315},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3604":72591,"_31083":72472,"_21524":120317,"_5":14790,"_28264":120026,"_3060":120318},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3604":72592,"_31083":72472,"_21524":120320,"_5":14790,"_28264":120026,"_3060":120321},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3604":72593,"_31083":72472,"_21524":120323,"_5":14790,"_28264":120026,"_3060":120324},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3604":72594,"_31083":72472,"_21524":120326,"_5":14790,"_28264":120030,"_3060":120327},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3604":72595,"_31083":72595,"_5":15155,"_3060":120329,"_31421":120330,"_21524":120331,"_28264":72595},"Instala con Helm",[50730,119749,119983],[],{"_3604":72596,"_31083":72595,"_21524":120333,"_5":14790,"_28264":72595,"_3060":120334},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3604":72597,"_31083":72595,"_5":31418,"_21524":120336,"_28264":120337,"_3060":120338},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3604":72598,"_31083":72595,"_5":31418,"_21524":120340,"_28264":120341,"_3060":119999},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3604":72599,"_31083":72595,"_5":31418,"_21524":120343,"_28264":120344,"_3060":120345},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3604":72600,"_31083":72595,"_5":31418,"_21524":120347,"_28264":120348,"_3060":120349},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3604":72601,"_31083":72595,"_5":31418,"_21524":120351,"_28264":120352,"_3060":120353},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3604":72602,"_31083":72595,"_5":31418,"_21524":120355,"_28264":120356,"_3060":120357},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3604":72603,"_31083":72595,"_5":31418,"_21524":120359,"_28264":120360,"_3060":120361},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3604":72604,"_31083":72595,"_5":31418,"_21524":120363,"_28264":120364,"_3060":120365},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3604":72605,"_31083":72595,"_5":31418,"_21524":120367,"_28264":120368,"_3060":120369},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3604":72606,"_31083":72595,"_5":31418,"_21524":120371,"_28264":120372,"_3060":120373},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3604":72607,"_31083":72595,"_5":31418,"_21524":120375,"_28264":120376,"_3060":120377},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3604":72608,"_31083":72595,"_5":31418,"_21524":120379,"_28264":120380,"_3060":120381},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3604":72609,"_31083":72595,"_21524":120383,"_5":14790,"_28264":120337,"_3060":120384},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3604":72610,"_31083":72595,"_21524":120386,"_5":14790,"_28264":120341,"_3060":120387},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3604":72611,"_31083":72595,"_21524":120389,"_5":14790,"_28264":120341,"_3060":120390},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3604":72612,"_31083":72595,"_21524":120392,"_5":14790,"_28264":120341,"_3060":120393},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3604":72613,"_31083":72595,"_21524":120395,"_5":14790,"_28264":120341,"_3060":120396},[],"un broker RabbitMQ accesible y sus credenciales",{"_3604":72614,"_31083":72595,"_21524":120398,"_5":14790,"_28264":120341,"_3060":120399},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3604":72615,"_31083":72595,"_21524":120401,"_5":14790,"_28264":120341,"_3060":120402},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3604":72616,"_31083":72595,"_21524":120404,"_5":14790,"_28264":120341,"_3060":120405},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3604":72617,"_31083":72595,"_21524":120407,"_5":14790,"_28264":120341,"_3060":120408},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3604":72618,"_31083":72595,"_21524":120410,"_5":14790,"_28264":120341,"_3060":120411},[],"una StorageClass y un diseño de tráfico externo",{"_3604":72619,"_31083":72595,"_21524":120413,"_5":14790,"_28264":120341,"_3060":120414},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3604":72620,"_31083":72595,"_21524":120416,"_5":14790,"_28264":120341,"_3060":120417},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3604":72621,"_31083":72595,"_21524":120419,"_5":14790,"_28264":120341,"_3060":120420},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3604":72622,"_31083":72595,"_21524":120422,"_5":14790,"_28264":120344,"_3060":120423},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3604":72623,"_31083":72595,"_21524":120425,"_5":14790,"_28264":120344,"_3060":120426},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3604":72624,"_31083":72595,"_21524":120428,"_5":14790,"_28264":120344,"_3060":120429},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3604":72625,"_31083":72595,"_21524":120431,"_5":14790,"_28264":120348,"_3060":120432},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3604":72626,"_31083":72595,"_21524":120434,"_5":14790,"_28264":120348,"_3060":120435},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3604":72627,"_31083":72595,"_21524":120437,"_5":14790,"_28264":120348,"_3060":120438},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3604":72628,"_31083":72595,"_21524":120440,"_5":14790,"_28264":120348,"_3060":120441},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3604":72629,"_31083":72595,"_21524":120443,"_5":14790,"_28264":120352,"_3060":120444},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3604":72630,"_31083":72595,"_21524":120446,"_5":14790,"_28264":120352,"_3060":120447},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3604":72631,"_31083":72595,"_21524":120449,"_5":14790,"_28264":120352,"_3060":120450},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3604":72632,"_31083":72595,"_21524":120452,"_5":14790,"_28264":120352,"_3060":120453},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3604":72633,"_31083":72595,"_21524":120455,"_5":14790,"_28264":120352,"_3060":120456},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3604":72634,"_31083":72595,"_21524":120458,"_5":14790,"_28264":120352,"_3060":120459},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3604":72635,"_31083":72595,"_21524":120461,"_5":14790,"_28264":120352,"_3060":120462},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3604":72636,"_31083":72595,"_21524":120464,"_5":14790,"_28264":120352,"_3060":120465},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3604":72637,"_31083":72595,"_21524":120467,"_5":14790,"_28264":120356,"_3060":120468},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3604":72638,"_31083":72595,"_21524":120470,"_5":14790,"_28264":120360,"_3060":120471},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3604":72639,"_31083":72595,"_21524":120473,"_5":14790,"_28264":120360,"_3060":120474},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3604":72640,"_31083":72595,"_21524":120476,"_5":14790,"_28264":120360,"_3060":120477},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3604":72641,"_31083":72595,"_21524":120479,"_5":14790,"_28264":120360,"_3060":120480},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3604":72642,"_31083":72595,"_21524":120482,"_5":14790,"_28264":120360,"_3060":120483},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3604":72643,"_31083":72595,"_21524":120485,"_5":14790,"_28264":120360,"_3060":120486},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3604":72644,"_31083":72595,"_21524":120488,"_5":14790,"_28264":120360,"_3060":120489},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3604":72645,"_31083":72595,"_21524":120491,"_5":14790,"_28264":120364,"_3060":120492},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3604":72646,"_31083":72595,"_21524":120494,"_5":14790,"_28264":120364,"_3060":120495},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3604":72647,"_31083":72595,"_21524":120497,"_5":14790,"_28264":120364,"_3060":120498},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3604":72648,"_31083":72595,"_21524":120500,"_5":14790,"_28264":120364,"_3060":120501},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3604":72649,"_31083":72595,"_21524":120503,"_5":14790,"_28264":120368,"_3060":120504},[],"Para instalar un checkout local:",{"_3604":72650,"_31083":72595,"_21524":120506,"_5":14790,"_28264":120372,"_3060":120507},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3604":72651,"_31083":72595,"_21524":120509,"_5":14790,"_28264":120372,"_3060":120510},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3604":72652,"_31083":72595,"_21524":120512,"_5":14790,"_28264":120376,"_3060":120513},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3604":72653,"_31083":72595,"_21524":120515,"_5":14790,"_28264":120376,"_3060":120516},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3604":72654,"_31083":72595,"_21524":120518,"_5":14790,"_28264":120376,"_3060":120519},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3604":72655,"_31083":72595,"_21524":120521,"_5":14790,"_28264":120376,"_3060":120522},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3604":72656,"_31083":72595,"_21524":120524,"_5":14790,"_28264":120376,"_3060":120525},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3604":72657,"_31083":72595,"_21524":120527,"_5":14790,"_28264":120380,"_3060":120528},[],"Antes de pasar a producción, revisa:",{"_3604":72658,"_31083":72595,"_21524":120530,"_5":14790,"_28264":120380,"_3060":120531},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3604":72659,"_31083":72595,"_21524":120533,"_5":14790,"_28264":120380,"_3060":120534},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3604":72660,"_31083":72595,"_21524":120536,"_5":14790,"_28264":120380,"_3060":120537},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3604":72661,"_31083":72595,"_21524":120539,"_5":14790,"_28264":120380,"_3060":120540},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3604":72662,"_31083":72595,"_21524":120542,"_5":14790,"_28264":120380,"_3060":120543},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3604":72663,"_31083":72595,"_21524":120545,"_5":14790,"_28264":120380,"_3060":120546},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3604":72664,"_31083":72595,"_21524":120548,"_5":14790,"_28264":120380,"_3060":120549},[],"SMTP, observabilidad y entrega de alertas",{"_3604":72665,"_31083":72595,"_21524":120551,"_5":14790,"_28264":120380,"_3060":120552},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3604":72666,"_31083":72595,"_21524":120554,"_5":14790,"_28264":120380,"_3060":120555},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3604":72667,"_31083":72667,"_5":15155,"_3060":120557,"_31421":120558,"_21524":120559,"_28264":72667},"Expón el Gateway",[50730,119749,119983],[],{"_3604":72668,"_31083":72667,"_21524":120561,"_5":14790,"_28264":72667,"_3060":120562},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3604":72669,"_31083":72667,"_5":31418,"_21524":120564,"_28264":120565,"_3060":120566},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3604":72670,"_31083":72667,"_5":31418,"_21524":120568,"_28264":120569,"_3060":120570},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3604":72671,"_31083":72667,"_5":31418,"_21524":120572,"_28264":120573,"_3060":120574},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3604":72672,"_31083":72667,"_5":31418,"_21524":120576,"_28264":120577,"_3060":51593},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3604":72673,"_31083":72667,"_5":31418,"_21524":120579,"_28264":120580,"_3060":120581},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3604":72674,"_31083":72667,"_5":31418,"_21524":120583,"_28264":120584,"_3060":120585},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3604":72675,"_31083":72667,"_5":31418,"_21524":120587,"_28264":120588,"_3060":120589},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3604":72676,"_31083":72667,"_5":31418,"_21524":120591,"_28264":120592,"_3060":120593},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3604":72677,"_31083":72667,"_5":31418,"_21524":120595,"_28264":120596,"_3060":120597},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3604":72678,"_31083":72667,"_5":31418,"_21524":120599,"_28264":120600,"_3060":120601},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3604":72679,"_31083":72667,"_5":31418,"_21524":120603,"_28264":120604,"_3060":120605},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3604":72680,"_31083":72667,"_21524":120607,"_5":14790,"_28264":120565,"_3060":120608},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3604":72681,"_31083":72667,"_21524":120610,"_5":14790,"_28264":120565,"_3060":120611},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3604":72682,"_31083":72667,"_21524":120613,"_5":14790,"_28264":120569,"_3060":120614},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3604":72683,"_31083":72667,"_21524":120616,"_5":14790,"_28264":120569,"_3060":120617},[],"Defínelo únicamente cuando:",{"_3604":72684,"_31083":72667,"_21524":120619,"_5":14790,"_28264":120569,"_3060":120620},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3604":72685,"_31083":72667,"_21524":120622,"_5":14790,"_28264":120569,"_3060":120623},[],"esa dirección está asignada a este Gateway",{"_3604":72686,"_31083":72667,"_21524":120625,"_5":14790,"_28264":120569,"_3060":120626},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3604":72687,"_31083":72667,"_21524":120628,"_5":14790,"_28264":120569,"_3060":120629},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3604":72688,"_31083":72667,"_21524":120631,"_5":14790,"_28264":120569,"_3060":120632},[],"No confundas estos valores:",{"_3604":72689,"_31083":72667,"_21524":120634,"_5":14790,"_28264":120569,"_3060":120635},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3604":72690,"_31083":72667,"_21524":120637,"_5":14790,"_28264":120569,"_3060":120638},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3604":72691,"_31083":72667,"_21524":120640,"_5":14790,"_28264":120569,"_3060":120641},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3604":72692,"_31083":72667,"_21524":120643,"_5":14790,"_28264":120573,"_3060":120644},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3604":72693,"_31083":72667,"_21524":120646,"_5":14790,"_28264":120573,"_3060":120647},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3604":72694,"_31083":72667,"_21524":120649,"_5":14790,"_28264":120577,"_3060":120650},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3604":72695,"_31083":72667,"_21524":120652,"_5":14790,"_28264":120577,"_3060":120653},[],"Para el diseño recomendado:",{"_3604":72696,"_31083":72667,"_21524":120655,"_5":14790,"_28264":120577,"_3060":120656},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3604":72697,"_31083":72667,"_21524":120658,"_5":14790,"_28264":120577,"_3060":120659},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3604":72698,"_31083":72667,"_21524":120661,"_5":14790,"_28264":120577,"_3060":120662},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3604":72699,"_31083":72667,"_21524":120664,"_5":14790,"_28264":120577,"_3060":120665},[],"Apunta DNS a la dirección accesible de la VM.",{"_3604":72700,"_31083":72667,"_21524":120667,"_5":14790,"_28264":120577,"_3060":120668},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3604":72701,"_31083":72667,"_21524":120670,"_5":14790,"_28264":120580,"_3060":120671},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3604":72702,"_31083":72667,"_21524":120673,"_5":14790,"_28264":120584,"_3060":120674},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3604":72703,"_31083":72667,"_21524":120676,"_5":14790,"_28264":120584,"_3060":120677},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3604":72704,"_31083":72667,"_21524":120679,"_5":14790,"_28264":120588,"_3060":120680},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3604":72705,"_31083":72667,"_21524":120682,"_5":14790,"_28264":120588,"_3060":120683},[],"Requisito",{"_3604":72706,"_31083":72667,"_21524":120685,"_5":14790,"_28264":120588,"_3060":120686},[],"Diseño recomendado",{"_3604":72707,"_31083":72667,"_21524":120688,"_5":14790,"_28264":120588,"_3060":120689},[],"Consecuencia",{"_3604":72708,"_31083":72667,"_21524":120691,"_5":14790,"_28264":120588,"_3060":120692},[],"Varias URL o servicios de Lamassu",{"_3604":72709,"_31083":72667,"_21524":120694,"_5":14790,"_28264":120588,"_3060":120695},[],"Un Gateway con varias rutas",{"_3604":72710,"_31083":72667,"_21524":120697,"_5":14790,"_28264":120588,"_3060":120698},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3604":72711,"_31083":72667,"_21524":120700,"_5":14790,"_28264":120588,"_3060":120701},[],"Gateways independientes e IP externas distintas",{"_3604":72712,"_31083":72667,"_21524":120703,"_5":14790,"_28264":120588,"_3060":120704},[],"Una VIP por Gateway",{"_3604":72713,"_31083":72667,"_21524":120706,"_5":14790,"_28264":120588,"_3060":120707},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3604":72714,"_31083":72667,"_21524":120709,"_5":14790,"_28264":120588,"_3060":120710},[],"Gateways independientes, un nodo y una IP",{"_3604":72715,"_31083":72667,"_21524":120712,"_5":14790,"_28264":120588,"_3060":120713},[],"Puertos externos diferentes",{"_3604":72716,"_31083":72667,"_21524":120715,"_5":14790,"_28264":120588,"_3060":120716},[],"Los clientes deben indicar puertos no estándar",{"_3604":72717,"_31083":72667,"_21524":120718,"_5":14790,"_28264":120588,"_3060":120719},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3604":72718,"_31083":72667,"_21524":120721,"_5":14790,"_28264":120588,"_3060":120722},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3604":72719,"_31083":72667,"_21524":120724,"_5":14790,"_28264":120588,"_3060":120725},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3604":72720,"_31083":72667,"_21524":120727,"_5":14790,"_28264":120588,"_3060":120728},[],"Recursos Gateway separados pero proxy compartido",{"_3604":72721,"_31083":72667,"_21524":120730,"_5":14790,"_28264":120588,"_3060":120731},[],"Modo merged Gateway de Envoy",{"_3604":72722,"_31083":72667,"_21524":120733,"_5":14790,"_28264":120588,"_3060":120734},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3604":72723,"_31083":72667,"_21524":120736,"_5":14790,"_28264":120588,"_3060":120737},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3604":72724,"_31083":72667,"_21524":120739,"_5":14790,"_28264":120588,"_3060":120740},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3604":72725,"_31083":72667,"_21524":120742,"_5":14790,"_28264":120588,"_3060":120743},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3604":72726,"_31083":72667,"_21524":120745,"_5":14790,"_28264":120588,"_3060":120746},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3604":72727,"_31083":72667,"_21524":120748,"_5":14790,"_28264":120592,"_3060":120749},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3604":72728,"_31083":72667,"_21524":120751,"_5":14790,"_28264":120596,"_3060":120752},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3604":72729,"_31083":72667,"_21524":120754,"_5":14790,"_28264":120596,"_3060":120755},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3604":72730,"_31083":72667,"_21524":120757,"_5":14790,"_28264":120596,"_3060":120758},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3604":72731,"_31083":72667,"_21524":120760,"_5":14790,"_28264":120596,"_3060":120761},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3604":72732,"_31083":72667,"_21524":120763,"_5":14790,"_28264":120596,"_3060":120764},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3604":72733,"_31083":72667,"_21524":120766,"_5":14790,"_28264":120600,"_3060":120767},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3604":72734,"_31083":72667,"_21524":120769,"_5":14790,"_28264":120600,"_3060":120770},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3604":72735,"_31083":72667,"_21524":120772,"_5":14790,"_28264":120604,"_3060":120773},[],"Comprueba, en orden:",{"_3604":72736,"_31083":72667,"_21524":120775,"_5":14790,"_28264":120604,"_3060":120776},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3604":72737,"_31083":72667,"_21524":120778,"_5":14790,"_28264":120604,"_3060":120779},[],"Su estado contiene la dirección esperada.",{"_3604":72738,"_31083":72667,"_21524":120781,"_5":14790,"_28264":120604,"_3060":120782},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3604":72739,"_31083":72667,"_21524":120784,"_5":14790,"_28264":120604,"_3060":120785},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3604":72740,"_31083":72667,"_21524":120787,"_5":14790,"_28264":120604,"_3060":120788},[],"DNS resuelve al endpoint accesible externamente.",{"_3604":72741,"_31083":72667,"_21524":120790,"_5":14790,"_28264":120604,"_3060":120791},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3604":72742,"_31083":72667,"_21524":120793,"_5":14790,"_28264":120604,"_3060":120794},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3604":72743,"_31083":72743,"_5":15155,"_3060":50837,"_31421":120796,"_21524":120797,"_28264":72743},[50730,119749,119983],[],{"_3604":72744,"_31083":72743,"_21524":120799,"_5":14790,"_28264":72743,"_3060":120800},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3604":72745,"_31083":72743,"_5":31418,"_21524":120802,"_28264":120803,"_3060":120804},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3604":72746,"_31083":72743,"_5":31418,"_21524":120806,"_28264":120807,"_3060":120808},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3604":72747,"_31083":72743,"_5":31418,"_21524":120810,"_28264":120811,"_3060":120812},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3604":72748,"_31083":72743,"_5":31418,"_21524":120814,"_28264":120815,"_3060":120816},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3604":72749,"_31083":72743,"_5":31418,"_21524":120818,"_28264":120819,"_3060":120820},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3604":72750,"_31083":72743,"_5":31418,"_21524":120822,"_28264":120823,"_3060":120824},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3604":72751,"_31083":72743,"_21524":120826,"_5":14790,"_28264":120803,"_3060":120827},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3604":72752,"_31083":72743,"_21524":120829,"_5":14790,"_28264":120807,"_3060":120830},[],"Flujo",{"_3604":72753,"_31083":72743,"_21524":120832,"_5":14790,"_28264":120807,"_3060":120833},[],"Úsalo para",{"_3604":72754,"_31083":72743,"_21524":120835,"_5":14790,"_28264":120807,"_3060":120836},[],"Qué instala",{"_3604":72755,"_31083":72743,"_21524":120838,"_5":14790,"_28264":120807,"_3060":51855},[],{"_3604":72756,"_31083":72743,"_21524":120840,"_5":14790,"_28264":120807,"_3060":120841},[],"Producción y entornos controlados",{"_3604":72757,"_31083":72743,"_21524":120843,"_5":14790,"_28264":120807,"_3060":120844},[],"Servicios de Lamassu y recursos de Gateway API",{"_3604":72758,"_31083":72743,"_21524":120846,"_5":14790,"_28264":120807,"_3060":50974},[],{"_3604":72759,"_31083":72743,"_21524":120848,"_5":14790,"_28264":120807,"_3060":120849},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3604":72760,"_31083":72743,"_21524":120851,"_5":14790,"_28264":120807,"_3060":120852},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3604":72761,"_31083":72743,"_21524":120854,"_5":14790,"_28264":120811,"_3060":120855},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3604":72762,"_31083":72743,"_21524":120857,"_5":14790,"_28264":120811,"_3060":120858},[],"Área",{"_3604":72763,"_31083":72743,"_21524":120860,"_5":14790,"_28264":120811,"_3060":120861},[],"El chart de Lamassu proporciona",{"_3604":72764,"_31083":72743,"_21524":120863,"_5":14790,"_28264":120811,"_3060":120864},[],"Tú proporcionas",{"_3604":72765,"_31083":72743,"_21524":120866,"_5":14790,"_28264":120811,"_3060":120867},[],"Aplicaciones Lamassu",{"_3604":72766,"_31083":72743,"_21524":120869,"_5":14790,"_28264":120811,"_3060":120870},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3604":72767,"_31083":72743,"_21524":120872,"_5":14790,"_28264":120811,"_3060":120873},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3604":72768,"_31083":72743,"_21524":120875,"_5":14790,"_28264":120811,"_3060":120876},[],"Datos PostgreSQL",{"_3604":72769,"_31083":72743,"_21524":120878,"_5":14790,"_28264":120811,"_3060":120879},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3604":72770,"_31083":72743,"_21524":120881,"_5":14790,"_28264":120811,"_3060":120882},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3604":72771,"_31083":72743,"_21524":120884,"_5":14790,"_28264":120811,"_3060":120885},[],"Mensajería",{"_3604":72772,"_31083":72743,"_21524":120887,"_5":14790,"_28264":120811,"_3060":120888},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3604":72773,"_31083":72743,"_21524":120890,"_5":14790,"_28264":120811,"_3060":120891},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3604":72774,"_31083":72743,"_21524":120893,"_5":14790,"_28264":120811,"_3060":120894},[],"Identidad",{"_3604":72775,"_31083":72743,"_21524":120896,"_5":14790,"_28264":120811,"_3060":120897},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3604":72776,"_31083":72743,"_21524":120899,"_5":14790,"_28264":120811,"_3060":120900},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3604":72777,"_31083":72743,"_21524":120902,"_5":14790,"_28264":120811,"_3060":120903},[],"Enrutamiento externo",{"_3604":72778,"_31083":72743,"_21524":120905,"_5":14790,"_28264":120811,"_3060":120906},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3604":72779,"_31083":72743,"_21524":120908,"_5":14790,"_28264":120811,"_3060":120909},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3604":72780,"_31083":72743,"_21524":120911,"_5":14790,"_28264":120811,"_3060":51929},[],{"_3604":72781,"_31083":72743,"_21524":120913,"_5":14790,"_28264":120811,"_3060":120914},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3604":72782,"_31083":72743,"_21524":120916,"_5":14790,"_28264":120811,"_3060":120917},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3604":72783,"_31083":72743,"_21524":120919,"_5":14790,"_28264":120811,"_3060":120920},[],"Datos persistentes de la aplicación",{"_3604":72784,"_31083":72743,"_21524":120922,"_5":14790,"_28264":120811,"_3060":120923},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3604":72785,"_31083":72743,"_21524":120925,"_5":14790,"_28264":120811,"_3060":120926},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3604":72786,"_31083":72743,"_21524":120928,"_5":14790,"_28264":120811,"_3060":120929},[],"Integraciones opcionales",{"_3604":72787,"_31083":72743,"_21524":120931,"_5":14790,"_28264":120811,"_3060":120932},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3604":72788,"_31083":72743,"_21524":120934,"_5":14790,"_28264":120811,"_3060":120935},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3604":72789,"_31083":72743,"_21524":120937,"_5":14790,"_28264":120811,"_3060":120938},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3604":72790,"_31083":72743,"_21524":120940,"_5":14790,"_28264":120811,"_3060":120941},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3604":72791,"_31083":72743,"_21524":120943,"_5":14790,"_28264":120815,"_3060":120944},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3604":72792,"_31083":72743,"_21524":120946,"_5":14790,"_28264":120815,"_3060":120947},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3604":72793,"_31083":72743,"_21524":120949,"_5":14790,"_28264":120819,"_3060":120950},[],"Kubernetes 1.24 o posterior",{"_3604":72794,"_31083":72743,"_21524":120952,"_5":14790,"_28264":120819,"_3060":120953},[],"Helm 3.2 o posterior",{"_3604":72795,"_31083":72743,"_21524":120955,"_5":14790,"_28264":120819,"_3060":120956},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3604":72796,"_31083":72743,"_21524":120958,"_5":14790,"_28264":120819,"_3060":120959},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3604":72797,"_31083":72743,"_21524":120961,"_5":14790,"_28264":120819,"_3060":120962},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3604":72798,"_31083":72743,"_21524":120964,"_5":14790,"_28264":120819,"_3060":120965},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3604":72799,"_31083":72743,"_21524":120967,"_5":14790,"_28264":120819,"_3060":120968},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3604":72800,"_31083":72743,"_21524":120970,"_5":14790,"_28264":120823,"_3060":120971},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3604":72801,"_31083":72743,"_21524":120973,"_5":14790,"_28264":120823,"_3060":120974},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3604":72802,"_31083":72743,"_21524":120976,"_5":14790,"_28264":120823,"_3060":120977},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3604":72803,"_31083":72743,"_21524":120979,"_5":14790,"_28264":120823,"_3060":120980},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3604":72804,"_31083":72804,"_5":15155,"_3060":120982,"_31421":120983,"_21524":120985,"_28264":72804},"Resolución de problemas de despliegue",[50730,119749,120984],"Operación",[],{"_3604":72805,"_31083":72804,"_21524":120987,"_5":14790,"_28264":72804,"_3060":120988},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3604":72806,"_31083":72804,"_5":31418,"_21524":120990,"_28264":120991,"_3060":120992},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3604":72807,"_31083":72804,"_5":31418,"_21524":120994,"_28264":120995,"_3060":120996},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3604":72808,"_31083":72804,"_5":31418,"_21524":120998,"_28264":120999,"_3060":121000},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3604":72809,"_31083":72804,"_5":31418,"_21524":121002,"_28264":121003,"_3060":121004},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3604":72810,"_31083":72804,"_5":31418,"_21524":121006,"_28264":121007,"_3060":121008},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3604":72811,"_31083":72804,"_5":31418,"_21524":121010,"_28264":121011,"_3060":121012},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3604":72812,"_31083":72804,"_5":31418,"_21524":121014,"_28264":121015,"_3060":121016},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3604":72813,"_31083":72804,"_5":31418,"_21524":121018,"_28264":121019,"_3060":121020},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3604":72814,"_31083":72804,"_5":31418,"_21524":121022,"_28264":121023,"_3060":121024},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3604":72815,"_31083":72804,"_5":31418,"_21524":121026,"_28264":121027,"_3060":121028},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3604":72816,"_31083":72804,"_5":31418,"_21524":121030,"_28264":121031,"_3060":121032},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3604":72817,"_31083":72804,"_5":31418,"_21524":121034,"_28264":121035,"_3060":121036},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3604":72818,"_31083":72804,"_5":31418,"_21524":121038,"_28264":121039,"_3060":121040},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3604":72819,"_31083":72804,"_21524":121042,"_5":14790,"_28264":72804,"_3060":121043},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3604":72820,"_31083":72804,"_21524":121045,"_5":14790,"_28264":120995,"_3060":121046},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3604":72821,"_31083":72804,"_21524":121048,"_5":14790,"_28264":120999,"_3060":121049},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3604":72822,"_31083":72804,"_21524":121051,"_5":14790,"_28264":121003,"_3060":121052},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3604":72823,"_31083":72804,"_21524":121054,"_5":14790,"_28264":121007,"_3060":121055},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3604":72824,"_31083":72804,"_21524":121057,"_5":14790,"_28264":121011,"_3060":121058},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3604":72825,"_31083":72804,"_21524":121060,"_5":14790,"_28264":121015,"_3060":121061},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3604":72826,"_31083":72804,"_21524":121063,"_5":14790,"_28264":121015,"_3060":121064},[],"Ejecuta también la prueba de conectividad del chart:",{"_3604":72827,"_31083":72804,"_21524":121066,"_5":14790,"_28264":121015,"_3060":121067},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3604":72828,"_31083":72804,"_21524":121069,"_5":14790,"_28264":121015,"_3060":121070},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3604":72829,"_31083":72804,"_21524":121072,"_5":14790,"_28264":121019,"_3060":121073},[],"Si recibes un 401:",{"_3604":72830,"_31083":72804,"_21524":121075,"_5":14790,"_28264":121019,"_3060":121076},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3604":72831,"_31083":72804,"_21524":121078,"_5":14790,"_28264":121019,"_3060":121079},[],"verifica emisor, audiencia y expiración del token;",{"_3604":72832,"_31083":72804,"_21524":121081,"_5":14790,"_28264":121019,"_3060":121082},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3604":72833,"_31083":72804,"_21524":121084,"_5":14790,"_28264":121019,"_3060":121085},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3604":72834,"_31083":72804,"_21524":121087,"_5":14790,"_28264":121019,"_3060":121088},[],"Si el login termina pero las APIs devuelven 403:",{"_3604":72835,"_31083":72804,"_21524":121090,"_5":14790,"_28264":121019,"_3060":121091},[],"inspecciona los claims reales del token;",{"_3604":72836,"_31083":72804,"_21524":121093,"_5":14790,"_28264":121019,"_3060":121094},[],"confirma que coinciden con un principal activo;",{"_3604":72837,"_31083":72804,"_21524":121096,"_5":14790,"_28264":121019,"_3060":121097},[],"revisa las políticas concedidas al principal;",{"_3604":72838,"_31083":72804,"_21524":121099,"_5":14790,"_28264":121019,"_3060":121100},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3604":72839,"_31083":72804,"_21524":121102,"_5":14790,"_28264":121019,"_3060":121103},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3604":72840,"_31083":72804,"_21524":121105,"_5":14790,"_28264":121023,"_3060":121106},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3604":72841,"_31083":72804,"_21524":121108,"_5":14790,"_28264":121023,"_3060":121109},[],"Localiza el pod y Service de authz.",{"_3604":72842,"_31083":72804,"_21524":121111,"_5":14790,"_28264":121023,"_3060":121112},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3604":72843,"_31083":72804,"_21524":121114,"_5":14790,"_28264":121023,"_3060":121115},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3604":72844,"_31083":72804,"_21524":121117,"_5":14790,"_28264":121023,"_3060":121118},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3604":72845,"_31083":72804,"_21524":121120,"_5":14790,"_28264":121023,"_3060":121121},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3604":72846,"_31083":72804,"_21524":121123,"_5":14790,"_28264":121027,"_3060":121124},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3604":72847,"_31083":72804,"_21524":121126,"_5":14790,"_28264":121031,"_3060":121127},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3604":72848,"_31083":72804,"_21524":121129,"_5":14790,"_28264":121031,"_3060":121130},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3604":72849,"_31083":72804,"_21524":121132,"_5":14790,"_28264":121031,"_3060":121133},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3604":72850,"_31083":72804,"_21524":121135,"_5":14790,"_28264":121031,"_3060":121136},[],"volumen persistente sin enlazar;",{"_3604":72851,"_31083":72804,"_21524":121138,"_5":14790,"_28264":121031,"_3060":121139},[],"imagen inaccesible o política de pull incorrecta;",{"_3604":72852,"_31083":72804,"_21524":121141,"_5":14790,"_28264":121031,"_3060":121142},[],"configuración inválida del motor criptográfico;",{"_3604":72853,"_31083":72804,"_21524":121144,"_5":14790,"_28264":121031,"_3060":121145},[],"límites de CPU o memoria demasiado bajos;",{"_3604":72854,"_31083":72804,"_21524":121147,"_5":14790,"_28264":121031,"_3060":121148},[],"migración previa incompleta.",{"_3604":72855,"_31083":72804,"_21524":121150,"_5":14790,"_28264":121031,"_3060":121151},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3604":72856,"_31083":72804,"_21524":121153,"_5":14790,"_28264":121031,"_3060":121154},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3604":72857,"_31083":72804,"_21524":121156,"_5":14790,"_28264":121031,"_3060":121157},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3604":72858,"_31083":72804,"_21524":121159,"_5":14790,"_28264":121035,"_3060":121160},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3604":72859,"_31083":72804,"_21524":121162,"_5":14790,"_28264":121035,"_3060":121163},[],"verifica que esté habilitado en el servicio emisor;",{"_3604":72860,"_31083":72804,"_21524":121165,"_5":14790,"_28264":121035,"_3060":121166},[],"comprueba conectividad y credenciales AMQP;",{"_3604":72861,"_31083":72804,"_21524":121168,"_5":14790,"_28264":121035,"_3060":121169},[],"revisa exchange, routing key, colas y consumidores;",{"_3604":72862,"_31083":72804,"_21524":121171,"_5":14790,"_28264":121035,"_3060":121172},[],"inspecciona dead-letter queues;",{"_3604":72863,"_31083":72804,"_21524":121174,"_5":14790,"_28264":121035,"_3060":121175},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3604":72864,"_31083":72804,"_21524":121177,"_5":14790,"_28264":121035,"_3060":121178},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3604":72865,"_31083":72804,"_21524":121180,"_5":14790,"_28264":121035,"_3060":121181},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3604":72866,"_31083":72804,"_21524":121183,"_5":14790,"_28264":121035,"_3060":121184},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3604":72867,"_31083":72804,"_21524":121186,"_5":14790,"_28264":121035,"_3060":121187},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3604":72868,"_31083":72804,"_21524":121189,"_5":14790,"_28264":121035,"_3060":121190},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3604":72869,"_31083":72804,"_21524":121192,"_5":14790,"_28264":121035,"_3060":121193},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3604":72870,"_31083":72804,"_21524":121195,"_5":14790,"_28264":121035,"_3060":121196},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3604":72871,"_31083":72804,"_21524":121198,"_5":14790,"_28264":121039,"_3060":121199},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3604":72872,"_31083":72804,"_21524":121201,"_5":14790,"_28264":121039,"_3060":121202},[],"Antes de cerrar una incidencia, guarda:",{"_3604":72873,"_31083":72804,"_21524":121204,"_5":14790,"_28264":121039,"_3060":121205},[],"causa confirmada;",{"_3604":72874,"_31083":72804,"_21524":121207,"_5":14790,"_28264":121039,"_3060":121208},[],"alcance temporal y recursos afectados;",{"_3604":72875,"_31083":72804,"_21524":121210,"_5":14790,"_28264":121039,"_3060":121211},[],"comandos o consultas utilizados;",{"_3604":72876,"_31083":72804,"_21524":121213,"_5":14790,"_28264":121039,"_3060":121214},[],"cambio aplicado y forma de revertirlo;",{"_3604":72877,"_31083":72804,"_21524":121216,"_5":14790,"_28264":121039,"_3060":121217},[],"validación desde un consumidor;",{"_3604":72878,"_31083":72804,"_21524":121219,"_5":14790,"_28264":121039,"_3060":121220},[],"acción preventiva y propietario.",{"_3604":72879,"_31083":72879,"_5":15155,"_3060":121222,"_31421":121223,"_21524":121227,"_28264":72879},"Modelo de datos",[50730,121224,121225,121226],"Plataforma","Administración","Control de acceso",[],{"_3604":72880,"_31083":72879,"_21524":121229,"_5":14790,"_28264":72879,"_3060":121230},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3604":72881,"_31083":72879,"_5":31418,"_21524":121232,"_28264":121233,"_3060":121234},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3604":72882,"_31083":72879,"_5":31418,"_21524":121236,"_28264":121237,"_3060":121238},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3604":72883,"_31083":72879,"_21524":121240,"_5":14790,"_28264":72879,"_3060":121241},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3604":72884,"_31083":72879,"_21524":121243,"_5":14790,"_28264":121233,"_3060":121244},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3604":72885,"_31083":72879,"_21524":121246,"_5":14790,"_28264":121233,"_3060":121247},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3604":72886,"_31083":72879,"_21524":121249,"_5":14790,"_28264":121233,"_3060":121250},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3604":72887,"_31083":72879,"_21524":121252,"_5":14790,"_28264":121237,"_3060":121253},[],"Entidad (`schema_name.entity_type`)",{"_3604":72888,"_31083":72879,"_21524":121255,"_5":14790,"_28264":121237,"_3060":121256},[],"Tabla (`table_name`)",{"_3604":72889,"_31083":72879,"_21524":121258,"_5":14790,"_28264":121237,"_3060":121259},[],"Clave (`primary_key`)",{"_3604":72890,"_31083":72879,"_21524":121261,"_5":14790,"_28264":121237,"_3060":52280},[],{"_3604":72891,"_31083":72879,"_21524":121263,"_5":14790,"_28264":121237,"_3060":52283},[],{"_3604":72892,"_31083":72879,"_21524":121265,"_5":14790,"_28264":121237,"_3060":52286},[],{"_3604":72893,"_31083":72879,"_21524":121267,"_5":14790,"_28264":121237,"_3060":52289},[],{"_3604":72894,"_31083":72879,"_21524":121269,"_5":14790,"_28264":121237,"_3060":52292},[],{"_3604":72895,"_31083":72879,"_21524":121271,"_5":14790,"_28264":121237,"_3060":52295},[],{"_3604":72896,"_31083":72879,"_21524":121273,"_5":14790,"_28264":121237,"_3060":52298},[],{"_3604":72897,"_31083":72879,"_21524":121275,"_5":14790,"_28264":121237,"_3060":52301},[],{"_3604":72898,"_31083":72879,"_21524":121277,"_5":14790,"_28264":121237,"_3060":52295},[],{"_3604":72899,"_31083":72879,"_21524":121279,"_5":14790,"_28264":121237,"_3060":52306},[],{"_3604":72900,"_31083":72879,"_21524":121281,"_5":14790,"_28264":121237,"_3060":52309},[],{"_3604":72901,"_31083":72879,"_21524":121283,"_5":14790,"_28264":121237,"_3060":52312},[],{"_3604":72902,"_31083":72879,"_21524":121285,"_5":14790,"_28264":121237,"_3060":52315},[],{"_3604":72903,"_31083":72879,"_21524":121287,"_5":14790,"_28264":121237,"_3060":52318},[],{"_3604":72904,"_31083":72879,"_21524":121289,"_5":14790,"_28264":121237,"_3060":52295},[],{"_3604":72905,"_31083":72879,"_21524":121291,"_5":14790,"_28264":121237,"_3060":52323},[],{"_3604":72906,"_31083":72879,"_21524":121293,"_5":14790,"_28264":121237,"_3060":52326},[],{"_3604":72907,"_31083":72879,"_21524":121295,"_5":14790,"_28264":121237,"_3060":52295},[],{"_3604":72908,"_31083":72879,"_21524":121297,"_5":14790,"_28264":121237,"_3060":52331},[],{"_3604":72909,"_31083":72879,"_21524":121299,"_5":14790,"_28264":121237,"_3060":52334},[],{"_3604":72910,"_31083":72879,"_21524":121301,"_5":14790,"_28264":121237,"_3060":52295},[],{"_3604":72911,"_31083":72879,"_21524":121303,"_5":14790,"_28264":121237,"_3060":52339},[],{"_3604":72912,"_31083":72879,"_21524":121305,"_5":14790,"_28264":121237,"_3060":52342},[],{"_3604":72913,"_31083":72879,"_21524":121307,"_5":14790,"_28264":121237,"_3060":52295},[],{"_3604":72914,"_31083":72879,"_21524":121309,"_5":14790,"_28264":121237,"_3060":52347},[],{"_3604":72915,"_31083":72879,"_21524":121311,"_5":14790,"_28264":121237,"_3060":52350},[],{"_3604":72916,"_31083":72879,"_21524":121313,"_5":14790,"_28264":121237,"_3060":52353},[],{"_3604":72917,"_31083":72879,"_21524":121315,"_5":14790,"_28264":121237,"_3060":52356},[],{"_3604":72918,"_31083":72879,"_21524":121317,"_5":14790,"_28264":121237,"_3060":52359},[],{"_3604":72919,"_31083":72879,"_21524":121319,"_5":14790,"_28264":121237,"_3060":52362},[],{"_3604":72920,"_31083":72879,"_21524":121321,"_5":14790,"_28264":121237,"_3060":121322},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3604":72921,"_31083":72879,"_21524":121324,"_5":14790,"_28264":121237,"_3060":121325},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3604":72922,"_31083":72879,"_21524":121327,"_5":14790,"_28264":121237,"_3060":121328},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3604":72923,"_31083":72923,"_5":15155,"_3060":121330,"_31421":121331,"_21524":121332,"_28264":72923},"Visión general del control de acceso",[50730,121224,121225,121226],[],{"_3604":72924,"_31083":72923,"_21524":121334,"_5":14790,"_28264":72923,"_3060":121335},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3604":72925,"_31083":72923,"_5":31418,"_21524":121337,"_28264":121338,"_3060":121339},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3604":72926,"_31083":72923,"_5":31418,"_21524":121341,"_28264":121342,"_3060":121343},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3604":72927,"_31083":72923,"_5":31418,"_21524":121345,"_28264":121346,"_3060":121347},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3604":72928,"_31083":72923,"_5":31418,"_21524":121349,"_28264":121350,"_3060":121351},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3604":72929,"_31083":72923,"_5":31418,"_21524":121353,"_28264":121354,"_3060":121355},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3604":72930,"_31083":72923,"_5":31418,"_21524":121357,"_28264":121358,"_3060":121359},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3604":72931,"_31083":72923,"_5":31418,"_21524":121361,"_28264":121362,"_3060":121363},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3604":72932,"_31083":72923,"_5":31418,"_21524":121365,"_28264":121366,"_3060":121367},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3604":72933,"_31083":72923,"_5":31418,"_21524":121369,"_28264":121370,"_3060":121371},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3604":72934,"_31083":72923,"_5":31418,"_21524":121373,"_28264":121374,"_3060":121375},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3604":72935,"_31083":72923,"_5":31418,"_21524":121377,"_28264":121378,"_3060":121379},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3604":72936,"_31083":72923,"_5":31418,"_21524":121381,"_28264":121382,"_3060":121383},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3604":72937,"_31083":72923,"_5":31418,"_21524":121385,"_28264":121386,"_3060":121387},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3604":72938,"_31083":72923,"_5":31418,"_21524":121389,"_28264":121390,"_3060":121391},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3604":72939,"_31083":72923,"_5":31418,"_21524":121393,"_28264":121394,"_3060":121395},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3604":72940,"_31083":72923,"_5":31418,"_21524":121397,"_28264":121398,"_3060":120365},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3604":72941,"_31083":72923,"_5":31418,"_21524":121400,"_28264":121401,"_3060":121402},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3604":72942,"_31083":72923,"_5":31418,"_21524":121404,"_28264":121405,"_3060":121406},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3604":72943,"_31083":72923,"_5":31418,"_21524":121408,"_28264":121409,"_3060":121410},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3604":72944,"_31083":72923,"_5":31418,"_21524":121412,"_28264":121413,"_3060":121414},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3604":72945,"_31083":72923,"_5":31418,"_21524":121416,"_28264":121417,"_3060":121418},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3604":72946,"_31083":72923,"_5":31418,"_21524":121420,"_28264":121421,"_3060":121422},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3604":72947,"_31083":72923,"_5":31418,"_21524":121424,"_28264":121425,"_3060":121426},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3604":72948,"_31083":72923,"_5":31418,"_21524":121428,"_28264":121429,"_3060":121430},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3604":72949,"_31083":72923,"_5":31418,"_21524":121432,"_28264":121433,"_3060":121434},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3604":72950,"_31083":72923,"_5":31418,"_21524":121436,"_28264":121437,"_3060":121438},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3604":72951,"_31083":72923,"_5":31418,"_21524":121440,"_28264":121441,"_3060":121442},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3604":72952,"_31083":72923,"_5":31418,"_21524":121444,"_28264":121445,"_3060":121446},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3604":72953,"_31083":72923,"_5":31418,"_21524":121448,"_28264":121449,"_3060":121450},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3604":72954,"_31083":72923,"_5":31418,"_21524":121452,"_28264":121453,"_3060":121454},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3604":72955,"_31083":72923,"_5":31418,"_21524":121456,"_28264":121457,"_3060":121458},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3604":72956,"_31083":72923,"_21524":121460,"_5":14790,"_28264":72923,"_3060":121461},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3604":72957,"_31083":72923,"_21524":121463,"_5":14790,"_28264":72923,"_3060":121464},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3604":72958,"_31083":72923,"_21524":121466,"_5":14790,"_28264":72923,"_3060":121467},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3604":72959,"_31083":72923,"_21524":121469,"_5":14790,"_28264":121338,"_3060":121470},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3604":72960,"_31083":72923,"_21524":121472,"_5":14790,"_28264":121338,"_3060":121473},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3604":72961,"_31083":72923,"_21524":121475,"_5":14790,"_28264":121338,"_3060":121476},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3604":72962,"_31083":72923,"_21524":121478,"_5":14790,"_28264":121338,"_3060":121479},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3604":72963,"_31083":72923,"_21524":121481,"_5":14790,"_28264":121338,"_3060":121482},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3604":72964,"_31083":72923,"_21524":121484,"_5":14790,"_28264":121338,"_3060":121485},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3604":72965,"_31083":72923,"_21524":121487,"_5":14790,"_28264":121342,"_3060":121488},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3604":72966,"_31083":72923,"_21524":121490,"_5":14790,"_28264":121342,"_3060":121491},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3604":72967,"_31083":72923,"_21524":121493,"_5":14790,"_28264":121346,"_3060":121494},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3604":72968,"_31083":72923,"_21524":121496,"_5":14790,"_28264":121346,"_3060":121497},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3604":72969,"_31083":72923,"_21524":121499,"_5":14790,"_28264":121346,"_3060":121500},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3604":72970,"_31083":72923,"_21524":121502,"_5":14790,"_28264":121346,"_3060":121503},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3604":72971,"_31083":72923,"_21524":121505,"_5":14790,"_28264":121346,"_3060":121506},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3604":72972,"_31083":72923,"_21524":121508,"_5":14790,"_28264":121346,"_3060":121509},[],"Carga por separado las políticas concedidas a cada principal.",{"_3604":72973,"_31083":72923,"_21524":121511,"_5":14790,"_28264":121346,"_3060":121512},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3604":72974,"_31083":72923,"_21524":121514,"_5":14790,"_28264":121346,"_3060":121515},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3604":72975,"_31083":72923,"_21524":121517,"_5":14790,"_28264":121346,"_3060":121518},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3604":72976,"_31083":72923,"_21524":121520,"_5":14790,"_28264":121346,"_3060":121521},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3604":72977,"_31083":72923,"_21524":121523,"_5":14790,"_28264":121346,"_3060":121524},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3604":72978,"_31083":72923,"_21524":121526,"_5":14790,"_28264":121346,"_3060":121527},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3604":72979,"_31083":72923,"_21524":121529,"_5":14790,"_28264":121350,"_3060":121530},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3604":72980,"_31083":72923,"_21524":121532,"_5":14790,"_28264":121350,"_3060":121533},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3604":72981,"_31083":72923,"_21524":121535,"_5":14790,"_28264":121350,"_3060":121536},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3604":72982,"_31083":72923,"_21524":121538,"_5":14790,"_28264":121350,"_3060":121539},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3604":72983,"_31083":72923,"_21524":121541,"_5":14790,"_28264":121350,"_3060":121542},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3604":72984,"_31083":72923,"_21524":121544,"_5":14790,"_28264":121350,"_3060":121545},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3604":72985,"_31083":72923,"_21524":121547,"_5":14790,"_28264":121350,"_3060":121548},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3604":72986,"_31083":72923,"_21524":121550,"_5":14790,"_28264":121350,"_3060":121551},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3604":72987,"_31083":72923,"_21524":121553,"_5":14790,"_28264":121350,"_3060":121554},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3604":72988,"_31083":72923,"_21524":121556,"_5":14790,"_28264":121350,"_3060":121557},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3604":72989,"_31083":72923,"_21524":121559,"_5":14790,"_28264":121354,"_3060":121560},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3604":72990,"_31083":72923,"_21524":121562,"_5":14790,"_28264":121354,"_3060":121563},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3604":72991,"_31083":72923,"_21524":121565,"_5":14790,"_28264":121354,"_3060":121566},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3604":72992,"_31083":72923,"_21524":121568,"_5":14790,"_28264":121354,"_3060":121569},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3604":72993,"_31083":72923,"_21524":121571,"_5":14790,"_28264":121354,"_3060":121572},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3604":72994,"_31083":72923,"_21524":121574,"_5":14790,"_28264":121354,"_3060":121575},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3604":72995,"_31083":72923,"_21524":121577,"_5":14790,"_28264":121354,"_3060":121578},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3604":72996,"_31083":72923,"_21524":121580,"_5":14790,"_28264":121354,"_3060":121581},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3604":72997,"_31083":72923,"_21524":121583,"_5":14790,"_28264":121354,"_3060":121584},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3604":72998,"_31083":72923,"_21524":121586,"_5":14790,"_28264":121354,"_3060":121587},[],"Las acciones se dividen en dos grupos:",{"_3604":72999,"_31083":72923,"_21524":121589,"_5":14790,"_28264":121354,"_3060":121590},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3604":73000,"_31083":72923,"_21524":121592,"_5":14790,"_28264":121354,"_3060":121593},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3604":73001,"_31083":72923,"_21524":121595,"_5":14790,"_28264":121354,"_3060":121596},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3604":73002,"_31083":72923,"_21524":121598,"_5":14790,"_28264":121358,"_3060":121599},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3604":73003,"_31083":72923,"_21524":121601,"_5":14790,"_28264":121358,"_3060":121602},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3604":73004,"_31083":72923,"_21524":121604,"_5":14790,"_28264":121358,"_3060":121605},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3604":73005,"_31083":72923,"_21524":121607,"_5":14790,"_28264":121362,"_3060":121608},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3604":73006,"_31083":72923,"_21524":121610,"_5":14790,"_28264":121362,"_3060":121611},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3604":73007,"_31083":72923,"_21524":121613,"_5":14790,"_28264":121362,"_3060":121614},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3604":73008,"_31083":72923,"_21524":121616,"_5":14790,"_28264":121362,"_3060":121617},[],"Los operadores implementados son:",{"_3604":73009,"_31083":72923,"_21524":121619,"_5":14790,"_28264":121362,"_3060":121620},[],"`equals`, para igualdad exacta;",{"_3604":73010,"_31083":72923,"_21524":121622,"_5":14790,"_28264":121362,"_3060":121623},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3604":73011,"_31083":72923,"_21524":121625,"_5":14790,"_28264":121362,"_3060":121626},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3604":73012,"_31083":72923,"_21524":121628,"_5":14790,"_28264":121362,"_3060":121629},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3604":73013,"_31083":72923,"_21524":121631,"_5":14790,"_28264":121366,"_3060":121632},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3604":73014,"_31083":72923,"_21524":121634,"_5":14790,"_28264":121366,"_3060":121635},[],"Los modos disponibles son:",{"_3604":73015,"_31083":72923,"_21524":121637,"_5":14790,"_28264":121366,"_3060":121638},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3604":73016,"_31083":72923,"_21524":121640,"_5":14790,"_28264":121366,"_3060":121641},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3604":73017,"_31083":72923,"_21524":121643,"_5":14790,"_28264":121366,"_3060":121644},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3604":73018,"_31083":72923,"_21524":121646,"_5":14790,"_28264":121366,"_3060":121647},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3604":73019,"_31083":72923,"_21524":121649,"_5":14790,"_28264":121366,"_3060":121650},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3604":73020,"_31083":72923,"_21524":121652,"_5":14790,"_28264":121366,"_3060":121653},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3604":73021,"_31083":72923,"_21524":121655,"_5":14790,"_28264":121370,"_3060":121656},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3604":73022,"_31083":72923,"_21524":121658,"_5":14790,"_28264":121370,"_3060":121659},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3604":73023,"_31083":72923,"_21524":121661,"_5":14790,"_28264":121370,"_3060":121662},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3604":73024,"_31083":72923,"_21524":121664,"_5":14790,"_28264":121370,"_3060":121665},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3604":73025,"_31083":72923,"_21524":121667,"_5":14790,"_28264":121378,"_3060":121668},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3604":73026,"_31083":72923,"_21524":121670,"_5":14790,"_28264":121378,"_3060":121671},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3604":73027,"_31083":72923,"_21524":121673,"_5":14790,"_28264":121382,"_3060":121674},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3604":73028,"_31083":72923,"_21524":121676,"_5":14790,"_28264":121382,"_3060":121677},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3604":73029,"_31083":72923,"_21524":121679,"_5":14790,"_28264":121382,"_3060":121680},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3604":73030,"_31083":72923,"_21524":121682,"_5":14790,"_28264":121382,"_3060":121683},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3604":73031,"_31083":72923,"_21524":121685,"_5":14790,"_28264":121382,"_3060":121686},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3604":73032,"_31083":72923,"_21524":121688,"_5":14790,"_28264":121386,"_3060":121689},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3604":73033,"_31083":72923,"_21524":121691,"_5":14790,"_28264":121386,"_3060":121692},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3604":73034,"_31083":72923,"_21524":121694,"_5":14790,"_28264":121386,"_3060":121695},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3604":73035,"_31083":72923,"_21524":121697,"_5":14790,"_28264":121390,"_3060":121698},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3604":73036,"_31083":72923,"_21524":121700,"_5":14790,"_28264":121390,"_3060":121701},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3604":73037,"_31083":72923,"_21524":121703,"_5":14790,"_28264":121390,"_3060":121704},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3604":73038,"_31083":72923,"_21524":121706,"_5":14790,"_28264":121390,"_3060":121707},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3604":73039,"_31083":72923,"_21524":121709,"_5":14790,"_28264":121390,"_3060":121710},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3604":73040,"_31083":72923,"_21524":121712,"_5":14790,"_28264":121390,"_3060":121713},[],"Ten en cuenta que:",{"_3604":73041,"_31083":72923,"_21524":121715,"_5":14790,"_28264":121390,"_3060":121716},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3604":73042,"_31083":72923,"_21524":121718,"_5":14790,"_28264":121390,"_3060":121719},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3604":73043,"_31083":72923,"_21524":121721,"_5":14790,"_28264":121390,"_3060":121722},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3604":73044,"_31083":72923,"_21524":121724,"_5":14790,"_28264":121394,"_3060":121725},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3604":73045,"_31083":72923,"_21524":121727,"_5":14790,"_28264":121394,"_3060":121728},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3604":73046,"_31083":72923,"_21524":121730,"_5":14790,"_28264":121394,"_3060":121731},[],"acceso completo y de solo lectura a KMS;",{"_3604":73047,"_31083":72923,"_21524":121733,"_5":14790,"_28264":121394,"_3060":121734},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3604":73048,"_31083":72923,"_21524":121736,"_5":14790,"_28264":121394,"_3060":121737},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3604":73049,"_31083":72923,"_21524":121739,"_5":14790,"_28264":121394,"_3060":121740},[],"acceso a la interfaz;",{"_3604":73050,"_31083":72923,"_21524":121742,"_5":14790,"_28264":121394,"_3060":121743},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3604":73051,"_31083":72923,"_21524":121745,"_5":14790,"_28264":121394,"_3060":121746},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3604":73052,"_31083":72923,"_21524":121748,"_5":14790,"_28264":121394,"_3060":121749},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3604":73053,"_31083":72923,"_21524":121751,"_5":14790,"_28264":121394,"_3060":121752},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3604":73054,"_31083":72923,"_21524":121754,"_5":14790,"_28264":121394,"_3060":121755},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3604":73055,"_31083":72923,"_21524":121757,"_5":14790,"_28264":121398,"_3060":121758},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3604":73056,"_31083":72923,"_21524":121760,"_5":14790,"_28264":121398,"_3060":121761},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3604":73057,"_31083":72923,"_21524":121763,"_5":14790,"_28264":121398,"_3060":121764},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3604":73058,"_31083":72923,"_21524":121766,"_5":14790,"_28264":121401,"_3060":121767},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3604":73059,"_31083":72923,"_21524":121769,"_5":14790,"_28264":121405,"_3060":121770},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3604":73060,"_31083":72923,"_21524":121772,"_5":14790,"_28264":121405,"_3060":121773},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3604":73061,"_31083":72923,"_21524":121775,"_5":14790,"_28264":121409,"_3060":121776},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3604":73062,"_31083":72923,"_21524":121778,"_5":14790,"_28264":121413,"_3060":121779},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3604":73063,"_31083":72923,"_21524":121781,"_5":14790,"_28264":121417,"_3060":121782},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3604":73064,"_31083":72923,"_21524":121784,"_5":14790,"_28264":121421,"_3060":121785},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3604":73065,"_31083":72923,"_21524":121787,"_5":14790,"_28264":121421,"_3060":121788},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3604":73066,"_31083":72923,"_21524":121790,"_5":14790,"_28264":121425,"_3060":121791},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3604":73067,"_31083":72923,"_21524":121793,"_5":14790,"_28264":121425,"_3060":121794},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3604":73068,"_31083":72923,"_21524":121796,"_5":14790,"_28264":121425,"_3060":121797},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3604":73069,"_31083":72923,"_21524":121799,"_5":14790,"_28264":121425,"_3060":121800},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3604":73070,"_31083":72923,"_21524":121802,"_5":14790,"_28264":121425,"_3060":121803},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3604":73071,"_31083":72923,"_21524":121805,"_5":14790,"_28264":121425,"_3060":121806},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3604":73072,"_31083":72923,"_21524":121808,"_5":14790,"_28264":121425,"_3060":121809},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3604":73073,"_31083":72923,"_21524":121811,"_5":14790,"_28264":121425,"_3060":121812},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3604":73074,"_31083":72923,"_21524":121814,"_5":14790,"_28264":121429,"_3060":121815},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3604":73075,"_31083":72923,"_21524":121817,"_5":14790,"_28264":121429,"_3060":121818},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3604":73076,"_31083":72923,"_21524":121820,"_5":14790,"_28264":121429,"_3060":121821},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3604":73077,"_31083":72923,"_21524":121823,"_5":14790,"_28264":121433,"_3060":121824},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3604":73078,"_31083":72923,"_21524":121826,"_5":14790,"_28264":121433,"_3060":121827},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3604":73079,"_31083":72923,"_21524":121829,"_5":14790,"_28264":121433,"_3060":121830},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3604":73080,"_31083":72923,"_21524":121832,"_5":14790,"_28264":121433,"_3060":121833},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3604":73081,"_31083":72923,"_21524":121835,"_5":14790,"_28264":121433,"_3060":121836},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3604":73082,"_31083":72923,"_21524":121838,"_5":14790,"_28264":121433,"_3060":121839},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3604":73083,"_31083":72923,"_21524":121841,"_5":14790,"_28264":121433,"_3060":121842},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3604":73084,"_31083":72923,"_21524":121844,"_5":14790,"_28264":121433,"_3060":121845},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3604":73085,"_31083":72923,"_21524":121847,"_5":14790,"_28264":121441,"_3060":121848},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3604":73086,"_31083":72923,"_21524":121850,"_5":14790,"_28264":121445,"_3060":121851},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3604":73087,"_31083":72923,"_21524":121853,"_5":14790,"_28264":121445,"_3060":121854},[],"que exista un principal activo del tipo correcto;",{"_3604":73088,"_31083":72923,"_21524":121856,"_5":14790,"_28264":121445,"_3060":121857},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3604":73089,"_31083":72923,"_21524":121859,"_5":14790,"_28264":121445,"_3060":121860},[],"que todas las condiciones del principal se cumplan;",{"_3604":73090,"_31083":72923,"_21524":121862,"_5":14790,"_28264":121445,"_3060":121863},[],"que el principal tenga concedida la política esperada;",{"_3604":73091,"_31083":72923,"_21524":121865,"_5":14790,"_28264":121445,"_3060":121866},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3604":73092,"_31083":72923,"_21524":121868,"_5":14790,"_28264":121445,"_3060":121869},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3604":73093,"_31083":72923,"_21524":121871,"_5":14790,"_28264":121445,"_3060":121872},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3604":73094,"_31083":72923,"_21524":121874,"_5":14790,"_28264":121445,"_3060":121875},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3604":73095,"_31083":72923,"_21524":121877,"_5":14790,"_28264":121449,"_3060":121878},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3604":73096,"_31083":72923,"_21524":121880,"_5":14790,"_28264":121453,"_3060":121881},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3604":73097,"_31083":72923,"_21524":121883,"_5":14790,"_28264":121457,"_3060":121884},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3604":73098,"_31083":72923,"_21524":121886,"_5":14790,"_28264":121457,"_3060":121887},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3604":73099,"_31083":73099,"_5":15155,"_3060":121889,"_31421":121890,"_21524":121891,"_28264":73099},"Alertas y suscripciones",[50730,121224,121225],[],{"_3604":73100,"_31083":73099,"_21524":121893,"_5":14790,"_28264":73099,"_3060":121894},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3604":73101,"_31083":73099,"_5":31418,"_21524":121896,"_28264":121897,"_3060":121898},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3604":73102,"_31083":73099,"_5":31418,"_21524":121900,"_28264":121901,"_3060":121902},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3604":73103,"_31083":73099,"_5":31418,"_21524":121904,"_28264":121905,"_3060":121906},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3604":73104,"_31083":73099,"_5":31418,"_21524":121908,"_28264":121909,"_3060":121910},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3604":73105,"_31083":73099,"_5":31418,"_21524":121912,"_28264":121913,"_3060":121914},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3604":73106,"_31083":73099,"_5":31418,"_21524":121916,"_28264":121917,"_3060":121918},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3604":73107,"_31083":73099,"_5":31418,"_21524":121920,"_28264":121921,"_3060":121922},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3604":73108,"_31083":73099,"_5":31418,"_21524":121924,"_28264":121925,"_3060":121926},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3604":73109,"_31083":73099,"_5":31418,"_21524":121928,"_28264":121929,"_3060":121930},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3604":73110,"_31083":73099,"_5":31418,"_21524":121932,"_28264":121933,"_3060":121934},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3604":73111,"_31083":73099,"_5":31418,"_21524":121936,"_28264":121937,"_3060":121938},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3604":73112,"_31083":73099,"_21524":121940,"_5":14790,"_28264":73099,"_3060":121941},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3604":73113,"_31083":73099,"_21524":121943,"_5":14790,"_28264":121897,"_3060":121944},[],"Un servicio publica un evento de dominio.",{"_3604":73114,"_31083":73099,"_21524":121946,"_5":14790,"_28264":121897,"_3060":121947},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3604":73115,"_31083":73099,"_21524":121949,"_5":14790,"_28264":121897,"_3060":121950},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3604":73116,"_31083":73099,"_21524":121952,"_5":14790,"_28264":121897,"_3060":121953},[],"Lamassu entrega el evento al canal configurado.",{"_3604":73117,"_31083":73099,"_21524":121955,"_5":14790,"_28264":121897,"_3060":121956},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3604":73118,"_31083":73099,"_21524":121958,"_5":14790,"_28264":121901,"_3060":121959},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3604":73119,"_31083":73099,"_21524":121961,"_5":14790,"_28264":121901,"_3060":121962},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3604":73120,"_31083":73099,"_21524":121964,"_5":14790,"_28264":121901,"_3060":121965},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3604":73121,"_31083":73099,"_21524":121967,"_5":14790,"_28264":121901,"_3060":121968},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3604":73122,"_31083":73099,"_21524":121970,"_5":14790,"_28264":121901,"_3060":121971},[],"`apikey_options` necesita `header` y `key`.",{"_3604":73123,"_31083":73099,"_21524":121973,"_5":14790,"_28264":121901,"_3060":121974},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3604":73124,"_31083":73099,"_21524":121976,"_5":14790,"_28264":121901,"_3060":121977},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3604":73125,"_31083":73099,"_21524":121979,"_5":14790,"_28264":121901,"_3060":121980},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3604":73126,"_31083":73099,"_21524":121982,"_5":14790,"_28264":121909,"_3060":121983},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3604":73127,"_31083":73099,"_21524":121985,"_5":14790,"_28264":121913,"_3060":121986},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3604":73128,"_31083":73099,"_21524":121988,"_5":14790,"_28264":121917,"_3060":121989},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3604":73129,"_31083":73099,"_21524":121991,"_5":14790,"_28264":121917,"_3060":121992},[],"**None** notifica todas las instancias del evento.",{"_3604":73130,"_31083":73099,"_21524":121994,"_5":14790,"_28264":121917,"_3060":121995},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3604":73131,"_31083":73099,"_21524":121997,"_5":14790,"_28264":121917,"_3060":121998},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3604":73132,"_31083":73099,"_21524":122000,"_5":14790,"_28264":121917,"_3060":122001},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3604":73133,"_31083":73099,"_21524":122003,"_5":14790,"_28264":121917,"_3060":122004},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3604":73134,"_31083":73099,"_21524":122006,"_5":14790,"_28264":121917,"_3060":122007},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3604":73135,"_31083":73099,"_21524":122009,"_5":14790,"_28264":121921,"_3060":122010},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3604":73136,"_31083":73099,"_21524":122012,"_5":14790,"_28264":121925,"_3060":122013},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3604":73137,"_31083":73099,"_21524":122015,"_5":14790,"_28264":121925,"_3060":122016},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3604":73138,"_31083":73099,"_21524":122018,"_5":14790,"_28264":121925,"_3060":122019},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3604":73139,"_31083":73099,"_21524":122021,"_5":14790,"_28264":121925,"_3060":122022},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3604":73140,"_31083":73099,"_21524":122024,"_5":14790,"_28264":121925,"_3060":122025},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3604":73141,"_31083":73099,"_21524":122027,"_5":14790,"_28264":121925,"_3060":122028},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3604":73142,"_31083":73099,"_21524":122030,"_5":14790,"_28264":121925,"_3060":122031},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3604":73143,"_31083":73099,"_21524":122033,"_5":14790,"_28264":121925,"_3060":122034},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3604":73144,"_31083":73099,"_21524":122036,"_5":14790,"_28264":121929,"_3060":122037},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3604":73145,"_31083":73099,"_21524":122039,"_5":14790,"_28264":121929,"_3060":122040},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3604":73146,"_31083":73099,"_21524":122042,"_5":14790,"_28264":121929,"_3060":122043},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3604":73147,"_31083":73099,"_21524":122045,"_5":14790,"_28264":121929,"_3060":122046},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3604":73148,"_31083":73099,"_21524":122048,"_5":14790,"_28264":121929,"_3060":122049},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3604":73149,"_31083":73099,"_21524":122051,"_5":14790,"_28264":121929,"_3060":122052},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3604":73150,"_31083":73099,"_21524":122054,"_5":14790,"_28264":121929,"_3060":122055},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3604":73151,"_31083":73099,"_21524":122057,"_5":14790,"_28264":121929,"_3060":122058},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3604":73152,"_31083":73099,"_21524":122060,"_5":14790,"_28264":121933,"_3060":122061},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3604":73153,"_31083":73099,"_21524":122063,"_5":14790,"_28264":121933,"_3060":122064},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3604":73154,"_31083":73099,"_21524":122066,"_5":14790,"_28264":121937,"_3060":122067},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3604":73155,"_31083":73099,"_21524":122069,"_5":14790,"_28264":121937,"_3060":122070},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3604":73156,"_31083":73099,"_21524":122072,"_5":14790,"_28264":121937,"_3060":122073},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3604":73157,"_31083":73099,"_21524":122075,"_5":14790,"_28264":121937,"_3060":122076},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3604":73158,"_31083":73099,"_21524":122078,"_5":14790,"_28264":121937,"_3060":122079},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3604":73159,"_31083":73099,"_21524":122081,"_5":14790,"_28264":121937,"_3060":122082},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3604":73160,"_31083":73099,"_21524":122084,"_5":14790,"_28264":121937,"_3060":122085},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3604":73161,"_31083":73099,"_21524":122087,"_5":14790,"_28264":121937,"_3060":122088},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3604":73162,"_31083":73099,"_21524":122090,"_5":14790,"_28264":121937,"_3060":122091},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3604":73163,"_31083":73099,"_21524":122093,"_5":14790,"_28264":121937,"_3060":122094},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3604":73164,"_31083":73164,"_5":15155,"_3060":122096,"_31421":122097,"_21524":122098,"_28264":73164},"Registros de auditoría",[50730,121224,121225],[],{"_3604":73165,"_31083":73164,"_21524":122100,"_5":14790,"_28264":73164,"_3060":122101},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3604":73166,"_31083":73164,"_5":31418,"_21524":122103,"_28264":122104,"_3060":122105},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3604":73167,"_31083":73164,"_5":31418,"_21524":122107,"_28264":122108,"_3060":122109},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3604":73168,"_31083":73164,"_5":31418,"_21524":122111,"_28264":122112,"_3060":122113},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3604":73169,"_31083":73164,"_5":31418,"_21524":122115,"_28264":122116,"_3060":122117},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3604":73170,"_31083":73164,"_5":31418,"_21524":122119,"_28264":122120,"_3060":122121},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3604":73171,"_31083":73164,"_5":31418,"_21524":122123,"_28264":122124,"_3060":122125},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3604":73172,"_31083":73164,"_5":31418,"_21524":122127,"_28264":122128,"_3060":122129},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3604":73173,"_31083":73164,"_5":31418,"_21524":122131,"_28264":122132,"_3060":122133},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3604":73174,"_31083":73164,"_5":31418,"_21524":122135,"_28264":122136,"_3060":122137},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3604":73175,"_31083":73164,"_5":31418,"_21524":122139,"_28264":122140,"_3060":122141},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3604":73176,"_31083":73164,"_5":31418,"_21524":122143,"_28264":122144,"_3060":122145},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3604":73177,"_31083":73164,"_21524":122147,"_5":14790,"_28264":73164,"_3060":122148},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3604":73178,"_31083":73164,"_21524":122150,"_5":14790,"_28264":122104,"_3060":122151},[],"El cuerpo de auditoría incluye:",{"_3604":73179,"_31083":73164,"_21524":122153,"_5":14790,"_28264":122104,"_3060":122154},[],"input: datos recibidos por la operación;",{"_3604":73180,"_31083":73164,"_21524":122156,"_5":14790,"_28264":122104,"_3060":122157},[],"has\\_error: indica si el servicio devolvió un error;",{"_3604":73181,"_31083":73164,"_21524":122159,"_5":14790,"_28264":122104,"_3060":122160},[],"output: resultado producido o mensaje de error;",{"_3604":73182,"_31083":73164,"_21524":122162,"_5":14790,"_28264":122104,"_3060":122163},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3604":73183,"_31083":73164,"_21524":122165,"_5":14790,"_28264":122104,"_3060":122166},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3604":73184,"_31083":73164,"_21524":122168,"_5":14790,"_28264":122104,"_3060":122169},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3604":73185,"_31083":73164,"_21524":122171,"_5":14790,"_28264":122108,"_3060":122172},[],"El backend aplica auditoría a mutaciones de:",{"_3604":73186,"_31083":73164,"_21524":122174,"_5":14790,"_28264":122108,"_3060":122175},[],"autoridades, certificados y perfiles de emisión;",{"_3604":73187,"_31083":73164,"_21524":122177,"_5":14790,"_28264":122108,"_3060":122178},[],"claves y motores KMS;",{"_3604":73188,"_31083":73164,"_21524":122180,"_5":14790,"_28264":122108,"_3060":122181},[],"dispositivos e identidades;",{"_3604":73189,"_31083":73164,"_21524":122183,"_5":14790,"_28264":122108,"_3060":122184},[],"DMS y operaciones de enrolamiento;",{"_3604":73190,"_31083":73164,"_21524":122186,"_5":14790,"_28264":122108,"_3060":122187},[],"funciones de validación y CRL;",{"_3604":73191,"_31083":73164,"_21524":122189,"_5":14790,"_28264":122108,"_3060":122190},[],"principales, políticas y concesiones de autorización.",{"_3604":73192,"_31083":73164,"_21524":122192,"_5":14790,"_28264":122108,"_3060":122193},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3604":73193,"_31083":73164,"_21524":122195,"_5":14790,"_28264":122112,"_3060":122196},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3604":73194,"_31083":73164,"_21524":122198,"_5":14790,"_28264":122112,"_3060":122199},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3604":73195,"_31083":73164,"_21524":122201,"_5":14790,"_28264":122112,"_3060":122202},[],"Diseña el consumidor para:",{"_3604":73196,"_31083":73164,"_21524":122204,"_5":14790,"_28264":122112,"_3060":122205},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3604":73197,"_31083":73164,"_21524":122207,"_5":14790,"_28264":122112,"_3060":122208},[],"conservar el CloudEvent completo sin modificar;",{"_3604":73198,"_31083":73164,"_21524":122210,"_5":14790,"_28264":122112,"_3060":122211},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3604":73199,"_31083":73164,"_21524":122213,"_5":14790,"_28264":122112,"_3060":122214},[],"cifrar en tránsito y en reposo;",{"_3604":73200,"_31083":73164,"_21524":122216,"_5":14790,"_28264":122112,"_3060":122217},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3604":73201,"_31083":73164,"_21524":122219,"_5":14790,"_28264":122112,"_3060":122220},[],"aplicar una política explícita de retención y legal hold;",{"_3604":73202,"_31083":73164,"_21524":122222,"_5":14790,"_28264":122112,"_3060":122223},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3604":73203,"_31083":73164,"_21524":122225,"_5":14790,"_28264":122116,"_3060":122226},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3604":73204,"_31083":73164,"_21524":122228,"_5":14790,"_28264":122116,"_3060":122229},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3604":73205,"_31083":73164,"_21524":122231,"_5":14790,"_28264":122124,"_3060":122232},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3604":73206,"_31083":73164,"_21524":122234,"_5":14790,"_28264":122128,"_3060":122235},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3604":73207,"_31083":73164,"_21524":122237,"_5":14790,"_28264":122132,"_3060":122238},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3604":73208,"_31083":73164,"_21524":122240,"_5":14790,"_28264":122136,"_3060":122241},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3604":73209,"_31083":73164,"_21524":122243,"_5":14790,"_28264":122140,"_3060":122244},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3604":73210,"_31083":73164,"_21524":122246,"_5":14790,"_28264":122144,"_3060":122247},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3604":73211,"_31083":73164,"_21524":122249,"_5":14790,"_28264":122144,"_3060":122250},[],"aparece un evento de auditoría correcto;",{"_3604":73212,"_31083":73164,"_21524":122252,"_5":14790,"_28264":122144,"_3060":122253},[],"el principal coincide con la identidad utilizada;",{"_3604":73213,"_31083":73164,"_21524":122255,"_5":14790,"_28264":122144,"_3060":122256},[],"el consumidor lo persiste una sola vez;",{"_3604":73214,"_31083":73164,"_21524":122258,"_5":14790,"_28264":122144,"_3060":122259},[],"puede recuperarse por recurso, actor y periodo;",{"_3604":73215,"_31083":73164,"_21524":122261,"_5":14790,"_28264":122144,"_3060":122262},[],"una interrupción del consumidor produce una alerta.",{"_3604":73216,"_31083":73164,"_21524":122264,"_5":14790,"_28264":122144,"_3060":122265},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3604":73217,"_31083":73217,"_5":15155,"_3060":122267,"_31421":122268,"_21524":122269,"_28264":73217},"Arquitectura de la plataforma",[50730,121224],[],{"_3604":73218,"_31083":73217,"_21524":122271,"_5":14790,"_28264":73217,"_3060":122272},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3604":73219,"_31083":73217,"_5":31418,"_21524":122274,"_28264":122275,"_3060":122276},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3604":73220,"_31083":73217,"_5":31418,"_21524":122278,"_28264":122279,"_3060":122280},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3604":73221,"_31083":73217,"_5":31418,"_21524":122282,"_28264":122283,"_3060":122284},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3604":73222,"_31083":73217,"_5":31418,"_21524":122286,"_28264":122287,"_3060":122288},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3604":73223,"_31083":73217,"_5":31418,"_21524":122290,"_28264":122291,"_3060":122292},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3604":73224,"_31083":73217,"_21524":122294,"_5":14790,"_28264":73217,"_3060":122295},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3604":73225,"_31083":73217,"_21524":122297,"_5":14790,"_28264":73217,"_3060":122298},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3604":73226,"_31083":73217,"_21524":122300,"_5":14790,"_28264":122275,"_3060":122301},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3604":73227,"_31083":73217,"_21524":122303,"_5":14790,"_28264":122279,"_3060":122304},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3604":73228,"_31083":73217,"_21524":122306,"_5":14790,"_28264":122283,"_3060":122307},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3604":73229,"_31083":73217,"_21524":122309,"_5":14790,"_28264":122287,"_3060":122310},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3604":73230,"_31083":73217,"_21524":122312,"_5":14790,"_28264":122291,"_3060":122313},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3604":73231,"_31083":73231,"_5":15155,"_3060":122315,"_31421":122316,"_21524":122317,"_28264":73231},"Cómo funciona Lamassu",[50730,121224],[],{"_3604":73232,"_31083":73231,"_21524":122319,"_5":14790,"_28264":73231,"_3060":122320},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3604":73233,"_31083":73231,"_5":31418,"_21524":122322,"_28264":122323,"_3060":122324},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3604":73234,"_31083":73231,"_5":31418,"_21524":122326,"_28264":122327,"_3060":122328},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3604":73235,"_31083":73231,"_21524":122330,"_5":14790,"_28264":73231,"_3060":122331},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3604":73236,"_31083":73231,"_21524":122333,"_5":14790,"_28264":122323,"_3060":122334},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3604":73237,"_31083":73231,"_21524":122336,"_5":14790,"_28264":122323,"_3060":122337},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3604":73238,"_31083":73231,"_21524":122339,"_5":14790,"_28264":122323,"_3060":122340},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3604":73239,"_31083":73231,"_21524":122342,"_5":14790,"_28264":122323,"_3060":122343},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3604":73240,"_31083":73231,"_21524":122345,"_5":14790,"_28264":122323,"_3060":122346},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3604":73241,"_31083":73231,"_21524":122348,"_5":14790,"_28264":122327,"_3060":122349},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3604":73242,"_31083":73231,"_21524":122351,"_5":14790,"_28264":122327,"_3060":122352},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3604":73243,"_31083":73231,"_21524":122354,"_5":14790,"_28264":122327,"_3060":122355},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3604":73244,"_31083":73231,"_21524":122357,"_5":14790,"_28264":122327,"_3060":122358},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3604":73245,"_31083":73231,"_21524":122360,"_5":14790,"_28264":122327,"_3060":122361},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3604":73246,"_31083":73231,"_21524":122363,"_5":14790,"_28264":122327,"_3060":122364},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3604":73247,"_31083":73231,"_21524":122366,"_5":14790,"_28264":122327,"_3060":122367},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3604":73248,"_31083":73248,"_5":15155,"_3060":122369,"_31421":122370,"_21524":122371,"_28264":73248},"Dispositivos e identidades",[50730,121224,53414,122369],[],{"_3604":73249,"_31083":73248,"_21524":122373,"_5":14790,"_28264":73248,"_3060":122374},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3604":73250,"_31083":73248,"_5":31418,"_21524":122376,"_28264":122377,"_3060":122378},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3604":73251,"_31083":73248,"_5":31418,"_21524":122380,"_28264":122381,"_3060":122382},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3604":73252,"_31083":73248,"_5":31418,"_21524":122384,"_28264":122385,"_3060":122386},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3604":73253,"_31083":73248,"_5":31418,"_21524":122388,"_28264":122389,"_3060":122390},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3604":73254,"_31083":73248,"_5":31418,"_21524":122392,"_28264":122393,"_3060":122394},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3604":73255,"_31083":73248,"_5":31418,"_21524":122396,"_28264":122397,"_3060":122398},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3604":73256,"_31083":73248,"_5":31418,"_21524":122400,"_28264":122401,"_3060":122402},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3604":73257,"_31083":73248,"_5":31418,"_21524":122404,"_28264":122405,"_3060":122406},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3604":73258,"_31083":73248,"_5":31418,"_21524":122408,"_28264":122409,"_3060":122410},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3604":73259,"_31083":73248,"_5":31418,"_21524":122412,"_28264":122413,"_3060":122414},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3604":73260,"_31083":73248,"_5":31418,"_21524":122416,"_28264":122417,"_3060":122418},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3604":73261,"_31083":73248,"_21524":122420,"_5":14790,"_28264":73248,"_3060":122421},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3604":73262,"_31083":73248,"_21524":122423,"_5":14790,"_28264":73248,"_3060":122424},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3604":73263,"_31083":73248,"_21524":122426,"_5":14790,"_28264":122377,"_3060":122427},[],"Vista operativa",{"_3604":73264,"_31083":73248,"_21524":122429,"_5":14790,"_28264":122377,"_3060":122430},[],"Interpretación",{"_3604":73265,"_31083":73248,"_21524":122432,"_5":14790,"_28264":122377,"_3060":53477},[],{"_3604":73266,"_31083":73248,"_21524":122434,"_5":14790,"_28264":122377,"_3060":122435},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3604":73267,"_31083":73248,"_21524":122437,"_5":14790,"_28264":122377,"_3060":53483},[],{"_3604":73268,"_31083":73248,"_21524":122439,"_5":14790,"_28264":122377,"_3060":122440},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3604":73269,"_31083":73248,"_21524":122442,"_5":14790,"_28264":122377,"_3060":53489},[],{"_3604":73270,"_31083":73248,"_21524":122444,"_5":14790,"_28264":122377,"_3060":122445},[],"La identidad está en la ventana operativa de renovación.",{"_3604":73271,"_31083":73248,"_21524":122447,"_5":14790,"_28264":122377,"_3060":53495},[],{"_3604":73272,"_31083":73248,"_21524":122449,"_5":14790,"_28264":122377,"_3060":122450},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3604":73273,"_31083":73248,"_21524":122452,"_5":14790,"_28264":122377,"_3060":53501},[],{"_3604":73274,"_31083":73248,"_21524":122454,"_5":14790,"_28264":122377,"_3060":122455},[],"La identidad ha vencido.",{"_3604":73275,"_31083":73248,"_21524":122457,"_5":14790,"_28264":122377,"_3060":53507},[],{"_3604":73276,"_31083":73248,"_21524":122459,"_5":14790,"_28264":122377,"_3060":122460},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3604":73277,"_31083":73248,"_21524":122462,"_5":14790,"_28264":122377,"_3060":53513},[],{"_3604":73278,"_31083":73248,"_21524":122464,"_5":14790,"_28264":122377,"_3060":122465},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3604":73279,"_31083":73248,"_21524":122467,"_5":14790,"_28264":122377,"_3060":122468},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3604":73280,"_31083":73248,"_21524":122470,"_5":14790,"_28264":122381,"_3060":122471},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3604":73281,"_31083":73248,"_21524":122473,"_5":14790,"_28264":122381,"_3060":122474},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3604":73282,"_31083":73248,"_21524":122476,"_5":14790,"_28264":122381,"_3060":122477},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3604":73283,"_31083":73248,"_21524":122479,"_5":14790,"_28264":122381,"_3060":122480},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3604":73284,"_31083":73248,"_21524":122482,"_5":14790,"_28264":122385,"_3060":122483},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3604":73285,"_31083":73248,"_21524":122485,"_5":14790,"_28264":122389,"_3060":122486},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3604":73286,"_31083":73248,"_21524":122488,"_5":14790,"_28264":122393,"_3060":122489},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3604":73287,"_31083":73248,"_21524":122491,"_5":14790,"_28264":122397,"_3060":122492},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3604":73288,"_31083":73248,"_21524":122494,"_5":14790,"_28264":122401,"_3060":122495},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3604":73289,"_31083":73248,"_21524":122497,"_5":14790,"_28264":122401,"_3060":122498},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3604":73290,"_31083":73248,"_21524":122500,"_5":14790,"_28264":122405,"_3060":122501},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3604":73291,"_31083":73248,"_21524":122503,"_5":14790,"_28264":122405,"_3060":122504},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3604":73292,"_31083":73248,"_21524":122506,"_5":14790,"_28264":122405,"_3060":122507},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3604":73293,"_31083":73248,"_21524":122509,"_5":14790,"_28264":122405,"_3060":122510},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3604":73294,"_31083":73248,"_21524":122512,"_5":14790,"_28264":122405,"_3060":122513},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3604":73295,"_31083":73248,"_21524":122515,"_5":14790,"_28264":122405,"_3060":122516},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3604":73296,"_31083":73248,"_21524":122518,"_5":14790,"_28264":122409,"_3060":122519},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3604":73297,"_31083":73248,"_21524":122521,"_5":14790,"_28264":122409,"_3060":122522},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3604":73298,"_31083":73248,"_21524":122524,"_5":14790,"_28264":122409,"_3060":122525},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3604":73299,"_31083":73248,"_21524":122527,"_5":14790,"_28264":122413,"_3060":122528},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3604":73300,"_31083":73248,"_21524":122530,"_5":14790,"_28264":122413,"_3060":122531},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3604":73301,"_31083":73248,"_21524":122533,"_5":14790,"_28264":122413,"_3060":122534},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3604":73302,"_31083":73248,"_21524":122536,"_5":14790,"_28264":122413,"_3060":122537},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3604":73303,"_31083":73248,"_21524":122539,"_5":14790,"_28264":122417,"_3060":122540},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3604":73304,"_31083":73248,"_21524":122542,"_5":14790,"_28264":122417,"_3060":122543},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3604":73305,"_31083":73305,"_5":15155,"_3060":122545,"_31421":122546,"_21524":122548,"_28264":73305},"Identidad inicial y autenticación",[50730,121224,53414,122369,122547],"Enrolamiento con PKI",[],{"_3604":73306,"_31083":73305,"_21524":122550,"_5":14790,"_28264":73305,"_3060":122551},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3604":73307,"_31083":73305,"_5":31418,"_21524":122553,"_28264":122554,"_3060":122555},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3604":73308,"_31083":73305,"_5":31418,"_21524":122557,"_28264":122558,"_3060":122559},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3604":73309,"_31083":73305,"_5":31418,"_21524":122561,"_28264":122562,"_3060":122563},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3604":73310,"_31083":73305,"_5":31418,"_21524":122565,"_28264":122566,"_3060":122567},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3604":73311,"_31083":73305,"_5":31418,"_21524":122569,"_28264":122570,"_3060":122571},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3604":73312,"_31083":73305,"_21524":122573,"_5":14790,"_28264":73305,"_3060":122574},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3604":73313,"_31083":73305,"_21524":122576,"_5":14790,"_28264":122554,"_3060":122577},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3604":73314,"_31083":73305,"_21524":122579,"_5":14790,"_28264":122554,"_3060":122580},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3604":73315,"_31083":73305,"_21524":122582,"_5":14790,"_28264":122558,"_3060":122583},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3604":73316,"_31083":73305,"_21524":122585,"_5":14790,"_28264":122558,"_3060":122586},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3604":73317,"_31083":73305,"_21524":122588,"_5":14790,"_28264":122558,"_3060":122589},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3604":73318,"_31083":73305,"_21524":122591,"_5":14790,"_28264":122562,"_3060":122592},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3604":73319,"_31083":73305,"_21524":122594,"_5":14790,"_28264":122562,"_3060":122595},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3604":73320,"_31083":73305,"_21524":122597,"_5":14790,"_28264":122566,"_3060":122598},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3604":73321,"_31083":73305,"_21524":122600,"_5":14790,"_28264":122566,"_3060":122601},[],"Ejemplo de cuerpo:",{"_3604":73322,"_31083":73305,"_21524":122603,"_5":14790,"_28264":122566,"_3060":122604},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3604":73323,"_31083":73305,"_21524":122606,"_5":14790,"_28264":122566,"_3060":122607},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3604":73324,"_31083":73305,"_21524":122609,"_5":14790,"_28264":122566,"_3060":122610},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3604":73325,"_31083":73305,"_21524":122612,"_5":14790,"_28264":122566,"_3060":122613},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3604":73326,"_31083":73305,"_21524":122615,"_5":14790,"_28264":122570,"_3060":122616},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3604":73327,"_31083":73305,"_21524":122618,"_5":14790,"_28264":122570,"_3060":122619},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3604":73328,"_31083":73328,"_5":15155,"_3060":122621,"_31421":122622,"_21524":122623,"_28264":73328},"Configura y opera el DMS",[50730,121224,53414,122369,122547],[],{"_3604":73329,"_31083":73328,"_21524":122625,"_5":14790,"_28264":73328,"_3060":122626},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3604":73330,"_31083":73328,"_5":31418,"_21524":122628,"_28264":122629,"_3060":119758},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3604":73331,"_31083":73328,"_5":31418,"_21524":122631,"_28264":122632,"_3060":122633},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3604":73332,"_31083":73328,"_5":31418,"_21524":122635,"_28264":122636,"_3060":122637},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3604":73333,"_31083":73328,"_5":31418,"_21524":122639,"_28264":122640,"_3060":122641},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3604":73334,"_31083":73328,"_5":31418,"_21524":122643,"_28264":122644,"_3060":122645},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3604":73335,"_31083":73328,"_5":31418,"_21524":122647,"_28264":122648,"_3060":122649},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3604":73336,"_31083":73328,"_5":31418,"_21524":122651,"_28264":122652,"_3060":122653},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3604":73337,"_31083":73328,"_5":31418,"_21524":122655,"_28264":122656,"_3060":122657},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3604":73338,"_31083":73328,"_5":31418,"_21524":122659,"_28264":122660,"_3060":53712},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3604":73339,"_31083":73328,"_5":31418,"_21524":122662,"_28264":122663,"_3060":53716},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3604":73340,"_31083":73328,"_5":31418,"_21524":122665,"_28264":122666,"_3060":122667},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3604":73341,"_31083":73328,"_5":31418,"_21524":122669,"_28264":122670,"_3060":122671},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3604":73342,"_31083":73328,"_5":31418,"_21524":122673,"_28264":122674,"_3060":122675},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3604":73343,"_31083":73328,"_5":31418,"_21524":122677,"_28264":122678,"_3060":122679},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3604":73344,"_31083":73328,"_5":31418,"_21524":122681,"_28264":122682,"_3060":53736},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3604":73345,"_31083":73328,"_5":31418,"_21524":122684,"_28264":122685,"_3060":122686},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3604":73346,"_31083":73328,"_5":31418,"_21524":122688,"_28264":122689,"_3060":122690},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3604":73347,"_31083":73328,"_5":31418,"_21524":122692,"_28264":122693,"_3060":122694},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3604":73348,"_31083":73328,"_21524":122696,"_5":14790,"_28264":73328,"_3060":122697},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3604":73349,"_31083":73328,"_21524":122699,"_5":14790,"_28264":122629,"_3060":122700},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3604":73350,"_31083":73328,"_21524":122702,"_5":14790,"_28264":122629,"_3060":122703},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3604":73351,"_31083":73328,"_21524":122705,"_5":14790,"_28264":122636,"_3060":122706},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3604":73352,"_31083":73328,"_21524":122708,"_5":14790,"_28264":122640,"_3060":122709},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3604":73353,"_31083":73328,"_21524":122711,"_5":14790,"_28264":122644,"_3060":122712},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3604":73354,"_31083":73328,"_21524":122714,"_5":14790,"_28264":122648,"_3060":122715},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3604":73355,"_31083":73328,"_21524":122717,"_5":14790,"_28264":122652,"_3060":122718},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3604":73356,"_31083":73328,"_21524":122720,"_5":14790,"_28264":122660,"_3060":122721},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3604":73357,"_31083":73328,"_21524":122723,"_5":14790,"_28264":122660,"_3060":122724},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3604":73358,"_31083":73328,"_21524":122726,"_5":14790,"_28264":122663,"_3060":122727},[],"Campo de `settings.enrollment_settings`",{"_3604":73359,"_31083":73328,"_21524":122729,"_5":14790,"_28264":122663,"_3060":122730},[],"Decisión",{"_3604":73360,"_31083":73328,"_21524":122732,"_5":14790,"_28264":122663,"_3060":53787},[],{"_3604":73361,"_31083":73328,"_21524":122734,"_5":14790,"_28264":122663,"_3060":122735},[],"`EST_RFC7030` para estas operaciones.",{"_3604":73362,"_31083":73328,"_21524":122737,"_5":14790,"_28264":122663,"_3060":53793},[],{"_3604":73363,"_31083":73328,"_21524":122739,"_5":14790,"_28264":122663,"_3060":122740},[],"ID de la CA que firmará.",{"_3604":73364,"_31083":73328,"_21524":122742,"_5":14790,"_28264":122663,"_3060":53799},[],{"_3604":73365,"_31083":73328,"_21524":122744,"_5":14790,"_28264":122663,"_3060":122745},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3604":73366,"_31083":73328,"_21524":122747,"_5":14790,"_28264":122663,"_3060":53805},[],{"_3604":73367,"_31083":73328,"_21524":122749,"_5":14790,"_28264":122663,"_3060":122750},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3604":73368,"_31083":73328,"_21524":122752,"_5":14790,"_28264":122663,"_3060":53811},[],{"_3604":73369,"_31083":73328,"_21524":122754,"_5":14790,"_28264":122663,"_3060":122755},[],"Uno de los cuatro modos de autenticación.",{"_3604":73370,"_31083":73328,"_21524":122757,"_5":14790,"_28264":122663,"_3060":122758},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3604":73371,"_31083":73328,"_21524":122760,"_5":14790,"_28264":122666,"_3060":122761},[],"Los bloques son independientes:",{"_3604":73372,"_31083":73328,"_21524":122763,"_5":14790,"_28264":122666,"_3060":122764},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3604":73373,"_31083":73328,"_21524":122766,"_5":14790,"_28264":122666,"_3060":122767},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3604":73374,"_31083":73328,"_21524":122769,"_5":14790,"_28264":122666,"_3060":53829},[],{"_3604":73375,"_31083":73328,"_21524":122771,"_5":14790,"_28264":122666,"_3060":122772},[],"Control aplicado en la operación configurada",{"_3604":73376,"_31083":73328,"_21524":122774,"_5":14790,"_28264":122666,"_3060":53835},[],{"_3604":73377,"_31083":73328,"_21524":122776,"_5":14790,"_28264":122666,"_3060":122777},[],"Validación del certificado presentado.",{"_3604":73378,"_31083":73328,"_21524":122779,"_5":14790,"_28264":122666,"_3060":53841},[],{"_3604":73379,"_31083":73328,"_21524":122781,"_5":14790,"_28264":122666,"_3060":122782},[],"Autorización del webhook configurado.",{"_3604":73380,"_31083":73328,"_21524":122784,"_5":14790,"_28264":122666,"_3060":53847},[],{"_3604":73381,"_31083":73328,"_21524":122786,"_5":14790,"_28264":122666,"_3060":122787},[],"Validación del certificado y, después, aprobación del webhook.",{"_3604":73382,"_31083":73328,"_21524":122789,"_5":14790,"_28264":122666,"_3060":53853},[],{"_3604":73383,"_31083":73328,"_21524":122791,"_5":14790,"_28264":122666,"_3060":122792},[],"Sin autenticación del solicitante por el DMS.",{"_3604":73384,"_31083":73328,"_21524":122794,"_5":14790,"_28264":122666,"_3060":122795},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3604":73385,"_31083":73328,"_21524":122797,"_5":14790,"_28264":122666,"_3060":122798},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3604":73386,"_31083":73328,"_21524":122800,"_5":14790,"_28264":122666,"_3060":122801},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3604":73387,"_31083":73328,"_21524":122803,"_5":14790,"_28264":122666,"_3060":122804},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3604":73388,"_31083":73328,"_21524":122806,"_5":14790,"_28264":122670,"_3060":122807},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3604":73389,"_31083":73328,"_21524":122809,"_5":14790,"_28264":122670,"_3060":122810},[],"Campo de `external_webhook_settings`",{"_3604":73390,"_31083":73328,"_21524":122812,"_5":14790,"_28264":122670,"_3060":122730},[],{"_3604":73391,"_31083":73328,"_21524":122814,"_5":14790,"_28264":122670,"_3060":53879},[],{"_3604":73392,"_31083":73328,"_21524":122816,"_5":14790,"_28264":122670,"_3060":122817},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3604":73393,"_31083":73328,"_21524":122819,"_5":14790,"_28264":122670,"_3060":53885},[],{"_3604":73394,"_31083":73328,"_21524":122821,"_5":14790,"_28264":122670,"_3060":122822},[],"`POST` o `PUT`; `POST` por defecto.",{"_3604":73395,"_31083":73328,"_21524":122824,"_5":14790,"_28264":122670,"_3060":53891},[],{"_3604":73396,"_31083":73328,"_21524":122826,"_5":14790,"_28264":122670,"_3060":122827},[],"Etiqueta usada en los logs del servicio.",{"_3604":73397,"_31083":73328,"_21524":122829,"_5":14790,"_28264":122670,"_3060":53897},[],{"_3604":73398,"_31083":73328,"_21524":122831,"_5":14790,"_28264":122670,"_3060":122832},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3604":73399,"_31083":73328,"_21524":122834,"_5":14790,"_28264":122670,"_3060":53903},[],{"_3604":73400,"_31083":73328,"_21524":122836,"_5":14790,"_28264":122670,"_3060":122837},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3604":73401,"_31083":73328,"_21524":122839,"_5":14790,"_28264":122670,"_3060":53909},[],{"_3604":73402,"_31083":73328,"_21524":122841,"_5":14790,"_28264":122670,"_3060":122842},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3604":73403,"_31083":73328,"_21524":122844,"_5":14790,"_28264":122670,"_3060":53915},[],{"_3604":73404,"_31083":73328,"_21524":122846,"_5":14790,"_28264":122670,"_3060":122847},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3604":73405,"_31083":73328,"_21524":122849,"_5":14790,"_28264":122670,"_3060":53921},[],{"_3604":73406,"_31083":73328,"_21524":122851,"_5":14790,"_28264":122670,"_3060":122852},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3604":73407,"_31083":73328,"_21524":122854,"_5":14790,"_28264":122670,"_3060":53927},[],{"_3604":73408,"_31083":73328,"_21524":122856,"_5":14790,"_28264":122670,"_3060":122857},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3604":73409,"_31083":73328,"_21524":122859,"_5":14790,"_28264":122670,"_3060":53933},[],{"_3604":73410,"_31083":73328,"_21524":122861,"_5":14790,"_28264":122670,"_3060":122862},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3604":73411,"_31083":73328,"_21524":122864,"_5":14790,"_28264":122670,"_3060":122865},[],"Reglas de esa configuración:",{"_3604":73412,"_31083":73328,"_21524":122867,"_5":14790,"_28264":122670,"_3060":122868},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3604":73413,"_31083":73328,"_21524":122870,"_5":14790,"_28264":122670,"_3060":122871},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3604":73414,"_31083":73328,"_21524":122873,"_5":14790,"_28264":122670,"_3060":122874},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3604":73415,"_31083":73328,"_21524":122876,"_5":14790,"_28264":122670,"_3060":122877},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3604":73416,"_31083":73328,"_21524":122879,"_5":14790,"_28264":122670,"_3060":122880},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3604":73417,"_31083":73328,"_21524":122882,"_5":14790,"_28264":122670,"_3060":122883},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3604":73418,"_31083":73328,"_21524":122885,"_5":14790,"_28264":122670,"_3060":122886},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3604":73419,"_31083":73328,"_21524":122888,"_5":14790,"_28264":122670,"_3060":122889},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3604":73420,"_31083":73328,"_21524":122891,"_5":14790,"_28264":122670,"_3060":122892},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3604":73421,"_31083":73328,"_21524":122894,"_5":14790,"_28264":122674,"_3060":122895},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3604":73422,"_31083":73328,"_21524":122897,"_5":14790,"_28264":122678,"_3060":122898},[],"Campo de `settings.reenrollment_settings`",{"_3604":73423,"_31083":73328,"_21524":122900,"_5":14790,"_28264":122678,"_3060":122901},[],"Función",{"_3604":73424,"_31083":73328,"_21524":122903,"_5":14790,"_28264":122678,"_3060":53977},[],{"_3604":73425,"_31083":73328,"_21524":122905,"_5":14790,"_28264":122678,"_3060":122906},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3604":73426,"_31083":73328,"_21524":122908,"_5":14790,"_28264":122678,"_3060":53983},[],{"_3604":73427,"_31083":73328,"_21524":122910,"_5":14790,"_28264":122678,"_3060":122911},[],"Umbral operativo preventivo de monitorización.",{"_3604":73428,"_31083":73328,"_21524":122913,"_5":14790,"_28264":122678,"_3060":53989},[],{"_3604":73429,"_31083":73328,"_21524":122915,"_5":14790,"_28264":122678,"_3060":122916},[],"Umbral operativo crítico de monitorización.",{"_3604":73430,"_31083":73328,"_21524":122918,"_5":14790,"_28264":122678,"_3060":53995},[],{"_3604":73431,"_31083":73328,"_21524":122920,"_5":14790,"_28264":122678,"_3060":122921},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3604":73432,"_31083":73328,"_21524":122923,"_5":14790,"_28264":122678,"_3060":54001},[],{"_3604":73433,"_31083":73328,"_21524":122925,"_5":14790,"_28264":122678,"_3060":122926},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3604":73434,"_31083":73328,"_21524":122928,"_5":14790,"_28264":122678,"_3060":54007},[],{"_3604":73435,"_31083":73328,"_21524":122930,"_5":14790,"_28264":122678,"_3060":122931},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3604":73436,"_31083":73328,"_21524":122933,"_5":14790,"_28264":122678,"_3060":122934},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3604":73437,"_31083":73328,"_21524":122936,"_5":14790,"_28264":122682,"_3060":122937},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3604":73438,"_31083":73328,"_21524":122939,"_5":14790,"_28264":122685,"_3060":120122},[],{"_3604":73439,"_31083":73328,"_21524":122941,"_5":14790,"_28264":122685,"_3060":122942},[],"Qué publica",{"_3604":73440,"_31083":73328,"_21524":122944,"_5":14790,"_28264":122685,"_3060":54024},[],{"_3604":73441,"_31083":73328,"_21524":122946,"_5":14790,"_28264":122685,"_3060":122947},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3604":73442,"_31083":73328,"_21524":122949,"_5":14790,"_28264":122685,"_3060":54030},[],{"_3604":73443,"_31083":73328,"_21524":122951,"_5":14790,"_28264":122685,"_3060":122952},[],"Certificado de la CA emisora seleccionada.",{"_3604":73444,"_31083":73328,"_21524":122954,"_5":14790,"_28264":122685,"_3060":54036},[],{"_3604":73445,"_31083":73328,"_21524":122956,"_5":14790,"_28264":122685,"_3060":122957},[],"Certificados de las CAs elegidas explícitamente.",{"_3604":73446,"_31083":73328,"_21524":122959,"_5":14790,"_28264":122685,"_3060":122960},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3604":73447,"_31083":73328,"_21524":122962,"_5":14790,"_28264":122689,"_3060":122963},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3604":73448,"_31083":73328,"_21524":122965,"_5":14790,"_28264":122689,"_3060":122966},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3604":73449,"_31083":73328,"_21524":122968,"_5":14790,"_28264":122689,"_3060":122969},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3604":73450,"_31083":73328,"_21524":122971,"_5":14790,"_28264":122693,"_3060":122972},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3604":73451,"_31083":73451,"_5":15155,"_3060":122974,"_31421":122975,"_21524":122976,"_28264":73451},"Integra el cliente EST",[50730,121224,53414,122369,122547],[],{"_3604":73452,"_31083":73451,"_21524":122978,"_5":14790,"_28264":73451,"_3060":122979},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3604":73453,"_31083":73451,"_5":31418,"_21524":122981,"_28264":122982,"_3060":119758},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3604":73454,"_31083":73451,"_5":31418,"_21524":122984,"_28264":122985,"_3060":122986},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3604":73455,"_31083":73451,"_5":31418,"_21524":122988,"_28264":122989,"_3060":122990},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3604":73456,"_31083":73451,"_5":31418,"_21524":122992,"_28264":122993,"_3060":122994},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3604":73457,"_31083":73451,"_5":31418,"_21524":122996,"_28264":122997,"_3060":122998},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3604":73458,"_31083":73451,"_5":31418,"_21524":123000,"_28264":123001,"_3060":123002},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3604":73459,"_31083":73451,"_21524":123004,"_5":14790,"_28264":73451,"_3060":123005},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3604":73460,"_31083":73451,"_21524":123007,"_5":14790,"_28264":122982,"_3060":123008},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3604":73461,"_31083":73451,"_21524":123010,"_5":14790,"_28264":122982,"_3060":123011},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3604":73462,"_31083":73451,"_21524":123013,"_5":14790,"_28264":122982,"_3060":123014},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3604":73463,"_31083":73451,"_21524":123016,"_5":14790,"_28264":122985,"_3060":123017},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3604":73464,"_31083":73451,"_21524":123019,"_5":14790,"_28264":122985,"_3060":123020},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3604":73465,"_31083":73451,"_21524":123022,"_5":14790,"_28264":122989,"_3060":123023},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3604":73466,"_31083":73451,"_21524":123025,"_5":14790,"_28264":122989,"_3060":123026},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3604":73467,"_31083":73451,"_21524":123028,"_5":14790,"_28264":122993,"_3060":123029},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3604":73468,"_31083":73451,"_21524":123031,"_5":14790,"_28264":122993,"_3060":123032},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3604":73469,"_31083":73451,"_21524":123034,"_5":14790,"_28264":122997,"_3060":123035},[],"Para el caso de una raíz que emite directamente:",{"_3604":73470,"_31083":73451,"_21524":123037,"_5":14790,"_28264":122997,"_3060":123038},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3604":73471,"_31083":73451,"_21524":123040,"_5":14790,"_28264":122997,"_3060":123041},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3604":73472,"_31083":73451,"_21524":123043,"_5":14790,"_28264":123001,"_3060":123044},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3604":73473,"_31083":73473,"_5":15155,"_3060":123046,"_31421":123047,"_21524":123048,"_28264":73473},"Referencia EST",[50730,121224,53414,122369,122547],[],{"_3604":73474,"_31083":73473,"_21524":123050,"_5":14790,"_28264":73473,"_3060":123051},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3604":73475,"_31083":73473,"_5":31418,"_21524":123053,"_28264":123054,"_3060":123055},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3604":73476,"_31083":73473,"_5":31418,"_21524":123057,"_28264":123058,"_3060":23326},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3604":73477,"_31083":73473,"_5":31418,"_21524":123060,"_28264":123061,"_3060":26820},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3604":73478,"_31083":73473,"_5":31418,"_21524":123063,"_28264":123064,"_3060":26827},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3604":73479,"_31083":73473,"_5":31418,"_21524":123066,"_28264":123067,"_3060":26089},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3604":73480,"_31083":73473,"_5":31418,"_21524":123069,"_28264":123070,"_3060":123071},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3604":73481,"_31083":73473,"_5":31418,"_21524":123073,"_28264":123074,"_3060":123075},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3604":73482,"_31083":73473,"_5":31418,"_21524":123077,"_28264":123078,"_3060":123079},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3604":73483,"_31083":73473,"_21524":123081,"_5":14790,"_28264":73473,"_3060":123082},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3604":73484,"_31083":73473,"_21524":123084,"_5":14790,"_28264":123054,"_3060":123085},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3604":73485,"_31083":73473,"_21524":123087,"_5":14790,"_28264":123054,"_3060":120984},[],{"_3604":73486,"_31083":73473,"_21524":123089,"_5":14790,"_28264":123054,"_3060":123090},[],"Método",{"_3604":73487,"_31083":73473,"_21524":123092,"_5":14790,"_28264":123054,"_3060":123093},[],"Autenticación y condición",{"_3604":73488,"_31083":73473,"_21524":123095,"_5":14790,"_28264":123054,"_3060":54179},[],{"_3604":73489,"_31083":73473,"_21524":123097,"_5":14790,"_28264":123054,"_3060":54182},[],{"_3604":73490,"_31083":73473,"_21524":123099,"_5":14790,"_28264":123054,"_3060":123100},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3604":73491,"_31083":73473,"_21524":123102,"_5":14790,"_28264":123054,"_3060":54188},[],{"_3604":73492,"_31083":73473,"_21524":123104,"_5":14790,"_28264":123054,"_3060":54191},[],{"_3604":73493,"_31083":73473,"_21524":123106,"_5":14790,"_28264":123054,"_3060":123107},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3604":73494,"_31083":73473,"_21524":123109,"_5":14790,"_28264":123054,"_3060":54197},[],{"_3604":73495,"_31083":73473,"_21524":123111,"_5":14790,"_28264":123054,"_3060":54191},[],{"_3604":73496,"_31083":73473,"_21524":123113,"_5":14790,"_28264":123054,"_3060":123114},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3604":73497,"_31083":73473,"_21524":123116,"_5":14790,"_28264":123054,"_3060":54205},[],{"_3604":73498,"_31083":73473,"_21524":123118,"_5":14790,"_28264":123054,"_3060":54191},[],{"_3604":73499,"_31083":73473,"_21524":123120,"_5":14790,"_28264":123054,"_3060":123121},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3604":73500,"_31083":73473,"_21524":123123,"_5":14790,"_28264":123054,"_3060":123124},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3604":73501,"_31083":73473,"_21524":123126,"_5":14790,"_28264":123058,"_3060":123127},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3604":73502,"_31083":73473,"_21524":123129,"_5":14790,"_28264":123058,"_3060":123130},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3604":73503,"_31083":73473,"_21524":123132,"_5":14790,"_28264":123061,"_3060":123133},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3604":73504,"_31083":73473,"_21524":123135,"_5":14790,"_28264":123061,"_3060":123136},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3604":73505,"_31083":73473,"_21524":123138,"_5":14790,"_28264":123064,"_3060":123139},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3604":73506,"_31083":73473,"_21524":123141,"_5":14790,"_28264":123064,"_3060":123142},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3604":73507,"_31083":73473,"_21524":123144,"_5":14790,"_28264":123067,"_3060":123145},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3604":73508,"_31083":73473,"_21524":123147,"_5":14790,"_28264":123067,"_3060":123148},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3604":73509,"_31083":73473,"_21524":123150,"_5":14790,"_28264":123070,"_3060":123151},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3604":73510,"_31083":73473,"_21524":123153,"_5":14790,"_28264":123070,"_3060":123154},[],"Parte",{"_3604":73511,"_31083":73473,"_21524":123156,"_5":14790,"_28264":123070,"_3060":123157},[],"Contenido tras decodificar su Base64",{"_3604":73512,"_31083":73473,"_21524":123159,"_5":14790,"_28264":123070,"_3060":54249},[],{"_3604":73513,"_31083":73473,"_21524":123161,"_5":14790,"_28264":123070,"_3060":123162},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3604":73514,"_31083":73473,"_21524":123164,"_5":14790,"_28264":123070,"_3060":54255},[],{"_3604":73515,"_31083":73473,"_21524":123166,"_5":14790,"_28264":123070,"_3060":123167},[],"PKCS#7 DER con el certificado emitido.",{"_3604":73516,"_31083":73473,"_21524":123169,"_5":14790,"_28264":123070,"_3060":123170},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3604":73517,"_31083":73473,"_21524":123172,"_5":14790,"_28264":123074,"_3060":123173},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3604":73518,"_31083":73473,"_21524":123175,"_5":14790,"_28264":123074,"_3060":123176},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3604":73519,"_31083":73473,"_21524":123178,"_5":14790,"_28264":123074,"_3060":123179},[],"Convierte y comprueba el resultado:",{"_3604":73520,"_31083":73473,"_21524":123181,"_5":14790,"_28264":123074,"_3060":123182},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3604":73521,"_31083":73473,"_21524":123184,"_5":14790,"_28264":123078,"_3060":123185},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3604":73522,"_31083":73473,"_21524":123187,"_5":14790,"_28264":123078,"_3060":123188},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3604":73523,"_31083":73523,"_5":15155,"_3060":122547,"_31421":123190,"_21524":123191,"_28264":73523},[50730,121224,53414,122369,122547],[],{"_3604":73524,"_31083":73523,"_21524":123193,"_5":14790,"_28264":73523,"_3060":123194},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3604":73525,"_31083":73523,"_5":31418,"_21524":123196,"_28264":123197,"_3060":123198},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3604":73526,"_31083":73523,"_5":31418,"_21524":123200,"_28264":123201,"_3060":123202},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3604":73527,"_31083":73523,"_5":31418,"_21524":123204,"_28264":123205,"_3060":123206},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3604":73528,"_31083":73523,"_5":31418,"_21524":123208,"_28264":123209,"_3060":123210},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3604":73529,"_31083":73523,"_21524":123212,"_5":14790,"_28264":73523,"_3060":123213},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3604":73530,"_31083":73523,"_21524":123215,"_5":14790,"_28264":123197,"_3060":123216},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3604":73531,"_31083":73523,"_21524":123218,"_5":14790,"_28264":123197,"_3060":123219},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3604":73532,"_31083":73523,"_21524":123221,"_5":14790,"_28264":123197,"_3060":123222},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3604":73533,"_31083":73523,"_21524":123224,"_5":14790,"_28264":123197,"_3060":123225},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3604":73534,"_31083":73523,"_21524":123227,"_5":14790,"_28264":123197,"_3060":123228},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3604":73535,"_31083":73523,"_21524":123230,"_5":14790,"_28264":123197,"_3060":123231},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3604":73536,"_31083":73523,"_21524":123233,"_5":14790,"_28264":123201,"_3060":123234},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3604":73537,"_31083":73523,"_21524":123236,"_5":14790,"_28264":123201,"_3060":123237},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":73538,"_31083":73523,"_21524":123239,"_5":14790,"_28264":123201,"_3060":123240},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3604":73539,"_31083":73523,"_21524":123242,"_5":14790,"_28264":123201,"_3060":123243},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3604":73540,"_31083":73523,"_21524":123245,"_5":14790,"_28264":123205,"_3060":123246},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3604":73541,"_31083":73523,"_21524":123248,"_5":14790,"_28264":123205,"_3060":123249},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3604":73542,"_31083":73523,"_21524":123251,"_5":14790,"_28264":123205,"_3060":123252},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3604":73543,"_31083":73523,"_21524":123254,"_5":14790,"_28264":123205,"_3060":123255},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3604":73544,"_31083":73523,"_21524":123257,"_5":14790,"_28264":123209,"_3060":123258},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3604":73545,"_31083":73523,"_21524":123260,"_5":14790,"_28264":123209,"_3060":123261},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3604":73546,"_31083":73546,"_5":15155,"_3060":123263,"_31421":123264,"_21524":123265,"_28264":73546},"Estrategias de aprovisionamiento",[50730,121224,53414,122369,122547],[],{"_3604":73547,"_31083":73546,"_21524":123267,"_5":14790,"_28264":73546,"_3060":123268},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3604":73548,"_31083":73546,"_5":31418,"_21524":123270,"_28264":123271,"_3060":123272},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3604":73549,"_31083":73546,"_5":31418,"_21524":123274,"_28264":123275,"_3060":123276},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3604":73550,"_31083":73546,"_5":31418,"_21524":123278,"_28264":123279,"_3060":123280},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3604":73551,"_31083":73546,"_5":31418,"_21524":123282,"_28264":123283,"_3060":123284},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3604":73552,"_31083":73546,"_5":31418,"_21524":123286,"_28264":123287,"_3060":123288},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3604":73553,"_31083":73546,"_21524":123290,"_5":14790,"_28264":73546,"_3060":123291},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3604":73554,"_31083":73546,"_21524":123293,"_5":14790,"_28264":123271,"_3060":123294},[],"Recorrido",{"_3604":73555,"_31083":73546,"_21524":123296,"_5":14790,"_28264":123271,"_3060":123297},[],"Cuándo existe el dispositivo",{"_3604":73556,"_31083":73546,"_21524":123299,"_5":14790,"_28264":123271,"_3060":123300},[],"Qué compruebas",{"_3604":73557,"_31083":73546,"_21524":123302,"_5":14790,"_28264":123271,"_3060":123303},[],"Asignación manual",{"_3604":73558,"_31083":73546,"_21524":123305,"_5":14790,"_28264":123271,"_3060":123306},[],"El operador lo crea antes de asociar un certificado.",{"_3604":73559,"_31083":73546,"_21524":123308,"_5":14790,"_28264":123271,"_3060":123309},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3604":73560,"_31083":73546,"_21524":123311,"_5":14790,"_28264":123271,"_3060":123312},[],"EST con `JITP`",{"_3604":73561,"_31083":73546,"_21524":123314,"_5":14790,"_28264":123271,"_3060":123315},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3604":73562,"_31083":73546,"_21524":123317,"_5":14790,"_28264":123271,"_3060":123318},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3604":73563,"_31083":73546,"_21524":123320,"_5":14790,"_28264":123271,"_3060":123321},[],"EST con `PRE_REGISTRATION`",{"_3604":73564,"_31083":73546,"_21524":123323,"_5":14790,"_28264":123271,"_3060":123324},[],"Debe existir antes de `/simpleenroll`.",{"_3604":73565,"_31083":73546,"_21524":123326,"_5":14790,"_28264":123271,"_3060":123327},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3604":73566,"_31083":73546,"_21524":123329,"_5":14790,"_28264":123271,"_3060":123330},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3604":73567,"_31083":73546,"_21524":123332,"_5":14790,"_28264":123271,"_3060":123333},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3604":73568,"_31083":73546,"_21524":123335,"_5":14790,"_28264":123275,"_3060":123336},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3604":73569,"_31083":73546,"_21524":123338,"_5":14790,"_28264":123275,"_3060":123339},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3604":73570,"_31083":73546,"_21524":123341,"_5":14790,"_28264":123275,"_3060":123342},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3604":73571,"_31083":73546,"_21524":123344,"_5":14790,"_28264":123279,"_3060":123345},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3604":73572,"_31083":73546,"_21524":123347,"_5":14790,"_28264":123279,"_3060":123348},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3604":73573,"_31083":73546,"_21524":123350,"_5":14790,"_28264":123279,"_3060":123351},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3604":73574,"_31083":73546,"_21524":123353,"_5":14790,"_28264":123279,"_3060":123354},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3604":73575,"_31083":73546,"_21524":123356,"_5":14790,"_28264":123279,"_3060":123357},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3604":73576,"_31083":73546,"_21524":123359,"_5":14790,"_28264":123279,"_3060":123360},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3604":73577,"_31083":73546,"_21524":123362,"_5":14790,"_28264":123283,"_3060":120122},[],{"_3604":73578,"_31083":73546,"_21524":123364,"_5":14790,"_28264":123283,"_3060":123365},[],"Material que atraviesa EST",{"_3604":73579,"_31083":73546,"_21524":123367,"_5":14790,"_28264":123283,"_3060":123368},[],"Clave generada por el dispositivo",{"_3604":73580,"_31083":73546,"_21524":123370,"_5":14790,"_28264":123283,"_3060":123371},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3604":73581,"_31083":73546,"_21524":123373,"_5":14790,"_28264":123283,"_3060":123374},[],"Clave ya disponible en el dispositivo",{"_3604":73582,"_31083":73546,"_21524":123376,"_5":14790,"_28264":123283,"_3060":123377},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3604":73583,"_31083":73546,"_21524":123379,"_5":14790,"_28264":123283,"_3060":53736},[],{"_3604":73584,"_31083":73546,"_21524":123381,"_5":14790,"_28264":123283,"_3060":123382},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3604":73585,"_31083":73546,"_21524":123384,"_5":14790,"_28264":123283,"_3060":123385},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3604":73586,"_31083":73546,"_21524":123387,"_5":14790,"_28264":123287,"_3060":123388},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3604":73587,"_31083":73587,"_5":15155,"_3060":123390,"_31421":123391,"_21524":123392,"_28264":73587},"Renovación y recuperación",[50730,121224,53414,122369,122547],[],{"_3604":73588,"_31083":73587,"_21524":123394,"_5":14790,"_28264":73587,"_3060":123395},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3604":73589,"_31083":73587,"_5":31418,"_21524":123397,"_28264":123398,"_3060":123399},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3604":73590,"_31083":73587,"_5":31418,"_21524":123401,"_28264":123402,"_3060":123403},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3604":73591,"_31083":73587,"_5":31418,"_21524":123405,"_28264":123406,"_3060":123407},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3604":73592,"_31083":73587,"_5":31418,"_21524":123409,"_28264":123410,"_3060":123411},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3604":73593,"_31083":73587,"_5":31418,"_21524":123413,"_28264":123414,"_3060":123415},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3604":73594,"_31083":73587,"_21524":123417,"_5":14790,"_28264":73587,"_3060":123418},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3604":73595,"_31083":73587,"_21524":123420,"_5":14790,"_28264":123398,"_3060":123421},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3604":73596,"_31083":73587,"_21524":123423,"_5":14790,"_28264":123398,"_3060":123424},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3604":73597,"_31083":73587,"_21524":123426,"_5":14790,"_28264":123398,"_3060":123427},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3604":73598,"_31083":73587,"_21524":123429,"_5":14790,"_28264":123398,"_3060":123430},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3604":73599,"_31083":73587,"_21524":123432,"_5":14790,"_28264":123402,"_3060":123433},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3604":73600,"_31083":73587,"_21524":123435,"_5":14790,"_28264":123402,"_3060":123436},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3604":73601,"_31083":73587,"_21524":123438,"_5":14790,"_28264":123406,"_3060":123439},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3604":73602,"_31083":73587,"_21524":123441,"_5":14790,"_28264":123406,"_3060":123442},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3604":73603,"_31083":73587,"_21524":123444,"_5":14790,"_28264":123406,"_3060":123445},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3604":73604,"_31083":73587,"_21524":123447,"_5":14790,"_28264":123410,"_3060":123448},[],"Situación",{"_3604":73605,"_31083":73587,"_21524":123450,"_5":14790,"_28264":123410,"_3060":123451},[],"Procedimiento",{"_3604":73606,"_31083":73587,"_21524":123453,"_5":14790,"_28264":123410,"_3060":123454},[],"Certificado vigente, fuera de ventana",{"_3604":73607,"_31083":73587,"_21524":123456,"_5":14790,"_28264":123410,"_3060":123457},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3604":73608,"_31083":73587,"_21524":123459,"_5":14790,"_28264":123410,"_3060":123460},[],"Certificado vencido, clave disponible",{"_3604":73609,"_31083":73587,"_21524":123462,"_5":14790,"_28264":123410,"_3060":123463},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3604":73610,"_31083":73587,"_21524":123465,"_5":14790,"_28264":123410,"_3060":123466},[],"Renovación por webhook o `NO_AUTH`",{"_3604":73611,"_31083":73587,"_21524":123468,"_5":14790,"_28264":123410,"_3060":123469},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3604":73612,"_31083":73587,"_21524":123471,"_5":14790,"_28264":123410,"_3060":123472},[],"Clave perdida o inaccesible",{"_3604":73613,"_31083":73587,"_21524":123474,"_5":14790,"_28264":123410,"_3060":123475},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3604":73614,"_31083":73587,"_21524":123477,"_5":14790,"_28264":123410,"_3060":123478},[],"Identidad actual revocada",{"_3604":73615,"_31083":73587,"_21524":123480,"_5":14790,"_28264":123410,"_3060":123481},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3604":73616,"_31083":73587,"_21524":123483,"_5":14790,"_28264":123410,"_3060":123484},[],"Dispositivo sin identidad",{"_3604":73617,"_31083":73587,"_21524":123486,"_5":14790,"_28264":123410,"_3060":123487},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3604":73618,"_31083":73587,"_21524":123489,"_5":14790,"_28264":123410,"_3060":123490},[],"Dispositivo retirado",{"_3604":73619,"_31083":73587,"_21524":123492,"_5":14790,"_28264":123410,"_3060":123493},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3604":73620,"_31083":73587,"_21524":123495,"_5":14790,"_28264":123410,"_3060":123496},[],"Timeout, HTTP 500 o fallo de instalación",{"_3604":73621,"_31083":73587,"_21524":123498,"_5":14790,"_28264":123410,"_3060":123499},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3604":73622,"_31083":73587,"_21524":123501,"_5":14790,"_28264":123414,"_3060":123502},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3604":73623,"_31083":73587,"_21524":123504,"_5":14790,"_28264":123414,"_3060":123505},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3604":73624,"_31083":73624,"_5":15155,"_3060":123507,"_31421":123508,"_21524":123509,"_28264":73624},"Diagnóstico de enrolamiento",[50730,121224,53414,122369,122547],[],{"_3604":73625,"_31083":73624,"_21524":123511,"_5":14790,"_28264":73624,"_3060":123512},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3604":73626,"_31083":73624,"_5":31418,"_21524":123514,"_28264":123515,"_3060":123516},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3604":73627,"_31083":73624,"_5":31418,"_21524":123518,"_28264":123519,"_3060":123520},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3604":73628,"_31083":73624,"_5":31418,"_21524":123522,"_28264":123523,"_3060":123079},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3604":73629,"_31083":73624,"_5":31418,"_21524":123525,"_28264":123526,"_3060":123527},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3604":73630,"_31083":73624,"_21524":123529,"_5":14790,"_28264":73624,"_3060":123530},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3604":73631,"_31083":73624,"_21524":123532,"_5":14790,"_28264":123519,"_3060":123533},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3604":73632,"_31083":73624,"_21524":123535,"_5":14790,"_28264":123519,"_3060":123536},[],"Síntoma o mensaje",{"_3604":73633,"_31083":73624,"_21524":123538,"_5":14790,"_28264":123519,"_3060":123539},[],"Qué revisar",{"_3604":73634,"_31083":73624,"_21524":123541,"_5":14790,"_28264":123519,"_3060":123542},[],"curl rechaza TLS, nombre o emisor",{"_3604":73635,"_31083":73624,"_21524":123544,"_5":14790,"_28264":123519,"_3060":123545},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3604":73636,"_31083":73624,"_21524":123547,"_5":14790,"_28264":123519,"_3060":123548},[],"404 o APS ausente",{"_3604":73637,"_31083":73624,"_21524":123550,"_5":14790,"_28264":123519,"_3060":123551},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3604":73638,"_31083":73624,"_21524":123553,"_5":14790,"_28264":123519,"_3060":123554},[],"400, error de CSR o formato",{"_3604":73639,"_31083":73624,"_21524":123556,"_5":14790,"_28264":123519,"_3060":123557},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3604":73640,"_31083":73624,"_21524":123559,"_5":14790,"_28264":123519,"_3060":123560},[],"Credencial ausente o certificado no válido",{"_3604":73641,"_31083":73624,"_21524":123562,"_5":14790,"_28264":123519,"_3060":123563},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3604":73642,"_31083":73624,"_21524":123565,"_5":14790,"_28264":123519,"_3060":123566},[],"Webhook deniega, expira o responde sin autorización",{"_3604":73643,"_31083":73624,"_21524":123568,"_5":14790,"_28264":123519,"_3060":123569},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3604":73644,"_31083":73624,"_21524":123571,"_5":14790,"_28264":123519,"_3060":54662},[],{"_3604":73645,"_31083":73624,"_21524":123573,"_5":14790,"_28264":123519,"_3060":123574},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3604":73646,"_31083":73624,"_21524":123576,"_5":14790,"_28264":123519,"_3060":54668},[],{"_3604":73647,"_31083":73624,"_21524":123578,"_5":14790,"_28264":123519,"_3060":123579},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3604":73648,"_31083":73624,"_21524":123581,"_5":14790,"_28264":123519,"_3060":54674},[],{"_3604":73649,"_31083":73624,"_21524":123583,"_5":14790,"_28264":123519,"_3060":123584},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3604":73650,"_31083":73624,"_21524":123586,"_5":14790,"_28264":123519,"_3060":54680},[],{"_3604":73651,"_31083":73624,"_21524":123588,"_5":14790,"_28264":123519,"_3060":123589},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3604":73652,"_31083":73624,"_21524":123591,"_5":14790,"_28264":123519,"_3060":54686},[],{"_3604":73653,"_31083":73624,"_21524":123593,"_5":14790,"_28264":123519,"_3060":123594},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3604":73654,"_31083":73624,"_21524":123596,"_5":14790,"_28264":123519,"_3060":123597},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3604":73655,"_31083":73624,"_21524":123599,"_5":14790,"_28264":123519,"_3060":123600},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3604":73656,"_31083":73624,"_21524":123602,"_5":14790,"_28264":123519,"_3060":123603},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3604":73657,"_31083":73624,"_21524":123605,"_5":14790,"_28264":123519,"_3060":123606},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3604":73658,"_31083":73624,"_21524":123608,"_5":14790,"_28264":123519,"_3060":54704},[],{"_3604":73659,"_31083":73624,"_21524":123610,"_5":14790,"_28264":123519,"_3060":123611},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3604":73660,"_31083":73624,"_21524":123613,"_5":14790,"_28264":123519,"_3060":54710},[],{"_3604":73661,"_31083":73624,"_21524":123615,"_5":14790,"_28264":123519,"_3060":123616},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3604":73662,"_31083":73624,"_21524":123618,"_5":14790,"_28264":123519,"_3060":123619},[],"DMS propietario distinto",{"_3604":73663,"_31083":73624,"_21524":123621,"_5":14790,"_28264":123519,"_3060":123622},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3604":73664,"_31083":73624,"_21524":123624,"_5":14790,"_28264":123519,"_3060":54722},[],{"_3604":73665,"_31083":73624,"_21524":123626,"_5":14790,"_28264":123519,"_3060":123627},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3604":73666,"_31083":73624,"_21524":123629,"_5":14790,"_28264":123519,"_3060":54728},[],{"_3604":73667,"_31083":73624,"_21524":123631,"_5":14790,"_28264":123519,"_3060":123632},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3604":73668,"_31083":73624,"_21524":123634,"_5":14790,"_28264":123519,"_3060":123635},[],"Certificado actual revocado",{"_3604":73669,"_31083":73624,"_21524":123637,"_5":14790,"_28264":123519,"_3060":123638},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3604":73670,"_31083":73624,"_21524":123640,"_5":14790,"_28264":123519,"_3060":123641},[],"Error de CA, perfil o firma",{"_3604":73671,"_31083":73624,"_21524":123643,"_5":14790,"_28264":123519,"_3060":123644},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3604":73672,"_31083":73624,"_21524":123646,"_5":14790,"_28264":123519,"_3060":123647},[],"HTTP 200 sin conexión del dispositivo",{"_3604":73673,"_31083":73624,"_21524":123649,"_5":14790,"_28264":123519,"_3060":123650},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3604":73674,"_31083":73624,"_21524":123652,"_5":14790,"_28264":123519,"_3060":123653},[],"Timeout o error después de emitir",{"_3604":73675,"_31083":73624,"_21524":123655,"_5":14790,"_28264":123519,"_3060":123656},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3604":73676,"_31083":73624,"_21524":123658,"_5":14790,"_28264":123523,"_3060":123659},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3604":73677,"_31083":73624,"_21524":123661,"_5":14790,"_28264":123523,"_3060":123662},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3604":73678,"_31083":73624,"_21524":123664,"_5":14790,"_28264":123526,"_3060":123665},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3604":73679,"_31083":73624,"_21524":123667,"_5":14790,"_28264":123526,"_3060":123668},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3604":73680,"_31083":73624,"_21524":123670,"_5":14790,"_28264":123526,"_3060":123671},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3604":73681,"_31083":73624,"_21524":123673,"_5":14790,"_28264":123526,"_3060":123674},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3604":73682,"_31083":73624,"_21524":123676,"_5":14790,"_28264":123526,"_3060":123677},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3604":73683,"_31083":73624,"_21524":123679,"_5":14790,"_28264":123526,"_3060":123680},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3604":73684,"_31083":73624,"_21524":123682,"_5":14790,"_28264":123526,"_3060":123683},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3604":73685,"_31083":73685,"_5":15155,"_3060":123685,"_31421":123686,"_21524":123687,"_28264":73685},"Distribución y actualización de confianza",[50730,121224,53414,122369,122547],[],{"_3604":73686,"_31083":73685,"_21524":123689,"_5":14790,"_28264":73685,"_3060":123690},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3604":73687,"_31083":73685,"_5":31418,"_21524":123692,"_28264":123693,"_3060":123694},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3604":73688,"_31083":73685,"_5":31418,"_21524":123696,"_28264":123697,"_3060":123698},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3604":73689,"_31083":73685,"_5":31418,"_21524":123700,"_28264":123701,"_3060":123702},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3604":73690,"_31083":73685,"_5":31418,"_21524":123704,"_28264":123705,"_3060":123706},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3604":73691,"_31083":73685,"_5":31418,"_21524":123708,"_28264":123709,"_3060":123710},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3604":73692,"_31083":73685,"_21524":123712,"_5":14790,"_28264":73685,"_3060":123713},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3604":73693,"_31083":73685,"_21524":123715,"_5":14790,"_28264":123693,"_3060":123716},[],"Relación",{"_3604":73694,"_31083":73685,"_21524":123718,"_5":14790,"_28264":123693,"_3060":123719},[],"Material que prepara el responsable",{"_3604":73695,"_31083":73685,"_21524":123721,"_5":14790,"_28264":123693,"_3060":123722},[],"Dispositivo → servidor EST",{"_3604":73696,"_31083":73685,"_21524":123724,"_5":14790,"_28264":123693,"_3060":123725},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3604":73697,"_31083":73685,"_21524":123727,"_5":14790,"_28264":123693,"_3060":123728},[],"DMS → solicitante",{"_3604":73698,"_31083":73685,"_21524":123730,"_5":14790,"_28264":123693,"_3060":123731},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3604":73699,"_31083":73685,"_21524":123733,"_5":14790,"_28264":123693,"_3060":123734},[],"Consumidor → dispositivo",{"_3604":73700,"_31083":73685,"_21524":123736,"_5":14790,"_28264":123693,"_3060":123737},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3604":73701,"_31083":73685,"_21524":123739,"_5":14790,"_28264":123693,"_3060":123740},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3604":73702,"_31083":73685,"_21524":123742,"_5":14790,"_28264":123697,"_3060":123743},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3604":73703,"_31083":73685,"_21524":123745,"_5":14790,"_28264":123697,"_3060":123746},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3604":73704,"_31083":73685,"_21524":123748,"_5":14790,"_28264":123701,"_3060":123749},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3604":73705,"_31083":73685,"_21524":123751,"_5":14790,"_28264":123701,"_3060":123752},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3604":73706,"_31083":73685,"_21524":123754,"_5":14790,"_28264":123701,"_3060":123755},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3604":73707,"_31083":73685,"_21524":123757,"_5":14790,"_28264":123701,"_3060":123758},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3604":73708,"_31083":73685,"_21524":123760,"_5":14790,"_28264":123701,"_3060":123761},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3604":73709,"_31083":73685,"_21524":123763,"_5":14790,"_28264":123701,"_3060":123764},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3604":73710,"_31083":73685,"_21524":123766,"_5":14790,"_28264":123705,"_3060":123767},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3604":73711,"_31083":73685,"_21524":123769,"_5":14790,"_28264":123705,"_3060":123770},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3604":73712,"_31083":73685,"_21524":123772,"_5":14790,"_28264":123705,"_3060":123773},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3604":73713,"_31083":73685,"_21524":123775,"_5":14790,"_28264":123709,"_3060":123776},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3604":73714,"_31083":73714,"_5":15155,"_3060":54877,"_31421":123778,"_21524":123780,"_28264":73714},[50730,121224,53414,122369,123779],"Integraciones",[],{"_3604":73715,"_31083":73714,"_21524":123782,"_5":14790,"_28264":73714,"_3060":123783},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3604":73716,"_31083":73714,"_5":31418,"_21524":123785,"_28264":123786,"_3060":123787},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3604":73717,"_31083":73714,"_5":31418,"_21524":123789,"_28264":123790,"_3060":123791},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3604":73718,"_31083":73714,"_5":31418,"_21524":123793,"_28264":123794,"_3060":123795},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3604":73719,"_31083":73714,"_5":31418,"_21524":123797,"_28264":123798,"_3060":123799},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3604":73720,"_31083":73714,"_5":31418,"_21524":123801,"_28264":123802,"_3060":123803},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3604":73721,"_31083":73714,"_5":31418,"_21524":123805,"_28264":123806,"_3060":123807},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3604":73722,"_31083":73714,"_5":31418,"_21524":123809,"_28264":123810,"_3060":123811},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3604":73723,"_31083":73714,"_5":31418,"_21524":123813,"_28264":123814,"_3060":123815},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3604":73724,"_31083":73714,"_5":31418,"_21524":123817,"_28264":123818,"_3060":54919},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3604":73725,"_31083":73714,"_5":31418,"_21524":123820,"_28264":123821,"_3060":54923},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3604":73726,"_31083":73714,"_5":31418,"_21524":123823,"_28264":123824,"_3060":123825},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3604":73727,"_31083":73714,"_5":31418,"_21524":123827,"_28264":123828,"_3060":123829},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3604":73728,"_31083":73714,"_5":31418,"_21524":123831,"_28264":123832,"_3060":123833},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3604":73729,"_31083":73714,"_5":31418,"_21524":123835,"_28264":123836,"_3060":123837},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3604":73730,"_31083":73714,"_5":31418,"_21524":123839,"_28264":123840,"_3060":123841},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3604":73731,"_31083":73714,"_5":31418,"_21524":123843,"_28264":123844,"_3060":123845},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3604":73732,"_31083":73714,"_5":31418,"_21524":123847,"_28264":123848,"_3060":123849},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3604":73733,"_31083":73714,"_5":31418,"_21524":123851,"_28264":123852,"_3060":123853},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3604":73734,"_31083":73714,"_5":31418,"_21524":123855,"_28264":123856,"_3060":123857},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3604":73735,"_31083":73714,"_5":31418,"_21524":123859,"_28264":123860,"_3060":123861},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3604":73736,"_31083":73714,"_5":31418,"_21524":123863,"_28264":123864,"_3060":123865},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3604":73737,"_31083":73714,"_5":31418,"_21524":123867,"_28264":123868,"_3060":123869},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3604":73738,"_31083":73714,"_5":31418,"_21524":123871,"_28264":123872,"_3060":123873},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3604":73739,"_31083":73714,"_5":31418,"_21524":123875,"_28264":123876,"_3060":123877},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3604":73740,"_31083":73714,"_5":31418,"_21524":123879,"_28264":123880,"_3060":123881},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3604":73741,"_31083":73714,"_21524":123883,"_5":14790,"_28264":73714,"_3060":123884},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3604":73742,"_31083":73714,"_21524":123886,"_5":14790,"_28264":73714,"_3060":123887},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3604":73743,"_31083":73714,"_21524":123889,"_5":14790,"_28264":73714,"_3060":123890},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3604":73744,"_31083":73714,"_21524":123892,"_5":14790,"_28264":123786,"_3060":123893},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3604":73745,"_31083":73714,"_21524":123895,"_5":14790,"_28264":123786,"_3060":123896},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3604":73746,"_31083":73714,"_21524":123898,"_5":14790,"_28264":123786,"_3060":123899},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3604":73747,"_31083":73714,"_21524":123901,"_5":14790,"_28264":123786,"_3060":123902},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3604":73748,"_31083":73714,"_21524":123904,"_5":14790,"_28264":123790,"_3060":123905},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3604":73749,"_31083":73714,"_21524":123907,"_5":14790,"_28264":123794,"_3060":123908},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3604":73750,"_31083":73714,"_21524":123910,"_5":14790,"_28264":123794,"_3060":123911},[],"Acción IAM",{"_3604":73751,"_31083":73714,"_21524":123913,"_5":14790,"_28264":123794,"_3060":120128},[],{"_3604":73752,"_31083":73714,"_21524":123915,"_5":14790,"_28264":123794,"_3060":55018},[],{"_3604":73753,"_31083":73714,"_21524":123917,"_5":14790,"_28264":123794,"_3060":123918},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3604":73754,"_31083":73714,"_21524":123920,"_5":14790,"_28264":123794,"_3060":55024},[],{"_3604":73755,"_31083":73714,"_21524":123922,"_5":14790,"_28264":123794,"_3060":123923},[],"Registrar la CA en AWS IoT",{"_3604":73756,"_31083":73714,"_21524":123925,"_5":14790,"_28264":123794,"_3060":55030},[],{"_3604":73757,"_31083":73714,"_21524":123927,"_5":14790,"_28264":123794,"_3060":123928},[],"Consultar el estado del registro de la CA",{"_3604":73758,"_31083":73714,"_21524":123930,"_5":14790,"_28264":123794,"_3060":55036},[],{"_3604":73759,"_31083":73714,"_21524":123932,"_5":14790,"_28264":123794,"_3060":123933},[],"Crear o actualizar Things en IoT Core",{"_3604":73760,"_31083":73714,"_21524":123935,"_5":14790,"_28264":123794,"_3060":55042},[],{"_3604":73761,"_31083":73714,"_21524":123937,"_5":14790,"_28264":123794,"_3060":123938},[],"Aprovisionar Things mediante plantilla",{"_3604":73762,"_31083":73714,"_21524":123940,"_5":14790,"_28264":123794,"_3060":55048},[],{"_3604":73763,"_31083":73714,"_21524":123942,"_5":14790,"_28264":123794,"_3060":123943},[],"Registrar certificados de dispositivo",{"_3604":73764,"_31083":73714,"_21524":123945,"_5":14790,"_28264":123794,"_3060":55054},[],{"_3604":73765,"_31083":73714,"_21524":123947,"_5":14790,"_28264":123794,"_3060":123948},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3604":73766,"_31083":73714,"_21524":123950,"_5":14790,"_28264":123794,"_3060":55060},[],{"_3604":73767,"_31083":73714,"_21524":123952,"_5":14790,"_28264":123794,"_3060":123953},[],"Crear y adjuntar políticas IoT",{"_3604":73768,"_31083":73714,"_21524":123955,"_5":14790,"_28264":123794,"_3060":55066},[],{"_3604":73769,"_31083":73714,"_21524":123957,"_5":14790,"_28264":123794,"_3060":123958},[],"Gestionar grupos de Things",{"_3604":73770,"_31083":73714,"_21524":123960,"_5":14790,"_28264":123794,"_3060":55072},[],{"_3604":73771,"_31083":73714,"_21524":123962,"_5":14790,"_28264":123794,"_3060":123963},[],"Crear plantillas JITP",{"_3604":73772,"_31083":73714,"_21524":123965,"_5":14790,"_28264":123794,"_3060":55078},[],{"_3604":73773,"_31083":73714,"_21524":123967,"_5":14790,"_28264":123794,"_3060":123968},[],"Leer y escribir el Device Shadow",{"_3604":73774,"_31083":73714,"_21524":123970,"_5":14790,"_28264":123794,"_3060":123971},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3604":73775,"_31083":73714,"_21524":123973,"_5":14790,"_28264":123798,"_3060":123974},[],"Parámetro",{"_3604":73776,"_31083":73714,"_21524":123976,"_5":14790,"_28264":123798,"_3060":123977},[],"Tipo",{"_3604":73777,"_31083":73714,"_21524":123979,"_5":14790,"_28264":123798,"_3060":123980},[],"Requerido",{"_3604":73778,"_31083":73714,"_21524":123982,"_5":14790,"_28264":123798,"_3060":123983},[],"Descripción",{"_3604":73779,"_31083":73714,"_21524":123985,"_5":14790,"_28264":123798,"_3060":55099},[],{"_3604":73780,"_31083":73714,"_21524":123987,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73781,"_31083":73714,"_21524":123989,"_5":14790,"_28264":123798,"_3060":123990},[],"Sí",{"_3604":73782,"_31083":73714,"_21524":123992,"_5":14790,"_28264":123798,"_3060":123993},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3604":73783,"_31083":73714,"_21524":123995,"_5":14790,"_28264":123798,"_3060":55110},[],{"_3604":73784,"_31083":73714,"_21524":123997,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73785,"_31083":73714,"_21524":123999,"_5":14790,"_28264":123798,"_3060":123990},[],{"_3604":73786,"_31083":73714,"_21524":124001,"_5":14790,"_28264":123798,"_3060":124002},[],"Región AWS donde opera el conector.",{"_3604":73787,"_31083":73714,"_21524":124004,"_5":14790,"_28264":123798,"_3060":55120},[],{"_3604":73788,"_31083":73714,"_21524":124006,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73789,"_31083":73714,"_21524":124008,"_5":14790,"_28264":123798,"_3060":123990},[],{"_3604":73790,"_31083":73714,"_21524":124010,"_5":14790,"_28264":123798,"_3060":124011},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3604":73791,"_31083":73714,"_21524":124013,"_5":14790,"_28264":123798,"_3060":55130},[],{"_3604":73792,"_31083":73714,"_21524":124015,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73793,"_31083":73714,"_21524":124017,"_5":14790,"_28264":123798,"_3060":124018},[],"Solo con `auth_method=static`",{"_3604":73794,"_31083":73714,"_21524":124020,"_5":14790,"_28264":123798,"_3060":124021},[],"Clave de acceso AWS.",{"_3604":73795,"_31083":73714,"_21524":124023,"_5":14790,"_28264":123798,"_3060":55141},[],{"_3604":73796,"_31083":73714,"_21524":124025,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73797,"_31083":73714,"_21524":124027,"_5":14790,"_28264":123798,"_3060":124018},[],{"_3604":73798,"_31083":73714,"_21524":124029,"_5":14790,"_28264":123798,"_3060":124030},[],"Clave secreta AWS.",{"_3604":73799,"_31083":73714,"_21524":124032,"_5":14790,"_28264":123798,"_3060":55151},[],{"_3604":73800,"_31083":73714,"_21524":124034,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73801,"_31083":73714,"_21524":124036,"_5":14790,"_28264":123798,"_3060":55156},[],{"_3604":73802,"_31083":73714,"_21524":124038,"_5":14790,"_28264":123798,"_3060":124039},[],"Token de sesión (con `auth_method=static`).",{"_3604":73803,"_31083":73714,"_21524":124041,"_5":14790,"_28264":123798,"_3060":55162},[],{"_3604":73804,"_31083":73714,"_21524":124043,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73805,"_31083":73714,"_21524":124045,"_5":14790,"_28264":123798,"_3060":124046},[],"Solo con `auth_method=role`",{"_3604":73806,"_31083":73714,"_21524":124048,"_5":14790,"_28264":123798,"_3060":124049},[],"ARN del rol a asumir.",{"_3604":73807,"_31083":73714,"_21524":124051,"_5":14790,"_28264":123798,"_3060":55173},[],{"_3604":73808,"_31083":73714,"_21524":124053,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73809,"_31083":73714,"_21524":124055,"_5":14790,"_28264":123798,"_3060":55156},[],{"_3604":73810,"_31083":73714,"_21524":124057,"_5":14790,"_28264":123798,"_3060":124058},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3604":73811,"_31083":73714,"_21524":124060,"_5":14790,"_28264":123798,"_3060":55183},[],{"_3604":73812,"_31083":73714,"_21524":124062,"_5":14790,"_28264":123798,"_3060":92494},[],{"_3604":73813,"_31083":73714,"_21524":124064,"_5":14790,"_28264":123798,"_3060":123990},[],{"_3604":73814,"_31083":73714,"_21524":124066,"_5":14790,"_28264":123798,"_3060":124067},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3604":73815,"_31083":73714,"_21524":124069,"_5":14790,"_28264":123798,"_3060":55193},[],{"_3604":73816,"_31083":73714,"_21524":124071,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73817,"_31083":73714,"_21524":124073,"_5":14790,"_28264":123798,"_3060":123990},[],{"_3604":73818,"_31083":73714,"_21524":124075,"_5":14790,"_28264":123798,"_3060":124076},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3604":73819,"_31083":73714,"_21524":124078,"_5":14790,"_28264":123798,"_3060":55203},[],{"_3604":73820,"_31083":73714,"_21524":124080,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73821,"_31083":73714,"_21524":124082,"_5":14790,"_28264":123798,"_3060":123990},[],{"_3604":73822,"_31083":73714,"_21524":124084,"_5":14790,"_28264":123798,"_3060":124085},[],"URL HTTP del Device Manager de Lamassu.",{"_3604":73823,"_31083":73714,"_21524":124087,"_5":14790,"_28264":123798,"_3060":55213},[],{"_3604":73824,"_31083":73714,"_21524":124089,"_5":14790,"_28264":123798,"_3060":25699},[],{"_3604":73825,"_31083":73714,"_21524":124091,"_5":14790,"_28264":123798,"_3060":123990},[],{"_3604":73826,"_31083":73714,"_21524":124093,"_5":14790,"_28264":123798,"_3060":124094},[],"URL HTTP del servicio de CA de Lamassu.",{"_3604":73827,"_31083":73714,"_21524":124096,"_5":14790,"_28264":123802,"_3060":124097},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3604":73828,"_31083":73714,"_21524":124099,"_5":14790,"_28264":123802,"_3060":124100},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3604":73829,"_31083":73714,"_21524":124102,"_5":14790,"_28264":123802,"_3060":124103},[],"Tipo de CloudEvent",{"_3604":73830,"_31083":73714,"_21524":124105,"_5":14790,"_28264":123802,"_3060":124106},[],"Recurso en Lamassu",{"_3604":73831,"_31083":73714,"_21524":124108,"_5":14790,"_28264":123802,"_3060":124109},[],"Recurso AWS",{"_3604":73832,"_31083":73714,"_21524":124111,"_5":14790,"_28264":123802,"_3060":124112},[],"Acciones IAM",{"_3604":73833,"_31083":73714,"_21524":124114,"_5":14790,"_28264":123802,"_3060":124115},[],"Llamadas AWS y efecto",{"_3604":73834,"_31083":73714,"_21524":124117,"_5":14790,"_28264":123802,"_3060":124118},[],"Dónde en esta página",{"_3604":73835,"_31083":73714,"_21524":124120,"_5":14790,"_28264":123802,"_3060":55247},[],{"_3604":73836,"_31083":73714,"_21524":124122,"_5":14790,"_28264":123802,"_3060":55250},[],{"_3604":73837,"_31083":73714,"_21524":124124,"_5":14790,"_28264":123802,"_3060":55253},[],{"_3604":73838,"_31083":73714,"_21524":124126,"_5":14790,"_28264":123802,"_3060":55256},[],{"_3604":73839,"_31083":73714,"_21524":124128,"_5":14790,"_28264":123802,"_3060":124129},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3604":73840,"_31083":73714,"_21524":124131,"_5":14790,"_28264":123802,"_3060":123815},[],{"_3604":73841,"_31083":73714,"_21524":124133,"_5":14790,"_28264":123802,"_3060":55264},[],{"_3604":73842,"_31083":73714,"_21524":124135,"_5":14790,"_28264":123802,"_3060":55267},[],{"_3604":73843,"_31083":73714,"_21524":124137,"_5":14790,"_28264":123802,"_3060":55270},[],{"_3604":73844,"_31083":73714,"_21524":124139,"_5":14790,"_28264":123802,"_3060":55273},[],{"_3604":73845,"_31083":73714,"_21524":124141,"_5":14790,"_28264":123802,"_3060":124142},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3604":73846,"_31083":73714,"_21524":124144,"_5":14790,"_28264":123802,"_3060":123841},[],{"_3604":73847,"_31083":73714,"_21524":124146,"_5":14790,"_28264":123802,"_3060":55281},[],{"_3604":73848,"_31083":73714,"_21524":124148,"_5":14790,"_28264":123802,"_3060":124149},[],"Dispositivo",{"_3604":73849,"_31083":73714,"_21524":124151,"_5":14790,"_28264":123802,"_3060":55287},[],{"_3604":73850,"_31083":73714,"_21524":124153,"_5":14790,"_28264":123802,"_3060":55290},[],{"_3604":73851,"_31083":73714,"_21524":124155,"_5":14790,"_28264":123802,"_3060":124156},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3604":73852,"_31083":73714,"_21524":124158,"_5":14790,"_28264":123802,"_3060":123849},[],{"_3604":73853,"_31083":73714,"_21524":124160,"_5":14790,"_28264":123802,"_3060":55298},[],{"_3604":73854,"_31083":73714,"_21524":124162,"_5":14790,"_28264":123802,"_3060":124163},[],"Certificado",{"_3604":73855,"_31083":73714,"_21524":124165,"_5":14790,"_28264":123802,"_3060":55304},[],{"_3604":73856,"_31083":73714,"_21524":124167,"_5":14790,"_28264":123802,"_3060":124168},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3604":73857,"_31083":73714,"_21524":124170,"_5":14790,"_28264":123802,"_3060":124171},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3604":73858,"_31083":73714,"_21524":124173,"_5":14790,"_28264":123802,"_3060":123861},[],{"_3604":73859,"_31083":73714,"_21524":124175,"_5":14790,"_28264":123802,"_3060":55315},[],{"_3604":73860,"_31083":73714,"_21524":124177,"_5":14790,"_28264":123802,"_3060":124178},[],"Certificado / Dispositivo",{"_3604":73861,"_31083":73714,"_21524":124180,"_5":14790,"_28264":123802,"_3060":55321},[],{"_3604":73862,"_31083":73714,"_21524":124182,"_5":14790,"_28264":123802,"_3060":51126},[],{"_3604":73863,"_31083":73714,"_21524":124184,"_5":14790,"_28264":123802,"_3060":124185},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3604":73864,"_31083":73714,"_21524":124187,"_5":14790,"_28264":123802,"_3060":123869},[],{"_3604":73865,"_31083":73714,"_21524":124189,"_5":14790,"_28264":123806,"_3060":124190},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3604":73866,"_31083":73714,"_21524":124192,"_5":14790,"_28264":123810,"_3060":124193},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3604":73867,"_31083":73714,"_21524":124195,"_5":14790,"_28264":123810,"_3060":124196},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3604":73868,"_31083":73714,"_21524":124198,"_5":14790,"_28264":123814,"_3060":124199},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3604":73869,"_31083":73714,"_21524":124201,"_5":14790,"_28264":123814,"_3060":124202},[],"Transición",{"_3604":73870,"_31083":73714,"_21524":124204,"_5":14790,"_28264":123814,"_3060":124205},[],"Llamadas AWS",{"_3604":73871,"_31083":73714,"_21524":124207,"_5":14790,"_28264":123814,"_3060":124208},[],"`NoRegistrada` → `Solicitada`",{"_3604":73872,"_31083":73714,"_21524":124210,"_5":14790,"_28264":123814,"_3060":124211},[],"ninguna (solo escritura de metadatos)",{"_3604":73873,"_31083":73714,"_21524":124213,"_5":14790,"_28264":123814,"_3060":124214},[],"`Solicitada` → `Registrando`",{"_3604":73874,"_31083":73714,"_21524":124216,"_5":14790,"_28264":123814,"_3060":124217},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3604":73875,"_31083":73714,"_21524":124219,"_5":14790,"_28264":123814,"_3060":124220},[],"`Registrando` → `Completada`",{"_3604":73876,"_31083":73714,"_21524":124222,"_5":14790,"_28264":123814,"_3060":124223},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3604":73877,"_31083":73714,"_21524":124225,"_5":14790,"_28264":123814,"_3060":124226},[],"`Registrando` → `Fallida`",{"_3604":73878,"_31083":73714,"_21524":124228,"_5":14790,"_28264":123814,"_3060":124229},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3604":73879,"_31083":73714,"_21524":124231,"_5":14790,"_28264":123814,"_3060":124232},[],"`Fallida` / `Completada` → `Solicitada`",{"_3604":73880,"_31083":73714,"_21524":124234,"_5":14790,"_28264":123814,"_3060":124235},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3604":73881,"_31083":73714,"_21524":124237,"_5":14790,"_28264":123818,"_3060":124238},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3604":73882,"_31083":73714,"_21524":124240,"_5":14790,"_28264":123818,"_3060":124241},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3604":73883,"_31083":73714,"_21524":124243,"_5":14790,"_28264":123818,"_3060":124244},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3604":73884,"_31083":73714,"_21524":124246,"_5":14790,"_28264":123818,"_3060":124247},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3604":73885,"_31083":73714,"_21524":124249,"_5":14790,"_28264":123818,"_3060":124250},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3604":73886,"_31083":73714,"_21524":124252,"_5":14790,"_28264":123818,"_3060":124253},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3604":73887,"_31083":73714,"_21524":124255,"_5":14790,"_28264":123821,"_3060":124256},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3604":73888,"_31083":73714,"_21524":124258,"_5":14790,"_28264":123824,"_3060":124259},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3604":73889,"_31083":73714,"_21524":124261,"_5":14790,"_28264":123824,"_3060":124262},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3604":73890,"_31083":73714,"_21524":124264,"_5":14790,"_28264":123828,"_3060":124265},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3604":73891,"_31083":73714,"_21524":124267,"_5":14790,"_28264":123832,"_3060":124268},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3604":73892,"_31083":73714,"_21524":124270,"_5":14790,"_28264":123832,"_3060":124271},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3604":73893,"_31083":73714,"_21524":124273,"_5":14790,"_28264":123832,"_3060":124274},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3604":73894,"_31083":73714,"_21524":124276,"_5":14790,"_28264":123832,"_3060":124277},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3604":73895,"_31083":73714,"_21524":124279,"_5":14790,"_28264":123832,"_3060":124280},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3604":73896,"_31083":73714,"_21524":124282,"_5":14790,"_28264":123832,"_3060":124283},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3604":73897,"_31083":73714,"_21524":124285,"_5":14790,"_28264":123836,"_3060":124286},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3604":73898,"_31083":73714,"_21524":124288,"_5":14790,"_28264":123836,"_3060":124289},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3604":73899,"_31083":73714,"_21524":124291,"_5":14790,"_28264":123836,"_3060":124292},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3604":73900,"_31083":73714,"_21524":124294,"_5":14790,"_28264":123836,"_3060":124295},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3604":73901,"_31083":73714,"_21524":124297,"_5":14790,"_28264":123836,"_3060":124298},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3604":73902,"_31083":73714,"_21524":124300,"_5":14790,"_28264":123840,"_3060":124301},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3604":73903,"_31083":73714,"_21524":124303,"_5":14790,"_28264":123840,"_3060":124202},[],{"_3604":73904,"_31083":73714,"_21524":124305,"_5":14790,"_28264":123840,"_3060":124205},[],{"_3604":73905,"_31083":73714,"_21524":124307,"_5":14790,"_28264":123840,"_3060":124308},[],"`SinConfigurar` → `None` / `Auto`",{"_3604":73906,"_31083":73714,"_21524":124310,"_5":14790,"_28264":123840,"_3060":124311},[],"ninguna (solo configuración)",{"_3604":73907,"_31083":73714,"_21524":124313,"_5":14790,"_28264":123840,"_3060":55458},[],{"_3604":73908,"_31083":73714,"_21524":124315,"_5":14790,"_28264":123840,"_3060":124311},[],{"_3604":73909,"_31083":73714,"_21524":124317,"_5":14790,"_28264":123840,"_3060":124318},[],"Cualquiera → `Jitp`",{"_3604":73910,"_31083":73714,"_21524":124320,"_5":14790,"_28264":123840,"_3060":124321},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3604":73911,"_31083":73714,"_21524":124323,"_5":14790,"_28264":123840,"_3060":55469},[],{"_3604":73912,"_31083":73714,"_21524":124325,"_5":14790,"_28264":123840,"_3060":124326},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3604":73913,"_31083":73714,"_21524":124328,"_5":14790,"_28264":123844,"_3060":124329},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3604":73914,"_31083":73714,"_21524":124331,"_5":14790,"_28264":123844,"_3060":124332},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3604":73915,"_31083":73714,"_21524":124334,"_5":14790,"_28264":123844,"_3060":124335},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3604":73916,"_31083":73714,"_21524":124337,"_5":14790,"_28264":123848,"_3060":124338},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3604":73917,"_31083":73714,"_21524":124340,"_5":14790,"_28264":123848,"_3060":124202},[],{"_3604":73918,"_31083":73714,"_21524":124342,"_5":14790,"_28264":123848,"_3060":124205},[],{"_3604":73919,"_31083":73714,"_21524":124344,"_5":14790,"_28264":123848,"_3060":124345},[],"`Ausente` → `Aprovisionado`",{"_3604":73920,"_31083":73714,"_21524":124347,"_5":14790,"_28264":123848,"_3060":124348},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3604":73921,"_31083":73714,"_21524":124350,"_5":14790,"_28264":123848,"_3060":124351},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3604":73922,"_31083":73714,"_21524":124353,"_5":14790,"_28264":123848,"_3060":124354},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3604":73923,"_31083":73714,"_21524":124356,"_5":14790,"_28264":123848,"_3060":124357},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3604":73924,"_31083":73714,"_21524":124359,"_5":14790,"_28264":123852,"_3060":124360},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3604":73925,"_31083":73714,"_21524":124362,"_5":14790,"_28264":123852,"_3060":124363},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3604":73926,"_31083":73714,"_21524":124365,"_5":14790,"_28264":123852,"_3060":124366},[],"Para que el flujo JITP funcione correctamente:",{"_3604":73927,"_31083":73714,"_21524":124368,"_5":14790,"_28264":123852,"_3060":124369},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3604":73928,"_31083":73714,"_21524":124371,"_5":14790,"_28264":123852,"_3060":124372},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3604":73929,"_31083":73714,"_21524":124374,"_5":14790,"_28264":123852,"_3060":124375},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3604":73930,"_31083":73714,"_21524":124377,"_5":14790,"_28264":123852,"_3060":124378},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3604":73931,"_31083":73714,"_21524":124380,"_5":14790,"_28264":123856,"_3060":124381},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3604":73932,"_31083":73714,"_21524":124383,"_5":14790,"_28264":123856,"_3060":124384},[],"Estado en Lamassu",{"_3604":73933,"_31083":73714,"_21524":124386,"_5":14790,"_28264":123856,"_3060":124387},[],"Razón de revocación",{"_3604":73934,"_31083":73714,"_21524":124389,"_5":14790,"_28264":123856,"_3060":124390},[],"Estado en AWS IoT Core",{"_3604":73935,"_31083":73714,"_21524":124392,"_5":14790,"_28264":123856,"_3060":55539},[],{"_3604":73936,"_31083":73714,"_21524":124394,"_5":14790,"_28264":123856,"_3060":124395},[],"Ninguna",{"_3604":73937,"_31083":73714,"_21524":124397,"_5":14790,"_28264":123856,"_3060":55545},[],{"_3604":73938,"_31083":73714,"_21524":124399,"_5":14790,"_28264":123856,"_3060":55548},[],{"_3604":73939,"_31083":73714,"_21524":124401,"_5":14790,"_28264":123856,"_3060":55551},[],{"_3604":73940,"_31083":73714,"_21524":124403,"_5":14790,"_28264":123856,"_3060":55554},[],{"_3604":73941,"_31083":73714,"_21524":124405,"_5":14790,"_28264":123856,"_3060":55548},[],{"_3604":73942,"_31083":73714,"_21524":124407,"_5":14790,"_28264":123856,"_3060":124408},[],"Cualquier otra razón",{"_3604":73943,"_31083":73714,"_21524":124410,"_5":14790,"_28264":123856,"_3060":55562},[],{"_3604":73944,"_31083":73714,"_21524":124412,"_5":14790,"_28264":123856,"_3060":124413},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3604":73945,"_31083":73714,"_21524":124415,"_5":14790,"_28264":123860,"_3060":124416},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3604":73946,"_31083":73714,"_21524":124418,"_5":14790,"_28264":123860,"_3060":124202},[],{"_3604":73947,"_31083":73714,"_21524":124420,"_5":14790,"_28264":123860,"_3060":124205},[],{"_3604":73948,"_31083":73714,"_21524":124422,"_5":14790,"_28264":123860,"_3060":124423},[],"`NoSincronizado` → `Active`",{"_3604":73949,"_31083":73714,"_21524":124425,"_5":14790,"_28264":123860,"_3060":55054},[],{"_3604":73950,"_31083":73714,"_21524":124427,"_5":14790,"_28264":123860,"_3060":55580},[],{"_3604":73951,"_31083":73714,"_21524":124429,"_5":14790,"_28264":123860,"_3060":124430},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3604":73952,"_31083":73714,"_21524":124432,"_5":14790,"_28264":123860,"_3060":55586},[],{"_3604":73953,"_31083":73714,"_21524":124434,"_5":14790,"_28264":123860,"_3060":124430},[],{"_3604":73954,"_31083":73714,"_21524":124436,"_5":14790,"_28264":123860,"_3060":55591},[],{"_3604":73955,"_31083":73714,"_21524":124438,"_5":14790,"_28264":123860,"_3060":55054},[],{"_3604":73956,"_31083":73714,"_21524":124440,"_5":14790,"_28264":123860,"_3060":55596},[],{"_3604":73957,"_31083":73714,"_21524":124442,"_5":14790,"_28264":123860,"_3060":124443},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3604":73958,"_31083":73714,"_21524":124445,"_5":14790,"_28264":123864,"_3060":124446},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3604":73959,"_31083":73714,"_21524":124448,"_5":14790,"_28264":123864,"_3060":124449},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3604":73960,"_31083":73714,"_21524":124451,"_5":14790,"_28264":123864,"_3060":124452},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3604":73961,"_31083":73714,"_21524":124454,"_5":14790,"_28264":123868,"_3060":124455},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3604":73962,"_31083":73714,"_21524":124457,"_5":14790,"_28264":123868,"_3060":124458},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3604":73963,"_31083":73714,"_21524":124460,"_5":14790,"_28264":123872,"_3060":124461},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3604":73964,"_31083":73714,"_21524":124463,"_5":14790,"_28264":123872,"_3060":124464},[],"Existen dos tipos de acciones:",{"_3604":73965,"_31083":73714,"_21524":124466,"_5":14790,"_28264":123872,"_3060":124467},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3604":73966,"_31083":73714,"_21524":124469,"_5":14790,"_28264":123872,"_3060":124470},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3604":73967,"_31083":73714,"_21524":124472,"_5":14790,"_28264":123872,"_3060":124473},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3604":73968,"_31083":73714,"_21524":124475,"_5":14790,"_28264":123876,"_3060":124476},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3604":73969,"_31083":73714,"_21524":124478,"_5":14790,"_28264":123876,"_3060":124479},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3604":73970,"_31083":73714,"_21524":124481,"_5":14790,"_28264":123876,"_3060":124482},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3604":73971,"_31083":73714,"_21524":124484,"_5":14790,"_28264":123880,"_3060":124485},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3604":73972,"_31083":73714,"_21524":124487,"_5":14790,"_28264":123880,"_3060":124488},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3604":73973,"_31083":73714,"_21524":124490,"_5":14790,"_28264":123880,"_3060":124491},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3604":73974,"_31083":73714,"_21524":124493,"_5":14790,"_28264":123880,"_3060":124494},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3604":73975,"_31083":73714,"_21524":124496,"_5":14790,"_28264":123880,"_3060":124497},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3604":73976,"_31083":73714,"_21524":124499,"_5":14790,"_28264":123880,"_3060":124500},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3604":73977,"_31083":73714,"_21524":124502,"_5":14790,"_28264":123880,"_3060":124503},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3604":73978,"_31083":73714,"_21524":124505,"_5":14790,"_28264":123880,"_3060":124506},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3604":73979,"_31083":73714,"_21524":124508,"_5":14790,"_28264":123880,"_3060":124509},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3604":73980,"_31083":73714,"_21524":124511,"_5":14790,"_28264":123880,"_3060":124512},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3604":73981,"_31083":73714,"_21524":124514,"_5":14790,"_28264":123880,"_3060":124515},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3604":73982,"_31083":73714,"_21524":124517,"_5":14790,"_28264":123880,"_3060":124518},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3604":73983,"_31083":73714,"_21524":124520,"_5":14790,"_28264":123880,"_3060":124521},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3604":73984,"_31083":73714,"_21524":124523,"_5":14790,"_28264":123880,"_3060":124524},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3604":73985,"_31083":73714,"_21524":124526,"_5":14790,"_28264":123880,"_3060":124527},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3604":73986,"_31083":73714,"_21524":124529,"_5":14790,"_28264":123880,"_3060":124530},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3604":73987,"_31083":73714,"_21524":124532,"_5":14790,"_28264":123880,"_3060":124533},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3604":73988,"_31083":73714,"_21524":124535,"_5":14790,"_28264":123880,"_3060":124536},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3604":73989,"_31083":73714,"_21524":124538,"_5":14790,"_28264":123880,"_3060":124539},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3604":73990,"_31083":73714,"_21524":124541,"_5":14790,"_28264":123880,"_3060":124542},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3604":73991,"_31083":73714,"_21524":124544,"_5":14790,"_28264":123880,"_3060":124545},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3604":73992,"_31083":73714,"_21524":124547,"_5":14790,"_28264":123880,"_3060":124548},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":73993,"_31083":73714,"_21524":124550,"_5":14790,"_28264":123880,"_3060":124551},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3604":73994,"_31083":73714,"_21524":124553,"_5":14790,"_28264":123880,"_3060":124554},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3604":73995,"_31083":73995,"_5":15155,"_3060":53414,"_31421":124556,"_21524":124557,"_28264":73995},[50730,121224,53414],[],{"_3604":73996,"_31083":73995,"_21524":124559,"_5":14790,"_28264":73995,"_3060":124560},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3604":73997,"_31083":73995,"_5":31418,"_21524":124562,"_28264":124563,"_3060":124564},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3604":73998,"_31083":73995,"_5":31418,"_21524":124566,"_28264":124567,"_3060":122369},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3604":73999,"_31083":73995,"_5":31418,"_21524":124569,"_28264":124570,"_3060":122547},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3604":74000,"_31083":73995,"_5":31418,"_21524":124572,"_28264":124573,"_3060":123779},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3604":74001,"_31083":73995,"_5":31418,"_21524":124575,"_28264":124576,"_3060":124577},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3604":74002,"_31083":73995,"_21524":124579,"_5":14790,"_28264":73995,"_3060":124580},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3604":74003,"_31083":73995,"_21524":124582,"_5":14790,"_28264":124563,"_3060":124583},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3604":74004,"_31083":73995,"_21524":124585,"_5":14790,"_28264":124563,"_3060":124586},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3604":74005,"_31083":73995,"_21524":124588,"_5":14790,"_28264":124567,"_3060":124589},[],"Recurso",{"_3604":74006,"_31083":73995,"_21524":124591,"_5":14790,"_28264":124567,"_3060":124592},[],"Qué representa",{"_3604":74007,"_31083":73995,"_21524":124594,"_5":14790,"_28264":124567,"_3060":124595},[],"**Dispositivo**",{"_3604":74008,"_31083":73995,"_21524":124597,"_5":14790,"_28264":124567,"_3060":124598},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3604":74009,"_31083":73995,"_21524":124600,"_5":14790,"_28264":124567,"_3060":124601},[],"**Identidad**",{"_3604":74010,"_31083":73995,"_21524":124603,"_5":14790,"_28264":124567,"_3060":124604},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3604":74011,"_31083":73995,"_21524":124606,"_5":14790,"_28264":124567,"_3060":55763},[],{"_3604":74012,"_31083":73995,"_21524":124608,"_5":14790,"_28264":124567,"_3060":124609},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3604":74013,"_31083":73995,"_21524":124611,"_5":14790,"_28264":124567,"_3060":124612},[],"**Flota**",{"_3604":74014,"_31083":73995,"_21524":124614,"_5":14790,"_28264":124567,"_3060":124615},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3604":74015,"_31083":73995,"_21524":124617,"_5":14790,"_28264":124567,"_3060":124618},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3604":74016,"_31083":73995,"_21524":124620,"_5":14790,"_28264":124567,"_3060":124621},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3604":74017,"_31083":73995,"_21524":124623,"_5":14790,"_28264":124570,"_3060":124624},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3604":74018,"_31083":73995,"_21524":124626,"_5":14790,"_28264":124570,"_3060":124627},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3604":74019,"_31083":73995,"_21524":124629,"_5":14790,"_28264":124570,"_3060":124630},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3604":74020,"_31083":73995,"_21524":124632,"_5":14790,"_28264":124570,"_3060":124633},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3604":74021,"_31083":73995,"_21524":124635,"_5":14790,"_28264":124570,"_3060":124636},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3604":74022,"_31083":73995,"_21524":124638,"_5":14790,"_28264":124570,"_3060":124639},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3604":74023,"_31083":73995,"_21524":124641,"_5":14790,"_28264":124570,"_3060":124642},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":74024,"_31083":73995,"_21524":124644,"_5":14790,"_28264":124570,"_3060":124645},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3604":74025,"_31083":73995,"_21524":124647,"_5":14790,"_28264":124573,"_3060":124648},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3604":74026,"_31083":73995,"_21524":124650,"_5":14790,"_28264":124573,"_3060":124651},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3604":74027,"_31083":73995,"_21524":124653,"_5":14790,"_28264":124576,"_3060":124654},[],"Participante",{"_3604":74028,"_31083":73995,"_21524":124656,"_5":14790,"_28264":124576,"_3060":124657},[],"Responsabilidad",{"_3604":74029,"_31083":73995,"_21524":124659,"_5":14790,"_28264":124576,"_3060":124660},[],"Administrador PKI",{"_3604":74030,"_31083":73995,"_21524":124662,"_5":14790,"_28264":124576,"_3060":124663},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3604":74031,"_31083":73995,"_21524":124665,"_5":14790,"_28264":124576,"_3060":124666},[],"Administrador del aprovisionamiento",{"_3604":74032,"_31083":73995,"_21524":124668,"_5":14790,"_28264":124576,"_3060":124669},[],"DMS, admisión, autenticación por operación e inventario.",{"_3604":74033,"_31083":73995,"_21524":124671,"_5":14790,"_28264":124576,"_3060":124672},[],"Integrador del dispositivo",{"_3604":74034,"_31083":73995,"_21524":124674,"_5":14790,"_28264":124576,"_3060":124675},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3604":74035,"_31083":73995,"_21524":124677,"_5":14790,"_28264":124576,"_3060":124678},[],"Integrador del consumidor",{"_3604":74036,"_31083":73995,"_21524":124680,"_5":14790,"_28264":124576,"_3060":124681},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3604":74037,"_31083":73995,"_21524":124683,"_5":14790,"_28264":124576,"_3060":124684},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3604":74038,"_31083":74038,"_5":15155,"_3060":124686,"_31421":124687,"_21524":124689,"_28264":74038},"Enrola y conecta tu primer dispositivo",[50730,121224,53414,124688],"Primeros pasos",[],{"_3604":74039,"_31083":74038,"_21524":124691,"_5":14790,"_28264":74038,"_3060":124692},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3604":74040,"_31083":74038,"_5":31418,"_21524":124694,"_28264":124695,"_3060":119758},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3604":74041,"_31083":74038,"_5":31418,"_21524":124697,"_28264":124698,"_3060":124699},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3604":74042,"_31083":74038,"_5":31418,"_21524":124701,"_28264":124702,"_3060":124703},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3604":74043,"_31083":74038,"_5":31418,"_21524":124705,"_28264":124706,"_3060":124707},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3604":74044,"_31083":74038,"_5":31418,"_21524":124709,"_28264":124710,"_3060":124711},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3604":74045,"_31083":74038,"_5":31418,"_21524":124713,"_28264":124714,"_3060":124715},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3604":74046,"_31083":74038,"_5":31418,"_21524":124717,"_28264":124718,"_3060":124719},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3604":74047,"_31083":74038,"_5":31418,"_21524":124721,"_28264":124722,"_3060":124723},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3604":74048,"_31083":74038,"_21524":124725,"_5":14790,"_28264":74038,"_3060":124726},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3604":74049,"_31083":74038,"_21524":124728,"_5":14790,"_28264":124695,"_3060":124729},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3604":74050,"_31083":74038,"_21524":124731,"_5":14790,"_28264":124695,"_3060":124732},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3604":74051,"_31083":74038,"_21524":124734,"_5":14790,"_28264":124695,"_3060":124735},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3604":74052,"_31083":74038,"_21524":124737,"_5":14790,"_28264":124695,"_3060":124738},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3604":74053,"_31083":74038,"_21524":124740,"_5":14790,"_28264":124695,"_3060":124741},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3604":74054,"_31083":74038,"_21524":124743,"_5":14790,"_28264":124698,"_3060":124744},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3604":74055,"_31083":74038,"_21524":124746,"_5":14790,"_28264":124698,"_3060":124747},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3604":74056,"_31083":74038,"_21524":124749,"_5":14790,"_28264":124702,"_3060":124750},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3604":74057,"_31083":74038,"_21524":124752,"_5":14790,"_28264":124702,"_3060":124753},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3604":74058,"_31083":74038,"_21524":124755,"_5":14790,"_28264":124702,"_3060":124756},[],"Ajuste",{"_3604":74059,"_31083":74038,"_21524":124758,"_5":14790,"_28264":124702,"_3060":124759},[],"Valor de evaluación",{"_3604":74060,"_31083":74038,"_21524":124761,"_5":14790,"_28264":124702,"_3060":55919},[],{"_3604":74061,"_31083":74038,"_21524":124763,"_5":14790,"_28264":124702,"_3060":124764},[],"Raíz emisora de `device-root.pem`.",{"_3604":74062,"_31083":74038,"_21524":124766,"_5":14790,"_28264":124702,"_3060":122675},[],{"_3604":74063,"_31083":74038,"_21524":124768,"_5":14790,"_28264":124702,"_3060":124769},[],"Perfil final de 1 hora que acabas de preparar.",{"_3604":74064,"_31083":74038,"_21524":124771,"_5":14790,"_28264":124702,"_3060":55930},[],{"_3604":74065,"_31083":74038,"_21524":124773,"_5":14790,"_28264":124702,"_3060":55933},[],{"_3604":74066,"_31083":74038,"_21524":124775,"_5":14790,"_28264":124702,"_3060":55936},[],{"_3604":74067,"_31083":74038,"_21524":124777,"_5":14790,"_28264":124702,"_3060":124778},[],"Habilitado.",{"_3604":74068,"_31083":74038,"_21524":124780,"_5":14790,"_28264":124702,"_3060":55942},[],{"_3604":74069,"_31083":74038,"_21524":124782,"_5":14790,"_28264":124702,"_3060":124783},[],"Deshabilitado; el ID debe ser nuevo.",{"_3604":74070,"_31083":74038,"_21524":124785,"_5":14790,"_28264":124702,"_3060":124786},[],"Autenticación inicial",{"_3604":74071,"_31083":74038,"_21524":124788,"_5":14790,"_28264":124702,"_3060":124789},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3604":74072,"_31083":74038,"_21524":124791,"_5":14790,"_28264":124702,"_3060":124792},[],"Autenticación de renovación",{"_3604":74073,"_31083":74038,"_21524":124794,"_5":14790,"_28264":124702,"_3060":124795},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3604":74074,"_31083":74038,"_21524":124797,"_5":14790,"_28264":124702,"_3060":55960},[],{"_3604":74075,"_31083":74038,"_21524":124799,"_5":14790,"_28264":124702,"_3060":124800},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3604":74076,"_31083":74038,"_21524":124802,"_5":14790,"_28264":124702,"_3060":55966},[],{"_3604":74077,"_31083":74038,"_21524":124804,"_5":14790,"_28264":124702,"_3060":124805},[],"1 hora.",{"_3604":74078,"_31083":74038,"_21524":124807,"_5":14790,"_28264":124702,"_3060":55972},[],{"_3604":74079,"_31083":74038,"_21524":124809,"_5":14790,"_28264":124702,"_3060":124810},[],"30 minutos / 10 minutos.",{"_3604":74080,"_31083":74038,"_21524":124812,"_5":14790,"_28264":124702,"_3060":55978},[],{"_3604":74081,"_31083":74038,"_21524":124814,"_5":14790,"_28264":124702,"_3060":124815},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3604":74082,"_31083":74038,"_21524":124817,"_5":14790,"_28264":124702,"_3060":53736},[],{"_3604":74083,"_31083":74038,"_21524":124819,"_5":14790,"_28264":124702,"_3060":124820},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3604":74084,"_31083":74038,"_21524":124822,"_5":14790,"_28264":124702,"_3060":55989},[],{"_3604":74085,"_31083":74038,"_21524":124824,"_5":14790,"_28264":124702,"_3060":124825},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3604":74086,"_31083":74038,"_21524":124827,"_5":14790,"_28264":124702,"_3060":124828},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3604":74087,"_31083":74038,"_21524":124830,"_5":14790,"_28264":124706,"_3060":124831},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3604":74088,"_31083":74038,"_21524":124833,"_5":14790,"_28264":124706,"_3060":124834},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3604":74089,"_31083":74038,"_21524":124836,"_5":14790,"_28264":124710,"_3060":124837},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3604":74090,"_31083":74038,"_21524":124839,"_5":14790,"_28264":124710,"_3060":124840},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3604":74091,"_31083":74038,"_21524":124842,"_5":14790,"_28264":124710,"_3060":124843},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3604":74092,"_31083":74038,"_21524":124845,"_5":14790,"_28264":124714,"_3060":124846},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3604":74093,"_31083":74038,"_21524":124848,"_5":14790,"_28264":124714,"_3060":124849},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3604":74094,"_31083":74038,"_21524":124851,"_5":14790,"_28264":124718,"_3060":124852},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3604":74095,"_31083":74038,"_21524":124854,"_5":14790,"_28264":124718,"_3060":124855},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3604":74096,"_31083":74038,"_21524":124857,"_5":14790,"_28264":124718,"_3060":124858},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3604":74097,"_31083":74038,"_21524":124860,"_5":14790,"_28264":124718,"_3060":124861},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3604":74098,"_31083":74038,"_21524":124863,"_5":14790,"_28264":124718,"_3060":124864},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3604":74099,"_31083":74038,"_21524":124866,"_5":14790,"_28264":124722,"_3060":124867},[],"Comprobación",{"_3604":74100,"_31083":74038,"_21524":124869,"_5":14790,"_28264":124722,"_3060":124870},[],"Resultado esperado",{"_3604":74101,"_31083":74038,"_21524":124872,"_5":14790,"_28264":124722,"_3060":124873},[],"Registro",{"_3604":74102,"_31083":74038,"_21524":124875,"_5":14790,"_28264":124722,"_3060":124876},[],"ID creado automáticamente y DMS correcto.",{"_3604":74103,"_31083":74038,"_21524":124878,"_5":14790,"_28264":124722,"_3060":124163},[],{"_3604":74104,"_31083":74038,"_21524":124880,"_5":14790,"_28264":124722,"_3060":124881},[],"CN, perfil, serie y clave verificados.",{"_3604":74105,"_31083":74038,"_21524":124883,"_5":14790,"_28264":124722,"_3060":124884},[],"Inventario",{"_3604":74106,"_31083":74038,"_21524":124886,"_5":14790,"_28264":124722,"_3060":124887},[],"Serie recibida visible como identidad actual y en el historial.",{"_3604":74107,"_31083":74038,"_21524":124889,"_5":14790,"_28264":124722,"_3060":124890},[],"Consumidor",{"_3604":74108,"_31083":74038,"_21524":124892,"_5":14790,"_28264":124722,"_3060":124893},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3604":74109,"_31083":74038,"_21524":124895,"_5":14790,"_28264":124722,"_3060":124896},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3604":74110,"_31083":74038,"_21524":124898,"_5":14790,"_28264":124722,"_3060":124899},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3604":74111,"_31083":74111,"_5":15155,"_3060":122386,"_31421":124901,"_21524":124902,"_28264":74111},[50730,121224,53414,124688],[],{"_3604":74112,"_31083":74111,"_21524":124904,"_5":14790,"_28264":74111,"_3060":124905},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3604":74113,"_31083":74111,"_5":31418,"_21524":124907,"_28264":124908,"_3060":119758},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3604":74114,"_31083":74111,"_5":31418,"_21524":124910,"_28264":124911,"_3060":124912},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3604":74115,"_31083":74111,"_5":31418,"_21524":124914,"_28264":124915,"_3060":124916},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3604":74116,"_31083":74111,"_5":31418,"_21524":124918,"_28264":124919,"_3060":124920},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3604":74117,"_31083":74111,"_5":31418,"_21524":124922,"_28264":124923,"_3060":124924},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3604":74118,"_31083":74111,"_5":31418,"_21524":124926,"_28264":124927,"_3060":124928},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3604":74119,"_31083":74111,"_5":31418,"_21524":124930,"_28264":124931,"_3060":124870},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3604":74120,"_31083":74111,"_5":31418,"_21524":124933,"_28264":124934,"_3060":124935},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3604":74121,"_31083":74111,"_5":31418,"_21524":124937,"_28264":124938,"_3060":124939},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3604":74122,"_31083":74111,"_21524":124941,"_5":14790,"_28264":74111,"_3060":124942},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3604":74123,"_31083":74111,"_21524":124944,"_5":14790,"_28264":74111,"_3060":124945},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3604":74124,"_31083":74111,"_21524":124947,"_5":14790,"_28264":124908,"_3060":124948},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3604":74125,"_31083":74111,"_21524":124950,"_5":14790,"_28264":124908,"_3060":124951},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3604":74126,"_31083":74111,"_21524":124953,"_5":14790,"_28264":124908,"_3060":124954},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3604":74127,"_31083":74111,"_21524":124956,"_5":14790,"_28264":124908,"_3060":124957},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3604":74128,"_31083":74111,"_21524":124959,"_5":14790,"_28264":124911,"_3060":124960},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3604":74129,"_31083":74111,"_21524":124962,"_5":14790,"_28264":124911,"_3060":124963},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3604":74130,"_31083":74111,"_21524":124965,"_5":14790,"_28264":124911,"_3060":124966},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3604":74131,"_31083":74111,"_21524":124968,"_5":14790,"_28264":124911,"_3060":124969},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3604":74132,"_31083":74111,"_21524":124971,"_5":14790,"_28264":124911,"_3060":124972},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3604":74133,"_31083":74111,"_21524":124974,"_5":14790,"_28264":124911,"_3060":124975},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3604":74134,"_31083":74111,"_21524":124977,"_5":14790,"_28264":124911,"_3060":124978},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3604":74135,"_31083":74111,"_21524":124980,"_5":14790,"_28264":124911,"_3060":124981},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3604":74136,"_31083":74111,"_21524":124983,"_5":14790,"_28264":124915,"_3060":124984},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3604":74137,"_31083":74111,"_21524":124986,"_5":14790,"_28264":124915,"_3060":56154},[],{"_3604":74138,"_31083":74111,"_21524":124988,"_5":14790,"_28264":124915,"_3060":124989},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3604":74139,"_31083":74111,"_21524":124991,"_5":14790,"_28264":124915,"_3060":124992},[],"**Icon** y **Tags**: clasificación opcional.",{"_3604":74140,"_31083":74111,"_21524":124994,"_5":14790,"_28264":124915,"_3060":124995},[],"Confirma el registro.",{"_3604":74141,"_31083":74111,"_21524":124997,"_5":14790,"_28264":124919,"_3060":124998},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3604":74142,"_31083":74111,"_21524":125000,"_5":14790,"_28264":124919,"_3060":125001},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3604":74143,"_31083":74111,"_21524":125003,"_5":14790,"_28264":124923,"_3060":125004},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3604":74144,"_31083":74111,"_21524":125006,"_5":14790,"_28264":124923,"_3060":125007},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3604":74145,"_31083":74111,"_21524":125009,"_5":14790,"_28264":124927,"_3060":125010},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3604":74146,"_31083":74111,"_21524":125012,"_5":14790,"_28264":124927,"_3060":125013},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3604":74147,"_31083":74111,"_21524":125015,"_5":14790,"_28264":124931,"_3060":124867},[],{"_3604":74148,"_31083":74111,"_21524":125017,"_5":14790,"_28264":124931,"_3060":125018},[],"Resultado",{"_3604":74149,"_31083":74111,"_21524":125020,"_5":14790,"_28264":124931,"_3060":124149},[],{"_3604":74150,"_31083":74111,"_21524":125022,"_5":14790,"_28264":124931,"_3060":125023},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3604":74151,"_31083":74111,"_21524":125025,"_5":14790,"_28264":124931,"_3060":125026},[],"Identidad actual",{"_3604":74152,"_31083":74111,"_21524":125028,"_5":14790,"_28264":124931,"_3060":125029},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3604":74153,"_31083":74111,"_21524":125031,"_5":14790,"_28264":124931,"_3060":125032},[],"Historial",{"_3604":74154,"_31083":74111,"_21524":125034,"_5":14790,"_28264":124931,"_3060":125035},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3604":74155,"_31083":74111,"_21524":125037,"_5":14790,"_28264":124931,"_3060":125038},[],"Clave y certificado",{"_3604":74156,"_31083":74111,"_21524":125040,"_5":14790,"_28264":124931,"_3060":125041},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3604":74157,"_31083":74111,"_21524":125043,"_5":14790,"_28264":124934,"_3060":125044},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3604":74158,"_31083":74111,"_21524":125046,"_5":14790,"_28264":124934,"_3060":125047},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3604":74159,"_31083":74111,"_21524":125049,"_5":14790,"_28264":124934,"_3060":125050},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3604":74160,"_31083":74111,"_21524":125052,"_5":14790,"_28264":124934,"_3060":125053},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3604":74161,"_31083":74111,"_21524":125055,"_5":14790,"_28264":124938,"_3060":125056},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3604":74162,"_31083":74111,"_21524":125058,"_5":14790,"_28264":124938,"_3060":125059},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3604":74163,"_31083":74111,"_21524":125061,"_5":14790,"_28264":124938,"_3060":125062},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3604":74164,"_31083":74164,"_5":15155,"_3060":125064,"_31421":125065,"_21524":125066,"_28264":74164},"Plataforma Lamassu IoT",[50730,121224],[],{"_3604":74165,"_31083":74164,"_21524":125068,"_5":14790,"_28264":74164,"_3060":125069},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3604":74166,"_31083":74164,"_5":31418,"_21524":125071,"_28264":125072,"_3060":124564},[],"/docs/es/platform/overview#empieza-aquí",{"_3604":74167,"_31083":74164,"_5":31418,"_21524":125074,"_28264":125075,"_3060":125076},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3604":74168,"_31083":74164,"_5":31418,"_21524":125078,"_28264":125079,"_3060":125080},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3604":74169,"_31083":74164,"_5":31418,"_21524":125082,"_28264":125083,"_3060":125084},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3604":74170,"_31083":74164,"_5":31418,"_21524":125086,"_28264":125087,"_3060":125088},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3604":74171,"_31083":74164,"_5":31418,"_21524":125090,"_28264":125091,"_3060":125092},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3604":74172,"_31083":74164,"_5":31418,"_21524":125094,"_28264":125095,"_3060":125096},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3604":74173,"_31083":74164,"_5":31418,"_21524":125098,"_28264":125099,"_3060":125100},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3604":74174,"_31083":74164,"_5":31418,"_21524":125102,"_28264":125103,"_3060":125104},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3604":74175,"_31083":74164,"_5":31418,"_21524":125106,"_28264":125107,"_3060":125108},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3604":74176,"_31083":74164,"_5":31418,"_21524":125110,"_28264":125111,"_3060":125112},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3604":74177,"_31083":74164,"_21524":125114,"_5":14790,"_28264":74164,"_3060":125115},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3604":74178,"_31083":74164,"_21524":125117,"_5":14790,"_28264":125072,"_3060":125118},[],"Elige el resultado que necesitas obtener:",{"_3604":74179,"_31083":74164,"_21524":125120,"_5":14790,"_28264":125072,"_3060":125121},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3604":74180,"_31083":74164,"_21524":125123,"_5":14790,"_28264":125072,"_3060":125124},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3604":74181,"_31083":74164,"_21524":125126,"_5":14790,"_28264":125072,"_3060":125127},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3604":74182,"_31083":74164,"_21524":125129,"_5":14790,"_28264":125075,"_3060":125130},[],"Bloque",{"_3604":74183,"_31083":74164,"_21524":125132,"_5":14790,"_28264":125075,"_3060":125133},[],"Qué gestionas",{"_3604":74184,"_31083":74164,"_21524":125135,"_5":14790,"_28264":125075,"_3060":125136},[],"Punto de entrada",{"_3604":74185,"_31083":74164,"_21524":125138,"_5":14790,"_28264":125075,"_3060":56307},[],{"_3604":74186,"_31083":74164,"_21524":125140,"_5":14790,"_28264":125075,"_3060":125141},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3604":74187,"_31083":74164,"_21524":125143,"_5":14790,"_28264":125075,"_3060":125144},[],"Visión general de PKI",{"_3604":74188,"_31083":74164,"_21524":125146,"_5":14790,"_28264":125075,"_3060":56316},[],{"_3604":74189,"_31083":74164,"_21524":125148,"_5":14790,"_28264":125075,"_3060":125149},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3604":74190,"_31083":74164,"_21524":125151,"_5":14790,"_28264":125075,"_3060":125152},[],"Visión general de IoT Fleets",{"_3604":74191,"_31083":74164,"_21524":125154,"_5":14790,"_28264":125075,"_3060":125155},[],"**Administración**",{"_3604":74192,"_31083":74164,"_21524":125157,"_5":14790,"_28264":125075,"_3060":125158},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3604":74193,"_31083":74164,"_21524":125160,"_5":14790,"_28264":125075,"_3060":121226},[],{"_3604":74194,"_31083":74164,"_21524":125162,"_5":14790,"_28264":125075,"_3060":125163},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3604":74195,"_31083":74164,"_21524":125165,"_5":14790,"_28264":125079,"_3060":125166},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3604":74196,"_31083":74164,"_21524":125168,"_5":14790,"_28264":125079,"_3060":125169},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3604":74197,"_31083":74164,"_21524":125171,"_5":14790,"_28264":125079,"_3060":125172},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3604":74198,"_31083":74164,"_21524":125174,"_5":14790,"_28264":125079,"_3060":125175},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3604":74199,"_31083":74164,"_21524":125177,"_5":14790,"_28264":125079,"_3060":125178},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3604":74200,"_31083":74164,"_21524":125180,"_5":14790,"_28264":125079,"_3060":125181},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3604":74201,"_31083":74164,"_21524":125183,"_5":14790,"_28264":125087,"_3060":125184},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3604":74202,"_31083":74164,"_21524":125186,"_5":14790,"_28264":125091,"_3060":125187},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3604":74203,"_31083":74164,"_21524":125189,"_5":14790,"_28264":125095,"_3060":125190},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3604":74204,"_31083":74164,"_21524":125192,"_5":14790,"_28264":125099,"_3060":125193},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3604":74205,"_31083":74164,"_21524":125195,"_5":14790,"_28264":125103,"_3060":125196},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3604":74206,"_31083":74164,"_21524":125198,"_5":14790,"_28264":125107,"_3060":125199},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3604":74207,"_31083":74164,"_21524":125201,"_5":14790,"_28264":125111,"_3060":124657},[],{"_3604":74208,"_31083":74164,"_21524":125203,"_5":14790,"_28264":125111,"_3060":125204},[],"Qué prepara o comprueba",{"_3604":74209,"_31083":74164,"_21524":125206,"_5":14790,"_28264":125111,"_3060":124660},[],{"_3604":74210,"_31083":74164,"_21524":125208,"_5":14790,"_28264":125111,"_3060":125209},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3604":74211,"_31083":74164,"_21524":125211,"_5":14790,"_28264":125111,"_3060":125212},[],"Administrador de la flota",{"_3604":74212,"_31083":74164,"_21524":125214,"_5":14790,"_28264":125111,"_3060":125215},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3604":74213,"_31083":74164,"_21524":125217,"_5":14790,"_28264":125111,"_3060":124672},[],{"_3604":74214,"_31083":74164,"_21524":125219,"_5":14790,"_28264":125111,"_3060":125220},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3604":74215,"_31083":74164,"_21524":125222,"_5":14790,"_28264":125111,"_3060":124678},[],{"_3604":74216,"_31083":74164,"_21524":125224,"_5":14790,"_28264":125111,"_3060":125225},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3604":74217,"_31083":74164,"_21524":125227,"_5":14790,"_28264":125111,"_3060":125228},[],"Operador de infraestructura",{"_3604":74218,"_31083":74164,"_21524":125230,"_5":14790,"_28264":125111,"_3060":125231},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3604":74219,"_31083":74164,"_21524":125233,"_5":14790,"_28264":125111,"_3060":125234},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3604":74220,"_31083":74220,"_5":15155,"_3060":125236,"_31421":125237,"_21524":125239,"_28264":74220},"Jerarquía y rotación de CAs",[50730,121224,56408,125238],"Claves, autoridades y certificados",[],{"_3604":74221,"_31083":74220,"_21524":125241,"_5":14790,"_28264":74220,"_3060":125242},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3604":74222,"_31083":74220,"_5":31418,"_21524":125244,"_28264":125245,"_3060":125246},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3604":74223,"_31083":74220,"_5":31418,"_21524":125248,"_28264":125249,"_3060":125250},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3604":74224,"_31083":74220,"_5":31418,"_21524":125252,"_28264":125253,"_3060":125254},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3604":74225,"_31083":74220,"_5":31418,"_21524":125256,"_28264":125257,"_3060":125258},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3604":74226,"_31083":74220,"_5":31418,"_21524":125260,"_28264":125261,"_3060":125262},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3604":74227,"_31083":74220,"_5":31418,"_21524":125264,"_28264":125265,"_3060":125266},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3604":74228,"_31083":74220,"_5":31418,"_21524":125268,"_28264":125269,"_3060":125270},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3604":74229,"_31083":74220,"_5":31418,"_21524":125272,"_28264":125273,"_3060":125274},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3604":74230,"_31083":74220,"_5":31418,"_21524":125276,"_28264":125277,"_3060":125278},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3604":74231,"_31083":74220,"_5":31418,"_21524":125280,"_28264":125281,"_3060":125282},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3604":74232,"_31083":74220,"_5":31418,"_21524":125284,"_28264":125285,"_3060":125286},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3604":74233,"_31083":74220,"_5":31418,"_21524":125288,"_28264":125289,"_3060":125290},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3604":74234,"_31083":74220,"_21524":125292,"_5":14790,"_28264":74220,"_3060":125293},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3604":74235,"_31083":74220,"_21524":125295,"_5":14790,"_28264":74220,"_3060":125296},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3604":74236,"_31083":74220,"_21524":125298,"_5":14790,"_28264":125245,"_3060":125299},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3604":74237,"_31083":74220,"_21524":125301,"_5":14790,"_28264":125245,"_3060":125302},[],"entorno, como producción y preproducción;",{"_3604":74238,"_31083":74220,"_21524":125304,"_5":14790,"_28264":125245,"_3060":125305},[],"propietario o equipo operador;",{"_3604":74239,"_31083":74220,"_21524":125307,"_5":14790,"_28264":125245,"_3060":125308},[],"familia de dispositivos o proceso de fabricación;",{"_3604":74240,"_31083":74220,"_21524":125310,"_5":14790,"_28264":125245,"_3060":125311},[],"región o requisito regulatorio;",{"_3604":74241,"_31083":74220,"_21524":125313,"_5":14790,"_28264":125245,"_3060":125314},[],"motor criptográfico o política de clave;",{"_3604":74242,"_31083":74220,"_21524":125316,"_5":14790,"_28264":125245,"_3060":125317},[],"ventana de mantenimiento y ritmo de renovación.",{"_3604":74243,"_31083":74220,"_21524":125319,"_5":14790,"_28264":125245,"_3060":125320},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3604":74244,"_31083":74220,"_21524":125322,"_5":14790,"_28264":125245,"_3060":125323},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3604":74245,"_31083":74220,"_21524":125325,"_5":14790,"_28264":125249,"_3060":125326},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3604":74246,"_31083":74220,"_21524":125328,"_5":14790,"_28264":125249,"_3060":125329},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3604":74247,"_31083":74220,"_21524":125331,"_5":14790,"_28264":125249,"_3060":125332},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3604":74248,"_31083":74220,"_21524":125334,"_5":14790,"_28264":125249,"_3060":125335},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3604":74249,"_31083":74220,"_21524":125337,"_5":14790,"_28264":125253,"_3060":125338},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3604":74250,"_31083":74220,"_21524":125340,"_5":14790,"_28264":125253,"_3060":125341},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3604":74251,"_31083":74220,"_21524":125343,"_5":14790,"_28264":125253,"_3060":125344},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3604":74252,"_31083":74220,"_21524":125346,"_5":14790,"_28264":125253,"_3060":125347},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3604":74253,"_31083":74220,"_21524":125349,"_5":14790,"_28264":125261,"_3060":125350},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3604":74254,"_31083":74220,"_21524":125352,"_5":14790,"_28264":125265,"_3060":125353},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3604":74255,"_31083":74220,"_21524":125355,"_5":14790,"_28264":125269,"_3060":125356},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3604":74256,"_31083":74220,"_21524":125358,"_5":14790,"_28264":125273,"_3060":125359},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3604":74257,"_31083":74220,"_21524":125361,"_5":14790,"_28264":125277,"_3060":125362},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3604":74258,"_31083":74220,"_21524":125364,"_5":14790,"_28264":125281,"_3060":125365},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3604":74259,"_31083":74220,"_21524":125367,"_5":14790,"_28264":125285,"_3060":125368},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3604":74260,"_31083":74220,"_21524":125370,"_5":14790,"_28264":125285,"_3060":125371},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3604":74261,"_31083":74220,"_21524":125373,"_5":14790,"_28264":125285,"_3060":125374},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3604":74262,"_31083":74220,"_21524":125376,"_5":14790,"_28264":125285,"_3060":125377},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3604":74263,"_31083":74220,"_21524":125379,"_5":14790,"_28264":125289,"_3060":125380},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3604":74264,"_31083":74220,"_21524":125382,"_5":14790,"_28264":125289,"_3060":125383},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3604":74265,"_31083":74220,"_21524":125385,"_5":14790,"_28264":125289,"_3060":125386},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3604":74266,"_31083":74220,"_21524":125388,"_5":14790,"_28264":125289,"_3060":125389},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3604":74267,"_31083":74220,"_21524":125391,"_5":14790,"_28264":125289,"_3060":125392},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3604":74268,"_31083":74220,"_21524":125394,"_5":14790,"_28264":125289,"_3060":125395},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3604":74269,"_31083":74220,"_21524":125397,"_5":14790,"_28264":125289,"_3060":125398},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3604":74270,"_31083":74270,"_5":15155,"_3060":125400,"_31421":125401,"_21524":125402,"_28264":74270},"Autoridades de certificación",[50730,121224,56408,125238],[],{"_3604":74271,"_31083":74270,"_21524":125404,"_5":14790,"_28264":74270,"_3060":125405},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3604":74272,"_31083":74270,"_5":31418,"_21524":125407,"_28264":125408,"_3060":125409},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3604":74273,"_31083":74270,"_5":31418,"_21524":125411,"_28264":125412,"_3060":125413},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3604":74274,"_31083":74270,"_5":31418,"_21524":125415,"_28264":125416,"_3060":119758},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3604":74275,"_31083":74270,"_5":31418,"_21524":125418,"_28264":125419,"_3060":125420},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3604":74276,"_31083":74270,"_5":31418,"_21524":125422,"_28264":125423,"_3060":125424},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3604":74277,"_31083":74270,"_5":31418,"_21524":125426,"_28264":125427,"_3060":125428},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3604":74278,"_31083":74270,"_5":31418,"_21524":125430,"_28264":125431,"_3060":125432},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3604":74279,"_31083":74270,"_5":31418,"_21524":125434,"_28264":125435,"_3060":125436},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3604":74280,"_31083":74270,"_5":31418,"_21524":125438,"_28264":125439,"_3060":125440},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3604":74281,"_31083":74270,"_5":31418,"_21524":125442,"_28264":125443,"_3060":125444},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3604":74282,"_31083":74270,"_5":31418,"_21524":125446,"_28264":125447,"_3060":125448},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3604":74283,"_31083":74270,"_5":31418,"_21524":125450,"_28264":125451,"_3060":125452},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3604":74284,"_31083":74270,"_5":31418,"_21524":125454,"_28264":125455,"_3060":125456},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3604":74285,"_31083":74270,"_5":31418,"_21524":125458,"_28264":125459,"_3060":125460},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3604":74286,"_31083":74270,"_5":31418,"_21524":125462,"_28264":125463,"_3060":125464},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3604":74287,"_31083":74270,"_5":31418,"_21524":125466,"_28264":125467,"_3060":125468},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3604":74288,"_31083":74270,"_5":31418,"_21524":125470,"_28264":125471,"_3060":125472},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3604":74289,"_31083":74270,"_5":31418,"_21524":125474,"_28264":125475,"_3060":125476},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3604":74290,"_31083":74270,"_5":31418,"_21524":125478,"_28264":125479,"_3060":125480},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3604":74291,"_31083":74270,"_5":31418,"_21524":125482,"_28264":125483,"_3060":125484},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3604":74292,"_31083":74270,"_5":31418,"_21524":125486,"_28264":125487,"_3060":125488},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3604":74293,"_31083":74270,"_5":31418,"_21524":125490,"_28264":125491,"_3060":125492},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3604":74294,"_31083":74270,"_5":31418,"_21524":125494,"_28264":125495,"_3060":125496},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3604":74295,"_31083":74270,"_21524":125498,"_5":14790,"_28264":74270,"_3060":125499},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3604":74296,"_31083":74270,"_21524":125501,"_5":14790,"_28264":74270,"_3060":125502},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3604":74297,"_31083":74270,"_21524":125504,"_5":14790,"_28264":74270,"_3060":125505},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3604":74298,"_31083":74270,"_21524":125507,"_5":14790,"_28264":125408,"_3060":125508},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3604":74299,"_31083":74270,"_21524":125510,"_5":14790,"_28264":125408,"_3060":125511},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3604":74300,"_31083":74270,"_21524":125513,"_5":14790,"_28264":125408,"_3060":125514},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3604":74301,"_31083":74270,"_21524":125516,"_5":14790,"_28264":125408,"_3060":125517},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3604":74302,"_31083":74270,"_21524":125519,"_5":14790,"_28264":125408,"_3060":125520},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3604":74303,"_31083":74270,"_21524":125522,"_5":14790,"_28264":125416,"_3060":125523},[],"Decide si la CA será raíz o intermedia.",{"_3604":74304,"_31083":74270,"_21524":125525,"_5":14790,"_28264":125416,"_3060":125526},[],"Elige el motor que custodiará la clave.",{"_3604":74305,"_31083":74270,"_21524":125528,"_5":14790,"_28264":125416,"_3060":125529},[],"Define una validez superior a la de los certificados que emitirá.",{"_3604":74306,"_31083":74270,"_21524":125531,"_5":14790,"_28264":125416,"_3060":125532},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3604":74307,"_31083":74270,"_21524":125534,"_5":14790,"_28264":125419,"_3060":125535},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3604":74308,"_31083":74270,"_21524":125537,"_5":14790,"_28264":125423,"_3060":125538},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3604":74309,"_31083":74270,"_21524":125540,"_5":14790,"_28264":125423,"_3060":125541},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3604":74310,"_31083":74270,"_21524":125543,"_5":14790,"_28264":125427,"_3060":125544},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3604":74311,"_31083":74270,"_21524":125546,"_5":14790,"_28264":125431,"_3060":125547},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3604":74312,"_31083":74270,"_21524":125549,"_5":14790,"_28264":125431,"_3060":125550},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3604":74313,"_31083":74270,"_21524":125552,"_5":14790,"_28264":125431,"_3060":125553},[],"`ST`: estado o provincia.",{"_3604":74314,"_31083":74270,"_21524":125555,"_5":14790,"_28264":125431,"_3060":125556},[],"`L`: localidad.",{"_3604":74315,"_31083":74270,"_21524":125558,"_5":14790,"_28264":125431,"_3060":125559},[],"`O`: organización.",{"_3604":74316,"_31083":74270,"_21524":125561,"_5":14790,"_28264":125431,"_3060":125562},[],"`OU`: unidad organizativa.",{"_3604":74317,"_31083":74270,"_21524":125564,"_5":14790,"_28264":125431,"_3060":125565},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3604":74318,"_31083":74270,"_21524":125567,"_5":14790,"_28264":125435,"_3060":125568},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3604":74319,"_31083":74270,"_21524":125570,"_5":14790,"_28264":125435,"_3060":125571},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3604":74320,"_31083":74270,"_21524":125573,"_5":14790,"_28264":125439,"_3060":125574},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3604":74321,"_31083":74270,"_21524":125576,"_5":14790,"_28264":125439,"_3060":125577},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3604":74322,"_31083":74270,"_21524":125579,"_5":14790,"_28264":125443,"_3060":125580},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3604":74323,"_31083":74270,"_21524":125582,"_5":14790,"_28264":125443,"_3060":125583},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3604":74324,"_31083":74270,"_21524":125585,"_5":14790,"_28264":125447,"_3060":125586},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3604":74325,"_31083":74270,"_21524":125588,"_5":14790,"_28264":125447,"_3060":125589},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3604":74326,"_31083":74270,"_21524":125591,"_5":14790,"_28264":125447,"_3060":125592},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3604":74327,"_31083":74270,"_21524":125594,"_5":14790,"_28264":125451,"_3060":125595},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3604":74328,"_31083":74270,"_21524":125597,"_5":14790,"_28264":125455,"_3060":125598},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3604":74329,"_31083":74270,"_21524":125600,"_5":14790,"_28264":125455,"_3060":125601},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3604":74330,"_31083":74270,"_21524":125603,"_5":14790,"_28264":125459,"_3060":125604},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3604":74331,"_31083":74270,"_21524":125606,"_5":14790,"_28264":125463,"_3060":125607},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3604":74332,"_31083":74270,"_21524":125609,"_5":14790,"_28264":125463,"_3060":125610},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3604":74333,"_31083":74270,"_21524":125612,"_5":14790,"_28264":125463,"_3060":125613},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3604":74334,"_31083":74270,"_21524":125615,"_5":14790,"_28264":125467,"_3060":125616},[],"Abre una CA desde el inventario para consultar:",{"_3604":74335,"_31083":74270,"_21524":125618,"_5":14790,"_28264":125467,"_3060":125619},[],"Estado y periodo de validez.",{"_3604":74336,"_31083":74270,"_21524":125621,"_5":14790,"_28264":125467,"_3060":125622},[],"Certificado y cadena en formato PEM.",{"_3604":74337,"_31083":74270,"_21524":125624,"_5":14790,"_28264":125467,"_3060":125625},[],"Número de certificados activos, expirados y revocados.",{"_3604":74338,"_31083":74270,"_21524":125627,"_5":14790,"_28264":125467,"_3060":125628},[],"Certificados emitidos en **Issued Certificates**.",{"_3604":74339,"_31083":74270,"_21524":125630,"_5":14790,"_28264":125467,"_3060":125631},[],"CRL vinculada a la autoridad.",{"_3604":74340,"_31083":74270,"_21524":125633,"_5":14790,"_28264":125467,"_3060":125634},[],"Metadatos y motor criptográfico asociado.",{"_3604":74341,"_31083":74270,"_21524":125636,"_5":14790,"_28264":125467,"_3060":125637},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3604":74342,"_31083":74270,"_21524":125639,"_5":14790,"_28264":125471,"_3060":125640},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3604":74343,"_31083":74270,"_21524":125642,"_5":14790,"_28264":125471,"_3060":125643},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3604":74344,"_31083":74270,"_21524":125645,"_5":14790,"_28264":125471,"_3060":125646},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3604":74345,"_31083":74270,"_21524":125648,"_5":14790,"_28264":125471,"_3060":125649},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3604":74346,"_31083":74270,"_21524":125651,"_5":14790,"_28264":125471,"_3060":125652},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3604":74347,"_31083":74270,"_21524":125654,"_5":14790,"_28264":125471,"_3060":125655},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3604":74348,"_31083":74270,"_21524":125657,"_5":14790,"_28264":125475,"_3060":125658},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3604":74349,"_31083":74270,"_21524":125660,"_5":14790,"_28264":125479,"_3060":125661},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3604":74350,"_31083":74270,"_21524":125663,"_5":14790,"_28264":125483,"_3060":125664},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3604":74351,"_31083":74270,"_21524":125666,"_5":14790,"_28264":125487,"_3060":125667},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3604":74352,"_31083":74270,"_21524":125669,"_5":14790,"_28264":125491,"_3060":125670},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3604":74353,"_31083":74270,"_21524":125672,"_5":14790,"_28264":125495,"_3060":125673},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3604":74354,"_31083":74270,"_21524":125675,"_5":14790,"_28264":125495,"_3060":125676},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3604":74355,"_31083":74270,"_21524":125678,"_5":14790,"_28264":125495,"_3060":125679},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3604":74356,"_31083":74270,"_21524":125681,"_5":14790,"_28264":125495,"_3060":125682},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3604":74357,"_31083":74357,"_5":15155,"_3060":125684,"_31421":125685,"_21524":125686,"_28264":74357},"Perfiles de certificado",[50730,121224,56408,125238],[],{"_3604":74358,"_31083":74357,"_21524":125688,"_5":14790,"_28264":74357,"_3060":125689},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3604":74359,"_31083":74357,"_5":31418,"_21524":125691,"_28264":125692,"_3060":125693},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3604":74360,"_31083":74357,"_5":31418,"_21524":125695,"_28264":125696,"_3060":125697},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3604":74361,"_31083":74357,"_5":31418,"_21524":125699,"_28264":125700,"_3060":125701},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3604":74362,"_31083":74357,"_5":31418,"_21524":125703,"_28264":125704,"_3060":125705},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3604":74363,"_31083":74357,"_5":31418,"_21524":125707,"_28264":125708,"_3060":125709},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3604":74364,"_31083":74357,"_5":31418,"_21524":125711,"_28264":125712,"_3060":125713},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3604":74365,"_31083":74357,"_5":31418,"_21524":125715,"_28264":125716,"_3060":125717},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3604":74366,"_31083":74357,"_5":31418,"_21524":125719,"_28264":125720,"_3060":125721},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3604":74367,"_31083":74357,"_5":31418,"_21524":125723,"_28264":125724,"_3060":125725},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3604":74368,"_31083":74357,"_5":31418,"_21524":125727,"_28264":125728,"_3060":125729},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3604":74369,"_31083":74357,"_5":31418,"_21524":125731,"_28264":125732,"_3060":125733},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3604":74370,"_31083":74357,"_5":31418,"_21524":125735,"_28264":125736,"_3060":125737},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3604":74371,"_31083":74357,"_5":31418,"_21524":125739,"_28264":125740,"_3060":125741},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3604":74372,"_31083":74357,"_5":31418,"_21524":125743,"_28264":125744,"_3060":125745},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3604":74373,"_31083":74357,"_5":31418,"_21524":125747,"_28264":125748,"_3060":125749},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3604":74374,"_31083":74357,"_5":31418,"_21524":125751,"_28264":125752,"_3060":125753},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3604":74375,"_31083":74357,"_21524":125755,"_5":14790,"_28264":74357,"_3060":125756},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3604":74376,"_31083":74357,"_21524":125758,"_5":14790,"_28264":74357,"_3060":125759},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3604":74377,"_31083":74357,"_21524":125761,"_5":14790,"_28264":125696,"_3060":125762},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3604":74378,"_31083":74357,"_21524":125764,"_5":14790,"_28264":125696,"_3060":125765},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3604":74379,"_31083":74357,"_21524":125767,"_5":14790,"_28264":125700,"_3060":125768},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3604":74380,"_31083":74357,"_21524":125770,"_5":14790,"_28264":125704,"_3060":125771},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3604":74381,"_31083":74357,"_21524":125773,"_5":14790,"_28264":125704,"_3060":125774},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3604":74382,"_31083":74357,"_21524":125776,"_5":14790,"_28264":125704,"_3060":125777},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3604":74383,"_31083":74357,"_21524":125779,"_5":14790,"_28264":125708,"_3060":125780},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3604":74384,"_31083":74357,"_21524":125782,"_5":14790,"_28264":125712,"_3060":125783},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3604":74385,"_31083":74357,"_21524":125785,"_5":14790,"_28264":125712,"_3060":125786},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3604":74386,"_31083":74357,"_21524":125788,"_5":14790,"_28264":125716,"_3060":125789},[],"La aplicación criptográfica puede:",{"_3604":74387,"_31083":74357,"_21524":125791,"_5":14790,"_28264":125716,"_3060":125792},[],"permitir o bloquear claves RSA;",{"_3604":74388,"_31083":74357,"_21524":125794,"_5":14790,"_28264":125716,"_3060":125795},[],"limitar los tamaños RSA admitidos;",{"_3604":74389,"_31083":74357,"_21524":125797,"_5":14790,"_28264":125716,"_3060":125798},[],"permitir o bloquear claves ECDSA;",{"_3604":74390,"_31083":74357,"_21524":125800,"_5":14790,"_28264":125716,"_3060":125801},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3604":74391,"_31083":74357,"_21524":125803,"_5":14790,"_28264":125716,"_3060":125804},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3604":74392,"_31083":74357,"_21524":125806,"_5":14790,"_28264":125720,"_3060":125807},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3604":74393,"_31083":74357,"_21524":125809,"_5":14790,"_28264":125720,"_3060":120984},[],{"_3604":74394,"_31083":74357,"_21524":125811,"_5":14790,"_28264":125720,"_3060":125812},[],"Primera opción",{"_3604":74395,"_31083":74357,"_21524":125814,"_5":14790,"_28264":125720,"_3060":125815},[],"Segunda opción",{"_3604":74396,"_31083":74357,"_21524":125817,"_5":14790,"_28264":125720,"_3060":125818},[],"Si no hay ninguna",{"_3604":74397,"_31083":74357,"_21524":125820,"_5":14790,"_28264":125720,"_3060":125821},[],"Firma directa con una CA",{"_3604":74398,"_31083":74357,"_21524":125823,"_5":14790,"_28264":125720,"_3060":125824},[],"`issuance_profile` incluido en la solicitud",{"_3604":74399,"_31083":74357,"_21524":125826,"_5":14790,"_28264":125720,"_3060":125827},[],"`issuance_profile_id` de la solicitud",{"_3604":74400,"_31083":74357,"_21524":125829,"_5":14790,"_28264":125720,"_3060":125830},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3604":74401,"_31083":74357,"_21524":125832,"_5":14790,"_28264":125720,"_3060":125833},[],"Emisión mediante DMS",{"_3604":74402,"_31083":74357,"_21524":125835,"_5":14790,"_28264":125720,"_3060":57007},[],{"_3604":74403,"_31083":74357,"_21524":125837,"_5":14790,"_28264":125720,"_3060":125838},[],"`settings.issuance_profile` incluido en el DMS",{"_3604":74404,"_31083":74357,"_21524":125840,"_5":14790,"_28264":125720,"_3060":125841},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3604":74405,"_31083":74357,"_21524":125843,"_5":14790,"_28264":125720,"_3060":125844},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3604":74406,"_31083":74357,"_21524":125846,"_5":14790,"_28264":125720,"_3060":125847},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3604":74407,"_31083":74357,"_21524":125849,"_5":14790,"_28264":125728,"_3060":125850},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3604":74408,"_31083":74357,"_21524":125852,"_5":14790,"_28264":125732,"_3060":125853},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3604":74409,"_31083":74357,"_21524":125855,"_5":14790,"_28264":125736,"_3060":125856},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3604":74410,"_31083":74357,"_21524":125858,"_5":14790,"_28264":125740,"_3060":125859},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3604":74411,"_31083":74357,"_21524":125861,"_5":14790,"_28264":125744,"_3060":125862},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3604":74412,"_31083":74357,"_21524":125864,"_5":14790,"_28264":125744,"_3060":125865},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3604":74413,"_31083":74357,"_21524":125867,"_5":14790,"_28264":125748,"_3060":125868},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3604":74414,"_31083":74357,"_21524":125870,"_5":14790,"_28264":125748,"_3060":125871},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3604":74415,"_31083":74357,"_21524":125873,"_5":14790,"_28264":125748,"_3060":125874},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3604":74416,"_31083":74357,"_21524":125876,"_5":14790,"_28264":125748,"_3060":125877},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3604":74417,"_31083":74357,"_21524":125879,"_5":14790,"_28264":125752,"_3060":125880},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3604":74418,"_31083":74357,"_21524":125882,"_5":14790,"_28264":125752,"_3060":125883},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3604":74419,"_31083":74419,"_5":15155,"_3060":125885,"_31421":125886,"_21524":125888,"_28264":74419},"Validación de certificados",[50730,121224,56408,125887],"Validación",[],{"_3604":74420,"_31083":74419,"_21524":125890,"_5":14790,"_28264":74419,"_3060":125891},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3604":74421,"_31083":74419,"_5":31418,"_21524":125893,"_28264":125894,"_3060":125895},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3604":74422,"_31083":74419,"_5":31418,"_21524":125897,"_28264":125898,"_3060":125899},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3604":74423,"_31083":74419,"_5":31418,"_21524":125901,"_28264":125902,"_3060":125903},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3604":74424,"_31083":74419,"_21524":125905,"_5":14790,"_28264":74419,"_3060":125906},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3604":74425,"_31083":74419,"_21524":125908,"_5":14790,"_28264":125894,"_3060":125909},[],"Verifica estos criterios juntos:",{"_3604":74426,"_31083":74419,"_21524":125911,"_5":14790,"_28264":125894,"_3060":124867},[],{"_3604":74427,"_31083":74419,"_21524":125913,"_5":14790,"_28264":125894,"_3060":125914},[],"Resultado necesario",{"_3604":74428,"_31083":74419,"_21524":125916,"_5":14790,"_28264":125894,"_3060":125917},[],"Cadena y firma",{"_3604":74429,"_31083":74419,"_21524":125919,"_5":14790,"_28264":125894,"_3060":125920},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3604":74430,"_31083":74419,"_21524":125922,"_5":14790,"_28264":125894,"_3060":125923},[],"Fechas",{"_3604":74431,"_31083":74419,"_21524":125925,"_5":14790,"_28264":125894,"_3060":125926},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3604":74432,"_31083":74419,"_21524":125928,"_5":14790,"_28264":125894,"_3060":120894},[],{"_3604":74433,"_31083":74419,"_21524":125930,"_5":14790,"_28264":125894,"_3060":125931},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3604":74434,"_31083":74419,"_21524":125933,"_5":14790,"_28264":125894,"_3060":125934},[],"Uso",{"_3604":74435,"_31083":74419,"_21524":125936,"_5":14790,"_28264":125894,"_3060":125937},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3604":74436,"_31083":74419,"_21524":125939,"_5":14790,"_28264":125894,"_3060":125940},[],"Revocación",{"_3604":74437,"_31083":74419,"_21524":125942,"_5":14790,"_28264":125894,"_3060":125943},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3604":74438,"_31083":74419,"_21524":125945,"_5":14790,"_28264":125894,"_3060":125946},[],"Autorización",{"_3604":74439,"_31083":74419,"_21524":125948,"_5":14790,"_28264":125894,"_3060":125949},[],"La aplicación permite la acción a esa identidad.",{"_3604":74440,"_31083":74419,"_21524":125951,"_5":14790,"_28264":125894,"_3060":125952},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3604":74441,"_31083":74419,"_21524":125954,"_5":14790,"_28264":125898,"_3060":125955},[],"Mecanismo",{"_3604":74442,"_31083":74419,"_21524":125957,"_5":14790,"_28264":125898,"_3060":125958},[],"Cuándo utilizarlo",{"_3604":74443,"_31083":74419,"_21524":125960,"_5":14790,"_28264":125898,"_3060":125961},[],"Qué debes mantener",{"_3604":74444,"_31083":74419,"_21524":125963,"_5":14790,"_28264":125898,"_3060":57135},[],{"_3604":74445,"_31083":74419,"_21524":125965,"_5":14790,"_28264":125898,"_3060":125966},[],"Consulta del estado de un certificado concreto.",{"_3604":74446,"_31083":74419,"_21524":125968,"_5":14790,"_28264":125898,"_3060":125969},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3604":74447,"_31083":74419,"_21524":125971,"_5":14790,"_28264":125898,"_3060":57144},[],{"_3604":74448,"_31083":74419,"_21524":125973,"_5":14790,"_28264":125898,"_3060":125974},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3604":74449,"_31083":74419,"_21524":125976,"_5":14790,"_28264":125898,"_3060":125977},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3604":74450,"_31083":74419,"_21524":125979,"_5":14790,"_28264":125898,"_3060":125980},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3604":74451,"_31083":74419,"_21524":125982,"_5":14790,"_28264":125898,"_3060":125983},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3604":74452,"_31083":74419,"_21524":125985,"_5":14790,"_28264":125902,"_3060":125986},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3604":74453,"_31083":74419,"_21524":125988,"_5":14790,"_28264":125902,"_3060":125989},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3604":74454,"_31083":74419,"_21524":125991,"_5":14790,"_28264":125902,"_3060":125992},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3604":74455,"_31083":74419,"_21524":125994,"_5":14790,"_28264":125902,"_3060":125995},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3604":74456,"_31083":74419,"_21524":125997,"_5":14790,"_28264":125902,"_3060":125998},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3604":74457,"_31083":74419,"_21524":126000,"_5":14790,"_28264":125902,"_3060":126001},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3604":74458,"_31083":74419,"_21524":126003,"_5":14790,"_28264":125902,"_3060":126004},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3604":74459,"_31083":74419,"_21524":126006,"_5":14790,"_28264":125902,"_3060":126007},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":74460,"_31083":74419,"_21524":126009,"_5":14790,"_28264":125902,"_3060":126010},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3604":74461,"_31083":74461,"_5":15155,"_3060":126012,"_31421":126013,"_21524":126014,"_28264":74461},"Certificados",[50730,121224,56408,125238],[],{"_3604":74462,"_31083":74461,"_21524":126016,"_5":14790,"_28264":74461,"_3060":126017},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3604":74463,"_31083":74461,"_5":31418,"_21524":126019,"_28264":126020,"_3060":126021},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3604":74464,"_31083":74461,"_5":31418,"_21524":126023,"_28264":126024,"_3060":126025},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3604":74465,"_31083":74461,"_5":31418,"_21524":126027,"_28264":126028,"_3060":126029},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3604":74466,"_31083":74461,"_5":31418,"_21524":126031,"_28264":126032,"_3060":126033},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3604":74467,"_31083":74461,"_5":31418,"_21524":126035,"_28264":126036,"_3060":126037},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3604":74468,"_31083":74461,"_5":31418,"_21524":126039,"_28264":126040,"_3060":126041},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3604":74469,"_31083":74461,"_5":31418,"_21524":126043,"_28264":126044,"_3060":126045},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3604":74470,"_31083":74461,"_5":31418,"_21524":126047,"_28264":126048,"_3060":126049},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3604":74471,"_31083":74461,"_5":31418,"_21524":126051,"_28264":126052,"_3060":126053},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3604":74472,"_31083":74461,"_21524":126055,"_5":14790,"_28264":74461,"_3060":126056},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3604":74473,"_31083":74461,"_21524":126058,"_5":14790,"_28264":126020,"_3060":126059},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3604":74474,"_31083":74461,"_21524":126061,"_5":14790,"_28264":126020,"_3060":126062},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3604":74475,"_31083":74461,"_21524":126064,"_5":14790,"_28264":126020,"_3060":126065},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3604":74476,"_31083":74461,"_21524":126067,"_5":14790,"_28264":126020,"_3060":126068},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3604":74477,"_31083":74461,"_21524":126070,"_5":14790,"_28264":126020,"_3060":126071},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3604":74478,"_31083":74461,"_21524":126073,"_5":14790,"_28264":126020,"_3060":126074},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3604":74479,"_31083":74461,"_21524":126076,"_5":14790,"_28264":126020,"_3060":126077},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3604":74480,"_31083":74461,"_21524":126079,"_5":14790,"_28264":126024,"_3060":126080},[],"Descarga el PEM e inspecciónalo:",{"_3604":74481,"_31083":74461,"_21524":126082,"_5":14790,"_28264":126024,"_3060":126083},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3604":74482,"_31083":74461,"_21524":126085,"_5":14790,"_28264":126028,"_3060":126086},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3604":74483,"_31083":74461,"_21524":126088,"_5":14790,"_28264":126028,"_3060":126089},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3604":74484,"_31083":74461,"_21524":126091,"_5":14790,"_28264":126028,"_3060":126092},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3604":74485,"_31083":74461,"_21524":126094,"_5":14790,"_28264":126028,"_3060":126095},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3604":74486,"_31083":74461,"_21524":126097,"_5":14790,"_28264":126028,"_3060":126098},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3604":74487,"_31083":74461,"_21524":126100,"_5":14790,"_28264":126028,"_3060":126101},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3604":74488,"_31083":74461,"_21524":126103,"_5":14790,"_28264":126028,"_3060":126104},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3604":74489,"_31083":74461,"_21524":126106,"_5":14790,"_28264":126032,"_3060":126107},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3604":74490,"_31083":74461,"_21524":126109,"_5":14790,"_28264":126036,"_3060":126110},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3604":74491,"_31083":74461,"_21524":126112,"_5":14790,"_28264":126040,"_3060":126113},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3604":74492,"_31083":74461,"_21524":126115,"_5":14790,"_28264":126044,"_3060":126116},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3604":74493,"_31083":74461,"_21524":126118,"_5":14790,"_28264":126044,"_3060":126119},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3604":74494,"_31083":74461,"_21524":126121,"_5":14790,"_28264":126044,"_3060":126122},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3604":74495,"_31083":74461,"_21524":126124,"_5":14790,"_28264":126048,"_3060":126125},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3604":74496,"_31083":74461,"_21524":126127,"_5":14790,"_28264":126048,"_3060":126128},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3604":74497,"_31083":74461,"_21524":126130,"_5":14790,"_28264":126048,"_3060":126131},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3604":74498,"_31083":74461,"_21524":126133,"_5":14790,"_28264":126052,"_3060":126134},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":74499,"_31083":74461,"_21524":126136,"_5":14790,"_28264":126052,"_3060":126137},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3604":74500,"_31083":74500,"_5":15155,"_3060":126139,"_31421":126140,"_21524":126142,"_28264":74500},"Ciclo de vida de un certificado",[50730,121224,56408,126141],"Conceptos",[],{"_3604":74501,"_31083":74500,"_21524":126144,"_5":14790,"_28264":74500,"_3060":126145},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3604":74502,"_31083":74500,"_5":31418,"_21524":126147,"_28264":126148,"_3060":126149},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3604":74503,"_31083":74500,"_5":31418,"_21524":126151,"_28264":126152,"_3060":126153},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3604":74504,"_31083":74500,"_5":31418,"_21524":126155,"_28264":126156,"_3060":126157},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3604":74505,"_31083":74500,"_5":31418,"_21524":126159,"_28264":126160,"_3060":126161},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3604":74506,"_31083":74500,"_5":31418,"_21524":126163,"_28264":126164,"_3060":126165},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3604":74507,"_31083":74500,"_5":31418,"_21524":126167,"_28264":126168,"_3060":126169},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3604":74508,"_31083":74500,"_5":31418,"_21524":126171,"_28264":126172,"_3060":123861},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3604":74509,"_31083":74500,"_5":31418,"_21524":126174,"_28264":126175,"_3060":126176},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3604":74510,"_31083":74500,"_5":31418,"_21524":126178,"_28264":126179,"_3060":126180},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3604":74511,"_31083":74500,"_5":31418,"_21524":126182,"_28264":126183,"_3060":126184},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3604":74512,"_31083":74500,"_21524":126186,"_5":14790,"_28264":74500,"_3060":126187},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3604":74513,"_31083":74500,"_21524":126189,"_5":14790,"_28264":126152,"_3060":126190},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3604":74514,"_31083":74500,"_21524":126192,"_5":14790,"_28264":126156,"_3060":126193},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3604":74515,"_31083":74500,"_21524":126195,"_5":14790,"_28264":126160,"_3060":126196},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3604":74516,"_31083":74500,"_21524":126198,"_5":14790,"_28264":126164,"_3060":126199},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3604":74517,"_31083":74500,"_21524":126201,"_5":14790,"_28264":126168,"_3060":126202},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3604":74518,"_31083":74500,"_21524":126204,"_5":14790,"_28264":126172,"_3060":126205},[],"Lamassu persiste cuatro estados X.509:",{"_3604":74519,"_31083":74500,"_21524":126207,"_5":14790,"_28264":126172,"_3060":126208},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3604":74520,"_31083":74500,"_21524":126210,"_5":14790,"_28264":126172,"_3060":126211},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3604":74521,"_31083":74500,"_21524":126213,"_5":14790,"_28264":126172,"_3060":126214},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3604":74522,"_31083":74500,"_21524":126216,"_5":14790,"_28264":126172,"_3060":126217},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3604":74523,"_31083":74500,"_21524":126219,"_5":14790,"_28264":126172,"_3060":126220},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3604":74524,"_31083":74500,"_21524":126222,"_5":14790,"_28264":126175,"_3060":126223},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3604":74525,"_31083":74500,"_21524":126225,"_5":14790,"_28264":126175,"_3060":126226},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3604":74526,"_31083":74500,"_21524":126228,"_5":14790,"_28264":126175,"_3060":126229},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3604":74527,"_31083":74500,"_21524":126231,"_5":14790,"_28264":126179,"_3060":126232},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3604":74528,"_31083":74500,"_21524":126234,"_5":14790,"_28264":126179,"_3060":126235},[],"Antes de confirmar:",{"_3604":74529,"_31083":74500,"_21524":126237,"_5":14790,"_28264":126179,"_3060":126238},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3604":74530,"_31083":74500,"_21524":126240,"_5":14790,"_28264":126179,"_3060":126241},[],"Distribuye la nueva cadena de confianza.",{"_3604":74531,"_31083":74500,"_21524":126243,"_5":14790,"_28264":126179,"_3060":126244},[],"Reemite las identidades necesarias.",{"_3604":74532,"_31083":74500,"_21524":126246,"_5":14790,"_28264":126179,"_3060":126247},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3604":74533,"_31083":74500,"_21524":126249,"_5":14790,"_28264":126179,"_3060":126250},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3604":74534,"_31083":74500,"_21524":126252,"_5":14790,"_28264":126179,"_3060":126253},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3604":74535,"_31083":74500,"_21524":126255,"_5":14790,"_28264":126183,"_3060":126256},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3604":74536,"_31083":74500,"_21524":126258,"_5":14790,"_28264":126183,"_3060":126259},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3604":74537,"_31083":74500,"_21524":126261,"_5":14790,"_28264":126183,"_3060":126262},[],"Cambios de estado y razones de revocación.",{"_3604":74538,"_31083":74500,"_21524":126264,"_5":14790,"_28264":126183,"_3060":126265},[],"Publicación y vigencia de OCSP y CRLs.",{"_3604":74539,"_31083":74500,"_21524":126267,"_5":14790,"_28264":126183,"_3060":126268},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3604":74540,"_31083":74500,"_21524":126270,"_5":14790,"_28264":126183,"_3060":126271},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3604":74541,"_31083":74541,"_5":15155,"_3060":126273,"_31421":126274,"_21524":126275,"_28264":74541},"Modelo de confianza",[50730,121224,56408,126141],[],{"_3604":74542,"_31083":74541,"_21524":126277,"_5":14790,"_28264":74541,"_3060":126278},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3604":74543,"_31083":74541,"_5":31418,"_21524":126280,"_28264":126281,"_3060":126282},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3604":74544,"_31083":74541,"_5":31418,"_21524":126284,"_28264":126285,"_3060":126286},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3604":74545,"_31083":74541,"_5":31418,"_21524":126288,"_28264":126289,"_3060":126290},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3604":74546,"_31083":74541,"_5":31418,"_21524":126292,"_28264":126293,"_3060":126294},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3604":74547,"_31083":74541,"_5":31418,"_21524":126296,"_28264":126297,"_3060":126298},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3604":74548,"_31083":74541,"_5":31418,"_21524":126300,"_28264":126301,"_3060":126302},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3604":74549,"_31083":74541,"_5":31418,"_21524":126304,"_28264":126305,"_3060":126306},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3604":74550,"_31083":74541,"_5":31418,"_21524":126308,"_28264":126309,"_3060":126310},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3604":74551,"_31083":74541,"_5":31418,"_21524":126312,"_28264":126313,"_3060":126314},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3604":74552,"_31083":74541,"_5":31418,"_21524":126316,"_28264":126317,"_3060":126318},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3604":74553,"_31083":74541,"_21524":126320,"_5":14790,"_28264":74541,"_3060":126321},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3604":74554,"_31083":74541,"_21524":126323,"_5":14790,"_28264":126285,"_3060":126324},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3604":74555,"_31083":74541,"_21524":126326,"_5":14790,"_28264":126289,"_3060":126327},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3604":74556,"_31083":74541,"_21524":126329,"_5":14790,"_28264":126293,"_3060":126330},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3604":74557,"_31083":74541,"_21524":126332,"_5":14790,"_28264":126297,"_3060":126333},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3604":74558,"_31083":74541,"_21524":126335,"_5":14790,"_28264":126301,"_3060":126336},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3604":74559,"_31083":74541,"_21524":126338,"_5":14790,"_28264":126301,"_3060":126339},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3604":74560,"_31083":74541,"_21524":126341,"_5":14790,"_28264":126301,"_3060":126342},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3604":74561,"_31083":74541,"_21524":126344,"_5":14790,"_28264":126301,"_3060":126345},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3604":74562,"_31083":74541,"_21524":126347,"_5":14790,"_28264":126301,"_3060":126348},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3604":74563,"_31083":74541,"_21524":126350,"_5":14790,"_28264":126301,"_3060":126351},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3604":74564,"_31083":74541,"_21524":126353,"_5":14790,"_28264":126305,"_3060":126354},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3604":74565,"_31083":74541,"_21524":126356,"_5":14790,"_28264":126305,"_3060":126357},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3604":74566,"_31083":74541,"_21524":126359,"_5":14790,"_28264":126305,"_3060":126360},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3604":74567,"_31083":74541,"_21524":126362,"_5":14790,"_28264":126305,"_3060":126363},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3604":74568,"_31083":74541,"_21524":126365,"_5":14790,"_28264":126305,"_3060":126366},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3604":74569,"_31083":74541,"_21524":126368,"_5":14790,"_28264":126309,"_3060":126369},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3604":74570,"_31083":74541,"_21524":126371,"_5":14790,"_28264":126309,"_3060":126372},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3604":74571,"_31083":74541,"_21524":126374,"_5":14790,"_28264":126309,"_3060":126375},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3604":74572,"_31083":74541,"_21524":126377,"_5":14790,"_28264":126309,"_3060":126378},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3604":74573,"_31083":74541,"_21524":126380,"_5":14790,"_28264":126309,"_3060":126381},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3604":74574,"_31083":74541,"_21524":126383,"_5":14790,"_28264":126309,"_3060":126384},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3604":74575,"_31083":74541,"_21524":126386,"_5":14790,"_28264":126309,"_3060":126387},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3604":74576,"_31083":74541,"_21524":126389,"_5":14790,"_28264":126313,"_3060":126390},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3604":74577,"_31083":74541,"_21524":126392,"_5":14790,"_28264":126317,"_3060":126393},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3604":74578,"_31083":74541,"_21524":126395,"_5":14790,"_28264":126317,"_3060":126396},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3604":74579,"_31083":74541,"_21524":126398,"_5":14790,"_28264":126317,"_3060":126399},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3604":74580,"_31083":74541,"_21524":126401,"_5":14790,"_28264":126317,"_3060":126402},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3604":74581,"_31083":74541,"_21524":126404,"_5":14790,"_28264":126317,"_3060":126405},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3604":74582,"_31083":74541,"_21524":126407,"_5":14790,"_28264":126317,"_3060":126408},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3604":74583,"_31083":74541,"_21524":126410,"_5":14790,"_28264":126317,"_3060":126411},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3604":74584,"_31083":74584,"_5":15155,"_3060":126413,"_31421":126414,"_21524":126415,"_28264":74584},"Listas de revocación (CRL)",[50730,121224,56408,125887],[],{"_3604":74585,"_31083":74584,"_21524":126417,"_5":14790,"_28264":74584,"_3060":126418},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3604":74586,"_31083":74584,"_5":31418,"_21524":126420,"_28264":126421,"_3060":126422},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3604":74587,"_31083":74584,"_5":31418,"_21524":126424,"_28264":126425,"_3060":126426},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3604":74588,"_31083":74584,"_5":31418,"_21524":126428,"_28264":126429,"_3060":126430},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3604":74589,"_31083":74584,"_5":31418,"_21524":126432,"_28264":126433,"_3060":126434},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3604":74590,"_31083":74584,"_5":31418,"_21524":126436,"_28264":126437,"_3060":126438},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3604":74591,"_31083":74584,"_5":31418,"_21524":126440,"_28264":126441,"_3060":126442},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3604":74592,"_31083":74584,"_5":31418,"_21524":126444,"_28264":126445,"_3060":126446},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3604":74593,"_31083":74584,"_5":31418,"_21524":126448,"_28264":126449,"_3060":126450},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3604":74594,"_31083":74584,"_21524":126452,"_5":14790,"_28264":74584,"_3060":126453},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3604":74595,"_31083":74584,"_21524":126455,"_5":14790,"_28264":126421,"_3060":126456},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3604":74596,"_31083":74584,"_21524":126458,"_5":14790,"_28264":126421,"_3060":126459},[],"Campo",{"_3604":74597,"_31083":74584,"_21524":126461,"_5":14790,"_28264":126421,"_3060":122901},[],{"_3604":74598,"_31083":74584,"_21524":126463,"_5":14790,"_28264":126421,"_3060":52362},[],{"_3604":74599,"_31083":74584,"_21524":126465,"_5":14790,"_28264":126421,"_3060":126466},[],"ID de la CA a la que pertenecen los ajustes.",{"_3604":74600,"_31083":74584,"_21524":126468,"_5":14790,"_28264":126421,"_3060":57643},[],{"_3604":74601,"_31083":74584,"_21524":126470,"_5":14790,"_28264":126421,"_3060":126471},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3604":74602,"_31083":74584,"_21524":126473,"_5":14790,"_28264":126421,"_3060":57649},[],{"_3604":74603,"_31083":74584,"_21524":126475,"_5":14790,"_28264":126421,"_3060":126476},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3604":74604,"_31083":74584,"_21524":126478,"_5":14790,"_28264":126421,"_3060":57655},[],{"_3604":74605,"_31083":74584,"_21524":126480,"_5":14790,"_28264":126421,"_3060":126481},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3604":74606,"_31083":74584,"_21524":126483,"_5":14790,"_28264":126421,"_3060":126484},[],"Campo de `crl_options`",{"_3604":74607,"_31083":74584,"_21524":126486,"_5":14790,"_28264":126421,"_3060":122901},[],{"_3604":74608,"_31083":74584,"_21524":126488,"_5":14790,"_28264":126421,"_3060":126489},[],"Valor inicial",{"_3604":74609,"_31083":74584,"_21524":126491,"_5":14790,"_28264":126421,"_3060":57669},[],{"_3604":74610,"_31083":74584,"_21524":126493,"_5":14790,"_28264":126421,"_3060":126494},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3604":74611,"_31083":74584,"_21524":126496,"_5":14790,"_28264":126421,"_3060":126497},[],"7 días.",{"_3604":74612,"_31083":74584,"_21524":126499,"_5":14790,"_28264":126421,"_3060":57678},[],{"_3604":74613,"_31083":74584,"_21524":126501,"_5":14790,"_28264":126421,"_3060":126502},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3604":74614,"_31083":74584,"_21524":126504,"_5":14790,"_28264":126421,"_3060":126505},[],"6 días y 23 horas.",{"_3604":74615,"_31083":74584,"_21524":126507,"_5":14790,"_28264":126421,"_3060":57687},[],{"_3604":74616,"_31083":74584,"_21524":126509,"_5":14790,"_28264":126421,"_3060":126510},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3604":74617,"_31083":74584,"_21524":126512,"_5":14790,"_28264":126421,"_3060":57693},[],{"_3604":74618,"_31083":74584,"_21524":126514,"_5":14790,"_28264":126421,"_3060":57696},[],{"_3604":74619,"_31083":74584,"_21524":126516,"_5":14790,"_28264":126421,"_3060":126517},[],"Número de serie del certificado existente que firma la CRL.",{"_3604":74620,"_31083":74584,"_21524":126519,"_5":14790,"_28264":126421,"_3060":126520},[],"Número de serie del certificado actual de la CA.",{"_3604":74621,"_31083":74584,"_21524":126522,"_5":14790,"_28264":126421,"_3060":126523},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3604":74622,"_31083":74584,"_21524":126525,"_5":14790,"_28264":126421,"_3060":126526},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3604":74623,"_31083":74584,"_21524":126528,"_5":14790,"_28264":126421,"_3060":126529},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3604":74624,"_31083":74584,"_21524":126531,"_5":14790,"_28264":126421,"_3060":126532},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3604":74625,"_31083":74584,"_21524":126534,"_5":14790,"_28264":126421,"_3060":126535},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3604":74626,"_31083":74584,"_21524":126537,"_5":14790,"_28264":126421,"_3060":126538},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3604":74627,"_31083":74584,"_21524":126540,"_5":14790,"_28264":126421,"_3060":126541},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3604":74628,"_31083":74584,"_21524":126543,"_5":14790,"_28264":126421,"_3060":126544},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3604":74629,"_31083":74584,"_21524":126546,"_5":14790,"_28264":126421,"_3060":126547},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3604":74630,"_31083":74584,"_21524":126549,"_5":14790,"_28264":126421,"_3060":126550},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3604":74631,"_31083":74584,"_21524":126552,"_5":14790,"_28264":126421,"_3060":126553},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3604":74632,"_31083":74584,"_21524":126555,"_5":14790,"_28264":126425,"_3060":126556},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3604":74633,"_31083":74584,"_21524":126558,"_5":14790,"_28264":126425,"_3060":126559},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3604":74634,"_31083":74584,"_21524":126561,"_5":14790,"_28264":126425,"_3060":126562},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3604":74635,"_31083":74584,"_21524":126564,"_5":14790,"_28264":126425,"_3060":126565},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3604":74636,"_31083":74584,"_21524":126567,"_5":14790,"_28264":126429,"_3060":126568},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3604":74637,"_31083":74584,"_21524":126570,"_5":14790,"_28264":126429,"_3060":126571},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3604":74638,"_31083":74584,"_21524":126573,"_5":14790,"_28264":126429,"_3060":126574},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3604":74639,"_31083":74584,"_21524":126576,"_5":14790,"_28264":126429,"_3060":126577},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3604":74640,"_31083":74584,"_21524":126579,"_5":14790,"_28264":126429,"_3060":126580},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3604":74641,"_31083":74584,"_21524":126582,"_5":14790,"_28264":126429,"_3060":126583},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3604":74642,"_31083":74584,"_21524":126585,"_5":14790,"_28264":126429,"_3060":126586},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3604":74643,"_31083":74584,"_21524":126588,"_5":14790,"_28264":126429,"_3060":126589},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3604":74644,"_31083":74584,"_21524":126591,"_5":14790,"_28264":126429,"_3060":126592},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3604":74645,"_31083":74584,"_21524":126594,"_5":14790,"_28264":126433,"_3060":126595},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3604":74646,"_31083":74584,"_21524":126597,"_5":14790,"_28264":126433,"_3060":126598},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3604":74647,"_31083":74584,"_21524":126600,"_5":14790,"_28264":126437,"_3060":126601},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3604":74648,"_31083":74584,"_21524":126603,"_5":14790,"_28264":126437,"_3060":126604},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3604":74649,"_31083":74584,"_21524":126606,"_5":14790,"_28264":126437,"_3060":126607},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3604":74650,"_31083":74584,"_21524":126609,"_5":14790,"_28264":126437,"_3060":126610},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3604":74651,"_31083":74584,"_21524":126612,"_5":14790,"_28264":126437,"_3060":126613},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3604":74652,"_31083":74584,"_21524":126615,"_5":14790,"_28264":126441,"_3060":126616},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3604":74653,"_31083":74584,"_21524":126618,"_5":14790,"_28264":126441,"_3060":123090},[],{"_3604":74654,"_31083":74584,"_21524":126620,"_5":14790,"_28264":126441,"_3060":126621},[],"Path relativo",{"_3604":74655,"_31083":74584,"_21524":126623,"_5":14790,"_28264":126441,"_3060":120984},[],{"_3604":74656,"_31083":74584,"_21524":126625,"_5":14790,"_28264":126441,"_3060":57808},[],{"_3604":74657,"_31083":74584,"_21524":126627,"_5":14790,"_28264":126441,"_3060":57811},[],{"_3604":74658,"_31083":74584,"_21524":126629,"_5":14790,"_28264":126441,"_3060":126630},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3604":74659,"_31083":74584,"_21524":126632,"_5":14790,"_28264":126441,"_3060":57808},[],{"_3604":74660,"_31083":74584,"_21524":126634,"_5":14790,"_28264":126441,"_3060":57819},[],{"_3604":74661,"_31083":74584,"_21524":126636,"_5":14790,"_28264":126441,"_3060":126637},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3604":74662,"_31083":74584,"_21524":126639,"_5":14790,"_28264":126441,"_3060":57825},[],{"_3604":74663,"_31083":74584,"_21524":126641,"_5":14790,"_28264":126441,"_3060":57819},[],{"_3604":74664,"_31083":74584,"_21524":126643,"_5":14790,"_28264":126441,"_3060":126644},[],"Sustituir la configuración de CRL de una CA.",{"_3604":74665,"_31083":74584,"_21524":126646,"_5":14790,"_28264":126441,"_3060":57833},[],{"_3604":74666,"_31083":74584,"_21524":126648,"_5":14790,"_28264":126441,"_3060":57819},[],{"_3604":74667,"_31083":74584,"_21524":126650,"_5":14790,"_28264":126441,"_3060":126651},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3604":74668,"_31083":74584,"_21524":126653,"_5":14790,"_28264":126441,"_3060":126654},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3604":74669,"_31083":74584,"_21524":126656,"_5":14790,"_28264":126441,"_3060":126657},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3604":74670,"_31083":74584,"_21524":126659,"_5":14790,"_28264":126441,"_3060":126660},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3604":74671,"_31083":74584,"_21524":126662,"_5":14790,"_28264":126445,"_3060":126663},[],"Síntoma",{"_3604":74672,"_31083":74584,"_21524":126665,"_5":14790,"_28264":126445,"_3060":126666},[],"Causa",{"_3604":74673,"_31083":74584,"_21524":126668,"_5":14790,"_28264":126445,"_3060":126669},[],"Acción",{"_3604":74674,"_31083":74584,"_21524":126671,"_5":14790,"_28264":126445,"_3060":126672},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3604":74675,"_31083":74584,"_21524":126674,"_5":14790,"_28264":126445,"_3060":126675},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3604":74676,"_31083":74584,"_21524":126677,"_5":14790,"_28264":126445,"_3060":126678},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3604":74677,"_31083":74584,"_21524":126680,"_5":14790,"_28264":126445,"_3060":126681},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3604":74678,"_31083":74584,"_21524":126683,"_5":14790,"_28264":126445,"_3060":126684},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3604":74679,"_31083":74584,"_21524":126686,"_5":14790,"_28264":126445,"_3060":126687},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3604":74680,"_31083":74584,"_21524":126689,"_5":14790,"_28264":126445,"_3060":126690},[],"`PUT` devuelve 400.",{"_3604":74681,"_31083":74584,"_21524":126692,"_5":14790,"_28264":126445,"_3060":126693},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3604":74682,"_31083":74584,"_21524":126695,"_5":14790,"_28264":126445,"_3060":126696},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3604":74683,"_31083":74584,"_21524":126698,"_5":14790,"_28264":126445,"_3060":126699},[],"`PUT` devuelve 404.",{"_3604":74684,"_31083":74584,"_21524":126701,"_5":14790,"_28264":126445,"_3060":126702},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3604":74685,"_31083":74584,"_21524":126704,"_5":14790,"_28264":126445,"_3060":126705},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3604":74686,"_31083":74584,"_21524":126707,"_5":14790,"_28264":126445,"_3060":126708},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3604":74687,"_31083":74584,"_21524":126710,"_5":14790,"_28264":126445,"_3060":126711},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3604":74688,"_31083":74584,"_21524":126713,"_5":14790,"_28264":126445,"_3060":126714},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3604":74689,"_31083":74584,"_21524":126716,"_5":14790,"_28264":126445,"_3060":126717},[],"La CRL no cambia tras revocar un certificado.",{"_3604":74690,"_31083":74584,"_21524":126719,"_5":14790,"_28264":126445,"_3060":126720},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3604":74691,"_31083":74584,"_21524":126722,"_5":14790,"_28264":126445,"_3060":126723},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3604":74692,"_31083":74584,"_21524":126725,"_5":14790,"_28264":126445,"_3060":126726},[],"Un verificador rechaza la CRL por el emisor.",{"_3604":74693,"_31083":74584,"_21524":126728,"_5":14790,"_28264":126445,"_3060":126729},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3604":74694,"_31083":74584,"_21524":126731,"_5":14790,"_28264":126445,"_3060":126732},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3604":74695,"_31083":74584,"_21524":126734,"_5":14790,"_28264":126449,"_3060":126735},[],"RFC 5280: perfil X.509 y CRL.",{"_3604":74696,"_31083":74584,"_21524":126737,"_5":14790,"_28264":126449,"_3060":57925},[],{"_3604":74697,"_31083":74584,"_21524":126739,"_5":14790,"_28264":126449,"_3060":57928},[],{"_3604":74698,"_31083":74584,"_21524":126741,"_5":14790,"_28264":126449,"_3060":126742},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":74699,"_31083":74584,"_21524":126744,"_5":14790,"_28264":126449,"_3060":126745},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3604":74700,"_31083":74700,"_5":15155,"_3060":126747,"_31421":126748,"_21524":126749,"_28264":74700},"Claves y motores criptográficos",[50730,121224,56408,125238],[],{"_3604":74701,"_31083":74700,"_21524":126751,"_5":14790,"_28264":74700,"_3060":126752},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3604":74702,"_31083":74700,"_5":31418,"_21524":126754,"_28264":126755,"_3060":126756},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3604":74703,"_31083":74700,"_5":31418,"_21524":126758,"_28264":126759,"_3060":126760},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3604":74704,"_31083":74700,"_5":31418,"_21524":126762,"_28264":126763,"_3060":57953},[],"/docs/es/platform/pki/key-management#file-system",{"_3604":74705,"_31083":74700,"_5":31418,"_21524":126765,"_28264":126766,"_3060":57957},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3604":74706,"_31083":74700,"_5":31418,"_21524":126768,"_28264":126769,"_3060":57961},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3604":74707,"_31083":74700,"_5":31418,"_21524":126771,"_28264":126772,"_3060":57965},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3604":74708,"_31083":74700,"_5":31418,"_21524":126774,"_28264":126775,"_3060":57969},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3604":74709,"_31083":74700,"_5":31418,"_21524":126777,"_28264":126778,"_3060":57973},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3604":74710,"_31083":74700,"_5":31418,"_21524":126780,"_28264":126781,"_3060":126782},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3604":74711,"_31083":74700,"_5":31418,"_21524":126784,"_28264":126785,"_3060":126786},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3604":74712,"_31083":74700,"_5":31418,"_21524":126788,"_28264":126789,"_3060":126790},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3604":74713,"_31083":74700,"_5":31418,"_21524":126792,"_28264":126793,"_3060":126794},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3604":74714,"_31083":74700,"_5":31418,"_21524":126796,"_28264":126797,"_3060":126798},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3604":74715,"_31083":74700,"_5":31418,"_21524":126800,"_28264":126801,"_3060":126802},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3604":74716,"_31083":74700,"_5":31418,"_21524":126804,"_28264":126805,"_3060":126806},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3604":74717,"_31083":74700,"_5":31418,"_21524":126808,"_28264":126809,"_3060":58005},[],"/docs/es/platform/pki/key-management#sign",{"_3604":74718,"_31083":74700,"_5":31418,"_21524":126811,"_28264":126812,"_3060":58009},[],"/docs/es/platform/pki/key-management#verify",{"_3604":74719,"_31083":74700,"_5":31418,"_21524":126814,"_28264":126815,"_3060":126816},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3604":74720,"_31083":74700,"_5":31418,"_21524":126818,"_28264":126819,"_3060":126820},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3604":74721,"_31083":74700,"_5":31418,"_21524":126822,"_28264":126823,"_3060":126824},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3604":74722,"_31083":74700,"_21524":126826,"_5":14790,"_28264":74700,"_3060":126827},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3604":74723,"_31083":74700,"_21524":126829,"_5":14790,"_28264":74700,"_3060":126830},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3604":74724,"_31083":74700,"_21524":126832,"_5":14790,"_28264":126755,"_3060":126833},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3604":74725,"_31083":74700,"_21524":126835,"_5":14790,"_28264":126755,"_3060":126836},[],"En la práctica, permite:",{"_3604":74726,"_31083":74700,"_21524":126838,"_5":14790,"_28264":126755,"_3060":126839},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3604":74727,"_31083":74700,"_21524":126841,"_5":14790,"_28264":126755,"_3060":126842},[],"Importar claves creadas externamente.",{"_3604":74728,"_31083":74700,"_21524":126844,"_5":14790,"_28264":126755,"_3060":126845},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3604":74729,"_31083":74700,"_21524":126847,"_5":14790,"_28264":126755,"_3060":126848},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3604":74730,"_31083":74700,"_21524":126850,"_5":14790,"_28264":126759,"_3060":126851},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3604":74731,"_31083":74700,"_21524":126853,"_5":14790,"_28264":126759,"_3060":126854},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3604":74732,"_31083":74700,"_21524":126856,"_5":14790,"_28264":126759,"_3060":126857},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3604":74733,"_31083":74700,"_21524":126859,"_5":14790,"_28264":126763,"_3060":126860},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3604":74734,"_31083":74700,"_21524":126862,"_5":14790,"_28264":126766,"_3060":126863},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3604":74735,"_31083":74700,"_21524":126865,"_5":14790,"_28264":126766,"_3060":126866},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3604":74736,"_31083":74700,"_21524":126868,"_5":14790,"_28264":126769,"_3060":126869},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3604":74737,"_31083":74700,"_21524":126871,"_5":14790,"_28264":126772,"_3060":126872},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3604":74738,"_31083":74700,"_21524":126874,"_5":14790,"_28264":126775,"_3060":126875},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3604":74739,"_31083":74700,"_21524":126877,"_5":14790,"_28264":126778,"_3060":126878},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3604":74740,"_31083":74700,"_21524":126880,"_5":14790,"_28264":126778,"_3060":126881},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3604":74741,"_31083":74700,"_21524":126883,"_5":14790,"_28264":126778,"_3060":126884},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3604":74742,"_31083":74700,"_21524":126886,"_5":14790,"_28264":126778,"_3060":126887},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3604":74743,"_31083":74700,"_21524":126889,"_5":14790,"_28264":126781,"_3060":126890},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3604":74744,"_31083":74700,"_21524":126892,"_5":14790,"_28264":126781,"_3060":126893},[],"La tabla incluye los siguientes campos:",{"_3604":74745,"_31083":74700,"_21524":126895,"_5":14790,"_28264":126781,"_3060":126896},[],"**Name**: nombre descriptivo de la clave.",{"_3604":74746,"_31083":74700,"_21524":126898,"_5":14790,"_28264":126781,"_3060":126899},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3604":74747,"_31083":74700,"_21524":126901,"_5":14790,"_28264":126781,"_3060":126902},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3604":74748,"_31083":74700,"_21524":126904,"_5":14790,"_28264":126781,"_3060":126905},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3604":74749,"_31083":74700,"_21524":126907,"_5":14790,"_28264":126781,"_3060":126908},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3604":74750,"_31083":74700,"_21524":126910,"_5":14790,"_28264":126781,"_3060":126911},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3604":74751,"_31083":74700,"_21524":126913,"_5":14790,"_28264":126781,"_3060":126914},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3604":74752,"_31083":74700,"_21524":126916,"_5":14790,"_28264":126781,"_3060":126917},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3604":74753,"_31083":74700,"_21524":126919,"_5":14790,"_28264":126781,"_3060":126920},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3604":74754,"_31083":74700,"_21524":126922,"_5":14790,"_28264":126781,"_3060":126923},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3604":74755,"_31083":74700,"_21524":126925,"_5":14790,"_28264":126781,"_3060":126926},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3604":74756,"_31083":74700,"_21524":126928,"_5":14790,"_28264":126781,"_3060":126929},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3604":74757,"_31083":74700,"_21524":126931,"_5":14790,"_28264":126781,"_3060":126932},[],"**Delete Key** para eliminar la clave del sistema.",{"_3604":74758,"_31083":74700,"_21524":126934,"_5":14790,"_28264":126785,"_3060":126935},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3604":74759,"_31083":74700,"_21524":126937,"_5":14790,"_28264":126789,"_3060":126938},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3604":74760,"_31083":74700,"_21524":126940,"_5":14790,"_28264":126789,"_3060":126941},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3604":74761,"_31083":74700,"_21524":126943,"_5":14790,"_28264":126789,"_3060":126944},[],"**Key Name**: nombre único y descriptivo.",{"_3604":74762,"_31083":74700,"_21524":126946,"_5":14790,"_28264":126789,"_3060":126947},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3604":74763,"_31083":74700,"_21524":126949,"_5":14790,"_28264":126789,"_3060":126950},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3604":74764,"_31083":74700,"_21524":126952,"_5":14790,"_28264":126789,"_3060":126953},[],"**Tags**: metadatos para clasificar la clave.",{"_3604":74765,"_31083":74700,"_21524":126955,"_5":14790,"_28264":126789,"_3060":126956},[],"**Metadata**: información adicional para usos avanzados.",{"_3604":74766,"_31083":74700,"_21524":126958,"_5":14790,"_28264":126793,"_3060":126959},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3604":74767,"_31083":74700,"_21524":126961,"_5":14790,"_28264":126793,"_3060":126962},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3604":74768,"_31083":74700,"_21524":126964,"_5":14790,"_28264":126793,"_3060":126965},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3604":74769,"_31083":74700,"_21524":126967,"_5":14790,"_28264":126793,"_3060":126968},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3604":74770,"_31083":74700,"_21524":126970,"_5":14790,"_28264":126793,"_3060":126971},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3604":74771,"_31083":74700,"_21524":126973,"_5":14790,"_28264":126793,"_3060":126974},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3604":74772,"_31083":74700,"_21524":126976,"_5":14790,"_28264":126793,"_3060":126977},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3604":74773,"_31083":74700,"_21524":126979,"_5":14790,"_28264":126793,"_3060":126980},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3604":74774,"_31083":74700,"_21524":126982,"_5":14790,"_28264":126793,"_3060":126983},[],"**Metadata**: información adicional opcional.",{"_3604":74775,"_31083":74700,"_21524":126985,"_5":14790,"_28264":126793,"_3060":126986},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3604":74776,"_31083":74700,"_21524":126988,"_5":14790,"_28264":126793,"_3060":126989},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3604":74777,"_31083":74700,"_21524":126991,"_5":14790,"_28264":126797,"_3060":126992},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3604":74778,"_31083":74700,"_21524":126994,"_5":14790,"_28264":126801,"_3060":126995},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3604":74779,"_31083":74700,"_21524":126997,"_5":14790,"_28264":126801,"_3060":126998},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3604":74780,"_31083":74700,"_21524":127000,"_5":14790,"_28264":126801,"_3060":127001},[],"**Key Name**: nombre descriptivo.",{"_3604":74781,"_31083":74700,"_21524":127003,"_5":14790,"_28264":126801,"_3060":127004},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3604":74782,"_31083":74700,"_21524":127006,"_5":14790,"_28264":126801,"_3060":127007},[],"**Tags**: etiquetas asociadas.",{"_3604":74783,"_31083":74700,"_21524":127009,"_5":14790,"_28264":126801,"_3060":127010},[],"**Aliases**: nombres alternativos.",{"_3604":74784,"_31083":74700,"_21524":127012,"_5":14790,"_28264":126801,"_3060":127013},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3604":74785,"_31083":74700,"_21524":127015,"_5":14790,"_28264":126801,"_3060":127016},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3604":74786,"_31083":74700,"_21524":127018,"_5":14790,"_28264":126801,"_3060":127019},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3604":74787,"_31083":74700,"_21524":127021,"_5":14790,"_28264":126801,"_3060":127022},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3604":74788,"_31083":74700,"_21524":127024,"_5":14790,"_28264":126805,"_3060":127025},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3604":74789,"_31083":74700,"_21524":127027,"_5":14790,"_28264":126805,"_3060":127028},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3604":74790,"_31083":74700,"_21524":127030,"_5":14790,"_28264":126805,"_3060":127031},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3604":74791,"_31083":74700,"_21524":127033,"_5":14790,"_28264":126809,"_3060":127034},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3604":74792,"_31083":74700,"_21524":127036,"_5":14790,"_28264":126809,"_3060":127037},[],"Campos principales:",{"_3604":74793,"_31083":74700,"_21524":127039,"_5":14790,"_28264":126809,"_3060":127040},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3604":74794,"_31083":74700,"_21524":127042,"_5":14790,"_28264":126809,"_3060":127043},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3604":74795,"_31083":74700,"_21524":127045,"_5":14790,"_28264":126809,"_3060":127046},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3604":74796,"_31083":74700,"_21524":127048,"_5":14790,"_28264":126809,"_3060":127049},[],"**Message**: contenido que se va a firmar.",{"_3604":74797,"_31083":74700,"_21524":127051,"_5":14790,"_28264":126809,"_3060":127052},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3604":74798,"_31083":74700,"_21524":127054,"_5":14790,"_28264":126812,"_3060":127055},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3604":74799,"_31083":74700,"_21524":127057,"_5":14790,"_28264":126812,"_3060":127037},[],{"_3604":74800,"_31083":74700,"_21524":127059,"_5":14790,"_28264":126812,"_3060":127060},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3604":74801,"_31083":74700,"_21524":127062,"_5":14790,"_28264":126812,"_3060":127063},[],"**Message Type**: `Raw` o `Digest`.",{"_3604":74802,"_31083":74700,"_21524":127065,"_5":14790,"_28264":126812,"_3060":127066},[],"**Payload Encoding**: codificación del mensaje.",{"_3604":74803,"_31083":74700,"_21524":127068,"_5":14790,"_28264":126812,"_3060":127069},[],"**Message**: mensaje original o hash.",{"_3604":74804,"_31083":74700,"_21524":127071,"_5":14790,"_28264":126812,"_3060":127072},[],"**Signature**: firma que se desea comprobar.",{"_3604":74805,"_31083":74700,"_21524":127074,"_5":14790,"_28264":126812,"_3060":127075},[],"**Result**: indicador del resultado de la validación.",{"_3604":74806,"_31083":74700,"_21524":127077,"_5":14790,"_28264":126815,"_3060":127078},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3604":74807,"_31083":74700,"_21524":127080,"_5":14790,"_28264":126815,"_3060":127081},[],"Este flujo es útil para:",{"_3604":74808,"_31083":74700,"_21524":127083,"_5":14790,"_28264":126815,"_3060":127084},[],"Solicitar certificados a una CA externa.",{"_3604":74809,"_31083":74700,"_21524":127086,"_5":14790,"_28264":126815,"_3060":127087},[],"Renovar una identidad manteniendo la misma clave.",{"_3604":74810,"_31083":74700,"_21524":127089,"_5":14790,"_28264":126815,"_3060":127090},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3604":74811,"_31083":74700,"_21524":127092,"_5":14790,"_28264":126815,"_3060":127093},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3604":74812,"_31083":74700,"_21524":127095,"_5":14790,"_28264":126815,"_3060":127096},[],"**Organization (O)**: organización o empresa.",{"_3604":74813,"_31083":74700,"_21524":127098,"_5":14790,"_28264":126815,"_3060":127099},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3604":74814,"_31083":74700,"_21524":127101,"_5":14790,"_28264":126815,"_3060":127102},[],"**Country (C)**: código de país de dos letras.",{"_3604":74815,"_31083":74700,"_21524":127104,"_5":14790,"_28264":126815,"_3060":127105},[],"**State / Province (ST)**: estado o provincia.",{"_3604":74816,"_31083":74700,"_21524":127107,"_5":14790,"_28264":126815,"_3060":127108},[],"**Locality (L)**: ciudad o localidad.",{"_3604":74817,"_31083":74700,"_21524":127110,"_5":14790,"_28264":126815,"_3060":127111},[],"**Email Address**: correo de contacto.",{"_3604":74818,"_31083":74700,"_21524":127113,"_5":14790,"_28264":126815,"_3060":127114},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3604":74819,"_31083":74700,"_21524":127116,"_5":14790,"_28264":126815,"_3060":127117},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3604":74820,"_31083":74700,"_21524":127119,"_5":14790,"_28264":126819,"_3060":127120},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3604":74821,"_31083":74700,"_21524":127122,"_5":14790,"_28264":126819,"_3060":127123},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3604":74822,"_31083":74700,"_21524":127125,"_5":14790,"_28264":126823,"_3060":127126},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3604":74823,"_31083":74700,"_21524":127128,"_5":14790,"_28264":126823,"_3060":127129},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3604":74824,"_31083":74824,"_5":15155,"_3060":127131,"_31421":127132,"_21524":127133,"_28264":74824},"Validación online con OCSP",[50730,121224,56408,125887],[],{"_3604":74825,"_31083":74824,"_21524":127135,"_5":14790,"_28264":74824,"_3060":127136},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3604":74826,"_31083":74824,"_5":31418,"_21524":127138,"_28264":127139,"_3060":127140},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3604":74827,"_31083":74824,"_5":31418,"_21524":127142,"_28264":127143,"_3060":127144},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3604":74828,"_31083":74824,"_5":31418,"_21524":127146,"_28264":127147,"_3060":127148},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3604":74829,"_31083":74824,"_5":31418,"_21524":127150,"_28264":127151,"_3060":127152},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3604":74830,"_31083":74824,"_5":31418,"_21524":127154,"_28264":127155,"_3060":127156},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3604":74831,"_31083":74824,"_5":31418,"_21524":127158,"_28264":127159,"_3060":126450},[],"/docs/es/platform/pki/ocsp#referencias",{"_3604":74832,"_31083":74824,"_21524":127161,"_5":14790,"_28264":74824,"_3060":127162},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3604":74833,"_31083":74824,"_21524":127164,"_5":14790,"_28264":127139,"_3060":127165},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3604":74834,"_31083":74824,"_21524":127167,"_5":14790,"_28264":127139,"_3060":127168},[],"Estado del registro",{"_3604":74835,"_31083":74824,"_21524":127170,"_5":14790,"_28264":127139,"_3060":127171},[],"Respuesta firmada",{"_3604":74836,"_31083":74824,"_21524":127173,"_5":14790,"_28264":127139,"_3060":55545},[],{"_3604":74837,"_31083":74824,"_21524":127175,"_5":14790,"_28264":127139,"_3060":58373},[],{"_3604":74838,"_31083":74824,"_21524":127177,"_5":14790,"_28264":127139,"_3060":55562},[],{"_3604":74839,"_31083":74824,"_21524":127179,"_5":14790,"_28264":127139,"_3060":127180},[],"`Revoked`, con razón y fecha de revocación.",{"_3604":74840,"_31083":74824,"_21524":127182,"_5":14790,"_28264":127139,"_3060":127183},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3604":74841,"_31083":74824,"_21524":127185,"_5":14790,"_28264":127139,"_3060":127186},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3604":74842,"_31083":74824,"_21524":127188,"_5":14790,"_28264":127139,"_3060":127189},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3604":74843,"_31083":74824,"_21524":127191,"_5":14790,"_28264":127139,"_3060":127192},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3604":74844,"_31083":74824,"_21524":127194,"_5":14790,"_28264":127139,"_3060":127195},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3604":74845,"_31083":74824,"_21524":127197,"_5":14790,"_28264":127143,"_3060":127198},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3604":74846,"_31083":74824,"_21524":127200,"_5":14790,"_28264":127143,"_3060":127201},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3604":74847,"_31083":74824,"_21524":127203,"_5":14790,"_28264":127147,"_3060":127204},[],"El servicio acepta:",{"_3604":74848,"_31083":74824,"_21524":127206,"_5":14790,"_28264":127147,"_3060":123090},[],{"_3604":74849,"_31083":74824,"_21524":127208,"_5":14790,"_28264":127147,"_3060":127209},[],"Ruta del servicio VA",{"_3604":74850,"_31083":74824,"_21524":127211,"_5":14790,"_28264":127147,"_3060":127212},[],"Formato",{"_3604":74851,"_31083":74824,"_21524":127214,"_5":14790,"_28264":127147,"_3060":58413},[],{"_3604":74852,"_31083":74824,"_21524":127216,"_5":14790,"_28264":127147,"_3060":58416},[],{"_3604":74853,"_31083":74824,"_21524":127218,"_5":14790,"_28264":127147,"_3060":127219},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3604":74854,"_31083":74824,"_21524":127221,"_5":14790,"_28264":127147,"_3060":57808},[],{"_3604":74855,"_31083":74824,"_21524":127223,"_5":14790,"_28264":127147,"_3060":58424},[],{"_3604":74856,"_31083":74824,"_21524":127225,"_5":14790,"_28264":127147,"_3060":127226},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3604":74857,"_31083":74824,"_21524":127228,"_5":14790,"_28264":127147,"_3060":127229},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3604":74858,"_31083":74824,"_21524":127231,"_5":14790,"_28264":127151,"_3060":127232},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3604":74859,"_31083":74824,"_21524":127234,"_5":14790,"_28264":127151,"_3060":127235},[],"Genera la solicitud:",{"_3604":74860,"_31083":74824,"_21524":127237,"_5":14790,"_28264":127151,"_3060":127238},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3604":74861,"_31083":74824,"_21524":127240,"_5":14790,"_28264":127151,"_3060":127241},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3604":74862,"_31083":74824,"_21524":127243,"_5":14790,"_28264":127151,"_3060":127244},[],"Verifica el DER recibido:",{"_3604":74863,"_31083":74824,"_21524":127246,"_5":14790,"_28264":127151,"_3060":127247},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3604":74864,"_31083":74824,"_21524":127249,"_5":14790,"_28264":127155,"_3060":127250},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3604":74865,"_31083":74824,"_21524":127252,"_5":14790,"_28264":127155,"_3060":127253},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3604":74866,"_31083":74824,"_21524":127255,"_5":14790,"_28264":127159,"_3060":58457},[],{"_3604":74867,"_31083":74824,"_21524":127257,"_5":14790,"_28264":127159,"_3060":58460},[],{"_3604":74868,"_31083":74824,"_21524":127259,"_5":14790,"_28264":127159,"_3060":127260},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3604":74869,"_31083":74824,"_21524":127262,"_5":14790,"_28264":127159,"_3060":126745},[],{"_3604":74870,"_31083":74870,"_5":15155,"_3060":56408,"_31421":127264,"_21524":127265,"_28264":74870},[50730,121224,56408],[],{"_3604":74871,"_31083":74870,"_21524":127267,"_5":14790,"_28264":74870,"_3060":127268},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3604":74872,"_31083":74870,"_5":31418,"_21524":127270,"_28264":127271,"_3060":124564},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3604":74873,"_31083":74870,"_5":31418,"_21524":127273,"_28264":127274,"_3060":127275},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3604":74874,"_31083":74870,"_5":31418,"_21524":127277,"_28264":127278,"_3060":125084},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3604":74875,"_31083":74870,"_5":31418,"_21524":127280,"_28264":127281,"_3060":125088},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3604":74876,"_31083":74870,"_5":31418,"_21524":127283,"_28264":127284,"_3060":125092},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3604":74877,"_31083":74870,"_5":31418,"_21524":127286,"_28264":127287,"_3060":125096},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3604":74878,"_31083":74870,"_5":31418,"_21524":127289,"_28264":127290,"_3060":125104},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3604":74879,"_31083":74870,"_5":31418,"_21524":127292,"_28264":127293,"_3060":127294},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3604":74880,"_31083":74870,"_5":31418,"_21524":127296,"_28264":127297,"_3060":126053},[],"/docs/es/platform/pki/overview#continúa",{"_3604":74881,"_31083":74870,"_21524":127299,"_5":14790,"_28264":74870,"_3060":127300},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3604":74882,"_31083":74870,"_21524":127302,"_5":14790,"_28264":127271,"_3060":127303},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3604":74883,"_31083":74870,"_21524":127305,"_5":14790,"_28264":127271,"_3060":127306},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3604":74884,"_31083":74870,"_21524":127308,"_5":14790,"_28264":127274,"_3060":127309},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3604":74885,"_31083":74870,"_21524":127311,"_5":14790,"_28264":127274,"_3060":127312},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3604":74886,"_31083":74870,"_21524":127314,"_5":14790,"_28264":127274,"_3060":127315},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3604":74887,"_31083":74870,"_21524":127317,"_5":14790,"_28264":127274,"_3060":127318},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3604":74888,"_31083":74870,"_21524":127320,"_5":14790,"_28264":127274,"_3060":127321},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3604":74889,"_31083":74870,"_21524":127323,"_5":14790,"_28264":127281,"_3060":127324},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3604":74890,"_31083":74870,"_21524":127326,"_5":14790,"_28264":127284,"_3060":127327},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3604":74891,"_31083":74870,"_21524":127329,"_5":14790,"_28264":127287,"_3060":127330},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3604":74892,"_31083":74870,"_21524":127332,"_5":14790,"_28264":127290,"_3060":127333},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3604":74893,"_31083":74870,"_21524":127335,"_5":14790,"_28264":127293,"_3060":127336},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3604":74894,"_31083":74870,"_21524":127338,"_5":14790,"_28264":127293,"_3060":127339},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3604":74895,"_31083":74870,"_21524":127341,"_5":14790,"_28264":127293,"_3060":127342},[],"su clave pública corresponda a la clave privada del cliente;",{"_3604":74896,"_31083":74870,"_21524":127344,"_5":14790,"_28264":127293,"_3060":127345},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3604":74897,"_31083":74870,"_21524":127347,"_5":14790,"_28264":127293,"_3060":127348},[],"sus fechas y usos permitan la operación;",{"_3604":74898,"_31083":74870,"_21524":127350,"_5":14790,"_28264":127293,"_3060":127351},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3604":74899,"_31083":74870,"_21524":127353,"_5":14790,"_28264":127293,"_3060":127354},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3604":74900,"_31083":74870,"_21524":127356,"_5":14790,"_28264":127297,"_3060":127357},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3604":74901,"_31083":74870,"_21524":127359,"_5":14790,"_28264":127297,"_3060":127360},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3604":74902,"_31083":74870,"_21524":127362,"_5":14790,"_28264":127297,"_3060":127363},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3604":74903,"_31083":74903,"_5":15155,"_3060":127365,"_31421":127366,"_21524":127367,"_28264":74903},"Crea tu primera CA",[50730,121224,56408,124688],[],{"_3604":74904,"_31083":74903,"_21524":127369,"_5":14790,"_28264":74903,"_3060":127370},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3604":74905,"_31083":74903,"_5":31418,"_21524":127372,"_28264":127373,"_3060":119758},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3604":74906,"_31083":74903,"_5":31418,"_21524":127375,"_28264":127376,"_3060":127377},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3604":74907,"_31083":74903,"_5":31418,"_21524":127379,"_28264":127380,"_3060":127381},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3604":74908,"_31083":74903,"_5":31418,"_21524":127383,"_28264":127384,"_3060":127385},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3604":74909,"_31083":74903,"_5":31418,"_21524":127387,"_28264":127388,"_3060":127389},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3604":74910,"_31083":74903,"_5":31418,"_21524":127391,"_28264":127392,"_3060":127393},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3604":74911,"_31083":74903,"_5":31418,"_21524":127395,"_28264":127396,"_3060":127397},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3604":74912,"_31083":74903,"_5":31418,"_21524":127399,"_28264":127400,"_3060":124935},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3604":74913,"_31083":74903,"_5":31418,"_21524":127402,"_28264":127403,"_3060":119782},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3604":74914,"_31083":74903,"_21524":127405,"_5":14790,"_28264":74903,"_3060":127406},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3604":74915,"_31083":74903,"_21524":127408,"_5":14790,"_28264":127373,"_3060":127409},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3604":74916,"_31083":74903,"_21524":127411,"_5":14790,"_28264":127373,"_3060":127412},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3604":74917,"_31083":74903,"_21524":127414,"_5":14790,"_28264":127373,"_3060":127415},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3604":74918,"_31083":74903,"_21524":127417,"_5":14790,"_28264":127373,"_3060":127418},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3604":74919,"_31083":74903,"_21524":127420,"_5":14790,"_28264":127376,"_3060":127421},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3604":74920,"_31083":74903,"_21524":127423,"_5":14790,"_28264":127376,"_3060":127424},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3604":74921,"_31083":74903,"_21524":127426,"_5":14790,"_28264":127380,"_3060":127427},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3604":74922,"_31083":74903,"_21524":127429,"_5":14790,"_28264":127380,"_3060":127430},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3604":74923,"_31083":74903,"_21524":127432,"_5":14790,"_28264":127384,"_3060":127433},[],"Selecciona **Root CA** y completa:",{"_3604":74924,"_31083":74903,"_21524":127435,"_5":14790,"_28264":127384,"_3060":58639},[],{"_3604":74925,"_31083":74903,"_21524":127437,"_5":14790,"_28264":127384,"_3060":127438},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3604":74926,"_31083":74903,"_21524":127440,"_5":14790,"_28264":127384,"_3060":127441},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3604":74927,"_31083":74903,"_21524":127443,"_5":14790,"_28264":127384,"_3060":127444},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3604":74928,"_31083":74903,"_21524":127446,"_5":14790,"_28264":127384,"_3060":127447},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3604":74929,"_31083":74903,"_21524":127449,"_5":14790,"_28264":127388,"_3060":127450},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3604":74930,"_31083":74903,"_21524":127452,"_5":14790,"_28264":127392,"_3060":127453},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3604":74931,"_31083":74903,"_21524":127455,"_5":14790,"_28264":127392,"_3060":127456},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3604":74932,"_31083":74903,"_21524":127458,"_5":14790,"_28264":127396,"_3060":127459},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3604":74933,"_31083":74903,"_21524":127461,"_5":14790,"_28264":127396,"_3060":127462},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3604":74934,"_31083":74903,"_21524":127464,"_5":14790,"_28264":127396,"_3060":127465},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3604":74935,"_31083":74903,"_21524":127467,"_5":14790,"_28264":127400,"_3060":127468},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3604":74936,"_31083":74903,"_21524":127470,"_5":14790,"_28264":127400,"_3060":127471},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3604":74937,"_31083":74903,"_21524":127473,"_5":14790,"_28264":127400,"_3060":127474},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3604":74938,"_31083":74903,"_21524":127476,"_5":14790,"_28264":127400,"_3060":127477},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3604":74939,"_31083":74903,"_21524":127479,"_5":14790,"_28264":127403,"_3060":127480},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3604":74940,"_31083":74940,"_5":15155,"_3060":127482,"_31421":127483,"_21524":127484,"_28264":74940},"Emite y verifica un certificado",[50730,121224,56408,124688],[],{"_3604":74941,"_31083":74940,"_21524":127486,"_5":14790,"_28264":74940,"_3060":127487},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3604":74942,"_31083":74940,"_5":31418,"_21524":127489,"_28264":127490,"_3060":119758},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3604":74943,"_31083":74940,"_5":31418,"_21524":127492,"_28264":127493,"_3060":127494},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3604":74944,"_31083":74940,"_5":31418,"_21524":127496,"_28264":127497,"_3060":127498},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3604":74945,"_31083":74940,"_5":31418,"_21524":127500,"_28264":127501,"_3060":127502},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3604":74946,"_31083":74940,"_5":31418,"_21524":127504,"_28264":127505,"_3060":127506},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3604":74947,"_31083":74940,"_5":31418,"_21524":127508,"_28264":127509,"_3060":127510},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3604":74948,"_31083":74940,"_5":31418,"_21524":127512,"_28264":127513,"_3060":127514},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3604":74949,"_31083":74940,"_5":31418,"_21524":127516,"_28264":127517,"_3060":127518},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3604":74950,"_31083":74940,"_5":31418,"_21524":127520,"_28264":127521,"_3060":127522},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3604":74951,"_31083":74940,"_5":31418,"_21524":127524,"_28264":127525,"_3060":127526},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3604":74952,"_31083":74940,"_5":31418,"_21524":127528,"_28264":127529,"_3060":124935},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3604":74953,"_31083":74940,"_5":31418,"_21524":127531,"_28264":127532,"_3060":119782},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3604":74954,"_31083":74940,"_21524":127534,"_5":14790,"_28264":74940,"_3060":127535},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3604":74955,"_31083":74940,"_21524":127537,"_5":14790,"_28264":127490,"_3060":127538},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3604":74956,"_31083":74940,"_21524":127540,"_5":14790,"_28264":127490,"_3060":127541},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3604":74957,"_31083":74940,"_21524":127543,"_5":14790,"_28264":127490,"_3060":127544},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3604":74958,"_31083":74940,"_21524":127546,"_5":14790,"_28264":127490,"_3060":127547},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3604":74959,"_31083":74940,"_21524":127549,"_5":14790,"_28264":127490,"_3060":127550},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3604":74960,"_31083":74940,"_21524":127552,"_5":14790,"_28264":127493,"_3060":127553},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3604":74961,"_31083":74940,"_21524":127555,"_5":14790,"_28264":127497,"_3060":127556},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3604":74962,"_31083":74940,"_21524":127558,"_5":14790,"_28264":127497,"_3060":127559},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3604":74963,"_31083":74940,"_21524":127561,"_5":14790,"_28264":127501,"_3060":127562},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3604":74964,"_31083":74940,"_21524":127564,"_5":14790,"_28264":127501,"_3060":127565},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3604":74965,"_31083":74940,"_21524":127567,"_5":14790,"_28264":127505,"_3060":127568},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3604":74966,"_31083":74940,"_21524":127570,"_5":14790,"_28264":127505,"_3060":127571},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3604":74967,"_31083":74940,"_21524":127573,"_5":14790,"_28264":127509,"_3060":127574},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3604":74968,"_31083":74940,"_21524":127576,"_5":14790,"_28264":127513,"_3060":127577},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3604":74969,"_31083":74940,"_21524":127579,"_5":14790,"_28264":127517,"_3060":127580},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3604":74970,"_31083":74940,"_21524":127582,"_5":14790,"_28264":127521,"_3060":127583},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3604":74971,"_31083":74940,"_21524":127585,"_5":14790,"_28264":127521,"_3060":127586},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3604":74972,"_31083":74940,"_21524":127588,"_5":14790,"_28264":127521,"_3060":127589},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3604":74973,"_31083":74940,"_21524":127591,"_5":14790,"_28264":127525,"_3060":127592},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3604":74974,"_31083":74940,"_21524":127594,"_5":14790,"_28264":127525,"_3060":127595},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3604":74975,"_31083":74940,"_21524":127597,"_5":14790,"_28264":127525,"_3060":127598},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3604":74976,"_31083":74940,"_21524":127600,"_5":14790,"_28264":127529,"_3060":125018},[],{"_3604":74977,"_31083":74940,"_21524":127602,"_5":14790,"_28264":127529,"_3060":123539},[],{"_3604":74978,"_31083":74940,"_21524":127604,"_5":14790,"_28264":127529,"_3060":127605},[],"La CA rechaza la emisión",{"_3604":74979,"_31083":74940,"_21524":127607,"_5":14790,"_28264":127529,"_3060":127608},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3604":74980,"_31083":74940,"_21524":127610,"_5":14790,"_28264":127529,"_3060":127611},[],"Sujeto o usos diferentes",{"_3604":74981,"_31083":74940,"_21524":127613,"_5":14790,"_28264":127529,"_3060":127614},[],"Perfil aplicado y valores solicitados.",{"_3604":74982,"_31083":74940,"_21524":127616,"_5":14790,"_28264":127529,"_3060":127617},[],"No se encuentra el emisor",{"_3604":74983,"_31083":74940,"_21524":127619,"_5":14790,"_28264":127529,"_3060":127620},[],"CA descargada y cadena intermedia necesaria.",{"_3604":74984,"_31083":74940,"_21524":127622,"_5":14790,"_28264":127529,"_3060":127623},[],"Falla la vigencia",{"_3604":74985,"_31083":74940,"_21524":127625,"_5":14790,"_28264":127529,"_3060":127626},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3604":74986,"_31083":74940,"_21524":127628,"_5":14790,"_28264":127529,"_3060":127629},[],"Los resúmenes de clave difieren",{"_3604":74987,"_31083":74940,"_21524":127631,"_5":14790,"_28264":127529,"_3060":127632},[],"Archivos de certificado y clave de la misma emisión.",{"_3604":74988,"_31083":74940,"_21524":127634,"_5":14790,"_28264":127529,"_3060":127635},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3604":74989,"_31083":74940,"_21524":127637,"_5":14790,"_28264":127532,"_3060":127638},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3604":74990,"_31083":74940,"_21524":127640,"_5":14790,"_28264":127532,"_3060":127641},[],"Gestionar certificados para inspección, estado y revocación.",{"_3604":74991,"_31083":74940,"_21524":127643,"_5":14790,"_28264":127532,"_3060":127644},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3604":74992,"_31083":74940,"_21524":127646,"_5":14790,"_28264":127532,"_3060":127647},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3604":74993,"_31083":74940,"_21524":127649,"_5":14790,"_28264":127532,"_3060":127650},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3604":74994,"_31083":74994,"_5":15155,"_3060":127652,"_31421":127653,"_21524":127654,"_28264":74994},"Primeros pasos de PKI",[50730,121224,56408,124688],[],{"_3604":74995,"_31083":74994,"_21524":127656,"_5":14790,"_28264":74994,"_3060":127657},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3604":74996,"_31083":74994,"_5":31418,"_21524":127659,"_28264":127660,"_3060":119758},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3604":74997,"_31083":74994,"_5":31418,"_21524":127662,"_28264":127663,"_3060":127664},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3604":74998,"_31083":74994,"_5":31418,"_21524":127666,"_28264":127667,"_3060":124870},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3604":74999,"_31083":74994,"_5":31418,"_21524":127669,"_28264":127670,"_3060":127671},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3604":75000,"_31083":74994,"_21524":127673,"_5":14790,"_28264":74994,"_3060":127674},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3604":75001,"_31083":74994,"_21524":127676,"_5":14790,"_28264":127660,"_3060":127677},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3604":75002,"_31083":74994,"_21524":127679,"_5":14790,"_28264":127660,"_3060":127680},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3604":75003,"_31083":74994,"_21524":127682,"_5":14790,"_28264":127660,"_3060":127683},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3604":75004,"_31083":74994,"_21524":127685,"_5":14790,"_28264":127660,"_3060":127686},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3604":75005,"_31083":74994,"_21524":127688,"_5":14790,"_28264":127660,"_3060":127689},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3604":75006,"_31083":74994,"_21524":127691,"_5":14790,"_28264":127663,"_3060":127692},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3604":75007,"_31083":74994,"_21524":127694,"_5":14790,"_28264":127663,"_3060":127695},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3604":75008,"_31083":74994,"_21524":127697,"_5":14790,"_28264":127663,"_3060":127698},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3604":75009,"_31083":74994,"_21524":127700,"_5":14790,"_28264":127663,"_3060":127701},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3604":75010,"_31083":74994,"_21524":127703,"_5":14790,"_28264":127667,"_3060":127704},[],"Archivo o recurso",{"_3604":75011,"_31083":74994,"_21524":127706,"_5":14790,"_28264":127667,"_3060":124867},[],{"_3604":75012,"_31083":74994,"_21524":127708,"_5":14790,"_28264":127667,"_3060":127709},[],"CA raíz activa y `ca.pem`",{"_3604":75013,"_31083":74994,"_21524":127711,"_5":14790,"_28264":127667,"_3060":127712},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3604":75014,"_31083":74994,"_21524":127714,"_5":14790,"_28264":127667,"_3060":127715},[],"Certificado final y `device.crt`",{"_3604":75015,"_31083":74994,"_21524":127717,"_5":14790,"_28264":127667,"_3060":127718},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3604":75016,"_31083":74994,"_21524":127720,"_5":14790,"_28264":127667,"_3060":127721},[],"Clave privada `device.key`",{"_3604":75017,"_31083":74994,"_21524":127723,"_5":14790,"_28264":127667,"_3060":127724},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3604":75018,"_31083":74994,"_21524":127726,"_5":14790,"_28264":127667,"_3060":127727},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3604":75019,"_31083":74994,"_21524":127729,"_5":14790,"_28264":127670,"_3060":127730},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3604":75020,"_31083":74994,"_21524":127732,"_5":14790,"_28264":127670,"_3060":127733},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3604":75021,"_31083":74994,"_21524":127735,"_5":14790,"_28264":127670,"_3060":127736},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3604":75022,"_31083":75022,"_5":15155,"_3060":127738,"_31421":127739,"_21524":127741,"_28264":75022},"Resolución de problemas PKI",[50730,121224,56408,127740],"Resolución de problemas",[],{"_3604":75023,"_31083":75022,"_21524":127743,"_5":14790,"_28264":75022,"_3060":127744},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3604":75024,"_31083":75022,"_5":31418,"_21524":127746,"_28264":127747,"_3060":127748},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3604":75025,"_31083":75022,"_5":31418,"_21524":127750,"_28264":127751,"_3060":127752},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3604":75026,"_31083":75022,"_5":31418,"_21524":127754,"_28264":127755,"_3060":127756},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3604":75027,"_31083":75022,"_21524":127758,"_5":14790,"_28264":75022,"_3060":127759},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3604":75028,"_31083":75022,"_21524":127761,"_5":14790,"_28264":75022,"_3060":127762},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3604":75029,"_31083":75022,"_21524":127764,"_5":14790,"_28264":127747,"_3060":124867},[],{"_3604":75030,"_31083":75022,"_21524":127766,"_5":14790,"_28264":127747,"_3060":123539},[],{"_3604":75031,"_31083":75022,"_21524":127768,"_5":14790,"_28264":127747,"_3060":119782},[],{"_3604":75032,"_31083":75022,"_21524":127770,"_5":14790,"_28264":127747,"_3060":55250},[],{"_3604":75033,"_31083":75022,"_21524":127772,"_5":14790,"_28264":127747,"_3060":127773},[],"Existe, está activa y sus fechas son utilizables.",{"_3604":75034,"_31083":75022,"_21524":127775,"_5":14790,"_28264":127747,"_3060":127776},[],"Autoridades.",{"_3604":75035,"_31083":75022,"_21524":127778,"_5":14790,"_28264":127747,"_3060":127779},[],"Clave",{"_3604":75036,"_31083":75022,"_21524":127781,"_5":14790,"_28264":127747,"_3060":127782},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3604":75037,"_31083":75022,"_21524":127784,"_5":14790,"_28264":127747,"_3060":127785},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3604":75038,"_31083":75022,"_21524":127787,"_5":14790,"_28264":127747,"_3060":58993},[],{"_3604":75039,"_31083":75022,"_21524":127789,"_5":14790,"_28264":127747,"_3060":127790},[],"PEM correcto y firma verificable.",{"_3604":75040,"_31083":75022,"_21524":127792,"_5":14790,"_28264":127747,"_3060":58999},[],{"_3604":75041,"_31083":75022,"_21524":127794,"_5":14790,"_28264":127747,"_3060":127795},[],"Perfil",{"_3604":75042,"_31083":75022,"_21524":127797,"_5":14790,"_28264":127747,"_3060":127798},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3604":75043,"_31083":75022,"_21524":127800,"_5":14790,"_28264":127747,"_3060":127801},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3604":75044,"_31083":75022,"_21524":127803,"_5":14790,"_28264":127747,"_3060":125018},[],{"_3604":75045,"_31083":75022,"_21524":127805,"_5":14790,"_28264":127747,"_3060":127806},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3604":75046,"_31083":75022,"_21524":127808,"_5":14790,"_28264":127747,"_3060":127809},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3604":75047,"_31083":75022,"_21524":127811,"_5":14790,"_28264":127747,"_3060":127812},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3604":75048,"_31083":75022,"_21524":127814,"_5":14790,"_28264":127747,"_3060":127815},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3604":75049,"_31083":75022,"_21524":127817,"_5":14790,"_28264":127747,"_3060":127818},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3604":75050,"_31083":75022,"_21524":127820,"_5":14790,"_28264":127751,"_3060":127821},[],"Revisa cada frontera por separado:",{"_3604":75051,"_31083":75022,"_21524":127823,"_5":14790,"_28264":127751,"_3060":127824},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3604":75052,"_31083":75022,"_21524":127826,"_5":14790,"_28264":127751,"_3060":127827},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3604":75053,"_31083":75022,"_21524":127829,"_5":14790,"_28264":127751,"_3060":127830},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3604":75054,"_31083":75022,"_21524":127832,"_5":14790,"_28264":127751,"_3060":127833},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3604":75055,"_31083":75022,"_21524":127835,"_5":14790,"_28264":127751,"_3060":127836},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3604":75056,"_31083":75022,"_21524":127838,"_5":14790,"_28264":127751,"_3060":127839},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3604":75057,"_31083":75022,"_21524":127841,"_5":14790,"_28264":127755,"_3060":127842},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3604":75058,"_31083":75022,"_21524":127844,"_5":14790,"_28264":127755,"_3060":127845},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3604":75059,"_31083":75059,"_5":15155,"_3060":127847,"_31421":127848,"_21524":127849,"_28264":75059},"Seguridad",[50730],[],{"_3604":75060,"_31083":75059,"_21524":127851,"_5":14790,"_28264":75059,"_3060":127852},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3604":75061,"_31083":75059,"_5":31418,"_21524":127854,"_28264":127855,"_3060":127856},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3604":75062,"_31083":75059,"_5":31418,"_21524":127858,"_28264":127859,"_3060":127860},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3604":75063,"_31083":75059,"_5":31418,"_21524":127862,"_28264":127863,"_3060":127864},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3604":75064,"_31083":75059,"_5":31418,"_21524":127866,"_28264":127867,"_3060":127868},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3604":75065,"_31083":75059,"_21524":127870,"_5":14790,"_28264":75059,"_3060":127871},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3604":75066,"_31083":75059,"_21524":127873,"_5":14790,"_28264":127855,"_3060":127874},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3604":75067,"_31083":75059,"_21524":127876,"_5":14790,"_28264":127855,"_3060":127877},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3604":75068,"_31083":75059,"_21524":127879,"_5":14790,"_28264":127855,"_3060":15429},[],{"_3604":75069,"_31083":75059,"_21524":127881,"_5":14790,"_28264":127855,"_3060":15358},[],{"_3604":75070,"_31083":75059,"_21524":127883,"_5":14790,"_28264":127855,"_3060":15416},[],{"_3604":75071,"_31083":75059,"_21524":127885,"_5":14790,"_28264":127855,"_3060":127886},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3604":75072,"_31083":75059,"_21524":127888,"_5":14790,"_28264":127855,"_3060":127889},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3604":75073,"_31083":75059,"_21524":127891,"_5":14790,"_28264":127859,"_3060":127892},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3604":75074,"_31083":75059,"_21524":127894,"_5":14790,"_28264":127859,"_3060":127895},[],"No incluyas en el reporte:",{"_3604":75075,"_31083":75059,"_21524":127897,"_5":14790,"_28264":127859,"_3060":127898},[],"Credenciales, tokens o claves privadas",{"_3604":75076,"_31083":75059,"_21524":127900,"_5":14790,"_28264":127859,"_3060":127901},[],"Datos de clientes o información identificable de clientes",{"_3604":75077,"_31083":75059,"_21524":127903,"_5":14790,"_28264":127859,"_3060":127904},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3604":75078,"_31083":75059,"_21524":127906,"_5":14790,"_28264":127863,"_3060":127907},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3604":75079,"_31083":75059,"_21524":127909,"_5":14790,"_28264":127863,"_3060":127910},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3604":75080,"_31083":75059,"_21524":127912,"_5":14790,"_28264":127867,"_3060":127913},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3604":75081,"_31083":75059,"_21524":127915,"_5":14790,"_28264":127867,"_3060":127916},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3604":75082,"_31083":75059,"_21524":127918,"_5":14790,"_28264":127867,"_3060":127919},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3604":75083,"_31083":75059,"_21524":127921,"_5":14790,"_28264":127867,"_3060":127922},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3604":75084,"_31083":75059,"_21524":127924,"_5":14790,"_28264":127867,"_3060":127925},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3604":75085,"_31083":75085,"_5":15155,"_3060":127927,"_31421":127928,"_21524":127930,"_28264":75085},"3.8.0 a 4.0.0",[50730,127929],"Actualizaciones",[],{"_3604":75086,"_31083":75085,"_21524":127932,"_5":14790,"_28264":75085,"_3060":127933},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3604":75087,"_31083":75085,"_5":31418,"_21524":127935,"_28264":127936,"_3060":127937},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3604":75088,"_31083":75085,"_5":31418,"_21524":127939,"_28264":127940,"_3060":127941},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3604":75089,"_31083":75085,"_5":31418,"_21524":127943,"_28264":127944,"_3060":127945},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3604":75090,"_31083":75085,"_5":31418,"_21524":127947,"_28264":127948,"_3060":127949},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3604":75091,"_31083":75085,"_5":31418,"_21524":127951,"_28264":127952,"_3060":127953},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3604":75092,"_31083":75085,"_5":31418,"_21524":127955,"_28264":127956,"_3060":127957},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3604":75093,"_31083":75085,"_5":31418,"_21524":127959,"_28264":127960,"_3060":59168},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3604":75094,"_31083":75085,"_5":31418,"_21524":127962,"_28264":127963,"_3060":127964},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3604":75095,"_31083":75085,"_5":31418,"_21524":127966,"_28264":127967,"_3060":127968},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3604":75096,"_31083":75085,"_5":31418,"_21524":127970,"_28264":127971,"_3060":127972},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3604":75097,"_31083":75085,"_5":31418,"_21524":127974,"_28264":127975,"_3060":120353},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3604":75098,"_31083":75085,"_5":31418,"_21524":127977,"_28264":127978,"_3060":127979},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3604":75099,"_31083":75085,"_5":31418,"_21524":127981,"_28264":127982,"_3060":127983},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3604":75100,"_31083":75085,"_5":31418,"_21524":127985,"_28264":127986,"_3060":127987},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3604":75101,"_31083":75085,"_5":31418,"_21524":127989,"_28264":127990,"_3060":127991},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3604":75102,"_31083":75085,"_5":31418,"_21524":127993,"_28264":127994,"_3060":127995},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3604":75103,"_31083":75085,"_5":31418,"_21524":127997,"_28264":127998,"_3060":127999},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3604":75104,"_31083":75085,"_5":31418,"_21524":128001,"_28264":128002,"_3060":128003},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3604":75105,"_31083":75085,"_5":31418,"_21524":128005,"_28264":128006,"_3060":128007},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3604":75106,"_31083":75085,"_5":31418,"_21524":128009,"_28264":128010,"_3060":128011},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3604":75107,"_31083":75085,"_5":31418,"_21524":128013,"_28264":128014,"_3060":128015},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3604":75108,"_31083":75085,"_5":31418,"_21524":128017,"_28264":128018,"_3060":128019},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3604":75109,"_31083":75085,"_5":31418,"_21524":128021,"_28264":128022,"_3060":128023},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3604":75110,"_31083":75085,"_5":31418,"_21524":128025,"_28264":128026,"_3060":128027},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3604":75111,"_31083":75085,"_5":31418,"_21524":128029,"_28264":128030,"_3060":128031},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3604":75112,"_31083":75085,"_5":31418,"_21524":128033,"_28264":128034,"_3060":128035},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3604":75113,"_31083":75085,"_5":31418,"_21524":128037,"_28264":128038,"_3060":128039},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3604":75114,"_31083":75085,"_5":31418,"_21524":128041,"_28264":128042,"_3060":128043},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3604":75115,"_31083":75085,"_5":31418,"_21524":128045,"_28264":128046,"_3060":128047},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3604":75116,"_31083":75085,"_5":31418,"_21524":128049,"_28264":128050,"_3060":128051},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3604":75117,"_31083":75085,"_5":31418,"_21524":128053,"_28264":128054,"_3060":128055},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3604":75118,"_31083":75085,"_5":31418,"_21524":128057,"_28264":128058,"_3060":128059},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3604":75119,"_31083":75085,"_5":31418,"_21524":128061,"_28264":128062,"_3060":128063},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3604":75120,"_31083":75085,"_5":31418,"_21524":128065,"_28264":128066,"_3060":128067},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3604":75121,"_31083":75085,"_5":31418,"_21524":128069,"_28264":128070,"_3060":128071},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3604":75122,"_31083":75085,"_5":31418,"_21524":128073,"_28264":128074,"_3060":128075},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3604":75123,"_31083":75085,"_5":31418,"_21524":128077,"_28264":128078,"_3060":128079},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3604":75124,"_31083":75085,"_5":31418,"_21524":128081,"_28264":128082,"_3060":128083},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3604":75125,"_31083":75085,"_5":31418,"_21524":128085,"_28264":128086,"_3060":128087},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3604":75126,"_31083":75085,"_5":31418,"_21524":128089,"_28264":128090,"_3060":128091},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3604":75127,"_31083":75085,"_5":31418,"_21524":128093,"_28264":128094,"_3060":128095},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3604":75128,"_31083":75085,"_5":31418,"_21524":128097,"_28264":128098,"_3060":128099},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3604":75129,"_31083":75085,"_5":31418,"_21524":128101,"_28264":128102,"_3060":123881},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3604":75130,"_31083":75085,"_5":31418,"_21524":128104,"_28264":128105,"_3060":128106},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3604":75131,"_31083":75085,"_5":31418,"_21524":128108,"_28264":128109,"_3060":128110},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3604":75132,"_31083":75085,"_21524":128112,"_5":14790,"_28264":75085,"_3060":128113},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3604":75133,"_31083":75085,"_21524":128115,"_5":14790,"_28264":75085,"_3060":128116},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3604":75134,"_31083":75085,"_21524":128118,"_5":14790,"_28264":75085,"_3060":128119},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3604":75135,"_31083":75085,"_21524":128121,"_5":14790,"_28264":75085,"_3060":128122},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3604":75136,"_31083":75085,"_21524":128124,"_5":14790,"_28264":75085,"_3060":128125},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3604":75137,"_31083":75085,"_21524":128127,"_5":14790,"_28264":75085,"_3060":128128},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3604":75138,"_31083":75085,"_21524":128130,"_5":14790,"_28264":75085,"_3060":128131},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3604":75139,"_31083":75085,"_21524":128133,"_5":14790,"_28264":127940,"_3060":128134},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3604":75140,"_31083":75085,"_21524":128136,"_5":14790,"_28264":127940,"_3060":128137},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3604":75141,"_31083":75085,"_21524":128139,"_5":14790,"_28264":127944,"_3060":128140},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3604":75142,"_31083":75085,"_21524":128142,"_5":14790,"_28264":127944,"_3060":128143},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3604":75143,"_31083":75085,"_21524":128145,"_5":14790,"_28264":127948,"_3060":128146},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3604":75144,"_31083":75085,"_21524":128148,"_5":14790,"_28264":127952,"_3060":128149},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3604":75145,"_31083":75085,"_21524":128151,"_5":14790,"_28264":127952,"_3060":128152},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3604":75146,"_31083":75085,"_21524":128154,"_5":14790,"_28264":127952,"_3060":128155},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3604":75147,"_31083":75085,"_21524":128157,"_5":14790,"_28264":127952,"_3060":128158},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3604":75148,"_31083":75085,"_21524":128160,"_5":14790,"_28264":127952,"_3060":128161},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3604":75149,"_31083":75085,"_21524":128163,"_5":14790,"_28264":127956,"_3060":128164},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3604":75150,"_31083":75085,"_21524":128166,"_5":14790,"_28264":127956,"_3060":128167},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3604":75151,"_31083":75085,"_21524":128169,"_5":14790,"_28264":127956,"_3060":128170},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3604":75152,"_31083":75085,"_21524":128172,"_5":14790,"_28264":127956,"_3060":128173},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3604":75153,"_31083":75085,"_21524":128175,"_5":14790,"_28264":127956,"_3060":128176},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3604":75154,"_31083":75085,"_21524":128178,"_5":14790,"_28264":127956,"_3060":128179},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3604":75155,"_31083":75085,"_21524":128181,"_5":14790,"_28264":127960,"_3060":128182},[],"Cambio",{"_3604":75156,"_31083":75085,"_21524":128184,"_5":14790,"_28264":127960,"_3060":128185},[],"A quién afecta",{"_3604":75157,"_31083":75085,"_21524":128187,"_5":14790,"_28264":127960,"_3060":128188},[],"Gravedad",{"_3604":75158,"_31083":75085,"_21524":128190,"_5":14790,"_28264":127960,"_3060":126669},[],{"_3604":75159,"_31083":75085,"_21524":128192,"_5":14790,"_28264":127960,"_3060":127968},[],{"_3604":75160,"_31083":75085,"_21524":128194,"_5":14790,"_28264":127960,"_3060":128195},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3604":75161,"_31083":75085,"_21524":128197,"_5":14790,"_28264":127960,"_3060":128198},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3604":75162,"_31083":75085,"_21524":128200,"_5":14790,"_28264":127960,"_3060":128201},[],"Copiar los datos a los volúmenes nuevos",{"_3604":75163,"_31083":75085,"_21524":128203,"_5":14790,"_28264":127960,"_3060":127972},[],{"_3604":75164,"_31083":75085,"_21524":128205,"_5":14790,"_28264":127960,"_3060":128206},[],"Todas las releases de Helm",{"_3604":75165,"_31083":75085,"_21524":128208,"_5":14790,"_28264":127960,"_3060":128209},[],"Alta: `helm upgrade` falla",{"_3604":75166,"_31083":75085,"_21524":128211,"_5":14790,"_28264":127960,"_3060":128212},[],"Eliminar o renombrar las claves heredadas",{"_3604":75167,"_31083":75085,"_21524":128214,"_5":14790,"_28264":127960,"_3060":120353},[],{"_3604":75168,"_31083":75085,"_21524":128216,"_5":14790,"_28264":127960,"_3060":128206},[],{"_3604":75169,"_31083":75085,"_21524":128218,"_5":14790,"_28264":127960,"_3060":128219},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3604":75170,"_31083":75085,"_21524":128221,"_5":14790,"_28264":127960,"_3060":128222},[],"Crear primero los Secrets; consulta el paso 2",{"_3604":75171,"_31083":75085,"_21524":128224,"_5":14790,"_28264":127960,"_3060":127979},[],{"_3604":75172,"_31083":75085,"_21524":128226,"_5":14790,"_28264":127960,"_3060":128227},[],"Todos los despliegues",{"_3604":75173,"_31083":75085,"_21524":128229,"_5":14790,"_28264":127960,"_3060":128230},[],"Alta: sin principal de bootstrap no hay administrador",{"_3604":75174,"_31083":75085,"_21524":128232,"_5":14790,"_28264":127960,"_3060":128233},[],"Configurar `services.authz`",{"_3604":75175,"_31083":75085,"_21524":128235,"_5":14790,"_28264":127960,"_3060":127983},[],{"_3604":75176,"_31083":75085,"_21524":128237,"_5":14790,"_28264":127960,"_3060":128206},[],{"_3604":75177,"_31083":75085,"_21524":128239,"_5":14790,"_28264":127960,"_3060":128240},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3604":75178,"_31083":75085,"_21524":128242,"_5":14790,"_28264":127960,"_3060":128243},[],"Mover JWKS y roles a `services.authz`",{"_3604":75179,"_31083":75085,"_21524":128245,"_5":14790,"_28264":127960,"_3060":128003},[],{"_3604":75180,"_31083":75085,"_21524":128247,"_5":14790,"_28264":127960,"_3060":128248},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3604":75181,"_31083":75085,"_21524":128250,"_5":14790,"_28264":127960,"_3060":128251},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3604":75182,"_31083":75085,"_21524":128253,"_5":14790,"_28264":127960,"_3060":128254},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3604":75183,"_31083":75085,"_21524":128256,"_5":14790,"_28264":127960,"_3060":128007},[],{"_3604":75184,"_31083":75085,"_21524":128258,"_5":14790,"_28264":127960,"_3060":128259},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3604":75185,"_31083":75085,"_21524":128261,"_5":14790,"_28264":127960,"_3060":128262},[],"Alta: el backend ya no arranca con ellos",{"_3604":75186,"_31083":75085,"_21524":128264,"_5":14790,"_28264":127960,"_3060":128265},[],"Pasar a PostgreSQL antes de actualizar",{"_3604":75187,"_31083":75085,"_21524":128267,"_5":14790,"_28264":127960,"_3060":128051},[],{"_3604":75188,"_31083":75085,"_21524":128269,"_5":14790,"_28264":127960,"_3060":128270},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3604":75189,"_31083":75085,"_21524":128272,"_5":14790,"_28264":127960,"_3060":128273},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3604":75190,"_31083":75085,"_21524":128275,"_5":14790,"_28264":127960,"_3060":128276},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3604":75191,"_31083":75085,"_21524":128278,"_5":14790,"_28264":127960,"_3060":128279},[],"Webhooks con referencias a archivos",{"_3604":75192,"_31083":75085,"_21524":128281,"_5":14790,"_28264":127960,"_3060":128282},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3604":75193,"_31083":75085,"_21524":128284,"_5":14790,"_28264":127960,"_3060":128285},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3604":75194,"_31083":75085,"_21524":128287,"_5":14790,"_28264":127960,"_3060":128288},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3604":75195,"_31083":75085,"_21524":128290,"_5":14790,"_28264":127960,"_3060":127987},[],{"_3604":75196,"_31083":75085,"_21524":128292,"_5":14790,"_28264":127960,"_3060":128293},[],"Releases con identidades por servicio o material de claves montado",{"_3604":75197,"_31083":75085,"_21524":128295,"_5":14790,"_28264":127960,"_3060":128296},[],"Media: los servicios no pueden leer sus archivos",{"_3604":75198,"_31083":75085,"_21524":128298,"_5":14790,"_28264":127960,"_3060":128299},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3604":75199,"_31083":75085,"_21524":128301,"_5":14790,"_28264":127960,"_3060":127991},[],{"_3604":75200,"_31083":75085,"_21524":128303,"_5":14790,"_28264":127960,"_3060":128304},[],"Releases que definen `amqp.tls`",{"_3604":75201,"_31083":75085,"_21524":128306,"_5":14790,"_28264":127960,"_3060":128307},[],"Media: los clientes se conectan al puerto equivocado",{"_3604":75202,"_31083":75085,"_21524":128309,"_5":14790,"_28264":127960,"_3060":128310},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3604":75203,"_31083":75085,"_21524":128312,"_5":14790,"_28264":127960,"_3060":128011},[],{"_3604":75204,"_31083":75085,"_21524":128314,"_5":14790,"_28264":127960,"_3060":128315},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3604":75205,"_31083":75085,"_21524":128317,"_5":14790,"_28264":127960,"_3060":128318},[],"Media: las claves de CA quedan sin gestionar",{"_3604":75206,"_31083":75085,"_21524":128320,"_5":14790,"_28264":127960,"_3060":128321},[],"Ejecutar la migración de CA a KMS",{"_3604":75207,"_31083":75085,"_21524":128323,"_5":14790,"_28264":127960,"_3060":128324},[],"Verificación del certificado del receptor",{"_3604":75208,"_31083":75085,"_21524":128326,"_5":14790,"_28264":127960,"_3060":128327},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3604":75209,"_31083":75085,"_21524":128329,"_5":14790,"_28264":127960,"_3060":128330},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3604":75210,"_31083":75085,"_21524":128332,"_5":14790,"_28264":127960,"_3060":128333},[],"Poner `insecure_skip_verify` a `false`",{"_3604":75211,"_31083":75085,"_21524":128335,"_5":14790,"_28264":127960,"_3060":128027},[],{"_3604":75212,"_31083":75085,"_21524":128337,"_5":14790,"_28264":127960,"_3060":128338},[],"Scripts y consolas que editan DMS por API",{"_3604":75213,"_31083":75085,"_21524":128340,"_5":14790,"_28264":127960,"_3060":128341},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3604":75214,"_31083":75085,"_21524":128343,"_5":14790,"_28264":127960,"_3060":128344},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3604":75215,"_31083":75085,"_21524":128346,"_5":14790,"_28264":127960,"_3060":128047},[],{"_3604":75216,"_31083":75085,"_21524":128348,"_5":14790,"_28264":127960,"_3060":128349},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3604":75217,"_31083":75085,"_21524":128351,"_5":14790,"_28264":127960,"_3060":128352},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3604":75218,"_31083":75085,"_21524":128354,"_5":14790,"_28264":127960,"_3060":128355},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3604":75219,"_31083":75085,"_21524":128357,"_5":14790,"_28264":127960,"_3060":128055},[],{"_3604":75220,"_31083":75085,"_21524":128359,"_5":14790,"_28264":127960,"_3060":128360},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3604":75221,"_31083":75085,"_21524":128362,"_5":14790,"_28264":127960,"_3060":128363},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3604":75222,"_31083":75085,"_21524":128365,"_5":14790,"_28264":127960,"_3060":128366},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3604":75223,"_31083":75085,"_21524":128368,"_5":14790,"_28264":127960,"_3060":128043},[],{"_3604":75224,"_31083":75085,"_21524":128370,"_5":14790,"_28264":127960,"_3060":128371},[],"Consumidores que leen el campo `events` del dispositivo",{"_3604":75225,"_31083":75085,"_21524":128373,"_5":14790,"_28264":127960,"_3060":128374},[],"Media: el campo desaparece",{"_3604":75226,"_31083":75085,"_21524":128376,"_5":14790,"_28264":127960,"_3060":128377},[],"Usar los nuevos endpoints de eventos",{"_3604":75227,"_31083":75085,"_21524":128379,"_5":14790,"_28264":127960,"_3060":128067},[],{"_3604":75228,"_31083":75085,"_21524":128381,"_5":14790,"_28264":127960,"_3060":128382},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3604":75229,"_31083":75085,"_21524":128384,"_5":14790,"_28264":127960,"_3060":128385},[],"Media: la migración de la VA aborta",{"_3604":75230,"_31083":75085,"_21524":128387,"_5":14790,"_28264":127960,"_3060":128388},[],"Corregir los roles afectados antes de actualizar",{"_3604":75231,"_31083":75085,"_21524":128390,"_5":14790,"_28264":127960,"_3060":127995},[],{"_3604":75232,"_31083":75085,"_21524":128392,"_5":14790,"_28264":127960,"_3060":128393},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3604":75233,"_31083":75085,"_21524":128395,"_5":14790,"_28264":127960,"_3060":128396},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3604":75234,"_31083":75085,"_21524":128398,"_5":14790,"_28264":127960,"_3060":128399},[],"Actualizar el archivo de values",{"_3604":75235,"_31083":75085,"_21524":128401,"_5":14790,"_28264":127960,"_3060":128035},[],{"_3604":75236,"_31083":75085,"_21524":128403,"_5":14790,"_28264":127960,"_3060":128404},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3604":75237,"_31083":75085,"_21524":128406,"_5":14790,"_28264":127960,"_3060":128407},[],"Baja: prevalece el ID de la URL",{"_3604":75238,"_31083":75085,"_21524":128409,"_5":14790,"_28264":127960,"_3060":128410},[],"Enviar el ID en la URL",{"_3604":75239,"_31083":75085,"_21524":128412,"_5":14790,"_28264":127960,"_3060":128059},[],{"_3604":75240,"_31083":75085,"_21524":128414,"_5":14790,"_28264":127960,"_3060":128415},[],"Clientes que envían un `id` al crear o importar CAs",{"_3604":75241,"_31083":75085,"_21524":128417,"_5":14790,"_28264":127960,"_3060":128418},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3604":75242,"_31083":75085,"_21524":128420,"_5":14790,"_28264":127960,"_3060":128421},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3604":75243,"_31083":75085,"_21524":128423,"_5":14790,"_28264":127960,"_3060":128063},[],{"_3604":75244,"_31083":75085,"_21524":128425,"_5":14790,"_28264":127960,"_3060":128426},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3604":75245,"_31083":75085,"_21524":128428,"_5":14790,"_28264":127960,"_3060":128429},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3604":75246,"_31083":75085,"_21524":128431,"_5":14790,"_28264":127960,"_3060":128432},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3604":75247,"_31083":75085,"_21524":128434,"_5":14790,"_28264":127960,"_3060":128039},[],{"_3604":75248,"_31083":75085,"_21524":128436,"_5":14790,"_28264":127960,"_3060":128437},[],"Consumidores que comparan el `type` del certificado",{"_3604":75249,"_31083":75085,"_21524":128439,"_5":14790,"_28264":127960,"_3060":128440},[],"Baja: dos valores cambian de nombre",{"_3604":75250,"_31083":75085,"_21524":128442,"_5":14790,"_28264":127960,"_3060":128443},[],"Adaptar los consumidores",{"_3604":75251,"_31083":75085,"_21524":128445,"_5":14790,"_28264":127960,"_3060":128031},[],{"_3604":75252,"_31083":75085,"_21524":128447,"_5":14790,"_28264":127960,"_3060":128448},[],"Cualquier DMS",{"_3604":75253,"_31083":75085,"_21524":128450,"_5":14790,"_28264":127960,"_3060":128451},[],"Baja: solo informativo",{"_3604":75254,"_31083":75085,"_21524":128453,"_5":14790,"_28264":127960,"_3060":128454},[],"Revisar ambos bloques antes de editar",{"_3604":75255,"_31083":75085,"_21524":128456,"_5":14790,"_28264":127967,"_3060":128457},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3604":75256,"_31083":75085,"_21524":128459,"_5":14790,"_28264":127967,"_3060":128460},[],"El paso 4 de la guía de migración copia los datos.",{"_3604":75257,"_31083":75085,"_21524":128462,"_5":14790,"_28264":127971,"_3060":128463},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3604":75258,"_31083":75085,"_21524":128465,"_5":14790,"_28264":127975,"_3060":128466},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3604":75259,"_31083":75085,"_21524":128468,"_5":14790,"_28264":127975,"_3060":128469},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3604":75260,"_31083":75085,"_21524":128471,"_5":14790,"_28264":127978,"_3060":128472},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3604":75261,"_31083":75085,"_21524":128474,"_5":14790,"_28264":127982,"_3060":128475},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3604":75262,"_31083":75085,"_21524":128477,"_5":14790,"_28264":127986,"_3060":128478},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3604":75263,"_31083":75085,"_21524":128480,"_5":14790,"_28264":127986,"_3060":128481},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3604":75264,"_31083":75085,"_21524":128483,"_5":14790,"_28264":127986,"_3060":128484},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3604":75265,"_31083":75085,"_21524":128486,"_5":14790,"_28264":127990,"_3060":128487},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3604":75266,"_31083":75085,"_21524":128489,"_5":14790,"_28264":127994,"_3060":128490},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3604":75267,"_31083":75085,"_21524":128492,"_5":14790,"_28264":127994,"_3060":128493},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3604":75268,"_31083":75085,"_21524":128495,"_5":14790,"_28264":127994,"_3060":128496},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3604":75269,"_31083":75085,"_21524":128498,"_5":14790,"_28264":127994,"_3060":128499},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3604":75270,"_31083":75085,"_21524":128501,"_5":14790,"_28264":127994,"_3060":128502},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3604":75271,"_31083":75085,"_21524":128504,"_5":14790,"_28264":127994,"_3060":128505},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3604":75272,"_31083":75085,"_21524":128507,"_5":14790,"_28264":128002,"_3060":128508},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3604":75273,"_31083":75085,"_21524":128510,"_5":14790,"_28264":128002,"_3060":128511},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3604":75274,"_31083":75085,"_21524":128513,"_5":14790,"_28264":128002,"_3060":128514},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3604":75275,"_31083":75085,"_21524":128516,"_5":14790,"_28264":128002,"_3060":128517},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3604":75276,"_31083":75085,"_21524":128519,"_5":14790,"_28264":128002,"_3060":128520},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3604":75277,"_31083":75085,"_21524":128522,"_5":14790,"_28264":128006,"_3060":128523},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3604":75278,"_31083":75085,"_21524":128525,"_5":14790,"_28264":128010,"_3060":128526},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3604":75279,"_31083":75085,"_21524":128528,"_5":14790,"_28264":128010,"_3060":128529},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3604":75280,"_31083":75085,"_21524":128531,"_5":14790,"_28264":128010,"_3060":128532},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3604":75281,"_31083":75085,"_21524":128534,"_5":14790,"_28264":128010,"_3060":128535},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3604":75282,"_31083":75085,"_21524":128537,"_5":14790,"_28264":128010,"_3060":128538},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3604":75283,"_31083":75085,"_21524":128540,"_5":14790,"_28264":128010,"_3060":128541},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3604":75284,"_31083":75085,"_21524":128543,"_5":14790,"_28264":128010,"_3060":128544},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3604":75285,"_31083":75085,"_21524":128546,"_5":14790,"_28264":128010,"_3060":128547},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3604":75286,"_31083":75085,"_21524":128549,"_5":14790,"_28264":128014,"_3060":128550},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3604":75287,"_31083":75085,"_21524":128552,"_5":14790,"_28264":128022,"_3060":128553},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3604":75288,"_31083":75085,"_21524":128555,"_5":14790,"_28264":128022,"_3060":128556},[],"Campo en 3.8.0",{"_3604":75289,"_31083":75085,"_21524":128558,"_5":14790,"_28264":128022,"_3060":128559},[],"Campo en 4.0.0",{"_3604":75290,"_31083":75085,"_21524":128561,"_5":14790,"_28264":128022,"_3060":59770},[],{"_3604":75291,"_31083":75085,"_21524":128563,"_5":14790,"_28264":128022,"_3060":128564},[],"`insecure_skip_verify` (con el valor negado)",{"_3604":75292,"_31083":75085,"_21524":128566,"_5":14790,"_28264":128022,"_3060":59776},[],{"_3604":75293,"_31083":75085,"_21524":128568,"_5":14790,"_28264":128022,"_3060":59779},[],{"_3604":75294,"_31083":75085,"_21524":128570,"_5":14790,"_28264":128022,"_3060":59782},[],{"_3604":75295,"_31083":75085,"_21524":128572,"_5":14790,"_28264":128022,"_3060":59785},[],{"_3604":75296,"_31083":75085,"_21524":128574,"_5":14790,"_28264":128022,"_3060":59788},[],{"_3604":75297,"_31083":75085,"_21524":128576,"_5":14790,"_28264":128022,"_3060":59791},[],{"_3604":75298,"_31083":75085,"_21524":128578,"_5":14790,"_28264":128022,"_3060":128579},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3604":75299,"_31083":75085,"_21524":128581,"_5":14790,"_28264":128022,"_3060":128582},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3604":75300,"_31083":75085,"_21524":128584,"_5":14790,"_28264":128022,"_3060":128585},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3604":75301,"_31083":75085,"_21524":128587,"_5":14790,"_28264":128026,"_3060":128588},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3604":75302,"_31083":75085,"_21524":128590,"_5":14790,"_28264":128026,"_3060":128591},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3604":75303,"_31083":75085,"_21524":128593,"_5":14790,"_28264":128026,"_3060":128594},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3604":75304,"_31083":75085,"_21524":128596,"_5":14790,"_28264":128030,"_3060":128597},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3604":75305,"_31083":75085,"_21524":128599,"_5":14790,"_28264":128034,"_3060":128600},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3604":75306,"_31083":75085,"_21524":128602,"_5":14790,"_28264":128038,"_3060":128603},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3604":75307,"_31083":75085,"_21524":128605,"_5":14790,"_28264":128042,"_3060":128606},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3604":75308,"_31083":75085,"_21524":128608,"_5":14790,"_28264":128042,"_3060":128609},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3604":75309,"_31083":75085,"_21524":128611,"_5":14790,"_28264":128042,"_3060":128612},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3604":75310,"_31083":75085,"_21524":128614,"_5":14790,"_28264":128042,"_3060":128615},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3604":75311,"_31083":75085,"_21524":128617,"_5":14790,"_28264":128046,"_3060":128618},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3604":75312,"_31083":75085,"_21524":128620,"_5":14790,"_28264":128050,"_3060":128621},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3604":75313,"_31083":75085,"_21524":128623,"_5":14790,"_28264":128050,"_3060":128624},[],"Ruta",{"_3604":75314,"_31083":75085,"_21524":128626,"_5":14790,"_28264":128050,"_3060":120984},[],{"_3604":75315,"_31083":75085,"_21524":128628,"_5":14790,"_28264":128050,"_3060":59844},[],{"_3604":75316,"_31083":75085,"_21524":128630,"_5":14790,"_28264":128050,"_3060":128631},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3604":75317,"_31083":75085,"_21524":128633,"_5":14790,"_28264":128050,"_3060":59850},[],{"_3604":75318,"_31083":75085,"_21524":128635,"_5":14790,"_28264":128050,"_3060":128636},[],"Lee los ajustes de una CA.",{"_3604":75319,"_31083":75085,"_21524":128638,"_5":14790,"_28264":128050,"_3060":59856},[],{"_3604":75320,"_31083":75085,"_21524":128640,"_5":14790,"_28264":128050,"_3060":128641},[],"Sustituye los `crl_options`.",{"_3604":75321,"_31083":75085,"_21524":128643,"_5":14790,"_28264":128050,"_3060":59862},[],{"_3604":75322,"_31083":75085,"_21524":128645,"_5":14790,"_28264":128050,"_3060":128646},[],"Elimina los ajustes archivados de una CA.",{"_3604":75323,"_31083":75085,"_21524":128648,"_5":14790,"_28264":128050,"_3060":128649},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3604":75324,"_31083":75085,"_21524":128651,"_5":14790,"_28264":128050,"_3060":128652},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3604":75325,"_31083":75085,"_21524":128654,"_5":14790,"_28264":128050,"_3060":128655},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3604":75326,"_31083":75085,"_21524":128657,"_5":14790,"_28264":128050,"_3060":128658},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3604":75327,"_31083":75085,"_21524":128660,"_5":14790,"_28264":128050,"_3060":128661},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3604":75328,"_31083":75085,"_21524":128663,"_5":14790,"_28264":128050,"_3060":128664},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3604":75329,"_31083":75085,"_21524":128666,"_5":14790,"_28264":128050,"_3060":128667},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3604":75330,"_31083":75085,"_21524":128669,"_5":14790,"_28264":128050,"_3060":128670},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3604":75331,"_31083":75085,"_21524":128672,"_5":14790,"_28264":128050,"_3060":128673},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3604":75332,"_31083":75085,"_21524":128675,"_5":14790,"_28264":128050,"_3060":128676},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3604":75333,"_31083":75085,"_21524":128678,"_5":14790,"_28264":128050,"_3060":128679},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3604":75334,"_31083":75085,"_21524":128681,"_5":14790,"_28264":128054,"_3060":128682},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3604":75335,"_31083":75085,"_21524":128684,"_5":14790,"_28264":128058,"_3060":128685},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3604":75336,"_31083":75085,"_21524":128687,"_5":14790,"_28264":128062,"_3060":128688},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3604":75337,"_31083":75085,"_21524":128690,"_5":14790,"_28264":128062,"_3060":128691},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3604":75338,"_31083":75085,"_21524":128693,"_5":14790,"_28264":128066,"_3060":128694},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3604":75339,"_31083":75085,"_21524":128696,"_5":14790,"_28264":128070,"_3060":128697},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3604":75340,"_31083":75085,"_21524":128699,"_5":14790,"_28264":128074,"_3060":128700},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3604":75341,"_31083":75085,"_21524":128702,"_5":14790,"_28264":128074,"_3060":128703},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3604":75342,"_31083":75085,"_21524":128705,"_5":14790,"_28264":128074,"_3060":128706},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3604":75343,"_31083":75085,"_21524":128708,"_5":14790,"_28264":128074,"_3060":128709},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3604":75344,"_31083":75085,"_21524":128711,"_5":14790,"_28264":128074,"_3060":128712},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3604":75345,"_31083":75085,"_21524":128714,"_5":14790,"_28264":128074,"_3060":128715},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3604":75346,"_31083":75085,"_21524":128717,"_5":14790,"_28264":128078,"_3060":128718},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3604":75347,"_31083":75085,"_21524":128720,"_5":14790,"_28264":128078,"_3060":128721},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3604":75348,"_31083":75085,"_21524":128723,"_5":14790,"_28264":128078,"_3060":128724},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3604":75349,"_31083":75085,"_21524":128726,"_5":14790,"_28264":128078,"_3060":128727},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3604":75350,"_31083":75085,"_21524":128729,"_5":14790,"_28264":128078,"_3060":128730},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3604":75351,"_31083":75085,"_21524":128732,"_5":14790,"_28264":128082,"_3060":128733},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3604":75352,"_31083":75085,"_21524":128735,"_5":14790,"_28264":128082,"_3060":128736},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3604":75353,"_31083":75085,"_21524":128738,"_5":14790,"_28264":128082,"_3060":128739},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3604":75354,"_31083":75085,"_21524":128741,"_5":14790,"_28264":128082,"_3060":59961},[],{"_3604":75355,"_31083":75085,"_21524":128743,"_5":14790,"_28264":128082,"_3060":128744},[],"Claves de datos obligatorias",{"_3604":75356,"_31083":75085,"_21524":128746,"_5":14790,"_28264":128082,"_3060":128747},[],"Cuándo",{"_3604":75357,"_31083":75085,"_21524":128749,"_5":14790,"_28264":128082,"_3060":128750},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3604":75358,"_31083":75085,"_21524":128752,"_5":14790,"_28264":128082,"_3060":59973},[],{"_3604":75359,"_31083":75085,"_21524":128754,"_5":14790,"_28264":128082,"_3060":128755},[],"Siempre",{"_3604":75360,"_31083":75085,"_21524":128757,"_5":14790,"_28264":128082,"_3060":128758},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3604":75361,"_31083":75085,"_21524":128760,"_5":14790,"_28264":128082,"_3060":59973},[],{"_3604":75362,"_31083":75085,"_21524":128762,"_5":14790,"_28264":128082,"_3060":128755},[],{"_3604":75363,"_31083":75085,"_21524":128764,"_5":14790,"_28264":128082,"_3060":59986},[],{"_3604":75364,"_31083":75085,"_21524":128766,"_5":14790,"_28264":128082,"_3060":59973},[],{"_3604":75365,"_31083":75085,"_21524":128768,"_5":14790,"_28264":128082,"_3060":128769},[],"Solo cuando hay autenticación SMTP",{"_3604":75366,"_31083":75085,"_21524":128771,"_5":14790,"_28264":128082,"_3060":128772},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3604":75367,"_31083":75085,"_21524":128774,"_5":14790,"_28264":128082,"_3060":128775},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3604":75368,"_31083":75085,"_21524":128777,"_5":14790,"_28264":128082,"_3060":128778},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3604":75369,"_31083":75085,"_21524":128780,"_5":14790,"_28264":128082,"_3060":128781},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3604":75370,"_31083":75085,"_21524":128783,"_5":14790,"_28264":128082,"_3060":128784},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3604":75371,"_31083":75085,"_21524":128786,"_5":14790,"_28264":128082,"_3060":128787},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3604":75372,"_31083":75085,"_21524":128789,"_5":14790,"_28264":128082,"_3060":128790},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3604":75373,"_31083":75085,"_21524":128792,"_5":14790,"_28264":128082,"_3060":128793},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3604":75374,"_31083":75085,"_21524":128795,"_5":14790,"_28264":128082,"_3060":128796},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3604":75375,"_31083":75085,"_21524":128798,"_5":14790,"_28264":128082,"_3060":128799},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3604":75376,"_31083":75085,"_21524":128801,"_5":14790,"_28264":128082,"_3060":128802},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3604":75377,"_31083":75085,"_21524":128804,"_5":14790,"_28264":128082,"_3060":128805},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3604":75378,"_31083":75085,"_21524":128807,"_5":14790,"_28264":128082,"_3060":128808},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3604":75379,"_31083":75085,"_21524":128810,"_5":14790,"_28264":128082,"_3060":128811},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3604":75380,"_31083":75085,"_21524":128813,"_5":14790,"_28264":128082,"_3060":128814},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3604":75381,"_31083":75085,"_21524":128816,"_5":14790,"_28264":128086,"_3060":128817},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3604":75382,"_31083":75085,"_21524":128819,"_5":14790,"_28264":128086,"_3060":128820},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3604":75383,"_31083":75085,"_21524":128822,"_5":14790,"_28264":128090,"_3060":128823},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3604":75384,"_31083":75085,"_21524":128825,"_5":14790,"_28264":128090,"_3060":128826},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3604":75385,"_31083":75085,"_21524":128828,"_5":14790,"_28264":128090,"_3060":128829},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3604":75386,"_31083":75085,"_21524":128831,"_5":14790,"_28264":128090,"_3060":128832},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3604":75387,"_31083":75085,"_21524":128834,"_5":14790,"_28264":128090,"_3060":128835},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3604":75388,"_31083":75085,"_21524":128837,"_5":14790,"_28264":128090,"_3060":128838},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3604":75389,"_31083":75085,"_21524":128840,"_5":14790,"_28264":128090,"_3060":128841},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3604":75390,"_31083":75085,"_21524":128843,"_5":14790,"_28264":128090,"_3060":128844},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3604":75391,"_31083":75085,"_21524":128846,"_5":14790,"_28264":128090,"_3060":128847},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3604":75392,"_31083":75085,"_21524":128849,"_5":14790,"_28264":128090,"_3060":128850},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3604":75393,"_31083":75085,"_21524":128852,"_5":14790,"_28264":128090,"_3060":128853},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3604":75394,"_31083":75085,"_21524":128855,"_5":14790,"_28264":128094,"_3060":128856},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3604":75395,"_31083":75085,"_21524":128858,"_5":14790,"_28264":128094,"_3060":128859},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3604":75396,"_31083":75085,"_21524":128861,"_5":14790,"_28264":128098,"_3060":128862},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3604":75397,"_31083":75085,"_21524":128864,"_5":14790,"_28264":128098,"_3060":128865},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3604":75398,"_31083":75085,"_21524":128867,"_5":14790,"_28264":128098,"_3060":128868},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3604":75399,"_31083":75085,"_21524":128870,"_5":14790,"_28264":128098,"_3060":128871},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3604":75400,"_31083":75085,"_21524":128873,"_5":14790,"_28264":128098,"_3060":128874},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3604":75401,"_31083":75085,"_21524":128876,"_5":14790,"_28264":128098,"_3060":128877},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3604":75402,"_31083":75085,"_21524":128879,"_5":14790,"_28264":128098,"_3060":128880},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3604":75403,"_31083":75085,"_21524":128882,"_5":14790,"_28264":128098,"_3060":128883},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3604":75404,"_31083":75085,"_21524":128885,"_5":14790,"_28264":128102,"_3060":128886},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3604":75405,"_31083":75085,"_21524":128888,"_5":14790,"_28264":128102,"_3060":128889},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3604":75406,"_31083":75085,"_21524":128891,"_5":14790,"_28264":128102,"_3060":128892},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3604":75407,"_31083":75085,"_21524":128894,"_5":14790,"_28264":128102,"_3060":128895},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3604":75408,"_31083":75085,"_21524":128897,"_5":14790,"_28264":128102,"_3060":128898},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3604":75409,"_31083":75085,"_21524":128900,"_5":14790,"_28264":128102,"_3060":128901},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3604":75410,"_31083":75085,"_21524":128903,"_5":14790,"_28264":128102,"_3060":128904},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3604":75411,"_31083":75085,"_21524":128906,"_5":14790,"_28264":128102,"_3060":128907},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3604":75412,"_31083":75085,"_21524":128909,"_5":14790,"_28264":128102,"_3060":128910},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3604":75413,"_31083":75085,"_21524":128912,"_5":14790,"_28264":128102,"_3060":128913},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3604":75414,"_31083":75085,"_21524":128915,"_5":14790,"_28264":128102,"_3060":128916},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3604":75415,"_31083":75085,"_21524":128918,"_5":14790,"_28264":128105,"_3060":128919},[],"Tras la actualización, comprueba en este orden:",{"_3604":75416,"_31083":75085,"_21524":128921,"_5":14790,"_28264":128105,"_3060":128922},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3604":75417,"_31083":75085,"_21524":128924,"_5":14790,"_28264":128105,"_3060":128925},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3604":75418,"_31083":75085,"_21524":128927,"_5":14790,"_28264":128105,"_3060":128928},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3604":75419,"_31083":75085,"_21524":128930,"_5":14790,"_28264":128105,"_3060":128931},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3604":75420,"_31083":75085,"_21524":128933,"_5":14790,"_28264":128105,"_3060":128934},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3604":75421,"_31083":75085,"_21524":128936,"_5":14790,"_28264":128105,"_3060":128937},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3604":75422,"_31083":75085,"_21524":128939,"_5":14790,"_28264":128105,"_3060":128940},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3604":75423,"_31083":75085,"_21524":128942,"_5":14790,"_28264":128105,"_3060":128943},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3604":75424,"_31083":75085,"_21524":128945,"_5":14790,"_28264":128105,"_3060":128946},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3604":75425,"_31083":75085,"_21524":128948,"_5":14790,"_28264":128105,"_3060":128949},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3604":75426,"_31083":75085,"_21524":128951,"_5":14790,"_28264":128105,"_3060":128952},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3604":75427,"_31083":75085,"_21524":128954,"_5":14790,"_28264":128105,"_3060":128955},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3604":75428,"_31083":75085,"_21524":128957,"_5":14790,"_28264":128105,"_3060":128958},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3604":75429,"_31083":75085,"_21524":128960,"_5":14790,"_28264":128105,"_3060":128961},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3604":75430,"_31083":75085,"_21524":128963,"_5":14790,"_28264":128105,"_3060":128964},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3604":75431,"_31083":75085,"_21524":128966,"_5":14790,"_28264":128109,"_3060":128967},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3604":75432,"_31083":75085,"_21524":128969,"_5":14790,"_28264":128109,"_3060":128970},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3604":75433,"_31083":75085,"_21524":128972,"_5":14790,"_28264":128109,"_3060":128973},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3604":75434,"_31083":75085,"_21524":128975,"_5":14790,"_28264":128109,"_3060":128976},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3604":75435,"_31083":75085,"_21524":128978,"_5":14790,"_28264":128109,"_3060":128979},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60204":128981,"_60206":128982,"_60208":128983,"_60210":128984,"_18649":3095,"_72389":3095},"spanish",[3060,31083,5,28264],{"_3060":25699,"_31083":25699,"_5":25699,"_28264":25699},{"_3060":128985,"_31083":132028,"_5":135071,"_28264":138114},{"_4802":128986,"_60214":128987,"_5":25699},{"_14871":7193,"_15250":7739,"_15269":7170,"_30082":3905,"_15256":4188,"_20431":3351,"_14892":5340,"_14899":13260,"_30024":7936,"_30438":4211,"_30459":7310,"_30058":3837,"_35450":5127,"_30161":20917,"_30503":10165,"_35457":5423,"_35460":4122,"_35463":7257,"_35466":3349,"_30905":13823,"_35471":4880,"_35473":26095,"_30940":11945,"_15265":19028,"_35477":7768,"_35480":10773,"_35482":5866,"_30487":3870,"_30925":12206,"_30953":7505,"_35487":7754,"_35489":12686,"_35491":17077,"_30178":7941,"_35494":3454,"_35496":7175,"_35498":3439,"_35500":8997,"_35502":3462,"_30095":7255,"_35505":3419,"_35507":5005,"_30089":14457,"_30524":10706,"_35511":27856,"_35513":14580,"_35516":4546,"_30135":4700,"_35520":8437,"_30015":6174,"_35523":11470,"_30063":25065,"_35526":10036,"_35528":4212,"_35531":11662,"_15259":19084,"_35534":9343,"_35536":3170,"_35539":26706,"_35541":6848,"_35543":7267,"_35545":6504,"_35547":23522,"_20434":3453,"_35550":10800,"_35552":3814,"_30036":6211,"_30481":6187,"_35556":10467,"_35558":4292,"_35560":7620,"_30970":3461,"_35563":3772,"_35565":7163,"_35567":6701,"_31063":3686,"_30540":13297,"_35571":3124,"_35573":3369,"_30073":17507,"_35576":7169,"_35578":14672,"_35580":3671,"_30986":6034,"_30155":11656,"_29535":13780,"_35585":7557,"_35587":26823,"_35589":4941,"_30204":18651,"_35593":7231,"_30475":19715,"_35597":12239,"_35599":3512,"_35601":3470,"_35603":4889,"_35605":7660,"_35607":7180,"_30193":10972,"_30443":5615,"_35611":3335,"_35613":6502,"_35615":5739,"_35618":11696,"_35620":12105,"_35622":9342,"_35624":3309,"_35626":7820,"_35628":9106,"_35630":4352,"_35633":6938,"_35635":24423,"_35637":8818,"_35639":5305,"_35641":3356,"_35644":6206,"_35646":24843,"_35649":21667,"_35652":21748,"_35654":5261,"_35656":6526,"_35658":4066,"_35660":5100,"_35662":50720,"_35664":4307,"_35666":7146,"_3