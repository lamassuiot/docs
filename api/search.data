4,"_41563":129517,"_41565":129520,"_41567":129523,"_41569":129526,"_41571":129529,"_41573":129532,"_41575":129535,"_41577":129538,"_41579":129541,"_41581":129544,"_41583":129547,"_41585":129550,"_41587":129553,"_41589":129556,"_41591":129559,"_41594":129562,"_41596":129565,"_41598":129568,"_41600":129571,"_41602":129574,"_41604":129577,"_41606":129580,"_41608":129583,"_41610":129586,"_41612":129589,"_41614":129592,"_41616":129595,"_41618":129598,"_41620":129601,"_41623":129604,"_41625":129607,"_41627":129610,"_41629":129613,"_41631":129616,"_41633":129619,"_41635":129622,"_41637":129625,"_41639":129628,"_41641":129631,"_41643":129634,"_41645":129637,"_41647":129640,"_41649":129643,"_41651":129646,"_41653":129649,"_41655":129652,"_41657":129655,"_41659":129658,"_41661":129661,"_41663":129664,"_41665":129667,"_41667":129670,"_41669":129673,"_41671":129676,"_41673":129679,"_41675":129682,"_41677":129685,"_41679":129688,"_41681":129691,"_41683":129694,"_41685":129697,"_41688":129700,"_41690":129703,"_41692":129706},{"_3632":72790,"_31184":72790,"_5":15230,"_3083":120407,"_31522":120408,"_21603":120411,"_28376":72790},"Despliega desde AWS Marketplace",[50964,120409,120410],"Despliegue","Otros modelos",[],{"_3632":72791,"_31184":72790,"_21603":120413,"_5":14870,"_28376":72790,"_3083":120414},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3632":72792,"_31184":72790,"_5":31519,"_21603":120416,"_28376":120417,"_3083":120418},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3632":72793,"_31184":72790,"_5":31519,"_21603":120420,"_28376":120421,"_3083":120422},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3632":72794,"_31184":72790,"_5":31519,"_21603":120424,"_28376":120425,"_3083":120426},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3632":72795,"_31184":72790,"_5":31519,"_21603":120428,"_28376":120429,"_3083":120430},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3632":72796,"_31184":72790,"_5":31519,"_21603":120432,"_28376":120433,"_3083":120434},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3632":72797,"_31184":72790,"_5":31519,"_21603":120436,"_28376":120437,"_3083":120438},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3632":72798,"_31184":72790,"_5":31519,"_21603":120440,"_28376":120441,"_3083":120442},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3632":72799,"_31184":72790,"_21603":120444,"_5":14870,"_28376":72790,"_3083":120445},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3632":72800,"_31184":72790,"_21603":120447,"_5":14870,"_28376":120417,"_3083":120448},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3632":72801,"_31184":72790,"_21603":120450,"_5":14870,"_28376":120417,"_3083":120451},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3632":72802,"_31184":72790,"_21603":120453,"_5":14870,"_28376":120417,"_3083":120454},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3632":72803,"_31184":72790,"_21603":120456,"_5":14870,"_28376":120421,"_3083":120457},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3632":72804,"_31184":72790,"_21603":120459,"_5":14870,"_28376":120421,"_3083":120460},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3632":72805,"_31184":72790,"_21603":120462,"_5":14870,"_28376":120421,"_3083":120463},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3632":72806,"_31184":72790,"_21603":120465,"_5":14870,"_28376":120425,"_3083":120466},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3632":72807,"_31184":72790,"_21603":120468,"_5":14870,"_28376":120429,"_3083":120469},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3632":72808,"_31184":72790,"_21603":120471,"_5":14870,"_28376":120433,"_3083":120472},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3632":72809,"_31184":72790,"_21603":120474,"_5":14870,"_28376":120437,"_3083":120475},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3632":72810,"_31184":72790,"_21603":120477,"_5":14870,"_28376":120441,"_3083":120478},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3632":72811,"_31184":72811,"_5":15230,"_3083":120480,"_31522":120481,"_21603":120482,"_28376":72811},"Despliega Lamassu",[50964,120409],[],{"_3632":72812,"_31184":72811,"_21603":120484,"_5":14870,"_28376":72811,"_3083":120485},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3632":72813,"_31184":72811,"_5":31519,"_21603":120487,"_28376":120488,"_3083":120489},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3632":72814,"_31184":72811,"_5":31519,"_21603":120491,"_28376":120492,"_3083":120493},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3632":72815,"_31184":72811,"_5":31519,"_21603":120495,"_28376":120496,"_3083":120497},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3632":72816,"_31184":72811,"_21603":120499,"_5":14870,"_28376":72811,"_3083":120500},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3632":72817,"_31184":72811,"_21603":120502,"_5":14870,"_28376":120488,"_3083":120503},[],"Modelo",{"_3632":72818,"_31184":72811,"_21603":120505,"_5":14870,"_28376":120488,"_3083":120506},[],"Recomendado para",{"_3632":72819,"_31184":72811,"_21603":120508,"_5":14870,"_28376":120488,"_3083":120509},[],"Quién opera la infraestructura",{"_3632":72820,"_31184":72811,"_21603":120511,"_5":14870,"_28376":120488,"_3083":120512},[],"Punto de partida",{"_3632":72821,"_31184":72811,"_21603":120514,"_5":14870,"_28376":120488,"_3083":51071},[],{"_3632":72822,"_31184":72811,"_21603":120516,"_5":14870,"_28376":120488,"_3083":120517},[],"Producción, entornos regulados y despliegues personalizados",{"_3632":72823,"_31184":72811,"_21603":120519,"_5":14870,"_28376":120488,"_3083":120520},[],"Tu equipo",{"_3632":72824,"_31184":72811,"_21603":120522,"_5":14870,"_28376":120488,"_3083":120523},[],"Helm o Fastlane",{"_3632":72825,"_31184":72811,"_21603":120525,"_5":14870,"_28376":120488,"_3083":51083},[],{"_3632":72826,"_31184":72811,"_21603":120527,"_5":14870,"_28376":120488,"_3083":120528},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3632":72827,"_31184":72811,"_21603":120530,"_5":14870,"_28376":120488,"_3083":120520},[],{"_3632":72828,"_31184":72811,"_21603":120532,"_5":14870,"_28376":120488,"_3083":120533},[],"Imagen preconfigurada en EC2",{"_3632":72829,"_31184":72811,"_21603":120535,"_5":14870,"_28376":120488,"_3083":51094},[],{"_3632":72830,"_31184":72811,"_21603":120537,"_5":14870,"_28376":120488,"_3083":120538},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3632":72831,"_31184":72811,"_21603":120540,"_5":14870,"_28376":120488,"_3083":51100},[],{"_3632":72832,"_31184":72811,"_21603":120542,"_5":14870,"_28376":120488,"_3083":120543},[],"Suscripción gestionada",{"_3632":72833,"_31184":72811,"_21603":120545,"_5":14870,"_28376":120488,"_3083":120546},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3632":72834,"_31184":72811,"_21603":120548,"_5":14870,"_28376":120488,"_3083":120549},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3632":72835,"_31184":72811,"_21603":120551,"_5":14870,"_28376":120488,"_3083":120552},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3632":72836,"_31184":72811,"_21603":120554,"_5":14870,"_28376":120492,"_3083":120555},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3632":72837,"_31184":72811,"_21603":120557,"_5":14870,"_28376":120496,"_3083":120558},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3632":72838,"_31184":72838,"_5":15230,"_3083":120560,"_31522":120561,"_21603":120562,"_28376":72838},"Utiliza Lamassu como SaaS",[50964,120409,120410],[],{"_3632":72839,"_31184":72838,"_21603":120564,"_5":14870,"_28376":72838,"_3083":120565},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3632":72840,"_31184":72838,"_5":31519,"_21603":120567,"_28376":120568,"_3083":120569},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3632":72841,"_31184":72838,"_5":31519,"_21603":120571,"_28376":120572,"_3083":120573},[],"/docs/es/deployment/saas#planes","Planes",{"_3632":72842,"_31184":72838,"_5":31519,"_21603":120575,"_28376":120576,"_3083":120577},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3632":72843,"_31184":72838,"_21603":120579,"_5":14870,"_28376":72838,"_3083":120580},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3632":72844,"_31184":72838,"_21603":120582,"_5":14870,"_28376":120568,"_3083":120583},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3632":72845,"_31184":72838,"_21603":120585,"_5":14870,"_28376":120568,"_3083":120586},[],"Copias de seguridad automáticas.",{"_3632":72846,"_31184":72838,"_21603":120588,"_5":14870,"_28376":120568,"_3083":120589},[],"Actualizaciones de versión.",{"_3632":72847,"_31184":72838,"_21603":120591,"_5":14870,"_28376":120568,"_3083":120592},[],"Soporte técnico y SLA según el plan contratado.",{"_3632":72848,"_31184":72838,"_21603":120594,"_5":14870,"_28376":120572,"_3083":51155},[],{"_3632":72849,"_31184":72838,"_21603":120596,"_5":14870,"_28376":120572,"_3083":120597},[],"Dispositivos",{"_3632":72850,"_31184":72838,"_21603":120599,"_5":14870,"_28376":120572,"_3083":120600},[],"Soporte",{"_3632":72851,"_31184":72838,"_21603":120602,"_5":14870,"_28376":120572,"_3083":51164},[],{"_3632":72852,"_31184":72838,"_21603":120604,"_5":14870,"_28376":120572,"_3083":51167},[],{"_3632":72853,"_31184":72838,"_21603":120606,"_5":14870,"_28376":120572,"_3083":120607},[],"Hasta 1.000",{"_3632":72854,"_31184":72838,"_21603":120609,"_5":14870,"_28376":120572,"_3083":51173},[],{"_3632":72855,"_31184":72838,"_21603":120611,"_5":14870,"_28376":120572,"_3083":120612},[],"99,5 %",{"_3632":72856,"_31184":72838,"_21603":120614,"_5":14870,"_28376":120572,"_3083":51179},[],{"_3632":72857,"_31184":72838,"_21603":120616,"_5":14870,"_28376":120572,"_3083":120617},[],"Hasta 10.000",{"_3632":72858,"_31184":72838,"_21603":120619,"_5":14870,"_28376":120572,"_3083":120620},[],"Email y chat",{"_3632":72859,"_31184":72838,"_21603":120622,"_5":14870,"_28376":120572,"_3083":120623},[],"99,9 %",{"_3632":72860,"_31184":72838,"_21603":120625,"_5":14870,"_28376":120572,"_3083":51191},[],{"_3632":72861,"_31184":72838,"_21603":120627,"_5":14870,"_28376":120572,"_3083":120628},[],"Ilimitados",{"_3632":72862,"_31184":72838,"_21603":120630,"_5":14870,"_28376":120572,"_3083":120631},[],"Dedicado",{"_3632":72863,"_31184":72838,"_21603":120633,"_5":14870,"_28376":120572,"_3083":120634},[],"99,99 %",{"_3632":72864,"_31184":72838,"_21603":120636,"_5":14870,"_28376":120576,"_3083":120637},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3632":72865,"_31184":72838,"_21603":120639,"_5":14870,"_28376":120576,"_3083":120640},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3632":72866,"_31184":72866,"_5":15230,"_3083":51208,"_31522":120642,"_21603":120644,"_28376":72866},[50964,120409,120643],"Kubernetes autogestionado",[],{"_3632":72867,"_31184":72866,"_21603":120646,"_5":14870,"_28376":72866,"_3083":120647},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3632":72868,"_31184":72866,"_5":31519,"_21603":120649,"_28376":120650,"_3083":120651},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3632":72869,"_31184":72866,"_5":31519,"_21603":120653,"_28376":120654,"_3083":120655},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3632":72870,"_31184":72866,"_5":31519,"_21603":120657,"_28376":120658,"_3083":120659},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3632":72871,"_31184":72866,"_5":31519,"_21603":120661,"_28376":120662,"_3083":120663},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3632":72872,"_31184":72866,"_5":31519,"_21603":120665,"_28376":120666,"_3083":120667},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3632":72873,"_31184":72866,"_5":31519,"_21603":120669,"_28376":120670,"_3083":120671},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3632":72874,"_31184":72866,"_5":31519,"_21603":120673,"_28376":120674,"_3083":120675},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3632":72875,"_31184":72866,"_5":31519,"_21603":120677,"_28376":120678,"_3083":120679},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3632":72876,"_31184":72866,"_5":31519,"_21603":120681,"_28376":120682,"_3083":120683},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3632":72877,"_31184":72866,"_5":31519,"_21603":120685,"_28376":120686,"_3083":120687},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3632":72878,"_31184":72866,"_5":31519,"_21603":120689,"_28376":120690,"_3083":120691},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3632":72879,"_31184":72866,"_21603":120693,"_5":14870,"_28376":120650,"_3083":120694},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3632":72880,"_31184":72866,"_21603":120696,"_5":14870,"_28376":120650,"_3083":120697},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3632":72881,"_31184":72866,"_21603":120699,"_5":14870,"_28376":120654,"_3083":120700},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3632":72882,"_31184":72866,"_21603":120702,"_5":14870,"_28376":120654,"_3083":120703},[],"Fastlane instala o configura",{"_3632":72883,"_31184":72866,"_21603":120705,"_5":14870,"_28376":120654,"_3083":120706},[],"Tú sigues proporcionando",{"_3632":72884,"_31184":72866,"_21603":120708,"_5":14870,"_28376":120654,"_3083":120709},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3632":72885,"_31184":72866,"_21603":120711,"_5":14870,"_28376":120654,"_3083":120712},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3632":72886,"_31184":72866,"_21603":120714,"_5":14870,"_28376":120654,"_3083":120715},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3632":72887,"_31184":72866,"_21603":120717,"_5":14870,"_28376":120654,"_3083":120718},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3632":72888,"_31184":72866,"_21603":120720,"_5":14870,"_28376":120654,"_3083":120721},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3632":72889,"_31184":72866,"_21603":120723,"_5":14870,"_28376":120654,"_3083":120724},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3632":72890,"_31184":72866,"_21603":120726,"_5":14870,"_28376":120654,"_3083":120727},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3632":72891,"_31184":72866,"_21603":120729,"_5":14870,"_28376":120654,"_3083":120730},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3632":72892,"_31184":72866,"_21603":120732,"_5":14870,"_28376":120654,"_3083":120733},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3632":72893,"_31184":72866,"_21603":120735,"_5":14870,"_28376":120658,"_3083":120736},[],"Necesitas:",{"_3632":72894,"_31184":72866,"_21603":120738,"_5":14870,"_28376":120658,"_3083":120739},[],"un clúster Kubernetes existente",{"_3632":72895,"_31184":72866,"_21603":120741,"_5":14870,"_28376":120658,"_3083":120742},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3632":72896,"_31184":72866,"_21603":120744,"_5":14870,"_28376":120658,"_3083":51310},[],{"_3632":72897,"_31184":72866,"_21603":120746,"_5":14870,"_28376":120658,"_3083":24416},[],{"_3632":72898,"_31184":72866,"_21603":120748,"_5":14870,"_28376":120658,"_3083":120749},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3632":72899,"_31184":72866,"_21603":120751,"_5":14870,"_28376":120658,"_3083":120752},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3632":72900,"_31184":72866,"_21603":120754,"_5":14870,"_28376":120658,"_3083":120755},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3632":72901,"_31184":72866,"_21603":120757,"_5":14870,"_28376":120658,"_3083":120758},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3632":72902,"_31184":72866,"_21603":120760,"_5":14870,"_28376":120658,"_3083":120761},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3632":72903,"_31184":72866,"_21603":120763,"_5":14870,"_28376":120662,"_3083":120764},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3632":72904,"_31184":72866,"_21603":120766,"_5":14870,"_28376":120662,"_3083":120767},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3632":72905,"_31184":72866,"_21603":120769,"_5":14870,"_28376":120666,"_3083":120770},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3632":72906,"_31184":72866,"_21603":120772,"_5":14870,"_28376":120666,"_3083":120773},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3632":72907,"_31184":72866,"_21603":120775,"_5":14870,"_28376":120666,"_3083":120776},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3632":72908,"_31184":72866,"_21603":120778,"_5":14870,"_28376":120666,"_3083":120779},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3632":72909,"_31184":72866,"_21603":120781,"_5":14870,"_28376":120670,"_3083":120782},[],"Opción",{"_3632":72910,"_31184":72866,"_21603":120784,"_5":14870,"_28376":120670,"_3083":120785},[],"Valor predeterminado",{"_3632":72911,"_31184":72866,"_21603":120787,"_5":14870,"_28376":120670,"_3083":120788},[],"Propósito",{"_3632":72912,"_31184":72866,"_21603":120790,"_5":14870,"_28376":120670,"_3083":51357},[],{"_3632":72913,"_31184":72866,"_21603":120792,"_5":14870,"_28376":120670,"_3083":51360},[],{"_3632":72914,"_31184":72866,"_21603":120794,"_5":14870,"_28376":120670,"_3083":120795},[],"Muestra la ayuda",{"_3632":72915,"_31184":72866,"_21603":120797,"_5":14870,"_28376":120670,"_3083":51366},[],{"_3632":72916,"_31184":72866,"_21603":120799,"_5":14870,"_28376":120670,"_3083":120800},[],"contexto actual",{"_3632":72917,"_31184":72866,"_21603":120802,"_5":14870,"_28376":120670,"_3083":120803},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3632":72918,"_31184":72866,"_21603":120805,"_5":14870,"_28376":120670,"_3083":51375},[],{"_3632":72919,"_31184":72866,"_21603":120807,"_5":14870,"_28376":120670,"_3083":6802},[],{"_3632":72920,"_31184":72866,"_21603":120809,"_5":14870,"_28376":120670,"_3083":120810},[],"Omite prompts y genera credenciales para las dependencias",{"_3632":72921,"_31184":72866,"_21603":120812,"_5":14870,"_28376":120670,"_3083":51383},[],{"_3632":72922,"_31184":72866,"_21603":120814,"_5":14870,"_28376":120670,"_3083":51386},[],{"_3632":72923,"_31184":72866,"_21603":120816,"_5":14870,"_28376":120670,"_3083":120817},[],"Namespace de la instalación",{"_3632":72924,"_31184":72866,"_21603":120819,"_5":14870,"_28376":120670,"_3083":51392},[],{"_3632":72925,"_31184":72866,"_21603":120821,"_5":14870,"_28376":120670,"_3083":51395},[],{"_3632":72926,"_31184":72866,"_21603":120823,"_5":14870,"_28376":120670,"_3083":120824},[],"Dominio usado por la UI, OIDC y el certificado",{"_3632":72927,"_31184":72866,"_21603":120826,"_5":14870,"_28376":120670,"_3083":51401},[],{"_3632":72928,"_31184":72866,"_21603":120828,"_5":14870,"_28376":120670,"_3083":15582},[],{"_3632":72929,"_31184":72866,"_21603":120830,"_5":14870,"_28376":120670,"_3083":120831},[],"Versión del chart de Lamassu",{"_3632":72930,"_31184":72866,"_21603":120833,"_5":14870,"_28376":120670,"_3083":51409},[],{"_3632":72931,"_31184":72866,"_21603":120835,"_5":14870,"_28376":120670,"_3083":51412},[],{"_3632":72932,"_31184":72866,"_21603":120837,"_5":14870,"_28376":120670,"_3083":120838},[],"Puerto del listener HTTPS",{"_3632":72933,"_31184":72866,"_21603":120840,"_5":14870,"_28376":120670,"_3083":51418},[],{"_3632":72934,"_31184":72866,"_21603":120842,"_5":14870,"_28376":120670,"_3083":51421},[],{"_3632":72935,"_31184":72866,"_21603":120844,"_5":14870,"_28376":120670,"_3083":120845},[],"Puerto del listener HTTP",{"_3632":72936,"_31184":72866,"_21603":120847,"_5":14870,"_28376":120670,"_3083":51427},[],{"_3632":72937,"_31184":72866,"_21603":120849,"_5":14870,"_28376":120670,"_3083":51360},[],{"_3632":72938,"_31184":72866,"_21603":120851,"_5":14870,"_28376":120670,"_3083":120852},[],"Certificado PEM para TLS downstream",{"_3632":72939,"_31184":72866,"_21603":120854,"_5":14870,"_28376":120670,"_3083":51435},[],{"_3632":72940,"_31184":72866,"_21603":120856,"_5":14870,"_28376":120670,"_3083":51360},[],{"_3632":72941,"_31184":72866,"_21603":120858,"_5":14870,"_28376":120670,"_3083":120859},[],"Clave privada PEM para TLS downstream",{"_3632":72942,"_31184":72866,"_21603":120861,"_5":14870,"_28376":120670,"_3083":51443},[],{"_3632":72943,"_31184":72866,"_21603":120863,"_5":14870,"_28376":120670,"_3083":120864},[],"chart del repositorio",{"_3632":72944,"_31184":72866,"_21603":120866,"_5":14870,"_28376":120670,"_3083":120867},[],"Usa un chart local de Lamassu sin empaquetar",{"_3632":72945,"_31184":72866,"_21603":120869,"_5":14870,"_28376":120670,"_3083":51452},[],{"_3632":72946,"_31184":72866,"_21603":120871,"_5":14870,"_28376":120670,"_3083":120872},[],"detección automática",{"_3632":72947,"_31184":72866,"_21603":120874,"_5":14870,"_28376":120670,"_3083":120875},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3632":72948,"_31184":72866,"_21603":120877,"_5":14870,"_28376":120670,"_3083":51460},[],{"_3632":72949,"_31184":72866,"_21603":120879,"_5":14870,"_28376":120670,"_3083":6802},[],{"_3632":72950,"_31184":72866,"_21603":120881,"_5":14870,"_28376":120670,"_3083":120882},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3632":72951,"_31184":72866,"_21603":120884,"_5":14870,"_28376":120670,"_3083":51468},[],{"_3632":72952,"_31184":72866,"_21603":120886,"_5":14870,"_28376":120670,"_3083":6802},[],{"_3632":72953,"_31184":72866,"_21603":120888,"_5":14870,"_28376":120670,"_3083":120889},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3632":72954,"_31184":72866,"_21603":120891,"_5":14870,"_28376":120670,"_3083":51476},[],{"_3632":72955,"_31184":72866,"_21603":120893,"_5":14870,"_28376":120670,"_3083":6802},[],{"_3632":72956,"_31184":72866,"_21603":120895,"_5":14870,"_28376":120670,"_3083":120896},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3632":72957,"_31184":72866,"_21603":120898,"_5":14870,"_28376":120670,"_3083":51484},[],{"_3632":72958,"_31184":72866,"_21603":120900,"_5":14870,"_28376":120670,"_3083":6802},[],{"_3632":72959,"_31184":72866,"_21603":120902,"_5":14870,"_28376":120670,"_3083":120903},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3632":72960,"_31184":72866,"_21603":120905,"_5":14870,"_28376":120670,"_3083":51492},[],{"_3632":72961,"_31184":72866,"_21603":120907,"_5":14870,"_28376":120670,"_3083":51495},[],{"_3632":72962,"_31184":72866,"_21603":120909,"_5":14870,"_28376":120670,"_3083":120910},[],"Usa otro chart local de SoftHSM",{"_3632":72963,"_31184":72866,"_21603":120912,"_5":14870,"_28376":120670,"_3083":120913},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3632":72964,"_31184":72866,"_21603":120915,"_5":14870,"_28376":120674,"_3083":120916},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3632":72965,"_31184":72866,"_21603":120918,"_5":14870,"_28376":120674,"_3083":120919},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3632":72966,"_31184":72866,"_21603":120921,"_5":14870,"_28376":120674,"_3083":120922},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3632":72967,"_31184":72866,"_21603":120924,"_5":14870,"_28376":120674,"_3083":120925},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3632":72968,"_31184":72866,"_21603":120927,"_5":14870,"_28376":120674,"_3083":120928},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3632":72969,"_31184":72866,"_21603":120930,"_5":14870,"_28376":120674,"_3083":120931},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3632":72970,"_31184":72866,"_21603":120933,"_5":14870,"_28376":120678,"_3083":51522},[],{"_3632":72971,"_31184":72866,"_21603":120935,"_5":14870,"_28376":120678,"_3083":120936},[],"valida las herramientas locales y el clúster seleccionado",{"_3632":72972,"_31184":72866,"_21603":120938,"_5":14870,"_28376":120678,"_3083":120939},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3632":72973,"_31184":72866,"_21603":120941,"_5":14870,"_28376":120678,"_3083":120942},[],"crea el namespace",{"_3632":72974,"_31184":72866,"_21603":120944,"_5":14870,"_28376":120678,"_3083":120945},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3632":72975,"_31184":72866,"_21603":120947,"_5":14870,"_28376":120678,"_3083":120948},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3632":72976,"_31184":72866,"_21603":120950,"_5":14870,"_28376":120678,"_3083":120951},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3632":72977,"_31184":72866,"_21603":120953,"_5":14870,"_28376":120678,"_3083":120954},[],"instala RabbitMQ",{"_3632":72978,"_31184":72866,"_21603":120956,"_5":14870,"_28376":120678,"_3083":120957},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3632":72979,"_31184":72866,"_21603":120959,"_5":14870,"_28376":120678,"_3083":120960},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3632":72980,"_31184":72866,"_21603":120962,"_5":14870,"_28376":120678,"_3083":120963},[],"carga datos de ejemplo opcionalmente",{"_3632":72981,"_31184":72866,"_21603":120965,"_5":14870,"_28376":120678,"_3083":120966},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3632":72982,"_31184":72866,"_21603":120968,"_5":14870,"_28376":120682,"_3083":120969},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3632":72983,"_31184":72866,"_21603":120971,"_5":14870,"_28376":120682,"_3083":120972},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3632":72984,"_31184":72866,"_21603":120974,"_5":14870,"_28376":120686,"_3083":120975},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3632":72985,"_31184":72866,"_21603":120977,"_5":14870,"_28376":120686,"_3083":120978},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3632":72986,"_31184":72866,"_21603":120980,"_5":14870,"_28376":120686,"_3083":120981},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3632":72987,"_31184":72866,"_21603":120983,"_5":14870,"_28376":120686,"_3083":120984},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3632":72988,"_31184":72866,"_21603":120986,"_5":14870,"_28376":120690,"_3083":120987},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3632":72989,"_31184":72989,"_5":15230,"_3083":120989,"_31522":120990,"_21603":120991,"_28376":72989},"Instala con Helm",[50964,120409,120643],[],{"_3632":72990,"_31184":72989,"_21603":120993,"_5":14870,"_28376":72989,"_3083":120994},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3632":72991,"_31184":72989,"_5":31519,"_21603":120996,"_28376":120997,"_3083":120998},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3632":72992,"_31184":72989,"_5":31519,"_21603":121000,"_28376":121001,"_3083":120659},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3632":72993,"_31184":72989,"_5":31519,"_21603":121003,"_28376":121004,"_3083":121005},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3632":72994,"_31184":72989,"_5":31519,"_21603":121007,"_28376":121008,"_3083":121009},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3632":72995,"_31184":72989,"_5":31519,"_21603":121011,"_28376":121012,"_3083":121013},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3632":72996,"_31184":72989,"_5":31519,"_21603":121015,"_28376":121016,"_3083":121017},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3632":72997,"_31184":72989,"_5":31519,"_21603":121019,"_28376":121020,"_3083":121021},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3632":72998,"_31184":72989,"_5":31519,"_21603":121023,"_28376":121024,"_3083":121025},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3632":72999,"_31184":72989,"_5":31519,"_21603":121027,"_28376":121028,"_3083":121029},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3632":73000,"_31184":72989,"_5":31519,"_21603":121031,"_28376":121032,"_3083":121033},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3632":73001,"_31184":72989,"_5":31519,"_21603":121035,"_28376":121036,"_3083":121037},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3632":73002,"_31184":72989,"_5":31519,"_21603":121039,"_28376":121040,"_3083":121041},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3632":73003,"_31184":72989,"_21603":121043,"_5":14870,"_28376":120997,"_3083":121044},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3632":73004,"_31184":72989,"_21603":121046,"_5":14870,"_28376":121001,"_3083":121047},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3632":73005,"_31184":72989,"_21603":121049,"_5":14870,"_28376":121001,"_3083":121050},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3632":73006,"_31184":72989,"_21603":121052,"_5":14870,"_28376":121001,"_3083":121053},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3632":73007,"_31184":72989,"_21603":121055,"_5":14870,"_28376":121001,"_3083":121056},[],"un broker RabbitMQ accesible y sus credenciales",{"_3632":73008,"_31184":72989,"_21603":121058,"_5":14870,"_28376":121001,"_3083":121059},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3632":73009,"_31184":72989,"_21603":121061,"_5":14870,"_28376":121001,"_3083":121062},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3632":73010,"_31184":72989,"_21603":121064,"_5":14870,"_28376":121001,"_3083":121065},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3632":73011,"_31184":72989,"_21603":121067,"_5":14870,"_28376":121001,"_3083":121068},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3632":73012,"_31184":72989,"_21603":121070,"_5":14870,"_28376":121001,"_3083":121071},[],"una StorageClass y un diseño de tráfico externo",{"_3632":73013,"_31184":72989,"_21603":121073,"_5":14870,"_28376":121001,"_3083":121074},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3632":73014,"_31184":72989,"_21603":121076,"_5":14870,"_28376":121001,"_3083":121077},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3632":73015,"_31184":72989,"_21603":121079,"_5":14870,"_28376":121001,"_3083":121080},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3632":73016,"_31184":72989,"_21603":121082,"_5":14870,"_28376":121004,"_3083":121083},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3632":73017,"_31184":72989,"_21603":121085,"_5":14870,"_28376":121004,"_3083":121086},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3632":73018,"_31184":72989,"_21603":121088,"_5":14870,"_28376":121004,"_3083":121089},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3632":73019,"_31184":72989,"_21603":121091,"_5":14870,"_28376":121008,"_3083":121092},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3632":73020,"_31184":72989,"_21603":121094,"_5":14870,"_28376":121008,"_3083":121095},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3632":73021,"_31184":72989,"_21603":121097,"_5":14870,"_28376":121008,"_3083":121098},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3632":73022,"_31184":72989,"_21603":121100,"_5":14870,"_28376":121008,"_3083":121101},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3632":73023,"_31184":72989,"_21603":121103,"_5":14870,"_28376":121012,"_3083":121104},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3632":73024,"_31184":72989,"_21603":121106,"_5":14870,"_28376":121012,"_3083":121107},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3632":73025,"_31184":72989,"_21603":121109,"_5":14870,"_28376":121012,"_3083":121110},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3632":73026,"_31184":72989,"_21603":121112,"_5":14870,"_28376":121012,"_3083":121113},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3632":73027,"_31184":72989,"_21603":121115,"_5":14870,"_28376":121012,"_3083":121116},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3632":73028,"_31184":72989,"_21603":121118,"_5":14870,"_28376":121012,"_3083":121119},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3632":73029,"_31184":72989,"_21603":121121,"_5":14870,"_28376":121012,"_3083":121122},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3632":73030,"_31184":72989,"_21603":121124,"_5":14870,"_28376":121012,"_3083":121125},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3632":73031,"_31184":72989,"_21603":121127,"_5":14870,"_28376":121016,"_3083":121128},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3632":73032,"_31184":72989,"_21603":121130,"_5":14870,"_28376":121020,"_3083":121131},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3632":73033,"_31184":72989,"_21603":121133,"_5":14870,"_28376":121020,"_3083":121134},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3632":73034,"_31184":72989,"_21603":121136,"_5":14870,"_28376":121020,"_3083":121137},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3632":73035,"_31184":72989,"_21603":121139,"_5":14870,"_28376":121020,"_3083":121140},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3632":73036,"_31184":72989,"_21603":121142,"_5":14870,"_28376":121020,"_3083":121143},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3632":73037,"_31184":72989,"_21603":121145,"_5":14870,"_28376":121020,"_3083":121146},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3632":73038,"_31184":72989,"_21603":121148,"_5":14870,"_28376":121020,"_3083":121149},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3632":73039,"_31184":72989,"_21603":121151,"_5":14870,"_28376":121024,"_3083":121152},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3632":73040,"_31184":72989,"_21603":121154,"_5":14870,"_28376":121024,"_3083":121155},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3632":73041,"_31184":72989,"_21603":121157,"_5":14870,"_28376":121024,"_3083":121158},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3632":73042,"_31184":72989,"_21603":121160,"_5":14870,"_28376":121024,"_3083":121161},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3632":73043,"_31184":72989,"_21603":121163,"_5":14870,"_28376":121028,"_3083":121164},[],"Para instalar un checkout local:",{"_3632":73044,"_31184":72989,"_21603":121166,"_5":14870,"_28376":121032,"_3083":121167},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3632":73045,"_31184":72989,"_21603":121169,"_5":14870,"_28376":121032,"_3083":121170},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3632":73046,"_31184":72989,"_21603":121172,"_5":14870,"_28376":121036,"_3083":121173},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3632":73047,"_31184":72989,"_21603":121175,"_5":14870,"_28376":121036,"_3083":121176},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3632":73048,"_31184":72989,"_21603":121178,"_5":14870,"_28376":121036,"_3083":121179},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3632":73049,"_31184":72989,"_21603":121181,"_5":14870,"_28376":121036,"_3083":121182},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3632":73050,"_31184":72989,"_21603":121184,"_5":14870,"_28376":121036,"_3083":121185},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3632":73051,"_31184":72989,"_21603":121187,"_5":14870,"_28376":121040,"_3083":121188},[],"Antes de pasar a producción, revisa:",{"_3632":73052,"_31184":72989,"_21603":121190,"_5":14870,"_28376":121040,"_3083":121191},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3632":73053,"_31184":72989,"_21603":121193,"_5":14870,"_28376":121040,"_3083":121194},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3632":73054,"_31184":72989,"_21603":121196,"_5":14870,"_28376":121040,"_3083":121197},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3632":73055,"_31184":72989,"_21603":121199,"_5":14870,"_28376":121040,"_3083":121200},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3632":73056,"_31184":72989,"_21603":121202,"_5":14870,"_28376":121040,"_3083":121203},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3632":73057,"_31184":72989,"_21603":121205,"_5":14870,"_28376":121040,"_3083":121206},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3632":73058,"_31184":72989,"_21603":121208,"_5":14870,"_28376":121040,"_3083":121209},[],"SMTP, observabilidad y entrega de alertas",{"_3632":73059,"_31184":72989,"_21603":121211,"_5":14870,"_28376":121040,"_3083":121212},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3632":73060,"_31184":72989,"_21603":121214,"_5":14870,"_28376":121040,"_3083":121215},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3632":73061,"_31184":73061,"_5":15230,"_3083":121217,"_31522":121218,"_21603":121219,"_28376":73061},"Expón el Gateway",[50964,120409,120643],[],{"_3632":73062,"_31184":73061,"_21603":121221,"_5":14870,"_28376":73061,"_3083":121222},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3632":73063,"_31184":73061,"_5":31519,"_21603":121224,"_28376":121225,"_3083":121226},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3632":73064,"_31184":73061,"_5":31519,"_21603":121228,"_28376":121229,"_3083":121230},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3632":73065,"_31184":73061,"_5":31519,"_21603":121232,"_28376":121233,"_3083":121234},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3632":73066,"_31184":73061,"_5":31519,"_21603":121236,"_28376":121237,"_3083":51827},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3632":73067,"_31184":73061,"_5":31519,"_21603":121239,"_28376":121240,"_3083":121241},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3632":73068,"_31184":73061,"_5":31519,"_21603":121243,"_28376":121244,"_3083":121245},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3632":73069,"_31184":73061,"_5":31519,"_21603":121247,"_28376":121248,"_3083":121249},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3632":73070,"_31184":73061,"_5":31519,"_21603":121251,"_28376":121252,"_3083":121253},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3632":73071,"_31184":73061,"_5":31519,"_21603":121255,"_28376":121256,"_3083":121257},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3632":73072,"_31184":73061,"_5":31519,"_21603":121259,"_28376":121260,"_3083":121261},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3632":73073,"_31184":73061,"_5":31519,"_21603":121263,"_28376":121264,"_3083":121265},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3632":73074,"_31184":73061,"_21603":121267,"_5":14870,"_28376":121225,"_3083":121268},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3632":73075,"_31184":73061,"_21603":121270,"_5":14870,"_28376":121225,"_3083":121271},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3632":73076,"_31184":73061,"_21603":121273,"_5":14870,"_28376":121229,"_3083":121274},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3632":73077,"_31184":73061,"_21603":121276,"_5":14870,"_28376":121229,"_3083":121277},[],"Defínelo únicamente cuando:",{"_3632":73078,"_31184":73061,"_21603":121279,"_5":14870,"_28376":121229,"_3083":121280},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3632":73079,"_31184":73061,"_21603":121282,"_5":14870,"_28376":121229,"_3083":121283},[],"esa dirección está asignada a este Gateway",{"_3632":73080,"_31184":73061,"_21603":121285,"_5":14870,"_28376":121229,"_3083":121286},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3632":73081,"_31184":73061,"_21603":121288,"_5":14870,"_28376":121229,"_3083":121289},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3632":73082,"_31184":73061,"_21603":121291,"_5":14870,"_28376":121229,"_3083":121292},[],"No confundas estos valores:",{"_3632":73083,"_31184":73061,"_21603":121294,"_5":14870,"_28376":121229,"_3083":121295},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3632":73084,"_31184":73061,"_21603":121297,"_5":14870,"_28376":121229,"_3083":121298},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3632":73085,"_31184":73061,"_21603":121300,"_5":14870,"_28376":121229,"_3083":121301},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3632":73086,"_31184":73061,"_21603":121303,"_5":14870,"_28376":121233,"_3083":121304},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3632":73087,"_31184":73061,"_21603":121306,"_5":14870,"_28376":121233,"_3083":121307},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3632":73088,"_31184":73061,"_21603":121309,"_5":14870,"_28376":121237,"_3083":121310},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3632":73089,"_31184":73061,"_21603":121312,"_5":14870,"_28376":121237,"_3083":121313},[],"Para el diseño recomendado:",{"_3632":73090,"_31184":73061,"_21603":121315,"_5":14870,"_28376":121237,"_3083":121316},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3632":73091,"_31184":73061,"_21603":121318,"_5":14870,"_28376":121237,"_3083":121319},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3632":73092,"_31184":73061,"_21603":121321,"_5":14870,"_28376":121237,"_3083":121322},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3632":73093,"_31184":73061,"_21603":121324,"_5":14870,"_28376":121237,"_3083":121325},[],"Apunta DNS a la dirección accesible de la VM.",{"_3632":73094,"_31184":73061,"_21603":121327,"_5":14870,"_28376":121237,"_3083":121328},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3632":73095,"_31184":73061,"_21603":121330,"_5":14870,"_28376":121240,"_3083":121331},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3632":73096,"_31184":73061,"_21603":121333,"_5":14870,"_28376":121244,"_3083":121334},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3632":73097,"_31184":73061,"_21603":121336,"_5":14870,"_28376":121244,"_3083":121337},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3632":73098,"_31184":73061,"_21603":121339,"_5":14870,"_28376":121248,"_3083":121340},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3632":73099,"_31184":73061,"_21603":121342,"_5":14870,"_28376":121248,"_3083":121343},[],"Requisito",{"_3632":73100,"_31184":73061,"_21603":121345,"_5":14870,"_28376":121248,"_3083":121346},[],"Diseño recomendado",{"_3632":73101,"_31184":73061,"_21603":121348,"_5":14870,"_28376":121248,"_3083":121349},[],"Consecuencia",{"_3632":73102,"_31184":73061,"_21603":121351,"_5":14870,"_28376":121248,"_3083":121352},[],"Varias URL o servicios de Lamassu",{"_3632":73103,"_31184":73061,"_21603":121354,"_5":14870,"_28376":121248,"_3083":121355},[],"Un Gateway con varias rutas",{"_3632":73104,"_31184":73061,"_21603":121357,"_5":14870,"_28376":121248,"_3083":121358},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3632":73105,"_31184":73061,"_21603":121360,"_5":14870,"_28376":121248,"_3083":121361},[],"Gateways independientes e IP externas distintas",{"_3632":73106,"_31184":73061,"_21603":121363,"_5":14870,"_28376":121248,"_3083":121364},[],"Una VIP por Gateway",{"_3632":73107,"_31184":73061,"_21603":121366,"_5":14870,"_28376":121248,"_3083":121367},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3632":73108,"_31184":73061,"_21603":121369,"_5":14870,"_28376":121248,"_3083":121370},[],"Gateways independientes, un nodo y una IP",{"_3632":73109,"_31184":73061,"_21603":121372,"_5":14870,"_28376":121248,"_3083":121373},[],"Puertos externos diferentes",{"_3632":73110,"_31184":73061,"_21603":121375,"_5":14870,"_28376":121248,"_3083":121376},[],"Los clientes deben indicar puertos no estándar",{"_3632":73111,"_31184":73061,"_21603":121378,"_5":14870,"_28376":121248,"_3083":121379},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3632":73112,"_31184":73061,"_21603":121381,"_5":14870,"_28376":121248,"_3083":121382},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3632":73113,"_31184":73061,"_21603":121384,"_5":14870,"_28376":121248,"_3083":121385},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3632":73114,"_31184":73061,"_21603":121387,"_5":14870,"_28376":121248,"_3083":121388},[],"Recursos Gateway separados pero proxy compartido",{"_3632":73115,"_31184":73061,"_21603":121390,"_5":14870,"_28376":121248,"_3083":121391},[],"Modo merged Gateway de Envoy",{"_3632":73116,"_31184":73061,"_21603":121393,"_5":14870,"_28376":121248,"_3083":121394},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3632":73117,"_31184":73061,"_21603":121396,"_5":14870,"_28376":121248,"_3083":121397},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3632":73118,"_31184":73061,"_21603":121399,"_5":14870,"_28376":121248,"_3083":121400},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3632":73119,"_31184":73061,"_21603":121402,"_5":14870,"_28376":121248,"_3083":121403},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3632":73120,"_31184":73061,"_21603":121405,"_5":14870,"_28376":121248,"_3083":121406},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3632":73121,"_31184":73061,"_21603":121408,"_5":14870,"_28376":121252,"_3083":121409},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3632":73122,"_31184":73061,"_21603":121411,"_5":14870,"_28376":121256,"_3083":121412},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3632":73123,"_31184":73061,"_21603":121414,"_5":14870,"_28376":121256,"_3083":121415},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3632":73124,"_31184":73061,"_21603":121417,"_5":14870,"_28376":121256,"_3083":121418},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3632":73125,"_31184":73061,"_21603":121420,"_5":14870,"_28376":121256,"_3083":121421},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3632":73126,"_31184":73061,"_21603":121423,"_5":14870,"_28376":121256,"_3083":121424},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3632":73127,"_31184":73061,"_21603":121426,"_5":14870,"_28376":121260,"_3083":121427},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3632":73128,"_31184":73061,"_21603":121429,"_5":14870,"_28376":121260,"_3083":121430},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3632":73129,"_31184":73061,"_21603":121432,"_5":14870,"_28376":121264,"_3083":121433},[],"Comprueba, en orden:",{"_3632":73130,"_31184":73061,"_21603":121435,"_5":14870,"_28376":121264,"_3083":121436},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3632":73131,"_31184":73061,"_21603":121438,"_5":14870,"_28376":121264,"_3083":121439},[],"Su estado contiene la dirección esperada.",{"_3632":73132,"_31184":73061,"_21603":121441,"_5":14870,"_28376":121264,"_3083":121442},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3632":73133,"_31184":73061,"_21603":121444,"_5":14870,"_28376":121264,"_3083":121445},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3632":73134,"_31184":73061,"_21603":121447,"_5":14870,"_28376":121264,"_3083":121448},[],"DNS resuelve al endpoint accesible externamente.",{"_3632":73135,"_31184":73061,"_21603":121450,"_5":14870,"_28376":121264,"_3083":121451},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3632":73136,"_31184":73061,"_21603":121453,"_5":14870,"_28376":121264,"_3083":121454},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3632":73137,"_31184":73137,"_5":15230,"_3083":51071,"_31522":121456,"_21603":121457,"_28376":73137},[50964,120409,120643],[],{"_3632":73138,"_31184":73137,"_21603":121459,"_5":14870,"_28376":73137,"_3083":121460},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3632":73139,"_31184":73137,"_5":31519,"_21603":121462,"_28376":121463,"_3083":121464},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3632":73140,"_31184":73137,"_5":31519,"_21603":121466,"_28376":121467,"_3083":121468},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3632":73141,"_31184":73137,"_5":31519,"_21603":121470,"_28376":121471,"_3083":121472},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3632":73142,"_31184":73137,"_5":31519,"_21603":121474,"_28376":121475,"_3083":121476},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3632":73143,"_31184":73137,"_5":31519,"_21603":121478,"_28376":121479,"_3083":121480},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3632":73144,"_31184":73137,"_5":31519,"_21603":121482,"_28376":121483,"_3083":121484},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3632":73145,"_31184":73137,"_21603":121486,"_5":14870,"_28376":121463,"_3083":121487},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3632":73146,"_31184":73137,"_21603":121489,"_5":14870,"_28376":121467,"_3083":121490},[],"Flujo",{"_3632":73147,"_31184":73137,"_21603":121492,"_5":14870,"_28376":121467,"_3083":121493},[],"Úsalo para",{"_3632":73148,"_31184":73137,"_21603":121495,"_5":14870,"_28376":121467,"_3083":121496},[],"Qué instala",{"_3632":73149,"_31184":73137,"_21603":121498,"_5":14870,"_28376":121467,"_3083":52089},[],{"_3632":73150,"_31184":73137,"_21603":121500,"_5":14870,"_28376":121467,"_3083":121501},[],"Producción y entornos controlados",{"_3632":73151,"_31184":73137,"_21603":121503,"_5":14870,"_28376":121467,"_3083":121504},[],"Servicios de Lamassu y recursos de Gateway API",{"_3632":73152,"_31184":73137,"_21603":121506,"_5":14870,"_28376":121467,"_3083":51208},[],{"_3632":73153,"_31184":73137,"_21603":121508,"_5":14870,"_28376":121467,"_3083":121509},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3632":73154,"_31184":73137,"_21603":121511,"_5":14870,"_28376":121467,"_3083":121512},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3632":73155,"_31184":73137,"_21603":121514,"_5":14870,"_28376":121471,"_3083":121515},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3632":73156,"_31184":73137,"_21603":121517,"_5":14870,"_28376":121471,"_3083":121518},[],"Área",{"_3632":73157,"_31184":73137,"_21603":121520,"_5":14870,"_28376":121471,"_3083":121521},[],"El chart de Lamassu proporciona",{"_3632":73158,"_31184":73137,"_21603":121523,"_5":14870,"_28376":121471,"_3083":121524},[],"Tú proporcionas",{"_3632":73159,"_31184":73137,"_21603":121526,"_5":14870,"_28376":121471,"_3083":121527},[],"Aplicaciones Lamassu",{"_3632":73160,"_31184":73137,"_21603":121529,"_5":14870,"_28376":121471,"_3083":121530},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3632":73161,"_31184":73137,"_21603":121532,"_5":14870,"_28376":121471,"_3083":121533},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3632":73162,"_31184":73137,"_21603":121535,"_5":14870,"_28376":121471,"_3083":121536},[],"Datos PostgreSQL",{"_3632":73163,"_31184":73137,"_21603":121538,"_5":14870,"_28376":121471,"_3083":121539},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3632":73164,"_31184":73137,"_21603":121541,"_5":14870,"_28376":121471,"_3083":121542},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3632":73165,"_31184":73137,"_21603":121544,"_5":14870,"_28376":121471,"_3083":121545},[],"Mensajería",{"_3632":73166,"_31184":73137,"_21603":121547,"_5":14870,"_28376":121471,"_3083":121548},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3632":73167,"_31184":73137,"_21603":121550,"_5":14870,"_28376":121471,"_3083":121551},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3632":73168,"_31184":73137,"_21603":121553,"_5":14870,"_28376":121471,"_3083":121554},[],"Identidad",{"_3632":73169,"_31184":73137,"_21603":121556,"_5":14870,"_28376":121471,"_3083":121557},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3632":73170,"_31184":73137,"_21603":121559,"_5":14870,"_28376":121471,"_3083":121560},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3632":73171,"_31184":73137,"_21603":121562,"_5":14870,"_28376":121471,"_3083":121563},[],"Enrutamiento externo",{"_3632":73172,"_31184":73137,"_21603":121565,"_5":14870,"_28376":121471,"_3083":121566},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3632":73173,"_31184":73137,"_21603":121568,"_5":14870,"_28376":121471,"_3083":121569},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3632":73174,"_31184":73137,"_21603":121571,"_5":14870,"_28376":121471,"_3083":52163},[],{"_3632":73175,"_31184":73137,"_21603":121573,"_5":14870,"_28376":121471,"_3083":121574},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3632":73176,"_31184":73137,"_21603":121576,"_5":14870,"_28376":121471,"_3083":121577},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3632":73177,"_31184":73137,"_21603":121579,"_5":14870,"_28376":121471,"_3083":121580},[],"Datos persistentes de la aplicación",{"_3632":73178,"_31184":73137,"_21603":121582,"_5":14870,"_28376":121471,"_3083":121583},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3632":73179,"_31184":73137,"_21603":121585,"_5":14870,"_28376":121471,"_3083":121586},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3632":73180,"_31184":73137,"_21603":121588,"_5":14870,"_28376":121471,"_3083":121589},[],"Integraciones opcionales",{"_3632":73181,"_31184":73137,"_21603":121591,"_5":14870,"_28376":121471,"_3083":121592},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3632":73182,"_31184":73137,"_21603":121594,"_5":14870,"_28376":121471,"_3083":121595},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3632":73183,"_31184":73137,"_21603":121597,"_5":14870,"_28376":121471,"_3083":121598},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3632":73184,"_31184":73137,"_21603":121600,"_5":14870,"_28376":121471,"_3083":121601},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3632":73185,"_31184":73137,"_21603":121603,"_5":14870,"_28376":121475,"_3083":121604},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3632":73186,"_31184":73137,"_21603":121606,"_5":14870,"_28376":121475,"_3083":121607},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3632":73187,"_31184":73137,"_21603":121609,"_5":14870,"_28376":121479,"_3083":121610},[],"Kubernetes 1.24 o posterior",{"_3632":73188,"_31184":73137,"_21603":121612,"_5":14870,"_28376":121479,"_3083":121613},[],"Helm 3.2 o posterior",{"_3632":73189,"_31184":73137,"_21603":121615,"_5":14870,"_28376":121479,"_3083":121616},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3632":73190,"_31184":73137,"_21603":121618,"_5":14870,"_28376":121479,"_3083":121619},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3632":73191,"_31184":73137,"_21603":121621,"_5":14870,"_28376":121479,"_3083":121622},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3632":73192,"_31184":73137,"_21603":121624,"_5":14870,"_28376":121479,"_3083":121625},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3632":73193,"_31184":73137,"_21603":121627,"_5":14870,"_28376":121479,"_3083":121628},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3632":73194,"_31184":73137,"_21603":121630,"_5":14870,"_28376":121483,"_3083":121631},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":73195,"_31184":73137,"_21603":121633,"_5":14870,"_28376":121483,"_3083":121634},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3632":73196,"_31184":73137,"_21603":121636,"_5":14870,"_28376":121483,"_3083":121637},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3632":73197,"_31184":73137,"_21603":121639,"_5":14870,"_28376":121483,"_3083":121640},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3632":73198,"_31184":73198,"_5":15230,"_3083":121642,"_31522":121643,"_21603":121645,"_28376":73198},"Resolución de problemas de despliegue",[50964,120409,121644],"Operación",[],{"_3632":73199,"_31184":73198,"_21603":121647,"_5":14870,"_28376":73198,"_3083":121648},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3632":73200,"_31184":73198,"_5":31519,"_21603":121650,"_28376":121651,"_3083":121652},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3632":73201,"_31184":73198,"_5":31519,"_21603":121654,"_28376":121655,"_3083":121656},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3632":73202,"_31184":73198,"_5":31519,"_21603":121658,"_28376":121659,"_3083":121660},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3632":73203,"_31184":73198,"_5":31519,"_21603":121662,"_28376":121663,"_3083":121664},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3632":73204,"_31184":73198,"_5":31519,"_21603":121666,"_28376":121667,"_3083":121668},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3632":73205,"_31184":73198,"_5":31519,"_21603":121670,"_28376":121671,"_3083":121672},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3632":73206,"_31184":73198,"_5":31519,"_21603":121674,"_28376":121675,"_3083":121676},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3632":73207,"_31184":73198,"_5":31519,"_21603":121678,"_28376":121679,"_3083":121680},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3632":73208,"_31184":73198,"_5":31519,"_21603":121682,"_28376":121683,"_3083":121684},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3632":73209,"_31184":73198,"_5":31519,"_21603":121686,"_28376":121687,"_3083":121688},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3632":73210,"_31184":73198,"_5":31519,"_21603":121690,"_28376":121691,"_3083":121692},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3632":73211,"_31184":73198,"_5":31519,"_21603":121694,"_28376":121695,"_3083":121696},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3632":73212,"_31184":73198,"_5":31519,"_21603":121698,"_28376":121699,"_3083":121700},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3632":73213,"_31184":73198,"_21603":121702,"_5":14870,"_28376":73198,"_3083":121703},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3632":73214,"_31184":73198,"_21603":121705,"_5":14870,"_28376":121655,"_3083":121706},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3632":73215,"_31184":73198,"_21603":121708,"_5":14870,"_28376":121659,"_3083":121709},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3632":73216,"_31184":73198,"_21603":121711,"_5":14870,"_28376":121663,"_3083":121712},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3632":73217,"_31184":73198,"_21603":121714,"_5":14870,"_28376":121667,"_3083":121715},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3632":73218,"_31184":73198,"_21603":121717,"_5":14870,"_28376":121671,"_3083":121718},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3632":73219,"_31184":73198,"_21603":121720,"_5":14870,"_28376":121675,"_3083":121721},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3632":73220,"_31184":73198,"_21603":121723,"_5":14870,"_28376":121675,"_3083":121724},[],"Ejecuta también la prueba de conectividad del chart:",{"_3632":73221,"_31184":73198,"_21603":121726,"_5":14870,"_28376":121675,"_3083":121727},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3632":73222,"_31184":73198,"_21603":121729,"_5":14870,"_28376":121675,"_3083":121730},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3632":73223,"_31184":73198,"_21603":121732,"_5":14870,"_28376":121679,"_3083":121733},[],"Si recibes un 401:",{"_3632":73224,"_31184":73198,"_21603":121735,"_5":14870,"_28376":121679,"_3083":121736},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3632":73225,"_31184":73198,"_21603":121738,"_5":14870,"_28376":121679,"_3083":121739},[],"verifica emisor, audiencia y expiración del token;",{"_3632":73226,"_31184":73198,"_21603":121741,"_5":14870,"_28376":121679,"_3083":121742},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3632":73227,"_31184":73198,"_21603":121744,"_5":14870,"_28376":121679,"_3083":121745},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3632":73228,"_31184":73198,"_21603":121747,"_5":14870,"_28376":121679,"_3083":121748},[],"Si el login termina pero las APIs devuelven 403:",{"_3632":73229,"_31184":73198,"_21603":121750,"_5":14870,"_28376":121679,"_3083":121751},[],"inspecciona los claims reales del token;",{"_3632":73230,"_31184":73198,"_21603":121753,"_5":14870,"_28376":121679,"_3083":121754},[],"confirma que coinciden con un principal activo;",{"_3632":73231,"_31184":73198,"_21603":121756,"_5":14870,"_28376":121679,"_3083":121757},[],"revisa las políticas concedidas al principal;",{"_3632":73232,"_31184":73198,"_21603":121759,"_5":14870,"_28376":121679,"_3083":121760},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3632":73233,"_31184":73198,"_21603":121762,"_5":14870,"_28376":121679,"_3083":121763},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3632":73234,"_31184":73198,"_21603":121765,"_5":14870,"_28376":121683,"_3083":121766},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3632":73235,"_31184":73198,"_21603":121768,"_5":14870,"_28376":121683,"_3083":121769},[],"Localiza el pod y Service de authz.",{"_3632":73236,"_31184":73198,"_21603":121771,"_5":14870,"_28376":121683,"_3083":121772},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3632":73237,"_31184":73198,"_21603":121774,"_5":14870,"_28376":121683,"_3083":121775},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3632":73238,"_31184":73198,"_21603":121777,"_5":14870,"_28376":121683,"_3083":121778},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3632":73239,"_31184":73198,"_21603":121780,"_5":14870,"_28376":121683,"_3083":121781},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3632":73240,"_31184":73198,"_21603":121783,"_5":14870,"_28376":121687,"_3083":121784},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3632":73241,"_31184":73198,"_21603":121786,"_5":14870,"_28376":121691,"_3083":121787},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3632":73242,"_31184":73198,"_21603":121789,"_5":14870,"_28376":121691,"_3083":121790},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3632":73243,"_31184":73198,"_21603":121792,"_5":14870,"_28376":121691,"_3083":121793},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3632":73244,"_31184":73198,"_21603":121795,"_5":14870,"_28376":121691,"_3083":121796},[],"volumen persistente sin enlazar;",{"_3632":73245,"_31184":73198,"_21603":121798,"_5":14870,"_28376":121691,"_3083":121799},[],"imagen inaccesible o política de pull incorrecta;",{"_3632":73246,"_31184":73198,"_21603":121801,"_5":14870,"_28376":121691,"_3083":121802},[],"configuración inválida del motor criptográfico;",{"_3632":73247,"_31184":73198,"_21603":121804,"_5":14870,"_28376":121691,"_3083":121805},[],"límites de CPU o memoria demasiado bajos;",{"_3632":73248,"_31184":73198,"_21603":121807,"_5":14870,"_28376":121691,"_3083":121808},[],"migración previa incompleta.",{"_3632":73249,"_31184":73198,"_21603":121810,"_5":14870,"_28376":121691,"_3083":121811},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3632":73250,"_31184":73198,"_21603":121813,"_5":14870,"_28376":121691,"_3083":121814},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3632":73251,"_31184":73198,"_21603":121816,"_5":14870,"_28376":121691,"_3083":121817},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3632":73252,"_31184":73198,"_21603":121819,"_5":14870,"_28376":121695,"_3083":121820},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3632":73253,"_31184":73198,"_21603":121822,"_5":14870,"_28376":121695,"_3083":121823},[],"verifica que esté habilitado en el servicio emisor;",{"_3632":73254,"_31184":73198,"_21603":121825,"_5":14870,"_28376":121695,"_3083":121826},[],"comprueba conectividad y credenciales AMQP;",{"_3632":73255,"_31184":73198,"_21603":121828,"_5":14870,"_28376":121695,"_3083":121829},[],"revisa exchange, routing key, colas y consumidores;",{"_3632":73256,"_31184":73198,"_21603":121831,"_5":14870,"_28376":121695,"_3083":121832},[],"inspecciona dead-letter queues;",{"_3632":73257,"_31184":73198,"_21603":121834,"_5":14870,"_28376":121695,"_3083":121835},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3632":73258,"_31184":73198,"_21603":121837,"_5":14870,"_28376":121695,"_3083":121838},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3632":73259,"_31184":73198,"_21603":121840,"_5":14870,"_28376":121695,"_3083":121841},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3632":73260,"_31184":73198,"_21603":121843,"_5":14870,"_28376":121695,"_3083":121844},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3632":73261,"_31184":73198,"_21603":121846,"_5":14870,"_28376":121695,"_3083":121847},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3632":73262,"_31184":73198,"_21603":121849,"_5":14870,"_28376":121695,"_3083":121850},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3632":73263,"_31184":73198,"_21603":121852,"_5":14870,"_28376":121695,"_3083":121853},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3632":73264,"_31184":73198,"_21603":121855,"_5":14870,"_28376":121695,"_3083":121856},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3632":73265,"_31184":73198,"_21603":121858,"_5":14870,"_28376":121699,"_3083":121859},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3632":73266,"_31184":73198,"_21603":121861,"_5":14870,"_28376":121699,"_3083":121862},[],"Antes de cerrar una incidencia, guarda:",{"_3632":73267,"_31184":73198,"_21603":121864,"_5":14870,"_28376":121699,"_3083":121865},[],"causa confirmada;",{"_3632":73268,"_31184":73198,"_21603":121867,"_5":14870,"_28376":121699,"_3083":121868},[],"alcance temporal y recursos afectados;",{"_3632":73269,"_31184":73198,"_21603":121870,"_5":14870,"_28376":121699,"_3083":121871},[],"comandos o consultas utilizados;",{"_3632":73270,"_31184":73198,"_21603":121873,"_5":14870,"_28376":121699,"_3083":121874},[],"cambio aplicado y forma de revertirlo;",{"_3632":73271,"_31184":73198,"_21603":121876,"_5":14870,"_28376":121699,"_3083":121877},[],"validación desde un consumidor;",{"_3632":73272,"_31184":73198,"_21603":121879,"_5":14870,"_28376":121699,"_3083":121880},[],"acción preventiva y propietario.",{"_3632":73273,"_31184":73273,"_5":15230,"_3083":121882,"_31522":121883,"_21603":121887,"_28376":73273},"Modelo de datos",[50964,121884,121885,121886],"Plataforma","Administración","Control de acceso",[],{"_3632":73274,"_31184":73273,"_21603":121889,"_5":14870,"_28376":73273,"_3083":121890},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3632":73275,"_31184":73273,"_5":31519,"_21603":121892,"_28376":121893,"_3083":121894},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3632":73276,"_31184":73273,"_5":31519,"_21603":121896,"_28376":121897,"_3083":121898},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3632":73277,"_31184":73273,"_21603":121900,"_5":14870,"_28376":73273,"_3083":121901},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3632":73278,"_31184":73273,"_21603":121903,"_5":14870,"_28376":121893,"_3083":121904},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3632":73279,"_31184":73273,"_21603":121906,"_5":14870,"_28376":121893,"_3083":121907},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3632":73280,"_31184":73273,"_21603":121909,"_5":14870,"_28376":121893,"_3083":121910},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3632":73281,"_31184":73273,"_21603":121912,"_5":14870,"_28376":121897,"_3083":121913},[],"Entidad (`schema_name.entity_type`)",{"_3632":73282,"_31184":73273,"_21603":121915,"_5":14870,"_28376":121897,"_3083":121916},[],"Tabla (`table_name`)",{"_3632":73283,"_31184":73273,"_21603":121918,"_5":14870,"_28376":121897,"_3083":121919},[],"Clave (`primary_key`)",{"_3632":73284,"_31184":73273,"_21603":121921,"_5":14870,"_28376":121897,"_3083":52514},[],{"_3632":73285,"_31184":73273,"_21603":121923,"_5":14870,"_28376":121897,"_3083":52517},[],{"_3632":73286,"_31184":73273,"_21603":121925,"_5":14870,"_28376":121897,"_3083":52520},[],{"_3632":73287,"_31184":73273,"_21603":121927,"_5":14870,"_28376":121897,"_3083":52523},[],{"_3632":73288,"_31184":73273,"_21603":121929,"_5":14870,"_28376":121897,"_3083":52526},[],{"_3632":73289,"_31184":73273,"_21603":121931,"_5":14870,"_28376":121897,"_3083":52529},[],{"_3632":73290,"_31184":73273,"_21603":121933,"_5":14870,"_28376":121897,"_3083":52532},[],{"_3632":73291,"_31184":73273,"_21603":121935,"_5":14870,"_28376":121897,"_3083":52535},[],{"_3632":73292,"_31184":73273,"_21603":121937,"_5":14870,"_28376":121897,"_3083":52529},[],{"_3632":73293,"_31184":73273,"_21603":121939,"_5":14870,"_28376":121897,"_3083":52540},[],{"_3632":73294,"_31184":73273,"_21603":121941,"_5":14870,"_28376":121897,"_3083":52543},[],{"_3632":73295,"_31184":73273,"_21603":121943,"_5":14870,"_28376":121897,"_3083":52546},[],{"_3632":73296,"_31184":73273,"_21603":121945,"_5":14870,"_28376":121897,"_3083":52549},[],{"_3632":73297,"_31184":73273,"_21603":121947,"_5":14870,"_28376":121897,"_3083":52552},[],{"_3632":73298,"_31184":73273,"_21603":121949,"_5":14870,"_28376":121897,"_3083":52529},[],{"_3632":73299,"_31184":73273,"_21603":121951,"_5":14870,"_28376":121897,"_3083":52557},[],{"_3632":73300,"_31184":73273,"_21603":121953,"_5":14870,"_28376":121897,"_3083":52560},[],{"_3632":73301,"_31184":73273,"_21603":121955,"_5":14870,"_28376":121897,"_3083":52529},[],{"_3632":73302,"_31184":73273,"_21603":121957,"_5":14870,"_28376":121897,"_3083":52565},[],{"_3632":73303,"_31184":73273,"_21603":121959,"_5":14870,"_28376":121897,"_3083":52568},[],{"_3632":73304,"_31184":73273,"_21603":121961,"_5":14870,"_28376":121897,"_3083":52529},[],{"_3632":73305,"_31184":73273,"_21603":121963,"_5":14870,"_28376":121897,"_3083":52573},[],{"_3632":73306,"_31184":73273,"_21603":121965,"_5":14870,"_28376":121897,"_3083":52576},[],{"_3632":73307,"_31184":73273,"_21603":121967,"_5":14870,"_28376":121897,"_3083":52529},[],{"_3632":73308,"_31184":73273,"_21603":121969,"_5":14870,"_28376":121897,"_3083":52581},[],{"_3632":73309,"_31184":73273,"_21603":121971,"_5":14870,"_28376":121897,"_3083":52584},[],{"_3632":73310,"_31184":73273,"_21603":121973,"_5":14870,"_28376":121897,"_3083":52587},[],{"_3632":73311,"_31184":73273,"_21603":121975,"_5":14870,"_28376":121897,"_3083":52590},[],{"_3632":73312,"_31184":73273,"_21603":121977,"_5":14870,"_28376":121897,"_3083":52593},[],{"_3632":73313,"_31184":73273,"_21603":121979,"_5":14870,"_28376":121897,"_3083":52596},[],{"_3632":73314,"_31184":73273,"_21603":121981,"_5":14870,"_28376":121897,"_3083":121982},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3632":73315,"_31184":73273,"_21603":121984,"_5":14870,"_28376":121897,"_3083":121985},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3632":73316,"_31184":73273,"_21603":121987,"_5":14870,"_28376":121897,"_3083":121988},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3632":73317,"_31184":73317,"_5":15230,"_3083":121990,"_31522":121991,"_21603":121992,"_28376":73317},"Visión general del control de acceso",[50964,121884,121885,121886],[],{"_3632":73318,"_31184":73317,"_21603":121994,"_5":14870,"_28376":73317,"_3083":121995},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3632":73319,"_31184":73317,"_5":31519,"_21603":121997,"_28376":121998,"_3083":121999},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3632":73320,"_31184":73317,"_5":31519,"_21603":122001,"_28376":122002,"_3083":122003},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3632":73321,"_31184":73317,"_5":31519,"_21603":122005,"_28376":122006,"_3083":122007},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3632":73322,"_31184":73317,"_5":31519,"_21603":122009,"_28376":122010,"_3083":122011},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3632":73323,"_31184":73317,"_5":31519,"_21603":122013,"_28376":122014,"_3083":122015},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3632":73324,"_31184":73317,"_5":31519,"_21603":122017,"_28376":122018,"_3083":122019},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3632":73325,"_31184":73317,"_5":31519,"_21603":122021,"_28376":122022,"_3083":122023},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3632":73326,"_31184":73317,"_5":31519,"_21603":122025,"_28376":122026,"_3083":122027},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3632":73327,"_31184":73317,"_5":31519,"_21603":122029,"_28376":122030,"_3083":122031},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3632":73328,"_31184":73317,"_5":31519,"_21603":122033,"_28376":122034,"_3083":122035},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3632":73329,"_31184":73317,"_5":31519,"_21603":122037,"_28376":122038,"_3083":122039},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3632":73330,"_31184":73317,"_5":31519,"_21603":122041,"_28376":122042,"_3083":122043},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3632":73331,"_31184":73317,"_5":31519,"_21603":122045,"_28376":122046,"_3083":122047},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3632":73332,"_31184":73317,"_5":31519,"_21603":122049,"_28376":122050,"_3083":122051},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3632":73333,"_31184":73317,"_5":31519,"_21603":122053,"_28376":122054,"_3083":122055},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3632":73334,"_31184":73317,"_5":31519,"_21603":122057,"_28376":122058,"_3083":121025},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3632":73335,"_31184":73317,"_5":31519,"_21603":122060,"_28376":122061,"_3083":122062},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3632":73336,"_31184":73317,"_5":31519,"_21603":122064,"_28376":122065,"_3083":122066},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3632":73337,"_31184":73317,"_5":31519,"_21603":122068,"_28376":122069,"_3083":122070},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3632":73338,"_31184":73317,"_5":31519,"_21603":122072,"_28376":122073,"_3083":122074},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3632":73339,"_31184":73317,"_5":31519,"_21603":122076,"_28376":122077,"_3083":122078},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3632":73340,"_31184":73317,"_5":31519,"_21603":122080,"_28376":122081,"_3083":122082},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3632":73341,"_31184":73317,"_5":31519,"_21603":122084,"_28376":122085,"_3083":122086},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3632":73342,"_31184":73317,"_5":31519,"_21603":122088,"_28376":122089,"_3083":122090},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3632":73343,"_31184":73317,"_5":31519,"_21603":122092,"_28376":122093,"_3083":122094},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3632":73344,"_31184":73317,"_5":31519,"_21603":122096,"_28376":122097,"_3083":122098},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3632":73345,"_31184":73317,"_5":31519,"_21603":122100,"_28376":122101,"_3083":122102},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3632":73346,"_31184":73317,"_5":31519,"_21603":122104,"_28376":122105,"_3083":122106},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3632":73347,"_31184":73317,"_5":31519,"_21603":122108,"_28376":122109,"_3083":122110},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3632":73348,"_31184":73317,"_5":31519,"_21603":122112,"_28376":122113,"_3083":122114},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3632":73349,"_31184":73317,"_5":31519,"_21603":122116,"_28376":122117,"_3083":122118},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3632":73350,"_31184":73317,"_21603":122120,"_5":14870,"_28376":73317,"_3083":122121},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3632":73351,"_31184":73317,"_21603":122123,"_5":14870,"_28376":73317,"_3083":122124},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3632":73352,"_31184":73317,"_21603":122126,"_5":14870,"_28376":73317,"_3083":122127},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3632":73353,"_31184":73317,"_21603":122129,"_5":14870,"_28376":121998,"_3083":122130},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3632":73354,"_31184":73317,"_21603":122132,"_5":14870,"_28376":121998,"_3083":122133},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3632":73355,"_31184":73317,"_21603":122135,"_5":14870,"_28376":121998,"_3083":122136},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3632":73356,"_31184":73317,"_21603":122138,"_5":14870,"_28376":121998,"_3083":122139},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3632":73357,"_31184":73317,"_21603":122141,"_5":14870,"_28376":121998,"_3083":122142},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3632":73358,"_31184":73317,"_21603":122144,"_5":14870,"_28376":121998,"_3083":122145},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3632":73359,"_31184":73317,"_21603":122147,"_5":14870,"_28376":122002,"_3083":122148},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3632":73360,"_31184":73317,"_21603":122150,"_5":14870,"_28376":122002,"_3083":122151},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3632":73361,"_31184":73317,"_21603":122153,"_5":14870,"_28376":122006,"_3083":122154},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3632":73362,"_31184":73317,"_21603":122156,"_5":14870,"_28376":122006,"_3083":122157},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3632":73363,"_31184":73317,"_21603":122159,"_5":14870,"_28376":122006,"_3083":122160},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3632":73364,"_31184":73317,"_21603":122162,"_5":14870,"_28376":122006,"_3083":122163},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3632":73365,"_31184":73317,"_21603":122165,"_5":14870,"_28376":122006,"_3083":122166},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3632":73366,"_31184":73317,"_21603":122168,"_5":14870,"_28376":122006,"_3083":122169},[],"Carga por separado las políticas concedidas a cada principal.",{"_3632":73367,"_31184":73317,"_21603":122171,"_5":14870,"_28376":122006,"_3083":122172},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3632":73368,"_31184":73317,"_21603":122174,"_5":14870,"_28376":122006,"_3083":122175},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3632":73369,"_31184":73317,"_21603":122177,"_5":14870,"_28376":122006,"_3083":122178},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3632":73370,"_31184":73317,"_21603":122180,"_5":14870,"_28376":122006,"_3083":122181},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3632":73371,"_31184":73317,"_21603":122183,"_5":14870,"_28376":122006,"_3083":122184},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3632":73372,"_31184":73317,"_21603":122186,"_5":14870,"_28376":122006,"_3083":122187},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3632":73373,"_31184":73317,"_21603":122189,"_5":14870,"_28376":122010,"_3083":122190},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3632":73374,"_31184":73317,"_21603":122192,"_5":14870,"_28376":122010,"_3083":122193},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3632":73375,"_31184":73317,"_21603":122195,"_5":14870,"_28376":122010,"_3083":122196},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3632":73376,"_31184":73317,"_21603":122198,"_5":14870,"_28376":122010,"_3083":122199},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3632":73377,"_31184":73317,"_21603":122201,"_5":14870,"_28376":122010,"_3083":122202},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3632":73378,"_31184":73317,"_21603":122204,"_5":14870,"_28376":122010,"_3083":122205},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3632":73379,"_31184":73317,"_21603":122207,"_5":14870,"_28376":122010,"_3083":122208},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3632":73380,"_31184":73317,"_21603":122210,"_5":14870,"_28376":122010,"_3083":122211},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3632":73381,"_31184":73317,"_21603":122213,"_5":14870,"_28376":122010,"_3083":122214},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3632":73382,"_31184":73317,"_21603":122216,"_5":14870,"_28376":122010,"_3083":122217},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3632":73383,"_31184":73317,"_21603":122219,"_5":14870,"_28376":122014,"_3083":122220},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3632":73384,"_31184":73317,"_21603":122222,"_5":14870,"_28376":122014,"_3083":122223},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3632":73385,"_31184":73317,"_21603":122225,"_5":14870,"_28376":122014,"_3083":122226},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3632":73386,"_31184":73317,"_21603":122228,"_5":14870,"_28376":122014,"_3083":122229},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3632":73387,"_31184":73317,"_21603":122231,"_5":14870,"_28376":122014,"_3083":122232},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3632":73388,"_31184":73317,"_21603":122234,"_5":14870,"_28376":122014,"_3083":122235},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3632":73389,"_31184":73317,"_21603":122237,"_5":14870,"_28376":122014,"_3083":122238},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3632":73390,"_31184":73317,"_21603":122240,"_5":14870,"_28376":122014,"_3083":122241},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3632":73391,"_31184":73317,"_21603":122243,"_5":14870,"_28376":122014,"_3083":122244},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3632":73392,"_31184":73317,"_21603":122246,"_5":14870,"_28376":122014,"_3083":122247},[],"Las acciones se dividen en dos grupos:",{"_3632":73393,"_31184":73317,"_21603":122249,"_5":14870,"_28376":122014,"_3083":122250},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3632":73394,"_31184":73317,"_21603":122252,"_5":14870,"_28376":122014,"_3083":122253},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3632":73395,"_31184":73317,"_21603":122255,"_5":14870,"_28376":122014,"_3083":122256},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3632":73396,"_31184":73317,"_21603":122258,"_5":14870,"_28376":122018,"_3083":122259},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3632":73397,"_31184":73317,"_21603":122261,"_5":14870,"_28376":122018,"_3083":122262},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3632":73398,"_31184":73317,"_21603":122264,"_5":14870,"_28376":122018,"_3083":122265},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3632":73399,"_31184":73317,"_21603":122267,"_5":14870,"_28376":122022,"_3083":122268},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3632":73400,"_31184":73317,"_21603":122270,"_5":14870,"_28376":122022,"_3083":122271},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3632":73401,"_31184":73317,"_21603":122273,"_5":14870,"_28376":122022,"_3083":122274},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3632":73402,"_31184":73317,"_21603":122276,"_5":14870,"_28376":122022,"_3083":122277},[],"Los operadores implementados son:",{"_3632":73403,"_31184":73317,"_21603":122279,"_5":14870,"_28376":122022,"_3083":122280},[],"`equals`, para igualdad exacta;",{"_3632":73404,"_31184":73317,"_21603":122282,"_5":14870,"_28376":122022,"_3083":122283},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3632":73405,"_31184":73317,"_21603":122285,"_5":14870,"_28376":122022,"_3083":122286},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3632":73406,"_31184":73317,"_21603":122288,"_5":14870,"_28376":122022,"_3083":122289},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3632":73407,"_31184":73317,"_21603":122291,"_5":14870,"_28376":122026,"_3083":122292},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3632":73408,"_31184":73317,"_21603":122294,"_5":14870,"_28376":122026,"_3083":122295},[],"Los modos disponibles son:",{"_3632":73409,"_31184":73317,"_21603":122297,"_5":14870,"_28376":122026,"_3083":122298},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3632":73410,"_31184":73317,"_21603":122300,"_5":14870,"_28376":122026,"_3083":122301},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3632":73411,"_31184":73317,"_21603":122303,"_5":14870,"_28376":122026,"_3083":122304},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3632":73412,"_31184":73317,"_21603":122306,"_5":14870,"_28376":122026,"_3083":122307},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3632":73413,"_31184":73317,"_21603":122309,"_5":14870,"_28376":122026,"_3083":122310},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3632":73414,"_31184":73317,"_21603":122312,"_5":14870,"_28376":122026,"_3083":122313},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3632":73415,"_31184":73317,"_21603":122315,"_5":14870,"_28376":122030,"_3083":122316},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3632":73416,"_31184":73317,"_21603":122318,"_5":14870,"_28376":122030,"_3083":122319},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3632":73417,"_31184":73317,"_21603":122321,"_5":14870,"_28376":122030,"_3083":122322},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3632":73418,"_31184":73317,"_21603":122324,"_5":14870,"_28376":122030,"_3083":122325},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3632":73419,"_31184":73317,"_21603":122327,"_5":14870,"_28376":122038,"_3083":122328},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3632":73420,"_31184":73317,"_21603":122330,"_5":14870,"_28376":122038,"_3083":122331},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3632":73421,"_31184":73317,"_21603":122333,"_5":14870,"_28376":122042,"_3083":122334},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3632":73422,"_31184":73317,"_21603":122336,"_5":14870,"_28376":122042,"_3083":122337},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3632":73423,"_31184":73317,"_21603":122339,"_5":14870,"_28376":122042,"_3083":122340},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3632":73424,"_31184":73317,"_21603":122342,"_5":14870,"_28376":122042,"_3083":122343},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3632":73425,"_31184":73317,"_21603":122345,"_5":14870,"_28376":122042,"_3083":122346},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3632":73426,"_31184":73317,"_21603":122348,"_5":14870,"_28376":122046,"_3083":122349},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3632":73427,"_31184":73317,"_21603":122351,"_5":14870,"_28376":122046,"_3083":122352},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3632":73428,"_31184":73317,"_21603":122354,"_5":14870,"_28376":122046,"_3083":122355},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3632":73429,"_31184":73317,"_21603":122357,"_5":14870,"_28376":122050,"_3083":122358},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3632":73430,"_31184":73317,"_21603":122360,"_5":14870,"_28376":122050,"_3083":122361},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3632":73431,"_31184":73317,"_21603":122363,"_5":14870,"_28376":122050,"_3083":122364},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3632":73432,"_31184":73317,"_21603":122366,"_5":14870,"_28376":122050,"_3083":122367},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3632":73433,"_31184":73317,"_21603":122369,"_5":14870,"_28376":122050,"_3083":122370},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3632":73434,"_31184":73317,"_21603":122372,"_5":14870,"_28376":122050,"_3083":122373},[],"Ten en cuenta que:",{"_3632":73435,"_31184":73317,"_21603":122375,"_5":14870,"_28376":122050,"_3083":122376},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3632":73436,"_31184":73317,"_21603":122378,"_5":14870,"_28376":122050,"_3083":122379},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3632":73437,"_31184":73317,"_21603":122381,"_5":14870,"_28376":122050,"_3083":122382},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3632":73438,"_31184":73317,"_21603":122384,"_5":14870,"_28376":122054,"_3083":122385},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3632":73439,"_31184":73317,"_21603":122387,"_5":14870,"_28376":122054,"_3083":122388},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3632":73440,"_31184":73317,"_21603":122390,"_5":14870,"_28376":122054,"_3083":122391},[],"acceso completo y de solo lectura a KMS;",{"_3632":73441,"_31184":73317,"_21603":122393,"_5":14870,"_28376":122054,"_3083":122394},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3632":73442,"_31184":73317,"_21603":122396,"_5":14870,"_28376":122054,"_3083":122397},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3632":73443,"_31184":73317,"_21603":122399,"_5":14870,"_28376":122054,"_3083":122400},[],"acceso a la interfaz;",{"_3632":73444,"_31184":73317,"_21603":122402,"_5":14870,"_28376":122054,"_3083":122403},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3632":73445,"_31184":73317,"_21603":122405,"_5":14870,"_28376":122054,"_3083":122406},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3632":73446,"_31184":73317,"_21603":122408,"_5":14870,"_28376":122054,"_3083":122409},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3632":73447,"_31184":73317,"_21603":122411,"_5":14870,"_28376":122054,"_3083":122412},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3632":73448,"_31184":73317,"_21603":122414,"_5":14870,"_28376":122054,"_3083":122415},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3632":73449,"_31184":73317,"_21603":122417,"_5":14870,"_28376":122058,"_3083":122418},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3632":73450,"_31184":73317,"_21603":122420,"_5":14870,"_28376":122058,"_3083":122421},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3632":73451,"_31184":73317,"_21603":122423,"_5":14870,"_28376":122058,"_3083":122424},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3632":73452,"_31184":73317,"_21603":122426,"_5":14870,"_28376":122061,"_3083":122427},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3632":73453,"_31184":73317,"_21603":122429,"_5":14870,"_28376":122065,"_3083":122430},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3632":73454,"_31184":73317,"_21603":122432,"_5":14870,"_28376":122065,"_3083":122433},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3632":73455,"_31184":73317,"_21603":122435,"_5":14870,"_28376":122069,"_3083":122436},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3632":73456,"_31184":73317,"_21603":122438,"_5":14870,"_28376":122073,"_3083":122439},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3632":73457,"_31184":73317,"_21603":122441,"_5":14870,"_28376":122077,"_3083":122442},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3632":73458,"_31184":73317,"_21603":122444,"_5":14870,"_28376":122081,"_3083":122445},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3632":73459,"_31184":73317,"_21603":122447,"_5":14870,"_28376":122081,"_3083":122448},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3632":73460,"_31184":73317,"_21603":122450,"_5":14870,"_28376":122085,"_3083":122451},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3632":73461,"_31184":73317,"_21603":122453,"_5":14870,"_28376":122085,"_3083":122454},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3632":73462,"_31184":73317,"_21603":122456,"_5":14870,"_28376":122085,"_3083":122457},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3632":73463,"_31184":73317,"_21603":122459,"_5":14870,"_28376":122085,"_3083":122460},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3632":73464,"_31184":73317,"_21603":122462,"_5":14870,"_28376":122085,"_3083":122463},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3632":73465,"_31184":73317,"_21603":122465,"_5":14870,"_28376":122085,"_3083":122466},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3632":73466,"_31184":73317,"_21603":122468,"_5":14870,"_28376":122085,"_3083":122469},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3632":73467,"_31184":73317,"_21603":122471,"_5":14870,"_28376":122085,"_3083":122472},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3632":73468,"_31184":73317,"_21603":122474,"_5":14870,"_28376":122089,"_3083":122475},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3632":73469,"_31184":73317,"_21603":122477,"_5":14870,"_28376":122089,"_3083":122478},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3632":73470,"_31184":73317,"_21603":122480,"_5":14870,"_28376":122089,"_3083":122481},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3632":73471,"_31184":73317,"_21603":122483,"_5":14870,"_28376":122093,"_3083":122484},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3632":73472,"_31184":73317,"_21603":122486,"_5":14870,"_28376":122093,"_3083":122487},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3632":73473,"_31184":73317,"_21603":122489,"_5":14870,"_28376":122093,"_3083":122490},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3632":73474,"_31184":73317,"_21603":122492,"_5":14870,"_28376":122093,"_3083":122493},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3632":73475,"_31184":73317,"_21603":122495,"_5":14870,"_28376":122093,"_3083":122496},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3632":73476,"_31184":73317,"_21603":122498,"_5":14870,"_28376":122093,"_3083":122499},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3632":73477,"_31184":73317,"_21603":122501,"_5":14870,"_28376":122093,"_3083":122502},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3632":73478,"_31184":73317,"_21603":122504,"_5":14870,"_28376":122093,"_3083":122505},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3632":73479,"_31184":73317,"_21603":122507,"_5":14870,"_28376":122101,"_3083":122508},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3632":73480,"_31184":73317,"_21603":122510,"_5":14870,"_28376":122105,"_3083":122511},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3632":73481,"_31184":73317,"_21603":122513,"_5":14870,"_28376":122105,"_3083":122514},[],"que exista un principal activo del tipo correcto;",{"_3632":73482,"_31184":73317,"_21603":122516,"_5":14870,"_28376":122105,"_3083":122517},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3632":73483,"_31184":73317,"_21603":122519,"_5":14870,"_28376":122105,"_3083":122520},[],"que todas las condiciones del principal se cumplan;",{"_3632":73484,"_31184":73317,"_21603":122522,"_5":14870,"_28376":122105,"_3083":122523},[],"que el principal tenga concedida la política esperada;",{"_3632":73485,"_31184":73317,"_21603":122525,"_5":14870,"_28376":122105,"_3083":122526},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3632":73486,"_31184":73317,"_21603":122528,"_5":14870,"_28376":122105,"_3083":122529},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3632":73487,"_31184":73317,"_21603":122531,"_5":14870,"_28376":122105,"_3083":122532},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3632":73488,"_31184":73317,"_21603":122534,"_5":14870,"_28376":122105,"_3083":122535},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3632":73489,"_31184":73317,"_21603":122537,"_5":14870,"_28376":122109,"_3083":122538},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3632":73490,"_31184":73317,"_21603":122540,"_5":14870,"_28376":122113,"_3083":122541},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3632":73491,"_31184":73317,"_21603":122543,"_5":14870,"_28376":122117,"_3083":122544},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3632":73492,"_31184":73317,"_21603":122546,"_5":14870,"_28376":122117,"_3083":122547},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3632":73493,"_31184":73493,"_5":15230,"_3083":122549,"_31522":122550,"_21603":122551,"_28376":73493},"Alertas y suscripciones",[50964,121884,121885],[],{"_3632":73494,"_31184":73493,"_21603":122553,"_5":14870,"_28376":73493,"_3083":122554},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3632":73495,"_31184":73493,"_5":31519,"_21603":122556,"_28376":122557,"_3083":122558},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3632":73496,"_31184":73493,"_5":31519,"_21603":122560,"_28376":122561,"_3083":122562},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3632":73497,"_31184":73493,"_5":31519,"_21603":122564,"_28376":122565,"_3083":122566},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3632":73498,"_31184":73493,"_5":31519,"_21603":122568,"_28376":122569,"_3083":122570},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3632":73499,"_31184":73493,"_5":31519,"_21603":122572,"_28376":122573,"_3083":122574},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3632":73500,"_31184":73493,"_5":31519,"_21603":122576,"_28376":122577,"_3083":122578},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3632":73501,"_31184":73493,"_5":31519,"_21603":122580,"_28376":122581,"_3083":122582},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3632":73502,"_31184":73493,"_5":31519,"_21603":122584,"_28376":122585,"_3083":122586},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3632":73503,"_31184":73493,"_5":31519,"_21603":122588,"_28376":122589,"_3083":122590},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3632":73504,"_31184":73493,"_5":31519,"_21603":122592,"_28376":122593,"_3083":122594},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3632":73505,"_31184":73493,"_5":31519,"_21603":122596,"_28376":122597,"_3083":122598},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3632":73506,"_31184":73493,"_21603":122600,"_5":14870,"_28376":73493,"_3083":122601},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3632":73507,"_31184":73493,"_21603":122603,"_5":14870,"_28376":122557,"_3083":122604},[],"Un servicio publica un evento de dominio.",{"_3632":73508,"_31184":73493,"_21603":122606,"_5":14870,"_28376":122557,"_3083":122607},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3632":73509,"_31184":73493,"_21603":122609,"_5":14870,"_28376":122557,"_3083":122610},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3632":73510,"_31184":73493,"_21603":122612,"_5":14870,"_28376":122557,"_3083":122613},[],"Lamassu entrega el evento al canal configurado.",{"_3632":73511,"_31184":73493,"_21603":122615,"_5":14870,"_28376":122557,"_3083":122616},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3632":73512,"_31184":73493,"_21603":122618,"_5":14870,"_28376":122561,"_3083":122619},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3632":73513,"_31184":73493,"_21603":122621,"_5":14870,"_28376":122561,"_3083":122622},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3632":73514,"_31184":73493,"_21603":122624,"_5":14870,"_28376":122561,"_3083":122625},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3632":73515,"_31184":73493,"_21603":122627,"_5":14870,"_28376":122561,"_3083":122628},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3632":73516,"_31184":73493,"_21603":122630,"_5":14870,"_28376":122561,"_3083":122631},[],"`apikey_options` necesita `header` y `key`.",{"_3632":73517,"_31184":73493,"_21603":122633,"_5":14870,"_28376":122561,"_3083":122634},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3632":73518,"_31184":73493,"_21603":122636,"_5":14870,"_28376":122561,"_3083":122637},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3632":73519,"_31184":73493,"_21603":122639,"_5":14870,"_28376":122561,"_3083":122640},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3632":73520,"_31184":73493,"_21603":122642,"_5":14870,"_28376":122569,"_3083":122643},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3632":73521,"_31184":73493,"_21603":122645,"_5":14870,"_28376":122573,"_3083":122646},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3632":73522,"_31184":73493,"_21603":122648,"_5":14870,"_28376":122577,"_3083":122649},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3632":73523,"_31184":73493,"_21603":122651,"_5":14870,"_28376":122577,"_3083":122652},[],"**None** notifica todas las instancias del evento.",{"_3632":73524,"_31184":73493,"_21603":122654,"_5":14870,"_28376":122577,"_3083":122655},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3632":73525,"_31184":73493,"_21603":122657,"_5":14870,"_28376":122577,"_3083":122658},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3632":73526,"_31184":73493,"_21603":122660,"_5":14870,"_28376":122577,"_3083":122661},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3632":73527,"_31184":73493,"_21603":122663,"_5":14870,"_28376":122577,"_3083":122664},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3632":73528,"_31184":73493,"_21603":122666,"_5":14870,"_28376":122577,"_3083":122667},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3632":73529,"_31184":73493,"_21603":122669,"_5":14870,"_28376":122581,"_3083":122670},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3632":73530,"_31184":73493,"_21603":122672,"_5":14870,"_28376":122585,"_3083":122673},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3632":73531,"_31184":73493,"_21603":122675,"_5":14870,"_28376":122585,"_3083":122676},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3632":73532,"_31184":73493,"_21603":122678,"_5":14870,"_28376":122585,"_3083":122679},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3632":73533,"_31184":73493,"_21603":122681,"_5":14870,"_28376":122585,"_3083":122682},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3632":73534,"_31184":73493,"_21603":122684,"_5":14870,"_28376":122585,"_3083":122685},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3632":73535,"_31184":73493,"_21603":122687,"_5":14870,"_28376":122585,"_3083":122688},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3632":73536,"_31184":73493,"_21603":122690,"_5":14870,"_28376":122585,"_3083":122691},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3632":73537,"_31184":73493,"_21603":122693,"_5":14870,"_28376":122585,"_3083":122694},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3632":73538,"_31184":73493,"_21603":122696,"_5":14870,"_28376":122589,"_3083":122697},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3632":73539,"_31184":73493,"_21603":122699,"_5":14870,"_28376":122589,"_3083":122700},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3632":73540,"_31184":73493,"_21603":122702,"_5":14870,"_28376":122589,"_3083":122703},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3632":73541,"_31184":73493,"_21603":122705,"_5":14870,"_28376":122589,"_3083":122706},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3632":73542,"_31184":73493,"_21603":122708,"_5":14870,"_28376":122589,"_3083":122709},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3632":73543,"_31184":73493,"_21603":122711,"_5":14870,"_28376":122589,"_3083":122712},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3632":73544,"_31184":73493,"_21603":122714,"_5":14870,"_28376":122589,"_3083":122715},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3632":73545,"_31184":73493,"_21603":122717,"_5":14870,"_28376":122589,"_3083":122718},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3632":73546,"_31184":73493,"_21603":122720,"_5":14870,"_28376":122593,"_3083":122721},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3632":73547,"_31184":73493,"_21603":122723,"_5":14870,"_28376":122593,"_3083":122724},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3632":73548,"_31184":73493,"_21603":122726,"_5":14870,"_28376":122597,"_3083":122727},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3632":73549,"_31184":73493,"_21603":122729,"_5":14870,"_28376":122597,"_3083":122730},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3632":73550,"_31184":73493,"_21603":122732,"_5":14870,"_28376":122597,"_3083":122733},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3632":73551,"_31184":73493,"_21603":122735,"_5":14870,"_28376":122597,"_3083":122736},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3632":73552,"_31184":73493,"_21603":122738,"_5":14870,"_28376":122597,"_3083":122739},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3632":73553,"_31184":73493,"_21603":122741,"_5":14870,"_28376":122597,"_3083":122742},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3632":73554,"_31184":73493,"_21603":122744,"_5":14870,"_28376":122597,"_3083":122745},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3632":73555,"_31184":73493,"_21603":122747,"_5":14870,"_28376":122597,"_3083":122748},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3632":73556,"_31184":73493,"_21603":122750,"_5":14870,"_28376":122597,"_3083":122751},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3632":73557,"_31184":73493,"_21603":122753,"_5":14870,"_28376":122597,"_3083":122754},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3632":73558,"_31184":73558,"_5":15230,"_3083":122756,"_31522":122757,"_21603":122758,"_28376":73558},"Registros de auditoría",[50964,121884,121885],[],{"_3632":73559,"_31184":73558,"_21603":122760,"_5":14870,"_28376":73558,"_3083":122761},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3632":73560,"_31184":73558,"_5":31519,"_21603":122763,"_28376":122764,"_3083":122765},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3632":73561,"_31184":73558,"_5":31519,"_21603":122767,"_28376":122768,"_3083":122769},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3632":73562,"_31184":73558,"_5":31519,"_21603":122771,"_28376":122772,"_3083":122773},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3632":73563,"_31184":73558,"_5":31519,"_21603":122775,"_28376":122776,"_3083":122777},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3632":73564,"_31184":73558,"_5":31519,"_21603":122779,"_28376":122780,"_3083":122781},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3632":73565,"_31184":73558,"_5":31519,"_21603":122783,"_28376":122784,"_3083":122785},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3632":73566,"_31184":73558,"_5":31519,"_21603":122787,"_28376":122788,"_3083":122789},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3632":73567,"_31184":73558,"_5":31519,"_21603":122791,"_28376":122792,"_3083":122793},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3632":73568,"_31184":73558,"_5":31519,"_21603":122795,"_28376":122796,"_3083":122797},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3632":73569,"_31184":73558,"_5":31519,"_21603":122799,"_28376":122800,"_3083":122801},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3632":73570,"_31184":73558,"_5":31519,"_21603":122803,"_28376":122804,"_3083":122805},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3632":73571,"_31184":73558,"_21603":122807,"_5":14870,"_28376":73558,"_3083":122808},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3632":73572,"_31184":73558,"_21603":122810,"_5":14870,"_28376":122764,"_3083":122811},[],"El cuerpo de auditoría incluye:",{"_3632":73573,"_31184":73558,"_21603":122813,"_5":14870,"_28376":122764,"_3083":122814},[],"input: datos recibidos por la operación;",{"_3632":73574,"_31184":73558,"_21603":122816,"_5":14870,"_28376":122764,"_3083":122817},[],"has\\_error: indica si el servicio devolvió un error;",{"_3632":73575,"_31184":73558,"_21603":122819,"_5":14870,"_28376":122764,"_3083":122820},[],"output: resultado producido o mensaje de error;",{"_3632":73576,"_31184":73558,"_21603":122822,"_5":14870,"_28376":122764,"_3083":122823},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3632":73577,"_31184":73558,"_21603":122825,"_5":14870,"_28376":122764,"_3083":122826},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3632":73578,"_31184":73558,"_21603":122828,"_5":14870,"_28376":122764,"_3083":122829},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3632":73579,"_31184":73558,"_21603":122831,"_5":14870,"_28376":122768,"_3083":122832},[],"El backend aplica auditoría a mutaciones de:",{"_3632":73580,"_31184":73558,"_21603":122834,"_5":14870,"_28376":122768,"_3083":122835},[],"autoridades, certificados y perfiles de emisión;",{"_3632":73581,"_31184":73558,"_21603":122837,"_5":14870,"_28376":122768,"_3083":122838},[],"claves y motores KMS;",{"_3632":73582,"_31184":73558,"_21603":122840,"_5":14870,"_28376":122768,"_3083":122841},[],"dispositivos e identidades;",{"_3632":73583,"_31184":73558,"_21603":122843,"_5":14870,"_28376":122768,"_3083":122844},[],"DMS y operaciones de enrolamiento;",{"_3632":73584,"_31184":73558,"_21603":122846,"_5":14870,"_28376":122768,"_3083":122847},[],"funciones de validación y CRL;",{"_3632":73585,"_31184":73558,"_21603":122849,"_5":14870,"_28376":122768,"_3083":122850},[],"principales, políticas y concesiones de autorización.",{"_3632":73586,"_31184":73558,"_21603":122852,"_5":14870,"_28376":122768,"_3083":122853},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3632":73587,"_31184":73558,"_21603":122855,"_5":14870,"_28376":122772,"_3083":122856},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3632":73588,"_31184":73558,"_21603":122858,"_5":14870,"_28376":122772,"_3083":122859},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3632":73589,"_31184":73558,"_21603":122861,"_5":14870,"_28376":122772,"_3083":122862},[],"Diseña el consumidor para:",{"_3632":73590,"_31184":73558,"_21603":122864,"_5":14870,"_28376":122772,"_3083":122865},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3632":73591,"_31184":73558,"_21603":122867,"_5":14870,"_28376":122772,"_3083":122868},[],"conservar el CloudEvent completo sin modificar;",{"_3632":73592,"_31184":73558,"_21603":122870,"_5":14870,"_28376":122772,"_3083":122871},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3632":73593,"_31184":73558,"_21603":122873,"_5":14870,"_28376":122772,"_3083":122874},[],"cifrar en tránsito y en reposo;",{"_3632":73594,"_31184":73558,"_21603":122876,"_5":14870,"_28376":122772,"_3083":122877},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3632":73595,"_31184":73558,"_21603":122879,"_5":14870,"_28376":122772,"_3083":122880},[],"aplicar una política explícita de retención y legal hold;",{"_3632":73596,"_31184":73558,"_21603":122882,"_5":14870,"_28376":122772,"_3083":122883},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3632":73597,"_31184":73558,"_21603":122885,"_5":14870,"_28376":122776,"_3083":122886},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3632":73598,"_31184":73558,"_21603":122888,"_5":14870,"_28376":122776,"_3083":122889},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3632":73599,"_31184":73558,"_21603":122891,"_5":14870,"_28376":122784,"_3083":122892},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3632":73600,"_31184":73558,"_21603":122894,"_5":14870,"_28376":122788,"_3083":122895},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3632":73601,"_31184":73558,"_21603":122897,"_5":14870,"_28376":122792,"_3083":122898},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3632":73602,"_31184":73558,"_21603":122900,"_5":14870,"_28376":122796,"_3083":122901},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3632":73603,"_31184":73558,"_21603":122903,"_5":14870,"_28376":122800,"_3083":122904},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3632":73604,"_31184":73558,"_21603":122906,"_5":14870,"_28376":122804,"_3083":122907},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3632":73605,"_31184":73558,"_21603":122909,"_5":14870,"_28376":122804,"_3083":122910},[],"aparece un evento de auditoría correcto;",{"_3632":73606,"_31184":73558,"_21603":122912,"_5":14870,"_28376":122804,"_3083":122913},[],"el principal coincide con la identidad utilizada;",{"_3632":73607,"_31184":73558,"_21603":122915,"_5":14870,"_28376":122804,"_3083":122916},[],"el consumidor lo persiste una sola vez;",{"_3632":73608,"_31184":73558,"_21603":122918,"_5":14870,"_28376":122804,"_3083":122919},[],"puede recuperarse por recurso, actor y periodo;",{"_3632":73609,"_31184":73558,"_21603":122921,"_5":14870,"_28376":122804,"_3083":122922},[],"una interrupción del consumidor produce una alerta.",{"_3632":73610,"_31184":73558,"_21603":122924,"_5":14870,"_28376":122804,"_3083":122925},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3632":73611,"_31184":73611,"_5":15230,"_3083":122927,"_31522":122928,"_21603":122929,"_28376":73611},"Arquitectura de la plataforma",[50964,121884],[],{"_3632":73612,"_31184":73611,"_21603":122931,"_5":14870,"_28376":73611,"_3083":122932},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3632":73613,"_31184":73611,"_5":31519,"_21603":122934,"_28376":122935,"_3083":122936},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3632":73614,"_31184":73611,"_5":31519,"_21603":122938,"_28376":122939,"_3083":122940},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3632":73615,"_31184":73611,"_5":31519,"_21603":122942,"_28376":122943,"_3083":122944},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3632":73616,"_31184":73611,"_5":31519,"_21603":122946,"_28376":122947,"_3083":122948},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3632":73617,"_31184":73611,"_5":31519,"_21603":122950,"_28376":122951,"_3083":122952},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3632":73618,"_31184":73611,"_21603":122954,"_5":14870,"_28376":73611,"_3083":122955},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3632":73619,"_31184":73611,"_21603":122957,"_5":14870,"_28376":73611,"_3083":122958},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3632":73620,"_31184":73611,"_21603":122960,"_5":14870,"_28376":122935,"_3083":122961},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3632":73621,"_31184":73611,"_21603":122963,"_5":14870,"_28376":122939,"_3083":122964},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3632":73622,"_31184":73611,"_21603":122966,"_5":14870,"_28376":122943,"_3083":122967},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3632":73623,"_31184":73611,"_21603":122969,"_5":14870,"_28376":122947,"_3083":122970},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3632":73624,"_31184":73611,"_21603":122972,"_5":14870,"_28376":122951,"_3083":122973},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3632":73625,"_31184":73625,"_5":15230,"_3083":122975,"_31522":122976,"_21603":122977,"_28376":73625},"Cómo funciona Lamassu",[50964,121884],[],{"_3632":73626,"_31184":73625,"_21603":122979,"_5":14870,"_28376":73625,"_3083":122980},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3632":73627,"_31184":73625,"_5":31519,"_21603":122982,"_28376":122983,"_3083":122984},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3632":73628,"_31184":73625,"_5":31519,"_21603":122986,"_28376":122987,"_3083":122988},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3632":73629,"_31184":73625,"_21603":122990,"_5":14870,"_28376":73625,"_3083":122991},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3632":73630,"_31184":73625,"_21603":122993,"_5":14870,"_28376":122983,"_3083":122994},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3632":73631,"_31184":73625,"_21603":122996,"_5":14870,"_28376":122983,"_3083":122997},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3632":73632,"_31184":73625,"_21603":122999,"_5":14870,"_28376":122983,"_3083":123000},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3632":73633,"_31184":73625,"_21603":123002,"_5":14870,"_28376":122983,"_3083":123003},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3632":73634,"_31184":73625,"_21603":123005,"_5":14870,"_28376":122983,"_3083":123006},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3632":73635,"_31184":73625,"_21603":123008,"_5":14870,"_28376":122987,"_3083":123009},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3632":73636,"_31184":73625,"_21603":123011,"_5":14870,"_28376":122987,"_3083":123012},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3632":73637,"_31184":73625,"_21603":123014,"_5":14870,"_28376":122987,"_3083":123015},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3632":73638,"_31184":73625,"_21603":123017,"_5":14870,"_28376":122987,"_3083":123018},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3632":73639,"_31184":73625,"_21603":123020,"_5":14870,"_28376":122987,"_3083":123021},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3632":73640,"_31184":73625,"_21603":123023,"_5":14870,"_28376":122987,"_3083":123024},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3632":73641,"_31184":73625,"_21603":123026,"_5":14870,"_28376":122987,"_3083":123027},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3632":73642,"_31184":73642,"_5":15230,"_3083":123029,"_31522":123030,"_21603":123031,"_28376":73642},"Dispositivos e identidades",[50964,121884,53648,123029],[],{"_3632":73643,"_31184":73642,"_21603":123033,"_5":14870,"_28376":73642,"_3083":123034},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3632":73644,"_31184":73642,"_5":31519,"_21603":123036,"_28376":123037,"_3083":123038},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3632":73645,"_31184":73642,"_5":31519,"_21603":123040,"_28376":123041,"_3083":123042},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3632":73646,"_31184":73642,"_5":31519,"_21603":123044,"_28376":123045,"_3083":123046},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3632":73647,"_31184":73642,"_5":31519,"_21603":123048,"_28376":123049,"_3083":123050},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3632":73648,"_31184":73642,"_5":31519,"_21603":123052,"_28376":123053,"_3083":123054},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3632":73649,"_31184":73642,"_5":31519,"_21603":123056,"_28376":123057,"_3083":123058},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3632":73650,"_31184":73642,"_5":31519,"_21603":123060,"_28376":123061,"_3083":123062},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3632":73651,"_31184":73642,"_5":31519,"_21603":123064,"_28376":123065,"_3083":123066},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3632":73652,"_31184":73642,"_5":31519,"_21603":123068,"_28376":123069,"_3083":123070},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3632":73653,"_31184":73642,"_5":31519,"_21603":123072,"_28376":123073,"_3083":123074},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3632":73654,"_31184":73642,"_5":31519,"_21603":123076,"_28376":123077,"_3083":123078},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3632":73655,"_31184":73642,"_21603":123080,"_5":14870,"_28376":73642,"_3083":123081},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3632":73656,"_31184":73642,"_21603":123083,"_5":14870,"_28376":73642,"_3083":123084},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3632":73657,"_31184":73642,"_21603":123086,"_5":14870,"_28376":123037,"_3083":123087},[],"Vista operativa",{"_3632":73658,"_31184":73642,"_21603":123089,"_5":14870,"_28376":123037,"_3083":123090},[],"Interpretación",{"_3632":73659,"_31184":73642,"_21603":123092,"_5":14870,"_28376":123037,"_3083":53711},[],{"_3632":73660,"_31184":73642,"_21603":123094,"_5":14870,"_28376":123037,"_3083":123095},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3632":73661,"_31184":73642,"_21603":123097,"_5":14870,"_28376":123037,"_3083":53717},[],{"_3632":73662,"_31184":73642,"_21603":123099,"_5":14870,"_28376":123037,"_3083":123100},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3632":73663,"_31184":73642,"_21603":123102,"_5":14870,"_28376":123037,"_3083":53723},[],{"_3632":73664,"_31184":73642,"_21603":123104,"_5":14870,"_28376":123037,"_3083":123105},[],"La identidad está en la ventana operativa de renovación.",{"_3632":73665,"_31184":73642,"_21603":123107,"_5":14870,"_28376":123037,"_3083":53729},[],{"_3632":73666,"_31184":73642,"_21603":123109,"_5":14870,"_28376":123037,"_3083":123110},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3632":73667,"_31184":73642,"_21603":123112,"_5":14870,"_28376":123037,"_3083":53735},[],{"_3632":73668,"_31184":73642,"_21603":123114,"_5":14870,"_28376":123037,"_3083":123115},[],"La identidad ha vencido.",{"_3632":73669,"_31184":73642,"_21603":123117,"_5":14870,"_28376":123037,"_3083":53741},[],{"_3632":73670,"_31184":73642,"_21603":123119,"_5":14870,"_28376":123037,"_3083":123120},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3632":73671,"_31184":73642,"_21603":123122,"_5":14870,"_28376":123037,"_3083":53747},[],{"_3632":73672,"_31184":73642,"_21603":123124,"_5":14870,"_28376":123037,"_3083":123125},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3632":73673,"_31184":73642,"_21603":123127,"_5":14870,"_28376":123037,"_3083":123128},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3632":73674,"_31184":73642,"_21603":123130,"_5":14870,"_28376":123041,"_3083":123131},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3632":73675,"_31184":73642,"_21603":123133,"_5":14870,"_28376":123041,"_3083":123134},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3632":73676,"_31184":73642,"_21603":123136,"_5":14870,"_28376":123041,"_3083":123137},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3632":73677,"_31184":73642,"_21603":123139,"_5":14870,"_28376":123041,"_3083":123140},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3632":73678,"_31184":73642,"_21603":123142,"_5":14870,"_28376":123045,"_3083":123143},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3632":73679,"_31184":73642,"_21603":123145,"_5":14870,"_28376":123049,"_3083":123146},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3632":73680,"_31184":73642,"_21603":123148,"_5":14870,"_28376":123053,"_3083":123149},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3632":73681,"_31184":73642,"_21603":123151,"_5":14870,"_28376":123057,"_3083":123152},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3632":73682,"_31184":73642,"_21603":123154,"_5":14870,"_28376":123061,"_3083":123155},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3632":73683,"_31184":73642,"_21603":123157,"_5":14870,"_28376":123061,"_3083":123158},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3632":73684,"_31184":73642,"_21603":123160,"_5":14870,"_28376":123065,"_3083":123161},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3632":73685,"_31184":73642,"_21603":123163,"_5":14870,"_28376":123065,"_3083":123164},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3632":73686,"_31184":73642,"_21603":123166,"_5":14870,"_28376":123065,"_3083":123167},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3632":73687,"_31184":73642,"_21603":123169,"_5":14870,"_28376":123065,"_3083":123170},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3632":73688,"_31184":73642,"_21603":123172,"_5":14870,"_28376":123065,"_3083":123173},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3632":73689,"_31184":73642,"_21603":123175,"_5":14870,"_28376":123065,"_3083":123176},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3632":73690,"_31184":73642,"_21603":123178,"_5":14870,"_28376":123069,"_3083":123179},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3632":73691,"_31184":73642,"_21603":123181,"_5":14870,"_28376":123069,"_3083":123182},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3632":73692,"_31184":73642,"_21603":123184,"_5":14870,"_28376":123069,"_3083":123185},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3632":73693,"_31184":73642,"_21603":123187,"_5":14870,"_28376":123073,"_3083":123188},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3632":73694,"_31184":73642,"_21603":123190,"_5":14870,"_28376":123073,"_3083":123191},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3632":73695,"_31184":73642,"_21603":123193,"_5":14870,"_28376":123073,"_3083":123194},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3632":73696,"_31184":73642,"_21603":123196,"_5":14870,"_28376":123073,"_3083":123197},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3632":73697,"_31184":73642,"_21603":123199,"_5":14870,"_28376":123077,"_3083":123200},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":73698,"_31184":73642,"_21603":123202,"_5":14870,"_28376":123077,"_3083":123203},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":73699,"_31184":73699,"_5":15230,"_3083":123205,"_31522":123206,"_21603":123208,"_28376":73699},"Identidad inicial y autenticación",[50964,121884,53648,123029,123207],"Enrolamiento con PKI",[],{"_3632":73700,"_31184":73699,"_21603":123210,"_5":14870,"_28376":73699,"_3083":123211},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3632":73701,"_31184":73699,"_5":31519,"_21603":123213,"_28376":123214,"_3083":123215},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3632":73702,"_31184":73699,"_5":31519,"_21603":123217,"_28376":123218,"_3083":123219},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3632":73703,"_31184":73699,"_5":31519,"_21603":123221,"_28376":123222,"_3083":123223},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3632":73704,"_31184":73699,"_5":31519,"_21603":123225,"_28376":123226,"_3083":123227},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3632":73705,"_31184":73699,"_5":31519,"_21603":123229,"_28376":123230,"_3083":123231},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3632":73706,"_31184":73699,"_21603":123233,"_5":14870,"_28376":73699,"_3083":123234},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3632":73707,"_31184":73699,"_21603":123236,"_5":14870,"_28376":123214,"_3083":123237},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3632":73708,"_31184":73699,"_21603":123239,"_5":14870,"_28376":123214,"_3083":123240},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3632":73709,"_31184":73699,"_21603":123242,"_5":14870,"_28376":123218,"_3083":123243},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3632":73710,"_31184":73699,"_21603":123245,"_5":14870,"_28376":123218,"_3083":123246},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3632":73711,"_31184":73699,"_21603":123248,"_5":14870,"_28376":123218,"_3083":123249},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3632":73712,"_31184":73699,"_21603":123251,"_5":14870,"_28376":123222,"_3083":123252},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3632":73713,"_31184":73699,"_21603":123254,"_5":14870,"_28376":123222,"_3083":123255},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3632":73714,"_31184":73699,"_21603":123257,"_5":14870,"_28376":123226,"_3083":123258},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3632":73715,"_31184":73699,"_21603":123260,"_5":14870,"_28376":123226,"_3083":123261},[],"Ejemplo de cuerpo:",{"_3632":73716,"_31184":73699,"_21603":123263,"_5":14870,"_28376":123226,"_3083":123264},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3632":73717,"_31184":73699,"_21603":123266,"_5":14870,"_28376":123226,"_3083":123267},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3632":73718,"_31184":73699,"_21603":123269,"_5":14870,"_28376":123226,"_3083":123270},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3632":73719,"_31184":73699,"_21603":123272,"_5":14870,"_28376":123226,"_3083":123273},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3632":73720,"_31184":73699,"_21603":123275,"_5":14870,"_28376":123230,"_3083":123276},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3632":73721,"_31184":73699,"_21603":123278,"_5":14870,"_28376":123230,"_3083":123279},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3632":73722,"_31184":73699,"_21603":123281,"_5":14870,"_28376":123230,"_3083":123282},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3632":73723,"_31184":73699,"_21603":123284,"_5":14870,"_28376":123230,"_3083":123285},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3632":73724,"_31184":73724,"_5":15230,"_3083":123287,"_31522":123288,"_21603":123289,"_28376":73724},"Configura y opera el DMS",[50964,121884,53648,123029,123207],[],{"_3632":73725,"_31184":73724,"_21603":123291,"_5":14870,"_28376":73724,"_3083":123292},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3632":73726,"_31184":73724,"_5":31519,"_21603":123294,"_28376":123295,"_3083":120418},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3632":73727,"_31184":73724,"_5":31519,"_21603":123297,"_28376":123298,"_3083":123299},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3632":73728,"_31184":73724,"_5":31519,"_21603":123301,"_28376":123302,"_3083":123303},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3632":73729,"_31184":73724,"_5":31519,"_21603":123305,"_28376":123306,"_3083":123307},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3632":73730,"_31184":73724,"_5":31519,"_21603":123309,"_28376":123310,"_3083":123311},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3632":73731,"_31184":73724,"_5":31519,"_21603":123313,"_28376":123314,"_3083":123315},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3632":73732,"_31184":73724,"_5":31519,"_21603":123317,"_28376":123318,"_3083":123319},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3632":73733,"_31184":73724,"_5":31519,"_21603":123321,"_28376":123322,"_3083":123323},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3632":73734,"_31184":73724,"_5":31519,"_21603":123325,"_28376":123326,"_3083":53952},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3632":73735,"_31184":73724,"_5":31519,"_21603":123328,"_28376":123329,"_3083":53956},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3632":73736,"_31184":73724,"_5":31519,"_21603":123331,"_28376":123332,"_3083":123333},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3632":73737,"_31184":73724,"_5":31519,"_21603":123335,"_28376":123336,"_3083":123337},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3632":73738,"_31184":73724,"_5":31519,"_21603":123339,"_28376":123340,"_3083":123341},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3632":73739,"_31184":73724,"_5":31519,"_21603":123343,"_28376":123344,"_3083":123345},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3632":73740,"_31184":73724,"_5":31519,"_21603":123347,"_28376":123348,"_3083":53976},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3632":73741,"_31184":73724,"_5":31519,"_21603":123350,"_28376":123351,"_3083":123352},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3632":73742,"_31184":73724,"_5":31519,"_21603":123354,"_28376":123355,"_3083":123356},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3632":73743,"_31184":73724,"_5":31519,"_21603":123358,"_28376":123359,"_3083":123360},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3632":73744,"_31184":73724,"_21603":123362,"_5":14870,"_28376":73724,"_3083":123363},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3632":73745,"_31184":73724,"_21603":123365,"_5":14870,"_28376":123295,"_3083":123366},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3632":73746,"_31184":73724,"_21603":123368,"_5":14870,"_28376":123295,"_3083":123369},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3632":73747,"_31184":73724,"_21603":123371,"_5":14870,"_28376":123302,"_3083":123372},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3632":73748,"_31184":73724,"_21603":123374,"_5":14870,"_28376":123306,"_3083":123375},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3632":73749,"_31184":73724,"_21603":123377,"_5":14870,"_28376":123310,"_3083":123378},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3632":73750,"_31184":73724,"_21603":123380,"_5":14870,"_28376":123314,"_3083":123381},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3632":73751,"_31184":73724,"_21603":123383,"_5":14870,"_28376":123318,"_3083":123384},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3632":73752,"_31184":73724,"_21603":123386,"_5":14870,"_28376":123326,"_3083":123387},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3632":73753,"_31184":73724,"_21603":123389,"_5":14870,"_28376":123326,"_3083":123390},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3632":73754,"_31184":73724,"_21603":123392,"_5":14870,"_28376":123329,"_3083":123393},[],"Campo de `settings.enrollment_settings`",{"_3632":73755,"_31184":73724,"_21603":123395,"_5":14870,"_28376":123329,"_3083":123396},[],"Decisión",{"_3632":73756,"_31184":73724,"_21603":123398,"_5":14870,"_28376":123329,"_3083":54027},[],{"_3632":73757,"_31184":73724,"_21603":123400,"_5":14870,"_28376":123329,"_3083":123401},[],"`EST_RFC7030` para estas operaciones.",{"_3632":73758,"_31184":73724,"_21603":123403,"_5":14870,"_28376":123329,"_3083":54033},[],{"_3632":73759,"_31184":73724,"_21603":123405,"_5":14870,"_28376":123329,"_3083":123406},[],"ID de la CA que firmará.",{"_3632":73760,"_31184":73724,"_21603":123408,"_5":14870,"_28376":123329,"_3083":54039},[],{"_3632":73761,"_31184":73724,"_21603":123410,"_5":14870,"_28376":123329,"_3083":123411},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3632":73762,"_31184":73724,"_21603":123413,"_5":14870,"_28376":123329,"_3083":54045},[],{"_3632":73763,"_31184":73724,"_21603":123415,"_5":14870,"_28376":123329,"_3083":123416},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3632":73764,"_31184":73724,"_21603":123418,"_5":14870,"_28376":123329,"_3083":54051},[],{"_3632":73765,"_31184":73724,"_21603":123420,"_5":14870,"_28376":123329,"_3083":123421},[],"Uno de los cuatro modos de autenticación.",{"_3632":73766,"_31184":73724,"_21603":123423,"_5":14870,"_28376":123329,"_3083":123424},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3632":73767,"_31184":73724,"_21603":123426,"_5":14870,"_28376":123332,"_3083":123427},[],"Los bloques son independientes:",{"_3632":73768,"_31184":73724,"_21603":123429,"_5":14870,"_28376":123332,"_3083":123430},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3632":73769,"_31184":73724,"_21603":123432,"_5":14870,"_28376":123332,"_3083":123433},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3632":73770,"_31184":73724,"_21603":123435,"_5":14870,"_28376":123332,"_3083":54069},[],{"_3632":73771,"_31184":73724,"_21603":123437,"_5":14870,"_28376":123332,"_3083":123438},[],"Control aplicado en la operación configurada",{"_3632":73772,"_31184":73724,"_21603":123440,"_5":14870,"_28376":123332,"_3083":54075},[],{"_3632":73773,"_31184":73724,"_21603":123442,"_5":14870,"_28376":123332,"_3083":123443},[],"Validación del certificado presentado.",{"_3632":73774,"_31184":73724,"_21603":123445,"_5":14870,"_28376":123332,"_3083":54081},[],{"_3632":73775,"_31184":73724,"_21603":123447,"_5":14870,"_28376":123332,"_3083":123448},[],"Autorización del webhook configurado.",{"_3632":73776,"_31184":73724,"_21603":123450,"_5":14870,"_28376":123332,"_3083":54087},[],{"_3632":73777,"_31184":73724,"_21603":123452,"_5":14870,"_28376":123332,"_3083":123453},[],"Validación del certificado y, después, aprobación del webhook.",{"_3632":73778,"_31184":73724,"_21603":123455,"_5":14870,"_28376":123332,"_3083":54093},[],{"_3632":73779,"_31184":73724,"_21603":123457,"_5":14870,"_28376":123332,"_3083":123458},[],"Sin autenticación del solicitante por el DMS.",{"_3632":73780,"_31184":73724,"_21603":123460,"_5":14870,"_28376":123332,"_3083":123461},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3632":73781,"_31184":73724,"_21603":123463,"_5":14870,"_28376":123332,"_3083":123464},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3632":73782,"_31184":73724,"_21603":123466,"_5":14870,"_28376":123332,"_3083":123467},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3632":73783,"_31184":73724,"_21603":123469,"_5":14870,"_28376":123332,"_3083":123470},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3632":73784,"_31184":73724,"_21603":123472,"_5":14870,"_28376":123332,"_3083":123473},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3632":73785,"_31184":73724,"_21603":123475,"_5":14870,"_28376":123336,"_3083":123476},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3632":73786,"_31184":73724,"_21603":123478,"_5":14870,"_28376":123336,"_3083":123479},[],"Campo de `external_webhook_settings`",{"_3632":73787,"_31184":73724,"_21603":123481,"_5":14870,"_28376":123336,"_3083":123396},[],{"_3632":73788,"_31184":73724,"_21603":123483,"_5":14870,"_28376":123336,"_3083":54122},[],{"_3632":73789,"_31184":73724,"_21603":123485,"_5":14870,"_28376":123336,"_3083":123486},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3632":73790,"_31184":73724,"_21603":123488,"_5":14870,"_28376":123336,"_3083":54128},[],{"_3632":73791,"_31184":73724,"_21603":123490,"_5":14870,"_28376":123336,"_3083":123491},[],"`POST` o `PUT`; `POST` por defecto.",{"_3632":73792,"_31184":73724,"_21603":123493,"_5":14870,"_28376":123336,"_3083":54134},[],{"_3632":73793,"_31184":73724,"_21603":123495,"_5":14870,"_28376":123336,"_3083":123496},[],"Etiqueta usada en los logs del servicio.",{"_3632":73794,"_31184":73724,"_21603":123498,"_5":14870,"_28376":123336,"_3083":54140},[],{"_3632":73795,"_31184":73724,"_21603":123500,"_5":14870,"_28376":123336,"_3083":123501},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3632":73796,"_31184":73724,"_21603":123503,"_5":14870,"_28376":123336,"_3083":54146},[],{"_3632":73797,"_31184":73724,"_21603":123505,"_5":14870,"_28376":123336,"_3083":123506},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3632":73798,"_31184":73724,"_21603":123508,"_5":14870,"_28376":123336,"_3083":54152},[],{"_3632":73799,"_31184":73724,"_21603":123510,"_5":14870,"_28376":123336,"_3083":123511},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3632":73800,"_31184":73724,"_21603":123513,"_5":14870,"_28376":123336,"_3083":54158},[],{"_3632":73801,"_31184":73724,"_21603":123515,"_5":14870,"_28376":123336,"_3083":123516},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3632":73802,"_31184":73724,"_21603":123518,"_5":14870,"_28376":123336,"_3083":54164},[],{"_3632":73803,"_31184":73724,"_21603":123520,"_5":14870,"_28376":123336,"_3083":123521},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3632":73804,"_31184":73724,"_21603":123523,"_5":14870,"_28376":123336,"_3083":54170},[],{"_3632":73805,"_31184":73724,"_21603":123525,"_5":14870,"_28376":123336,"_3083":123526},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3632":73806,"_31184":73724,"_21603":123528,"_5":14870,"_28376":123336,"_3083":54176},[],{"_3632":73807,"_31184":73724,"_21603":123530,"_5":14870,"_28376":123336,"_3083":123531},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3632":73808,"_31184":73724,"_21603":123533,"_5":14870,"_28376":123336,"_3083":123534},[],"Reglas de esa configuración:",{"_3632":73809,"_31184":73724,"_21603":123536,"_5":14870,"_28376":123336,"_3083":123537},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3632":73810,"_31184":73724,"_21603":123539,"_5":14870,"_28376":123336,"_3083":123540},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3632":73811,"_31184":73724,"_21603":123542,"_5":14870,"_28376":123336,"_3083":123543},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3632":73812,"_31184":73724,"_21603":123545,"_5":14870,"_28376":123336,"_3083":123546},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3632":73813,"_31184":73724,"_21603":123548,"_5":14870,"_28376":123336,"_3083":123549},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3632":73814,"_31184":73724,"_21603":123551,"_5":14870,"_28376":123336,"_3083":123552},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3632":73815,"_31184":73724,"_21603":123554,"_5":14870,"_28376":123336,"_3083":123555},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3632":73816,"_31184":73724,"_21603":123557,"_5":14870,"_28376":123336,"_3083":123558},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3632":73817,"_31184":73724,"_21603":123560,"_5":14870,"_28376":123336,"_3083":123561},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3632":73818,"_31184":73724,"_21603":123563,"_5":14870,"_28376":123340,"_3083":123564},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3632":73819,"_31184":73724,"_21603":123566,"_5":14870,"_28376":123344,"_3083":123567},[],"Campo de `settings.reenrollment_settings`",{"_3632":73820,"_31184":73724,"_21603":123569,"_5":14870,"_28376":123344,"_3083":123570},[],"Función",{"_3632":73821,"_31184":73724,"_21603":123572,"_5":14870,"_28376":123344,"_3083":54220},[],{"_3632":73822,"_31184":73724,"_21603":123574,"_5":14870,"_28376":123344,"_3083":123575},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3632":73823,"_31184":73724,"_21603":123577,"_5":14870,"_28376":123344,"_3083":54226},[],{"_3632":73824,"_31184":73724,"_21603":123579,"_5":14870,"_28376":123344,"_3083":123580},[],"Umbral operativo preventivo de monitorización.",{"_3632":73825,"_31184":73724,"_21603":123582,"_5":14870,"_28376":123344,"_3083":54232},[],{"_3632":73826,"_31184":73724,"_21603":123584,"_5":14870,"_28376":123344,"_3083":123585},[],"Umbral operativo crítico de monitorización.",{"_3632":73827,"_31184":73724,"_21603":123587,"_5":14870,"_28376":123344,"_3083":54238},[],{"_3632":73828,"_31184":73724,"_21603":123589,"_5":14870,"_28376":123344,"_3083":123590},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3632":73829,"_31184":73724,"_21603":123592,"_5":14870,"_28376":123344,"_3083":54244},[],{"_3632":73830,"_31184":73724,"_21603":123594,"_5":14870,"_28376":123344,"_3083":123595},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3632":73831,"_31184":73724,"_21603":123597,"_5":14870,"_28376":123344,"_3083":54250},[],{"_3632":73832,"_31184":73724,"_21603":123599,"_5":14870,"_28376":123344,"_3083":123600},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3632":73833,"_31184":73724,"_21603":123602,"_5":14870,"_28376":123344,"_3083":123603},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3632":73834,"_31184":73724,"_21603":123605,"_5":14870,"_28376":123348,"_3083":123606},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3632":73835,"_31184":73724,"_21603":123608,"_5":14870,"_28376":123351,"_3083":120782},[],{"_3632":73836,"_31184":73724,"_21603":123610,"_5":14870,"_28376":123351,"_3083":123611},[],"Qué publica",{"_3632":73837,"_31184":73724,"_21603":123613,"_5":14870,"_28376":123351,"_3083":54267},[],{"_3632":73838,"_31184":73724,"_21603":123615,"_5":14870,"_28376":123351,"_3083":123616},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3632":73839,"_31184":73724,"_21603":123618,"_5":14870,"_28376":123351,"_3083":54273},[],{"_3632":73840,"_31184":73724,"_21603":123620,"_5":14870,"_28376":123351,"_3083":123621},[],"Certificado de la CA emisora seleccionada.",{"_3632":73841,"_31184":73724,"_21603":123623,"_5":14870,"_28376":123351,"_3083":54279},[],{"_3632":73842,"_31184":73724,"_21603":123625,"_5":14870,"_28376":123351,"_3083":123626},[],"Certificados de las CAs elegidas explícitamente.",{"_3632":73843,"_31184":73724,"_21603":123628,"_5":14870,"_28376":123351,"_3083":123629},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3632":73844,"_31184":73724,"_21603":123631,"_5":14870,"_28376":123355,"_3083":123632},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3632":73845,"_31184":73724,"_21603":123634,"_5":14870,"_28376":123355,"_3083":123635},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3632":73846,"_31184":73724,"_21603":123637,"_5":14870,"_28376":123355,"_3083":123638},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3632":73847,"_31184":73724,"_21603":123640,"_5":14870,"_28376":123359,"_3083":123641},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3632":73848,"_31184":73848,"_5":15230,"_3083":123643,"_31522":123644,"_21603":123645,"_28376":73848},"Integra el cliente EST",[50964,121884,53648,123029,123207],[],{"_3632":73849,"_31184":73848,"_21603":123647,"_5":14870,"_28376":73848,"_3083":123648},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3632":73850,"_31184":73848,"_5":31519,"_21603":123650,"_28376":123651,"_3083":120418},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3632":73851,"_31184":73848,"_5":31519,"_21603":123653,"_28376":123654,"_3083":123655},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3632":73852,"_31184":73848,"_5":31519,"_21603":123657,"_28376":123658,"_3083":123659},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3632":73853,"_31184":73848,"_5":31519,"_21603":123661,"_28376":123662,"_3083":123663},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3632":73854,"_31184":73848,"_5":31519,"_21603":123665,"_28376":123666,"_3083":123667},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3632":73855,"_31184":73848,"_5":31519,"_21603":123669,"_28376":123670,"_3083":123671},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3632":73856,"_31184":73848,"_21603":123673,"_5":14870,"_28376":73848,"_3083":123674},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3632":73857,"_31184":73848,"_21603":123676,"_5":14870,"_28376":123651,"_3083":123677},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3632":73858,"_31184":73848,"_21603":123679,"_5":14870,"_28376":123651,"_3083":123680},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3632":73859,"_31184":73848,"_21603":123682,"_5":14870,"_28376":123651,"_3083":123683},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3632":73860,"_31184":73848,"_21603":123685,"_5":14870,"_28376":123654,"_3083":123686},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3632":73861,"_31184":73848,"_21603":123688,"_5":14870,"_28376":123654,"_3083":123689},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3632":73862,"_31184":73848,"_21603":123691,"_5":14870,"_28376":123658,"_3083":123692},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3632":73863,"_31184":73848,"_21603":123694,"_5":14870,"_28376":123658,"_3083":123695},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3632":73864,"_31184":73848,"_21603":123697,"_5":14870,"_28376":123662,"_3083":123698},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3632":73865,"_31184":73848,"_21603":123700,"_5":14870,"_28376":123662,"_3083":123701},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3632":73866,"_31184":73848,"_21603":123703,"_5":14870,"_28376":123666,"_3083":123704},[],"Para el caso de una raíz que emite directamente:",{"_3632":73867,"_31184":73848,"_21603":123706,"_5":14870,"_28376":123666,"_3083":123707},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3632":73868,"_31184":73848,"_21603":123709,"_5":14870,"_28376":123666,"_3083":123710},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3632":73869,"_31184":73848,"_21603":123712,"_5":14870,"_28376":123670,"_3083":123713},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3632":73870,"_31184":73870,"_5":15230,"_3083":123715,"_31522":123716,"_21603":123717,"_28376":73870},"Referencia EST",[50964,121884,53648,123029,123207],[],{"_3632":73871,"_31184":73870,"_21603":123719,"_5":14870,"_28376":73870,"_3083":123720},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3632":73872,"_31184":73870,"_5":31519,"_21603":123722,"_28376":123723,"_3083":123724},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3632":73873,"_31184":73870,"_5":31519,"_21603":123726,"_28376":123727,"_3083":23406},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3632":73874,"_31184":73870,"_5":31519,"_21603":123729,"_28376":123730,"_3083":26921},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3632":73875,"_31184":73870,"_5":31519,"_21603":123732,"_28376":123733,"_3083":26928},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3632":73876,"_31184":73870,"_5":31519,"_21603":123735,"_28376":123736,"_3083":26190},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3632":73877,"_31184":73870,"_5":31519,"_21603":123738,"_28376":123739,"_3083":123740},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3632":73878,"_31184":73870,"_5":31519,"_21603":123742,"_28376":123743,"_3083":123744},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3632":73879,"_31184":73870,"_5":31519,"_21603":123746,"_28376":123747,"_3083":123748},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3632":73880,"_31184":73870,"_21603":123750,"_5":14870,"_28376":73870,"_3083":123751},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3632":73881,"_31184":73870,"_21603":123753,"_5":14870,"_28376":123723,"_3083":123754},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3632":73882,"_31184":73870,"_21603":123756,"_5":14870,"_28376":123723,"_3083":121644},[],{"_3632":73883,"_31184":73870,"_21603":123758,"_5":14870,"_28376":123723,"_3083":123759},[],"Método",{"_3632":73884,"_31184":73870,"_21603":123761,"_5":14870,"_28376":123723,"_3083":123762},[],"Autenticación y condición",{"_3632":73885,"_31184":73870,"_21603":123764,"_5":14870,"_28376":123723,"_3083":54422},[],{"_3632":73886,"_31184":73870,"_21603":123766,"_5":14870,"_28376":123723,"_3083":54425},[],{"_3632":73887,"_31184":73870,"_21603":123768,"_5":14870,"_28376":123723,"_3083":123769},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3632":73888,"_31184":73870,"_21603":123771,"_5":14870,"_28376":123723,"_3083":54431},[],{"_3632":73889,"_31184":73870,"_21603":123773,"_5":14870,"_28376":123723,"_3083":54434},[],{"_3632":73890,"_31184":73870,"_21603":123775,"_5":14870,"_28376":123723,"_3083":123776},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3632":73891,"_31184":73870,"_21603":123778,"_5":14870,"_28376":123723,"_3083":54440},[],{"_3632":73892,"_31184":73870,"_21603":123780,"_5":14870,"_28376":123723,"_3083":54434},[],{"_3632":73893,"_31184":73870,"_21603":123782,"_5":14870,"_28376":123723,"_3083":123783},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3632":73894,"_31184":73870,"_21603":123785,"_5":14870,"_28376":123723,"_3083":54448},[],{"_3632":73895,"_31184":73870,"_21603":123787,"_5":14870,"_28376":123723,"_3083":54434},[],{"_3632":73896,"_31184":73870,"_21603":123789,"_5":14870,"_28376":123723,"_3083":123790},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3632":73897,"_31184":73870,"_21603":123792,"_5":14870,"_28376":123723,"_3083":123793},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3632":73898,"_31184":73870,"_21603":123795,"_5":14870,"_28376":123727,"_3083":123796},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3632":73899,"_31184":73870,"_21603":123798,"_5":14870,"_28376":123727,"_3083":123799},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3632":73900,"_31184":73870,"_21603":123801,"_5":14870,"_28376":123730,"_3083":123802},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3632":73901,"_31184":73870,"_21603":123804,"_5":14870,"_28376":123730,"_3083":123805},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3632":73902,"_31184":73870,"_21603":123807,"_5":14870,"_28376":123733,"_3083":123808},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3632":73903,"_31184":73870,"_21603":123810,"_5":14870,"_28376":123733,"_3083":123811},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3632":73904,"_31184":73870,"_21603":123813,"_5":14870,"_28376":123736,"_3083":123814},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3632":73905,"_31184":73870,"_21603":123816,"_5":14870,"_28376":123736,"_3083":123817},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3632":73906,"_31184":73870,"_21603":123819,"_5":14870,"_28376":123739,"_3083":123820},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3632":73907,"_31184":73870,"_21603":123822,"_5":14870,"_28376":123739,"_3083":123823},[],"Parte",{"_3632":73908,"_31184":73870,"_21603":123825,"_5":14870,"_28376":123739,"_3083":123826},[],"Contenido tras decodificar su Base64",{"_3632":73909,"_31184":73870,"_21603":123828,"_5":14870,"_28376":123739,"_3083":54492},[],{"_3632":73910,"_31184":73870,"_21603":123830,"_5":14870,"_28376":123739,"_3083":123831},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3632":73911,"_31184":73870,"_21603":123833,"_5":14870,"_28376":123739,"_3083":54498},[],{"_3632":73912,"_31184":73870,"_21603":123835,"_5":14870,"_28376":123739,"_3083":123836},[],"PKCS#7 DER con el certificado emitido.",{"_3632":73913,"_31184":73870,"_21603":123838,"_5":14870,"_28376":123739,"_3083":123839},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3632":73914,"_31184":73870,"_21603":123841,"_5":14870,"_28376":123743,"_3083":123842},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3632":73915,"_31184":73870,"_21603":123844,"_5":14870,"_28376":123743,"_3083":123845},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3632":73916,"_31184":73870,"_21603":123847,"_5":14870,"_28376":123743,"_3083":123848},[],"Convierte y comprueba el resultado:",{"_3632":73917,"_31184":73870,"_21603":123850,"_5":14870,"_28376":123743,"_3083":123851},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3632":73918,"_31184":73870,"_21603":123853,"_5":14870,"_28376":123747,"_3083":123854},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3632":73919,"_31184":73870,"_21603":123856,"_5":14870,"_28376":123747,"_3083":123857},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3632":73920,"_31184":73920,"_5":15230,"_3083":123207,"_31522":123859,"_21603":123860,"_28376":73920},[50964,121884,53648,123029,123207],[],{"_3632":73921,"_31184":73920,"_21603":123862,"_5":14870,"_28376":73920,"_3083":123863},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3632":73922,"_31184":73920,"_5":31519,"_21603":123865,"_28376":123866,"_3083":123867},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3632":73923,"_31184":73920,"_5":31519,"_21603":123869,"_28376":123870,"_3083":123871},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3632":73924,"_31184":73920,"_5":31519,"_21603":123873,"_28376":123874,"_3083":123875},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3632":73925,"_31184":73920,"_21603":123877,"_5":14870,"_28376":73920,"_3083":123878},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3632":73926,"_31184":73920,"_21603":123880,"_5":14870,"_28376":123866,"_3083":123881},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3632":73927,"_31184":73920,"_21603":123883,"_5":14870,"_28376":123866,"_3083":123884},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3632":73928,"_31184":73920,"_21603":123886,"_5":14870,"_28376":123866,"_3083":123887},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3632":73929,"_31184":73920,"_21603":123889,"_5":14870,"_28376":123866,"_3083":123890},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3632":73930,"_31184":73920,"_21603":123892,"_5":14870,"_28376":123866,"_3083":123893},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3632":73931,"_31184":73920,"_21603":123895,"_5":14870,"_28376":123866,"_3083":123896},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3632":73932,"_31184":73920,"_21603":123898,"_5":14870,"_28376":123870,"_3083":123899},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3632":73933,"_31184":73920,"_21603":123901,"_5":14870,"_28376":123870,"_3083":123902},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":73934,"_31184":73920,"_21603":123904,"_5":14870,"_28376":123870,"_3083":123905},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3632":73935,"_31184":73920,"_21603":123907,"_5":14870,"_28376":123870,"_3083":123908},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3632":73936,"_31184":73920,"_21603":123910,"_5":14870,"_28376":123874,"_3083":123911},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":73937,"_31184":73920,"_21603":123913,"_5":14870,"_28376":123874,"_3083":123914},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":73938,"_31184":73920,"_21603":123916,"_5":14870,"_28376":123874,"_3083":123917},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3632":73939,"_31184":73920,"_21603":123919,"_5":14870,"_28376":123874,"_3083":123920},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3632":73940,"_31184":73920,"_21603":123922,"_5":14870,"_28376":123874,"_3083":123923},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3632":73941,"_31184":73941,"_5":15230,"_3083":123925,"_31522":123926,"_21603":123927,"_28376":73941},"Estrategias de aprovisionamiento",[50964,121884,53648,123029,123207],[],{"_3632":73942,"_31184":73941,"_21603":123929,"_5":14870,"_28376":73941,"_3083":123930},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3632":73943,"_31184":73941,"_5":31519,"_21603":123932,"_28376":123933,"_3083":123934},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3632":73944,"_31184":73941,"_5":31519,"_21603":123936,"_28376":123937,"_3083":123938},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3632":73945,"_31184":73941,"_5":31519,"_21603":123940,"_28376":123941,"_3083":123942},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3632":73946,"_31184":73941,"_5":31519,"_21603":123944,"_28376":123945,"_3083":123946},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3632":73947,"_31184":73941,"_5":31519,"_21603":123948,"_28376":123949,"_3083":123950},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3632":73948,"_31184":73941,"_21603":123952,"_5":14870,"_28376":73941,"_3083":123953},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3632":73949,"_31184":73941,"_21603":123955,"_5":14870,"_28376":123933,"_3083":123956},[],"Recorrido",{"_3632":73950,"_31184":73941,"_21603":123958,"_5":14870,"_28376":123933,"_3083":123959},[],"Cuándo existe el dispositivo",{"_3632":73951,"_31184":73941,"_21603":123961,"_5":14870,"_28376":123933,"_3083":123962},[],"Qué compruebas",{"_3632":73952,"_31184":73941,"_21603":123964,"_5":14870,"_28376":123933,"_3083":123965},[],"Asignación manual",{"_3632":73953,"_31184":73941,"_21603":123967,"_5":14870,"_28376":123933,"_3083":123968},[],"El operador lo crea antes de asociar un certificado.",{"_3632":73954,"_31184":73941,"_21603":123970,"_5":14870,"_28376":123933,"_3083":123971},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3632":73955,"_31184":73941,"_21603":123973,"_5":14870,"_28376":123933,"_3083":123974},[],"EST con `JITP`",{"_3632":73956,"_31184":73941,"_21603":123976,"_5":14870,"_28376":123933,"_3083":123977},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3632":73957,"_31184":73941,"_21603":123979,"_5":14870,"_28376":123933,"_3083":123980},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3632":73958,"_31184":73941,"_21603":123982,"_5":14870,"_28376":123933,"_3083":123983},[],"EST con `PRE_REGISTRATION`",{"_3632":73959,"_31184":73941,"_21603":123985,"_5":14870,"_28376":123933,"_3083":123986},[],"Debe existir antes de `/simpleenroll`.",{"_3632":73960,"_31184":73941,"_21603":123988,"_5":14870,"_28376":123933,"_3083":123989},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3632":73961,"_31184":73941,"_21603":123991,"_5":14870,"_28376":123933,"_3083":123992},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3632":73962,"_31184":73941,"_21603":123994,"_5":14870,"_28376":123933,"_3083":123995},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3632":73963,"_31184":73941,"_21603":123997,"_5":14870,"_28376":123937,"_3083":123998},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3632":73964,"_31184":73941,"_21603":124000,"_5":14870,"_28376":123937,"_3083":124001},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3632":73965,"_31184":73941,"_21603":124003,"_5":14870,"_28376":123937,"_3083":124004},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3632":73966,"_31184":73941,"_21603":124006,"_5":14870,"_28376":123941,"_3083":124007},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3632":73967,"_31184":73941,"_21603":124009,"_5":14870,"_28376":123941,"_3083":124010},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3632":73968,"_31184":73941,"_21603":124012,"_5":14870,"_28376":123941,"_3083":124013},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3632":73969,"_31184":73941,"_21603":124015,"_5":14870,"_28376":123941,"_3083":124016},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3632":73970,"_31184":73941,"_21603":124018,"_5":14870,"_28376":123941,"_3083":124019},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3632":73971,"_31184":73941,"_21603":124021,"_5":14870,"_28376":123941,"_3083":124022},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3632":73972,"_31184":73941,"_21603":124024,"_5":14870,"_28376":123945,"_3083":120782},[],{"_3632":73973,"_31184":73941,"_21603":124026,"_5":14870,"_28376":123945,"_3083":124027},[],"Material que atraviesa EST",{"_3632":73974,"_31184":73941,"_21603":124029,"_5":14870,"_28376":123945,"_3083":124030},[],"Clave generada por el dispositivo",{"_3632":73975,"_31184":73941,"_21603":124032,"_5":14870,"_28376":123945,"_3083":124033},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3632":73976,"_31184":73941,"_21603":124035,"_5":14870,"_28376":123945,"_3083":124036},[],"Clave ya disponible en el dispositivo",{"_3632":73977,"_31184":73941,"_21603":124038,"_5":14870,"_28376":123945,"_3083":124039},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3632":73978,"_31184":73941,"_21603":124041,"_5":14870,"_28376":123945,"_3083":53976},[],{"_3632":73979,"_31184":73941,"_21603":124043,"_5":14870,"_28376":123945,"_3083":124044},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3632":73980,"_31184":73941,"_21603":124046,"_5":14870,"_28376":123945,"_3083":124047},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3632":73981,"_31184":73941,"_21603":124049,"_5":14870,"_28376":123949,"_3083":124050},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3632":73982,"_31184":73982,"_5":15230,"_3083":124052,"_31522":124053,"_21603":124054,"_28376":73982},"Renovación y recuperación",[50964,121884,53648,123029,123207],[],{"_3632":73983,"_31184":73982,"_21603":124056,"_5":14870,"_28376":73982,"_3083":124057},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3632":73984,"_31184":73982,"_5":31519,"_21603":124059,"_28376":124060,"_3083":124061},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3632":73985,"_31184":73982,"_5":31519,"_21603":124063,"_28376":124064,"_3083":124065},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3632":73986,"_31184":73982,"_5":31519,"_21603":124067,"_28376":124068,"_3083":124069},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3632":73987,"_31184":73982,"_5":31519,"_21603":124071,"_28376":124072,"_3083":124073},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3632":73988,"_31184":73982,"_5":31519,"_21603":124075,"_28376":124076,"_3083":124077},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3632":73989,"_31184":73982,"_21603":124079,"_5":14870,"_28376":73982,"_3083":124080},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3632":73990,"_31184":73982,"_21603":124082,"_5":14870,"_28376":124060,"_3083":124083},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3632":73991,"_31184":73982,"_21603":124085,"_5":14870,"_28376":124060,"_3083":124086},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3632":73992,"_31184":73982,"_21603":124088,"_5":14870,"_28376":124060,"_3083":124089},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3632":73993,"_31184":73982,"_21603":124091,"_5":14870,"_28376":124060,"_3083":124092},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3632":73994,"_31184":73982,"_21603":124094,"_5":14870,"_28376":124064,"_3083":124095},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3632":73995,"_31184":73982,"_21603":124097,"_5":14870,"_28376":124064,"_3083":124098},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3632":73996,"_31184":73982,"_21603":124100,"_5":14870,"_28376":124068,"_3083":124101},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3632":73997,"_31184":73982,"_21603":124103,"_5":14870,"_28376":124068,"_3083":124104},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3632":73998,"_31184":73982,"_21603":124106,"_5":14870,"_28376":124068,"_3083":124107},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3632":73999,"_31184":73982,"_21603":124109,"_5":14870,"_28376":124072,"_3083":124110},[],"Situación",{"_3632":74000,"_31184":73982,"_21603":124112,"_5":14870,"_28376":124072,"_3083":124113},[],"Procedimiento",{"_3632":74001,"_31184":73982,"_21603":124115,"_5":14870,"_28376":124072,"_3083":124116},[],"Certificado vigente, fuera de ventana",{"_3632":74002,"_31184":73982,"_21603":124118,"_5":14870,"_28376":124072,"_3083":124119},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3632":74003,"_31184":73982,"_21603":124121,"_5":14870,"_28376":124072,"_3083":124122},[],"Certificado vencido, clave disponible",{"_3632":74004,"_31184":73982,"_21603":124124,"_5":14870,"_28376":124072,"_3083":124125},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3632":74005,"_31184":73982,"_21603":124127,"_5":14870,"_28376":124072,"_3083":124128},[],"Renovación por webhook o `NO_AUTH`",{"_3632":74006,"_31184":73982,"_21603":124130,"_5":14870,"_28376":124072,"_3083":124131},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3632":74007,"_31184":73982,"_21603":124133,"_5":14870,"_28376":124072,"_3083":124134},[],"Clave perdida o inaccesible",{"_3632":74008,"_31184":73982,"_21603":124136,"_5":14870,"_28376":124072,"_3083":124137},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3632":74009,"_31184":73982,"_21603":124139,"_5":14870,"_28376":124072,"_3083":124140},[],"Identidad actual revocada",{"_3632":74010,"_31184":73982,"_21603":124142,"_5":14870,"_28376":124072,"_3083":124143},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3632":74011,"_31184":73982,"_21603":124145,"_5":14870,"_28376":124072,"_3083":124146},[],"Dispositivo sin identidad",{"_3632":74012,"_31184":73982,"_21603":124148,"_5":14870,"_28376":124072,"_3083":124149},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3632":74013,"_31184":73982,"_21603":124151,"_5":14870,"_28376":124072,"_3083":124152},[],"Dispositivo retirado",{"_3632":74014,"_31184":73982,"_21603":124154,"_5":14870,"_28376":124072,"_3083":124155},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3632":74015,"_31184":73982,"_21603":124157,"_5":14870,"_28376":124072,"_3083":124158},[],"Timeout, HTTP 500 o fallo de instalación",{"_3632":74016,"_31184":73982,"_21603":124160,"_5":14870,"_28376":124072,"_3083":124161},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3632":74017,"_31184":73982,"_21603":124163,"_5":14870,"_28376":124076,"_3083":124164},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3632":74018,"_31184":73982,"_21603":124166,"_5":14870,"_28376":124076,"_3083":124167},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3632":74019,"_31184":74019,"_5":15230,"_3083":124169,"_31522":124170,"_21603":124171,"_28376":74019},"Diagnóstico de enrolamiento",[50964,121884,53648,123029,123207],[],{"_3632":74020,"_31184":74019,"_21603":124173,"_5":14870,"_28376":74019,"_3083":124174},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3632":74021,"_31184":74019,"_5":31519,"_21603":124176,"_28376":124177,"_3083":124178},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3632":74022,"_31184":74019,"_5":31519,"_21603":124180,"_28376":124181,"_3083":124182},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3632":74023,"_31184":74019,"_5":31519,"_21603":124184,"_28376":124185,"_3083":123748},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3632":74024,"_31184":74019,"_5":31519,"_21603":124187,"_28376":124188,"_3083":124189},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3632":74025,"_31184":74019,"_21603":124191,"_5":14870,"_28376":74019,"_3083":124192},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3632":74026,"_31184":74019,"_21603":124194,"_5":14870,"_28376":124181,"_3083":124195},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3632":74027,"_31184":74019,"_21603":124197,"_5":14870,"_28376":124181,"_3083":124198},[],"Síntoma o mensaje",{"_3632":74028,"_31184":74019,"_21603":124200,"_5":14870,"_28376":124181,"_3083":124201},[],"Qué revisar",{"_3632":74029,"_31184":74019,"_21603":124203,"_5":14870,"_28376":124181,"_3083":124204},[],"curl rechaza TLS, nombre o emisor",{"_3632":74030,"_31184":74019,"_21603":124206,"_5":14870,"_28376":124181,"_3083":124207},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3632":74031,"_31184":74019,"_21603":124209,"_5":14870,"_28376":124181,"_3083":124210},[],"404 o APS ausente",{"_3632":74032,"_31184":74019,"_21603":124212,"_5":14870,"_28376":124181,"_3083":124213},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3632":74033,"_31184":74019,"_21603":124215,"_5":14870,"_28376":124181,"_3083":124216},[],"400, error de CSR o formato",{"_3632":74034,"_31184":74019,"_21603":124218,"_5":14870,"_28376":124181,"_3083":124219},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3632":74035,"_31184":74019,"_21603":124221,"_5":14870,"_28376":124181,"_3083":124222},[],"Credencial ausente o certificado no válido",{"_3632":74036,"_31184":74019,"_21603":124224,"_5":14870,"_28376":124181,"_3083":124225},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3632":74037,"_31184":74019,"_21603":124227,"_5":14870,"_28376":124181,"_3083":124228},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3632":74038,"_31184":74019,"_21603":124230,"_5":14870,"_28376":124181,"_3083":124231},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3632":74039,"_31184":74019,"_21603":124233,"_5":14870,"_28376":124181,"_3083":124234},[],"Webhook deniega, expira o responde sin autorización",{"_3632":74040,"_31184":74019,"_21603":124236,"_5":14870,"_28376":124181,"_3083":124237},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3632":74041,"_31184":74019,"_21603":124239,"_5":14870,"_28376":124181,"_3083":54904},[],{"_3632":74042,"_31184":74019,"_21603":124241,"_5":14870,"_28376":124181,"_3083":124242},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3632":74043,"_31184":74019,"_21603":124244,"_5":14870,"_28376":124181,"_3083":54910},[],{"_3632":74044,"_31184":74019,"_21603":124246,"_5":14870,"_28376":124181,"_3083":124247},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3632":74045,"_31184":74019,"_21603":124249,"_5":14870,"_28376":124181,"_3083":54916},[],{"_3632":74046,"_31184":74019,"_21603":124251,"_5":14870,"_28376":124181,"_3083":124252},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3632":74047,"_31184":74019,"_21603":124254,"_5":14870,"_28376":124181,"_3083":54922},[],{"_3632":74048,"_31184":74019,"_21603":124256,"_5":14870,"_28376":124181,"_3083":124257},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3632":74049,"_31184":74019,"_21603":124259,"_5":14870,"_28376":124181,"_3083":54928},[],{"_3632":74050,"_31184":74019,"_21603":124261,"_5":14870,"_28376":124181,"_3083":124262},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3632":74051,"_31184":74019,"_21603":124264,"_5":14870,"_28376":124181,"_3083":124265},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3632":74052,"_31184":74019,"_21603":124267,"_5":14870,"_28376":124181,"_3083":124268},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3632":74053,"_31184":74019,"_21603":124270,"_5":14870,"_28376":124181,"_3083":124271},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3632":74054,"_31184":74019,"_21603":124273,"_5":14870,"_28376":124181,"_3083":124274},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3632":74055,"_31184":74019,"_21603":124276,"_5":14870,"_28376":124181,"_3083":54946},[],{"_3632":74056,"_31184":74019,"_21603":124278,"_5":14870,"_28376":124181,"_3083":124279},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3632":74057,"_31184":74019,"_21603":124281,"_5":14870,"_28376":124181,"_3083":54952},[],{"_3632":74058,"_31184":74019,"_21603":124283,"_5":14870,"_28376":124181,"_3083":124284},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3632":74059,"_31184":74019,"_21603":124286,"_5":14870,"_28376":124181,"_3083":124287},[],"DMS propietario distinto",{"_3632":74060,"_31184":74019,"_21603":124289,"_5":14870,"_28376":124181,"_3083":124290},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3632":74061,"_31184":74019,"_21603":124292,"_5":14870,"_28376":124181,"_3083":54964},[],{"_3632":74062,"_31184":74019,"_21603":124294,"_5":14870,"_28376":124181,"_3083":124295},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3632":74063,"_31184":74019,"_21603":124297,"_5":14870,"_28376":124181,"_3083":54970},[],{"_3632":74064,"_31184":74019,"_21603":124299,"_5":14870,"_28376":124181,"_3083":124300},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3632":74065,"_31184":74019,"_21603":124302,"_5":14870,"_28376":124181,"_3083":124303},[],"Certificado actual revocado",{"_3632":74066,"_31184":74019,"_21603":124305,"_5":14870,"_28376":124181,"_3083":124306},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3632":74067,"_31184":74019,"_21603":124308,"_5":14870,"_28376":124181,"_3083":124309},[],"Error de CA, perfil o firma",{"_3632":74068,"_31184":74019,"_21603":124311,"_5":14870,"_28376":124181,"_3083":124312},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3632":74069,"_31184":74019,"_21603":124314,"_5":14870,"_28376":124181,"_3083":124315},[],"HTTP 200 sin conexión del dispositivo",{"_3632":74070,"_31184":74019,"_21603":124317,"_5":14870,"_28376":124181,"_3083":124318},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3632":74071,"_31184":74019,"_21603":124320,"_5":14870,"_28376":124181,"_3083":124321},[],"Timeout o error después de emitir",{"_3632":74072,"_31184":74019,"_21603":124323,"_5":14870,"_28376":124181,"_3083":124324},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3632":74073,"_31184":74019,"_21603":124326,"_5":14870,"_28376":124185,"_3083":124327},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3632":74074,"_31184":74019,"_21603":124329,"_5":14870,"_28376":124185,"_3083":124330},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3632":74075,"_31184":74019,"_21603":124332,"_5":14870,"_28376":124188,"_3083":124333},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3632":74076,"_31184":74019,"_21603":124335,"_5":14870,"_28376":124188,"_3083":124336},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3632":74077,"_31184":74019,"_21603":124338,"_5":14870,"_28376":124188,"_3083":124339},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3632":74078,"_31184":74019,"_21603":124341,"_5":14870,"_28376":124188,"_3083":124342},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3632":74079,"_31184":74019,"_21603":124344,"_5":14870,"_28376":124188,"_3083":124345},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3632":74080,"_31184":74019,"_21603":124347,"_5":14870,"_28376":124188,"_3083":124348},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3632":74081,"_31184":74019,"_21603":124350,"_5":14870,"_28376":124188,"_3083":124351},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3632":74082,"_31184":74082,"_5":15230,"_3083":124353,"_31522":124354,"_21603":124355,"_28376":74082},"Distribución y actualización de confianza",[50964,121884,53648,123029,123207],[],{"_3632":74083,"_31184":74082,"_21603":124357,"_5":14870,"_28376":74082,"_3083":124358},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3632":74084,"_31184":74082,"_5":31519,"_21603":124360,"_28376":124361,"_3083":124362},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3632":74085,"_31184":74082,"_5":31519,"_21603":124364,"_28376":124365,"_3083":124366},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3632":74086,"_31184":74082,"_5":31519,"_21603":124368,"_28376":124369,"_3083":124370},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3632":74087,"_31184":74082,"_5":31519,"_21603":124372,"_28376":124373,"_3083":124374},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3632":74088,"_31184":74082,"_5":31519,"_21603":124376,"_28376":124377,"_3083":124378},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3632":74089,"_31184":74082,"_21603":124380,"_5":14870,"_28376":74082,"_3083":124381},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3632":74090,"_31184":74082,"_21603":124383,"_5":14870,"_28376":124361,"_3083":124384},[],"Relación",{"_3632":74091,"_31184":74082,"_21603":124386,"_5":14870,"_28376":124361,"_3083":124387},[],"Material que prepara el responsable",{"_3632":74092,"_31184":74082,"_21603":124389,"_5":14870,"_28376":124361,"_3083":124390},[],"Dispositivo → servidor EST",{"_3632":74093,"_31184":74082,"_21603":124392,"_5":14870,"_28376":124361,"_3083":124393},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3632":74094,"_31184":74082,"_21603":124395,"_5":14870,"_28376":124361,"_3083":124396},[],"DMS → solicitante",{"_3632":74095,"_31184":74082,"_21603":124398,"_5":14870,"_28376":124361,"_3083":124399},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3632":74096,"_31184":74082,"_21603":124401,"_5":14870,"_28376":124361,"_3083":124402},[],"Consumidor → dispositivo",{"_3632":74097,"_31184":74082,"_21603":124404,"_5":14870,"_28376":124361,"_3083":124405},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3632":74098,"_31184":74082,"_21603":124407,"_5":14870,"_28376":124361,"_3083":124408},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3632":74099,"_31184":74082,"_21603":124410,"_5":14870,"_28376":124365,"_3083":124411},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3632":74100,"_31184":74082,"_21603":124413,"_5":14870,"_28376":124365,"_3083":124414},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3632":74101,"_31184":74082,"_21603":124416,"_5":14870,"_28376":124369,"_3083":124417},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3632":74102,"_31184":74082,"_21603":124419,"_5":14870,"_28376":124369,"_3083":124420},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3632":74103,"_31184":74082,"_21603":124422,"_5":14870,"_28376":124369,"_3083":124423},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3632":74104,"_31184":74082,"_21603":124425,"_5":14870,"_28376":124369,"_3083":124426},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3632":74105,"_31184":74082,"_21603":124428,"_5":14870,"_28376":124369,"_3083":124429},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3632":74106,"_31184":74082,"_21603":124431,"_5":14870,"_28376":124369,"_3083":124432},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3632":74107,"_31184":74082,"_21603":124434,"_5":14870,"_28376":124373,"_3083":124435},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3632":74108,"_31184":74082,"_21603":124437,"_5":14870,"_28376":124373,"_3083":124438},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3632":74109,"_31184":74082,"_21603":124440,"_5":14870,"_28376":124373,"_3083":124441},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3632":74110,"_31184":74082,"_21603":124443,"_5":14870,"_28376":124377,"_3083":124444},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3632":74111,"_31184":74111,"_5":15230,"_3083":55119,"_31522":124446,"_21603":124448,"_28376":74111},[50964,121884,53648,123029,124447],"Integraciones",[],{"_3632":74112,"_31184":74111,"_21603":124450,"_5":14870,"_28376":74111,"_3083":124451},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3632":74113,"_31184":74111,"_5":31519,"_21603":124453,"_28376":124454,"_3083":124455},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3632":74114,"_31184":74111,"_5":31519,"_21603":124457,"_28376":124458,"_3083":124459},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3632":74115,"_31184":74111,"_5":31519,"_21603":124461,"_28376":124462,"_3083":124463},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3632":74116,"_31184":74111,"_5":31519,"_21603":124465,"_28376":124466,"_3083":124467},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3632":74117,"_31184":74111,"_5":31519,"_21603":124469,"_28376":124470,"_3083":124471},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3632":74118,"_31184":74111,"_5":31519,"_21603":124473,"_28376":124474,"_3083":124475},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3632":74119,"_31184":74111,"_5":31519,"_21603":124477,"_28376":124478,"_3083":124479},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3632":74120,"_31184":74111,"_5":31519,"_21603":124481,"_28376":124482,"_3083":124483},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3632":74121,"_31184":74111,"_5":31519,"_21603":124485,"_28376":124486,"_3083":55161},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3632":74122,"_31184":74111,"_5":31519,"_21603":124488,"_28376":124489,"_3083":55165},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3632":74123,"_31184":74111,"_5":31519,"_21603":124491,"_28376":124492,"_3083":124493},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3632":74124,"_31184":74111,"_5":31519,"_21603":124495,"_28376":124496,"_3083":124497},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3632":74125,"_31184":74111,"_5":31519,"_21603":124499,"_28376":124500,"_3083":124501},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3632":74126,"_31184":74111,"_5":31519,"_21603":124503,"_28376":124504,"_3083":124505},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3632":74127,"_31184":74111,"_5":31519,"_21603":124507,"_28376":124508,"_3083":124509},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3632":74128,"_31184":74111,"_5":31519,"_21603":124511,"_28376":124512,"_3083":124513},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3632":74129,"_31184":74111,"_5":31519,"_21603":124515,"_28376":124516,"_3083":124517},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3632":74130,"_31184":74111,"_5":31519,"_21603":124519,"_28376":124520,"_3083":124521},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3632":74131,"_31184":74111,"_5":31519,"_21603":124523,"_28376":124524,"_3083":124525},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3632":74132,"_31184":74111,"_5":31519,"_21603":124527,"_28376":124528,"_3083":124529},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3632":74133,"_31184":74111,"_5":31519,"_21603":124531,"_28376":124532,"_3083":124533},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3632":74134,"_31184":74111,"_5":31519,"_21603":124535,"_28376":124536,"_3083":124537},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3632":74135,"_31184":74111,"_5":31519,"_21603":124539,"_28376":124540,"_3083":124541},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3632":74136,"_31184":74111,"_5":31519,"_21603":124543,"_28376":124544,"_3083":124545},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3632":74137,"_31184":74111,"_5":31519,"_21603":124547,"_28376":124548,"_3083":124549},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3632":74138,"_31184":74111,"_21603":124551,"_5":14870,"_28376":74111,"_3083":124552},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3632":74139,"_31184":74111,"_21603":124554,"_5":14870,"_28376":74111,"_3083":124555},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3632":74140,"_31184":74111,"_21603":124557,"_5":14870,"_28376":74111,"_3083":124558},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3632":74141,"_31184":74111,"_21603":124560,"_5":14870,"_28376":124454,"_3083":124561},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3632":74142,"_31184":74111,"_21603":124563,"_5":14870,"_28376":124454,"_3083":124564},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3632":74143,"_31184":74111,"_21603":124566,"_5":14870,"_28376":124454,"_3083":124567},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3632":74144,"_31184":74111,"_21603":124569,"_5":14870,"_28376":124454,"_3083":124570},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3632":74145,"_31184":74111,"_21603":124572,"_5":14870,"_28376":124458,"_3083":124573},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3632":74146,"_31184":74111,"_21603":124575,"_5":14870,"_28376":124462,"_3083":124576},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3632":74147,"_31184":74111,"_21603":124578,"_5":14870,"_28376":124462,"_3083":124579},[],"Acción IAM",{"_3632":74148,"_31184":74111,"_21603":124581,"_5":14870,"_28376":124462,"_3083":120788},[],{"_3632":74149,"_31184":74111,"_21603":124583,"_5":14870,"_28376":124462,"_3083":55260},[],{"_3632":74150,"_31184":74111,"_21603":124585,"_5":14870,"_28376":124462,"_3083":124586},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3632":74151,"_31184":74111,"_21603":124588,"_5":14870,"_28376":124462,"_3083":55266},[],{"_3632":74152,"_31184":74111,"_21603":124590,"_5":14870,"_28376":124462,"_3083":124591},[],"Registrar la CA en AWS IoT",{"_3632":74153,"_31184":74111,"_21603":124593,"_5":14870,"_28376":124462,"_3083":55272},[],{"_3632":74154,"_31184":74111,"_21603":124595,"_5":14870,"_28376":124462,"_3083":124596},[],"Consultar el estado del registro de la CA",{"_3632":74155,"_31184":74111,"_21603":124598,"_5":14870,"_28376":124462,"_3083":55278},[],{"_3632":74156,"_31184":74111,"_21603":124600,"_5":14870,"_28376":124462,"_3083":124601},[],"Crear o actualizar Things en IoT Core",{"_3632":74157,"_31184":74111,"_21603":124603,"_5":14870,"_28376":124462,"_3083":55284},[],{"_3632":74158,"_31184":74111,"_21603":124605,"_5":14870,"_28376":124462,"_3083":124606},[],"Aprovisionar Things mediante plantilla",{"_3632":74159,"_31184":74111,"_21603":124608,"_5":14870,"_28376":124462,"_3083":55290},[],{"_3632":74160,"_31184":74111,"_21603":124610,"_5":14870,"_28376":124462,"_3083":124611},[],"Registrar certificados de dispositivo",{"_3632":74161,"_31184":74111,"_21603":124613,"_5":14870,"_28376":124462,"_3083":55296},[],{"_3632":74162,"_31184":74111,"_21603":124615,"_5":14870,"_28376":124462,"_3083":124616},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3632":74163,"_31184":74111,"_21603":124618,"_5":14870,"_28376":124462,"_3083":55302},[],{"_3632":74164,"_31184":74111,"_21603":124620,"_5":14870,"_28376":124462,"_3083":124621},[],"Crear y adjuntar políticas IoT",{"_3632":74165,"_31184":74111,"_21603":124623,"_5":14870,"_28376":124462,"_3083":55308},[],{"_3632":74166,"_31184":74111,"_21603":124625,"_5":14870,"_28376":124462,"_3083":124626},[],"Gestionar grupos de Things",{"_3632":74167,"_31184":74111,"_21603":124628,"_5":14870,"_28376":124462,"_3083":55314},[],{"_3632":74168,"_31184":74111,"_21603":124630,"_5":14870,"_28376":124462,"_3083":124631},[],"Crear plantillas JITP",{"_3632":74169,"_31184":74111,"_21603":124633,"_5":14870,"_28376":124462,"_3083":55320},[],{"_3632":74170,"_31184":74111,"_21603":124635,"_5":14870,"_28376":124462,"_3083":124636},[],"Leer y escribir el Device Shadow",{"_3632":74171,"_31184":74111,"_21603":124638,"_5":14870,"_28376":124462,"_3083":124639},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3632":74172,"_31184":74111,"_21603":124641,"_5":14870,"_28376":124466,"_3083":124642},[],"Parámetro",{"_3632":74173,"_31184":74111,"_21603":124644,"_5":14870,"_28376":124466,"_3083":124645},[],"Tipo",{"_3632":74174,"_31184":74111,"_21603":124647,"_5":14870,"_28376":124466,"_3083":124648},[],"Requerido",{"_3632":74175,"_31184":74111,"_21603":124650,"_5":14870,"_28376":124466,"_3083":124651},[],"Descripción",{"_3632":74176,"_31184":74111,"_21603":124653,"_5":14870,"_28376":124466,"_3083":55341},[],{"_3632":74177,"_31184":74111,"_21603":124655,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74178,"_31184":74111,"_21603":124657,"_5":14870,"_28376":124466,"_3083":124658},[],"Sí",{"_3632":74179,"_31184":74111,"_21603":124660,"_5":14870,"_28376":124466,"_3083":124661},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3632":74180,"_31184":74111,"_21603":124663,"_5":14870,"_28376":124466,"_3083":55352},[],{"_3632":74181,"_31184":74111,"_21603":124665,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74182,"_31184":74111,"_21603":124667,"_5":14870,"_28376":124466,"_3083":124658},[],{"_3632":74183,"_31184":74111,"_21603":124669,"_5":14870,"_28376":124466,"_3083":124670},[],"Región AWS donde opera el conector.",{"_3632":74184,"_31184":74111,"_21603":124672,"_5":14870,"_28376":124466,"_3083":55362},[],{"_3632":74185,"_31184":74111,"_21603":124674,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74186,"_31184":74111,"_21603":124676,"_5":14870,"_28376":124466,"_3083":124658},[],{"_3632":74187,"_31184":74111,"_21603":124678,"_5":14870,"_28376":124466,"_3083":124679},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3632":74188,"_31184":74111,"_21603":124681,"_5":14870,"_28376":124466,"_3083":55372},[],{"_3632":74189,"_31184":74111,"_21603":124683,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74190,"_31184":74111,"_21603":124685,"_5":14870,"_28376":124466,"_3083":124686},[],"Solo con `auth_method=static`",{"_3632":74191,"_31184":74111,"_21603":124688,"_5":14870,"_28376":124466,"_3083":124689},[],"Clave de acceso AWS.",{"_3632":74192,"_31184":74111,"_21603":124691,"_5":14870,"_28376":124466,"_3083":55383},[],{"_3632":74193,"_31184":74111,"_21603":124693,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74194,"_31184":74111,"_21603":124695,"_5":14870,"_28376":124466,"_3083":124686},[],{"_3632":74195,"_31184":74111,"_21603":124697,"_5":14870,"_28376":124466,"_3083":124698},[],"Clave secreta AWS.",{"_3632":74196,"_31184":74111,"_21603":124700,"_5":14870,"_28376":124466,"_3083":55393},[],{"_3632":74197,"_31184":74111,"_21603":124702,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74198,"_31184":74111,"_21603":124704,"_5":14870,"_28376":124466,"_3083":55398},[],{"_3632":74199,"_31184":74111,"_21603":124706,"_5":14870,"_28376":124466,"_3083":124707},[],"Token de sesión (con `auth_method=static`).",{"_3632":74200,"_31184":74111,"_21603":124709,"_5":14870,"_28376":124466,"_3083":55404},[],{"_3632":74201,"_31184":74111,"_21603":124711,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74202,"_31184":74111,"_21603":124713,"_5":14870,"_28376":124466,"_3083":124714},[],"Solo con `auth_method=role`",{"_3632":74203,"_31184":74111,"_21603":124716,"_5":14870,"_28376":124466,"_3083":124717},[],"ARN del rol a asumir.",{"_3632":74204,"_31184":74111,"_21603":124719,"_5":14870,"_28376":124466,"_3083":55415},[],{"_3632":74205,"_31184":74111,"_21603":124721,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74206,"_31184":74111,"_21603":124723,"_5":14870,"_28376":124466,"_3083":55398},[],{"_3632":74207,"_31184":74111,"_21603":124725,"_5":14870,"_28376":124466,"_3083":124726},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3632":74208,"_31184":74111,"_21603":124728,"_5":14870,"_28376":124466,"_3083":55425},[],{"_3632":74209,"_31184":74111,"_21603":124730,"_5":14870,"_28376":124466,"_3083":92970},[],{"_3632":74210,"_31184":74111,"_21603":124732,"_5":14870,"_28376":124466,"_3083":124658},[],{"_3632":74211,"_31184":74111,"_21603":124734,"_5":14870,"_28376":124466,"_3083":124735},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3632":74212,"_31184":74111,"_21603":124737,"_5":14870,"_28376":124466,"_3083":55435},[],{"_3632":74213,"_31184":74111,"_21603":124739,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74214,"_31184":74111,"_21603":124741,"_5":14870,"_28376":124466,"_3083":124658},[],{"_3632":74215,"_31184":74111,"_21603":124743,"_5":14870,"_28376":124466,"_3083":124744},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3632":74216,"_31184":74111,"_21603":124746,"_5":14870,"_28376":124466,"_3083":55445},[],{"_3632":74217,"_31184":74111,"_21603":124748,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74218,"_31184":74111,"_21603":124750,"_5":14870,"_28376":124466,"_3083":124658},[],{"_3632":74219,"_31184":74111,"_21603":124752,"_5":14870,"_28376":124466,"_3083":124753},[],"URL HTTP del Device Manager de Lamassu.",{"_3632":74220,"_31184":74111,"_21603":124755,"_5":14870,"_28376":124466,"_3083":55455},[],{"_3632":74221,"_31184":74111,"_21603":124757,"_5":14870,"_28376":124466,"_3083":25790},[],{"_3632":74222,"_31184":74111,"_21603":124759,"_5":14870,"_28376":124466,"_3083":124658},[],{"_3632":74223,"_31184":74111,"_21603":124761,"_5":14870,"_28376":124466,"_3083":124762},[],"URL HTTP del servicio de CA de Lamassu.",{"_3632":74224,"_31184":74111,"_21603":124764,"_5":14870,"_28376":124470,"_3083":124765},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3632":74225,"_31184":74111,"_21603":124767,"_5":14870,"_28376":124470,"_3083":124768},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3632":74226,"_31184":74111,"_21603":124770,"_5":14870,"_28376":124470,"_3083":124771},[],"Tipo de CloudEvent",{"_3632":74227,"_31184":74111,"_21603":124773,"_5":14870,"_28376":124470,"_3083":124774},[],"Recurso en Lamassu",{"_3632":74228,"_31184":74111,"_21603":124776,"_5":14870,"_28376":124470,"_3083":124777},[],"Recurso AWS",{"_3632":74229,"_31184":74111,"_21603":124779,"_5":14870,"_28376":124470,"_3083":124780},[],"Acciones IAM",{"_3632":74230,"_31184":74111,"_21603":124782,"_5":14870,"_28376":124470,"_3083":124783},[],"Llamadas AWS y efecto",{"_3632":74231,"_31184":74111,"_21603":124785,"_5":14870,"_28376":124470,"_3083":124786},[],"Dónde en esta página",{"_3632":74232,"_31184":74111,"_21603":124788,"_5":14870,"_28376":124470,"_3083":55489},[],{"_3632":74233,"_31184":74111,"_21603":124790,"_5":14870,"_28376":124470,"_3083":55492},[],{"_3632":74234,"_31184":74111,"_21603":124792,"_5":14870,"_28376":124470,"_3083":55495},[],{"_3632":74235,"_31184":74111,"_21603":124794,"_5":14870,"_28376":124470,"_3083":55498},[],{"_3632":74236,"_31184":74111,"_21603":124796,"_5":14870,"_28376":124470,"_3083":124797},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3632":74237,"_31184":74111,"_21603":124799,"_5":14870,"_28376":124470,"_3083":124483},[],{"_3632":74238,"_31184":74111,"_21603":124801,"_5":14870,"_28376":124470,"_3083":55506},[],{"_3632":74239,"_31184":74111,"_21603":124803,"_5":14870,"_28376":124470,"_3083":55509},[],{"_3632":74240,"_31184":74111,"_21603":124805,"_5":14870,"_28376":124470,"_3083":55512},[],{"_3632":74241,"_31184":74111,"_21603":124807,"_5":14870,"_28376":124470,"_3083":55515},[],{"_3632":74242,"_31184":74111,"_21603":124809,"_5":14870,"_28376":124470,"_3083":124810},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3632":74243,"_31184":74111,"_21603":124812,"_5":14870,"_28376":124470,"_3083":124509},[],{"_3632":74244,"_31184":74111,"_21603":124814,"_5":14870,"_28376":124470,"_3083":55523},[],{"_3632":74245,"_31184":74111,"_21603":124816,"_5":14870,"_28376":124470,"_3083":124817},[],"Dispositivo",{"_3632":74246,"_31184":74111,"_21603":124819,"_5":14870,"_28376":124470,"_3083":55529},[],{"_3632":74247,"_31184":74111,"_21603":124821,"_5":14870,"_28376":124470,"_3083":55532},[],{"_3632":74248,"_31184":74111,"_21603":124823,"_5":14870,"_28376":124470,"_3083":124824},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3632":74249,"_31184":74111,"_21603":124826,"_5":14870,"_28376":124470,"_3083":124517},[],{"_3632":74250,"_31184":74111,"_21603":124828,"_5":14870,"_28376":124470,"_3083":55540},[],{"_3632":74251,"_31184":74111,"_21603":124830,"_5":14870,"_28376":124470,"_3083":124831},[],"Certificado",{"_3632":74252,"_31184":74111,"_21603":124833,"_5":14870,"_28376":124470,"_3083":55546},[],{"_3632":74253,"_31184":74111,"_21603":124835,"_5":14870,"_28376":124470,"_3083":124836},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3632":74254,"_31184":74111,"_21603":124838,"_5":14870,"_28376":124470,"_3083":124839},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3632":74255,"_31184":74111,"_21603":124841,"_5":14870,"_28376":124470,"_3083":124529},[],{"_3632":74256,"_31184":74111,"_21603":124843,"_5":14870,"_28376":124470,"_3083":55557},[],{"_3632":74257,"_31184":74111,"_21603":124845,"_5":14870,"_28376":124470,"_3083":124846},[],"Certificado / Dispositivo",{"_3632":74258,"_31184":74111,"_21603":124848,"_5":14870,"_28376":124470,"_3083":55563},[],{"_3632":74259,"_31184":74111,"_21603":124850,"_5":14870,"_28376":124470,"_3083":51360},[],{"_3632":74260,"_31184":74111,"_21603":124852,"_5":14870,"_28376":124470,"_3083":124853},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3632":74261,"_31184":74111,"_21603":124855,"_5":14870,"_28376":124470,"_3083":124537},[],{"_3632":74262,"_31184":74111,"_21603":124857,"_5":14870,"_28376":124474,"_3083":124858},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3632":74263,"_31184":74111,"_21603":124860,"_5":14870,"_28376":124478,"_3083":124861},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3632":74264,"_31184":74111,"_21603":124863,"_5":14870,"_28376":124478,"_3083":124864},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3632":74265,"_31184":74111,"_21603":124866,"_5":14870,"_28376":124482,"_3083":124867},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3632":74266,"_31184":74111,"_21603":124869,"_5":14870,"_28376":124482,"_3083":124870},[],"Transición",{"_3632":74267,"_31184":74111,"_21603":124872,"_5":14870,"_28376":124482,"_3083":124873},[],"Llamadas AWS",{"_3632":74268,"_31184":74111,"_21603":124875,"_5":14870,"_28376":124482,"_3083":124876},[],"`NoRegistrada` → `Solicitada`",{"_3632":74269,"_31184":74111,"_21603":124878,"_5":14870,"_28376":124482,"_3083":124879},[],"ninguna (solo escritura de metadatos)",{"_3632":74270,"_31184":74111,"_21603":124881,"_5":14870,"_28376":124482,"_3083":124882},[],"`Solicitada` → `Registrando`",{"_3632":74271,"_31184":74111,"_21603":124884,"_5":14870,"_28376":124482,"_3083":124885},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3632":74272,"_31184":74111,"_21603":124887,"_5":14870,"_28376":124482,"_3083":124888},[],"`Registrando` → `Completada`",{"_3632":74273,"_31184":74111,"_21603":124890,"_5":14870,"_28376":124482,"_3083":124891},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3632":74274,"_31184":74111,"_21603":124893,"_5":14870,"_28376":124482,"_3083":124894},[],"`Registrando` → `Fallida`",{"_3632":74275,"_31184":74111,"_21603":124896,"_5":14870,"_28376":124482,"_3083":124897},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3632":74276,"_31184":74111,"_21603":124899,"_5":14870,"_28376":124482,"_3083":124900},[],"`Fallida` / `Completada` → `Solicitada`",{"_3632":74277,"_31184":74111,"_21603":124902,"_5":14870,"_28376":124482,"_3083":124903},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3632":74278,"_31184":74111,"_21603":124905,"_5":14870,"_28376":124486,"_3083":124906},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3632":74279,"_31184":74111,"_21603":124908,"_5":14870,"_28376":124486,"_3083":124909},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3632":74280,"_31184":74111,"_21603":124911,"_5":14870,"_28376":124486,"_3083":124912},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3632":74281,"_31184":74111,"_21603":124914,"_5":14870,"_28376":124486,"_3083":124915},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3632":74282,"_31184":74111,"_21603":124917,"_5":14870,"_28376":124486,"_3083":124918},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3632":74283,"_31184":74111,"_21603":124920,"_5":14870,"_28376":124486,"_3083":124921},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3632":74284,"_31184":74111,"_21603":124923,"_5":14870,"_28376":124489,"_3083":124924},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3632":74285,"_31184":74111,"_21603":124926,"_5":14870,"_28376":124492,"_3083":124927},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3632":74286,"_31184":74111,"_21603":124929,"_5":14870,"_28376":124492,"_3083":124930},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3632":74287,"_31184":74111,"_21603":124932,"_5":14870,"_28376":124496,"_3083":124933},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3632":74288,"_31184":74111,"_21603":124935,"_5":14870,"_28376":124500,"_3083":124936},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3632":74289,"_31184":74111,"_21603":124938,"_5":14870,"_28376":124500,"_3083":124939},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3632":74290,"_31184":74111,"_21603":124941,"_5":14870,"_28376":124500,"_3083":124942},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3632":74291,"_31184":74111,"_21603":124944,"_5":14870,"_28376":124500,"_3083":124945},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3632":74292,"_31184":74111,"_21603":124947,"_5":14870,"_28376":124500,"_3083":124948},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3632":74293,"_31184":74111,"_21603":124950,"_5":14870,"_28376":124500,"_3083":124951},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3632":74294,"_31184":74111,"_21603":124953,"_5":14870,"_28376":124504,"_3083":124954},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3632":74295,"_31184":74111,"_21603":124956,"_5":14870,"_28376":124504,"_3083":124957},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3632":74296,"_31184":74111,"_21603":124959,"_5":14870,"_28376":124504,"_3083":124960},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3632":74297,"_31184":74111,"_21603":124962,"_5":14870,"_28376":124504,"_3083":124963},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3632":74298,"_31184":74111,"_21603":124965,"_5":14870,"_28376":124504,"_3083":124966},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3632":74299,"_31184":74111,"_21603":124968,"_5":14870,"_28376":124508,"_3083":124969},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3632":74300,"_31184":74111,"_21603":124971,"_5":14870,"_28376":124508,"_3083":124870},[],{"_3632":74301,"_31184":74111,"_21603":124973,"_5":14870,"_28376":124508,"_3083":124873},[],{"_3632":74302,"_31184":74111,"_21603":124975,"_5":14870,"_28376":124508,"_3083":124976},[],"`SinConfigurar` → `None` / `Auto`",{"_3632":74303,"_31184":74111,"_21603":124978,"_5":14870,"_28376":124508,"_3083":124979},[],"ninguna (solo configuración)",{"_3632":74304,"_31184":74111,"_21603":124981,"_5":14870,"_28376":124508,"_3083":55700},[],{"_3632":74305,"_31184":74111,"_21603":124983,"_5":14870,"_28376":124508,"_3083":124979},[],{"_3632":74306,"_31184":74111,"_21603":124985,"_5":14870,"_28376":124508,"_3083":124986},[],"Cualquiera → `Jitp`",{"_3632":74307,"_31184":74111,"_21603":124988,"_5":14870,"_28376":124508,"_3083":124989},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3632":74308,"_31184":74111,"_21603":124991,"_5":14870,"_28376":124508,"_3083":55711},[],{"_3632":74309,"_31184":74111,"_21603":124993,"_5":14870,"_28376":124508,"_3083":124994},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3632":74310,"_31184":74111,"_21603":124996,"_5":14870,"_28376":124512,"_3083":124997},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3632":74311,"_31184":74111,"_21603":124999,"_5":14870,"_28376":124512,"_3083":125000},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3632":74312,"_31184":74111,"_21603":125002,"_5":14870,"_28376":124512,"_3083":125003},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3632":74313,"_31184":74111,"_21603":125005,"_5":14870,"_28376":124516,"_3083":125006},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3632":74314,"_31184":74111,"_21603":125008,"_5":14870,"_28376":124516,"_3083":124870},[],{"_3632":74315,"_31184":74111,"_21603":125010,"_5":14870,"_28376":124516,"_3083":124873},[],{"_3632":74316,"_31184":74111,"_21603":125012,"_5":14870,"_28376":124516,"_3083":125013},[],"`Ausente` → `Aprovisionado`",{"_3632":74317,"_31184":74111,"_21603":125015,"_5":14870,"_28376":124516,"_3083":125016},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3632":74318,"_31184":74111,"_21603":125018,"_5":14870,"_28376":124516,"_3083":125019},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3632":74319,"_31184":74111,"_21603":125021,"_5":14870,"_28376":124516,"_3083":125022},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3632":74320,"_31184":74111,"_21603":125024,"_5":14870,"_28376":124516,"_3083":125025},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3632":74321,"_31184":74111,"_21603":125027,"_5":14870,"_28376":124520,"_3083":125028},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3632":74322,"_31184":74111,"_21603":125030,"_5":14870,"_28376":124520,"_3083":125031},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3632":74323,"_31184":74111,"_21603":125033,"_5":14870,"_28376":124520,"_3083":125034},[],"Para que el flujo JITP funcione correctamente:",{"_3632":74324,"_31184":74111,"_21603":125036,"_5":14870,"_28376":124520,"_3083":125037},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3632":74325,"_31184":74111,"_21603":125039,"_5":14870,"_28376":124520,"_3083":125040},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3632":74326,"_31184":74111,"_21603":125042,"_5":14870,"_28376":124520,"_3083":125043},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3632":74327,"_31184":74111,"_21603":125045,"_5":14870,"_28376":124520,"_3083":125046},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3632":74328,"_31184":74111,"_21603":125048,"_5":14870,"_28376":124524,"_3083":125049},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3632":74329,"_31184":74111,"_21603":125051,"_5":14870,"_28376":124524,"_3083":125052},[],"Estado en Lamassu",{"_3632":74330,"_31184":74111,"_21603":125054,"_5":14870,"_28376":124524,"_3083":125055},[],"Razón de revocación",{"_3632":74331,"_31184":74111,"_21603":125057,"_5":14870,"_28376":124524,"_3083":125058},[],"Estado en AWS IoT Core",{"_3632":74332,"_31184":74111,"_21603":125060,"_5":14870,"_28376":124524,"_3083":55781},[],{"_3632":74333,"_31184":74111,"_21603":125062,"_5":14870,"_28376":124524,"_3083":125063},[],"Ninguna",{"_3632":74334,"_31184":74111,"_21603":125065,"_5":14870,"_28376":124524,"_3083":55787},[],{"_3632":74335,"_31184":74111,"_21603":125067,"_5":14870,"_28376":124524,"_3083":55790},[],{"_3632":74336,"_31184":74111,"_21603":125069,"_5":14870,"_28376":124524,"_3083":55793},[],{"_3632":74337,"_31184":74111,"_21603":125071,"_5":14870,"_28376":124524,"_3083":55796},[],{"_3632":74338,"_31184":74111,"_21603":125073,"_5":14870,"_28376":124524,"_3083":55790},[],{"_3632":74339,"_31184":74111,"_21603":125075,"_5":14870,"_28376":124524,"_3083":125076},[],"Cualquier otra razón",{"_3632":74340,"_31184":74111,"_21603":125078,"_5":14870,"_28376":124524,"_3083":55804},[],{"_3632":74341,"_31184":74111,"_21603":125080,"_5":14870,"_28376":124524,"_3083":125081},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3632":74342,"_31184":74111,"_21603":125083,"_5":14870,"_28376":124528,"_3083":125084},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3632":74343,"_31184":74111,"_21603":125086,"_5":14870,"_28376":124528,"_3083":124870},[],{"_3632":74344,"_31184":74111,"_21603":125088,"_5":14870,"_28376":124528,"_3083":124873},[],{"_3632":74345,"_31184":74111,"_21603":125090,"_5":14870,"_28376":124528,"_3083":125091},[],"`NoSincronizado` → `Active`",{"_3632":74346,"_31184":74111,"_21603":125093,"_5":14870,"_28376":124528,"_3083":55296},[],{"_3632":74347,"_31184":74111,"_21603":125095,"_5":14870,"_28376":124528,"_3083":55822},[],{"_3632":74348,"_31184":74111,"_21603":125097,"_5":14870,"_28376":124528,"_3083":125098},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3632":74349,"_31184":74111,"_21603":125100,"_5":14870,"_28376":124528,"_3083":55828},[],{"_3632":74350,"_31184":74111,"_21603":125102,"_5":14870,"_28376":124528,"_3083":125098},[],{"_3632":74351,"_31184":74111,"_21603":125104,"_5":14870,"_28376":124528,"_3083":55833},[],{"_3632":74352,"_31184":74111,"_21603":125106,"_5":14870,"_28376":124528,"_3083":55296},[],{"_3632":74353,"_31184":74111,"_21603":125108,"_5":14870,"_28376":124528,"_3083":55838},[],{"_3632":74354,"_31184":74111,"_21603":125110,"_5":14870,"_28376":124528,"_3083":125111},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3632":74355,"_31184":74111,"_21603":125113,"_5":14870,"_28376":124532,"_3083":125114},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3632":74356,"_31184":74111,"_21603":125116,"_5":14870,"_28376":124532,"_3083":125117},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3632":74357,"_31184":74111,"_21603":125119,"_5":14870,"_28376":124532,"_3083":125120},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3632":74358,"_31184":74111,"_21603":125122,"_5":14870,"_28376":124536,"_3083":125123},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3632":74359,"_31184":74111,"_21603":125125,"_5":14870,"_28376":124536,"_3083":125126},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3632":74360,"_31184":74111,"_21603":125128,"_5":14870,"_28376":124540,"_3083":125129},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3632":74361,"_31184":74111,"_21603":125131,"_5":14870,"_28376":124540,"_3083":125132},[],"Existen dos tipos de acciones:",{"_3632":74362,"_31184":74111,"_21603":125134,"_5":14870,"_28376":124540,"_3083":125135},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3632":74363,"_31184":74111,"_21603":125137,"_5":14870,"_28376":124540,"_3083":125138},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3632":74364,"_31184":74111,"_21603":125140,"_5":14870,"_28376":124540,"_3083":125141},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3632":74365,"_31184":74111,"_21603":125143,"_5":14870,"_28376":124544,"_3083":125144},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3632":74366,"_31184":74111,"_21603":125146,"_5":14870,"_28376":124544,"_3083":125147},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3632":74367,"_31184":74111,"_21603":125149,"_5":14870,"_28376":124544,"_3083":125150},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3632":74368,"_31184":74111,"_21603":125152,"_5":14870,"_28376":124548,"_3083":125153},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3632":74369,"_31184":74111,"_21603":125155,"_5":14870,"_28376":124548,"_3083":125156},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3632":74370,"_31184":74111,"_21603":125158,"_5":14870,"_28376":124548,"_3083":125159},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3632":74371,"_31184":74111,"_21603":125161,"_5":14870,"_28376":124548,"_3083":125162},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3632":74372,"_31184":74111,"_21603":125164,"_5":14870,"_28376":124548,"_3083":125165},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3632":74373,"_31184":74111,"_21603":125167,"_5":14870,"_28376":124548,"_3083":125168},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3632":74374,"_31184":74111,"_21603":125170,"_5":14870,"_28376":124548,"_3083":125171},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3632":74375,"_31184":74111,"_21603":125173,"_5":14870,"_28376":124548,"_3083":125174},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3632":74376,"_31184":74111,"_21603":125176,"_5":14870,"_28376":124548,"_3083":125177},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3632":74377,"_31184":74111,"_21603":125179,"_5":14870,"_28376":124548,"_3083":125180},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3632":74378,"_31184":74111,"_21603":125182,"_5":14870,"_28376":124548,"_3083":125183},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3632":74379,"_31184":74111,"_21603":125185,"_5":14870,"_28376":124548,"_3083":125186},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3632":74380,"_31184":74111,"_21603":125188,"_5":14870,"_28376":124548,"_3083":125189},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3632":74381,"_31184":74111,"_21603":125191,"_5":14870,"_28376":124548,"_3083":125192},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3632":74382,"_31184":74111,"_21603":125194,"_5":14870,"_28376":124548,"_3083":125195},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3632":74383,"_31184":74111,"_21603":125197,"_5":14870,"_28376":124548,"_3083":125198},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3632":74384,"_31184":74111,"_21603":125200,"_5":14870,"_28376":124548,"_3083":125201},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3632":74385,"_31184":74111,"_21603":125203,"_5":14870,"_28376":124548,"_3083":125204},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3632":74386,"_31184":74111,"_21603":125206,"_5":14870,"_28376":124548,"_3083":125207},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3632":74387,"_31184":74111,"_21603":125209,"_5":14870,"_28376":124548,"_3083":125210},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3632":74388,"_31184":74111,"_21603":125212,"_5":14870,"_28376":124548,"_3083":125213},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3632":74389,"_31184":74111,"_21603":125215,"_5":14870,"_28376":124548,"_3083":125216},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":74390,"_31184":74111,"_21603":125218,"_5":14870,"_28376":124548,"_3083":125219},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3632":74391,"_31184":74111,"_21603":125221,"_5":14870,"_28376":124548,"_3083":125222},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3632":74392,"_31184":74392,"_5":15230,"_3083":53648,"_31522":125224,"_21603":125225,"_28376":74392},[50964,121884,53648],[],{"_3632":74393,"_31184":74392,"_21603":125227,"_5":14870,"_28376":74392,"_3083":125228},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3632":74394,"_31184":74392,"_5":31519,"_21603":125230,"_28376":125231,"_3083":125232},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3632":74395,"_31184":74392,"_5":31519,"_21603":125234,"_28376":125235,"_3083":123029},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3632":74396,"_31184":74392,"_5":31519,"_21603":125237,"_28376":125238,"_3083":123207},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3632":74397,"_31184":74392,"_5":31519,"_21603":125240,"_28376":125241,"_3083":124447},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3632":74398,"_31184":74392,"_5":31519,"_21603":125243,"_28376":125244,"_3083":125245},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3632":74399,"_31184":74392,"_21603":125247,"_5":14870,"_28376":74392,"_3083":125248},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3632":74400,"_31184":74392,"_21603":125250,"_5":14870,"_28376":125231,"_3083":125251},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3632":74401,"_31184":74392,"_21603":125253,"_5":14870,"_28376":125231,"_3083":125254},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3632":74402,"_31184":74392,"_21603":125256,"_5":14870,"_28376":125235,"_3083":125257},[],"Recurso",{"_3632":74403,"_31184":74392,"_21603":125259,"_5":14870,"_28376":125235,"_3083":125260},[],"Qué representa",{"_3632":74404,"_31184":74392,"_21603":125262,"_5":14870,"_28376":125235,"_3083":125263},[],"**Dispositivo**",{"_3632":74405,"_31184":74392,"_21603":125265,"_5":14870,"_28376":125235,"_3083":125266},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3632":74406,"_31184":74392,"_21603":125268,"_5":14870,"_28376":125235,"_3083":125269},[],"**Identidad**",{"_3632":74407,"_31184":74392,"_21603":125271,"_5":14870,"_28376":125235,"_3083":125272},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3632":74408,"_31184":74392,"_21603":125274,"_5":14870,"_28376":125235,"_3083":56005},[],{"_3632":74409,"_31184":74392,"_21603":125276,"_5":14870,"_28376":125235,"_3083":125277},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3632":74410,"_31184":74392,"_21603":125279,"_5":14870,"_28376":125235,"_3083":125280},[],"**Flota**",{"_3632":74411,"_31184":74392,"_21603":125282,"_5":14870,"_28376":125235,"_3083":125283},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3632":74412,"_31184":74392,"_21603":125285,"_5":14870,"_28376":125235,"_3083":125286},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3632":74413,"_31184":74392,"_21603":125288,"_5":14870,"_28376":125235,"_3083":125289},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3632":74414,"_31184":74392,"_21603":125291,"_5":14870,"_28376":125238,"_3083":125292},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3632":74415,"_31184":74392,"_21603":125294,"_5":14870,"_28376":125238,"_3083":125295},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3632":74416,"_31184":74392,"_21603":125297,"_5":14870,"_28376":125238,"_3083":125298},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3632":74417,"_31184":74392,"_21603":125300,"_5":14870,"_28376":125238,"_3083":125301},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3632":74418,"_31184":74392,"_21603":125303,"_5":14870,"_28376":125238,"_3083":125304},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3632":74419,"_31184":74392,"_21603":125306,"_5":14870,"_28376":125238,"_3083":125307},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3632":74420,"_31184":74392,"_21603":125309,"_5":14870,"_28376":125238,"_3083":125310},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":74421,"_31184":74392,"_21603":125312,"_5":14870,"_28376":125238,"_3083":125313},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":74422,"_31184":74392,"_21603":125315,"_5":14870,"_28376":125241,"_3083":125316},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3632":74423,"_31184":74392,"_21603":125318,"_5":14870,"_28376":125241,"_3083":125319},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3632":74424,"_31184":74392,"_21603":125321,"_5":14870,"_28376":125244,"_3083":125322},[],"Participante",{"_3632":74425,"_31184":74392,"_21603":125324,"_5":14870,"_28376":125244,"_3083":125325},[],"Responsabilidad",{"_3632":74426,"_31184":74392,"_21603":125327,"_5":14870,"_28376":125244,"_3083":125328},[],"Administrador PKI",{"_3632":74427,"_31184":74392,"_21603":125330,"_5":14870,"_28376":125244,"_3083":125331},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3632":74428,"_31184":74392,"_21603":125333,"_5":14870,"_28376":125244,"_3083":125334},[],"Administrador del aprovisionamiento",{"_3632":74429,"_31184":74392,"_21603":125336,"_5":14870,"_28376":125244,"_3083":125337},[],"DMS, admisión, autenticación por operación e inventario.",{"_3632":74430,"_31184":74392,"_21603":125339,"_5":14870,"_28376":125244,"_3083":125340},[],"Integrador del dispositivo",{"_3632":74431,"_31184":74392,"_21603":125342,"_5":14870,"_28376":125244,"_3083":125343},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3632":74432,"_31184":74392,"_21603":125345,"_5":14870,"_28376":125244,"_3083":125346},[],"Integrador del consumidor",{"_3632":74433,"_31184":74392,"_21603":125348,"_5":14870,"_28376":125244,"_3083":125349},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3632":74434,"_31184":74392,"_21603":125351,"_5":14870,"_28376":125244,"_3083":125352},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3632":74435,"_31184":74435,"_5":15230,"_3083":125354,"_31522":125355,"_21603":125357,"_28376":74435},"Enrola y conecta tu primer dispositivo",[50964,121884,53648,125356],"Primeros pasos",[],{"_3632":74436,"_31184":74435,"_21603":125359,"_5":14870,"_28376":74435,"_3083":125360},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3632":74437,"_31184":74435,"_5":31519,"_21603":125362,"_28376":125363,"_3083":120418},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3632":74438,"_31184":74435,"_5":31519,"_21603":125365,"_28376":125366,"_3083":125367},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3632":74439,"_31184":74435,"_5":31519,"_21603":125369,"_28376":125370,"_3083":125371},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3632":74440,"_31184":74435,"_5":31519,"_21603":125373,"_28376":125374,"_3083":125375},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3632":74441,"_31184":74435,"_5":31519,"_21603":125377,"_28376":125378,"_3083":125379},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3632":74442,"_31184":74435,"_5":31519,"_21603":125381,"_28376":125382,"_3083":125383},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3632":74443,"_31184":74435,"_5":31519,"_21603":125385,"_28376":125386,"_3083":125387},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3632":74444,"_31184":74435,"_5":31519,"_21603":125389,"_28376":125390,"_3083":125391},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3632":74445,"_31184":74435,"_21603":125393,"_5":14870,"_28376":74435,"_3083":125394},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3632":74446,"_31184":74435,"_21603":125396,"_5":14870,"_28376":125363,"_3083":125397},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3632":74447,"_31184":74435,"_21603":125399,"_5":14870,"_28376":125363,"_3083":125400},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3632":74448,"_31184":74435,"_21603":125402,"_5":14870,"_28376":125363,"_3083":125403},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3632":74449,"_31184":74435,"_21603":125405,"_5":14870,"_28376":125363,"_3083":125406},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3632":74450,"_31184":74435,"_21603":125408,"_5":14870,"_28376":125363,"_3083":125409},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3632":74451,"_31184":74435,"_21603":125411,"_5":14870,"_28376":125366,"_3083":125412},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3632":74452,"_31184":74435,"_21603":125414,"_5":14870,"_28376":125366,"_3083":125415},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3632":74453,"_31184":74435,"_21603":125417,"_5":14870,"_28376":125370,"_3083":125418},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3632":74454,"_31184":74435,"_21603":125420,"_5":14870,"_28376":125370,"_3083":125421},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3632":74455,"_31184":74435,"_21603":125423,"_5":14870,"_28376":125370,"_3083":125424},[],"Ajuste",{"_3632":74456,"_31184":74435,"_21603":125426,"_5":14870,"_28376":125370,"_3083":125427},[],"Valor de evaluación",{"_3632":74457,"_31184":74435,"_21603":125429,"_5":14870,"_28376":125370,"_3083":56161},[],{"_3632":74458,"_31184":74435,"_21603":125431,"_5":14870,"_28376":125370,"_3083":125432},[],"Raíz emisora de `device-root.pem`.",{"_3632":74459,"_31184":74435,"_21603":125434,"_5":14870,"_28376":125370,"_3083":123341},[],{"_3632":74460,"_31184":74435,"_21603":125436,"_5":14870,"_28376":125370,"_3083":125437},[],"Perfil final de 1 hora que acabas de preparar.",{"_3632":74461,"_31184":74435,"_21603":125439,"_5":14870,"_28376":125370,"_3083":56172},[],{"_3632":74462,"_31184":74435,"_21603":125441,"_5":14870,"_28376":125370,"_3083":56175},[],{"_3632":74463,"_31184":74435,"_21603":125443,"_5":14870,"_28376":125370,"_3083":56178},[],{"_3632":74464,"_31184":74435,"_21603":125445,"_5":14870,"_28376":125370,"_3083":125446},[],"Habilitado.",{"_3632":74465,"_31184":74435,"_21603":125448,"_5":14870,"_28376":125370,"_3083":56184},[],{"_3632":74466,"_31184":74435,"_21603":125450,"_5":14870,"_28376":125370,"_3083":125451},[],"Deshabilitado; el ID debe ser nuevo.",{"_3632":74467,"_31184":74435,"_21603":125453,"_5":14870,"_28376":125370,"_3083":125454},[],"Autenticación inicial",{"_3632":74468,"_31184":74435,"_21603":125456,"_5":14870,"_28376":125370,"_3083":125457},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3632":74469,"_31184":74435,"_21603":125459,"_5":14870,"_28376":125370,"_3083":125460},[],"Autenticación de renovación",{"_3632":74470,"_31184":74435,"_21603":125462,"_5":14870,"_28376":125370,"_3083":125463},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3632":74471,"_31184":74435,"_21603":125465,"_5":14870,"_28376":125370,"_3083":56202},[],{"_3632":74472,"_31184":74435,"_21603":125467,"_5":14870,"_28376":125370,"_3083":125468},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3632":74473,"_31184":74435,"_21603":125470,"_5":14870,"_28376":125370,"_3083":56208},[],{"_3632":74474,"_31184":74435,"_21603":125472,"_5":14870,"_28376":125370,"_3083":125473},[],"1 hora.",{"_3632":74475,"_31184":74435,"_21603":125475,"_5":14870,"_28376":125370,"_3083":56214},[],{"_3632":74476,"_31184":74435,"_21603":125477,"_5":14870,"_28376":125370,"_3083":125478},[],"30 minutos / 10 minutos.",{"_3632":74477,"_31184":74435,"_21603":125480,"_5":14870,"_28376":125370,"_3083":56220},[],{"_3632":74478,"_31184":74435,"_21603":125482,"_5":14870,"_28376":125370,"_3083":125483},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3632":74479,"_31184":74435,"_21603":125485,"_5":14870,"_28376":125370,"_3083":53976},[],{"_3632":74480,"_31184":74435,"_21603":125487,"_5":14870,"_28376":125370,"_3083":125488},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3632":74481,"_31184":74435,"_21603":125490,"_5":14870,"_28376":125370,"_3083":56231},[],{"_3632":74482,"_31184":74435,"_21603":125492,"_5":14870,"_28376":125370,"_3083":125493},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3632":74483,"_31184":74435,"_21603":125495,"_5":14870,"_28376":125370,"_3083":125496},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3632":74484,"_31184":74435,"_21603":125498,"_5":14870,"_28376":125374,"_3083":125499},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3632":74485,"_31184":74435,"_21603":125501,"_5":14870,"_28376":125374,"_3083":125502},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3632":74486,"_31184":74435,"_21603":125504,"_5":14870,"_28376":125378,"_3083":125505},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3632":74487,"_31184":74435,"_21603":125507,"_5":14870,"_28376":125378,"_3083":125508},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3632":74488,"_31184":74435,"_21603":125510,"_5":14870,"_28376":125378,"_3083":125511},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3632":74489,"_31184":74435,"_21603":125513,"_5":14870,"_28376":125382,"_3083":125514},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3632":74490,"_31184":74435,"_21603":125516,"_5":14870,"_28376":125382,"_3083":125517},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3632":74491,"_31184":74435,"_21603":125519,"_5":14870,"_28376":125386,"_3083":125520},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3632":74492,"_31184":74435,"_21603":125522,"_5":14870,"_28376":125386,"_3083":125523},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3632":74493,"_31184":74435,"_21603":125525,"_5":14870,"_28376":125386,"_3083":125526},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3632":74494,"_31184":74435,"_21603":125528,"_5":14870,"_28376":125386,"_3083":125529},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3632":74495,"_31184":74435,"_21603":125531,"_5":14870,"_28376":125386,"_3083":125532},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3632":74496,"_31184":74435,"_21603":125534,"_5":14870,"_28376":125390,"_3083":125535},[],"Comprobación",{"_3632":74497,"_31184":74435,"_21603":125537,"_5":14870,"_28376":125390,"_3083":125538},[],"Resultado esperado",{"_3632":74498,"_31184":74435,"_21603":125540,"_5":14870,"_28376":125390,"_3083":125541},[],"Registro",{"_3632":74499,"_31184":74435,"_21603":125543,"_5":14870,"_28376":125390,"_3083":125544},[],"ID creado automáticamente y DMS correcto.",{"_3632":74500,"_31184":74435,"_21603":125546,"_5":14870,"_28376":125390,"_3083":124831},[],{"_3632":74501,"_31184":74435,"_21603":125548,"_5":14870,"_28376":125390,"_3083":125549},[],"CN, perfil, serie y clave verificados.",{"_3632":74502,"_31184":74435,"_21603":125551,"_5":14870,"_28376":125390,"_3083":125552},[],"Inventario",{"_3632":74503,"_31184":74435,"_21603":125554,"_5":14870,"_28376":125390,"_3083":125555},[],"Serie recibida visible como identidad actual y en el historial.",{"_3632":74504,"_31184":74435,"_21603":125557,"_5":14870,"_28376":125390,"_3083":125558},[],"Consumidor",{"_3632":74505,"_31184":74435,"_21603":125560,"_5":14870,"_28376":125390,"_3083":125561},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3632":74506,"_31184":74435,"_21603":125563,"_5":14870,"_28376":125390,"_3083":125564},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3632":74507,"_31184":74435,"_21603":125566,"_5":14870,"_28376":125390,"_3083":125567},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3632":74508,"_31184":74508,"_5":15230,"_3083":123046,"_31522":125569,"_21603":125570,"_28376":74508},[50964,121884,53648,125356],[],{"_3632":74509,"_31184":74508,"_21603":125572,"_5":14870,"_28376":74508,"_3083":125573},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3632":74510,"_31184":74508,"_5":31519,"_21603":125575,"_28376":125576,"_3083":120418},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3632":74511,"_31184":74508,"_5":31519,"_21603":125578,"_28376":125579,"_3083":125580},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3632":74512,"_31184":74508,"_5":31519,"_21603":125582,"_28376":125583,"_3083":125584},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3632":74513,"_31184":74508,"_5":31519,"_21603":125586,"_28376":125587,"_3083":125588},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3632":74514,"_31184":74508,"_5":31519,"_21603":125590,"_28376":125591,"_3083":125592},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3632":74515,"_31184":74508,"_5":31519,"_21603":125594,"_28376":125595,"_3083":125596},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3632":74516,"_31184":74508,"_5":31519,"_21603":125598,"_28376":125599,"_3083":125538},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3632":74517,"_31184":74508,"_5":31519,"_21603":125601,"_28376":125602,"_3083":125603},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3632":74518,"_31184":74508,"_5":31519,"_21603":125605,"_28376":125606,"_3083":125607},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3632":74519,"_31184":74508,"_21603":125609,"_5":14870,"_28376":74508,"_3083":125610},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3632":74520,"_31184":74508,"_21603":125612,"_5":14870,"_28376":74508,"_3083":125613},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3632":74521,"_31184":74508,"_21603":125615,"_5":14870,"_28376":125576,"_3083":125616},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3632":74522,"_31184":74508,"_21603":125618,"_5":14870,"_28376":125576,"_3083":125619},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3632":74523,"_31184":74508,"_21603":125621,"_5":14870,"_28376":125576,"_3083":125622},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3632":74524,"_31184":74508,"_21603":125624,"_5":14870,"_28376":125576,"_3083":125625},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3632":74525,"_31184":74508,"_21603":125627,"_5":14870,"_28376":125579,"_3083":125628},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3632":74526,"_31184":74508,"_21603":125630,"_5":14870,"_28376":125579,"_3083":125631},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3632":74527,"_31184":74508,"_21603":125633,"_5":14870,"_28376":125579,"_3083":125634},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3632":74528,"_31184":74508,"_21603":125636,"_5":14870,"_28376":125579,"_3083":125637},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3632":74529,"_31184":74508,"_21603":125639,"_5":14870,"_28376":125579,"_3083":125640},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3632":74530,"_31184":74508,"_21603":125642,"_5":14870,"_28376":125579,"_3083":125643},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3632":74531,"_31184":74508,"_21603":125645,"_5":14870,"_28376":125579,"_3083":125646},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3632":74532,"_31184":74508,"_21603":125648,"_5":14870,"_28376":125579,"_3083":125649},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3632":74533,"_31184":74508,"_21603":125651,"_5":14870,"_28376":125583,"_3083":125652},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3632":74534,"_31184":74508,"_21603":125654,"_5":14870,"_28376":125583,"_3083":56396},[],{"_3632":74535,"_31184":74508,"_21603":125656,"_5":14870,"_28376":125583,"_3083":125657},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3632":74536,"_31184":74508,"_21603":125659,"_5":14870,"_28376":125583,"_3083":125660},[],"**Icon** y **Tags**: clasificación opcional.",{"_3632":74537,"_31184":74508,"_21603":125662,"_5":14870,"_28376":125583,"_3083":125663},[],"Confirma el registro.",{"_3632":74538,"_31184":74508,"_21603":125665,"_5":14870,"_28376":125587,"_3083":125666},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3632":74539,"_31184":74508,"_21603":125668,"_5":14870,"_28376":125587,"_3083":125669},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3632":74540,"_31184":74508,"_21603":125671,"_5":14870,"_28376":125591,"_3083":125672},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3632":74541,"_31184":74508,"_21603":125674,"_5":14870,"_28376":125591,"_3083":125675},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3632":74542,"_31184":74508,"_21603":125677,"_5":14870,"_28376":125595,"_3083":125678},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3632":74543,"_31184":74508,"_21603":125680,"_5":14870,"_28376":125595,"_3083":125681},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3632":74544,"_31184":74508,"_21603":125683,"_5":14870,"_28376":125599,"_3083":125535},[],{"_3632":74545,"_31184":74508,"_21603":125685,"_5":14870,"_28376":125599,"_3083":125686},[],"Resultado",{"_3632":74546,"_31184":74508,"_21603":125688,"_5":14870,"_28376":125599,"_3083":124817},[],{"_3632":74547,"_31184":74508,"_21603":125690,"_5":14870,"_28376":125599,"_3083":125691},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3632":74548,"_31184":74508,"_21603":125693,"_5":14870,"_28376":125599,"_3083":125694},[],"Identidad actual",{"_3632":74549,"_31184":74508,"_21603":125696,"_5":14870,"_28376":125599,"_3083":125697},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3632":74550,"_31184":74508,"_21603":125699,"_5":14870,"_28376":125599,"_3083":125700},[],"Historial",{"_3632":74551,"_31184":74508,"_21603":125702,"_5":14870,"_28376":125599,"_3083":125703},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3632":74552,"_31184":74508,"_21603":125705,"_5":14870,"_28376":125599,"_3083":125706},[],"Clave y certificado",{"_3632":74553,"_31184":74508,"_21603":125708,"_5":14870,"_28376":125599,"_3083":125709},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3632":74554,"_31184":74508,"_21603":125711,"_5":14870,"_28376":125602,"_3083":125712},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3632":74555,"_31184":74508,"_21603":125714,"_5":14870,"_28376":125602,"_3083":125715},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3632":74556,"_31184":74508,"_21603":125717,"_5":14870,"_28376":125602,"_3083":125718},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3632":74557,"_31184":74508,"_21603":125720,"_5":14870,"_28376":125602,"_3083":125721},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3632":74558,"_31184":74508,"_21603":125723,"_5":14870,"_28376":125606,"_3083":125724},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3632":74559,"_31184":74508,"_21603":125726,"_5":14870,"_28376":125606,"_3083":125727},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3632":74560,"_31184":74508,"_21603":125729,"_5":14870,"_28376":125606,"_3083":125730},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3632":74561,"_31184":74561,"_5":15230,"_3083":125732,"_31522":125733,"_21603":125734,"_28376":74561},"Plataforma Lamassu IoT",[50964,121884],[],{"_3632":74562,"_31184":74561,"_21603":125736,"_5":14870,"_28376":74561,"_3083":125737},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3632":74563,"_31184":74561,"_5":31519,"_21603":125739,"_28376":125740,"_3083":125232},[],"/docs/es/platform/overview#empieza-aquí",{"_3632":74564,"_31184":74561,"_5":31519,"_21603":125742,"_28376":125743,"_3083":125744},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3632":74565,"_31184":74561,"_5":31519,"_21603":125746,"_28376":125747,"_3083":125748},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3632":74566,"_31184":74561,"_5":31519,"_21603":125750,"_28376":125751,"_3083":125752},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3632":74567,"_31184":74561,"_5":31519,"_21603":125754,"_28376":125755,"_3083":125756},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3632":74568,"_31184":74561,"_5":31519,"_21603":125758,"_28376":125759,"_3083":125760},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3632":74569,"_31184":74561,"_5":31519,"_21603":125762,"_28376":125763,"_3083":125764},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3632":74570,"_31184":74561,"_5":31519,"_21603":125766,"_28376":125767,"_3083":125768},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3632":74571,"_31184":74561,"_5":31519,"_21603":125770,"_28376":125771,"_3083":125772},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3632":74572,"_31184":74561,"_5":31519,"_21603":125774,"_28376":125775,"_3083":125776},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3632":74573,"_31184":74561,"_5":31519,"_21603":125778,"_28376":125779,"_3083":125780},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3632":74574,"_31184":74561,"_21603":125782,"_5":14870,"_28376":74561,"_3083":125783},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3632":74575,"_31184":74561,"_21603":125785,"_5":14870,"_28376":125740,"_3083":125786},[],"Elige el resultado que necesitas obtener:",{"_3632":74576,"_31184":74561,"_21603":125788,"_5":14870,"_28376":125740,"_3083":125789},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":74577,"_31184":74561,"_21603":125791,"_5":14870,"_28376":125740,"_3083":125792},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":74578,"_31184":74561,"_21603":125794,"_5":14870,"_28376":125740,"_3083":125795},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3632":74579,"_31184":74561,"_21603":125797,"_5":14870,"_28376":125743,"_3083":125798},[],"Bloque",{"_3632":74580,"_31184":74561,"_21603":125800,"_5":14870,"_28376":125743,"_3083":125801},[],"Qué gestionas",{"_3632":74581,"_31184":74561,"_21603":125803,"_5":14870,"_28376":125743,"_3083":125804},[],"Punto de entrada",{"_3632":74582,"_31184":74561,"_21603":125806,"_5":14870,"_28376":125743,"_3083":56549},[],{"_3632":74583,"_31184":74561,"_21603":125808,"_5":14870,"_28376":125743,"_3083":125809},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3632":74584,"_31184":74561,"_21603":125811,"_5":14870,"_28376":125743,"_3083":125812},[],"Visión general de PKI",{"_3632":74585,"_31184":74561,"_21603":125814,"_5":14870,"_28376":125743,"_3083":56558},[],{"_3632":74586,"_31184":74561,"_21603":125816,"_5":14870,"_28376":125743,"_3083":125817},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3632":74587,"_31184":74561,"_21603":125819,"_5":14870,"_28376":125743,"_3083":125820},[],"Visión general de IoT Fleets",{"_3632":74588,"_31184":74561,"_21603":125822,"_5":14870,"_28376":125743,"_3083":125823},[],"**Administración**",{"_3632":74589,"_31184":74561,"_21603":125825,"_5":14870,"_28376":125743,"_3083":125826},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3632":74590,"_31184":74561,"_21603":125828,"_5":14870,"_28376":125743,"_3083":121886},[],{"_3632":74591,"_31184":74561,"_21603":125830,"_5":14870,"_28376":125743,"_3083":125831},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3632":74592,"_31184":74561,"_21603":125833,"_5":14870,"_28376":125747,"_3083":125834},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3632":74593,"_31184":74561,"_21603":125836,"_5":14870,"_28376":125747,"_3083":125837},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3632":74594,"_31184":74561,"_21603":125839,"_5":14870,"_28376":125747,"_3083":125840},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3632":74595,"_31184":74561,"_21603":125842,"_5":14870,"_28376":125747,"_3083":125843},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3632":74596,"_31184":74561,"_21603":125845,"_5":14870,"_28376":125747,"_3083":125846},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3632":74597,"_31184":74561,"_21603":125848,"_5":14870,"_28376":125747,"_3083":125849},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3632":74598,"_31184":74561,"_21603":125851,"_5":14870,"_28376":125755,"_3083":125852},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3632":74599,"_31184":74561,"_21603":125854,"_5":14870,"_28376":125759,"_3083":125855},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3632":74600,"_31184":74561,"_21603":125857,"_5":14870,"_28376":125763,"_3083":125858},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3632":74601,"_31184":74561,"_21603":125860,"_5":14870,"_28376":125767,"_3083":125861},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3632":74602,"_31184":74561,"_21603":125863,"_5":14870,"_28376":125771,"_3083":125864},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3632":74603,"_31184":74561,"_21603":125866,"_5":14870,"_28376":125775,"_3083":125867},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3632":74604,"_31184":74561,"_21603":125869,"_5":14870,"_28376":125779,"_3083":125325},[],{"_3632":74605,"_31184":74561,"_21603":125871,"_5":14870,"_28376":125779,"_3083":125872},[],"Qué prepara o comprueba",{"_3632":74606,"_31184":74561,"_21603":125874,"_5":14870,"_28376":125779,"_3083":125328},[],{"_3632":74607,"_31184":74561,"_21603":125876,"_5":14870,"_28376":125779,"_3083":125877},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3632":74608,"_31184":74561,"_21603":125879,"_5":14870,"_28376":125779,"_3083":125880},[],"Administrador de la flota",{"_3632":74609,"_31184":74561,"_21603":125882,"_5":14870,"_28376":125779,"_3083":125883},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3632":74610,"_31184":74561,"_21603":125885,"_5":14870,"_28376":125779,"_3083":125340},[],{"_3632":74611,"_31184":74561,"_21603":125887,"_5":14870,"_28376":125779,"_3083":125888},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3632":74612,"_31184":74561,"_21603":125890,"_5":14870,"_28376":125779,"_3083":125346},[],{"_3632":74613,"_31184":74561,"_21603":125892,"_5":14870,"_28376":125779,"_3083":125893},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3632":74614,"_31184":74561,"_21603":125895,"_5":14870,"_28376":125779,"_3083":125896},[],"Operador de infraestructura",{"_3632":74615,"_31184":74561,"_21603":125898,"_5":14870,"_28376":125779,"_3083":125899},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3632":74616,"_31184":74561,"_21603":125901,"_5":14870,"_28376":125779,"_3083":125902},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3632":74617,"_31184":74617,"_5":15230,"_3083":125904,"_31522":125905,"_21603":125907,"_28376":74617},"Jerarquía y rotación de CAs",[50964,121884,56650,125906],"Claves, autoridades y certificados",[],{"_3632":74618,"_31184":74617,"_21603":125909,"_5":14870,"_28376":74617,"_3083":125910},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3632":74619,"_31184":74617,"_5":31519,"_21603":125912,"_28376":125913,"_3083":125914},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3632":74620,"_31184":74617,"_5":31519,"_21603":125916,"_28376":125917,"_3083":125918},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3632":74621,"_31184":74617,"_5":31519,"_21603":125920,"_28376":125921,"_3083":125922},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3632":74622,"_31184":74617,"_5":31519,"_21603":125924,"_28376":125925,"_3083":125926},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3632":74623,"_31184":74617,"_5":31519,"_21603":125928,"_28376":125929,"_3083":125930},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3632":74624,"_31184":74617,"_5":31519,"_21603":125932,"_28376":125933,"_3083":125934},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3632":74625,"_31184":74617,"_5":31519,"_21603":125936,"_28376":125937,"_3083":125938},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3632":74626,"_31184":74617,"_5":31519,"_21603":125940,"_28376":125941,"_3083":125942},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3632":74627,"_31184":74617,"_5":31519,"_21603":125944,"_28376":125945,"_3083":125946},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3632":74628,"_31184":74617,"_5":31519,"_21603":125948,"_28376":125949,"_3083":125950},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3632":74629,"_31184":74617,"_5":31519,"_21603":125952,"_28376":125953,"_3083":125954},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3632":74630,"_31184":74617,"_5":31519,"_21603":125956,"_28376":125957,"_3083":125958},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3632":74631,"_31184":74617,"_21603":125960,"_5":14870,"_28376":74617,"_3083":125961},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3632":74632,"_31184":74617,"_21603":125963,"_5":14870,"_28376":74617,"_3083":125964},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3632":74633,"_31184":74617,"_21603":125966,"_5":14870,"_28376":125913,"_3083":125967},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3632":74634,"_31184":74617,"_21603":125969,"_5":14870,"_28376":125913,"_3083":125970},[],"entorno, como producción y preproducción;",{"_3632":74635,"_31184":74617,"_21603":125972,"_5":14870,"_28376":125913,"_3083":125973},[],"propietario o equipo operador;",{"_3632":74636,"_31184":74617,"_21603":125975,"_5":14870,"_28376":125913,"_3083":125976},[],"familia de dispositivos o proceso de fabricación;",{"_3632":74637,"_31184":74617,"_21603":125978,"_5":14870,"_28376":125913,"_3083":125979},[],"región o requisito regulatorio;",{"_3632":74638,"_31184":74617,"_21603":125981,"_5":14870,"_28376":125913,"_3083":125982},[],"motor criptográfico o política de clave;",{"_3632":74639,"_31184":74617,"_21603":125984,"_5":14870,"_28376":125913,"_3083":125985},[],"ventana de mantenimiento y ritmo de renovación.",{"_3632":74640,"_31184":74617,"_21603":125987,"_5":14870,"_28376":125913,"_3083":125988},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3632":74641,"_31184":74617,"_21603":125990,"_5":14870,"_28376":125913,"_3083":125991},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3632":74642,"_31184":74617,"_21603":125993,"_5":14870,"_28376":125917,"_3083":125994},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3632":74643,"_31184":74617,"_21603":125996,"_5":14870,"_28376":125917,"_3083":125997},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3632":74644,"_31184":74617,"_21603":125999,"_5":14870,"_28376":125917,"_3083":126000},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3632":74645,"_31184":74617,"_21603":126002,"_5":14870,"_28376":125917,"_3083":126003},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3632":74646,"_31184":74617,"_21603":126005,"_5":14870,"_28376":125921,"_3083":126006},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3632":74647,"_31184":74617,"_21603":126008,"_5":14870,"_28376":125921,"_3083":126009},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3632":74648,"_31184":74617,"_21603":126011,"_5":14870,"_28376":125921,"_3083":126012},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3632":74649,"_31184":74617,"_21603":126014,"_5":14870,"_28376":125921,"_3083":126015},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3632":74650,"_31184":74617,"_21603":126017,"_5":14870,"_28376":125929,"_3083":126018},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3632":74651,"_31184":74617,"_21603":126020,"_5":14870,"_28376":125933,"_3083":126021},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3632":74652,"_31184":74617,"_21603":126023,"_5":14870,"_28376":125937,"_3083":126024},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3632":74653,"_31184":74617,"_21603":126026,"_5":14870,"_28376":125941,"_3083":126027},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3632":74654,"_31184":74617,"_21603":126029,"_5":14870,"_28376":125945,"_3083":126030},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3632":74655,"_31184":74617,"_21603":126032,"_5":14870,"_28376":125949,"_3083":126033},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3632":74656,"_31184":74617,"_21603":126035,"_5":14870,"_28376":125953,"_3083":126036},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3632":74657,"_31184":74617,"_21603":126038,"_5":14870,"_28376":125953,"_3083":126039},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3632":74658,"_31184":74617,"_21603":126041,"_5":14870,"_28376":125953,"_3083":126042},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3632":74659,"_31184":74617,"_21603":126044,"_5":14870,"_28376":125953,"_3083":126045},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3632":74660,"_31184":74617,"_21603":126047,"_5":14870,"_28376":125957,"_3083":126048},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3632":74661,"_31184":74617,"_21603":126050,"_5":14870,"_28376":125957,"_3083":126051},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3632":74662,"_31184":74617,"_21603":126053,"_5":14870,"_28376":125957,"_3083":126054},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3632":74663,"_31184":74617,"_21603":126056,"_5":14870,"_28376":125957,"_3083":126057},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3632":74664,"_31184":74617,"_21603":126059,"_5":14870,"_28376":125957,"_3083":126060},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3632":74665,"_31184":74617,"_21603":126062,"_5":14870,"_28376":125957,"_3083":126063},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3632":74666,"_31184":74617,"_21603":126065,"_5":14870,"_28376":125957,"_3083":126066},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3632":74667,"_31184":74667,"_5":15230,"_3083":126068,"_31522":126069,"_21603":126070,"_28376":74667},"Autoridades de certificación",[50964,121884,56650,125906],[],{"_3632":74668,"_31184":74667,"_21603":126072,"_5":14870,"_28376":74667,"_3083":126073},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3632":74669,"_31184":74667,"_5":31519,"_21603":126075,"_28376":126076,"_3083":126077},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3632":74670,"_31184":74667,"_5":31519,"_21603":126079,"_28376":126080,"_3083":126081},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3632":74671,"_31184":74667,"_5":31519,"_21603":126083,"_28376":126084,"_3083":120418},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3632":74672,"_31184":74667,"_5":31519,"_21603":126086,"_28376":126087,"_3083":126088},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3632":74673,"_31184":74667,"_5":31519,"_21603":126090,"_28376":126091,"_3083":126092},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3632":74674,"_31184":74667,"_5":31519,"_21603":126094,"_28376":126095,"_3083":126096},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3632":74675,"_31184":74667,"_5":31519,"_21603":126098,"_28376":126099,"_3083":126100},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3632":74676,"_31184":74667,"_5":31519,"_21603":126102,"_28376":126103,"_3083":126104},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3632":74677,"_31184":74667,"_5":31519,"_21603":126106,"_28376":126107,"_3083":126108},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3632":74678,"_31184":74667,"_5":31519,"_21603":126110,"_28376":126111,"_3083":126112},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3632":74679,"_31184":74667,"_5":31519,"_21603":126114,"_28376":126115,"_3083":126116},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3632":74680,"_31184":74667,"_5":31519,"_21603":126118,"_28376":126119,"_3083":126120},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3632":74681,"_31184":74667,"_5":31519,"_21603":126122,"_28376":126123,"_3083":126124},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3632":74682,"_31184":74667,"_5":31519,"_21603":126126,"_28376":126127,"_3083":126128},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3632":74683,"_31184":74667,"_5":31519,"_21603":126130,"_28376":126131,"_3083":126132},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3632":74684,"_31184":74667,"_5":31519,"_21603":126134,"_28376":126135,"_3083":126136},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3632":74685,"_31184":74667,"_5":31519,"_21603":126138,"_28376":126139,"_3083":126140},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3632":74686,"_31184":74667,"_5":31519,"_21603":126142,"_28376":126143,"_3083":126144},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3632":74687,"_31184":74667,"_5":31519,"_21603":126146,"_28376":126147,"_3083":126148},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3632":74688,"_31184":74667,"_5":31519,"_21603":126150,"_28376":126151,"_3083":126152},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3632":74689,"_31184":74667,"_5":31519,"_21603":126154,"_28376":126155,"_3083":126156},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3632":74690,"_31184":74667,"_5":31519,"_21603":126158,"_28376":126159,"_3083":126160},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3632":74691,"_31184":74667,"_5":31519,"_21603":126162,"_28376":126163,"_3083":126164},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3632":74692,"_31184":74667,"_5":31519,"_21603":126166,"_28376":126167,"_3083":126168},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3632":74693,"_31184":74667,"_21603":126170,"_5":14870,"_28376":74667,"_3083":126171},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3632":74694,"_31184":74667,"_21603":126173,"_5":14870,"_28376":74667,"_3083":126174},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3632":74695,"_31184":74667,"_21603":126176,"_5":14870,"_28376":74667,"_3083":126177},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3632":74696,"_31184":74667,"_21603":126179,"_5":14870,"_28376":126076,"_3083":126180},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3632":74697,"_31184":74667,"_21603":126182,"_5":14870,"_28376":126076,"_3083":126183},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3632":74698,"_31184":74667,"_21603":126185,"_5":14870,"_28376":126076,"_3083":126186},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3632":74699,"_31184":74667,"_21603":126188,"_5":14870,"_28376":126076,"_3083":126189},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3632":74700,"_31184":74667,"_21603":126191,"_5":14870,"_28376":126076,"_3083":126192},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3632":74701,"_31184":74667,"_21603":126194,"_5":14870,"_28376":126084,"_3083":126195},[],"Decide si la CA será raíz o intermedia.",{"_3632":74702,"_31184":74667,"_21603":126197,"_5":14870,"_28376":126084,"_3083":126198},[],"Elige el motor que custodiará la clave.",{"_3632":74703,"_31184":74667,"_21603":126200,"_5":14870,"_28376":126084,"_3083":126201},[],"Define una validez superior a la de los certificados que emitirá.",{"_3632":74704,"_31184":74667,"_21603":126203,"_5":14870,"_28376":126084,"_3083":126204},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3632":74705,"_31184":74667,"_21603":126206,"_5":14870,"_28376":126087,"_3083":126207},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3632":74706,"_31184":74667,"_21603":126209,"_5":14870,"_28376":126091,"_3083":126210},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3632":74707,"_31184":74667,"_21603":126212,"_5":14870,"_28376":126091,"_3083":126213},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3632":74708,"_31184":74667,"_21603":126215,"_5":14870,"_28376":126095,"_3083":126216},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3632":74709,"_31184":74667,"_21603":126218,"_5":14870,"_28376":126099,"_3083":126219},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3632":74710,"_31184":74667,"_21603":126221,"_5":14870,"_28376":126099,"_3083":126222},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3632":74711,"_31184":74667,"_21603":126224,"_5":14870,"_28376":126099,"_3083":126225},[],"`ST`: estado o provincia.",{"_3632":74712,"_31184":74667,"_21603":126227,"_5":14870,"_28376":126099,"_3083":126228},[],"`L`: localidad.",{"_3632":74713,"_31184":74667,"_21603":126230,"_5":14870,"_28376":126099,"_3083":126231},[],"`O`: organización.",{"_3632":74714,"_31184":74667,"_21603":126233,"_5":14870,"_28376":126099,"_3083":126234},[],"`OU`: unidad organizativa.",{"_3632":74715,"_31184":74667,"_21603":126236,"_5":14870,"_28376":126099,"_3083":126237},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3632":74716,"_31184":74667,"_21603":126239,"_5":14870,"_28376":126103,"_3083":126240},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3632":74717,"_31184":74667,"_21603":126242,"_5":14870,"_28376":126103,"_3083":126243},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3632":74718,"_31184":74667,"_21603":126245,"_5":14870,"_28376":126107,"_3083":126246},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3632":74719,"_31184":74667,"_21603":126248,"_5":14870,"_28376":126107,"_3083":126249},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3632":74720,"_31184":74667,"_21603":126251,"_5":14870,"_28376":126111,"_3083":126252},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3632":74721,"_31184":74667,"_21603":126254,"_5":14870,"_28376":126111,"_3083":126255},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3632":74722,"_31184":74667,"_21603":126257,"_5":14870,"_28376":126115,"_3083":126258},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3632":74723,"_31184":74667,"_21603":126260,"_5":14870,"_28376":126115,"_3083":126261},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3632":74724,"_31184":74667,"_21603":126263,"_5":14870,"_28376":126115,"_3083":126264},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3632":74725,"_31184":74667,"_21603":126266,"_5":14870,"_28376":126115,"_3083":126267},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3632":74726,"_31184":74667,"_21603":126269,"_5":14870,"_28376":126119,"_3083":126270},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3632":74727,"_31184":74667,"_21603":126272,"_5":14870,"_28376":126123,"_3083":126273},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3632":74728,"_31184":74667,"_21603":126275,"_5":14870,"_28376":126123,"_3083":126276},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3632":74729,"_31184":74667,"_21603":126278,"_5":14870,"_28376":126127,"_3083":126279},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3632":74730,"_31184":74667,"_21603":126281,"_5":14870,"_28376":126131,"_3083":126282},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3632":74731,"_31184":74667,"_21603":126284,"_5":14870,"_28376":126131,"_3083":126285},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3632":74732,"_31184":74667,"_21603":126287,"_5":14870,"_28376":126131,"_3083":126288},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3632":74733,"_31184":74667,"_21603":126290,"_5":14870,"_28376":126135,"_3083":126291},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3632":74734,"_31184":74667,"_21603":126293,"_5":14870,"_28376":126135,"_3083":126294},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3632":74735,"_31184":74667,"_21603":126296,"_5":14870,"_28376":126135,"_3083":126297},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3632":74736,"_31184":74667,"_21603":126299,"_5":14870,"_28376":126135,"_3083":126300},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3632":74737,"_31184":74667,"_21603":126302,"_5":14870,"_28376":126139,"_3083":126303},[],"Abre una CA desde el inventario para consultar:",{"_3632":74738,"_31184":74667,"_21603":126305,"_5":14870,"_28376":126139,"_3083":126306},[],"Estado y periodo de validez.",{"_3632":74739,"_31184":74667,"_21603":126308,"_5":14870,"_28376":126139,"_3083":126309},[],"Certificado y cadena en formato PEM.",{"_3632":74740,"_31184":74667,"_21603":126311,"_5":14870,"_28376":126139,"_3083":126312},[],"Número de certificados activos, expirados y revocados.",{"_3632":74741,"_31184":74667,"_21603":126314,"_5":14870,"_28376":126139,"_3083":126315},[],"Certificados emitidos en **Issued Certificates**.",{"_3632":74742,"_31184":74667,"_21603":126317,"_5":14870,"_28376":126139,"_3083":126318},[],"CRL vinculada a la autoridad.",{"_3632":74743,"_31184":74667,"_21603":126320,"_5":14870,"_28376":126139,"_3083":126321},[],"Metadatos y motor criptográfico asociado.",{"_3632":74744,"_31184":74667,"_21603":126323,"_5":14870,"_28376":126139,"_3083":126324},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3632":74745,"_31184":74667,"_21603":126326,"_5":14870,"_28376":126143,"_3083":126327},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3632":74746,"_31184":74667,"_21603":126329,"_5":14870,"_28376":126143,"_3083":126330},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3632":74747,"_31184":74667,"_21603":126332,"_5":14870,"_28376":126143,"_3083":126333},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3632":74748,"_31184":74667,"_21603":126335,"_5":14870,"_28376":126143,"_3083":126336},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3632":74749,"_31184":74667,"_21603":126338,"_5":14870,"_28376":126143,"_3083":126339},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3632":74750,"_31184":74667,"_21603":126341,"_5":14870,"_28376":126143,"_3083":126342},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3632":74751,"_31184":74667,"_21603":126344,"_5":14870,"_28376":126147,"_3083":126345},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3632":74752,"_31184":74667,"_21603":126347,"_5":14870,"_28376":126151,"_3083":126348},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3632":74753,"_31184":74667,"_21603":126350,"_5":14870,"_28376":126155,"_3083":126351},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3632":74754,"_31184":74667,"_21603":126353,"_5":14870,"_28376":126159,"_3083":126354},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3632":74755,"_31184":74667,"_21603":126356,"_5":14870,"_28376":126163,"_3083":126357},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3632":74756,"_31184":74667,"_21603":126359,"_5":14870,"_28376":126167,"_3083":126360},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3632":74757,"_31184":74667,"_21603":126362,"_5":14870,"_28376":126167,"_3083":126363},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3632":74758,"_31184":74667,"_21603":126365,"_5":14870,"_28376":126167,"_3083":126366},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3632":74759,"_31184":74667,"_21603":126368,"_5":14870,"_28376":126167,"_3083":126369},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3632":74760,"_31184":74667,"_21603":126371,"_5":14870,"_28376":126167,"_3083":126372},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3632":74761,"_31184":74761,"_5":15230,"_3083":126374,"_31522":126375,"_21603":126376,"_28376":74761},"Perfiles de certificado",[50964,121884,56650,125906],[],{"_3632":74762,"_31184":74761,"_21603":126378,"_5":14870,"_28376":74761,"_3083":126379},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3632":74763,"_31184":74761,"_5":31519,"_21603":126381,"_28376":126382,"_3083":126383},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3632":74764,"_31184":74761,"_5":31519,"_21603":126385,"_28376":126386,"_3083":126387},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3632":74765,"_31184":74761,"_5":31519,"_21603":126389,"_28376":126390,"_3083":126391},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3632":74766,"_31184":74761,"_5":31519,"_21603":126393,"_28376":126394,"_3083":126395},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3632":74767,"_31184":74761,"_5":31519,"_21603":126397,"_28376":126398,"_3083":126399},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3632":74768,"_31184":74761,"_5":31519,"_21603":126401,"_28376":126402,"_3083":126403},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3632":74769,"_31184":74761,"_5":31519,"_21603":126405,"_28376":126406,"_3083":126407},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3632":74770,"_31184":74761,"_5":31519,"_21603":126409,"_28376":126410,"_3083":126411},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3632":74771,"_31184":74761,"_5":31519,"_21603":126413,"_28376":126414,"_3083":126415},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3632":74772,"_31184":74761,"_5":31519,"_21603":126417,"_28376":126418,"_3083":126419},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3632":74773,"_31184":74761,"_5":31519,"_21603":126421,"_28376":126422,"_3083":126423},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3632":74774,"_31184":74761,"_5":31519,"_21603":126425,"_28376":126426,"_3083":126427},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3632":74775,"_31184":74761,"_5":31519,"_21603":126429,"_28376":126430,"_3083":126431},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3632":74776,"_31184":74761,"_5":31519,"_21603":126433,"_28376":126434,"_3083":126435},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3632":74777,"_31184":74761,"_5":31519,"_21603":126437,"_28376":126438,"_3083":126439},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3632":74778,"_31184":74761,"_5":31519,"_21603":126441,"_28376":126442,"_3083":126443},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3632":74779,"_31184":74761,"_21603":126445,"_5":14870,"_28376":74761,"_3083":126446},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3632":74780,"_31184":74761,"_21603":126448,"_5":14870,"_28376":74761,"_3083":126449},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3632":74781,"_31184":74761,"_21603":126451,"_5":14870,"_28376":126386,"_3083":126452},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3632":74782,"_31184":74761,"_21603":126454,"_5":14870,"_28376":126386,"_3083":126455},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3632":74783,"_31184":74761,"_21603":126457,"_5":14870,"_28376":126390,"_3083":126458},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3632":74784,"_31184":74761,"_21603":126460,"_5":14870,"_28376":126394,"_3083":126461},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3632":74785,"_31184":74761,"_21603":126463,"_5":14870,"_28376":126394,"_3083":126464},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3632":74786,"_31184":74761,"_21603":126466,"_5":14870,"_28376":126394,"_3083":126467},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3632":74787,"_31184":74761,"_21603":126469,"_5":14870,"_28376":126398,"_3083":126470},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3632":74788,"_31184":74761,"_21603":126472,"_5":14870,"_28376":126402,"_3083":126473},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3632":74789,"_31184":74761,"_21603":126475,"_5":14870,"_28376":126402,"_3083":126476},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3632":74790,"_31184":74761,"_21603":126478,"_5":14870,"_28376":126406,"_3083":126479},[],"La aplicación criptográfica puede:",{"_3632":74791,"_31184":74761,"_21603":126481,"_5":14870,"_28376":126406,"_3083":126482},[],"permitir o bloquear claves RSA;",{"_3632":74792,"_31184":74761,"_21603":126484,"_5":14870,"_28376":126406,"_3083":126485},[],"limitar los tamaños RSA admitidos;",{"_3632":74793,"_31184":74761,"_21603":126487,"_5":14870,"_28376":126406,"_3083":126488},[],"permitir o bloquear claves ECDSA;",{"_3632":74794,"_31184":74761,"_21603":126490,"_5":14870,"_28376":126406,"_3083":126491},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3632":74795,"_31184":74761,"_21603":126493,"_5":14870,"_28376":126406,"_3083":126494},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3632":74796,"_31184":74761,"_21603":126496,"_5":14870,"_28376":126410,"_3083":126497},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3632":74797,"_31184":74761,"_21603":126499,"_5":14870,"_28376":126410,"_3083":121644},[],{"_3632":74798,"_31184":74761,"_21603":126501,"_5":14870,"_28376":126410,"_3083":126502},[],"Primera opción",{"_3632":74799,"_31184":74761,"_21603":126504,"_5":14870,"_28376":126410,"_3083":126505},[],"Segunda opción",{"_3632":74800,"_31184":74761,"_21603":126507,"_5":14870,"_28376":126410,"_3083":126508},[],"Si no hay ninguna",{"_3632":74801,"_31184":74761,"_21603":126510,"_5":14870,"_28376":126410,"_3083":126511},[],"Firma directa con una CA",{"_3632":74802,"_31184":74761,"_21603":126513,"_5":14870,"_28376":126410,"_3083":126514},[],"`issuance_profile` incluido en la solicitud",{"_3632":74803,"_31184":74761,"_21603":126516,"_5":14870,"_28376":126410,"_3083":126517},[],"`issuance_profile_id` de la solicitud",{"_3632":74804,"_31184":74761,"_21603":126519,"_5":14870,"_28376":126410,"_3083":126520},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3632":74805,"_31184":74761,"_21603":126522,"_5":14870,"_28376":126410,"_3083":126523},[],"Emisión mediante DMS",{"_3632":74806,"_31184":74761,"_21603":126525,"_5":14870,"_28376":126410,"_3083":57271},[],{"_3632":74807,"_31184":74761,"_21603":126527,"_5":14870,"_28376":126410,"_3083":126528},[],"`settings.issuance_profile` incluido en el DMS",{"_3632":74808,"_31184":74761,"_21603":126530,"_5":14870,"_28376":126410,"_3083":126531},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3632":74809,"_31184":74761,"_21603":126533,"_5":14870,"_28376":126410,"_3083":126534},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3632":74810,"_31184":74761,"_21603":126536,"_5":14870,"_28376":126410,"_3083":126537},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3632":74811,"_31184":74761,"_21603":126539,"_5":14870,"_28376":126418,"_3083":126540},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3632":74812,"_31184":74761,"_21603":126542,"_5":14870,"_28376":126422,"_3083":126543},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3632":74813,"_31184":74761,"_21603":126545,"_5":14870,"_28376":126426,"_3083":126546},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3632":74814,"_31184":74761,"_21603":126548,"_5":14870,"_28376":126430,"_3083":126549},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3632":74815,"_31184":74761,"_21603":126551,"_5":14870,"_28376":126434,"_3083":126552},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3632":74816,"_31184":74761,"_21603":126554,"_5":14870,"_28376":126434,"_3083":126555},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3632":74817,"_31184":74761,"_21603":126557,"_5":14870,"_28376":126438,"_3083":126558},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3632":74818,"_31184":74761,"_21603":126560,"_5":14870,"_28376":126438,"_3083":126561},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3632":74819,"_31184":74761,"_21603":126563,"_5":14870,"_28376":126438,"_3083":126564},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3632":74820,"_31184":74761,"_21603":126566,"_5":14870,"_28376":126438,"_3083":126567},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3632":74821,"_31184":74761,"_21603":126569,"_5":14870,"_28376":126442,"_3083":126570},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3632":74822,"_31184":74761,"_21603":126572,"_5":14870,"_28376":126442,"_3083":126573},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3632":74823,"_31184":74823,"_5":15230,"_3083":126575,"_31522":126576,"_21603":126578,"_28376":74823},"Validación de certificados",[50964,121884,56650,126577],"Validación",[],{"_3632":74824,"_31184":74823,"_21603":126580,"_5":14870,"_28376":74823,"_3083":126581},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3632":74825,"_31184":74823,"_5":31519,"_21603":126583,"_28376":126584,"_3083":126585},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3632":74826,"_31184":74823,"_5":31519,"_21603":126587,"_28376":126588,"_3083":126589},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3632":74827,"_31184":74823,"_5":31519,"_21603":126591,"_28376":126592,"_3083":126593},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3632":74828,"_31184":74823,"_21603":126595,"_5":14870,"_28376":74823,"_3083":126596},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3632":74829,"_31184":74823,"_21603":126598,"_5":14870,"_28376":126584,"_3083":126599},[],"Verifica estos criterios juntos:",{"_3632":74830,"_31184":74823,"_21603":126601,"_5":14870,"_28376":126584,"_3083":125535},[],{"_3632":74831,"_31184":74823,"_21603":126603,"_5":14870,"_28376":126584,"_3083":126604},[],"Resultado necesario",{"_3632":74832,"_31184":74823,"_21603":126606,"_5":14870,"_28376":126584,"_3083":126607},[],"Cadena y firma",{"_3632":74833,"_31184":74823,"_21603":126609,"_5":14870,"_28376":126584,"_3083":126610},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3632":74834,"_31184":74823,"_21603":126612,"_5":14870,"_28376":126584,"_3083":126613},[],"Fechas",{"_3632":74835,"_31184":74823,"_21603":126615,"_5":14870,"_28376":126584,"_3083":126616},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3632":74836,"_31184":74823,"_21603":126618,"_5":14870,"_28376":126584,"_3083":121554},[],{"_3632":74837,"_31184":74823,"_21603":126620,"_5":14870,"_28376":126584,"_3083":126621},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3632":74838,"_31184":74823,"_21603":126623,"_5":14870,"_28376":126584,"_3083":126624},[],"Uso",{"_3632":74839,"_31184":74823,"_21603":126626,"_5":14870,"_28376":126584,"_3083":126627},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3632":74840,"_31184":74823,"_21603":126629,"_5":14870,"_28376":126584,"_3083":126630},[],"Revocación",{"_3632":74841,"_31184":74823,"_21603":126632,"_5":14870,"_28376":126584,"_3083":126633},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3632":74842,"_31184":74823,"_21603":126635,"_5":14870,"_28376":126584,"_3083":126636},[],"Autorización",{"_3632":74843,"_31184":74823,"_21603":126638,"_5":14870,"_28376":126584,"_3083":126639},[],"La aplicación permite la acción a esa identidad.",{"_3632":74844,"_31184":74823,"_21603":126641,"_5":14870,"_28376":126584,"_3083":126642},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3632":74845,"_31184":74823,"_21603":126644,"_5":14870,"_28376":126588,"_3083":126645},[],"Mecanismo",{"_3632":74846,"_31184":74823,"_21603":126647,"_5":14870,"_28376":126588,"_3083":126648},[],"Cuándo utilizarlo",{"_3632":74847,"_31184":74823,"_21603":126650,"_5":14870,"_28376":126588,"_3083":126651},[],"Qué debes mantener",{"_3632":74848,"_31184":74823,"_21603":126653,"_5":14870,"_28376":126588,"_3083":57399},[],{"_3632":74849,"_31184":74823,"_21603":126655,"_5":14870,"_28376":126588,"_3083":126656},[],"Consulta del estado de un certificado concreto.",{"_3632":74850,"_31184":74823,"_21603":126658,"_5":14870,"_28376":126588,"_3083":126659},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3632":74851,"_31184":74823,"_21603":126661,"_5":14870,"_28376":126588,"_3083":57408},[],{"_3632":74852,"_31184":74823,"_21603":126663,"_5":14870,"_28376":126588,"_3083":126664},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3632":74853,"_31184":74823,"_21603":126666,"_5":14870,"_28376":126588,"_3083":126667},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3632":74854,"_31184":74823,"_21603":126669,"_5":14870,"_28376":126588,"_3083":126670},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3632":74855,"_31184":74823,"_21603":126672,"_5":14870,"_28376":126588,"_3083":126673},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3632":74856,"_31184":74823,"_21603":126675,"_5":14870,"_28376":126592,"_3083":126676},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3632":74857,"_31184":74823,"_21603":126678,"_5":14870,"_28376":126592,"_3083":126679},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3632":74858,"_31184":74823,"_21603":126681,"_5":14870,"_28376":126592,"_3083":126682},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3632":74859,"_31184":74823,"_21603":126684,"_5":14870,"_28376":126592,"_3083":126685},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3632":74860,"_31184":74823,"_21603":126687,"_5":14870,"_28376":126592,"_3083":126688},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3632":74861,"_31184":74823,"_21603":126690,"_5":14870,"_28376":126592,"_3083":126691},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3632":74862,"_31184":74823,"_21603":126693,"_5":14870,"_28376":126592,"_3083":126694},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3632":74863,"_31184":74823,"_21603":126696,"_5":14870,"_28376":126592,"_3083":126697},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":74864,"_31184":74823,"_21603":126699,"_5":14870,"_28376":126592,"_3083":126700},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3632":74865,"_31184":74865,"_5":15230,"_3083":126702,"_31522":126703,"_21603":126704,"_28376":74865},"Certificados",[50964,121884,56650,125906],[],{"_3632":74866,"_31184":74865,"_21603":126706,"_5":14870,"_28376":74865,"_3083":126707},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3632":74867,"_31184":74865,"_5":31519,"_21603":126709,"_28376":126710,"_3083":126711},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3632":74868,"_31184":74865,"_5":31519,"_21603":126713,"_28376":126714,"_3083":126715},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3632":74869,"_31184":74865,"_5":31519,"_21603":126717,"_28376":126718,"_3083":126719},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3632":74870,"_31184":74865,"_5":31519,"_21603":126721,"_28376":126722,"_3083":126723},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3632":74871,"_31184":74865,"_5":31519,"_21603":126725,"_28376":126726,"_3083":126727},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3632":74872,"_31184":74865,"_5":31519,"_21603":126729,"_28376":126730,"_3083":126731},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3632":74873,"_31184":74865,"_5":31519,"_21603":126733,"_28376":126734,"_3083":126735},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3632":74874,"_31184":74865,"_5":31519,"_21603":126737,"_28376":126738,"_3083":126739},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3632":74875,"_31184":74865,"_5":31519,"_21603":126741,"_28376":126742,"_3083":126743},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3632":74876,"_31184":74865,"_21603":126745,"_5":14870,"_28376":74865,"_3083":126746},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3632":74877,"_31184":74865,"_21603":126748,"_5":14870,"_28376":126710,"_3083":126749},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3632":74878,"_31184":74865,"_21603":126751,"_5":14870,"_28376":126710,"_3083":126752},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3632":74879,"_31184":74865,"_21603":126754,"_5":14870,"_28376":126710,"_3083":126755},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3632":74880,"_31184":74865,"_21603":126757,"_5":14870,"_28376":126710,"_3083":126758},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3632":74881,"_31184":74865,"_21603":126760,"_5":14870,"_28376":126710,"_3083":126761},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3632":74882,"_31184":74865,"_21603":126763,"_5":14870,"_28376":126710,"_3083":126764},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3632":74883,"_31184":74865,"_21603":126766,"_5":14870,"_28376":126710,"_3083":126767},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3632":74884,"_31184":74865,"_21603":126769,"_5":14870,"_28376":126714,"_3083":126770},[],"Descarga el PEM e inspecciónalo:",{"_3632":74885,"_31184":74865,"_21603":126772,"_5":14870,"_28376":126714,"_3083":126773},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3632":74886,"_31184":74865,"_21603":126775,"_5":14870,"_28376":126718,"_3083":126776},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3632":74887,"_31184":74865,"_21603":126778,"_5":14870,"_28376":126718,"_3083":126779},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3632":74888,"_31184":74865,"_21603":126781,"_5":14870,"_28376":126718,"_3083":126782},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3632":74889,"_31184":74865,"_21603":126784,"_5":14870,"_28376":126718,"_3083":126785},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3632":74890,"_31184":74865,"_21603":126787,"_5":14870,"_28376":126718,"_3083":126788},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3632":74891,"_31184":74865,"_21603":126790,"_5":14870,"_28376":126718,"_3083":126791},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3632":74892,"_31184":74865,"_21603":126793,"_5":14870,"_28376":126718,"_3083":126794},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3632":74893,"_31184":74865,"_21603":126796,"_5":14870,"_28376":126722,"_3083":126797},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3632":74894,"_31184":74865,"_21603":126799,"_5":14870,"_28376":126726,"_3083":126800},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3632":74895,"_31184":74865,"_21603":126802,"_5":14870,"_28376":126730,"_3083":126803},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3632":74896,"_31184":74865,"_21603":126805,"_5":14870,"_28376":126734,"_3083":126806},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3632":74897,"_31184":74865,"_21603":126808,"_5":14870,"_28376":126734,"_3083":126809},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3632":74898,"_31184":74865,"_21603":126811,"_5":14870,"_28376":126734,"_3083":126812},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3632":74899,"_31184":74865,"_21603":126814,"_5":14870,"_28376":126738,"_3083":126815},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3632":74900,"_31184":74865,"_21603":126817,"_5":14870,"_28376":126738,"_3083":126818},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3632":74901,"_31184":74865,"_21603":126820,"_5":14870,"_28376":126738,"_3083":126821},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3632":74902,"_31184":74865,"_21603":126823,"_5":14870,"_28376":126742,"_3083":126824},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":74903,"_31184":74865,"_21603":126826,"_5":14870,"_28376":126742,"_3083":126827},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3632":74904,"_31184":74904,"_5":15230,"_3083":126829,"_31522":126830,"_21603":126832,"_28376":74904},"Ciclo de vida de un certificado",[50964,121884,56650,126831],"Conceptos",[],{"_3632":74905,"_31184":74904,"_21603":126834,"_5":14870,"_28376":74904,"_3083":126835},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3632":74906,"_31184":74904,"_5":31519,"_21603":126837,"_28376":126838,"_3083":126839},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3632":74907,"_31184":74904,"_5":31519,"_21603":126841,"_28376":126842,"_3083":126843},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3632":74908,"_31184":74904,"_5":31519,"_21603":126845,"_28376":126846,"_3083":126847},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3632":74909,"_31184":74904,"_5":31519,"_21603":126849,"_28376":126850,"_3083":126851},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3632":74910,"_31184":74904,"_5":31519,"_21603":126853,"_28376":126854,"_3083":126855},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3632":74911,"_31184":74904,"_5":31519,"_21603":126857,"_28376":126858,"_3083":126859},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3632":74912,"_31184":74904,"_5":31519,"_21603":126861,"_28376":126862,"_3083":124529},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3632":74913,"_31184":74904,"_5":31519,"_21603":126864,"_28376":126865,"_3083":126866},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3632":74914,"_31184":74904,"_5":31519,"_21603":126868,"_28376":126869,"_3083":126870},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3632":74915,"_31184":74904,"_5":31519,"_21603":126872,"_28376":126873,"_3083":126874},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3632":74916,"_31184":74904,"_21603":126876,"_5":14870,"_28376":74904,"_3083":126877},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3632":74917,"_31184":74904,"_21603":126879,"_5":14870,"_28376":126842,"_3083":126880},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3632":74918,"_31184":74904,"_21603":126882,"_5":14870,"_28376":126846,"_3083":126883},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3632":74919,"_31184":74904,"_21603":126885,"_5":14870,"_28376":126850,"_3083":126886},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3632":74920,"_31184":74904,"_21603":126888,"_5":14870,"_28376":126854,"_3083":126889},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3632":74921,"_31184":74904,"_21603":126891,"_5":14870,"_28376":126858,"_3083":126892},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3632":74922,"_31184":74904,"_21603":126894,"_5":14870,"_28376":126862,"_3083":126895},[],"Lamassu persiste cuatro estados X.509:",{"_3632":74923,"_31184":74904,"_21603":126897,"_5":14870,"_28376":126862,"_3083":126898},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3632":74924,"_31184":74904,"_21603":126900,"_5":14870,"_28376":126862,"_3083":126901},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3632":74925,"_31184":74904,"_21603":126903,"_5":14870,"_28376":126862,"_3083":126904},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3632":74926,"_31184":74904,"_21603":126906,"_5":14870,"_28376":126862,"_3083":126907},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3632":74927,"_31184":74904,"_21603":126909,"_5":14870,"_28376":126862,"_3083":126910},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3632":74928,"_31184":74904,"_21603":126912,"_5":14870,"_28376":126865,"_3083":126913},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3632":74929,"_31184":74904,"_21603":126915,"_5":14870,"_28376":126865,"_3083":126916},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3632":74930,"_31184":74904,"_21603":126918,"_5":14870,"_28376":126865,"_3083":126919},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3632":74931,"_31184":74904,"_21603":126921,"_5":14870,"_28376":126869,"_3083":126922},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3632":74932,"_31184":74904,"_21603":126924,"_5":14870,"_28376":126869,"_3083":126925},[],"Antes de confirmar:",{"_3632":74933,"_31184":74904,"_21603":126927,"_5":14870,"_28376":126869,"_3083":126928},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3632":74934,"_31184":74904,"_21603":126930,"_5":14870,"_28376":126869,"_3083":126931},[],"Distribuye la nueva cadena de confianza.",{"_3632":74935,"_31184":74904,"_21603":126933,"_5":14870,"_28376":126869,"_3083":126934},[],"Reemite las identidades necesarias.",{"_3632":74936,"_31184":74904,"_21603":126936,"_5":14870,"_28376":126869,"_3083":126937},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3632":74937,"_31184":74904,"_21603":126939,"_5":14870,"_28376":126869,"_3083":126940},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3632":74938,"_31184":74904,"_21603":126942,"_5":14870,"_28376":126869,"_3083":126943},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3632":74939,"_31184":74904,"_21603":126945,"_5":14870,"_28376":126873,"_3083":126946},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3632":74940,"_31184":74904,"_21603":126948,"_5":14870,"_28376":126873,"_3083":126949},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3632":74941,"_31184":74904,"_21603":126951,"_5":14870,"_28376":126873,"_3083":126952},[],"Cambios de estado y razones de revocación.",{"_3632":74942,"_31184":74904,"_21603":126954,"_5":14870,"_28376":126873,"_3083":126955},[],"Publicación y vigencia de OCSP y CRLs.",{"_3632":74943,"_31184":74904,"_21603":126957,"_5":14870,"_28376":126873,"_3083":126958},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3632":74944,"_31184":74904,"_21603":126960,"_5":14870,"_28376":126873,"_3083":126961},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3632":74945,"_31184":74945,"_5":15230,"_3083":126963,"_31522":126964,"_21603":126965,"_28376":74945},"Modelo de confianza",[50964,121884,56650,126831],[],{"_3632":74946,"_31184":74945,"_21603":126967,"_5":14870,"_28376":74945,"_3083":126968},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3632":74947,"_31184":74945,"_5":31519,"_21603":126970,"_28376":126971,"_3083":126972},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3632":74948,"_31184":74945,"_5":31519,"_21603":126974,"_28376":126975,"_3083":126976},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3632":74949,"_31184":74945,"_5":31519,"_21603":126978,"_28376":126979,"_3083":126980},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3632":74950,"_31184":74945,"_5":31519,"_21603":126982,"_28376":126983,"_3083":126984},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3632":74951,"_31184":74945,"_5":31519,"_21603":126986,"_28376":126987,"_3083":126988},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3632":74952,"_31184":74945,"_5":31519,"_21603":126990,"_28376":126991,"_3083":126992},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3632":74953,"_31184":74945,"_5":31519,"_21603":126994,"_28376":126995,"_3083":126996},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3632":74954,"_31184":74945,"_5":31519,"_21603":126998,"_28376":126999,"_3083":127000},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3632":74955,"_31184":74945,"_5":31519,"_21603":127002,"_28376":127003,"_3083":127004},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3632":74956,"_31184":74945,"_5":31519,"_21603":127006,"_28376":127007,"_3083":127008},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3632":74957,"_31184":74945,"_21603":127010,"_5":14870,"_28376":74945,"_3083":127011},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3632":74958,"_31184":74945,"_21603":127013,"_5":14870,"_28376":126975,"_3083":127014},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3632":74959,"_31184":74945,"_21603":127016,"_5":14870,"_28376":126979,"_3083":127017},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3632":74960,"_31184":74945,"_21603":127019,"_5":14870,"_28376":126983,"_3083":127020},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3632":74961,"_31184":74945,"_21603":127022,"_5":14870,"_28376":126987,"_3083":127023},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3632":74962,"_31184":74945,"_21603":127025,"_5":14870,"_28376":126991,"_3083":127026},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3632":74963,"_31184":74945,"_21603":127028,"_5":14870,"_28376":126991,"_3083":127029},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3632":74964,"_31184":74945,"_21603":127031,"_5":14870,"_28376":126991,"_3083":127032},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3632":74965,"_31184":74945,"_21603":127034,"_5":14870,"_28376":126991,"_3083":127035},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3632":74966,"_31184":74945,"_21603":127037,"_5":14870,"_28376":126991,"_3083":127038},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3632":74967,"_31184":74945,"_21603":127040,"_5":14870,"_28376":126991,"_3083":127041},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3632":74968,"_31184":74945,"_21603":127043,"_5":14870,"_28376":126995,"_3083":127044},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3632":74969,"_31184":74945,"_21603":127046,"_5":14870,"_28376":126995,"_3083":127047},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3632":74970,"_31184":74945,"_21603":127049,"_5":14870,"_28376":126995,"_3083":127050},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3632":74971,"_31184":74945,"_21603":127052,"_5":14870,"_28376":126995,"_3083":127053},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3632":74972,"_31184":74945,"_21603":127055,"_5":14870,"_28376":126995,"_3083":127056},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3632":74973,"_31184":74945,"_21603":127058,"_5":14870,"_28376":126999,"_3083":127059},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3632":74974,"_31184":74945,"_21603":127061,"_5":14870,"_28376":126999,"_3083":127062},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3632":74975,"_31184":74945,"_21603":127064,"_5":14870,"_28376":126999,"_3083":127065},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3632":74976,"_31184":74945,"_21603":127067,"_5":14870,"_28376":126999,"_3083":127068},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3632":74977,"_31184":74945,"_21603":127070,"_5":14870,"_28376":126999,"_3083":127071},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3632":74978,"_31184":74945,"_21603":127073,"_5":14870,"_28376":126999,"_3083":127074},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3632":74979,"_31184":74945,"_21603":127076,"_5":14870,"_28376":126999,"_3083":127077},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3632":74980,"_31184":74945,"_21603":127079,"_5":14870,"_28376":127003,"_3083":127080},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3632":74981,"_31184":74945,"_21603":127082,"_5":14870,"_28376":127007,"_3083":127083},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3632":74982,"_31184":74945,"_21603":127085,"_5":14870,"_28376":127007,"_3083":127086},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3632":74983,"_31184":74945,"_21603":127088,"_5":14870,"_28376":127007,"_3083":127089},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3632":74984,"_31184":74945,"_21603":127091,"_5":14870,"_28376":127007,"_3083":127092},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3632":74985,"_31184":74945,"_21603":127094,"_5":14870,"_28376":127007,"_3083":127095},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3632":74986,"_31184":74945,"_21603":127097,"_5":14870,"_28376":127007,"_3083":127098},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3632":74987,"_31184":74945,"_21603":127100,"_5":14870,"_28376":127007,"_3083":127101},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3632":74988,"_31184":74988,"_5":15230,"_3083":127103,"_31522":127104,"_21603":127105,"_28376":74988},"Listas de revocación (CRL)",[50964,121884,56650,126577],[],{"_3632":74989,"_31184":74988,"_21603":127107,"_5":14870,"_28376":74988,"_3083":127108},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3632":74990,"_31184":74988,"_5":31519,"_21603":127110,"_28376":127111,"_3083":127112},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3632":74991,"_31184":74988,"_5":31519,"_21603":127114,"_28376":127115,"_3083":127116},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3632":74992,"_31184":74988,"_5":31519,"_21603":127118,"_28376":127119,"_3083":127120},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3632":74993,"_31184":74988,"_5":31519,"_21603":127122,"_28376":127123,"_3083":127124},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3632":74994,"_31184":74988,"_5":31519,"_21603":127126,"_28376":127127,"_3083":127128},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3632":74995,"_31184":74988,"_5":31519,"_21603":127130,"_28376":127131,"_3083":127132},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3632":74996,"_31184":74988,"_5":31519,"_21603":127134,"_28376":127135,"_3083":127136},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3632":74997,"_31184":74988,"_5":31519,"_21603":127138,"_28376":127139,"_3083":127140},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3632":74998,"_31184":74988,"_21603":127142,"_5":14870,"_28376":74988,"_3083":127143},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3632":74999,"_31184":74988,"_21603":127145,"_5":14870,"_28376":127111,"_3083":127146},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3632":75000,"_31184":74988,"_21603":127148,"_5":14870,"_28376":127111,"_3083":127149},[],"Campo",{"_3632":75001,"_31184":74988,"_21603":127151,"_5":14870,"_28376":127111,"_3083":123570},[],{"_3632":75002,"_31184":74988,"_21603":127153,"_5":14870,"_28376":127111,"_3083":52596},[],{"_3632":75003,"_31184":74988,"_21603":127155,"_5":14870,"_28376":127111,"_3083":127156},[],"ID de la CA a la que pertenecen los ajustes.",{"_3632":75004,"_31184":74988,"_21603":127158,"_5":14870,"_28376":127111,"_3083":57907},[],{"_3632":75005,"_31184":74988,"_21603":127160,"_5":14870,"_28376":127111,"_3083":127161},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3632":75006,"_31184":74988,"_21603":127163,"_5":14870,"_28376":127111,"_3083":57913},[],{"_3632":75007,"_31184":74988,"_21603":127165,"_5":14870,"_28376":127111,"_3083":127166},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3632":75008,"_31184":74988,"_21603":127168,"_5":14870,"_28376":127111,"_3083":57919},[],{"_3632":75009,"_31184":74988,"_21603":127170,"_5":14870,"_28376":127111,"_3083":127171},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3632":75010,"_31184":74988,"_21603":127173,"_5":14870,"_28376":127111,"_3083":127174},[],"Campo de `crl_options`",{"_3632":75011,"_31184":74988,"_21603":127176,"_5":14870,"_28376":127111,"_3083":123570},[],{"_3632":75012,"_31184":74988,"_21603":127178,"_5":14870,"_28376":127111,"_3083":127179},[],"Valor inicial",{"_3632":75013,"_31184":74988,"_21603":127181,"_5":14870,"_28376":127111,"_3083":57933},[],{"_3632":75014,"_31184":74988,"_21603":127183,"_5":14870,"_28376":127111,"_3083":127184},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3632":75015,"_31184":74988,"_21603":127186,"_5":14870,"_28376":127111,"_3083":127187},[],"7 días.",{"_3632":75016,"_31184":74988,"_21603":127189,"_5":14870,"_28376":127111,"_3083":57942},[],{"_3632":75017,"_31184":74988,"_21603":127191,"_5":14870,"_28376":127111,"_3083":127192},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3632":75018,"_31184":74988,"_21603":127194,"_5":14870,"_28376":127111,"_3083":127195},[],"6 días y 23 horas.",{"_3632":75019,"_31184":74988,"_21603":127197,"_5":14870,"_28376":127111,"_3083":57951},[],{"_3632":75020,"_31184":74988,"_21603":127199,"_5":14870,"_28376":127111,"_3083":127200},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3632":75021,"_31184":74988,"_21603":127202,"_5":14870,"_28376":127111,"_3083":57957},[],{"_3632":75022,"_31184":74988,"_21603":127204,"_5":14870,"_28376":127111,"_3083":57960},[],{"_3632":75023,"_31184":74988,"_21603":127206,"_5":14870,"_28376":127111,"_3083":127207},[],"Número de serie del certificado existente que firma la CRL.",{"_3632":75024,"_31184":74988,"_21603":127209,"_5":14870,"_28376":127111,"_3083":127210},[],"Número de serie del certificado actual de la CA.",{"_3632":75025,"_31184":74988,"_21603":127212,"_5":14870,"_28376":127111,"_3083":127213},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3632":75026,"_31184":74988,"_21603":127215,"_5":14870,"_28376":127111,"_3083":127216},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3632":75027,"_31184":74988,"_21603":127218,"_5":14870,"_28376":127111,"_3083":127219},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3632":75028,"_31184":74988,"_21603":127221,"_5":14870,"_28376":127111,"_3083":127222},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3632":75029,"_31184":74988,"_21603":127224,"_5":14870,"_28376":127111,"_3083":127225},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3632":75030,"_31184":74988,"_21603":127227,"_5":14870,"_28376":127111,"_3083":127228},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3632":75031,"_31184":74988,"_21603":127230,"_5":14870,"_28376":127111,"_3083":127231},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3632":75032,"_31184":74988,"_21603":127233,"_5":14870,"_28376":127111,"_3083":127234},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3632":75033,"_31184":74988,"_21603":127236,"_5":14870,"_28376":127111,"_3083":127237},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3632":75034,"_31184":74988,"_21603":127239,"_5":14870,"_28376":127111,"_3083":127240},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3632":75035,"_31184":74988,"_21603":127242,"_5":14870,"_28376":127111,"_3083":127243},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3632":75036,"_31184":74988,"_21603":127245,"_5":14870,"_28376":127115,"_3083":127246},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3632":75037,"_31184":74988,"_21603":127248,"_5":14870,"_28376":127115,"_3083":127249},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3632":75038,"_31184":74988,"_21603":127251,"_5":14870,"_28376":127115,"_3083":127252},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3632":75039,"_31184":74988,"_21603":127254,"_5":14870,"_28376":127115,"_3083":127255},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3632":75040,"_31184":74988,"_21603":127257,"_5":14870,"_28376":127119,"_3083":127258},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3632":75041,"_31184":74988,"_21603":127260,"_5":14870,"_28376":127119,"_3083":127261},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3632":75042,"_31184":74988,"_21603":127263,"_5":14870,"_28376":127119,"_3083":127264},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3632":75043,"_31184":74988,"_21603":127266,"_5":14870,"_28376":127119,"_3083":127267},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3632":75044,"_31184":74988,"_21603":127269,"_5":14870,"_28376":127119,"_3083":127270},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3632":75045,"_31184":74988,"_21603":127272,"_5":14870,"_28376":127119,"_3083":127273},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3632":75046,"_31184":74988,"_21603":127275,"_5":14870,"_28376":127119,"_3083":127276},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3632":75047,"_31184":74988,"_21603":127278,"_5":14870,"_28376":127119,"_3083":127279},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3632":75048,"_31184":74988,"_21603":127281,"_5":14870,"_28376":127119,"_3083":127282},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3632":75049,"_31184":74988,"_21603":127284,"_5":14870,"_28376":127123,"_3083":127285},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3632":75050,"_31184":74988,"_21603":127287,"_5":14870,"_28376":127123,"_3083":127288},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3632":75051,"_31184":74988,"_21603":127290,"_5":14870,"_28376":127127,"_3083":127291},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3632":75052,"_31184":74988,"_21603":127293,"_5":14870,"_28376":127127,"_3083":127294},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3632":75053,"_31184":74988,"_21603":127296,"_5":14870,"_28376":127127,"_3083":127297},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3632":75054,"_31184":74988,"_21603":127299,"_5":14870,"_28376":127127,"_3083":127300},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3632":75055,"_31184":74988,"_21603":127302,"_5":14870,"_28376":127127,"_3083":127303},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3632":75056,"_31184":74988,"_21603":127305,"_5":14870,"_28376":127131,"_3083":127306},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3632":75057,"_31184":74988,"_21603":127308,"_5":14870,"_28376":127131,"_3083":123759},[],{"_3632":75058,"_31184":74988,"_21603":127310,"_5":14870,"_28376":127131,"_3083":127311},[],"Path relativo",{"_3632":75059,"_31184":74988,"_21603":127313,"_5":14870,"_28376":127131,"_3083":121644},[],{"_3632":75060,"_31184":74988,"_21603":127315,"_5":14870,"_28376":127131,"_3083":58072},[],{"_3632":75061,"_31184":74988,"_21603":127317,"_5":14870,"_28376":127131,"_3083":58075},[],{"_3632":75062,"_31184":74988,"_21603":127319,"_5":14870,"_28376":127131,"_3083":127320},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3632":75063,"_31184":74988,"_21603":127322,"_5":14870,"_28376":127131,"_3083":58072},[],{"_3632":75064,"_31184":74988,"_21603":127324,"_5":14870,"_28376":127131,"_3083":58083},[],{"_3632":75065,"_31184":74988,"_21603":127326,"_5":14870,"_28376":127131,"_3083":127327},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3632":75066,"_31184":74988,"_21603":127329,"_5":14870,"_28376":127131,"_3083":58089},[],{"_3632":75067,"_31184":74988,"_21603":127331,"_5":14870,"_28376":127131,"_3083":58083},[],{"_3632":75068,"_31184":74988,"_21603":127333,"_5":14870,"_28376":127131,"_3083":127334},[],"Sustituir la configuración de CRL de una CA.",{"_3632":75069,"_31184":74988,"_21603":127336,"_5":14870,"_28376":127131,"_3083":58097},[],{"_3632":75070,"_31184":74988,"_21603":127338,"_5":14870,"_28376":127131,"_3083":58083},[],{"_3632":75071,"_31184":74988,"_21603":127340,"_5":14870,"_28376":127131,"_3083":127341},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3632":75072,"_31184":74988,"_21603":127343,"_5":14870,"_28376":127131,"_3083":127344},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3632":75073,"_31184":74988,"_21603":127346,"_5":14870,"_28376":127131,"_3083":127347},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3632":75074,"_31184":74988,"_21603":127349,"_5":14870,"_28376":127131,"_3083":127350},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3632":75075,"_31184":74988,"_21603":127352,"_5":14870,"_28376":127135,"_3083":127353},[],"Síntoma",{"_3632":75076,"_31184":74988,"_21603":127355,"_5":14870,"_28376":127135,"_3083":127356},[],"Causa",{"_3632":75077,"_31184":74988,"_21603":127358,"_5":14870,"_28376":127135,"_3083":127359},[],"Acción",{"_3632":75078,"_31184":74988,"_21603":127361,"_5":14870,"_28376":127135,"_3083":127362},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3632":75079,"_31184":74988,"_21603":127364,"_5":14870,"_28376":127135,"_3083":127365},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3632":75080,"_31184":74988,"_21603":127367,"_5":14870,"_28376":127135,"_3083":127368},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3632":75081,"_31184":74988,"_21603":127370,"_5":14870,"_28376":127135,"_3083":127371},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3632":75082,"_31184":74988,"_21603":127373,"_5":14870,"_28376":127135,"_3083":127374},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3632":75083,"_31184":74988,"_21603":127376,"_5":14870,"_28376":127135,"_3083":127377},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3632":75084,"_31184":74988,"_21603":127379,"_5":14870,"_28376":127135,"_3083":127380},[],"`PUT` devuelve 400.",{"_3632":75085,"_31184":74988,"_21603":127382,"_5":14870,"_28376":127135,"_3083":127383},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3632":75086,"_31184":74988,"_21603":127385,"_5":14870,"_28376":127135,"_3083":127386},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3632":75087,"_31184":74988,"_21603":127388,"_5":14870,"_28376":127135,"_3083":127389},[],"`PUT` devuelve 404.",{"_3632":75088,"_31184":74988,"_21603":127391,"_5":14870,"_28376":127135,"_3083":127392},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3632":75089,"_31184":74988,"_21603":127394,"_5":14870,"_28376":127135,"_3083":127395},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3632":75090,"_31184":74988,"_21603":127397,"_5":14870,"_28376":127135,"_3083":127398},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3632":75091,"_31184":74988,"_21603":127400,"_5":14870,"_28376":127135,"_3083":127401},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3632":75092,"_31184":74988,"_21603":127403,"_5":14870,"_28376":127135,"_3083":127404},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3632":75093,"_31184":74988,"_21603":127406,"_5":14870,"_28376":127135,"_3083":127407},[],"La CRL no cambia tras revocar un certificado.",{"_3632":75094,"_31184":74988,"_21603":127409,"_5":14870,"_28376":127135,"_3083":127410},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3632":75095,"_31184":74988,"_21603":127412,"_5":14870,"_28376":127135,"_3083":127413},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3632":75096,"_31184":74988,"_21603":127415,"_5":14870,"_28376":127135,"_3083":127416},[],"Un verificador rechaza la CRL por el emisor.",{"_3632":75097,"_31184":74988,"_21603":127418,"_5":14870,"_28376":127135,"_3083":127419},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3632":75098,"_31184":74988,"_21603":127421,"_5":14870,"_28376":127135,"_3083":127422},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3632":75099,"_31184":74988,"_21603":127424,"_5":14870,"_28376":127139,"_3083":127425},[],"RFC 5280: perfil X.509 y CRL.",{"_3632":75100,"_31184":74988,"_21603":127427,"_5":14870,"_28376":127139,"_3083":58189},[],{"_3632":75101,"_31184":74988,"_21603":127429,"_5":14870,"_28376":127139,"_3083":58192},[],{"_3632":75102,"_31184":74988,"_21603":127431,"_5":14870,"_28376":127139,"_3083":127432},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":75103,"_31184":74988,"_21603":127434,"_5":14870,"_28376":127139,"_3083":127435},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3632":75104,"_31184":75104,"_5":15230,"_3083":127437,"_31522":127438,"_21603":127439,"_28376":75104},"Claves y motores criptográficos",[50964,121884,56650,125906],[],{"_3632":75105,"_31184":75104,"_21603":127441,"_5":14870,"_28376":75104,"_3083":127442},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3632":75106,"_31184":75104,"_5":31519,"_21603":127444,"_28376":127445,"_3083":127446},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3632":75107,"_31184":75104,"_5":31519,"_21603":127448,"_28376":127449,"_3083":127450},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3632":75108,"_31184":75104,"_5":31519,"_21603":127452,"_28376":127453,"_3083":58217},[],"/docs/es/platform/pki/key-management#file-system",{"_3632":75109,"_31184":75104,"_5":31519,"_21603":127455,"_28376":127456,"_3083":58221},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3632":75110,"_31184":75104,"_5":31519,"_21603":127458,"_28376":127459,"_3083":58225},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3632":75111,"_31184":75104,"_5":31519,"_21603":127461,"_28376":127462,"_3083":58229},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3632":75112,"_31184":75104,"_5":31519,"_21603":127464,"_28376":127465,"_3083":58233},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3632":75113,"_31184":75104,"_5":31519,"_21603":127467,"_28376":127468,"_3083":58237},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3632":75114,"_31184":75104,"_5":31519,"_21603":127470,"_28376":127471,"_3083":127472},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3632":75115,"_31184":75104,"_5":31519,"_21603":127474,"_28376":127475,"_3083":127476},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3632":75116,"_31184":75104,"_5":31519,"_21603":127478,"_28376":127479,"_3083":127480},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3632":75117,"_31184":75104,"_5":31519,"_21603":127482,"_28376":127483,"_3083":127484},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3632":75118,"_31184":75104,"_5":31519,"_21603":127486,"_28376":127487,"_3083":127488},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3632":75119,"_31184":75104,"_5":31519,"_21603":127490,"_28376":127491,"_3083":127492},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3632":75120,"_31184":75104,"_5":31519,"_21603":127494,"_28376":127495,"_3083":127496},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3632":75121,"_31184":75104,"_5":31519,"_21603":127498,"_28376":127499,"_3083":58269},[],"/docs/es/platform/pki/key-management#sign",{"_3632":75122,"_31184":75104,"_5":31519,"_21603":127501,"_28376":127502,"_3083":58273},[],"/docs/es/platform/pki/key-management#verify",{"_3632":75123,"_31184":75104,"_5":31519,"_21603":127504,"_28376":127505,"_3083":127506},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3632":75124,"_31184":75104,"_5":31519,"_21603":127508,"_28376":127509,"_3083":127510},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3632":75125,"_31184":75104,"_5":31519,"_21603":127512,"_28376":127513,"_3083":127514},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3632":75126,"_31184":75104,"_21603":127516,"_5":14870,"_28376":75104,"_3083":127517},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3632":75127,"_31184":75104,"_21603":127519,"_5":14870,"_28376":75104,"_3083":127520},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3632":75128,"_31184":75104,"_21603":127522,"_5":14870,"_28376":127445,"_3083":127523},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3632":75129,"_31184":75104,"_21603":127525,"_5":14870,"_28376":127445,"_3083":127526},[],"En la práctica, permite:",{"_3632":75130,"_31184":75104,"_21603":127528,"_5":14870,"_28376":127445,"_3083":127529},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3632":75131,"_31184":75104,"_21603":127531,"_5":14870,"_28376":127445,"_3083":127532},[],"Importar claves creadas externamente.",{"_3632":75132,"_31184":75104,"_21603":127534,"_5":14870,"_28376":127445,"_3083":127535},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3632":75133,"_31184":75104,"_21603":127537,"_5":14870,"_28376":127445,"_3083":127538},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3632":75134,"_31184":75104,"_21603":127540,"_5":14870,"_28376":127449,"_3083":127541},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3632":75135,"_31184":75104,"_21603":127543,"_5":14870,"_28376":127449,"_3083":127544},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3632":75136,"_31184":75104,"_21603":127546,"_5":14870,"_28376":127449,"_3083":127547},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3632":75137,"_31184":75104,"_21603":127549,"_5":14870,"_28376":127453,"_3083":127550},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3632":75138,"_31184":75104,"_21603":127552,"_5":14870,"_28376":127456,"_3083":127553},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3632":75139,"_31184":75104,"_21603":127555,"_5":14870,"_28376":127456,"_3083":127556},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3632":75140,"_31184":75104,"_21603":127558,"_5":14870,"_28376":127459,"_3083":127559},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3632":75141,"_31184":75104,"_21603":127561,"_5":14870,"_28376":127462,"_3083":127562},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3632":75142,"_31184":75104,"_21603":127564,"_5":14870,"_28376":127465,"_3083":127565},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3632":75143,"_31184":75104,"_21603":127567,"_5":14870,"_28376":127468,"_3083":127568},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3632":75144,"_31184":75104,"_21603":127570,"_5":14870,"_28376":127468,"_3083":127571},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3632":75145,"_31184":75104,"_21603":127573,"_5":14870,"_28376":127468,"_3083":127574},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3632":75146,"_31184":75104,"_21603":127576,"_5":14870,"_28376":127468,"_3083":127577},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3632":75147,"_31184":75104,"_21603":127579,"_5":14870,"_28376":127471,"_3083":127580},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3632":75148,"_31184":75104,"_21603":127582,"_5":14870,"_28376":127471,"_3083":127583},[],"La tabla incluye los siguientes campos:",{"_3632":75149,"_31184":75104,"_21603":127585,"_5":14870,"_28376":127471,"_3083":127586},[],"**Name**: nombre descriptivo de la clave.",{"_3632":75150,"_31184":75104,"_21603":127588,"_5":14870,"_28376":127471,"_3083":127589},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3632":75151,"_31184":75104,"_21603":127591,"_5":14870,"_28376":127471,"_3083":127592},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3632":75152,"_31184":75104,"_21603":127594,"_5":14870,"_28376":127471,"_3083":127595},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3632":75153,"_31184":75104,"_21603":127597,"_5":14870,"_28376":127471,"_3083":127598},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3632":75154,"_31184":75104,"_21603":127600,"_5":14870,"_28376":127471,"_3083":127601},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3632":75155,"_31184":75104,"_21603":127603,"_5":14870,"_28376":127471,"_3083":127604},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3632":75156,"_31184":75104,"_21603":127606,"_5":14870,"_28376":127471,"_3083":127607},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3632":75157,"_31184":75104,"_21603":127609,"_5":14870,"_28376":127471,"_3083":127610},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3632":75158,"_31184":75104,"_21603":127612,"_5":14870,"_28376":127471,"_3083":127613},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3632":75159,"_31184":75104,"_21603":127615,"_5":14870,"_28376":127471,"_3083":127616},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3632":75160,"_31184":75104,"_21603":127618,"_5":14870,"_28376":127471,"_3083":127619},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3632":75161,"_31184":75104,"_21603":127621,"_5":14870,"_28376":127471,"_3083":127622},[],"**Delete Key** para eliminar la clave del sistema.",{"_3632":75162,"_31184":75104,"_21603":127624,"_5":14870,"_28376":127475,"_3083":127625},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3632":75163,"_31184":75104,"_21603":127627,"_5":14870,"_28376":127479,"_3083":127628},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3632":75164,"_31184":75104,"_21603":127630,"_5":14870,"_28376":127479,"_3083":127631},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3632":75165,"_31184":75104,"_21603":127633,"_5":14870,"_28376":127479,"_3083":127634},[],"**Key Name**: nombre único y descriptivo.",{"_3632":75166,"_31184":75104,"_21603":127636,"_5":14870,"_28376":127479,"_3083":127637},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3632":75167,"_31184":75104,"_21603":127639,"_5":14870,"_28376":127479,"_3083":127640},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3632":75168,"_31184":75104,"_21603":127642,"_5":14870,"_28376":127479,"_3083":127643},[],"**Tags**: metadatos para clasificar la clave.",{"_3632":75169,"_31184":75104,"_21603":127645,"_5":14870,"_28376":127479,"_3083":127646},[],"**Metadata**: información adicional para usos avanzados.",{"_3632":75170,"_31184":75104,"_21603":127648,"_5":14870,"_28376":127483,"_3083":127649},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3632":75171,"_31184":75104,"_21603":127651,"_5":14870,"_28376":127483,"_3083":127652},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3632":75172,"_31184":75104,"_21603":127654,"_5":14870,"_28376":127483,"_3083":127655},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3632":75173,"_31184":75104,"_21603":127657,"_5":14870,"_28376":127483,"_3083":127658},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3632":75174,"_31184":75104,"_21603":127660,"_5":14870,"_28376":127483,"_3083":127661},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3632":75175,"_31184":75104,"_21603":127663,"_5":14870,"_28376":127483,"_3083":127664},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3632":75176,"_31184":75104,"_21603":127666,"_5":14870,"_28376":127483,"_3083":127667},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3632":75177,"_31184":75104,"_21603":127669,"_5":14870,"_28376":127483,"_3083":127670},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3632":75178,"_31184":75104,"_21603":127672,"_5":14870,"_28376":127483,"_3083":127673},[],"**Metadata**: información adicional opcional.",{"_3632":75179,"_31184":75104,"_21603":127675,"_5":14870,"_28376":127483,"_3083":127676},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3632":75180,"_31184":75104,"_21603":127678,"_5":14870,"_28376":127483,"_3083":127679},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3632":75181,"_31184":75104,"_21603":127681,"_5":14870,"_28376":127487,"_3083":127682},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3632":75182,"_31184":75104,"_21603":127684,"_5":14870,"_28376":127491,"_3083":127685},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3632":75183,"_31184":75104,"_21603":127687,"_5":14870,"_28376":127491,"_3083":127688},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3632":75184,"_31184":75104,"_21603":127690,"_5":14870,"_28376":127491,"_3083":127691},[],"**Key Name**: nombre descriptivo.",{"_3632":75185,"_31184":75104,"_21603":127693,"_5":14870,"_28376":127491,"_3083":127694},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3632":75186,"_31184":75104,"_21603":127696,"_5":14870,"_28376":127491,"_3083":127697},[],"**Tags**: etiquetas asociadas.",{"_3632":75187,"_31184":75104,"_21603":127699,"_5":14870,"_28376":127491,"_3083":127700},[],"**Aliases**: nombres alternativos.",{"_3632":75188,"_31184":75104,"_21603":127702,"_5":14870,"_28376":127491,"_3083":127703},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3632":75189,"_31184":75104,"_21603":127705,"_5":14870,"_28376":127491,"_3083":127706},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3632":75190,"_31184":75104,"_21603":127708,"_5":14870,"_28376":127491,"_3083":127709},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3632":75191,"_31184":75104,"_21603":127711,"_5":14870,"_28376":127491,"_3083":127712},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3632":75192,"_31184":75104,"_21603":127714,"_5":14870,"_28376":127495,"_3083":127715},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3632":75193,"_31184":75104,"_21603":127717,"_5":14870,"_28376":127495,"_3083":127718},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3632":75194,"_31184":75104,"_21603":127720,"_5":14870,"_28376":127495,"_3083":127721},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3632":75195,"_31184":75104,"_21603":127723,"_5":14870,"_28376":127499,"_3083":127724},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3632":75196,"_31184":75104,"_21603":127726,"_5":14870,"_28376":127499,"_3083":127727},[],"Campos principales:",{"_3632":75197,"_31184":75104,"_21603":127729,"_5":14870,"_28376":127499,"_3083":127730},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3632":75198,"_31184":75104,"_21603":127732,"_5":14870,"_28376":127499,"_3083":127733},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3632":75199,"_31184":75104,"_21603":127735,"_5":14870,"_28376":127499,"_3083":127736},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3632":75200,"_31184":75104,"_21603":127738,"_5":14870,"_28376":127499,"_3083":127739},[],"**Message**: contenido que se va a firmar.",{"_3632":75201,"_31184":75104,"_21603":127741,"_5":14870,"_28376":127499,"_3083":127742},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3632":75202,"_31184":75104,"_21603":127744,"_5":14870,"_28376":127502,"_3083":127745},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3632":75203,"_31184":75104,"_21603":127747,"_5":14870,"_28376":127502,"_3083":127727},[],{"_3632":75204,"_31184":75104,"_21603":127749,"_5":14870,"_28376":127502,"_3083":127750},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3632":75205,"_31184":75104,"_21603":127752,"_5":14870,"_28376":127502,"_3083":127753},[],"**Message Type**: `Raw` o `Digest`.",{"_3632":75206,"_31184":75104,"_21603":127755,"_5":14870,"_28376":127502,"_3083":127756},[],"**Payload Encoding**: codificación del mensaje.",{"_3632":75207,"_31184":75104,"_21603":127758,"_5":14870,"_28376":127502,"_3083":127759},[],"**Message**: mensaje original o hash.",{"_3632":75208,"_31184":75104,"_21603":127761,"_5":14870,"_28376":127502,"_3083":127762},[],"**Signature**: firma que se desea comprobar.",{"_3632":75209,"_31184":75104,"_21603":127764,"_5":14870,"_28376":127502,"_3083":127765},[],"**Result**: indicador del resultado de la validación.",{"_3632":75210,"_31184":75104,"_21603":127767,"_5":14870,"_28376":127505,"_3083":127768},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3632":75211,"_31184":75104,"_21603":127770,"_5":14870,"_28376":127505,"_3083":127771},[],"Este flujo es útil para:",{"_3632":75212,"_31184":75104,"_21603":127773,"_5":14870,"_28376":127505,"_3083":127774},[],"Solicitar certificados a una CA externa.",{"_3632":75213,"_31184":75104,"_21603":127776,"_5":14870,"_28376":127505,"_3083":127777},[],"Renovar una identidad manteniendo la misma clave.",{"_3632":75214,"_31184":75104,"_21603":127779,"_5":14870,"_28376":127505,"_3083":127780},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3632":75215,"_31184":75104,"_21603":127782,"_5":14870,"_28376":127505,"_3083":127783},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3632":75216,"_31184":75104,"_21603":127785,"_5":14870,"_28376":127505,"_3083":127786},[],"**Organization (O)**: organización o empresa.",{"_3632":75217,"_31184":75104,"_21603":127788,"_5":14870,"_28376":127505,"_3083":127789},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3632":75218,"_31184":75104,"_21603":127791,"_5":14870,"_28376":127505,"_3083":127792},[],"**Country (C)**: código de país de dos letras.",{"_3632":75219,"_31184":75104,"_21603":127794,"_5":14870,"_28376":127505,"_3083":127795},[],"**State / Province (ST)**: estado o provincia.",{"_3632":75220,"_31184":75104,"_21603":127797,"_5":14870,"_28376":127505,"_3083":127798},[],"**Locality (L)**: ciudad o localidad.",{"_3632":75221,"_31184":75104,"_21603":127800,"_5":14870,"_28376":127505,"_3083":127801},[],"**Email Address**: correo de contacto.",{"_3632":75222,"_31184":75104,"_21603":127803,"_5":14870,"_28376":127505,"_3083":127804},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3632":75223,"_31184":75104,"_21603":127806,"_5":14870,"_28376":127505,"_3083":127807},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3632":75224,"_31184":75104,"_21603":127809,"_5":14870,"_28376":127509,"_3083":127810},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3632":75225,"_31184":75104,"_21603":127812,"_5":14870,"_28376":127509,"_3083":127813},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3632":75226,"_31184":75104,"_21603":127815,"_5":14870,"_28376":127513,"_3083":127816},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3632":75227,"_31184":75104,"_21603":127818,"_5":14870,"_28376":127513,"_3083":127819},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3632":75228,"_31184":75228,"_5":15230,"_3083":127821,"_31522":127822,"_21603":127823,"_28376":75228},"Validación online con OCSP",[50964,121884,56650,126577],[],{"_3632":75229,"_31184":75228,"_21603":127825,"_5":14870,"_28376":75228,"_3083":127826},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3632":75230,"_31184":75228,"_5":31519,"_21603":127828,"_28376":127829,"_3083":127830},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3632":75231,"_31184":75228,"_5":31519,"_21603":127832,"_28376":127833,"_3083":127834},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3632":75232,"_31184":75228,"_5":31519,"_21603":127836,"_28376":127837,"_3083":127838},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3632":75233,"_31184":75228,"_5":31519,"_21603":127840,"_28376":127841,"_3083":127842},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3632":75234,"_31184":75228,"_5":31519,"_21603":127844,"_28376":127845,"_3083":127846},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3632":75235,"_31184":75228,"_5":31519,"_21603":127848,"_28376":127849,"_3083":127140},[],"/docs/es/platform/pki/ocsp#referencias",{"_3632":75236,"_31184":75228,"_21603":127851,"_5":14870,"_28376":75228,"_3083":127852},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3632":75237,"_31184":75228,"_21603":127854,"_5":14870,"_28376":127829,"_3083":127855},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3632":75238,"_31184":75228,"_21603":127857,"_5":14870,"_28376":127829,"_3083":127858},[],"Estado del registro",{"_3632":75239,"_31184":75228,"_21603":127860,"_5":14870,"_28376":127829,"_3083":127861},[],"Respuesta firmada",{"_3632":75240,"_31184":75228,"_21603":127863,"_5":14870,"_28376":127829,"_3083":55787},[],{"_3632":75241,"_31184":75228,"_21603":127865,"_5":14870,"_28376":127829,"_3083":58637},[],{"_3632":75242,"_31184":75228,"_21603":127867,"_5":14870,"_28376":127829,"_3083":55804},[],{"_3632":75243,"_31184":75228,"_21603":127869,"_5":14870,"_28376":127829,"_3083":127870},[],"`Revoked`, con razón y fecha de revocación.",{"_3632":75244,"_31184":75228,"_21603":127872,"_5":14870,"_28376":127829,"_3083":127873},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3632":75245,"_31184":75228,"_21603":127875,"_5":14870,"_28376":127829,"_3083":127876},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3632":75246,"_31184":75228,"_21603":127878,"_5":14870,"_28376":127829,"_3083":127879},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3632":75247,"_31184":75228,"_21603":127881,"_5":14870,"_28376":127829,"_3083":127882},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3632":75248,"_31184":75228,"_21603":127884,"_5":14870,"_28376":127829,"_3083":127885},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3632":75249,"_31184":75228,"_21603":127887,"_5":14870,"_28376":127833,"_3083":127888},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3632":75250,"_31184":75228,"_21603":127890,"_5":14870,"_28376":127833,"_3083":127891},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3632":75251,"_31184":75228,"_21603":127893,"_5":14870,"_28376":127837,"_3083":127894},[],"El servicio acepta:",{"_3632":75252,"_31184":75228,"_21603":127896,"_5":14870,"_28376":127837,"_3083":123759},[],{"_3632":75253,"_31184":75228,"_21603":127898,"_5":14870,"_28376":127837,"_3083":127899},[],"Ruta del servicio VA",{"_3632":75254,"_31184":75228,"_21603":127901,"_5":14870,"_28376":127837,"_3083":127902},[],"Formato",{"_3632":75255,"_31184":75228,"_21603":127904,"_5":14870,"_28376":127837,"_3083":58677},[],{"_3632":75256,"_31184":75228,"_21603":127906,"_5":14870,"_28376":127837,"_3083":58680},[],{"_3632":75257,"_31184":75228,"_21603":127908,"_5":14870,"_28376":127837,"_3083":127909},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3632":75258,"_31184":75228,"_21603":127911,"_5":14870,"_28376":127837,"_3083":58072},[],{"_3632":75259,"_31184":75228,"_21603":127913,"_5":14870,"_28376":127837,"_3083":58688},[],{"_3632":75260,"_31184":75228,"_21603":127915,"_5":14870,"_28376":127837,"_3083":127916},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3632":75261,"_31184":75228,"_21603":127918,"_5":14870,"_28376":127837,"_3083":127919},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3632":75262,"_31184":75228,"_21603":127921,"_5":14870,"_28376":127841,"_3083":127922},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3632":75263,"_31184":75228,"_21603":127924,"_5":14870,"_28376":127841,"_3083":127925},[],"Genera la solicitud:",{"_3632":75264,"_31184":75228,"_21603":127927,"_5":14870,"_28376":127841,"_3083":127928},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3632":75265,"_31184":75228,"_21603":127930,"_5":14870,"_28376":127841,"_3083":127931},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3632":75266,"_31184":75228,"_21603":127933,"_5":14870,"_28376":127841,"_3083":127934},[],"Verifica el DER recibido:",{"_3632":75267,"_31184":75228,"_21603":127936,"_5":14870,"_28376":127841,"_3083":127937},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3632":75268,"_31184":75228,"_21603":127939,"_5":14870,"_28376":127845,"_3083":127940},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3632":75269,"_31184":75228,"_21603":127942,"_5":14870,"_28376":127845,"_3083":127943},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3632":75270,"_31184":75228,"_21603":127945,"_5":14870,"_28376":127849,"_3083":58721},[],{"_3632":75271,"_31184":75228,"_21603":127947,"_5":14870,"_28376":127849,"_3083":58724},[],{"_3632":75272,"_31184":75228,"_21603":127949,"_5":14870,"_28376":127849,"_3083":127950},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3632":75273,"_31184":75228,"_21603":127952,"_5":14870,"_28376":127849,"_3083":127435},[],{"_3632":75274,"_31184":75274,"_5":15230,"_3083":56650,"_31522":127954,"_21603":127955,"_28376":75274},[50964,121884,56650],[],{"_3632":75275,"_31184":75274,"_21603":127957,"_5":14870,"_28376":75274,"_3083":127958},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3632":75276,"_31184":75274,"_5":31519,"_21603":127960,"_28376":127961,"_3083":125232},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3632":75277,"_31184":75274,"_5":31519,"_21603":127963,"_28376":127964,"_3083":127965},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3632":75278,"_31184":75274,"_5":31519,"_21603":127967,"_28376":127968,"_3083":125752},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3632":75279,"_31184":75274,"_5":31519,"_21603":127970,"_28376":127971,"_3083":125756},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3632":75280,"_31184":75274,"_5":31519,"_21603":127973,"_28376":127974,"_3083":125760},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3632":75281,"_31184":75274,"_5":31519,"_21603":127976,"_28376":127977,"_3083":125764},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3632":75282,"_31184":75274,"_5":31519,"_21603":127979,"_28376":127980,"_3083":125772},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3632":75283,"_31184":75274,"_5":31519,"_21603":127982,"_28376":127983,"_3083":127984},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3632":75284,"_31184":75274,"_5":31519,"_21603":127986,"_28376":127987,"_3083":126743},[],"/docs/es/platform/pki/overview#continúa",{"_3632":75285,"_31184":75274,"_21603":127989,"_5":14870,"_28376":75274,"_3083":127990},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3632":75286,"_31184":75274,"_21603":127992,"_5":14870,"_28376":127961,"_3083":127993},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3632":75287,"_31184":75274,"_21603":127995,"_5":14870,"_28376":127961,"_3083":127996},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3632":75288,"_31184":75274,"_21603":127998,"_5":14870,"_28376":127964,"_3083":127999},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3632":75289,"_31184":75274,"_21603":128001,"_5":14870,"_28376":127964,"_3083":128002},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3632":75290,"_31184":75274,"_21603":128004,"_5":14870,"_28376":127964,"_3083":128005},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3632":75291,"_31184":75274,"_21603":128007,"_5":14870,"_28376":127964,"_3083":128008},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3632":75292,"_31184":75274,"_21603":128010,"_5":14870,"_28376":127964,"_3083":128011},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3632":75293,"_31184":75274,"_21603":128013,"_5":14870,"_28376":127971,"_3083":128014},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3632":75294,"_31184":75274,"_21603":128016,"_5":14870,"_28376":127974,"_3083":128017},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3632":75295,"_31184":75274,"_21603":128019,"_5":14870,"_28376":127977,"_3083":128020},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3632":75296,"_31184":75274,"_21603":128022,"_5":14870,"_28376":127980,"_3083":128023},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3632":75297,"_31184":75274,"_21603":128025,"_5":14870,"_28376":127983,"_3083":128026},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3632":75298,"_31184":75274,"_21603":128028,"_5":14870,"_28376":127983,"_3083":128029},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3632":75299,"_31184":75274,"_21603":128031,"_5":14870,"_28376":127983,"_3083":128032},[],"su clave pública corresponda a la clave privada del cliente;",{"_3632":75300,"_31184":75274,"_21603":128034,"_5":14870,"_28376":127983,"_3083":128035},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3632":75301,"_31184":75274,"_21603":128037,"_5":14870,"_28376":127983,"_3083":128038},[],"sus fechas y usos permitan la operación;",{"_3632":75302,"_31184":75274,"_21603":128040,"_5":14870,"_28376":127983,"_3083":128041},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3632":75303,"_31184":75274,"_21603":128043,"_5":14870,"_28376":127983,"_3083":128044},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3632":75304,"_31184":75274,"_21603":128046,"_5":14870,"_28376":127987,"_3083":128047},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":75305,"_31184":75274,"_21603":128049,"_5":14870,"_28376":127987,"_3083":128050},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3632":75306,"_31184":75274,"_21603":128052,"_5":14870,"_28376":127987,"_3083":128053},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3632":75307,"_31184":75307,"_5":15230,"_3083":128055,"_31522":128056,"_21603":128057,"_28376":75307},"Crea tu primera CA",[50964,121884,56650,125356],[],{"_3632":75308,"_31184":75307,"_21603":128059,"_5":14870,"_28376":75307,"_3083":128060},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3632":75309,"_31184":75307,"_5":31519,"_21603":128062,"_28376":128063,"_3083":120418},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3632":75310,"_31184":75307,"_5":31519,"_21603":128065,"_28376":128066,"_3083":128067},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3632":75311,"_31184":75307,"_5":31519,"_21603":128069,"_28376":128070,"_3083":128071},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3632":75312,"_31184":75307,"_5":31519,"_21603":128073,"_28376":128074,"_3083":128075},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3632":75313,"_31184":75307,"_5":31519,"_21603":128077,"_28376":128078,"_3083":128079},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3632":75314,"_31184":75307,"_5":31519,"_21603":128081,"_28376":128082,"_3083":128083},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3632":75315,"_31184":75307,"_5":31519,"_21603":128085,"_28376":128086,"_3083":128087},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3632":75316,"_31184":75307,"_5":31519,"_21603":128089,"_28376":128090,"_3083":125603},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3632":75317,"_31184":75307,"_5":31519,"_21603":128092,"_28376":128093,"_3083":120442},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3632":75318,"_31184":75307,"_21603":128095,"_5":14870,"_28376":75307,"_3083":128096},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3632":75319,"_31184":75307,"_21603":128098,"_5":14870,"_28376":128063,"_3083":128099},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3632":75320,"_31184":75307,"_21603":128101,"_5":14870,"_28376":128063,"_3083":128102},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3632":75321,"_31184":75307,"_21603":128104,"_5":14870,"_28376":128063,"_3083":128105},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3632":75322,"_31184":75307,"_21603":128107,"_5":14870,"_28376":128063,"_3083":128108},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3632":75323,"_31184":75307,"_21603":128110,"_5":14870,"_28376":128066,"_3083":128111},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3632":75324,"_31184":75307,"_21603":128113,"_5":14870,"_28376":128066,"_3083":128114},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3632":75325,"_31184":75307,"_21603":128116,"_5":14870,"_28376":128070,"_3083":128117},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3632":75326,"_31184":75307,"_21603":128119,"_5":14870,"_28376":128070,"_3083":128120},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3632":75327,"_31184":75307,"_21603":128122,"_5":14870,"_28376":128074,"_3083":128123},[],"Selecciona **Root CA** y completa:",{"_3632":75328,"_31184":75307,"_21603":128125,"_5":14870,"_28376":128074,"_3083":58903},[],{"_3632":75329,"_31184":75307,"_21603":128127,"_5":14870,"_28376":128074,"_3083":128128},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3632":75330,"_31184":75307,"_21603":128130,"_5":14870,"_28376":128074,"_3083":128131},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3632":75331,"_31184":75307,"_21603":128133,"_5":14870,"_28376":128074,"_3083":128134},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3632":75332,"_31184":75307,"_21603":128136,"_5":14870,"_28376":128074,"_3083":128137},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3632":75333,"_31184":75307,"_21603":128139,"_5":14870,"_28376":128078,"_3083":128140},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3632":75334,"_31184":75307,"_21603":128142,"_5":14870,"_28376":128082,"_3083":128143},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3632":75335,"_31184":75307,"_21603":128145,"_5":14870,"_28376":128082,"_3083":128146},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3632":75336,"_31184":75307,"_21603":128148,"_5":14870,"_28376":128086,"_3083":128149},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3632":75337,"_31184":75307,"_21603":128151,"_5":14870,"_28376":128086,"_3083":128152},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3632":75338,"_31184":75307,"_21603":128154,"_5":14870,"_28376":128086,"_3083":128155},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3632":75339,"_31184":75307,"_21603":128157,"_5":14870,"_28376":128090,"_3083":128158},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3632":75340,"_31184":75307,"_21603":128160,"_5":14870,"_28376":128090,"_3083":128161},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3632":75341,"_31184":75307,"_21603":128163,"_5":14870,"_28376":128090,"_3083":128164},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3632":75342,"_31184":75307,"_21603":128166,"_5":14870,"_28376":128090,"_3083":128167},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3632":75343,"_31184":75307,"_21603":128169,"_5":14870,"_28376":128093,"_3083":128170},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3632":75344,"_31184":75344,"_5":15230,"_3083":128172,"_31522":128173,"_21603":128174,"_28376":75344},"Emite y verifica un certificado",[50964,121884,56650,125356],[],{"_3632":75345,"_31184":75344,"_21603":128176,"_5":14870,"_28376":75344,"_3083":128177},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3632":75346,"_31184":75344,"_5":31519,"_21603":128179,"_28376":128180,"_3083":120418},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3632":75347,"_31184":75344,"_5":31519,"_21603":128182,"_28376":128183,"_3083":128184},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3632":75348,"_31184":75344,"_5":31519,"_21603":128186,"_28376":128187,"_3083":128188},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3632":75349,"_31184":75344,"_5":31519,"_21603":128190,"_28376":128191,"_3083":128192},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3632":75350,"_31184":75344,"_5":31519,"_21603":128194,"_28376":128195,"_3083":128196},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3632":75351,"_31184":75344,"_5":31519,"_21603":128198,"_28376":128199,"_3083":128200},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3632":75352,"_31184":75344,"_5":31519,"_21603":128202,"_28376":128203,"_3083":128204},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3632":75353,"_31184":75344,"_5":31519,"_21603":128206,"_28376":128207,"_3083":128208},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3632":75354,"_31184":75344,"_5":31519,"_21603":128210,"_28376":128211,"_3083":128212},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3632":75355,"_31184":75344,"_5":31519,"_21603":128214,"_28376":128215,"_3083":128216},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3632":75356,"_31184":75344,"_5":31519,"_21603":128218,"_28376":128219,"_3083":125603},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3632":75357,"_31184":75344,"_5":31519,"_21603":128221,"_28376":128222,"_3083":120442},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3632":75358,"_31184":75344,"_21603":128224,"_5":14870,"_28376":75344,"_3083":128225},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3632":75359,"_31184":75344,"_21603":128227,"_5":14870,"_28376":128180,"_3083":128228},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3632":75360,"_31184":75344,"_21603":128230,"_5":14870,"_28376":128180,"_3083":128231},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3632":75361,"_31184":75344,"_21603":128233,"_5":14870,"_28376":128180,"_3083":128234},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3632":75362,"_31184":75344,"_21603":128236,"_5":14870,"_28376":128180,"_3083":128237},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3632":75363,"_31184":75344,"_21603":128239,"_5":14870,"_28376":128180,"_3083":128240},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3632":75364,"_31184":75344,"_21603":128242,"_5":14870,"_28376":128183,"_3083":128243},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3632":75365,"_31184":75344,"_21603":128245,"_5":14870,"_28376":128187,"_3083":128246},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3632":75366,"_31184":75344,"_21603":128248,"_5":14870,"_28376":128187,"_3083":128249},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3632":75367,"_31184":75344,"_21603":128251,"_5":14870,"_28376":128191,"_3083":128252},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3632":75368,"_31184":75344,"_21603":128254,"_5":14870,"_28376":128191,"_3083":128255},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3632":75369,"_31184":75344,"_21603":128257,"_5":14870,"_28376":128195,"_3083":128258},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3632":75370,"_31184":75344,"_21603":128260,"_5":14870,"_28376":128195,"_3083":128261},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3632":75371,"_31184":75344,"_21603":128263,"_5":14870,"_28376":128199,"_3083":128264},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3632":75372,"_31184":75344,"_21603":128266,"_5":14870,"_28376":128203,"_3083":128267},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3632":75373,"_31184":75344,"_21603":128269,"_5":14870,"_28376":128207,"_3083":128270},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3632":75374,"_31184":75344,"_21603":128272,"_5":14870,"_28376":128211,"_3083":128273},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3632":75375,"_31184":75344,"_21603":128275,"_5":14870,"_28376":128211,"_3083":128276},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3632":75376,"_31184":75344,"_21603":128278,"_5":14870,"_28376":128211,"_3083":128279},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3632":75377,"_31184":75344,"_21603":128281,"_5":14870,"_28376":128215,"_3083":128282},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3632":75378,"_31184":75344,"_21603":128284,"_5":14870,"_28376":128215,"_3083":128285},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3632":75379,"_31184":75344,"_21603":128287,"_5":14870,"_28376":128215,"_3083":128288},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3632":75380,"_31184":75344,"_21603":128290,"_5":14870,"_28376":128219,"_3083":125686},[],{"_3632":75381,"_31184":75344,"_21603":128292,"_5":14870,"_28376":128219,"_3083":124201},[],{"_3632":75382,"_31184":75344,"_21603":128294,"_5":14870,"_28376":128219,"_3083":128295},[],"La CA rechaza la emisión",{"_3632":75383,"_31184":75344,"_21603":128297,"_5":14870,"_28376":128219,"_3083":128298},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3632":75384,"_31184":75344,"_21603":128300,"_5":14870,"_28376":128219,"_3083":128301},[],"Sujeto o usos diferentes",{"_3632":75385,"_31184":75344,"_21603":128303,"_5":14870,"_28376":128219,"_3083":128304},[],"Perfil aplicado y valores solicitados.",{"_3632":75386,"_31184":75344,"_21603":128306,"_5":14870,"_28376":128219,"_3083":128307},[],"No se encuentra el emisor",{"_3632":75387,"_31184":75344,"_21603":128309,"_5":14870,"_28376":128219,"_3083":128310},[],"CA descargada y cadena intermedia necesaria.",{"_3632":75388,"_31184":75344,"_21603":128312,"_5":14870,"_28376":128219,"_3083":128313},[],"Falla la vigencia",{"_3632":75389,"_31184":75344,"_21603":128315,"_5":14870,"_28376":128219,"_3083":128316},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3632":75390,"_31184":75344,"_21603":128318,"_5":14870,"_28376":128219,"_3083":128319},[],"Los resúmenes de clave difieren",{"_3632":75391,"_31184":75344,"_21603":128321,"_5":14870,"_28376":128219,"_3083":128322},[],"Archivos de certificado y clave de la misma emisión.",{"_3632":75392,"_31184":75344,"_21603":128324,"_5":14870,"_28376":128219,"_3083":128325},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3632":75393,"_31184":75344,"_21603":128327,"_5":14870,"_28376":128222,"_3083":128328},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3632":75394,"_31184":75344,"_21603":128330,"_5":14870,"_28376":128222,"_3083":128331},[],"Gestionar certificados para inspección, estado y revocación.",{"_3632":75395,"_31184":75344,"_21603":128333,"_5":14870,"_28376":128222,"_3083":128334},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3632":75396,"_31184":75344,"_21603":128336,"_5":14870,"_28376":128222,"_3083":128337},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3632":75397,"_31184":75344,"_21603":128339,"_5":14870,"_28376":128222,"_3083":128340},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3632":75398,"_31184":75398,"_5":15230,"_3083":128342,"_31522":128343,"_21603":128344,"_28376":75398},"Primeros pasos de PKI",[50964,121884,56650,125356],[],{"_3632":75399,"_31184":75398,"_21603":128346,"_5":14870,"_28376":75398,"_3083":128347},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3632":75400,"_31184":75398,"_5":31519,"_21603":128349,"_28376":128350,"_3083":120418},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3632":75401,"_31184":75398,"_5":31519,"_21603":128352,"_28376":128353,"_3083":128354},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3632":75402,"_31184":75398,"_5":31519,"_21603":128356,"_28376":128357,"_3083":125538},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3632":75403,"_31184":75398,"_5":31519,"_21603":128359,"_28376":128360,"_3083":128361},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3632":75404,"_31184":75398,"_21603":128363,"_5":14870,"_28376":75398,"_3083":128364},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3632":75405,"_31184":75398,"_21603":128366,"_5":14870,"_28376":128350,"_3083":128367},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3632":75406,"_31184":75398,"_21603":128369,"_5":14870,"_28376":128350,"_3083":128370},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3632":75407,"_31184":75398,"_21603":128372,"_5":14870,"_28376":128350,"_3083":128373},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3632":75408,"_31184":75398,"_21603":128375,"_5":14870,"_28376":128350,"_3083":128376},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3632":75409,"_31184":75398,"_21603":128378,"_5":14870,"_28376":128350,"_3083":128379},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3632":75410,"_31184":75398,"_21603":128381,"_5":14870,"_28376":128353,"_3083":128382},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3632":75411,"_31184":75398,"_21603":128384,"_5":14870,"_28376":128353,"_3083":128385},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3632":75412,"_31184":75398,"_21603":128387,"_5":14870,"_28376":128353,"_3083":128388},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3632":75413,"_31184":75398,"_21603":128390,"_5":14870,"_28376":128353,"_3083":128391},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3632":75414,"_31184":75398,"_21603":128393,"_5":14870,"_28376":128357,"_3083":128394},[],"Archivo o recurso",{"_3632":75415,"_31184":75398,"_21603":128396,"_5":14870,"_28376":128357,"_3083":125535},[],{"_3632":75416,"_31184":75398,"_21603":128398,"_5":14870,"_28376":128357,"_3083":128399},[],"CA raíz activa y `ca.pem`",{"_3632":75417,"_31184":75398,"_21603":128401,"_5":14870,"_28376":128357,"_3083":128402},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3632":75418,"_31184":75398,"_21603":128404,"_5":14870,"_28376":128357,"_3083":128405},[],"Certificado final y `device.crt`",{"_3632":75419,"_31184":75398,"_21603":128407,"_5":14870,"_28376":128357,"_3083":128408},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3632":75420,"_31184":75398,"_21603":128410,"_5":14870,"_28376":128357,"_3083":128411},[],"Clave privada `device.key`",{"_3632":75421,"_31184":75398,"_21603":128413,"_5":14870,"_28376":128357,"_3083":128414},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3632":75422,"_31184":75398,"_21603":128416,"_5":14870,"_28376":128357,"_3083":128417},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3632":75423,"_31184":75398,"_21603":128419,"_5":14870,"_28376":128360,"_3083":128420},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3632":75424,"_31184":75398,"_21603":128422,"_5":14870,"_28376":128360,"_3083":128423},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3632":75425,"_31184":75398,"_21603":128425,"_5":14870,"_28376":128360,"_3083":128426},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3632":75426,"_31184":75426,"_5":15230,"_3083":128428,"_31522":128429,"_21603":128431,"_28376":75426},"Resolución de problemas PKI",[50964,121884,56650,128430],"Resolución de problemas",[],{"_3632":75427,"_31184":75426,"_21603":128433,"_5":14870,"_28376":75426,"_3083":128434},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3632":75428,"_31184":75426,"_5":31519,"_21603":128436,"_28376":128437,"_3083":128438},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3632":75429,"_31184":75426,"_5":31519,"_21603":128440,"_28376":128441,"_3083":128442},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3632":75430,"_31184":75426,"_5":31519,"_21603":128444,"_28376":128445,"_3083":128446},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3632":75431,"_31184":75426,"_21603":128448,"_5":14870,"_28376":75426,"_3083":128449},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3632":75432,"_31184":75426,"_21603":128451,"_5":14870,"_28376":75426,"_3083":128452},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3632":75433,"_31184":75426,"_21603":128454,"_5":14870,"_28376":128437,"_3083":125535},[],{"_3632":75434,"_31184":75426,"_21603":128456,"_5":14870,"_28376":128437,"_3083":124201},[],{"_3632":75435,"_31184":75426,"_21603":128458,"_5":14870,"_28376":128437,"_3083":120442},[],{"_3632":75436,"_31184":75426,"_21603":128460,"_5":14870,"_28376":128437,"_3083":55492},[],{"_3632":75437,"_31184":75426,"_21603":128462,"_5":14870,"_28376":128437,"_3083":128463},[],"Existe, está activa y sus fechas son utilizables.",{"_3632":75438,"_31184":75426,"_21603":128465,"_5":14870,"_28376":128437,"_3083":128466},[],"Autoridades.",{"_3632":75439,"_31184":75426,"_21603":128468,"_5":14870,"_28376":128437,"_3083":128469},[],"Clave",{"_3632":75440,"_31184":75426,"_21603":128471,"_5":14870,"_28376":128437,"_3083":128472},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3632":75441,"_31184":75426,"_21603":128474,"_5":14870,"_28376":128437,"_3083":128475},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3632":75442,"_31184":75426,"_21603":128477,"_5":14870,"_28376":128437,"_3083":59257},[],{"_3632":75443,"_31184":75426,"_21603":128479,"_5":14870,"_28376":128437,"_3083":128480},[],"PEM correcto y firma verificable.",{"_3632":75444,"_31184":75426,"_21603":128482,"_5":14870,"_28376":128437,"_3083":59263},[],{"_3632":75445,"_31184":75426,"_21603":128484,"_5":14870,"_28376":128437,"_3083":128485},[],"Perfil",{"_3632":75446,"_31184":75426,"_21603":128487,"_5":14870,"_28376":128437,"_3083":128488},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3632":75447,"_31184":75426,"_21603":128490,"_5":14870,"_28376":128437,"_3083":128491},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3632":75448,"_31184":75426,"_21603":128493,"_5":14870,"_28376":128437,"_3083":125686},[],{"_3632":75449,"_31184":75426,"_21603":128495,"_5":14870,"_28376":128437,"_3083":128496},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3632":75450,"_31184":75426,"_21603":128498,"_5":14870,"_28376":128437,"_3083":128499},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3632":75451,"_31184":75426,"_21603":128501,"_5":14870,"_28376":128437,"_3083":128502},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3632":75452,"_31184":75426,"_21603":128504,"_5":14870,"_28376":128437,"_3083":128505},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3632":75453,"_31184":75426,"_21603":128507,"_5":14870,"_28376":128437,"_3083":128508},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3632":75454,"_31184":75426,"_21603":128510,"_5":14870,"_28376":128441,"_3083":128511},[],"Revisa cada frontera por separado:",{"_3632":75455,"_31184":75426,"_21603":128513,"_5":14870,"_28376":128441,"_3083":128514},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3632":75456,"_31184":75426,"_21603":128516,"_5":14870,"_28376":128441,"_3083":128517},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3632":75457,"_31184":75426,"_21603":128519,"_5":14870,"_28376":128441,"_3083":128520},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3632":75458,"_31184":75426,"_21603":128522,"_5":14870,"_28376":128441,"_3083":128523},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3632":75459,"_31184":75426,"_21603":128525,"_5":14870,"_28376":128441,"_3083":128526},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3632":75460,"_31184":75426,"_21603":128528,"_5":14870,"_28376":128441,"_3083":128529},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3632":75461,"_31184":75426,"_21603":128531,"_5":14870,"_28376":128445,"_3083":128532},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3632":75462,"_31184":75426,"_21603":128534,"_5":14870,"_28376":128445,"_3083":128535},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3632":75463,"_31184":75463,"_5":15230,"_3083":128537,"_31522":128538,"_21603":128539,"_28376":75463},"Seguridad",[50964],[],{"_3632":75464,"_31184":75463,"_21603":128541,"_5":14870,"_28376":75463,"_3083":128542},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3632":75465,"_31184":75463,"_5":31519,"_21603":128544,"_28376":128545,"_3083":128546},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3632":75466,"_31184":75463,"_5":31519,"_21603":128548,"_28376":128549,"_3083":128550},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3632":75467,"_31184":75463,"_5":31519,"_21603":128552,"_28376":128553,"_3083":128554},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3632":75468,"_31184":75463,"_5":31519,"_21603":128556,"_28376":128557,"_3083":128558},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3632":75469,"_31184":75463,"_21603":128560,"_5":14870,"_28376":75463,"_3083":128561},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3632":75470,"_31184":75463,"_21603":128563,"_5":14870,"_28376":128545,"_3083":128564},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3632":75471,"_31184":75463,"_21603":128566,"_5":14870,"_28376":128545,"_3083":128567},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3632":75472,"_31184":75463,"_21603":128569,"_5":14870,"_28376":128545,"_3083":15509},[],{"_3632":75473,"_31184":75463,"_21603":128571,"_5":14870,"_28376":128545,"_3083":15438},[],{"_3632":75474,"_31184":75463,"_21603":128573,"_5":14870,"_28376":128545,"_3083":15496},[],{"_3632":75475,"_31184":75463,"_21603":128575,"_5":14870,"_28376":128545,"_3083":128576},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3632":75476,"_31184":75463,"_21603":128578,"_5":14870,"_28376":128545,"_3083":128579},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3632":75477,"_31184":75463,"_21603":128581,"_5":14870,"_28376":128549,"_3083":128582},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3632":75478,"_31184":75463,"_21603":128584,"_5":14870,"_28376":128549,"_3083":128585},[],"No incluyas en el reporte:",{"_3632":75479,"_31184":75463,"_21603":128587,"_5":14870,"_28376":128549,"_3083":128588},[],"Credenciales, tokens o claves privadas",{"_3632":75480,"_31184":75463,"_21603":128590,"_5":14870,"_28376":128549,"_3083":128591},[],"Datos de clientes o información identificable de clientes",{"_3632":75481,"_31184":75463,"_21603":128593,"_5":14870,"_28376":128549,"_3083":128594},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3632":75482,"_31184":75463,"_21603":128596,"_5":14870,"_28376":128553,"_3083":128597},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3632":75483,"_31184":75463,"_21603":128599,"_5":14870,"_28376":128553,"_3083":128600},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3632":75484,"_31184":75463,"_21603":128602,"_5":14870,"_28376":128557,"_3083":128603},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3632":75485,"_31184":75463,"_21603":128605,"_5":14870,"_28376":128557,"_3083":128606},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3632":75486,"_31184":75463,"_21603":128608,"_5":14870,"_28376":128557,"_3083":128609},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3632":75487,"_31184":75463,"_21603":128611,"_5":14870,"_28376":128557,"_3083":128612},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3632":75488,"_31184":75463,"_21603":128614,"_5":14870,"_28376":128557,"_3083":128615},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3632":75489,"_31184":75489,"_5":15230,"_3083":128617,"_31522":128618,"_21603":128620,"_28376":75489},"3.8.0 a 4.0.0",[50964,128619],"Actualizaciones",[],{"_3632":75490,"_31184":75489,"_21603":128622,"_5":14870,"_28376":75489,"_3083":128623},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3632":75491,"_31184":75489,"_5":31519,"_21603":128625,"_28376":128626,"_3083":128627},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3632":75492,"_31184":75489,"_5":31519,"_21603":128629,"_28376":128630,"_3083":128631},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3632":75493,"_31184":75489,"_5":31519,"_21603":128633,"_28376":128634,"_3083":128635},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3632":75494,"_31184":75489,"_5":31519,"_21603":128637,"_28376":128638,"_3083":128639},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3632":75495,"_31184":75489,"_5":31519,"_21603":128641,"_28376":128642,"_3083":128643},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3632":75496,"_31184":75489,"_5":31519,"_21603":128645,"_28376":128646,"_3083":128647},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3632":75497,"_31184":75489,"_5":31519,"_21603":128649,"_28376":128650,"_3083":59432},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3632":75498,"_31184":75489,"_5":31519,"_21603":128652,"_28376":128653,"_3083":128654},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3632":75499,"_31184":75489,"_5":31519,"_21603":128656,"_28376":128657,"_3083":128658},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3632":75500,"_31184":75489,"_5":31519,"_21603":128660,"_28376":128661,"_3083":128662},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3632":75501,"_31184":75489,"_5":31519,"_21603":128664,"_28376":128665,"_3083":121013},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3632":75502,"_31184":75489,"_5":31519,"_21603":128667,"_28376":128668,"_3083":128669},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3632":75503,"_31184":75489,"_5":31519,"_21603":128671,"_28376":128672,"_3083":128673},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3632":75504,"_31184":75489,"_5":31519,"_21603":128675,"_28376":128676,"_3083":128677},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3632":75505,"_31184":75489,"_5":31519,"_21603":128679,"_28376":128680,"_3083":128681},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3632":75506,"_31184":75489,"_5":31519,"_21603":128683,"_28376":128684,"_3083":128685},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3632":75507,"_31184":75489,"_5":31519,"_21603":128687,"_28376":128688,"_3083":128689},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3632":75508,"_31184":75489,"_5":31519,"_21603":128691,"_28376":128692,"_3083":128693},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3632":75509,"_31184":75489,"_5":31519,"_21603":128695,"_28376":128696,"_3083":128697},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3632":75510,"_31184":75489,"_5":31519,"_21603":128699,"_28376":128700,"_3083":128701},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3632":75511,"_31184":75489,"_5":31519,"_21603":128703,"_28376":128704,"_3083":128705},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3632":75512,"_31184":75489,"_5":31519,"_21603":128707,"_28376":128708,"_3083":128709},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3632":75513,"_31184":75489,"_5":31519,"_21603":128711,"_28376":128712,"_3083":128713},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3632":75514,"_31184":75489,"_5":31519,"_21603":128715,"_28376":128716,"_3083":128717},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3632":75515,"_31184":75489,"_5":31519,"_21603":128719,"_28376":128720,"_3083":128721},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3632":75516,"_31184":75489,"_5":31519,"_21603":128723,"_28376":128724,"_3083":128725},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3632":75517,"_31184":75489,"_5":31519,"_21603":128727,"_28376":128728,"_3083":128729},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3632":75518,"_31184":75489,"_5":31519,"_21603":128731,"_28376":128732,"_3083":128733},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3632":75519,"_31184":75489,"_5":31519,"_21603":128735,"_28376":128736,"_3083":128737},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3632":75520,"_31184":75489,"_5":31519,"_21603":128739,"_28376":128740,"_3083":128741},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3632":75521,"_31184":75489,"_5":31519,"_21603":128743,"_28376":128744,"_3083":128745},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3632":75522,"_31184":75489,"_5":31519,"_21603":128747,"_28376":128748,"_3083":128749},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3632":75523,"_31184":75489,"_5":31519,"_21603":128751,"_28376":128752,"_3083":128753},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3632":75524,"_31184":75489,"_5":31519,"_21603":128755,"_28376":128756,"_3083":128757},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3632":75525,"_31184":75489,"_5":31519,"_21603":128759,"_28376":128760,"_3083":128761},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3632":75526,"_31184":75489,"_5":31519,"_21603":128763,"_28376":128764,"_3083":128765},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3632":75527,"_31184":75489,"_5":31519,"_21603":128767,"_28376":128768,"_3083":128769},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3632":75528,"_31184":75489,"_5":31519,"_21603":128771,"_28376":128772,"_3083":128773},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3632":75529,"_31184":75489,"_5":31519,"_21603":128775,"_28376":128776,"_3083":128777},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3632":75530,"_31184":75489,"_5":31519,"_21603":128779,"_28376":128780,"_3083":128781},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3632":75531,"_31184":75489,"_5":31519,"_21603":128783,"_28376":128784,"_3083":128785},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3632":75532,"_31184":75489,"_5":31519,"_21603":128787,"_28376":128788,"_3083":128789},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3632":75533,"_31184":75489,"_5":31519,"_21603":128791,"_28376":128792,"_3083":128793},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3632":75534,"_31184":75489,"_5":31519,"_21603":128795,"_28376":128796,"_3083":128797},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3632":75535,"_31184":75489,"_5":31519,"_21603":128799,"_28376":128800,"_3083":124549},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3632":75536,"_31184":75489,"_5":31519,"_21603":128802,"_28376":128803,"_3083":128804},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3632":75537,"_31184":75489,"_5":31519,"_21603":128806,"_28376":128807,"_3083":128808},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3632":75538,"_31184":75489,"_21603":128810,"_5":14870,"_28376":75489,"_3083":128811},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3632":75539,"_31184":75489,"_21603":128813,"_5":14870,"_28376":75489,"_3083":128814},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3632":75540,"_31184":75489,"_21603":128816,"_5":14870,"_28376":75489,"_3083":128817},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3632":75541,"_31184":75489,"_21603":128819,"_5":14870,"_28376":75489,"_3083":128820},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3632":75542,"_31184":75489,"_21603":128822,"_5":14870,"_28376":75489,"_3083":128823},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3632":75543,"_31184":75489,"_21603":128825,"_5":14870,"_28376":75489,"_3083":128826},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3632":75544,"_31184":75489,"_21603":128828,"_5":14870,"_28376":75489,"_3083":128829},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3632":75545,"_31184":75489,"_21603":128831,"_5":14870,"_28376":128630,"_3083":128832},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3632":75546,"_31184":75489,"_21603":128834,"_5":14870,"_28376":128630,"_3083":128835},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3632":75547,"_31184":75489,"_21603":128837,"_5":14870,"_28376":128634,"_3083":128838},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3632":75548,"_31184":75489,"_21603":128840,"_5":14870,"_28376":128634,"_3083":128841},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3632":75549,"_31184":75489,"_21603":128843,"_5":14870,"_28376":128638,"_3083":128844},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3632":75550,"_31184":75489,"_21603":128846,"_5":14870,"_28376":128642,"_3083":128847},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3632":75551,"_31184":75489,"_21603":128849,"_5":14870,"_28376":128642,"_3083":128850},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3632":75552,"_31184":75489,"_21603":128852,"_5":14870,"_28376":128642,"_3083":128853},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3632":75553,"_31184":75489,"_21603":128855,"_5":14870,"_28376":128642,"_3083":128856},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3632":75554,"_31184":75489,"_21603":128858,"_5":14870,"_28376":128642,"_3083":128859},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3632":75555,"_31184":75489,"_21603":128861,"_5":14870,"_28376":128646,"_3083":128862},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3632":75556,"_31184":75489,"_21603":128864,"_5":14870,"_28376":128646,"_3083":128865},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3632":75557,"_31184":75489,"_21603":128867,"_5":14870,"_28376":128646,"_3083":128868},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3632":75558,"_31184":75489,"_21603":128870,"_5":14870,"_28376":128646,"_3083":128871},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3632":75559,"_31184":75489,"_21603":128873,"_5":14870,"_28376":128646,"_3083":128874},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3632":75560,"_31184":75489,"_21603":128876,"_5":14870,"_28376":128646,"_3083":128877},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3632":75561,"_31184":75489,"_21603":128879,"_5":14870,"_28376":128650,"_3083":128880},[],"Cambio",{"_3632":75562,"_31184":75489,"_21603":128882,"_5":14870,"_28376":128650,"_3083":128883},[],"A quién afecta",{"_3632":75563,"_31184":75489,"_21603":128885,"_5":14870,"_28376":128650,"_3083":128886},[],"Gravedad",{"_3632":75564,"_31184":75489,"_21603":128888,"_5":14870,"_28376":128650,"_3083":127359},[],{"_3632":75565,"_31184":75489,"_21603":128890,"_5":14870,"_28376":128650,"_3083":128658},[],{"_3632":75566,"_31184":75489,"_21603":128892,"_5":14870,"_28376":128650,"_3083":128893},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3632":75567,"_31184":75489,"_21603":128895,"_5":14870,"_28376":128650,"_3083":128896},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3632":75568,"_31184":75489,"_21603":128898,"_5":14870,"_28376":128650,"_3083":128899},[],"Copiar los datos a los volúmenes nuevos",{"_3632":75569,"_31184":75489,"_21603":128901,"_5":14870,"_28376":128650,"_3083":128662},[],{"_3632":75570,"_31184":75489,"_21603":128903,"_5":14870,"_28376":128650,"_3083":128904},[],"Todas las releases de Helm",{"_3632":75571,"_31184":75489,"_21603":128906,"_5":14870,"_28376":128650,"_3083":128907},[],"Alta: `helm upgrade` falla",{"_3632":75572,"_31184":75489,"_21603":128909,"_5":14870,"_28376":128650,"_3083":128910},[],"Eliminar o renombrar las claves heredadas",{"_3632":75573,"_31184":75489,"_21603":128912,"_5":14870,"_28376":128650,"_3083":121013},[],{"_3632":75574,"_31184":75489,"_21603":128914,"_5":14870,"_28376":128650,"_3083":128904},[],{"_3632":75575,"_31184":75489,"_21603":128916,"_5":14870,"_28376":128650,"_3083":128917},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3632":75576,"_31184":75489,"_21603":128919,"_5":14870,"_28376":128650,"_3083":128920},[],"Crear primero los Secrets; consulta el paso 2",{"_3632":75577,"_31184":75489,"_21603":128922,"_5":14870,"_28376":128650,"_3083":128669},[],{"_3632":75578,"_31184":75489,"_21603":128924,"_5":14870,"_28376":128650,"_3083":128925},[],"Todos los despliegues",{"_3632":75579,"_31184":75489,"_21603":128927,"_5":14870,"_28376":128650,"_3083":128928},[],"Alta: sin principal de bootstrap no hay administrador",{"_3632":75580,"_31184":75489,"_21603":128930,"_5":14870,"_28376":128650,"_3083":128931},[],"Configurar `services.authz`",{"_3632":75581,"_31184":75489,"_21603":128933,"_5":14870,"_28376":128650,"_3083":128673},[],{"_3632":75582,"_31184":75489,"_21603":128935,"_5":14870,"_28376":128650,"_3083":128904},[],{"_3632":75583,"_31184":75489,"_21603":128937,"_5":14870,"_28376":128650,"_3083":128938},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3632":75584,"_31184":75489,"_21603":128940,"_5":14870,"_28376":128650,"_3083":128941},[],"Mover JWKS y roles a `services.authz`",{"_3632":75585,"_31184":75489,"_21603":128943,"_5":14870,"_28376":128650,"_3083":128693},[],{"_3632":75586,"_31184":75489,"_21603":128945,"_5":14870,"_28376":128650,"_3083":128946},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3632":75587,"_31184":75489,"_21603":128948,"_5":14870,"_28376":128650,"_3083":128949},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3632":75588,"_31184":75489,"_21603":128951,"_5":14870,"_28376":128650,"_3083":128952},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3632":75589,"_31184":75489,"_21603":128954,"_5":14870,"_28376":128650,"_3083":128697},[],{"_3632":75590,"_31184":75489,"_21603":128956,"_5":14870,"_28376":128650,"_3083":128957},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3632":75591,"_31184":75489,"_21603":128959,"_5":14870,"_28376":128650,"_3083":128960},[],"Alta: el backend ya no arranca con ellos",{"_3632":75592,"_31184":75489,"_21603":128962,"_5":14870,"_28376":128650,"_3083":128963},[],"Pasar a PostgreSQL antes de actualizar",{"_3632":75593,"_31184":75489,"_21603":128965,"_5":14870,"_28376":128650,"_3083":128745},[],{"_3632":75594,"_31184":75489,"_21603":128967,"_5":14870,"_28376":128650,"_3083":128968},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3632":75595,"_31184":75489,"_21603":128970,"_5":14870,"_28376":128650,"_3083":128971},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3632":75596,"_31184":75489,"_21603":128973,"_5":14870,"_28376":128650,"_3083":128974},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3632":75597,"_31184":75489,"_21603":128976,"_5":14870,"_28376":128650,"_3083":128977},[],"Webhooks con referencias a archivos",{"_3632":75598,"_31184":75489,"_21603":128979,"_5":14870,"_28376":128650,"_3083":128980},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3632":75599,"_31184":75489,"_21603":128982,"_5":14870,"_28376":128650,"_3083":128983},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3632":75600,"_31184":75489,"_21603":128985,"_5":14870,"_28376":128650,"_3083":128986},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3632":75601,"_31184":75489,"_21603":128988,"_5":14870,"_28376":128650,"_3083":128677},[],{"_3632":75602,"_31184":75489,"_21603":128990,"_5":14870,"_28376":128650,"_3083":128991},[],"Releases con identidades por servicio o material de claves montado",{"_3632":75603,"_31184":75489,"_21603":128993,"_5":14870,"_28376":128650,"_3083":128994},[],"Media: los servicios no pueden leer sus archivos",{"_3632":75604,"_31184":75489,"_21603":128996,"_5":14870,"_28376":128650,"_3083":128997},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3632":75605,"_31184":75489,"_21603":128999,"_5":14870,"_28376":128650,"_3083":128681},[],{"_3632":75606,"_31184":75489,"_21603":129001,"_5":14870,"_28376":128650,"_3083":129002},[],"Releases que definen `amqp.tls`",{"_3632":75607,"_31184":75489,"_21603":129004,"_5":14870,"_28376":128650,"_3083":129005},[],"Media: los clientes se conectan al puerto equivocado",{"_3632":75608,"_31184":75489,"_21603":129007,"_5":14870,"_28376":128650,"_3083":129008},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3632":75609,"_31184":75489,"_21603":129010,"_5":14870,"_28376":128650,"_3083":128701},[],{"_3632":75610,"_31184":75489,"_21603":129012,"_5":14870,"_28376":128650,"_3083":129013},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3632":75611,"_31184":75489,"_21603":129015,"_5":14870,"_28376":128650,"_3083":129016},[],"Media: las claves de CA quedan sin gestionar",{"_3632":75612,"_31184":75489,"_21603":129018,"_5":14870,"_28376":128650,"_3083":129019},[],"Ejecutar la migración de CA a KMS",{"_3632":75613,"_31184":75489,"_21603":129021,"_5":14870,"_28376":128650,"_3083":129022},[],"Verificación del certificado del receptor",{"_3632":75614,"_31184":75489,"_21603":129024,"_5":14870,"_28376":128650,"_3083":129025},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3632":75615,"_31184":75489,"_21603":129027,"_5":14870,"_28376":128650,"_3083":129028},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3632":75616,"_31184":75489,"_21603":129030,"_5":14870,"_28376":128650,"_3083":129031},[],"Poner `insecure_skip_verify` a `false`",{"_3632":75617,"_31184":75489,"_21603":129033,"_5":14870,"_28376":128650,"_3083":128717},[],{"_3632":75618,"_31184":75489,"_21603":129035,"_5":14870,"_28376":128650,"_3083":129036},[],"Scripts y consolas que editan DMS por API",{"_3632":75619,"_31184":75489,"_21603":129038,"_5":14870,"_28376":128650,"_3083":129039},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3632":75620,"_31184":75489,"_21603":129041,"_5":14870,"_28376":128650,"_3083":129042},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3632":75621,"_31184":75489,"_21603":129044,"_5":14870,"_28376":128650,"_3083":128721},[],{"_3632":75622,"_31184":75489,"_21603":129046,"_5":14870,"_28376":128650,"_3083":129047},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3632":75623,"_31184":75489,"_21603":129049,"_5":14870,"_28376":128650,"_3083":129050},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3632":75624,"_31184":75489,"_21603":129052,"_5":14870,"_28376":128650,"_3083":129053},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3632":75625,"_31184":75489,"_21603":129055,"_5":14870,"_28376":128650,"_3083":128741},[],{"_3632":75626,"_31184":75489,"_21603":129057,"_5":14870,"_28376":128650,"_3083":129058},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3632":75627,"_31184":75489,"_21603":129060,"_5":14870,"_28376":128650,"_3083":129061},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3632":75628,"_31184":75489,"_21603":129063,"_5":14870,"_28376":128650,"_3083":129064},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3632":75629,"_31184":75489,"_21603":129066,"_5":14870,"_28376":128650,"_3083":128749},[],{"_3632":75630,"_31184":75489,"_21603":129068,"_5":14870,"_28376":128650,"_3083":129069},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3632":75631,"_31184":75489,"_21603":129071,"_5":14870,"_28376":128650,"_3083":129072},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3632":75632,"_31184":75489,"_21603":129074,"_5":14870,"_28376":128650,"_3083":129075},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3632":75633,"_31184":75489,"_21603":129077,"_5":14870,"_28376":128650,"_3083":128753},[],{"_3632":75634,"_31184":75489,"_21603":129079,"_5":14870,"_28376":128650,"_3083":129080},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3632":75635,"_31184":75489,"_21603":129082,"_5":14870,"_28376":128650,"_3083":129083},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3632":75636,"_31184":75489,"_21603":129085,"_5":14870,"_28376":128650,"_3083":129086},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3632":75637,"_31184":75489,"_21603":129088,"_5":14870,"_28376":128650,"_3083":128737},[],{"_3632":75638,"_31184":75489,"_21603":129090,"_5":14870,"_28376":128650,"_3083":129091},[],"Consumidores que leen el campo `events` del dispositivo",{"_3632":75639,"_31184":75489,"_21603":129093,"_5":14870,"_28376":128650,"_3083":129094},[],"Media: el campo desaparece",{"_3632":75640,"_31184":75489,"_21603":129096,"_5":14870,"_28376":128650,"_3083":129097},[],"Usar los nuevos endpoints de eventos",{"_3632":75641,"_31184":75489,"_21603":129099,"_5":14870,"_28376":128650,"_3083":128765},[],{"_3632":75642,"_31184":75489,"_21603":129101,"_5":14870,"_28376":128650,"_3083":129102},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3632":75643,"_31184":75489,"_21603":129104,"_5":14870,"_28376":128650,"_3083":129105},[],"Media: la migración de la VA aborta",{"_3632":75644,"_31184":75489,"_21603":129107,"_5":14870,"_28376":128650,"_3083":129108},[],"Corregir los roles afectados antes de actualizar",{"_3632":75645,"_31184":75489,"_21603":129110,"_5":14870,"_28376":128650,"_3083":128685},[],{"_3632":75646,"_31184":75489,"_21603":129112,"_5":14870,"_28376":128650,"_3083":129113},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3632":75647,"_31184":75489,"_21603":129115,"_5":14870,"_28376":128650,"_3083":129116},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3632":75648,"_31184":75489,"_21603":129118,"_5":14870,"_28376":128650,"_3083":129119},[],"Actualizar el archivo de values",{"_3632":75649,"_31184":75489,"_21603":129121,"_5":14870,"_28376":128650,"_3083":128729},[],{"_3632":75650,"_31184":75489,"_21603":129123,"_5":14870,"_28376":128650,"_3083":129124},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3632":75651,"_31184":75489,"_21603":129126,"_5":14870,"_28376":128650,"_3083":129127},[],"Baja: prevalece el ID de la URL",{"_3632":75652,"_31184":75489,"_21603":129129,"_5":14870,"_28376":128650,"_3083":129130},[],"Enviar el ID en la URL",{"_3632":75653,"_31184":75489,"_21603":129132,"_5":14870,"_28376":128650,"_3083":128757},[],{"_3632":75654,"_31184":75489,"_21603":129134,"_5":14870,"_28376":128650,"_3083":129135},[],"Clientes que envían un `id` al crear o importar CAs",{"_3632":75655,"_31184":75489,"_21603":129137,"_5":14870,"_28376":128650,"_3083":129138},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3632":75656,"_31184":75489,"_21603":129140,"_5":14870,"_28376":128650,"_3083":129141},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3632":75657,"_31184":75489,"_21603":129143,"_5":14870,"_28376":128650,"_3083":128761},[],{"_3632":75658,"_31184":75489,"_21603":129145,"_5":14870,"_28376":128650,"_3083":129146},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3632":75659,"_31184":75489,"_21603":129148,"_5":14870,"_28376":128650,"_3083":129149},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3632":75660,"_31184":75489,"_21603":129151,"_5":14870,"_28376":128650,"_3083":129152},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3632":75661,"_31184":75489,"_21603":129154,"_5":14870,"_28376":128650,"_3083":128733},[],{"_3632":75662,"_31184":75489,"_21603":129156,"_5":14870,"_28376":128650,"_3083":129157},[],"Consumidores que comparan el `type` del certificado",{"_3632":75663,"_31184":75489,"_21603":129159,"_5":14870,"_28376":128650,"_3083":129160},[],"Baja: dos valores cambian de nombre",{"_3632":75664,"_31184":75489,"_21603":129162,"_5":14870,"_28376":128650,"_3083":129163},[],"Adaptar los consumidores",{"_3632":75665,"_31184":75489,"_21603":129165,"_5":14870,"_28376":128650,"_3083":128725},[],{"_3632":75666,"_31184":75489,"_21603":129167,"_5":14870,"_28376":128650,"_3083":129168},[],"Cualquier DMS",{"_3632":75667,"_31184":75489,"_21603":129170,"_5":14870,"_28376":128650,"_3083":129171},[],"Baja: solo informativo",{"_3632":75668,"_31184":75489,"_21603":129173,"_5":14870,"_28376":128650,"_3083":129174},[],"Revisar ambos bloques antes de editar",{"_3632":75669,"_31184":75489,"_21603":129176,"_5":14870,"_28376":128657,"_3083":129177},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3632":75670,"_31184":75489,"_21603":129179,"_5":14870,"_28376":128657,"_3083":129180},[],"El paso 4 de la guía de migración copia los datos.",{"_3632":75671,"_31184":75489,"_21603":129182,"_5":14870,"_28376":128661,"_3083":129183},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3632":75672,"_31184":75489,"_21603":129185,"_5":14870,"_28376":128665,"_3083":129186},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3632":75673,"_31184":75489,"_21603":129188,"_5":14870,"_28376":128665,"_3083":129189},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3632":75674,"_31184":75489,"_21603":129191,"_5":14870,"_28376":128668,"_3083":129192},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3632":75675,"_31184":75489,"_21603":129194,"_5":14870,"_28376":128672,"_3083":129195},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3632":75676,"_31184":75489,"_21603":129197,"_5":14870,"_28376":128676,"_3083":129198},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3632":75677,"_31184":75489,"_21603":129200,"_5":14870,"_28376":128676,"_3083":129201},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3632":75678,"_31184":75489,"_21603":129203,"_5":14870,"_28376":128676,"_3083":129204},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3632":75679,"_31184":75489,"_21603":129206,"_5":14870,"_28376":128680,"_3083":129207},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3632":75680,"_31184":75489,"_21603":129209,"_5":14870,"_28376":128684,"_3083":129210},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3632":75681,"_31184":75489,"_21603":129212,"_5":14870,"_28376":128684,"_3083":129213},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3632":75682,"_31184":75489,"_21603":129215,"_5":14870,"_28376":128684,"_3083":129216},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3632":75683,"_31184":75489,"_21603":129218,"_5":14870,"_28376":128684,"_3083":129219},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3632":75684,"_31184":75489,"_21603":129221,"_5":14870,"_28376":128684,"_3083":129222},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3632":75685,"_31184":75489,"_21603":129224,"_5":14870,"_28376":128684,"_3083":129225},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3632":75686,"_31184":75489,"_21603":129227,"_5":14870,"_28376":128692,"_3083":129228},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3632":75687,"_31184":75489,"_21603":129230,"_5":14870,"_28376":128692,"_3083":129231},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3632":75688,"_31184":75489,"_21603":129233,"_5":14870,"_28376":128692,"_3083":129234},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3632":75689,"_31184":75489,"_21603":129236,"_5":14870,"_28376":128692,"_3083":129237},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3632":75690,"_31184":75489,"_21603":129239,"_5":14870,"_28376":128692,"_3083":129240},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3632":75691,"_31184":75489,"_21603":129242,"_5":14870,"_28376":128696,"_3083":129243},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3632":75692,"_31184":75489,"_21603":129245,"_5":14870,"_28376":128700,"_3083":129246},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3632":75693,"_31184":75489,"_21603":129248,"_5":14870,"_28376":128700,"_3083":129249},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3632":75694,"_31184":75489,"_21603":129251,"_5":14870,"_28376":128700,"_3083":129252},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3632":75695,"_31184":75489,"_21603":129254,"_5":14870,"_28376":128700,"_3083":129255},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3632":75696,"_31184":75489,"_21603":129257,"_5":14870,"_28376":128700,"_3083":129258},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3632":75697,"_31184":75489,"_21603":129260,"_5":14870,"_28376":128700,"_3083":129261},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3632":75698,"_31184":75489,"_21603":129263,"_5":14870,"_28376":128700,"_3083":129264},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3632":75699,"_31184":75489,"_21603":129266,"_5":14870,"_28376":128700,"_3083":129267},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3632":75700,"_31184":75489,"_21603":129269,"_5":14870,"_28376":128704,"_3083":129270},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3632":75701,"_31184":75489,"_21603":129272,"_5":14870,"_28376":128712,"_3083":129273},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3632":75702,"_31184":75489,"_21603":129275,"_5":14870,"_28376":128712,"_3083":129276},[],"Campo en 3.8.0",{"_3632":75703,"_31184":75489,"_21603":129278,"_5":14870,"_28376":128712,"_3083":129279},[],"Campo en 4.0.0",{"_3632":75704,"_31184":75489,"_21603":129281,"_5":14870,"_28376":128712,"_3083":60063},[],{"_3632":75705,"_31184":75489,"_21603":129283,"_5":14870,"_28376":128712,"_3083":129284},[],"`insecure_skip_verify` (con el valor negado)",{"_3632":75706,"_31184":75489,"_21603":129286,"_5":14870,"_28376":128712,"_3083":60069},[],{"_3632":75707,"_31184":75489,"_21603":129288,"_5":14870,"_28376":128712,"_3083":60072},[],{"_3632":75708,"_31184":75489,"_21603":129290,"_5":14870,"_28376":128712,"_3083":60075},[],{"_3632":75709,"_31184":75489,"_21603":129292,"_5":14870,"_28376":128712,"_3083":60078},[],{"_3632":75710,"_31184":75489,"_21603":129294,"_5":14870,"_28376":128712,"_3083":60081},[],{"_3632":75711,"_31184":75489,"_21603":129296,"_5":14870,"_28376":128712,"_3083":60084},[],{"_3632":75712,"_31184":75489,"_21603":129298,"_5":14870,"_28376":128712,"_3083":129299},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3632":75713,"_31184":75489,"_21603":129301,"_5":14870,"_28376":128712,"_3083":129302},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3632":75714,"_31184":75489,"_21603":129304,"_5":14870,"_28376":128712,"_3083":129305},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3632":75715,"_31184":75489,"_21603":129307,"_5":14870,"_28376":128716,"_3083":129308},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3632":75716,"_31184":75489,"_21603":129310,"_5":14870,"_28376":128716,"_3083":129311},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3632":75717,"_31184":75489,"_21603":129313,"_5":14870,"_28376":128716,"_3083":129314},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3632":75718,"_31184":75489,"_21603":129316,"_5":14870,"_28376":128720,"_3083":129317},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3632":75719,"_31184":75489,"_21603":129319,"_5":14870,"_28376":128720,"_3083":129320},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3632":75720,"_31184":75489,"_21603":129322,"_5":14870,"_28376":128724,"_3083":129323},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3632":75721,"_31184":75489,"_21603":129325,"_5":14870,"_28376":128728,"_3083":129326},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3632":75722,"_31184":75489,"_21603":129328,"_5":14870,"_28376":128732,"_3083":129329},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3632":75723,"_31184":75489,"_21603":129331,"_5":14870,"_28376":128736,"_3083":129332},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3632":75724,"_31184":75489,"_21603":129334,"_5":14870,"_28376":128736,"_3083":129335},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3632":75725,"_31184":75489,"_21603":129337,"_5":14870,"_28376":128736,"_3083":129338},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3632":75726,"_31184":75489,"_21603":129340,"_5":14870,"_28376":128736,"_3083":129341},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3632":75727,"_31184":75489,"_21603":129343,"_5":14870,"_28376":128740,"_3083":129344},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3632":75728,"_31184":75489,"_21603":129346,"_5":14870,"_28376":128744,"_3083":129347},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3632":75729,"_31184":75489,"_21603":129349,"_5":14870,"_28376":128744,"_3083":129350},[],"Ruta",{"_3632":75730,"_31184":75489,"_21603":129352,"_5":14870,"_28376":128744,"_3083":121644},[],{"_3632":75731,"_31184":75489,"_21603":129354,"_5":14870,"_28376":128744,"_3083":60143},[],{"_3632":75732,"_31184":75489,"_21603":129356,"_5":14870,"_28376":128744,"_3083":129357},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3632":75733,"_31184":75489,"_21603":129359,"_5":14870,"_28376":128744,"_3083":60149},[],{"_3632":75734,"_31184":75489,"_21603":129361,"_5":14870,"_28376":128744,"_3083":129362},[],"Lee los ajustes de una CA.",{"_3632":75735,"_31184":75489,"_21603":129364,"_5":14870,"_28376":128744,"_3083":60155},[],{"_3632":75736,"_31184":75489,"_21603":129366,"_5":14870,"_28376":128744,"_3083":129367},[],"Sustituye los `crl_options`.",{"_3632":75737,"_31184":75489,"_21603":129369,"_5":14870,"_28376":128744,"_3083":60161},[],{"_3632":75738,"_31184":75489,"_21603":129371,"_5":14870,"_28376":128744,"_3083":129372},[],"Elimina los ajustes archivados de una CA.",{"_3632":75739,"_31184":75489,"_21603":129374,"_5":14870,"_28376":128744,"_3083":129375},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3632":75740,"_31184":75489,"_21603":129377,"_5":14870,"_28376":128744,"_3083":129378},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3632":75741,"_31184":75489,"_21603":129380,"_5":14870,"_28376":128744,"_3083":129381},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3632":75742,"_31184":75489,"_21603":129383,"_5":14870,"_28376":128744,"_3083":129384},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3632":75743,"_31184":75489,"_21603":129386,"_5":14870,"_28376":128744,"_3083":129387},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3632":75744,"_31184":75489,"_21603":129389,"_5":14870,"_28376":128744,"_3083":129390},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3632":75745,"_31184":75489,"_21603":129392,"_5":14870,"_28376":128744,"_3083":129393},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3632":75746,"_31184":75489,"_21603":129395,"_5":14870,"_28376":128744,"_3083":129396},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3632":75747,"_31184":75489,"_21603":129398,"_5":14870,"_28376":128744,"_3083":129399},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3632":75748,"_31184":75489,"_21603":129401,"_5":14870,"_28376":128744,"_3083":129402},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3632":75749,"_31184":75489,"_21603":129404,"_5":14870,"_28376":128744,"_3083":129405},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3632":75750,"_31184":75489,"_21603":129407,"_5":14870,"_28376":128748,"_3083":129408},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3632":75751,"_31184":75489,"_21603":129410,"_5":14870,"_28376":128752,"_3083":129411},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3632":75752,"_31184":75489,"_21603":129413,"_5":14870,"_28376":128756,"_3083":129414},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3632":75753,"_31184":75489,"_21603":129416,"_5":14870,"_28376":128760,"_3083":129417},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3632":75754,"_31184":75489,"_21603":129419,"_5":14870,"_28376":128760,"_3083":129420},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3632":75755,"_31184":75489,"_21603":129422,"_5":14870,"_28376":128764,"_3083":129423},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3632":75756,"_31184":75489,"_21603":129425,"_5":14870,"_28376":128768,"_3083":129426},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3632":75757,"_31184":75489,"_21603":129428,"_5":14870,"_28376":128772,"_3083":129429},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3632":75758,"_31184":75489,"_21603":129431,"_5":14870,"_28376":128772,"_3083":129432},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3632":75759,"_31184":75489,"_21603":129434,"_5":14870,"_28376":128772,"_3083":129435},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3632":75760,"_31184":75489,"_21603":129437,"_5":14870,"_28376":128772,"_3083":129438},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3632":75761,"_31184":75489,"_21603":129440,"_5":14870,"_28376":128772,"_3083":129441},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3632":75762,"_31184":75489,"_21603":129443,"_5":14870,"_28376":128772,"_3083":129444},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3632":75763,"_31184":75489,"_21603":129446,"_5":14870,"_28376":128776,"_3083":129447},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3632":75764,"_31184":75489,"_21603":129449,"_5":14870,"_28376":128776,"_3083":129450},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3632":75765,"_31184":75489,"_21603":129452,"_5":14870,"_28376":128776,"_3083":129453},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3632":75766,"_31184":75489,"_21603":129455,"_5":14870,"_28376":128776,"_3083":129456},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3632":75767,"_31184":75489,"_21603":129458,"_5":14870,"_28376":128776,"_3083":129459},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3632":75768,"_31184":75489,"_21603":129461,"_5":14870,"_28376":128780,"_3083":129462},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3632":75769,"_31184":75489,"_21603":129464,"_5":14870,"_28376":128780,"_3083":129465},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3632":75770,"_31184":75489,"_21603":129467,"_5":14870,"_28376":128780,"_3083":129468},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3632":75771,"_31184":75489,"_21603":129470,"_5":14870,"_28376":128780,"_3083":60263},[],{"_3632":75772,"_31184":75489,"_21603":129472,"_5":14870,"_28376":128780,"_3083":129473},[],"Claves de datos obligatorias",{"_3632":75773,"_31184":75489,"_21603":129475,"_5":14870,"_28376":128780,"_3083":129476},[],"Cuándo",{"_3632":75774,"_31184":75489,"_21603":129478,"_5":14870,"_28376":128780,"_3083":129479},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3632":75775,"_31184":75489,"_21603":129481,"_5":14870,"_28376":128780,"_3083":60275},[],{"_3632":75776,"_31184":75489,"_21603":129483,"_5":14870,"_28376":128780,"_3083":129484},[],"Siempre",{"_3632":75777,"_31184":75489,"_21603":129486,"_5":14870,"_28376":128780,"_3083":129487},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3632":75778,"_31184":75489,"_21603":129489,"_5":14870,"_28376":128780,"_3083":60275},[],{"_3632":75779,"_31184":75489,"_21603":129491,"_5":14870,"_28376":128780,"_3083":129484},[],{"_3632":75780,"_31184":75489,"_21603":129493,"_5":14870,"_28376":128780,"_3083":60288},[],{"_3632":75781,"_31184":75489,"_21603":129495,"_5":14870,"_28376":128780,"_3083":60275},[],{"_3632":75782,"_31184":75489,"_21603":129497,"_5":14870,"_28376":128780,"_3083":129498},[],"Solo cuando hay autenticación SMTP",{"_3632":75783,"_31184":75489,"_21603":129500,"_5":14870,"_28376":128780,"_3083":129501},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3632":75784,"_31184":75489,"_21603":129503,"_5":14870,"_28376":128780,"_3083":129504},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3632":75785,"_31184":75489,"_21603":129506,"_5":14870,"_28376":128780,"_3083":129507},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3632":75786,"_31184":75489,"_21603":129509,"_5":14870,"_28376":128780,"_3083":129510},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3632":75787,"_31184":75489,"_21603":129512,"_5":14870,"_28376":128780,"_3083":129513},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3632":75788,"_31184":75489,"_21603":129515,"_5":14870,"_28376":128780,"_3083":129516},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3632":75789,"_31184":75489,"_21603":129518,"_5":14870,"_28376":128780,"_3083":129519},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3632":75790,"_31184":75489,"_21603":129521,"_5":14870,"_28376":128780,"_3083":129522},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3632":75791,"_31184":75489,"_21603":129524,"_5":14870,"_28376":128780,"_3083":129525},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3632":75792,"_31184":75489,"_21603":129527,"_5":14870,"_28376":128780,"_3083":129528},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3632":75793,"_31184":75489,"_21603":129530,"_5":14870,"_28376":128780,"_3083":129531},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3632":75794,"_31184":75489,"_21603":129533,"_5":14870,"_28376":128780,"_3083":129534},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3632":75795,"_31184":75489,"_21603":129536,"_5":14870,"_28376":128780,"_3083":129537},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3632":75796,"_31184":75489,"_21603":129539,"_5":14870,"_28376":128780,"_3083":129540},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3632":75797,"_31184":75489,"_21603":129542,"_5":14870,"_28376":128780,"_3083":129543},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3632":75798,"_31184":75489,"_21603":129545,"_5":14870,"_28376":128784,"_3083":129546},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3632":75799,"_31184":75489,"_21603":129548,"_5":14870,"_28376":128784,"_3083":129549},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3632":75800,"_31184":75489,"_21603":129551,"_5":14870,"_28376":128788,"_3083":129552},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3632":75801,"_31184":75489,"_21603":129554,"_5":14870,"_28376":128788,"_3083":129555},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3632":75802,"_31184":75489,"_21603":129557,"_5":14870,"_28376":128788,"_3083":129558},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3632":75803,"_31184":75489,"_21603":129560,"_5":14870,"_28376":128788,"_3083":129561},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3632":75804,"_31184":75489,"_21603":129563,"_5":14870,"_28376":128788,"_3083":129564},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3632":75805,"_31184":75489,"_21603":129566,"_5":14870,"_28376":128788,"_3083":129567},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3632":75806,"_31184":75489,"_21603":129569,"_5":14870,"_28376":128788,"_3083":129570},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3632":75807,"_31184":75489,"_21603":129572,"_5":14870,"_28376":128788,"_3083":129573},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3632":75808,"_31184":75489,"_21603":129575,"_5":14870,"_28376":128788,"_3083":129576},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3632":75809,"_31184":75489,"_21603":129578,"_5":14870,"_28376":128788,"_3083":129579},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3632":75810,"_31184":75489,"_21603":129581,"_5":14870,"_28376":128788,"_3083":129582},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3632":75811,"_31184":75489,"_21603":129584,"_5":14870,"_28376":128792,"_3083":129585},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3632":75812,"_31184":75489,"_21603":129587,"_5":14870,"_28376":128792,"_3083":129588},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3632":75813,"_31184":75489,"_21603":129590,"_5":14870,"_28376":128796,"_3083":129591},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3632":75814,"_31184":75489,"_21603":129593,"_5":14870,"_28376":128796,"_3083":129594},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3632":75815,"_31184":75489,"_21603":129596,"_5":14870,"_28376":128796,"_3083":129597},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3632":75816,"_31184":75489,"_21603":129599,"_5":14870,"_28376":128796,"_3083":129600},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3632":75817,"_31184":75489,"_21603":129602,"_5":14870,"_28376":128796,"_3083":129603},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3632":75818,"_31184":75489,"_21603":129605,"_5":14870,"_28376":128796,"_3083":129606},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3632":75819,"_31184":75489,"_21603":129608,"_5":14870,"_28376":128796,"_3083":129609},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3632":75820,"_31184":75489,"_21603":129611,"_5":14870,"_28376":128796,"_3083":129612},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3632":75821,"_31184":75489,"_21603":129614,"_5":14870,"_28376":128800,"_3083":129615},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3632":75822,"_31184":75489,"_21603":129617,"_5":14870,"_28376":128800,"_3083":129618},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3632":75823,"_31184":75489,"_21603":129620,"_5":14870,"_28376":128800,"_3083":129621},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3632":75824,"_31184":75489,"_21603":129623,"_5":14870,"_28376":128800,"_3083":129624},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3632":75825,"_31184":75489,"_21603":129626,"_5":14870,"_28376":128800,"_3083":129627},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3632":75826,"_31184":75489,"_21603":129629,"_5":14870,"_28376":128800,"_3083":129630},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3632":75827,"_31184":75489,"_21603":129632,"_5":14870,"_28376":128800,"_3083":129633},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3632":75828,"_31184":75489,"_21603":129635,"_5":14870,"_28376":128800,"_3083":129636},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3632":75829,"_31184":75489,"_21603":129638,"_5":14870,"_28376":128800,"_3083":129639},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3632":75830,"_31184":75489,"_21603":129641,"_5":14870,"_28376":128800,"_3083":129642},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3632":75831,"_31184":75489,"_21603":129644,"_5":14870,"_28376":128800,"_3083":129645},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3632":75832,"_31184":75489,"_21603":129647,"_5":14870,"_28376":128803,"_3083":129648},[],"Tras la actualización, comprueba en este orden:",{"_3632":75833,"_31184":75489,"_21603":129650,"_5":14870,"_28376":128803,"_3083":129651},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3632":75834,"_31184":75489,"_21603":129653,"_5":14870,"_28376":128803,"_3083":129654},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3632":75835,"_31184":75489,"_21603":129656,"_5":14870,"_28376":128803,"_3083":129657},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3632":75836,"_31184":75489,"_21603":129659,"_5":14870,"_28376":128803,"_3083":129660},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3632":75837,"_31184":75489,"_21603":129662,"_5":14870,"_28376":128803,"_3083":129663},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3632":75838,"_31184":75489,"_21603":129665,"_5":14870,"_28376":128803,"_3083":129666},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3632":75839,"_31184":75489,"_21603":129668,"_5":14870,"_28376":128803,"_3083":129669},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3632":75840,"_31184":75489,"_21603":129671,"_5":14870,"_28376":128803,"_3083":129672},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3632":75841,"_31184":75489,"_21603":129674,"_5":14870,"_28376":128803,"_3083":129675},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3632":75842,"_31184":75489,"_21603":129677,"_5":14870,"_28376":128803,"_3083":129678},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3632":75843,"_31184":75489,"_21603":129680,"_5":14870,"_28376":128803,"_3083":129681},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3632":75844,"_31184":75489,"_21603":129683,"_5":14870,"_28376":128803,"_3083":129684},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3632":75845,"_31184":75489,"_21603":129686,"_5":14870,"_28376":128803,"_3083":129687},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3632":75846,"_31184":75489,"_21603":129689,"_5":14870,"_28376":128803,"_3083":129690},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3632":75847,"_31184":75489,"_21603":129692,"_5":14870,"_28376":128803,"_3083":129693},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3632":75848,"_31184":75489,"_21603":129695,"_5":14870,"_28376":128807,"_3083":129696},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3632":75849,"_31184":75489,"_21603":129698,"_5":14870,"_28376":128807,"_3083":129699},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3632":75850,"_31184":75489,"_21603":129701,"_5":14870,"_28376":128807,"_3083":129702},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":75851,"_31184":75489,"_21603":129704,"_5":14870,"_28376":128807,"_3083":129705},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3632":75852,"_31184":75489,"_21603":129707,"_5":14870,"_28376":128807,"_3083":129708},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60506":129710,"_60508":129711,"_60510":129712,"_60512":129713,"_18740":3118,"_72783":3118},"spanish",[3083,31184,5,28376],{"_3083":25790,"_31184":25790,"_5":25790,"_28376":25790},{"_3083":129714,"_31184":132780,"_5":135846,"_28376":138912},{"_4836":129715,"_60516":129716,"_5":25790},{"_14951":12770,"_15330":13059,"_15349":3926,"_30184":6078,"_15336":4222,"_20515":6204,"_14972":3501,"_14979":20820,"_30126":17387,"_30534":13854,"_30561":7289,"_30160":4579,"_35567":5165,"_30263":19691,"_30605":10222,"_35574":5592,"_35577":3554,"_35580":3532,"_35583":3377,"_31007":3158,"_35588":7667,"