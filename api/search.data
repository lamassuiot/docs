7,"_29561":68382,"_5":29890,"_20535":113388,"_26896":113389,"_2860":113390},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3374":68388,"_29561":68382,"_5":29890,"_20535":113392,"_26896":113393,"_2860":113394},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3374":68389,"_29561":68382,"_5":29890,"_20535":113396,"_26896":113397,"_2860":113398},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3374":68390,"_29561":68382,"_5":29890,"_20535":113400,"_26896":113401,"_2860":113402},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3374":68391,"_29561":68382,"_20535":113404,"_5":14089,"_26896":68382,"_2860":113405},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3374":68392,"_29561":68382,"_20535":113407,"_5":14089,"_26896":113377,"_2860":113408},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3374":68393,"_29561":68382,"_20535":113410,"_5":14089,"_26896":113377,"_2860":113411},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3374":68394,"_29561":68382,"_20535":113413,"_5":14089,"_26896":113377,"_2860":113414},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3374":68395,"_29561":68382,"_20535":113416,"_5":14089,"_26896":113381,"_2860":113417},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3374":68396,"_29561":68382,"_20535":113419,"_5":14089,"_26896":113381,"_2860":113420},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3374":68397,"_29561":68382,"_20535":113422,"_5":14089,"_26896":113381,"_2860":113423},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3374":68398,"_29561":68382,"_20535":113425,"_5":14089,"_26896":113385,"_2860":113426},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3374":68399,"_29561":68382,"_20535":113428,"_5":14089,"_26896":113389,"_2860":113429},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3374":68400,"_29561":68382,"_20535":113431,"_5":14089,"_26896":113393,"_2860":113432},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3374":68401,"_29561":68382,"_20535":113434,"_5":14089,"_26896":113397,"_2860":113435},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3374":68402,"_29561":68382,"_20535":113437,"_5":14089,"_26896":113401,"_2860":113438},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3374":68403,"_29561":68403,"_5":14447,"_2860":113440,"_29893":113441,"_20535":113442,"_26896":68403},"Despliega Lamassu",[48107,113369],[],{"_3374":68404,"_29561":68403,"_20535":113444,"_5":14089,"_26896":68403,"_2860":113445},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3374":68405,"_29561":68403,"_5":29890,"_20535":113447,"_26896":113448,"_2860":113449},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3374":68406,"_29561":68403,"_5":29890,"_20535":113451,"_26896":113452,"_2860":113453},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3374":68407,"_29561":68403,"_5":29890,"_20535":113455,"_26896":113456,"_2860":113457},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3374":68408,"_29561":68403,"_20535":113459,"_5":14089,"_26896":68403,"_2860":113460},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3374":68409,"_29561":68403,"_20535":113462,"_5":14089,"_26896":113448,"_2860":113463},[],"Modelo",{"_3374":68410,"_29561":68403,"_20535":113465,"_5":14089,"_26896":113448,"_2860":113466},[],"Recomendado para",{"_3374":68411,"_29561":68403,"_20535":113468,"_5":14089,"_26896":113448,"_2860":113469},[],"Quién opera la infraestructura",{"_3374":68412,"_29561":68403,"_20535":113471,"_5":14089,"_26896":113448,"_2860":113472},[],"Punto de partida",{"_3374":68413,"_29561":68403,"_20535":113474,"_5":14089,"_26896":113448,"_2860":48214},[],{"_3374":68414,"_29561":68403,"_20535":113476,"_5":14089,"_26896":113448,"_2860":113477},[],"Producción, entornos regulados y despliegues personalizados",{"_3374":68415,"_29561":68403,"_20535":113479,"_5":14089,"_26896":113448,"_2860":113480},[],"Tu equipo",{"_3374":68416,"_29561":68403,"_20535":113482,"_5":14089,"_26896":113448,"_2860":113483},[],"Helm o Fastlane",{"_3374":68417,"_29561":68403,"_20535":113485,"_5":14089,"_26896":113448,"_2860":48226},[],{"_3374":68418,"_29561":68403,"_20535":113487,"_5":14089,"_26896":113448,"_2860":113488},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3374":68419,"_29561":68403,"_20535":113490,"_5":14089,"_26896":113448,"_2860":113480},[],{"_3374":68420,"_29561":68403,"_20535":113492,"_5":14089,"_26896":113448,"_2860":113493},[],"Imagen preconfigurada en EC2",{"_3374":68421,"_29561":68403,"_20535":113495,"_5":14089,"_26896":113448,"_2860":48237},[],{"_3374":68422,"_29561":68403,"_20535":113497,"_5":14089,"_26896":113448,"_2860":113498},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3374":68423,"_29561":68403,"_20535":113500,"_5":14089,"_26896":113448,"_2860":48243},[],{"_3374":68424,"_29561":68403,"_20535":113502,"_5":14089,"_26896":113448,"_2860":113503},[],"Suscripción gestionada",{"_3374":68425,"_29561":68403,"_20535":113505,"_5":14089,"_26896":113448,"_2860":113506},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3374":68426,"_29561":68403,"_20535":113508,"_5":14089,"_26896":113448,"_2860":113509},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3374":68427,"_29561":68403,"_20535":113511,"_5":14089,"_26896":113448,"_2860":113512},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3374":68428,"_29561":68403,"_20535":113514,"_5":14089,"_26896":113452,"_2860":113515},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3374":68429,"_29561":68403,"_20535":113517,"_5":14089,"_26896":113456,"_2860":113518},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3374":68430,"_29561":68430,"_5":14447,"_2860":113520,"_29893":113521,"_20535":113522,"_26896":68430},"Utiliza Lamassu como SaaS",[48107,113369,113370],[],{"_3374":68431,"_29561":68430,"_20535":113524,"_5":14089,"_26896":68430,"_2860":113525},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3374":68432,"_29561":68430,"_5":29890,"_20535":113527,"_26896":113528,"_2860":113529},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3374":68433,"_29561":68430,"_5":29890,"_20535":113531,"_26896":113532,"_2860":113533},[],"/docs/es/deployment/saas#planes","Planes",{"_3374":68434,"_29561":68430,"_5":29890,"_20535":113535,"_26896":113536,"_2860":113537},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3374":68435,"_29561":68430,"_20535":113539,"_5":14089,"_26896":68430,"_2860":113540},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3374":68436,"_29561":68430,"_20535":113542,"_5":14089,"_26896":113528,"_2860":113543},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3374":68437,"_29561":68430,"_20535":113545,"_5":14089,"_26896":113528,"_2860":113546},[],"Copias de seguridad automáticas.",{"_3374":68438,"_29561":68430,"_20535":113548,"_5":14089,"_26896":113528,"_2860":113549},[],"Actualizaciones de versión.",{"_3374":68439,"_29561":68430,"_20535":113551,"_5":14089,"_26896":113528,"_2860":113552},[],"Soporte técnico y SLA según el plan contratado.",{"_3374":68440,"_29561":68430,"_20535":113554,"_5":14089,"_26896":113532,"_2860":48298},[],{"_3374":68441,"_29561":68430,"_20535":113556,"_5":14089,"_26896":113532,"_2860":113557},[],"Dispositivos",{"_3374":68442,"_29561":68430,"_20535":113559,"_5":14089,"_26896":113532,"_2860":113560},[],"Soporte",{"_3374":68443,"_29561":68430,"_20535":113562,"_5":14089,"_26896":113532,"_2860":48307},[],{"_3374":68444,"_29561":68430,"_20535":113564,"_5":14089,"_26896":113532,"_2860":48310},[],{"_3374":68445,"_29561":68430,"_20535":113566,"_5":14089,"_26896":113532,"_2860":113567},[],"Hasta 1.000",{"_3374":68446,"_29561":68430,"_20535":113569,"_5":14089,"_26896":113532,"_2860":48316},[],{"_3374":68447,"_29561":68430,"_20535":113571,"_5":14089,"_26896":113532,"_2860":113572},[],"99,5 %",{"_3374":68448,"_29561":68430,"_20535":113574,"_5":14089,"_26896":113532,"_2860":48322},[],{"_3374":68449,"_29561":68430,"_20535":113576,"_5":14089,"_26896":113532,"_2860":113577},[],"Hasta 10.000",{"_3374":68450,"_29561":68430,"_20535":113579,"_5":14089,"_26896":113532,"_2860":113580},[],"Email y chat",{"_3374":68451,"_29561":68430,"_20535":113582,"_5":14089,"_26896":113532,"_2860":113583},[],"99,9 %",{"_3374":68452,"_29561":68430,"_20535":113585,"_5":14089,"_26896":113532,"_2860":48334},[],{"_3374":68453,"_29561":68430,"_20535":113587,"_5":14089,"_26896":113532,"_2860":113588},[],"Ilimitados",{"_3374":68454,"_29561":68430,"_20535":113590,"_5":14089,"_26896":113532,"_2860":113591},[],"Dedicado",{"_3374":68455,"_29561":68430,"_20535":113593,"_5":14089,"_26896":113532,"_2860":113594},[],"99,99 %",{"_3374":68456,"_29561":68430,"_20535":113596,"_5":14089,"_26896":113536,"_2860":113597},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3374":68457,"_29561":68430,"_20535":113599,"_5":14089,"_26896":113536,"_2860":113600},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3374":68458,"_29561":68458,"_5":14447,"_2860":48351,"_29893":113602,"_20535":113604,"_26896":68458},[48107,113369,113603],"Kubernetes autogestionado",[],{"_3374":68459,"_29561":68458,"_20535":113606,"_5":14089,"_26896":68458,"_2860":113607},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3374":68460,"_29561":68458,"_5":29890,"_20535":113609,"_26896":113610,"_2860":113611},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3374":68461,"_29561":68458,"_5":29890,"_20535":113613,"_26896":113614,"_2860":113615},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3374":68462,"_29561":68458,"_5":29890,"_20535":113617,"_26896":113618,"_2860":113619},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3374":68463,"_29561":68458,"_5":29890,"_20535":113621,"_26896":113622,"_2860":113623},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3374":68464,"_29561":68458,"_5":29890,"_20535":113625,"_26896":113626,"_2860":113627},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3374":68465,"_29561":68458,"_5":29890,"_20535":113629,"_26896":113630,"_2860":113631},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3374":68466,"_29561":68458,"_5":29890,"_20535":113633,"_26896":113634,"_2860":113635},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3374":68467,"_29561":68458,"_5":29890,"_20535":113637,"_26896":113638,"_2860":113639},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3374":68468,"_29561":68458,"_5":29890,"_20535":113641,"_26896":113642,"_2860":113643},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3374":68469,"_29561":68458,"_5":29890,"_20535":113645,"_26896":113646,"_2860":113647},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3374":68470,"_29561":68458,"_5":29890,"_20535":113649,"_26896":113650,"_2860":113651},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3374":68471,"_29561":68458,"_20535":113653,"_5":14089,"_26896":113610,"_2860":113654},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3374":68472,"_29561":68458,"_20535":113656,"_5":14089,"_26896":113610,"_2860":113657},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3374":68473,"_29561":68458,"_20535":113659,"_5":14089,"_26896":113614,"_2860":113660},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3374":68474,"_29561":68458,"_20535":113662,"_5":14089,"_26896":113614,"_2860":113663},[],"Fastlane instala o configura",{"_3374":68475,"_29561":68458,"_20535":113665,"_5":14089,"_26896":113614,"_2860":113666},[],"Tú sigues proporcionando",{"_3374":68476,"_29561":68458,"_20535":113668,"_5":14089,"_26896":113614,"_2860":113669},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3374":68477,"_29561":68458,"_20535":113671,"_5":14089,"_26896":113614,"_2860":113672},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3374":68478,"_29561":68458,"_20535":113674,"_5":14089,"_26896":113614,"_2860":113675},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3374":68479,"_29561":68458,"_20535":113677,"_5":14089,"_26896":113614,"_2860":113678},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3374":68480,"_29561":68458,"_20535":113680,"_5":14089,"_26896":113614,"_2860":113681},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3374":68481,"_29561":68458,"_20535":113683,"_5":14089,"_26896":113614,"_2860":113684},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3374":68482,"_29561":68458,"_20535":113686,"_5":14089,"_26896":113614,"_2860":113687},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3374":68483,"_29561":68458,"_20535":113689,"_5":14089,"_26896":113614,"_2860":113690},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3374":68484,"_29561":68458,"_20535":113692,"_5":14089,"_26896":113614,"_2860":113693},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3374":68485,"_29561":68458,"_20535":113695,"_5":14089,"_26896":113618,"_2860":113696},[],"Necesitas:",{"_3374":68486,"_29561":68458,"_20535":113698,"_5":14089,"_26896":113618,"_2860":113699},[],"un clúster Kubernetes existente",{"_3374":68487,"_29561":68458,"_20535":113701,"_5":14089,"_26896":113618,"_2860":113702},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3374":68488,"_29561":68458,"_20535":113704,"_5":14089,"_26896":113618,"_2860":48453},[],{"_3374":68489,"_29561":68458,"_20535":113706,"_5":14089,"_26896":113618,"_2860":23216},[],{"_3374":68490,"_29561":68458,"_20535":113708,"_5":14089,"_26896":113618,"_2860":113709},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3374":68491,"_29561":68458,"_20535":113711,"_5":14089,"_26896":113618,"_2860":113712},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3374":68492,"_29561":68458,"_20535":113714,"_5":14089,"_26896":113618,"_2860":113715},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3374":68493,"_29561":68458,"_20535":113717,"_5":14089,"_26896":113618,"_2860":113718},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3374":68494,"_29561":68458,"_20535":113720,"_5":14089,"_26896":113618,"_2860":113721},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3374":68495,"_29561":68458,"_20535":113723,"_5":14089,"_26896":113622,"_2860":113724},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3374":68496,"_29561":68458,"_20535":113726,"_5":14089,"_26896":113622,"_2860":113727},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3374":68497,"_29561":68458,"_20535":113729,"_5":14089,"_26896":113626,"_2860":113730},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3374":68498,"_29561":68458,"_20535":113732,"_5":14089,"_26896":113626,"_2860":113733},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3374":68499,"_29561":68458,"_20535":113735,"_5":14089,"_26896":113626,"_2860":113736},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3374":68500,"_29561":68458,"_20535":113738,"_5":14089,"_26896":113626,"_2860":113739},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3374":68501,"_29561":68458,"_20535":113741,"_5":14089,"_26896":113630,"_2860":113742},[],"Opción",{"_3374":68502,"_29561":68458,"_20535":113744,"_5":14089,"_26896":113630,"_2860":113745},[],"Valor predeterminado",{"_3374":68503,"_29561":68458,"_20535":113747,"_5":14089,"_26896":113630,"_2860":113748},[],"Propósito",{"_3374":68504,"_29561":68458,"_20535":113750,"_5":14089,"_26896":113630,"_2860":48500},[],{"_3374":68505,"_29561":68458,"_20535":113752,"_5":14089,"_26896":113630,"_2860":48503},[],{"_3374":68506,"_29561":68458,"_20535":113754,"_5":14089,"_26896":113630,"_2860":113755},[],"Muestra la ayuda",{"_3374":68507,"_29561":68458,"_20535":113757,"_5":14089,"_26896":113630,"_2860":48509},[],{"_3374":68508,"_29561":68458,"_20535":113759,"_5":14089,"_26896":113630,"_2860":113760},[],"contexto actual",{"_3374":68509,"_29561":68458,"_20535":113762,"_5":14089,"_26896":113630,"_2860":113763},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3374":68510,"_29561":68458,"_20535":113765,"_5":14089,"_26896":113630,"_2860":48518},[],{"_3374":68511,"_29561":68458,"_20535":113767,"_5":14089,"_26896":113630,"_2860":6383},[],{"_3374":68512,"_29561":68458,"_20535":113769,"_5":14089,"_26896":113630,"_2860":113770},[],"Omite prompts y genera credenciales para las dependencias",{"_3374":68513,"_29561":68458,"_20535":113772,"_5":14089,"_26896":113630,"_2860":48526},[],{"_3374":68514,"_29561":68458,"_20535":113774,"_5":14089,"_26896":113630,"_2860":48529},[],{"_3374":68515,"_29561":68458,"_20535":113776,"_5":14089,"_26896":113630,"_2860":113777},[],"Namespace de la instalación",{"_3374":68516,"_29561":68458,"_20535":113779,"_5":14089,"_26896":113630,"_2860":48535},[],{"_3374":68517,"_29561":68458,"_20535":113781,"_5":14089,"_26896":113630,"_2860":48538},[],{"_3374":68518,"_29561":68458,"_20535":113783,"_5":14089,"_26896":113630,"_2860":113784},[],"Dominio usado por la UI, OIDC y el certificado",{"_3374":68519,"_29561":68458,"_20535":113786,"_5":14089,"_26896":113630,"_2860":48544},[],{"_3374":68520,"_29561":68458,"_20535":113788,"_5":14089,"_26896":113630,"_2860":14776},[],{"_3374":68521,"_29561":68458,"_20535":113790,"_5":14089,"_26896":113630,"_2860":113791},[],"Versión del chart de Lamassu",{"_3374":68522,"_29561":68458,"_20535":113793,"_5":14089,"_26896":113630,"_2860":48552},[],{"_3374":68523,"_29561":68458,"_20535":113795,"_5":14089,"_26896":113630,"_2860":48555},[],{"_3374":68524,"_29561":68458,"_20535":113797,"_5":14089,"_26896":113630,"_2860":113798},[],"Puerto del listener HTTPS",{"_3374":68525,"_29561":68458,"_20535":113800,"_5":14089,"_26896":113630,"_2860":48561},[],{"_3374":68526,"_29561":68458,"_20535":113802,"_5":14089,"_26896":113630,"_2860":48564},[],{"_3374":68527,"_29561":68458,"_20535":113804,"_5":14089,"_26896":113630,"_2860":113805},[],"Puerto del listener HTTP",{"_3374":68528,"_29561":68458,"_20535":113807,"_5":14089,"_26896":113630,"_2860":48570},[],{"_3374":68529,"_29561":68458,"_20535":113809,"_5":14089,"_26896":113630,"_2860":48503},[],{"_3374":68530,"_29561":68458,"_20535":113811,"_5":14089,"_26896":113630,"_2860":113812},[],"Certificado PEM para TLS downstream",{"_3374":68531,"_29561":68458,"_20535":113814,"_5":14089,"_26896":113630,"_2860":48578},[],{"_3374":68532,"_29561":68458,"_20535":113816,"_5":14089,"_26896":113630,"_2860":48503},[],{"_3374":68533,"_29561":68458,"_20535":113818,"_5":14089,"_26896":113630,"_2860":113819},[],"Clave privada PEM para TLS downstream",{"_3374":68534,"_29561":68458,"_20535":113821,"_5":14089,"_26896":113630,"_2860":48586},[],{"_3374":68535,"_29561":68458,"_20535":113823,"_5":14089,"_26896":113630,"_2860":113824},[],"chart del repositorio",{"_3374":68536,"_29561":68458,"_20535":113826,"_5":14089,"_26896":113630,"_2860":113827},[],"Usa un chart local de Lamassu sin empaquetar",{"_3374":68537,"_29561":68458,"_20535":113829,"_5":14089,"_26896":113630,"_2860":48595},[],{"_3374":68538,"_29561":68458,"_20535":113831,"_5":14089,"_26896":113630,"_2860":113832},[],"detección automática",{"_3374":68539,"_29561":68458,"_20535":113834,"_5":14089,"_26896":113630,"_2860":113835},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3374":68540,"_29561":68458,"_20535":113837,"_5":14089,"_26896":113630,"_2860":48603},[],{"_3374":68541,"_29561":68458,"_20535":113839,"_5":14089,"_26896":113630,"_2860":6383},[],{"_3374":68542,"_29561":68458,"_20535":113841,"_5":14089,"_26896":113630,"_2860":113842},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3374":68543,"_29561":68458,"_20535":113844,"_5":14089,"_26896":113630,"_2860":48611},[],{"_3374":68544,"_29561":68458,"_20535":113846,"_5":14089,"_26896":113630,"_2860":6383},[],{"_3374":68545,"_29561":68458,"_20535":113848,"_5":14089,"_26896":113630,"_2860":113849},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3374":68546,"_29561":68458,"_20535":113851,"_5":14089,"_26896":113630,"_2860":48619},[],{"_3374":68547,"_29561":68458,"_20535":113853,"_5":14089,"_26896":113630,"_2860":6383},[],{"_3374":68548,"_29561":68458,"_20535":113855,"_5":14089,"_26896":113630,"_2860":113856},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3374":68549,"_29561":68458,"_20535":113858,"_5":14089,"_26896":113630,"_2860":48627},[],{"_3374":68550,"_29561":68458,"_20535":113860,"_5":14089,"_26896":113630,"_2860":6383},[],{"_3374":68551,"_29561":68458,"_20535":113862,"_5":14089,"_26896":113630,"_2860":113863},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3374":68552,"_29561":68458,"_20535":113865,"_5":14089,"_26896":113630,"_2860":48635},[],{"_3374":68553,"_29561":68458,"_20535":113867,"_5":14089,"_26896":113630,"_2860":48638},[],{"_3374":68554,"_29561":68458,"_20535":113869,"_5":14089,"_26896":113630,"_2860":113870},[],"Usa otro chart local de SoftHSM",{"_3374":68555,"_29561":68458,"_20535":113872,"_5":14089,"_26896":113630,"_2860":113873},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3374":68556,"_29561":68458,"_20535":113875,"_5":14089,"_26896":113634,"_2860":113876},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3374":68557,"_29561":68458,"_20535":113878,"_5":14089,"_26896":113634,"_2860":113879},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3374":68558,"_29561":68458,"_20535":113881,"_5":14089,"_26896":113634,"_2860":113882},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3374":68559,"_29561":68458,"_20535":113884,"_5":14089,"_26896":113634,"_2860":113885},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3374":68560,"_29561":68458,"_20535":113887,"_5":14089,"_26896":113634,"_2860":113888},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3374":68561,"_29561":68458,"_20535":113890,"_5":14089,"_26896":113634,"_2860":113891},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3374":68562,"_29561":68458,"_20535":113893,"_5":14089,"_26896":113638,"_2860":48665},[],{"_3374":68563,"_29561":68458,"_20535":113895,"_5":14089,"_26896":113638,"_2860":113896},[],"valida las herramientas locales y el clúster seleccionado",{"_3374":68564,"_29561":68458,"_20535":113898,"_5":14089,"_26896":113638,"_2860":113899},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3374":68565,"_29561":68458,"_20535":113901,"_5":14089,"_26896":113638,"_2860":113902},[],"crea el namespace",{"_3374":68566,"_29561":68458,"_20535":113904,"_5":14089,"_26896":113638,"_2860":113905},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3374":68567,"_29561":68458,"_20535":113907,"_5":14089,"_26896":113638,"_2860":113908},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3374":68568,"_29561":68458,"_20535":113910,"_5":14089,"_26896":113638,"_2860":113911},[],"instala RabbitMQ",{"_3374":68569,"_29561":68458,"_20535":113913,"_5":14089,"_26896":113638,"_2860":113914},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3374":68570,"_29561":68458,"_20535":113916,"_5":14089,"_26896":113638,"_2860":113917},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3374":68571,"_29561":68458,"_20535":113919,"_5":14089,"_26896":113638,"_2860":113920},[],"carga datos de ejemplo opcionalmente",{"_3374":68572,"_29561":68458,"_20535":113922,"_5":14089,"_26896":113638,"_2860":113923},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3374":68573,"_29561":68458,"_20535":113925,"_5":14089,"_26896":113642,"_2860":113926},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3374":68574,"_29561":68458,"_20535":113928,"_5":14089,"_26896":113642,"_2860":113929},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3374":68575,"_29561":68458,"_20535":113931,"_5":14089,"_26896":113646,"_2860":113932},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3374":68576,"_29561":68458,"_20535":113934,"_5":14089,"_26896":113646,"_2860":113935},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3374":68577,"_29561":68458,"_20535":113937,"_5":14089,"_26896":113646,"_2860":113938},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3374":68578,"_29561":68458,"_20535":113940,"_5":14089,"_26896":113650,"_2860":113941},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3374":68579,"_29561":68579,"_5":14447,"_2860":113943,"_29893":113944,"_20535":113945,"_26896":68579},"Instala con Helm",[48107,113369,113603],[],{"_3374":68580,"_29561":68579,"_20535":113947,"_5":14089,"_26896":68579,"_2860":113948},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3374":68581,"_29561":68579,"_5":29890,"_20535":113950,"_26896":113951,"_2860":113952},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3374":68582,"_29561":68579,"_5":29890,"_20535":113954,"_26896":113955,"_2860":113619},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3374":68583,"_29561":68579,"_5":29890,"_20535":113957,"_26896":113958,"_2860":113959},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3374":68584,"_29561":68579,"_5":29890,"_20535":113961,"_26896":113962,"_2860":113963},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3374":68585,"_29561":68579,"_5":29890,"_20535":113965,"_26896":113966,"_2860":113967},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3374":68586,"_29561":68579,"_5":29890,"_20535":113969,"_26896":113970,"_2860":113971},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3374":68587,"_29561":68579,"_5":29890,"_20535":113973,"_26896":113974,"_2860":113975},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3374":68588,"_29561":68579,"_5":29890,"_20535":113977,"_26896":113978,"_2860":113979},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3374":68589,"_29561":68579,"_5":29890,"_20535":113981,"_26896":113982,"_2860":113983},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3374":68590,"_29561":68579,"_5":29890,"_20535":113985,"_26896":113986,"_2860":113987},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3374":68591,"_29561":68579,"_5":29890,"_20535":113989,"_26896":113990,"_2860":113991},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3374":68592,"_29561":68579,"_20535":113993,"_5":14089,"_26896":113951,"_2860":113994},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3374":68593,"_29561":68579,"_20535":113996,"_5":14089,"_26896":113955,"_2860":113997},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3374":68594,"_29561":68579,"_20535":113999,"_5":14089,"_26896":113955,"_2860":114000},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3374":68595,"_29561":68579,"_20535":114002,"_5":14089,"_26896":113955,"_2860":114003},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3374":68596,"_29561":68579,"_20535":114005,"_5":14089,"_26896":113955,"_2860":114006},[],"un broker RabbitMQ accesible y sus credenciales",{"_3374":68597,"_29561":68579,"_20535":114008,"_5":14089,"_26896":113955,"_2860":114009},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3374":68598,"_29561":68579,"_20535":114011,"_5":14089,"_26896":113955,"_2860":114012},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3374":68599,"_29561":68579,"_20535":114014,"_5":14089,"_26896":113955,"_2860":114015},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3374":68600,"_29561":68579,"_20535":114017,"_5":14089,"_26896":113955,"_2860":114018},[],"una StorageClass y un diseño de tráfico externo",{"_3374":68601,"_29561":68579,"_20535":114020,"_5":14089,"_26896":113955,"_2860":114021},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3374":68602,"_29561":68579,"_20535":114023,"_5":14089,"_26896":113955,"_2860":114024},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3374":68603,"_29561":68579,"_20535":114026,"_5":14089,"_26896":113955,"_2860":114027},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3374":68604,"_29561":68579,"_20535":114029,"_5":14089,"_26896":113958,"_2860":114030},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3374":68605,"_29561":68579,"_20535":114032,"_5":14089,"_26896":113958,"_2860":114033},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3374":68606,"_29561":68579,"_20535":114035,"_5":14089,"_26896":113958,"_2860":114036},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3374":68607,"_29561":68579,"_20535":114038,"_5":14089,"_26896":113962,"_2860":114039},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3374":68608,"_29561":68579,"_20535":114041,"_5":14089,"_26896":113962,"_2860":114042},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3374":68609,"_29561":68579,"_20535":114044,"_5":14089,"_26896":113962,"_2860":114045},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3374":68610,"_29561":68579,"_20535":114047,"_5":14089,"_26896":113962,"_2860":114048},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3374":68611,"_29561":68579,"_20535":114050,"_5":14089,"_26896":113966,"_2860":114051},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3374":68612,"_29561":68579,"_20535":114053,"_5":14089,"_26896":113970,"_2860":114054},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3374":68613,"_29561":68579,"_20535":114056,"_5":14089,"_26896":113970,"_2860":114057},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3374":68614,"_29561":68579,"_20535":114059,"_5":14089,"_26896":113970,"_2860":114060},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3374":68615,"_29561":68579,"_20535":114062,"_5":14089,"_26896":113970,"_2860":114063},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3374":68616,"_29561":68579,"_20535":114065,"_5":14089,"_26896":113970,"_2860":114066},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3374":68617,"_29561":68579,"_20535":114068,"_5":14089,"_26896":113970,"_2860":114069},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3374":68618,"_29561":68579,"_20535":114071,"_5":14089,"_26896":113970,"_2860":114072},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3374":68619,"_29561":68579,"_20535":114074,"_5":14089,"_26896":113974,"_2860":114075},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3374":68620,"_29561":68579,"_20535":114077,"_5":14089,"_26896":113974,"_2860":114078},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3374":68621,"_29561":68579,"_20535":114080,"_5":14089,"_26896":113974,"_2860":114081},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3374":68622,"_29561":68579,"_20535":114083,"_5":14089,"_26896":113974,"_2860":114084},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3374":68623,"_29561":68579,"_20535":114086,"_5":14089,"_26896":113978,"_2860":114087},[],"Para instalar un checkout local:",{"_3374":68624,"_29561":68579,"_20535":114089,"_5":14089,"_26896":113982,"_2860":114090},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3374":68625,"_29561":68579,"_20535":114092,"_5":14089,"_26896":113982,"_2860":114093},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3374":68626,"_29561":68579,"_20535":114095,"_5":14089,"_26896":113986,"_2860":114096},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3374":68627,"_29561":68579,"_20535":114098,"_5":14089,"_26896":113986,"_2860":114099},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3374":68628,"_29561":68579,"_20535":114101,"_5":14089,"_26896":113986,"_2860":114102},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3374":68629,"_29561":68579,"_20535":114104,"_5":14089,"_26896":113986,"_2860":114105},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3374":68630,"_29561":68579,"_20535":114107,"_5":14089,"_26896":113986,"_2860":114108},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3374":68631,"_29561":68579,"_20535":114110,"_5":14089,"_26896":113990,"_2860":114111},[],"Antes de pasar a producción, revisa:",{"_3374":68632,"_29561":68579,"_20535":114113,"_5":14089,"_26896":113990,"_2860":114114},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3374":68633,"_29561":68579,"_20535":114116,"_5":14089,"_26896":113990,"_2860":114117},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3374":68634,"_29561":68579,"_20535":114119,"_5":14089,"_26896":113990,"_2860":114120},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3374":68635,"_29561":68579,"_20535":114122,"_5":14089,"_26896":113990,"_2860":114123},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3374":68636,"_29561":68579,"_20535":114125,"_5":14089,"_26896":113990,"_2860":114126},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3374":68637,"_29561":68579,"_20535":114128,"_5":14089,"_26896":113990,"_2860":114129},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3374":68638,"_29561":68579,"_20535":114131,"_5":14089,"_26896":113990,"_2860":114132},[],"SMTP, observabilidad y entrega de alertas",{"_3374":68639,"_29561":68579,"_20535":114134,"_5":14089,"_26896":113990,"_2860":114135},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3374":68640,"_29561":68579,"_20535":114137,"_5":14089,"_26896":113990,"_2860":114138},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3374":68641,"_29561":68641,"_5":14447,"_2860":114140,"_29893":114141,"_20535":114142,"_26896":68641},"Expón el Gateway",[48107,113369,113603],[],{"_3374":68642,"_29561":68641,"_20535":114144,"_5":14089,"_26896":68641,"_2860":114145},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3374":68643,"_29561":68641,"_5":29890,"_20535":114147,"_26896":114148,"_2860":114149},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3374":68644,"_29561":68641,"_5":29890,"_20535":114151,"_26896":114152,"_2860":114153},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3374":68645,"_29561":68641,"_5":29890,"_20535":114155,"_26896":114156,"_2860":114157},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3374":68646,"_29561":68641,"_5":29890,"_20535":114159,"_26896":114160,"_2860":48933},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3374":68647,"_29561":68641,"_5":29890,"_20535":114162,"_26896":114163,"_2860":114164},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3374":68648,"_29561":68641,"_5":29890,"_20535":114166,"_26896":114167,"_2860":114168},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3374":68649,"_29561":68641,"_5":29890,"_20535":114170,"_26896":114171,"_2860":114172},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3374":68650,"_29561":68641,"_5":29890,"_20535":114174,"_26896":114175,"_2860":114176},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3374":68651,"_29561":68641,"_5":29890,"_20535":114178,"_26896":114179,"_2860":114180},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3374":68652,"_29561":68641,"_5":29890,"_20535":114182,"_26896":114183,"_2860":114184},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3374":68653,"_29561":68641,"_20535":114186,"_5":14089,"_26896":114148,"_2860":114187},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3374":68654,"_29561":68641,"_20535":114189,"_5":14089,"_26896":114148,"_2860":114190},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3374":68655,"_29561":68641,"_20535":114192,"_5":14089,"_26896":114152,"_2860":114193},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3374":68656,"_29561":68641,"_20535":114195,"_5":14089,"_26896":114152,"_2860":114196},[],"Defínelo únicamente cuando:",{"_3374":68657,"_29561":68641,"_20535":114198,"_5":14089,"_26896":114152,"_2860":114199},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3374":68658,"_29561":68641,"_20535":114201,"_5":14089,"_26896":114152,"_2860":114202},[],"esa dirección está asignada a este Gateway",{"_3374":68659,"_29561":68641,"_20535":114204,"_5":14089,"_26896":114152,"_2860":114205},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3374":68660,"_29561":68641,"_20535":114207,"_5":14089,"_26896":114152,"_2860":114208},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3374":68661,"_29561":68641,"_20535":114210,"_5":14089,"_26896":114152,"_2860":114211},[],"No confundas estos valores:",{"_3374":68662,"_29561":68641,"_20535":114213,"_5":14089,"_26896":114152,"_2860":114214},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3374":68663,"_29561":68641,"_20535":114216,"_5":14089,"_26896":114152,"_2860":114217},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3374":68664,"_29561":68641,"_20535":114219,"_5":14089,"_26896":114152,"_2860":114220},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3374":68665,"_29561":68641,"_20535":114222,"_5":14089,"_26896":114156,"_2860":114223},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3374":68666,"_29561":68641,"_20535":114225,"_5":14089,"_26896":114156,"_2860":114226},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3374":68667,"_29561":68641,"_20535":114228,"_5":14089,"_26896":114160,"_2860":114229},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3374":68668,"_29561":68641,"_20535":114231,"_5":14089,"_26896":114160,"_2860":114232},[],"Para el diseño recomendado:",{"_3374":68669,"_29561":68641,"_20535":114234,"_5":14089,"_26896":114160,"_2860":114235},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3374":68670,"_29561":68641,"_20535":114237,"_5":14089,"_26896":114160,"_2860":114238},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3374":68671,"_29561":68641,"_20535":114240,"_5":14089,"_26896":114160,"_2860":114241},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3374":68672,"_29561":68641,"_20535":114243,"_5":14089,"_26896":114160,"_2860":114244},[],"Apunta DNS a la dirección accesible de la VM.",{"_3374":68673,"_29561":68641,"_20535":114246,"_5":14089,"_26896":114160,"_2860":114247},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3374":68674,"_29561":68641,"_20535":114249,"_5":14089,"_26896":114163,"_2860":114250},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3374":68675,"_29561":68641,"_20535":114252,"_5":14089,"_26896":114167,"_2860":114253},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3374":68676,"_29561":68641,"_20535":114255,"_5":14089,"_26896":114167,"_2860":114256},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3374":68677,"_29561":68641,"_20535":114258,"_5":14089,"_26896":114171,"_2860":114259},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3374":68678,"_29561":68641,"_20535":114261,"_5":14089,"_26896":114171,"_2860":114262},[],"Requisito",{"_3374":68679,"_29561":68641,"_20535":114264,"_5":14089,"_26896":114171,"_2860":114265},[],"Diseño recomendado",{"_3374":68680,"_29561":68641,"_20535":114267,"_5":14089,"_26896":114171,"_2860":114268},[],"Consecuencia",{"_3374":68681,"_29561":68641,"_20535":114270,"_5":14089,"_26896":114171,"_2860":114271},[],"Varias URL o servicios de Lamassu",{"_3374":68682,"_29561":68641,"_20535":114273,"_5":14089,"_26896":114171,"_2860":114274},[],"Un Gateway con varias rutas",{"_3374":68683,"_29561":68641,"_20535":114276,"_5":14089,"_26896":114171,"_2860":114277},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3374":68684,"_29561":68641,"_20535":114279,"_5":14089,"_26896":114171,"_2860":114280},[],"Gateways independientes e IP externas distintas",{"_3374":68685,"_29561":68641,"_20535":114282,"_5":14089,"_26896":114171,"_2860":114283},[],"Una VIP por Gateway",{"_3374":68686,"_29561":68641,"_20535":114285,"_5":14089,"_26896":114171,"_2860":114286},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3374":68687,"_29561":68641,"_20535":114288,"_5":14089,"_26896":114171,"_2860":114289},[],"Gateways independientes, un nodo y una IP",{"_3374":68688,"_29561":68641,"_20535":114291,"_5":14089,"_26896":114171,"_2860":114292},[],"Puertos externos diferentes",{"_3374":68689,"_29561":68641,"_20535":114294,"_5":14089,"_26896":114171,"_2860":114295},[],"Los clientes deben indicar puertos no estándar",{"_3374":68690,"_29561":68641,"_20535":114297,"_5":14089,"_26896":114171,"_2860":114298},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3374":68691,"_29561":68641,"_20535":114300,"_5":14089,"_26896":114171,"_2860":114301},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3374":68692,"_29561":68641,"_20535":114303,"_5":14089,"_26896":114171,"_2860":114304},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3374":68693,"_29561":68641,"_20535":114306,"_5":14089,"_26896":114171,"_2860":114307},[],"Recursos Gateway separados pero proxy compartido",{"_3374":68694,"_29561":68641,"_20535":114309,"_5":14089,"_26896":114171,"_2860":114310},[],"Modo merged Gateway de Envoy",{"_3374":68695,"_29561":68641,"_20535":114312,"_5":14089,"_26896":114171,"_2860":114313},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3374":68696,"_29561":68641,"_20535":114315,"_5":14089,"_26896":114171,"_2860":114316},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3374":68697,"_29561":68641,"_20535":114318,"_5":14089,"_26896":114171,"_2860":114319},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3374":68698,"_29561":68641,"_20535":114321,"_5":14089,"_26896":114171,"_2860":114322},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3374":68699,"_29561":68641,"_20535":114324,"_5":14089,"_26896":114171,"_2860":114325},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3374":68700,"_29561":68641,"_20535":114327,"_5":14089,"_26896":114175,"_2860":114328},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3374":68701,"_29561":68641,"_20535":114330,"_5":14089,"_26896":114175,"_2860":114331},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3374":68702,"_29561":68641,"_20535":114333,"_5":14089,"_26896":114175,"_2860":114334},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3374":68703,"_29561":68641,"_20535":114336,"_5":14089,"_26896":114175,"_2860":114337},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3374":68704,"_29561":68641,"_20535":114339,"_5":14089,"_26896":114175,"_2860":114340},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3374":68705,"_29561":68641,"_20535":114342,"_5":14089,"_26896":114179,"_2860":114343},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3374":68706,"_29561":68641,"_20535":114345,"_5":14089,"_26896":114179,"_2860":114346},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3374":68707,"_29561":68641,"_20535":114348,"_5":14089,"_26896":114183,"_2860":114349},[],"Comprueba, en orden:",{"_3374":68708,"_29561":68641,"_20535":114351,"_5":14089,"_26896":114183,"_2860":114352},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3374":68709,"_29561":68641,"_20535":114354,"_5":14089,"_26896":114183,"_2860":114355},[],"Su estado contiene la dirección esperada.",{"_3374":68710,"_29561":68641,"_20535":114357,"_5":14089,"_26896":114183,"_2860":114358},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3374":68711,"_29561":68641,"_20535":114360,"_5":14089,"_26896":114183,"_2860":114361},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3374":68712,"_29561":68641,"_20535":114363,"_5":14089,"_26896":114183,"_2860":114364},[],"DNS resuelve al endpoint accesible externamente.",{"_3374":68713,"_29561":68641,"_20535":114366,"_5":14089,"_26896":114183,"_2860":114367},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3374":68714,"_29561":68641,"_20535":114369,"_5":14089,"_26896":114183,"_2860":114370},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3374":68715,"_29561":68715,"_5":14447,"_2860":48214,"_29893":114372,"_20535":114373,"_26896":68715},[48107,113369,113603],[],{"_3374":68716,"_29561":68715,"_20535":114375,"_5":14089,"_26896":68715,"_2860":114376},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3374":68717,"_29561":68715,"_5":29890,"_20535":114378,"_26896":114379,"_2860":114380},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3374":68718,"_29561":68715,"_5":29890,"_20535":114382,"_26896":114383,"_2860":114384},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3374":68719,"_29561":68715,"_5":29890,"_20535":114386,"_26896":114387,"_2860":114388},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3374":68720,"_29561":68715,"_5":29890,"_20535":114390,"_26896":114391,"_2860":114392},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3374":68721,"_29561":68715,"_5":29890,"_20535":114394,"_26896":114395,"_2860":114396},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3374":68722,"_29561":68715,"_5":29890,"_20535":114398,"_26896":114399,"_2860":114400},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3374":68723,"_29561":68715,"_20535":114402,"_5":14089,"_26896":114379,"_2860":114403},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3374":68724,"_29561":68715,"_20535":114405,"_5":14089,"_26896":114383,"_2860":114406},[],"Flujo",{"_3374":68725,"_29561":68715,"_20535":114408,"_5":14089,"_26896":114383,"_2860":114409},[],"Úsalo para",{"_3374":68726,"_29561":68715,"_20535":114411,"_5":14089,"_26896":114383,"_2860":114412},[],"Qué instala",{"_3374":68727,"_29561":68715,"_20535":114414,"_5":14089,"_26896":114383,"_2860":49188},[],{"_3374":68728,"_29561":68715,"_20535":114416,"_5":14089,"_26896":114383,"_2860":114417},[],"Producción y entornos controlados",{"_3374":68729,"_29561":68715,"_20535":114419,"_5":14089,"_26896":114383,"_2860":114420},[],"Servicios de Lamassu y recursos de Gateway API",{"_3374":68730,"_29561":68715,"_20535":114422,"_5":14089,"_26896":114383,"_2860":48351},[],{"_3374":68731,"_29561":68715,"_20535":114424,"_5":14089,"_26896":114383,"_2860":114425},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3374":68732,"_29561":68715,"_20535":114427,"_5":14089,"_26896":114383,"_2860":114428},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3374":68733,"_29561":68715,"_20535":114430,"_5":14089,"_26896":114387,"_2860":114431},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3374":68734,"_29561":68715,"_20535":114433,"_5":14089,"_26896":114387,"_2860":114434},[],"Área",{"_3374":68735,"_29561":68715,"_20535":114436,"_5":14089,"_26896":114387,"_2860":114437},[],"El chart de Lamassu proporciona",{"_3374":68736,"_29561":68715,"_20535":114439,"_5":14089,"_26896":114387,"_2860":114440},[],"Tú proporcionas",{"_3374":68737,"_29561":68715,"_20535":114442,"_5":14089,"_26896":114387,"_2860":114443},[],"Aplicaciones Lamassu",{"_3374":68738,"_29561":68715,"_20535":114445,"_5":14089,"_26896":114387,"_2860":114446},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3374":68739,"_29561":68715,"_20535":114448,"_5":14089,"_26896":114387,"_2860":114449},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3374":68740,"_29561":68715,"_20535":114451,"_5":14089,"_26896":114387,"_2860":114452},[],"Datos PostgreSQL",{"_3374":68741,"_29561":68715,"_20535":114454,"_5":14089,"_26896":114387,"_2860":114455},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3374":68742,"_29561":68715,"_20535":114457,"_5":14089,"_26896":114387,"_2860":114458},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3374":68743,"_29561":68715,"_20535":114460,"_5":14089,"_26896":114387,"_2860":114461},[],"Mensajería",{"_3374":68744,"_29561":68715,"_20535":114463,"_5":14089,"_26896":114387,"_2860":114464},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3374":68745,"_29561":68715,"_20535":114466,"_5":14089,"_26896":114387,"_2860":114467},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3374":68746,"_29561":68715,"_20535":114469,"_5":14089,"_26896":114387,"_2860":114470},[],"Identidad",{"_3374":68747,"_29561":68715,"_20535":114472,"_5":14089,"_26896":114387,"_2860":114473},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3374":68748,"_29561":68715,"_20535":114475,"_5":14089,"_26896":114387,"_2860":114476},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3374":68749,"_29561":68715,"_20535":114478,"_5":14089,"_26896":114387,"_2860":114479},[],"Enrutamiento externo",{"_3374":68750,"_29561":68715,"_20535":114481,"_5":14089,"_26896":114387,"_2860":114482},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3374":68751,"_29561":68715,"_20535":114484,"_5":14089,"_26896":114387,"_2860":114485},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3374":68752,"_29561":68715,"_20535":114487,"_5":14089,"_26896":114387,"_2860":49262},[],{"_3374":68753,"_29561":68715,"_20535":114489,"_5":14089,"_26896":114387,"_2860":114490},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3374":68754,"_29561":68715,"_20535":114492,"_5":14089,"_26896":114387,"_2860":114493},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3374":68755,"_29561":68715,"_20535":114495,"_5":14089,"_26896":114387,"_2860":114496},[],"Datos persistentes de la aplicación",{"_3374":68756,"_29561":68715,"_20535":114498,"_5":14089,"_26896":114387,"_2860":114499},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3374":68757,"_29561":68715,"_20535":114501,"_5":14089,"_26896":114387,"_2860":114502},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3374":68758,"_29561":68715,"_20535":114504,"_5":14089,"_26896":114387,"_2860":114505},[],"Integraciones opcionales",{"_3374":68759,"_29561":68715,"_20535":114507,"_5":14089,"_26896":114387,"_2860":114508},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3374":68760,"_29561":68715,"_20535":114510,"_5":14089,"_26896":114387,"_2860":114511},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3374":68761,"_29561":68715,"_20535":114513,"_5":14089,"_26896":114387,"_2860":114514},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3374":68762,"_29561":68715,"_20535":114516,"_5":14089,"_26896":114387,"_2860":114517},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3374":68763,"_29561":68715,"_20535":114519,"_5":14089,"_26896":114391,"_2860":114520},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3374":68764,"_29561":68715,"_20535":114522,"_5":14089,"_26896":114391,"_2860":114523},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3374":68765,"_29561":68715,"_20535":114525,"_5":14089,"_26896":114395,"_2860":114526},[],"Kubernetes 1.24 o posterior",{"_3374":68766,"_29561":68715,"_20535":114528,"_5":14089,"_26896":114395,"_2860":114529},[],"Helm 3.2 o posterior",{"_3374":68767,"_29561":68715,"_20535":114531,"_5":14089,"_26896":114395,"_2860":114532},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3374":68768,"_29561":68715,"_20535":114534,"_5":14089,"_26896":114395,"_2860":114535},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3374":68769,"_29561":68715,"_20535":114537,"_5":14089,"_26896":114395,"_2860":114538},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3374":68770,"_29561":68715,"_20535":114540,"_5":14089,"_26896":114395,"_2860":114541},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3374":68771,"_29561":68715,"_20535":114543,"_5":14089,"_26896":114395,"_2860":114544},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3374":68772,"_29561":68715,"_20535":114546,"_5":14089,"_26896":114399,"_2860":114547},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3374":68773,"_29561":68715,"_20535":114549,"_5":14089,"_26896":114399,"_2860":114550},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3374":68774,"_29561":68715,"_20535":114552,"_5":14089,"_26896":114399,"_2860":114553},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3374":68775,"_29561":68715,"_20535":114555,"_5":14089,"_26896":114399,"_2860":114556},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3374":68776,"_29561":68776,"_5":14447,"_2860":114558,"_29893":114559,"_20535":114561,"_26896":68776},"Resolución de problemas de despliegue",[48107,113369,114560],"Operación",[],{"_3374":68777,"_29561":68776,"_20535":114563,"_5":14089,"_26896":68776,"_2860":114564},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3374":68778,"_29561":68776,"_5":29890,"_20535":114566,"_26896":114567,"_2860":114568},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3374":68779,"_29561":68776,"_5":29890,"_20535":114570,"_26896":114571,"_2860":114572},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3374":68780,"_29561":68776,"_5":29890,"_20535":114574,"_26896":114575,"_2860":114576},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3374":68781,"_29561":68776,"_5":29890,"_20535":114578,"_26896":114579,"_2860":114580},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3374":68782,"_29561":68776,"_5":29890,"_20535":114582,"_26896":114583,"_2860":114584},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3374":68783,"_29561":68776,"_5":29890,"_20535":114586,"_26896":114587,"_2860":114588},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3374":68784,"_29561":68776,"_5":29890,"_20535":114590,"_26896":114591,"_2860":114592},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3374":68785,"_29561":68776,"_5":29890,"_20535":114594,"_26896":114595,"_2860":114596},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3374":68786,"_29561":68776,"_5":29890,"_20535":114598,"_26896":114599,"_2860":114600},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3374":68787,"_29561":68776,"_5":29890,"_20535":114602,"_26896":114603,"_2860":114604},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3374":68788,"_29561":68776,"_5":29890,"_20535":114606,"_26896":114607,"_2860":114608},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3374":68789,"_29561":68776,"_5":29890,"_20535":114610,"_26896":114611,"_2860":114612},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3374":68790,"_29561":68776,"_5":29890,"_20535":114614,"_26896":114615,"_2860":114616},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3374":68791,"_29561":68776,"_20535":114618,"_5":14089,"_26896":68776,"_2860":114619},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3374":68792,"_29561":68776,"_20535":114621,"_5":14089,"_26896":114571,"_2860":114622},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3374":68793,"_29561":68776,"_20535":114624,"_5":14089,"_26896":114575,"_2860":114625},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3374":68794,"_29561":68776,"_20535":114627,"_5":14089,"_26896":114579,"_2860":114628},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3374":68795,"_29561":68776,"_20535":114630,"_5":14089,"_26896":114583,"_2860":114631},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3374":68796,"_29561":68776,"_20535":114633,"_5":14089,"_26896":114587,"_2860":114634},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3374":68797,"_29561":68776,"_20535":114636,"_5":14089,"_26896":114591,"_2860":114637},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3374":68798,"_29561":68776,"_20535":114639,"_5":14089,"_26896":114591,"_2860":114640},[],"Ejecuta también la prueba de conectividad del chart:",{"_3374":68799,"_29561":68776,"_20535":114642,"_5":14089,"_26896":114591,"_2860":114643},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3374":68800,"_29561":68776,"_20535":114645,"_5":14089,"_26896":114591,"_2860":114646},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3374":68801,"_29561":68776,"_20535":114648,"_5":14089,"_26896":114595,"_2860":114649},[],"Si recibes un 401:",{"_3374":68802,"_29561":68776,"_20535":114651,"_5":14089,"_26896":114595,"_2860":114652},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3374":68803,"_29561":68776,"_20535":114654,"_5":14089,"_26896":114595,"_2860":114655},[],"verifica emisor, audiencia y expiración del token;",{"_3374":68804,"_29561":68776,"_20535":114657,"_5":14089,"_26896":114595,"_2860":114658},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3374":68805,"_29561":68776,"_20535":114660,"_5":14089,"_26896":114595,"_2860":114661},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3374":68806,"_29561":68776,"_20535":114663,"_5":14089,"_26896":114595,"_2860":114664},[],"Si el login termina pero las APIs devuelven 403:",{"_3374":68807,"_29561":68776,"_20535":114666,"_5":14089,"_26896":114595,"_2860":114667},[],"inspecciona los claims reales del token;",{"_3374":68808,"_29561":68776,"_20535":114669,"_5":14089,"_26896":114595,"_2860":114670},[],"confirma que coinciden con un principal activo;",{"_3374":68809,"_29561":68776,"_20535":114672,"_5":14089,"_26896":114595,"_2860":114673},[],"revisa las políticas concedidas al principal;",{"_3374":68810,"_29561":68776,"_20535":114675,"_5":14089,"_26896":114595,"_2860":114676},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3374":68811,"_29561":68776,"_20535":114678,"_5":14089,"_26896":114595,"_2860":114679},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3374":68812,"_29561":68776,"_20535":114681,"_5":14089,"_26896":114599,"_2860":114682},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3374":68813,"_29561":68776,"_20535":114684,"_5":14089,"_26896":114599,"_2860":114685},[],"Localiza el pod y Service de authz.",{"_3374":68814,"_29561":68776,"_20535":114687,"_5":14089,"_26896":114599,"_2860":114688},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3374":68815,"_29561":68776,"_20535":114690,"_5":14089,"_26896":114599,"_2860":114691},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3374":68816,"_29561":68776,"_20535":114693,"_5":14089,"_26896":114599,"_2860":114694},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3374":68817,"_29561":68776,"_20535":114696,"_5":14089,"_26896":114599,"_2860":114697},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3374":68818,"_29561":68776,"_20535":114699,"_5":14089,"_26896":114603,"_2860":114700},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3374":68819,"_29561":68776,"_20535":114702,"_5":14089,"_26896":114607,"_2860":114703},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3374":68820,"_29561":68776,"_20535":114705,"_5":14089,"_26896":114607,"_2860":114706},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3374":68821,"_29561":68776,"_20535":114708,"_5":14089,"_26896":114607,"_2860":114709},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3374":68822,"_29561":68776,"_20535":114711,"_5":14089,"_26896":114607,"_2860":114712},[],"volumen persistente sin enlazar;",{"_3374":68823,"_29561":68776,"_20535":114714,"_5":14089,"_26896":114607,"_2860":114715},[],"imagen inaccesible o política de pull incorrecta;",{"_3374":68824,"_29561":68776,"_20535":114717,"_5":14089,"_26896":114607,"_2860":114718},[],"configuración inválida del motor criptográfico;",{"_3374":68825,"_29561":68776,"_20535":114720,"_5":14089,"_26896":114607,"_2860":114721},[],"límites de CPU o memoria demasiado bajos;",{"_3374":68826,"_29561":68776,"_20535":114723,"_5":14089,"_26896":114607,"_2860":114724},[],"migración previa incompleta.",{"_3374":68827,"_29561":68776,"_20535":114726,"_5":14089,"_26896":114607,"_2860":114727},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3374":68828,"_29561":68776,"_20535":114729,"_5":14089,"_26896":114607,"_2860":114730},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3374":68829,"_29561":68776,"_20535":114732,"_5":14089,"_26896":114607,"_2860":114733},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3374":68830,"_29561":68776,"_20535":114735,"_5":14089,"_26896":114611,"_2860":114736},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3374":68831,"_29561":68776,"_20535":114738,"_5":14089,"_26896":114611,"_2860":114739},[],"verifica que esté habilitado en el servicio emisor;",{"_3374":68832,"_29561":68776,"_20535":114741,"_5":14089,"_26896":114611,"_2860":114742},[],"comprueba conectividad y credenciales AMQP;",{"_3374":68833,"_29561":68776,"_20535":114744,"_5":14089,"_26896":114611,"_2860":114745},[],"revisa exchange, routing key, colas y consumidores;",{"_3374":68834,"_29561":68776,"_20535":114747,"_5":14089,"_26896":114611,"_2860":114748},[],"inspecciona dead-letter queues;",{"_3374":68835,"_29561":68776,"_20535":114750,"_5":14089,"_26896":114611,"_2860":114751},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3374":68836,"_29561":68776,"_20535":114753,"_5":14089,"_26896":114611,"_2860":114754},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3374":68837,"_29561":68776,"_20535":114756,"_5":14089,"_26896":114611,"_2860":114757},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3374":68838,"_29561":68776,"_20535":114759,"_5":14089,"_26896":114611,"_2860":114760},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3374":68839,"_29561":68776,"_20535":114762,"_5":14089,"_26896":114611,"_2860":114763},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3374":68840,"_29561":68776,"_20535":114765,"_5":14089,"_26896":114611,"_2860":114766},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3374":68841,"_29561":68776,"_20535":114768,"_5":14089,"_26896":114611,"_2860":114769},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3374":68842,"_29561":68776,"_20535":114771,"_5":14089,"_26896":114611,"_2860":114772},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3374":68843,"_29561":68776,"_20535":114774,"_5":14089,"_26896":114615,"_2860":114775},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3374":68844,"_29561":68776,"_20535":114777,"_5":14089,"_26896":114615,"_2860":114778},[],"Antes de cerrar una incidencia, guarda:",{"_3374":68845,"_29561":68776,"_20535":114780,"_5":14089,"_26896":114615,"_2860":114781},[],"causa confirmada;",{"_3374":68846,"_29561":68776,"_20535":114783,"_5":14089,"_26896":114615,"_2860":114784},[],"alcance temporal y recursos afectados;",{"_3374":68847,"_29561":68776,"_20535":114786,"_5":14089,"_26896":114615,"_2860":114787},[],"comandos o consultas utilizados;",{"_3374":68848,"_29561":68776,"_20535":114789,"_5":14089,"_26896":114615,"_2860":114790},[],"cambio aplicado y forma de revertirlo;",{"_3374":68849,"_29561":68776,"_20535":114792,"_5":14089,"_26896":114615,"_2860":114793},[],"validación desde un consumidor;",{"_3374":68850,"_29561":68776,"_20535":114795,"_5":14089,"_26896":114615,"_2860":114796},[],"acción preventiva y propietario.",{"_3374":68851,"_29561":68851,"_5":14447,"_2860":114798,"_29893":114799,"_20535":114802,"_26896":68851},"Control de acceso",[48107,114800,114801],"Plataforma","Administración",[],{"_3374":68852,"_29561":68851,"_20535":114804,"_5":14089,"_26896":68851,"_2860":114805},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3374":68853,"_29561":68851,"_5":29890,"_20535":114807,"_26896":114808,"_2860":114809},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3374":68854,"_29561":68851,"_5":29890,"_20535":114811,"_26896":114812,"_2860":114813},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3374":68855,"_29561":68851,"_5":29890,"_20535":114815,"_26896":114816,"_2860":114817},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3374":68856,"_29561":68851,"_5":29890,"_20535":114819,"_26896":114820,"_2860":114821},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3374":68857,"_29561":68851,"_5":29890,"_20535":114823,"_26896":114824,"_2860":114825},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3374":68858,"_29561":68851,"_5":29890,"_20535":114827,"_26896":114828,"_2860":114829},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3374":68859,"_29561":68851,"_5":29890,"_20535":114831,"_26896":114832,"_2860":114833},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3374":68860,"_29561":68851,"_5":29890,"_20535":114835,"_26896":114836,"_2860":114837},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3374":68861,"_29561":68851,"_5":29890,"_20535":114839,"_26896":114840,"_2860":114841},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3374":68862,"_29561":68851,"_5":29890,"_20535":114843,"_26896":114844,"_2860":114845},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3374":68863,"_29561":68851,"_5":29890,"_20535":114847,"_26896":114848,"_2860":114849},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3374":68864,"_29561":68851,"_5":29890,"_20535":114851,"_26896":114852,"_2860":114853},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3374":68865,"_29561":68851,"_5":29890,"_20535":114855,"_26896":114856,"_2860":114857},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3374":68866,"_29561":68851,"_5":29890,"_20535":114859,"_26896":114860,"_2860":114861},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3374":68867,"_29561":68851,"_5":29890,"_20535":114863,"_26896":114864,"_2860":114865},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3374":68868,"_29561":68851,"_5":29890,"_20535":114867,"_26896":114868,"_2860":113975},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3374":68869,"_29561":68851,"_5":29890,"_20535":114870,"_26896":114871,"_2860":114872},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3374":68870,"_29561":68851,"_5":29890,"_20535":114874,"_26896":114875,"_2860":114876},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3374":68871,"_29561":68851,"_5":29890,"_20535":114878,"_26896":114879,"_2860":114880},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3374":68872,"_29561":68851,"_5":29890,"_20535":114882,"_26896":114883,"_2860":114884},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3374":68873,"_29561":68851,"_5":29890,"_20535":114886,"_26896":114887,"_2860":114888},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3374":68874,"_29561":68851,"_5":29890,"_20535":114890,"_26896":114891,"_2860":114892},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3374":68875,"_29561":68851,"_5":29890,"_20535":114894,"_26896":114895,"_2860":114896},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3374":68876,"_29561":68851,"_5":29890,"_20535":114898,"_26896":114899,"_2860":114900},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3374":68877,"_29561":68851,"_5":29890,"_20535":114902,"_26896":114903,"_2860":114904},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3374":68878,"_29561":68851,"_5":29890,"_20535":114906,"_26896":114907,"_2860":114908},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3374":68879,"_29561":68851,"_5":29890,"_20535":114910,"_26896":114911,"_2860":114912},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3374":68880,"_29561":68851,"_5":29890,"_20535":114914,"_26896":114915,"_2860":114916},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3374":68881,"_29561":68851,"_5":29890,"_20535":114918,"_26896":114919,"_2860":114920},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3374":68882,"_29561":68851,"_5":29890,"_20535":114922,"_26896":114923,"_2860":114924},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3374":68883,"_29561":68851,"_5":29890,"_20535":114926,"_26896":114927,"_2860":114928},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3374":68884,"_29561":68851,"_20535":114930,"_5":14089,"_26896":68851,"_2860":114931},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3374":68885,"_29561":68851,"_20535":114933,"_5":14089,"_26896":68851,"_2860":114934},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3374":68886,"_29561":68851,"_20535":114936,"_5":14089,"_26896":68851,"_2860":114937},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3374":68887,"_29561":68851,"_20535":114939,"_5":14089,"_26896":114808,"_2860":114940},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3374":68888,"_29561":68851,"_20535":114942,"_5":14089,"_26896":114808,"_2860":114943},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3374":68889,"_29561":68851,"_20535":114945,"_5":14089,"_26896":114808,"_2860":114946},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3374":68890,"_29561":68851,"_20535":114948,"_5":14089,"_26896":114808,"_2860":114949},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3374":68891,"_29561":68851,"_20535":114951,"_5":14089,"_26896":114808,"_2860":114952},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3374":68892,"_29561":68851,"_20535":114954,"_5":14089,"_26896":114808,"_2860":114955},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3374":68893,"_29561":68851,"_20535":114957,"_5":14089,"_26896":114812,"_2860":114958},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3374":68894,"_29561":68851,"_20535":114960,"_5":14089,"_26896":114812,"_2860":114961},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3374":68895,"_29561":68851,"_20535":114963,"_5":14089,"_26896":114816,"_2860":114964},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3374":68896,"_29561":68851,"_20535":114966,"_5":14089,"_26896":114816,"_2860":114967},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3374":68897,"_29561":68851,"_20535":114969,"_5":14089,"_26896":114816,"_2860":114970},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3374":68898,"_29561":68851,"_20535":114972,"_5":14089,"_26896":114816,"_2860":114973},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3374":68899,"_29561":68851,"_20535":114975,"_5":14089,"_26896":114816,"_2860":114976},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3374":68900,"_29561":68851,"_20535":114978,"_5":14089,"_26896":114816,"_2860":114979},[],"Carga por separado las políticas concedidas a cada principal.",{"_3374":68901,"_29561":68851,"_20535":114981,"_5":14089,"_26896":114816,"_2860":114982},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3374":68902,"_29561":68851,"_20535":114984,"_5":14089,"_26896":114816,"_2860":114985},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3374":68903,"_29561":68851,"_20535":114987,"_5":14089,"_26896":114816,"_2860":114988},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3374":68904,"_29561":68851,"_20535":114990,"_5":14089,"_26896":114816,"_2860":114991},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3374":68905,"_29561":68851,"_20535":114993,"_5":14089,"_26896":114816,"_2860":114994},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3374":68906,"_29561":68851,"_20535":114996,"_5":14089,"_26896":114816,"_2860":114997},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3374":68907,"_29561":68851,"_20535":114999,"_5":14089,"_26896":114820,"_2860":115000},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3374":68908,"_29561":68851,"_20535":115002,"_5":14089,"_26896":114820,"_2860":115003},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3374":68909,"_29561":68851,"_20535":115005,"_5":14089,"_26896":114820,"_2860":115006},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3374":68910,"_29561":68851,"_20535":115008,"_5":14089,"_26896":114820,"_2860":115009},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3374":68911,"_29561":68851,"_20535":115011,"_5":14089,"_26896":114820,"_2860":115012},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3374":68912,"_29561":68851,"_20535":115014,"_5":14089,"_26896":114820,"_2860":115015},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3374":68913,"_29561":68851,"_20535":115017,"_5":14089,"_26896":114820,"_2860":115018},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3374":68914,"_29561":68851,"_20535":115020,"_5":14089,"_26896":114820,"_2860":115021},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3374":68915,"_29561":68851,"_20535":115023,"_5":14089,"_26896":114824,"_2860":115024},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3374":68916,"_29561":68851,"_20535":115026,"_5":14089,"_26896":114824,"_2860":115027},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3374":68917,"_29561":68851,"_20535":115029,"_5":14089,"_26896":114824,"_2860":115030},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3374":68918,"_29561":68851,"_20535":115032,"_5":14089,"_26896":114824,"_2860":115033},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3374":68919,"_29561":68851,"_20535":115035,"_5":14089,"_26896":114824,"_2860":115036},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3374":68920,"_29561":68851,"_20535":115038,"_5":14089,"_26896":114824,"_2860":115039},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3374":68921,"_29561":68851,"_20535":115041,"_5":14089,"_26896":114824,"_2860":115042},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3374":68922,"_29561":68851,"_20535":115044,"_5":14089,"_26896":114824,"_2860":115045},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3374":68923,"_29561":68851,"_20535":115047,"_5":14089,"_26896":114824,"_2860":115048},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3374":68924,"_29561":68851,"_20535":115050,"_5":14089,"_26896":114824,"_2860":115051},[],"Las acciones se dividen en dos grupos:",{"_3374":68925,"_29561":68851,"_20535":115053,"_5":14089,"_26896":114824,"_2860":115054},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3374":68926,"_29561":68851,"_20535":115056,"_5":14089,"_26896":114824,"_2860":115057},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3374":68927,"_29561":68851,"_20535":115059,"_5":14089,"_26896":114824,"_2860":115060},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3374":68928,"_29561":68851,"_20535":115062,"_5":14089,"_26896":114828,"_2860":115063},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3374":68929,"_29561":68851,"_20535":115065,"_5":14089,"_26896":114828,"_2860":115066},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3374":68930,"_29561":68851,"_20535":115068,"_5":14089,"_26896":114828,"_2860":115069},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3374":68931,"_29561":68851,"_20535":115071,"_5":14089,"_26896":114832,"_2860":115072},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3374":68932,"_29561":68851,"_20535":115074,"_5":14089,"_26896":114832,"_2860":115075},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3374":68933,"_29561":68851,"_20535":115077,"_5":14089,"_26896":114832,"_2860":115078},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3374":68934,"_29561":68851,"_20535":115080,"_5":14089,"_26896":114832,"_2860":115081},[],"Los operadores implementados son:",{"_3374":68935,"_29561":68851,"_20535":115083,"_5":14089,"_26896":114832,"_2860":115084},[],"`equals`, para igualdad exacta;",{"_3374":68936,"_29561":68851,"_20535":115086,"_5":14089,"_26896":114832,"_2860":115087},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3374":68937,"_29561":68851,"_20535":115089,"_5":14089,"_26896":114832,"_2860":115090},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3374":68938,"_29561":68851,"_20535":115092,"_5":14089,"_26896":114832,"_2860":115093},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3374":68939,"_29561":68851,"_20535":115095,"_5":14089,"_26896":114836,"_2860":115096},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3374":68940,"_29561":68851,"_20535":115098,"_5":14089,"_26896":114836,"_2860":115099},[],"Los modos disponibles son:",{"_3374":68941,"_29561":68851,"_20535":115101,"_5":14089,"_26896":114836,"_2860":115102},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3374":68942,"_29561":68851,"_20535":115104,"_5":14089,"_26896":114836,"_2860":115105},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3374":68943,"_29561":68851,"_20535":115107,"_5":14089,"_26896":114836,"_2860":115108},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3374":68944,"_29561":68851,"_20535":115110,"_5":14089,"_26896":114836,"_2860":115111},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3374":68945,"_29561":68851,"_20535":115113,"_5":14089,"_26896":114836,"_2860":115114},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3374":68946,"_29561":68851,"_20535":115116,"_5":14089,"_26896":114836,"_2860":115117},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3374":68947,"_29561":68851,"_20535":115119,"_5":14089,"_26896":114840,"_2860":115120},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3374":68948,"_29561":68851,"_20535":115122,"_5":14089,"_26896":114840,"_2860":115123},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3374":68949,"_29561":68851,"_20535":115125,"_5":14089,"_26896":114840,"_2860":115126},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3374":68950,"_29561":68851,"_20535":115128,"_5":14089,"_26896":114840,"_2860":115129},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3374":68951,"_29561":68851,"_20535":115131,"_5":14089,"_26896":114848,"_2860":115132},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3374":68952,"_29561":68851,"_20535":115134,"_5":14089,"_26896":114848,"_2860":115135},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3374":68953,"_29561":68851,"_20535":115137,"_5":14089,"_26896":114852,"_2860":115138},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3374":68954,"_29561":68851,"_20535":115140,"_5":14089,"_26896":114852,"_2860":115141},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3374":68955,"_29561":68851,"_20535":115143,"_5":14089,"_26896":114856,"_2860":115144},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3374":68956,"_29561":68851,"_20535":115146,"_5":14089,"_26896":114856,"_2860":115147},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3374":68957,"_29561":68851,"_20535":115149,"_5":14089,"_26896":114856,"_2860":115150},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3374":68958,"_29561":68851,"_20535":115152,"_5":14089,"_26896":114860,"_2860":115153},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3374":68959,"_29561":68851,"_20535":115155,"_5":14089,"_26896":114860,"_2860":115156},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3374":68960,"_29561":68851,"_20535":115158,"_5":14089,"_26896":114860,"_2860":115159},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3374":68961,"_29561":68851,"_20535":115161,"_5":14089,"_26896":114860,"_2860":115162},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3374":68962,"_29561":68851,"_20535":115164,"_5":14089,"_26896":114860,"_2860":115165},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3374":68963,"_29561":68851,"_20535":115167,"_5":14089,"_26896":114860,"_2860":115168},[],"Ten en cuenta que:",{"_3374":68964,"_29561":68851,"_20535":115170,"_5":14089,"_26896":114860,"_2860":115171},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3374":68965,"_29561":68851,"_20535":115173,"_5":14089,"_26896":114860,"_2860":115174},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3374":68966,"_29561":68851,"_20535":115176,"_5":14089,"_26896":114860,"_2860":115177},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3374":68967,"_29561":68851,"_20535":115179,"_5":14089,"_26896":114864,"_2860":115180},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3374":68968,"_29561":68851,"_20535":115182,"_5":14089,"_26896":114864,"_2860":115183},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3374":68969,"_29561":68851,"_20535":115185,"_5":14089,"_26896":114864,"_2860":115186},[],"acceso completo y de solo lectura a KMS;",{"_3374":68970,"_29561":68851,"_20535":115188,"_5":14089,"_26896":114864,"_2860":115189},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3374":68971,"_29561":68851,"_20535":115191,"_5":14089,"_26896":114864,"_2860":115192},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3374":68972,"_29561":68851,"_20535":115194,"_5":14089,"_26896":114864,"_2860":115195},[],"acceso a la interfaz;",{"_3374":68973,"_29561":68851,"_20535":115197,"_5":14089,"_26896":114864,"_2860":115198},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3374":68974,"_29561":68851,"_20535":115200,"_5":14089,"_26896":114864,"_2860":115201},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3374":68975,"_29561":68851,"_20535":115203,"_5":14089,"_26896":114864,"_2860":115204},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3374":68976,"_29561":68851,"_20535":115206,"_5":14089,"_26896":114868,"_2860":115207},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3374":68977,"_29561":68851,"_20535":115209,"_5":14089,"_26896":114868,"_2860":115210},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3374":68978,"_29561":68851,"_20535":115212,"_5":14089,"_26896":114868,"_2860":115213},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3374":68979,"_29561":68851,"_20535":115215,"_5":14089,"_26896":114871,"_2860":115216},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3374":68980,"_29561":68851,"_20535":115218,"_5":14089,"_26896":114875,"_2860":115219},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3374":68981,"_29561":68851,"_20535":115221,"_5":14089,"_26896":114875,"_2860":115222},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3374":68982,"_29561":68851,"_20535":115224,"_5":14089,"_26896":114879,"_2860":115225},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3374":68983,"_29561":68851,"_20535":115227,"_5":14089,"_26896":114883,"_2860":115228},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3374":68984,"_29561":68851,"_20535":115230,"_5":14089,"_26896":114887,"_2860":115231},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3374":68985,"_29561":68851,"_20535":115233,"_5":14089,"_26896":114891,"_2860":115234},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3374":68986,"_29561":68851,"_20535":115236,"_5":14089,"_26896":114891,"_2860":115237},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3374":68987,"_29561":68851,"_20535":115239,"_5":14089,"_26896":114895,"_2860":115240},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3374":68988,"_29561":68851,"_20535":115242,"_5":14089,"_26896":114895,"_2860":115243},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3374":68989,"_29561":68851,"_20535":115245,"_5":14089,"_26896":114895,"_2860":115246},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3374":68990,"_29561":68851,"_20535":115248,"_5":14089,"_26896":114895,"_2860":115249},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3374":68991,"_29561":68851,"_20535":115251,"_5":14089,"_26896":114895,"_2860":115252},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3374":68992,"_29561":68851,"_20535":115254,"_5":14089,"_26896":114895,"_2860":115255},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3374":68993,"_29561":68851,"_20535":115257,"_5":14089,"_26896":114895,"_2860":115258},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3374":68994,"_29561":68851,"_20535":115260,"_5":14089,"_26896":114895,"_2860":115261},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3374":68995,"_29561":68851,"_20535":115263,"_5":14089,"_26896":114899,"_2860":115264},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3374":68996,"_29561":68851,"_20535":115266,"_5":14089,"_26896":114899,"_2860":115267},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3374":68997,"_29561":68851,"_20535":115269,"_5":14089,"_26896":114899,"_2860":115270},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3374":68998,"_29561":68851,"_20535":115272,"_5":14089,"_26896":114903,"_2860":115273},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3374":68999,"_29561":68851,"_20535":115275,"_5":14089,"_26896":114903,"_2860":115276},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3374":69000,"_29561":68851,"_20535":115278,"_5":14089,"_26896":114903,"_2860":115279},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3374":69001,"_29561":68851,"_20535":115281,"_5":14089,"_26896":114903,"_2860":115282},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3374":69002,"_29561":68851,"_20535":115284,"_5":14089,"_26896":114903,"_2860":115285},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3374":69003,"_29561":68851,"_20535":115287,"_5":14089,"_26896":114903,"_2860":115288},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3374":69004,"_29561":68851,"_20535":115290,"_5":14089,"_26896":114903,"_2860":115291},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3374":69005,"_29561":68851,"_20535":115293,"_5":14089,"_26896":114903,"_2860":115294},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3374":69006,"_29561":68851,"_20535":115296,"_5":14089,"_26896":114911,"_2860":115297},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3374":69007,"_29561":68851,"_20535":115299,"_5":14089,"_26896":114915,"_2860":115300},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3374":69008,"_29561":68851,"_20535":115302,"_5":14089,"_26896":114915,"_2860":115303},[],"que exista un principal activo del tipo correcto;",{"_3374":69009,"_29561":68851,"_20535":115305,"_5":14089,"_26896":114915,"_2860":115306},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3374":69010,"_29561":68851,"_20535":115308,"_5":14089,"_26896":114915,"_2860":115309},[],"que todas las condiciones del principal se cumplan;",{"_3374":69011,"_29561":68851,"_20535":115311,"_5":14089,"_26896":114915,"_2860":115312},[],"que el principal tenga concedida la política esperada;",{"_3374":69012,"_29561":68851,"_20535":115314,"_5":14089,"_26896":114915,"_2860":115315},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3374":69013,"_29561":68851,"_20535":115317,"_5":14089,"_26896":114915,"_2860":115318},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3374":69014,"_29561":68851,"_20535":115320,"_5":14089,"_26896":114915,"_2860":115321},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3374":69015,"_29561":68851,"_20535":115323,"_5":14089,"_26896":114919,"_2860":115324},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3374":69016,"_29561":68851,"_20535":115326,"_5":14089,"_26896":114923,"_2860":115327},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3374":69017,"_29561":68851,"_20535":115329,"_5":14089,"_26896":114927,"_2860":115330},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3374":69018,"_29561":68851,"_20535":115332,"_5":14089,"_26896":114927,"_2860":115333},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3374":69019,"_29561":69019,"_5":14447,"_2860":115335,"_29893":115336,"_20535":115337,"_26896":69019},"Alertas y suscripciones",[48107,114800,114801],[],{"_3374":69020,"_29561":69019,"_20535":115339,"_5":14089,"_26896":69019,"_2860":115340},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3374":69021,"_29561":69019,"_5":29890,"_20535":115342,"_26896":115343,"_2860":115344},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3374":69022,"_29561":69019,"_5":29890,"_20535":115346,"_26896":115347,"_2860":115348},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3374":69023,"_29561":69019,"_5":29890,"_20535":115350,"_26896":115351,"_2860":115352},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3374":69024,"_29561":69019,"_5":29890,"_20535":115354,"_26896":115355,"_2860":115356},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3374":69025,"_29561":69019,"_5":29890,"_20535":115358,"_26896":115359,"_2860":115360},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3374":69026,"_29561":69019,"_5":29890,"_20535":115362,"_26896":115363,"_2860":115364},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3374":69027,"_29561":69019,"_5":29890,"_20535":115366,"_26896":115367,"_2860":115368},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3374":69028,"_29561":69019,"_5":29890,"_20535":115370,"_26896":115371,"_2860":115372},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3374":69029,"_29561":69019,"_5":29890,"_20535":115374,"_26896":115375,"_2860":115376},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3374":69030,"_29561":69019,"_5":29890,"_20535":115378,"_26896":115379,"_2860":115380},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3374":69031,"_29561":69019,"_5":29890,"_20535":115382,"_26896":115383,"_2860":115384},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3374":69032,"_29561":69019,"_20535":115386,"_5":14089,"_26896":69019,"_2860":115387},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3374":69033,"_29561":69019,"_20535":115389,"_5":14089,"_26896":115343,"_2860":115390},[],"Un servicio publica un evento de dominio.",{"_3374":69034,"_29561":69019,"_20535":115392,"_5":14089,"_26896":115343,"_2860":115393},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3374":69035,"_29561":69019,"_20535":115395,"_5":14089,"_26896":115343,"_2860":115396},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3374":69036,"_29561":69019,"_20535":115398,"_5":14089,"_26896":115343,"_2860":115399},[],"Lamassu entrega el evento al canal configurado.",{"_3374":69037,"_29561":69019,"_20535":115401,"_5":14089,"_26896":115343,"_2860":115402},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3374":69038,"_29561":69019,"_20535":115404,"_5":14089,"_26896":115347,"_2860":115405},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3374":69039,"_29561":69019,"_20535":115407,"_5":14089,"_26896":115347,"_2860":115408},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3374":69040,"_29561":69019,"_20535":115410,"_5":14089,"_26896":115347,"_2860":115411},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3374":69041,"_29561":69019,"_20535":115413,"_5":14089,"_26896":115347,"_2860":115414},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3374":69042,"_29561":69019,"_20535":115416,"_5":14089,"_26896":115347,"_2860":115417},[],"`apikey_options` necesita `header` y `key`.",{"_3374":69043,"_29561":69019,"_20535":115419,"_5":14089,"_26896":115347,"_2860":115420},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3374":69044,"_29561":69019,"_20535":115422,"_5":14089,"_26896":115347,"_2860":115423},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3374":69045,"_29561":69019,"_20535":115425,"_5":14089,"_26896":115347,"_2860":115426},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3374":69046,"_29561":69019,"_20535":115428,"_5":14089,"_26896":115355,"_2860":115429},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3374":69047,"_29561":69019,"_20535":115431,"_5":14089,"_26896":115359,"_2860":115432},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3374":69048,"_29561":69019,"_20535":115434,"_5":14089,"_26896":115363,"_2860":115435},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3374":69049,"_29561":69019,"_20535":115437,"_5":14089,"_26896":115363,"_2860":115438},[],"**None** notifica todas las instancias del evento.",{"_3374":69050,"_29561":69019,"_20535":115440,"_5":14089,"_26896":115363,"_2860":115441},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3374":69051,"_29561":69019,"_20535":115443,"_5":14089,"_26896":115363,"_2860":115444},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3374":69052,"_29561":69019,"_20535":115446,"_5":14089,"_26896":115363,"_2860":115447},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3374":69053,"_29561":69019,"_20535":115449,"_5":14089,"_26896":115363,"_2860":115450},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3374":69054,"_29561":69019,"_20535":115452,"_5":14089,"_26896":115363,"_2860":115453},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3374":69055,"_29561":69019,"_20535":115455,"_5":14089,"_26896":115367,"_2860":115456},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3374":69056,"_29561":69019,"_20535":115458,"_5":14089,"_26896":115371,"_2860":115459},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3374":69057,"_29561":69019,"_20535":115461,"_5":14089,"_26896":115371,"_2860":115462},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3374":69058,"_29561":69019,"_20535":115464,"_5":14089,"_26896":115371,"_2860":115465},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3374":69059,"_29561":69019,"_20535":115467,"_5":14089,"_26896":115371,"_2860":115468},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3374":69060,"_29561":69019,"_20535":115470,"_5":14089,"_26896":115371,"_2860":115471},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3374":69061,"_29561":69019,"_20535":115473,"_5":14089,"_26896":115371,"_2860":115474},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3374":69062,"_29561":69019,"_20535":115476,"_5":14089,"_26896":115371,"_2860":115477},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3374":69063,"_29561":69019,"_20535":115479,"_5":14089,"_26896":115371,"_2860":115480},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3374":69064,"_29561":69019,"_20535":115482,"_5":14089,"_26896":115375,"_2860":115483},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3374":69065,"_29561":69019,"_20535":115485,"_5":14089,"_26896":115375,"_2860":115486},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3374":69066,"_29561":69019,"_20535":115488,"_5":14089,"_26896":115375,"_2860":115489},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3374":69067,"_29561":69019,"_20535":115491,"_5":14089,"_26896":115375,"_2860":115492},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3374":69068,"_29561":69019,"_20535":115494,"_5":14089,"_26896":115375,"_2860":115495},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3374":69069,"_29561":69019,"_20535":115497,"_5":14089,"_26896":115375,"_2860":115498},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3374":69070,"_29561":69019,"_20535":115500,"_5":14089,"_26896":115375,"_2860":115501},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3374":69071,"_29561":69019,"_20535":115503,"_5":14089,"_26896":115375,"_2860":115504},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3374":69072,"_29561":69019,"_20535":115506,"_5":14089,"_26896":115379,"_2860":115507},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3374":69073,"_29561":69019,"_20535":115509,"_5":14089,"_26896":115379,"_2860":115510},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3374":69074,"_29561":69019,"_20535":115512,"_5":14089,"_26896":115383,"_2860":115513},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3374":69075,"_29561":69019,"_20535":115515,"_5":14089,"_26896":115383,"_2860":115516},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3374":69076,"_29561":69019,"_20535":115518,"_5":14089,"_26896":115383,"_2860":115519},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3374":69077,"_29561":69019,"_20535":115521,"_5":14089,"_26896":115383,"_2860":115522},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3374":69078,"_29561":69019,"_20535":115524,"_5":14089,"_26896":115383,"_2860":115525},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3374":69079,"_29561":69019,"_20535":115527,"_5":14089,"_26896":115383,"_2860":115528},[],"**Validación:** `va.role.crl.create`.",{"_3374":69080,"_29561":69019,"_20535":115530,"_5":14089,"_26896":115383,"_2860":115531},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3374":69081,"_29561":69019,"_20535":115533,"_5":14089,"_26896":115383,"_2860":115534},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3374":69082,"_29561":69082,"_5":14447,"_2860":115536,"_29893":115537,"_20535":115538,"_26896":69082},"Registros de auditoría",[48107,114800,114801],[],{"_3374":69083,"_29561":69082,"_20535":115540,"_5":14089,"_26896":69082,"_2860":115541},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3374":69084,"_29561":69082,"_5":29890,"_20535":115543,"_26896":115544,"_2860":115545},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3374":69085,"_29561":69082,"_5":29890,"_20535":115547,"_26896":115548,"_2860":115549},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3374":69086,"_29561":69082,"_5":29890,"_20535":115551,"_26896":115552,"_2860":115553},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3374":69087,"_29561":69082,"_5":29890,"_20535":115555,"_26896":115556,"_2860":115557},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3374":69088,"_29561":69082,"_5":29890,"_20535":115559,"_26896":115560,"_2860":115561},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3374":69089,"_29561":69082,"_5":29890,"_20535":115563,"_26896":115564,"_2860":115565},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3374":69090,"_29561":69082,"_5":29890,"_20535":115567,"_26896":115568,"_2860":115569},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3374":69091,"_29561":69082,"_5":29890,"_20535":115571,"_26896":115572,"_2860":115573},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3374":69092,"_29561":69082,"_5":29890,"_20535":115575,"_26896":115576,"_2860":115577},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3374":69093,"_29561":69082,"_5":29890,"_20535":115579,"_26896":115580,"_2860":115581},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3374":69094,"_29561":69082,"_5":29890,"_20535":115583,"_26896":115584,"_2860":115585},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3374":69095,"_29561":69082,"_20535":115587,"_5":14089,"_26896":69082,"_2860":115588},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3374":69096,"_29561":69082,"_20535":115590,"_5":14089,"_26896":115544,"_2860":115591},[],"El cuerpo de auditoría incluye:",{"_3374":69097,"_29561":69082,"_20535":115593,"_5":14089,"_26896":115544,"_2860":115594},[],"input: datos recibidos por la operación;",{"_3374":69098,"_29561":69082,"_20535":115596,"_5":14089,"_26896":115544,"_2860":115597},[],"has\\_error: indica si el servicio devolvió un error;",{"_3374":69099,"_29561":69082,"_20535":115599,"_5":14089,"_26896":115544,"_2860":115600},[],"output: resultado producido o mensaje de error;",{"_3374":69100,"_29561":69082,"_20535":115602,"_5":14089,"_26896":115544,"_2860":115603},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3374":69101,"_29561":69082,"_20535":115605,"_5":14089,"_26896":115544,"_2860":115606},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3374":69102,"_29561":69082,"_20535":115608,"_5":14089,"_26896":115544,"_2860":115609},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3374":69103,"_29561":69082,"_20535":115611,"_5":14089,"_26896":115548,"_2860":115612},[],"El backend aplica auditoría a mutaciones de:",{"_3374":69104,"_29561":69082,"_20535":115614,"_5":14089,"_26896":115548,"_2860":115615},[],"autoridades, certificados y perfiles de emisión;",{"_3374":69105,"_29561":69082,"_20535":115617,"_5":14089,"_26896":115548,"_2860":115618},[],"claves y motores KMS;",{"_3374":69106,"_29561":69082,"_20535":115620,"_5":14089,"_26896":115548,"_2860":115621},[],"dispositivos e identidades;",{"_3374":69107,"_29561":69082,"_20535":115623,"_5":14089,"_26896":115548,"_2860":115624},[],"DMS y operaciones de enrolamiento;",{"_3374":69108,"_29561":69082,"_20535":115626,"_5":14089,"_26896":115548,"_2860":115627},[],"funciones de validación y CRL;",{"_3374":69109,"_29561":69082,"_20535":115629,"_5":14089,"_26896":115548,"_2860":115630},[],"principales, políticas y concesiones de autorización.",{"_3374":69110,"_29561":69082,"_20535":115632,"_5":14089,"_26896":115548,"_2860":115633},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3374":69111,"_29561":69082,"_20535":115635,"_5":14089,"_26896":115552,"_2860":115636},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3374":69112,"_29561":69082,"_20535":115638,"_5":14089,"_26896":115552,"_2860":115639},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3374":69113,"_29561":69082,"_20535":115641,"_5":14089,"_26896":115552,"_2860":115642},[],"Diseña el consumidor para:",{"_3374":69114,"_29561":69082,"_20535":115644,"_5":14089,"_26896":115552,"_2860":115645},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3374":69115,"_29561":69082,"_20535":115647,"_5":14089,"_26896":115552,"_2860":115648},[],"conservar el CloudEvent completo sin modificar;",{"_3374":69116,"_29561":69082,"_20535":115650,"_5":14089,"_26896":115552,"_2860":115651},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3374":69117,"_29561":69082,"_20535":115653,"_5":14089,"_26896":115552,"_2860":115654},[],"cifrar en tránsito y en reposo;",{"_3374":69118,"_29561":69082,"_20535":115656,"_5":14089,"_26896":115552,"_2860":115657},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3374":69119,"_29561":69082,"_20535":115659,"_5":14089,"_26896":115552,"_2860":115660},[],"aplicar una política explícita de retención y legal hold;",{"_3374":69120,"_29561":69082,"_20535":115662,"_5":14089,"_26896":115552,"_2860":115663},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3374":69121,"_29561":69082,"_20535":115665,"_5":14089,"_26896":115556,"_2860":115666},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3374":69122,"_29561":69082,"_20535":115668,"_5":14089,"_26896":115556,"_2860":115669},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3374":69123,"_29561":69082,"_20535":115671,"_5":14089,"_26896":115564,"_2860":115672},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3374":69124,"_29561":69082,"_20535":115674,"_5":14089,"_26896":115568,"_2860":115675},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3374":69125,"_29561":69082,"_20535":115677,"_5":14089,"_26896":115572,"_2860":115678},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3374":69126,"_29561":69082,"_20535":115680,"_5":14089,"_26896":115576,"_2860":115681},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3374":69127,"_29561":69082,"_20535":115683,"_5":14089,"_26896":115580,"_2860":115684},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3374":69128,"_29561":69082,"_20535":115686,"_5":14089,"_26896":115584,"_2860":115687},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3374":69129,"_29561":69082,"_20535":115689,"_5":14089,"_26896":115584,"_2860":115690},[],"aparece un evento de auditoría correcto;",{"_3374":69130,"_29561":69082,"_20535":115692,"_5":14089,"_26896":115584,"_2860":115693},[],"el principal coincide con la identidad utilizada;",{"_3374":69131,"_29561":69082,"_20535":115695,"_5":14089,"_26896":115584,"_2860":115696},[],"el consumidor lo persiste una sola vez;",{"_3374":69132,"_29561":69082,"_20535":115698,"_5":14089,"_26896":115584,"_2860":115699},[],"puede recuperarse por recurso, actor y periodo;",{"_3374":69133,"_29561":69082,"_20535":115701,"_5":14089,"_26896":115584,"_2860":115702},[],"una interrupción del consumidor produce una alerta.",{"_3374":69134,"_29561":69082,"_20535":115704,"_5":14089,"_26896":115584,"_2860":115705},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3374":69135,"_29561":69135,"_5":14447,"_2860":115707,"_29893":115708,"_20535":115709,"_26896":69135},"Arquitectura de la plataforma",[48107,114800],[],{"_3374":69136,"_29561":69135,"_20535":115711,"_5":14089,"_26896":69135,"_2860":115712},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3374":69137,"_29561":69135,"_5":29890,"_20535":115714,"_26896":115715,"_2860":115716},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3374":69138,"_29561":69135,"_5":29890,"_20535":115718,"_26896":115719,"_2860":115720},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3374":69139,"_29561":69135,"_5":29890,"_20535":115722,"_26896":115723,"_2860":115724},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3374":69140,"_29561":69135,"_5":29890,"_20535":115726,"_26896":115727,"_2860":115728},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3374":69141,"_29561":69135,"_5":29890,"_20535":115730,"_26896":115731,"_2860":115732},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3374":69142,"_29561":69135,"_20535":115734,"_5":14089,"_26896":69135,"_2860":115735},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3374":69143,"_29561":69135,"_20535":115737,"_5":14089,"_26896":69135,"_2860":115738},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3374":69144,"_29561":69135,"_20535":115740,"_5":14089,"_26896":115715,"_2860":115741},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3374":69145,"_29561":69135,"_20535":115743,"_5":14089,"_26896":115719,"_2860":115744},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3374":69146,"_29561":69135,"_20535":115746,"_5":14089,"_26896":115723,"_2860":115747},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3374":69147,"_29561":69135,"_20535":115749,"_5":14089,"_26896":115727,"_2860":115750},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3374":69148,"_29561":69135,"_20535":115752,"_5":14089,"_26896":115731,"_2860":115753},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3374":69149,"_29561":69149,"_5":14447,"_2860":115755,"_29893":115756,"_20535":115757,"_26896":69149},"Cómo funciona Lamassu",[48107,114800],[],{"_3374":69150,"_29561":69149,"_20535":115759,"_5":14089,"_26896":69149,"_2860":115760},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3374":69151,"_29561":69149,"_5":29890,"_20535":115762,"_26896":115763,"_2860":115764},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3374":69152,"_29561":69149,"_5":29890,"_20535":115766,"_26896":115767,"_2860":115768},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3374":69153,"_29561":69149,"_20535":115770,"_5":14089,"_26896":69149,"_2860":115771},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3374":69154,"_29561":69149,"_20535":115773,"_5":14089,"_26896":115763,"_2860":115774},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3374":69155,"_29561":69149,"_20535":115776,"_5":14089,"_26896":115763,"_2860":115777},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3374":69156,"_29561":69149,"_20535":115779,"_5":14089,"_26896":115763,"_2860":115780},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3374":69157,"_29561":69149,"_20535":115782,"_5":14089,"_26896":115763,"_2860":115783},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3374":69158,"_29561":69149,"_20535":115785,"_5":14089,"_26896":115763,"_2860":115786},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3374":69159,"_29561":69149,"_20535":115788,"_5":14089,"_26896":115767,"_2860":115789},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3374":69160,"_29561":69149,"_20535":115791,"_5":14089,"_26896":115767,"_2860":115792},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3374":69161,"_29561":69149,"_20535":115794,"_5":14089,"_26896":115767,"_2860":115795},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3374":69162,"_29561":69149,"_20535":115797,"_5":14089,"_26896":115767,"_2860":115798},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3374":69163,"_29561":69149,"_20535":115800,"_5":14089,"_26896":115767,"_2860":115801},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3374":69164,"_29561":69149,"_20535":115803,"_5":14089,"_26896":115767,"_2860":115804},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3374":69165,"_29561":69149,"_20535":115806,"_5":14089,"_26896":115767,"_2860":115807},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3374":69166,"_29561":69166,"_5":14447,"_2860":115809,"_29893":115810,"_20535":115811,"_26896":69166},"Dispositivos e identidades",[48107,114800,50586,115809],[],{"_3374":69167,"_29561":69166,"_20535":115813,"_5":14089,"_26896":69166,"_2860":115814},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3374":69168,"_29561":69166,"_5":29890,"_20535":115816,"_26896":115817,"_2860":115818},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3374":69169,"_29561":69166,"_5":29890,"_20535":115820,"_26896":115821,"_2860":115822},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3374":69170,"_29561":69166,"_5":29890,"_20535":115824,"_26896":115825,"_2860":115826},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3374":69171,"_29561":69166,"_5":29890,"_20535":115828,"_26896":115829,"_2860":115830},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3374":69172,"_29561":69166,"_5":29890,"_20535":115832,"_26896":115833,"_2860":115834},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3374":69173,"_29561":69166,"_5":29890,"_20535":115836,"_26896":115837,"_2860":115838},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3374":69174,"_29561":69166,"_5":29890,"_20535":115840,"_26896":115841,"_2860":115842},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3374":69175,"_29561":69166,"_5":29890,"_20535":115844,"_26896":115845,"_2860":115846},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3374":69176,"_29561":69166,"_5":29890,"_20535":115848,"_26896":115849,"_2860":115850},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3374":69177,"_29561":69166,"_5":29890,"_20535":115852,"_26896":115853,"_2860":115854},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3374":69178,"_29561":69166,"_5":29890,"_20535":115856,"_26896":115857,"_2860":115858},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3374":69179,"_29561":69166,"_20535":115860,"_5":14089,"_26896":69166,"_2860":115861},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3374":69180,"_29561":69166,"_20535":115863,"_5":14089,"_26896":69166,"_2860":115864},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3374":69181,"_29561":69166,"_20535":115866,"_5":14089,"_26896":115817,"_2860":115867},[],"Vista operativa",{"_3374":69182,"_29561":69166,"_20535":115869,"_5":14089,"_26896":115817,"_2860":115870},[],"Interpretación",{"_3374":69183,"_29561":69166,"_20535":115872,"_5":14089,"_26896":115817,"_2860":50649},[],{"_3374":69184,"_29561":69166,"_20535":115874,"_5":14089,"_26896":115817,"_2860":115875},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3374":69185,"_29561":69166,"_20535":115877,"_5":14089,"_26896":115817,"_2860":50655},[],{"_3374":69186,"_29561":69166,"_20535":115879,"_5":14089,"_26896":115817,"_2860":115880},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3374":69187,"_29561":69166,"_20535":115882,"_5":14089,"_26896":115817,"_2860":50661},[],{"_3374":69188,"_29561":69166,"_20535":115884,"_5":14089,"_26896":115817,"_2860":115885},[],"La identidad está en la ventana operativa de renovación.",{"_3374":69189,"_29561":69166,"_20535":115887,"_5":14089,"_26896":115817,"_2860":50667},[],{"_3374":69190,"_29561":69166,"_20535":115889,"_5":14089,"_26896":115817,"_2860":115890},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3374":69191,"_29561":69166,"_20535":115892,"_5":14089,"_26896":115817,"_2860":50673},[],{"_3374":69192,"_29561":69166,"_20535":115894,"_5":14089,"_26896":115817,"_2860":115895},[],"La identidad ha vencido.",{"_3374":69193,"_29561":69166,"_20535":115897,"_5":14089,"_26896":115817,"_2860":50679},[],{"_3374":69194,"_29561":69166,"_20535":115899,"_5":14089,"_26896":115817,"_2860":115900},[],"La identidad está marcada como revocada.",{"_3374":69195,"_29561":69166,"_20535":115902,"_5":14089,"_26896":115817,"_2860":50685},[],{"_3374":69196,"_29561":69166,"_20535":115904,"_5":14089,"_26896":115817,"_2860":115905},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3374":69197,"_29561":69166,"_20535":115907,"_5":14089,"_26896":115817,"_2860":115908},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3374":69198,"_29561":69166,"_20535":115910,"_5":14089,"_26896":115821,"_2860":115911},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3374":69199,"_29561":69166,"_20535":115913,"_5":14089,"_26896":115821,"_2860":115914},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3374":69200,"_29561":69166,"_20535":115916,"_5":14089,"_26896":115821,"_2860":115917},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3374":69201,"_29561":69166,"_20535":115919,"_5":14089,"_26896":115821,"_2860":115920},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3374":69202,"_29561":69166,"_20535":115922,"_5":14089,"_26896":115825,"_2860":115923},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3374":69203,"_29561":69166,"_20535":115925,"_5":14089,"_26896":115829,"_2860":115926},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3374":69204,"_29561":69166,"_20535":115928,"_5":14089,"_26896":115833,"_2860":115929},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3374":69205,"_29561":69166,"_20535":115931,"_5":14089,"_26896":115837,"_2860":115932},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3374":69206,"_29561":69166,"_20535":115934,"_5":14089,"_26896":115841,"_2860":115935},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3374":69207,"_29561":69166,"_20535":115937,"_5":14089,"_26896":115841,"_2860":115938},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3374":69208,"_29561":69166,"_20535":115940,"_5":14089,"_26896":115845,"_2860":115941},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3374":69209,"_29561":69166,"_20535":115943,"_5":14089,"_26896":115845,"_2860":115944},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3374":69210,"_29561":69166,"_20535":115946,"_5":14089,"_26896":115845,"_2860":115947},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3374":69211,"_29561":69166,"_20535":115949,"_5":14089,"_26896":115845,"_2860":115950},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3374":69212,"_29561":69166,"_20535":115952,"_5":14089,"_26896":115845,"_2860":115953},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3374":69213,"_29561":69166,"_20535":115955,"_5":14089,"_26896":115845,"_2860":115956},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3374":69214,"_29561":69166,"_20535":115958,"_5":14089,"_26896":115849,"_2860":115959},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3374":69215,"_29561":69166,"_20535":115961,"_5":14089,"_26896":115849,"_2860":115962},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3374":69216,"_29561":69166,"_20535":115964,"_5":14089,"_26896":115853,"_2860":115965},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3374":69217,"_29561":69166,"_20535":115967,"_5":14089,"_26896":115853,"_2860":115968},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3374":69218,"_29561":69166,"_20535":115970,"_5":14089,"_26896":115853,"_2860":115971},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3374":69219,"_29561":69166,"_20535":115973,"_5":14089,"_26896":115853,"_2860":115974},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3374":69220,"_29561":69166,"_20535":115976,"_5":14089,"_26896":115857,"_2860":115977},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3374":69221,"_29561":69166,"_20535":115979,"_5":14089,"_26896":115857,"_2860":115980},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3374":69222,"_29561":69222,"_5":14447,"_2860":115982,"_29893":115983,"_20535":115985,"_26896":69222},"Identidad inicial y autenticación",[48107,114800,50586,115809,115984],"Enrolamiento con PKI",[],{"_3374":69223,"_29561":69222,"_20535":115987,"_5":14089,"_26896":69222,"_2860":115988},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3374":69224,"_29561":69222,"_5":29890,"_20535":115990,"_26896":115991,"_2860":115992},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3374":69225,"_29561":69222,"_5":29890,"_20535":115994,"_26896":115995,"_2860":115996},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3374":69226,"_29561":69222,"_5":29890,"_20535":115998,"_26896":115999,"_2860":116000},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3374":69227,"_29561":69222,"_5":29890,"_20535":116002,"_26896":116003,"_2860":116004},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3374":69228,"_29561":69222,"_5":29890,"_20535":116006,"_26896":116007,"_2860":116008},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3374":69229,"_29561":69222,"_20535":116010,"_5":14089,"_26896":69222,"_2860":116011},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3374":69230,"_29561":69222,"_20535":116013,"_5":14089,"_26896":115991,"_2860":116014},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3374":69231,"_29561":69222,"_20535":116016,"_5":14089,"_26896":115991,"_2860":116017},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3374":69232,"_29561":69222,"_20535":116019,"_5":14089,"_26896":115995,"_2860":116020},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3374":69233,"_29561":69222,"_20535":116022,"_5":14089,"_26896":115995,"_2860":116023},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3374":69234,"_29561":69222,"_20535":116025,"_5":14089,"_26896":115995,"_2860":116026},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3374":69235,"_29561":69222,"_20535":116028,"_5":14089,"_26896":115999,"_2860":116029},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3374":69236,"_29561":69222,"_20535":116031,"_5":14089,"_26896":115999,"_2860":116032},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3374":69237,"_29561":69222,"_20535":116034,"_5":14089,"_26896":116003,"_2860":116035},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3374":69238,"_29561":69222,"_20535":116037,"_5":14089,"_26896":116003,"_2860":116038},[],"Ejemplo de cuerpo:",{"_3374":69239,"_29561":69222,"_20535":116040,"_5":14089,"_26896":116003,"_2860":116041},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3374":69240,"_29561":69222,"_20535":116043,"_5":14089,"_26896":116003,"_2860":116044},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3374":69241,"_29561":69222,"_20535":116046,"_5":14089,"_26896":116003,"_2860":116047},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3374":69242,"_29561":69222,"_20535":116049,"_5":14089,"_26896":116003,"_2860":116050},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3374":69243,"_29561":69222,"_20535":116052,"_5":14089,"_26896":116007,"_2860":116053},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3374":69244,"_29561":69222,"_20535":116055,"_5":14089,"_26896":116007,"_2860":116056},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3374":69245,"_29561":69245,"_5":14447,"_2860":116058,"_29893":116059,"_20535":116060,"_26896":69245},"Configura y opera el DMS",[48107,114800,50586,115809,115984],[],{"_3374":69246,"_29561":69245,"_20535":116062,"_5":14089,"_26896":69245,"_2860":116063},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3374":69247,"_29561":69245,"_5":29890,"_20535":116065,"_26896":116066,"_2860":113378},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3374":69248,"_29561":69245,"_5":29890,"_20535":116068,"_26896":116069,"_2860":116070},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3374":69249,"_29561":69245,"_5":29890,"_20535":116072,"_26896":116073,"_2860":116074},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3374":69250,"_29561":69245,"_5":29890,"_20535":116076,"_26896":116077,"_2860":116078},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3374":69251,"_29561":69245,"_5":29890,"_20535":116080,"_26896":116081,"_2860":116082},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3374":69252,"_29561":69245,"_5":29890,"_20535":116084,"_26896":116085,"_2860":116086},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3374":69253,"_29561":69245,"_5":29890,"_20535":116088,"_26896":116089,"_2860":116090},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3374":69254,"_29561":69245,"_5":29890,"_20535":116092,"_26896":116093,"_2860":116094},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3374":69255,"_29561":69245,"_5":29890,"_20535":116096,"_26896":116097,"_2860":50881},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3374":69256,"_29561":69245,"_5":29890,"_20535":116099,"_26896":116100,"_2860":50885},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3374":69257,"_29561":69245,"_5":29890,"_20535":116102,"_26896":116103,"_2860":116104},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3374":69258,"_29561":69245,"_5":29890,"_20535":116106,"_26896":116107,"_2860":116108},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3374":69259,"_29561":69245,"_5":29890,"_20535":116110,"_26896":116111,"_2860":116112},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3374":69260,"_29561":69245,"_5":29890,"_20535":116114,"_26896":116115,"_2860":116116},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3374":69261,"_29561":69245,"_5":29890,"_20535":116118,"_26896":116119,"_2860":50905},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3374":69262,"_29561":69245,"_5":29890,"_20535":116121,"_26896":116122,"_2860":116123},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3374":69263,"_29561":69245,"_5":29890,"_20535":116125,"_26896":116126,"_2860":116127},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3374":69264,"_29561":69245,"_5":29890,"_20535":116129,"_26896":116130,"_2860":116131},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3374":69265,"_29561":69245,"_20535":116133,"_5":14089,"_26896":69245,"_2860":116134},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3374":69266,"_29561":69245,"_20535":116136,"_5":14089,"_26896":116066,"_2860":116137},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3374":69267,"_29561":69245,"_20535":116139,"_5":14089,"_26896":116066,"_2860":116140},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3374":69268,"_29561":69245,"_20535":116142,"_5":14089,"_26896":116073,"_2860":116143},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3374":69269,"_29561":69245,"_20535":116145,"_5":14089,"_26896":116077,"_2860":116146},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3374":69270,"_29561":69245,"_20535":116148,"_5":14089,"_26896":116081,"_2860":116149},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3374":69271,"_29561":69245,"_20535":116151,"_5":14089,"_26896":116085,"_2860":116152},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3374":69272,"_29561":69245,"_20535":116154,"_5":14089,"_26896":116089,"_2860":116155},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3374":69273,"_29561":69245,"_20535":116157,"_5":14089,"_26896":116097,"_2860":116158},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3374":69274,"_29561":69245,"_20535":116160,"_5":14089,"_26896":116097,"_2860":116161},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3374":69275,"_29561":69245,"_20535":116163,"_5":14089,"_26896":116100,"_2860":116164},[],"Campo de `settings.enrollment_settings`",{"_3374":69276,"_29561":69245,"_20535":116166,"_5":14089,"_26896":116100,"_2860":116167},[],"Decisión",{"_3374":69277,"_29561":69245,"_20535":116169,"_5":14089,"_26896":116100,"_2860":50956},[],{"_3374":69278,"_29561":69245,"_20535":116171,"_5":14089,"_26896":116100,"_2860":116172},[],"`EST_RFC7030` para estas operaciones.",{"_3374":69279,"_29561":69245,"_20535":116174,"_5":14089,"_26896":116100,"_2860":50962},[],{"_3374":69280,"_29561":69245,"_20535":116176,"_5":14089,"_26896":116100,"_2860":116177},[],"ID de la CA que firmará.",{"_3374":69281,"_29561":69245,"_20535":116179,"_5":14089,"_26896":116100,"_2860":50968},[],{"_3374":69282,"_29561":69245,"_20535":116181,"_5":14089,"_26896":116100,"_2860":116182},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3374":69283,"_29561":69245,"_20535":116184,"_5":14089,"_26896":116100,"_2860":50974},[],{"_3374":69284,"_29561":69245,"_20535":116186,"_5":14089,"_26896":116100,"_2860":116187},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3374":69285,"_29561":69245,"_20535":116189,"_5":14089,"_26896":116100,"_2860":50980},[],{"_3374":69286,"_29561":69245,"_20535":116191,"_5":14089,"_26896":116100,"_2860":116192},[],"Uno de los cuatro modos de autenticación.",{"_3374":69287,"_29561":69245,"_20535":116194,"_5":14089,"_26896":116100,"_2860":116195},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3374":69288,"_29561":69245,"_20535":116197,"_5":14089,"_26896":116103,"_2860":116198},[],"Los bloques son independientes:",{"_3374":69289,"_29561":69245,"_20535":116200,"_5":14089,"_26896":116103,"_2860":116201},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3374":69290,"_29561":69245,"_20535":116203,"_5":14089,"_26896":116103,"_2860":116204},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3374":69291,"_29561":69245,"_20535":116206,"_5":14089,"_26896":116103,"_2860":50998},[],{"_3374":69292,"_29561":69245,"_20535":116208,"_5":14089,"_26896":116103,"_2860":116209},[],"Control aplicado en la operación configurada",{"_3374":69293,"_29561":69245,"_20535":116211,"_5":14089,"_26896":116103,"_2860":51004},[],{"_3374":69294,"_29561":69245,"_20535":116213,"_5":14089,"_26896":116103,"_2860":116214},[],"Validación del certificado presentado.",{"_3374":69295,"_29561":69245,"_20535":116216,"_5":14089,"_26896":116103,"_2860":51010},[],{"_3374":69296,"_29561":69245,"_20535":116218,"_5":14089,"_26896":116103,"_2860":116219},[],"Autorización del webhook configurado.",{"_3374":69297,"_29561":69245,"_20535":116221,"_5":14089,"_26896":116103,"_2860":51016},[],{"_3374":69298,"_29561":69245,"_20535":116223,"_5":14089,"_26896":116103,"_2860":116224},[],"Validación del certificado y, después, aprobación del webhook.",{"_3374":69299,"_29561":69245,"_20535":116226,"_5":14089,"_26896":116103,"_2860":51022},[],{"_3374":69300,"_29561":69245,"_20535":116228,"_5":14089,"_26896":116103,"_2860":116229},[],"Sin autenticación del solicitante por el DMS.",{"_3374":69301,"_29561":69245,"_20535":116231,"_5":14089,"_26896":116103,"_2860":116232},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3374":69302,"_29561":69245,"_20535":116234,"_5":14089,"_26896":116103,"_2860":116235},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3374":69303,"_29561":69245,"_20535":116237,"_5":14089,"_26896":116103,"_2860":116238},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3374":69304,"_29561":69245,"_20535":116240,"_5":14089,"_26896":116103,"_2860":116241},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3374":69305,"_29561":69245,"_20535":116243,"_5":14089,"_26896":116107,"_2860":116244},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3374":69306,"_29561":69245,"_20535":116246,"_5":14089,"_26896":116107,"_2860":116247},[],"Campo de `external_webhook_settings`",{"_3374":69307,"_29561":69245,"_20535":116249,"_5":14089,"_26896":116107,"_2860":116167},[],{"_3374":69308,"_29561":69245,"_20535":116251,"_5":14089,"_26896":116107,"_2860":51048},[],{"_3374":69309,"_29561":69245,"_20535":116253,"_5":14089,"_26896":116107,"_2860":116254},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3374":69310,"_29561":69245,"_20535":116256,"_5":14089,"_26896":116107,"_2860":51054},[],{"_3374":69311,"_29561":69245,"_20535":116258,"_5":14089,"_26896":116107,"_2860":116259},[],"`POST` o `PUT`; `POST` por defecto.",{"_3374":69312,"_29561":69245,"_20535":116261,"_5":14089,"_26896":116107,"_2860":51060},[],{"_3374":69313,"_29561":69245,"_20535":116263,"_5":14089,"_26896":116107,"_2860":116264},[],"Etiqueta usada en los logs del servicio.",{"_3374":69314,"_29561":69245,"_20535":116266,"_5":14089,"_26896":116107,"_2860":51066},[],{"_3374":69315,"_29561":69245,"_20535":116268,"_5":14089,"_26896":116107,"_2860":116269},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3374":69316,"_29561":69245,"_20535":116271,"_5":14089,"_26896":116107,"_2860":51072},[],{"_3374":69317,"_29561":69245,"_20535":116273,"_5":14089,"_26896":116107,"_2860":116274},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3374":69318,"_29561":69245,"_20535":116276,"_5":14089,"_26896":116107,"_2860":51078},[],{"_3374":69319,"_29561":69245,"_20535":116278,"_5":14089,"_26896":116107,"_2860":116279},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3374":69320,"_29561":69245,"_20535":116281,"_5":14089,"_26896":116107,"_2860":51084},[],{"_3374":69321,"_29561":69245,"_20535":116283,"_5":14089,"_26896":116107,"_2860":116284},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3374":69322,"_29561":69245,"_20535":116286,"_5":14089,"_26896":116107,"_2860":51090},[],{"_3374":69323,"_29561":69245,"_20535":116288,"_5":14089,"_26896":116107,"_2860":116289},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3374":69324,"_29561":69245,"_20535":116291,"_5":14089,"_26896":116107,"_2860":51096},[],{"_3374":69325,"_29561":69245,"_20535":116293,"_5":14089,"_26896":116107,"_2860":116294},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3374":69326,"_29561":69245,"_20535":116296,"_5":14089,"_26896":116107,"_2860":51102},[],{"_3374":69327,"_29561":69245,"_20535":116298,"_5":14089,"_26896":116107,"_2860":116299},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3374":69328,"_29561":69245,"_20535":116301,"_5":14089,"_26896":116107,"_2860":116302},[],"Reglas de esa configuración:",{"_3374":69329,"_29561":69245,"_20535":116304,"_5":14089,"_26896":116107,"_2860":116305},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3374":69330,"_29561":69245,"_20535":116307,"_5":14089,"_26896":116107,"_2860":116308},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3374":69331,"_29561":69245,"_20535":116310,"_5":14089,"_26896":116107,"_2860":116311},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3374":69332,"_29561":69245,"_20535":116313,"_5":14089,"_26896":116107,"_2860":116314},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3374":69333,"_29561":69245,"_20535":116316,"_5":14089,"_26896":116107,"_2860":116317},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3374":69334,"_29561":69245,"_20535":116319,"_5":14089,"_26896":116107,"_2860":116320},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3374":69335,"_29561":69245,"_20535":116322,"_5":14089,"_26896":116107,"_2860":116323},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3374":69336,"_29561":69245,"_20535":116325,"_5":14089,"_26896":116107,"_2860":116326},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3374":69337,"_29561":69245,"_20535":116328,"_5":14089,"_26896":116107,"_2860":116329},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3374":69338,"_29561":69245,"_20535":116331,"_5":14089,"_26896":116111,"_2860":116332},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3374":69339,"_29561":69245,"_20535":116334,"_5":14089,"_26896":116115,"_2860":116335},[],"Campo de `settings.reenrollment_settings`",{"_3374":69340,"_29561":69245,"_20535":116337,"_5":14089,"_26896":116115,"_2860":116338},[],"Función",{"_3374":69341,"_29561":69245,"_20535":116340,"_5":14089,"_26896":116115,"_2860":51146},[],{"_3374":69342,"_29561":69245,"_20535":116342,"_5":14089,"_26896":116115,"_2860":116343},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3374":69343,"_29561":69245,"_20535":116345,"_5":14089,"_26896":116115,"_2860":51152},[],{"_3374":69344,"_29561":69245,"_20535":116347,"_5":14089,"_26896":116115,"_2860":116348},[],"Umbral operativo preventivo de monitorización.",{"_3374":69345,"_29561":69245,"_20535":116350,"_5":14089,"_26896":116115,"_2860":51158},[],{"_3374":69346,"_29561":69245,"_20535":116352,"_5":14089,"_26896":116115,"_2860":116353},[],"Umbral operativo crítico de monitorización.",{"_3374":69347,"_29561":69245,"_20535":116355,"_5":14089,"_26896":116115,"_2860":51164},[],{"_3374":69348,"_29561":69245,"_20535":116357,"_5":14089,"_26896":116115,"_2860":116358},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3374":69349,"_29561":69245,"_20535":116360,"_5":14089,"_26896":116115,"_2860":51170},[],{"_3374":69350,"_29561":69245,"_20535":116362,"_5":14089,"_26896":116115,"_2860":116363},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3374":69351,"_29561":69245,"_20535":116365,"_5":14089,"_26896":116115,"_2860":51176},[],{"_3374":69352,"_29561":69245,"_20535":116367,"_5":14089,"_26896":116115,"_2860":116368},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3374":69353,"_29561":69245,"_20535":116370,"_5":14089,"_26896":116115,"_2860":116371},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3374":69354,"_29561":69245,"_20535":116373,"_5":14089,"_26896":116119,"_2860":116374},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3374":69355,"_29561":69245,"_20535":116376,"_5":14089,"_26896":116122,"_2860":113742},[],{"_3374":69356,"_29561":69245,"_20535":116378,"_5":14089,"_26896":116122,"_2860":116379},[],"Qué publica",{"_3374":69357,"_29561":69245,"_20535":116381,"_5":14089,"_26896":116122,"_2860":51193},[],{"_3374":69358,"_29561":69245,"_20535":116383,"_5":14089,"_26896":116122,"_2860":116384},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3374":69359,"_29561":69245,"_20535":116386,"_5":14089,"_26896":116122,"_2860":51199},[],{"_3374":69360,"_29561":69245,"_20535":116388,"_5":14089,"_26896":116122,"_2860":116389},[],"Certificado de la CA emisora seleccionada.",{"_3374":69361,"_29561":69245,"_20535":116391,"_5":14089,"_26896":116122,"_2860":51205},[],{"_3374":69362,"_29561":69245,"_20535":116393,"_5":14089,"_26896":116122,"_2860":116394},[],"Certificados de las CAs elegidas explícitamente.",{"_3374":69363,"_29561":69245,"_20535":116396,"_5":14089,"_26896":116122,"_2860":116397},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3374":69364,"_29561":69245,"_20535":116399,"_5":14089,"_26896":116126,"_2860":116400},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3374":69365,"_29561":69245,"_20535":116402,"_5":14089,"_26896":116126,"_2860":116403},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3374":69366,"_29561":69245,"_20535":116405,"_5":14089,"_26896":116126,"_2860":116406},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3374":69367,"_29561":69245,"_20535":116408,"_5":14089,"_26896":116130,"_2860":116409},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3374":69368,"_29561":69368,"_5":14447,"_2860":116411,"_29893":116412,"_20535":116413,"_26896":69368},"Integra el cliente EST",[48107,114800,50586,115809,115984],[],{"_3374":69369,"_29561":69368,"_20535":116415,"_5":14089,"_26896":69368,"_2860":116416},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3374":69370,"_29561":69368,"_5":29890,"_20535":116418,"_26896":116419,"_2860":113378},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3374":69371,"_29561":69368,"_5":29890,"_20535":116421,"_26896":116422,"_2860":116423},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3374":69372,"_29561":69368,"_5":29890,"_20535":116425,"_26896":116426,"_2860":116427},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3374":69373,"_29561":69368,"_5":29890,"_20535":116429,"_26896":116430,"_2860":116431},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3374":69374,"_29561":69368,"_5":29890,"_20535":116433,"_26896":116434,"_2860":116435},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3374":69375,"_29561":69368,"_5":29890,"_20535":116437,"_26896":116438,"_2860":116439},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3374":69376,"_29561":69368,"_20535":116441,"_5":14089,"_26896":69368,"_2860":116442},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3374":69377,"_29561":69368,"_20535":116444,"_5":14089,"_26896":116419,"_2860":116445},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3374":69378,"_29561":69368,"_20535":116447,"_5":14089,"_26896":116419,"_2860":116448},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3374":69379,"_29561":69368,"_20535":116450,"_5":14089,"_26896":116419,"_2860":116451},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3374":69380,"_29561":69368,"_20535":116453,"_5":14089,"_26896":116422,"_2860":116454},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3374":69381,"_29561":69368,"_20535":116456,"_5":14089,"_26896":116422,"_2860":116457},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3374":69382,"_29561":69368,"_20535":116459,"_5":14089,"_26896":116426,"_2860":116460},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3374":69383,"_29561":69368,"_20535":116462,"_5":14089,"_26896":116426,"_2860":116463},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3374":69384,"_29561":69368,"_20535":116465,"_5":14089,"_26896":116430,"_2860":116466},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3374":69385,"_29561":69368,"_20535":116468,"_5":14089,"_26896":116430,"_2860":116469},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3374":69386,"_29561":69368,"_20535":116471,"_5":14089,"_26896":116434,"_2860":116472},[],"Para el caso de una raíz que emite directamente:",{"_3374":69387,"_29561":69368,"_20535":116474,"_5":14089,"_26896":116434,"_2860":116475},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3374":69388,"_29561":69368,"_20535":116477,"_5":14089,"_26896":116434,"_2860":116478},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3374":69389,"_29561":69368,"_20535":116480,"_5":14089,"_26896":116438,"_2860":116481},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3374":69390,"_29561":69390,"_5":14447,"_2860":116483,"_29893":116484,"_20535":116485,"_26896":69390},"Referencia EST",[48107,114800,50586,115809,115984],[],{"_3374":69391,"_29561":69390,"_20535":116487,"_5":14089,"_26896":69390,"_2860":116488},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3374":69392,"_29561":69390,"_5":29890,"_20535":116490,"_26896":116491,"_2860":116492},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3374":69393,"_29561":69390,"_5":29890,"_20535":116494,"_26896":116495,"_2860":22263},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3374":69394,"_29561":69390,"_5":29890,"_20535":116497,"_26896":116498,"_2860":25543},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3374":69395,"_29561":69390,"_5":29890,"_20535":116500,"_26896":116501,"_2860":25550},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3374":69396,"_29561":69390,"_5":29890,"_20535":116503,"_26896":116504,"_2860":24878},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3374":69397,"_29561":69390,"_5":29890,"_20535":116506,"_26896":116507,"_2860":116508},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3374":69398,"_29561":69390,"_5":29890,"_20535":116510,"_26896":116511,"_2860":116512},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3374":69399,"_29561":69390,"_5":29890,"_20535":116514,"_26896":116515,"_2860":116516},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3374":69400,"_29561":69390,"_20535":116518,"_5":14089,"_26896":69390,"_2860":116519},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3374":69401,"_29561":69390,"_20535":116521,"_5":14089,"_26896":116491,"_2860":116522},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3374":69402,"_29561":69390,"_20535":116524,"_5":14089,"_26896":116491,"_2860":114560},[],{"_3374":69403,"_29561":69390,"_20535":116526,"_5":14089,"_26896":116491,"_2860":116527},[],"Método",{"_3374":69404,"_29561":69390,"_20535":116529,"_5":14089,"_26896":116491,"_2860":116530},[],"Autenticación y condición",{"_3374":69405,"_29561":69390,"_20535":116532,"_5":14089,"_26896":116491,"_2860":51348},[],{"_3374":69406,"_29561":69390,"_20535":116534,"_5":14089,"_26896":116491,"_2860":51351},[],{"_3374":69407,"_29561":69390,"_20535":116536,"_5":14089,"_26896":116491,"_2860":116537},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3374":69408,"_29561":69390,"_20535":116539,"_5":14089,"_26896":116491,"_2860":51357},[],{"_3374":69409,"_29561":69390,"_20535":116541,"_5":14089,"_26896":116491,"_2860":51360},[],{"_3374":69410,"_29561":69390,"_20535":116543,"_5":14089,"_26896":116491,"_2860":116544},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3374":69411,"_29561":69390,"_20535":116546,"_5":14089,"_26896":116491,"_2860":51366},[],{"_3374":69412,"_29561":69390,"_20535":116548,"_5":14089,"_26896":116491,"_2860":51360},[],{"_3374":69413,"_29561":69390,"_20535":116550,"_5":14089,"_26896":116491,"_2860":116551},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3374":69414,"_29561":69390,"_20535":116553,"_5":14089,"_26896":116491,"_2860":51374},[],{"_3374":69415,"_29561":69390,"_20535":116555,"_5":14089,"_26896":116491,"_2860":51360},[],{"_3374":69416,"_29561":69390,"_20535":116557,"_5":14089,"_26896":116491,"_2860":116558},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3374":69417,"_29561":69390,"_20535":116560,"_5":14089,"_26896":116491,"_2860":116561},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3374":69418,"_29561":69390,"_20535":116563,"_5":14089,"_26896":116495,"_2860":116564},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3374":69419,"_29561":69390,"_20535":116566,"_5":14089,"_26896":116495,"_2860":116567},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3374":69420,"_29561":69390,"_20535":116569,"_5":14089,"_26896":116498,"_2860":116570},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3374":69421,"_29561":69390,"_20535":116572,"_5":14089,"_26896":116498,"_2860":116573},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3374":69422,"_29561":69390,"_20535":116575,"_5":14089,"_26896":116501,"_2860":116576},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3374":69423,"_29561":69390,"_20535":116578,"_5":14089,"_26896":116501,"_2860":116579},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3374":69424,"_29561":69390,"_20535":116581,"_5":14089,"_26896":116504,"_2860":116582},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3374":69425,"_29561":69390,"_20535":116584,"_5":14089,"_26896":116504,"_2860":116585},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3374":69426,"_29561":69390,"_20535":116587,"_5":14089,"_26896":116507,"_2860":116588},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3374":69427,"_29561":69390,"_20535":116590,"_5":14089,"_26896":116507,"_2860":116591},[],"Parte",{"_3374":69428,"_29561":69390,"_20535":116593,"_5":14089,"_26896":116507,"_2860":116594},[],"Contenido tras decodificar su Base64",{"_3374":69429,"_29561":69390,"_20535":116596,"_5":14089,"_26896":116507,"_2860":51418},[],{"_3374":69430,"_29561":69390,"_20535":116598,"_5":14089,"_26896":116507,"_2860":116599},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3374":69431,"_29561":69390,"_20535":116601,"_5":14089,"_26896":116507,"_2860":51424},[],{"_3374":69432,"_29561":69390,"_20535":116603,"_5":14089,"_26896":116507,"_2860":116604},[],"PKCS#7 DER con el certificado emitido.",{"_3374":69433,"_29561":69390,"_20535":116606,"_5":14089,"_26896":116507,"_2860":116607},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3374":69434,"_29561":69390,"_20535":116609,"_5":14089,"_26896":116511,"_2860":116610},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3374":69435,"_29561":69390,"_20535":116612,"_5":14089,"_26896":116511,"_2860":116613},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3374":69436,"_29561":69390,"_20535":116615,"_5":14089,"_26896":116511,"_2860":116616},[],"Convierte y comprueba el resultado:",{"_3374":69437,"_29561":69390,"_20535":116618,"_5":14089,"_26896":116511,"_2860":116619},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3374":69438,"_29561":69390,"_20535":116621,"_5":14089,"_26896":116515,"_2860":116622},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3374":69439,"_29561":69390,"_20535":116624,"_5":14089,"_26896":116515,"_2860":116625},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3374":69440,"_29561":69440,"_5":14447,"_2860":115984,"_29893":116627,"_20535":116628,"_26896":69440},[48107,114800,50586,115809,115984],[],{"_3374":69441,"_29561":69440,"_20535":116630,"_5":14089,"_26896":69440,"_2860":116631},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3374":69442,"_29561":69440,"_5":29890,"_20535":116633,"_26896":116634,"_2860":116635},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3374":69443,"_29561":69440,"_5":29890,"_20535":116637,"_26896":116638,"_2860":116639},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3374":69444,"_29561":69440,"_5":29890,"_20535":116641,"_26896":116642,"_2860":116643},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3374":69445,"_29561":69440,"_5":29890,"_20535":116645,"_26896":116646,"_2860":116647},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3374":69446,"_29561":69440,"_20535":116649,"_5":14089,"_26896":69440,"_2860":116650},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3374":69447,"_29561":69440,"_20535":116652,"_5":14089,"_26896":116634,"_2860":116653},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3374":69448,"_29561":69440,"_20535":116655,"_5":14089,"_26896":116634,"_2860":116656},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3374":69449,"_29561":69440,"_20535":116658,"_5":14089,"_26896":116634,"_2860":116659},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3374":69450,"_29561":69440,"_20535":116661,"_5":14089,"_26896":116634,"_2860":116662},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3374":69451,"_29561":69440,"_20535":116664,"_5":14089,"_26896":116634,"_2860":116665},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3374":69452,"_29561":69440,"_20535":116667,"_5":14089,"_26896":116634,"_2860":116668},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3374":69453,"_29561":69440,"_20535":116670,"_5":14089,"_26896":116638,"_2860":116671},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3374":69454,"_29561":69440,"_20535":116673,"_5":14089,"_26896":116638,"_2860":116674},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3374":69455,"_29561":69440,"_20535":116676,"_5":14089,"_26896":116638,"_2860":116677},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3374":69456,"_29561":69440,"_20535":116679,"_5":14089,"_26896":116638,"_2860":116680},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3374":69457,"_29561":69440,"_20535":116682,"_5":14089,"_26896":116642,"_2860":116683},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3374":69458,"_29561":69440,"_20535":116685,"_5":14089,"_26896":116642,"_2860":116686},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3374":69459,"_29561":69440,"_20535":116688,"_5":14089,"_26896":116642,"_2860":116689},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3374":69460,"_29561":69440,"_20535":116691,"_5":14089,"_26896":116642,"_2860":116692},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3374":69461,"_29561":69440,"_20535":116694,"_5":14089,"_26896":116646,"_2860":116695},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3374":69462,"_29561":69440,"_20535":116697,"_5":14089,"_26896":116646,"_2860":116698},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3374":69463,"_29561":69463,"_5":14447,"_2860":116700,"_29893":116701,"_20535":116702,"_26896":69463},"Estrategias de aprovisionamiento",[48107,114800,50586,115809,115984],[],{"_3374":69464,"_29561":69463,"_20535":116704,"_5":14089,"_26896":69463,"_2860":116705},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3374":69465,"_29561":69463,"_5":29890,"_20535":116707,"_26896":116708,"_2860":116709},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3374":69466,"_29561":69463,"_5":29890,"_20535":116711,"_26896":116712,"_2860":116713},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3374":69467,"_29561":69463,"_5":29890,"_20535":116715,"_26896":116716,"_2860":116717},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3374":69468,"_29561":69463,"_5":29890,"_20535":116719,"_26896":116720,"_2860":116721},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3374":69469,"_29561":69463,"_5":29890,"_20535":116723,"_26896":116724,"_2860":116725},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3374":69470,"_29561":69463,"_20535":116727,"_5":14089,"_26896":69463,"_2860":116728},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3374":69471,"_29561":69463,"_20535":116730,"_5":14089,"_26896":116708,"_2860":116731},[],"Recorrido",{"_3374":69472,"_29561":69463,"_20535":116733,"_5":14089,"_26896":116708,"_2860":116734},[],"Cuándo existe el dispositivo",{"_3374":69473,"_29561":69463,"_20535":116736,"_5":14089,"_26896":116708,"_2860":116737},[],"Qué compruebas",{"_3374":69474,"_29561":69463,"_20535":116739,"_5":14089,"_26896":116708,"_2860":116740},[],"Asignación manual",{"_3374":69475,"_29561":69463,"_20535":116742,"_5":14089,"_26896":116708,"_2860":116743},[],"El operador lo crea antes de asociar un certificado.",{"_3374":69476,"_29561":69463,"_20535":116745,"_5":14089,"_26896":116708,"_2860":116746},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3374":69477,"_29561":69463,"_20535":116748,"_5":14089,"_26896":116708,"_2860":116749},[],"EST con `JITP`",{"_3374":69478,"_29561":69463,"_20535":116751,"_5":14089,"_26896":116708,"_2860":116752},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3374":69479,"_29561":69463,"_20535":116754,"_5":14089,"_26896":116708,"_2860":116755},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3374":69480,"_29561":69463,"_20535":116757,"_5":14089,"_26896":116708,"_2860":116758},[],"EST con `PRE_REGISTRATION`",{"_3374":69481,"_29561":69463,"_20535":116760,"_5":14089,"_26896":116708,"_2860":116761},[],"Debe existir antes de `/simpleenroll`.",{"_3374":69482,"_29561":69463,"_20535":116763,"_5":14089,"_26896":116708,"_2860":116764},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3374":69483,"_29561":69463,"_20535":116766,"_5":14089,"_26896":116708,"_2860":116767},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3374":69484,"_29561":69463,"_20535":116769,"_5":14089,"_26896":116708,"_2860":116770},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3374":69485,"_29561":69463,"_20535":116772,"_5":14089,"_26896":116712,"_2860":116773},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3374":69486,"_29561":69463,"_20535":116775,"_5":14089,"_26896":116712,"_2860":116776},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3374":69487,"_29561":69463,"_20535":116778,"_5":14089,"_26896":116712,"_2860":116779},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3374":69488,"_29561":69463,"_20535":116781,"_5":14089,"_26896":116716,"_2860":116782},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3374":69489,"_29561":69463,"_20535":116784,"_5":14089,"_26896":116716,"_2860":116785},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3374":69490,"_29561":69463,"_20535":116787,"_5":14089,"_26896":116716,"_2860":116788},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3374":69491,"_29561":69463,"_20535":116790,"_5":14089,"_26896":116716,"_2860":116791},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3374":69492,"_29561":69463,"_20535":116793,"_5":14089,"_26896":116716,"_2860":116794},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3374":69493,"_29561":69463,"_20535":116796,"_5":14089,"_26896":116716,"_2860":116797},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3374":69494,"_29561":69463,"_20535":116799,"_5":14089,"_26896":116720,"_2860":113742},[],{"_3374":69495,"_29561":69463,"_20535":116801,"_5":14089,"_26896":116720,"_2860":116802},[],"Material que atraviesa EST",{"_3374":69496,"_29561":69463,"_20535":116804,"_5":14089,"_26896":116720,"_2860":116805},[],"Clave generada por el dispositivo",{"_3374":69497,"_29561":69463,"_20535":116807,"_5":14089,"_26896":116720,"_2860":116808},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3374":69498,"_29561":69463,"_20535":116810,"_5":14089,"_26896":116720,"_2860":116811},[],"Clave ya disponible en el dispositivo",{"_3374":69499,"_29561":69463,"_20535":116813,"_5":14089,"_26896":116720,"_2860":116814},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3374":69500,"_29561":69463,"_20535":116816,"_5":14089,"_26896":116720,"_2860":50905},[],{"_3374":69501,"_29561":69463,"_20535":116818,"_5":14089,"_26896":116720,"_2860":116819},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3374":69502,"_29561":69463,"_20535":116821,"_5":14089,"_26896":116720,"_2860":116822},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3374":69503,"_29561":69463,"_20535":116824,"_5":14089,"_26896":116724,"_2860":116825},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3374":69504,"_29561":69504,"_5":14447,"_2860":116827,"_29893":116828,"_20535":116829,"_26896":69504},"Renovación y recuperación",[48107,114800,50586,115809,115984],[],{"_3374":69505,"_29561":69504,"_20535":116831,"_5":14089,"_26896":69504,"_2860":116832},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3374":69506,"_29561":69504,"_5":29890,"_20535":116834,"_26896":116835,"_2860":116836},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3374":69507,"_29561":69504,"_5":29890,"_20535":116838,"_26896":116839,"_2860":116840},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3374":69508,"_29561":69504,"_5":29890,"_20535":116842,"_26896":116843,"_2860":116844},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3374":69509,"_29561":69504,"_5":29890,"_20535":116846,"_26896":116847,"_2860":116848},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3374":69510,"_29561":69504,"_5":29890,"_20535":116850,"_26896":116851,"_2860":116852},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3374":69511,"_29561":69504,"_20535":116854,"_5":14089,"_26896":69504,"_2860":116855},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3374":69512,"_29561":69504,"_20535":116857,"_5":14089,"_26896":116835,"_2860":116858},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3374":69513,"_29561":69504,"_20535":116860,"_5":14089,"_26896":116835,"_2860":116861},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3374":69514,"_29561":69504,"_20535":116863,"_5":14089,"_26896":116835,"_2860":116864},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3374":69515,"_29561":69504,"_20535":116866,"_5":14089,"_26896":116835,"_2860":116867},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3374":69516,"_29561":69504,"_20535":116869,"_5":14089,"_26896":116839,"_2860":116870},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3374":69517,"_29561":69504,"_20535":116872,"_5":14089,"_26896":116839,"_2860":116873},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3374":69518,"_29561":69504,"_20535":116875,"_5":14089,"_26896":116843,"_2860":116876},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3374":69519,"_29561":69504,"_20535":116878,"_5":14089,"_26896":116843,"_2860":116879},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3374":69520,"_29561":69504,"_20535":116881,"_5":14089,"_26896":116843,"_2860":116882},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3374":69521,"_29561":69504,"_20535":116884,"_5":14089,"_26896":116847,"_2860":116885},[],"Situación",{"_3374":69522,"_29561":69504,"_20535":116887,"_5":14089,"_26896":116847,"_2860":116888},[],"Procedimiento",{"_3374":69523,"_29561":69504,"_20535":116890,"_5":14089,"_26896":116847,"_2860":116891},[],"Certificado vigente, fuera de ventana",{"_3374":69524,"_29561":69504,"_20535":116893,"_5":14089,"_26896":116847,"_2860":116894},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3374":69525,"_29561":69504,"_20535":116896,"_5":14089,"_26896":116847,"_2860":116897},[],"Certificado vencido, clave disponible",{"_3374":69526,"_29561":69504,"_20535":116899,"_5":14089,"_26896":116847,"_2860":116900},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3374":69527,"_29561":69504,"_20535":116902,"_5":14089,"_26896":116847,"_2860":116903},[],"Renovación por webhook o `NO_AUTH`",{"_3374":69528,"_29561":69504,"_20535":116905,"_5":14089,"_26896":116847,"_2860":116906},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3374":69529,"_29561":69504,"_20535":116908,"_5":14089,"_26896":116847,"_2860":116909},[],"Clave perdida o inaccesible",{"_3374":69530,"_29561":69504,"_20535":116911,"_5":14089,"_26896":116847,"_2860":116912},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3374":69531,"_29561":69504,"_20535":116914,"_5":14089,"_26896":116847,"_2860":116915},[],"Identidad actual revocada",{"_3374":69532,"_29561":69504,"_20535":116917,"_5":14089,"_26896":116847,"_2860":116918},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3374":69533,"_29561":69504,"_20535":116920,"_5":14089,"_26896":116847,"_2860":116921},[],"Dispositivo sin identidad",{"_3374":69534,"_29561":69504,"_20535":116923,"_5":14089,"_26896":116847,"_2860":116924},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3374":69535,"_29561":69504,"_20535":116926,"_5":14089,"_26896":116847,"_2860":116927},[],"Dispositivo retirado",{"_3374":69536,"_29561":69504,"_20535":116929,"_5":14089,"_26896":116847,"_2860":116930},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3374":69537,"_29561":69504,"_20535":116932,"_5":14089,"_26896":116847,"_2860":116933},[],"Timeout, HTTP 500 o fallo de instalación",{"_3374":69538,"_29561":69504,"_20535":116935,"_5":14089,"_26896":116847,"_2860":116936},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3374":69539,"_29561":69504,"_20535":116938,"_5":14089,"_26896":116851,"_2860":116939},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3374":69540,"_29561":69504,"_20535":116941,"_5":14089,"_26896":116851,"_2860":116942},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3374":69541,"_29561":69541,"_5":14447,"_2860":116944,"_29893":116945,"_20535":116946,"_26896":69541},"Diagnóstico de enrolamiento",[48107,114800,50586,115809,115984],[],{"_3374":69542,"_29561":69541,"_20535":116948,"_5":14089,"_26896":69541,"_2860":116949},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3374":69543,"_29561":69541,"_5":29890,"_20535":116951,"_26896":116952,"_2860":116953},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3374":69544,"_29561":69541,"_5":29890,"_20535":116955,"_26896":116956,"_2860":116957},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3374":69545,"_29561":69541,"_5":29890,"_20535":116959,"_26896":116960,"_2860":116516},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3374":69546,"_29561":69541,"_5":29890,"_20535":116962,"_26896":116963,"_2860":116964},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3374":69547,"_29561":69541,"_20535":116966,"_5":14089,"_26896":69541,"_2860":116967},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3374":69548,"_29561":69541,"_20535":116969,"_5":14089,"_26896":116956,"_2860":116970},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3374":69549,"_29561":69541,"_20535":116972,"_5":14089,"_26896":116956,"_2860":116973},[],"Síntoma o mensaje",{"_3374":69550,"_29561":69541,"_20535":116975,"_5":14089,"_26896":116956,"_2860":116976},[],"Qué revisar",{"_3374":69551,"_29561":69541,"_20535":116978,"_5":14089,"_26896":116956,"_2860":116979},[],"curl rechaza TLS, nombre o emisor",{"_3374":69552,"_29561":69541,"_20535":116981,"_5":14089,"_26896":116956,"_2860":116982},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3374":69553,"_29561":69541,"_20535":116984,"_5":14089,"_26896":116956,"_2860":116985},[],"404 o APS ausente",{"_3374":69554,"_29561":69541,"_20535":116987,"_5":14089,"_26896":116956,"_2860":116988},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3374":69555,"_29561":69541,"_20535":116990,"_5":14089,"_26896":116956,"_2860":116991},[],"400, error de CSR o formato",{"_3374":69556,"_29561":69541,"_20535":116993,"_5":14089,"_26896":116956,"_2860":116994},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3374":69557,"_29561":69541,"_20535":116996,"_5":14089,"_26896":116956,"_2860":116997},[],"Credencial ausente o certificado no válido",{"_3374":69558,"_29561":69541,"_20535":116999,"_5":14089,"_26896":116956,"_2860":117000},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3374":69559,"_29561":69541,"_20535":117002,"_5":14089,"_26896":116956,"_2860":117003},[],"Webhook deniega, expira o responde sin autorización",{"_3374":69560,"_29561":69541,"_20535":117005,"_5":14089,"_26896":116956,"_2860":117006},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3374":69561,"_29561":69541,"_20535":117008,"_5":14089,"_26896":116956,"_2860":51831},[],{"_3374":69562,"_29561":69541,"_20535":117010,"_5":14089,"_26896":116956,"_2860":117011},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3374":69563,"_29561":69541,"_20535":117013,"_5":14089,"_26896":116956,"_2860":51837},[],{"_3374":69564,"_29561":69541,"_20535":117015,"_5":14089,"_26896":116956,"_2860":117016},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3374":69565,"_29561":69541,"_20535":117018,"_5":14089,"_26896":116956,"_2860":51843},[],{"_3374":69566,"_29561":69541,"_20535":117020,"_5":14089,"_26896":116956,"_2860":117021},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3374":69567,"_29561":69541,"_20535":117023,"_5":14089,"_26896":116956,"_2860":51849},[],{"_3374":69568,"_29561":69541,"_20535":117025,"_5":14089,"_26896":116956,"_2860":117026},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3374":69569,"_29561":69541,"_20535":117028,"_5":14089,"_26896":116956,"_2860":51855},[],{"_3374":69570,"_29561":69541,"_20535":117030,"_5":14089,"_26896":116956,"_2860":117031},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3374":69571,"_29561":69541,"_20535":117033,"_5":14089,"_26896":116956,"_2860":117034},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3374":69572,"_29561":69541,"_20535":117036,"_5":14089,"_26896":116956,"_2860":117037},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3374":69573,"_29561":69541,"_20535":117039,"_5":14089,"_26896":116956,"_2860":117040},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3374":69574,"_29561":69541,"_20535":117042,"_5":14089,"_26896":116956,"_2860":117043},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3374":69575,"_29561":69541,"_20535":117045,"_5":14089,"_26896":116956,"_2860":51873},[],{"_3374":69576,"_29561":69541,"_20535":117047,"_5":14089,"_26896":116956,"_2860":117048},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3374":69577,"_29561":69541,"_20535":117050,"_5":14089,"_26896":116956,"_2860":51879},[],{"_3374":69578,"_29561":69541,"_20535":117052,"_5":14089,"_26896":116956,"_2860":117053},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3374":69579,"_29561":69541,"_20535":117055,"_5":14089,"_26896":116956,"_2860":117056},[],"DMS propietario distinto",{"_3374":69580,"_29561":69541,"_20535":117058,"_5":14089,"_26896":116956,"_2860":117059},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3374":69581,"_29561":69541,"_20535":117061,"_5":14089,"_26896":116956,"_2860":51891},[],{"_3374":69582,"_29561":69541,"_20535":117063,"_5":14089,"_26896":116956,"_2860":117064},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3374":69583,"_29561":69541,"_20535":117066,"_5":14089,"_26896":116956,"_2860":51897},[],{"_3374":69584,"_29561":69541,"_20535":117068,"_5":14089,"_26896":116956,"_2860":117069},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3374":69585,"_29561":69541,"_20535":117071,"_5":14089,"_26896":116956,"_2860":117072},[],"Certificado actual revocado",{"_3374":69586,"_29561":69541,"_20535":117074,"_5":14089,"_26896":116956,"_2860":117075},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3374":69587,"_29561":69541,"_20535":117077,"_5":14089,"_26896":116956,"_2860":117078},[],"Error de CA, perfil o firma",{"_3374":69588,"_29561":69541,"_20535":117080,"_5":14089,"_26896":116956,"_2860":117081},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3374":69589,"_29561":69541,"_20535":117083,"_5":14089,"_26896":116956,"_2860":117084},[],"HTTP 200 sin conexión del dispositivo",{"_3374":69590,"_29561":69541,"_20535":117086,"_5":14089,"_26896":116956,"_2860":117087},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3374":69591,"_29561":69541,"_20535":117089,"_5":14089,"_26896":116956,"_2860":117090},[],"Timeout o error después de emitir",{"_3374":69592,"_29561":69541,"_20535":117092,"_5":14089,"_26896":116956,"_2860":117093},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3374":69593,"_29561":69541,"_20535":117095,"_5":14089,"_26896":116960,"_2860":117096},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3374":69594,"_29561":69541,"_20535":117098,"_5":14089,"_26896":116960,"_2860":117099},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3374":69595,"_29561":69541,"_20535":117101,"_5":14089,"_26896":116963,"_2860":117102},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3374":69596,"_29561":69541,"_20535":117104,"_5":14089,"_26896":116963,"_2860":117105},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3374":69597,"_29561":69541,"_20535":117107,"_5":14089,"_26896":116963,"_2860":117108},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3374":69598,"_29561":69541,"_20535":117110,"_5":14089,"_26896":116963,"_2860":117111},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3374":69599,"_29561":69541,"_20535":117113,"_5":14089,"_26896":116963,"_2860":117114},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3374":69600,"_29561":69541,"_20535":117116,"_5":14089,"_26896":116963,"_2860":117117},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3374":69601,"_29561":69541,"_20535":117119,"_5":14089,"_26896":116963,"_2860":117120},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3374":69602,"_29561":69602,"_5":14447,"_2860":117122,"_29893":117123,"_20535":117124,"_26896":69602},"Distribución y actualización de confianza",[48107,114800,50586,115809,115984],[],{"_3374":69603,"_29561":69602,"_20535":117126,"_5":14089,"_26896":69602,"_2860":117127},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3374":69604,"_29561":69602,"_5":29890,"_20535":117129,"_26896":117130,"_2860":117131},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3374":69605,"_29561":69602,"_5":29890,"_20535":117133,"_26896":117134,"_2860":117135},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3374":69606,"_29561":69602,"_5":29890,"_20535":117137,"_26896":117138,"_2860":117139},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3374":69607,"_29561":69602,"_5":29890,"_20535":117141,"_26896":117142,"_2860":117143},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3374":69608,"_29561":69602,"_5":29890,"_20535":117145,"_26896":117146,"_2860":117147},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3374":69609,"_29561":69602,"_20535":117149,"_5":14089,"_26896":69602,"_2860":117150},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3374":69610,"_29561":69602,"_20535":117152,"_5":14089,"_26896":117130,"_2860":117153},[],"Relación",{"_3374":69611,"_29561":69602,"_20535":117155,"_5":14089,"_26896":117130,"_2860":117156},[],"Material que prepara el responsable",{"_3374":69612,"_29561":69602,"_20535":117158,"_5":14089,"_26896":117130,"_2860":117159},[],"Dispositivo → servidor EST",{"_3374":69613,"_29561":69602,"_20535":117161,"_5":14089,"_26896":117130,"_2860":117162},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3374":69614,"_29561":69602,"_20535":117164,"_5":14089,"_26896":117130,"_2860":117165},[],"DMS → solicitante",{"_3374":69615,"_29561":69602,"_20535":117167,"_5":14089,"_26896":117130,"_2860":117168},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3374":69616,"_29561":69602,"_20535":117170,"_5":14089,"_26896":117130,"_2860":117171},[],"Consumidor → dispositivo",{"_3374":69617,"_29561":69602,"_20535":117173,"_5":14089,"_26896":117130,"_2860":117174},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3374":69618,"_29561":69602,"_20535":117176,"_5":14089,"_26896":117130,"_2860":117177},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3374":69619,"_29561":69602,"_20535":117179,"_5":14089,"_26896":117134,"_2860":117180},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3374":69620,"_29561":69602,"_20535":117182,"_5":14089,"_26896":117134,"_2860":117183},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3374":69621,"_29561":69602,"_20535":117185,"_5":14089,"_26896":117138,"_2860":117186},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3374":69622,"_29561":69602,"_20535":117188,"_5":14089,"_26896":117138,"_2860":117189},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3374":69623,"_29561":69602,"_20535":117191,"_5":14089,"_26896":117138,"_2860":117192},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3374":69624,"_29561":69602,"_20535":117194,"_5":14089,"_26896":117138,"_2860":117195},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3374":69625,"_29561":69602,"_20535":117197,"_5":14089,"_26896":117138,"_2860":117198},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3374":69626,"_29561":69602,"_20535":117200,"_5":14089,"_26896":117138,"_2860":117201},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3374":69627,"_29561":69602,"_20535":117203,"_5":14089,"_26896":117142,"_2860":117204},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3374":69628,"_29561":69602,"_20535":117206,"_5":14089,"_26896":117142,"_2860":117207},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3374":69629,"_29561":69602,"_20535":117209,"_5":14089,"_26896":117142,"_2860":117210},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3374":69630,"_29561":69602,"_20535":117212,"_5":14089,"_26896":117146,"_2860":117213},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3374":69631,"_29561":69631,"_5":14447,"_2860":52046,"_29893":117215,"_20535":117217,"_26896":69631},[48107,114800,50586,115809,117216],"Integraciones",[],{"_3374":69632,"_29561":69631,"_20535":117219,"_5":14089,"_26896":69631,"_2860":117220},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3374":69633,"_29561":69631,"_5":29890,"_20535":117222,"_26896":117223,"_2860":117224},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3374":69634,"_29561":69631,"_5":29890,"_20535":117226,"_26896":117227,"_2860":117228},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3374":69635,"_29561":69631,"_5":29890,"_20535":117230,"_26896":117231,"_2860":117232},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3374":69636,"_29561":69631,"_5":29890,"_20535":117234,"_26896":117235,"_2860":117236},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3374":69637,"_29561":69631,"_5":29890,"_20535":117238,"_26896":117239,"_2860":117240},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3374":69638,"_29561":69631,"_5":29890,"_20535":117242,"_26896":117243,"_2860":117244},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3374":69639,"_29561":69631,"_5":29890,"_20535":117246,"_26896":117247,"_2860":117248},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3374":69640,"_29561":69631,"_5":29890,"_20535":117250,"_26896":117251,"_2860":117252},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3374":69641,"_29561":69631,"_5":29890,"_20535":117254,"_26896":117255,"_2860":52088},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3374":69642,"_29561":69631,"_5":29890,"_20535":117257,"_26896":117258,"_2860":52092},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3374":69643,"_29561":69631,"_5":29890,"_20535":117260,"_26896":117261,"_2860":117262},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3374":69644,"_29561":69631,"_5":29890,"_20535":117264,"_26896":117265,"_2860":117266},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3374":69645,"_29561":69631,"_5":29890,"_20535":117268,"_26896":117269,"_2860":117270},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3374":69646,"_29561":69631,"_5":29890,"_20535":117272,"_26896":117273,"_2860":117274},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3374":69647,"_29561":69631,"_5":29890,"_20535":117276,"_26896":117277,"_2860":117278},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3374":69648,"_29561":69631,"_5":29890,"_20535":117280,"_26896":117281,"_2860":117282},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3374":69649,"_29561":69631,"_5":29890,"_20535":117284,"_26896":117285,"_2860":117286},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3374":69650,"_29561":69631,"_5":29890,"_20535":117288,"_26896":117289,"_2860":117290},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3374":69651,"_29561":69631,"_5":29890,"_20535":117292,"_26896":117293,"_2860":117294},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3374":69652,"_29561":69631,"_5":29890,"_20535":117296,"_26896":117297,"_2860":117298},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3374":69653,"_29561":69631,"_5":29890,"_20535":117300,"_26896":117301,"_2860":117302},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3374":69654,"_29561":69631,"_5":29890,"_20535":117304,"_26896":117305,"_2860":117306},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3374":69655,"_29561":69631,"_5":29890,"_20535":117308,"_26896":117309,"_2860":117310},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3374":69656,"_29561":69631,"_5":29890,"_20535":117312,"_26896":117313,"_2860":117314},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3374":69657,"_29561":69631,"_5":29890,"_20535":117316,"_26896":117317,"_2860":117318},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3374":69658,"_29561":69631,"_20535":117320,"_5":14089,"_26896":69631,"_2860":117321},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3374":69659,"_29561":69631,"_20535":117323,"_5":14089,"_26896":69631,"_2860":117324},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3374":69660,"_29561":69631,"_20535":117326,"_5":14089,"_26896":69631,"_2860":117327},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3374":69661,"_29561":69631,"_20535":117329,"_5":14089,"_26896":117223,"_2860":117330},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3374":69662,"_29561":69631,"_20535":117332,"_5":14089,"_26896":117223,"_2860":117333},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3374":69663,"_29561":69631,"_20535":117335,"_5":14089,"_26896":117223,"_2860":117336},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3374":69664,"_29561":69631,"_20535":117338,"_5":14089,"_26896":117223,"_2860":117339},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3374":69665,"_29561":69631,"_20535":117341,"_5":14089,"_26896":117227,"_2860":117342},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3374":69666,"_29561":69631,"_20535":117344,"_5":14089,"_26896":117231,"_2860":117345},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3374":69667,"_29561":69631,"_20535":117347,"_5":14089,"_26896":117231,"_2860":117348},[],"Acción IAM",{"_3374":69668,"_29561":69631,"_20535":117350,"_5":14089,"_26896":117231,"_2860":113748},[],{"_3374":69669,"_29561":69631,"_20535":117352,"_5":14089,"_26896":117231,"_2860":52187},[],{"_3374":69670,"_29561":69631,"_20535":117354,"_5":14089,"_26896":117231,"_2860":117355},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3374":69671,"_29561":69631,"_20535":117357,"_5":14089,"_26896":117231,"_2860":52193},[],{"_3374":69672,"_29561":69631,"_20535":117359,"_5":14089,"_26896":117231,"_2860":117360},[],"Registrar la CA en AWS IoT",{"_3374":69673,"_29561":69631,"_20535":117362,"_5":14089,"_26896":117231,"_2860":52199},[],{"_3374":69674,"_29561":69631,"_20535":117364,"_5":14089,"_26896":117231,"_2860":117365},[],"Consultar el estado del registro de la CA",{"_3374":69675,"_29561":69631,"_20535":117367,"_5":14089,"_26896":117231,"_2860":52205},[],{"_3374":69676,"_29561":69631,"_20535":117369,"_5":14089,"_26896":117231,"_2860":117370},[],"Crear o actualizar Things en IoT Core",{"_3374":69677,"_29561":69631,"_20535":117372,"_5":14089,"_26896":117231,"_2860":52211},[],{"_3374":69678,"_29561":69631,"_20535":117374,"_5":14089,"_26896":117231,"_2860":117375},[],"Aprovisionar Things mediante plantilla",{"_3374":69679,"_29561":69631,"_20535":117377,"_5":14089,"_26896":117231,"_2860":52217},[],{"_3374":69680,"_29561":69631,"_20535":117379,"_5":14089,"_26896":117231,"_2860":117380},[],"Registrar certificados de dispositivo",{"_3374":69681,"_29561":69631,"_20535":117382,"_5":14089,"_26896":117231,"_2860":52223},[],{"_3374":69682,"_29561":69631,"_20535":117384,"_5":14089,"_26896":117231,"_2860":117385},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3374":69683,"_29561":69631,"_20535":117387,"_5":14089,"_26896":117231,"_2860":52229},[],{"_3374":69684,"_29561":69631,"_20535":117389,"_5":14089,"_26896":117231,"_2860":117390},[],"Crear y adjuntar políticas IoT",{"_3374":69685,"_29561":69631,"_20535":117392,"_5":14089,"_26896":117231,"_2860":52235},[],{"_3374":69686,"_29561":69631,"_20535":117394,"_5":14089,"_26896":117231,"_2860":117395},[],"Gestionar grupos de Things",{"_3374":69687,"_29561":69631,"_20535":117397,"_5":14089,"_26896":117231,"_2860":52241},[],{"_3374":69688,"_29561":69631,"_20535":117399,"_5":14089,"_26896":117231,"_2860":117400},[],"Crear plantillas JITP",{"_3374":69689,"_29561":69631,"_20535":117402,"_5":14089,"_26896":117231,"_2860":52247},[],{"_3374":69690,"_29561":69631,"_20535":117404,"_5":14089,"_26896":117231,"_2860":117405},[],"Leer y escribir el Device Shadow",{"_3374":69691,"_29561":69631,"_20535":117407,"_5":14089,"_26896":117231,"_2860":117408},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3374":69692,"_29561":69631,"_20535":117410,"_5":14089,"_26896":117235,"_2860":117411},[],"Parámetro",{"_3374":69693,"_29561":69631,"_20535":117413,"_5":14089,"_26896":117235,"_2860":117414},[],"Tipo",{"_3374":69694,"_29561":69631,"_20535":117416,"_5":14089,"_26896":117235,"_2860":117417},[],"Requerido",{"_3374":69695,"_29561":69631,"_20535":117419,"_5":14089,"_26896":117235,"_2860":117420},[],"Descripción",{"_3374":69696,"_29561":69631,"_20535":117422,"_5":14089,"_26896":117235,"_2860":52268},[],{"_3374":69697,"_29561":69631,"_20535":117424,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69698,"_29561":69631,"_20535":117426,"_5":14089,"_26896":117235,"_2860":117427},[],"Sí",{"_3374":69699,"_29561":69631,"_20535":117429,"_5":14089,"_26896":117235,"_2860":117430},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3374":69700,"_29561":69631,"_20535":117432,"_5":14089,"_26896":117235,"_2860":52279},[],{"_3374":69701,"_29561":69631,"_20535":117434,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69702,"_29561":69631,"_20535":117436,"_5":14089,"_26896":117235,"_2860":117427},[],{"_3374":69703,"_29561":69631,"_20535":117438,"_5":14089,"_26896":117235,"_2860":117439},[],"Región AWS donde opera el conector.",{"_3374":69704,"_29561":69631,"_20535":117441,"_5":14089,"_26896":117235,"_2860":52289},[],{"_3374":69705,"_29561":69631,"_20535":117443,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69706,"_29561":69631,"_20535":117445,"_5":14089,"_26896":117235,"_2860":117427},[],{"_3374":69707,"_29561":69631,"_20535":117447,"_5":14089,"_26896":117235,"_2860":117448},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3374":69708,"_29561":69631,"_20535":117450,"_5":14089,"_26896":117235,"_2860":52299},[],{"_3374":69709,"_29561":69631,"_20535":117452,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69710,"_29561":69631,"_20535":117454,"_5":14089,"_26896":117235,"_2860":117455},[],"Solo con `auth_method=static`",{"_3374":69711,"_29561":69631,"_20535":117457,"_5":14089,"_26896":117235,"_2860":117458},[],"Clave de acceso AWS.",{"_3374":69712,"_29561":69631,"_20535":117460,"_5":14089,"_26896":117235,"_2860":52310},[],{"_3374":69713,"_29561":69631,"_20535":117462,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69714,"_29561":69631,"_20535":117464,"_5":14089,"_26896":117235,"_2860":117455},[],{"_3374":69715,"_29561":69631,"_20535":117466,"_5":14089,"_26896":117235,"_2860":117467},[],"Clave secreta AWS.",{"_3374":69716,"_29561":69631,"_20535":117469,"_5":14089,"_26896":117235,"_2860":52320},[],{"_3374":69717,"_29561":69631,"_20535":117471,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69718,"_29561":69631,"_20535":117473,"_5":14089,"_26896":117235,"_2860":52325},[],{"_3374":69719,"_29561":69631,"_20535":117475,"_5":14089,"_26896":117235,"_2860":117476},[],"Token de sesión (con `auth_method=static`).",{"_3374":69720,"_29561":69631,"_20535":117478,"_5":14089,"_26896":117235,"_2860":52331},[],{"_3374":69721,"_29561":69631,"_20535":117480,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69722,"_29561":69631,"_20535":117482,"_5":14089,"_26896":117235,"_2860":117483},[],"Solo con `auth_method=role`",{"_3374":69723,"_29561":69631,"_20535":117485,"_5":14089,"_26896":117235,"_2860":117486},[],"ARN del rol a asumir.",{"_3374":69724,"_29561":69631,"_20535":117488,"_5":14089,"_26896":117235,"_2860":52342},[],{"_3374":69725,"_29561":69631,"_20535":117490,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69726,"_29561":69631,"_20535":117492,"_5":14089,"_26896":117235,"_2860":52325},[],{"_3374":69727,"_29561":69631,"_20535":117494,"_5":14089,"_26896":117235,"_2860":117495},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3374":69728,"_29561":69631,"_20535":117497,"_5":14089,"_26896":117235,"_2860":52352},[],{"_3374":69729,"_29561":69631,"_20535":117499,"_5":14089,"_26896":117235,"_2860":87481},[],{"_3374":69730,"_29561":69631,"_20535":117501,"_5":14089,"_26896":117235,"_2860":117427},[],{"_3374":69731,"_29561":69631,"_20535":117503,"_5":14089,"_26896":117235,"_2860":117504},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3374":69732,"_29561":69631,"_20535":117506,"_5":14089,"_26896":117235,"_2860":52362},[],{"_3374":69733,"_29561":69631,"_20535":117508,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69734,"_29561":69631,"_20535":117510,"_5":14089,"_26896":117235,"_2860":117427},[],{"_3374":69735,"_29561":69631,"_20535":117512,"_5":14089,"_26896":117235,"_2860":117513},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3374":69736,"_29561":69631,"_20535":117515,"_5":14089,"_26896":117235,"_2860":52372},[],{"_3374":69737,"_29561":69631,"_20535":117517,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69738,"_29561":69631,"_20535":117519,"_5":14089,"_26896":117235,"_2860":117427},[],{"_3374":69739,"_29561":69631,"_20535":117521,"_5":14089,"_26896":117235,"_2860":117522},[],"URL HTTP del Device Manager de Lamassu.",{"_3374":69740,"_29561":69631,"_20535":117524,"_5":14089,"_26896":117235,"_2860":52382},[],{"_3374":69741,"_29561":69631,"_20535":117526,"_5":14089,"_26896":117235,"_2860":24534},[],{"_3374":69742,"_29561":69631,"_20535":117528,"_5":14089,"_26896":117235,"_2860":117427},[],{"_3374":69743,"_29561":69631,"_20535":117530,"_5":14089,"_26896":117235,"_2860":117531},[],"URL HTTP del servicio de CA de Lamassu.",{"_3374":69744,"_29561":69631,"_20535":117533,"_5":14089,"_26896":117239,"_2860":117534},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3374":69745,"_29561":69631,"_20535":117536,"_5":14089,"_26896":117239,"_2860":117537},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3374":69746,"_29561":69631,"_20535":117539,"_5":14089,"_26896":117239,"_2860":117540},[],"Tipo de CloudEvent",{"_3374":69747,"_29561":69631,"_20535":117542,"_5":14089,"_26896":117239,"_2860":117543},[],"Recurso en Lamassu",{"_3374":69748,"_29561":69631,"_20535":117545,"_5":14089,"_26896":117239,"_2860":117546},[],"Recurso AWS",{"_3374":69749,"_29561":69631,"_20535":117548,"_5":14089,"_26896":117239,"_2860":117549},[],"Acciones IAM",{"_3374":69750,"_29561":69631,"_20535":117551,"_5":14089,"_26896":117239,"_2860":117552},[],"Llamadas AWS y efecto",{"_3374":69751,"_29561":69631,"_20535":117554,"_5":14089,"_26896":117239,"_2860":117555},[],"Dónde en esta página",{"_3374":69752,"_29561":69631,"_20535":117557,"_5":14089,"_26896":117239,"_2860":52416},[],{"_3374":69753,"_29561":69631,"_20535":117559,"_5":14089,"_26896":117239,"_2860":52419},[],{"_3374":69754,"_29561":69631,"_20535":117561,"_5":14089,"_26896":117239,"_2860":52422},[],{"_3374":69755,"_29561":69631,"_20535":117563,"_5":14089,"_26896":117239,"_2860":52425},[],{"_3374":69756,"_29561":69631,"_20535":117565,"_5":14089,"_26896":117239,"_2860":117566},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3374":69757,"_29561":69631,"_20535":117568,"_5":14089,"_26896":117239,"_2860":117252},[],{"_3374":69758,"_29561":69631,"_20535":117570,"_5":14089,"_26896":117239,"_2860":52433},[],{"_3374":69759,"_29561":69631,"_20535":117572,"_5":14089,"_26896":117239,"_2860":52436},[],{"_3374":69760,"_29561":69631,"_20535":117574,"_5":14089,"_26896":117239,"_2860":52439},[],{"_3374":69761,"_29561":69631,"_20535":117576,"_5":14089,"_26896":117239,"_2860":52442},[],{"_3374":69762,"_29561":69631,"_20535":117578,"_5":14089,"_26896":117239,"_2860":117579},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3374":69763,"_29561":69631,"_20535":117581,"_5":14089,"_26896":117239,"_2860":117278},[],{"_3374":69764,"_29561":69631,"_20535":117583,"_5":14089,"_26896":117239,"_2860":52450},[],{"_3374":69765,"_29561":69631,"_20535":117585,"_5":14089,"_26896":117239,"_2860":117586},[],"Dispositivo",{"_3374":69766,"_29561":69631,"_20535":117588,"_5":14089,"_26896":117239,"_2860":52456},[],{"_3374":69767,"_29561":69631,"_20535":117590,"_5":14089,"_26896":117239,"_2860":52459},[],{"_3374":69768,"_29561":69631,"_20535":117592,"_5":14089,"_26896":117239,"_2860":117593},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3374":69769,"_29561":69631,"_20535":117595,"_5":14089,"_26896":117239,"_2860":117286},[],{"_3374":69770,"_29561":69631,"_20535":117597,"_5":14089,"_26896":117239,"_2860":52467},[],{"_3374":69771,"_29561":69631,"_20535":117599,"_5":14089,"_26896":117239,"_2860":117600},[],"Certificado",{"_3374":69772,"_29561":69631,"_20535":117602,"_5":14089,"_26896":117239,"_2860":52473},[],{"_3374":69773,"_29561":69631,"_20535":117604,"_5":14089,"_26896":117239,"_2860":117605},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3374":69774,"_29561":69631,"_20535":117607,"_5":14089,"_26896":117239,"_2860":117608},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3374":69775,"_29561":69631,"_20535":117610,"_5":14089,"_26896":117239,"_2860":117298},[],{"_3374":69776,"_29561":69631,"_20535":117612,"_5":14089,"_26896":117239,"_2860":52484},[],{"_3374":69777,"_29561":69631,"_20535":117614,"_5":14089,"_26896":117239,"_2860":117615},[],"Certificado / Dispositivo",{"_3374":69778,"_29561":69631,"_20535":117617,"_5":14089,"_26896":117239,"_2860":52490},[],{"_3374":69779,"_29561":69631,"_20535":117619,"_5":14089,"_26896":117239,"_2860":48503},[],{"_3374":69780,"_29561":69631,"_20535":117621,"_5":14089,"_26896":117239,"_2860":117622},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3374":69781,"_29561":69631,"_20535":117624,"_5":14089,"_26896":117239,"_2860":117306},[],{"_3374":69782,"_29561":69631,"_20535":117626,"_5":14089,"_26896":117243,"_2860":117627},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3374":69783,"_29561":69631,"_20535":117629,"_5":14089,"_26896":117247,"_2860":117630},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3374":69784,"_29561":69631,"_20535":117632,"_5":14089,"_26896":117247,"_2860":117633},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3374":69785,"_29561":69631,"_20535":117635,"_5":14089,"_26896":117251,"_2860":117636},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3374":69786,"_29561":69631,"_20535":117638,"_5":14089,"_26896":117251,"_2860":117639},[],"Transición",{"_3374":69787,"_29561":69631,"_20535":117641,"_5":14089,"_26896":117251,"_2860":117642},[],"Llamadas AWS",{"_3374":69788,"_29561":69631,"_20535":117644,"_5":14089,"_26896":117251,"_2860":117645},[],"`NoRegistrada` → `Solicitada`",{"_3374":69789,"_29561":69631,"_20535":117647,"_5":14089,"_26896":117251,"_2860":117648},[],"ninguna (solo escritura de metadatos)",{"_3374":69790,"_29561":69631,"_20535":117650,"_5":14089,"_26896":117251,"_2860":117651},[],"`Solicitada` → `Registrando`",{"_3374":69791,"_29561":69631,"_20535":117653,"_5":14089,"_26896":117251,"_2860":117654},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3374":69792,"_29561":69631,"_20535":117656,"_5":14089,"_26896":117251,"_2860":117657},[],"`Registrando` → `Completada`",{"_3374":69793,"_29561":69631,"_20535":117659,"_5":14089,"_26896":117251,"_2860":117660},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3374":69794,"_29561":69631,"_20535":117662,"_5":14089,"_26896":117251,"_2860":117663},[],"`Registrando` → `Fallida`",{"_3374":69795,"_29561":69631,"_20535":117665,"_5":14089,"_26896":117251,"_2860":117666},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3374":69796,"_29561":69631,"_20535":117668,"_5":14089,"_26896":117251,"_2860":117669},[],"`Fallida` / `Completada` → `Solicitada`",{"_3374":69797,"_29561":69631,"_20535":117671,"_5":14089,"_26896":117251,"_2860":117672},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3374":69798,"_29561":69631,"_20535":117674,"_5":14089,"_26896":117255,"_2860":117675},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3374":69799,"_29561":69631,"_20535":117677,"_5":14089,"_26896":117255,"_2860":117678},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3374":69800,"_29561":69631,"_20535":117680,"_5":14089,"_26896":117255,"_2860":117681},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3374":69801,"_29561":69631,"_20535":117683,"_5":14089,"_26896":117255,"_2860":117684},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3374":69802,"_29561":69631,"_20535":117686,"_5":14089,"_26896":117255,"_2860":117687},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3374":69803,"_29561":69631,"_20535":117689,"_5":14089,"_26896":117255,"_2860":117690},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3374":69804,"_29561":69631,"_20535":117692,"_5":14089,"_26896":117258,"_2860":117693},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3374":69805,"_29561":69631,"_20535":117695,"_5":14089,"_26896":117261,"_2860":117696},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3374":69806,"_29561":69631,"_20535":117698,"_5":14089,"_26896":117261,"_2860":117699},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3374":69807,"_29561":69631,"_20535":117701,"_5":14089,"_26896":117265,"_2860":117702},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3374":69808,"_29561":69631,"_20535":117704,"_5":14089,"_26896":117269,"_2860":117705},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3374":69809,"_29561":69631,"_20535":117707,"_5":14089,"_26896":117269,"_2860":117708},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3374":69810,"_29561":69631,"_20535":117710,"_5":14089,"_26896":117269,"_2860":117711},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3374":69811,"_29561":69631,"_20535":117713,"_5":14089,"_26896":117269,"_2860":117714},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3374":69812,"_29561":69631,"_20535":117716,"_5":14089,"_26896":117269,"_2860":117717},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3374":69813,"_29561":69631,"_20535":117719,"_5":14089,"_26896":117269,"_2860":117720},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3374":69814,"_29561":69631,"_20535":117722,"_5":14089,"_26896":117273,"_2860":117723},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3374":69815,"_29561":69631,"_20535":117725,"_5":14089,"_26896":117273,"_2860":117726},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3374":69816,"_29561":69631,"_20535":117728,"_5":14089,"_26896":117273,"_2860":117729},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3374":69817,"_29561":69631,"_20535":117731,"_5":14089,"_26896":117273,"_2860":117732},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3374":69818,"_29561":69631,"_20535":117734,"_5":14089,"_26896":117273,"_2860":117735},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3374":69819,"_29561":69631,"_20535":117737,"_5":14089,"_26896":117277,"_2860":117738},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3374":69820,"_29561":69631,"_20535":117740,"_5":14089,"_26896":117277,"_2860":117639},[],{"_3374":69821,"_29561":69631,"_20535":117742,"_5":14089,"_26896":117277,"_2860":117642},[],{"_3374":69822,"_29561":69631,"_20535":117744,"_5":14089,"_26896":117277,"_2860":117745},[],"`SinConfigurar` → `None` / `Auto`",{"_3374":69823,"_29561":69631,"_20535":117747,"_5":14089,"_26896":117277,"_2860":117748},[],"ninguna (solo configuración)",{"_3374":69824,"_29561":69631,"_20535":117750,"_5":14089,"_26896":117277,"_2860":52627},[],{"_3374":69825,"_29561":69631,"_20535":117752,"_5":14089,"_26896":117277,"_2860":117748},[],{"_3374":69826,"_29561":69631,"_20535":117754,"_5":14089,"_26896":117277,"_2860":117755},[],"Cualquiera → `Jitp`",{"_3374":69827,"_29561":69631,"_20535":117757,"_5":14089,"_26896":117277,"_2860":117758},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3374":69828,"_29561":69631,"_20535":117760,"_5":14089,"_26896":117277,"_2860":52638},[],{"_3374":69829,"_29561":69631,"_20535":117762,"_5":14089,"_26896":117277,"_2860":117763},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3374":69830,"_29561":69631,"_20535":117765,"_5":14089,"_26896":117281,"_2860":117766},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3374":69831,"_29561":69631,"_20535":117768,"_5":14089,"_26896":117281,"_2860":117769},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3374":69832,"_29561":69631,"_20535":117771,"_5":14089,"_26896":117281,"_2860":117772},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3374":69833,"_29561":69631,"_20535":117774,"_5":14089,"_26896":117285,"_2860":117775},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3374":69834,"_29561":69631,"_20535":117777,"_5":14089,"_26896":117285,"_2860":117639},[],{"_3374":69835,"_29561":69631,"_20535":117779,"_5":14089,"_26896":117285,"_2860":117642},[],{"_3374":69836,"_29561":69631,"_20535":117781,"_5":14089,"_26896":117285,"_2860":117782},[],"`Ausente` → `Aprovisionado`",{"_3374":69837,"_29561":69631,"_20535":117784,"_5":14089,"_26896":117285,"_2860":117785},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3374":69838,"_29561":69631,"_20535":117787,"_5":14089,"_26896":117285,"_2860":117788},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3374":69839,"_29561":69631,"_20535":117790,"_5":14089,"_26896":117285,"_2860":117791},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3374":69840,"_29561":69631,"_20535":117793,"_5":14089,"_26896":117285,"_2860":117794},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3374":69841,"_29561":69631,"_20535":117796,"_5":14089,"_26896":117289,"_2860":117797},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3374":69842,"_29561":69631,"_20535":117799,"_5":14089,"_26896":117289,"_2860":117800},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3374":69843,"_29561":69631,"_20535":117802,"_5":14089,"_26896":117289,"_2860":117803},[],"Para que el flujo JITP funcione correctamente:",{"_3374":69844,"_29561":69631,"_20535":117805,"_5":14089,"_26896":117289,"_2860":117806},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3374":69845,"_29561":69631,"_20535":117808,"_5":14089,"_26896":117289,"_2860":117809},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3374":69846,"_29561":69631,"_20535":117811,"_5":14089,"_26896":117289,"_2860":117812},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3374":69847,"_29561":69631,"_20535":117814,"_5":14089,"_26896":117289,"_2860":117815},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3374":69848,"_29561":69631,"_20535":117817,"_5":14089,"_26896":117293,"_2860":117818},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3374":69849,"_29561":69631,"_20535":117820,"_5":14089,"_26896":117293,"_2860":117821},[],"Estado en Lamassu",{"_3374":69850,"_29561":69631,"_20535":117823,"_5":14089,"_26896":117293,"_2860":117824},[],"Razón de revocación",{"_3374":69851,"_29561":69631,"_20535":117826,"_5":14089,"_26896":117293,"_2860":117827},[],"Estado en AWS IoT Core",{"_3374":69852,"_29561":69631,"_20535":117829,"_5":14089,"_26896":117293,"_2860":52708},[],{"_3374":69853,"_29561":69631,"_20535":117831,"_5":14089,"_26896":117293,"_2860":117832},[],"Ninguna",{"_3374":69854,"_29561":69631,"_20535":117834,"_5":14089,"_26896":117293,"_2860":52714},[],{"_3374":69855,"_29561":69631,"_20535":117836,"_5":14089,"_26896":117293,"_2860":52717},[],{"_3374":69856,"_29561":69631,"_20535":117838,"_5":14089,"_26896":117293,"_2860":52720},[],{"_3374":69857,"_29561":69631,"_20535":117840,"_5":14089,"_26896":117293,"_2860":52723},[],{"_3374":69858,"_29561":69631,"_20535":117842,"_5":14089,"_26896":117293,"_2860":52717},[],{"_3374":69859,"_29561":69631,"_20535":117844,"_5":14089,"_26896":117293,"_2860":117845},[],"Cualquier otra razón",{"_3374":69860,"_29561":69631,"_20535":117847,"_5":14089,"_26896":117293,"_2860":52731},[],{"_3374":69861,"_29561":69631,"_20535":117849,"_5":14089,"_26896":117293,"_2860":117850},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3374":69862,"_29561":69631,"_20535":117852,"_5":14089,"_26896":117297,"_2860":117853},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3374":69863,"_29561":69631,"_20535":117855,"_5":14089,"_26896":117297,"_2860":117639},[],{"_3374":69864,"_29561":69631,"_20535":117857,"_5":14089,"_26896":117297,"_2860":117642},[],{"_3374":69865,"_29561":69631,"_20535":117859,"_5":14089,"_26896":117297,"_2860":117860},[],"`NoSincronizado` → `Active`",{"_3374":69866,"_29561":69631,"_20535":117862,"_5":14089,"_26896":117297,"_2860":52223},[],{"_3374":69867,"_29561":69631,"_20535":117864,"_5":14089,"_26896":117297,"_2860":52749},[],{"_3374":69868,"_29561":69631,"_20535":117866,"_5":14089,"_26896":117297,"_2860":117867},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3374":69869,"_29561":69631,"_20535":117869,"_5":14089,"_26896":117297,"_2860":52755},[],{"_3374":69870,"_29561":69631,"_20535":117871,"_5":14089,"_26896":117297,"_2860":117867},[],{"_3374":69871,"_29561":69631,"_20535":117873,"_5":14089,"_26896":117297,"_2860":52760},[],{"_3374":69872,"_29561":69631,"_20535":117875,"_5":14089,"_26896":117297,"_2860":52223},[],{"_3374":69873,"_29561":69631,"_20535":117877,"_5":14089,"_26896":117297,"_2860":52765},[],{"_3374":69874,"_29561":69631,"_20535":117879,"_5":14089,"_26896":117297,"_2860":117880},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3374":69875,"_29561":69631,"_20535":117882,"_5":14089,"_26896":117301,"_2860":117883},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3374":69876,"_29561":69631,"_20535":117885,"_5":14089,"_26896":117301,"_2860":117886},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3374":69877,"_29561":69631,"_20535":117888,"_5":14089,"_26896":117301,"_2860":117889},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3374":69878,"_29561":69631,"_20535":117891,"_5":14089,"_26896":117305,"_2860":117892},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3374":69879,"_29561":69631,"_20535":117894,"_5":14089,"_26896":117305,"_2860":117895},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3374":69880,"_29561":69631,"_20535":117897,"_5":14089,"_26896":117309,"_2860":117898},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3374":69881,"_29561":69631,"_20535":117900,"_5":14089,"_26896":117309,"_2860":117901},[],"Existen dos tipos de acciones:",{"_3374":69882,"_29561":69631,"_20535":117903,"_5":14089,"_26896":117309,"_2860":117904},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3374":69883,"_29561":69631,"_20535":117906,"_5":14089,"_26896":117309,"_2860":117907},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3374":69884,"_29561":69631,"_20535":117909,"_5":14089,"_26896":117309,"_2860":117910},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3374":69885,"_29561":69631,"_20535":117912,"_5":14089,"_26896":117313,"_2860":117913},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3374":69886,"_29561":69631,"_20535":117915,"_5":14089,"_26896":117313,"_2860":117916},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3374":69887,"_29561":69631,"_20535":117918,"_5":14089,"_26896":117313,"_2860":117919},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3374":69888,"_29561":69631,"_20535":117921,"_5":14089,"_26896":117317,"_2860":117922},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3374":69889,"_29561":69631,"_20535":117924,"_5":14089,"_26896":117317,"_2860":117925},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3374":69890,"_29561":69631,"_20535":117927,"_5":14089,"_26896":117317,"_2860":117928},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3374":69891,"_29561":69631,"_20535":117930,"_5":14089,"_26896":117317,"_2860":117931},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3374":69892,"_29561":69631,"_20535":117933,"_5":14089,"_26896":117317,"_2860":117934},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3374":69893,"_29561":69631,"_20535":117936,"_5":14089,"_26896":117317,"_2860":117937},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3374":69894,"_29561":69631,"_20535":117939,"_5":14089,"_26896":117317,"_2860":117940},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3374":69895,"_29561":69631,"_20535":117942,"_5":14089,"_26896":117317,"_2860":117943},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3374":69896,"_29561":69631,"_20535":117945,"_5":14089,"_26896":117317,"_2860":117946},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3374":69897,"_29561":69631,"_20535":117948,"_5":14089,"_26896":117317,"_2860":117949},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3374":69898,"_29561":69631,"_20535":117951,"_5":14089,"_26896":117317,"_2860":117952},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3374":69899,"_29561":69631,"_20535":117954,"_5":14089,"_26896":117317,"_2860":117955},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3374":69900,"_29561":69631,"_20535":117957,"_5":14089,"_26896":117317,"_2860":117958},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3374":69901,"_29561":69631,"_20535":117960,"_5":14089,"_26896":117317,"_2860":117961},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3374":69902,"_29561":69631,"_20535":117963,"_5":14089,"_26896":117317,"_2860":117964},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3374":69903,"_29561":69631,"_20535":117966,"_5":14089,"_26896":117317,"_2860":117967},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3374":69904,"_29561":69631,"_20535":117969,"_5":14089,"_26896":117317,"_2860":117970},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3374":69905,"_29561":69631,"_20535":117972,"_5":14089,"_26896":117317,"_2860":117973},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3374":69906,"_29561":69631,"_20535":117975,"_5":14089,"_26896":117317,"_2860":117976},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3374":69907,"_29561":69631,"_20535":117978,"_5":14089,"_26896":117317,"_2860":117979},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3374":69908,"_29561":69631,"_20535":117981,"_5":14089,"_26896":117317,"_2860":117982},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3374":69909,"_29561":69631,"_20535":117984,"_5":14089,"_26896":117317,"_2860":117985},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3374":69910,"_29561":69631,"_20535":117987,"_5":14089,"_26896":117317,"_2860":117988},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3374":69911,"_29561":69631,"_20535":117990,"_5":14089,"_26896":117317,"_2860":117991},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3374":69912,"_29561":69912,"_5":14447,"_2860":50586,"_29893":117993,"_20535":117994,"_26896":69912},[48107,114800,50586],[],{"_3374":69913,"_29561":69912,"_20535":117996,"_5":14089,"_26896":69912,"_2860":117997},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3374":69914,"_29561":69912,"_5":29890,"_20535":117999,"_26896":118000,"_2860":118001},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3374":69915,"_29561":69912,"_5":29890,"_20535":118003,"_26896":118004,"_2860":115809},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3374":69916,"_29561":69912,"_5":29890,"_20535":118006,"_26896":118007,"_2860":115984},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3374":69917,"_29561":69912,"_5":29890,"_20535":118009,"_26896":118010,"_2860":117216},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3374":69918,"_29561":69912,"_5":29890,"_20535":118012,"_26896":118013,"_2860":118014},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3374":69919,"_29561":69912,"_20535":118016,"_5":14089,"_26896":69912,"_2860":118017},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3374":69920,"_29561":69912,"_20535":118019,"_5":14089,"_26896":118000,"_2860":118020},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3374":69921,"_29561":69912,"_20535":118022,"_5":14089,"_26896":118000,"_2860":118023},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3374":69922,"_29561":69912,"_20535":118025,"_5":14089,"_26896":118004,"_2860":118026},[],"Recurso",{"_3374":69923,"_29561":69912,"_20535":118028,"_5":14089,"_26896":118004,"_2860":118029},[],"Qué representa",{"_3374":69924,"_29561":69912,"_20535":118031,"_5":14089,"_26896":118004,"_2860":118032},[],"**Dispositivo**",{"_3374":69925,"_29561":69912,"_20535":118034,"_5":14089,"_26896":118004,"_2860":118035},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3374":69926,"_29561":69912,"_20535":118037,"_5":14089,"_26896":118004,"_2860":118038},[],"**Identidad**",{"_3374":69927,"_29561":69912,"_20535":118040,"_5":14089,"_26896":118004,"_2860":118041},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3374":69928,"_29561":69912,"_20535":118043,"_5":14089,"_26896":118004,"_2860":52932},[],{"_3374":69929,"_29561":69912,"_20535":118045,"_5":14089,"_26896":118004,"_2860":118046},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3374":69930,"_29561":69912,"_20535":118048,"_5":14089,"_26896":118004,"_2860":118049},[],"**Flota**",{"_3374":69931,"_29561":69912,"_20535":118051,"_5":14089,"_26896":118004,"_2860":118052},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3374":69932,"_29561":69912,"_20535":118054,"_5":14089,"_26896":118004,"_2860":118055},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3374":69933,"_29561":69912,"_20535":118057,"_5":14089,"_26896":118004,"_2860":118058},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3374":69934,"_29561":69912,"_20535":118060,"_5":14089,"_26896":118007,"_2860":118061},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3374":69935,"_29561":69912,"_20535":118063,"_5":14089,"_26896":118007,"_2860":118064},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3374":69936,"_29561":69912,"_20535":118066,"_5":14089,"_26896":118007,"_2860":118067},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3374":69937,"_29561":69912,"_20535":118069,"_5":14089,"_26896":118007,"_2860":118070},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3374":69938,"_29561":69912,"_20535":118072,"_5":14089,"_26896":118007,"_2860":118073},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3374":69939,"_29561":69912,"_20535":118075,"_5":14089,"_26896":118007,"_2860":118076},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3374":69940,"_29561":69912,"_20535":118078,"_5":14089,"_26896":118007,"_2860":118079},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3374":69941,"_29561":69912,"_20535":118081,"_5":14089,"_26896":118007,"_2860":118082},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3374":69942,"_29561":69912,"_20535":118084,"_5":14089,"_26896":118010,"_2860":118085},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3374":69943,"_29561":69912,"_20535":118087,"_5":14089,"_26896":118010,"_2860":118088},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3374":69944,"_29561":69912,"_20535":118090,"_5":14089,"_26896":118013,"_2860":118091},[],"Participante",{"_3374":69945,"_29561":69912,"_20535":118093,"_5":14089,"_26896":118013,"_2860":118094},[],"Responsabilidad",{"_3374":69946,"_29561":69912,"_20535":118096,"_5":14089,"_26896":118013,"_2860":118097},[],"Administrador PKI",{"_3374":69947,"_29561":69912,"_20535":118099,"_5":14089,"_26896":118013,"_2860":118100},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3374":69948,"_29561":69912,"_20535":118102,"_5":14089,"_26896":118013,"_2860":118103},[],"Administrador del aprovisionamiento",{"_3374":69949,"_29561":69912,"_20535":118105,"_5":14089,"_26896":118013,"_2860":118106},[],"DMS, admisión, autenticación por operación e inventario.",{"_3374":69950,"_29561":69912,"_20535":118108,"_5":14089,"_26896":118013,"_2860":118109},[],"Integrador del dispositivo",{"_3374":69951,"_29561":69912,"_20535":118111,"_5":14089,"_26896":118013,"_2860":118112},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3374":69952,"_29561":69912,"_20535":118114,"_5":14089,"_26896":118013,"_2860":118115},[],"Integrador del consumidor",{"_3374":69953,"_29561":69912,"_20535":118117,"_5":14089,"_26896":118013,"_2860":118118},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3374":69954,"_29561":69912,"_20535":118120,"_5":14089,"_26896":118013,"_2860":118121},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3374":69955,"_29561":69955,"_5":14447,"_2860":118123,"_29893":118124,"_20535":118126,"_26896":69955},"Enrola y conecta tu primer dispositivo",[48107,114800,50586,118125],"Primeros pasos",[],{"_3374":69956,"_29561":69955,"_20535":118128,"_5":14089,"_26896":69955,"_2860":118129},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3374":69957,"_29561":69955,"_5":29890,"_20535":118131,"_26896":118132,"_2860":113378},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3374":69958,"_29561":69955,"_5":29890,"_20535":118134,"_26896":118135,"_2860":118136},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3374":69959,"_29561":69955,"_5":29890,"_20535":118138,"_26896":118139,"_2860":118140},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3374":69960,"_29561":69955,"_5":29890,"_20535":118142,"_26896":118143,"_2860":118144},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3374":69961,"_29561":69955,"_5":29890,"_20535":118146,"_26896":118147,"_2860":118148},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3374":69962,"_29561":69955,"_5":29890,"_20535":118150,"_26896":118151,"_2860":118152},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3374":69963,"_29561":69955,"_5":29890,"_20535":118154,"_26896":118155,"_2860":118156},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3374":69964,"_29561":69955,"_5":29890,"_20535":118158,"_26896":118159,"_2860":118160},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3374":69965,"_29561":69955,"_20535":118162,"_5":14089,"_26896":69955,"_2860":118163},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3374":69966,"_29561":69955,"_20535":118165,"_5":14089,"_26896":118132,"_2860":118166},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3374":69967,"_29561":69955,"_20535":118168,"_5":14089,"_26896":118132,"_2860":118169},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3374":69968,"_29561":69955,"_20535":118171,"_5":14089,"_26896":118132,"_2860":118172},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3374":69969,"_29561":69955,"_20535":118174,"_5":14089,"_26896":118132,"_2860":118175},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3374":69970,"_29561":69955,"_20535":118177,"_5":14089,"_26896":118132,"_2860":118178},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3374":69971,"_29561":69955,"_20535":118180,"_5":14089,"_26896":118135,"_2860":118181},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3374":69972,"_29561":69955,"_20535":118183,"_5":14089,"_26896":118135,"_2860":118184},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3374":69973,"_29561":69955,"_20535":118186,"_5":14089,"_26896":118139,"_2860":118187},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3374":69974,"_29561":69955,"_20535":118189,"_5":14089,"_26896":118139,"_2860":118190},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3374":69975,"_29561":69955,"_20535":118192,"_5":14089,"_26896":118139,"_2860":118193},[],"Ajuste",{"_3374":69976,"_29561":69955,"_20535":118195,"_5":14089,"_26896":118139,"_2860":118196},[],"Valor de evaluación",{"_3374":69977,"_29561":69955,"_20535":118198,"_5":14089,"_26896":118139,"_2860":53088},[],{"_3374":69978,"_29561":69955,"_20535":118200,"_5":14089,"_26896":118139,"_2860":118201},[],"Raíz emisora de `device-root.pem`.",{"_3374":69979,"_29561":69955,"_20535":118203,"_5":14089,"_26896":118139,"_2860":116112},[],{"_3374":69980,"_29561":69955,"_20535":118205,"_5":14089,"_26896":118139,"_2860":118206},[],"Perfil final de 1 hora que acabas de preparar.",{"_3374":69981,"_29561":69955,"_20535":118208,"_5":14089,"_26896":118139,"_2860":53099},[],{"_3374":69982,"_29561":69955,"_20535":118210,"_5":14089,"_26896":118139,"_2860":53102},[],{"_3374":69983,"_29561":69955,"_20535":118212,"_5":14089,"_26896":118139,"_2860":53105},[],{"_3374":69984,"_29561":69955,"_20535":118214,"_5":14089,"_26896":118139,"_2860":118215},[],"Habilitado.",{"_3374":69985,"_29561":69955,"_20535":118217,"_5":14089,"_26896":118139,"_2860":53111},[],{"_3374":69986,"_29561":69955,"_20535":118219,"_5":14089,"_26896":118139,"_2860":118220},[],"Deshabilitado; el ID debe ser nuevo.",{"_3374":69987,"_29561":69955,"_20535":118222,"_5":14089,"_26896":118139,"_2860":118223},[],"Autenticación inicial",{"_3374":69988,"_29561":69955,"_20535":118225,"_5":14089,"_26896":118139,"_2860":118226},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3374":69989,"_29561":69955,"_20535":118228,"_5":14089,"_26896":118139,"_2860":118229},[],"Autenticación de renovación",{"_3374":69990,"_29561":69955,"_20535":118231,"_5":14089,"_26896":118139,"_2860":118232},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3374":69991,"_29561":69955,"_20535":118234,"_5":14089,"_26896":118139,"_2860":53129},[],{"_3374":69992,"_29561":69955,"_20535":118236,"_5":14089,"_26896":118139,"_2860":118237},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3374":69993,"_29561":69955,"_20535":118239,"_5":14089,"_26896":118139,"_2860":53135},[],{"_3374":69994,"_29561":69955,"_20535":118241,"_5":14089,"_26896":118139,"_2860":118242},[],"1 hora.",{"_3374":69995,"_29561":69955,"_20535":118244,"_5":14089,"_26896":118139,"_2860":53141},[],{"_3374":69996,"_29561":69955,"_20535":118246,"_5":14089,"_26896":118139,"_2860":118247},[],"30 minutos / 10 minutos.",{"_3374":69997,"_29561":69955,"_20535":118249,"_5":14089,"_26896":118139,"_2860":53147},[],{"_3374":69998,"_29561":69955,"_20535":118251,"_5":14089,"_26896":118139,"_2860":118252},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3374":69999,"_29561":69955,"_20535":118254,"_5":14089,"_26896":118139,"_2860":50905},[],{"_3374":70000,"_29561":69955,"_20535":118256,"_5":14089,"_26896":118139,"_2860":118257},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3374":70001,"_29561":69955,"_20535":118259,"_5":14089,"_26896":118139,"_2860":53158},[],{"_3374":70002,"_29561":69955,"_20535":118261,"_5":14089,"_26896":118139,"_2860":118262},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3374":70003,"_29561":69955,"_20535":118264,"_5":14089,"_26896":118139,"_2860":118265},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3374":70004,"_29561":69955,"_20535":118267,"_5":14089,"_26896":118143,"_2860":118268},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3374":70005,"_29561":69955,"_20535":118270,"_5":14089,"_26896":118143,"_2860":118271},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3374":70006,"_29561":69955,"_20535":118273,"_5":14089,"_26896":118147,"_2860":118274},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3374":70007,"_29561":69955,"_20535":118276,"_5":14089,"_26896":118147,"_2860":118277},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3374":70008,"_29561":69955,"_20535":118279,"_5":14089,"_26896":118147,"_2860":118280},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3374":70009,"_29561":69955,"_20535":118282,"_5":14089,"_26896":118151,"_2860":118283},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3374":70010,"_29561":69955,"_20535":118285,"_5":14089,"_26896":118151,"_2860":118286},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3374":70011,"_29561":69955,"_20535":118288,"_5":14089,"_26896":118155,"_2860":118289},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3374":70012,"_29561":69955,"_20535":118291,"_5":14089,"_26896":118155,"_2860":118292},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3374":70013,"_29561":69955,"_20535":118294,"_5":14089,"_26896":118155,"_2860":118295},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3374":70014,"_29561":69955,"_20535":118297,"_5":14089,"_26896":118155,"_2860":118298},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3374":70015,"_29561":69955,"_20535":118300,"_5":14089,"_26896":118155,"_2860":118301},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3374":70016,"_29561":69955,"_20535":118303,"_5":14089,"_26896":118159,"_2860":118304},[],"Comprobación",{"_3374":70017,"_29561":69955,"_20535":118306,"_5":14089,"_26896":118159,"_2860":118307},[],"Resultado esperado",{"_3374":70018,"_29561":69955,"_20535":118309,"_5":14089,"_26896":118159,"_2860":118310},[],"Registro",{"_3374":70019,"_29561":69955,"_20535":118312,"_5":14089,"_26896":118159,"_2860":118313},[],"ID creado automáticamente y DMS correcto.",{"_3374":70020,"_29561":69955,"_20535":118315,"_5":14089,"_26896":118159,"_2860":117600},[],{"_3374":70021,"_29561":69955,"_20535":118317,"_5":14089,"_26896":118159,"_2860":118318},[],"CN, perfil, serie y clave verificados.",{"_3374":70022,"_29561":69955,"_20535":118320,"_5":14089,"_26896":118159,"_2860":118321},[],"Inventario",{"_3374":70023,"_29561":69955,"_20535":118323,"_5":14089,"_26896":118159,"_2860":118324},[],"Serie recibida visible como identidad actual y en el historial.",{"_3374":70024,"_29561":69955,"_20535":118326,"_5":14089,"_26896":118159,"_2860":118327},[],"Consumidor",{"_3374":70025,"_29561":69955,"_20535":118329,"_5":14089,"_26896":118159,"_2860":118330},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3374":70026,"_29561":69955,"_20535":118332,"_5":14089,"_26896":118159,"_2860":118333},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3374":70027,"_29561":69955,"_20535":118335,"_5":14089,"_26896":118159,"_2860":118336},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3374":70028,"_29561":70028,"_5":14447,"_2860":115826,"_29893":118338,"_20535":118339,"_26896":70028},[48107,114800,50586,118125],[],{"_3374":70029,"_29561":70028,"_20535":118341,"_5":14089,"_26896":70028,"_2860":118342},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3374":70030,"_29561":70028,"_5":29890,"_20535":118344,"_26896":118345,"_2860":113378},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3374":70031,"_29561":70028,"_5":29890,"_20535":118347,"_26896":118348,"_2860":118349},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3374":70032,"_29561":70028,"_5":29890,"_20535":118351,"_26896":118352,"_2860":118353},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3374":70033,"_29561":70028,"_5":29890,"_20535":118355,"_26896":118356,"_2860":118357},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3374":70034,"_29561":70028,"_5":29890,"_20535":118359,"_26896":118360,"_2860":118361},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3374":70035,"_29561":70028,"_5":29890,"_20535":118363,"_26896":118364,"_2860":118365},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3374":70036,"_29561":70028,"_5":29890,"_20535":118367,"_26896":118368,"_2860":118307},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3374":70037,"_29561":70028,"_5":29890,"_20535":118370,"_26896":118371,"_2860":118372},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3374":70038,"_29561":70028,"_5":29890,"_20535":118374,"_26896":118375,"_2860":118376},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3374":70039,"_29561":70028,"_20535":118378,"_5":14089,"_26896":70028,"_2860":118379},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3374":70040,"_29561":70028,"_20535":118381,"_5":14089,"_26896":70028,"_2860":118382},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3374":70041,"_29561":70028,"_20535":118384,"_5":14089,"_26896":118345,"_2860":118385},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3374":70042,"_29561":70028,"_20535":118387,"_5":14089,"_26896":118345,"_2860":118388},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3374":70043,"_29561":70028,"_20535":118390,"_5":14089,"_26896":118345,"_2860":118391},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3374":70044,"_29561":70028,"_20535":118393,"_5":14089,"_26896":118345,"_2860":118394},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3374":70045,"_29561":70028,"_20535":118396,"_5":14089,"_26896":118348,"_2860":118397},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3374":70046,"_29561":70028,"_20535":118399,"_5":14089,"_26896":118348,"_2860":118400},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3374":70047,"_29561":70028,"_20535":118402,"_5":14089,"_26896":118348,"_2860":118403},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3374":70048,"_29561":70028,"_20535":118405,"_5":14089,"_26896":118348,"_2860":118406},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3374":70049,"_29561":70028,"_20535":118408,"_5":14089,"_26896":118348,"_2860":118409},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3374":70050,"_29561":70028,"_20535":118411,"_5":14089,"_26896":118348,"_2860":118412},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3374":70051,"_29561":70028,"_20535":118414,"_5":14089,"_26896":118348,"_2860":118415},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3374":70052,"_29561":70028,"_20535":118417,"_5":14089,"_26896":118348,"_2860":118418},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3374":70053,"_29561":70028,"_20535":118420,"_5":14089,"_26896":118352,"_2860":118421},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3374":70054,"_29561":70028,"_20535":118423,"_5":14089,"_26896":118352,"_2860":53323},[],{"_3374":70055,"_29561":70028,"_20535":118425,"_5":14089,"_26896":118352,"_2860":118426},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3374":70056,"_29561":70028,"_20535":118428,"_5":14089,"_26896":118352,"_2860":118429},[],"**Icon** y **Tags**: clasificación opcional.",{"_3374":70057,"_29561":70028,"_20535":118431,"_5":14089,"_26896":118352,"_2860":118432},[],"Confirma el registro.",{"_3374":70058,"_29561":70028,"_20535":118434,"_5":14089,"_26896":118356,"_2860":118435},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3374":70059,"_29561":70028,"_20535":118437,"_5":14089,"_26896":118356,"_2860":118438},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3374":70060,"_29561":70028,"_20535":118440,"_5":14089,"_26896":118360,"_2860":118441},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3374":70061,"_29561":70028,"_20535":118443,"_5":14089,"_26896":118360,"_2860":118444},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3374":70062,"_29561":70028,"_20535":118446,"_5":14089,"_26896":118364,"_2860":118447},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3374":70063,"_29561":70028,"_20535":118449,"_5":14089,"_26896":118364,"_2860":118450},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3374":70064,"_29561":70028,"_20535":118452,"_5":14089,"_26896":118368,"_2860":118304},[],{"_3374":70065,"_29561":70028,"_20535":118454,"_5":14089,"_26896":118368,"_2860":118455},[],"Resultado",{"_3374":70066,"_29561":70028,"_20535":118457,"_5":14089,"_26896":118368,"_2860":117586},[],{"_3374":70067,"_29561":70028,"_20535":118459,"_5":14089,"_26896":118368,"_2860":118460},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3374":70068,"_29561":70028,"_20535":118462,"_5":14089,"_26896":118368,"_2860":118463},[],"Identidad actual",{"_3374":70069,"_29561":70028,"_20535":118465,"_5":14089,"_26896":118368,"_2860":118466},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3374":70070,"_29561":70028,"_20535":118468,"_5":14089,"_26896":118368,"_2860":118469},[],"Historial",{"_3374":70071,"_29561":70028,"_20535":118471,"_5":14089,"_26896":118368,"_2860":118472},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3374":70072,"_29561":70028,"_20535":118474,"_5":14089,"_26896":118368,"_2860":118475},[],"Clave y certificado",{"_3374":70073,"_29561":70028,"_20535":118477,"_5":14089,"_26896":118368,"_2860":118478},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3374":70074,"_29561":70028,"_20535":118480,"_5":14089,"_26896":118371,"_2860":118481},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3374":70075,"_29561":70028,"_20535":118483,"_5":14089,"_26896":118371,"_2860":118484},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3374":70076,"_29561":70028,"_20535":118486,"_5":14089,"_26896":118371,"_2860":118487},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3374":70077,"_29561":70028,"_20535":118489,"_5":14089,"_26896":118371,"_2860":118490},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3374":70078,"_29561":70028,"_20535":118492,"_5":14089,"_26896":118375,"_2860":118493},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3374":70079,"_29561":70028,"_20535":118495,"_5":14089,"_26896":118375,"_2860":118496},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3374":70080,"_29561":70028,"_20535":118498,"_5":14089,"_26896":118375,"_2860":118499},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3374":70081,"_29561":70081,"_5":14447,"_2860":118501,"_29893":118502,"_20535":118503,"_26896":70081},"Plataforma Lamassu IoT",[48107,114800],[],{"_3374":70082,"_29561":70081,"_20535":118505,"_5":14089,"_26896":70081,"_2860":118506},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3374":70083,"_29561":70081,"_5":29890,"_20535":118508,"_26896":118509,"_2860":118001},[],"/docs/es/platform/overview#empieza-aquí",{"_3374":70084,"_29561":70081,"_5":29890,"_20535":118511,"_26896":118512,"_2860":118513},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3374":70085,"_29561":70081,"_5":29890,"_20535":118515,"_26896":118516,"_2860":118517},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3374":70086,"_29561":70081,"_5":29890,"_20535":118519,"_26896":118520,"_2860":118521},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3374":70087,"_29561":70081,"_5":29890,"_20535":118523,"_26896":118524,"_2860":118525},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3374":70088,"_29561":70081,"_5":29890,"_20535":118527,"_26896":118528,"_2860":118529},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3374":70089,"_29561":70081,"_5":29890,"_20535":118531,"_26896":118532,"_2860":118533},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3374":70090,"_29561":70081,"_5":29890,"_20535":118535,"_26896":118536,"_2860":118537},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3374":70091,"_29561":70081,"_5":29890,"_20535":118539,"_26896":118540,"_2860":118541},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3374":70092,"_29561":70081,"_5":29890,"_20535":118543,"_26896":118544,"_2860":118545},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3374":70093,"_29561":70081,"_5":29890,"_20535":118547,"_26896":118548,"_2860":118549},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3374":70094,"_29561":70081,"_20535":118551,"_5":14089,"_26896":70081,"_2860":118552},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3374":70095,"_29561":70081,"_20535":118554,"_5":14089,"_26896":118509,"_2860":118555},[],"Elige el resultado que necesitas obtener:",{"_3374":70096,"_29561":70081,"_20535":118557,"_5":14089,"_26896":118509,"_2860":118558},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3374":70097,"_29561":70081,"_20535":118560,"_5":14089,"_26896":118509,"_2860":118561},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3374":70098,"_29561":70081,"_20535":118563,"_5":14089,"_26896":118509,"_2860":118564},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3374":70099,"_29561":70081,"_20535":118566,"_5":14089,"_26896":118512,"_2860":118567},[],"Bloque",{"_3374":70100,"_29561":70081,"_20535":118569,"_5":14089,"_26896":118512,"_2860":118570},[],"Qué gestionas",{"_3374":70101,"_29561":70081,"_20535":118572,"_5":14089,"_26896":118512,"_2860":118573},[],"Punto de entrada",{"_3374":70102,"_29561":70081,"_20535":118575,"_5":14089,"_26896":118512,"_2860":53476},[],{"_3374":70103,"_29561":70081,"_20535":118577,"_5":14089,"_26896":118512,"_2860":118578},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3374":70104,"_29561":70081,"_20535":118580,"_5":14089,"_26896":118512,"_2860":118581},[],"Visión general de PKI",{"_3374":70105,"_29561":70081,"_20535":118583,"_5":14089,"_26896":118512,"_2860":53485},[],{"_3374":70106,"_29561":70081,"_20535":118585,"_5":14089,"_26896":118512,"_2860":118586},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3374":70107,"_29561":70081,"_20535":118588,"_5":14089,"_26896":118512,"_2860":118589},[],"Visión general de IoT Fleets",{"_3374":70108,"_29561":70081,"_20535":118591,"_5":14089,"_26896":118512,"_2860":118592},[],"**Administración**",{"_3374":70109,"_29561":70081,"_20535":118594,"_5":14089,"_26896":118512,"_2860":118595},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3374":70110,"_29561":70081,"_20535":118597,"_5":14089,"_26896":118512,"_2860":114798},[],{"_3374":70111,"_29561":70081,"_20535":118599,"_5":14089,"_26896":118512,"_2860":118600},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3374":70112,"_29561":70081,"_20535":118602,"_5":14089,"_26896":118516,"_2860":118603},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3374":70113,"_29561":70081,"_20535":118605,"_5":14089,"_26896":118516,"_2860":118606},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3374":70114,"_29561":70081,"_20535":118608,"_5":14089,"_26896":118516,"_2860":118609},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3374":70115,"_29561":70081,"_20535":118611,"_5":14089,"_26896":118516,"_2860":118612},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3374":70116,"_29561":70081,"_20535":118614,"_5":14089,"_26896":118516,"_2860":118615},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3374":70117,"_29561":70081,"_20535":118617,"_5":14089,"_26896":118516,"_2860":118618},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3374":70118,"_29561":70081,"_20535":118620,"_5":14089,"_26896":118524,"_2860":118621},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3374":70119,"_29561":70081,"_20535":118623,"_5":14089,"_26896":118528,"_2860":118624},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3374":70120,"_29561":70081,"_20535":118626,"_5":14089,"_26896":118532,"_2860":118627},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3374":70121,"_29561":70081,"_20535":118629,"_5":14089,"_26896":118536,"_2860":118630},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3374":70122,"_29561":70081,"_20535":118632,"_5":14089,"_26896":118540,"_2860":118633},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3374":70123,"_29561":70081,"_20535":118635,"_5":14089,"_26896":118544,"_2860":118636},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3374":70124,"_29561":70081,"_20535":118638,"_5":14089,"_26896":118548,"_2860":118094},[],{"_3374":70125,"_29561":70081,"_20535":118640,"_5":14089,"_26896":118548,"_2860":118641},[],"Qué prepara o comprueba",{"_3374":70126,"_29561":70081,"_20535":118643,"_5":14089,"_26896":118548,"_2860":118097},[],{"_3374":70127,"_29561":70081,"_20535":118645,"_5":14089,"_26896":118548,"_2860":118646},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3374":70128,"_29561":70081,"_20535":118648,"_5":14089,"_26896":118548,"_2860":118649},[],"Administrador de la flota",{"_3374":70129,"_29561":70081,"_20535":118651,"_5":14089,"_26896":118548,"_2860":118652},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3374":70130,"_29561":70081,"_20535":118654,"_5":14089,"_26896":118548,"_2860":118109},[],{"_3374":70131,"_29561":70081,"_20535":118656,"_5":14089,"_26896":118548,"_2860":118657},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3374":70132,"_29561":70081,"_20535":118659,"_5":14089,"_26896":118548,"_2860":118115},[],{"_3374":70133,"_29561":70081,"_20535":118661,"_5":14089,"_26896":118548,"_2860":118662},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3374":70134,"_29561":70081,"_20535":118664,"_5":14089,"_26896":118548,"_2860":118665},[],"Operador de infraestructura",{"_3374":70135,"_29561":70081,"_20535":118667,"_5":14089,"_26896":118548,"_2860":118668},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3374":70136,"_29561":70081,"_20535":118670,"_5":14089,"_26896":118548,"_2860":118671},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3374":70137,"_29561":70137,"_5":14447,"_2860":118673,"_29893":118674,"_20535":118676,"_26896":70137},"Jerarquía y rotación de CAs",[48107,114800,53577,118675],"Claves, autoridades y certificados",[],{"_3374":70138,"_29561":70137,"_20535":118678,"_5":14089,"_26896":70137,"_2860":118679},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3374":70139,"_29561":70137,"_5":29890,"_20535":118681,"_26896":118682,"_2860":118683},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3374":70140,"_29561":70137,"_5":29890,"_20535":118685,"_26896":118686,"_2860":118687},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3374":70141,"_29561":70137,"_5":29890,"_20535":118689,"_26896":118690,"_2860":118691},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3374":70142,"_29561":70137,"_5":29890,"_20535":118693,"_26896":118694,"_2860":118695},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3374":70143,"_29561":70137,"_5":29890,"_20535":118697,"_26896":118698,"_2860":118699},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3374":70144,"_29561":70137,"_5":29890,"_20535":118701,"_26896":118702,"_2860":118703},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3374":70145,"_29561":70137,"_5":29890,"_20535":118705,"_26896":118706,"_2860":118707},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3374":70146,"_29561":70137,"_5":29890,"_20535":118709,"_26896":118710,"_2860":118711},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3374":70147,"_29561":70137,"_5":29890,"_20535":118713,"_26896":118714,"_2860":118715},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3374":70148,"_29561":70137,"_5":29890,"_20535":118717,"_26896":118718,"_2860":118719},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3374":70149,"_29561":70137,"_5":29890,"_20535":118721,"_26896":118722,"_2860":118723},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3374":70150,"_29561":70137,"_5":29890,"_20535":118725,"_26896":118726,"_2860":118727},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3374":70151,"_29561":70137,"_20535":118729,"_5":14089,"_26896":70137,"_2860":118730},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3374":70152,"_29561":70137,"_20535":118732,"_5":14089,"_26896":70137,"_2860":118733},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3374":70153,"_29561":70137,"_20535":118735,"_5":14089,"_26896":118682,"_2860":118736},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3374":70154,"_29561":70137,"_20535":118738,"_5":14089,"_26896":118682,"_2860":118739},[],"entorno, como producción y preproducción;",{"_3374":70155,"_29561":70137,"_20535":118741,"_5":14089,"_26896":118682,"_2860":118742},[],"propietario o equipo operador;",{"_3374":70156,"_29561":70137,"_20535":118744,"_5":14089,"_26896":118682,"_2860":118745},[],"familia de dispositivos o proceso de fabricación;",{"_3374":70157,"_29561":70137,"_20535":118747,"_5":14089,"_26896":118682,"_2860":118748},[],"región o requisito regulatorio;",{"_3374":70158,"_29561":70137,"_20535":118750,"_5":14089,"_26896":118682,"_2860":118751},[],"motor criptográfico o política de clave;",{"_3374":70159,"_29561":70137,"_20535":118753,"_5":14089,"_26896":118682,"_2860":118754},[],"ventana de mantenimiento y ritmo de renovación.",{"_3374":70160,"_29561":70137,"_20535":118756,"_5":14089,"_26896":118682,"_2860":118757},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3374":70161,"_29561":70137,"_20535":118759,"_5":14089,"_26896":118682,"_2860":118760},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3374":70162,"_29561":70137,"_20535":118762,"_5":14089,"_26896":118686,"_2860":118763},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3374":70163,"_29561":70137,"_20535":118765,"_5":14089,"_26896":118686,"_2860":118766},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3374":70164,"_29561":70137,"_20535":118768,"_5":14089,"_26896":118686,"_2860":118769},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3374":70165,"_29561":70137,"_20535":118771,"_5":14089,"_26896":118690,"_2860":118772},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3374":70166,"_29561":70137,"_20535":118774,"_5":14089,"_26896":118690,"_2860":118775},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3374":70167,"_29561":70137,"_20535":118777,"_5":14089,"_26896":118690,"_2860":118778},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3374":70168,"_29561":70137,"_20535":118780,"_5":14089,"_26896":118690,"_2860":118781},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3374":70169,"_29561":70137,"_20535":118783,"_5":14089,"_26896":118698,"_2860":118784},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3374":70170,"_29561":70137,"_20535":118786,"_5":14089,"_26896":118702,"_2860":118787},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3374":70171,"_29561":70137,"_20535":118789,"_5":14089,"_26896":118706,"_2860":118790},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3374":70172,"_29561":70137,"_20535":118792,"_5":14089,"_26896":118710,"_2860":118793},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3374":70173,"_29561":70137,"_20535":118795,"_5":14089,"_26896":118714,"_2860":118796},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3374":70174,"_29561":70137,"_20535":118798,"_5":14089,"_26896":118718,"_2860":118799},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3374":70175,"_29561":70137,"_20535":118801,"_5":14089,"_26896":118722,"_2860":118802},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3374":70176,"_29561":70137,"_20535":118804,"_5":14089,"_26896":118722,"_2860":118805},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3374":70177,"_29561":70137,"_20535":118807,"_5":14089,"_26896":118722,"_2860":118808},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3374":70178,"_29561":70137,"_20535":118810,"_5":14089,"_26896":118722,"_2860":118811},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3374":70179,"_29561":70137,"_20535":118813,"_5":14089,"_26896":118726,"_2860":118814},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3374":70180,"_29561":70137,"_20535":118816,"_5":14089,"_26896":118726,"_2860":118817},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3374":70181,"_29561":70137,"_20535":118819,"_5":14089,"_26896":118726,"_2860":118820},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3374":70182,"_29561":70137,"_20535":118822,"_5":14089,"_26896":118726,"_2860":118823},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3374":70183,"_29561":70137,"_20535":118825,"_5":14089,"_26896":118726,"_2860":118826},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3374":70184,"_29561":70137,"_20535":118828,"_5":14089,"_26896":118726,"_2860":118829},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3374":70185,"_29561":70137,"_20535":118831,"_5":14089,"_26896":118726,"_2860":118832},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3374":70186,"_29561":70186,"_5":14447,"_2860":118834,"_29893":118835,"_20535":118836,"_26896":70186},"Autoridades de certificación",[48107,114800,53577,118675],[],{"_3374":70187,"_29561":70186,"_20535":118838,"_5":14089,"_26896":70186,"_2860":118839},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3374":70188,"_29561":70186,"_5":29890,"_20535":118841,"_26896":118842,"_2860":118843},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3374":70189,"_29561":70186,"_5":29890,"_20535":118845,"_26896":118846,"_2860":118847},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3374":70190,"_29561":70186,"_5":29890,"_20535":118849,"_26896":118850,"_2860":113378},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3374":70191,"_29561":70186,"_5":29890,"_20535":118852,"_26896":118853,"_2860":118854},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3374":70192,"_29561":70186,"_5":29890,"_20535":118856,"_26896":118857,"_2860":118858},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3374":70193,"_29561":70186,"_5":29890,"_20535":118860,"_26896":118861,"_2860":118862},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3374":70194,"_29561":70186,"_5":29890,"_20535":118864,"_26896":118865,"_2860":118866},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3374":70195,"_29561":70186,"_5":29890,"_20535":118868,"_26896":118869,"_2860":118870},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3374":70196,"_29561":70186,"_5":29890,"_20535":118872,"_26896":118873,"_2860":118874},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3374":70197,"_29561":70186,"_5":29890,"_20535":118876,"_26896":118877,"_2860":118878},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3374":70198,"_29561":70186,"_5":29890,"_20535":118880,"_26896":118881,"_2860":118882},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3374":70199,"_29561":70186,"_5":29890,"_20535":118884,"_26896":118885,"_2860":118886},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3374":70200,"_29561":70186,"_5":29890,"_20535":118888,"_26896":118889,"_2860":118890},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3374":70201,"_29561":70186,"_5":29890,"_20535":118892,"_26896":118893,"_2860":118894},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3374":70202,"_29561":70186,"_5":29890,"_20535":118896,"_26896":118897,"_2860":118898},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3374":70203,"_29561":70186,"_5":29890,"_20535":118900,"_26896":118901,"_2860":118902},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3374":70204,"_29561":70186,"_5":29890,"_20535":118904,"_26896":118905,"_2860":118906},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3374":70205,"_29561":70186,"_5":29890,"_20535":118908,"_26896":118909,"_2860":118910},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3374":70206,"_29561":70186,"_5":29890,"_20535":118912,"_26896":118913,"_2860":118914},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3374":70207,"_29561":70186,"_5":29890,"_20535":118916,"_26896":118917,"_2860":118918},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3374":70208,"_29561":70186,"_5":29890,"_20535":118920,"_26896":118921,"_2860":118922},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3374":70209,"_29561":70186,"_5":29890,"_20535":118924,"_26896":118925,"_2860":118926},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3374":70210,"_29561":70186,"_5":29890,"_20535":118928,"_26896":118929,"_2860":118930},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3374":70211,"_29561":70186,"_20535":118932,"_5":14089,"_26896":70186,"_2860":118933},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3374":70212,"_29561":70186,"_20535":118935,"_5":14089,"_26896":70186,"_2860":118936},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3374":70213,"_29561":70186,"_20535":118938,"_5":14089,"_26896":70186,"_2860":118939},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3374":70214,"_29561":70186,"_20535":118941,"_5":14089,"_26896":118842,"_2860":118942},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3374":70215,"_29561":70186,"_20535":118944,"_5":14089,"_26896":118842,"_2860":118945},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3374":70216,"_29561":70186,"_20535":118947,"_5":14089,"_26896":118842,"_2860":118948},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3374":70217,"_29561":70186,"_20535":118950,"_5":14089,"_26896":118842,"_2860":118951},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3374":70218,"_29561":70186,"_20535":118953,"_5":14089,"_26896":118842,"_2860":118954},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3374":70219,"_29561":70186,"_20535":118956,"_5":14089,"_26896":118850,"_2860":118957},[],"Decide si la CA será raíz o intermedia.",{"_3374":70220,"_29561":70186,"_20535":118959,"_5":14089,"_26896":118850,"_2860":118960},[],"Elige el motor que custodiará la clave.",{"_3374":70221,"_29561":70186,"_20535":118962,"_5":14089,"_26896":118850,"_2860":118963},[],"Define una validez superior a la de los certificados que emitirá.",{"_3374":70222,"_29561":70186,"_20535":118965,"_5":14089,"_26896":118850,"_2860":118966},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3374":70223,"_29561":70186,"_20535":118968,"_5":14089,"_26896":118853,"_2860":118969},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3374":70224,"_29561":70186,"_20535":118971,"_5":14089,"_26896":118857,"_2860":118972},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3374":70225,"_29561":70186,"_20535":118974,"_5":14089,"_26896":118857,"_2860":118975},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3374":70226,"_29561":70186,"_20535":118977,"_5":14089,"_26896":118861,"_2860":118978},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3374":70227,"_29561":70186,"_20535":118980,"_5":14089,"_26896":118865,"_2860":118981},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3374":70228,"_29561":70186,"_20535":118983,"_5":14089,"_26896":118865,"_2860":118984},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3374":70229,"_29561":70186,"_20535":118986,"_5":14089,"_26896":118865,"_2860":118987},[],"`ST`: estado o provincia.",{"_3374":70230,"_29561":70186,"_20535":118989,"_5":14089,"_26896":118865,"_2860":118990},[],"`L`: localidad.",{"_3374":70231,"_29561":70186,"_20535":118992,"_5":14089,"_26896":118865,"_2860":118993},[],"`O`: organización.",{"_3374":70232,"_29561":70186,"_20535":118995,"_5":14089,"_26896":118865,"_2860":118996},[],"`OU`: unidad organizativa.",{"_3374":70233,"_29561":70186,"_20535":118998,"_5":14089,"_26896":118865,"_2860":118999},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3374":70234,"_29561":70186,"_20535":119001,"_5":14089,"_26896":118869,"_2860":119002},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3374":70235,"_29561":70186,"_20535":119004,"_5":14089,"_26896":118869,"_2860":119005},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3374":70236,"_29561":70186,"_20535":119007,"_5":14089,"_26896":118873,"_2860":119008},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3374":70237,"_29561":70186,"_20535":119010,"_5":14089,"_26896":118873,"_2860":119011},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3374":70238,"_29561":70186,"_20535":119013,"_5":14089,"_26896":118877,"_2860":119014},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3374":70239,"_29561":70186,"_20535":119016,"_5":14089,"_26896":118877,"_2860":119017},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3374":70240,"_29561":70186,"_20535":119019,"_5":14089,"_26896":118881,"_2860":119020},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3374":70241,"_29561":70186,"_20535":119022,"_5":14089,"_26896":118881,"_2860":119023},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3374":70242,"_29561":70186,"_20535":119025,"_5":14089,"_26896":118881,"_2860":119026},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3374":70243,"_29561":70186,"_20535":119028,"_5":14089,"_26896":118885,"_2860":119029},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3374":70244,"_29561":70186,"_20535":119031,"_5":14089,"_26896":118889,"_2860":119032},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3374":70245,"_29561":70186,"_20535":119034,"_5":14089,"_26896":118893,"_2860":119035},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3374":70246,"_29561":70186,"_20535":119037,"_5":14089,"_26896":118897,"_2860":119038},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3374":70247,"_29561":70186,"_20535":119040,"_5":14089,"_26896":118897,"_2860":119041},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3374":70248,"_29561":70186,"_20535":119043,"_5":14089,"_26896":118901,"_2860":119044},[],"Abre una CA desde el inventario para consultar:",{"_3374":70249,"_29561":70186,"_20535":119046,"_5":14089,"_26896":118901,"_2860":119047},[],"Estado y periodo de validez.",{"_3374":70250,"_29561":70186,"_20535":119049,"_5":14089,"_26896":118901,"_2860":119050},[],"Certificado y cadena en formato PEM.",{"_3374":70251,"_29561":70186,"_20535":119052,"_5":14089,"_26896":118901,"_2860":119053},[],"Número de certificados activos, expirados y revocados.",{"_3374":70252,"_29561":70186,"_20535":119055,"_5":14089,"_26896":118901,"_2860":119056},[],"Certificados emitidos en **Issued Certificates**.",{"_3374":70253,"_29561":70186,"_20535":119058,"_5":14089,"_26896":118901,"_2860":119059},[],"CRL vinculada a la autoridad.",{"_3374":70254,"_29561":70186,"_20535":119061,"_5":14089,"_26896":118901,"_2860":119062},[],"Metadatos y motor criptográfico asociado.",{"_3374":70255,"_29561":70186,"_20535":119064,"_5":14089,"_26896":118901,"_2860":119065},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3374":70256,"_29561":70186,"_20535":119067,"_5":14089,"_26896":118905,"_2860":119068},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3374":70257,"_29561":70186,"_20535":119070,"_5":14089,"_26896":118905,"_2860":119071},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3374":70258,"_29561":70186,"_20535":119073,"_5":14089,"_26896":118905,"_2860":119074},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3374":70259,"_29561":70186,"_20535":119076,"_5":14089,"_26896":118905,"_2860":119077},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3374":70260,"_29561":70186,"_20535":119079,"_5":14089,"_26896":118909,"_2860":119080},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3374":70261,"_29561":70186,"_20535":119082,"_5":14089,"_26896":118913,"_2860":119083},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3374":70262,"_29561":70186,"_20535":119085,"_5":14089,"_26896":118917,"_2860":119086},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3374":70263,"_29561":70186,"_20535":119088,"_5":14089,"_26896":118921,"_2860":119089},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3374":70264,"_29561":70186,"_20535":119091,"_5":14089,"_26896":118925,"_2860":119092},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3374":70265,"_29561":70186,"_20535":119094,"_5":14089,"_26896":118929,"_2860":119095},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3374":70266,"_29561":70186,"_20535":119097,"_5":14089,"_26896":118929,"_2860":119098},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3374":70267,"_29561":70186,"_20535":119100,"_5":14089,"_26896":118929,"_2860":119101},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3374":70268,"_29561":70268,"_5":14447,"_2860":119103,"_29893":119104,"_20535":119105,"_26896":70268},"Perfiles de certificado",[48107,114800,53577,118675],[],{"_3374":70269,"_29561":70268,"_20535":119107,"_5":14089,"_26896":70268,"_2860":119108},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3374":70270,"_29561":70268,"_5":29890,"_20535":119110,"_26896":119111,"_2860":119112},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3374":70271,"_29561":70268,"_5":29890,"_20535":119114,"_26896":119115,"_2860":119116},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3374":70272,"_29561":70268,"_5":29890,"_20535":119118,"_26896":119119,"_2860":119120},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3374":70273,"_29561":70268,"_5":29890,"_20535":119122,"_26896":119123,"_2860":119124},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3374":70274,"_29561":70268,"_5":29890,"_20535":119126,"_26896":119127,"_2860":119128},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3374":70275,"_29561":70268,"_5":29890,"_20535":119130,"_26896":119131,"_2860":119132},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3374":70276,"_29561":70268,"_5":29890,"_20535":119134,"_26896":119135,"_2860":119136},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3374":70277,"_29561":70268,"_5":29890,"_20535":119138,"_26896":119139,"_2860":119140},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3374":70278,"_29561":70268,"_5":29890,"_20535":119142,"_26896":119143,"_2860":119144},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3374":70279,"_29561":70268,"_5":29890,"_20535":119146,"_26896":119147,"_2860":119148},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3374":70280,"_29561":70268,"_5":29890,"_20535":119150,"_26896":119151,"_2860":119152},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3374":70281,"_29561":70268,"_5":29890,"_20535":119154,"_26896":119155,"_2860":119156},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3374":70282,"_29561":70268,"_5":29890,"_20535":119158,"_26896":119159,"_2860":119160},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3374":70283,"_29561":70268,"_5":29890,"_20535":119162,"_26896":119163,"_2860":119164},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3374":70284,"_29561":70268,"_5":29890,"_20535":119166,"_26896":119167,"_2860":119168},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3374":70285,"_29561":70268,"_5":29890,"_20535":119170,"_26896":119171,"_2860":119172},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3374":70286,"_29561":70268,"_20535":119174,"_5":14089,"_26896":70268,"_2860":119175},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3374":70287,"_29561":70268,"_20535":119177,"_5":14089,"_26896":70268,"_2860":119178},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3374":70288,"_29561":70268,"_20535":119180,"_5":14089,"_26896":119115,"_2860":119181},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3374":70289,"_29561":70268,"_20535":119183,"_5":14089,"_26896":119115,"_2860":119184},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3374":70290,"_29561":70268,"_20535":119186,"_5":14089,"_26896":119119,"_2860":119187},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3374":70291,"_29561":70268,"_20535":119189,"_5":14089,"_26896":119123,"_2860":119190},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3374":70292,"_29561":70268,"_20535":119192,"_5":14089,"_26896":119123,"_2860":119193},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3374":70293,"_29561":70268,"_20535":119195,"_5":14089,"_26896":119123,"_2860":119196},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3374":70294,"_29561":70268,"_20535":119198,"_5":14089,"_26896":119127,"_2860":119199},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3374":70295,"_29561":70268,"_20535":119201,"_5":14089,"_26896":119131,"_2860":119202},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3374":70296,"_29561":70268,"_20535":119204,"_5":14089,"_26896":119131,"_2860":119205},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3374":70297,"_29561":70268,"_20535":119207,"_5":14089,"_26896":119135,"_2860":119208},[],"La aplicación criptográfica puede:",{"_3374":70298,"_29561":70268,"_20535":119210,"_5":14089,"_26896":119135,"_2860":119211},[],"permitir o bloquear claves RSA;",{"_3374":70299,"_29561":70268,"_20535":119213,"_5":14089,"_26896":119135,"_2860":119214},[],"limitar los tamaños RSA admitidos;",{"_3374":70300,"_29561":70268,"_20535":119216,"_5":14089,"_26896":119135,"_2860":119217},[],"permitir o bloquear claves ECDSA;",{"_3374":70301,"_29561":70268,"_20535":119219,"_5":14089,"_26896":119135,"_2860":119220},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3374":70302,"_29561":70268,"_20535":119222,"_5":14089,"_26896":119135,"_2860":119223},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3374":70303,"_29561":70268,"_20535":119225,"_5":14089,"_26896":119139,"_2860":119226},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3374":70304,"_29561":70268,"_20535":119228,"_5":14089,"_26896":119139,"_2860":114560},[],{"_3374":70305,"_29561":70268,"_20535":119230,"_5":14089,"_26896":119139,"_2860":119231},[],"Primera opción",{"_3374":70306,"_29561":70268,"_20535":119233,"_5":14089,"_26896":119139,"_2860":119234},[],"Segunda opción",{"_3374":70307,"_29561":70268,"_20535":119236,"_5":14089,"_26896":119139,"_2860":119237},[],"Si no hay ninguna",{"_3374":70308,"_29561":70268,"_20535":119239,"_5":14089,"_26896":119139,"_2860":119240},[],"Firma directa con una CA",{"_3374":70309,"_29561":70268,"_20535":119242,"_5":14089,"_26896":119139,"_2860":119243},[],"`issuance_profile` incluido en la solicitud",{"_3374":70310,"_29561":70268,"_20535":119245,"_5":14089,"_26896":119139,"_2860":119246},[],"`issuance_profile_id` de la solicitud",{"_3374":70311,"_29561":70268,"_20535":119248,"_5":14089,"_26896":119139,"_2860":119249},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3374":70312,"_29561":70268,"_20535":119251,"_5":14089,"_26896":119139,"_2860":119252},[],"Emisión mediante DMS",{"_3374":70313,"_29561":70268,"_20535":119254,"_5":14089,"_26896":119139,"_2860":54158},[],{"_3374":70314,"_29561":70268,"_20535":119256,"_5":14089,"_26896":119139,"_2860":119257},[],"`settings.issuance_profile` incluido en el DMS",{"_3374":70315,"_29561":70268,"_20535":119259,"_5":14089,"_26896":119139,"_2860":119260},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3374":70316,"_29561":70268,"_20535":119262,"_5":14089,"_26896":119139,"_2860":119263},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3374":70317,"_29561":70268,"_20535":119265,"_5":14089,"_26896":119139,"_2860":119266},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3374":70318,"_29561":70268,"_20535":119268,"_5":14089,"_26896":119147,"_2860":119269},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3374":70319,"_29561":70268,"_20535":119271,"_5":14089,"_26896":119151,"_2860":119272},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3374":70320,"_29561":70268,"_20535":119274,"_5":14089,"_26896":119155,"_2860":119275},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3374":70321,"_29561":70268,"_20535":119277,"_5":14089,"_26896":119159,"_2860":119278},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3374":70322,"_29561":70268,"_20535":119280,"_5":14089,"_26896":119163,"_2860":119281},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3374":70323,"_29561":70268,"_20535":119283,"_5":14089,"_26896":119163,"_2860":119284},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3374":70324,"_29561":70268,"_20535":119286,"_5":14089,"_26896":119167,"_2860":119287},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3374":70325,"_29561":70268,"_20535":119289,"_5":14089,"_26896":119167,"_2860":119290},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3374":70326,"_29561":70268,"_20535":119292,"_5":14089,"_26896":119167,"_2860":119293},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3374":70327,"_29561":70268,"_20535":119295,"_5":14089,"_26896":119167,"_2860":119296},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3374":70328,"_29561":70268,"_20535":119298,"_5":14089,"_26896":119171,"_2860":119299},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3374":70329,"_29561":70268,"_20535":119301,"_5":14089,"_26896":119171,"_2860":119302},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3374":70330,"_29561":70330,"_5":14447,"_2860":119304,"_29893":119305,"_20535":119307,"_26896":70330},"Validación de certificados",[48107,114800,53577,119306],"Validación",[],{"_3374":70331,"_29561":70330,"_20535":119309,"_5":14089,"_26896":70330,"_2860":119310},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3374":70332,"_29561":70330,"_5":29890,"_20535":119312,"_26896":119313,"_2860":119314},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3374":70333,"_29561":70330,"_5":29890,"_20535":119316,"_26896":119317,"_2860":119318},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3374":70334,"_29561":70330,"_5":29890,"_20535":119320,"_26896":119321,"_2860":119322},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3374":70335,"_29561":70330,"_20535":119324,"_5":14089,"_26896":70330,"_2860":119325},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3374":70336,"_29561":70330,"_20535":119327,"_5":14089,"_26896":119313,"_2860":119328},[],"Verifica estos criterios juntos:",{"_3374":70337,"_29561":70330,"_20535":119330,"_5":14089,"_26896":119313,"_2860":118304},[],{"_3374":70338,"_29561":70330,"_20535":119332,"_5":14089,"_26896":119313,"_2860":119333},[],"Resultado necesario",{"_3374":70339,"_29561":70330,"_20535":119335,"_5":14089,"_26896":119313,"_2860":119336},[],"Cadena y firma",{"_3374":70340,"_29561":70330,"_20535":119338,"_5":14089,"_26896":119313,"_2860":119339},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3374":70341,"_29561":70330,"_20535":119341,"_5":14089,"_26896":119313,"_2860":119342},[],"Fechas",{"_3374":70342,"_29561":70330,"_20535":119344,"_5":14089,"_26896":119313,"_2860":119345},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3374":70343,"_29561":70330,"_20535":119347,"_5":14089,"_26896":119313,"_2860":114470},[],{"_3374":70344,"_29561":70330,"_20535":119349,"_5":14089,"_26896":119313,"_2860":119350},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3374":70345,"_29561":70330,"_20535":119352,"_5":14089,"_26896":119313,"_2860":119353},[],"Uso",{"_3374":70346,"_29561":70330,"_20535":119355,"_5":14089,"_26896":119313,"_2860":119356},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3374":70347,"_29561":70330,"_20535":119358,"_5":14089,"_26896":119313,"_2860":119359},[],"Revocación",{"_3374":70348,"_29561":70330,"_20535":119361,"_5":14089,"_26896":119313,"_2860":119362},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3374":70349,"_29561":70330,"_20535":119364,"_5":14089,"_26896":119313,"_2860":119365},[],"Autorización",{"_3374":70350,"_29561":70330,"_20535":119367,"_5":14089,"_26896":119313,"_2860":119368},[],"La aplicación permite la acción a esa identidad.",{"_3374":70351,"_29561":70330,"_20535":119370,"_5":14089,"_26896":119313,"_2860":119371},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3374":70352,"_29561":70330,"_20535":119373,"_5":14089,"_26896":119317,"_2860":119374},[],"Mecanismo",{"_3374":70353,"_29561":70330,"_20535":119376,"_5":14089,"_26896":119317,"_2860":119377},[],"Cuándo utilizarlo",{"_3374":70354,"_29561":70330,"_20535":119379,"_5":14089,"_26896":119317,"_2860":119380},[],"Qué debes mantener",{"_3374":70355,"_29561":70330,"_20535":119382,"_5":14089,"_26896":119317,"_2860":54286},[],{"_3374":70356,"_29561":70330,"_20535":119384,"_5":14089,"_26896":119317,"_2860":119385},[],"Consulta del estado de un certificado concreto.",{"_3374":70357,"_29561":70330,"_20535":119387,"_5":14089,"_26896":119317,"_2860":119388},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3374":70358,"_29561":70330,"_20535":119390,"_5":14089,"_26896":119317,"_2860":54295},[],{"_3374":70359,"_29561":70330,"_20535":119392,"_5":14089,"_26896":119317,"_2860":119393},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3374":70360,"_29561":70330,"_20535":119395,"_5":14089,"_26896":119317,"_2860":119396},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3374":70361,"_29561":70330,"_20535":119398,"_5":14089,"_26896":119317,"_2860":119399},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3374":70362,"_29561":70330,"_20535":119401,"_5":14089,"_26896":119317,"_2860":119402},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3374":70363,"_29561":70330,"_20535":119404,"_5":14089,"_26896":119321,"_2860":119405},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3374":70364,"_29561":70330,"_20535":119407,"_5":14089,"_26896":119321,"_2860":119408},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3374":70365,"_29561":70330,"_20535":119410,"_5":14089,"_26896":119321,"_2860":119411},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3374":70366,"_29561":70330,"_20535":119413,"_5":14089,"_26896":119321,"_2860":119414},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3374":70367,"_29561":70330,"_20535":119416,"_5":14089,"_26896":119321,"_2860":119417},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3374":70368,"_29561":70330,"_20535":119419,"_5":14089,"_26896":119321,"_2860":119420},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3374":70369,"_29561":70330,"_20535":119422,"_5":14089,"_26896":119321,"_2860":119423},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3374":70370,"_29561":70330,"_20535":119425,"_5":14089,"_26896":119321,"_2860":119426},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3374":70371,"_29561":70330,"_20535":119428,"_5":14089,"_26896":119321,"_2860":119429},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3374":70372,"_29561":70372,"_5":14447,"_2860":119431,"_29893":119432,"_20535":119433,"_26896":70372},"Certificados",[48107,114800,53577,118675],[],{"_3374":70373,"_29561":70372,"_20535":119435,"_5":14089,"_26896":70372,"_2860":119436},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3374":70374,"_29561":70372,"_5":29890,"_20535":119438,"_26896":119439,"_2860":119440},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3374":70375,"_29561":70372,"_5":29890,"_20535":119442,"_26896":119443,"_2860":119444},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3374":70376,"_29561":70372,"_5":29890,"_20535":119446,"_26896":119447,"_2860":119448},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3374":70377,"_29561":70372,"_5":29890,"_20535":119450,"_26896":119451,"_2860":119452},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3374":70378,"_29561":70372,"_5":29890,"_20535":119454,"_26896":119455,"_2860":119456},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3374":70379,"_29561":70372,"_5":29890,"_20535":119458,"_26896":119459,"_2860":119460},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3374":70380,"_29561":70372,"_5":29890,"_20535":119462,"_26896":119463,"_2860":119464},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3374":70381,"_29561":70372,"_5":29890,"_20535":119466,"_26896":119467,"_2860":119468},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3374":70382,"_29561":70372,"_5":29890,"_20535":119470,"_26896":119471,"_2860":119472},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3374":70383,"_29561":70372,"_20535":119474,"_5":14089,"_26896":70372,"_2860":119475},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3374":70384,"_29561":70372,"_20535":119477,"_5":14089,"_26896":119439,"_2860":119478},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos. Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`), y las listas de certificados pueden filtrarse por `has_private_key`.",{"_3374":70385,"_29561":70372,"_20535":119480,"_5":14089,"_26896":119439,"_2860":119481},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3374":70386,"_29561":70372,"_20535":119483,"_5":14089,"_26896":119443,"_2860":119484},[],"Descarga el PEM e inspecciónalo:",{"_3374":70387,"_29561":70372,"_20535":119486,"_5":14089,"_26896":119443,"_2860":119487},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3374":70388,"_29561":70372,"_20535":119489,"_5":14089,"_26896":119447,"_2860":119490},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3374":70389,"_29561":70372,"_20535":119492,"_5":14089,"_26896":119447,"_2860":119493},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3374":70390,"_29561":70372,"_20535":119495,"_5":14089,"_26896":119447,"_2860":119496},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3374":70391,"_29561":70372,"_20535":119498,"_5":14089,"_26896":119447,"_2860":119499},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3374":70392,"_29561":70372,"_20535":119501,"_5":14089,"_26896":119447,"_2860":119502},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3374":70393,"_29561":70372,"_20535":119504,"_5":14089,"_26896":119447,"_2860":119505},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3374":70394,"_29561":70372,"_20535":119507,"_5":14089,"_26896":119447,"_2860":119508},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3374":70395,"_29561":70372,"_20535":119510,"_5":14089,"_26896":119451,"_2860":119511},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3374":70396,"_29561":70372,"_20535":119513,"_5":14089,"_26896":119455,"_2860":119514},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3374":70397,"_29561":70372,"_20535":119516,"_5":14089,"_26896":119459,"_2860":119517},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3374":70398,"_29561":70372,"_20535":119519,"_5":14089,"_26896":119463,"_2860":119520},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3374":70399,"_29561":70372,"_20535":119522,"_5":14089,"_26896":119463,"_2860":119523},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3374":70400,"_29561":70372,"_20535":119525,"_5":14089,"_26896":119463,"_2860":119526},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3374":70401,"_29561":70372,"_20535":119528,"_5":14089,"_26896":119467,"_2860":119529},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3374":70402,"_29561":70372,"_20535":119531,"_5":14089,"_26896":119467,"_2860":119532},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3374":70403,"_29561":70372,"_20535":119534,"_5":14089,"_26896":119467,"_2860":119535},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3374":70404,"_29561":70372,"_20535":119537,"_5":14089,"_26896":119471,"_2860":119538},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3374":70405,"_29561":70372,"_20535":119540,"_5":14089,"_26896":119471,"_2860":119541},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3374":70406,"_29561":70406,"_5":14447,"_2860":119543,"_29893":119544,"_20535":119546,"_26896":70406},"Ciclo de vida de un certificado",[48107,114800,53577,119545],"Conceptos",[],{"_3374":70407,"_29561":70406,"_20535":119548,"_5":14089,"_26896":70406,"_2860":119549},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3374":70408,"_29561":70406,"_5":29890,"_20535":119551,"_26896":119552,"_2860":119553},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3374":70409,"_29561":70406,"_5":29890,"_20535":119555,"_26896":119556,"_2860":119557},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3374":70410,"_29561":70406,"_5":29890,"_20535":119559,"_26896":119560,"_2860":119561},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3374":70411,"_29561":70406,"_5":29890,"_20535":119563,"_26896":119564,"_2860":119565},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3374":70412,"_29561":70406,"_5":29890,"_20535":119567,"_26896":119568,"_2860":119569},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3374":70413,"_29561":70406,"_5":29890,"_20535":119571,"_26896":119572,"_2860":119573},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3374":70414,"_29561":70406,"_5":29890,"_20535":119575,"_26896":119576,"_2860":117298},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3374":70415,"_29561":70406,"_5":29890,"_20535":119578,"_26896":119579,"_2860":119580},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3374":70416,"_29561":70406,"_5":29890,"_20535":119582,"_26896":119583,"_2860":119584},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3374":70417,"_29561":70406,"_5":29890,"_20535":119586,"_26896":119587,"_2860":119588},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3374":70418,"_29561":70406,"_20535":119590,"_5":14089,"_26896":70406,"_2860":119591},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3374":70419,"_29561":70406,"_20535":119593,"_5":14089,"_26896":119556,"_2860":119594},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3374":70420,"_29561":70406,"_20535":119596,"_5":14089,"_26896":119560,"_2860":119597},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3374":70421,"_29561":70406,"_20535":119599,"_5":14089,"_26896":119564,"_2860":119600},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3374":70422,"_29561":70406,"_20535":119602,"_5":14089,"_26896":119568,"_2860":119603},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3374":70423,"_29561":70406,"_20535":119605,"_5":14089,"_26896":119572,"_2860":119606},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3374":70424,"_29561":70406,"_20535":119608,"_5":14089,"_26896":119576,"_2860":119609},[],"Lamassu persiste cuatro estados X.509:",{"_3374":70425,"_29561":70406,"_20535":119611,"_5":14089,"_26896":119576,"_2860":119612},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3374":70426,"_29561":70406,"_20535":119614,"_5":14089,"_26896":119576,"_2860":119615},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3374":70427,"_29561":70406,"_20535":119617,"_5":14089,"_26896":119576,"_2860":119618},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3374":70428,"_29561":70406,"_20535":119620,"_5":14089,"_26896":119576,"_2860":119621},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3374":70429,"_29561":70406,"_20535":119623,"_5":14089,"_26896":119576,"_2860":119624},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3374":70430,"_29561":70406,"_20535":119626,"_5":14089,"_26896":119579,"_2860":119627},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3374":70431,"_29561":70406,"_20535":119629,"_5":14089,"_26896":119579,"_2860":119630},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3374":70432,"_29561":70406,"_20535":119632,"_5":14089,"_26896":119579,"_2860":119633},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3374":70433,"_29561":70406,"_20535":119635,"_5":14089,"_26896":119583,"_2860":119636},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3374":70434,"_29561":70406,"_20535":119638,"_5":14089,"_26896":119583,"_2860":119639},[],"Antes de confirmar:",{"_3374":70435,"_29561":70406,"_20535":119641,"_5":14089,"_26896":119583,"_2860":119642},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3374":70436,"_29561":70406,"_20535":119644,"_5":14089,"_26896":119583,"_2860":119645},[],"Distribuye la nueva cadena de confianza.",{"_3374":70437,"_29561":70406,"_20535":119647,"_5":14089,"_26896":119583,"_2860":119648},[],"Reemite las identidades necesarias.",{"_3374":70438,"_29561":70406,"_20535":119650,"_5":14089,"_26896":119583,"_2860":119651},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3374":70439,"_29561":70406,"_20535":119653,"_5":14089,"_26896":119583,"_2860":119654},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3374":70440,"_29561":70406,"_20535":119656,"_5":14089,"_26896":119583,"_2860":119657},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3374":70441,"_29561":70406,"_20535":119659,"_5":14089,"_26896":119587,"_2860":119660},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3374":70442,"_29561":70406,"_20535":119662,"_5":14089,"_26896":119587,"_2860":119663},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3374":70443,"_29561":70406,"_20535":119665,"_5":14089,"_26896":119587,"_2860":119666},[],"Cambios de estado y razones de revocación.",{"_3374":70444,"_29561":70406,"_20535":119668,"_5":14089,"_26896":119587,"_2860":119669},[],"Publicación y vigencia de OCSP y CRLs.",{"_3374":70445,"_29561":70406,"_20535":119671,"_5":14089,"_26896":119587,"_2860":119672},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3374":70446,"_29561":70406,"_20535":119674,"_5":14089,"_26896":119587,"_2860":119675},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3374":70447,"_29561":70447,"_5":14447,"_2860":119677,"_29893":119678,"_20535":119679,"_26896":70447},"Modelo de confianza",[48107,114800,53577,119545],[],{"_3374":70448,"_29561":70447,"_20535":119681,"_5":14089,"_26896":70447,"_2860":119682},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3374":70449,"_29561":70447,"_5":29890,"_20535":119684,"_26896":119685,"_2860":119686},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3374":70450,"_29561":70447,"_5":29890,"_20535":119688,"_26896":119689,"_2860":119690},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3374":70451,"_29561":70447,"_5":29890,"_20535":119692,"_26896":119693,"_2860":119694},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3374":70452,"_29561":70447,"_5":29890,"_20535":119696,"_26896":119697,"_2860":119698},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3374":70453,"_29561":70447,"_5":29890,"_20535":119700,"_26896":119701,"_2860":119702},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3374":70454,"_29561":70447,"_5":29890,"_20535":119704,"_26896":119705,"_2860":119706},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3374":70455,"_29561":70447,"_5":29890,"_20535":119708,"_26896":119709,"_2860":119710},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3374":70456,"_29561":70447,"_5":29890,"_20535":119712,"_26896":119713,"_2860":119714},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3374":70457,"_29561":70447,"_5":29890,"_20535":119716,"_26896":119717,"_2860":119718},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3374":70458,"_29561":70447,"_5":29890,"_20535":119720,"_26896":119721,"_2860":119722},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3374":70459,"_29561":70447,"_20535":119724,"_5":14089,"_26896":70447,"_2860":119725},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3374":70460,"_29561":70447,"_20535":119727,"_5":14089,"_26896":119689,"_2860":119728},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3374":70461,"_29561":70447,"_20535":119730,"_5":14089,"_26896":119693,"_2860":119731},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3374":70462,"_29561":70447,"_20535":119733,"_5":14089,"_26896":119697,"_2860":119734},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3374":70463,"_29561":70447,"_20535":119736,"_5":14089,"_26896":119701,"_2860":119737},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3374":70464,"_29561":70447,"_20535":119739,"_5":14089,"_26896":119705,"_2860":119740},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3374":70465,"_29561":70447,"_20535":119742,"_5":14089,"_26896":119705,"_2860":119743},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3374":70466,"_29561":70447,"_20535":119745,"_5":14089,"_26896":119705,"_2860":119746},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3374":70467,"_29561":70447,"_20535":119748,"_5":14089,"_26896":119705,"_2860":119749},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3374":70468,"_29561":70447,"_20535":119751,"_5":14089,"_26896":119705,"_2860":119752},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3374":70469,"_29561":70447,"_20535":119754,"_5":14089,"_26896":119705,"_2860":119755},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3374":70470,"_29561":70447,"_20535":119757,"_5":14089,"_26896":119709,"_2860":119758},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3374":70471,"_29561":70447,"_20535":119760,"_5":14089,"_26896":119709,"_2860":119761},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3374":70472,"_29561":70447,"_20535":119763,"_5":14089,"_26896":119709,"_2860":119764},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3374":70473,"_29561":70447,"_20535":119766,"_5":14089,"_26896":119709,"_2860":119767},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3374":70474,"_29561":70447,"_20535":119769,"_5":14089,"_26896":119709,"_2860":119770},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3374":70475,"_29561":70447,"_20535":119772,"_5":14089,"_26896":119713,"_2860":119773},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3374":70476,"_29561":70447,"_20535":119775,"_5":14089,"_26896":119713,"_2860":119776},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3374":70477,"_29561":70447,"_20535":119778,"_5":14089,"_26896":119713,"_2860":119779},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3374":70478,"_29561":70447,"_20535":119781,"_5":14089,"_26896":119713,"_2860":119782},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3374":70479,"_29561":70447,"_20535":119784,"_5":14089,"_26896":119713,"_2860":119785},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3374":70480,"_29561":70447,"_20535":119787,"_5":14089,"_26896":119713,"_2860":119788},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3374":70481,"_29561":70447,"_20535":119790,"_5":14089,"_26896":119713,"_2860":119791},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3374":70482,"_29561":70447,"_20535":119793,"_5":14089,"_26896":119717,"_2860":119794},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3374":70483,"_29561":70447,"_20535":119796,"_5":14089,"_26896":119721,"_2860":119797},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3374":70484,"_29561":70447,"_20535":119799,"_5":14089,"_26896":119721,"_2860":119800},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3374":70485,"_29561":70447,"_20535":119802,"_5":14089,"_26896":119721,"_2860":119803},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3374":70486,"_29561":70447,"_20535":119805,"_5":14089,"_26896":119721,"_2860":119806},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3374":70487,"_29561":70447,"_20535":119808,"_5":14089,"_26896":119721,"_2860":119809},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3374":70488,"_29561":70447,"_20535":119811,"_5":14089,"_26896":119721,"_2860":119812},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3374":70489,"_29561":70447,"_20535":119814,"_5":14089,"_26896":119721,"_2860":119815},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3374":70490,"_29561":70490,"_5":14447,"_2860":119817,"_29893":119818,"_20535":119819,"_26896":70490},"Listas de revocación (CRL)",[48107,114800,53577,119306],[],{"_3374":70491,"_29561":70490,"_20535":119821,"_5":14089,"_26896":70490,"_2860":119822},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3374":70492,"_29561":70490,"_5":29890,"_20535":119824,"_26896":119825,"_2860":119826},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3374":70493,"_29561":70490,"_5":29890,"_20535":119828,"_26896":119829,"_2860":119830},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3374":70494,"_29561":70490,"_5":29890,"_20535":119832,"_26896":119833,"_2860":119834},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3374":70495,"_29561":70490,"_5":29890,"_20535":119836,"_26896":119837,"_2860":119838},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3374":70496,"_29561":70490,"_5":29890,"_20535":119840,"_26896":119841,"_2860":119842},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3374":70497,"_29561":70490,"_5":29890,"_20535":119844,"_26896":119845,"_2860":119846},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3374":70498,"_29561":70490,"_5":29890,"_20535":119848,"_26896":119849,"_2860":119850},[],"/docs/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3374":70499,"_29561":70490,"_5":29890,"_20535":119852,"_26896":119853,"_2860":119854},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3374":70500,"_29561":70490,"_5":29890,"_20535":119856,"_26896":119857,"_2860":119858},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3374":70501,"_29561":70490,"_20535":119860,"_5":14089,"_26896":70490,"_2860":119861},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3374":70502,"_29561":70490,"_20535":119863,"_5":14089,"_26896":119825,"_2860":119864},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3374":70503,"_29561":70490,"_20535":119866,"_5":14089,"_26896":119825,"_2860":119867},[],"Campo de `crl_options`",{"_3374":70504,"_29561":70490,"_20535":119869,"_5":14089,"_26896":119825,"_2860":116338},[],{"_3374":70505,"_29561":70490,"_20535":119871,"_5":14089,"_26896":119825,"_2860":119872},[],"Valor inicial del backend",{"_3374":70506,"_29561":70490,"_20535":119874,"_5":14089,"_26896":119825,"_2860":54781},[],{"_3374":70507,"_29561":70490,"_20535":119876,"_5":14089,"_26896":119825,"_2860":119877},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3374":70508,"_29561":70490,"_20535":119879,"_5":14089,"_26896":119825,"_2860":119880},[],"7 días.",{"_3374":70509,"_29561":70490,"_20535":119882,"_5":14089,"_26896":119825,"_2860":54790},[],{"_3374":70510,"_29561":70490,"_20535":119884,"_5":14089,"_26896":119825,"_2860":119885},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3374":70511,"_29561":70490,"_20535":119887,"_5":14089,"_26896":119825,"_2860":119888},[],"6 días y 23 horas.",{"_3374":70512,"_29561":70490,"_20535":119890,"_5":14089,"_26896":119825,"_2860":54799},[],{"_3374":70513,"_29561":70490,"_20535":119892,"_5":14089,"_26896":119825,"_2860":119893},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3374":70514,"_29561":70490,"_20535":119895,"_5":14089,"_26896":119825,"_2860":54805},[],{"_3374":70515,"_29561":70490,"_20535":119897,"_5":14089,"_26896":119825,"_2860":54808},[],{"_3374":70516,"_29561":70490,"_20535":119899,"_5":14089,"_26896":119825,"_2860":119900},[],"Número de serie del certificado existente que firma la CRL.",{"_3374":70517,"_29561":70490,"_20535":119902,"_5":14089,"_26896":119825,"_2860":119903},[],"Número de serie del certificado actual de la CA.",{"_3374":70518,"_29561":70490,"_20535":119905,"_5":14089,"_26896":119825,"_2860":119906},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3374":70519,"_29561":70490,"_20535":119908,"_5":14089,"_26896":119825,"_2860":119909},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3374":70520,"_29561":70490,"_20535":119911,"_5":14089,"_26896":119825,"_2860":119912},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3374":70521,"_29561":70490,"_20535":119914,"_5":14089,"_26896":119825,"_2860":119915},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3374":70522,"_29561":70490,"_20535":119917,"_5":14089,"_26896":119825,"_2860":119918},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3374":70523,"_29561":70490,"_20535":119920,"_5":14089,"_26896":119825,"_2860":119921},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3374":70524,"_29561":70490,"_20535":119923,"_5":14089,"_26896":119825,"_2860":119924},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3374":70525,"_29561":70490,"_20535":119926,"_5":14089,"_26896":119829,"_2860":119927},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3374":70526,"_29561":70490,"_20535":119929,"_5":14089,"_26896":119829,"_2860":119930},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3374":70527,"_29561":70490,"_20535":119932,"_5":14089,"_26896":119829,"_2860":119933},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3374":70528,"_29561":70490,"_20535":119935,"_5":14089,"_26896":119829,"_2860":119936},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3374":70529,"_29561":70490,"_20535":119938,"_5":14089,"_26896":119833,"_2860":119939},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3374":70530,"_29561":70490,"_20535":119941,"_5":14089,"_26896":119833,"_2860":119942},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3374":70531,"_29561":70490,"_20535":119944,"_5":14089,"_26896":119833,"_2860":119945},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3374":70532,"_29561":70490,"_20535":119947,"_5":14089,"_26896":119833,"_2860":119948},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3374":70533,"_29561":70490,"_20535":119950,"_5":14089,"_26896":119837,"_2860":119951},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3374":70534,"_29561":70490,"_20535":119953,"_5":14089,"_26896":119837,"_2860":119954},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3374":70535,"_29561":70490,"_20535":119956,"_5":14089,"_26896":119841,"_2860":119957},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3374":70536,"_29561":70490,"_20535":119959,"_5":14089,"_26896":119841,"_2860":119960},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3374":70537,"_29561":70490,"_20535":119962,"_5":14089,"_26896":119841,"_2860":119963},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3374":70538,"_29561":70490,"_20535":119965,"_5":14089,"_26896":119841,"_2860":119966},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3374":70539,"_29561":70490,"_20535":119968,"_5":14089,"_26896":119841,"_2860":119969},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3374":70540,"_29561":70490,"_20535":119971,"_5":14089,"_26896":119845,"_2860":119972},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3374":70541,"_29561":70490,"_20535":119974,"_5":14089,"_26896":119845,"_2860":116527},[],{"_3374":70542,"_29561":70490,"_20535":119976,"_5":14089,"_26896":119845,"_2860":119977},[],"Path relativo",{"_3374":70543,"_29561":70490,"_20535":119979,"_5":14089,"_26896":119845,"_2860":114560},[],{"_3374":70544,"_29561":70490,"_20535":119981,"_5":14089,"_26896":119845,"_2860":54893},[],{"_3374":70545,"_29561":70490,"_20535":119983,"_5":14089,"_26896":119845,"_2860":54896},[],{"_3374":70546,"_29561":70490,"_20535":119985,"_5":14089,"_26896":119845,"_2860":119986},[],"Consultar `crl_options` y `latest_crl`.",{"_3374":70547,"_29561":70490,"_20535":119988,"_5":14089,"_26896":119845,"_2860":54902},[],{"_3374":70548,"_29561":70490,"_20535":119990,"_5":14089,"_26896":119845,"_2860":54896},[],{"_3374":70549,"_29561":70490,"_20535":119992,"_5":14089,"_26896":119845,"_2860":119993},[],"Sustituir la configuración de CRL.",{"_3374":70550,"_29561":70490,"_20535":119995,"_5":14089,"_26896":119845,"_2860":119996},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3374":70551,"_29561":70490,"_20535":119998,"_5":14089,"_26896":119845,"_2860":119999},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3374":70552,"_29561":70490,"_20535":120001,"_5":14089,"_26896":119849,"_2860":120002},[],"Síntoma",{"_3374":70553,"_29561":70490,"_20535":120004,"_5":14089,"_26896":119849,"_2860":120005},[],"Causa",{"_3374":70554,"_29561":70490,"_20535":120007,"_5":14089,"_26896":119849,"_2860":120008},[],"Acción",{"_3374":70555,"_29561":70490,"_20535":120010,"_5":14089,"_26896":119849,"_2860":120011},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3374":70556,"_29561":70490,"_20535":120013,"_5":14089,"_26896":119849,"_2860":120014},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3374":70557,"_29561":70490,"_20535":120016,"_5":14089,"_26896":119849,"_2860":120017},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3374":70558,"_29561":70490,"_20535":120019,"_5":14089,"_26896":119849,"_2860":120020},[],"`PUT` devuelve 400.",{"_3374":70559,"_29561":70490,"_20535":120022,"_5":14089,"_26896":119849,"_2860":120023},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3374":70560,"_29561":70490,"_20535":120025,"_5":14089,"_26896":119849,"_2860":120026},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3374":70561,"_29561":70490,"_20535":120028,"_5":14089,"_26896":119849,"_2860":120029},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3374":70562,"_29561":70490,"_20535":120031,"_5":14089,"_26896":119849,"_2860":120032},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3374":70563,"_29561":70490,"_20535":120034,"_5":14089,"_26896":119849,"_2860":120035},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3374":70564,"_29561":70490,"_20535":120037,"_5":14089,"_26896":119849,"_2860":120038},[],"La CRL no cambia tras revocar un certificado.",{"_3374":70565,"_29561":70490,"_20535":120040,"_5":14089,"_26896":119849,"_2860":120041},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3374":70566,"_29561":70490,"_20535":120043,"_5":14089,"_26896":119849,"_2860":120044},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3374":70567,"_29561":70490,"_20535":120046,"_5":14089,"_26896":119849,"_2860":120047},[],"Un verificador rechaza la CRL por el emisor.",{"_3374":70568,"_29561":70490,"_20535":120049,"_5":14089,"_26896":119849,"_2860":120050},[],"Varias CAs comparten SKI.",{"_3374":70569,"_29561":70490,"_20535":120052,"_5":14089,"_26896":119849,"_2860":120053},[],"Consulta CAs que comparten clave.",{"_3374":70570,"_29561":70490,"_20535":120055,"_5":14089,"_26896":119853,"_2860":120056},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3374":70571,"_29561":70490,"_20535":120058,"_5":14089,"_26896":119857,"_2860":120059},[],"RFC 5280: perfil X.509 y CRL.",{"_3374":70572,"_29561":70490,"_20535":120061,"_5":14089,"_26896":119857,"_2860":54976},[],{"_3374":70573,"_29561":70490,"_20535":120063,"_5":14089,"_26896":119857,"_2860":54979},[],{"_3374":70574,"_29561":70490,"_20535":120065,"_5":14089,"_26896":119857,"_2860":120066},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3374":70575,"_29561":70490,"_20535":120068,"_5":14089,"_26896":119857,"_2860":120069},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3374":70576,"_29561":70576,"_5":14447,"_2860":120071,"_29893":120072,"_20535":120073,"_26896":70576},"Claves y motores criptográficos",[48107,114800,53577,118675],[],{"_3374":70577,"_29561":70576,"_20535":120075,"_5":14089,"_26896":70576,"_2860":120076},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3374":70578,"_29561":70576,"_5":29890,"_20535":120078,"_26896":120079,"_2860":120080},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3374":70579,"_29561":70576,"_5":29890,"_20535":120082,"_26896":120083,"_2860":120084},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3374":70580,"_29561":70576,"_5":29890,"_20535":120086,"_26896":120087,"_2860":55004},[],"/docs/es/platform/pki/key-management#file-system",{"_3374":70581,"_29561":70576,"_5":29890,"_20535":120089,"_26896":120090,"_2860":55008},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3374":70582,"_29561":70576,"_5":29890,"_20535":120092,"_26896":120093,"_2860":55012},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3374":70583,"_29561":70576,"_5":29890,"_20535":120095,"_26896":120096,"_2860":55016},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3374":70584,"_29561":70576,"_5":29890,"_20535":120098,"_26896":120099,"_2860":55020},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3374":70585,"_29561":70576,"_5":29890,"_20535":120101,"_26896":120102,"_2860":55024},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3374":70586,"_29561":70576,"_5":29890,"_20535":120104,"_26896":120105,"_2860":120106},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3374":70587,"_29561":70576,"_5":29890,"_20535":120108,"_26896":120109,"_2860":120110},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3374":70588,"_29561":70576,"_5":29890,"_20535":120112,"_26896":120113,"_2860":120114},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3374":70589,"_29561":70576,"_5":29890,"_20535":120116,"_26896":120117,"_2860":120118},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3374":70590,"_29561":70576,"_5":29890,"_20535":120120,"_26896":120121,"_2860":120122},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3374":70591,"_29561":70576,"_5":29890,"_20535":120124,"_26896":120125,"_2860":120126},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3374":70592,"_29561":70576,"_5":29890,"_20535":120128,"_26896":120129,"_2860":120130},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3374":70593,"_29561":70576,"_5":29890,"_20535":120132,"_26896":120133,"_2860":55056},[],"/docs/es/platform/pki/key-management#sign",{"_3374":70594,"_29561":70576,"_5":29890,"_20535":120135,"_26896":120136,"_2860":55060},[],"/docs/es/platform/pki/key-management#verify",{"_3374":70595,"_29561":70576,"_5":29890,"_20535":120138,"_26896":120139,"_2860":120140},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3374":70596,"_29561":70576,"_5":29890,"_20535":120142,"_26896":120143,"_2860":120144},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3374":70597,"_29561":70576,"_5":29890,"_20535":120146,"_26896":120147,"_2860":120148},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3374":70598,"_29561":70576,"_20535":120150,"_5":14089,"_26896":70576,"_2860":120151},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3374":70599,"_29561":70576,"_20535":120153,"_5":14089,"_26896":70576,"_2860":120154},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3374":70600,"_29561":70576,"_20535":120156,"_5":14089,"_26896":120079,"_2860":120157},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3374":70601,"_29561":70576,"_20535":120159,"_5":14089,"_26896":120079,"_2860":120160},[],"En la práctica, permite:",{"_3374":70602,"_29561":70576,"_20535":120162,"_5":14089,"_26896":120079,"_2860":120163},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3374":70603,"_29561":70576,"_20535":120165,"_5":14089,"_26896":120079,"_2860":120166},[],"Importar claves creadas externamente.",{"_3374":70604,"_29561":70576,"_20535":120168,"_5":14089,"_26896":120079,"_2860":120169},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3374":70605,"_29561":70576,"_20535":120171,"_5":14089,"_26896":120079,"_2860":120172},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3374":70606,"_29561":70576,"_20535":120174,"_5":14089,"_26896":120083,"_2860":120175},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3374":70607,"_29561":70576,"_20535":120177,"_5":14089,"_26896":120083,"_2860":120178},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3374":70608,"_29561":70576,"_20535":120180,"_5":14089,"_26896":120083,"_2860":120181},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3374":70609,"_29561":70576,"_20535":120183,"_5":14089,"_26896":120087,"_2860":120184},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3374":70610,"_29561":70576,"_20535":120186,"_5":14089,"_26896":120090,"_2860":120187},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3374":70611,"_29561":70576,"_20535":120189,"_5":14089,"_26896":120090,"_2860":120190},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3374":70612,"_29561":70576,"_20535":120192,"_5":14089,"_26896":120093,"_2860":120193},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3374":70613,"_29561":70576,"_20535":120195,"_5":14089,"_26896":120096,"_2860":120196},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3374":70614,"_29561":70576,"_20535":120198,"_5":14089,"_26896":120099,"_2860":120199},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3374":70615,"_29561":70576,"_20535":120201,"_5":14089,"_26896":120102,"_2860":120202},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3374":70616,"_29561":70576,"_20535":120204,"_5":14089,"_26896":120102,"_2860":120205},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3374":70617,"_29561":70576,"_20535":120207,"_5":14089,"_26896":120102,"_2860":120208},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3374":70618,"_29561":70576,"_20535":120210,"_5":14089,"_26896":120102,"_2860":120211},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3374":70619,"_29561":70576,"_20535":120213,"_5":14089,"_26896":120105,"_2860":120214},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3374":70620,"_29561":70576,"_20535":120216,"_5":14089,"_26896":120105,"_2860":120217},[],"La tabla incluye los siguientes campos:",{"_3374":70621,"_29561":70576,"_20535":120219,"_5":14089,"_26896":120105,"_2860":120220},[],"**Name**: nombre descriptivo de la clave.",{"_3374":70622,"_29561":70576,"_20535":120222,"_5":14089,"_26896":120105,"_2860":120223},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3374":70623,"_29561":70576,"_20535":120225,"_5":14089,"_26896":120105,"_2860":120226},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3374":70624,"_29561":70576,"_20535":120228,"_5":14089,"_26896":120105,"_2860":120229},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3374":70625,"_29561":70576,"_20535":120231,"_5":14089,"_26896":120105,"_2860":120232},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3374":70626,"_29561":70576,"_20535":120234,"_5":14089,"_26896":120105,"_2860":120235},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3374":70627,"_29561":70576,"_20535":120237,"_5":14089,"_26896":120105,"_2860":120238},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3374":70628,"_29561":70576,"_20535":120240,"_5":14089,"_26896":120105,"_2860":120241},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3374":70629,"_29561":70576,"_20535":120243,"_5":14089,"_26896":120105,"_2860":120244},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3374":70630,"_29561":70576,"_20535":120246,"_5":14089,"_26896":120105,"_2860":120247},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3374":70631,"_29561":70576,"_20535":120249,"_5":14089,"_26896":120105,"_2860":120250},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3374":70632,"_29561":70576,"_20535":120252,"_5":14089,"_26896":120105,"_2860":120253},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3374":70633,"_29561":70576,"_20535":120255,"_5":14089,"_26896":120105,"_2860":120256},[],"**Delete Key** para eliminar la clave del sistema.",{"_3374":70634,"_29561":70576,"_20535":120258,"_5":14089,"_26896":120109,"_2860":120259},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3374":70635,"_29561":70576,"_20535":120261,"_5":14089,"_26896":120113,"_2860":120262},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3374":70636,"_29561":70576,"_20535":120264,"_5":14089,"_26896":120113,"_2860":120265},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3374":70637,"_29561":70576,"_20535":120267,"_5":14089,"_26896":120113,"_2860":120268},[],"**Key Name**: nombre único y descriptivo.",{"_3374":70638,"_29561":70576,"_20535":120270,"_5":14089,"_26896":120113,"_2860":120271},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3374":70639,"_29561":70576,"_20535":120273,"_5":14089,"_26896":120113,"_2860":120274},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3374":70640,"_29561":70576,"_20535":120276,"_5":14089,"_26896":120113,"_2860":120277},[],"**Tags**: metadatos para clasificar la clave.",{"_3374":70641,"_29561":70576,"_20535":120279,"_5":14089,"_26896":120113,"_2860":120280},[],"**Metadata**: información adicional para usos avanzados.",{"_3374":70642,"_29561":70576,"_20535":120282,"_5":14089,"_26896":120117,"_2860":120283},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3374":70643,"_29561":70576,"_20535":120285,"_5":14089,"_26896":120117,"_2860":120286},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3374":70644,"_29561":70576,"_20535":120288,"_5":14089,"_26896":120117,"_2860":120289},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3374":70645,"_29561":70576,"_20535":120291,"_5":14089,"_26896":120117,"_2860":120292},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3374":70646,"_29561":70576,"_20535":120294,"_5":14089,"_26896":120117,"_2860":120295},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3374":70647,"_29561":70576,"_20535":120297,"_5":14089,"_26896":120117,"_2860":120298},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3374":70648,"_29561":70576,"_20535":120300,"_5":14089,"_26896":120117,"_2860":120301},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3374":70649,"_29561":70576,"_20535":120303,"_5":14089,"_26896":120117,"_2860":120304},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3374":70650,"_29561":70576,"_20535":120306,"_5":14089,"_26896":120117,"_2860":120307},[],"**Metadata**: información adicional opcional.",{"_3374":70651,"_29561":70576,"_20535":120309,"_5":14089,"_26896":120117,"_2860":120310},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3374":70652,"_29561":70576,"_20535":120312,"_5":14089,"_26896":120117,"_2860":120313},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3374":70653,"_29561":70576,"_20535":120315,"_5":14089,"_26896":120121,"_2860":120316},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3374":70654,"_29561":70576,"_20535":120318,"_5":14089,"_26896":120125,"_2860":120319},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3374":70655,"_29561":70576,"_20535":120321,"_5":14089,"_26896":120125,"_2860":120322},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3374":70656,"_29561":70576,"_20535":120324,"_5":14089,"_26896":120125,"_2860":120325},[],"**Key Name**: nombre descriptivo.",{"_3374":70657,"_29561":70576,"_20535":120327,"_5":14089,"_26896":120125,"_2860":120328},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3374":70658,"_29561":70576,"_20535":120330,"_5":14089,"_26896":120125,"_2860":120331},[],"**Tags**: etiquetas asociadas.",{"_3374":70659,"_29561":70576,"_20535":120333,"_5":14089,"_26896":120125,"_2860":120334},[],"**Aliases**: nombres alternativos.",{"_3374":70660,"_29561":70576,"_20535":120336,"_5":14089,"_26896":120125,"_2860":120337},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3374":70661,"_29561":70576,"_20535":120339,"_5":14089,"_26896":120125,"_2860":120340},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3374":70662,"_29561":70576,"_20535":120342,"_5":14089,"_26896":120125,"_2860":120343},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3374":70663,"_29561":70576,"_20535":120345,"_5":14089,"_26896":120125,"_2860":120346},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3374":70664,"_29561":70576,"_20535":120348,"_5":14089,"_26896":120129,"_2860":120349},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3374":70665,"_29561":70576,"_20535":120351,"_5":14089,"_26896":120129,"_2860":120352},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3374":70666,"_29561":70576,"_20535":120354,"_5":14089,"_26896":120129,"_2860":120355},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3374":70667,"_29561":70576,"_20535":120357,"_5":14089,"_26896":120133,"_2860":120358},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3374":70668,"_29561":70576,"_20535":120360,"_5":14089,"_26896":120133,"_2860":120361},[],"Campos principales:",{"_3374":70669,"_29561":70576,"_20535":120363,"_5":14089,"_26896":120133,"_2860":120364},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3374":70670,"_29561":70576,"_20535":120366,"_5":14089,"_26896":120133,"_2860":120367},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3374":70671,"_29561":70576,"_20535":120369,"_5":14089,"_26896":120133,"_2860":120370},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3374":70672,"_29561":70576,"_20535":120372,"_5":14089,"_26896":120133,"_2860":120373},[],"**Message**: contenido que se va a firmar.",{"_3374":70673,"_29561":70576,"_20535":120375,"_5":14089,"_26896":120133,"_2860":120376},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3374":70674,"_29561":70576,"_20535":120378,"_5":14089,"_26896":120136,"_2860":120379},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3374":70675,"_29561":70576,"_20535":120381,"_5":14089,"_26896":120136,"_2860":120361},[],{"_3374":70676,"_29561":70576,"_20535":120383,"_5":14089,"_26896":120136,"_2860":120384},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3374":70677,"_29561":70576,"_20535":120386,"_5":14089,"_26896":120136,"_2860":120387},[],"**Message Type**: `Raw` o `Digest`.",{"_3374":70678,"_29561":70576,"_20535":120389,"_5":14089,"_26896":120136,"_2860":120390},[],"**Payload Encoding**: codificación del mensaje.",{"_3374":70679,"_29561":70576,"_20535":120392,"_5":14089,"_26896":120136,"_2860":120393},[],"**Message**: mensaje original o hash.",{"_3374":70680,"_29561":70576,"_20535":120395,"_5":14089,"_26896":120136,"_2860":120396},[],"**Signature**: firma que se desea comprobar.",{"_3374":70681,"_29561":70576,"_20535":120398,"_5":14089,"_26896":120136,"_2860":120399},[],"**Result**: indicador del resultado de la validación.",{"_3374":70682,"_29561":70576,"_20535":120401,"_5":14089,"_26896":120139,"_2860":120402},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3374":70683,"_29561":70576,"_20535":120404,"_5":14089,"_26896":120139,"_2860":120405},[],"Este flujo es útil para:",{"_3374":70684,"_29561":70576,"_20535":120407,"_5":14089,"_26896":120139,"_2860":120408},[],"Solicitar certificados a una CA externa.",{"_3374":70685,"_29561":70576,"_20535":120410,"_5":14089,"_26896":120139,"_2860":120411},[],"Renovar una identidad manteniendo la misma clave.",{"_3374":70686,"_29561":70576,"_20535":120413,"_5":14089,"_26896":120139,"_2860":120414},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3374":70687,"_29561":70576,"_20535":120416,"_5":14089,"_26896":120139,"_2860":120417},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3374":70688,"_29561":70576,"_20535":120419,"_5":14089,"_26896":120139,"_2860":120420},[],"**Organization (O)**: organización o empresa.",{"_3374":70689,"_29561":70576,"_20535":120422,"_5":14089,"_26896":120139,"_2860":120423},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3374":70690,"_29561":70576,"_20535":120425,"_5":14089,"_26896":120139,"_2860":120426},[],"**Country (C)**: código de país de dos letras.",{"_3374":70691,"_29561":70576,"_20535":120428,"_5":14089,"_26896":120139,"_2860":120429},[],"**State / Province (ST)**: estado o provincia.",{"_3374":70692,"_29561":70576,"_20535":120431,"_5":14089,"_26896":120139,"_2860":120432},[],"**Locality (L)**: ciudad o localidad.",{"_3374":70693,"_29561":70576,"_20535":120434,"_5":14089,"_26896":120139,"_2860":120435},[],"**Email Address**: correo de contacto.",{"_3374":70694,"_29561":70576,"_20535":120437,"_5":14089,"_26896":120139,"_2860":120438},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3374":70695,"_29561":70576,"_20535":120440,"_5":14089,"_26896":120139,"_2860":120441},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3374":70696,"_29561":70576,"_20535":120443,"_5":14089,"_26896":120143,"_2860":120444},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3374":70697,"_29561":70576,"_20535":120446,"_5":14089,"_26896":120143,"_2860":120447},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3374":70698,"_29561":70576,"_20535":120449,"_5":14089,"_26896":120147,"_2860":120450},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3374":70699,"_29561":70576,"_20535":120452,"_5":14089,"_26896":120147,"_2860":120453},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3374":70700,"_29561":70700,"_5":14447,"_2860":120455,"_29893":120456,"_20535":120457,"_26896":70700},"Validación online con OCSP",[48107,114800,53577,119306],[],{"_3374":70701,"_29561":70700,"_20535":120459,"_5":14089,"_26896":70700,"_2860":120460},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3374":70702,"_29561":70700,"_5":29890,"_20535":120462,"_26896":120463,"_2860":120464},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3374":70703,"_29561":70700,"_5":29890,"_20535":120466,"_26896":120467,"_2860":120468},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3374":70704,"_29561":70700,"_5":29890,"_20535":120470,"_26896":120471,"_2860":120472},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3374":70705,"_29561":70700,"_5":29890,"_20535":120474,"_26896":120475,"_2860":120476},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3374":70706,"_29561":70700,"_5":29890,"_20535":120478,"_26896":120479,"_2860":120480},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3374":70707,"_29561":70700,"_5":29890,"_20535":120482,"_26896":120483,"_2860":119858},[],"/docs/es/platform/pki/ocsp#referencias",{"_3374":70708,"_29561":70700,"_20535":120485,"_5":14089,"_26896":70700,"_2860":120486},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3374":70709,"_29561":70700,"_20535":120488,"_5":14089,"_26896":120463,"_2860":120489},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3374":70710,"_29561":70700,"_20535":120491,"_5":14089,"_26896":120463,"_2860":120492},[],"Estado del registro",{"_3374":70711,"_29561":70700,"_20535":120494,"_5":14089,"_26896":120463,"_2860":120495},[],"Respuesta firmada",{"_3374":70712,"_29561":70700,"_20535":120497,"_5":14089,"_26896":120463,"_2860":52714},[],{"_3374":70713,"_29561":70700,"_20535":120499,"_5":14089,"_26896":120463,"_2860":55424},[],{"_3374":70714,"_29561":70700,"_20535":120501,"_5":14089,"_26896":120463,"_2860":52731},[],{"_3374":70715,"_29561":70700,"_20535":120503,"_5":14089,"_26896":120463,"_2860":120504},[],"`Revoked`, con razón y fecha de revocación.",{"_3374":70716,"_29561":70700,"_20535":120506,"_5":14089,"_26896":120463,"_2860":120507},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3374":70717,"_29561":70700,"_20535":120509,"_5":14089,"_26896":120463,"_2860":120510},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3374":70718,"_29561":70700,"_20535":120512,"_5":14089,"_26896":120463,"_2860":120513},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3374":70719,"_29561":70700,"_20535":120515,"_5":14089,"_26896":120463,"_2860":120516},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3374":70720,"_29561":70700,"_20535":120518,"_5":14089,"_26896":120463,"_2860":120519},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3374":70721,"_29561":70700,"_20535":120521,"_5":14089,"_26896":120467,"_2860":120522},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3374":70722,"_29561":70700,"_20535":120524,"_5":14089,"_26896":120467,"_2860":120525},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3374":70723,"_29561":70700,"_20535":120527,"_5":14089,"_26896":120471,"_2860":120528},[],"El servicio acepta:",{"_3374":70724,"_29561":70700,"_20535":120530,"_5":14089,"_26896":120471,"_2860":116527},[],{"_3374":70725,"_29561":70700,"_20535":120532,"_5":14089,"_26896":120471,"_2860":120533},[],"Ruta del servicio VA",{"_3374":70726,"_29561":70700,"_20535":120535,"_5":14089,"_26896":120471,"_2860":120536},[],"Formato",{"_3374":70727,"_29561":70700,"_20535":120538,"_5":14089,"_26896":120471,"_2860":55464},[],{"_3374":70728,"_29561":70700,"_20535":120540,"_5":14089,"_26896":120471,"_2860":55467},[],{"_3374":70729,"_29561":70700,"_20535":120542,"_5":14089,"_26896":120471,"_2860":120543},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3374":70730,"_29561":70700,"_20535":120545,"_5":14089,"_26896":120471,"_2860":54893},[],{"_3374":70731,"_29561":70700,"_20535":120547,"_5":14089,"_26896":120471,"_2860":55475},[],{"_3374":70732,"_29561":70700,"_20535":120549,"_5":14089,"_26896":120471,"_2860":120550},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3374":70733,"_29561":70700,"_20535":120552,"_5":14089,"_26896":120471,"_2860":120553},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3374":70734,"_29561":70700,"_20535":120555,"_5":14089,"_26896":120475,"_2860":120556},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3374":70735,"_29561":70700,"_20535":120558,"_5":14089,"_26896":120475,"_2860":120559},[],"Genera la solicitud:",{"_3374":70736,"_29561":70700,"_20535":120561,"_5":14089,"_26896":120475,"_2860":120562},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3374":70737,"_29561":70700,"_20535":120564,"_5":14089,"_26896":120475,"_2860":120565},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3374":70738,"_29561":70700,"_20535":120567,"_5":14089,"_26896":120475,"_2860":120568},[],"Verifica el DER recibido:",{"_3374":70739,"_29561":70700,"_20535":120570,"_5":14089,"_26896":120475,"_2860":120571},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3374":70740,"_29561":70700,"_20535":120573,"_5":14089,"_26896":120479,"_2860":120574},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3374":70741,"_29561":70700,"_20535":120576,"_5":14089,"_26896":120479,"_2860":120577},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3374":70742,"_29561":70700,"_20535":120579,"_5":14089,"_26896":120483,"_2860":55508},[],{"_3374":70743,"_29561":70700,"_20535":120581,"_5":14089,"_26896":120483,"_2860":55511},[],{"_3374":70744,"_29561":70700,"_20535":120583,"_5":14089,"_26896":120483,"_2860":120584},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3374":70745,"_29561":70700,"_20535":120586,"_5":14089,"_26896":120483,"_2860":120069},[],{"_3374":70746,"_29561":70746,"_5":14447,"_2860":53577,"_29893":120588,"_20535":120589,"_26896":70746},[48107,114800,53577],[],{"_3374":70747,"_29561":70746,"_20535":120591,"_5":14089,"_26896":70746,"_2860":120592},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3374":70748,"_29561":70746,"_5":29890,"_20535":120594,"_26896":120595,"_2860":118001},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3374":70749,"_29561":70746,"_5":29890,"_20535":120597,"_26896":120598,"_2860":120599},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3374":70750,"_29561":70746,"_5":29890,"_20535":120601,"_26896":120602,"_2860":118521},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3374":70751,"_29561":70746,"_5":29890,"_20535":120604,"_26896":120605,"_2860":118525},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3374":70752,"_29561":70746,"_5":29890,"_20535":120607,"_26896":120608,"_2860":118529},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3374":70753,"_29561":70746,"_5":29890,"_20535":120610,"_26896":120611,"_2860":118533},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3374":70754,"_29561":70746,"_5":29890,"_20535":120613,"_26896":120614,"_2860":118541},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3374":70755,"_29561":70746,"_5":29890,"_20535":120616,"_26896":120617,"_2860":120618},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3374":70756,"_29561":70746,"_5":29890,"_20535":120620,"_26896":120621,"_2860":119472},[],"/docs/es/platform/pki/overview#continúa",{"_3374":70757,"_29561":70746,"_20535":120623,"_5":14089,"_26896":70746,"_2860":120624},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3374":70758,"_29561":70746,"_20535":120626,"_5":14089,"_26896":120595,"_2860":120627},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3374":70759,"_29561":70746,"_20535":120629,"_5":14089,"_26896":120595,"_2860":120630},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3374":70760,"_29561":70746,"_20535":120632,"_5":14089,"_26896":120598,"_2860":120633},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3374":70761,"_29561":70746,"_20535":120635,"_5":14089,"_26896":120598,"_2860":120636},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3374":70762,"_29561":70746,"_20535":120638,"_5":14089,"_26896":120598,"_2860":120639},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3374":70763,"_29561":70746,"_20535":120641,"_5":14089,"_26896":120598,"_2860":120642},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3374":70764,"_29561":70746,"_20535":120644,"_5":14089,"_26896":120598,"_2860":120645},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3374":70765,"_29561":70746,"_20535":120647,"_5":14089,"_26896":120605,"_2860":120648},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3374":70766,"_29561":70746,"_20535":120650,"_5":14089,"_26896":120608,"_2860":120651},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3374":70767,"_29561":70746,"_20535":120653,"_5":14089,"_26896":120611,"_2860":120654},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3374":70768,"_29561":70746,"_20535":120656,"_5":14089,"_26896":120614,"_2860":120657},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3374":70769,"_29561":70746,"_20535":120659,"_5":14089,"_26896":120617,"_2860":120660},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3374":70770,"_29561":70746,"_20535":120662,"_5":14089,"_26896":120617,"_2860":120663},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3374":70771,"_29561":70746,"_20535":120665,"_5":14089,"_26896":120617,"_2860":120666},[],"su clave pública corresponda a la clave privada del cliente;",{"_3374":70772,"_29561":70746,"_20535":120668,"_5":14089,"_26896":120617,"_2860":120669},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3374":70773,"_29561":70746,"_20535":120671,"_5":14089,"_26896":120617,"_2860":120672},[],"sus fechas y usos permitan la operación;",{"_3374":70774,"_29561":70746,"_20535":120674,"_5":14089,"_26896":120617,"_2860":120675},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3374":70775,"_29561":70746,"_20535":120677,"_5":14089,"_26896":120617,"_2860":120678},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3374":70776,"_29561":70746,"_20535":120680,"_5":14089,"_26896":120621,"_2860":120681},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3374":70777,"_29561":70746,"_20535":120683,"_5":14089,"_26896":120621,"_2860":120684},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3374":70778,"_29561":70746,"_20535":120686,"_5":14089,"_26896":120621,"_2860":120687},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3374":70779,"_29561":70779,"_5":14447,"_2860":120689,"_29893":120690,"_20535":120691,"_26896":70779},"Crea tu primera CA",[48107,114800,53577,118125],[],{"_3374":70780,"_29561":70779,"_20535":120693,"_5":14089,"_26896":70779,"_2860":120694},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3374":70781,"_29561":70779,"_5":29890,"_20535":120696,"_26896":120697,"_2860":113378},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3374":70782,"_29561":70779,"_5":29890,"_20535":120699,"_26896":120700,"_2860":120701},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3374":70783,"_29561":70779,"_5":29890,"_20535":120703,"_26896":120704,"_2860":120705},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3374":70784,"_29561":70779,"_5":29890,"_20535":120707,"_26896":120708,"_2860":120709},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3374":70785,"_29561":70779,"_5":29890,"_20535":120711,"_26896":120712,"_2860":120713},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3374":70786,"_29561":70779,"_5":29890,"_20535":120715,"_26896":120716,"_2860":120717},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3374":70787,"_29561":70779,"_5":29890,"_20535":120719,"_26896":120720,"_2860":120721},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3374":70788,"_29561":70779,"_5":29890,"_20535":120723,"_26896":120724,"_2860":118372},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3374":70789,"_29561":70779,"_5":29890,"_20535":120726,"_26896":120727,"_2860":113402},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3374":70790,"_29561":70779,"_20535":120729,"_5":14089,"_26896":70779,"_2860":120730},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3374":70791,"_29561":70779,"_20535":120732,"_5":14089,"_26896":120697,"_2860":120733},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3374":70792,"_29561":70779,"_20535":120735,"_5":14089,"_26896":120697,"_2860":120736},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3374":70793,"_29561":70779,"_20535":120738,"_5":14089,"_26896":120697,"_2860":120739},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3374":70794,"_29561":70779,"_20535":120741,"_5":14089,"_26896":120697,"_2860":120742},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3374":70795,"_29561":70779,"_20535":120744,"_5":14089,"_26896":120700,"_2860":120745},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3374":70796,"_29561":70779,"_20535":120747,"_5":14089,"_26896":120700,"_2860":120748},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3374":70797,"_29561":70779,"_20535":120750,"_5":14089,"_26896":120704,"_2860":120751},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3374":70798,"_29561":70779,"_20535":120753,"_5":14089,"_26896":120704,"_2860":120754},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3374":70799,"_29561":70779,"_20535":120756,"_5":14089,"_26896":120708,"_2860":120757},[],"Selecciona **Root CA** y completa:",{"_3374":70800,"_29561":70779,"_20535":120759,"_5":14089,"_26896":120708,"_2860":55690},[],{"_3374":70801,"_29561":70779,"_20535":120761,"_5":14089,"_26896":120708,"_2860":120762},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3374":70802,"_29561":70779,"_20535":120764,"_5":14089,"_26896":120708,"_2860":120765},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3374":70803,"_29561":70779,"_20535":120767,"_5":14089,"_26896":120708,"_2860":120768},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3374":70804,"_29561":70779,"_20535":120770,"_5":14089,"_26896":120708,"_2860":120771},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3374":70805,"_29561":70779,"_20535":120773,"_5":14089,"_26896":120712,"_2860":120774},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3374":70806,"_29561":70779,"_20535":120776,"_5":14089,"_26896":120716,"_2860":120777},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3374":70807,"_29561":70779,"_20535":120779,"_5":14089,"_26896":120716,"_2860":120780},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3374":70808,"_29561":70779,"_20535":120782,"_5":14089,"_26896":120720,"_2860":120783},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3374":70809,"_29561":70779,"_20535":120785,"_5":14089,"_26896":120720,"_2860":120786},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3374":70810,"_29561":70779,"_20535":120788,"_5":14089,"_26896":120720,"_2860":120789},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3374":70811,"_29561":70779,"_20535":120791,"_5":14089,"_26896":120724,"_2860":120792},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3374":70812,"_29561":70779,"_20535":120794,"_5":14089,"_26896":120724,"_2860":120795},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3374":70813,"_29561":70779,"_20535":120797,"_5":14089,"_26896":120724,"_2860":120798},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3374":70814,"_29561":70779,"_20535":120800,"_5":14089,"_26896":120724,"_2860":120801},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3374":70815,"_29561":70779,"_20535":120803,"_5":14089,"_26896":120727,"_2860":120804},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3374":70816,"_29561":70816,"_5":14447,"_2860":120806,"_29893":120807,"_20535":120808,"_26896":70816},"Emite y verifica un certificado",[48107,114800,53577,118125],[],{"_3374":70817,"_29561":70816,"_20535":120810,"_5":14089,"_26896":70816,"_2860":120811},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3374":70818,"_29561":70816,"_5":29890,"_20535":120813,"_26896":120814,"_2860":113378},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3374":70819,"_29561":70816,"_5":29890,"_20535":120816,"_26896":120817,"_2860":120818},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3374":70820,"_29561":70816,"_5":29890,"_20535":120820,"_26896":120821,"_2860":120822},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3374":70821,"_29561":70816,"_5":29890,"_20535":120824,"_26896":120825,"_2860":120826},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3374":70822,"_29561":70816,"_5":29890,"_20535":120828,"_26896":120829,"_2860":120830},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3374":70823,"_29561":70816,"_5":29890,"_20535":120832,"_26896":120833,"_2860":120834},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3374":70824,"_29561":70816,"_5":29890,"_20535":120836,"_26896":120837,"_2860":120838},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3374":70825,"_29561":70816,"_5":29890,"_20535":120840,"_26896":120841,"_2860":120842},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3374":70826,"_29561":70816,"_5":29890,"_20535":120844,"_26896":120845,"_2860":120846},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3374":70827,"_29561":70816,"_5":29890,"_20535":120848,"_26896":120849,"_2860":120850},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3374":70828,"_29561":70816,"_5":29890,"_20535":120852,"_26896":120853,"_2860":118372},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3374":70829,"_29561":70816,"_5":29890,"_20535":120855,"_26896":120856,"_2860":113402},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3374":70830,"_29561":70816,"_20535":120858,"_5":14089,"_26896":70816,"_2860":120859},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3374":70831,"_29561":70816,"_20535":120861,"_5":14089,"_26896":120814,"_2860":120862},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3374":70832,"_29561":70816,"_20535":120864,"_5":14089,"_26896":120814,"_2860":120865},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3374":70833,"_29561":70816,"_20535":120867,"_5":14089,"_26896":120814,"_2860":120868},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3374":70834,"_29561":70816,"_20535":120870,"_5":14089,"_26896":120814,"_2860":120871},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3374":70835,"_29561":70816,"_20535":120873,"_5":14089,"_26896":120814,"_2860":120874},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3374":70836,"_29561":70816,"_20535":120876,"_5":14089,"_26896":120817,"_2860":120877},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3374":70837,"_29561":70816,"_20535":120879,"_5":14089,"_26896":120821,"_2860":120880},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3374":70838,"_29561":70816,"_20535":120882,"_5":14089,"_26896":120821,"_2860":120883},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3374":70839,"_29561":70816,"_20535":120885,"_5":14089,"_26896":120825,"_2860":120886},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3374":70840,"_29561":70816,"_20535":120888,"_5":14089,"_26896":120825,"_2860":120889},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3374":70841,"_29561":70816,"_20535":120891,"_5":14089,"_26896":120829,"_2860":120892},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3374":70842,"_29561":70816,"_20535":120894,"_5":14089,"_26896":120829,"_2860":120895},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3374":70843,"_29561":70816,"_20535":120897,"_5":14089,"_26896":120833,"_2860":120898},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3374":70844,"_29561":70816,"_20535":120900,"_5":14089,"_26896":120837,"_2860":120901},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3374":70845,"_29561":70816,"_20535":120903,"_5":14089,"_26896":120841,"_2860":120904},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3374":70846,"_29561":70816,"_20535":120906,"_5":14089,"_26896":120845,"_2860":120907},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3374":70847,"_29561":70816,"_20535":120909,"_5":14089,"_26896":120845,"_2860":120910},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3374":70848,"_29561":70816,"_20535":120912,"_5":14089,"_26896":120845,"_2860":120913},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3374":70849,"_29561":70816,"_20535":120915,"_5":14089,"_26896":120849,"_2860":120916},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3374":70850,"_29561":70816,"_20535":120918,"_5":14089,"_26896":120849,"_2860":120919},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3374":70851,"_29561":70816,"_20535":120921,"_5":14089,"_26896":120849,"_2860":120922},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3374":70852,"_29561":70816,"_20535":120924,"_5":14089,"_26896":120853,"_2860":118455},[],{"_3374":70853,"_29561":70816,"_20535":120926,"_5":14089,"_26896":120853,"_2860":116976},[],{"_3374":70854,"_29561":70816,"_20535":120928,"_5":14089,"_26896":120853,"_2860":120929},[],"La CA rechaza la emisión",{"_3374":70855,"_29561":70816,"_20535":120931,"_5":14089,"_26896":120853,"_2860":120932},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3374":70856,"_29561":70816,"_20535":120934,"_5":14089,"_26896":120853,"_2860":120935},[],"Sujeto o usos diferentes",{"_3374":70857,"_29561":70816,"_20535":120937,"_5":14089,"_26896":120853,"_2860":120938},[],"Perfil aplicado y valores solicitados.",{"_3374":70858,"_29561":70816,"_20535":120940,"_5":14089,"_26896":120853,"_2860":120941},[],"No se encuentra el emisor",{"_3374":70859,"_29561":70816,"_20535":120943,"_5":14089,"_26896":120853,"_2860":120944},[],"CA descargada y cadena intermedia necesaria.",{"_3374":70860,"_29561":70816,"_20535":120946,"_5":14089,"_26896":120853,"_2860":120947},[],"Falla la vigencia",{"_3374":70861,"_29561":70816,"_20535":120949,"_5":14089,"_26896":120853,"_2860":120950},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3374":70862,"_29561":70816,"_20535":120952,"_5":14089,"_26896":120853,"_2860":120953},[],"Los resúmenes de clave difieren",{"_3374":70863,"_29561":70816,"_20535":120955,"_5":14089,"_26896":120853,"_2860":120956},[],"Archivos de certificado y clave de la misma emisión.",{"_3374":70864,"_29561":70816,"_20535":120958,"_5":14089,"_26896":120853,"_2860":120959},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3374":70865,"_29561":70816,"_20535":120961,"_5":14089,"_26896":120856,"_2860":120962},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3374":70866,"_29561":70816,"_20535":120964,"_5":14089,"_26896":120856,"_2860":120965},[],"Gestionar certificados para inspección, estado y revocación.",{"_3374":70867,"_29561":70816,"_20535":120967,"_5":14089,"_26896":120856,"_2860":120968},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3374":70868,"_29561":70816,"_20535":120970,"_5":14089,"_26896":120856,"_2860":120971},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3374":70869,"_29561":70816,"_20535":120973,"_5":14089,"_26896":120856,"_2860":120974},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3374":70870,"_29561":70870,"_5":14447,"_2860":120976,"_29893":120977,"_20535":120978,"_26896":70870},"Primeros pasos de PKI",[48107,114800,53577,118125],[],{"_3374":70871,"_29561":70870,"_20535":120980,"_5":14089,"_26896":70870,"_2860":120981},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3374":70872,"_29561":70870,"_5":29890,"_20535":120983,"_26896":120984,"_2860":113378},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3374":70873,"_29561":70870,"_5":29890,"_20535":120986,"_26896":120987,"_2860":120988},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3374":70874,"_29561":70870,"_5":29890,"_20535":120990,"_26896":120991,"_2860":118307},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3374":70875,"_29561":70870,"_5":29890,"_20535":120993,"_26896":120994,"_2860":120995},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3374":70876,"_29561":70870,"_20535":120997,"_5":14089,"_26896":70870,"_2860":120998},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3374":70877,"_29561":70870,"_20535":121000,"_5":14089,"_26896":120984,"_2860":121001},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3374":70878,"_29561":70870,"_20535":121003,"_5":14089,"_26896":120984,"_2860":121004},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3374":70879,"_29561":70870,"_20535":121006,"_5":14089,"_26896":120984,"_2860":121007},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3374":70880,"_29561":70870,"_20535":121009,"_5":14089,"_26896":120984,"_2860":121010},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3374":70881,"_29561":70870,"_20535":121012,"_5":14089,"_26896":120984,"_2860":121013},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3374":70882,"_29561":70870,"_20535":121015,"_5":14089,"_26896":120987,"_2860":121016},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3374":70883,"_29561":70870,"_20535":121018,"_5":14089,"_26896":120987,"_2860":121019},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3374":70884,"_29561":70870,"_20535":121021,"_5":14089,"_26896":120987,"_2860":121022},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3374":70885,"_29561":70870,"_20535":121024,"_5":14089,"_26896":120987,"_2860":121025},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3374":70886,"_29561":70870,"_20535":121027,"_5":14089,"_26896":120991,"_2860":121028},[],"Archivo o recurso",{"_3374":70887,"_29561":70870,"_20535":121030,"_5":14089,"_26896":120991,"_2860":118304},[],{"_3374":70888,"_29561":70870,"_20535":121032,"_5":14089,"_26896":120991,"_2860":121033},[],"CA raíz activa y `ca.pem`",{"_3374":70889,"_29561":70870,"_20535":121035,"_5":14089,"_26896":120991,"_2860":121036},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3374":70890,"_29561":70870,"_20535":121038,"_5":14089,"_26896":120991,"_2860":121039},[],"Certificado final y `device.crt`",{"_3374":70891,"_29561":70870,"_20535":121041,"_5":14089,"_26896":120991,"_2860":121042},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3374":70892,"_29561":70870,"_20535":121044,"_5":14089,"_26896":120991,"_2860":121045},[],"Clave privada `device.key`",{"_3374":70893,"_29561":70870,"_20535":121047,"_5":14089,"_26896":120991,"_2860":121048},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3374":70894,"_29561":70870,"_20535":121050,"_5":14089,"_26896":120991,"_2860":121051},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3374":70895,"_29561":70870,"_20535":121053,"_5":14089,"_26896":120994,"_2860":121054},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3374":70896,"_29561":70870,"_20535":121056,"_5":14089,"_26896":120994,"_2860":121057},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3374":70897,"_29561":70870,"_20535":121059,"_5":14089,"_26896":120994,"_2860":121060},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3374":70898,"_29561":70898,"_5":14447,"_2860":121062,"_29893":121063,"_20535":121065,"_26896":70898},"Resolución de problemas PKI",[48107,114800,53577,121064],"Resolución de problemas",[],{"_3374":70899,"_29561":70898,"_20535":121067,"_5":14089,"_26896":70898,"_2860":121068},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3374":70900,"_29561":70898,"_5":29890,"_20535":121070,"_26896":121071,"_2860":121072},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3374":70901,"_29561":70898,"_5":29890,"_20535":121074,"_26896":121075,"_2860":121076},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3374":70902,"_29561":70898,"_5":29890,"_20535":121078,"_26896":121079,"_2860":121080},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3374":70903,"_29561":70898,"_20535":121082,"_5":14089,"_26896":70898,"_2860":121083},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3374":70904,"_29561":70898,"_20535":121085,"_5":14089,"_26896":70898,"_2860":121086},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3374":70905,"_29561":70898,"_20535":121088,"_5":14089,"_26896":121071,"_2860":118304},[],{"_3374":70906,"_29561":70898,"_20535":121090,"_5":14089,"_26896":121071,"_2860":116976},[],{"_3374":70907,"_29561":70898,"_20535":121092,"_5":14089,"_26896":121071,"_2860":113402},[],{"_3374":70908,"_29561":70898,"_20535":121094,"_5":14089,"_26896":121071,"_2860":52419},[],{"_3374":70909,"_29561":70898,"_20535":121096,"_5":14089,"_26896":121071,"_2860":121097},[],"Existe, está activa y sus fechas son utilizables.",{"_3374":70910,"_29561":70898,"_20535":121099,"_5":14089,"_26896":121071,"_2860":121100},[],"Autoridades.",{"_3374":70911,"_29561":70898,"_20535":121102,"_5":14089,"_26896":121071,"_2860":121103},[],"Clave",{"_3374":70912,"_29561":70898,"_20535":121105,"_5":14089,"_26896":121071,"_2860":121106},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3374":70913,"_29561":70898,"_20535":121108,"_5":14089,"_26896":121071,"_2860":121109},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3374":70914,"_29561":70898,"_20535":121111,"_5":14089,"_26896":121071,"_2860":56044},[],{"_3374":70915,"_29561":70898,"_20535":121113,"_5":14089,"_26896":121071,"_2860":121114},[],"PEM correcto y firma verificable.",{"_3374":70916,"_29561":70898,"_20535":121116,"_5":14089,"_26896":121071,"_2860":56050},[],{"_3374":70917,"_29561":70898,"_20535":121118,"_5":14089,"_26896":121071,"_2860":121119},[],"Perfil",{"_3374":70918,"_29561":70898,"_20535":121121,"_5":14089,"_26896":121071,"_2860":121122},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3374":70919,"_29561":70898,"_20535":121124,"_5":14089,"_26896":121071,"_2860":121125},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3374":70920,"_29561":70898,"_20535":121127,"_5":14089,"_26896":121071,"_2860":118455},[],{"_3374":70921,"_29561":70898,"_20535":121129,"_5":14089,"_26896":121071,"_2860":121130},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3374":70922,"_29561":70898,"_20535":121132,"_5":14089,"_26896":121071,"_2860":121133},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3374":70923,"_29561":70898,"_20535":121135,"_5":14089,"_26896":121071,"_2860":121136},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3374":70924,"_29561":70898,"_20535":121138,"_5":14089,"_26896":121071,"_2860":121139},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3374":70925,"_29561":70898,"_20535":121141,"_5":14089,"_26896":121075,"_2860":121142},[],"Revisa cada frontera por separado:",{"_3374":70926,"_29561":70898,"_20535":121144,"_5":14089,"_26896":121075,"_2860":121145},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3374":70927,"_29561":70898,"_20535":121147,"_5":14089,"_26896":121075,"_2860":121148},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3374":70928,"_29561":70898,"_20535":121150,"_5":14089,"_26896":121075,"_2860":121151},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3374":70929,"_29561":70898,"_20535":121153,"_5":14089,"_26896":121075,"_2860":121154},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3374":70930,"_29561":70898,"_20535":121156,"_5":14089,"_26896":121075,"_2860":121157},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3374":70931,"_29561":70898,"_20535":121159,"_5":14089,"_26896":121075,"_2860":121160},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3374":70932,"_29561":70898,"_20535":121162,"_5":14089,"_26896":121079,"_2860":121163},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3374":70933,"_29561":70898,"_20535":121165,"_5":14089,"_26896":121079,"_2860":121166},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3374":70934,"_29561":70934,"_5":14447,"_2860":121168,"_29893":121169,"_20535":121170,"_26896":70934},"Seguridad",[48107],[],{"_3374":70935,"_29561":70934,"_20535":121172,"_5":14089,"_26896":70934,"_2860":121173},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3374":70936,"_29561":70934,"_5":29890,"_20535":121175,"_26896":121176,"_2860":121177},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3374":70937,"_29561":70934,"_5":29890,"_20535":121179,"_26896":121180,"_2860":121181},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3374":70938,"_29561":70934,"_5":29890,"_20535":121183,"_26896":121184,"_2860":121185},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3374":70939,"_29561":70934,"_5":29890,"_20535":121187,"_26896":121188,"_2860":121189},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3374":70940,"_29561":70934,"_20535":121191,"_5":14089,"_26896":70934,"_2860":121192},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3374":70941,"_29561":70934,"_20535":121194,"_5":14089,"_26896":121176,"_2860":121195},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3374":70942,"_29561":70934,"_20535":121197,"_5":14089,"_26896":121176,"_2860":121198},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3374":70943,"_29561":70934,"_20535":121200,"_5":14089,"_26896":121176,"_2860":14709},[],{"_3374":70944,"_29561":70934,"_20535":121202,"_5":14089,"_26896":121176,"_2860":14655},[],{"_3374":70945,"_29561":70934,"_20535":121204,"_5":14089,"_26896":121176,"_2860":14702},[],{"_3374":70946,"_29561":70934,"_20535":121206,"_5":14089,"_26896":121176,"_2860":121207},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3374":70947,"_29561":70934,"_20535":121209,"_5":14089,"_26896":121176,"_2860":121210},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3374":70948,"_29561":70934,"_20535":121212,"_5":14089,"_26896":121180,"_2860":121213},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3374":70949,"_29561":70934,"_20535":121215,"_5":14089,"_26896":121180,"_2860":121216},[],"No incluyas en el reporte:",{"_3374":70950,"_29561":70934,"_20535":121218,"_5":14089,"_26896":121180,"_2860":121219},[],"Credenciales, tokens o claves privadas",{"_3374":70951,"_29561":70934,"_20535":121221,"_5":14089,"_26896":121180,"_2860":121222},[],"Datos de clientes o información identificable de clientes",{"_3374":70952,"_29561":70934,"_20535":121224,"_5":14089,"_26896":121180,"_2860":121225},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3374":70953,"_29561":70934,"_20535":121227,"_5":14089,"_26896":121184,"_2860":121228},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3374":70954,"_29561":70934,"_20535":121230,"_5":14089,"_26896":121184,"_2860":121231},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3374":70955,"_29561":70934,"_20535":121233,"_5":14089,"_26896":121188,"_2860":121234},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3374":70956,"_29561":70934,"_20535":121236,"_5":14089,"_26896":121188,"_2860":121237},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3374":70957,"_29561":70934,"_20535":121239,"_5":14089,"_26896":121188,"_2860":121240},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3374":70958,"_29561":70934,"_20535":121242,"_5":14089,"_26896":121188,"_2860":121243},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3374":70959,"_29561":70934,"_20535":121245,"_5":14089,"_26896":121188,"_2860":121246},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3374":70960,"_29561":70960,"_5":14447,"_2860":121248,"_29893":121249,"_20535":121251,"_26896":70960},"3.8.0 a 4.0.0",[48107,121250],"Actualizaciones",[],{"_3374":70961,"_29561":70960,"_20535":121253,"_5":14089,"_26896":70960,"_2860":121254},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3374":70962,"_29561":70960,"_5":29890,"_20535":121256,"_26896":121257,"_2860":121258},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3374":70963,"_29561":70960,"_5":29890,"_20535":121260,"_26896":121261,"_2860":121262},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3374":70964,"_29561":70960,"_5":29890,"_20535":121264,"_26896":121265,"_2860":121266},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3374":70965,"_29561":70960,"_5":29890,"_20535":121268,"_26896":121269,"_2860":121270},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3374":70966,"_29561":70960,"_5":29890,"_20535":121272,"_26896":121273,"_2860":121274},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3374":70967,"_29561":70960,"_5":29890,"_20535":121276,"_26896":121277,"_2860":121278},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3374":70968,"_29561":70960,"_5":29890,"_20535":121280,"_26896":121281,"_2860":56216},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3374":70969,"_29561":70960,"_5":29890,"_20535":121283,"_26896":121284,"_2860":121285},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3374":70970,"_29561":70960,"_5":29890,"_20535":121287,"_26896":121288,"_2860":121289},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3374":70971,"_29561":70960,"_5":29890,"_20535":121291,"_26896":121292,"_2860":121293},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3374":70972,"_29561":70960,"_5":29890,"_20535":121295,"_26896":121296,"_2860":121297},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3374":70973,"_29561":70960,"_5":29890,"_20535":121299,"_26896":121300,"_2860":121301},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3374":70974,"_29561":70960,"_5":29890,"_20535":121303,"_26896":121304,"_2860":121305},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3374":70975,"_29561":70960,"_5":29890,"_20535":121307,"_26896":121308,"_2860":121309},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3374":70976,"_29561":70960,"_5":29890,"_20535":121311,"_26896":121312,"_2860":121313},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3374":70977,"_29561":70960,"_5":29890,"_20535":121315,"_26896":121316,"_2860":121317},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3374":70978,"_29561":70960,"_5":29890,"_20535":121319,"_26896":121320,"_2860":121321},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3374":70979,"_29561":70960,"_5":29890,"_20535":121323,"_26896":121324,"_2860":121325},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3374":70980,"_29561":70960,"_5":29890,"_20535":121327,"_26896":121328,"_2860":121329},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3374":70981,"_29561":70960,"_5":29890,"_20535":121331,"_26896":121332,"_2860":121333},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3374":70982,"_29561":70960,"_5":29890,"_20535":121335,"_26896":121336,"_2860":121337},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3374":70983,"_29561":70960,"_5":29890,"_20535":121339,"_26896":121340,"_2860":121341},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3374":70984,"_29561":70960,"_5":29890,"_20535":121343,"_26896":121344,"_2860":121345},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3374":70985,"_29561":70960,"_5":29890,"_20535":121347,"_26896":121348,"_2860":121349},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3374":70986,"_29561":70960,"_5":29890,"_20535":121351,"_26896":121352,"_2860":121353},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3374":70987,"_29561":70960,"_5":29890,"_20535":121355,"_26896":121356,"_2860":121357},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3374":70988,"_29561":70960,"_5":29890,"_20535":121359,"_26896":121360,"_2860":121361},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3374":70989,"_29561":70960,"_5":29890,"_20535":121363,"_26896":121364,"_2860":121365},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3374":70990,"_29561":70960,"_5":29890,"_20535":121367,"_26896":121368,"_2860":121369},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3374":70991,"_29561":70960,"_5":29890,"_20535":121371,"_26896":121372,"_2860":121373},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3374":70992,"_29561":70960,"_5":29890,"_20535":121375,"_26896":121376,"_2860":121377},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3374":70993,"_29561":70960,"_5":29890,"_20535":121379,"_26896":121380,"_2860":121381},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3374":70994,"_29561":70960,"_5":29890,"_20535":121383,"_26896":121384,"_2860":121385},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3374":70995,"_29561":70960,"_5":29890,"_20535":121387,"_26896":121388,"_2860":121389},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3374":70996,"_29561":70960,"_5":29890,"_20535":121391,"_26896":121392,"_2860":121393},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3374":70997,"_29561":70960,"_5":29890,"_20535":121395,"_26896":121396,"_2860":117318},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3374":70998,"_29561":70960,"_5":29890,"_20535":121398,"_26896":121399,"_2860":121400},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3374":70999,"_29561":70960,"_5":29890,"_20535":121402,"_26896":121403,"_2860":121404},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3374":71000,"_29561":70960,"_20535":121406,"_5":14089,"_26896":70960,"_2860":121407},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3374":71001,"_29561":70960,"_20535":121409,"_5":14089,"_26896":70960,"_2860":121410},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3374":71002,"_29561":70960,"_20535":121412,"_5":14089,"_26896":70960,"_2860":121413},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3374":71003,"_29561":70960,"_20535":121415,"_5":14089,"_26896":70960,"_2860":121416},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3374":71004,"_29561":70960,"_20535":121418,"_5":14089,"_26896":70960,"_2860":121419},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3374":71005,"_29561":70960,"_20535":121421,"_5":14089,"_26896":70960,"_2860":121422},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3374":71006,"_29561":70960,"_20535":121424,"_5":14089,"_26896":70960,"_2860":121425},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3374":71007,"_29561":70960,"_20535":121427,"_5":14089,"_26896":121261,"_2860":121428},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3374":71008,"_29561":70960,"_20535":121430,"_5":14089,"_26896":121261,"_2860":121431},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3374":71009,"_29561":70960,"_20535":121433,"_5":14089,"_26896":121265,"_2860":121434},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3374":71010,"_29561":70960,"_20535":121436,"_5":14089,"_26896":121265,"_2860":121437},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3374":71011,"_29561":70960,"_20535":121439,"_5":14089,"_26896":121269,"_2860":121440},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3374":71012,"_29561":70960,"_20535":121442,"_5":14089,"_26896":121273,"_2860":121443},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3374":71013,"_29561":70960,"_20535":121445,"_5":14089,"_26896":121273,"_2860":121446},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3374":71014,"_29561":70960,"_20535":121448,"_5":14089,"_26896":121273,"_2860":121449},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3374":71015,"_29561":70960,"_20535":121451,"_5":14089,"_26896":121273,"_2860":121452},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3374":71016,"_29561":70960,"_20535":121454,"_5":14089,"_26896":121273,"_2860":121455},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3374":71017,"_29561":70960,"_20535":121457,"_5":14089,"_26896":121277,"_2860":121458},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3374":71018,"_29561":70960,"_20535":121460,"_5":14089,"_26896":121277,"_2860":121461},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3374":71019,"_29561":70960,"_20535":121463,"_5":14089,"_26896":121277,"_2860":121464},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3374":71020,"_29561":70960,"_20535":121466,"_5":14089,"_26896":121277,"_2860":121467},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3374":71021,"_29561":70960,"_20535":121469,"_5":14089,"_26896":121277,"_2860":121470},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3374":71022,"_29561":70960,"_20535":121472,"_5":14089,"_26896":121281,"_2860":121473},[],"Cambio",{"_3374":71023,"_29561":70960,"_20535":121475,"_5":14089,"_26896":121281,"_2860":121476},[],"A quién afecta",{"_3374":71024,"_29561":70960,"_20535":121478,"_5":14089,"_26896":121281,"_2860":121479},[],"Gravedad",{"_3374":71025,"_29561":70960,"_20535":121481,"_5":14089,"_26896":121281,"_2860":120008},[],{"_3374":71026,"_29561":70960,"_20535":121483,"_5":14089,"_26896":121281,"_2860":121289},[],{"_3374":71027,"_29561":70960,"_20535":121485,"_5":14089,"_26896":121281,"_2860":121486},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3374":71028,"_29561":70960,"_20535":121488,"_5":14089,"_26896":121281,"_2860":121489},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3374":71029,"_29561":70960,"_20535":121491,"_5":14089,"_26896":121281,"_2860":121492},[],"Copiar los datos a los volúmenes nuevos",{"_3374":71030,"_29561":70960,"_20535":121494,"_5":14089,"_26896":121281,"_2860":121293},[],{"_3374":71031,"_29561":70960,"_20535":121496,"_5":14089,"_26896":121281,"_2860":121497},[],"Todas las releases de Helm",{"_3374":71032,"_29561":70960,"_20535":121499,"_5":14089,"_26896":121281,"_2860":121500},[],"Alta: `helm upgrade` falla",{"_3374":71033,"_29561":70960,"_20535":121502,"_5":14089,"_26896":121281,"_2860":121503},[],"Eliminar o renombrar las claves heredadas",{"_3374":71034,"_29561":70960,"_20535":121505,"_5":14089,"_26896":121281,"_2860":121297},[],{"_3374":71035,"_29561":70960,"_20535":121507,"_5":14089,"_26896":121281,"_2860":121508},[],"Todos los despliegues",{"_3374":71036,"_29561":70960,"_20535":121510,"_5":14089,"_26896":121281,"_2860":121511},[],"Alta: sin principal de bootstrap no hay administrador",{"_3374":71037,"_29561":70960,"_20535":121513,"_5":14089,"_26896":121281,"_2860":121514},[],"Configurar `services.authz`",{"_3374":71038,"_29561":70960,"_20535":121516,"_5":14089,"_26896":121281,"_2860":121301},[],{"_3374":71039,"_29561":70960,"_20535":121518,"_5":14089,"_26896":121281,"_2860":121497},[],{"_3374":71040,"_29561":70960,"_20535":121520,"_5":14089,"_26896":121281,"_2860":121521},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3374":71041,"_29561":70960,"_20535":121523,"_5":14089,"_26896":121281,"_2860":121524},[],"Mover JWKS y roles a `services.authz`",{"_3374":71042,"_29561":70960,"_20535":121526,"_5":14089,"_26896":121281,"_2860":121321},[],{"_3374":71043,"_29561":70960,"_20535":121528,"_5":14089,"_26896":121281,"_2860":121529},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3374":71044,"_29561":70960,"_20535":121531,"_5":14089,"_26896":121281,"_2860":121532},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3374":71045,"_29561":70960,"_20535":121534,"_5":14089,"_26896":121281,"_2860":121535},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3374":71046,"_29561":70960,"_20535":121537,"_5":14089,"_26896":121281,"_2860":121325},[],{"_3374":71047,"_29561":70960,"_20535":121539,"_5":14089,"_26896":121281,"_2860":121540},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3374":71048,"_29561":70960,"_20535":121542,"_5":14089,"_26896":121281,"_2860":121543},[],"Alta: el backend ya no arranca con ellos",{"_3374":71049,"_29561":70960,"_20535":121545,"_5":14089,"_26896":121281,"_2860":121546},[],"Pasar a PostgreSQL antes de actualizar",{"_3374":71050,"_29561":70960,"_20535":121548,"_5":14089,"_26896":121281,"_2860":121549},[],"Webhooks con referencias a archivos",{"_3374":71051,"_29561":70960,"_20535":121551,"_5":14089,"_26896":121281,"_2860":121552},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3374":71052,"_29561":70960,"_20535":121554,"_5":14089,"_26896":121281,"_2860":121555},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3374":71053,"_29561":70960,"_20535":121557,"_5":14089,"_26896":121281,"_2860":121558},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3374":71054,"_29561":70960,"_20535":121560,"_5":14089,"_26896":121281,"_2860":121305},[],{"_3374":71055,"_29561":70960,"_20535":121562,"_5":14089,"_26896":121281,"_2860":121563},[],"Releases con identidades por servicio o material de claves montado",{"_3374":71056,"_29561":70960,"_20535":121565,"_5":14089,"_26896":121281,"_2860":121566},[],"Media: los servicios no pueden leer sus archivos",{"_3374":71057,"_29561":70960,"_20535":121568,"_5":14089,"_26896":121281,"_2860":121569},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3374":71058,"_29561":70960,"_20535":121571,"_5":14089,"_26896":121281,"_2860":121309},[],{"_3374":71059,"_29561":70960,"_20535":121573,"_5":14089,"_26896":121281,"_2860":121574},[],"Releases que definen `amqp.tls`",{"_3374":71060,"_29561":70960,"_20535":121576,"_5":14089,"_26896":121281,"_2860":121577},[],"Media: los clientes se conectan al puerto equivocado",{"_3374":71061,"_29561":70960,"_20535":121579,"_5":14089,"_26896":121281,"_2860":121580},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3374":71062,"_29561":70960,"_20535":121582,"_5":14089,"_26896":121281,"_2860":121329},[],{"_3374":71063,"_29561":70960,"_20535":121584,"_5":14089,"_26896":121281,"_2860":121585},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3374":71064,"_29561":70960,"_20535":121587,"_5":14089,"_26896":121281,"_2860":121588},[],"Media: las claves de CA quedan sin gestionar",{"_3374":71065,"_29561":70960,"_20535":121590,"_5":14089,"_26896":121281,"_2860":121591},[],"Ejecutar la migración de CA a KMS",{"_3374":71066,"_29561":70960,"_20535":121593,"_5":14089,"_26896":121281,"_2860":121594},[],"Verificación del certificado del receptor",{"_3374":71067,"_29561":70960,"_20535":121596,"_5":14089,"_26896":121281,"_2860":121597},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3374":71068,"_29561":70960,"_20535":121599,"_5":14089,"_26896":121281,"_2860":121600},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3374":71069,"_29561":70960,"_20535":121602,"_5":14089,"_26896":121281,"_2860":121603},[],"Poner `insecure_skip_verify` a `false`",{"_3374":71070,"_29561":70960,"_20535":121605,"_5":14089,"_26896":121281,"_2860":121345},[],{"_3374":71071,"_29561":70960,"_20535":121607,"_5":14089,"_26896":121281,"_2860":121608},[],"Scripts y consolas que editan DMS por API",{"_3374":71072,"_29561":70960,"_20535":121610,"_5":14089,"_26896":121281,"_2860":121611},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3374":71073,"_29561":70960,"_20535":121613,"_5":14089,"_26896":121281,"_2860":121614},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3374":71074,"_29561":70960,"_20535":121616,"_5":14089,"_26896":121281,"_2860":121365},[],{"_3374":71075,"_29561":70960,"_20535":121618,"_5":14089,"_26896":121281,"_2860":121619},[],"Clientes que crean o actualizan roles VA por API",{"_3374":71076,"_29561":70960,"_20535":121621,"_5":14089,"_26896":121281,"_2860":121622},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3374":71077,"_29561":70960,"_20535":121624,"_5":14089,"_26896":121281,"_2860":121625},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3374":71078,"_29561":70960,"_20535":121627,"_5":14089,"_26896":121281,"_2860":121361},[],{"_3374":71079,"_29561":70960,"_20535":121629,"_5":14089,"_26896":121281,"_2860":121630},[],"Consumidores que leen el campo `events` del dispositivo",{"_3374":71080,"_29561":70960,"_20535":121632,"_5":14089,"_26896":121281,"_2860":121633},[],"Media: el campo desaparece",{"_3374":71081,"_29561":70960,"_20535":121635,"_5":14089,"_26896":121281,"_2860":121636},[],"Usar los nuevos endpoints de eventos",{"_3374":71082,"_29561":70960,"_20535":121638,"_5":14089,"_26896":121281,"_2860":121313},[],{"_3374":71083,"_29561":70960,"_20535":121640,"_5":14089,"_26896":121281,"_2860":121641},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3374":71084,"_29561":70960,"_20535":121643,"_5":14089,"_26896":121281,"_2860":121644},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3374":71085,"_29561":70960,"_20535":121646,"_5":14089,"_26896":121281,"_2860":121647},[],"Actualizar el archivo de values",{"_3374":71086,"_29561":70960,"_20535":121649,"_5":14089,"_26896":121281,"_2860":121353},[],{"_3374":71087,"_29561":70960,"_20535":121651,"_5":14089,"_26896":121281,"_2860":121652},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3374":71088,"_29561":70960,"_20535":121654,"_5":14089,"_26896":121281,"_2860":121655},[],"Baja: prevalece el ID de la URL",{"_3374":71089,"_29561":70960,"_20535":121657,"_5":14089,"_26896":121281,"_2860":121658},[],"Enviar el ID en la URL",{"_3374":71090,"_29561":70960,"_20535":121660,"_5":14089,"_26896":121281,"_2860":121357},[],{"_3374":71091,"_29561":70960,"_20535":121662,"_5":14089,"_26896":121281,"_2860":121663},[],"Consumidores que comparan el `type` del certificado",{"_3374":71092,"_29561":70960,"_20535":121665,"_5":14089,"_26896":121281,"_2860":121666},[],"Baja: dos valores cambian de nombre",{"_3374":71093,"_29561":70960,"_20535":121668,"_5":14089,"_26896":121281,"_2860":121669},[],"Adaptar los consumidores",{"_3374":71094,"_29561":70960,"_20535":121671,"_5":14089,"_26896":121281,"_2860":121349},[],{"_3374":71095,"_29561":70960,"_20535":121673,"_5":14089,"_26896":121281,"_2860":121674},[],"Cualquier DMS",{"_3374":71096,"_29561":70960,"_20535":121676,"_5":14089,"_26896":121281,"_2860":121677},[],"Baja: solo informativo",{"_3374":71097,"_29561":70960,"_20535":121679,"_5":14089,"_26896":121281,"_2860":121680},[],"Revisar ambos bloques antes de editar",{"_3374":71098,"_29561":70960,"_20535":121682,"_5":14089,"_26896":121288,"_2860":121683},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3374":71099,"_29561":70960,"_20535":121685,"_5":14089,"_26896":121288,"_2860":121686},[],"El paso 4 de la guía de migración copia los datos.",{"_3374":71100,"_29561":70960,"_20535":121688,"_5":14089,"_26896":121292,"_2860":121689},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3374":71101,"_29561":70960,"_20535":121691,"_5":14089,"_26896":121296,"_2860":121692},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3374":71102,"_29561":70960,"_20535":121694,"_5":14089,"_26896":121300,"_2860":121695},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3374":71103,"_29561":70960,"_20535":121697,"_5":14089,"_26896":121304,"_2860":121698},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3374":71104,"_29561":70960,"_20535":121700,"_5":14089,"_26896":121304,"_2860":121701},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3374":71105,"_29561":70960,"_20535":121703,"_5":14089,"_26896":121308,"_2860":121704},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3374":71106,"_29561":70960,"_20535":121706,"_5":14089,"_26896":121312,"_2860":121707},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3374":71107,"_29561":70960,"_20535":121709,"_5":14089,"_26896":121312,"_2860":121710},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3374":71108,"_29561":70960,"_20535":121712,"_5":14089,"_26896":121312,"_2860":121713},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3374":71109,"_29561":70960,"_20535":121715,"_5":14089,"_26896":121312,"_2860":121716},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3374":71110,"_29561":70960,"_20535":121718,"_5":14089,"_26896":121312,"_2860":121719},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3374":71111,"_29561":70960,"_20535":121721,"_5":14089,"_26896":121312,"_2860":121722},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3374":71112,"_29561":70960,"_20535":121724,"_5":14089,"_26896":121320,"_2860":121725},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3374":71113,"_29561":70960,"_20535":121727,"_5":14089,"_26896":121320,"_2860":121728},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3374":71114,"_29561":70960,"_20535":121730,"_5":14089,"_26896":121320,"_2860":121731},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3374":71115,"_29561":70960,"_20535":121733,"_5":14089,"_26896":121320,"_2860":121734},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3374":71116,"_29561":70960,"_20535":121736,"_5":14089,"_26896":121320,"_2860":121737},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3374":71117,"_29561":70960,"_20535":121739,"_5":14089,"_26896":121324,"_2860":121740},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3374":71118,"_29561":70960,"_20535":121742,"_5":14089,"_26896":121328,"_2860":121743},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3374":71119,"_29561":70960,"_20535":121745,"_5":14089,"_26896":121328,"_2860":121746},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3374":71120,"_29561":70960,"_20535":121748,"_5":14089,"_26896":121328,"_2860":121749},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3374":71121,"_29561":70960,"_20535":121751,"_5":14089,"_26896":121328,"_2860":121752},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3374":71122,"_29561":70960,"_20535":121754,"_5":14089,"_26896":121328,"_2860":121755},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3374":71123,"_29561":70960,"_20535":121757,"_5":14089,"_26896":121328,"_2860":121758},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3374":71124,"_29561":70960,"_20535":121760,"_5":14089,"_26896":121328,"_2860":121761},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3374":71125,"_29561":70960,"_20535":121763,"_5":14089,"_26896":121332,"_2860":121764},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3374":71126,"_29561":70960,"_20535":121766,"_5":14089,"_26896":121340,"_2860":121767},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3374":71127,"_29561":70960,"_20535":121769,"_5":14089,"_26896":121340,"_2860":121770},[],"Campo en 3.8.0",{"_3374":71128,"_29561":70960,"_20535":121772,"_5":14089,"_26896":121340,"_2860":121773},[],"Campo en 4.0.0",{"_3374":71129,"_29561":70960,"_20535":121775,"_5":14089,"_26896":121340,"_2860":56711},[],{"_3374":71130,"_29561":70960,"_20535":121777,"_5":14089,"_26896":121340,"_2860":121778},[],"`insecure_skip_verify` (con el valor negado)",{"_3374":71131,"_29561":70960,"_20535":121780,"_5":14089,"_26896":121340,"_2860":56717},[],{"_3374":71132,"_29561":70960,"_20535":121782,"_5":14089,"_26896":121340,"_2860":56720},[],{"_3374":71133,"_29561":70960,"_20535":121784,"_5":14089,"_26896":121340,"_2860":56723},[],{"_3374":71134,"_29561":70960,"_20535":121786,"_5":14089,"_26896":121340,"_2860":56726},[],{"_3374":71135,"_29561":70960,"_20535":121788,"_5":14089,"_26896":121340,"_2860":56729},[],{"_3374":71136,"_29561":70960,"_20535":121790,"_5":14089,"_26896":121340,"_2860":56732},[],{"_3374":71137,"_29561":70960,"_20535":121792,"_5":14089,"_26896":121340,"_2860":121793},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3374":71138,"_29561":70960,"_20535":121795,"_5":14089,"_26896":121340,"_2860":121796},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3374":71139,"_29561":70960,"_20535":121798,"_5":14089,"_26896":121340,"_2860":121799},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3374":71140,"_29561":70960,"_20535":121801,"_5":14089,"_26896":121344,"_2860":121802},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3374":71141,"_29561":70960,"_20535":121804,"_5":14089,"_26896":121344,"_2860":121805},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3374":71142,"_29561":70960,"_20535":121807,"_5":14089,"_26896":121344,"_2860":121808},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3374":71143,"_29561":70960,"_20535":121810,"_5":14089,"_26896":121348,"_2860":121811},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3374":71144,"_29561":70960,"_20535":121813,"_5":14089,"_26896":121352,"_2860":121814},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3374":71145,"_29561":70960,"_20535":121816,"_5":14089,"_26896":121356,"_2860":121817},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3374":71146,"_29561":70960,"_20535":121819,"_5":14089,"_26896":121360,"_2860":121820},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3374":71147,"_29561":70960,"_20535":121822,"_5":14089,"_26896":121360,"_2860":121823},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3374":71148,"_29561":70960,"_20535":121825,"_5":14089,"_26896":121360,"_2860":121826},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3374":71149,"_29561":70960,"_20535":121828,"_5":14089,"_26896":121360,"_2860":121829},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3374":71150,"_29561":70960,"_20535":121831,"_5":14089,"_26896":121364,"_2860":121832},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3374":71151,"_29561":70960,"_20535":121834,"_5":14089,"_26896":121368,"_2860":121835},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3374":71152,"_29561":70960,"_20535":121837,"_5":14089,"_26896":121372,"_2860":121838},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3374":71153,"_29561":70960,"_20535":121840,"_5":14089,"_26896":121372,"_2860":121841},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3374":71154,"_29561":70960,"_20535":121843,"_5":14089,"_26896":121372,"_2860":121844},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3374":71155,"_29561":70960,"_20535":121846,"_5":14089,"_26896":121372,"_2860":121847},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3374":71156,"_29561":70960,"_20535":121849,"_5":14089,"_26896":121372,"_2860":121850},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3374":71157,"_29561":70960,"_20535":121852,"_5":14089,"_26896":121376,"_2860":121853},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3374":71158,"_29561":70960,"_20535":121855,"_5":14089,"_26896":121376,"_2860":121856},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3374":71159,"_29561":70960,"_20535":121858,"_5":14089,"_26896":121376,"_2860":121859},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3374":71160,"_29561":70960,"_20535":121861,"_5":14089,"_26896":121376,"_2860":121862},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3374":71161,"_29561":70960,"_20535":121864,"_5":14089,"_26896":121376,"_2860":121865},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3374":71162,"_29561":70960,"_20535":121867,"_5":14089,"_26896":121376,"_2860":121868},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3374":71163,"_29561":70960,"_20535":121870,"_5":14089,"_26896":121376,"_2860":121871},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3374":71164,"_29561":70960,"_20535":121873,"_5":14089,"_26896":121376,"_2860":121874},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3374":71165,"_29561":70960,"_20535":121876,"_5":14089,"_26896":121376,"_2860":121877},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3374":71166,"_29561":70960,"_20535":121879,"_5":14089,"_26896":121376,"_2860":121880},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3374":71167,"_29561":70960,"_20535":121882,"_5":14089,"_26896":121376,"_2860":121883},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3374":71168,"_29561":70960,"_20535":121885,"_5":14089,"_26896":121376,"_2860":121886},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3374":71169,"_29561":70960,"_20535":121888,"_5":14089,"_26896":121380,"_2860":121889},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3374":71170,"_29561":70960,"_20535":121891,"_5":14089,"_26896":121380,"_2860":121892},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3374":71171,"_29561":70960,"_20535":121894,"_5":14089,"_26896":121384,"_2860":121895},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3374":71172,"_29561":70960,"_20535":121897,"_5":14089,"_26896":121384,"_2860":121898},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3374":71173,"_29561":70960,"_20535":121900,"_5":14089,"_26896":121384,"_2860":121901},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3374":71174,"_29561":70960,"_20535":121903,"_5":14089,"_26896":121384,"_2860":121904},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3374":71175,"_29561":70960,"_20535":121906,"_5":14089,"_26896":121384,"_2860":121907},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3374":71176,"_29561":70960,"_20535":121909,"_5":14089,"_26896":121384,"_2860":121910},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3374":71177,"_29561":70960,"_20535":121912,"_5":14089,"_26896":121384,"_2860":121913},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3374":71178,"_29561":70960,"_20535":121915,"_5":14089,"_26896":121384,"_2860":121916},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3374":71179,"_29561":70960,"_20535":121918,"_5":14089,"_26896":121384,"_2860":121919},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3374":71180,"_29561":70960,"_20535":121921,"_5":14089,"_26896":121384,"_2860":121922},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3374":71181,"_29561":70960,"_20535":121924,"_5":14089,"_26896":121384,"_2860":121925},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3374":71182,"_29561":70960,"_20535":121927,"_5":14089,"_26896":121388,"_2860":121928},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3374":71183,"_29561":70960,"_20535":121930,"_5":14089,"_26896":121388,"_2860":121931},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3374":71184,"_29561":70960,"_20535":121933,"_5":14089,"_26896":121392,"_2860":121934},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3374":71185,"_29561":70960,"_20535":121936,"_5":14089,"_26896":121392,"_2860":121937},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3374":71186,"_29561":70960,"_20535":121939,"_5":14089,"_26896":121392,"_2860":121940},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3374":71187,"_29561":70960,"_20535":121942,"_5":14089,"_26896":121392,"_2860":121943},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3374":71188,"_29561":70960,"_20535":121945,"_5":14089,"_26896":121392,"_2860":121946},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3374":71189,"_29561":70960,"_20535":121948,"_5":14089,"_26896":121392,"_2860":121949},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3374":71190,"_29561":70960,"_20535":121951,"_5":14089,"_26896":121392,"_2860":121952},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3374":71191,"_29561":70960,"_20535":121954,"_5":14089,"_26896":121396,"_2860":121955},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3374":71192,"_29561":70960,"_20535":121957,"_5":14089,"_26896":121396,"_2860":121958},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3374":71193,"_29561":70960,"_20535":121960,"_5":14089,"_26896":121396,"_2860":121961},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3374":71194,"_29561":70960,"_20535":121963,"_5":14089,"_26896":121396,"_2860":121964},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3374":71195,"_29561":70960,"_20535":121966,"_5":14089,"_26896":121396,"_2860":121967},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3374":71196,"_29561":70960,"_20535":121969,"_5":14089,"_26896":121396,"_2860":121970},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3374":71197,"_29561":70960,"_20535":121972,"_5":14089,"_26896":121396,"_2860":121973},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3374":71198,"_29561":70960,"_20535":121975,"_5":14089,"_26896":121396,"_2860":121976},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3374":71199,"_29561":70960,"_20535":121978,"_5":14089,"_26896":121396,"_2860":121979},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3374":71200,"_29561":70960,"_20535":121981,"_5":14089,"_26896":121396,"_2860":121982},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3374":71201,"_29561":70960,"_20535":121984,"_5":14089,"_26896":121396,"_2860":121985},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3374":71202,"_29561":70960,"_20535":121987,"_5":14089,"_26896":121399,"_2860":121988},[],"Tras la actualización, comprueba en este orden:",{"_3374":71203,"_29561":70960,"_20535":121990,"_5":14089,"_26896":121399,"_2860":121991},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3374":71204,"_29561":70960,"_20535":121993,"_5":14089,"_26896":121399,"_2860":121994},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3374":71205,"_29561":70960,"_20535":121996,"_5":14089,"_26896":121399,"_2860":121997},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3374":71206,"_29561":70960,"_20535":121999,"_5":14089,"_26896":121399,"_2860":122000},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3374":71207,"_29561":70960,"_20535":122002,"_5":14089,"_26896":121399,"_2860":122003},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3374":71208,"_29561":70960,"_20535":122005,"_5":14089,"_26896":121399,"_2860":122006},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3374":71209,"_29561":70960,"_20535":122008,"_5":14089,"_26896":121399,"_2860":122009},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3374":71210,"_29561":70960,"_20535":122011,"_5":14089,"_26896":121399,"_2860":122012},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3374":71211,"_29561":70960,"_20535":122014,"_5":14089,"_26896":121399,"_2860":122015},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3374":71212,"_29561":70960,"_20535":122017,"_5":14089,"_26896":121399,"_2860":122018},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3374":71213,"_29561":70960,"_20535":122020,"_5":14089,"_26896":121399,"_2860":122021},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3374":71214,"_29561":70960,"_20535":122023,"_5":14089,"_26896":121399,"_2860":122024},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3374":71215,"_29561":70960,"_20535":122026,"_5":14089,"_26896":121399,"_2860":122027},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3374":71216,"_29561":70960,"_20535":122029,"_5":14089,"_26896":121399,"_2860":122030},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3374":71217,"_29561":70960,"_20535":122032,"_5":14089,"_26896":121403,"_2860":122033},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3374":71218,"_29561":70960,"_20535":122035,"_5":14089,"_26896":121403,"_2860":122036},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3374":71219,"_29561":70960,"_20535":122038,"_5":14089,"_26896":121403,"_2860":122039},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3374":71220,"_29561":70960,"_20535":122041,"_5":14089,"_26896":121403,"_2860":122042},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3374":71221,"_29561":70960,"_20535":122044,"_5":14089,"_26896":121403,"_2860":122045},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_56990":122047,"_56992":122048,"_56994":122049,"_56996":122050,"_17787":2895,"_68375":2895},"spanish",[2860,29561,5,26896],{"_2860":24534,"_29561":24534,"_5":24534,"_26896":24534},{"_2860":122051,"_29561":124894,"_5":127737,"_26896":130580},{"_4534":122052,"_57000":122053,"_5":24534},{"_14171":12911,"_14547":4437,"_14566":5821,"_28570":3786,"_14553":3954,"_19495":3329,"_14192":7440,"_14199":4085,"_28512":7490,"_28921":7433,"_28942":4113,"_28546":4105,"_33836":21027,"_28649":19953,"_28986":9660,"_33843":29089,"_33846":3894,"_33849":6436,"_33852":24881,"_29393":3244,"_33857":14013,"_33859":9806,"_29423":25101,"_14562":10813,"_33863":7328,"_33866":5840,"_33868":6010,"_28970":16231,"_29388":19957,"_29436":7471,"_33873":12053,"_33875":3556,"_33877":6837,"_28666":6866,"_33880":3913,"_33882":4212,"_33884":6598,"_33886":2969,"_33888":3241,"_28583":5446,"_33891":5847,"_33893":5700,"_28577":5045,"_29007":10203,"_33897":3044,"_33899":13880,"_33902":8838,"_28623":7392,"_33906":6195,"_28503":20754,"_33909":6