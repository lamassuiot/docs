34,"_38026":117037,"_38028":117040,"_38031":117043,"_38033":117046,"_38035":117049,"_38038":117052,"_38040":117055,"_38042":117058,"_38044":117061,"_38046":117064,"_38048":117067,"_38050":117070,"_38052":117073,"_38054":117076,"_38056":117079,"_38058":117082,"_38060":117085,"_38062":117088,"_38064":117091,"_38066":117094,"_38068":117097,"_38070":117100,"_38072":117103,"_38074":117106,"_38076":117109,"_38078":117112,"_38080":117115,"_38082":117118,"_38084":117121,"_38086":117124,"_38088":117127,"_38090":117130,"_38092":117133,"_38094":117136,"_38096":117139,"_38098":117142,"_38100":117145,"_38102":117148,"_38104":117151,"_38106":117154,"_38108":117157,"_38110":117160,"_38112":117163,"_38115":117166,"_38117":117169,"_38119":117172},{"_3227":65605,"_28586":65605,"_5":13916,"_2720":108886,"_28908":108887,"_19790":108890,"_26008":65605},"Despliega desde AWS Marketplace",[46300,108888,108889],"Despliegue","Otros modelos",[],{"_3227":65606,"_28586":65605,"_19790":108892,"_5":13558,"_26008":65605,"_2720":108893},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3227":65607,"_28586":65605,"_5":28905,"_19790":108895,"_26008":108896,"_2720":108897},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3227":65608,"_28586":65605,"_5":28905,"_19790":108899,"_26008":108900,"_2720":108901},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3227":65609,"_28586":65605,"_5":28905,"_19790":108903,"_26008":108904,"_2720":108905},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3227":65610,"_28586":65605,"_5":28905,"_19790":108907,"_26008":108908,"_2720":108909},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3227":65611,"_28586":65605,"_5":28905,"_19790":108911,"_26008":108912,"_2720":108913},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3227":65612,"_28586":65605,"_5":28905,"_19790":108915,"_26008":108916,"_2720":108917},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3227":65613,"_28586":65605,"_5":28905,"_19790":108919,"_26008":108920,"_2720":108921},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3227":65614,"_28586":65605,"_19790":108923,"_5":13558,"_26008":65605,"_2720":108924},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3227":65615,"_28586":65605,"_19790":108926,"_5":13558,"_26008":108896,"_2720":108927},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3227":65616,"_28586":65605,"_19790":108929,"_5":13558,"_26008":108896,"_2720":108930},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3227":65617,"_28586":65605,"_19790":108932,"_5":13558,"_26008":108896,"_2720":108933},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3227":65618,"_28586":65605,"_19790":108935,"_5":13558,"_26008":108900,"_2720":108936},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3227":65619,"_28586":65605,"_19790":108938,"_5":13558,"_26008":108900,"_2720":108939},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3227":65620,"_28586":65605,"_19790":108941,"_5":13558,"_26008":108900,"_2720":108942},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3227":65621,"_28586":65605,"_19790":108944,"_5":13558,"_26008":108904,"_2720":108945},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3227":65622,"_28586":65605,"_19790":108947,"_5":13558,"_26008":108908,"_2720":108948},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3227":65623,"_28586":65605,"_19790":108950,"_5":13558,"_26008":108912,"_2720":108951},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3227":65624,"_28586":65605,"_19790":108953,"_5":13558,"_26008":108916,"_2720":108954},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3227":65625,"_28586":65605,"_19790":108956,"_5":13558,"_26008":108920,"_2720":108957},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3227":65626,"_28586":65626,"_5":13916,"_2720":108959,"_28908":108960,"_19790":108961,"_26008":65626},"Despliega Lamassu",[46300,108888],[],{"_3227":65627,"_28586":65626,"_19790":108963,"_5":13558,"_26008":65626,"_2720":108964},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3227":65628,"_28586":65626,"_5":28905,"_19790":108966,"_26008":108967,"_2720":108968},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3227":65629,"_28586":65626,"_5":28905,"_19790":108970,"_26008":108971,"_2720":108972},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3227":65630,"_28586":65626,"_5":28905,"_19790":108974,"_26008":108975,"_2720":108976},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3227":65631,"_28586":65626,"_19790":108978,"_5":13558,"_26008":65626,"_2720":108979},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3227":65632,"_28586":65626,"_19790":108981,"_5":13558,"_26008":108967,"_2720":108982},[],"Modelo",{"_3227":65633,"_28586":65626,"_19790":108984,"_5":13558,"_26008":108967,"_2720":108985},[],"Recomendado para",{"_3227":65634,"_28586":65626,"_19790":108987,"_5":13558,"_26008":108967,"_2720":108988},[],"Quién opera la infraestructura",{"_3227":65635,"_28586":65626,"_19790":108990,"_5":13558,"_26008":108967,"_2720":108991},[],"Punto de partida",{"_3227":65636,"_28586":65626,"_19790":108993,"_5":13558,"_26008":108967,"_2720":46407},[],{"_3227":65637,"_28586":65626,"_19790":108995,"_5":13558,"_26008":108967,"_2720":108996},[],"Producción, entornos regulados y despliegues personalizados",{"_3227":65638,"_28586":65626,"_19790":108998,"_5":13558,"_26008":108967,"_2720":108999},[],"Tu equipo",{"_3227":65639,"_28586":65626,"_19790":109001,"_5":13558,"_26008":108967,"_2720":109002},[],"Helm o Fastlane",{"_3227":65640,"_28586":65626,"_19790":109004,"_5":13558,"_26008":108967,"_2720":46419},[],{"_3227":65641,"_28586":65626,"_19790":109006,"_5":13558,"_26008":108967,"_2720":109007},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3227":65642,"_28586":65626,"_19790":109009,"_5":13558,"_26008":108967,"_2720":108999},[],{"_3227":65643,"_28586":65626,"_19790":109011,"_5":13558,"_26008":108967,"_2720":109012},[],"Imagen preconfigurada en EC2",{"_3227":65644,"_28586":65626,"_19790":109014,"_5":13558,"_26008":108967,"_2720":46430},[],{"_3227":65645,"_28586":65626,"_19790":109016,"_5":13558,"_26008":108967,"_2720":109017},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3227":65646,"_28586":65626,"_19790":109019,"_5":13558,"_26008":108967,"_2720":46436},[],{"_3227":65647,"_28586":65626,"_19790":109021,"_5":13558,"_26008":108967,"_2720":109022},[],"Suscripción gestionada",{"_3227":65648,"_28586":65626,"_19790":109024,"_5":13558,"_26008":108967,"_2720":109025},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3227":65649,"_28586":65626,"_19790":109027,"_5":13558,"_26008":108967,"_2720":109028},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3227":65650,"_28586":65626,"_19790":109030,"_5":13558,"_26008":108967,"_2720":109031},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3227":65651,"_28586":65626,"_19790":109033,"_5":13558,"_26008":108971,"_2720":109034},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3227":65652,"_28586":65626,"_19790":109036,"_5":13558,"_26008":108975,"_2720":109037},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3227":65653,"_28586":65653,"_5":13916,"_2720":109039,"_28908":109040,"_19790":109041,"_26008":65653},"Utiliza Lamassu como SaaS",[46300,108888,108889],[],{"_3227":65654,"_28586":65653,"_19790":109043,"_5":13558,"_26008":65653,"_2720":109044},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3227":65655,"_28586":65653,"_5":28905,"_19790":109046,"_26008":109047,"_2720":109048},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3227":65656,"_28586":65653,"_5":28905,"_19790":109050,"_26008":109051,"_2720":109052},[],"/docs/es/deployment/saas#planes","Planes",{"_3227":65657,"_28586":65653,"_5":28905,"_19790":109054,"_26008":109055,"_2720":109056},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3227":65658,"_28586":65653,"_19790":109058,"_5":13558,"_26008":65653,"_2720":109059},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3227":65659,"_28586":65653,"_19790":109061,"_5":13558,"_26008":109047,"_2720":109062},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3227":65660,"_28586":65653,"_19790":109064,"_5":13558,"_26008":109047,"_2720":109065},[],"Copias de seguridad automáticas.",{"_3227":65661,"_28586":65653,"_19790":109067,"_5":13558,"_26008":109047,"_2720":109068},[],"Actualizaciones de versión.",{"_3227":65662,"_28586":65653,"_19790":109070,"_5":13558,"_26008":109047,"_2720":109071},[],"Soporte técnico y SLA según el plan contratado.",{"_3227":65663,"_28586":65653,"_19790":109073,"_5":13558,"_26008":109051,"_2720":46491},[],{"_3227":65664,"_28586":65653,"_19790":109075,"_5":13558,"_26008":109051,"_2720":109076},[],"Dispositivos",{"_3227":65665,"_28586":65653,"_19790":109078,"_5":13558,"_26008":109051,"_2720":109079},[],"Soporte",{"_3227":65666,"_28586":65653,"_19790":109081,"_5":13558,"_26008":109051,"_2720":46500},[],{"_3227":65667,"_28586":65653,"_19790":109083,"_5":13558,"_26008":109051,"_2720":46503},[],{"_3227":65668,"_28586":65653,"_19790":109085,"_5":13558,"_26008":109051,"_2720":109086},[],"Hasta 1.000",{"_3227":65669,"_28586":65653,"_19790":109088,"_5":13558,"_26008":109051,"_2720":46509},[],{"_3227":65670,"_28586":65653,"_19790":109090,"_5":13558,"_26008":109051,"_2720":109091},[],"99,5 %",{"_3227":65671,"_28586":65653,"_19790":109093,"_5":13558,"_26008":109051,"_2720":46515},[],{"_3227":65672,"_28586":65653,"_19790":109095,"_5":13558,"_26008":109051,"_2720":109096},[],"Hasta 10.000",{"_3227":65673,"_28586":65653,"_19790":109098,"_5":13558,"_26008":109051,"_2720":109099},[],"Email y chat",{"_3227":65674,"_28586":65653,"_19790":109101,"_5":13558,"_26008":109051,"_2720":109102},[],"99,9 %",{"_3227":65675,"_28586":65653,"_19790":109104,"_5":13558,"_26008":109051,"_2720":46527},[],{"_3227":65676,"_28586":65653,"_19790":109106,"_5":13558,"_26008":109051,"_2720":109107},[],"Ilimitados",{"_3227":65677,"_28586":65653,"_19790":109109,"_5":13558,"_26008":109051,"_2720":109110},[],"Dedicado",{"_3227":65678,"_28586":65653,"_19790":109112,"_5":13558,"_26008":109051,"_2720":109113},[],"99,99 %",{"_3227":65679,"_28586":65653,"_19790":109115,"_5":13558,"_26008":109055,"_2720":109116},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3227":65680,"_28586":65653,"_19790":109118,"_5":13558,"_26008":109055,"_2720":109119},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3227":65681,"_28586":65681,"_5":13916,"_2720":46544,"_28908":109121,"_19790":109123,"_26008":65681},[46300,108888,109122],"Kubernetes autogestionado",[],{"_3227":65682,"_28586":65681,"_19790":109125,"_5":13558,"_26008":65681,"_2720":109126},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3227":65683,"_28586":65681,"_5":28905,"_19790":109128,"_26008":109129,"_2720":109130},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3227":65684,"_28586":65681,"_5":28905,"_19790":109132,"_26008":109133,"_2720":109134},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3227":65685,"_28586":65681,"_5":28905,"_19790":109136,"_26008":109137,"_2720":109138},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3227":65686,"_28586":65681,"_5":28905,"_19790":109140,"_26008":109141,"_2720":109142},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3227":65687,"_28586":65681,"_5":28905,"_19790":109144,"_26008":109145,"_2720":109146},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3227":65688,"_28586":65681,"_5":28905,"_19790":109148,"_26008":109149,"_2720":109150},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3227":65689,"_28586":65681,"_5":28905,"_19790":109152,"_26008":109153,"_2720":109154},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3227":65690,"_28586":65681,"_5":28905,"_19790":109156,"_26008":109157,"_2720":109158},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3227":65691,"_28586":65681,"_5":28905,"_19790":109160,"_26008":109161,"_2720":109162},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3227":65692,"_28586":65681,"_5":28905,"_19790":109164,"_26008":109165,"_2720":109166},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3227":65693,"_28586":65681,"_5":28905,"_19790":109168,"_26008":109169,"_2720":109170},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3227":65694,"_28586":65681,"_19790":109172,"_5":13558,"_26008":109129,"_2720":109173},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3227":65695,"_28586":65681,"_19790":109175,"_5":13558,"_26008":109129,"_2720":109176},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3227":65696,"_28586":65681,"_19790":109178,"_5":13558,"_26008":109133,"_2720":109179},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3227":65697,"_28586":65681,"_19790":109181,"_5":13558,"_26008":109133,"_2720":109182},[],"Fastlane instala o configura",{"_3227":65698,"_28586":65681,"_19790":109184,"_5":13558,"_26008":109133,"_2720":109185},[],"Tú sigues proporcionando",{"_3227":65699,"_28586":65681,"_19790":109187,"_5":13558,"_26008":109133,"_2720":109188},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3227":65700,"_28586":65681,"_19790":109190,"_5":13558,"_26008":109133,"_2720":109191},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3227":65701,"_28586":65681,"_19790":109193,"_5":13558,"_26008":109133,"_2720":109194},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3227":65702,"_28586":65681,"_19790":109196,"_5":13558,"_26008":109133,"_2720":109197},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3227":65703,"_28586":65681,"_19790":109199,"_5":13558,"_26008":109133,"_2720":109200},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3227":65704,"_28586":65681,"_19790":109202,"_5":13558,"_26008":109133,"_2720":109203},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3227":65705,"_28586":65681,"_19790":109205,"_5":13558,"_26008":109133,"_2720":109206},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3227":65706,"_28586":65681,"_19790":109208,"_5":13558,"_26008":109133,"_2720":109209},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3227":65707,"_28586":65681,"_19790":109211,"_5":13558,"_26008":109133,"_2720":109212},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3227":65708,"_28586":65681,"_19790":109214,"_5":13558,"_26008":109137,"_2720":109215},[],"Necesitas:",{"_3227":65709,"_28586":65681,"_19790":109217,"_5":13558,"_26008":109137,"_2720":109218},[],"un clúster Kubernetes existente",{"_3227":65710,"_28586":65681,"_19790":109220,"_5":13558,"_26008":109137,"_2720":109221},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3227":65711,"_28586":65681,"_19790":109223,"_5":13558,"_26008":109137,"_2720":46646},[],{"_3227":65712,"_28586":65681,"_19790":109225,"_5":13558,"_26008":109137,"_2720":22417},[],{"_3227":65713,"_28586":65681,"_19790":109227,"_5":13558,"_26008":109137,"_2720":109228},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3227":65714,"_28586":65681,"_19790":109230,"_5":13558,"_26008":109137,"_2720":109231},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3227":65715,"_28586":65681,"_19790":109233,"_5":13558,"_26008":109137,"_2720":109234},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3227":65716,"_28586":65681,"_19790":109236,"_5":13558,"_26008":109137,"_2720":109237},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3227":65717,"_28586":65681,"_19790":109239,"_5":13558,"_26008":109137,"_2720":109240},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3227":65718,"_28586":65681,"_19790":109242,"_5":13558,"_26008":109141,"_2720":109243},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3227":65719,"_28586":65681,"_19790":109245,"_5":13558,"_26008":109141,"_2720":109246},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3227":65720,"_28586":65681,"_19790":109248,"_5":13558,"_26008":109145,"_2720":109249},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3227":65721,"_28586":65681,"_19790":109251,"_5":13558,"_26008":109145,"_2720":109252},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3227":65722,"_28586":65681,"_19790":109254,"_5":13558,"_26008":109145,"_2720":109255},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3227":65723,"_28586":65681,"_19790":109257,"_5":13558,"_26008":109145,"_2720":109258},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3227":65724,"_28586":65681,"_19790":109260,"_5":13558,"_26008":109149,"_2720":109261},[],"Opción",{"_3227":65725,"_28586":65681,"_19790":109263,"_5":13558,"_26008":109149,"_2720":109264},[],"Valor predeterminado",{"_3227":65726,"_28586":65681,"_19790":109266,"_5":13558,"_26008":109149,"_2720":109267},[],"Propósito",{"_3227":65727,"_28586":65681,"_19790":109269,"_5":13558,"_26008":109149,"_2720":46693},[],{"_3227":65728,"_28586":65681,"_19790":109271,"_5":13558,"_26008":109149,"_2720":46696},[],{"_3227":65729,"_28586":65681,"_19790":109273,"_5":13558,"_26008":109149,"_2720":109274},[],"Muestra la ayuda",{"_3227":65730,"_28586":65681,"_19790":109276,"_5":13558,"_26008":109149,"_2720":46702},[],{"_3227":65731,"_28586":65681,"_19790":109278,"_5":13558,"_26008":109149,"_2720":109279},[],"contexto actual",{"_3227":65732,"_28586":65681,"_19790":109281,"_5":13558,"_26008":109149,"_2720":109282},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3227":65733,"_28586":65681,"_19790":109284,"_5":13558,"_26008":109149,"_2720":46711},[],{"_3227":65734,"_28586":65681,"_19790":109286,"_5":13558,"_26008":109149,"_2720":6085},[],{"_3227":65735,"_28586":65681,"_19790":109288,"_5":13558,"_26008":109149,"_2720":109289},[],"Omite prompts y genera credenciales para las dependencias",{"_3227":65736,"_28586":65681,"_19790":109291,"_5":13558,"_26008":109149,"_2720":46719},[],{"_3227":65737,"_28586":65681,"_19790":109293,"_5":13558,"_26008":109149,"_2720":46722},[],{"_3227":65738,"_28586":65681,"_19790":109295,"_5":13558,"_26008":109149,"_2720":109296},[],"Namespace de la instalación",{"_3227":65739,"_28586":65681,"_19790":109298,"_5":13558,"_26008":109149,"_2720":46728},[],{"_3227":65740,"_28586":65681,"_19790":109300,"_5":13558,"_26008":109149,"_2720":46731},[],{"_3227":65741,"_28586":65681,"_19790":109302,"_5":13558,"_26008":109149,"_2720":109303},[],"Dominio usado por la UI, OIDC y el certificado",{"_3227":65742,"_28586":65681,"_19790":109305,"_5":13558,"_26008":109149,"_2720":46737},[],{"_3227":65743,"_28586":65681,"_19790":109307,"_5":13558,"_26008":109149,"_2720":14216},[],{"_3227":65744,"_28586":65681,"_19790":109309,"_5":13558,"_26008":109149,"_2720":109310},[],"Versión del chart de Lamassu",{"_3227":65745,"_28586":65681,"_19790":109312,"_5":13558,"_26008":109149,"_2720":46745},[],{"_3227":65746,"_28586":65681,"_19790":109314,"_5":13558,"_26008":109149,"_2720":46748},[],{"_3227":65747,"_28586":65681,"_19790":109316,"_5":13558,"_26008":109149,"_2720":109317},[],"Puerto del listener HTTPS",{"_3227":65748,"_28586":65681,"_19790":109319,"_5":13558,"_26008":109149,"_2720":46754},[],{"_3227":65749,"_28586":65681,"_19790":109321,"_5":13558,"_26008":109149,"_2720":46757},[],{"_3227":65750,"_28586":65681,"_19790":109323,"_5":13558,"_26008":109149,"_2720":109324},[],"Puerto del listener HTTP",{"_3227":65751,"_28586":65681,"_19790":109326,"_5":13558,"_26008":109149,"_2720":46763},[],{"_3227":65752,"_28586":65681,"_19790":109328,"_5":13558,"_26008":109149,"_2720":46696},[],{"_3227":65753,"_28586":65681,"_19790":109330,"_5":13558,"_26008":109149,"_2720":109331},[],"Certificado PEM para TLS downstream",{"_3227":65754,"_28586":65681,"_19790":109333,"_5":13558,"_26008":109149,"_2720":46771},[],{"_3227":65755,"_28586":65681,"_19790":109335,"_5":13558,"_26008":109149,"_2720":46696},[],{"_3227":65756,"_28586":65681,"_19790":109337,"_5":13558,"_26008":109149,"_2720":109338},[],"Clave privada PEM para TLS downstream",{"_3227":65757,"_28586":65681,"_19790":109340,"_5":13558,"_26008":109149,"_2720":46779},[],{"_3227":65758,"_28586":65681,"_19790":109342,"_5":13558,"_26008":109149,"_2720":109343},[],"chart del repositorio",{"_3227":65759,"_28586":65681,"_19790":109345,"_5":13558,"_26008":109149,"_2720":109346},[],"Usa un chart local de Lamassu sin empaquetar",{"_3227":65760,"_28586":65681,"_19790":109348,"_5":13558,"_26008":109149,"_2720":46788},[],{"_3227":65761,"_28586":65681,"_19790":109350,"_5":13558,"_26008":109149,"_2720":109351},[],"detección automática",{"_3227":65762,"_28586":65681,"_19790":109353,"_5":13558,"_26008":109149,"_2720":109354},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3227":65763,"_28586":65681,"_19790":109356,"_5":13558,"_26008":109149,"_2720":46796},[],{"_3227":65764,"_28586":65681,"_19790":109358,"_5":13558,"_26008":109149,"_2720":6085},[],{"_3227":65765,"_28586":65681,"_19790":109360,"_5":13558,"_26008":109149,"_2720":109361},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3227":65766,"_28586":65681,"_19790":109363,"_5":13558,"_26008":109149,"_2720":46804},[],{"_3227":65767,"_28586":65681,"_19790":109365,"_5":13558,"_26008":109149,"_2720":6085},[],{"_3227":65768,"_28586":65681,"_19790":109367,"_5":13558,"_26008":109149,"_2720":109368},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3227":65769,"_28586":65681,"_19790":109370,"_5":13558,"_26008":109149,"_2720":46812},[],{"_3227":65770,"_28586":65681,"_19790":109372,"_5":13558,"_26008":109149,"_2720":6085},[],{"_3227":65771,"_28586":65681,"_19790":109374,"_5":13558,"_26008":109149,"_2720":109375},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3227":65772,"_28586":65681,"_19790":109377,"_5":13558,"_26008":109149,"_2720":46820},[],{"_3227":65773,"_28586":65681,"_19790":109379,"_5":13558,"_26008":109149,"_2720":6085},[],{"_3227":65774,"_28586":65681,"_19790":109381,"_5":13558,"_26008":109149,"_2720":109382},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3227":65775,"_28586":65681,"_19790":109384,"_5":13558,"_26008":109149,"_2720":46828},[],{"_3227":65776,"_28586":65681,"_19790":109386,"_5":13558,"_26008":109149,"_2720":46831},[],{"_3227":65777,"_28586":65681,"_19790":109388,"_5":13558,"_26008":109149,"_2720":109389},[],"Usa otro chart local de SoftHSM",{"_3227":65778,"_28586":65681,"_19790":109391,"_5":13558,"_26008":109149,"_2720":109392},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3227":65779,"_28586":65681,"_19790":109394,"_5":13558,"_26008":109153,"_2720":109395},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3227":65780,"_28586":65681,"_19790":109397,"_5":13558,"_26008":109153,"_2720":109398},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3227":65781,"_28586":65681,"_19790":109400,"_5":13558,"_26008":109153,"_2720":109401},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3227":65782,"_28586":65681,"_19790":109403,"_5":13558,"_26008":109153,"_2720":109404},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3227":65783,"_28586":65681,"_19790":109406,"_5":13558,"_26008":109153,"_2720":109407},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3227":65784,"_28586":65681,"_19790":109409,"_5":13558,"_26008":109153,"_2720":109410},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3227":65785,"_28586":65681,"_19790":109412,"_5":13558,"_26008":109157,"_2720":46858},[],{"_3227":65786,"_28586":65681,"_19790":109414,"_5":13558,"_26008":109157,"_2720":109415},[],"valida las herramientas locales y el clúster seleccionado",{"_3227":65787,"_28586":65681,"_19790":109417,"_5":13558,"_26008":109157,"_2720":109418},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3227":65788,"_28586":65681,"_19790":109420,"_5":13558,"_26008":109157,"_2720":109421},[],"crea el namespace",{"_3227":65789,"_28586":65681,"_19790":109423,"_5":13558,"_26008":109157,"_2720":109424},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3227":65790,"_28586":65681,"_19790":109426,"_5":13558,"_26008":109157,"_2720":109427},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3227":65791,"_28586":65681,"_19790":109429,"_5":13558,"_26008":109157,"_2720":109430},[],"instala RabbitMQ",{"_3227":65792,"_28586":65681,"_19790":109432,"_5":13558,"_26008":109157,"_2720":109433},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3227":65793,"_28586":65681,"_19790":109435,"_5":13558,"_26008":109157,"_2720":109436},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3227":65794,"_28586":65681,"_19790":109438,"_5":13558,"_26008":109157,"_2720":109439},[],"carga datos de ejemplo opcionalmente",{"_3227":65795,"_28586":65681,"_19790":109441,"_5":13558,"_26008":109157,"_2720":109442},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3227":65796,"_28586":65681,"_19790":109444,"_5":13558,"_26008":109161,"_2720":109445},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3227":65797,"_28586":65681,"_19790":109447,"_5":13558,"_26008":109161,"_2720":109448},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3227":65798,"_28586":65681,"_19790":109450,"_5":13558,"_26008":109165,"_2720":109451},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3227":65799,"_28586":65681,"_19790":109453,"_5":13558,"_26008":109165,"_2720":109454},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3227":65800,"_28586":65681,"_19790":109456,"_5":13558,"_26008":109165,"_2720":109457},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3227":65801,"_28586":65681,"_19790":109459,"_5":13558,"_26008":109169,"_2720":109460},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3227":65802,"_28586":65802,"_5":13916,"_2720":109462,"_28908":109463,"_19790":109464,"_26008":65802},"Instala con Helm",[46300,108888,109122],[],{"_3227":65803,"_28586":65802,"_19790":109466,"_5":13558,"_26008":65802,"_2720":109467},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3227":65804,"_28586":65802,"_5":28905,"_19790":109469,"_26008":109470,"_2720":109471},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3227":65805,"_28586":65802,"_5":28905,"_19790":109473,"_26008":109474,"_2720":109138},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3227":65806,"_28586":65802,"_5":28905,"_19790":109476,"_26008":109477,"_2720":109478},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3227":65807,"_28586":65802,"_5":28905,"_19790":109480,"_26008":109481,"_2720":109482},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3227":65808,"_28586":65802,"_5":28905,"_19790":109484,"_26008":109485,"_2720":109486},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3227":65809,"_28586":65802,"_5":28905,"_19790":109488,"_26008":109489,"_2720":109490},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3227":65810,"_28586":65802,"_5":28905,"_19790":109492,"_26008":109493,"_2720":109494},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3227":65811,"_28586":65802,"_5":28905,"_19790":109496,"_26008":109497,"_2720":109498},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3227":65812,"_28586":65802,"_5":28905,"_19790":109500,"_26008":109501,"_2720":109502},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3227":65813,"_28586":65802,"_5":28905,"_19790":109504,"_26008":109505,"_2720":109506},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3227":65814,"_28586":65802,"_19790":109508,"_5":13558,"_26008":109470,"_2720":109509},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3227":65815,"_28586":65802,"_19790":109511,"_5":13558,"_26008":109474,"_2720":109512},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3227":65816,"_28586":65802,"_19790":109514,"_5":13558,"_26008":109474,"_2720":109515},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3227":65817,"_28586":65802,"_19790":109517,"_5":13558,"_26008":109474,"_2720":109518},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3227":65818,"_28586":65802,"_19790":109520,"_5":13558,"_26008":109474,"_2720":109521},[],"un broker RabbitMQ accesible y sus credenciales",{"_3227":65819,"_28586":65802,"_19790":109523,"_5":13558,"_26008":109474,"_2720":109524},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3227":65820,"_28586":65802,"_19790":109526,"_5":13558,"_26008":109474,"_2720":109527},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3227":65821,"_28586":65802,"_19790":109529,"_5":13558,"_26008":109474,"_2720":109530},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3227":65822,"_28586":65802,"_19790":109532,"_5":13558,"_26008":109474,"_2720":109533},[],"una StorageClass y un diseño de tráfico externo",{"_3227":65823,"_28586":65802,"_19790":109535,"_5":13558,"_26008":109474,"_2720":109536},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3227":65824,"_28586":65802,"_19790":109538,"_5":13558,"_26008":109474,"_2720":109539},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3227":65825,"_28586":65802,"_19790":109541,"_5":13558,"_26008":109474,"_2720":109542},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3227":65826,"_28586":65802,"_19790":109544,"_5":13558,"_26008":109477,"_2720":109545},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3227":65827,"_28586":65802,"_19790":109547,"_5":13558,"_26008":109477,"_2720":109548},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3227":65828,"_28586":65802,"_19790":109550,"_5":13558,"_26008":109477,"_2720":109551},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3227":65829,"_28586":65802,"_19790":109553,"_5":13558,"_26008":109481,"_2720":109554},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3227":65830,"_28586":65802,"_19790":109556,"_5":13558,"_26008":109481,"_2720":109557},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3227":65831,"_28586":65802,"_19790":109559,"_5":13558,"_26008":109481,"_2720":109560},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3227":65832,"_28586":65802,"_19790":109562,"_5":13558,"_26008":109481,"_2720":109563},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3227":65833,"_28586":65802,"_19790":109565,"_5":13558,"_26008":109485,"_2720":109566},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3227":65834,"_28586":65802,"_19790":109568,"_5":13558,"_26008":109489,"_2720":109569},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3227":65835,"_28586":65802,"_19790":109571,"_5":13558,"_26008":109489,"_2720":109572},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3227":65836,"_28586":65802,"_19790":109574,"_5":13558,"_26008":109489,"_2720":109575},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3227":65837,"_28586":65802,"_19790":109577,"_5":13558,"_26008":109489,"_2720":109578},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3227":65838,"_28586":65802,"_19790":109580,"_5":13558,"_26008":109489,"_2720":109581},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3227":65839,"_28586":65802,"_19790":109583,"_5":13558,"_26008":109489,"_2720":109584},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3227":65840,"_28586":65802,"_19790":109586,"_5":13558,"_26008":109489,"_2720":109587},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3227":65841,"_28586":65802,"_19790":109589,"_5":13558,"_26008":109493,"_2720":109590},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3227":65842,"_28586":65802,"_19790":109592,"_5":13558,"_26008":109493,"_2720":109593},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3227":65843,"_28586":65802,"_19790":109595,"_5":13558,"_26008":109493,"_2720":109596},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3227":65844,"_28586":65802,"_19790":109598,"_5":13558,"_26008":109493,"_2720":109599},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3227":65845,"_28586":65802,"_19790":109601,"_5":13558,"_26008":109497,"_2720":109602},[],"Para instalar un checkout local:",{"_3227":65846,"_28586":65802,"_19790":109604,"_5":13558,"_26008":109501,"_2720":109605},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3227":65847,"_28586":65802,"_19790":109607,"_5":13558,"_26008":109501,"_2720":109608},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3227":65848,"_28586":65802,"_19790":109610,"_5":13558,"_26008":109505,"_2720":109611},[],"Antes de pasar a producción, revisa:",{"_3227":65849,"_28586":65802,"_19790":109613,"_5":13558,"_26008":109505,"_2720":109614},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3227":65850,"_28586":65802,"_19790":109616,"_5":13558,"_26008":109505,"_2720":109617},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3227":65851,"_28586":65802,"_19790":109619,"_5":13558,"_26008":109505,"_2720":109620},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3227":65852,"_28586":65802,"_19790":109622,"_5":13558,"_26008":109505,"_2720":109623},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3227":65853,"_28586":65802,"_19790":109625,"_5":13558,"_26008":109505,"_2720":109626},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3227":65854,"_28586":65802,"_19790":109628,"_5":13558,"_26008":109505,"_2720":109629},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3227":65855,"_28586":65802,"_19790":109631,"_5":13558,"_26008":109505,"_2720":109632},[],"SMTP, observabilidad y entrega de alertas",{"_3227":65856,"_28586":65802,"_19790":109634,"_5":13558,"_26008":109505,"_2720":109635},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3227":65857,"_28586":65802,"_19790":109637,"_5":13558,"_26008":109505,"_2720":109638},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3227":65858,"_28586":65858,"_5":13916,"_2720":109640,"_28908":109641,"_19790":109642,"_26008":65858},"Expón el Gateway",[46300,108888,109122],[],{"_3227":65859,"_28586":65858,"_19790":109644,"_5":13558,"_26008":65858,"_2720":109645},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3227":65860,"_28586":65858,"_5":28905,"_19790":109647,"_26008":109648,"_2720":109649},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3227":65861,"_28586":65858,"_5":28905,"_19790":109651,"_26008":109652,"_2720":109653},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3227":65862,"_28586":65858,"_5":28905,"_19790":109655,"_26008":109656,"_2720":109657},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3227":65863,"_28586":65858,"_5":28905,"_19790":109659,"_26008":109660,"_2720":47107},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3227":65864,"_28586":65858,"_5":28905,"_19790":109662,"_26008":109663,"_2720":109664},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3227":65865,"_28586":65858,"_5":28905,"_19790":109666,"_26008":109667,"_2720":109668},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3227":65866,"_28586":65858,"_5":28905,"_19790":109670,"_26008":109671,"_2720":109672},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3227":65867,"_28586":65858,"_5":28905,"_19790":109674,"_26008":109675,"_2720":109676},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3227":65868,"_28586":65858,"_5":28905,"_19790":109678,"_26008":109679,"_2720":109680},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3227":65869,"_28586":65858,"_5":28905,"_19790":109682,"_26008":109683,"_2720":109684},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3227":65870,"_28586":65858,"_19790":109686,"_5":13558,"_26008":109648,"_2720":109687},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3227":65871,"_28586":65858,"_19790":109689,"_5":13558,"_26008":109648,"_2720":109690},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3227":65872,"_28586":65858,"_19790":109692,"_5":13558,"_26008":109652,"_2720":109693},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3227":65873,"_28586":65858,"_19790":109695,"_5":13558,"_26008":109652,"_2720":109696},[],"Defínelo únicamente cuando:",{"_3227":65874,"_28586":65858,"_19790":109698,"_5":13558,"_26008":109652,"_2720":109699},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3227":65875,"_28586":65858,"_19790":109701,"_5":13558,"_26008":109652,"_2720":109702},[],"esa dirección está asignada a este Gateway",{"_3227":65876,"_28586":65858,"_19790":109704,"_5":13558,"_26008":109652,"_2720":109705},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3227":65877,"_28586":65858,"_19790":109707,"_5":13558,"_26008":109652,"_2720":109708},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3227":65878,"_28586":65858,"_19790":109710,"_5":13558,"_26008":109652,"_2720":109711},[],"No confundas estos valores:",{"_3227":65879,"_28586":65858,"_19790":109713,"_5":13558,"_26008":109652,"_2720":109714},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3227":65880,"_28586":65858,"_19790":109716,"_5":13558,"_26008":109652,"_2720":109717},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3227":65881,"_28586":65858,"_19790":109719,"_5":13558,"_26008":109652,"_2720":109720},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3227":65882,"_28586":65858,"_19790":109722,"_5":13558,"_26008":109656,"_2720":109723},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3227":65883,"_28586":65858,"_19790":109725,"_5":13558,"_26008":109656,"_2720":109726},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3227":65884,"_28586":65858,"_19790":109728,"_5":13558,"_26008":109660,"_2720":109729},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3227":65885,"_28586":65858,"_19790":109731,"_5":13558,"_26008":109660,"_2720":109732},[],"Para el diseño recomendado:",{"_3227":65886,"_28586":65858,"_19790":109734,"_5":13558,"_26008":109660,"_2720":109735},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3227":65887,"_28586":65858,"_19790":109737,"_5":13558,"_26008":109660,"_2720":109738},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3227":65888,"_28586":65858,"_19790":109740,"_5":13558,"_26008":109660,"_2720":109741},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3227":65889,"_28586":65858,"_19790":109743,"_5":13558,"_26008":109660,"_2720":109744},[],"Apunta DNS a la dirección accesible de la VM.",{"_3227":65890,"_28586":65858,"_19790":109746,"_5":13558,"_26008":109660,"_2720":109747},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3227":65891,"_28586":65858,"_19790":109749,"_5":13558,"_26008":109663,"_2720":109750},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3227":65892,"_28586":65858,"_19790":109752,"_5":13558,"_26008":109667,"_2720":109753},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3227":65893,"_28586":65858,"_19790":109755,"_5":13558,"_26008":109667,"_2720":109756},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3227":65894,"_28586":65858,"_19790":109758,"_5":13558,"_26008":109671,"_2720":109759},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3227":65895,"_28586":65858,"_19790":109761,"_5":13558,"_26008":109671,"_2720":109762},[],"Requisito",{"_3227":65896,"_28586":65858,"_19790":109764,"_5":13558,"_26008":109671,"_2720":109765},[],"Diseño recomendado",{"_3227":65897,"_28586":65858,"_19790":109767,"_5":13558,"_26008":109671,"_2720":109768},[],"Consecuencia",{"_3227":65898,"_28586":65858,"_19790":109770,"_5":13558,"_26008":109671,"_2720":109771},[],"Varias URL o servicios de Lamassu",{"_3227":65899,"_28586":65858,"_19790":109773,"_5":13558,"_26008":109671,"_2720":109774},[],"Un Gateway con varias rutas",{"_3227":65900,"_28586":65858,"_19790":109776,"_5":13558,"_26008":109671,"_2720":109777},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3227":65901,"_28586":65858,"_19790":109779,"_5":13558,"_26008":109671,"_2720":109780},[],"Gateways independientes e IP externas distintas",{"_3227":65902,"_28586":65858,"_19790":109782,"_5":13558,"_26008":109671,"_2720":109783},[],"Una VIP por Gateway",{"_3227":65903,"_28586":65858,"_19790":109785,"_5":13558,"_26008":109671,"_2720":109786},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3227":65904,"_28586":65858,"_19790":109788,"_5":13558,"_26008":109671,"_2720":109789},[],"Gateways independientes, un nodo y una IP",{"_3227":65905,"_28586":65858,"_19790":109791,"_5":13558,"_26008":109671,"_2720":109792},[],"Puertos externos diferentes",{"_3227":65906,"_28586":65858,"_19790":109794,"_5":13558,"_26008":109671,"_2720":109795},[],"Los clientes deben indicar puertos no estándar",{"_3227":65907,"_28586":65858,"_19790":109797,"_5":13558,"_26008":109671,"_2720":109798},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3227":65908,"_28586":65858,"_19790":109800,"_5":13558,"_26008":109671,"_2720":109801},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3227":65909,"_28586":65858,"_19790":109803,"_5":13558,"_26008":109671,"_2720":109804},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3227":65910,"_28586":65858,"_19790":109806,"_5":13558,"_26008":109671,"_2720":109807},[],"Recursos Gateway separados pero proxy compartido",{"_3227":65911,"_28586":65858,"_19790":109809,"_5":13558,"_26008":109671,"_2720":109810},[],"Modo merged Gateway de Envoy",{"_3227":65912,"_28586":65858,"_19790":109812,"_5":13558,"_26008":109671,"_2720":109813},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3227":65913,"_28586":65858,"_19790":109815,"_5":13558,"_26008":109671,"_2720":109816},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3227":65914,"_28586":65858,"_19790":109818,"_5":13558,"_26008":109671,"_2720":109819},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3227":65915,"_28586":65858,"_19790":109821,"_5":13558,"_26008":109671,"_2720":109822},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3227":65916,"_28586":65858,"_19790":109824,"_5":13558,"_26008":109671,"_2720":109825},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3227":65917,"_28586":65858,"_19790":109827,"_5":13558,"_26008":109675,"_2720":109828},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3227":65918,"_28586":65858,"_19790":109830,"_5":13558,"_26008":109675,"_2720":109831},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3227":65919,"_28586":65858,"_19790":109833,"_5":13558,"_26008":109675,"_2720":109834},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3227":65920,"_28586":65858,"_19790":109836,"_5":13558,"_26008":109675,"_2720":109837},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3227":65921,"_28586":65858,"_19790":109839,"_5":13558,"_26008":109675,"_2720":109840},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3227":65922,"_28586":65858,"_19790":109842,"_5":13558,"_26008":109679,"_2720":109843},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3227":65923,"_28586":65858,"_19790":109845,"_5":13558,"_26008":109679,"_2720":109846},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3227":65924,"_28586":65858,"_19790":109848,"_5":13558,"_26008":109683,"_2720":109849},[],"Comprueba, en orden:",{"_3227":65925,"_28586":65858,"_19790":109851,"_5":13558,"_26008":109683,"_2720":109852},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3227":65926,"_28586":65858,"_19790":109854,"_5":13558,"_26008":109683,"_2720":109855},[],"Su estado contiene la dirección esperada.",{"_3227":65927,"_28586":65858,"_19790":109857,"_5":13558,"_26008":109683,"_2720":109858},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3227":65928,"_28586":65858,"_19790":109860,"_5":13558,"_26008":109683,"_2720":109861},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3227":65929,"_28586":65858,"_19790":109863,"_5":13558,"_26008":109683,"_2720":109864},[],"DNS resuelve al endpoint accesible externamente.",{"_3227":65930,"_28586":65858,"_19790":109866,"_5":13558,"_26008":109683,"_2720":109867},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3227":65931,"_28586":65858,"_19790":109869,"_5":13558,"_26008":109683,"_2720":109870},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3227":65932,"_28586":65932,"_5":13916,"_2720":46407,"_28908":109872,"_19790":109873,"_26008":65932},[46300,108888,109122],[],{"_3227":65933,"_28586":65932,"_19790":109875,"_5":13558,"_26008":65932,"_2720":109876},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3227":65934,"_28586":65932,"_5":28905,"_19790":109878,"_26008":109879,"_2720":109880},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3227":65935,"_28586":65932,"_5":28905,"_19790":109882,"_26008":109883,"_2720":109884},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3227":65936,"_28586":65932,"_5":28905,"_19790":109886,"_26008":109887,"_2720":109888},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3227":65937,"_28586":65932,"_5":28905,"_19790":109890,"_26008":109891,"_2720":109892},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3227":65938,"_28586":65932,"_5":28905,"_19790":109894,"_26008":109895,"_2720":109896},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3227":65939,"_28586":65932,"_5":28905,"_19790":109898,"_26008":109899,"_2720":109900},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3227":65940,"_28586":65932,"_19790":109902,"_5":13558,"_26008":109879,"_2720":109903},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3227":65941,"_28586":65932,"_19790":109905,"_5":13558,"_26008":109883,"_2720":109906},[],"Flujo",{"_3227":65942,"_28586":65932,"_19790":109908,"_5":13558,"_26008":109883,"_2720":109909},[],"Úsalo para",{"_3227":65943,"_28586":65932,"_19790":109911,"_5":13558,"_26008":109883,"_2720":109912},[],"Qué instala",{"_3227":65944,"_28586":65932,"_19790":109914,"_5":13558,"_26008":109883,"_2720":47362},[],{"_3227":65945,"_28586":65932,"_19790":109916,"_5":13558,"_26008":109883,"_2720":109917},[],"Producción y entornos controlados",{"_3227":65946,"_28586":65932,"_19790":109919,"_5":13558,"_26008":109883,"_2720":109920},[],"Servicios de Lamassu y recursos de Gateway API",{"_3227":65947,"_28586":65932,"_19790":109922,"_5":13558,"_26008":109883,"_2720":46544},[],{"_3227":65948,"_28586":65932,"_19790":109924,"_5":13558,"_26008":109883,"_2720":109925},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3227":65949,"_28586":65932,"_19790":109927,"_5":13558,"_26008":109883,"_2720":109928},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3227":65950,"_28586":65932,"_19790":109930,"_5":13558,"_26008":109887,"_2720":109931},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3227":65951,"_28586":65932,"_19790":109933,"_5":13558,"_26008":109887,"_2720":109934},[],"Área",{"_3227":65952,"_28586":65932,"_19790":109936,"_5":13558,"_26008":109887,"_2720":109937},[],"El chart de Lamassu proporciona",{"_3227":65953,"_28586":65932,"_19790":109939,"_5":13558,"_26008":109887,"_2720":109940},[],"Tú proporcionas",{"_3227":65954,"_28586":65932,"_19790":109942,"_5":13558,"_26008":109887,"_2720":109943},[],"Aplicaciones Lamassu",{"_3227":65955,"_28586":65932,"_19790":109945,"_5":13558,"_26008":109887,"_2720":109946},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3227":65956,"_28586":65932,"_19790":109948,"_5":13558,"_26008":109887,"_2720":109949},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3227":65957,"_28586":65932,"_19790":109951,"_5":13558,"_26008":109887,"_2720":109952},[],"Datos PostgreSQL",{"_3227":65958,"_28586":65932,"_19790":109954,"_5":13558,"_26008":109887,"_2720":109955},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3227":65959,"_28586":65932,"_19790":109957,"_5":13558,"_26008":109887,"_2720":109958},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3227":65960,"_28586":65932,"_19790":109960,"_5":13558,"_26008":109887,"_2720":109961},[],"Mensajería",{"_3227":65961,"_28586":65932,"_19790":109963,"_5":13558,"_26008":109887,"_2720":109964},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3227":65962,"_28586":65932,"_19790":109966,"_5":13558,"_26008":109887,"_2720":109967},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3227":65963,"_28586":65932,"_19790":109969,"_5":13558,"_26008":109887,"_2720":109970},[],"Identidad",{"_3227":65964,"_28586":65932,"_19790":109972,"_5":13558,"_26008":109887,"_2720":109973},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3227":65965,"_28586":65932,"_19790":109975,"_5":13558,"_26008":109887,"_2720":109976},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3227":65966,"_28586":65932,"_19790":109978,"_5":13558,"_26008":109887,"_2720":109979},[],"Enrutamiento externo",{"_3227":65967,"_28586":65932,"_19790":109981,"_5":13558,"_26008":109887,"_2720":109982},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3227":65968,"_28586":65932,"_19790":109984,"_5":13558,"_26008":109887,"_2720":109985},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3227":65969,"_28586":65932,"_19790":109987,"_5":13558,"_26008":109887,"_2720":47436},[],{"_3227":65970,"_28586":65932,"_19790":109989,"_5":13558,"_26008":109887,"_2720":109990},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3227":65971,"_28586":65932,"_19790":109992,"_5":13558,"_26008":109887,"_2720":109993},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3227":65972,"_28586":65932,"_19790":109995,"_5":13558,"_26008":109887,"_2720":109996},[],"Datos persistentes de la aplicación",{"_3227":65973,"_28586":65932,"_19790":109998,"_5":13558,"_26008":109887,"_2720":109999},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3227":65974,"_28586":65932,"_19790":110001,"_5":13558,"_26008":109887,"_2720":110002},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3227":65975,"_28586":65932,"_19790":110004,"_5":13558,"_26008":109887,"_2720":110005},[],"Integraciones opcionales",{"_3227":65976,"_28586":65932,"_19790":110007,"_5":13558,"_26008":109887,"_2720":110008},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3227":65977,"_28586":65932,"_19790":110010,"_5":13558,"_26008":109887,"_2720":110011},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3227":65978,"_28586":65932,"_19790":110013,"_5":13558,"_26008":109887,"_2720":110014},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3227":65979,"_28586":65932,"_19790":110016,"_5":13558,"_26008":109887,"_2720":110017},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3227":65980,"_28586":65932,"_19790":110019,"_5":13558,"_26008":109891,"_2720":110020},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3227":65981,"_28586":65932,"_19790":110022,"_5":13558,"_26008":109891,"_2720":110023},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3227":65982,"_28586":65932,"_19790":110025,"_5":13558,"_26008":109895,"_2720":110026},[],"Kubernetes 1.24 o posterior",{"_3227":65983,"_28586":65932,"_19790":110028,"_5":13558,"_26008":109895,"_2720":110029},[],"Helm 3.2 o posterior",{"_3227":65984,"_28586":65932,"_19790":110031,"_5":13558,"_26008":109895,"_2720":110032},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3227":65985,"_28586":65932,"_19790":110034,"_5":13558,"_26008":109895,"_2720":110035},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3227":65986,"_28586":65932,"_19790":110037,"_5":13558,"_26008":109895,"_2720":110038},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3227":65987,"_28586":65932,"_19790":110040,"_5":13558,"_26008":109895,"_2720":110041},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3227":65988,"_28586":65932,"_19790":110043,"_5":13558,"_26008":109895,"_2720":110044},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3227":65989,"_28586":65932,"_19790":110046,"_5":13558,"_26008":109899,"_2720":110047},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3227":65990,"_28586":65932,"_19790":110049,"_5":13558,"_26008":109899,"_2720":110050},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3227":65991,"_28586":65932,"_19790":110052,"_5":13558,"_26008":109899,"_2720":110053},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3227":65992,"_28586":65932,"_19790":110055,"_5":13558,"_26008":109899,"_2720":110056},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3227":65993,"_28586":65993,"_5":13916,"_2720":110058,"_28908":110059,"_19790":110061,"_26008":65993},"Resolución de problemas de despliegue",[46300,108888,110060],"Operación",[],{"_3227":65994,"_28586":65993,"_19790":110063,"_5":13558,"_26008":65993,"_2720":110064},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3227":65995,"_28586":65993,"_5":28905,"_19790":110066,"_26008":110067,"_2720":110068},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3227":65996,"_28586":65993,"_5":28905,"_19790":110070,"_26008":110071,"_2720":110072},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3227":65997,"_28586":65993,"_5":28905,"_19790":110074,"_26008":110075,"_2720":110076},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3227":65998,"_28586":65993,"_5":28905,"_19790":110078,"_26008":110079,"_2720":110080},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3227":65999,"_28586":65993,"_5":28905,"_19790":110082,"_26008":110083,"_2720":110084},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3227":66000,"_28586":65993,"_5":28905,"_19790":110086,"_26008":110087,"_2720":110088},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3227":66001,"_28586":65993,"_5":28905,"_19790":110090,"_26008":110091,"_2720":110092},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3227":66002,"_28586":65993,"_5":28905,"_19790":110094,"_26008":110095,"_2720":110096},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3227":66003,"_28586":65993,"_5":28905,"_19790":110098,"_26008":110099,"_2720":110100},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3227":66004,"_28586":65993,"_5":28905,"_19790":110102,"_26008":110103,"_2720":110104},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3227":66005,"_28586":65993,"_5":28905,"_19790":110106,"_26008":110107,"_2720":110108},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3227":66006,"_28586":65993,"_5":28905,"_19790":110110,"_26008":110111,"_2720":110112},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3227":66007,"_28586":65993,"_5":28905,"_19790":110114,"_26008":110115,"_2720":110116},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3227":66008,"_28586":65993,"_19790":110118,"_5":13558,"_26008":65993,"_2720":110119},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3227":66009,"_28586":65993,"_19790":110121,"_5":13558,"_26008":110071,"_2720":110122},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3227":66010,"_28586":65993,"_19790":110124,"_5":13558,"_26008":110075,"_2720":110125},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3227":66011,"_28586":65993,"_19790":110127,"_5":13558,"_26008":110079,"_2720":110128},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3227":66012,"_28586":65993,"_19790":110130,"_5":13558,"_26008":110083,"_2720":110131},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3227":66013,"_28586":65993,"_19790":110133,"_5":13558,"_26008":110087,"_2720":110134},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3227":66014,"_28586":65993,"_19790":110136,"_5":13558,"_26008":110091,"_2720":110137},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3227":66015,"_28586":65993,"_19790":110139,"_5":13558,"_26008":110091,"_2720":110140},[],"Ejecuta también la prueba de conectividad del chart:",{"_3227":66016,"_28586":65993,"_19790":110142,"_5":13558,"_26008":110091,"_2720":110143},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3227":66017,"_28586":65993,"_19790":110145,"_5":13558,"_26008":110091,"_2720":110146},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3227":66018,"_28586":65993,"_19790":110148,"_5":13558,"_26008":110095,"_2720":110149},[],"Si recibes un 401:",{"_3227":66019,"_28586":65993,"_19790":110151,"_5":13558,"_26008":110095,"_2720":110152},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3227":66020,"_28586":65993,"_19790":110154,"_5":13558,"_26008":110095,"_2720":110155},[],"verifica emisor, audiencia y expiración del token;",{"_3227":66021,"_28586":65993,"_19790":110157,"_5":13558,"_26008":110095,"_2720":110158},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3227":66022,"_28586":65993,"_19790":110160,"_5":13558,"_26008":110095,"_2720":110161},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3227":66023,"_28586":65993,"_19790":110163,"_5":13558,"_26008":110095,"_2720":110164},[],"Si el login termina pero las APIs devuelven 403:",{"_3227":66024,"_28586":65993,"_19790":110166,"_5":13558,"_26008":110095,"_2720":110167},[],"inspecciona los claims reales del token;",{"_3227":66025,"_28586":65993,"_19790":110169,"_5":13558,"_26008":110095,"_2720":110170},[],"confirma que coinciden con un principal activo;",{"_3227":66026,"_28586":65993,"_19790":110172,"_5":13558,"_26008":110095,"_2720":110173},[],"revisa las políticas concedidas al principal;",{"_3227":66027,"_28586":65993,"_19790":110175,"_5":13558,"_26008":110095,"_2720":110176},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3227":66028,"_28586":65993,"_19790":110178,"_5":13558,"_26008":110095,"_2720":110179},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3227":66029,"_28586":65993,"_19790":110181,"_5":13558,"_26008":110099,"_2720":110182},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3227":66030,"_28586":65993,"_19790":110184,"_5":13558,"_26008":110099,"_2720":110185},[],"Localiza el pod y Service de authz.",{"_3227":66031,"_28586":65993,"_19790":110187,"_5":13558,"_26008":110099,"_2720":110188},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3227":66032,"_28586":65993,"_19790":110190,"_5":13558,"_26008":110099,"_2720":110191},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3227":66033,"_28586":65993,"_19790":110193,"_5":13558,"_26008":110099,"_2720":110194},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3227":66034,"_28586":65993,"_19790":110196,"_5":13558,"_26008":110099,"_2720":110197},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3227":66035,"_28586":65993,"_19790":110199,"_5":13558,"_26008":110103,"_2720":110200},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3227":66036,"_28586":65993,"_19790":110202,"_5":13558,"_26008":110107,"_2720":110203},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3227":66037,"_28586":65993,"_19790":110205,"_5":13558,"_26008":110107,"_2720":110206},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3227":66038,"_28586":65993,"_19790":110208,"_5":13558,"_26008":110107,"_2720":110209},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3227":66039,"_28586":65993,"_19790":110211,"_5":13558,"_26008":110107,"_2720":110212},[],"volumen persistente sin enlazar;",{"_3227":66040,"_28586":65993,"_19790":110214,"_5":13558,"_26008":110107,"_2720":110215},[],"imagen inaccesible o política de pull incorrecta;",{"_3227":66041,"_28586":65993,"_19790":110217,"_5":13558,"_26008":110107,"_2720":110218},[],"configuración inválida del motor criptográfico;",{"_3227":66042,"_28586":65993,"_19790":110220,"_5":13558,"_26008":110107,"_2720":110221},[],"límites de CPU o memoria demasiado bajos;",{"_3227":66043,"_28586":65993,"_19790":110223,"_5":13558,"_26008":110107,"_2720":110224},[],"migración previa incompleta.",{"_3227":66044,"_28586":65993,"_19790":110226,"_5":13558,"_26008":110107,"_2720":110227},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3227":66045,"_28586":65993,"_19790":110229,"_5":13558,"_26008":110107,"_2720":110230},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3227":66046,"_28586":65993,"_19790":110232,"_5":13558,"_26008":110107,"_2720":110233},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3227":66047,"_28586":65993,"_19790":110235,"_5":13558,"_26008":110111,"_2720":110236},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3227":66048,"_28586":65993,"_19790":110238,"_5":13558,"_26008":110111,"_2720":110239},[],"verifica que esté habilitado en el servicio emisor;",{"_3227":66049,"_28586":65993,"_19790":110241,"_5":13558,"_26008":110111,"_2720":110242},[],"comprueba conectividad y credenciales AMQP;",{"_3227":66050,"_28586":65993,"_19790":110244,"_5":13558,"_26008":110111,"_2720":110245},[],"revisa exchange, routing key, colas y consumidores;",{"_3227":66051,"_28586":65993,"_19790":110247,"_5":13558,"_26008":110111,"_2720":110248},[],"inspecciona dead-letter queues;",{"_3227":66052,"_28586":65993,"_19790":110250,"_5":13558,"_26008":110111,"_2720":110251},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3227":66053,"_28586":65993,"_19790":110253,"_5":13558,"_26008":110111,"_2720":110254},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3227":66054,"_28586":65993,"_19790":110256,"_5":13558,"_26008":110111,"_2720":110257},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3227":66055,"_28586":65993,"_19790":110259,"_5":13558,"_26008":110111,"_2720":110260},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3227":66056,"_28586":65993,"_19790":110262,"_5":13558,"_26008":110111,"_2720":110263},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3227":66057,"_28586":65993,"_19790":110265,"_5":13558,"_26008":110111,"_2720":110266},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3227":66058,"_28586":65993,"_19790":110268,"_5":13558,"_26008":110111,"_2720":110269},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3227":66059,"_28586":65993,"_19790":110271,"_5":13558,"_26008":110111,"_2720":110272},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3227":66060,"_28586":65993,"_19790":110274,"_5":13558,"_26008":110115,"_2720":110275},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3227":66061,"_28586":65993,"_19790":110277,"_5":13558,"_26008":110115,"_2720":110278},[],"Antes de cerrar una incidencia, guarda:",{"_3227":66062,"_28586":65993,"_19790":110280,"_5":13558,"_26008":110115,"_2720":110281},[],"causa confirmada;",{"_3227":66063,"_28586":65993,"_19790":110283,"_5":13558,"_26008":110115,"_2720":110284},[],"alcance temporal y recursos afectados;",{"_3227":66064,"_28586":65993,"_19790":110286,"_5":13558,"_26008":110115,"_2720":110287},[],"comandos o consultas utilizados;",{"_3227":66065,"_28586":65993,"_19790":110289,"_5":13558,"_26008":110115,"_2720":110290},[],"cambio aplicado y forma de revertirlo;",{"_3227":66066,"_28586":65993,"_19790":110292,"_5":13558,"_26008":110115,"_2720":110293},[],"validación desde un consumidor;",{"_3227":66067,"_28586":65993,"_19790":110295,"_5":13558,"_26008":110115,"_2720":110296},[],"acción preventiva y propietario.",{"_3227":66068,"_28586":66068,"_5":13916,"_2720":110298,"_28908":110299,"_19790":110302,"_26008":66068},"Control de acceso",[46300,110300,110301],"Plataforma","Administración",[],{"_3227":66069,"_28586":66068,"_19790":110304,"_5":13558,"_26008":66068,"_2720":110305},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3227":66070,"_28586":66068,"_5":28905,"_19790":110307,"_26008":110308,"_2720":110309},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3227":66071,"_28586":66068,"_5":28905,"_19790":110311,"_26008":110312,"_2720":110313},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3227":66072,"_28586":66068,"_5":28905,"_19790":110315,"_26008":110316,"_2720":110317},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3227":66073,"_28586":66068,"_5":28905,"_19790":110319,"_26008":110320,"_2720":110321},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3227":66074,"_28586":66068,"_5":28905,"_19790":110323,"_26008":110324,"_2720":110325},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3227":66075,"_28586":66068,"_5":28905,"_19790":110327,"_26008":110328,"_2720":110329},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3227":66076,"_28586":66068,"_5":28905,"_19790":110331,"_26008":110332,"_2720":110333},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3227":66077,"_28586":66068,"_5":28905,"_19790":110335,"_26008":110336,"_2720":110337},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3227":66078,"_28586":66068,"_5":28905,"_19790":110339,"_26008":110340,"_2720":110341},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3227":66079,"_28586":66068,"_5":28905,"_19790":110343,"_26008":110344,"_2720":110345},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3227":66080,"_28586":66068,"_5":28905,"_19790":110347,"_26008":110348,"_2720":110349},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3227":66081,"_28586":66068,"_5":28905,"_19790":110351,"_26008":110352,"_2720":110353},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3227":66082,"_28586":66068,"_5":28905,"_19790":110355,"_26008":110356,"_2720":110357},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3227":66083,"_28586":66068,"_5":28905,"_19790":110359,"_26008":110360,"_2720":110361},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3227":66084,"_28586":66068,"_5":28905,"_19790":110363,"_26008":110364,"_2720":110365},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3227":66085,"_28586":66068,"_5":28905,"_19790":110367,"_26008":110368,"_2720":109494},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3227":66086,"_28586":66068,"_5":28905,"_19790":110370,"_26008":110371,"_2720":110372},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3227":66087,"_28586":66068,"_5":28905,"_19790":110374,"_26008":110375,"_2720":110376},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3227":66088,"_28586":66068,"_5":28905,"_19790":110378,"_26008":110379,"_2720":110380},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3227":66089,"_28586":66068,"_5":28905,"_19790":110382,"_26008":110383,"_2720":110384},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3227":66090,"_28586":66068,"_5":28905,"_19790":110386,"_26008":110387,"_2720":110388},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3227":66091,"_28586":66068,"_5":28905,"_19790":110390,"_26008":110391,"_2720":110392},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3227":66092,"_28586":66068,"_5":28905,"_19790":110394,"_26008":110395,"_2720":110396},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3227":66093,"_28586":66068,"_5":28905,"_19790":110398,"_26008":110399,"_2720":110400},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3227":66094,"_28586":66068,"_5":28905,"_19790":110402,"_26008":110403,"_2720":110404},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3227":66095,"_28586":66068,"_5":28905,"_19790":110406,"_26008":110407,"_2720":110408},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3227":66096,"_28586":66068,"_5":28905,"_19790":110410,"_26008":110411,"_2720":110412},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3227":66097,"_28586":66068,"_5":28905,"_19790":110414,"_26008":110415,"_2720":110416},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3227":66098,"_28586":66068,"_5":28905,"_19790":110418,"_26008":110419,"_2720":110420},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3227":66099,"_28586":66068,"_5":28905,"_19790":110422,"_26008":110423,"_2720":110424},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3227":66100,"_28586":66068,"_5":28905,"_19790":110426,"_26008":110427,"_2720":110428},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3227":66101,"_28586":66068,"_19790":110430,"_5":13558,"_26008":66068,"_2720":110431},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3227":66102,"_28586":66068,"_19790":110433,"_5":13558,"_26008":66068,"_2720":110434},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3227":66103,"_28586":66068,"_19790":110436,"_5":13558,"_26008":66068,"_2720":110437},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3227":66104,"_28586":66068,"_19790":110439,"_5":13558,"_26008":110308,"_2720":110440},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3227":66105,"_28586":66068,"_19790":110442,"_5":13558,"_26008":110308,"_2720":110443},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3227":66106,"_28586":66068,"_19790":110445,"_5":13558,"_26008":110308,"_2720":110446},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3227":66107,"_28586":66068,"_19790":110448,"_5":13558,"_26008":110308,"_2720":110449},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3227":66108,"_28586":66068,"_19790":110451,"_5":13558,"_26008":110308,"_2720":110452},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3227":66109,"_28586":66068,"_19790":110454,"_5":13558,"_26008":110308,"_2720":110455},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3227":66110,"_28586":66068,"_19790":110457,"_5":13558,"_26008":110312,"_2720":110458},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3227":66111,"_28586":66068,"_19790":110460,"_5":13558,"_26008":110312,"_2720":110461},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3227":66112,"_28586":66068,"_19790":110463,"_5":13558,"_26008":110316,"_2720":110464},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3227":66113,"_28586":66068,"_19790":110466,"_5":13558,"_26008":110316,"_2720":110467},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3227":66114,"_28586":66068,"_19790":110469,"_5":13558,"_26008":110316,"_2720":110470},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3227":66115,"_28586":66068,"_19790":110472,"_5":13558,"_26008":110316,"_2720":110473},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3227":66116,"_28586":66068,"_19790":110475,"_5":13558,"_26008":110316,"_2720":110476},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3227":66117,"_28586":66068,"_19790":110478,"_5":13558,"_26008":110316,"_2720":110479},[],"Carga por separado las políticas concedidas a cada principal.",{"_3227":66118,"_28586":66068,"_19790":110481,"_5":13558,"_26008":110316,"_2720":110482},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3227":66119,"_28586":66068,"_19790":110484,"_5":13558,"_26008":110316,"_2720":110485},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3227":66120,"_28586":66068,"_19790":110487,"_5":13558,"_26008":110316,"_2720":110488},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3227":66121,"_28586":66068,"_19790":110490,"_5":13558,"_26008":110316,"_2720":110491},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3227":66122,"_28586":66068,"_19790":110493,"_5":13558,"_26008":110316,"_2720":110494},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3227":66123,"_28586":66068,"_19790":110496,"_5":13558,"_26008":110316,"_2720":110497},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3227":66124,"_28586":66068,"_19790":110499,"_5":13558,"_26008":110320,"_2720":110500},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3227":66125,"_28586":66068,"_19790":110502,"_5":13558,"_26008":110320,"_2720":110503},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3227":66126,"_28586":66068,"_19790":110505,"_5":13558,"_26008":110320,"_2720":110506},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3227":66127,"_28586":66068,"_19790":110508,"_5":13558,"_26008":110320,"_2720":110509},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3227":66128,"_28586":66068,"_19790":110511,"_5":13558,"_26008":110320,"_2720":110512},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3227":66129,"_28586":66068,"_19790":110514,"_5":13558,"_26008":110320,"_2720":110515},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3227":66130,"_28586":66068,"_19790":110517,"_5":13558,"_26008":110320,"_2720":110518},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3227":66131,"_28586":66068,"_19790":110520,"_5":13558,"_26008":110320,"_2720":110521},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3227":66132,"_28586":66068,"_19790":110523,"_5":13558,"_26008":110324,"_2720":110524},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3227":66133,"_28586":66068,"_19790":110526,"_5":13558,"_26008":110324,"_2720":110527},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3227":66134,"_28586":66068,"_19790":110529,"_5":13558,"_26008":110324,"_2720":110530},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3227":66135,"_28586":66068,"_19790":110532,"_5":13558,"_26008":110324,"_2720":110533},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3227":66136,"_28586":66068,"_19790":110535,"_5":13558,"_26008":110324,"_2720":110536},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3227":66137,"_28586":66068,"_19790":110538,"_5":13558,"_26008":110324,"_2720":110539},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3227":66138,"_28586":66068,"_19790":110541,"_5":13558,"_26008":110324,"_2720":110542},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3227":66139,"_28586":66068,"_19790":110544,"_5":13558,"_26008":110324,"_2720":110545},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3227":66140,"_28586":66068,"_19790":110547,"_5":13558,"_26008":110324,"_2720":110548},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3227":66141,"_28586":66068,"_19790":110550,"_5":13558,"_26008":110324,"_2720":110551},[],"Las acciones se dividen en dos grupos:",{"_3227":66142,"_28586":66068,"_19790":110553,"_5":13558,"_26008":110324,"_2720":110554},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3227":66143,"_28586":66068,"_19790":110556,"_5":13558,"_26008":110324,"_2720":110557},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3227":66144,"_28586":66068,"_19790":110559,"_5":13558,"_26008":110324,"_2720":110560},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3227":66145,"_28586":66068,"_19790":110562,"_5":13558,"_26008":110328,"_2720":110563},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3227":66146,"_28586":66068,"_19790":110565,"_5":13558,"_26008":110328,"_2720":110566},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3227":66147,"_28586":66068,"_19790":110568,"_5":13558,"_26008":110328,"_2720":110569},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3227":66148,"_28586":66068,"_19790":110571,"_5":13558,"_26008":110332,"_2720":110572},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3227":66149,"_28586":66068,"_19790":110574,"_5":13558,"_26008":110332,"_2720":110575},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3227":66150,"_28586":66068,"_19790":110577,"_5":13558,"_26008":110332,"_2720":110578},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3227":66151,"_28586":66068,"_19790":110580,"_5":13558,"_26008":110332,"_2720":110581},[],"Los operadores implementados son:",{"_3227":66152,"_28586":66068,"_19790":110583,"_5":13558,"_26008":110332,"_2720":110584},[],"`equals`, para igualdad exacta;",{"_3227":66153,"_28586":66068,"_19790":110586,"_5":13558,"_26008":110332,"_2720":110587},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3227":66154,"_28586":66068,"_19790":110589,"_5":13558,"_26008":110332,"_2720":110590},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3227":66155,"_28586":66068,"_19790":110592,"_5":13558,"_26008":110332,"_2720":110593},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3227":66156,"_28586":66068,"_19790":110595,"_5":13558,"_26008":110336,"_2720":110596},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3227":66157,"_28586":66068,"_19790":110598,"_5":13558,"_26008":110336,"_2720":110599},[],"Los modos disponibles son:",{"_3227":66158,"_28586":66068,"_19790":110601,"_5":13558,"_26008":110336,"_2720":110602},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3227":66159,"_28586":66068,"_19790":110604,"_5":13558,"_26008":110336,"_2720":110605},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3227":66160,"_28586":66068,"_19790":110607,"_5":13558,"_26008":110336,"_2720":110608},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3227":66161,"_28586":66068,"_19790":110610,"_5":13558,"_26008":110336,"_2720":110611},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3227":66162,"_28586":66068,"_19790":110613,"_5":13558,"_26008":110336,"_2720":110614},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3227":66163,"_28586":66068,"_19790":110616,"_5":13558,"_26008":110336,"_2720":110617},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3227":66164,"_28586":66068,"_19790":110619,"_5":13558,"_26008":110340,"_2720":110620},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3227":66165,"_28586":66068,"_19790":110622,"_5":13558,"_26008":110340,"_2720":110623},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3227":66166,"_28586":66068,"_19790":110625,"_5":13558,"_26008":110340,"_2720":110626},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3227":66167,"_28586":66068,"_19790":110628,"_5":13558,"_26008":110340,"_2720":110629},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3227":66168,"_28586":66068,"_19790":110631,"_5":13558,"_26008":110348,"_2720":110632},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3227":66169,"_28586":66068,"_19790":110634,"_5":13558,"_26008":110348,"_2720":110635},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3227":66170,"_28586":66068,"_19790":110637,"_5":13558,"_26008":110352,"_2720":110638},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3227":66171,"_28586":66068,"_19790":110640,"_5":13558,"_26008":110352,"_2720":110641},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3227":66172,"_28586":66068,"_19790":110643,"_5":13558,"_26008":110356,"_2720":110644},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3227":66173,"_28586":66068,"_19790":110646,"_5":13558,"_26008":110356,"_2720":110647},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3227":66174,"_28586":66068,"_19790":110649,"_5":13558,"_26008":110356,"_2720":110650},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3227":66175,"_28586":66068,"_19790":110652,"_5":13558,"_26008":110360,"_2720":110653},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3227":66176,"_28586":66068,"_19790":110655,"_5":13558,"_26008":110360,"_2720":110656},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3227":66177,"_28586":66068,"_19790":110658,"_5":13558,"_26008":110360,"_2720":110659},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3227":66178,"_28586":66068,"_19790":110661,"_5":13558,"_26008":110360,"_2720":110662},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3227":66179,"_28586":66068,"_19790":110664,"_5":13558,"_26008":110360,"_2720":110665},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3227":66180,"_28586":66068,"_19790":110667,"_5":13558,"_26008":110360,"_2720":110668},[],"Ten en cuenta que:",{"_3227":66181,"_28586":66068,"_19790":110670,"_5":13558,"_26008":110360,"_2720":110671},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3227":66182,"_28586":66068,"_19790":110673,"_5":13558,"_26008":110360,"_2720":110674},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3227":66183,"_28586":66068,"_19790":110676,"_5":13558,"_26008":110360,"_2720":110677},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3227":66184,"_28586":66068,"_19790":110679,"_5":13558,"_26008":110364,"_2720":110680},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3227":66185,"_28586":66068,"_19790":110682,"_5":13558,"_26008":110364,"_2720":110683},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3227":66186,"_28586":66068,"_19790":110685,"_5":13558,"_26008":110364,"_2720":110686},[],"acceso completo y de solo lectura a KMS;",{"_3227":66187,"_28586":66068,"_19790":110688,"_5":13558,"_26008":110364,"_2720":110689},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3227":66188,"_28586":66068,"_19790":110691,"_5":13558,"_26008":110364,"_2720":110692},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3227":66189,"_28586":66068,"_19790":110694,"_5":13558,"_26008":110364,"_2720":110695},[],"acceso a la interfaz;",{"_3227":66190,"_28586":66068,"_19790":110697,"_5":13558,"_26008":110364,"_2720":110698},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3227":66191,"_28586":66068,"_19790":110700,"_5":13558,"_26008":110364,"_2720":110701},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3227":66192,"_28586":66068,"_19790":110703,"_5":13558,"_26008":110364,"_2720":110704},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3227":66193,"_28586":66068,"_19790":110706,"_5":13558,"_26008":110368,"_2720":110707},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3227":66194,"_28586":66068,"_19790":110709,"_5":13558,"_26008":110368,"_2720":110710},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3227":66195,"_28586":66068,"_19790":110712,"_5":13558,"_26008":110368,"_2720":110713},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3227":66196,"_28586":66068,"_19790":110715,"_5":13558,"_26008":110371,"_2720":110716},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3227":66197,"_28586":66068,"_19790":110718,"_5":13558,"_26008":110375,"_2720":110719},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3227":66198,"_28586":66068,"_19790":110721,"_5":13558,"_26008":110375,"_2720":110722},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3227":66199,"_28586":66068,"_19790":110724,"_5":13558,"_26008":110379,"_2720":110725},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3227":66200,"_28586":66068,"_19790":110727,"_5":13558,"_26008":110383,"_2720":110728},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3227":66201,"_28586":66068,"_19790":110730,"_5":13558,"_26008":110387,"_2720":110731},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3227":66202,"_28586":66068,"_19790":110733,"_5":13558,"_26008":110391,"_2720":110734},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3227":66203,"_28586":66068,"_19790":110736,"_5":13558,"_26008":110391,"_2720":110737},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3227":66204,"_28586":66068,"_19790":110739,"_5":13558,"_26008":110395,"_2720":110740},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3227":66205,"_28586":66068,"_19790":110742,"_5":13558,"_26008":110395,"_2720":110743},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3227":66206,"_28586":66068,"_19790":110745,"_5":13558,"_26008":110395,"_2720":110746},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3227":66207,"_28586":66068,"_19790":110748,"_5":13558,"_26008":110395,"_2720":110749},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3227":66208,"_28586":66068,"_19790":110751,"_5":13558,"_26008":110395,"_2720":110752},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3227":66209,"_28586":66068,"_19790":110754,"_5":13558,"_26008":110395,"_2720":110755},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3227":66210,"_28586":66068,"_19790":110757,"_5":13558,"_26008":110395,"_2720":110758},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3227":66211,"_28586":66068,"_19790":110760,"_5":13558,"_26008":110395,"_2720":110761},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3227":66212,"_28586":66068,"_19790":110763,"_5":13558,"_26008":110399,"_2720":110764},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3227":66213,"_28586":66068,"_19790":110766,"_5":13558,"_26008":110399,"_2720":110767},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3227":66214,"_28586":66068,"_19790":110769,"_5":13558,"_26008":110399,"_2720":110770},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3227":66215,"_28586":66068,"_19790":110772,"_5":13558,"_26008":110403,"_2720":110773},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3227":66216,"_28586":66068,"_19790":110775,"_5":13558,"_26008":110403,"_2720":110776},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3227":66217,"_28586":66068,"_19790":110778,"_5":13558,"_26008":110403,"_2720":110779},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3227":66218,"_28586":66068,"_19790":110781,"_5":13558,"_26008":110403,"_2720":110782},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3227":66219,"_28586":66068,"_19790":110784,"_5":13558,"_26008":110403,"_2720":110785},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3227":66220,"_28586":66068,"_19790":110787,"_5":13558,"_26008":110403,"_2720":110788},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3227":66221,"_28586":66068,"_19790":110790,"_5":13558,"_26008":110403,"_2720":110791},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3227":66222,"_28586":66068,"_19790":110793,"_5":13558,"_26008":110403,"_2720":110794},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3227":66223,"_28586":66068,"_19790":110796,"_5":13558,"_26008":110411,"_2720":110797},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3227":66224,"_28586":66068,"_19790":110799,"_5":13558,"_26008":110415,"_2720":110800},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3227":66225,"_28586":66068,"_19790":110802,"_5":13558,"_26008":110415,"_2720":110803},[],"que exista un principal activo del tipo correcto;",{"_3227":66226,"_28586":66068,"_19790":110805,"_5":13558,"_26008":110415,"_2720":110806},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3227":66227,"_28586":66068,"_19790":110808,"_5":13558,"_26008":110415,"_2720":110809},[],"que todas las condiciones del principal se cumplan;",{"_3227":66228,"_28586":66068,"_19790":110811,"_5":13558,"_26008":110415,"_2720":110812},[],"que el principal tenga concedida la política esperada;",{"_3227":66229,"_28586":66068,"_19790":110814,"_5":13558,"_26008":110415,"_2720":110815},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3227":66230,"_28586":66068,"_19790":110817,"_5":13558,"_26008":110415,"_2720":110818},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3227":66231,"_28586":66068,"_19790":110820,"_5":13558,"_26008":110415,"_2720":110821},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3227":66232,"_28586":66068,"_19790":110823,"_5":13558,"_26008":110419,"_2720":110824},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3227":66233,"_28586":66068,"_19790":110826,"_5":13558,"_26008":110423,"_2720":110827},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3227":66234,"_28586":66068,"_19790":110829,"_5":13558,"_26008":110427,"_2720":110830},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3227":66235,"_28586":66068,"_19790":110832,"_5":13558,"_26008":110427,"_2720":110833},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3227":66236,"_28586":66236,"_5":13916,"_2720":110835,"_28908":110836,"_19790":110837,"_26008":66236},"Alertas y suscripciones",[46300,110300,110301],[],{"_3227":66237,"_28586":66236,"_19790":110839,"_5":13558,"_26008":66236,"_2720":110840},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3227":66238,"_28586":66236,"_5":28905,"_19790":110842,"_26008":110843,"_2720":110844},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3227":66239,"_28586":66236,"_5":28905,"_19790":110846,"_26008":110847,"_2720":110848},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3227":66240,"_28586":66236,"_5":28905,"_19790":110850,"_26008":110851,"_2720":110852},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3227":66241,"_28586":66236,"_5":28905,"_19790":110854,"_26008":110855,"_2720":110856},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3227":66242,"_28586":66236,"_5":28905,"_19790":110858,"_26008":110859,"_2720":110860},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3227":66243,"_28586":66236,"_5":28905,"_19790":110862,"_26008":110863,"_2720":110864},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3227":66244,"_28586":66236,"_5":28905,"_19790":110866,"_26008":110867,"_2720":110868},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3227":66245,"_28586":66236,"_5":28905,"_19790":110870,"_26008":110871,"_2720":110872},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3227":66246,"_28586":66236,"_5":28905,"_19790":110874,"_26008":110875,"_2720":110876},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3227":66247,"_28586":66236,"_5":28905,"_19790":110878,"_26008":110879,"_2720":110880},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3227":66248,"_28586":66236,"_5":28905,"_19790":110882,"_26008":110883,"_2720":110884},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3227":66249,"_28586":66236,"_19790":110886,"_5":13558,"_26008":66236,"_2720":110887},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3227":66250,"_28586":66236,"_19790":110889,"_5":13558,"_26008":110843,"_2720":110890},[],"Un servicio publica un evento de dominio.",{"_3227":66251,"_28586":66236,"_19790":110892,"_5":13558,"_26008":110843,"_2720":110893},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3227":66252,"_28586":66236,"_19790":110895,"_5":13558,"_26008":110843,"_2720":110896},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3227":66253,"_28586":66236,"_19790":110898,"_5":13558,"_26008":110843,"_2720":110899},[],"Lamassu entrega el evento al canal configurado.",{"_3227":66254,"_28586":66236,"_19790":110901,"_5":13558,"_26008":110843,"_2720":110902},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3227":66255,"_28586":66236,"_19790":110904,"_5":13558,"_26008":110847,"_2720":110905},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3227":66256,"_28586":66236,"_19790":110907,"_5":13558,"_26008":110847,"_2720":110908},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3227":66257,"_28586":66236,"_19790":110910,"_5":13558,"_26008":110847,"_2720":110911},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3227":66258,"_28586":66236,"_19790":110913,"_5":13558,"_26008":110847,"_2720":110914},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3227":66259,"_28586":66236,"_19790":110916,"_5":13558,"_26008":110847,"_2720":110917},[],"`apikey_options` necesita `header` y `key`.",{"_3227":66260,"_28586":66236,"_19790":110919,"_5":13558,"_26008":110847,"_2720":110920},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3227":66261,"_28586":66236,"_19790":110922,"_5":13558,"_26008":110847,"_2720":110923},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3227":66262,"_28586":66236,"_19790":110925,"_5":13558,"_26008":110847,"_2720":110926},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3227":66263,"_28586":66236,"_19790":110928,"_5":13558,"_26008":110855,"_2720":110929},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3227":66264,"_28586":66236,"_19790":110931,"_5":13558,"_26008":110859,"_2720":110932},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3227":66265,"_28586":66236,"_19790":110934,"_5":13558,"_26008":110863,"_2720":110935},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3227":66266,"_28586":66236,"_19790":110937,"_5":13558,"_26008":110863,"_2720":110938},[],"**None** notifica todas las instancias del evento.",{"_3227":66267,"_28586":66236,"_19790":110940,"_5":13558,"_26008":110863,"_2720":110941},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3227":66268,"_28586":66236,"_19790":110943,"_5":13558,"_26008":110863,"_2720":110944},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3227":66269,"_28586":66236,"_19790":110946,"_5":13558,"_26008":110863,"_2720":110947},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3227":66270,"_28586":66236,"_19790":110949,"_5":13558,"_26008":110863,"_2720":110950},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3227":66271,"_28586":66236,"_19790":110952,"_5":13558,"_26008":110867,"_2720":110953},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3227":66272,"_28586":66236,"_19790":110955,"_5":13558,"_26008":110871,"_2720":110956},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3227":66273,"_28586":66236,"_19790":110958,"_5":13558,"_26008":110871,"_2720":110959},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3227":66274,"_28586":66236,"_19790":110961,"_5":13558,"_26008":110871,"_2720":110962},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3227":66275,"_28586":66236,"_19790":110964,"_5":13558,"_26008":110871,"_2720":110965},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3227":66276,"_28586":66236,"_19790":110967,"_5":13558,"_26008":110871,"_2720":110968},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3227":66277,"_28586":66236,"_19790":110970,"_5":13558,"_26008":110871,"_2720":110971},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3227":66278,"_28586":66236,"_19790":110973,"_5":13558,"_26008":110871,"_2720":110974},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3227":66279,"_28586":66236,"_19790":110976,"_5":13558,"_26008":110871,"_2720":110977},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3227":66280,"_28586":66236,"_19790":110979,"_5":13558,"_26008":110875,"_2720":110980},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3227":66281,"_28586":66236,"_19790":110982,"_5":13558,"_26008":110875,"_2720":110983},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3227":66282,"_28586":66236,"_19790":110985,"_5":13558,"_26008":110875,"_2720":110986},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3227":66283,"_28586":66236,"_19790":110988,"_5":13558,"_26008":110875,"_2720":110989},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3227":66284,"_28586":66236,"_19790":110991,"_5":13558,"_26008":110875,"_2720":110992},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3227":66285,"_28586":66236,"_19790":110994,"_5":13558,"_26008":110875,"_2720":110995},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3227":66286,"_28586":66236,"_19790":110997,"_5":13558,"_26008":110875,"_2720":110998},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3227":66287,"_28586":66236,"_19790":111000,"_5":13558,"_26008":110875,"_2720":111001},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3227":66288,"_28586":66236,"_19790":111003,"_5":13558,"_26008":110879,"_2720":111004},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3227":66289,"_28586":66236,"_19790":111006,"_5":13558,"_26008":110879,"_2720":111007},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3227":66290,"_28586":66236,"_19790":111009,"_5":13558,"_26008":110883,"_2720":111010},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3227":66291,"_28586":66236,"_19790":111012,"_5":13558,"_26008":110883,"_2720":111013},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3227":66292,"_28586":66236,"_19790":111015,"_5":13558,"_26008":110883,"_2720":111016},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3227":66293,"_28586":66236,"_19790":111018,"_5":13558,"_26008":110883,"_2720":111019},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3227":66294,"_28586":66236,"_19790":111021,"_5":13558,"_26008":110883,"_2720":111022},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3227":66295,"_28586":66236,"_19790":111024,"_5":13558,"_26008":110883,"_2720":111025},[],"**Validación:** `va.role.crl.create`.",{"_3227":66296,"_28586":66236,"_19790":111027,"_5":13558,"_26008":110883,"_2720":111028},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3227":66297,"_28586":66236,"_19790":111030,"_5":13558,"_26008":110883,"_2720":111031},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3227":66298,"_28586":66298,"_5":13916,"_2720":111033,"_28908":111034,"_19790":111035,"_26008":66298},"Registros de auditoría",[46300,110300,110301],[],{"_3227":66299,"_28586":66298,"_19790":111037,"_5":13558,"_26008":66298,"_2720":111038},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3227":66300,"_28586":66298,"_5":28905,"_19790":111040,"_26008":111041,"_2720":111042},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3227":66301,"_28586":66298,"_5":28905,"_19790":111044,"_26008":111045,"_2720":111046},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3227":66302,"_28586":66298,"_5":28905,"_19790":111048,"_26008":111049,"_2720":111050},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3227":66303,"_28586":66298,"_5":28905,"_19790":111052,"_26008":111053,"_2720":111054},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3227":66304,"_28586":66298,"_5":28905,"_19790":111056,"_26008":111057,"_2720":111058},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3227":66305,"_28586":66298,"_5":28905,"_19790":111060,"_26008":111061,"_2720":111062},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3227":66306,"_28586":66298,"_5":28905,"_19790":111064,"_26008":111065,"_2720":111066},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3227":66307,"_28586":66298,"_5":28905,"_19790":111068,"_26008":111069,"_2720":111070},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3227":66308,"_28586":66298,"_5":28905,"_19790":111072,"_26008":111073,"_2720":111074},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3227":66309,"_28586":66298,"_5":28905,"_19790":111076,"_26008":111077,"_2720":111078},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3227":66310,"_28586":66298,"_5":28905,"_19790":111080,"_26008":111081,"_2720":111082},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3227":66311,"_28586":66298,"_19790":111084,"_5":13558,"_26008":66298,"_2720":111085},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3227":66312,"_28586":66298,"_19790":111087,"_5":13558,"_26008":111041,"_2720":111088},[],"El cuerpo de auditoría incluye:",{"_3227":66313,"_28586":66298,"_19790":111090,"_5":13558,"_26008":111041,"_2720":111091},[],"input: datos recibidos por la operación;",{"_3227":66314,"_28586":66298,"_19790":111093,"_5":13558,"_26008":111041,"_2720":111094},[],"has\\_error: indica si el servicio devolvió un error;",{"_3227":66315,"_28586":66298,"_19790":111096,"_5":13558,"_26008":111041,"_2720":111097},[],"output: resultado producido o mensaje de error;",{"_3227":66316,"_28586":66298,"_19790":111099,"_5":13558,"_26008":111041,"_2720":111100},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3227":66317,"_28586":66298,"_19790":111102,"_5":13558,"_26008":111041,"_2720":111103},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3227":66318,"_28586":66298,"_19790":111105,"_5":13558,"_26008":111041,"_2720":111106},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3227":66319,"_28586":66298,"_19790":111108,"_5":13558,"_26008":111045,"_2720":111109},[],"El backend aplica auditoría a mutaciones de:",{"_3227":66320,"_28586":66298,"_19790":111111,"_5":13558,"_26008":111045,"_2720":111112},[],"autoridades, certificados y perfiles de emisión;",{"_3227":66321,"_28586":66298,"_19790":111114,"_5":13558,"_26008":111045,"_2720":111115},[],"claves y motores KMS;",{"_3227":66322,"_28586":66298,"_19790":111117,"_5":13558,"_26008":111045,"_2720":111118},[],"dispositivos e identidades;",{"_3227":66323,"_28586":66298,"_19790":111120,"_5":13558,"_26008":111045,"_2720":111121},[],"DMS y operaciones de enrolamiento;",{"_3227":66324,"_28586":66298,"_19790":111123,"_5":13558,"_26008":111045,"_2720":111124},[],"funciones de validación y CRL;",{"_3227":66325,"_28586":66298,"_19790":111126,"_5":13558,"_26008":111045,"_2720":111127},[],"principales, políticas y concesiones de autorización.",{"_3227":66326,"_28586":66298,"_19790":111129,"_5":13558,"_26008":111045,"_2720":111130},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3227":66327,"_28586":66298,"_19790":111132,"_5":13558,"_26008":111049,"_2720":111133},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3227":66328,"_28586":66298,"_19790":111135,"_5":13558,"_26008":111049,"_2720":111136},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3227":66329,"_28586":66298,"_19790":111138,"_5":13558,"_26008":111049,"_2720":111139},[],"Diseña el consumidor para:",{"_3227":66330,"_28586":66298,"_19790":111141,"_5":13558,"_26008":111049,"_2720":111142},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3227":66331,"_28586":66298,"_19790":111144,"_5":13558,"_26008":111049,"_2720":111145},[],"conservar el CloudEvent completo sin modificar;",{"_3227":66332,"_28586":66298,"_19790":111147,"_5":13558,"_26008":111049,"_2720":111148},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3227":66333,"_28586":66298,"_19790":111150,"_5":13558,"_26008":111049,"_2720":111151},[],"cifrar en tránsito y en reposo;",{"_3227":66334,"_28586":66298,"_19790":111153,"_5":13558,"_26008":111049,"_2720":111154},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3227":66335,"_28586":66298,"_19790":111156,"_5":13558,"_26008":111049,"_2720":111157},[],"aplicar una política explícita de retención y legal hold;",{"_3227":66336,"_28586":66298,"_19790":111159,"_5":13558,"_26008":111049,"_2720":111160},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3227":66337,"_28586":66298,"_19790":111162,"_5":13558,"_26008":111053,"_2720":111163},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3227":66338,"_28586":66298,"_19790":111165,"_5":13558,"_26008":111053,"_2720":111166},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3227":66339,"_28586":66298,"_19790":111168,"_5":13558,"_26008":111061,"_2720":111169},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3227":66340,"_28586":66298,"_19790":111171,"_5":13558,"_26008":111065,"_2720":111172},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3227":66341,"_28586":66298,"_19790":111174,"_5":13558,"_26008":111069,"_2720":111175},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3227":66342,"_28586":66298,"_19790":111177,"_5":13558,"_26008":111073,"_2720":111178},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3227":66343,"_28586":66298,"_19790":111180,"_5":13558,"_26008":111077,"_2720":111181},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3227":66344,"_28586":66298,"_19790":111183,"_5":13558,"_26008":111081,"_2720":111184},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3227":66345,"_28586":66298,"_19790":111186,"_5":13558,"_26008":111081,"_2720":111187},[],"aparece un evento de auditoría correcto;",{"_3227":66346,"_28586":66298,"_19790":111189,"_5":13558,"_26008":111081,"_2720":111190},[],"el principal coincide con la identidad utilizada;",{"_3227":66347,"_28586":66298,"_19790":111192,"_5":13558,"_26008":111081,"_2720":111193},[],"el consumidor lo persiste una sola vez;",{"_3227":66348,"_28586":66298,"_19790":111195,"_5":13558,"_26008":111081,"_2720":111196},[],"puede recuperarse por recurso, actor y periodo;",{"_3227":66349,"_28586":66298,"_19790":111198,"_5":13558,"_26008":111081,"_2720":111199},[],"una interrupción del consumidor produce una alerta.",{"_3227":66350,"_28586":66298,"_19790":111201,"_5":13558,"_26008":111081,"_2720":111202},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3227":66351,"_28586":66351,"_5":13916,"_2720":111204,"_28908":111205,"_19790":111206,"_26008":66351},"Arquitectura de la plataforma",[46300,110300],[],{"_3227":66352,"_28586":66351,"_19790":111208,"_5":13558,"_26008":66351,"_2720":111209},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3227":66353,"_28586":66351,"_5":28905,"_19790":111211,"_26008":111212,"_2720":111213},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3227":66354,"_28586":66351,"_5":28905,"_19790":111215,"_26008":111216,"_2720":111217},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3227":66355,"_28586":66351,"_5":28905,"_19790":111219,"_26008":111220,"_2720":111221},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3227":66356,"_28586":66351,"_5":28905,"_19790":111223,"_26008":111224,"_2720":111225},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3227":66357,"_28586":66351,"_5":28905,"_19790":111227,"_26008":111228,"_2720":111229},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3227":66358,"_28586":66351,"_19790":111231,"_5":13558,"_26008":66351,"_2720":111232},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3227":66359,"_28586":66351,"_19790":111234,"_5":13558,"_26008":66351,"_2720":111235},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3227":66360,"_28586":66351,"_19790":111237,"_5":13558,"_26008":111212,"_2720":111238},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3227":66361,"_28586":66351,"_19790":111240,"_5":13558,"_26008":111216,"_2720":111241},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3227":66362,"_28586":66351,"_19790":111243,"_5":13558,"_26008":111220,"_2720":111244},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3227":66363,"_28586":66351,"_19790":111246,"_5":13558,"_26008":111224,"_2720":111247},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3227":66364,"_28586":66351,"_19790":111249,"_5":13558,"_26008":111228,"_2720":111250},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3227":66365,"_28586":66365,"_5":13916,"_2720":111252,"_28908":111253,"_19790":111254,"_26008":66365},"Cómo funciona Lamassu",[46300,110300],[],{"_3227":66366,"_28586":66365,"_19790":111256,"_5":13558,"_26008":66365,"_2720":111257},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3227":66367,"_28586":66365,"_5":28905,"_19790":111259,"_26008":111260,"_2720":111261},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3227":66368,"_28586":66365,"_5":28905,"_19790":111263,"_26008":111264,"_2720":111265},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3227":66369,"_28586":66365,"_19790":111267,"_5":13558,"_26008":66365,"_2720":111268},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3227":66370,"_28586":66365,"_19790":111270,"_5":13558,"_26008":111260,"_2720":111271},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3227":66371,"_28586":66365,"_19790":111273,"_5":13558,"_26008":111260,"_2720":111274},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3227":66372,"_28586":66365,"_19790":111276,"_5":13558,"_26008":111260,"_2720":111277},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3227":66373,"_28586":66365,"_19790":111279,"_5":13558,"_26008":111260,"_2720":111280},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3227":66374,"_28586":66365,"_19790":111282,"_5":13558,"_26008":111260,"_2720":111283},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3227":66375,"_28586":66365,"_19790":111285,"_5":13558,"_26008":111264,"_2720":111286},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3227":66376,"_28586":66365,"_19790":111288,"_5":13558,"_26008":111264,"_2720":111289},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3227":66377,"_28586":66365,"_19790":111291,"_5":13558,"_26008":111264,"_2720":111292},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3227":66378,"_28586":66365,"_19790":111294,"_5":13558,"_26008":111264,"_2720":111295},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3227":66379,"_28586":66365,"_19790":111297,"_5":13558,"_26008":111264,"_2720":111298},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3227":66380,"_28586":66365,"_19790":111300,"_5":13558,"_26008":111264,"_2720":111301},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3227":66381,"_28586":66365,"_19790":111303,"_5":13558,"_26008":111264,"_2720":111304},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3227":66382,"_28586":66382,"_5":13916,"_2720":111306,"_28908":111307,"_19790":111308,"_26008":66382},"Dispositivos e identidades",[46300,110300,48757,111306],[],{"_3227":66383,"_28586":66382,"_19790":111310,"_5":13558,"_26008":66382,"_2720":111311},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3227":66384,"_28586":66382,"_5":28905,"_19790":111313,"_26008":111314,"_2720":111315},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3227":66385,"_28586":66382,"_5":28905,"_19790":111317,"_26008":111318,"_2720":111319},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3227":66386,"_28586":66382,"_5":28905,"_19790":111321,"_26008":111322,"_2720":111323},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3227":66387,"_28586":66382,"_5":28905,"_19790":111325,"_26008":111326,"_2720":111327},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3227":66388,"_28586":66382,"_5":28905,"_19790":111329,"_26008":111330,"_2720":111331},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3227":66389,"_28586":66382,"_5":28905,"_19790":111333,"_26008":111334,"_2720":111335},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3227":66390,"_28586":66382,"_5":28905,"_19790":111337,"_26008":111338,"_2720":111339},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3227":66391,"_28586":66382,"_5":28905,"_19790":111341,"_26008":111342,"_2720":111343},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3227":66392,"_28586":66382,"_5":28905,"_19790":111345,"_26008":111346,"_2720":111347},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3227":66393,"_28586":66382,"_5":28905,"_19790":111349,"_26008":111350,"_2720":111351},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3227":66394,"_28586":66382,"_5":28905,"_19790":111353,"_26008":111354,"_2720":111355},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3227":66395,"_28586":66382,"_19790":111357,"_5":13558,"_26008":66382,"_2720":111358},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3227":66396,"_28586":66382,"_19790":111360,"_5":13558,"_26008":66382,"_2720":111361},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3227":66397,"_28586":66382,"_19790":111363,"_5":13558,"_26008":111314,"_2720":111364},[],"Vista operativa",{"_3227":66398,"_28586":66382,"_19790":111366,"_5":13558,"_26008":111314,"_2720":111367},[],"Interpretación",{"_3227":66399,"_28586":66382,"_19790":111369,"_5":13558,"_26008":111314,"_2720":48820},[],{"_3227":66400,"_28586":66382,"_19790":111371,"_5":13558,"_26008":111314,"_2720":111372},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3227":66401,"_28586":66382,"_19790":111374,"_5":13558,"_26008":111314,"_2720":48826},[],{"_3227":66402,"_28586":66382,"_19790":111376,"_5":13558,"_26008":111314,"_2720":111377},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3227":66403,"_28586":66382,"_19790":111379,"_5":13558,"_26008":111314,"_2720":48832},[],{"_3227":66404,"_28586":66382,"_19790":111381,"_5":13558,"_26008":111314,"_2720":111382},[],"La identidad está en la ventana operativa de renovación.",{"_3227":66405,"_28586":66382,"_19790":111384,"_5":13558,"_26008":111314,"_2720":48838},[],{"_3227":66406,"_28586":66382,"_19790":111386,"_5":13558,"_26008":111314,"_2720":111387},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3227":66407,"_28586":66382,"_19790":111389,"_5":13558,"_26008":111314,"_2720":48844},[],{"_3227":66408,"_28586":66382,"_19790":111391,"_5":13558,"_26008":111314,"_2720":111392},[],"La identidad ha vencido.",{"_3227":66409,"_28586":66382,"_19790":111394,"_5":13558,"_26008":111314,"_2720":48850},[],{"_3227":66410,"_28586":66382,"_19790":111396,"_5":13558,"_26008":111314,"_2720":111397},[],"La identidad está marcada como revocada.",{"_3227":66411,"_28586":66382,"_19790":111399,"_5":13558,"_26008":111314,"_2720":48856},[],{"_3227":66412,"_28586":66382,"_19790":111401,"_5":13558,"_26008":111314,"_2720":111402},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3227":66413,"_28586":66382,"_19790":111404,"_5":13558,"_26008":111314,"_2720":111405},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3227":66414,"_28586":66382,"_19790":111407,"_5":13558,"_26008":111318,"_2720":111408},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3227":66415,"_28586":66382,"_19790":111410,"_5":13558,"_26008":111318,"_2720":111411},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3227":66416,"_28586":66382,"_19790":111413,"_5":13558,"_26008":111318,"_2720":111414},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3227":66417,"_28586":66382,"_19790":111416,"_5":13558,"_26008":111318,"_2720":111417},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3227":66418,"_28586":66382,"_19790":111419,"_5":13558,"_26008":111322,"_2720":111420},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3227":66419,"_28586":66382,"_19790":111422,"_5":13558,"_26008":111326,"_2720":111423},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3227":66420,"_28586":66382,"_19790":111425,"_5":13558,"_26008":111330,"_2720":111426},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3227":66421,"_28586":66382,"_19790":111428,"_5":13558,"_26008":111334,"_2720":111429},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3227":66422,"_28586":66382,"_19790":111431,"_5":13558,"_26008":111338,"_2720":111432},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3227":66423,"_28586":66382,"_19790":111434,"_5":13558,"_26008":111338,"_2720":111435},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3227":66424,"_28586":66382,"_19790":111437,"_5":13558,"_26008":111342,"_2720":111438},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3227":66425,"_28586":66382,"_19790":111440,"_5":13558,"_26008":111342,"_2720":111441},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3227":66426,"_28586":66382,"_19790":111443,"_5":13558,"_26008":111342,"_2720":111444},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3227":66427,"_28586":66382,"_19790":111446,"_5":13558,"_26008":111342,"_2720":111447},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3227":66428,"_28586":66382,"_19790":111449,"_5":13558,"_26008":111342,"_2720":111450},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3227":66429,"_28586":66382,"_19790":111452,"_5":13558,"_26008":111342,"_2720":111453},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3227":66430,"_28586":66382,"_19790":111455,"_5":13558,"_26008":111346,"_2720":111456},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3227":66431,"_28586":66382,"_19790":111458,"_5":13558,"_26008":111346,"_2720":111459},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3227":66432,"_28586":66382,"_19790":111461,"_5":13558,"_26008":111350,"_2720":111462},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3227":66433,"_28586":66382,"_19790":111464,"_5":13558,"_26008":111350,"_2720":111465},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3227":66434,"_28586":66382,"_19790":111467,"_5":13558,"_26008":111350,"_2720":111468},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3227":66435,"_28586":66382,"_19790":111470,"_5":13558,"_26008":111350,"_2720":111471},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3227":66436,"_28586":66382,"_19790":111473,"_5":13558,"_26008":111354,"_2720":111474},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3227":66437,"_28586":66382,"_19790":111476,"_5":13558,"_26008":111354,"_2720":111477},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3227":66438,"_28586":66438,"_5":13916,"_2720":111479,"_28908":111480,"_19790":111482,"_26008":66438},"Identidad inicial y autenticación",[46300,110300,48757,111306,111481],"Enrolamiento con PKI",[],{"_3227":66439,"_28586":66438,"_19790":111484,"_5":13558,"_26008":66438,"_2720":111485},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3227":66440,"_28586":66438,"_5":28905,"_19790":111487,"_26008":111488,"_2720":111489},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3227":66441,"_28586":66438,"_5":28905,"_19790":111491,"_26008":111492,"_2720":111493},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3227":66442,"_28586":66438,"_5":28905,"_19790":111495,"_26008":111496,"_2720":111497},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3227":66443,"_28586":66438,"_5":28905,"_19790":111499,"_26008":111500,"_2720":111501},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3227":66444,"_28586":66438,"_5":28905,"_19790":111503,"_26008":111504,"_2720":111505},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3227":66445,"_28586":66438,"_19790":111507,"_5":13558,"_26008":66438,"_2720":111508},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3227":66446,"_28586":66438,"_19790":111510,"_5":13558,"_26008":111488,"_2720":111511},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3227":66447,"_28586":66438,"_19790":111513,"_5":13558,"_26008":111488,"_2720":111514},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3227":66448,"_28586":66438,"_19790":111516,"_5":13558,"_26008":111492,"_2720":111517},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3227":66449,"_28586":66438,"_19790":111519,"_5":13558,"_26008":111492,"_2720":111520},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3227":66450,"_28586":66438,"_19790":111522,"_5":13558,"_26008":111492,"_2720":111523},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3227":66451,"_28586":66438,"_19790":111525,"_5":13558,"_26008":111496,"_2720":111526},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3227":66452,"_28586":66438,"_19790":111528,"_5":13558,"_26008":111496,"_2720":111529},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3227":66453,"_28586":66438,"_19790":111531,"_5":13558,"_26008":111500,"_2720":111532},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3227":66454,"_28586":66438,"_19790":111534,"_5":13558,"_26008":111500,"_2720":111535},[],"Ejemplo de cuerpo:",{"_3227":66455,"_28586":66438,"_19790":111537,"_5":13558,"_26008":111500,"_2720":111538},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3227":66456,"_28586":66438,"_19790":111540,"_5":13558,"_26008":111500,"_2720":111541},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3227":66457,"_28586":66438,"_19790":111543,"_5":13558,"_26008":111500,"_2720":111544},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3227":66458,"_28586":66438,"_19790":111546,"_5":13558,"_26008":111500,"_2720":111547},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3227":66459,"_28586":66438,"_19790":111549,"_5":13558,"_26008":111504,"_2720":111550},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3227":66460,"_28586":66438,"_19790":111552,"_5":13558,"_26008":111504,"_2720":111553},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3227":66461,"_28586":66461,"_5":13916,"_2720":111555,"_28908":111556,"_19790":111557,"_26008":66461},"Configura y opera el DMS",[46300,110300,48757,111306,111481],[],{"_3227":66462,"_28586":66461,"_19790":111559,"_5":13558,"_26008":66461,"_2720":111560},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3227":66463,"_28586":66461,"_5":28905,"_19790":111562,"_26008":111563,"_2720":108897},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3227":66464,"_28586":66461,"_5":28905,"_19790":111565,"_26008":111566,"_2720":111567},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3227":66465,"_28586":66461,"_5":28905,"_19790":111569,"_26008":111570,"_2720":111571},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3227":66466,"_28586":66461,"_5":28905,"_19790":111573,"_26008":111574,"_2720":111575},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3227":66467,"_28586":66461,"_5":28905,"_19790":111577,"_26008":111578,"_2720":111579},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3227":66468,"_28586":66461,"_5":28905,"_19790":111581,"_26008":111582,"_2720":111583},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3227":66469,"_28586":66461,"_5":28905,"_19790":111585,"_26008":111586,"_2720":111587},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3227":66470,"_28586":66461,"_5":28905,"_19790":111589,"_26008":111590,"_2720":111591},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3227":66471,"_28586":66461,"_5":28905,"_19790":111593,"_26008":111594,"_2720":49052},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3227":66472,"_28586":66461,"_5":28905,"_19790":111596,"_26008":111597,"_2720":49056},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3227":66473,"_28586":66461,"_5":28905,"_19790":111599,"_26008":111600,"_2720":111601},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3227":66474,"_28586":66461,"_5":28905,"_19790":111603,"_26008":111604,"_2720":111605},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3227":66475,"_28586":66461,"_5":28905,"_19790":111607,"_26008":111608,"_2720":111609},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3227":66476,"_28586":66461,"_5":28905,"_19790":111611,"_26008":111612,"_2720":111613},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3227":66477,"_28586":66461,"_5":28905,"_19790":111615,"_26008":111616,"_2720":49076},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3227":66478,"_28586":66461,"_5":28905,"_19790":111618,"_26008":111619,"_2720":111620},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3227":66479,"_28586":66461,"_5":28905,"_19790":111622,"_26008":111623,"_2720":111624},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3227":66480,"_28586":66461,"_5":28905,"_19790":111626,"_26008":111627,"_2720":111628},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3227":66481,"_28586":66461,"_19790":111630,"_5":13558,"_26008":66461,"_2720":111631},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3227":66482,"_28586":66461,"_19790":111633,"_5":13558,"_26008":111563,"_2720":111634},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3227":66483,"_28586":66461,"_19790":111636,"_5":13558,"_26008":111563,"_2720":111637},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3227":66484,"_28586":66461,"_19790":111639,"_5":13558,"_26008":111570,"_2720":111640},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3227":66485,"_28586":66461,"_19790":111642,"_5":13558,"_26008":111574,"_2720":111643},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3227":66486,"_28586":66461,"_19790":111645,"_5":13558,"_26008":111578,"_2720":111646},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3227":66487,"_28586":66461,"_19790":111648,"_5":13558,"_26008":111582,"_2720":111649},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3227":66488,"_28586":66461,"_19790":111651,"_5":13558,"_26008":111586,"_2720":111652},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3227":66489,"_28586":66461,"_19790":111654,"_5":13558,"_26008":111594,"_2720":111655},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3227":66490,"_28586":66461,"_19790":111657,"_5":13558,"_26008":111594,"_2720":111658},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3227":66491,"_28586":66461,"_19790":111660,"_5":13558,"_26008":111597,"_2720":111661},[],"Campo de `settings.enrollment_settings`",{"_3227":66492,"_28586":66461,"_19790":111663,"_5":13558,"_26008":111597,"_2720":111664},[],"Decisión",{"_3227":66493,"_28586":66461,"_19790":111666,"_5":13558,"_26008":111597,"_2720":49127},[],{"_3227":66494,"_28586":66461,"_19790":111668,"_5":13558,"_26008":111597,"_2720":111669},[],"`EST_RFC7030` para estas operaciones.",{"_3227":66495,"_28586":66461,"_19790":111671,"_5":13558,"_26008":111597,"_2720":49133},[],{"_3227":66496,"_28586":66461,"_19790":111673,"_5":13558,"_26008":111597,"_2720":111674},[],"ID de la CA que firmará.",{"_3227":66497,"_28586":66461,"_19790":111676,"_5":13558,"_26008":111597,"_2720":49139},[],{"_3227":66498,"_28586":66461,"_19790":111678,"_5":13558,"_26008":111597,"_2720":111679},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3227":66499,"_28586":66461,"_19790":111681,"_5":13558,"_26008":111597,"_2720":49145},[],{"_3227":66500,"_28586":66461,"_19790":111683,"_5":13558,"_26008":111597,"_2720":111684},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3227":66501,"_28586":66461,"_19790":111686,"_5":13558,"_26008":111597,"_2720":49151},[],{"_3227":66502,"_28586":66461,"_19790":111688,"_5":13558,"_26008":111597,"_2720":111689},[],"Uno de los cuatro modos de autenticación.",{"_3227":66503,"_28586":66461,"_19790":111691,"_5":13558,"_26008":111597,"_2720":111692},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3227":66504,"_28586":66461,"_19790":111694,"_5":13558,"_26008":111600,"_2720":111695},[],"Los bloques son independientes:",{"_3227":66505,"_28586":66461,"_19790":111697,"_5":13558,"_26008":111600,"_2720":111698},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3227":66506,"_28586":66461,"_19790":111700,"_5":13558,"_26008":111600,"_2720":111701},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3227":66507,"_28586":66461,"_19790":111703,"_5":13558,"_26008":111600,"_2720":49169},[],{"_3227":66508,"_28586":66461,"_19790":111705,"_5":13558,"_26008":111600,"_2720":111706},[],"Control aplicado en la operación configurada",{"_3227":66509,"_28586":66461,"_19790":111708,"_5":13558,"_26008":111600,"_2720":49175},[],{"_3227":66510,"_28586":66461,"_19790":111710,"_5":13558,"_26008":111600,"_2720":111711},[],"Validación del certificado presentado.",{"_3227":66511,"_28586":66461,"_19790":111713,"_5":13558,"_26008":111600,"_2720":49181},[],{"_3227":66512,"_28586":66461,"_19790":111715,"_5":13558,"_26008":111600,"_2720":111716},[],"Autorización del webhook configurado.",{"_3227":66513,"_28586":66461,"_19790":111718,"_5":13558,"_26008":111600,"_2720":49187},[],{"_3227":66514,"_28586":66461,"_19790":111720,"_5":13558,"_26008":111600,"_2720":111721},[],"Validación del certificado y, después, aprobación del webhook.",{"_3227":66515,"_28586":66461,"_19790":111723,"_5":13558,"_26008":111600,"_2720":49193},[],{"_3227":66516,"_28586":66461,"_19790":111725,"_5":13558,"_26008":111600,"_2720":111726},[],"Sin autenticación del solicitante por el DMS.",{"_3227":66517,"_28586":66461,"_19790":111728,"_5":13558,"_26008":111600,"_2720":111729},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3227":66518,"_28586":66461,"_19790":111731,"_5":13558,"_26008":111600,"_2720":111732},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3227":66519,"_28586":66461,"_19790":111734,"_5":13558,"_26008":111600,"_2720":111735},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3227":66520,"_28586":66461,"_19790":111737,"_5":13558,"_26008":111600,"_2720":111738},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3227":66521,"_28586":66461,"_19790":111740,"_5":13558,"_26008":111604,"_2720":111741},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3227":66522,"_28586":66461,"_19790":111743,"_5":13558,"_26008":111604,"_2720":111744},[],"Campo de `external_webhook_settings`",{"_3227":66523,"_28586":66461,"_19790":111746,"_5":13558,"_26008":111604,"_2720":111664},[],{"_3227":66524,"_28586":66461,"_19790":111748,"_5":13558,"_26008":111604,"_2720":49219},[],{"_3227":66525,"_28586":66461,"_19790":111750,"_5":13558,"_26008":111604,"_2720":111751},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3227":66526,"_28586":66461,"_19790":111753,"_5":13558,"_26008":111604,"_2720":49225},[],{"_3227":66527,"_28586":66461,"_19790":111755,"_5":13558,"_26008":111604,"_2720":111756},[],"`POST` o `PUT`; `POST` por defecto.",{"_3227":66528,"_28586":66461,"_19790":111758,"_5":13558,"_26008":111604,"_2720":49231},[],{"_3227":66529,"_28586":66461,"_19790":111760,"_5":13558,"_26008":111604,"_2720":111761},[],"Etiqueta usada en los logs del servicio.",{"_3227":66530,"_28586":66461,"_19790":111763,"_5":13558,"_26008":111604,"_2720":49237},[],{"_3227":66531,"_28586":66461,"_19790":111765,"_5":13558,"_26008":111604,"_2720":111766},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3227":66532,"_28586":66461,"_19790":111768,"_5":13558,"_26008":111604,"_2720":49243},[],{"_3227":66533,"_28586":66461,"_19790":111770,"_5":13558,"_26008":111604,"_2720":111771},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3227":66534,"_28586":66461,"_19790":111773,"_5":13558,"_26008":111604,"_2720":49249},[],{"_3227":66535,"_28586":66461,"_19790":111775,"_5":13558,"_26008":111604,"_2720":111776},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3227":66536,"_28586":66461,"_19790":111778,"_5":13558,"_26008":111604,"_2720":49255},[],{"_3227":66537,"_28586":66461,"_19790":111780,"_5":13558,"_26008":111604,"_2720":111781},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3227":66538,"_28586":66461,"_19790":111783,"_5":13558,"_26008":111604,"_2720":49261},[],{"_3227":66539,"_28586":66461,"_19790":111785,"_5":13558,"_26008":111604,"_2720":111786},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3227":66540,"_28586":66461,"_19790":111788,"_5":13558,"_26008":111604,"_2720":49267},[],{"_3227":66541,"_28586":66461,"_19790":111790,"_5":13558,"_26008":111604,"_2720":111791},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3227":66542,"_28586":66461,"_19790":111793,"_5":13558,"_26008":111604,"_2720":49273},[],{"_3227":66543,"_28586":66461,"_19790":111795,"_5":13558,"_26008":111604,"_2720":111796},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3227":66544,"_28586":66461,"_19790":111798,"_5":13558,"_26008":111604,"_2720":111799},[],"Reglas de esa configuración:",{"_3227":66545,"_28586":66461,"_19790":111801,"_5":13558,"_26008":111604,"_2720":111802},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3227":66546,"_28586":66461,"_19790":111804,"_5":13558,"_26008":111604,"_2720":111805},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3227":66547,"_28586":66461,"_19790":111807,"_5":13558,"_26008":111604,"_2720":111808},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3227":66548,"_28586":66461,"_19790":111810,"_5":13558,"_26008":111604,"_2720":111811},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3227":66549,"_28586":66461,"_19790":111813,"_5":13558,"_26008":111604,"_2720":111814},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3227":66550,"_28586":66461,"_19790":111816,"_5":13558,"_26008":111604,"_2720":111817},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3227":66551,"_28586":66461,"_19790":111819,"_5":13558,"_26008":111604,"_2720":111820},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3227":66552,"_28586":66461,"_19790":111822,"_5":13558,"_26008":111604,"_2720":111823},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3227":66553,"_28586":66461,"_19790":111825,"_5":13558,"_26008":111604,"_2720":111826},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3227":66554,"_28586":66461,"_19790":111828,"_5":13558,"_26008":111608,"_2720":111829},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3227":66555,"_28586":66461,"_19790":111831,"_5":13558,"_26008":111612,"_2720":111832},[],"Campo de `settings.reenrollment_settings`",{"_3227":66556,"_28586":66461,"_19790":111834,"_5":13558,"_26008":111612,"_2720":111835},[],"Función",{"_3227":66557,"_28586":66461,"_19790":111837,"_5":13558,"_26008":111612,"_2720":49317},[],{"_3227":66558,"_28586":66461,"_19790":111839,"_5":13558,"_26008":111612,"_2720":111840},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3227":66559,"_28586":66461,"_19790":111842,"_5":13558,"_26008":111612,"_2720":49323},[],{"_3227":66560,"_28586":66461,"_19790":111844,"_5":13558,"_26008":111612,"_2720":111845},[],"Umbral operativo preventivo de monitorización.",{"_3227":66561,"_28586":66461,"_19790":111847,"_5":13558,"_26008":111612,"_2720":49329},[],{"_3227":66562,"_28586":66461,"_19790":111849,"_5":13558,"_26008":111612,"_2720":111850},[],"Umbral operativo crítico de monitorización.",{"_3227":66563,"_28586":66461,"_19790":111852,"_5":13558,"_26008":111612,"_2720":49335},[],{"_3227":66564,"_28586":66461,"_19790":111854,"_5":13558,"_26008":111612,"_2720":111855},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3227":66565,"_28586":66461,"_19790":111857,"_5":13558,"_26008":111612,"_2720":49341},[],{"_3227":66566,"_28586":66461,"_19790":111859,"_5":13558,"_26008":111612,"_2720":111860},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3227":66567,"_28586":66461,"_19790":111862,"_5":13558,"_26008":111612,"_2720":49347},[],{"_3227":66568,"_28586":66461,"_19790":111864,"_5":13558,"_26008":111612,"_2720":111865},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3227":66569,"_28586":66461,"_19790":111867,"_5":13558,"_26008":111612,"_2720":111868},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3227":66570,"_28586":66461,"_19790":111870,"_5":13558,"_26008":111616,"_2720":111871},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3227":66571,"_28586":66461,"_19790":111873,"_5":13558,"_26008":111619,"_2720":109261},[],{"_3227":66572,"_28586":66461,"_19790":111875,"_5":13558,"_26008":111619,"_2720":111876},[],"Qué publica",{"_3227":66573,"_28586":66461,"_19790":111878,"_5":13558,"_26008":111619,"_2720":49364},[],{"_3227":66574,"_28586":66461,"_19790":111880,"_5":13558,"_26008":111619,"_2720":111881},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3227":66575,"_28586":66461,"_19790":111883,"_5":13558,"_26008":111619,"_2720":49370},[],{"_3227":66576,"_28586":66461,"_19790":111885,"_5":13558,"_26008":111619,"_2720":111886},[],"Certificado de la CA emisora seleccionada.",{"_3227":66577,"_28586":66461,"_19790":111888,"_5":13558,"_26008":111619,"_2720":49376},[],{"_3227":66578,"_28586":66461,"_19790":111890,"_5":13558,"_26008":111619,"_2720":111891},[],"Certificados de las CAs elegidas explícitamente.",{"_3227":66579,"_28586":66461,"_19790":111893,"_5":13558,"_26008":111619,"_2720":111894},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3227":66580,"_28586":66461,"_19790":111896,"_5":13558,"_26008":111623,"_2720":111897},[],"**Edit** cambia nombre, ajustes y metadatos. Al usar la API, lee el DMS antes de editarlo: `name` y `settings` se sustituyen por completo. `metadata` omitido o `null` conserva el almacenado, y un objeto lo sustituye por completo. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3227":66581,"_28586":66461,"_19790":111899,"_5":13558,"_26008":111623,"_2720":111900},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3227":66582,"_28586":66461,"_19790":111902,"_5":13558,"_26008":111623,"_2720":111903},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3227":66583,"_28586":66461,"_19790":111905,"_5":13558,"_26008":111627,"_2720":111906},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3227":66584,"_28586":66584,"_5":13916,"_2720":111908,"_28908":111909,"_19790":111910,"_26008":66584},"Integra el cliente EST",[46300,110300,48757,111306,111481],[],{"_3227":66585,"_28586":66584,"_19790":111912,"_5":13558,"_26008":66584,"_2720":111913},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3227":66586,"_28586":66584,"_5":28905,"_19790":111915,"_26008":111916,"_2720":108897},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3227":66587,"_28586":66584,"_5":28905,"_19790":111918,"_26008":111919,"_2720":111920},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3227":66588,"_28586":66584,"_5":28905,"_19790":111922,"_26008":111923,"_2720":111924},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3227":66589,"_28586":66584,"_5":28905,"_19790":111926,"_26008":111927,"_2720":111928},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3227":66590,"_28586":66584,"_5":28905,"_19790":111930,"_26008":111931,"_2720":111932},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3227":66591,"_28586":66584,"_5":28905,"_19790":111934,"_26008":111935,"_2720":111936},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3227":66592,"_28586":66584,"_19790":111938,"_5":13558,"_26008":66584,"_2720":111939},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3227":66593,"_28586":66584,"_19790":111941,"_5":13558,"_26008":111916,"_2720":111942},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3227":66594,"_28586":66584,"_19790":111944,"_5":13558,"_26008":111916,"_2720":111945},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3227":66595,"_28586":66584,"_19790":111947,"_5":13558,"_26008":111916,"_2720":111948},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3227":66596,"_28586":66584,"_19790":111950,"_5":13558,"_26008":111919,"_2720":111951},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3227":66597,"_28586":66584,"_19790":111953,"_5":13558,"_26008":111919,"_2720":111954},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3227":66598,"_28586":66584,"_19790":111956,"_5":13558,"_26008":111923,"_2720":111957},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3227":66599,"_28586":66584,"_19790":111959,"_5":13558,"_26008":111923,"_2720":111960},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3227":66600,"_28586":66584,"_19790":111962,"_5":13558,"_26008":111927,"_2720":111963},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3227":66601,"_28586":66584,"_19790":111965,"_5":13558,"_26008":111927,"_2720":111966},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3227":66602,"_28586":66584,"_19790":111968,"_5":13558,"_26008":111931,"_2720":111969},[],"Para el caso de una raíz que emite directamente:",{"_3227":66603,"_28586":66584,"_19790":111971,"_5":13558,"_26008":111931,"_2720":111972},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3227":66604,"_28586":66584,"_19790":111974,"_5":13558,"_26008":111931,"_2720":111975},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3227":66605,"_28586":66584,"_19790":111977,"_5":13558,"_26008":111935,"_2720":111978},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3227":66606,"_28586":66606,"_5":13916,"_2720":111980,"_28908":111981,"_19790":111982,"_26008":66606},"Referencia EST",[46300,110300,48757,111306,111481],[],{"_3227":66607,"_28586":66606,"_19790":111984,"_5":13558,"_26008":66606,"_2720":111985},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3227":66608,"_28586":66606,"_5":28905,"_19790":111987,"_26008":111988,"_2720":111989},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3227":66609,"_28586":66606,"_5":28905,"_19790":111991,"_26008":111992,"_2720":21508},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3227":66610,"_28586":66606,"_5":28905,"_19790":111994,"_26008":111995,"_2720":24657},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3227":66611,"_28586":66606,"_5":28905,"_19790":111997,"_26008":111998,"_2720":24664},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3227":66612,"_28586":66606,"_5":28905,"_19790":112000,"_26008":112001,"_2720":23997},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3227":66613,"_28586":66606,"_5":28905,"_19790":112003,"_26008":112004,"_2720":112005},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3227":66614,"_28586":66606,"_5":28905,"_19790":112007,"_26008":112008,"_2720":112009},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3227":66615,"_28586":66606,"_5":28905,"_19790":112011,"_26008":112012,"_2720":112013},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3227":66616,"_28586":66606,"_19790":112015,"_5":13558,"_26008":66606,"_2720":112016},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3227":66617,"_28586":66606,"_19790":112018,"_5":13558,"_26008":111988,"_2720":112019},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3227":66618,"_28586":66606,"_19790":112021,"_5":13558,"_26008":111988,"_2720":110060},[],{"_3227":66619,"_28586":66606,"_19790":112023,"_5":13558,"_26008":111988,"_2720":112024},[],"Método",{"_3227":66620,"_28586":66606,"_19790":112026,"_5":13558,"_26008":111988,"_2720":112027},[],"Autenticación y condición",{"_3227":66621,"_28586":66606,"_19790":112029,"_5":13558,"_26008":111988,"_2720":49519},[],{"_3227":66622,"_28586":66606,"_19790":112031,"_5":13558,"_26008":111988,"_2720":49522},[],{"_3227":66623,"_28586":66606,"_19790":112033,"_5":13558,"_26008":111988,"_2720":112034},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3227":66624,"_28586":66606,"_19790":112036,"_5":13558,"_26008":111988,"_2720":49528},[],{"_3227":66625,"_28586":66606,"_19790":112038,"_5":13558,"_26008":111988,"_2720":49531},[],{"_3227":66626,"_28586":66606,"_19790":112040,"_5":13558,"_26008":111988,"_2720":112041},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3227":66627,"_28586":66606,"_19790":112043,"_5":13558,"_26008":111988,"_2720":49537},[],{"_3227":66628,"_28586":66606,"_19790":112045,"_5":13558,"_26008":111988,"_2720":49531},[],{"_3227":66629,"_28586":66606,"_19790":112047,"_5":13558,"_26008":111988,"_2720":112048},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3227":66630,"_28586":66606,"_19790":112050,"_5":13558,"_26008":111988,"_2720":49545},[],{"_3227":66631,"_28586":66606,"_19790":112052,"_5":13558,"_26008":111988,"_2720":49531},[],{"_3227":66632,"_28586":66606,"_19790":112054,"_5":13558,"_26008":111988,"_2720":112055},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3227":66633,"_28586":66606,"_19790":112057,"_5":13558,"_26008":111988,"_2720":112058},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3227":66634,"_28586":66606,"_19790":112060,"_5":13558,"_26008":111992,"_2720":112061},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3227":66635,"_28586":66606,"_19790":112063,"_5":13558,"_26008":111992,"_2720":112064},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3227":66636,"_28586":66606,"_19790":112066,"_5":13558,"_26008":111995,"_2720":112067},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3227":66637,"_28586":66606,"_19790":112069,"_5":13558,"_26008":111995,"_2720":112070},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3227":66638,"_28586":66606,"_19790":112072,"_5":13558,"_26008":111998,"_2720":112073},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3227":66639,"_28586":66606,"_19790":112075,"_5":13558,"_26008":111998,"_2720":112076},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3227":66640,"_28586":66606,"_19790":112078,"_5":13558,"_26008":112001,"_2720":112079},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3227":66641,"_28586":66606,"_19790":112081,"_5":13558,"_26008":112001,"_2720":112082},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3227":66642,"_28586":66606,"_19790":112084,"_5":13558,"_26008":112004,"_2720":112085},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3227":66643,"_28586":66606,"_19790":112087,"_5":13558,"_26008":112004,"_2720":112088},[],"Parte",{"_3227":66644,"_28586":66606,"_19790":112090,"_5":13558,"_26008":112004,"_2720":112091},[],"Contenido tras decodificar su Base64",{"_3227":66645,"_28586":66606,"_19790":112093,"_5":13558,"_26008":112004,"_2720":49589},[],{"_3227":66646,"_28586":66606,"_19790":112095,"_5":13558,"_26008":112004,"_2720":112096},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3227":66647,"_28586":66606,"_19790":112098,"_5":13558,"_26008":112004,"_2720":49595},[],{"_3227":66648,"_28586":66606,"_19790":112100,"_5":13558,"_26008":112004,"_2720":112101},[],"PKCS#7 DER con el certificado emitido.",{"_3227":66649,"_28586":66606,"_19790":112103,"_5":13558,"_26008":112004,"_2720":112104},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3227":66650,"_28586":66606,"_19790":112106,"_5":13558,"_26008":112008,"_2720":112107},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3227":66651,"_28586":66606,"_19790":112109,"_5":13558,"_26008":112008,"_2720":112110},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3227":66652,"_28586":66606,"_19790":112112,"_5":13558,"_26008":112008,"_2720":112113},[],"Convierte y comprueba el resultado:",{"_3227":66653,"_28586":66606,"_19790":112115,"_5":13558,"_26008":112008,"_2720":112116},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3227":66654,"_28586":66606,"_19790":112118,"_5":13558,"_26008":112012,"_2720":112119},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3227":66655,"_28586":66606,"_19790":112121,"_5":13558,"_26008":112012,"_2720":112122},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3227":66656,"_28586":66656,"_5":13916,"_2720":111481,"_28908":112124,"_19790":112125,"_26008":66656},[46300,110300,48757,111306,111481],[],{"_3227":66657,"_28586":66656,"_19790":112127,"_5":13558,"_26008":66656,"_2720":112128},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3227":66658,"_28586":66656,"_5":28905,"_19790":112130,"_26008":112131,"_2720":112132},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3227":66659,"_28586":66656,"_5":28905,"_19790":112134,"_26008":112135,"_2720":112136},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3227":66660,"_28586":66656,"_5":28905,"_19790":112138,"_26008":112139,"_2720":112140},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3227":66661,"_28586":66656,"_5":28905,"_19790":112142,"_26008":112143,"_2720":112144},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3227":66662,"_28586":66656,"_19790":112146,"_5":13558,"_26008":66656,"_2720":112147},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3227":66663,"_28586":66656,"_19790":112149,"_5":13558,"_26008":112131,"_2720":112150},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3227":66664,"_28586":66656,"_19790":112152,"_5":13558,"_26008":112131,"_2720":112153},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3227":66665,"_28586":66656,"_19790":112155,"_5":13558,"_26008":112131,"_2720":112156},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3227":66666,"_28586":66656,"_19790":112158,"_5":13558,"_26008":112131,"_2720":112159},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3227":66667,"_28586":66656,"_19790":112161,"_5":13558,"_26008":112131,"_2720":112162},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3227":66668,"_28586":66656,"_19790":112164,"_5":13558,"_26008":112131,"_2720":112165},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3227":66669,"_28586":66656,"_19790":112167,"_5":13558,"_26008":112135,"_2720":112168},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3227":66670,"_28586":66656,"_19790":112170,"_5":13558,"_26008":112135,"_2720":112171},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":66671,"_28586":66656,"_19790":112173,"_5":13558,"_26008":112135,"_2720":112174},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3227":66672,"_28586":66656,"_19790":112176,"_5":13558,"_26008":112135,"_2720":112177},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3227":66673,"_28586":66656,"_19790":112179,"_5":13558,"_26008":112139,"_2720":112180},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3227":66674,"_28586":66656,"_19790":112182,"_5":13558,"_26008":112139,"_2720":112183},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3227":66675,"_28586":66656,"_19790":112185,"_5":13558,"_26008":112139,"_2720":112186},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3227":66676,"_28586":66656,"_19790":112188,"_5":13558,"_26008":112139,"_2720":112189},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3227":66677,"_28586":66656,"_19790":112191,"_5":13558,"_26008":112143,"_2720":112192},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3227":66678,"_28586":66656,"_19790":112194,"_5":13558,"_26008":112143,"_2720":112195},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3227":66679,"_28586":66679,"_5":13916,"_2720":112197,"_28908":112198,"_19790":112199,"_26008":66679},"Estrategias de aprovisionamiento",[46300,110300,48757,111306,111481],[],{"_3227":66680,"_28586":66679,"_19790":112201,"_5":13558,"_26008":66679,"_2720":112202},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3227":66681,"_28586":66679,"_5":28905,"_19790":112204,"_26008":112205,"_2720":112206},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3227":66682,"_28586":66679,"_5":28905,"_19790":112208,"_26008":112209,"_2720":112210},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3227":66683,"_28586":66679,"_5":28905,"_19790":112212,"_26008":112213,"_2720":112214},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3227":66684,"_28586":66679,"_5":28905,"_19790":112216,"_26008":112217,"_2720":112218},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3227":66685,"_28586":66679,"_5":28905,"_19790":112220,"_26008":112221,"_2720":112222},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3227":66686,"_28586":66679,"_19790":112224,"_5":13558,"_26008":66679,"_2720":112225},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3227":66687,"_28586":66679,"_19790":112227,"_5":13558,"_26008":112205,"_2720":112228},[],"Recorrido",{"_3227":66688,"_28586":66679,"_19790":112230,"_5":13558,"_26008":112205,"_2720":112231},[],"Cuándo existe el dispositivo",{"_3227":66689,"_28586":66679,"_19790":112233,"_5":13558,"_26008":112205,"_2720":112234},[],"Qué compruebas",{"_3227":66690,"_28586":66679,"_19790":112236,"_5":13558,"_26008":112205,"_2720":112237},[],"Asignación manual",{"_3227":66691,"_28586":66679,"_19790":112239,"_5":13558,"_26008":112205,"_2720":112240},[],"El operador lo crea antes de asociar un certificado.",{"_3227":66692,"_28586":66679,"_19790":112242,"_5":13558,"_26008":112205,"_2720":112243},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3227":66693,"_28586":66679,"_19790":112245,"_5":13558,"_26008":112205,"_2720":112246},[],"EST con `JITP`",{"_3227":66694,"_28586":66679,"_19790":112248,"_5":13558,"_26008":112205,"_2720":112249},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3227":66695,"_28586":66679,"_19790":112251,"_5":13558,"_26008":112205,"_2720":112252},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3227":66696,"_28586":66679,"_19790":112254,"_5":13558,"_26008":112205,"_2720":112255},[],"EST con `PRE_REGISTRATION`",{"_3227":66697,"_28586":66679,"_19790":112257,"_5":13558,"_26008":112205,"_2720":112258},[],"Debe existir antes de `/simpleenroll`.",{"_3227":66698,"_28586":66679,"_19790":112260,"_5":13558,"_26008":112205,"_2720":112261},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3227":66699,"_28586":66679,"_19790":112263,"_5":13558,"_26008":112205,"_2720":112264},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3227":66700,"_28586":66679,"_19790":112266,"_5":13558,"_26008":112205,"_2720":112267},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3227":66701,"_28586":66679,"_19790":112269,"_5":13558,"_26008":112209,"_2720":112270},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3227":66702,"_28586":66679,"_19790":112272,"_5":13558,"_26008":112209,"_2720":112273},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3227":66703,"_28586":66679,"_19790":112275,"_5":13558,"_26008":112209,"_2720":112276},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3227":66704,"_28586":66679,"_19790":112278,"_5":13558,"_26008":112213,"_2720":112279},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3227":66705,"_28586":66679,"_19790":112281,"_5":13558,"_26008":112213,"_2720":112282},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3227":66706,"_28586":66679,"_19790":112284,"_5":13558,"_26008":112213,"_2720":112285},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3227":66707,"_28586":66679,"_19790":112287,"_5":13558,"_26008":112213,"_2720":112288},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3227":66708,"_28586":66679,"_19790":112290,"_5":13558,"_26008":112213,"_2720":112291},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3227":66709,"_28586":66679,"_19790":112293,"_5":13558,"_26008":112213,"_2720":112294},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3227":66710,"_28586":66679,"_19790":112296,"_5":13558,"_26008":112217,"_2720":109261},[],{"_3227":66711,"_28586":66679,"_19790":112298,"_5":13558,"_26008":112217,"_2720":112299},[],"Material que atraviesa EST",{"_3227":66712,"_28586":66679,"_19790":112301,"_5":13558,"_26008":112217,"_2720":112302},[],"Clave generada por el dispositivo",{"_3227":66713,"_28586":66679,"_19790":112304,"_5":13558,"_26008":112217,"_2720":112305},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3227":66714,"_28586":66679,"_19790":112307,"_5":13558,"_26008":112217,"_2720":112308},[],"Clave ya disponible en el dispositivo",{"_3227":66715,"_28586":66679,"_19790":112310,"_5":13558,"_26008":112217,"_2720":112311},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3227":66716,"_28586":66679,"_19790":112313,"_5":13558,"_26008":112217,"_2720":49076},[],{"_3227":66717,"_28586":66679,"_19790":112315,"_5":13558,"_26008":112217,"_2720":112316},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3227":66718,"_28586":66679,"_19790":112318,"_5":13558,"_26008":112217,"_2720":112319},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3227":66719,"_28586":66679,"_19790":112321,"_5":13558,"_26008":112221,"_2720":112322},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3227":66720,"_28586":66720,"_5":13916,"_2720":112324,"_28908":112325,"_19790":112326,"_26008":66720},"Renovación y recuperación",[46300,110300,48757,111306,111481],[],{"_3227":66721,"_28586":66720,"_19790":112328,"_5":13558,"_26008":66720,"_2720":112329},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3227":66722,"_28586":66720,"_5":28905,"_19790":112331,"_26008":112332,"_2720":112333},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3227":66723,"_28586":66720,"_5":28905,"_19790":112335,"_26008":112336,"_2720":112337},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3227":66724,"_28586":66720,"_5":28905,"_19790":112339,"_26008":112340,"_2720":112341},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3227":66725,"_28586":66720,"_5":28905,"_19790":112343,"_26008":112344,"_2720":112345},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3227":66726,"_28586":66720,"_5":28905,"_19790":112347,"_26008":112348,"_2720":112349},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3227":66727,"_28586":66720,"_19790":112351,"_5":13558,"_26008":66720,"_2720":112352},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3227":66728,"_28586":66720,"_19790":112354,"_5":13558,"_26008":112332,"_2720":112355},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3227":66729,"_28586":66720,"_19790":112357,"_5":13558,"_26008":112332,"_2720":112358},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3227":66730,"_28586":66720,"_19790":112360,"_5":13558,"_26008":112332,"_2720":112361},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3227":66731,"_28586":66720,"_19790":112363,"_5":13558,"_26008":112332,"_2720":112364},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3227":66732,"_28586":66720,"_19790":112366,"_5":13558,"_26008":112336,"_2720":112367},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3227":66733,"_28586":66720,"_19790":112369,"_5":13558,"_26008":112336,"_2720":112370},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3227":66734,"_28586":66720,"_19790":112372,"_5":13558,"_26008":112340,"_2720":112373},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3227":66735,"_28586":66720,"_19790":112375,"_5":13558,"_26008":112340,"_2720":112376},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3227":66736,"_28586":66720,"_19790":112378,"_5":13558,"_26008":112340,"_2720":112379},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3227":66737,"_28586":66720,"_19790":112381,"_5":13558,"_26008":112344,"_2720":112382},[],"Situación",{"_3227":66738,"_28586":66720,"_19790":112384,"_5":13558,"_26008":112344,"_2720":112385},[],"Procedimiento",{"_3227":66739,"_28586":66720,"_19790":112387,"_5":13558,"_26008":112344,"_2720":112388},[],"Certificado vigente, fuera de ventana",{"_3227":66740,"_28586":66720,"_19790":112390,"_5":13558,"_26008":112344,"_2720":112391},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3227":66741,"_28586":66720,"_19790":112393,"_5":13558,"_26008":112344,"_2720":112394},[],"Certificado vencido, clave disponible",{"_3227":66742,"_28586":66720,"_19790":112396,"_5":13558,"_26008":112344,"_2720":112397},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3227":66743,"_28586":66720,"_19790":112399,"_5":13558,"_26008":112344,"_2720":112400},[],"Renovación por webhook o `NO_AUTH`",{"_3227":66744,"_28586":66720,"_19790":112402,"_5":13558,"_26008":112344,"_2720":112403},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3227":66745,"_28586":66720,"_19790":112405,"_5":13558,"_26008":112344,"_2720":112406},[],"Clave perdida o inaccesible",{"_3227":66746,"_28586":66720,"_19790":112408,"_5":13558,"_26008":112344,"_2720":112409},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3227":66747,"_28586":66720,"_19790":112411,"_5":13558,"_26008":112344,"_2720":112412},[],"Identidad actual revocada",{"_3227":66748,"_28586":66720,"_19790":112414,"_5":13558,"_26008":112344,"_2720":112415},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3227":66749,"_28586":66720,"_19790":112417,"_5":13558,"_26008":112344,"_2720":112418},[],"Dispositivo sin identidad",{"_3227":66750,"_28586":66720,"_19790":112420,"_5":13558,"_26008":112344,"_2720":112421},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3227":66751,"_28586":66720,"_19790":112423,"_5":13558,"_26008":112344,"_2720":112424},[],"Dispositivo retirado",{"_3227":66752,"_28586":66720,"_19790":112426,"_5":13558,"_26008":112344,"_2720":112427},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3227":66753,"_28586":66720,"_19790":112429,"_5":13558,"_26008":112344,"_2720":112430},[],"Timeout, HTTP 500 o fallo de instalación",{"_3227":66754,"_28586":66720,"_19790":112432,"_5":13558,"_26008":112344,"_2720":112433},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3227":66755,"_28586":66720,"_19790":112435,"_5":13558,"_26008":112348,"_2720":112436},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3227":66756,"_28586":66720,"_19790":112438,"_5":13558,"_26008":112348,"_2720":112439},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3227":66757,"_28586":66757,"_5":13916,"_2720":112441,"_28908":112442,"_19790":112443,"_26008":66757},"Diagnóstico de enrolamiento",[46300,110300,48757,111306,111481],[],{"_3227":66758,"_28586":66757,"_19790":112445,"_5":13558,"_26008":66757,"_2720":112446},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3227":66759,"_28586":66757,"_5":28905,"_19790":112448,"_26008":112449,"_2720":112450},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3227":66760,"_28586":66757,"_5":28905,"_19790":112452,"_26008":112453,"_2720":112454},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3227":66761,"_28586":66757,"_5":28905,"_19790":112456,"_26008":112457,"_2720":112013},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3227":66762,"_28586":66757,"_5":28905,"_19790":112459,"_26008":112460,"_2720":112461},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3227":66763,"_28586":66757,"_19790":112463,"_5":13558,"_26008":66757,"_2720":112464},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3227":66764,"_28586":66757,"_19790":112466,"_5":13558,"_26008":112453,"_2720":112467},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3227":66765,"_28586":66757,"_19790":112469,"_5":13558,"_26008":112453,"_2720":112470},[],"Síntoma o mensaje",{"_3227":66766,"_28586":66757,"_19790":112472,"_5":13558,"_26008":112453,"_2720":112473},[],"Qué revisar",{"_3227":66767,"_28586":66757,"_19790":112475,"_5":13558,"_26008":112453,"_2720":112476},[],"curl rechaza TLS, nombre o emisor",{"_3227":66768,"_28586":66757,"_19790":112478,"_5":13558,"_26008":112453,"_2720":112479},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3227":66769,"_28586":66757,"_19790":112481,"_5":13558,"_26008":112453,"_2720":112482},[],"404 o APS ausente",{"_3227":66770,"_28586":66757,"_19790":112484,"_5":13558,"_26008":112453,"_2720":112485},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3227":66771,"_28586":66757,"_19790":112487,"_5":13558,"_26008":112453,"_2720":112488},[],"400, error de CSR o formato",{"_3227":66772,"_28586":66757,"_19790":112490,"_5":13558,"_26008":112453,"_2720":112491},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3227":66773,"_28586":66757,"_19790":112493,"_5":13558,"_26008":112453,"_2720":112494},[],"Credencial ausente o certificado no válido",{"_3227":66774,"_28586":66757,"_19790":112496,"_5":13558,"_26008":112453,"_2720":112497},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3227":66775,"_28586":66757,"_19790":112499,"_5":13558,"_26008":112453,"_2720":112500},[],"Webhook deniega, expira o responde sin autorización",{"_3227":66776,"_28586":66757,"_19790":112502,"_5":13558,"_26008":112453,"_2720":112503},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3227":66777,"_28586":66757,"_19790":112505,"_5":13558,"_26008":112453,"_2720":50002},[],{"_3227":66778,"_28586":66757,"_19790":112507,"_5":13558,"_26008":112453,"_2720":112508},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3227":66779,"_28586":66757,"_19790":112510,"_5":13558,"_26008":112453,"_2720":50008},[],{"_3227":66780,"_28586":66757,"_19790":112512,"_5":13558,"_26008":112453,"_2720":112513},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3227":66781,"_28586":66757,"_19790":112515,"_5":13558,"_26008":112453,"_2720":50014},[],{"_3227":66782,"_28586":66757,"_19790":112517,"_5":13558,"_26008":112453,"_2720":112518},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3227":66783,"_28586":66757,"_19790":112520,"_5":13558,"_26008":112453,"_2720":50020},[],{"_3227":66784,"_28586":66757,"_19790":112522,"_5":13558,"_26008":112453,"_2720":112523},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3227":66785,"_28586":66757,"_19790":112525,"_5":13558,"_26008":112453,"_2720":50026},[],{"_3227":66786,"_28586":66757,"_19790":112527,"_5":13558,"_26008":112453,"_2720":112528},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3227":66787,"_28586":66757,"_19790":112530,"_5":13558,"_26008":112453,"_2720":112531},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3227":66788,"_28586":66757,"_19790":112533,"_5":13558,"_26008":112453,"_2720":112534},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3227":66789,"_28586":66757,"_19790":112536,"_5":13558,"_26008":112453,"_2720":112537},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3227":66790,"_28586":66757,"_19790":112539,"_5":13558,"_26008":112453,"_2720":112540},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3227":66791,"_28586":66757,"_19790":112542,"_5":13558,"_26008":112453,"_2720":50044},[],{"_3227":66792,"_28586":66757,"_19790":112544,"_5":13558,"_26008":112453,"_2720":112545},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3227":66793,"_28586":66757,"_19790":112547,"_5":13558,"_26008":112453,"_2720":50050},[],{"_3227":66794,"_28586":66757,"_19790":112549,"_5":13558,"_26008":112453,"_2720":112550},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3227":66795,"_28586":66757,"_19790":112552,"_5":13558,"_26008":112453,"_2720":112553},[],"DMS propietario distinto",{"_3227":66796,"_28586":66757,"_19790":112555,"_5":13558,"_26008":112453,"_2720":112556},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3227":66797,"_28586":66757,"_19790":112558,"_5":13558,"_26008":112453,"_2720":50062},[],{"_3227":66798,"_28586":66757,"_19790":112560,"_5":13558,"_26008":112453,"_2720":112561},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3227":66799,"_28586":66757,"_19790":112563,"_5":13558,"_26008":112453,"_2720":50068},[],{"_3227":66800,"_28586":66757,"_19790":112565,"_5":13558,"_26008":112453,"_2720":112566},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3227":66801,"_28586":66757,"_19790":112568,"_5":13558,"_26008":112453,"_2720":112569},[],"Certificado actual revocado",{"_3227":66802,"_28586":66757,"_19790":112571,"_5":13558,"_26008":112453,"_2720":112572},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3227":66803,"_28586":66757,"_19790":112574,"_5":13558,"_26008":112453,"_2720":112575},[],"Error de CA, perfil o firma",{"_3227":66804,"_28586":66757,"_19790":112577,"_5":13558,"_26008":112453,"_2720":112578},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3227":66805,"_28586":66757,"_19790":112580,"_5":13558,"_26008":112453,"_2720":112581},[],"HTTP 200 sin conexión del dispositivo",{"_3227":66806,"_28586":66757,"_19790":112583,"_5":13558,"_26008":112453,"_2720":112584},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3227":66807,"_28586":66757,"_19790":112586,"_5":13558,"_26008":112453,"_2720":112587},[],"Timeout o error después de emitir",{"_3227":66808,"_28586":66757,"_19790":112589,"_5":13558,"_26008":112453,"_2720":112590},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3227":66809,"_28586":66757,"_19790":112592,"_5":13558,"_26008":112457,"_2720":112593},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3227":66810,"_28586":66757,"_19790":112595,"_5":13558,"_26008":112457,"_2720":112596},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3227":66811,"_28586":66757,"_19790":112598,"_5":13558,"_26008":112460,"_2720":112599},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3227":66812,"_28586":66757,"_19790":112601,"_5":13558,"_26008":112460,"_2720":112602},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3227":66813,"_28586":66757,"_19790":112604,"_5":13558,"_26008":112460,"_2720":112605},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3227":66814,"_28586":66757,"_19790":112607,"_5":13558,"_26008":112460,"_2720":112608},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3227":66815,"_28586":66757,"_19790":112610,"_5":13558,"_26008":112460,"_2720":112611},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3227":66816,"_28586":66757,"_19790":112613,"_5":13558,"_26008":112460,"_2720":112614},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3227":66817,"_28586":66757,"_19790":112616,"_5":13558,"_26008":112460,"_2720":112617},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3227":66818,"_28586":66818,"_5":13916,"_2720":112619,"_28908":112620,"_19790":112621,"_26008":66818},"Distribución y actualización de confianza",[46300,110300,48757,111306,111481],[],{"_3227":66819,"_28586":66818,"_19790":112623,"_5":13558,"_26008":66818,"_2720":112624},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3227":66820,"_28586":66818,"_5":28905,"_19790":112626,"_26008":112627,"_2720":112628},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3227":66821,"_28586":66818,"_5":28905,"_19790":112630,"_26008":112631,"_2720":112632},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3227":66822,"_28586":66818,"_5":28905,"_19790":112634,"_26008":112635,"_2720":112636},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3227":66823,"_28586":66818,"_5":28905,"_19790":112638,"_26008":112639,"_2720":112640},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3227":66824,"_28586":66818,"_5":28905,"_19790":112642,"_26008":112643,"_2720":112644},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3227":66825,"_28586":66818,"_19790":112646,"_5":13558,"_26008":66818,"_2720":112647},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3227":66826,"_28586":66818,"_19790":112649,"_5":13558,"_26008":112627,"_2720":112650},[],"Relación",{"_3227":66827,"_28586":66818,"_19790":112652,"_5":13558,"_26008":112627,"_2720":112653},[],"Material que prepara el responsable",{"_3227":66828,"_28586":66818,"_19790":112655,"_5":13558,"_26008":112627,"_2720":112656},[],"Dispositivo → servidor EST",{"_3227":66829,"_28586":66818,"_19790":112658,"_5":13558,"_26008":112627,"_2720":112659},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3227":66830,"_28586":66818,"_19790":112661,"_5":13558,"_26008":112627,"_2720":112662},[],"DMS → solicitante",{"_3227":66831,"_28586":66818,"_19790":112664,"_5":13558,"_26008":112627,"_2720":112665},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3227":66832,"_28586":66818,"_19790":112667,"_5":13558,"_26008":112627,"_2720":112668},[],"Consumidor → dispositivo",{"_3227":66833,"_28586":66818,"_19790":112670,"_5":13558,"_26008":112627,"_2720":112671},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3227":66834,"_28586":66818,"_19790":112673,"_5":13558,"_26008":112627,"_2720":112674},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3227":66835,"_28586":66818,"_19790":112676,"_5":13558,"_26008":112631,"_2720":112677},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3227":66836,"_28586":66818,"_19790":112679,"_5":13558,"_26008":112631,"_2720":112680},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3227":66837,"_28586":66818,"_19790":112682,"_5":13558,"_26008":112635,"_2720":112683},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3227":66838,"_28586":66818,"_19790":112685,"_5":13558,"_26008":112635,"_2720":112686},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3227":66839,"_28586":66818,"_19790":112688,"_5":13558,"_26008":112635,"_2720":112689},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3227":66840,"_28586":66818,"_19790":112691,"_5":13558,"_26008":112635,"_2720":112692},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3227":66841,"_28586":66818,"_19790":112694,"_5":13558,"_26008":112635,"_2720":112695},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3227":66842,"_28586":66818,"_19790":112697,"_5":13558,"_26008":112635,"_2720":112698},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3227":66843,"_28586":66818,"_19790":112700,"_5":13558,"_26008":112639,"_2720":112701},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3227":66844,"_28586":66818,"_19790":112703,"_5":13558,"_26008":112639,"_2720":112704},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3227":66845,"_28586":66818,"_19790":112706,"_5":13558,"_26008":112639,"_2720":112707},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3227":66846,"_28586":66818,"_19790":112709,"_5":13558,"_26008":112643,"_2720":112710},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3227":66847,"_28586":66847,"_5":13916,"_2720":50217,"_28908":112712,"_19790":112714,"_26008":66847},[46300,110300,48757,111306,112713],"Integraciones",[],{"_3227":66848,"_28586":66847,"_19790":112716,"_5":13558,"_26008":66847,"_2720":112717},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3227":66849,"_28586":66847,"_5":28905,"_19790":112719,"_26008":112720,"_2720":112721},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3227":66850,"_28586":66847,"_5":28905,"_19790":112723,"_26008":112724,"_2720":112725},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3227":66851,"_28586":66847,"_5":28905,"_19790":112727,"_26008":112728,"_2720":112729},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3227":66852,"_28586":66847,"_5":28905,"_19790":112731,"_26008":112732,"_2720":112733},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3227":66853,"_28586":66847,"_5":28905,"_19790":112735,"_26008":112736,"_2720":112737},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3227":66854,"_28586":66847,"_5":28905,"_19790":112739,"_26008":112740,"_2720":112741},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3227":66855,"_28586":66847,"_5":28905,"_19790":112743,"_26008":112744,"_2720":50251},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3227":66856,"_28586":66847,"_5":28905,"_19790":112746,"_26008":112747,"_2720":50255},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3227":66857,"_28586":66847,"_5":28905,"_19790":112749,"_26008":112750,"_2720":112751},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3227":66858,"_28586":66847,"_5":28905,"_19790":112753,"_26008":112754,"_2720":112755},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3227":66859,"_28586":66847,"_5":28905,"_19790":112757,"_26008":112758,"_2720":112759},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3227":66860,"_28586":66847,"_5":28905,"_19790":112761,"_26008":112762,"_2720":112763},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3227":66861,"_28586":66847,"_5":28905,"_19790":112765,"_26008":112766,"_2720":112767},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3227":66862,"_28586":66847,"_5":28905,"_19790":112769,"_26008":112770,"_2720":112771},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3227":66863,"_28586":66847,"_5":28905,"_19790":112773,"_26008":112774,"_2720":112775},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3227":66864,"_28586":66847,"_5":28905,"_19790":112777,"_26008":112778,"_2720":112779},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3227":66865,"_28586":66847,"_5":28905,"_19790":112781,"_26008":112782,"_2720":112783},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3227":66866,"_28586":66847,"_5":28905,"_19790":112785,"_26008":112786,"_2720":112787},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3227":66867,"_28586":66847,"_5":28905,"_19790":112789,"_26008":112790,"_2720":112791},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3227":66868,"_28586":66847,"_5":28905,"_19790":112793,"_26008":112794,"_2720":112795},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3227":66869,"_28586":66847,"_19790":112797,"_5":13558,"_26008":66847,"_2720":112798},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3227":66870,"_28586":66847,"_19790":112800,"_5":13558,"_26008":66847,"_2720":112801},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3227":66871,"_28586":66847,"_19790":112803,"_5":13558,"_26008":66847,"_2720":112804},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3227":66872,"_28586":66847,"_19790":112806,"_5":13558,"_26008":112720,"_2720":112807},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3227":66873,"_28586":66847,"_19790":112809,"_5":13558,"_26008":112720,"_2720":112810},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3227":66874,"_28586":66847,"_19790":112812,"_5":13558,"_26008":112720,"_2720":112813},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3227":66875,"_28586":66847,"_19790":112815,"_5":13558,"_26008":112720,"_2720":112816},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3227":66876,"_28586":66847,"_19790":112818,"_5":13558,"_26008":112724,"_2720":112819},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3227":66877,"_28586":66847,"_19790":112821,"_5":13558,"_26008":112728,"_2720":112822},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3227":66878,"_28586":66847,"_19790":112824,"_5":13558,"_26008":112728,"_2720":112825},[],"Acción IAM",{"_3227":66879,"_28586":66847,"_19790":112827,"_5":13558,"_26008":112728,"_2720":109267},[],{"_3227":66880,"_28586":66847,"_19790":112829,"_5":13558,"_26008":112728,"_2720":50338},[],{"_3227":66881,"_28586":66847,"_19790":112831,"_5":13558,"_26008":112728,"_2720":112832},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3227":66882,"_28586":66847,"_19790":112834,"_5":13558,"_26008":112728,"_2720":50344},[],{"_3227":66883,"_28586":66847,"_19790":112836,"_5":13558,"_26008":112728,"_2720":112837},[],"Registrar la CA en AWS IoT",{"_3227":66884,"_28586":66847,"_19790":112839,"_5":13558,"_26008":112728,"_2720":50350},[],{"_3227":66885,"_28586":66847,"_19790":112841,"_5":13558,"_26008":112728,"_2720":112842},[],"Consultar el estado del registro de la CA",{"_3227":66886,"_28586":66847,"_19790":112844,"_5":13558,"_26008":112728,"_2720":50356},[],{"_3227":66887,"_28586":66847,"_19790":112846,"_5":13558,"_26008":112728,"_2720":112847},[],"Crear o actualizar Things en IoT Core",{"_3227":66888,"_28586":66847,"_19790":112849,"_5":13558,"_26008":112728,"_2720":50362},[],{"_3227":66889,"_28586":66847,"_19790":112851,"_5":13558,"_26008":112728,"_2720":112852},[],"Aprovisionar Things mediante plantilla",{"_3227":66890,"_28586":66847,"_19790":112854,"_5":13558,"_26008":112728,"_2720":50368},[],{"_3227":66891,"_28586":66847,"_19790":112856,"_5":13558,"_26008":112728,"_2720":112857},[],"Registrar certificados de dispositivo",{"_3227":66892,"_28586":66847,"_19790":112859,"_5":13558,"_26008":112728,"_2720":50374},[],{"_3227":66893,"_28586":66847,"_19790":112861,"_5":13558,"_26008":112728,"_2720":112862},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3227":66894,"_28586":66847,"_19790":112864,"_5":13558,"_26008":112728,"_2720":50380},[],{"_3227":66895,"_28586":66847,"_19790":112866,"_5":13558,"_26008":112728,"_2720":112867},[],"Crear y adjuntar políticas IoT",{"_3227":66896,"_28586":66847,"_19790":112869,"_5":13558,"_26008":112728,"_2720":50386},[],{"_3227":66897,"_28586":66847,"_19790":112871,"_5":13558,"_26008":112728,"_2720":112872},[],"Gestionar grupos de Things",{"_3227":66898,"_28586":66847,"_19790":112874,"_5":13558,"_26008":112728,"_2720":50392},[],{"_3227":66899,"_28586":66847,"_19790":112876,"_5":13558,"_26008":112728,"_2720":112877},[],"Crear plantillas JITP",{"_3227":66900,"_28586":66847,"_19790":112879,"_5":13558,"_26008":112728,"_2720":50398},[],{"_3227":66901,"_28586":66847,"_19790":112881,"_5":13558,"_26008":112728,"_2720":112882},[],"Leer y escribir el Device Shadow",{"_3227":66902,"_28586":66847,"_19790":112884,"_5":13558,"_26008":112728,"_2720":112885},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3227":66903,"_28586":66847,"_19790":112887,"_5":13558,"_26008":112732,"_2720":112888},[],"Parámetro",{"_3227":66904,"_28586":66847,"_19790":112890,"_5":13558,"_26008":112732,"_2720":112891},[],"Tipo",{"_3227":66905,"_28586":66847,"_19790":112893,"_5":13558,"_26008":112732,"_2720":112894},[],"Requerido",{"_3227":66906,"_28586":66847,"_19790":112896,"_5":13558,"_26008":112732,"_2720":112897},[],"Descripción",{"_3227":66907,"_28586":66847,"_19790":112899,"_5":13558,"_26008":112732,"_2720":50419},[],{"_3227":66908,"_28586":66847,"_19790":112901,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66909,"_28586":66847,"_19790":112903,"_5":13558,"_26008":112732,"_2720":112904},[],"Sí",{"_3227":66910,"_28586":66847,"_19790":112906,"_5":13558,"_26008":112732,"_2720":112907},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3227":66911,"_28586":66847,"_19790":112909,"_5":13558,"_26008":112732,"_2720":50430},[],{"_3227":66912,"_28586":66847,"_19790":112911,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66913,"_28586":66847,"_19790":112913,"_5":13558,"_26008":112732,"_2720":112904},[],{"_3227":66914,"_28586":66847,"_19790":112915,"_5":13558,"_26008":112732,"_2720":112916},[],"Región AWS donde opera el conector.",{"_3227":66915,"_28586":66847,"_19790":112918,"_5":13558,"_26008":112732,"_2720":50440},[],{"_3227":66916,"_28586":66847,"_19790":112920,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66917,"_28586":66847,"_19790":112922,"_5":13558,"_26008":112732,"_2720":112904},[],{"_3227":66918,"_28586":66847,"_19790":112924,"_5":13558,"_26008":112732,"_2720":112925},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3227":66919,"_28586":66847,"_19790":112927,"_5":13558,"_26008":112732,"_2720":50450},[],{"_3227":66920,"_28586":66847,"_19790":112929,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66921,"_28586":66847,"_19790":112931,"_5":13558,"_26008":112732,"_2720":112932},[],"Solo con `auth_method=static`",{"_3227":66922,"_28586":66847,"_19790":112934,"_5":13558,"_26008":112732,"_2720":112935},[],"Clave de acceso AWS.",{"_3227":66923,"_28586":66847,"_19790":112937,"_5":13558,"_26008":112732,"_2720":50461},[],{"_3227":66924,"_28586":66847,"_19790":112939,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66925,"_28586":66847,"_19790":112941,"_5":13558,"_26008":112732,"_2720":112932},[],{"_3227":66926,"_28586":66847,"_19790":112943,"_5":13558,"_26008":112732,"_2720":112944},[],"Clave secreta AWS.",{"_3227":66927,"_28586":66847,"_19790":112946,"_5":13558,"_26008":112732,"_2720":50471},[],{"_3227":66928,"_28586":66847,"_19790":112948,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66929,"_28586":66847,"_19790":112950,"_5":13558,"_26008":112732,"_2720":50476},[],{"_3227":66930,"_28586":66847,"_19790":112952,"_5":13558,"_26008":112732,"_2720":112953},[],"Token de sesión (con `auth_method=static`).",{"_3227":66931,"_28586":66847,"_19790":112955,"_5":13558,"_26008":112732,"_2720":50482},[],{"_3227":66932,"_28586":66847,"_19790":112957,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66933,"_28586":66847,"_19790":112959,"_5":13558,"_26008":112732,"_2720":112960},[],"Solo con `auth_method=role`",{"_3227":66934,"_28586":66847,"_19790":112962,"_5":13558,"_26008":112732,"_2720":112963},[],"ARN del rol a asumir.",{"_3227":66935,"_28586":66847,"_19790":112965,"_5":13558,"_26008":112732,"_2720":50493},[],{"_3227":66936,"_28586":66847,"_19790":112967,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66937,"_28586":66847,"_19790":112969,"_5":13558,"_26008":112732,"_2720":50476},[],{"_3227":66938,"_28586":66847,"_19790":112971,"_5":13558,"_26008":112732,"_2720":112972},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3227":66939,"_28586":66847,"_19790":112974,"_5":13558,"_26008":112732,"_2720":50503},[],{"_3227":66940,"_28586":66847,"_19790":112976,"_5":13558,"_26008":112732,"_2720":16666},[],{"_3227":66941,"_28586":66847,"_19790":112978,"_5":13558,"_26008":112732,"_2720":112904},[],{"_3227":66942,"_28586":66847,"_19790":112980,"_5":13558,"_26008":112732,"_2720":112981},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3227":66943,"_28586":66847,"_19790":112983,"_5":13558,"_26008":112732,"_2720":50513},[],{"_3227":66944,"_28586":66847,"_19790":112985,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66945,"_28586":66847,"_19790":112987,"_5":13558,"_26008":112732,"_2720":112904},[],{"_3227":66946,"_28586":66847,"_19790":112989,"_5":13558,"_26008":112732,"_2720":112990},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3227":66947,"_28586":66847,"_19790":112992,"_5":13558,"_26008":112732,"_2720":50523},[],{"_3227":66948,"_28586":66847,"_19790":112994,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66949,"_28586":66847,"_19790":112996,"_5":13558,"_26008":112732,"_2720":112904},[],{"_3227":66950,"_28586":66847,"_19790":112998,"_5":13558,"_26008":112732,"_2720":112999},[],"URL HTTP del Device Manager de Lamassu.",{"_3227":66951,"_28586":66847,"_19790":113001,"_5":13558,"_26008":112732,"_2720":50533},[],{"_3227":66952,"_28586":66847,"_19790":113003,"_5":13558,"_26008":112732,"_2720":23659},[],{"_3227":66953,"_28586":66847,"_19790":113005,"_5":13558,"_26008":112732,"_2720":112904},[],{"_3227":66954,"_28586":66847,"_19790":113007,"_5":13558,"_26008":112732,"_2720":113008},[],"URL HTTP del servicio de CA de Lamassu.",{"_3227":66955,"_28586":66847,"_19790":113010,"_5":13558,"_26008":112736,"_2720":113011},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3227":66956,"_28586":66847,"_19790":113013,"_5":13558,"_26008":112740,"_2720":113014},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3227":66957,"_28586":66847,"_19790":113016,"_5":13558,"_26008":112740,"_2720":113017},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3227":66958,"_28586":66847,"_19790":113019,"_5":13558,"_26008":112744,"_2720":113020},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3227":66959,"_28586":66847,"_19790":113022,"_5":13558,"_26008":112744,"_2720":113023},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3227":66960,"_28586":66847,"_19790":113025,"_5":13558,"_26008":112744,"_2720":113026},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3227":66961,"_28586":66847,"_19790":113028,"_5":13558,"_26008":112744,"_2720":113029},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3227":66962,"_28586":66847,"_19790":113031,"_5":13558,"_26008":112744,"_2720":113032},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3227":66963,"_28586":66847,"_19790":113034,"_5":13558,"_26008":112744,"_2720":113035},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3227":66964,"_28586":66847,"_19790":113037,"_5":13558,"_26008":112747,"_2720":113038},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3227":66965,"_28586":66847,"_19790":113040,"_5":13558,"_26008":112750,"_2720":113041},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3227":66966,"_28586":66847,"_19790":113043,"_5":13558,"_26008":112750,"_2720":113044},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3227":66967,"_28586":66847,"_19790":113046,"_5":13558,"_26008":112754,"_2720":113047},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3227":66968,"_28586":66847,"_19790":113049,"_5":13558,"_26008":112758,"_2720":113050},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3227":66969,"_28586":66847,"_19790":113052,"_5":13558,"_26008":112758,"_2720":113053},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3227":66970,"_28586":66847,"_19790":113055,"_5":13558,"_26008":112758,"_2720":113056},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3227":66971,"_28586":66847,"_19790":113058,"_5":13558,"_26008":112758,"_2720":113059},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3227":66972,"_28586":66847,"_19790":113061,"_5":13558,"_26008":112758,"_2720":113062},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3227":66973,"_28586":66847,"_19790":113064,"_5":13558,"_26008":112758,"_2720":113065},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3227":66974,"_28586":66847,"_19790":113067,"_5":13558,"_26008":112762,"_2720":113068},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. La plantilla se crea cuando el DMS se crea en Lamassu, no en el enrolamiento del dispositivo, y no se actualiza después (ver el aviso siguiente). A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3227":66975,"_28586":66847,"_19790":113070,"_5":13558,"_26008":112762,"_2720":113071},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3227":66976,"_28586":66847,"_19790":113073,"_5":13558,"_26008":112762,"_2720":113074},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3227":66977,"_28586":66847,"_19790":113076,"_5":13558,"_26008":112762,"_2720":113077},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3227":66978,"_28586":66847,"_19790":113079,"_5":13558,"_26008":112762,"_2720":113080},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3227":66979,"_28586":66847,"_19790":113082,"_5":13558,"_26008":112766,"_2720":113083},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3227":66980,"_28586":66847,"_19790":113085,"_5":13558,"_26008":112766,"_2720":113086},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3227":66981,"_28586":66847,"_19790":113088,"_5":13558,"_26008":112766,"_2720":113089},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3227":66982,"_28586":66847,"_19790":113091,"_5":13558,"_26008":112770,"_2720":113092},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3227":66983,"_28586":66847,"_19790":113094,"_5":13558,"_26008":112770,"_2720":113095},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3227":66984,"_28586":66847,"_19790":113097,"_5":13558,"_26008":112770,"_2720":113098},[],"Para que el flujo JITP funcione correctamente:",{"_3227":66985,"_28586":66847,"_19790":113100,"_5":13558,"_26008":112770,"_2720":113101},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3227":66986,"_28586":66847,"_19790":113103,"_5":13558,"_26008":112770,"_2720":113104},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3227":66987,"_28586":66847,"_19790":113106,"_5":13558,"_26008":112770,"_2720":113107},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3227":66988,"_28586":66847,"_19790":113109,"_5":13558,"_26008":112770,"_2720":113110},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3227":66989,"_28586":66847,"_19790":113112,"_5":13558,"_26008":112774,"_2720":113113},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3227":66990,"_28586":66847,"_19790":113115,"_5":13558,"_26008":112774,"_2720":113116},[],"Estado en Lamassu",{"_3227":66991,"_28586":66847,"_19790":113118,"_5":13558,"_26008":112774,"_2720":113119},[],"Razón de revocación",{"_3227":66992,"_28586":66847,"_19790":113121,"_5":13558,"_26008":112774,"_2720":113122},[],"Estado en AWS IoT Core",{"_3227":66993,"_28586":66847,"_19790":113124,"_5":13558,"_26008":112774,"_2720":50660},[],{"_3227":66994,"_28586":66847,"_19790":113126,"_5":13558,"_26008":112774,"_2720":113127},[],"Ninguna",{"_3227":66995,"_28586":66847,"_19790":113129,"_5":13558,"_26008":112774,"_2720":50666},[],{"_3227":66996,"_28586":66847,"_19790":113131,"_5":13558,"_26008":112774,"_2720":50669},[],{"_3227":66997,"_28586":66847,"_19790":113133,"_5":13558,"_26008":112774,"_2720":50672},[],{"_3227":66998,"_28586":66847,"_19790":113135,"_5":13558,"_26008":112774,"_2720":50675},[],{"_3227":66999,"_28586":66847,"_19790":113137,"_5":13558,"_26008":112774,"_2720":50669},[],{"_3227":67000,"_28586":66847,"_19790":113139,"_5":13558,"_26008":112774,"_2720":113140},[],"Cualquier otra razón",{"_3227":67001,"_28586":66847,"_19790":113142,"_5":13558,"_26008":112774,"_2720":50683},[],{"_3227":67002,"_28586":66847,"_19790":113144,"_5":13558,"_26008":112774,"_2720":113145},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3227":67003,"_28586":66847,"_19790":113147,"_5":13558,"_26008":112778,"_2720":113148},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3227":67004,"_28586":66847,"_19790":113150,"_5":13558,"_26008":112778,"_2720":113151},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3227":67005,"_28586":66847,"_19790":113153,"_5":13558,"_26008":112778,"_2720":113154},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3227":67006,"_28586":66847,"_19790":113156,"_5":13558,"_26008":112782,"_2720":113157},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3227":67007,"_28586":66847,"_19790":113159,"_5":13558,"_26008":112782,"_2720":113160},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3227":67008,"_28586":66847,"_19790":113162,"_5":13558,"_26008":112786,"_2720":113163},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3227":67009,"_28586":66847,"_19790":113165,"_5":13558,"_26008":112786,"_2720":113166},[],"Existen dos tipos de acciones:",{"_3227":67010,"_28586":66847,"_19790":113168,"_5":13558,"_26008":112786,"_2720":113169},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3227":67011,"_28586":66847,"_19790":113171,"_5":13558,"_26008":112786,"_2720":113172},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3227":67012,"_28586":66847,"_19790":113174,"_5":13558,"_26008":112786,"_2720":113175},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3227":67013,"_28586":66847,"_19790":113177,"_5":13558,"_26008":112790,"_2720":113178},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3227":67014,"_28586":66847,"_19790":113180,"_5":13558,"_26008":112790,"_2720":113181},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3227":67015,"_28586":66847,"_19790":113183,"_5":13558,"_26008":112790,"_2720":113184},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3227":67016,"_28586":66847,"_19790":113186,"_5":13558,"_26008":112794,"_2720":113187},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3227":67017,"_28586":66847,"_19790":113189,"_5":13558,"_26008":112794,"_2720":113190},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3227":67018,"_28586":66847,"_19790":113192,"_5":13558,"_26008":112794,"_2720":113193},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3227":67019,"_28586":66847,"_19790":113195,"_5":13558,"_26008":112794,"_2720":113196},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3227":67020,"_28586":66847,"_19790":113198,"_5":13558,"_26008":112794,"_2720":113199},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3227":67021,"_28586":66847,"_19790":113201,"_5":13558,"_26008":112794,"_2720":113202},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3227":67022,"_28586":66847,"_19790":113204,"_5":13558,"_26008":112794,"_2720":113205},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3227":67023,"_28586":66847,"_19790":113207,"_5":13558,"_26008":112794,"_2720":113208},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3227":67024,"_28586":66847,"_19790":113210,"_5":13558,"_26008":112794,"_2720":113211},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3227":67025,"_28586":66847,"_19790":113213,"_5":13558,"_26008":112794,"_2720":113214},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3227":67026,"_28586":66847,"_19790":113216,"_5":13558,"_26008":112794,"_2720":113217},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3227":67027,"_28586":66847,"_19790":113219,"_5":13558,"_26008":112794,"_2720":113220},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3227":67028,"_28586":66847,"_19790":113222,"_5":13558,"_26008":112794,"_2720":113223},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3227":67029,"_28586":66847,"_19790":113225,"_5":13558,"_26008":112794,"_2720":113226},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3227":67030,"_28586":66847,"_19790":113228,"_5":13558,"_26008":112794,"_2720":113229},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3227":67031,"_28586":66847,"_19790":113231,"_5":13558,"_26008":112794,"_2720":113232},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3227":67032,"_28586":66847,"_19790":113234,"_5":13558,"_26008":112794,"_2720":113235},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3227":67033,"_28586":66847,"_19790":113237,"_5":13558,"_26008":112794,"_2720":113238},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3227":67034,"_28586":66847,"_19790":113240,"_5":13558,"_26008":112794,"_2720":113241},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3227":67035,"_28586":66847,"_19790":113243,"_5":13558,"_26008":112794,"_2720":113244},[],"**Causa:** La edición dispara un nuevo intento de crear la plantilla JITP, que ya existe en AWS. El intento falla y se omiten los pasos posteriores del conector.",{"_3227":67036,"_28586":66847,"_19790":113246,"_5":13558,"_26008":112794,"_2720":113247},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3227":67037,"_28586":66847,"_19790":113249,"_5":13558,"_26008":112794,"_2720":113250},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":67038,"_28586":66847,"_19790":113252,"_5":13558,"_26008":112794,"_2720":113253},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3227":67039,"_28586":66847,"_19790":113255,"_5":13558,"_26008":112794,"_2720":113256},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3227":67040,"_28586":67040,"_5":13916,"_2720":48757,"_28908":113258,"_19790":113259,"_26008":67040},[46300,110300,48757],[],{"_3227":67041,"_28586":67040,"_19790":113261,"_5":13558,"_26008":67040,"_2720":113262},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3227":67042,"_28586":67040,"_5":28905,"_19790":113264,"_26008":113265,"_2720":113266},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3227":67043,"_28586":67040,"_5":28905,"_19790":113268,"_26008":113269,"_2720":111306},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3227":67044,"_28586":67040,"_5":28905,"_19790":113271,"_26008":113272,"_2720":111481},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3227":67045,"_28586":67040,"_5":28905,"_19790":113274,"_26008":113275,"_2720":112713},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3227":67046,"_28586":67040,"_5":28905,"_19790":113277,"_26008":113278,"_2720":113279},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3227":67047,"_28586":67040,"_19790":113281,"_5":13558,"_26008":67040,"_2720":113282},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3227":67048,"_28586":67040,"_19790":113284,"_5":13558,"_26008":113265,"_2720":113285},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3227":67049,"_28586":67040,"_19790":113287,"_5":13558,"_26008":113265,"_2720":113288},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3227":67050,"_28586":67040,"_19790":113290,"_5":13558,"_26008":113269,"_2720":113291},[],"Recurso",{"_3227":67051,"_28586":67040,"_19790":113293,"_5":13558,"_26008":113269,"_2720":113294},[],"Qué representa",{"_3227":67052,"_28586":67040,"_19790":113296,"_5":13558,"_26008":113269,"_2720":113297},[],"**Dispositivo**",{"_3227":67053,"_28586":67040,"_19790":113299,"_5":13558,"_26008":113269,"_2720":113300},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3227":67054,"_28586":67040,"_19790":113302,"_5":13558,"_26008":113269,"_2720":113303},[],"**Identidad**",{"_3227":67055,"_28586":67040,"_19790":113305,"_5":13558,"_26008":113269,"_2720":113306},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3227":67056,"_28586":67040,"_19790":113308,"_5":13558,"_26008":113269,"_2720":50850},[],{"_3227":67057,"_28586":67040,"_19790":113310,"_5":13558,"_26008":113269,"_2720":113311},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3227":67058,"_28586":67040,"_19790":113313,"_5":13558,"_26008":113269,"_2720":113314},[],"**Flota**",{"_3227":67059,"_28586":67040,"_19790":113316,"_5":13558,"_26008":113269,"_2720":113317},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3227":67060,"_28586":67040,"_19790":113319,"_5":13558,"_26008":113269,"_2720":113320},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3227":67061,"_28586":67040,"_19790":113322,"_5":13558,"_26008":113269,"_2720":113323},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3227":67062,"_28586":67040,"_19790":113325,"_5":13558,"_26008":113272,"_2720":113326},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3227":67063,"_28586":67040,"_19790":113328,"_5":13558,"_26008":113272,"_2720":113329},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3227":67064,"_28586":67040,"_19790":113331,"_5":13558,"_26008":113272,"_2720":113332},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3227":67065,"_28586":67040,"_19790":113334,"_5":13558,"_26008":113272,"_2720":113335},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3227":67066,"_28586":67040,"_19790":113337,"_5":13558,"_26008":113272,"_2720":113338},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3227":67067,"_28586":67040,"_19790":113340,"_5":13558,"_26008":113272,"_2720":113341},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3227":67068,"_28586":67040,"_19790":113343,"_5":13558,"_26008":113272,"_2720":113344},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":67069,"_28586":67040,"_19790":113346,"_5":13558,"_26008":113272,"_2720":113347},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3227":67070,"_28586":67040,"_19790":113349,"_5":13558,"_26008":113275,"_2720":113350},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3227":67071,"_28586":67040,"_19790":113352,"_5":13558,"_26008":113275,"_2720":113353},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3227":67072,"_28586":67040,"_19790":113355,"_5":13558,"_26008":113278,"_2720":113356},[],"Participante",{"_3227":67073,"_28586":67040,"_19790":113358,"_5":13558,"_26008":113278,"_2720":113359},[],"Responsabilidad",{"_3227":67074,"_28586":67040,"_19790":113361,"_5":13558,"_26008":113278,"_2720":113362},[],"Administrador PKI",{"_3227":67075,"_28586":67040,"_19790":113364,"_5":13558,"_26008":113278,"_2720":113365},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3227":67076,"_28586":67040,"_19790":113367,"_5":13558,"_26008":113278,"_2720":113368},[],"Administrador del aprovisionamiento",{"_3227":67077,"_28586":67040,"_19790":113370,"_5":13558,"_26008":113278,"_2720":113371},[],"DMS, admisión, autenticación por operación e inventario.",{"_3227":67078,"_28586":67040,"_19790":113373,"_5":13558,"_26008":113278,"_2720":113374},[],"Integrador del dispositivo",{"_3227":67079,"_28586":67040,"_19790":113376,"_5":13558,"_26008":113278,"_2720":113377},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3227":67080,"_28586":67040,"_19790":113379,"_5":13558,"_26008":113278,"_2720":113380},[],"Integrador del consumidor",{"_3227":67081,"_28586":67040,"_19790":113382,"_5":13558,"_26008":113278,"_2720":113383},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3227":67082,"_28586":67040,"_19790":113385,"_5":13558,"_26008":113278,"_2720":113386},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3227":67083,"_28586":67083,"_5":13916,"_2720":113388,"_28908":113389,"_19790":113391,"_26008":67083},"Enrola y conecta tu primer dispositivo",[46300,110300,48757,113390],"Primeros pasos",[],{"_3227":67084,"_28586":67083,"_19790":113393,"_5":13558,"_26008":67083,"_2720":113394},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3227":67085,"_28586":67083,"_5":28905,"_19790":113396,"_26008":113397,"_2720":108897},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3227":67086,"_28586":67083,"_5":28905,"_19790":113399,"_26008":113400,"_2720":113401},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3227":67087,"_28586":67083,"_5":28905,"_19790":113403,"_26008":113404,"_2720":113405},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3227":67088,"_28586":67083,"_5":28905,"_19790":113407,"_26008":113408,"_2720":113409},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3227":67089,"_28586":67083,"_5":28905,"_19790":113411,"_26008":113412,"_2720":113413},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3227":67090,"_28586":67083,"_5":28905,"_19790":113415,"_26008":113416,"_2720":113417},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3227":67091,"_28586":67083,"_5":28905,"_19790":113419,"_26008":113420,"_2720":113421},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3227":67092,"_28586":67083,"_5":28905,"_19790":113423,"_26008":113424,"_2720":113425},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3227":67093,"_28586":67083,"_19790":113427,"_5":13558,"_26008":67083,"_2720":113428},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3227":67094,"_28586":67083,"_19790":113430,"_5":13558,"_26008":113397,"_2720":113431},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3227":67095,"_28586":67083,"_19790":113433,"_5":13558,"_26008":113397,"_2720":113434},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3227":67096,"_28586":67083,"_19790":113436,"_5":13558,"_26008":113397,"_2720":113437},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3227":67097,"_28586":67083,"_19790":113439,"_5":13558,"_26008":113397,"_2720":113440},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3227":67098,"_28586":67083,"_19790":113442,"_5":13558,"_26008":113397,"_2720":113443},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3227":67099,"_28586":67083,"_19790":113445,"_5":13558,"_26008":113400,"_2720":113446},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3227":67100,"_28586":67083,"_19790":113448,"_5":13558,"_26008":113400,"_2720":113449},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3227":67101,"_28586":67083,"_19790":113451,"_5":13558,"_26008":113404,"_2720":113452},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3227":67102,"_28586":67083,"_19790":113454,"_5":13558,"_26008":113404,"_2720":113455},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3227":67103,"_28586":67083,"_19790":113457,"_5":13558,"_26008":113404,"_2720":113458},[],"Ajuste",{"_3227":67104,"_28586":67083,"_19790":113460,"_5":13558,"_26008":113404,"_2720":113461},[],"Valor de evaluación",{"_3227":67105,"_28586":67083,"_19790":113463,"_5":13558,"_26008":113404,"_2720":51006},[],{"_3227":67106,"_28586":67083,"_19790":113465,"_5":13558,"_26008":113404,"_2720":113466},[],"Raíz emisora de `device-root.pem`.",{"_3227":67107,"_28586":67083,"_19790":113468,"_5":13558,"_26008":113404,"_2720":111609},[],{"_3227":67108,"_28586":67083,"_19790":113470,"_5":13558,"_26008":113404,"_2720":113471},[],"Perfil final de 1 hora que acabas de preparar.",{"_3227":67109,"_28586":67083,"_19790":113473,"_5":13558,"_26008":113404,"_2720":51017},[],{"_3227":67110,"_28586":67083,"_19790":113475,"_5":13558,"_26008":113404,"_2720":51020},[],{"_3227":67111,"_28586":67083,"_19790":113477,"_5":13558,"_26008":113404,"_2720":51023},[],{"_3227":67112,"_28586":67083,"_19790":113479,"_5":13558,"_26008":113404,"_2720":113480},[],"Habilitado.",{"_3227":67113,"_28586":67083,"_19790":113482,"_5":13558,"_26008":113404,"_2720":51029},[],{"_3227":67114,"_28586":67083,"_19790":113484,"_5":13558,"_26008":113404,"_2720":113485},[],"Deshabilitado; el ID debe ser nuevo.",{"_3227":67115,"_28586":67083,"_19790":113487,"_5":13558,"_26008":113404,"_2720":113488},[],"Autenticación inicial",{"_3227":67116,"_28586":67083,"_19790":113490,"_5":13558,"_26008":113404,"_2720":113491},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3227":67117,"_28586":67083,"_19790":113493,"_5":13558,"_26008":113404,"_2720":113494},[],"Autenticación de renovación",{"_3227":67118,"_28586":67083,"_19790":113496,"_5":13558,"_26008":113404,"_2720":113497},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3227":67119,"_28586":67083,"_19790":113499,"_5":13558,"_26008":113404,"_2720":51047},[],{"_3227":67120,"_28586":67083,"_19790":113501,"_5":13558,"_26008":113404,"_2720":113502},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3227":67121,"_28586":67083,"_19790":113504,"_5":13558,"_26008":113404,"_2720":51053},[],{"_3227":67122,"_28586":67083,"_19790":113506,"_5":13558,"_26008":113404,"_2720":113507},[],"1 hora.",{"_3227":67123,"_28586":67083,"_19790":113509,"_5":13558,"_26008":113404,"_2720":51059},[],{"_3227":67124,"_28586":67083,"_19790":113511,"_5":13558,"_26008":113404,"_2720":113512},[],"30 minutos / 10 minutos.",{"_3227":67125,"_28586":67083,"_19790":113514,"_5":13558,"_26008":113404,"_2720":51065},[],{"_3227":67126,"_28586":67083,"_19790":113516,"_5":13558,"_26008":113404,"_2720":113517},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3227":67127,"_28586":67083,"_19790":113519,"_5":13558,"_26008":113404,"_2720":49076},[],{"_3227":67128,"_28586":67083,"_19790":113521,"_5":13558,"_26008":113404,"_2720":113522},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3227":67129,"_28586":67083,"_19790":113524,"_5":13558,"_26008":113404,"_2720":51076},[],{"_3227":67130,"_28586":67083,"_19790":113526,"_5":13558,"_26008":113404,"_2720":113527},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3227":67131,"_28586":67083,"_19790":113529,"_5":13558,"_26008":113404,"_2720":113530},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3227":67132,"_28586":67083,"_19790":113532,"_5":13558,"_26008":113408,"_2720":113533},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3227":67133,"_28586":67083,"_19790":113535,"_5":13558,"_26008":113408,"_2720":113536},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3227":67134,"_28586":67083,"_19790":113538,"_5":13558,"_26008":113412,"_2720":113539},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3227":67135,"_28586":67083,"_19790":113541,"_5":13558,"_26008":113412,"_2720":113542},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3227":67136,"_28586":67083,"_19790":113544,"_5":13558,"_26008":113412,"_2720":113545},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3227":67137,"_28586":67083,"_19790":113547,"_5":13558,"_26008":113416,"_2720":113548},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3227":67138,"_28586":67083,"_19790":113550,"_5":13558,"_26008":113416,"_2720":113551},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3227":67139,"_28586":67083,"_19790":113553,"_5":13558,"_26008":113420,"_2720":113554},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3227":67140,"_28586":67083,"_19790":113556,"_5":13558,"_26008":113420,"_2720":113557},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3227":67141,"_28586":67083,"_19790":113559,"_5":13558,"_26008":113420,"_2720":113560},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3227":67142,"_28586":67083,"_19790":113562,"_5":13558,"_26008":113420,"_2720":113563},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3227":67143,"_28586":67083,"_19790":113565,"_5":13558,"_26008":113420,"_2720":113566},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3227":67144,"_28586":67083,"_19790":113568,"_5":13558,"_26008":113424,"_2720":113569},[],"Comprobación",{"_3227":67145,"_28586":67083,"_19790":113571,"_5":13558,"_26008":113424,"_2720":113572},[],"Resultado esperado",{"_3227":67146,"_28586":67083,"_19790":113574,"_5":13558,"_26008":113424,"_2720":113575},[],"Registro",{"_3227":67147,"_28586":67083,"_19790":113577,"_5":13558,"_26008":113424,"_2720":113578},[],"ID creado automáticamente y DMS correcto.",{"_3227":67148,"_28586":67083,"_19790":113580,"_5":13558,"_26008":113424,"_2720":113581},[],"Certificado",{"_3227":67149,"_28586":67083,"_19790":113583,"_5":13558,"_26008":113424,"_2720":113584},[],"CN, perfil, serie y clave verificados.",{"_3227":67150,"_28586":67083,"_19790":113586,"_5":13558,"_26008":113424,"_2720":113587},[],"Inventario",{"_3227":67151,"_28586":67083,"_19790":113589,"_5":13558,"_26008":113424,"_2720":113590},[],"Serie recibida visible como identidad actual y en el historial.",{"_3227":67152,"_28586":67083,"_19790":113592,"_5":13558,"_26008":113424,"_2720":113593},[],"Consumidor",{"_3227":67153,"_28586":67083,"_19790":113595,"_5":13558,"_26008":113424,"_2720":113596},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3227":67154,"_28586":67083,"_19790":113598,"_5":13558,"_26008":113424,"_2720":113599},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3227":67155,"_28586":67083,"_19790":113601,"_5":13558,"_26008":113424,"_2720":113602},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3227":67156,"_28586":67156,"_5":13916,"_2720":111323,"_28908":113604,"_19790":113605,"_26008":67156},[46300,110300,48757,113390],[],{"_3227":67157,"_28586":67156,"_19790":113607,"_5":13558,"_26008":67156,"_2720":113608},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3227":67158,"_28586":67156,"_5":28905,"_19790":113610,"_26008":113611,"_2720":108897},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3227":67159,"_28586":67156,"_5":28905,"_19790":113613,"_26008":113614,"_2720":113615},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3227":67160,"_28586":67156,"_5":28905,"_19790":113617,"_26008":113618,"_2720":113619},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3227":67161,"_28586":67156,"_5":28905,"_19790":113621,"_26008":113622,"_2720":113623},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3227":67162,"_28586":67156,"_5":28905,"_19790":113625,"_26008":113626,"_2720":113627},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3227":67163,"_28586":67156,"_5":28905,"_19790":113629,"_26008":113630,"_2720":113631},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3227":67164,"_28586":67156,"_5":28905,"_19790":113633,"_26008":113634,"_2720":113572},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3227":67165,"_28586":67156,"_5":28905,"_19790":113636,"_26008":113637,"_2720":113638},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3227":67166,"_28586":67156,"_5":28905,"_19790":113640,"_26008":113641,"_2720":113642},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3227":67167,"_28586":67156,"_19790":113644,"_5":13558,"_26008":67156,"_2720":113645},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3227":67168,"_28586":67156,"_19790":113647,"_5":13558,"_26008":67156,"_2720":113648},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3227":67169,"_28586":67156,"_19790":113650,"_5":13558,"_26008":113611,"_2720":113651},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3227":67170,"_28586":67156,"_19790":113653,"_5":13558,"_26008":113611,"_2720":113654},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3227":67171,"_28586":67156,"_19790":113656,"_5":13558,"_26008":113611,"_2720":113657},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3227":67172,"_28586":67156,"_19790":113659,"_5":13558,"_26008":113611,"_2720":113660},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3227":67173,"_28586":67156,"_19790":113662,"_5":13558,"_26008":113614,"_2720":113663},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3227":67174,"_28586":67156,"_19790":113665,"_5":13558,"_26008":113614,"_2720":113666},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3227":67175,"_28586":67156,"_19790":113668,"_5":13558,"_26008":113614,"_2720":113669},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3227":67176,"_28586":67156,"_19790":113671,"_5":13558,"_26008":113614,"_2720":113672},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3227":67177,"_28586":67156,"_19790":113674,"_5":13558,"_26008":113614,"_2720":113675},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3227":67178,"_28586":67156,"_19790":113677,"_5":13558,"_26008":113614,"_2720":113678},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3227":67179,"_28586":67156,"_19790":113680,"_5":13558,"_26008":113614,"_2720":113681},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3227":67180,"_28586":67156,"_19790":113683,"_5":13558,"_26008":113614,"_2720":113684},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3227":67181,"_28586":67156,"_19790":113686,"_5":13558,"_26008":113618,"_2720":113687},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3227":67182,"_28586":67156,"_19790":113689,"_5":13558,"_26008":113618,"_2720":51242},[],{"_3227":67183,"_28586":67156,"_19790":113691,"_5":13558,"_26008":113618,"_2720":113692},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3227":67184,"_28586":67156,"_19790":113694,"_5":13558,"_26008":113618,"_2720":113695},[],"**Icon** y **Tags**: clasificación opcional.",{"_3227":67185,"_28586":67156,"_19790":113697,"_5":13558,"_26008":113618,"_2720":113698},[],"Confirma el registro.",{"_3227":67186,"_28586":67156,"_19790":113700,"_5":13558,"_26008":113622,"_2720":113701},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3227":67187,"_28586":67156,"_19790":113703,"_5":13558,"_26008":113622,"_2720":113704},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3227":67188,"_28586":67156,"_19790":113706,"_5":13558,"_26008":113626,"_2720":113707},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3227":67189,"_28586":67156,"_19790":113709,"_5":13558,"_26008":113626,"_2720":113710},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3227":67190,"_28586":67156,"_19790":113712,"_5":13558,"_26008":113630,"_2720":113713},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3227":67191,"_28586":67156,"_19790":113715,"_5":13558,"_26008":113630,"_2720":113716},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3227":67192,"_28586":67156,"_19790":113718,"_5":13558,"_26008":113634,"_2720":113569},[],{"_3227":67193,"_28586":67156,"_19790":113720,"_5":13558,"_26008":113634,"_2720":113721},[],"Resultado",{"_3227":67194,"_28586":67156,"_19790":113723,"_5":13558,"_26008":113634,"_2720":113724},[],"Dispositivo",{"_3227":67195,"_28586":67156,"_19790":113726,"_5":13558,"_26008":113634,"_2720":113727},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3227":67196,"_28586":67156,"_19790":113729,"_5":13558,"_26008":113634,"_2720":113730},[],"Identidad actual",{"_3227":67197,"_28586":67156,"_19790":113732,"_5":13558,"_26008":113634,"_2720":113733},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3227":67198,"_28586":67156,"_19790":113735,"_5":13558,"_26008":113634,"_2720":113736},[],"Historial",{"_3227":67199,"_28586":67156,"_19790":113738,"_5":13558,"_26008":113634,"_2720":113739},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3227":67200,"_28586":67156,"_19790":113741,"_5":13558,"_26008":113634,"_2720":113742},[],"Clave y certificado",{"_3227":67201,"_28586":67156,"_19790":113744,"_5":13558,"_26008":113634,"_2720":113745},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3227":67202,"_28586":67156,"_19790":113747,"_5":13558,"_26008":113637,"_2720":113748},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3227":67203,"_28586":67156,"_19790":113750,"_5":13558,"_26008":113637,"_2720":113751},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3227":67204,"_28586":67156,"_19790":113753,"_5":13558,"_26008":113637,"_2720":113754},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3227":67205,"_28586":67156,"_19790":113756,"_5":13558,"_26008":113637,"_2720":113757},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3227":67206,"_28586":67156,"_19790":113759,"_5":13558,"_26008":113641,"_2720":113760},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3227":67207,"_28586":67156,"_19790":113762,"_5":13558,"_26008":113641,"_2720":113763},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3227":67208,"_28586":67156,"_19790":113765,"_5":13558,"_26008":113641,"_2720":113766},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3227":67209,"_28586":67209,"_5":13916,"_2720":113768,"_28908":113769,"_19790":113770,"_26008":67209},"Plataforma Lamassu IoT",[46300,110300],[],{"_3227":67210,"_28586":67209,"_19790":113772,"_5":13558,"_26008":67209,"_2720":113773},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3227":67211,"_28586":67209,"_5":28905,"_19790":113775,"_26008":113776,"_2720":113266},[],"/docs/es/platform/overview#empieza-aquí",{"_3227":67212,"_28586":67209,"_5":28905,"_19790":113778,"_26008":113779,"_2720":113780},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3227":67213,"_28586":67209,"_5":28905,"_19790":113782,"_26008":113783,"_2720":113784},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3227":67214,"_28586":67209,"_5":28905,"_19790":113786,"_26008":113787,"_2720":113788},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3227":67215,"_28586":67209,"_5":28905,"_19790":113790,"_26008":113791,"_2720":113792},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3227":67216,"_28586":67209,"_5":28905,"_19790":113794,"_26008":113795,"_2720":113796},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3227":67217,"_28586":67209,"_5":28905,"_19790":113798,"_26008":113799,"_2720":113800},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3227":67218,"_28586":67209,"_5":28905,"_19790":113802,"_26008":113803,"_2720":113804},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3227":67219,"_28586":67209,"_5":28905,"_19790":113806,"_26008":113807,"_2720":113808},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3227":67220,"_28586":67209,"_5":28905,"_19790":113810,"_26008":113811,"_2720":113812},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3227":67221,"_28586":67209,"_5":28905,"_19790":113814,"_26008":113815,"_2720":113816},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3227":67222,"_28586":67209,"_19790":113818,"_5":13558,"_26008":67209,"_2720":113819},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3227":67223,"_28586":67209,"_19790":113821,"_5":13558,"_26008":113776,"_2720":113822},[],"Elige el resultado que necesitas obtener:",{"_3227":67224,"_28586":67209,"_19790":113824,"_5":13558,"_26008":113776,"_2720":113825},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3227":67225,"_28586":67209,"_19790":113827,"_5":13558,"_26008":113776,"_2720":113828},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3227":67226,"_28586":67209,"_19790":113830,"_5":13558,"_26008":113776,"_2720":113831},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3227":67227,"_28586":67209,"_19790":113833,"_5":13558,"_26008":113779,"_2720":113834},[],"Bloque",{"_3227":67228,"_28586":67209,"_19790":113836,"_5":13558,"_26008":113779,"_2720":113837},[],"Qué gestionas",{"_3227":67229,"_28586":67209,"_19790":113839,"_5":13558,"_26008":113779,"_2720":113840},[],"Punto de entrada",{"_3227":67230,"_28586":67209,"_19790":113842,"_5":13558,"_26008":113779,"_2720":51396},[],{"_3227":67231,"_28586":67209,"_19790":113844,"_5":13558,"_26008":113779,"_2720":113845},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3227":67232,"_28586":67209,"_19790":113847,"_5":13558,"_26008":113779,"_2720":113848},[],"Visión general de PKI",{"_3227":67233,"_28586":67209,"_19790":113850,"_5":13558,"_26008":113779,"_2720":51405},[],{"_3227":67234,"_28586":67209,"_19790":113852,"_5":13558,"_26008":113779,"_2720":113853},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3227":67235,"_28586":67209,"_19790":113855,"_5":13558,"_26008":113779,"_2720":113856},[],"Visión general de IoT Fleets",{"_3227":67236,"_28586":67209,"_19790":113858,"_5":13558,"_26008":113779,"_2720":113859},[],"**Administración**",{"_3227":67237,"_28586":67209,"_19790":113861,"_5":13558,"_26008":113779,"_2720":113862},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3227":67238,"_28586":67209,"_19790":113864,"_5":13558,"_26008":113779,"_2720":110298},[],{"_3227":67239,"_28586":67209,"_19790":113866,"_5":13558,"_26008":113779,"_2720":113867},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3227":67240,"_28586":67209,"_19790":113869,"_5":13558,"_26008":113783,"_2720":113870},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3227":67241,"_28586":67209,"_19790":113872,"_5":13558,"_26008":113783,"_2720":113873},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3227":67242,"_28586":67209,"_19790":113875,"_5":13558,"_26008":113783,"_2720":113876},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3227":67243,"_28586":67209,"_19790":113878,"_5":13558,"_26008":113783,"_2720":113879},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3227":67244,"_28586":67209,"_19790":113881,"_5":13558,"_26008":113783,"_2720":113882},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3227":67245,"_28586":67209,"_19790":113884,"_5":13558,"_26008":113783,"_2720":113885},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3227":67246,"_28586":67209,"_19790":113887,"_5":13558,"_26008":113791,"_2720":113888},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3227":67247,"_28586":67209,"_19790":113890,"_5":13558,"_26008":113795,"_2720":113891},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3227":67248,"_28586":67209,"_19790":113893,"_5":13558,"_26008":113799,"_2720":113894},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3227":67249,"_28586":67209,"_19790":113896,"_5":13558,"_26008":113803,"_2720":113897},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3227":67250,"_28586":67209,"_19790":113899,"_5":13558,"_26008":113807,"_2720":113900},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3227":67251,"_28586":67209,"_19790":113902,"_5":13558,"_26008":113811,"_2720":113903},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3227":67252,"_28586":67209,"_19790":113905,"_5":13558,"_26008":113815,"_2720":113359},[],{"_3227":67253,"_28586":67209,"_19790":113907,"_5":13558,"_26008":113815,"_2720":113908},[],"Qué prepara o comprueba",{"_3227":67254,"_28586":67209,"_19790":113910,"_5":13558,"_26008":113815,"_2720":113362},[],{"_3227":67255,"_28586":67209,"_19790":113912,"_5":13558,"_26008":113815,"_2720":113913},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3227":67256,"_28586":67209,"_19790":113915,"_5":13558,"_26008":113815,"_2720":113916},[],"Administrador de la flota",{"_3227":67257,"_28586":67209,"_19790":113918,"_5":13558,"_26008":113815,"_2720":113919},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3227":67258,"_28586":67209,"_19790":113921,"_5":13558,"_26008":113815,"_2720":113374},[],{"_3227":67259,"_28586":67209,"_19790":113923,"_5":13558,"_26008":113815,"_2720":113924},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3227":67260,"_28586":67209,"_19790":113926,"_5":13558,"_26008":113815,"_2720":113380},[],{"_3227":67261,"_28586":67209,"_19790":113928,"_5":13558,"_26008":113815,"_2720":113929},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3227":67262,"_28586":67209,"_19790":113931,"_5":13558,"_26008":113815,"_2720":113932},[],"Operador de infraestructura",{"_3227":67263,"_28586":67209,"_19790":113934,"_5":13558,"_26008":113815,"_2720":113935},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3227":67264,"_28586":67209,"_19790":113937,"_5":13558,"_26008":113815,"_2720":113938},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3227":67265,"_28586":67265,"_5":13916,"_2720":113940,"_28908":113941,"_19790":113943,"_26008":67265},"Jerarquía y rotación de CAs",[46300,110300,51497,113942],"Claves, autoridades y certificados",[],{"_3227":67266,"_28586":67265,"_19790":113945,"_5":13558,"_26008":67265,"_2720":113946},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3227":67267,"_28586":67265,"_5":28905,"_19790":113948,"_26008":113949,"_2720":113950},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3227":67268,"_28586":67265,"_5":28905,"_19790":113952,"_26008":113953,"_2720":113954},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3227":67269,"_28586":67265,"_5":28905,"_19790":113956,"_26008":113957,"_2720":113958},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3227":67270,"_28586":67265,"_5":28905,"_19790":113960,"_26008":113961,"_2720":113962},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3227":67271,"_28586":67265,"_5":28905,"_19790":113964,"_26008":113965,"_2720":113966},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3227":67272,"_28586":67265,"_5":28905,"_19790":113968,"_26008":113969,"_2720":113970},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3227":67273,"_28586":67265,"_5":28905,"_19790":113972,"_26008":113973,"_2720":113974},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3227":67274,"_28586":67265,"_5":28905,"_19790":113976,"_26008":113977,"_2720":113978},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3227":67275,"_28586":67265,"_5":28905,"_19790":113980,"_26008":113981,"_2720":113982},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3227":67276,"_28586":67265,"_5":28905,"_19790":113984,"_26008":113985,"_2720":113986},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3227":67277,"_28586":67265,"_5":28905,"_19790":113988,"_26008":113989,"_2720":113990},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3227":67278,"_28586":67265,"_5":28905,"_19790":113992,"_26008":113993,"_2720":113994},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3227":67279,"_28586":67265,"_19790":113996,"_5":13558,"_26008":67265,"_2720":113997},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3227":67280,"_28586":67265,"_19790":113999,"_5":13558,"_26008":67265,"_2720":114000},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3227":67281,"_28586":67265,"_19790":114002,"_5":13558,"_26008":113949,"_2720":114003},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3227":67282,"_28586":67265,"_19790":114005,"_5":13558,"_26008":113949,"_2720":114006},[],"entorno, como producción y preproducción;",{"_3227":67283,"_28586":67265,"_19790":114008,"_5":13558,"_26008":113949,"_2720":114009},[],"propietario o equipo operador;",{"_3227":67284,"_28586":67265,"_19790":114011,"_5":13558,"_26008":113949,"_2720":114012},[],"familia de dispositivos o proceso de fabricación;",{"_3227":67285,"_28586":67265,"_19790":114014,"_5":13558,"_26008":113949,"_2720":114015},[],"región o requisito regulatorio;",{"_3227":67286,"_28586":67265,"_19790":114017,"_5":13558,"_26008":113949,"_2720":114018},[],"motor criptográfico o política de clave;",{"_3227":67287,"_28586":67265,"_19790":114020,"_5":13558,"_26008":113949,"_2720":114021},[],"ventana de mantenimiento y ritmo de renovación.",{"_3227":67288,"_28586":67265,"_19790":114023,"_5":13558,"_26008":113949,"_2720":114024},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3227":67289,"_28586":67265,"_19790":114026,"_5":13558,"_26008":113949,"_2720":114027},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3227":67290,"_28586":67265,"_19790":114029,"_5":13558,"_26008":113953,"_2720":114030},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3227":67291,"_28586":67265,"_19790":114032,"_5":13558,"_26008":113953,"_2720":114033},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3227":67292,"_28586":67265,"_19790":114035,"_5":13558,"_26008":113953,"_2720":114036},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3227":67293,"_28586":67265,"_19790":114038,"_5":13558,"_26008":113957,"_2720":114039},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3227":67294,"_28586":67265,"_19790":114041,"_5":13558,"_26008":113957,"_2720":114042},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3227":67295,"_28586":67265,"_19790":114044,"_5":13558,"_26008":113957,"_2720":114045},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3227":67296,"_28586":67265,"_19790":114047,"_5":13558,"_26008":113957,"_2720":114048},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3227":67297,"_28586":67265,"_19790":114050,"_5":13558,"_26008":113965,"_2720":114051},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3227":67298,"_28586":67265,"_19790":114053,"_5":13558,"_26008":113969,"_2720":114054},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3227":67299,"_28586":67265,"_19790":114056,"_5":13558,"_26008":113973,"_2720":114057},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3227":67300,"_28586":67265,"_19790":114059,"_5":13558,"_26008":113977,"_2720":114060},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3227":67301,"_28586":67265,"_19790":114062,"_5":13558,"_26008":113981,"_2720":114063},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3227":67302,"_28586":67265,"_19790":114065,"_5":13558,"_26008":113985,"_2720":114066},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3227":67303,"_28586":67265,"_19790":114068,"_5":13558,"_26008":113989,"_2720":114069},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3227":67304,"_28586":67265,"_19790":114071,"_5":13558,"_26008":113989,"_2720":114072},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3227":67305,"_28586":67265,"_19790":114074,"_5":13558,"_26008":113989,"_2720":114075},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3227":67306,"_28586":67265,"_19790":114077,"_5":13558,"_26008":113989,"_2720":114078},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3227":67307,"_28586":67265,"_19790":114080,"_5":13558,"_26008":113993,"_2720":114081},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3227":67308,"_28586":67265,"_19790":114083,"_5":13558,"_26008":113993,"_2720":114084},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3227":67309,"_28586":67265,"_19790":114086,"_5":13558,"_26008":113993,"_2720":114087},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3227":67310,"_28586":67265,"_19790":114089,"_5":13558,"_26008":113993,"_2720":114090},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3227":67311,"_28586":67265,"_19790":114092,"_5":13558,"_26008":113993,"_2720":114093},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3227":67312,"_28586":67265,"_19790":114095,"_5":13558,"_26008":113993,"_2720":114096},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3227":67313,"_28586":67265,"_19790":114098,"_5":13558,"_26008":113993,"_2720":114099},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3227":67314,"_28586":67314,"_5":13916,"_2720":114101,"_28908":114102,"_19790":114103,"_26008":67314},"Autoridades de certificación",[46300,110300,51497,113942],[],{"_3227":67315,"_28586":67314,"_19790":114105,"_5":13558,"_26008":67314,"_2720":114106},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3227":67316,"_28586":67314,"_5":28905,"_19790":114108,"_26008":114109,"_2720":114110},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3227":67317,"_28586":67314,"_5":28905,"_19790":114112,"_26008":114113,"_2720":114114},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3227":67318,"_28586":67314,"_5":28905,"_19790":114116,"_26008":114117,"_2720":108897},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3227":67319,"_28586":67314,"_5":28905,"_19790":114119,"_26008":114120,"_2720":114121},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3227":67320,"_28586":67314,"_5":28905,"_19790":114123,"_26008":114124,"_2720":114125},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3227":67321,"_28586":67314,"_5":28905,"_19790":114127,"_26008":114128,"_2720":114129},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3227":67322,"_28586":67314,"_5":28905,"_19790":114131,"_26008":114132,"_2720":114133},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3227":67323,"_28586":67314,"_5":28905,"_19790":114135,"_26008":114136,"_2720":114137},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3227":67324,"_28586":67314,"_5":28905,"_19790":114139,"_26008":114140,"_2720":114141},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3227":67325,"_28586":67314,"_5":28905,"_19790":114143,"_26008":114144,"_2720":114145},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3227":67326,"_28586":67314,"_5":28905,"_19790":114147,"_26008":114148,"_2720":114149},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3227":67327,"_28586":67314,"_5":28905,"_19790":114151,"_26008":114152,"_2720":114153},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3227":67328,"_28586":67314,"_5":28905,"_19790":114155,"_26008":114156,"_2720":114157},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3227":67329,"_28586":67314,"_5":28905,"_19790":114159,"_26008":114160,"_2720":114161},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3227":67330,"_28586":67314,"_5":28905,"_19790":114163,"_26008":114164,"_2720":114165},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3227":67331,"_28586":67314,"_5":28905,"_19790":114167,"_26008":114168,"_2720":114169},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3227":67332,"_28586":67314,"_5":28905,"_19790":114171,"_26008":114172,"_2720":114173},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3227":67333,"_28586":67314,"_5":28905,"_19790":114175,"_26008":114176,"_2720":114177},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3227":67334,"_28586":67314,"_5":28905,"_19790":114179,"_26008":114180,"_2720":114181},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3227":67335,"_28586":67314,"_5":28905,"_19790":114183,"_26008":114184,"_2720":114185},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3227":67336,"_28586":67314,"_5":28905,"_19790":114187,"_26008":114188,"_2720":114189},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3227":67337,"_28586":67314,"_5":28905,"_19790":114191,"_26008":114192,"_2720":114193},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3227":67338,"_28586":67314,"_5":28905,"_19790":114195,"_26008":114196,"_2720":114197},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3227":67339,"_28586":67314,"_19790":114199,"_5":13558,"_26008":67314,"_2720":114200},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3227":67340,"_28586":67314,"_19790":114202,"_5":13558,"_26008":67314,"_2720":114203},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3227":67341,"_28586":67314,"_19790":114205,"_5":13558,"_26008":67314,"_2720":114206},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3227":67342,"_28586":67314,"_19790":114208,"_5":13558,"_26008":114109,"_2720":114209},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3227":67343,"_28586":67314,"_19790":114211,"_5":13558,"_26008":114109,"_2720":114212},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3227":67344,"_28586":67314,"_19790":114214,"_5":13558,"_26008":114109,"_2720":114215},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3227":67345,"_28586":67314,"_19790":114217,"_5":13558,"_26008":114109,"_2720":114218},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3227":67346,"_28586":67314,"_19790":114220,"_5":13558,"_26008":114109,"_2720":114221},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3227":67347,"_28586":67314,"_19790":114223,"_5":13558,"_26008":114117,"_2720":114224},[],"Decide si la CA será raíz o intermedia.",{"_3227":67348,"_28586":67314,"_19790":114226,"_5":13558,"_26008":114117,"_2720":114227},[],"Elige el motor que custodiará la clave.",{"_3227":67349,"_28586":67314,"_19790":114229,"_5":13558,"_26008":114117,"_2720":114230},[],"Define una validez superior a la de los certificados que emitirá.",{"_3227":67350,"_28586":67314,"_19790":114232,"_5":13558,"_26008":114117,"_2720":114233},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3227":67351,"_28586":67314,"_19790":114235,"_5":13558,"_26008":114120,"_2720":114236},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3227":67352,"_28586":67314,"_19790":114238,"_5":13558,"_26008":114124,"_2720":114239},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3227":67353,"_28586":67314,"_19790":114241,"_5":13558,"_26008":114124,"_2720":114242},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3227":67354,"_28586":67314,"_19790":114244,"_5":13558,"_26008":114128,"_2720":114245},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3227":67355,"_28586":67314,"_19790":114247,"_5":13558,"_26008":114132,"_2720":114248},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3227":67356,"_28586":67314,"_19790":114250,"_5":13558,"_26008":114132,"_2720":114251},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3227":67357,"_28586":67314,"_19790":114253,"_5":13558,"_26008":114132,"_2720":114254},[],"`ST`: estado o provincia.",{"_3227":67358,"_28586":67314,"_19790":114256,"_5":13558,"_26008":114132,"_2720":114257},[],"`L`: localidad.",{"_3227":67359,"_28586":67314,"_19790":114259,"_5":13558,"_26008":114132,"_2720":114260},[],"`O`: organización.",{"_3227":67360,"_28586":67314,"_19790":114262,"_5":13558,"_26008":114132,"_2720":114263},[],"`OU`: unidad organizativa.",{"_3227":67361,"_28586":67314,"_19790":114265,"_5":13558,"_26008":114132,"_2720":114266},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3227":67362,"_28586":67314,"_19790":114268,"_5":13558,"_26008":114136,"_2720":114269},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3227":67363,"_28586":67314,"_19790":114271,"_5":13558,"_26008":114136,"_2720":114272},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3227":67364,"_28586":67314,"_19790":114274,"_5":13558,"_26008":114140,"_2720":114275},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3227":67365,"_28586":67314,"_19790":114277,"_5":13558,"_26008":114140,"_2720":114278},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3227":67366,"_28586":67314,"_19790":114280,"_5":13558,"_26008":114144,"_2720":114281},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3227":67367,"_28586":67314,"_19790":114283,"_5":13558,"_26008":114144,"_2720":114284},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3227":67368,"_28586":67314,"_19790":114286,"_5":13558,"_26008":114148,"_2720":114287},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3227":67369,"_28586":67314,"_19790":114289,"_5":13558,"_26008":114152,"_2720":114290},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3227":67370,"_28586":67314,"_19790":114292,"_5":13558,"_26008":114156,"_2720":114293},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3227":67371,"_28586":67314,"_19790":114295,"_5":13558,"_26008":114160,"_2720":114296},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3227":67372,"_28586":67314,"_19790":114298,"_5":13558,"_26008":114164,"_2720":114299},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3227":67373,"_28586":67314,"_19790":114301,"_5":13558,"_26008":114164,"_2720":114302},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3227":67374,"_28586":67314,"_19790":114304,"_5":13558,"_26008":114168,"_2720":114305},[],"Abre una CA desde el inventario para consultar:",{"_3227":67375,"_28586":67314,"_19790":114307,"_5":13558,"_26008":114168,"_2720":114308},[],"Estado y periodo de validez.",{"_3227":67376,"_28586":67314,"_19790":114310,"_5":13558,"_26008":114168,"_2720":114311},[],"Certificado y cadena en formato PEM.",{"_3227":67377,"_28586":67314,"_19790":114313,"_5":13558,"_26008":114168,"_2720":114314},[],"Número de certificados activos, expirados y revocados.",{"_3227":67378,"_28586":67314,"_19790":114316,"_5":13558,"_26008":114168,"_2720":114317},[],"Certificados emitidos en **Issued Certificates**.",{"_3227":67379,"_28586":67314,"_19790":114319,"_5":13558,"_26008":114168,"_2720":114320},[],"CRL vinculada a la autoridad.",{"_3227":67380,"_28586":67314,"_19790":114322,"_5":13558,"_26008":114168,"_2720":114323},[],"Metadatos y motor criptográfico asociado.",{"_3227":67381,"_28586":67314,"_19790":114325,"_5":13558,"_26008":114168,"_2720":114326},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3227":67382,"_28586":67314,"_19790":114328,"_5":13558,"_26008":114172,"_2720":114329},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3227":67383,"_28586":67314,"_19790":114331,"_5":13558,"_26008":114172,"_2720":114332},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3227":67384,"_28586":67314,"_19790":114334,"_5":13558,"_26008":114172,"_2720":114335},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3227":67385,"_28586":67314,"_19790":114337,"_5":13558,"_26008":114172,"_2720":114338},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3227":67386,"_28586":67314,"_19790":114340,"_5":13558,"_26008":114176,"_2720":114341},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3227":67387,"_28586":67314,"_19790":114343,"_5":13558,"_26008":114180,"_2720":114344},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3227":67388,"_28586":67314,"_19790":114346,"_5":13558,"_26008":114184,"_2720":114347},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3227":67389,"_28586":67314,"_19790":114349,"_5":13558,"_26008":114188,"_2720":114350},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3227":67390,"_28586":67314,"_19790":114352,"_5":13558,"_26008":114192,"_2720":114353},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3227":67391,"_28586":67314,"_19790":114355,"_5":13558,"_26008":114196,"_2720":114356},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3227":67392,"_28586":67314,"_19790":114358,"_5":13558,"_26008":114196,"_2720":114359},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3227":67393,"_28586":67314,"_19790":114361,"_5":13558,"_26008":114196,"_2720":114362},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3227":67394,"_28586":67394,"_5":13916,"_2720":114364,"_28908":114365,"_19790":114366,"_26008":67394},"Perfiles de certificado",[46300,110300,51497,113942],[],{"_3227":67395,"_28586":67394,"_19790":114368,"_5":13558,"_26008":67394,"_2720":114369},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3227":67396,"_28586":67394,"_5":28905,"_19790":114371,"_26008":114372,"_2720":114373},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3227":67397,"_28586":67394,"_5":28905,"_19790":114375,"_26008":114376,"_2720":114377},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3227":67398,"_28586":67394,"_5":28905,"_19790":114379,"_26008":114380,"_2720":114381},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3227":67399,"_28586":67394,"_5":28905,"_19790":114383,"_26008":114384,"_2720":114385},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3227":67400,"_28586":67394,"_5":28905,"_19790":114387,"_26008":114388,"_2720":114389},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3227":67401,"_28586":67394,"_5":28905,"_19790":114391,"_26008":114392,"_2720":114393},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3227":67402,"_28586":67394,"_5":28905,"_19790":114395,"_26008":114396,"_2720":114397},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3227":67403,"_28586":67394,"_5":28905,"_19790":114399,"_26008":114400,"_2720":114401},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3227":67404,"_28586":67394,"_5":28905,"_19790":114403,"_26008":114404,"_2720":114405},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3227":67405,"_28586":67394,"_5":28905,"_19790":114407,"_26008":114408,"_2720":114409},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3227":67406,"_28586":67394,"_5":28905,"_19790":114411,"_26008":114412,"_2720":114413},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3227":67407,"_28586":67394,"_5":28905,"_19790":114415,"_26008":114416,"_2720":114417},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3227":67408,"_28586":67394,"_5":28905,"_19790":114419,"_26008":114420,"_2720":114421},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3227":67409,"_28586":67394,"_5":28905,"_19790":114423,"_26008":114424,"_2720":114425},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3227":67410,"_28586":67394,"_5":28905,"_19790":114427,"_26008":114428,"_2720":114429},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3227":67411,"_28586":67394,"_5":28905,"_19790":114431,"_26008":114432,"_2720":114433},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3227":67412,"_28586":67394,"_19790":114435,"_5":13558,"_26008":67394,"_2720":114436},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3227":67413,"_28586":67394,"_19790":114438,"_5":13558,"_26008":67394,"_2720":114439},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3227":67414,"_28586":67394,"_19790":114441,"_5":13558,"_26008":114376,"_2720":114442},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3227":67415,"_28586":67394,"_19790":114444,"_5":13558,"_26008":114376,"_2720":114445},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3227":67416,"_28586":67394,"_19790":114447,"_5":13558,"_26008":114380,"_2720":114448},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3227":67417,"_28586":67394,"_19790":114450,"_5":13558,"_26008":114384,"_2720":114451},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3227":67418,"_28586":67394,"_19790":114453,"_5":13558,"_26008":114384,"_2720":114454},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3227":67419,"_28586":67394,"_19790":114456,"_5":13558,"_26008":114384,"_2720":114457},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3227":67420,"_28586":67394,"_19790":114459,"_5":13558,"_26008":114388,"_2720":114460},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3227":67421,"_28586":67394,"_19790":114462,"_5":13558,"_26008":114392,"_2720":114463},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3227":67422,"_28586":67394,"_19790":114465,"_5":13558,"_26008":114392,"_2720":114466},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3227":67423,"_28586":67394,"_19790":114468,"_5":13558,"_26008":114396,"_2720":114469},[],"La aplicación criptográfica puede:",{"_3227":67424,"_28586":67394,"_19790":114471,"_5":13558,"_26008":114396,"_2720":114472},[],"permitir o bloquear claves RSA;",{"_3227":67425,"_28586":67394,"_19790":114474,"_5":13558,"_26008":114396,"_2720":114475},[],"limitar los tamaños RSA admitidos;",{"_3227":67426,"_28586":67394,"_19790":114477,"_5":13558,"_26008":114396,"_2720":114478},[],"permitir o bloquear claves ECDSA;",{"_3227":67427,"_28586":67394,"_19790":114480,"_5":13558,"_26008":114396,"_2720":114481},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3227":67428,"_28586":67394,"_19790":114483,"_5":13558,"_26008":114396,"_2720":114484},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3227":67429,"_28586":67394,"_19790":114486,"_5":13558,"_26008":114400,"_2720":114487},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3227":67430,"_28586":67394,"_19790":114489,"_5":13558,"_26008":114400,"_2720":110060},[],{"_3227":67431,"_28586":67394,"_19790":114491,"_5":13558,"_26008":114400,"_2720":114492},[],"Primera opción",{"_3227":67432,"_28586":67394,"_19790":114494,"_5":13558,"_26008":114400,"_2720":114495},[],"Segunda opción",{"_3227":67433,"_28586":67394,"_19790":114497,"_5":13558,"_26008":114400,"_2720":114498},[],"Si no hay ninguna",{"_3227":67434,"_28586":67394,"_19790":114500,"_5":13558,"_26008":114400,"_2720":114501},[],"Firma directa con una CA",{"_3227":67435,"_28586":67394,"_19790":114503,"_5":13558,"_26008":114400,"_2720":114504},[],"`issuance_profile` incluido en la solicitud",{"_3227":67436,"_28586":67394,"_19790":114506,"_5":13558,"_26008":114400,"_2720":114507},[],"`issuance_profile_id` de la solicitud",{"_3227":67437,"_28586":67394,"_19790":114509,"_5":13558,"_26008":114400,"_2720":114510},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3227":67438,"_28586":67394,"_19790":114512,"_5":13558,"_26008":114400,"_2720":114513},[],"Emisión mediante DMS",{"_3227":67439,"_28586":67394,"_19790":114515,"_5":13558,"_26008":114400,"_2720":52072},[],{"_3227":67440,"_28586":67394,"_19790":114517,"_5":13558,"_26008":114400,"_2720":114518},[],"`settings.issuance_profile` incluido en el DMS",{"_3227":67441,"_28586":67394,"_19790":114520,"_5":13558,"_26008":114400,"_2720":114521},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3227":67442,"_28586":67394,"_19790":114523,"_5":13558,"_26008":114400,"_2720":114524},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3227":67443,"_28586":67394,"_19790":114526,"_5":13558,"_26008":114400,"_2720":114527},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3227":67444,"_28586":67394,"_19790":114529,"_5":13558,"_26008":114408,"_2720":114530},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3227":67445,"_28586":67394,"_19790":114532,"_5":13558,"_26008":114412,"_2720":114533},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3227":67446,"_28586":67394,"_19790":114535,"_5":13558,"_26008":114416,"_2720":114536},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3227":67447,"_28586":67394,"_19790":114538,"_5":13558,"_26008":114420,"_2720":114539},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3227":67448,"_28586":67394,"_19790":114541,"_5":13558,"_26008":114424,"_2720":114542},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3227":67449,"_28586":67394,"_19790":114544,"_5":13558,"_26008":114424,"_2720":114545},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3227":67450,"_28586":67394,"_19790":114547,"_5":13558,"_26008":114428,"_2720":114548},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3227":67451,"_28586":67394,"_19790":114550,"_5":13558,"_26008":114428,"_2720":114551},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3227":67452,"_28586":67394,"_19790":114553,"_5":13558,"_26008":114428,"_2720":114554},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3227":67453,"_28586":67394,"_19790":114556,"_5":13558,"_26008":114428,"_2720":114557},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3227":67454,"_28586":67394,"_19790":114559,"_5":13558,"_26008":114432,"_2720":114560},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3227":67455,"_28586":67394,"_19790":114562,"_5":13558,"_26008":114432,"_2720":114563},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3227":67456,"_28586":67456,"_5":13916,"_2720":114565,"_28908":114566,"_19790":114568,"_26008":67456},"Validación de certificados",[46300,110300,51497,114567],"Validación",[],{"_3227":67457,"_28586":67456,"_19790":114570,"_5":13558,"_26008":67456,"_2720":114571},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3227":67458,"_28586":67456,"_5":28905,"_19790":114573,"_26008":114574,"_2720":114575},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3227":67459,"_28586":67456,"_5":28905,"_19790":114577,"_26008":114578,"_2720":114579},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3227":67460,"_28586":67456,"_5":28905,"_19790":114581,"_26008":114582,"_2720":114583},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3227":67461,"_28586":67456,"_19790":114585,"_5":13558,"_26008":67456,"_2720":114586},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3227":67462,"_28586":67456,"_19790":114588,"_5":13558,"_26008":114574,"_2720":114589},[],"Verifica estos criterios juntos:",{"_3227":67463,"_28586":67456,"_19790":114591,"_5":13558,"_26008":114574,"_2720":113569},[],{"_3227":67464,"_28586":67456,"_19790":114593,"_5":13558,"_26008":114574,"_2720":114594},[],"Resultado necesario",{"_3227":67465,"_28586":67456,"_19790":114596,"_5":13558,"_26008":114574,"_2720":114597},[],"Cadena y firma",{"_3227":67466,"_28586":67456,"_19790":114599,"_5":13558,"_26008":114574,"_2720":114600},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3227":67467,"_28586":67456,"_19790":114602,"_5":13558,"_26008":114574,"_2720":114603},[],"Fechas",{"_3227":67468,"_28586":67456,"_19790":114605,"_5":13558,"_26008":114574,"_2720":114606},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3227":67469,"_28586":67456,"_19790":114608,"_5":13558,"_26008":114574,"_2720":109970},[],{"_3227":67470,"_28586":67456,"_19790":114610,"_5":13558,"_26008":114574,"_2720":114611},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3227":67471,"_28586":67456,"_19790":114613,"_5":13558,"_26008":114574,"_2720":114614},[],"Uso",{"_3227":67472,"_28586":67456,"_19790":114616,"_5":13558,"_26008":114574,"_2720":114617},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3227":67473,"_28586":67456,"_19790":114619,"_5":13558,"_26008":114574,"_2720":114620},[],"Revocación",{"_3227":67474,"_28586":67456,"_19790":114622,"_5":13558,"_26008":114574,"_2720":114623},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3227":67475,"_28586":67456,"_19790":114625,"_5":13558,"_26008":114574,"_2720":114626},[],"Autorización",{"_3227":67476,"_28586":67456,"_19790":114628,"_5":13558,"_26008":114574,"_2720":114629},[],"La aplicación permite la acción a esa identidad.",{"_3227":67477,"_28586":67456,"_19790":114631,"_5":13558,"_26008":114574,"_2720":114632},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3227":67478,"_28586":67456,"_19790":114634,"_5":13558,"_26008":114578,"_2720":114635},[],"Mecanismo",{"_3227":67479,"_28586":67456,"_19790":114637,"_5":13558,"_26008":114578,"_2720":114638},[],"Cuándo utilizarlo",{"_3227":67480,"_28586":67456,"_19790":114640,"_5":13558,"_26008":114578,"_2720":114641},[],"Qué debes mantener",{"_3227":67481,"_28586":67456,"_19790":114643,"_5":13558,"_26008":114578,"_2720":52200},[],{"_3227":67482,"_28586":67456,"_19790":114645,"_5":13558,"_26008":114578,"_2720":114646},[],"Consulta del estado de un certificado concreto.",{"_3227":67483,"_28586":67456,"_19790":114648,"_5":13558,"_26008":114578,"_2720":114649},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3227":67484,"_28586":67456,"_19790":114651,"_5":13558,"_26008":114578,"_2720":52209},[],{"_3227":67485,"_28586":67456,"_19790":114653,"_5":13558,"_26008":114578,"_2720":114654},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3227":67486,"_28586":67456,"_19790":114656,"_5":13558,"_26008":114578,"_2720":114657},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3227":67487,"_28586":67456,"_19790":114659,"_5":13558,"_26008":114578,"_2720":114660},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3227":67488,"_28586":67456,"_19790":114662,"_5":13558,"_26008":114578,"_2720":114663},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3227":67489,"_28586":67456,"_19790":114665,"_5":13558,"_26008":114582,"_2720":114666},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3227":67490,"_28586":67456,"_19790":114668,"_5":13558,"_26008":114582,"_2720":114669},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3227":67491,"_28586":67456,"_19790":114671,"_5":13558,"_26008":114582,"_2720":114672},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3227":67492,"_28586":67456,"_19790":114674,"_5":13558,"_26008":114582,"_2720":114675},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3227":67493,"_28586":67456,"_19790":114677,"_5":13558,"_26008":114582,"_2720":114678},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3227":67494,"_28586":67456,"_19790":114680,"_5":13558,"_26008":114582,"_2720":114681},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3227":67495,"_28586":67456,"_19790":114683,"_5":13558,"_26008":114582,"_2720":114684},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3227":67496,"_28586":67456,"_19790":114686,"_5":13558,"_26008":114582,"_2720":114687},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":67497,"_28586":67456,"_19790":114689,"_5":13558,"_26008":114582,"_2720":114690},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3227":67498,"_28586":67498,"_5":13916,"_2720":114692,"_28908":114693,"_19790":114694,"_26008":67498},"Certificados",[46300,110300,51497,113942],[],{"_3227":67499,"_28586":67498,"_19790":114696,"_5":13558,"_26008":67498,"_2720":114697},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3227":67500,"_28586":67498,"_5":28905,"_19790":114699,"_26008":114700,"_2720":114701},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3227":67501,"_28586":67498,"_5":28905,"_19790":114703,"_26008":114704,"_2720":114705},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3227":67502,"_28586":67498,"_5":28905,"_19790":114707,"_26008":114708,"_2720":114709},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3227":67503,"_28586":67498,"_5":28905,"_19790":114711,"_26008":114712,"_2720":114713},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3227":67504,"_28586":67498,"_5":28905,"_19790":114715,"_26008":114716,"_2720":114717},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3227":67505,"_28586":67498,"_5":28905,"_19790":114719,"_26008":114720,"_2720":114721},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3227":67506,"_28586":67498,"_5":28905,"_19790":114723,"_26008":114724,"_2720":114725},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3227":67507,"_28586":67498,"_5":28905,"_19790":114727,"_26008":114728,"_2720":114729},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3227":67508,"_28586":67498,"_5":28905,"_19790":114731,"_26008":114732,"_2720":114733},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3227":67509,"_28586":67498,"_19790":114735,"_5":13558,"_26008":67498,"_2720":114736},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3227":67510,"_28586":67498,"_19790":114738,"_5":13558,"_26008":114700,"_2720":114739},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3227":67511,"_28586":67498,"_19790":114741,"_5":13558,"_26008":114700,"_2720":114742},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3227":67512,"_28586":67498,"_19790":114744,"_5":13558,"_26008":114704,"_2720":114745},[],"Descarga el PEM e inspecciónalo:",{"_3227":67513,"_28586":67498,"_19790":114747,"_5":13558,"_26008":114704,"_2720":114748},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3227":67514,"_28586":67498,"_19790":114750,"_5":13558,"_26008":114708,"_2720":114751},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3227":67515,"_28586":67498,"_19790":114753,"_5":13558,"_26008":114708,"_2720":114754},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3227":67516,"_28586":67498,"_19790":114756,"_5":13558,"_26008":114708,"_2720":114757},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3227":67517,"_28586":67498,"_19790":114759,"_5":13558,"_26008":114708,"_2720":114760},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3227":67518,"_28586":67498,"_19790":114762,"_5":13558,"_26008":114708,"_2720":114763},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3227":67519,"_28586":67498,"_19790":114765,"_5":13558,"_26008":114708,"_2720":114766},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3227":67520,"_28586":67498,"_19790":114768,"_5":13558,"_26008":114708,"_2720":114769},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3227":67521,"_28586":67498,"_19790":114771,"_5":13558,"_26008":114712,"_2720":114772},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3227":67522,"_28586":67498,"_19790":114774,"_5":13558,"_26008":114716,"_2720":114775},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3227":67523,"_28586":67498,"_19790":114777,"_5":13558,"_26008":114720,"_2720":114778},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3227":67524,"_28586":67498,"_19790":114780,"_5":13558,"_26008":114724,"_2720":114781},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3227":67525,"_28586":67498,"_19790":114783,"_5":13558,"_26008":114724,"_2720":114784},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3227":67526,"_28586":67498,"_19790":114786,"_5":13558,"_26008":114724,"_2720":114787},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3227":67527,"_28586":67498,"_19790":114789,"_5":13558,"_26008":114728,"_2720":114790},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3227":67528,"_28586":67498,"_19790":114792,"_5":13558,"_26008":114728,"_2720":114793},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3227":67529,"_28586":67498,"_19790":114795,"_5":13558,"_26008":114728,"_2720":114796},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3227":67530,"_28586":67498,"_19790":114798,"_5":13558,"_26008":114732,"_2720":114799},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":67531,"_28586":67498,"_19790":114801,"_5":13558,"_26008":114732,"_2720":114802},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3227":67532,"_28586":67532,"_5":13916,"_2720":114804,"_28908":114805,"_19790":114807,"_26008":67532},"Ciclo de vida de un certificado",[46300,110300,51497,114806],"Conceptos",[],{"_3227":67533,"_28586":67532,"_19790":114809,"_5":13558,"_26008":67532,"_2720":114810},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3227":67534,"_28586":67532,"_5":28905,"_19790":114812,"_26008":114813,"_2720":114814},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3227":67535,"_28586":67532,"_5":28905,"_19790":114816,"_26008":114817,"_2720":114818},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3227":67536,"_28586":67532,"_5":28905,"_19790":114820,"_26008":114821,"_2720":114822},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3227":67537,"_28586":67532,"_5":28905,"_19790":114824,"_26008":114825,"_2720":114826},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3227":67538,"_28586":67532,"_5":28905,"_19790":114828,"_26008":114829,"_2720":114830},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3227":67539,"_28586":67532,"_5":28905,"_19790":114832,"_26008":114833,"_2720":114834},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3227":67540,"_28586":67532,"_5":28905,"_19790":114836,"_26008":114837,"_2720":114838},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3227":67541,"_28586":67532,"_5":28905,"_19790":114840,"_26008":114841,"_2720":114842},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3227":67542,"_28586":67532,"_5":28905,"_19790":114844,"_26008":114845,"_2720":114846},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3227":67543,"_28586":67532,"_5":28905,"_19790":114848,"_26008":114849,"_2720":114850},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3227":67544,"_28586":67532,"_19790":114852,"_5":13558,"_26008":67532,"_2720":114853},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3227":67545,"_28586":67532,"_19790":114855,"_5":13558,"_26008":114817,"_2720":114856},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3227":67546,"_28586":67532,"_19790":114858,"_5":13558,"_26008":114821,"_2720":114859},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3227":67547,"_28586":67532,"_19790":114861,"_5":13558,"_26008":114825,"_2720":114862},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3227":67548,"_28586":67532,"_19790":114864,"_5":13558,"_26008":114829,"_2720":114865},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3227":67549,"_28586":67532,"_19790":114867,"_5":13558,"_26008":114833,"_2720":114868},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3227":67550,"_28586":67532,"_19790":114870,"_5":13558,"_26008":114837,"_2720":114871},[],"Lamassu persiste cuatro estados X.509:",{"_3227":67551,"_28586":67532,"_19790":114873,"_5":13558,"_26008":114837,"_2720":114874},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3227":67552,"_28586":67532,"_19790":114876,"_5":13558,"_26008":114837,"_2720":114877},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3227":67553,"_28586":67532,"_19790":114879,"_5":13558,"_26008":114837,"_2720":114880},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3227":67554,"_28586":67532,"_19790":114882,"_5":13558,"_26008":114837,"_2720":114883},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3227":67555,"_28586":67532,"_19790":114885,"_5":13558,"_26008":114837,"_2720":114886},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3227":67556,"_28586":67532,"_19790":114888,"_5":13558,"_26008":114841,"_2720":114889},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3227":67557,"_28586":67532,"_19790":114891,"_5":13558,"_26008":114841,"_2720":114892},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3227":67558,"_28586":67532,"_19790":114894,"_5":13558,"_26008":114841,"_2720":114895},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3227":67559,"_28586":67532,"_19790":114897,"_5":13558,"_26008":114845,"_2720":114898},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3227":67560,"_28586":67532,"_19790":114900,"_5":13558,"_26008":114845,"_2720":114901},[],"Antes de confirmar:",{"_3227":67561,"_28586":67532,"_19790":114903,"_5":13558,"_26008":114845,"_2720":114904},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3227":67562,"_28586":67532,"_19790":114906,"_5":13558,"_26008":114845,"_2720":114907},[],"Distribuye la nueva cadena de confianza.",{"_3227":67563,"_28586":67532,"_19790":114909,"_5":13558,"_26008":114845,"_2720":114910},[],"Reemite las identidades necesarias.",{"_3227":67564,"_28586":67532,"_19790":114912,"_5":13558,"_26008":114845,"_2720":114913},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3227":67565,"_28586":67532,"_19790":114915,"_5":13558,"_26008":114845,"_2720":114916},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3227":67566,"_28586":67532,"_19790":114918,"_5":13558,"_26008":114845,"_2720":114919},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3227":67567,"_28586":67532,"_19790":114921,"_5":13558,"_26008":114849,"_2720":114922},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3227":67568,"_28586":67532,"_19790":114924,"_5":13558,"_26008":114849,"_2720":114925},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3227":67569,"_28586":67532,"_19790":114927,"_5":13558,"_26008":114849,"_2720":114928},[],"Cambios de estado y razones de revocación.",{"_3227":67570,"_28586":67532,"_19790":114930,"_5":13558,"_26008":114849,"_2720":114931},[],"Publicación y vigencia de OCSP y CRLs.",{"_3227":67571,"_28586":67532,"_19790":114933,"_5":13558,"_26008":114849,"_2720":114934},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3227":67572,"_28586":67532,"_19790":114936,"_5":13558,"_26008":114849,"_2720":114937},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3227":67573,"_28586":67573,"_5":13916,"_2720":114939,"_28908":114940,"_19790":114941,"_26008":67573},"Modelo de confianza",[46300,110300,51497,114806],[],{"_3227":67574,"_28586":67573,"_19790":114943,"_5":13558,"_26008":67573,"_2720":114944},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3227":67575,"_28586":67573,"_5":28905,"_19790":114946,"_26008":114947,"_2720":114948},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3227":67576,"_28586":67573,"_5":28905,"_19790":114950,"_26008":114951,"_2720":114952},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3227":67577,"_28586":67573,"_5":28905,"_19790":114954,"_26008":114955,"_2720":114956},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3227":67578,"_28586":67573,"_5":28905,"_19790":114958,"_26008":114959,"_2720":114960},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3227":67579,"_28586":67573,"_5":28905,"_19790":114962,"_26008":114963,"_2720":114964},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3227":67580,"_28586":67573,"_5":28905,"_19790":114966,"_26008":114967,"_2720":114968},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3227":67581,"_28586":67573,"_5":28905,"_19790":114970,"_26008":114971,"_2720":114972},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3227":67582,"_28586":67573,"_5":28905,"_19790":114974,"_26008":114975,"_2720":114976},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3227":67583,"_28586":67573,"_5":28905,"_19790":114978,"_26008":114979,"_2720":114980},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3227":67584,"_28586":67573,"_5":28905,"_19790":114982,"_26008":114983,"_2720":114984},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3227":67585,"_28586":67573,"_19790":114986,"_5":13558,"_26008":67573,"_2720":114987},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3227":67586,"_28586":67573,"_19790":114989,"_5":13558,"_26008":114951,"_2720":114990},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3227":67587,"_28586":67573,"_19790":114992,"_5":13558,"_26008":114955,"_2720":114993},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3227":67588,"_28586":67573,"_19790":114995,"_5":13558,"_26008":114959,"_2720":114996},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3227":67589,"_28586":67573,"_19790":114998,"_5":13558,"_26008":114963,"_2720":114999},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3227":67590,"_28586":67573,"_19790":115001,"_5":13558,"_26008":114967,"_2720":115002},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3227":67591,"_28586":67573,"_19790":115004,"_5":13558,"_26008":114967,"_2720":115005},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3227":67592,"_28586":67573,"_19790":115007,"_5":13558,"_26008":114967,"_2720":115008},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3227":67593,"_28586":67573,"_19790":115010,"_5":13558,"_26008":114967,"_2720":115011},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3227":67594,"_28586":67573,"_19790":115013,"_5":13558,"_26008":114967,"_2720":115014},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3227":67595,"_28586":67573,"_19790":115016,"_5":13558,"_26008":114967,"_2720":115017},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3227":67596,"_28586":67573,"_19790":115019,"_5":13558,"_26008":114971,"_2720":115020},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3227":67597,"_28586":67573,"_19790":115022,"_5":13558,"_26008":114971,"_2720":115023},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3227":67598,"_28586":67573,"_19790":115025,"_5":13558,"_26008":114971,"_2720":115026},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3227":67599,"_28586":67573,"_19790":115028,"_5":13558,"_26008":114971,"_2720":115029},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3227":67600,"_28586":67573,"_19790":115031,"_5":13558,"_26008":114971,"_2720":115032},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3227":67601,"_28586":67573,"_19790":115034,"_5":13558,"_26008":114975,"_2720":115035},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3227":67602,"_28586":67573,"_19790":115037,"_5":13558,"_26008":114975,"_2720":115038},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3227":67603,"_28586":67573,"_19790":115040,"_5":13558,"_26008":114975,"_2720":115041},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3227":67604,"_28586":67573,"_19790":115043,"_5":13558,"_26008":114975,"_2720":115044},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3227":67605,"_28586":67573,"_19790":115046,"_5":13558,"_26008":114975,"_2720":115047},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3227":67606,"_28586":67573,"_19790":115049,"_5":13558,"_26008":114975,"_2720":115050},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3227":67607,"_28586":67573,"_19790":115052,"_5":13558,"_26008":114975,"_2720":115053},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3227":67608,"_28586":67573,"_19790":115055,"_5":13558,"_26008":114979,"_2720":115056},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3227":67609,"_28586":67573,"_19790":115058,"_5":13558,"_26008":114983,"_2720":115059},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3227":67610,"_28586":67573,"_19790":115061,"_5":13558,"_26008":114983,"_2720":115062},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3227":67611,"_28586":67573,"_19790":115064,"_5":13558,"_26008":114983,"_2720":115065},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3227":67612,"_28586":67573,"_19790":115067,"_5":13558,"_26008":114983,"_2720":115068},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3227":67613,"_28586":67573,"_19790":115070,"_5":13558,"_26008":114983,"_2720":115071},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3227":67614,"_28586":67573,"_19790":115073,"_5":13558,"_26008":114983,"_2720":115074},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3227":67615,"_28586":67573,"_19790":115076,"_5":13558,"_26008":114983,"_2720":115077},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3227":67616,"_28586":67616,"_5":13916,"_2720":115079,"_28908":115080,"_19790":115081,"_26008":67616},"Listas de revocación (CRL)",[46300,110300,51497,114567],[],{"_3227":67617,"_28586":67616,"_19790":115083,"_5":13558,"_26008":67616,"_2720":115084},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3227":67618,"_28586":67616,"_5":28905,"_19790":115086,"_26008":115087,"_2720":115088},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3227":67619,"_28586":67616,"_5":28905,"_19790":115090,"_26008":115091,"_2720":115092},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3227":67620,"_28586":67616,"_5":28905,"_19790":115094,"_26008":115095,"_2720":115096},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3227":67621,"_28586":67616,"_5":28905,"_19790":115098,"_26008":115099,"_2720":115100},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3227":67622,"_28586":67616,"_5":28905,"_19790":115102,"_26008":115103,"_2720":115104},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3227":67623,"_28586":67616,"_5":28905,"_19790":115106,"_26008":115107,"_2720":115108},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3227":67624,"_28586":67616,"_5":28905,"_19790":115110,"_26008":115111,"_2720":115112},[],"/docs/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3227":67625,"_28586":67616,"_5":28905,"_19790":115114,"_26008":115115,"_2720":115116},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3227":67626,"_28586":67616,"_5":28905,"_19790":115118,"_26008":115119,"_2720":115120},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3227":67627,"_28586":67616,"_19790":115122,"_5":13558,"_26008":67616,"_2720":115123},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3227":67628,"_28586":67616,"_19790":115125,"_5":13558,"_26008":115087,"_2720":115126},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3227":67629,"_28586":67616,"_19790":115128,"_5":13558,"_26008":115087,"_2720":115129},[],"Campo de `crl_options`",{"_3227":67630,"_28586":67616,"_19790":115131,"_5":13558,"_26008":115087,"_2720":111835},[],{"_3227":67631,"_28586":67616,"_19790":115133,"_5":13558,"_26008":115087,"_2720":115134},[],"Valor inicial del backend",{"_3227":67632,"_28586":67616,"_19790":115136,"_5":13558,"_26008":115087,"_2720":52695},[],{"_3227":67633,"_28586":67616,"_19790":115138,"_5":13558,"_26008":115087,"_2720":115139},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3227":67634,"_28586":67616,"_19790":115141,"_5":13558,"_26008":115087,"_2720":115142},[],"7 días.",{"_3227":67635,"_28586":67616,"_19790":115144,"_5":13558,"_26008":115087,"_2720":52704},[],{"_3227":67636,"_28586":67616,"_19790":115146,"_5":13558,"_26008":115087,"_2720":115147},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3227":67637,"_28586":67616,"_19790":115149,"_5":13558,"_26008":115087,"_2720":115150},[],"6 días y 23 horas.",{"_3227":67638,"_28586":67616,"_19790":115152,"_5":13558,"_26008":115087,"_2720":52713},[],{"_3227":67639,"_28586":67616,"_19790":115154,"_5":13558,"_26008":115087,"_2720":115155},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3227":67640,"_28586":67616,"_19790":115157,"_5":13558,"_26008":115087,"_2720":52719},[],{"_3227":67641,"_28586":67616,"_19790":115159,"_5":13558,"_26008":115087,"_2720":52722},[],{"_3227":67642,"_28586":67616,"_19790":115161,"_5":13558,"_26008":115087,"_2720":115162},[],"Número de serie del certificado existente que firma la CRL.",{"_3227":67643,"_28586":67616,"_19790":115164,"_5":13558,"_26008":115087,"_2720":115165},[],"Número de serie del certificado actual de la CA.",{"_3227":67644,"_28586":67616,"_19790":115167,"_5":13558,"_26008":115087,"_2720":115168},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3227":67645,"_28586":67616,"_19790":115170,"_5":13558,"_26008":115087,"_2720":115171},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3227":67646,"_28586":67616,"_19790":115173,"_5":13558,"_26008":115087,"_2720":115174},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3227":67647,"_28586":67616,"_19790":115176,"_5":13558,"_26008":115087,"_2720":115177},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3227":67648,"_28586":67616,"_19790":115179,"_5":13558,"_26008":115087,"_2720":115180},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3227":67649,"_28586":67616,"_19790":115182,"_5":13558,"_26008":115087,"_2720":115183},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3227":67650,"_28586":67616,"_19790":115185,"_5":13558,"_26008":115091,"_2720":115186},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3227":67651,"_28586":67616,"_19790":115188,"_5":13558,"_26008":115091,"_2720":115189},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3227":67652,"_28586":67616,"_19790":115191,"_5":13558,"_26008":115091,"_2720":115192},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3227":67653,"_28586":67616,"_19790":115194,"_5":13558,"_26008":115091,"_2720":115195},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3227":67654,"_28586":67616,"_19790":115197,"_5":13558,"_26008":115095,"_2720":115198},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3227":67655,"_28586":67616,"_19790":115200,"_5":13558,"_26008":115095,"_2720":115201},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3227":67656,"_28586":67616,"_19790":115203,"_5":13558,"_26008":115095,"_2720":115204},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3227":67657,"_28586":67616,"_19790":115206,"_5":13558,"_26008":115095,"_2720":115207},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3227":67658,"_28586":67616,"_19790":115209,"_5":13558,"_26008":115099,"_2720":115210},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3227":67659,"_28586":67616,"_19790":115212,"_5":13558,"_26008":115099,"_2720":115213},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3227":67660,"_28586":67616,"_19790":115215,"_5":13558,"_26008":115103,"_2720":115216},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3227":67661,"_28586":67616,"_19790":115218,"_5":13558,"_26008":115103,"_2720":115219},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3227":67662,"_28586":67616,"_19790":115221,"_5":13558,"_26008":115103,"_2720":115222},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3227":67663,"_28586":67616,"_19790":115224,"_5":13558,"_26008":115103,"_2720":115225},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3227":67664,"_28586":67616,"_19790":115227,"_5":13558,"_26008":115103,"_2720":115228},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3227":67665,"_28586":67616,"_19790":115230,"_5":13558,"_26008":115107,"_2720":115231},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3227":67666,"_28586":67616,"_19790":115233,"_5":13558,"_26008":115107,"_2720":112024},[],{"_3227":67667,"_28586":67616,"_19790":115235,"_5":13558,"_26008":115107,"_2720":115236},[],"Path relativo",{"_3227":67668,"_28586":67616,"_19790":115238,"_5":13558,"_26008":115107,"_2720":110060},[],{"_3227":67669,"_28586":67616,"_19790":115240,"_5":13558,"_26008":115107,"_2720":52804},[],{"_3227":67670,"_28586":67616,"_19790":115242,"_5":13558,"_26008":115107,"_2720":52807},[],{"_3227":67671,"_28586":67616,"_19790":115244,"_5":13558,"_26008":115107,"_2720":115245},[],"Consultar `crl_options` y `latest_crl`.",{"_3227":67672,"_28586":67616,"_19790":115247,"_5":13558,"_26008":115107,"_2720":52813},[],{"_3227":67673,"_28586":67616,"_19790":115249,"_5":13558,"_26008":115107,"_2720":52807},[],{"_3227":67674,"_28586":67616,"_19790":115251,"_5":13558,"_26008":115107,"_2720":115252},[],"Sustituir la configuración de CRL.",{"_3227":67675,"_28586":67616,"_19790":115254,"_5":13558,"_26008":115107,"_2720":115255},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3227":67676,"_28586":67616,"_19790":115257,"_5":13558,"_26008":115107,"_2720":115258},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3227":67677,"_28586":67616,"_19790":115260,"_5":13558,"_26008":115111,"_2720":115261},[],"Síntoma",{"_3227":67678,"_28586":67616,"_19790":115263,"_5":13558,"_26008":115111,"_2720":115264},[],"Causa",{"_3227":67679,"_28586":67616,"_19790":115266,"_5":13558,"_26008":115111,"_2720":115267},[],"Acción",{"_3227":67680,"_28586":67616,"_19790":115269,"_5":13558,"_26008":115111,"_2720":115270},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3227":67681,"_28586":67616,"_19790":115272,"_5":13558,"_26008":115111,"_2720":115273},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3227":67682,"_28586":67616,"_19790":115275,"_5":13558,"_26008":115111,"_2720":115276},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3227":67683,"_28586":67616,"_19790":115278,"_5":13558,"_26008":115111,"_2720":115279},[],"`PUT` devuelve 400.",{"_3227":67684,"_28586":67616,"_19790":115281,"_5":13558,"_26008":115111,"_2720":115282},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3227":67685,"_28586":67616,"_19790":115284,"_5":13558,"_26008":115111,"_2720":115285},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3227":67686,"_28586":67616,"_19790":115287,"_5":13558,"_26008":115111,"_2720":115288},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3227":67687,"_28586":67616,"_19790":115290,"_5":13558,"_26008":115111,"_2720":115291},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3227":67688,"_28586":67616,"_19790":115293,"_5":13558,"_26008":115111,"_2720":115294},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3227":67689,"_28586":67616,"_19790":115296,"_5":13558,"_26008":115111,"_2720":115297},[],"La CRL no cambia tras revocar un certificado.",{"_3227":67690,"_28586":67616,"_19790":115299,"_5":13558,"_26008":115111,"_2720":115300},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3227":67691,"_28586":67616,"_19790":115302,"_5":13558,"_26008":115111,"_2720":115303},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3227":67692,"_28586":67616,"_19790":115305,"_5":13558,"_26008":115111,"_2720":115306},[],"Un verificador rechaza la CRL por el emisor.",{"_3227":67693,"_28586":67616,"_19790":115308,"_5":13558,"_26008":115111,"_2720":115309},[],"Varias CAs comparten SKI.",{"_3227":67694,"_28586":67616,"_19790":115311,"_5":13558,"_26008":115111,"_2720":115312},[],"Consulta CAs que comparten clave.",{"_3227":67695,"_28586":67616,"_19790":115314,"_5":13558,"_26008":115115,"_2720":115315},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3227":67696,"_28586":67616,"_19790":115317,"_5":13558,"_26008":115119,"_2720":115318},[],"RFC 5280: perfil X.509 y CRL.",{"_3227":67697,"_28586":67616,"_19790":115320,"_5":13558,"_26008":115119,"_2720":52887},[],{"_3227":67698,"_28586":67616,"_19790":115322,"_5":13558,"_26008":115119,"_2720":52890},[],{"_3227":67699,"_28586":67616,"_19790":115324,"_5":13558,"_26008":115119,"_2720":115325},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":67700,"_28586":67616,"_19790":115327,"_5":13558,"_26008":115119,"_2720":115328},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3227":67701,"_28586":67701,"_5":13916,"_2720":115330,"_28908":115331,"_19790":115332,"_26008":67701},"Claves y motores criptográficos",[46300,110300,51497,113942],[],{"_3227":67702,"_28586":67701,"_19790":115334,"_5":13558,"_26008":67701,"_2720":115335},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3227":67703,"_28586":67701,"_5":28905,"_19790":115337,"_26008":115338,"_2720":115339},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3227":67704,"_28586":67701,"_5":28905,"_19790":115341,"_26008":115342,"_2720":115343},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3227":67705,"_28586":67701,"_5":28905,"_19790":115345,"_26008":115346,"_2720":52915},[],"/docs/es/platform/pki/key-management#file-system",{"_3227":67706,"_28586":67701,"_5":28905,"_19790":115348,"_26008":115349,"_2720":52919},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3227":67707,"_28586":67701,"_5":28905,"_19790":115351,"_26008":115352,"_2720":52923},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3227":67708,"_28586":67701,"_5":28905,"_19790":115354,"_26008":115355,"_2720":52927},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3227":67709,"_28586":67701,"_5":28905,"_19790":115357,"_26008":115358,"_2720":52931},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3227":67710,"_28586":67701,"_5":28905,"_19790":115360,"_26008":115361,"_2720":52935},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3227":67711,"_28586":67701,"_5":28905,"_19790":115363,"_26008":115364,"_2720":115365},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3227":67712,"_28586":67701,"_5":28905,"_19790":115367,"_26008":115368,"_2720":115369},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3227":67713,"_28586":67701,"_5":28905,"_19790":115371,"_26008":115372,"_2720":115373},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3227":67714,"_28586":67701,"_5":28905,"_19790":115375,"_26008":115376,"_2720":115377},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3227":67715,"_28586":67701,"_5":28905,"_19790":115379,"_26008":115380,"_2720":115381},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3227":67716,"_28586":67701,"_5":28905,"_19790":115383,"_26008":115384,"_2720":115385},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3227":67717,"_28586":67701,"_5":28905,"_19790":115387,"_26008":115388,"_2720":115389},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3227":67718,"_28586":67701,"_5":28905,"_19790":115391,"_26008":115392,"_2720":52967},[],"/docs/es/platform/pki/key-management#sign",{"_3227":67719,"_28586":67701,"_5":28905,"_19790":115394,"_26008":115395,"_2720":52971},[],"/docs/es/platform/pki/key-management#verify",{"_3227":67720,"_28586":67701,"_5":28905,"_19790":115397,"_26008":115398,"_2720":115399},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3227":67721,"_28586":67701,"_5":28905,"_19790":115401,"_26008":115402,"_2720":115403},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3227":67722,"_28586":67701,"_5":28905,"_19790":115405,"_26008":115406,"_2720":115407},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3227":67723,"_28586":67701,"_19790":115409,"_5":13558,"_26008":67701,"_2720":115410},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3227":67724,"_28586":67701,"_19790":115412,"_5":13558,"_26008":67701,"_2720":115413},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3227":67725,"_28586":67701,"_19790":115415,"_5":13558,"_26008":115338,"_2720":115416},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3227":67726,"_28586":67701,"_19790":115418,"_5":13558,"_26008":115338,"_2720":115419},[],"En la práctica, permite:",{"_3227":67727,"_28586":67701,"_19790":115421,"_5":13558,"_26008":115338,"_2720":115422},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3227":67728,"_28586":67701,"_19790":115424,"_5":13558,"_26008":115338,"_2720":115425},[],"Importar claves creadas externamente.",{"_3227":67729,"_28586":67701,"_19790":115427,"_5":13558,"_26008":115338,"_2720":115428},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3227":67730,"_28586":67701,"_19790":115430,"_5":13558,"_26008":115338,"_2720":115431},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3227":67731,"_28586":67701,"_19790":115433,"_5":13558,"_26008":115342,"_2720":115434},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3227":67732,"_28586":67701,"_19790":115436,"_5":13558,"_26008":115342,"_2720":115437},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3227":67733,"_28586":67701,"_19790":115439,"_5":13558,"_26008":115342,"_2720":115440},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3227":67734,"_28586":67701,"_19790":115442,"_5":13558,"_26008":115346,"_2720":115443},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3227":67735,"_28586":67701,"_19790":115445,"_5":13558,"_26008":115349,"_2720":115446},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3227":67736,"_28586":67701,"_19790":115448,"_5":13558,"_26008":115349,"_2720":115449},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3227":67737,"_28586":67701,"_19790":115451,"_5":13558,"_26008":115352,"_2720":115452},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3227":67738,"_28586":67701,"_19790":115454,"_5":13558,"_26008":115355,"_2720":115455},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3227":67739,"_28586":67701,"_19790":115457,"_5":13558,"_26008":115358,"_2720":115458},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3227":67740,"_28586":67701,"_19790":115460,"_5":13558,"_26008":115361,"_2720":115461},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3227":67741,"_28586":67701,"_19790":115463,"_5":13558,"_26008":115361,"_2720":115464},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3227":67742,"_28586":67701,"_19790":115466,"_5":13558,"_26008":115361,"_2720":115467},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3227":67743,"_28586":67701,"_19790":115469,"_5":13558,"_26008":115361,"_2720":115470},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3227":67744,"_28586":67701,"_19790":115472,"_5":13558,"_26008":115364,"_2720":115473},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3227":67745,"_28586":67701,"_19790":115475,"_5":13558,"_26008":115364,"_2720":115476},[],"La tabla incluye los siguientes campos:",{"_3227":67746,"_28586":67701,"_19790":115478,"_5":13558,"_26008":115364,"_2720":115479},[],"**Name**: nombre descriptivo de la clave.",{"_3227":67747,"_28586":67701,"_19790":115481,"_5":13558,"_26008":115364,"_2720":115482},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3227":67748,"_28586":67701,"_19790":115484,"_5":13558,"_26008":115364,"_2720":115485},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3227":67749,"_28586":67701,"_19790":115487,"_5":13558,"_26008":115364,"_2720":115488},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3227":67750,"_28586":67701,"_19790":115490,"_5":13558,"_26008":115364,"_2720":115491},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3227":67751,"_28586":67701,"_19790":115493,"_5":13558,"_26008":115364,"_2720":115494},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3227":67752,"_28586":67701,"_19790":115496,"_5":13558,"_26008":115364,"_2720":115497},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3227":67753,"_28586":67701,"_19790":115499,"_5":13558,"_26008":115364,"_2720":115500},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3227":67754,"_28586":67701,"_19790":115502,"_5":13558,"_26008":115364,"_2720":115503},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3227":67755,"_28586":67701,"_19790":115505,"_5":13558,"_26008":115364,"_2720":115506},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3227":67756,"_28586":67701,"_19790":115508,"_5":13558,"_26008":115364,"_2720":115509},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3227":67757,"_28586":67701,"_19790":115511,"_5":13558,"_26008":115364,"_2720":115512},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3227":67758,"_28586":67701,"_19790":115514,"_5":13558,"_26008":115364,"_2720":115515},[],"**Delete Key** para eliminar la clave del sistema.",{"_3227":67759,"_28586":67701,"_19790":115517,"_5":13558,"_26008":115368,"_2720":115518},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3227":67760,"_28586":67701,"_19790":115520,"_5":13558,"_26008":115372,"_2720":115521},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3227":67761,"_28586":67701,"_19790":115523,"_5":13558,"_26008":115372,"_2720":115524},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3227":67762,"_28586":67701,"_19790":115526,"_5":13558,"_26008":115372,"_2720":115527},[],"**Key Name**: nombre único y descriptivo.",{"_3227":67763,"_28586":67701,"_19790":115529,"_5":13558,"_26008":115372,"_2720":115530},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3227":67764,"_28586":67701,"_19790":115532,"_5":13558,"_26008":115372,"_2720":115533},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3227":67765,"_28586":67701,"_19790":115535,"_5":13558,"_26008":115372,"_2720":115536},[],"**Tags**: metadatos para clasificar la clave.",{"_3227":67766,"_28586":67701,"_19790":115538,"_5":13558,"_26008":115372,"_2720":115539},[],"**Metadata**: información adicional para usos avanzados.",{"_3227":67767,"_28586":67701,"_19790":115541,"_5":13558,"_26008":115376,"_2720":115542},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3227":67768,"_28586":67701,"_19790":115544,"_5":13558,"_26008":115376,"_2720":115545},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3227":67769,"_28586":67701,"_19790":115547,"_5":13558,"_26008":115376,"_2720":115548},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3227":67770,"_28586":67701,"_19790":115550,"_5":13558,"_26008":115376,"_2720":115551},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3227":67771,"_28586":67701,"_19790":115553,"_5":13558,"_26008":115376,"_2720":115554},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3227":67772,"_28586":67701,"_19790":115556,"_5":13558,"_26008":115376,"_2720":115557},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3227":67773,"_28586":67701,"_19790":115559,"_5":13558,"_26008":115376,"_2720":115560},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3227":67774,"_28586":67701,"_19790":115562,"_5":13558,"_26008":115376,"_2720":115563},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3227":67775,"_28586":67701,"_19790":115565,"_5":13558,"_26008":115376,"_2720":115566},[],"**Metadata**: información adicional opcional.",{"_3227":67776,"_28586":67701,"_19790":115568,"_5":13558,"_26008":115376,"_2720":115569},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3227":67777,"_28586":67701,"_19790":115571,"_5":13558,"_26008":115376,"_2720":115572},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3227":67778,"_28586":67701,"_19790":115574,"_5":13558,"_26008":115380,"_2720":115575},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3227":67779,"_28586":67701,"_19790":115577,"_5":13558,"_26008":115384,"_2720":115578},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3227":67780,"_28586":67701,"_19790":115580,"_5":13558,"_26008":115384,"_2720":115581},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3227":67781,"_28586":67701,"_19790":115583,"_5":13558,"_26008":115384,"_2720":115584},[],"**Key Name**: nombre descriptivo.",{"_3227":67782,"_28586":67701,"_19790":115586,"_5":13558,"_26008":115384,"_2720":115587},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3227":67783,"_28586":67701,"_19790":115589,"_5":13558,"_26008":115384,"_2720":115590},[],"**Tags**: etiquetas asociadas.",{"_3227":67784,"_28586":67701,"_19790":115592,"_5":13558,"_26008":115384,"_2720":115593},[],"**Aliases**: nombres alternativos.",{"_3227":67785,"_28586":67701,"_19790":115595,"_5":13558,"_26008":115384,"_2720":115596},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3227":67786,"_28586":67701,"_19790":115598,"_5":13558,"_26008":115384,"_2720":115599},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3227":67787,"_28586":67701,"_19790":115601,"_5":13558,"_26008":115384,"_2720":115602},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3227":67788,"_28586":67701,"_19790":115604,"_5":13558,"_26008":115384,"_2720":115605},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3227":67789,"_28586":67701,"_19790":115607,"_5":13558,"_26008":115388,"_2720":115608},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3227":67790,"_28586":67701,"_19790":115610,"_5":13558,"_26008":115388,"_2720":115611},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3227":67791,"_28586":67701,"_19790":115613,"_5":13558,"_26008":115388,"_2720":115614},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3227":67792,"_28586":67701,"_19790":115616,"_5":13558,"_26008":115392,"_2720":115617},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3227":67793,"_28586":67701,"_19790":115619,"_5":13558,"_26008":115392,"_2720":115620},[],"Campos principales:",{"_3227":67794,"_28586":67701,"_19790":115622,"_5":13558,"_26008":115392,"_2720":115623},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3227":67795,"_28586":67701,"_19790":115625,"_5":13558,"_26008":115392,"_2720":115626},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3227":67796,"_28586":67701,"_19790":115628,"_5":13558,"_26008":115392,"_2720":115629},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3227":67797,"_28586":67701,"_19790":115631,"_5":13558,"_26008":115392,"_2720":115632},[],"**Message**: contenido que se va a firmar.",{"_3227":67798,"_28586":67701,"_19790":115634,"_5":13558,"_26008":115392,"_2720":115635},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3227":67799,"_28586":67701,"_19790":115637,"_5":13558,"_26008":115395,"_2720":115638},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3227":67800,"_28586":67701,"_19790":115640,"_5":13558,"_26008":115395,"_2720":115620},[],{"_3227":67801,"_28586":67701,"_19790":115642,"_5":13558,"_26008":115395,"_2720":115643},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3227":67802,"_28586":67701,"_19790":115645,"_5":13558,"_26008":115395,"_2720":115646},[],"**Message Type**: `Raw` o `Digest`.",{"_3227":67803,"_28586":67701,"_19790":115648,"_5":13558,"_26008":115395,"_2720":115649},[],"**Payload Encoding**: codificación del mensaje.",{"_3227":67804,"_28586":67701,"_19790":115651,"_5":13558,"_26008":115395,"_2720":115652},[],"**Message**: mensaje original o hash.",{"_3227":67805,"_28586":67701,"_19790":115654,"_5":13558,"_26008":115395,"_2720":115655},[],"**Signature**: firma que se desea comprobar.",{"_3227":67806,"_28586":67701,"_19790":115657,"_5":13558,"_26008":115395,"_2720":115658},[],"**Result**: indicador del resultado de la validación.",{"_3227":67807,"_28586":67701,"_19790":115660,"_5":13558,"_26008":115398,"_2720":115661},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3227":67808,"_28586":67701,"_19790":115663,"_5":13558,"_26008":115398,"_2720":115664},[],"Este flujo es útil para:",{"_3227":67809,"_28586":67701,"_19790":115666,"_5":13558,"_26008":115398,"_2720":115667},[],"Solicitar certificados a una CA externa.",{"_3227":67810,"_28586":67701,"_19790":115669,"_5":13558,"_26008":115398,"_2720":115670},[],"Renovar una identidad manteniendo la misma clave.",{"_3227":67811,"_28586":67701,"_19790":115672,"_5":13558,"_26008":115398,"_2720":115673},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3227":67812,"_28586":67701,"_19790":115675,"_5":13558,"_26008":115398,"_2720":115676},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3227":67813,"_28586":67701,"_19790":115678,"_5":13558,"_26008":115398,"_2720":115679},[],"**Organization (O)**: organización o empresa.",{"_3227":67814,"_28586":67701,"_19790":115681,"_5":13558,"_26008":115398,"_2720":115682},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3227":67815,"_28586":67701,"_19790":115684,"_5":13558,"_26008":115398,"_2720":115685},[],"**Country (C)**: código de país de dos letras.",{"_3227":67816,"_28586":67701,"_19790":115687,"_5":13558,"_26008":115398,"_2720":115688},[],"**State / Province (ST)**: estado o provincia.",{"_3227":67817,"_28586":67701,"_19790":115690,"_5":13558,"_26008":115398,"_2720":115691},[],"**Locality (L)**: ciudad o localidad.",{"_3227":67818,"_28586":67701,"_19790":115693,"_5":13558,"_26008":115398,"_2720":115694},[],"**Email Address**: correo de contacto.",{"_3227":67819,"_28586":67701,"_19790":115696,"_5":13558,"_26008":115398,"_2720":115697},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3227":67820,"_28586":67701,"_19790":115699,"_5":13558,"_26008":115398,"_2720":115700},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3227":67821,"_28586":67701,"_19790":115702,"_5":13558,"_26008":115402,"_2720":115703},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3227":67822,"_28586":67701,"_19790":115705,"_5":13558,"_26008":115402,"_2720":53282},[],{"_3227":67823,"_28586":67701,"_19790":115707,"_5":13558,"_26008":115406,"_2720":115708},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3227":67824,"_28586":67824,"_5":13916,"_2720":115710,"_28908":115711,"_19790":115712,"_26008":67824},"Validación online con OCSP",[46300,110300,51497,114567],[],{"_3227":67825,"_28586":67824,"_19790":115714,"_5":13558,"_26008":67824,"_2720":115715},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3227":67826,"_28586":67824,"_5":28905,"_19790":115717,"_26008":115718,"_2720":115719},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3227":67827,"_28586":67824,"_5":28905,"_19790":115721,"_26008":115722,"_2720":115723},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3227":67828,"_28586":67824,"_5":28905,"_19790":115725,"_26008":115726,"_2720":115727},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3227":67829,"_28586":67824,"_5":28905,"_19790":115729,"_26008":115730,"_2720":115731},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3227":67830,"_28586":67824,"_5":28905,"_19790":115733,"_26008":115734,"_2720":115735},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3227":67831,"_28586":67824,"_5":28905,"_19790":115737,"_26008":115738,"_2720":115120},[],"/docs/es/platform/pki/ocsp#referencias",{"_3227":67832,"_28586":67824,"_19790":115740,"_5":13558,"_26008":67824,"_2720":115741},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3227":67833,"_28586":67824,"_19790":115743,"_5":13558,"_26008":115718,"_2720":115744},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3227":67834,"_28586":67824,"_19790":115746,"_5":13558,"_26008":115718,"_2720":115747},[],"Estado del registro",{"_3227":67835,"_28586":67824,"_19790":115749,"_5":13558,"_26008":115718,"_2720":115750},[],"Respuesta firmada",{"_3227":67836,"_28586":67824,"_19790":115752,"_5":13558,"_26008":115718,"_2720":50666},[],{"_3227":67837,"_28586":67824,"_19790":115754,"_5":13558,"_26008":115718,"_2720":53332},[],{"_3227":67838,"_28586":67824,"_19790":115756,"_5":13558,"_26008":115718,"_2720":50683},[],{"_3227":67839,"_28586":67824,"_19790":115758,"_5":13558,"_26008":115718,"_2720":115759},[],"`Revoked`, con razón y fecha de revocación.",{"_3227":67840,"_28586":67824,"_19790":115761,"_5":13558,"_26008":115718,"_2720":115762},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3227":67841,"_28586":67824,"_19790":115764,"_5":13558,"_26008":115718,"_2720":115765},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3227":67842,"_28586":67824,"_19790":115767,"_5":13558,"_26008":115718,"_2720":115768},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3227":67843,"_28586":67824,"_19790":115770,"_5":13558,"_26008":115718,"_2720":115771},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3227":67844,"_28586":67824,"_19790":115773,"_5":13558,"_26008":115718,"_2720":115774},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3227":67845,"_28586":67824,"_19790":115776,"_5":13558,"_26008":115722,"_2720":115777},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3227":67846,"_28586":67824,"_19790":115779,"_5":13558,"_26008":115722,"_2720":115780},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3227":67847,"_28586":67824,"_19790":115782,"_5":13558,"_26008":115726,"_2720":115783},[],"El servicio acepta:",{"_3227":67848,"_28586":67824,"_19790":115785,"_5":13558,"_26008":115726,"_2720":112024},[],{"_3227":67849,"_28586":67824,"_19790":115787,"_5":13558,"_26008":115726,"_2720":115788},[],"Ruta del servicio VA",{"_3227":67850,"_28586":67824,"_19790":115790,"_5":13558,"_26008":115726,"_2720":115791},[],"Formato",{"_3227":67851,"_28586":67824,"_19790":115793,"_5":13558,"_26008":115726,"_2720":53372},[],{"_3227":67852,"_28586":67824,"_19790":115795,"_5":13558,"_26008":115726,"_2720":53375},[],{"_3227":67853,"_28586":67824,"_19790":115797,"_5":13558,"_26008":115726,"_2720":115798},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3227":67854,"_28586":67824,"_19790":115800,"_5":13558,"_26008":115726,"_2720":52804},[],{"_3227":67855,"_28586":67824,"_19790":115802,"_5":13558,"_26008":115726,"_2720":53383},[],{"_3227":67856,"_28586":67824,"_19790":115804,"_5":13558,"_26008":115726,"_2720":115805},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3227":67857,"_28586":67824,"_19790":115807,"_5":13558,"_26008":115726,"_2720":115808},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3227":67858,"_28586":67824,"_19790":115810,"_5":13558,"_26008":115730,"_2720":115811},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3227":67859,"_28586":67824,"_19790":115813,"_5":13558,"_26008":115730,"_2720":115814},[],"Genera la solicitud:",{"_3227":67860,"_28586":67824,"_19790":115816,"_5":13558,"_26008":115730,"_2720":115817},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3227":67861,"_28586":67824,"_19790":115819,"_5":13558,"_26008":115730,"_2720":115820},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3227":67862,"_28586":67824,"_19790":115822,"_5":13558,"_26008":115730,"_2720":115823},[],"Verifica el DER recibido:",{"_3227":67863,"_28586":67824,"_19790":115825,"_5":13558,"_26008":115730,"_2720":115826},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3227":67864,"_28586":67824,"_19790":115828,"_5":13558,"_26008":115734,"_2720":115829},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3227":67865,"_28586":67824,"_19790":115831,"_5":13558,"_26008":115734,"_2720":115832},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3227":67866,"_28586":67824,"_19790":115834,"_5":13558,"_26008":115738,"_2720":53416},[],{"_3227":67867,"_28586":67824,"_19790":115836,"_5":13558,"_26008":115738,"_2720":53419},[],{"_3227":67868,"_28586":67824,"_19790":115838,"_5":13558,"_26008":115738,"_2720":115839},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3227":67869,"_28586":67824,"_19790":115841,"_5":13558,"_26008":115738,"_2720":115328},[],{"_3227":67870,"_28586":67870,"_5":13916,"_2720":51497,"_28908":115843,"_19790":115844,"_26008":67870},[46300,110300,51497],[],{"_3227":67871,"_28586":67870,"_19790":115846,"_5":13558,"_26008":67870,"_2720":115847},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3227":67872,"_28586":67870,"_5":28905,"_19790":115849,"_26008":115850,"_2720":113266},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3227":67873,"_28586":67870,"_5":28905,"_19790":115852,"_26008":115853,"_2720":115854},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3227":67874,"_28586":67870,"_5":28905,"_19790":115856,"_26008":115857,"_2720":113788},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3227":67875,"_28586":67870,"_5":28905,"_19790":115859,"_26008":115860,"_2720":113792},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3227":67876,"_28586":67870,"_5":28905,"_19790":115862,"_26008":115863,"_2720":113796},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3227":67877,"_28586":67870,"_5":28905,"_19790":115865,"_26008":115866,"_2720":113800},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3227":67878,"_28586":67870,"_5":28905,"_19790":115868,"_26008":115869,"_2720":113808},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3227":67879,"_28586":67870,"_5":28905,"_19790":115871,"_26008":115872,"_2720":115873},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3227":67880,"_28586":67870,"_5":28905,"_19790":115875,"_26008":115876,"_2720":114733},[],"/docs/es/platform/pki/overview#continúa",{"_3227":67881,"_28586":67870,"_19790":115878,"_5":13558,"_26008":67870,"_2720":115879},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3227":67882,"_28586":67870,"_19790":115881,"_5":13558,"_26008":115850,"_2720":115882},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3227":67883,"_28586":67870,"_19790":115884,"_5":13558,"_26008":115850,"_2720":115885},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3227":67884,"_28586":67870,"_19790":115887,"_5":13558,"_26008":115853,"_2720":115888},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3227":67885,"_28586":67870,"_19790":115890,"_5":13558,"_26008":115853,"_2720":115891},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3227":67886,"_28586":67870,"_19790":115893,"_5":13558,"_26008":115853,"_2720":115894},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3227":67887,"_28586":67870,"_19790":115896,"_5":13558,"_26008":115853,"_2720":115897},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3227":67888,"_28586":67870,"_19790":115899,"_5":13558,"_26008":115853,"_2720":115900},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3227":67889,"_28586":67870,"_19790":115902,"_5":13558,"_26008":115860,"_2720":115903},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3227":67890,"_28586":67870,"_19790":115905,"_5":13558,"_26008":115863,"_2720":115906},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3227":67891,"_28586":67870,"_19790":115908,"_5":13558,"_26008":115866,"_2720":115909},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3227":67892,"_28586":67870,"_19790":115911,"_5":13558,"_26008":115869,"_2720":115912},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3227":67893,"_28586":67870,"_19790":115914,"_5":13558,"_26008":115872,"_2720":115915},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3227":67894,"_28586":67870,"_19790":115917,"_5":13558,"_26008":115872,"_2720":115918},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3227":67895,"_28586":67870,"_19790":115920,"_5":13558,"_26008":115872,"_2720":115921},[],"su clave pública corresponda a la clave privada del cliente;",{"_3227":67896,"_28586":67870,"_19790":115923,"_5":13558,"_26008":115872,"_2720":115924},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3227":67897,"_28586":67870,"_19790":115926,"_5":13558,"_26008":115872,"_2720":115927},[],"sus fechas y usos permitan la operación;",{"_3227":67898,"_28586":67870,"_19790":115929,"_5":13558,"_26008":115872,"_2720":115930},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3227":67899,"_28586":67870,"_19790":115932,"_5":13558,"_26008":115872,"_2720":115933},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3227":67900,"_28586":67870,"_19790":115935,"_5":13558,"_26008":115876,"_2720":115936},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3227":67901,"_28586":67870,"_19790":115938,"_5":13558,"_26008":115876,"_2720":115939},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3227":67902,"_28586":67870,"_19790":115941,"_5":13558,"_26008":115876,"_2720":115942},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3227":67903,"_28586":67903,"_5":13916,"_2720":115944,"_28908":115945,"_19790":115946,"_26008":67903},"Crea tu primera CA",[46300,110300,51497,113390],[],{"_3227":67904,"_28586":67903,"_19790":115948,"_5":13558,"_26008":67903,"_2720":115949},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3227":67905,"_28586":67903,"_5":28905,"_19790":115951,"_26008":115952,"_2720":108897},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3227":67906,"_28586":67903,"_5":28905,"_19790":115954,"_26008":115955,"_2720":115956},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3227":67907,"_28586":67903,"_5":28905,"_19790":115958,"_26008":115959,"_2720":115960},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3227":67908,"_28586":67903,"_5":28905,"_19790":115962,"_26008":115963,"_2720":115964},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3227":67909,"_28586":67903,"_5":28905,"_19790":115966,"_26008":115967,"_2720":115968},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3227":67910,"_28586":67903,"_5":28905,"_19790":115970,"_26008":115971,"_2720":115972},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3227":67911,"_28586":67903,"_5":28905,"_19790":115974,"_26008":115975,"_2720":115976},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3227":67912,"_28586":67903,"_5":28905,"_19790":115978,"_26008":115979,"_2720":113638},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3227":67913,"_28586":67903,"_5":28905,"_19790":115981,"_26008":115982,"_2720":108921},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3227":67914,"_28586":67903,"_19790":115984,"_5":13558,"_26008":67903,"_2720":115985},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3227":67915,"_28586":67903,"_19790":115987,"_5":13558,"_26008":115952,"_2720":115988},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3227":67916,"_28586":67903,"_19790":115990,"_5":13558,"_26008":115952,"_2720":115991},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3227":67917,"_28586":67903,"_19790":115993,"_5":13558,"_26008":115952,"_2720":115994},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3227":67918,"_28586":67903,"_19790":115996,"_5":13558,"_26008":115952,"_2720":115997},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3227":67919,"_28586":67903,"_19790":115999,"_5":13558,"_26008":115955,"_2720":116000},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3227":67920,"_28586":67903,"_19790":116002,"_5":13558,"_26008":115955,"_2720":116003},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3227":67921,"_28586":67903,"_19790":116005,"_5":13558,"_26008":115959,"_2720":116006},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3227":67922,"_28586":67903,"_19790":116008,"_5":13558,"_26008":115959,"_2720":116009},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3227":67923,"_28586":67903,"_19790":116011,"_5":13558,"_26008":115963,"_2720":116012},[],"Selecciona **Root CA** y completa:",{"_3227":67924,"_28586":67903,"_19790":116014,"_5":13558,"_26008":115963,"_2720":53598},[],{"_3227":67925,"_28586":67903,"_19790":116016,"_5":13558,"_26008":115963,"_2720":116017},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3227":67926,"_28586":67903,"_19790":116019,"_5":13558,"_26008":115963,"_2720":116020},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3227":67927,"_28586":67903,"_19790":116022,"_5":13558,"_26008":115963,"_2720":116023},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3227":67928,"_28586":67903,"_19790":116025,"_5":13558,"_26008":115963,"_2720":116026},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3227":67929,"_28586":67903,"_19790":116028,"_5":13558,"_26008":115967,"_2720":116029},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3227":67930,"_28586":67903,"_19790":116031,"_5":13558,"_26008":115971,"_2720":116032},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3227":67931,"_28586":67903,"_19790":116034,"_5":13558,"_26008":115971,"_2720":116035},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3227":67932,"_28586":67903,"_19790":116037,"_5":13558,"_26008":115975,"_2720":116038},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3227":67933,"_28586":67903,"_19790":116040,"_5":13558,"_26008":115975,"_2720":116041},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3227":67934,"_28586":67903,"_19790":116043,"_5":13558,"_26008":115975,"_2720":116044},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3227":67935,"_28586":67903,"_19790":116046,"_5":13558,"_26008":115979,"_2720":116047},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3227":67936,"_28586":67903,"_19790":116049,"_5":13558,"_26008":115979,"_2720":116050},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3227":67937,"_28586":67903,"_19790":116052,"_5":13558,"_26008":115979,"_2720":116053},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3227":67938,"_28586":67903,"_19790":116055,"_5":13558,"_26008":115979,"_2720":116056},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3227":67939,"_28586":67903,"_19790":116058,"_5":13558,"_26008":115982,"_2720":116059},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3227":67940,"_28586":67940,"_5":13916,"_2720":116061,"_28908":116062,"_19790":116063,"_26008":67940},"Emite y verifica un certificado",[46300,110300,51497,113390],[],{"_3227":67941,"_28586":67940,"_19790":116065,"_5":13558,"_26008":67940,"_2720":116066},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3227":67942,"_28586":67940,"_5":28905,"_19790":116068,"_26008":116069,"_2720":108897},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3227":67943,"_28586":67940,"_5":28905,"_19790":116071,"_26008":116072,"_2720":116073},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3227":67944,"_28586":67940,"_5":28905,"_19790":116075,"_26008":116076,"_2720":116077},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3227":67945,"_28586":67940,"_5":28905,"_19790":116079,"_26008":116080,"_2720":116081},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3227":67946,"_28586":67940,"_5":28905,"_19790":116083,"_26008":116084,"_2720":116085},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3227":67947,"_28586":67940,"_5":28905,"_19790":116087,"_26008":116088,"_2720":116089},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3227":67948,"_28586":67940,"_5":28905,"_19790":116091,"_26008":116092,"_2720":116093},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3227":67949,"_28586":67940,"_5":28905,"_19790":116095,"_26008":116096,"_2720":116097},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3227":67950,"_28586":67940,"_5":28905,"_19790":116099,"_26008":116100,"_2720":116101},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3227":67951,"_28586":67940,"_5":28905,"_19790":116103,"_26008":116104,"_2720":116105},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3227":67952,"_28586":67940,"_5":28905,"_19790":116107,"_26008":116108,"_2720":113638},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3227":67953,"_28586":67940,"_5":28905,"_19790":116110,"_26008":116111,"_2720":108921},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3227":67954,"_28586":67940,"_19790":116113,"_5":13558,"_26008":67940,"_2720":116114},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3227":67955,"_28586":67940,"_19790":116116,"_5":13558,"_26008":116069,"_2720":116117},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3227":67956,"_28586":67940,"_19790":116119,"_5":13558,"_26008":116069,"_2720":116120},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3227":67957,"_28586":67940,"_19790":116122,"_5":13558,"_26008":116069,"_2720":116123},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3227":67958,"_28586":67940,"_19790":116125,"_5":13558,"_26008":116069,"_2720":116126},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3227":67959,"_28586":67940,"_19790":116128,"_5":13558,"_26008":116069,"_2720":116129},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3227":67960,"_28586":67940,"_19790":116131,"_5":13558,"_26008":116072,"_2720":116132},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3227":67961,"_28586":67940,"_19790":116134,"_5":13558,"_26008":116076,"_2720":116135},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3227":67962,"_28586":67940,"_19790":116137,"_5":13558,"_26008":116076,"_2720":116138},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3227":67963,"_28586":67940,"_19790":116140,"_5":13558,"_26008":116080,"_2720":116141},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3227":67964,"_28586":67940,"_19790":116143,"_5":13558,"_26008":116080,"_2720":116144},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3227":67965,"_28586":67940,"_19790":116146,"_5":13558,"_26008":116084,"_2720":116147},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3227":67966,"_28586":67940,"_19790":116149,"_5":13558,"_26008":116084,"_2720":116150},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3227":67967,"_28586":67940,"_19790":116152,"_5":13558,"_26008":116088,"_2720":116153},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3227":67968,"_28586":67940,"_19790":116155,"_5":13558,"_26008":116092,"_2720":116156},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3227":67969,"_28586":67940,"_19790":116158,"_5":13558,"_26008":116096,"_2720":116159},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3227":67970,"_28586":67940,"_19790":116161,"_5":13558,"_26008":116100,"_2720":116162},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3227":67971,"_28586":67940,"_19790":116164,"_5":13558,"_26008":116100,"_2720":116165},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3227":67972,"_28586":67940,"_19790":116167,"_5":13558,"_26008":116100,"_2720":116168},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3227":67973,"_28586":67940,"_19790":116170,"_5":13558,"_26008":116104,"_2720":116171},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3227":67974,"_28586":67940,"_19790":116173,"_5":13558,"_26008":116104,"_2720":116174},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3227":67975,"_28586":67940,"_19790":116176,"_5":13558,"_26008":116104,"_2720":116177},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3227":67976,"_28586":67940,"_19790":116179,"_5":13558,"_26008":116108,"_2720":113721},[],{"_3227":67977,"_28586":67940,"_19790":116181,"_5":13558,"_26008":116108,"_2720":112473},[],{"_3227":67978,"_28586":67940,"_19790":116183,"_5":13558,"_26008":116108,"_2720":116184},[],"La CA rechaza la emisión",{"_3227":67979,"_28586":67940,"_19790":116186,"_5":13558,"_26008":116108,"_2720":116187},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3227":67980,"_28586":67940,"_19790":116189,"_5":13558,"_26008":116108,"_2720":116190},[],"Sujeto o usos diferentes",{"_3227":67981,"_28586":67940,"_19790":116192,"_5":13558,"_26008":116108,"_2720":116193},[],"Perfil aplicado y valores solicitados.",{"_3227":67982,"_28586":67940,"_19790":116195,"_5":13558,"_26008":116108,"_2720":116196},[],"No se encuentra el emisor",{"_3227":67983,"_28586":67940,"_19790":116198,"_5":13558,"_26008":116108,"_2720":116199},[],"CA descargada y cadena intermedia necesaria.",{"_3227":67984,"_28586":67940,"_19790":116201,"_5":13558,"_26008":116108,"_2720":116202},[],"Falla la vigencia",{"_3227":67985,"_28586":67940,"_19790":116204,"_5":13558,"_26008":116108,"_2720":116205},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3227":67986,"_28586":67940,"_19790":116207,"_5":13558,"_26008":116108,"_2720":116208},[],"Los resúmenes de clave difieren",{"_3227":67987,"_28586":67940,"_19790":116210,"_5":13558,"_26008":116108,"_2720":116211},[],"Archivos de certificado y clave de la misma emisión.",{"_3227":67988,"_28586":67940,"_19790":116213,"_5":13558,"_26008":116108,"_2720":116214},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3227":67989,"_28586":67940,"_19790":116216,"_5":13558,"_26008":116111,"_2720":116217},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3227":67990,"_28586":67940,"_19790":116219,"_5":13558,"_26008":116111,"_2720":116220},[],"Gestionar certificados para inspección, estado y revocación.",{"_3227":67991,"_28586":67940,"_19790":116222,"_5":13558,"_26008":116111,"_2720":116223},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3227":67992,"_28586":67940,"_19790":116225,"_5":13558,"_26008":116111,"_2720":116226},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3227":67993,"_28586":67940,"_19790":116228,"_5":13558,"_26008":116111,"_2720":116229},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3227":67994,"_28586":67994,"_5":13916,"_2720":116231,"_28908":116232,"_19790":116233,"_26008":67994},"Primeros pasos de PKI",[46300,110300,51497,113390],[],{"_3227":67995,"_28586":67994,"_19790":116235,"_5":13558,"_26008":67994,"_2720":116236},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3227":67996,"_28586":67994,"_5":28905,"_19790":116238,"_26008":116239,"_2720":108897},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3227":67997,"_28586":67994,"_5":28905,"_19790":116241,"_26008":116242,"_2720":116243},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3227":67998,"_28586":67994,"_5":28905,"_19790":116245,"_26008":116246,"_2720":113572},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3227":67999,"_28586":67994,"_5":28905,"_19790":116248,"_26008":116249,"_2720":116250},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3227":68000,"_28586":67994,"_19790":116252,"_5":13558,"_26008":67994,"_2720":116253},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3227":68001,"_28586":67994,"_19790":116255,"_5":13558,"_26008":116239,"_2720":116256},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3227":68002,"_28586":67994,"_19790":116258,"_5":13558,"_26008":116239,"_2720":116259},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3227":68003,"_28586":67994,"_19790":116261,"_5":13558,"_26008":116239,"_2720":116262},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3227":68004,"_28586":67994,"_19790":116264,"_5":13558,"_26008":116239,"_2720":116265},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3227":68005,"_28586":67994,"_19790":116267,"_5":13558,"_26008":116239,"_2720":116268},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3227":68006,"_28586":67994,"_19790":116270,"_5":13558,"_26008":116242,"_2720":116271},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3227":68007,"_28586":67994,"_19790":116273,"_5":13558,"_26008":116242,"_2720":116274},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3227":68008,"_28586":67994,"_19790":116276,"_5":13558,"_26008":116242,"_2720":116277},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3227":68009,"_28586":67994,"_19790":116279,"_5":13558,"_26008":116242,"_2720":116280},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3227":68010,"_28586":67994,"_19790":116282,"_5":13558,"_26008":116246,"_2720":116283},[],"Archivo o recurso",{"_3227":68011,"_28586":67994,"_19790":116285,"_5":13558,"_26008":116246,"_2720":113569},[],{"_3227":68012,"_28586":67994,"_19790":116287,"_5":13558,"_26008":116246,"_2720":116288},[],"CA raíz activa y `ca.pem`",{"_3227":68013,"_28586":67994,"_19790":116290,"_5":13558,"_26008":116246,"_2720":116291},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3227":68014,"_28586":67994,"_19790":116293,"_5":13558,"_26008":116246,"_2720":116294},[],"Certificado final y `device.crt`",{"_3227":68015,"_28586":67994,"_19790":116296,"_5":13558,"_26008":116246,"_2720":116297},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3227":68016,"_28586":67994,"_19790":116299,"_5":13558,"_26008":116246,"_2720":116300},[],"Clave privada `device.key`",{"_3227":68017,"_28586":67994,"_19790":116302,"_5":13558,"_26008":116246,"_2720":116303},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3227":68018,"_28586":67994,"_19790":116305,"_5":13558,"_26008":116246,"_2720":116306},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3227":68019,"_28586":67994,"_19790":116308,"_5":13558,"_26008":116249,"_2720":116309},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3227":68020,"_28586":67994,"_19790":116311,"_5":13558,"_26008":116249,"_2720":116312},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3227":68021,"_28586":67994,"_19790":116314,"_5":13558,"_26008":116249,"_2720":116315},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3227":68022,"_28586":68022,"_5":13916,"_2720":116317,"_28908":116318,"_19790":116320,"_26008":68022},"Resolución de problemas PKI",[46300,110300,51497,116319],"Resolución de problemas",[],{"_3227":68023,"_28586":68022,"_19790":116322,"_5":13558,"_26008":68022,"_2720":116323},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3227":68024,"_28586":68022,"_5":28905,"_19790":116325,"_26008":116326,"_2720":116327},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3227":68025,"_28586":68022,"_5":28905,"_19790":116329,"_26008":116330,"_2720":116331},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3227":68026,"_28586":68022,"_5":28905,"_19790":116333,"_26008":116334,"_2720":116335},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3227":68027,"_28586":68022,"_19790":116337,"_5":13558,"_26008":68022,"_2720":116338},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3227":68028,"_28586":68022,"_19790":116340,"_5":13558,"_26008":68022,"_2720":116341},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3227":68029,"_28586":68022,"_19790":116343,"_5":13558,"_26008":116326,"_2720":113569},[],{"_3227":68030,"_28586":68022,"_19790":116345,"_5":13558,"_26008":116326,"_2720":112473},[],{"_3227":68031,"_28586":68022,"_19790":116347,"_5":13558,"_26008":116326,"_2720":108921},[],{"_3227":68032,"_28586":68022,"_19790":116349,"_5":13558,"_26008":116326,"_2720":53935},[],{"_3227":68033,"_28586":68022,"_19790":116351,"_5":13558,"_26008":116326,"_2720":116352},[],"Existe, está activa y sus fechas son utilizables.",{"_3227":68034,"_28586":68022,"_19790":116354,"_5":13558,"_26008":116326,"_2720":116355},[],"Autoridades.",{"_3227":68035,"_28586":68022,"_19790":116357,"_5":13558,"_26008":116326,"_2720":116358},[],"Clave",{"_3227":68036,"_28586":68022,"_19790":116360,"_5":13558,"_26008":116326,"_2720":116361},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3227":68037,"_28586":68022,"_19790":116363,"_5":13558,"_26008":116326,"_2720":116364},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3227":68038,"_28586":68022,"_19790":116366,"_5":13558,"_26008":116326,"_2720":53953},[],{"_3227":68039,"_28586":68022,"_19790":116368,"_5":13558,"_26008":116326,"_2720":116369},[],"PEM correcto y firma verificable.",{"_3227":68040,"_28586":68022,"_19790":116371,"_5":13558,"_26008":116326,"_2720":53959},[],{"_3227":68041,"_28586":68022,"_19790":116373,"_5":13558,"_26008":116326,"_2720":116374},[],"Perfil",{"_3227":68042,"_28586":68022,"_19790":116376,"_5":13558,"_26008":116326,"_2720":116377},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3227":68043,"_28586":68022,"_19790":116379,"_5":13558,"_26008":116326,"_2720":116380},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3227":68044,"_28586":68022,"_19790":116382,"_5":13558,"_26008":116326,"_2720":113721},[],{"_3227":68045,"_28586":68022,"_19790":116384,"_5":13558,"_26008":116326,"_2720":116385},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3227":68046,"_28586":68022,"_19790":116387,"_5":13558,"_26008":116326,"_2720":116388},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3227":68047,"_28586":68022,"_19790":116390,"_5":13558,"_26008":116326,"_2720":116391},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3227":68048,"_28586":68022,"_19790":116393,"_5":13558,"_26008":116326,"_2720":116394},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3227":68049,"_28586":68022,"_19790":116396,"_5":13558,"_26008":116330,"_2720":116397},[],"Revisa cada frontera por separado:",{"_3227":68050,"_28586":68022,"_19790":116399,"_5":13558,"_26008":116330,"_2720":116400},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3227":68051,"_28586":68022,"_19790":116402,"_5":13558,"_26008":116330,"_2720":116403},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3227":68052,"_28586":68022,"_19790":116405,"_5":13558,"_26008":116330,"_2720":116406},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3227":68053,"_28586":68022,"_19790":116408,"_5":13558,"_26008":116330,"_2720":116409},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3227":68054,"_28586":68022,"_19790":116411,"_5":13558,"_26008":116330,"_2720":116412},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3227":68055,"_28586":68022,"_19790":116414,"_5":13558,"_26008":116330,"_2720":116415},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3227":68056,"_28586":68022,"_19790":116417,"_5":13558,"_26008":116334,"_2720":116418},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3227":68057,"_28586":68022,"_19790":116420,"_5":13558,"_26008":116334,"_2720":116421},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3227":68058,"_28586":68058,"_5":13916,"_2720":116423,"_28908":116424,"_19790":116426,"_26008":68058},"3.8.0 a 4.0.0",[46300,116425],"Actualizaciones",[],{"_3227":68059,"_28586":68058,"_19790":116428,"_5":13558,"_26008":68058,"_2720":116429},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3227":68060,"_28586":68058,"_5":28905,"_19790":116431,"_26008":116432,"_2720":116433},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3227":68061,"_28586":68058,"_5":28905,"_19790":116435,"_26008":116436,"_2720":116437},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3227":68062,"_28586":68058,"_5":28905,"_19790":116439,"_26008":116440,"_2720":116441},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3227":68063,"_28586":68058,"_5":28905,"_19790":116443,"_26008":116444,"_2720":116445},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3227":68064,"_28586":68058,"_5":28905,"_19790":116447,"_26008":116448,"_2720":116449},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3227":68065,"_28586":68058,"_5":28905,"_19790":116451,"_26008":116452,"_2720":116453},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3227":68066,"_28586":68058,"_5":28905,"_19790":116455,"_26008":116456,"_2720":54045},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3227":68067,"_28586":68058,"_5":28905,"_19790":116458,"_26008":116459,"_2720":116460},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3227":68068,"_28586":68058,"_5":28905,"_19790":116462,"_26008":116463,"_2720":116464},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3227":68069,"_28586":68058,"_5":28905,"_19790":116466,"_26008":116467,"_2720":116468},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3227":68070,"_28586":68058,"_5":28905,"_19790":116470,"_26008":116471,"_2720":116472},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3227":68071,"_28586":68058,"_5":28905,"_19790":116474,"_26008":116475,"_2720":116476},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3227":68072,"_28586":68058,"_5":28905,"_19790":116478,"_26008":116479,"_2720":116480},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3227":68073,"_28586":68058,"_5":28905,"_19790":116482,"_26008":116483,"_2720":116484},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3227":68074,"_28586":68058,"_5":28905,"_19790":116486,"_26008":116487,"_2720":116488},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3227":68075,"_28586":68058,"_5":28905,"_19790":116490,"_26008":116491,"_2720":116492},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3227":68076,"_28586":68058,"_5":28905,"_19790":116494,"_26008":116495,"_2720":116496},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3227":68077,"_28586":68058,"_5":28905,"_19790":116498,"_26008":116499,"_2720":116500},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3227":68078,"_28586":68058,"_5":28905,"_19790":116502,"_26008":116503,"_2720":116504},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3227":68079,"_28586":68058,"_5":28905,"_19790":116506,"_26008":116507,"_2720":116508},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3227":68080,"_28586":68058,"_5":28905,"_19790":116510,"_26008":116511,"_2720":116512},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3227":68081,"_28586":68058,"_5":28905,"_19790":116514,"_26008":116515,"_2720":116516},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3227":68082,"_28586":68058,"_5":28905,"_19790":116518,"_26008":116519,"_2720":116520},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3227":68083,"_28586":68058,"_5":28905,"_19790":116522,"_26008":116523,"_2720":116524},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3227":68084,"_28586":68058,"_5":28905,"_19790":116526,"_26008":116527,"_2720":116528},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3227":68085,"_28586":68058,"_5":28905,"_19790":116530,"_26008":116531,"_2720":116532},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3227":68086,"_28586":68058,"_5":28905,"_19790":116534,"_26008":116535,"_2720":116536},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3227":68087,"_28586":68058,"_5":28905,"_19790":116538,"_26008":116539,"_2720":116540},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3227":68088,"_28586":68058,"_5":28905,"_19790":116542,"_26008":116543,"_2720":116544},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3227":68089,"_28586":68058,"_5":28905,"_19790":116546,"_26008":116547,"_2720":116548},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3227":68090,"_28586":68058,"_5":28905,"_19790":116550,"_26008":116551,"_2720":116552},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3227":68091,"_28586":68058,"_5":28905,"_19790":116554,"_26008":116555,"_2720":116556},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3227":68092,"_28586":68058,"_5":28905,"_19790":116558,"_26008":116559,"_2720":116560},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3227":68093,"_28586":68058,"_5":28905,"_19790":116562,"_26008":116563,"_2720":112795},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3227":68094,"_28586":68058,"_5":28905,"_19790":116565,"_26008":116566,"_2720":116567},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3227":68095,"_28586":68058,"_5":28905,"_19790":116569,"_26008":116570,"_2720":116571},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3227":68096,"_28586":68058,"_19790":116573,"_5":13558,"_26008":68058,"_2720":116574},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3227":68097,"_28586":68058,"_19790":116576,"_5":13558,"_26008":68058,"_2720":116577},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3227":68098,"_28586":68058,"_19790":116579,"_5":13558,"_26008":68058,"_2720":116580},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3227":68099,"_28586":68058,"_19790":116582,"_5":13558,"_26008":68058,"_2720":116583},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3227":68100,"_28586":68058,"_19790":116585,"_5":13558,"_26008":68058,"_2720":116586},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3227":68101,"_28586":68058,"_19790":116588,"_5":13558,"_26008":68058,"_2720":116589},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3227":68102,"_28586":68058,"_19790":116591,"_5":13558,"_26008":68058,"_2720":116592},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3227":68103,"_28586":68058,"_19790":116594,"_5":13558,"_26008":116436,"_2720":116595},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3227":68104,"_28586":68058,"_19790":116597,"_5":13558,"_26008":116436,"_2720":116598},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3227":68105,"_28586":68058,"_19790":116600,"_5":13558,"_26008":116440,"_2720":116601},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3227":68106,"_28586":68058,"_19790":116603,"_5":13558,"_26008":116440,"_2720":116604},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3227":68107,"_28586":68058,"_19790":116606,"_5":13558,"_26008":116444,"_2720":116607},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3227":68108,"_28586":68058,"_19790":116609,"_5":13558,"_26008":116448,"_2720":116610},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3227":68109,"_28586":68058,"_19790":116612,"_5":13558,"_26008":116448,"_2720":116613},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3227":68110,"_28586":68058,"_19790":116615,"_5":13558,"_26008":116448,"_2720":116616},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3227":68111,"_28586":68058,"_19790":116618,"_5":13558,"_26008":116448,"_2720":116619},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3227":68112,"_28586":68058,"_19790":116621,"_5":13558,"_26008":116448,"_2720":116622},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3227":68113,"_28586":68058,"_19790":116624,"_5":13558,"_26008":116452,"_2720":116625},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3227":68114,"_28586":68058,"_19790":116627,"_5":13558,"_26008":116452,"_2720":116628},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3227":68115,"_28586":68058,"_19790":116630,"_5":13558,"_26008":116452,"_2720":116631},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3227":68116,"_28586":68058,"_19790":116633,"_5":13558,"_26008":116452,"_2720":116634},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3227":68117,"_28586":68058,"_19790":116636,"_5":13558,"_26008":116452,"_2720":116637},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3227":68118,"_28586":68058,"_19790":116639,"_5":13558,"_26008":116456,"_2720":116640},[],"Cambio",{"_3227":68119,"_28586":68058,"_19790":116642,"_5":13558,"_26008":116456,"_2720":116643},[],"A quién afecta",{"_3227":68120,"_28586":68058,"_19790":116645,"_5":13558,"_26008":116456,"_2720":116646},[],"Gravedad",{"_3227":68121,"_28586":68058,"_19790":116648,"_5":13558,"_26008":116456,"_2720":115267},[],{"_3227":68122,"_28586":68058,"_19790":116650,"_5":13558,"_26008":116456,"_2720":116464},[],{"_3227":68123,"_28586":68058,"_19790":116652,"_5":13558,"_26008":116456,"_2720":116653},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3227":68124,"_28586":68058,"_19790":116655,"_5":13558,"_26008":116456,"_2720":116656},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3227":68125,"_28586":68058,"_19790":116658,"_5":13558,"_26008":116456,"_2720":116659},[],"Copiar los datos a los volúmenes nuevos",{"_3227":68126,"_28586":68058,"_19790":116661,"_5":13558,"_26008":116456,"_2720":116468},[],{"_3227":68127,"_28586":68058,"_19790":116663,"_5":13558,"_26008":116456,"_2720":116664},[],"Todas las releases de Helm",{"_3227":68128,"_28586":68058,"_19790":116666,"_5":13558,"_26008":116456,"_2720":116667},[],"Alta: `helm upgrade` falla",{"_3227":68129,"_28586":68058,"_19790":116669,"_5":13558,"_26008":116456,"_2720":116670},[],"Eliminar o renombrar las claves heredadas",{"_3227":68130,"_28586":68058,"_19790":116672,"_5":13558,"_26008":116456,"_2720":116472},[],{"_3227":68131,"_28586":68058,"_19790":116674,"_5":13558,"_26008":116456,"_2720":116675},[],"Todos los despliegues",{"_3227":68132,"_28586":68058,"_19790":116677,"_5":13558,"_26008":116456,"_2720":116678},[],"Alta: sin principal de bootstrap no hay administrador",{"_3227":68133,"_28586":68058,"_19790":116680,"_5":13558,"_26008":116456,"_2720":116681},[],"Configurar `services.authz`",{"_3227":68134,"_28586":68058,"_19790":116683,"_5":13558,"_26008":116456,"_2720":116476},[],{"_3227":68135,"_28586":68058,"_19790":116685,"_5":13558,"_26008":116456,"_2720":116664},[],{"_3227":68136,"_28586":68058,"_19790":116687,"_5":13558,"_26008":116456,"_2720":116688},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3227":68137,"_28586":68058,"_19790":116690,"_5":13558,"_26008":116456,"_2720":116691},[],"Mover JWKS y roles a `services.authz`",{"_3227":68138,"_28586":68058,"_19790":116693,"_5":13558,"_26008":116456,"_2720":116496},[],{"_3227":68139,"_28586":68058,"_19790":116695,"_5":13558,"_26008":116456,"_2720":116696},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3227":68140,"_28586":68058,"_19790":116698,"_5":13558,"_26008":116456,"_2720":116699},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3227":68141,"_28586":68058,"_19790":116701,"_5":13558,"_26008":116456,"_2720":116702},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3227":68142,"_28586":68058,"_19790":116704,"_5":13558,"_26008":116456,"_2720":116500},[],{"_3227":68143,"_28586":68058,"_19790":116706,"_5":13558,"_26008":116456,"_2720":116707},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3227":68144,"_28586":68058,"_19790":116709,"_5":13558,"_26008":116456,"_2720":116710},[],"Alta: el backend ya no arranca con ellos",{"_3227":68145,"_28586":68058,"_19790":116712,"_5":13558,"_26008":116456,"_2720":116713},[],"Pasar a PostgreSQL antes de actualizar",{"_3227":68146,"_28586":68058,"_19790":116715,"_5":13558,"_26008":116456,"_2720":116716},[],"Webhooks con referencias a archivos",{"_3227":68147,"_28586":68058,"_19790":116718,"_5":13558,"_26008":116456,"_2720":116719},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3227":68148,"_28586":68058,"_19790":116721,"_5":13558,"_26008":116456,"_2720":116722},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3227":68149,"_28586":68058,"_19790":116724,"_5":13558,"_26008":116456,"_2720":116725},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3227":68150,"_28586":68058,"_19790":116727,"_5":13558,"_26008":116456,"_2720":116480},[],{"_3227":68151,"_28586":68058,"_19790":116729,"_5":13558,"_26008":116456,"_2720":116730},[],"Releases con identidades por servicio o material de claves montado",{"_3227":68152,"_28586":68058,"_19790":116732,"_5":13558,"_26008":116456,"_2720":116733},[],"Media: los servicios no pueden leer sus archivos",{"_3227":68153,"_28586":68058,"_19790":116735,"_5":13558,"_26008":116456,"_2720":116736},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3227":68154,"_28586":68058,"_19790":116738,"_5":13558,"_26008":116456,"_2720":116484},[],{"_3227":68155,"_28586":68058,"_19790":116740,"_5":13558,"_26008":116456,"_2720":116741},[],"Releases que definen `amqp.tls`",{"_3227":68156,"_28586":68058,"_19790":116743,"_5":13558,"_26008":116456,"_2720":116744},[],"Media: los clientes se conectan al puerto equivocado",{"_3227":68157,"_28586":68058,"_19790":116746,"_5":13558,"_26008":116456,"_2720":116747},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3227":68158,"_28586":68058,"_19790":116749,"_5":13558,"_26008":116456,"_2720":116504},[],{"_3227":68159,"_28586":68058,"_19790":116751,"_5":13558,"_26008":116456,"_2720":116752},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3227":68160,"_28586":68058,"_19790":116754,"_5":13558,"_26008":116456,"_2720":116755},[],"Media: las claves de CA quedan sin gestionar",{"_3227":68161,"_28586":68058,"_19790":116757,"_5":13558,"_26008":116456,"_2720":116758},[],"Ejecutar la migración de CA a KMS",{"_3227":68162,"_28586":68058,"_19790":116760,"_5":13558,"_26008":116456,"_2720":116761},[],"Verificación del certificado del receptor",{"_3227":68163,"_28586":68058,"_19790":116763,"_5":13558,"_26008":116456,"_2720":116764},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3227":68164,"_28586":68058,"_19790":116766,"_5":13558,"_26008":116456,"_2720":116767},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3227":68165,"_28586":68058,"_19790":116769,"_5":13558,"_26008":116456,"_2720":116770},[],"Poner `insecure_skip_verify` a `false`",{"_3227":68166,"_28586":68058,"_19790":116772,"_5":13558,"_26008":116456,"_2720":116516},[],{"_3227":68167,"_28586":68058,"_19790":116774,"_5":13558,"_26008":116456,"_2720":116775},[],"Scripts y consolas que editan DMS por API",{"_3227":68168,"_28586":68058,"_19790":116777,"_5":13558,"_26008":116456,"_2720":116778},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3227":68169,"_28586":68058,"_19790":116780,"_5":13558,"_26008":116456,"_2720":116781},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3227":68170,"_28586":68058,"_19790":116783,"_5":13558,"_26008":116456,"_2720":116532},[],{"_3227":68171,"_28586":68058,"_19790":116785,"_5":13558,"_26008":116456,"_2720":116786},[],"Consumidores que leen el campo `events` del dispositivo",{"_3227":68172,"_28586":68058,"_19790":116788,"_5":13558,"_26008":116456,"_2720":116789},[],"Media: el campo desaparece",{"_3227":68173,"_28586":68058,"_19790":116791,"_5":13558,"_26008":116456,"_2720":116792},[],"Usar los nuevos endpoints de eventos",{"_3227":68174,"_28586":68058,"_19790":116794,"_5":13558,"_26008":116456,"_2720":116488},[],{"_3227":68175,"_28586":68058,"_19790":116796,"_5":13558,"_26008":116456,"_2720":116797},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3227":68176,"_28586":68058,"_19790":116799,"_5":13558,"_26008":116456,"_2720":116800},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3227":68177,"_28586":68058,"_19790":116802,"_5":13558,"_26008":116456,"_2720":116803},[],"Actualizar el archivo de values",{"_3227":68178,"_28586":68058,"_19790":116805,"_5":13558,"_26008":116456,"_2720":116524},[],{"_3227":68179,"_28586":68058,"_19790":116807,"_5":13558,"_26008":116456,"_2720":116808},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3227":68180,"_28586":68058,"_19790":116810,"_5":13558,"_26008":116456,"_2720":116811},[],"Baja: prevalece el ID de la URL",{"_3227":68181,"_28586":68058,"_19790":116813,"_5":13558,"_26008":116456,"_2720":116814},[],"Enviar el ID en la URL",{"_3227":68182,"_28586":68058,"_19790":116816,"_5":13558,"_26008":116456,"_2720":116528},[],{"_3227":68183,"_28586":68058,"_19790":116818,"_5":13558,"_26008":116456,"_2720":116819},[],"Consumidores que comparan el `type` del certificado",{"_3227":68184,"_28586":68058,"_19790":116821,"_5":13558,"_26008":116456,"_2720":116822},[],"Baja: dos valores cambian de nombre",{"_3227":68185,"_28586":68058,"_19790":116824,"_5":13558,"_26008":116456,"_2720":116825},[],"Adaptar los consumidores",{"_3227":68186,"_28586":68058,"_19790":116827,"_5":13558,"_26008":116456,"_2720":116520},[],{"_3227":68187,"_28586":68058,"_19790":116829,"_5":13558,"_26008":116456,"_2720":116830},[],"Cualquier DMS",{"_3227":68188,"_28586":68058,"_19790":116832,"_5":13558,"_26008":116456,"_2720":116833},[],"Baja: solo informativo",{"_3227":68189,"_28586":68058,"_19790":116835,"_5":13558,"_26008":116456,"_2720":116836},[],"Revisar ambos bloques antes de editar",{"_3227":68190,"_28586":68058,"_19790":116838,"_5":13558,"_26008":116463,"_2720":116839},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3227":68191,"_28586":68058,"_19790":116841,"_5":13558,"_26008":116463,"_2720":116842},[],"El paso 4 de la guía de migración copia los datos.",{"_3227":68192,"_28586":68058,"_19790":116844,"_5":13558,"_26008":116467,"_2720":116845},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3227":68193,"_28586":68058,"_19790":116847,"_5":13558,"_26008":116471,"_2720":116848},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3227":68194,"_28586":68058,"_19790":116850,"_5":13558,"_26008":116475,"_2720":116851},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3227":68195,"_28586":68058,"_19790":116853,"_5":13558,"_26008":116479,"_2720":116854},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3227":68196,"_28586":68058,"_19790":116856,"_5":13558,"_26008":116479,"_2720":116857},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3227":68197,"_28586":68058,"_19790":116859,"_5":13558,"_26008":116483,"_2720":116860},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3227":68198,"_28586":68058,"_19790":116862,"_5":13558,"_26008":116487,"_2720":116863},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3227":68199,"_28586":68058,"_19790":116865,"_5":13558,"_26008":116487,"_2720":116866},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3227":68200,"_28586":68058,"_19790":116868,"_5":13558,"_26008":116487,"_2720":116869},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3227":68201,"_28586":68058,"_19790":116871,"_5":13558,"_26008":116487,"_2720":116872},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3227":68202,"_28586":68058,"_19790":116874,"_5":13558,"_26008":116487,"_2720":116875},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3227":68203,"_28586":68058,"_19790":116877,"_5":13558,"_26008":116487,"_2720":116878},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3227":68204,"_28586":68058,"_19790":116880,"_5":13558,"_26008":116495,"_2720":116881},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3227":68205,"_28586":68058,"_19790":116883,"_5":13558,"_26008":116495,"_2720":116884},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3227":68206,"_28586":68058,"_19790":116886,"_5":13558,"_26008":116495,"_2720":116887},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3227":68207,"_28586":68058,"_19790":116889,"_5":13558,"_26008":116495,"_2720":116890},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3227":68208,"_28586":68058,"_19790":116892,"_5":13558,"_26008":116495,"_2720":116893},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3227":68209,"_28586":68058,"_19790":116895,"_5":13558,"_26008":116499,"_2720":116896},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3227":68210,"_28586":68058,"_19790":116898,"_5":13558,"_26008":116503,"_2720":116899},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3227":68211,"_28586":68058,"_19790":116901,"_5":13558,"_26008":116503,"_2720":116902},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3227":68212,"_28586":68058,"_19790":116904,"_5":13558,"_26008":116503,"_2720":116905},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3227":68213,"_28586":68058,"_19790":116907,"_5":13558,"_26008":116503,"_2720":116908},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3227":68214,"_28586":68058,"_19790":116910,"_5":13558,"_26008":116503,"_2720":116911},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3227":68215,"_28586":68058,"_19790":116913,"_5":13558,"_26008":116503,"_2720":116914},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3227":68216,"_28586":68058,"_19790":116916,"_5":13558,"_26008":116511,"_2720":116917},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3227":68217,"_28586":68058,"_19790":116919,"_5":13558,"_26008":116511,"_2720":116920},[],"Campo en 3.8.0",{"_3227":68218,"_28586":68058,"_19790":116922,"_5":13558,"_26008":116511,"_2720":116923},[],"Campo en 4.0.0",{"_3227":68219,"_28586":68058,"_19790":116925,"_5":13558,"_26008":116511,"_2720":54515},[],{"_3227":68220,"_28586":68058,"_19790":116927,"_5":13558,"_26008":116511,"_2720":116928},[],"`insecure_skip_verify` (con el valor negado)",{"_3227":68221,"_28586":68058,"_19790":116930,"_5":13558,"_26008":116511,"_2720":54521},[],{"_3227":68222,"_28586":68058,"_19790":116932,"_5":13558,"_26008":116511,"_2720":54524},[],{"_3227":68223,"_28586":68058,"_19790":116934,"_5":13558,"_26008":116511,"_2720":54527},[],{"_3227":68224,"_28586":68058,"_19790":116936,"_5":13558,"_26008":116511,"_2720":54530},[],{"_3227":68225,"_28586":68058,"_19790":116938,"_5":13558,"_26008":116511,"_2720":54533},[],{"_3227":68226,"_28586":68058,"_19790":116940,"_5":13558,"_26008":116511,"_2720":54536},[],{"_3227":68227,"_28586":68058,"_19790":116942,"_5":13558,"_26008":116511,"_2720":116943},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3227":68228,"_28586":68058,"_19790":116945,"_5":13558,"_26008":116511,"_2720":116946},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3227":68229,"_28586":68058,"_19790":116948,"_5":13558,"_26008":116511,"_2720":116949},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3227":68230,"_28586":68058,"_19790":116951,"_5":13558,"_26008":116515,"_2720":116952},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3227":68231,"_28586":68058,"_19790":116954,"_5":13558,"_26008":116515,"_2720":116955},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3227":68232,"_28586":68058,"_19790":116957,"_5":13558,"_26008":116515,"_2720":116958},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3227":68233,"_28586":68058,"_19790":116960,"_5":13558,"_26008":116519,"_2720":116961},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3227":68234,"_28586":68058,"_19790":116963,"_5":13558,"_26008":116523,"_2720":116964},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3227":68235,"_28586":68058,"_19790":116966,"_5":13558,"_26008":116527,"_2720":116967},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3227":68236,"_28586":68058,"_19790":116969,"_5":13558,"_26008":116531,"_2720":116970},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3227":68237,"_28586":68058,"_19790":116972,"_5":13558,"_26008":116531,"_2720":116973},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3227":68238,"_28586":68058,"_19790":116975,"_5":13558,"_26008":116531,"_2720":116976},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3227":68239,"_28586":68058,"_19790":116978,"_5":13558,"_26008":116531,"_2720":116979},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3227":68240,"_28586":68058,"_19790":116981,"_5":13558,"_26008":116535,"_2720":116982},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3227":68241,"_28586":68058,"_19790":116984,"_5":13558,"_26008":116539,"_2720":116985},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3227":68242,"_28586":68058,"_19790":116987,"_5":13558,"_26008":116539,"_2720":116988},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3227":68243,"_28586":68058,"_19790":116990,"_5":13558,"_26008":116539,"_2720":116991},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3227":68244,"_28586":68058,"_19790":116993,"_5":13558,"_26008":116539,"_2720":116994},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3227":68245,"_28586":68058,"_19790":116996,"_5":13558,"_26008":116539,"_2720":116997},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3227":68246,"_28586":68058,"_19790":116999,"_5":13558,"_26008":116543,"_2720":117000},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3227":68247,"_28586":68058,"_19790":117002,"_5":13558,"_26008":116543,"_2720":117003},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3227":68248,"_28586":68058,"_19790":117005,"_5":13558,"_26008":116543,"_2720":117006},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3227":68249,"_28586":68058,"_19790":117008,"_5":13558,"_26008":116543,"_2720":117009},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3227":68250,"_28586":68058,"_19790":117011,"_5":13558,"_26008":116543,"_2720":117012},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3227":68251,"_28586":68058,"_19790":117014,"_5":13558,"_26008":116543,"_2720":117015},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3227":68252,"_28586":68058,"_19790":117017,"_5":13558,"_26008":116543,"_2720":117018},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3227":68253,"_28586":68058,"_19790":117020,"_5":13558,"_26008":116543,"_2720":117021},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3227":68254,"_28586":68058,"_19790":117023,"_5":13558,"_26008":116543,"_2720":117024},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3227":68255,"_28586":68058,"_19790":117026,"_5":13558,"_26008":116543,"_2720":117027},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3227":68256,"_28586":68058,"_19790":117029,"_5":13558,"_26008":116543,"_2720":117030},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3227":68257,"_28586":68058,"_19790":117032,"_5":13558,"_26008":116543,"_2720":117033},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3227":68258,"_28586":68058,"_19790":117035,"_5":13558,"_26008":116547,"_2720":117036},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3227":68259,"_28586":68058,"_19790":117038,"_5":13558,"_26008":116547,"_2720":117039},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3227":68260,"_28586":68058,"_19790":117041,"_5":13558,"_26008":116551,"_2720":117042},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3227":68261,"_28586":68058,"_19790":117044,"_5":13558,"_26008":116551,"_2720":117045},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3227":68262,"_28586":68058,"_19790":117047,"_5":13558,"_26008":116551,"_2720":117048},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3227":68263,"_28586":68058,"_19790":117050,"_5":13558,"_26008":116551,"_2720":117051},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3227":68264,"_28586":68058,"_19790":117053,"_5":13558,"_26008":116551,"_2720":117054},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3227":68265,"_28586":68058,"_19790":117056,"_5":13558,"_26008":116551,"_2720":117057},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3227":68266,"_28586":68058,"_19790":117059,"_5":13558,"_26008":116551,"_2720":117060},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3227":68267,"_28586":68058,"_19790":117062,"_5":13558,"_26008":116551,"_2720":117063},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3227":68268,"_28586":68058,"_19790":117065,"_5":13558,"_26008":116551,"_2720":117066},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3227":68269,"_28586":68058,"_19790":117068,"_5":13558,"_26008":116551,"_2720":117069},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3227":68270,"_28586":68058,"_19790":117071,"_5":13558,"_26008":116551,"_2720":117072},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3227":68271,"_28586":68058,"_19790":117074,"_5":13558,"_26008":116555,"_2720":117075},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3227":68272,"_28586":68058,"_19790":117077,"_5":13558,"_26008":116555,"_2720":117078},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3227":68273,"_28586":68058,"_19790":117080,"_5":13558,"_26008":116559,"_2720":117081},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3227":68274,"_28586":68058,"_19790":117083,"_5":13558,"_26008":116559,"_2720":117084},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3227":68275,"_28586":68058,"_19790":117086,"_5":13558,"_26008":116559,"_2720":117087},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3227":68276,"_28586":68058,"_19790":117089,"_5":13558,"_26008":116559,"_2720":117090},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3227":68277,"_28586":68058,"_19790":117092,"_5":13558,"_26008":116559,"_2720":117093},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3227":68278,"_28586":68058,"_19790":117095,"_5":13558,"_26008":116563,"_2720":117096},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3227":68279,"_28586":68058,"_19790":117098,"_5":13558,"_26008":116563,"_2720":117099},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3227":68280,"_28586":68058,"_19790":117101,"_5":13558,"_26008":116563,"_2720":117102},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3227":68281,"_28586":68058,"_19790":117104,"_5":13558,"_26008":116563,"_2720":117105},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3227":68282,"_28586":68058,"_19790":117107,"_5":13558,"_26008":116563,"_2720":117108},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3227":68283,"_28586":68058,"_19790":117110,"_5":13558,"_26008":116563,"_2720":117111},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3227":68284,"_28586":68058,"_19790":117113,"_5":13558,"_26008":116563,"_2720":117114},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3227":68285,"_28586":68058,"_19790":117116,"_5":13558,"_26008":116566,"_2720":117117},[],"Tras la actualización, comprueba en este orden:",{"_3227":68286,"_28586":68058,"_19790":117119,"_5":13558,"_26008":116566,"_2720":117120},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3227":68287,"_28586":68058,"_19790":117122,"_5":13558,"_26008":116566,"_2720":117123},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3227":68288,"_28586":68058,"_19790":117125,"_5":13558,"_26008":116566,"_2720":117126},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3227":68289,"_28586":68058,"_19790":117128,"_5":13558,"_26008":116566,"_2720":117129},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3227":68290,"_28586":68058,"_19790":117131,"_5":13558,"_26008":116566,"_2720":117132},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3227":68291,"_28586":68058,"_19790":117134,"_5":13558,"_26008":116566,"_2720":117135},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3227":68292,"_28586":68058,"_19790":117137,"_5":13558,"_26008":116566,"_2720":117138},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3227":68293,"_28586":68058,"_19790":117140,"_5":13558,"_26008":116566,"_2720":117141},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3227":68294,"_28586":68058,"_19790":117143,"_5":13558,"_26008":116566,"_2720":117144},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3227":68295,"_28586":68058,"_19790":117146,"_5":13558,"_26008":116566,"_2720":117147},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3227":68296,"_28586":68058,"_19790":117149,"_5":13558,"_26008":116566,"_2720":117150},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3227":68297,"_28586":68058,"_19790":117152,"_5":13558,"_26008":116566,"_2720":117153},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3227":68298,"_28586":68058,"_19790":117155,"_5":13558,"_26008":116566,"_2720":117156},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3227":68299,"_28586":68058,"_19790":117158,"_5":13558,"_26008":116566,"_2720":117159},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3227":68300,"_28586":68058,"_19790":117161,"_5":13558,"_26008":116570,"_2720":117162},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3227":68301,"_28586":68058,"_19790":117164,"_5":13558,"_26008":116570,"_2720":117165},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3227":68302,"_28586":68058,"_19790":117167,"_5":13558,"_26008":116570,"_2720":117168},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3227":68303,"_28586":68058,"_19790":117170,"_5":13558,"_26008":116570,"_2720":117171},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3227":68304,"_28586":68058,"_19790":117173,"_5":13558,"_26008":116570,"_2720":117174},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_54773":117176,"_54775":117177,"_54777":117178,"_54779":117179,"_17152":2742,"_65598":2742},"spanish",[2720,28586,5,26008],{"_2720":23659,"_28586":23659,"_5":23659,"_26008":23659},{"_2720":117180,"_28586":119883,"_5":122586,"_26008":125289},{"_4350":117181,"_54783":117182,"_5":23659},{"_13640":5436,"_14015":7075,"_14034":6200,"_12236":5460,"_14021":6966,"_18791":6869,"_13661":5445,"_13668":6508,"_27573":5864,"_27981":7110,"_28002":11499,"_27607":5381,"_32734":2830,"_27709":24822,"_28046":2769,"_32741":28105,"_32744":3511,"_32747":5623,"_32750":5435,"_28423":3194,"_32755":4307,"_32757":5437,"_28453":3046,"_14030":14874,"_32761":14917,"_32764":8356,"_32766":23077,"_28030":19105,"_28418":3679,"_28466":7146,"_32771":5457,"_32773":2796,"_32775":4467,"_27726":6553,"_32778":4830,"_32780":5912,"_32782":15297,"_32784":3207,"_32786":3095,"_27643":3414,"_32789":3059,"_32791":5442,"_27637":11120,"_28067":5893,"_32795":7035,"_32797":5239,