442,"_22829":92443,"_2311":92444},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2783":55721,"_24069":55717,"_5":24381,"_16893":92446,"_22829":92447,"_2311":92448},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2783":55722,"_24069":55717,"_5":24381,"_16893":92450,"_22829":92451,"_2311":92452},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2783":55723,"_24069":55717,"_5":24381,"_16893":92454,"_22829":92455,"_2311":92456},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2783":55724,"_24069":55717,"_5":24381,"_16893":92458,"_22829":92459,"_2311":92460},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2783":55725,"_24069":55717,"_5":24381,"_16893":92462,"_22829":92463,"_2311":92464},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2783":55726,"_24069":55717,"_16893":92466,"_5":16788,"_22829":55717,"_2311":92467},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2783":55727,"_24069":55717,"_16893":92469,"_5":16788,"_22829":92439,"_2311":92470},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2783":55728,"_24069":55717,"_16893":92472,"_5":16788,"_22829":92439,"_2311":92473},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2783":55729,"_24069":55717,"_16893":92475,"_5":16788,"_22829":92439,"_2311":92476},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2783":55730,"_24069":55717,"_16893":92478,"_5":16788,"_22829":92443,"_2311":92479},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2783":55731,"_24069":55717,"_16893":92481,"_5":16788,"_22829":92443,"_2311":92482},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2783":55732,"_24069":55717,"_16893":92484,"_5":16788,"_22829":92443,"_2311":92485},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2783":55733,"_24069":55717,"_16893":92487,"_5":16788,"_22829":92447,"_2311":92488},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2783":55734,"_24069":55717,"_16893":92490,"_5":16788,"_22829":92451,"_2311":92491},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2783":55735,"_24069":55717,"_16893":92493,"_5":16788,"_22829":92455,"_2311":92494},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2783":55736,"_24069":55717,"_16893":92496,"_5":16788,"_22829":92459,"_2311":92497},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2783":55737,"_24069":55717,"_16893":92499,"_5":16788,"_22829":92463,"_2311":92500},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2783":55738,"_24069":55738,"_5":11891,"_2311":92502,"_24384":92503,"_16893":92504,"_22829":55738},"Despliega Lamassu",[39305,92431],[],{"_2783":55739,"_24069":55738,"_16893":92506,"_5":16788,"_22829":55738,"_2311":92507},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2783":55740,"_24069":55738,"_5":24381,"_16893":92509,"_22829":92510,"_2311":92511},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2783":55741,"_24069":55738,"_5":24381,"_16893":92513,"_22829":92514,"_2311":92515},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2783":55742,"_24069":55738,"_5":24381,"_16893":92517,"_22829":92518,"_2311":92519},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2783":55743,"_24069":55738,"_16893":92521,"_5":16788,"_22829":55738,"_2311":92522},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2783":55744,"_24069":55738,"_16893":92524,"_5":16788,"_22829":92510,"_2311":92525},[],"Modelo",{"_2783":55745,"_24069":55738,"_16893":92527,"_5":16788,"_22829":92510,"_2311":92528},[],"Recomendado para",{"_2783":55746,"_24069":55738,"_16893":92530,"_5":16788,"_22829":92510,"_2311":92531},[],"Quién opera la infraestructura",{"_2783":55747,"_24069":55738,"_16893":92533,"_5":16788,"_22829":92510,"_2311":92534},[],"Punto de partida",{"_2783":55748,"_24069":55738,"_16893":92536,"_5":16788,"_22829":92510,"_2311":39412},[],{"_2783":55749,"_24069":55738,"_16893":92538,"_5":16788,"_22829":92510,"_2311":92539},[],"Producción, entornos regulados y despliegues personalizados",{"_2783":55750,"_24069":55738,"_16893":92541,"_5":16788,"_22829":92510,"_2311":92542},[],"Tu equipo",{"_2783":55751,"_24069":55738,"_16893":92544,"_5":16788,"_22829":92510,"_2311":92545},[],"Helm o Fastlane",{"_2783":55752,"_24069":55738,"_16893":92547,"_5":16788,"_22829":92510,"_2311":39424},[],{"_2783":55753,"_24069":55738,"_16893":92549,"_5":16788,"_22829":92510,"_2311":92550},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2783":55754,"_24069":55738,"_16893":92552,"_5":16788,"_22829":92510,"_2311":92542},[],{"_2783":55755,"_24069":55738,"_16893":92554,"_5":16788,"_22829":92510,"_2311":92555},[],"Imagen preconfigurada en EC2",{"_2783":55756,"_24069":55738,"_16893":92557,"_5":16788,"_22829":92510,"_2311":39435},[],{"_2783":55757,"_24069":55738,"_16893":92559,"_5":16788,"_22829":92510,"_2311":92560},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2783":55758,"_24069":55738,"_16893":92562,"_5":16788,"_22829":92510,"_2311":39441},[],{"_2783":55759,"_24069":55738,"_16893":92564,"_5":16788,"_22829":92510,"_2311":92565},[],"Suscripción gestionada",{"_2783":55760,"_24069":55738,"_16893":92567,"_5":16788,"_22829":92510,"_2311":92568},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2783":55761,"_24069":55738,"_16893":92570,"_5":16788,"_22829":92510,"_2311":92571},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2783":55762,"_24069":55738,"_16893":92573,"_5":16788,"_22829":92510,"_2311":92574},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2783":55763,"_24069":55738,"_16893":92576,"_5":16788,"_22829":92514,"_2311":92577},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2783":55764,"_24069":55738,"_16893":92579,"_5":16788,"_22829":92518,"_2311":92580},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2783":55765,"_24069":55765,"_5":11891,"_2311":92582,"_24384":92583,"_16893":92584,"_22829":55765},"Utiliza Lamassu como SaaS",[39305,92431,92432],[],{"_2783":55766,"_24069":55765,"_16893":92586,"_5":16788,"_22829":55765,"_2311":92587},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2783":55767,"_24069":55765,"_5":24381,"_16893":92589,"_22829":92590,"_2311":92591},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2783":55768,"_24069":55765,"_5":24381,"_16893":92593,"_22829":92594,"_2311":92595},[],"/docs/es/deployment/saas#planes","Planes",{"_2783":55769,"_24069":55765,"_5":24381,"_16893":92597,"_22829":92598,"_2311":92599},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2783":55770,"_24069":55765,"_16893":92601,"_5":16788,"_22829":55765,"_2311":92602},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2783":55771,"_24069":55765,"_16893":92604,"_5":16788,"_22829":92590,"_2311":92605},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2783":55772,"_24069":55765,"_16893":92607,"_5":16788,"_22829":92590,"_2311":92608},[],"Copias de seguridad automáticas.",{"_2783":55773,"_24069":55765,"_16893":92610,"_5":16788,"_22829":92590,"_2311":92611},[],"Actualizaciones de versión.",{"_2783":55774,"_24069":55765,"_16893":92613,"_5":16788,"_22829":92590,"_2311":92614},[],"Soporte técnico y SLA según el plan contratado.",{"_2783":55775,"_24069":55765,"_16893":92616,"_5":16788,"_22829":92594,"_2311":39496},[],{"_2783":55776,"_24069":55765,"_16893":92618,"_5":16788,"_22829":92594,"_2311":92619},[],"Dispositivos",{"_2783":55777,"_24069":55765,"_16893":92621,"_5":16788,"_22829":92594,"_2311":92622},[],"Soporte",{"_2783":55778,"_24069":55765,"_16893":92624,"_5":16788,"_22829":92594,"_2311":39505},[],{"_2783":55779,"_24069":55765,"_16893":92626,"_5":16788,"_22829":92594,"_2311":39508},[],{"_2783":55780,"_24069":55765,"_16893":92628,"_5":16788,"_22829":92594,"_2311":92629},[],"Hasta 1.000",{"_2783":55781,"_24069":55765,"_16893":92631,"_5":16788,"_22829":92594,"_2311":39514},[],{"_2783":55782,"_24069":55765,"_16893":92633,"_5":16788,"_22829":92594,"_2311":92634},[],"99,5 %",{"_2783":55783,"_24069":55765,"_16893":92636,"_5":16788,"_22829":92594,"_2311":39520},[],{"_2783":55784,"_24069":55765,"_16893":92638,"_5":16788,"_22829":92594,"_2311":92639},[],"Hasta 10.000",{"_2783":55785,"_24069":55765,"_16893":92641,"_5":16788,"_22829":92594,"_2311":92642},[],"Email y chat",{"_2783":55786,"_24069":55765,"_16893":92644,"_5":16788,"_22829":92594,"_2311":92645},[],"99,9 %",{"_2783":55787,"_24069":55765,"_16893":92647,"_5":16788,"_22829":92594,"_2311":39532},[],{"_2783":55788,"_24069":55765,"_16893":92649,"_5":16788,"_22829":92594,"_2311":92650},[],"Ilimitados",{"_2783":55789,"_24069":55765,"_16893":92652,"_5":16788,"_22829":92594,"_2311":92653},[],"Dedicado",{"_2783":55790,"_24069":55765,"_16893":92655,"_5":16788,"_22829":92594,"_2311":92656},[],"99,99 %",{"_2783":55791,"_24069":55765,"_16893":92658,"_5":16788,"_22829":92598,"_2311":92659},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2783":55792,"_24069":55765,"_16893":92661,"_5":16788,"_22829":92598,"_2311":92662},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2783":55793,"_24069":55793,"_5":11891,"_2311":39549,"_24384":92664,"_16893":92666,"_22829":55793},[39305,92431,92665],"Kubernetes autogestionado",[],{"_2783":55794,"_24069":55793,"_16893":92668,"_5":16788,"_22829":55793,"_2311":92669},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2783":55795,"_24069":55793,"_5":24381,"_16893":92671,"_22829":92672,"_2311":92673},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2783":55796,"_24069":55793,"_5":24381,"_16893":92675,"_22829":92676,"_2311":92677},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2783":55797,"_24069":55793,"_5":24381,"_16893":92679,"_22829":92680,"_2311":92681},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2783":55798,"_24069":55793,"_5":24381,"_16893":92683,"_22829":92684,"_2311":92685},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2783":55799,"_24069":55793,"_5":24381,"_16893":92687,"_22829":92688,"_2311":92689},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2783":55800,"_24069":55793,"_5":24381,"_16893":92691,"_22829":92692,"_2311":92693},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2783":55801,"_24069":55793,"_5":24381,"_16893":92695,"_22829":92696,"_2311":92697},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2783":55802,"_24069":55793,"_5":24381,"_16893":92699,"_22829":92700,"_2311":92701},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2783":55803,"_24069":55793,"_5":24381,"_16893":92703,"_22829":92704,"_2311":92705},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2783":55804,"_24069":55793,"_5":24381,"_16893":92707,"_22829":92708,"_2311":92709},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2783":55805,"_24069":55793,"_16893":92711,"_5":16788,"_22829":92672,"_2311":92712},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2783":55806,"_24069":55793,"_16893":92714,"_5":16788,"_22829":92672,"_2311":92715},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2783":55807,"_24069":55793,"_16893":92717,"_5":16788,"_22829":92676,"_2311":92718},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2783":55808,"_24069":55793,"_16893":92720,"_5":16788,"_22829":92676,"_2311":92721},[],"Fastlane instala o configura",{"_2783":55809,"_24069":55793,"_16893":92723,"_5":16788,"_22829":92676,"_2311":92724},[],"Tú sigues proporcionando",{"_2783":55810,"_24069":55793,"_16893":92726,"_5":16788,"_22829":92676,"_2311":92727},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2783":55811,"_24069":55793,"_16893":92729,"_5":16788,"_22829":92676,"_2311":92730},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2783":55812,"_24069":55793,"_16893":92732,"_5":16788,"_22829":92676,"_2311":92733},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2783":55813,"_24069":55793,"_16893":92735,"_5":16788,"_22829":92676,"_2311":92736},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2783":55814,"_24069":55793,"_16893":92738,"_5":16788,"_22829":92676,"_2311":92739},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2783":55815,"_24069":55793,"_16893":92741,"_5":16788,"_22829":92676,"_2311":92742},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2783":55816,"_24069":55793,"_16893":92744,"_5":16788,"_22829":92676,"_2311":92745},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2783":55817,"_24069":55793,"_16893":92747,"_5":16788,"_22829":92676,"_2311":92748},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2783":55818,"_24069":55793,"_16893":92750,"_5":16788,"_22829":92676,"_2311":92751},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2783":55819,"_24069":55793,"_16893":92753,"_5":16788,"_22829":92680,"_2311":92754},[],"Necesitas:",{"_2783":55820,"_24069":55793,"_16893":92756,"_5":16788,"_22829":92680,"_2311":92757},[],"un clúster Kubernetes existente",{"_2783":55821,"_24069":55793,"_16893":92759,"_5":16788,"_22829":92680,"_2311":92760},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2783":55822,"_24069":55793,"_16893":92762,"_5":16788,"_22829":92680,"_2311":39647},[],{"_2783":55823,"_24069":55793,"_16893":92764,"_5":16788,"_22829":92680,"_2311":19088},[],{"_2783":55824,"_24069":55793,"_16893":92766,"_5":16788,"_22829":92680,"_2311":92767},[],"`jq` solo si usas `--sample-data`",{"_2783":55825,"_24069":55793,"_16893":92769,"_5":16788,"_22829":92680,"_2311":92770},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2783":55826,"_24069":55793,"_16893":92772,"_5":16788,"_22829":92680,"_2311":92773},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2783":55827,"_24069":55793,"_16893":92775,"_5":16788,"_22829":92680,"_2311":92776},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2783":55828,"_24069":55793,"_16893":92778,"_5":16788,"_22829":92684,"_2311":92779},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2783":55829,"_24069":55793,"_16893":92781,"_5":16788,"_22829":92684,"_2311":92782},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2783":55830,"_24069":55793,"_16893":92784,"_5":16788,"_22829":92688,"_2311":92785},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2783":55831,"_24069":55793,"_16893":92787,"_5":16788,"_22829":92688,"_2311":92788},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2783":55832,"_24069":55793,"_16893":92790,"_5":16788,"_22829":92688,"_2311":92791},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2783":55833,"_24069":55793,"_16893":92793,"_5":16788,"_22829":92688,"_2311":92794},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2783":55834,"_24069":55793,"_16893":92796,"_5":16788,"_22829":92692,"_2311":92797},[],"Opción",{"_2783":55835,"_24069":55793,"_16893":92799,"_5":16788,"_22829":92692,"_2311":92800},[],"Valor predeterminado",{"_2783":55836,"_24069":55793,"_16893":92802,"_5":16788,"_22829":92692,"_2311":92803},[],"Propósito",{"_2783":55837,"_24069":55793,"_16893":92805,"_5":16788,"_22829":92692,"_2311":39691},[],{"_2783":55838,"_24069":55793,"_16893":92807,"_5":16788,"_22829":92692,"_2311":39694},[],{"_2783":55839,"_24069":55793,"_16893":92809,"_5":16788,"_22829":92692,"_2311":92810},[],"Muestra la ayuda",{"_2783":55840,"_24069":55793,"_16893":92812,"_5":16788,"_22829":92692,"_2311":39700},[],{"_2783":55841,"_24069":55793,"_16893":92814,"_5":16788,"_22829":92692,"_2311":92815},[],"contexto actual",{"_2783":55842,"_24069":55793,"_16893":92817,"_5":16788,"_22829":92692,"_2311":92818},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2783":55843,"_24069":55793,"_16893":92820,"_5":16788,"_22829":92692,"_2311":39709},[],{"_2783":55844,"_24069":55793,"_16893":92822,"_5":16788,"_22829":92692,"_2311":5183},[],{"_2783":55845,"_24069":55793,"_16893":92824,"_5":16788,"_22829":92692,"_2311":92825},[],"Omite prompts y genera credenciales para las dependencias",{"_2783":55846,"_24069":55793,"_16893":92827,"_5":16788,"_22829":92692,"_2311":39717},[],{"_2783":55847,"_24069":55793,"_16893":92829,"_5":16788,"_22829":92692,"_2311":39720},[],{"_2783":55848,"_24069":55793,"_16893":92831,"_5":16788,"_22829":92692,"_2311":92832},[],"Namespace de la instalación",{"_2783":55849,"_24069":55793,"_16893":92834,"_5":16788,"_22829":92692,"_2311":39726},[],{"_2783":55850,"_24069":55793,"_16893":92836,"_5":16788,"_22829":92692,"_2311":39729},[],{"_2783":55851,"_24069":55793,"_16893":92838,"_5":16788,"_22829":92692,"_2311":92839},[],"Dominio usado por la UI, OIDC y el certificado",{"_2783":55852,"_24069":55793,"_16893":92841,"_5":16788,"_22829":92692,"_2311":39735},[],{"_2783":55853,"_24069":55793,"_16893":92843,"_5":16788,"_22829":92692,"_2311":12106},[],{"_2783":55854,"_24069":55793,"_16893":92845,"_5":16788,"_22829":92692,"_2311":92846},[],"Versión del chart de Lamassu",{"_2783":55855,"_24069":55793,"_16893":92848,"_5":16788,"_22829":92692,"_2311":39743},[],{"_2783":55856,"_24069":55793,"_16893":92850,"_5":16788,"_22829":92692,"_2311":39746},[],{"_2783":55857,"_24069":55793,"_16893":92852,"_5":16788,"_22829":92692,"_2311":92853},[],"Puerto del listener HTTPS",{"_2783":55858,"_24069":55793,"_16893":92855,"_5":16788,"_22829":92692,"_2311":39752},[],{"_2783":55859,"_24069":55793,"_16893":92857,"_5":16788,"_22829":92692,"_2311":39755},[],{"_2783":55860,"_24069":55793,"_16893":92859,"_5":16788,"_22829":92692,"_2311":92860},[],"Puerto del listener HTTP",{"_2783":55861,"_24069":55793,"_16893":92862,"_5":16788,"_22829":92692,"_2311":39761},[],{"_2783":55862,"_24069":55793,"_16893":92864,"_5":16788,"_22829":92692,"_2311":39694},[],{"_2783":55863,"_24069":55793,"_16893":92866,"_5":16788,"_22829":92692,"_2311":92867},[],"Certificado PEM para TLS downstream",{"_2783":55864,"_24069":55793,"_16893":92869,"_5":16788,"_22829":92692,"_2311":39769},[],{"_2783":55865,"_24069":55793,"_16893":92871,"_5":16788,"_22829":92692,"_2311":39694},[],{"_2783":55866,"_24069":55793,"_16893":92873,"_5":16788,"_22829":92692,"_2311":92874},[],"Clave privada PEM para TLS downstream",{"_2783":55867,"_24069":55793,"_16893":92876,"_5":16788,"_22829":92692,"_2311":39777},[],{"_2783":55868,"_24069":55793,"_16893":92878,"_5":16788,"_22829":92692,"_2311":92879},[],"chart del repositorio",{"_2783":55869,"_24069":55793,"_16893":92881,"_5":16788,"_22829":92692,"_2311":92882},[],"Usa un chart local de Lamassu sin empaquetar",{"_2783":55870,"_24069":55793,"_16893":92884,"_5":16788,"_22829":92692,"_2311":39786},[],{"_2783":55871,"_24069":55793,"_16893":92886,"_5":16788,"_22829":92692,"_2311":92887},[],"detección automática",{"_2783":55872,"_24069":55793,"_16893":92889,"_5":16788,"_22829":92692,"_2311":92890},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2783":55873,"_24069":55793,"_16893":92892,"_5":16788,"_22829":92692,"_2311":39794},[],{"_2783":55874,"_24069":55793,"_16893":92894,"_5":16788,"_22829":92692,"_2311":5183},[],{"_2783":55875,"_24069":55793,"_16893":92896,"_5":16788,"_22829":92692,"_2311":92897},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2783":55876,"_24069":55793,"_16893":92899,"_5":16788,"_22829":92692,"_2311":39802},[],{"_2783":55877,"_24069":55793,"_16893":92901,"_5":16788,"_22829":92692,"_2311":5183},[],{"_2783":55878,"_24069":55793,"_16893":92903,"_5":16788,"_22829":92692,"_2311":92904},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2783":55879,"_24069":55793,"_16893":92906,"_5":16788,"_22829":92692,"_2311":39810},[],{"_2783":55880,"_24069":55793,"_16893":92908,"_5":16788,"_22829":92692,"_2311":5183},[],{"_2783":55881,"_24069":55793,"_16893":92910,"_5":16788,"_22829":92692,"_2311":92911},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2783":55882,"_24069":55793,"_16893":92913,"_5":16788,"_22829":92692,"_2311":39818},[],{"_2783":55883,"_24069":55793,"_16893":92915,"_5":16788,"_22829":92692,"_2311":39821},[],{"_2783":55884,"_24069":55793,"_16893":92917,"_5":16788,"_22829":92692,"_2311":92918},[],"Usa otro chart local de SoftHSM",{"_2783":55885,"_24069":55793,"_16893":92920,"_5":16788,"_22829":92692,"_2311":92921},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2783":55886,"_24069":55793,"_16893":92923,"_5":16788,"_22829":92696,"_2311":39830},[],{"_2783":55887,"_24069":55793,"_16893":92925,"_5":16788,"_22829":92696,"_2311":92926},[],"valida las herramientas locales y el clúster seleccionado",{"_2783":55888,"_24069":55793,"_16893":92928,"_5":16788,"_22829":92696,"_2311":92929},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2783":55889,"_24069":55793,"_16893":92931,"_5":16788,"_22829":92696,"_2311":92932},[],"crea el namespace",{"_2783":55890,"_24069":55793,"_16893":92934,"_5":16788,"_22829":92696,"_2311":92935},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2783":55891,"_24069":55793,"_16893":92937,"_5":16788,"_22829":92696,"_2311":92938},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2783":55892,"_24069":55793,"_16893":92940,"_5":16788,"_22829":92696,"_2311":92941},[],"instala RabbitMQ",{"_2783":55893,"_24069":55793,"_16893":92943,"_5":16788,"_22829":92696,"_2311":92944},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2783":55894,"_24069":55793,"_16893":92946,"_5":16788,"_22829":92696,"_2311":92947},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2783":55895,"_24069":55793,"_16893":92949,"_5":16788,"_22829":92696,"_2311":92950},[],"carga datos de ejemplo opcionalmente",{"_2783":55896,"_24069":55793,"_16893":92952,"_5":16788,"_22829":92696,"_2311":92953},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2783":55897,"_24069":55793,"_16893":92955,"_5":16788,"_22829":92700,"_2311":92956},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2783":55898,"_24069":55793,"_16893":92958,"_5":16788,"_22829":92700,"_2311":92959},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2783":55899,"_24069":55793,"_16893":92961,"_5":16788,"_22829":92704,"_2311":92962},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2783":55900,"_24069":55793,"_16893":92964,"_5":16788,"_22829":92704,"_2311":92965},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2783":55901,"_24069":55793,"_16893":92967,"_5":16788,"_22829":92704,"_2311":92968},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2783":55902,"_24069":55793,"_16893":92970,"_5":16788,"_22829":92708,"_2311":92971},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2783":55903,"_24069":55903,"_5":11891,"_2311":92973,"_24384":92974,"_16893":92975,"_22829":55903},"Instala con Helm",[39305,92431,92665],[],{"_2783":55904,"_24069":55903,"_16893":92977,"_5":16788,"_22829":55903,"_2311":92978},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2783":55905,"_24069":55903,"_5":24381,"_16893":92980,"_22829":92981,"_2311":92982},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2783":55906,"_24069":55903,"_5":24381,"_16893":92984,"_22829":92985,"_2311":92681},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2783":55907,"_24069":55903,"_5":24381,"_16893":92987,"_22829":92988,"_2311":92989},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2783":55908,"_24069":55903,"_5":24381,"_16893":92991,"_22829":92992,"_2311":92993},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2783":55909,"_24069":55903,"_5":24381,"_16893":92995,"_22829":92996,"_2311":92997},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2783":55910,"_24069":55903,"_5":24381,"_16893":92999,"_22829":93000,"_2311":93001},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2783":55911,"_24069":55903,"_5":24381,"_16893":93003,"_22829":93004,"_2311":93005},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2783":55912,"_24069":55903,"_5":24381,"_16893":93007,"_22829":93008,"_2311":93009},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2783":55913,"_24069":55903,"_5":24381,"_16893":93011,"_22829":93012,"_2311":93013},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2783":55914,"_24069":55903,"_16893":93015,"_5":16788,"_22829":92981,"_2311":93016},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2783":55915,"_24069":55903,"_16893":93018,"_5":16788,"_22829":92985,"_2311":93019},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2783":55916,"_24069":55903,"_16893":93021,"_5":16788,"_22829":92985,"_2311":93022},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2783":55917,"_24069":55903,"_16893":93024,"_5":16788,"_22829":92985,"_2311":93025},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2783":55918,"_24069":55903,"_16893":93027,"_5":16788,"_22829":92985,"_2311":93028},[],"un broker RabbitMQ accesible y sus credenciales",{"_2783":55919,"_24069":55903,"_16893":93030,"_5":16788,"_22829":92985,"_2311":93031},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2783":55920,"_24069":55903,"_16893":93033,"_5":16788,"_22829":92985,"_2311":93034},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2783":55921,"_24069":55903,"_16893":93036,"_5":16788,"_22829":92985,"_2311":93037},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2783":55922,"_24069":55903,"_16893":93039,"_5":16788,"_22829":92985,"_2311":93040},[],"una StorageClass y un diseño de tráfico externo",{"_2783":55923,"_24069":55903,"_16893":93042,"_5":16788,"_22829":92985,"_2311":93043},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2783":55924,"_24069":55903,"_16893":93045,"_5":16788,"_22829":92985,"_2311":93046},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2783":55925,"_24069":55903,"_16893":93048,"_5":16788,"_22829":92985,"_2311":93049},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2783":55926,"_24069":55903,"_16893":93051,"_5":16788,"_22829":92988,"_2311":93052},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2783":55927,"_24069":55903,"_16893":93054,"_5":16788,"_22829":92988,"_2311":93055},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2783":55928,"_24069":55903,"_16893":93057,"_5":16788,"_22829":92988,"_2311":93058},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2783":55929,"_24069":55903,"_16893":93060,"_5":16788,"_22829":92992,"_2311":93061},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2783":55930,"_24069":55903,"_16893":93063,"_5":16788,"_22829":92992,"_2311":93064},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2783":55931,"_24069":55903,"_16893":93066,"_5":16788,"_22829":92992,"_2311":93067},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2783":55932,"_24069":55903,"_16893":93069,"_5":16788,"_22829":92996,"_2311":93070},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2783":55933,"_24069":55903,"_16893":93072,"_5":16788,"_22829":93000,"_2311":93073},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2783":55934,"_24069":55903,"_16893":93075,"_5":16788,"_22829":93000,"_2311":93076},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2783":55935,"_24069":55903,"_16893":93078,"_5":16788,"_22829":93000,"_2311":93079},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2783":55936,"_24069":55903,"_16893":93081,"_5":16788,"_22829":93000,"_2311":93082},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2783":55937,"_24069":55903,"_16893":93084,"_5":16788,"_22829":93004,"_2311":93085},[],"Para instalar un checkout local:",{"_2783":55938,"_24069":55903,"_16893":93087,"_5":16788,"_22829":93008,"_2311":93088},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2783":55939,"_24069":55903,"_16893":93090,"_5":16788,"_22829":93008,"_2311":93091},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2783":55940,"_24069":55903,"_16893":93093,"_5":16788,"_22829":93012,"_2311":93094},[],"Antes de pasar a producción, revisa:",{"_2783":55941,"_24069":55903,"_16893":93096,"_5":16788,"_22829":93012,"_2311":93097},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2783":55942,"_24069":55903,"_16893":93099,"_5":16788,"_22829":93012,"_2311":93100},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2783":55943,"_24069":55903,"_16893":93102,"_5":16788,"_22829":93012,"_2311":93103},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2783":55944,"_24069":55903,"_16893":93105,"_5":16788,"_22829":93012,"_2311":93106},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2783":55945,"_24069":55903,"_16893":93108,"_5":16788,"_22829":93012,"_2311":93109},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2783":55946,"_24069":55903,"_16893":93111,"_5":16788,"_22829":93012,"_2311":93112},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2783":55947,"_24069":55903,"_16893":93114,"_5":16788,"_22829":93012,"_2311":93115},[],"SMTP, observabilidad y entrega de alertas",{"_2783":55948,"_24069":55903,"_16893":93117,"_5":16788,"_22829":93012,"_2311":93118},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2783":55949,"_24069":55903,"_16893":93120,"_5":16788,"_22829":93012,"_2311":93121},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2783":55950,"_24069":55950,"_5":11891,"_2311":93123,"_24384":93124,"_16893":93125,"_22829":55950},"Expón el Gateway",[39305,92431,92665],[],{"_2783":55951,"_24069":55950,"_16893":93127,"_5":16788,"_22829":55950,"_2311":93128},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2783":55952,"_24069":55950,"_5":24381,"_16893":93130,"_22829":93131,"_2311":93132},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2783":55953,"_24069":55950,"_5":24381,"_16893":93134,"_22829":93135,"_2311":93136},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2783":55954,"_24069":55950,"_5":24381,"_16893":93138,"_22829":93139,"_2311":93140},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2783":55955,"_24069":55950,"_5":24381,"_16893":93142,"_22829":93143,"_2311":40051},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_2783":55956,"_24069":55950,"_5":24381,"_16893":93145,"_22829":93146,"_2311":93147},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2783":55957,"_24069":55950,"_5":24381,"_16893":93149,"_22829":93150,"_2311":93151},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2783":55958,"_24069":55950,"_5":24381,"_16893":93153,"_22829":93154,"_2311":93155},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2783":55959,"_24069":55950,"_5":24381,"_16893":93157,"_22829":93158,"_2311":93159},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2783":55960,"_24069":55950,"_5":24381,"_16893":93161,"_22829":93162,"_2311":93163},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2783":55961,"_24069":55950,"_16893":93165,"_5":16788,"_22829":93131,"_2311":93166},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2783":55962,"_24069":55950,"_16893":93168,"_5":16788,"_22829":93131,"_2311":93169},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2783":55963,"_24069":55950,"_16893":93171,"_5":16788,"_22829":93135,"_2311":93172},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2783":55964,"_24069":55950,"_16893":93174,"_5":16788,"_22829":93135,"_2311":93175},[],"Defínelo únicamente cuando:",{"_2783":55965,"_24069":55950,"_16893":93177,"_5":16788,"_22829":93135,"_2311":93178},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2783":55966,"_24069":55950,"_16893":93180,"_5":16788,"_22829":93135,"_2311":93181},[],"esa dirección está asignada a este Gateway",{"_2783":55967,"_24069":55950,"_16893":93183,"_5":16788,"_22829":93135,"_2311":93184},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2783":55968,"_24069":55950,"_16893":93186,"_5":16788,"_22829":93135,"_2311":93187},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2783":55969,"_24069":55950,"_16893":93189,"_5":16788,"_22829":93135,"_2311":93190},[],"No confundas estos valores:",{"_2783":55970,"_24069":55950,"_16893":93192,"_5":16788,"_22829":93135,"_2311":93193},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2783":55971,"_24069":55950,"_16893":93195,"_5":16788,"_22829":93135,"_2311":93196},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2783":55972,"_24069":55950,"_16893":93198,"_5":16788,"_22829":93135,"_2311":93199},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2783":55973,"_24069":55950,"_16893":93201,"_5":16788,"_22829":93139,"_2311":93202},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2783":55974,"_24069":55950,"_16893":93204,"_5":16788,"_22829":93139,"_2311":93205},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2783":55975,"_24069":55950,"_16893":93207,"_5":16788,"_22829":93143,"_2311":93208},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2783":55976,"_24069":55950,"_16893":93210,"_5":16788,"_22829":93143,"_2311":93211},[],"Para el diseño recomendado:",{"_2783":55977,"_24069":55950,"_16893":93213,"_5":16788,"_22829":93143,"_2311":93214},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2783":55978,"_24069":55950,"_16893":93216,"_5":16788,"_22829":93143,"_2311":93217},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2783":55979,"_24069":55950,"_16893":93219,"_5":16788,"_22829":93143,"_2311":93220},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2783":55980,"_24069":55950,"_16893":93222,"_5":16788,"_22829":93143,"_2311":93223},[],"Apunta DNS a la dirección accesible de la VM.",{"_2783":55981,"_24069":55950,"_16893":93225,"_5":16788,"_22829":93143,"_2311":93226},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2783":55982,"_24069":55950,"_16893":93228,"_5":16788,"_22829":93146,"_2311":93229},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2783":55983,"_24069":55950,"_16893":93231,"_5":16788,"_22829":93150,"_2311":93232},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2783":55984,"_24069":55950,"_16893":93234,"_5":16788,"_22829":93150,"_2311":93235},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2783":55985,"_24069":55950,"_16893":93237,"_5":16788,"_22829":93154,"_2311":93238},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2783":55986,"_24069":55950,"_16893":93240,"_5":16788,"_22829":93154,"_2311":93241},[],"Requisito",{"_2783":55987,"_24069":55950,"_16893":93243,"_5":16788,"_22829":93154,"_2311":93244},[],"Diseño recomendado",{"_2783":55988,"_24069":55950,"_16893":93246,"_5":16788,"_22829":93154,"_2311":93247},[],"Consecuencia",{"_2783":55989,"_24069":55950,"_16893":93249,"_5":16788,"_22829":93154,"_2311":93250},[],"Varias URL o servicios de Lamassu",{"_2783":55990,"_24069":55950,"_16893":93252,"_5":16788,"_22829":93154,"_2311":93253},[],"Un Gateway con varias rutas",{"_2783":55991,"_24069":55950,"_16893":93255,"_5":16788,"_22829":93154,"_2311":93256},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2783":55992,"_24069":55950,"_16893":93258,"_5":16788,"_22829":93154,"_2311":93259},[],"Gateways independientes e IP externas distintas",{"_2783":55993,"_24069":55950,"_16893":93261,"_5":16788,"_22829":93154,"_2311":93262},[],"Una VIP por Gateway",{"_2783":55994,"_24069":55950,"_16893":93264,"_5":16788,"_22829":93154,"_2311":93265},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2783":55995,"_24069":55950,"_16893":93267,"_5":16788,"_22829":93154,"_2311":93268},[],"Gateways independientes, un nodo y una IP",{"_2783":55996,"_24069":55950,"_16893":93270,"_5":16788,"_22829":93154,"_2311":93271},[],"Puertos externos diferentes",{"_2783":55997,"_24069":55950,"_16893":93273,"_5":16788,"_22829":93154,"_2311":93274},[],"Los clientes deben indicar puertos no estándar",{"_2783":55998,"_24069":55950,"_16893":93276,"_5":16788,"_22829":93154,"_2311":93277},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2783":55999,"_24069":55950,"_16893":93279,"_5":16788,"_22829":93154,"_2311":93280},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2783":56000,"_24069":55950,"_16893":93282,"_5":16788,"_22829":93154,"_2311":93283},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2783":56001,"_24069":55950,"_16893":93285,"_5":16788,"_22829":93154,"_2311":93286},[],"Recursos Gateway separados pero proxy compartido",{"_2783":56002,"_24069":55950,"_16893":93288,"_5":16788,"_22829":93154,"_2311":93289},[],"Modo merged Gateway de Envoy",{"_2783":56003,"_24069":55950,"_16893":93291,"_5":16788,"_22829":93154,"_2311":93292},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2783":56004,"_24069":55950,"_16893":93294,"_5":16788,"_22829":93154,"_2311":93295},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2783":56005,"_24069":55950,"_16893":93297,"_5":16788,"_22829":93154,"_2311":93298},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2783":56006,"_24069":55950,"_16893":93300,"_5":16788,"_22829":93154,"_2311":93301},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2783":56007,"_24069":55950,"_16893":93303,"_5":16788,"_22829":93154,"_2311":93304},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2783":56008,"_24069":55950,"_16893":93306,"_5":16788,"_22829":93158,"_2311":93307},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2783":56009,"_24069":55950,"_16893":93309,"_5":16788,"_22829":93158,"_2311":93310},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2783":56010,"_24069":55950,"_16893":93312,"_5":16788,"_22829":93158,"_2311":93313},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2783":56011,"_24069":55950,"_16893":93315,"_5":16788,"_22829":93158,"_2311":93316},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2783":56012,"_24069":55950,"_16893":93318,"_5":16788,"_22829":93158,"_2311":93319},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2783":56013,"_24069":55950,"_16893":93321,"_5":16788,"_22829":93162,"_2311":93322},[],"Comprueba, en orden:",{"_2783":56014,"_24069":55950,"_16893":93324,"_5":16788,"_22829":93162,"_2311":93325},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2783":56015,"_24069":55950,"_16893":93327,"_5":16788,"_22829":93162,"_2311":93328},[],"Su estado contiene la dirección esperada.",{"_2783":56016,"_24069":55950,"_16893":93330,"_5":16788,"_22829":93162,"_2311":93331},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2783":56017,"_24069":55950,"_16893":93333,"_5":16788,"_22829":93162,"_2311":93334},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2783":56018,"_24069":55950,"_16893":93336,"_5":16788,"_22829":93162,"_2311":93337},[],"DNS resuelve al endpoint accesible externamente.",{"_2783":56019,"_24069":55950,"_16893":93339,"_5":16788,"_22829":93162,"_2311":93340},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2783":56020,"_24069":55950,"_16893":93342,"_5":16788,"_22829":93162,"_2311":93343},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2783":56021,"_24069":56021,"_5":11891,"_2311":39412,"_24384":93345,"_16893":93346,"_22829":56021},[39305,92431,92665],[],{"_2783":56022,"_24069":56021,"_16893":93348,"_5":16788,"_22829":56021,"_2311":93349},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2783":56023,"_24069":56021,"_5":24381,"_16893":93351,"_22829":93352,"_2311":93353},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2783":56024,"_24069":56021,"_5":24381,"_16893":93355,"_22829":93356,"_2311":93357},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2783":56025,"_24069":56021,"_5":24381,"_16893":93359,"_22829":93360,"_2311":93361},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2783":56026,"_24069":56021,"_5":24381,"_16893":93363,"_22829":93364,"_2311":93365},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2783":56027,"_24069":56021,"_5":24381,"_16893":93367,"_22829":93368,"_2311":93369},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2783":56028,"_24069":56021,"_5":24381,"_16893":93371,"_22829":93372,"_2311":93373},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2783":56029,"_24069":56021,"_16893":93375,"_5":16788,"_22829":93352,"_2311":93376},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2783":56030,"_24069":56021,"_16893":93378,"_5":16788,"_22829":93356,"_2311":93379},[],"Flujo",{"_2783":56031,"_24069":56021,"_16893":93381,"_5":16788,"_22829":93356,"_2311":93382},[],"Úsalo para",{"_2783":56032,"_24069":56021,"_16893":93384,"_5":16788,"_22829":93356,"_2311":93385},[],"Qué instala",{"_2783":56033,"_24069":56021,"_16893":93387,"_5":16788,"_22829":93356,"_2311":40296},[],{"_2783":56034,"_24069":56021,"_16893":93389,"_5":16788,"_22829":93356,"_2311":93390},[],"Producción y entornos controlados",{"_2783":56035,"_24069":56021,"_16893":93392,"_5":16788,"_22829":93356,"_2311":93393},[],"Servicios de Lamassu y recursos de Gateway API",{"_2783":56036,"_24069":56021,"_16893":93395,"_5":16788,"_22829":93356,"_2311":39549},[],{"_2783":56037,"_24069":56021,"_16893":93397,"_5":16788,"_22829":93356,"_2311":93398},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2783":56038,"_24069":56021,"_16893":93400,"_5":16788,"_22829":93356,"_2311":93401},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2783":56039,"_24069":56021,"_16893":93403,"_5":16788,"_22829":93360,"_2311":93404},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2783":56040,"_24069":56021,"_16893":93406,"_5":16788,"_22829":93360,"_2311":93407},[],"Área",{"_2783":56041,"_24069":56021,"_16893":93409,"_5":16788,"_22829":93360,"_2311":93410},[],"El chart de Lamassu proporciona",{"_2783":56042,"_24069":56021,"_16893":93412,"_5":16788,"_22829":93360,"_2311":93413},[],"Tú proporcionas",{"_2783":56043,"_24069":56021,"_16893":93415,"_5":16788,"_22829":93360,"_2311":93416},[],"Aplicaciones Lamassu",{"_2783":56044,"_24069":56021,"_16893":93418,"_5":16788,"_22829":93360,"_2311":93419},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2783":56045,"_24069":56021,"_16893":93421,"_5":16788,"_22829":93360,"_2311":93422},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2783":56046,"_24069":56021,"_16893":93424,"_5":16788,"_22829":93360,"_2311":93425},[],"Datos PostgreSQL",{"_2783":56047,"_24069":56021,"_16893":93427,"_5":16788,"_22829":93360,"_2311":93428},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2783":56048,"_24069":56021,"_16893":93430,"_5":16788,"_22829":93360,"_2311":93431},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2783":56049,"_24069":56021,"_16893":93433,"_5":16788,"_22829":93360,"_2311":93434},[],"Mensajería",{"_2783":56050,"_24069":56021,"_16893":93436,"_5":16788,"_22829":93360,"_2311":93437},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2783":56051,"_24069":56021,"_16893":93439,"_5":16788,"_22829":93360,"_2311":93440},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2783":56052,"_24069":56021,"_16893":93442,"_5":16788,"_22829":93360,"_2311":93443},[],"Identidad",{"_2783":56053,"_24069":56021,"_16893":93445,"_5":16788,"_22829":93360,"_2311":93446},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2783":56054,"_24069":56021,"_16893":93448,"_5":16788,"_22829":93360,"_2311":93449},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2783":56055,"_24069":56021,"_16893":93451,"_5":16788,"_22829":93360,"_2311":93452},[],"Enrutamiento externo",{"_2783":56056,"_24069":56021,"_16893":93454,"_5":16788,"_22829":93360,"_2311":93455},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2783":56057,"_24069":56021,"_16893":93457,"_5":16788,"_22829":93360,"_2311":93458},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2783":56058,"_24069":56021,"_16893":93460,"_5":16788,"_22829":93360,"_2311":40370},[],{"_2783":56059,"_24069":56021,"_16893":93462,"_5":16788,"_22829":93360,"_2311":93463},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2783":56060,"_24069":56021,"_16893":93465,"_5":16788,"_22829":93360,"_2311":93466},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2783":56061,"_24069":56021,"_16893":93468,"_5":16788,"_22829":93360,"_2311":93469},[],"Datos persistentes de la aplicación",{"_2783":56062,"_24069":56021,"_16893":93471,"_5":16788,"_22829":93360,"_2311":93472},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2783":56063,"_24069":56021,"_16893":93474,"_5":16788,"_22829":93360,"_2311":93475},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2783":56064,"_24069":56021,"_16893":93477,"_5":16788,"_22829":93360,"_2311":93478},[],"Integraciones opcionales",{"_2783":56065,"_24069":56021,"_16893":93480,"_5":16788,"_22829":93360,"_2311":93481},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2783":56066,"_24069":56021,"_16893":93483,"_5":16788,"_22829":93360,"_2311":93484},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2783":56067,"_24069":56021,"_16893":93486,"_5":16788,"_22829":93360,"_2311":93487},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2783":56068,"_24069":56021,"_16893":93489,"_5":16788,"_22829":93360,"_2311":93490},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2783":56069,"_24069":56021,"_16893":93492,"_5":16788,"_22829":93364,"_2311":93493},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2783":56070,"_24069":56021,"_16893":93495,"_5":16788,"_22829":93364,"_2311":93496},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2783":56071,"_24069":56021,"_16893":93498,"_5":16788,"_22829":93368,"_2311":93499},[],"Kubernetes 1.24 o posterior",{"_2783":56072,"_24069":56021,"_16893":93501,"_5":16788,"_22829":93368,"_2311":93502},[],"Helm 3.2 o posterior",{"_2783":56073,"_24069":56021,"_16893":93504,"_5":16788,"_22829":93368,"_2311":93505},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2783":56074,"_24069":56021,"_16893":93507,"_5":16788,"_22829":93368,"_2311":93508},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2783":56075,"_24069":56021,"_16893":93510,"_5":16788,"_22829":93368,"_2311":93511},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2783":56076,"_24069":56021,"_16893":93513,"_5":16788,"_22829":93368,"_2311":93514},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2783":56077,"_24069":56021,"_16893":93516,"_5":16788,"_22829":93368,"_2311":93517},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2783":56078,"_24069":56021,"_16893":93519,"_5":16788,"_22829":93372,"_2311":93520},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2783":56079,"_24069":56021,"_16893":93522,"_5":16788,"_22829":93372,"_2311":93523},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2783":56080,"_24069":56021,"_16893":93525,"_5":16788,"_22829":93372,"_2311":93526},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2783":56081,"_24069":56081,"_5":11891,"_2311":93528,"_24384":93529,"_16893":93531,"_22829":56081},"Resolución de problemas de despliegue",[39305,92431,93530],"Operación",[],{"_2783":56082,"_24069":56081,"_16893":93533,"_5":16788,"_22829":56081,"_2311":93534},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2783":56083,"_24069":56081,"_5":24381,"_16893":93536,"_22829":93537,"_2311":93538},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2783":56084,"_24069":56081,"_5":24381,"_16893":93540,"_22829":93541,"_2311":93542},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2783":56085,"_24069":56081,"_5":24381,"_16893":93544,"_22829":93545,"_2311":93546},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2783":56086,"_24069":56081,"_5":24381,"_16893":93548,"_22829":93549,"_2311":93550},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2783":56087,"_24069":56081,"_5":24381,"_16893":93552,"_22829":93553,"_2311":93554},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2783":56088,"_24069":56081,"_5":24381,"_16893":93556,"_22829":93557,"_2311":93558},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2783":56089,"_24069":56081,"_5":24381,"_16893":93560,"_22829":93561,"_2311":93562},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2783":56090,"_24069":56081,"_5":24381,"_16893":93564,"_22829":93565,"_2311":93566},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2783":56091,"_24069":56081,"_5":24381,"_16893":93568,"_22829":93569,"_2311":93570},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2783":56092,"_24069":56081,"_5":24381,"_16893":93572,"_22829":93573,"_2311":93574},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2783":56093,"_24069":56081,"_5":24381,"_16893":93576,"_22829":93577,"_2311":93578},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2783":56094,"_24069":56081,"_5":24381,"_16893":93580,"_22829":93581,"_2311":93582},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2783":56095,"_24069":56081,"_16893":93584,"_5":16788,"_22829":56081,"_2311":93585},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2783":56096,"_24069":56081,"_16893":93587,"_5":16788,"_22829":93541,"_2311":93588},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2783":56097,"_24069":56081,"_16893":93590,"_5":16788,"_22829":93545,"_2311":93591},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2783":56098,"_24069":56081,"_16893":93593,"_5":16788,"_22829":93549,"_2311":93594},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2783":56099,"_24069":56081,"_16893":93596,"_5":16788,"_22829":93553,"_2311":93597},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2783":56100,"_24069":56081,"_16893":93599,"_5":16788,"_22829":93557,"_2311":93600},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2783":56101,"_24069":56081,"_16893":93602,"_5":16788,"_22829":93561,"_2311":93603},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2783":56102,"_24069":56081,"_16893":93605,"_5":16788,"_22829":93561,"_2311":93606},[],"Ejecuta también la prueba de conectividad del chart:",{"_2783":56103,"_24069":56081,"_16893":93608,"_5":16788,"_22829":93561,"_2311":93609},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2783":56104,"_24069":56081,"_16893":93611,"_5":16788,"_22829":93561,"_2311":93612},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2783":56105,"_24069":56081,"_16893":93614,"_5":16788,"_22829":93565,"_2311":93615},[],"Si recibes un 401:",{"_2783":56106,"_24069":56081,"_16893":93617,"_5":16788,"_22829":93565,"_2311":93618},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2783":56107,"_24069":56081,"_16893":93620,"_5":16788,"_22829":93565,"_2311":93621},[],"verifica emisor, audiencia y expiración del token;",{"_2783":56108,"_24069":56081,"_16893":93623,"_5":16788,"_22829":93565,"_2311":93624},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2783":56109,"_24069":56081,"_16893":93626,"_5":16788,"_22829":93565,"_2311":93627},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2783":56110,"_24069":56081,"_16893":93629,"_5":16788,"_22829":93565,"_2311":93630},[],"Si el login termina pero las APIs devuelven 403:",{"_2783":56111,"_24069":56081,"_16893":93632,"_5":16788,"_22829":93565,"_2311":93633},[],"inspecciona los claims reales del token;",{"_2783":56112,"_24069":56081,"_16893":93635,"_5":16788,"_22829":93565,"_2311":93636},[],"confirma que coinciden con un principal activo;",{"_2783":56113,"_24069":56081,"_16893":93638,"_5":16788,"_22829":93565,"_2311":93639},[],"revisa las políticas concedidas al principal;",{"_2783":56114,"_24069":56081,"_16893":93641,"_5":16788,"_22829":93565,"_2311":93642},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2783":56115,"_24069":56081,"_16893":93644,"_5":16788,"_22829":93565,"_2311":93645},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2783":56116,"_24069":56081,"_16893":93647,"_5":16788,"_22829":93569,"_2311":93648},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2783":56117,"_24069":56081,"_16893":93650,"_5":16788,"_22829":93569,"_2311":93651},[],"Localiza el pod y Service de authz.",{"_2783":56118,"_24069":56081,"_16893":93653,"_5":16788,"_22829":93569,"_2311":93654},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2783":56119,"_24069":56081,"_16893":93656,"_5":16788,"_22829":93569,"_2311":93657},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2783":56120,"_24069":56081,"_16893":93659,"_5":16788,"_22829":93569,"_2311":93660},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2783":56121,"_24069":56081,"_16893":93662,"_5":16788,"_22829":93569,"_2311":93663},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2783":56122,"_24069":56081,"_16893":93665,"_5":16788,"_22829":93573,"_2311":93666},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2783":56123,"_24069":56081,"_16893":93668,"_5":16788,"_22829":93573,"_2311":93669},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2783":56124,"_24069":56081,"_16893":93671,"_5":16788,"_22829":93573,"_2311":93672},[],"volumen persistente sin enlazar;",{"_2783":56125,"_24069":56081,"_16893":93674,"_5":16788,"_22829":93573,"_2311":93675},[],"imagen inaccesible o política de pull incorrecta;",{"_2783":56126,"_24069":56081,"_16893":93677,"_5":16788,"_22829":93573,"_2311":93678},[],"configuración inválida del motor criptográfico;",{"_2783":56127,"_24069":56081,"_16893":93680,"_5":16788,"_22829":93573,"_2311":93681},[],"límites de CPU o memoria demasiado bajos;",{"_2783":56128,"_24069":56081,"_16893":93683,"_5":16788,"_22829":93573,"_2311":93684},[],"migración previa incompleta.",{"_2783":56129,"_24069":56081,"_16893":93686,"_5":16788,"_22829":93573,"_2311":93687},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2783":56130,"_24069":56081,"_16893":93689,"_5":16788,"_22829":93573,"_2311":93690},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2783":56131,"_24069":56081,"_16893":93692,"_5":16788,"_22829":93577,"_2311":93693},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2783":56132,"_24069":56081,"_16893":93695,"_5":16788,"_22829":93577,"_2311":93696},[],"verifica que esté habilitado en el servicio emisor;",{"_2783":56133,"_24069":56081,"_16893":93698,"_5":16788,"_22829":93577,"_2311":93699},[],"comprueba conectividad y credenciales AMQP;",{"_2783":56134,"_24069":56081,"_16893":93701,"_5":16788,"_22829":93577,"_2311":93702},[],"revisa exchange, routing key, colas y consumidores;",{"_2783":56135,"_24069":56081,"_16893":93704,"_5":16788,"_22829":93577,"_2311":93705},[],"inspecciona dead-letter queues;",{"_2783":56136,"_24069":56081,"_16893":93707,"_5":16788,"_22829":93577,"_2311":93708},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2783":56137,"_24069":56081,"_16893":93710,"_5":16788,"_22829":93577,"_2311":93711},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2783":56138,"_24069":56081,"_16893":93713,"_5":16788,"_22829":93581,"_2311":93714},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2783":56139,"_24069":56081,"_16893":93716,"_5":16788,"_22829":93581,"_2311":93717},[],"Antes de cerrar una incidencia, guarda:",{"_2783":56140,"_24069":56081,"_16893":93719,"_5":16788,"_22829":93581,"_2311":93720},[],"causa confirmada;",{"_2783":56141,"_24069":56081,"_16893":93722,"_5":16788,"_22829":93581,"_2311":93723},[],"alcance temporal y recursos afectados;",{"_2783":56142,"_24069":56081,"_16893":93725,"_5":16788,"_22829":93581,"_2311":93726},[],"comandos o consultas utilizados;",{"_2783":56143,"_24069":56081,"_16893":93728,"_5":16788,"_22829":93581,"_2311":93729},[],"cambio aplicado y forma de revertirlo;",{"_2783":56144,"_24069":56081,"_16893":93731,"_5":16788,"_22829":93581,"_2311":93732},[],"validación desde un consumidor;",{"_2783":56145,"_24069":56081,"_16893":93734,"_5":16788,"_22829":93581,"_2311":93735},[],"acción preventiva y propietario.",{"_2783":56146,"_24069":56146,"_5":11891,"_2311":93737,"_24384":93738,"_16893":93741,"_22829":56146},"Control de acceso",[39305,93739,93740],"Plataforma","Administración",[],{"_2783":56147,"_24069":56146,"_16893":93743,"_5":16788,"_22829":56146,"_2311":93744},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2783":56148,"_24069":56146,"_5":24381,"_16893":93746,"_22829":93747,"_2311":93748},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2783":56149,"_24069":56146,"_5":24381,"_16893":93750,"_22829":93751,"_2311":93752},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2783":56150,"_24069":56146,"_5":24381,"_16893":93754,"_22829":93755,"_2311":93756},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2783":56151,"_24069":56146,"_5":24381,"_16893":93758,"_22829":93759,"_2311":93760},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2783":56152,"_24069":56146,"_5":24381,"_16893":93762,"_22829":93763,"_2311":93764},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2783":56153,"_24069":56146,"_5":24381,"_16893":93766,"_22829":93767,"_2311":93768},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2783":56154,"_24069":56146,"_5":24381,"_16893":93770,"_22829":93771,"_2311":93772},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2783":56155,"_24069":56146,"_5":24381,"_16893":93774,"_22829":93775,"_2311":93776},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2783":56156,"_24069":56146,"_5":24381,"_16893":93778,"_22829":93779,"_2311":93780},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2783":56157,"_24069":56146,"_5":24381,"_16893":93782,"_22829":93783,"_2311":93784},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2783":56158,"_24069":56146,"_5":24381,"_16893":93786,"_22829":93787,"_2311":93788},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2783":56159,"_24069":56146,"_5":24381,"_16893":93790,"_22829":93791,"_2311":93792},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2783":56160,"_24069":56146,"_5":24381,"_16893":93794,"_22829":93795,"_2311":93796},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2783":56161,"_24069":56146,"_5":24381,"_16893":93798,"_22829":93799,"_2311":93800},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2783":56162,"_24069":56146,"_5":24381,"_16893":93802,"_22829":93803,"_2311":93001},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2783":56163,"_24069":56146,"_5":24381,"_16893":93805,"_22829":93806,"_2311":93807},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2783":56164,"_24069":56146,"_5":24381,"_16893":93809,"_22829":93810,"_2311":93811},[],"/docs/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2783":56165,"_24069":56146,"_5":24381,"_16893":93813,"_22829":93814,"_2311":93815},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2783":56166,"_24069":56146,"_5":24381,"_16893":93817,"_22829":93818,"_2311":93819},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2783":56167,"_24069":56146,"_5":24381,"_16893":93821,"_22829":93822,"_2311":93823},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2783":56168,"_24069":56146,"_5":24381,"_16893":93825,"_22829":93826,"_2311":93827},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2783":56169,"_24069":56146,"_5":24381,"_16893":93829,"_22829":93830,"_2311":93831},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2783":56170,"_24069":56146,"_5":24381,"_16893":93833,"_22829":93834,"_2311":93835},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2783":56171,"_24069":56146,"_5":24381,"_16893":93837,"_22829":93838,"_2311":93839},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2783":56172,"_24069":56146,"_5":24381,"_16893":93841,"_22829":93842,"_2311":93843},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2783":56173,"_24069":56146,"_5":24381,"_16893":93845,"_22829":93846,"_2311":93847},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2783":56174,"_24069":56146,"_5":24381,"_16893":93849,"_22829":93850,"_2311":93851},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2783":56175,"_24069":56146,"_5":24381,"_16893":93853,"_22829":93854,"_2311":93855},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2783":56176,"_24069":56146,"_5":24381,"_16893":93857,"_22829":93858,"_2311":93859},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2783":56177,"_24069":56146,"_16893":93861,"_5":16788,"_22829":56146,"_2311":93862},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2783":56178,"_24069":56146,"_16893":93864,"_5":16788,"_22829":56146,"_2311":93865},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2783":56179,"_24069":56146,"_16893":93867,"_5":16788,"_22829":56146,"_2311":93868},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2783":56180,"_24069":56146,"_16893":93870,"_5":16788,"_22829":93747,"_2311":93871},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2783":56181,"_24069":56146,"_16893":93873,"_5":16788,"_22829":93747,"_2311":93874},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2783":56182,"_24069":56146,"_16893":93876,"_5":16788,"_22829":93747,"_2311":93877},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2783":56183,"_24069":56146,"_16893":93879,"_5":16788,"_22829":93747,"_2311":93880},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2783":56184,"_24069":56146,"_16893":93882,"_5":16788,"_22829":93747,"_2311":93883},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2783":56185,"_24069":56146,"_16893":93885,"_5":16788,"_22829":93747,"_2311":93886},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2783":56186,"_24069":56146,"_16893":93888,"_5":16788,"_22829":93751,"_2311":93889},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2783":56187,"_24069":56146,"_16893":93891,"_5":16788,"_22829":93751,"_2311":93892},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2783":56188,"_24069":56146,"_16893":93894,"_5":16788,"_22829":93755,"_2311":93895},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2783":56189,"_24069":56146,"_16893":93897,"_5":16788,"_22829":93755,"_2311":93898},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2783":56190,"_24069":56146,"_16893":93900,"_5":16788,"_22829":93755,"_2311":93901},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2783":56191,"_24069":56146,"_16893":93903,"_5":16788,"_22829":93755,"_2311":93904},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2783":56192,"_24069":56146,"_16893":93906,"_5":16788,"_22829":93755,"_2311":93907},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2783":56193,"_24069":56146,"_16893":93909,"_5":16788,"_22829":93755,"_2311":93910},[],"Carga por separado las políticas concedidas a cada principal.",{"_2783":56194,"_24069":56146,"_16893":93912,"_5":16788,"_22829":93755,"_2311":93913},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2783":56195,"_24069":56146,"_16893":93915,"_5":16788,"_22829":93755,"_2311":93916},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2783":56196,"_24069":56146,"_16893":93918,"_5":16788,"_22829":93755,"_2311":93919},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2783":56197,"_24069":56146,"_16893":93921,"_5":16788,"_22829":93755,"_2311":93922},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2783":56198,"_24069":56146,"_16893":93924,"_5":16788,"_22829":93755,"_2311":93925},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2783":56199,"_24069":56146,"_16893":93927,"_5":16788,"_22829":93755,"_2311":93928},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2783":56200,"_24069":56146,"_16893":93930,"_5":16788,"_22829":93759,"_2311":93931},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2783":56201,"_24069":56146,"_16893":93933,"_5":16788,"_22829":93759,"_2311":93934},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2783":56202,"_24069":56146,"_16893":93936,"_5":16788,"_22829":93759,"_2311":93937},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2783":56203,"_24069":56146,"_16893":93939,"_5":16788,"_22829":93759,"_2311":93940},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2783":56204,"_24069":56146,"_16893":93942,"_5":16788,"_22829":93759,"_2311":93943},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2783":56205,"_24069":56146,"_16893":93945,"_5":16788,"_22829":93759,"_2311":93946},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2783":56206,"_24069":56146,"_16893":93948,"_5":16788,"_22829":93759,"_2311":93949},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2783":56207,"_24069":56146,"_16893":93951,"_5":16788,"_22829":93759,"_2311":93952},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2783":56208,"_24069":56146,"_16893":93954,"_5":16788,"_22829":93759,"_2311":93955},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2783":56209,"_24069":56146,"_16893":93957,"_5":16788,"_22829":93759,"_2311":93958},[],"Las acciones se dividen en dos grupos:",{"_2783":56210,"_24069":56146,"_16893":93960,"_5":16788,"_22829":93759,"_2311":93961},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2783":56211,"_24069":56146,"_16893":93963,"_5":16788,"_22829":93759,"_2311":93964},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2783":56212,"_24069":56146,"_16893":93966,"_5":16788,"_22829":93759,"_2311":93967},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2783":56213,"_24069":56146,"_16893":93969,"_5":16788,"_22829":93763,"_2311":93970},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2783":56214,"_24069":56146,"_16893":93972,"_5":16788,"_22829":93763,"_2311":93973},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2783":56215,"_24069":56146,"_16893":93975,"_5":16788,"_22829":93763,"_2311":93976},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2783":56216,"_24069":56146,"_16893":93978,"_5":16788,"_22829":93767,"_2311":93979},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2783":56217,"_24069":56146,"_16893":93981,"_5":16788,"_22829":93767,"_2311":93982},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2783":56218,"_24069":56146,"_16893":93984,"_5":16788,"_22829":93767,"_2311":93985},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2783":56219,"_24069":56146,"_16893":93987,"_5":16788,"_22829":93767,"_2311":93988},[],"Los operadores implementados son:",{"_2783":56220,"_24069":56146,"_16893":93990,"_5":16788,"_22829":93767,"_2311":93991},[],"`equals`, para igualdad exacta;",{"_2783":56221,"_24069":56146,"_16893":93993,"_5":16788,"_22829":93767,"_2311":93994},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2783":56222,"_24069":56146,"_16893":93996,"_5":16788,"_22829":93767,"_2311":93997},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2783":56223,"_24069":56146,"_16893":93999,"_5":16788,"_22829":93767,"_2311":94000},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2783":56224,"_24069":56146,"_16893":94002,"_5":16788,"_22829":93771,"_2311":94003},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2783":56225,"_24069":56146,"_16893":94005,"_5":16788,"_22829":93771,"_2311":94006},[],"Los modos disponibles son:",{"_2783":56226,"_24069":56146,"_16893":94008,"_5":16788,"_22829":93771,"_2311":94009},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2783":56227,"_24069":56146,"_16893":94011,"_5":16788,"_22829":93771,"_2311":94012},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2783":56228,"_24069":56146,"_16893":94014,"_5":16788,"_22829":93771,"_2311":94015},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2783":56229,"_24069":56146,"_16893":94017,"_5":16788,"_22829":93771,"_2311":94018},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2783":56230,"_24069":56146,"_16893":94020,"_5":16788,"_22829":93771,"_2311":94021},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2783":56231,"_24069":56146,"_16893":94023,"_5":16788,"_22829":93771,"_2311":94024},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2783":56232,"_24069":56146,"_16893":94026,"_5":16788,"_22829":93775,"_2311":94027},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2783":56233,"_24069":56146,"_16893":94029,"_5":16788,"_22829":93775,"_2311":94030},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2783":56234,"_24069":56146,"_16893":94032,"_5":16788,"_22829":93775,"_2311":94033},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2783":56235,"_24069":56146,"_16893":94035,"_5":16788,"_22829":93775,"_2311":94036},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2783":56236,"_24069":56146,"_16893":94038,"_5":16788,"_22829":93783,"_2311":94039},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2783":56237,"_24069":56146,"_16893":94041,"_5":16788,"_22829":93783,"_2311":94042},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2783":56238,"_24069":56146,"_16893":94044,"_5":16788,"_22829":93787,"_2311":94045},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2783":56239,"_24069":56146,"_16893":94047,"_5":16788,"_22829":93787,"_2311":94048},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2783":56240,"_24069":56146,"_16893":94050,"_5":16788,"_22829":93791,"_2311":94051},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2783":56241,"_24069":56146,"_16893":94053,"_5":16788,"_22829":93791,"_2311":94054},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2783":56242,"_24069":56146,"_16893":94056,"_5":16788,"_22829":93791,"_2311":94057},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2783":56243,"_24069":56146,"_16893":94059,"_5":16788,"_22829":93795,"_2311":94060},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2783":56244,"_24069":56146,"_16893":94062,"_5":16788,"_22829":93795,"_2311":94063},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2783":56245,"_24069":56146,"_16893":94065,"_5":16788,"_22829":93795,"_2311":94066},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2783":56246,"_24069":56146,"_16893":94068,"_5":16788,"_22829":93799,"_2311":94069},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2783":56247,"_24069":56146,"_16893":94071,"_5":16788,"_22829":93799,"_2311":94072},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2783":56248,"_24069":56146,"_16893":94074,"_5":16788,"_22829":93799,"_2311":94075},[],"acceso completo y de solo lectura a KMS;",{"_2783":56249,"_24069":56146,"_16893":94077,"_5":16788,"_22829":93799,"_2311":94078},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2783":56250,"_24069":56146,"_16893":94080,"_5":16788,"_22829":93799,"_2311":94081},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2783":56251,"_24069":56146,"_16893":94083,"_5":16788,"_22829":93799,"_2311":94084},[],"acceso a la interfaz;",{"_2783":56252,"_24069":56146,"_16893":94086,"_5":16788,"_22829":93799,"_2311":94087},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2783":56253,"_24069":56146,"_16893":94089,"_5":16788,"_22829":93799,"_2311":94090},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2783":56254,"_24069":56146,"_16893":94092,"_5":16788,"_22829":93799,"_2311":94093},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2783":56255,"_24069":56146,"_16893":94095,"_5":16788,"_22829":93803,"_2311":94096},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2783":56256,"_24069":56146,"_16893":94098,"_5":16788,"_22829":93803,"_2311":94099},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2783":56257,"_24069":56146,"_16893":94101,"_5":16788,"_22829":93803,"_2311":94102},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2783":56258,"_24069":56146,"_16893":94104,"_5":16788,"_22829":93806,"_2311":94105},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2783":56259,"_24069":56146,"_16893":94107,"_5":16788,"_22829":93810,"_2311":94108},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2783":56260,"_24069":56146,"_16893":94110,"_5":16788,"_22829":93814,"_2311":94111},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2783":56261,"_24069":56146,"_16893":94113,"_5":16788,"_22829":93818,"_2311":94114},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2783":56262,"_24069":56146,"_16893":94116,"_5":16788,"_22829":93822,"_2311":94117},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2783":56263,"_24069":56146,"_16893":94119,"_5":16788,"_22829":93826,"_2311":94120},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2783":56264,"_24069":56146,"_16893":94122,"_5":16788,"_22829":93826,"_2311":94123},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2783":56265,"_24069":56146,"_16893":94125,"_5":16788,"_22829":93830,"_2311":94126},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2783":56266,"_24069":56146,"_16893":94128,"_5":16788,"_22829":93830,"_2311":94129},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2783":56267,"_24069":56146,"_16893":94131,"_5":16788,"_22829":93830,"_2311":94132},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2783":56268,"_24069":56146,"_16893":94134,"_5":16788,"_22829":93830,"_2311":94135},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2783":56269,"_24069":56146,"_16893":94137,"_5":16788,"_22829":93830,"_2311":94138},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2783":56270,"_24069":56146,"_16893":94140,"_5":16788,"_22829":93830,"_2311":94141},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2783":56271,"_24069":56146,"_16893":94143,"_5":16788,"_22829":93830,"_2311":94144},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2783":56272,"_24069":56146,"_16893":94146,"_5":16788,"_22829":93830,"_2311":94147},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2783":56273,"_24069":56146,"_16893":94149,"_5":16788,"_22829":93834,"_2311":94150},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2783":56274,"_24069":56146,"_16893":94152,"_5":16788,"_22829":93834,"_2311":94153},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2783":56275,"_24069":56146,"_16893":94155,"_5":16788,"_22829":93834,"_2311":94156},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2783":56276,"_24069":56146,"_16893":94158,"_5":16788,"_22829":93838,"_2311":94159},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2783":56277,"_24069":56146,"_16893":94161,"_5":16788,"_22829":93838,"_2311":94162},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2783":56278,"_24069":56146,"_16893":94164,"_5":16788,"_22829":93838,"_2311":94165},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2783":56279,"_24069":56146,"_16893":94167,"_5":16788,"_22829":93838,"_2311":94168},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2783":56280,"_24069":56146,"_16893":94170,"_5":16788,"_22829":93838,"_2311":94171},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2783":56281,"_24069":56146,"_16893":94173,"_5":16788,"_22829":93838,"_2311":94174},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2783":56282,"_24069":56146,"_16893":94176,"_5":16788,"_22829":93838,"_2311":94177},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2783":56283,"_24069":56146,"_16893":94179,"_5":16788,"_22829":93846,"_2311":94180},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2783":56284,"_24069":56146,"_16893":94182,"_5":16788,"_22829":93850,"_2311":94183},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2783":56285,"_24069":56146,"_16893":94185,"_5":16788,"_22829":93850,"_2311":94186},[],"que exista un principal activo del tipo correcto;",{"_2783":56286,"_24069":56146,"_16893":94188,"_5":16788,"_22829":93850,"_2311":94189},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2783":56287,"_24069":56146,"_16893":94191,"_5":16788,"_22829":93850,"_2311":94192},[],"que todas las condiciones del principal se cumplan;",{"_2783":56288,"_24069":56146,"_16893":94194,"_5":16788,"_22829":93850,"_2311":94195},[],"que el principal tenga concedida la política esperada;",{"_2783":56289,"_24069":56146,"_16893":94197,"_5":16788,"_22829":93850,"_2311":94198},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2783":56290,"_24069":56146,"_16893":94200,"_5":16788,"_22829":93850,"_2311":94201},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2783":56291,"_24069":56146,"_16893":94203,"_5":16788,"_22829":93850,"_2311":94204},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2783":56292,"_24069":56146,"_16893":94206,"_5":16788,"_22829":93854,"_2311":94207},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2783":56293,"_24069":56146,"_16893":94209,"_5":16788,"_22829":93858,"_2311":94210},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2783":56294,"_24069":56146,"_16893":94212,"_5":16788,"_22829":93858,"_2311":94213},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2783":56295,"_24069":56295,"_5":11891,"_2311":94215,"_24384":94216,"_16893":94217,"_22829":56295},"Alertas y suscripciones",[39305,93739,93740],[],{"_2783":56296,"_24069":56295,"_16893":94219,"_5":16788,"_22829":56295,"_2311":94220},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2783":56297,"_24069":56295,"_5":24381,"_16893":94222,"_22829":94223,"_2311":94224},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2783":56298,"_24069":56295,"_5":24381,"_16893":94226,"_22829":94227,"_2311":94228},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2783":56299,"_24069":56295,"_5":24381,"_16893":94230,"_22829":94231,"_2311":94232},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2783":56300,"_24069":56295,"_5":24381,"_16893":94234,"_22829":94235,"_2311":94236},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2783":56301,"_24069":56295,"_5":24381,"_16893":94238,"_22829":94239,"_2311":94240},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2783":56302,"_24069":56295,"_5":24381,"_16893":94242,"_22829":94243,"_2311":94244},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2783":56303,"_24069":56295,"_5":24381,"_16893":94246,"_22829":94247,"_2311":94248},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2783":56304,"_24069":56295,"_5":24381,"_16893":94250,"_22829":94251,"_2311":94252},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2783":56305,"_24069":56295,"_5":24381,"_16893":94254,"_22829":94255,"_2311":94256},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2783":56306,"_24069":56295,"_16893":94258,"_5":16788,"_22829":56295,"_2311":94259},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2783":56307,"_24069":56295,"_16893":94261,"_5":16788,"_22829":94223,"_2311":94262},[],"Un servicio publica un evento de dominio.",{"_2783":56308,"_24069":56295,"_16893":94264,"_5":16788,"_22829":94223,"_2311":94265},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2783":56309,"_24069":56295,"_16893":94267,"_5":16788,"_22829":94223,"_2311":94268},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2783":56310,"_24069":56295,"_16893":94270,"_5":16788,"_22829":94223,"_2311":94271},[],"Lamassu entrega el evento al canal configurado.",{"_2783":56311,"_24069":56295,"_16893":94273,"_5":16788,"_22829":94223,"_2311":94274},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2783":56312,"_24069":56295,"_16893":94276,"_5":16788,"_22829":94227,"_2311":94277},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2783":56313,"_24069":56295,"_16893":94279,"_5":16788,"_22829":94227,"_2311":94280},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2783":56314,"_24069":56295,"_16893":94282,"_5":16788,"_22829":94227,"_2311":94283},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2783":56315,"_24069":56295,"_16893":94285,"_5":16788,"_22829":94235,"_2311":94286},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2783":56316,"_24069":56295,"_16893":94288,"_5":16788,"_22829":94239,"_2311":94289},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2783":56317,"_24069":56295,"_16893":94291,"_5":16788,"_22829":94243,"_2311":94292},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2783":56318,"_24069":56295,"_16893":94294,"_5":16788,"_22829":94243,"_2311":94295},[],"**None** notifica todas las instancias del evento.",{"_2783":56319,"_24069":56295,"_16893":94297,"_5":16788,"_22829":94243,"_2311":94298},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2783":56320,"_24069":56295,"_16893":94300,"_5":16788,"_22829":94243,"_2311":94301},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2783":56321,"_24069":56295,"_16893":94303,"_5":16788,"_22829":94243,"_2311":94304},[],"**JavaScript** permite expresar lógica personalizada.",{"_2783":56322,"_24069":56295,"_16893":94306,"_5":16788,"_22829":94243,"_2311":94307},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2783":56323,"_24069":56295,"_16893":94309,"_5":16788,"_22829":94247,"_2311":94310},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2783":56324,"_24069":56295,"_16893":94312,"_5":16788,"_22829":94251,"_2311":94313},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2783":56325,"_24069":56295,"_16893":94315,"_5":16788,"_22829":94255,"_2311":94316},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2783":56326,"_24069":56295,"_16893":94318,"_5":16788,"_22829":94255,"_2311":94319},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2783":56327,"_24069":56295,"_16893":94321,"_5":16788,"_22829":94255,"_2311":94322},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2783":56328,"_24069":56295,"_16893":94324,"_5":16788,"_22829":94255,"_2311":94325},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2783":56329,"_24069":56295,"_16893":94327,"_5":16788,"_22829":94255,"_2311":94328},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2783":56330,"_24069":56295,"_16893":94330,"_5":16788,"_22829":94255,"_2311":94331},[],"**Validación:** `va.role.crl.create`.",{"_2783":56331,"_24069":56295,"_16893":94333,"_5":16788,"_22829":94255,"_2311":94334},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2783":56332,"_24069":56295,"_16893":94336,"_5":16788,"_22829":94255,"_2311":94337},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2783":56333,"_24069":56333,"_5":11891,"_2311":94339,"_24384":94340,"_16893":94341,"_22829":56333},"Registros de auditoría",[39305,93739,93740],[],{"_2783":56334,"_24069":56333,"_16893":94343,"_5":16788,"_22829":56333,"_2311":94344},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2783":56335,"_24069":56333,"_5":24381,"_16893":94346,"_22829":94347,"_2311":94348},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2783":56336,"_24069":56333,"_5":24381,"_16893":94350,"_22829":94351,"_2311":94352},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2783":56337,"_24069":56333,"_5":24381,"_16893":94354,"_22829":94355,"_2311":94356},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2783":56338,"_24069":56333,"_5":24381,"_16893":94358,"_22829":94359,"_2311":94360},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2783":56339,"_24069":56333,"_5":24381,"_16893":94362,"_22829":94363,"_2311":94364},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2783":56340,"_24069":56333,"_5":24381,"_16893":94366,"_22829":94367,"_2311":94368},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2783":56341,"_24069":56333,"_5":24381,"_16893":94370,"_22829":94371,"_2311":94372},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2783":56342,"_24069":56333,"_5":24381,"_16893":94374,"_22829":94375,"_2311":94376},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2783":56343,"_24069":56333,"_5":24381,"_16893":94378,"_22829":94379,"_2311":94380},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2783":56344,"_24069":56333,"_5":24381,"_16893":94382,"_22829":94383,"_2311":94384},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2783":56345,"_24069":56333,"_5":24381,"_16893":94386,"_22829":94387,"_2311":94388},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2783":56346,"_24069":56333,"_16893":94390,"_5":16788,"_22829":56333,"_2311":94391},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2783":56347,"_24069":56333,"_16893":94393,"_5":16788,"_22829":94347,"_2311":94394},[],"El cuerpo de auditoría incluye:",{"_2783":56348,"_24069":56333,"_16893":94396,"_5":16788,"_22829":94347,"_2311":94397},[],"input: datos recibidos por la operación;",{"_2783":56349,"_24069":56333,"_16893":94399,"_5":16788,"_22829":94347,"_2311":94400},[],"has\\_error: indica si el servicio devolvió un error;",{"_2783":56350,"_24069":56333,"_16893":94402,"_5":16788,"_22829":94347,"_2311":94403},[],"output: resultado producido o mensaje de error;",{"_2783":56351,"_24069":56333,"_16893":94405,"_5":16788,"_22829":94347,"_2311":94406},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2783":56352,"_24069":56333,"_16893":94408,"_5":16788,"_22829":94347,"_2311":94409},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2783":56353,"_24069":56333,"_16893":94411,"_5":16788,"_22829":94347,"_2311":94412},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2783":56354,"_24069":56333,"_16893":94414,"_5":16788,"_22829":94351,"_2311":94415},[],"El backend aplica auditoría a mutaciones de:",{"_2783":56355,"_24069":56333,"_16893":94417,"_5":16788,"_22829":94351,"_2311":94418},[],"autoridades, certificados y perfiles de emisión;",{"_2783":56356,"_24069":56333,"_16893":94420,"_5":16788,"_22829":94351,"_2311":94421},[],"claves y motores KMS;",{"_2783":56357,"_24069":56333,"_16893":94423,"_5":16788,"_22829":94351,"_2311":94424},[],"dispositivos e identidades;",{"_2783":56358,"_24069":56333,"_16893":94426,"_5":16788,"_22829":94351,"_2311":94427},[],"DMS y operaciones de enrolamiento;",{"_2783":56359,"_24069":56333,"_16893":94429,"_5":16788,"_22829":94351,"_2311":94430},[],"funciones de validación y CRL;",{"_2783":56360,"_24069":56333,"_16893":94432,"_5":16788,"_22829":94351,"_2311":94433},[],"principales, políticas y concesiones de autorización.",{"_2783":56361,"_24069":56333,"_16893":94435,"_5":16788,"_22829":94351,"_2311":94436},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2783":56362,"_24069":56333,"_16893":94438,"_5":16788,"_22829":94355,"_2311":94439},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2783":56363,"_24069":56333,"_16893":94441,"_5":16788,"_22829":94355,"_2311":94442},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2783":56364,"_24069":56333,"_16893":94444,"_5":16788,"_22829":94355,"_2311":94445},[],"Diseña el consumidor para:",{"_2783":56365,"_24069":56333,"_16893":94447,"_5":16788,"_22829":94355,"_2311":94448},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2783":56366,"_24069":56333,"_16893":94450,"_5":16788,"_22829":94355,"_2311":94451},[],"conservar el CloudEvent completo sin modificar;",{"_2783":56367,"_24069":56333,"_16893":94453,"_5":16788,"_22829":94355,"_2311":94454},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2783":56368,"_24069":56333,"_16893":94456,"_5":16788,"_22829":94355,"_2311":94457},[],"cifrar en tránsito y en reposo;",{"_2783":56369,"_24069":56333,"_16893":94459,"_5":16788,"_22829":94355,"_2311":94460},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2783":56370,"_24069":56333,"_16893":94462,"_5":16788,"_22829":94355,"_2311":94463},[],"aplicar una política explícita de retención y legal hold;",{"_2783":56371,"_24069":56333,"_16893":94465,"_5":16788,"_22829":94355,"_2311":94466},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2783":56372,"_24069":56333,"_16893":94468,"_5":16788,"_22829":94359,"_2311":94469},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2783":56373,"_24069":56333,"_16893":94471,"_5":16788,"_22829":94359,"_2311":94472},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2783":56374,"_24069":56333,"_16893":94474,"_5":16788,"_22829":94367,"_2311":94475},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2783":56375,"_24069":56333,"_16893":94477,"_5":16788,"_22829":94371,"_2311":94478},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2783":56376,"_24069":56333,"_16893":94480,"_5":16788,"_22829":94375,"_2311":94481},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2783":56377,"_24069":56333,"_16893":94483,"_5":16788,"_22829":94379,"_2311":94484},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2783":56378,"_24069":56333,"_16893":94486,"_5":16788,"_22829":94383,"_2311":94487},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2783":56379,"_24069":56333,"_16893":94489,"_5":16788,"_22829":94387,"_2311":94490},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2783":56380,"_24069":56333,"_16893":94492,"_5":16788,"_22829":94387,"_2311":94493},[],"aparece un evento de auditoría correcto;",{"_2783":56381,"_24069":56333,"_16893":94495,"_5":16788,"_22829":94387,"_2311":94496},[],"el principal coincide con la identidad utilizada;",{"_2783":56382,"_24069":56333,"_16893":94498,"_5":16788,"_22829":94387,"_2311":94499},[],"el consumidor lo persiste una sola vez;",{"_2783":56383,"_24069":56333,"_16893":94501,"_5":16788,"_22829":94387,"_2311":94502},[],"puede recuperarse por recurso, actor y periodo;",{"_2783":56384,"_24069":56333,"_16893":94504,"_5":16788,"_22829":94387,"_2311":94505},[],"una interrupción del consumidor produce una alerta.",{"_2783":56385,"_24069":56333,"_16893":94507,"_5":16788,"_22829":94387,"_2311":94508},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2783":56386,"_24069":56386,"_5":11891,"_2311":94510,"_24384":94511,"_16893":94512,"_22829":56386},"Arquitectura de la plataforma",[39305,93739],[],{"_2783":56387,"_24069":56386,"_16893":94514,"_5":16788,"_22829":56386,"_2311":94515},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2783":56388,"_24069":56386,"_5":24381,"_16893":94517,"_22829":94518,"_2311":94519},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2783":56389,"_24069":56386,"_5":24381,"_16893":94521,"_22829":94522,"_2311":94523},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2783":56390,"_24069":56386,"_5":24381,"_16893":94525,"_22829":94526,"_2311":94527},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2783":56391,"_24069":56386,"_5":24381,"_16893":94529,"_22829":94530,"_2311":94531},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2783":56392,"_24069":56386,"_5":24381,"_16893":94533,"_22829":94534,"_2311":94535},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2783":56393,"_24069":56386,"_16893":94537,"_5":16788,"_22829":56386,"_2311":94538},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2783":56394,"_24069":56386,"_16893":94540,"_5":16788,"_22829":56386,"_2311":94541},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2783":56395,"_24069":56386,"_16893":94543,"_5":16788,"_22829":94518,"_2311":94544},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2783":56396,"_24069":56386,"_16893":94546,"_5":16788,"_22829":94522,"_2311":94547},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2783":56397,"_24069":56386,"_16893":94549,"_5":16788,"_22829":94526,"_2311":94550},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2783":56398,"_24069":56386,"_16893":94552,"_5":16788,"_22829":94530,"_2311":94553},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2783":56399,"_24069":56386,"_16893":94555,"_5":16788,"_22829":94534,"_2311":94556},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2783":56400,"_24069":56400,"_5":11891,"_2311":94558,"_24384":94559,"_16893":94560,"_22829":56400},"Cómo funciona Lamassu",[39305,93739],[],{"_2783":56401,"_24069":56400,"_16893":94562,"_5":16788,"_22829":56400,"_2311":94563},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2783":56402,"_24069":56400,"_5":24381,"_16893":94565,"_22829":94566,"_2311":94567},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2783":56403,"_24069":56400,"_5":24381,"_16893":94569,"_22829":94570,"_2311":94571},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2783":56404,"_24069":56400,"_16893":94573,"_5":16788,"_22829":56400,"_2311":94574},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2783":56405,"_24069":56400,"_16893":94576,"_5":16788,"_22829":94566,"_2311":94577},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2783":56406,"_24069":56400,"_16893":94579,"_5":16788,"_22829":94566,"_2311":94580},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2783":56407,"_24069":56400,"_16893":94582,"_5":16788,"_22829":94566,"_2311":94583},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2783":56408,"_24069":56400,"_16893":94585,"_5":16788,"_22829":94566,"_2311":94586},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2783":56409,"_24069":56400,"_16893":94588,"_5":16788,"_22829":94566,"_2311":94589},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2783":56410,"_24069":56400,"_16893":94591,"_5":16788,"_22829":94570,"_2311":94592},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2783":56411,"_24069":56400,"_16893":94594,"_5":16788,"_22829":94570,"_2311":94595},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2783":56412,"_24069":56400,"_16893":94597,"_5":16788,"_22829":94570,"_2311":94598},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2783":56413,"_24069":56400,"_16893":94600,"_5":16788,"_22829":94570,"_2311":94601},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2783":56414,"_24069":56400,"_16893":94603,"_5":16788,"_22829":94570,"_2311":94604},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2783":56415,"_24069":56400,"_16893":94606,"_5":16788,"_22829":94570,"_2311":94607},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2783":56416,"_24069":56400,"_16893":94609,"_5":16788,"_22829":94570,"_2311":94610},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2783":56417,"_24069":56417,"_5":11891,"_2311":94612,"_24384":94613,"_16893":94614,"_22829":56417},"Dispositivos e identidades",[39305,93739,41524,94612],[],{"_2783":56418,"_24069":56417,"_16893":94616,"_5":16788,"_22829":56417,"_2311":94617},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2783":56419,"_24069":56417,"_5":24381,"_16893":94619,"_22829":94620,"_2311":94621},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2783":56420,"_24069":56417,"_5":24381,"_16893":94623,"_22829":94624,"_2311":94625},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2783":56421,"_24069":56417,"_5":24381,"_16893":94627,"_22829":94628,"_2311":94629},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2783":56422,"_24069":56417,"_5":24381,"_16893":94631,"_22829":94632,"_2311":94633},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2783":56423,"_24069":56417,"_5":24381,"_16893":94635,"_22829":94636,"_2311":94637},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2783":56424,"_24069":56417,"_5":24381,"_16893":94639,"_22829":94640,"_2311":94641},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2783":56425,"_24069":56417,"_5":24381,"_16893":94643,"_22829":94644,"_2311":94645},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2783":56426,"_24069":56417,"_5":24381,"_16893":94647,"_22829":94648,"_2311":94649},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2783":56427,"_24069":56417,"_5":24381,"_16893":94651,"_22829":94652,"_2311":94653},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2783":56428,"_24069":56417,"_5":24381,"_16893":94655,"_22829":94656,"_2311":94657},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2783":56429,"_24069":56417,"_5":24381,"_16893":94659,"_22829":94660,"_2311":94661},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2783":56430,"_24069":56417,"_16893":94663,"_5":16788,"_22829":56417,"_2311":94664},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2783":56431,"_24069":56417,"_16893":94666,"_5":16788,"_22829":56417,"_2311":94667},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2783":56432,"_24069":56417,"_16893":94669,"_5":16788,"_22829":94620,"_2311":94670},[],"Vista operativa",{"_2783":56433,"_24069":56417,"_16893":94672,"_5":16788,"_22829":94620,"_2311":94673},[],"Interpretación",{"_2783":56434,"_24069":56417,"_16893":94675,"_5":16788,"_22829":94620,"_2311":41587},[],{"_2783":56435,"_24069":56417,"_16893":94677,"_5":16788,"_22829":94620,"_2311":94678},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2783":56436,"_24069":56417,"_16893":94680,"_5":16788,"_22829":94620,"_2311":41593},[],{"_2783":56437,"_24069":56417,"_16893":94682,"_5":16788,"_22829":94620,"_2311":94683},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2783":56438,"_24069":56417,"_16893":94685,"_5":16788,"_22829":94620,"_2311":41599},[],{"_2783":56439,"_24069":56417,"_16893":94687,"_5":16788,"_22829":94620,"_2311":94688},[],"La identidad está en la ventana operativa de renovación.",{"_2783":56440,"_24069":56417,"_16893":94690,"_5":16788,"_22829":94620,"_2311":41605},[],{"_2783":56441,"_24069":56417,"_16893":94692,"_5":16788,"_22829":94620,"_2311":94693},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2783":56442,"_24069":56417,"_16893":94695,"_5":16788,"_22829":94620,"_2311":41611},[],{"_2783":56443,"_24069":56417,"_16893":94697,"_5":16788,"_22829":94620,"_2311":94698},[],"La identidad ha vencido.",{"_2783":56444,"_24069":56417,"_16893":94700,"_5":16788,"_22829":94620,"_2311":41617},[],{"_2783":56445,"_24069":56417,"_16893":94702,"_5":16788,"_22829":94620,"_2311":94703},[],"La identidad está marcada como revocada.",{"_2783":56446,"_24069":56417,"_16893":94705,"_5":16788,"_22829":94620,"_2311":41623},[],{"_2783":56447,"_24069":56417,"_16893":94707,"_5":16788,"_22829":94620,"_2311":94708},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2783":56448,"_24069":56417,"_16893":94710,"_5":16788,"_22829":94620,"_2311":94711},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2783":56449,"_24069":56417,"_16893":94713,"_5":16788,"_22829":94624,"_2311":94714},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2783":56450,"_24069":56417,"_16893":94716,"_5":16788,"_22829":94624,"_2311":94717},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2783":56451,"_24069":56417,"_16893":94719,"_5":16788,"_22829":94624,"_2311":94720},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2783":56452,"_24069":56417,"_16893":94722,"_5":16788,"_22829":94624,"_2311":94723},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2783":56453,"_24069":56417,"_16893":94725,"_5":16788,"_22829":94628,"_2311":94726},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2783":56454,"_24069":56417,"_16893":94728,"_5":16788,"_22829":94632,"_2311":94729},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2783":56455,"_24069":56417,"_16893":94731,"_5":16788,"_22829":94636,"_2311":94732},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2783":56456,"_24069":56417,"_16893":94734,"_5":16788,"_22829":94640,"_2311":94735},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2783":56457,"_24069":56417,"_16893":94737,"_5":16788,"_22829":94644,"_2311":94738},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2783":56458,"_24069":56417,"_16893":94740,"_5":16788,"_22829":94644,"_2311":94741},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2783":56459,"_24069":56417,"_16893":94743,"_5":16788,"_22829":94648,"_2311":94744},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2783":56460,"_24069":56417,"_16893":94746,"_5":16788,"_22829":94648,"_2311":94747},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2783":56461,"_24069":56417,"_16893":94749,"_5":16788,"_22829":94648,"_2311":94750},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2783":56462,"_24069":56417,"_16893":94752,"_5":16788,"_22829":94648,"_2311":94753},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2783":56463,"_24069":56417,"_16893":94755,"_5":16788,"_22829":94648,"_2311":94756},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2783":56464,"_24069":56417,"_16893":94758,"_5":16788,"_22829":94648,"_2311":94759},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2783":56465,"_24069":56417,"_16893":94761,"_5":16788,"_22829":94652,"_2311":94762},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2783":56466,"_24069":56417,"_16893":94764,"_5":16788,"_22829":94652,"_2311":94765},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2783":56467,"_24069":56417,"_16893":94767,"_5":16788,"_22829":94656,"_2311":94768},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2783":56468,"_24069":56417,"_16893":94770,"_5":16788,"_22829":94656,"_2311":94771},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2783":56469,"_24069":56417,"_16893":94773,"_5":16788,"_22829":94656,"_2311":94774},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2783":56470,"_24069":56417,"_16893":94776,"_5":16788,"_22829":94656,"_2311":94777},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2783":56471,"_24069":56417,"_16893":94779,"_5":16788,"_22829":94660,"_2311":94780},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":56472,"_24069":56417,"_16893":94782,"_5":16788,"_22829":94660,"_2311":94783},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":56473,"_24069":56473,"_5":11891,"_2311":94785,"_24384":94786,"_16893":94788,"_22829":56473},"Identidad inicial y autenticación",[39305,93739,41524,94612,94787],"Enrolamiento con PKI",[],{"_2783":56474,"_24069":56473,"_16893":94790,"_5":16788,"_22829":56473,"_2311":94791},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2783":56475,"_24069":56473,"_5":24381,"_16893":94793,"_22829":94794,"_2311":94795},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2783":56476,"_24069":56473,"_5":24381,"_16893":94797,"_22829":94798,"_2311":94799},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2783":56477,"_24069":56473,"_5":24381,"_16893":94801,"_22829":94802,"_2311":94803},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2783":56478,"_24069":56473,"_5":24381,"_16893":94805,"_22829":94806,"_2311":94807},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2783":56479,"_24069":56473,"_5":24381,"_16893":94809,"_22829":94810,"_2311":94811},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2783":56480,"_24069":56473,"_16893":94813,"_5":16788,"_22829":56473,"_2311":94814},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2783":56481,"_24069":56473,"_16893":94816,"_5":16788,"_22829":94794,"_2311":94817},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2783":56482,"_24069":56473,"_16893":94819,"_5":16788,"_22829":94794,"_2311":94820},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2783":56483,"_24069":56473,"_16893":94822,"_5":16788,"_22829":94798,"_2311":94823},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2783":56484,"_24069":56473,"_16893":94825,"_5":16788,"_22829":94798,"_2311":94826},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2783":56485,"_24069":56473,"_16893":94828,"_5":16788,"_22829":94798,"_2311":94829},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2783":56486,"_24069":56473,"_16893":94831,"_5":16788,"_22829":94802,"_2311":94832},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2783":56487,"_24069":56473,"_16893":94834,"_5":16788,"_22829":94802,"_2311":94835},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2783":56488,"_24069":56473,"_16893":94837,"_5":16788,"_22829":94806,"_2311":94838},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado.",{"_2783":56489,"_24069":56473,"_16893":94840,"_5":16788,"_22829":94806,"_2311":94841},[],"Ejemplo de cuerpo:",{"_2783":56490,"_24069":56473,"_16893":94843,"_5":16788,"_22829":94806,"_2311":94844},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2783":56491,"_24069":56473,"_16893":94846,"_5":16788,"_22829":94806,"_2311":94847},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2783":56492,"_24069":56473,"_16893":94849,"_5":16788,"_22829":94806,"_2311":94850},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2783":56493,"_24069":56473,"_16893":94852,"_5":16788,"_22829":94806,"_2311":94853},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2783":56494,"_24069":56473,"_16893":94855,"_5":16788,"_22829":94810,"_2311":94856},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2783":56495,"_24069":56473,"_16893":94858,"_5":16788,"_22829":94810,"_2311":94859},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2783":56496,"_24069":56496,"_5":11891,"_2311":94861,"_24384":94862,"_16893":94863,"_22829":56496},"Configura y opera el DMS",[39305,93739,41524,94612,94787],[],{"_2783":56497,"_24069":56496,"_16893":94865,"_5":16788,"_22829":56496,"_2311":94866},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2783":56498,"_24069":56496,"_5":24381,"_16893":94868,"_22829":94869,"_2311":92440},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2783":56499,"_24069":56496,"_5":24381,"_16893":94871,"_22829":94872,"_2311":94873},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2783":56500,"_24069":56496,"_5":24381,"_16893":94875,"_22829":94876,"_2311":94877},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2783":56501,"_24069":56496,"_5":24381,"_16893":94879,"_22829":94880,"_2311":94881},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2783":56502,"_24069":56496,"_5":24381,"_16893":94883,"_22829":94884,"_2311":94885},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2783":56503,"_24069":56496,"_5":24381,"_16893":94887,"_22829":94888,"_2311":94889},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2783":56504,"_24069":56496,"_5":24381,"_16893":94891,"_22829":94892,"_2311":94893},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2783":56505,"_24069":56496,"_5":24381,"_16893":94895,"_22829":94896,"_2311":94897},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2783":56506,"_24069":56496,"_5":24381,"_16893":94899,"_22829":94900,"_2311":41819},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2783":56507,"_24069":56496,"_5":24381,"_16893":94902,"_22829":94903,"_2311":41823},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2783":56508,"_24069":56496,"_5":24381,"_16893":94905,"_22829":94906,"_2311":94907},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2783":56509,"_24069":56496,"_5":24381,"_16893":94909,"_22829":94910,"_2311":94911},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2783":56510,"_24069":56496,"_5":24381,"_16893":94913,"_22829":94914,"_2311":94915},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2783":56511,"_24069":56496,"_5":24381,"_16893":94917,"_22829":94918,"_2311":41839},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2783":56512,"_24069":56496,"_5":24381,"_16893":94920,"_22829":94921,"_2311":94922},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2783":56513,"_24069":56496,"_5":24381,"_16893":94924,"_22829":94925,"_2311":94926},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2783":56514,"_24069":56496,"_5":24381,"_16893":94928,"_22829":94929,"_2311":94930},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2783":56515,"_24069":56496,"_16893":94932,"_5":16788,"_22829":56496,"_2311":94933},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2783":56516,"_24069":56496,"_16893":94935,"_5":16788,"_22829":94869,"_2311":94936},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2783":56517,"_24069":56496,"_16893":94938,"_5":16788,"_22829":94869,"_2311":94939},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2783":56518,"_24069":56496,"_16893":94941,"_5":16788,"_22829":94876,"_2311":94942},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2783":56519,"_24069":56496,"_16893":94944,"_5":16788,"_22829":94880,"_2311":94945},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2783":56520,"_24069":56496,"_16893":94947,"_5":16788,"_22829":94884,"_2311":94948},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2783":56521,"_24069":56496,"_16893":94950,"_5":16788,"_22829":94888,"_2311":94951},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2783":56522,"_24069":56496,"_16893":94953,"_5":16788,"_22829":94892,"_2311":94954},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2783":56523,"_24069":56496,"_16893":94956,"_5":16788,"_22829":94900,"_2311":94957},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2783":56524,"_24069":56496,"_16893":94959,"_5":16788,"_22829":94900,"_2311":94960},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2783":56525,"_24069":56496,"_16893":94962,"_5":16788,"_22829":94903,"_2311":94963},[],"Campo de `settings.enrollment_settings`",{"_2783":56526,"_24069":56496,"_16893":94965,"_5":16788,"_22829":94903,"_2311":94966},[],"Decisión",{"_2783":56527,"_24069":56496,"_16893":94968,"_5":16788,"_22829":94903,"_2311":41890},[],{"_2783":56528,"_24069":56496,"_16893":94970,"_5":16788,"_22829":94903,"_2311":94971},[],"`EST_RFC7030` para estas operaciones.",{"_2783":56529,"_24069":56496,"_16893":94973,"_5":16788,"_22829":94903,"_2311":41896},[],{"_2783":56530,"_24069":56496,"_16893":94975,"_5":16788,"_22829":94903,"_2311":94976},[],"ID de la CA que firmará.",{"_2783":56531,"_24069":56496,"_16893":94978,"_5":16788,"_22829":94903,"_2311":41902},[],{"_2783":56532,"_24069":56496,"_16893":94980,"_5":16788,"_22829":94903,"_2311":94981},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2783":56533,"_24069":56496,"_16893":94983,"_5":16788,"_22829":94903,"_2311":41908},[],{"_2783":56534,"_24069":56496,"_16893":94985,"_5":16788,"_22829":94903,"_2311":94986},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2783":56535,"_24069":56496,"_16893":94988,"_5":16788,"_22829":94903,"_2311":41914},[],{"_2783":56536,"_24069":56496,"_16893":94990,"_5":16788,"_22829":94903,"_2311":94991},[],"Uno de los cuatro modos de autenticación.",{"_2783":56537,"_24069":56496,"_16893":94993,"_5":16788,"_22829":94903,"_2311":94994},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2783":56538,"_24069":56496,"_16893":94996,"_5":16788,"_22829":94906,"_2311":94997},[],"Los bloques son independientes:",{"_2783":56539,"_24069":56496,"_16893":94999,"_5":16788,"_22829":94906,"_2311":95000},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2783":56540,"_24069":56496,"_16893":95002,"_5":16788,"_22829":94906,"_2311":95003},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2783":56541,"_24069":56496,"_16893":95005,"_5":16788,"_22829":94906,"_2311":41932},[],{"_2783":56542,"_24069":56496,"_16893":95007,"_5":16788,"_22829":94906,"_2311":95008},[],"Control aplicado en la operación configurada",{"_2783":56543,"_24069":56496,"_16893":95010,"_5":16788,"_22829":94906,"_2311":41938},[],{"_2783":56544,"_24069":56496,"_16893":95012,"_5":16788,"_22829":94906,"_2311":95013},[],"Validación del certificado presentado.",{"_2783":56545,"_24069":56496,"_16893":95015,"_5":16788,"_22829":94906,"_2311":41944},[],{"_2783":56546,"_24069":56496,"_16893":95017,"_5":16788,"_22829":94906,"_2311":95018},[],"Autorización del webhook configurado.",{"_2783":56547,"_24069":56496,"_16893":95020,"_5":16788,"_22829":94906,"_2311":41950},[],{"_2783":56548,"_24069":56496,"_16893":95022,"_5":16788,"_22829":94906,"_2311":95023},[],"Validación del certificado y, después, aprobación del webhook.",{"_2783":56549,"_24069":56496,"_16893":95025,"_5":16788,"_22829":94906,"_2311":41956},[],{"_2783":56550,"_24069":56496,"_16893":95027,"_5":16788,"_22829":94906,"_2311":95028},[],"Sin autenticación del solicitante por el DMS.",{"_2783":56551,"_24069":56496,"_16893":95030,"_5":16788,"_22829":94906,"_2311":95031},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2783":56552,"_24069":56496,"_16893":95033,"_5":16788,"_22829":94906,"_2311":95034},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2783":56553,"_24069":56496,"_16893":95036,"_5":16788,"_22829":94906,"_2311":95037},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2783":56554,"_24069":56496,"_16893":95039,"_5":16788,"_22829":94906,"_2311":95040},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2783":56555,"_24069":56496,"_16893":95042,"_5":16788,"_22829":94906,"_2311":95043},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2783":56556,"_24069":56496,"_16893":95045,"_5":16788,"_22829":94910,"_2311":95046},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2783":56557,"_24069":56496,"_16893":95048,"_5":16788,"_22829":94914,"_2311":95049},[],"Campo de `settings.reenrollment_settings`",{"_2783":56558,"_24069":56496,"_16893":95051,"_5":16788,"_22829":94914,"_2311":95052},[],"Función",{"_2783":56559,"_24069":56496,"_16893":95054,"_5":16788,"_22829":94914,"_2311":41985},[],{"_2783":56560,"_24069":56496,"_16893":95056,"_5":16788,"_22829":94914,"_2311":95057},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2783":56561,"_24069":56496,"_16893":95059,"_5":16788,"_22829":94914,"_2311":41991},[],{"_2783":56562,"_24069":56496,"_16893":95061,"_5":16788,"_22829":94914,"_2311":95062},[],"Umbral operativo preventivo de monitorización.",{"_2783":56563,"_24069":56496,"_16893":95064,"_5":16788,"_22829":94914,"_2311":41997},[],{"_2783":56564,"_24069":56496,"_16893":95066,"_5":16788,"_22829":94914,"_2311":95067},[],"Umbral operativo crítico de monitorización.",{"_2783":56565,"_24069":56496,"_16893":95069,"_5":16788,"_22829":94914,"_2311":42003},[],{"_2783":56566,"_24069":56496,"_16893":95071,"_5":16788,"_22829":94914,"_2311":95072},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2783":56567,"_24069":56496,"_16893":95074,"_5":16788,"_22829":94914,"_2311":42009},[],{"_2783":56568,"_24069":56496,"_16893":95076,"_5":16788,"_22829":94914,"_2311":95077},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2783":56569,"_24069":56496,"_16893":95079,"_5":16788,"_22829":94914,"_2311":42015},[],{"_2783":56570,"_24069":56496,"_16893":95081,"_5":16788,"_22829":94914,"_2311":95082},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2783":56571,"_24069":56496,"_16893":95084,"_5":16788,"_22829":94914,"_2311":95085},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2783":56572,"_24069":56496,"_16893":95087,"_5":16788,"_22829":94918,"_2311":95088},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2783":56573,"_24069":56496,"_16893":95090,"_5":16788,"_22829":94921,"_2311":92797},[],{"_2783":56574,"_24069":56496,"_16893":95092,"_5":16788,"_22829":94921,"_2311":95093},[],"Qué publica",{"_2783":56575,"_24069":56496,"_16893":95095,"_5":16788,"_22829":94921,"_2311":42032},[],{"_2783":56576,"_24069":56496,"_16893":95097,"_5":16788,"_22829":94921,"_2311":95098},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2783":56577,"_24069":56496,"_16893":95100,"_5":16788,"_22829":94921,"_2311":42038},[],{"_2783":56578,"_24069":56496,"_16893":95102,"_5":16788,"_22829":94921,"_2311":95103},[],"Certificado de la CA emisora seleccionada.",{"_2783":56579,"_24069":56496,"_16893":95105,"_5":16788,"_22829":94921,"_2311":42044},[],{"_2783":56580,"_24069":56496,"_16893":95107,"_5":16788,"_22829":94921,"_2311":95108},[],"Certificados de las CAs elegidas explícitamente.",{"_2783":56581,"_24069":56496,"_16893":95110,"_5":16788,"_22829":94921,"_2311":95111},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2783":56582,"_24069":56496,"_16893":95113,"_5":16788,"_22829":94925,"_2311":95114},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2783":56583,"_24069":56496,"_16893":95116,"_5":16788,"_22829":94925,"_2311":95117},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2783":56584,"_24069":56496,"_16893":95119,"_5":16788,"_22829":94925,"_2311":95120},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2783":56585,"_24069":56496,"_16893":95122,"_5":16788,"_22829":94929,"_2311":95123},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2783":56586,"_24069":56586,"_5":11891,"_2311":95125,"_24384":95126,"_16893":95127,"_22829":56586},"Integra el cliente EST",[39305,93739,41524,94612,94787],[],{"_2783":56587,"_24069":56586,"_16893":95129,"_5":16788,"_22829":56586,"_2311":95130},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2783":56588,"_24069":56586,"_5":24381,"_16893":95132,"_22829":95133,"_2311":92440},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2783":56589,"_24069":56586,"_5":24381,"_16893":95135,"_22829":95136,"_2311":95137},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2783":56590,"_24069":56586,"_5":24381,"_16893":95139,"_22829":95140,"_2311":95141},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2783":56591,"_24069":56586,"_5":24381,"_16893":95143,"_22829":95144,"_2311":95145},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2783":56592,"_24069":56586,"_5":24381,"_16893":95147,"_22829":95148,"_2311":95149},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2783":56593,"_24069":56586,"_5":24381,"_16893":95151,"_22829":95152,"_2311":95153},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2783":56594,"_24069":56586,"_16893":95155,"_5":16788,"_22829":56586,"_2311":95156},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2783":56595,"_24069":56586,"_16893":95158,"_5":16788,"_22829":95133,"_2311":95159},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2783":56596,"_24069":56586,"_16893":95161,"_5":16788,"_22829":95133,"_2311":95162},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2783":56597,"_24069":56586,"_16893":95164,"_5":16788,"_22829":95133,"_2311":95165},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2783":56598,"_24069":56586,"_16893":95167,"_5":16788,"_22829":95136,"_2311":95168},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2783":56599,"_24069":56586,"_16893":95170,"_5":16788,"_22829":95136,"_2311":95171},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2783":56600,"_24069":56586,"_16893":95173,"_5":16788,"_22829":95140,"_2311":95174},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2783":56601,"_24069":56586,"_16893":95176,"_5":16788,"_22829":95140,"_2311":95177},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2783":56602,"_24069":56586,"_16893":95179,"_5":16788,"_22829":95144,"_2311":95180},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2783":56603,"_24069":56586,"_16893":95182,"_5":16788,"_22829":95144,"_2311":95183},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2783":56604,"_24069":56586,"_16893":95185,"_5":16788,"_22829":95148,"_2311":95186},[],"Para el caso de una raíz que emite directamente:",{"_2783":56605,"_24069":56586,"_16893":95188,"_5":16788,"_22829":95148,"_2311":95189},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2783":56606,"_24069":56586,"_16893":95191,"_5":16788,"_22829":95148,"_2311":95192},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2783":56607,"_24069":56586,"_16893":95194,"_5":16788,"_22829":95152,"_2311":95195},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2783":56608,"_24069":56608,"_5":11891,"_2311":95197,"_24384":95198,"_16893":95199,"_22829":56608},"Referencia EST",[39305,93739,41524,94612,94787],[],{"_2783":56609,"_24069":56608,"_16893":95201,"_5":16788,"_22829":56608,"_2311":95202},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2783":56610,"_24069":56608,"_5":24381,"_16893":95204,"_22829":95205,"_2311":95206},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2783":56611,"_24069":56608,"_5":24381,"_16893":95208,"_22829":95209,"_2311":18303},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2783":56612,"_24069":56608,"_5":24381,"_16893":95211,"_22829":95212,"_2311":20997},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2783":56613,"_24069":56608,"_5":24381,"_16893":95214,"_22829":95215,"_2311":21004},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2783":56614,"_24069":56608,"_5":24381,"_16893":95217,"_22829":95218,"_2311":20373},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2783":56615,"_24069":56608,"_5":24381,"_16893":95220,"_22829":95221,"_2311":95222},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2783":56616,"_24069":56608,"_5":24381,"_16893":95224,"_22829":95225,"_2311":95226},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2783":56617,"_24069":56608,"_5":24381,"_16893":95228,"_22829":95229,"_2311":95230},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2783":56618,"_24069":56608,"_16893":95232,"_5":16788,"_22829":56608,"_2311":95233},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2783":56619,"_24069":56608,"_16893":95235,"_5":16788,"_22829":95205,"_2311":95236},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2783":56620,"_24069":56608,"_16893":95238,"_5":16788,"_22829":95205,"_2311":93530},[],{"_2783":56621,"_24069":56608,"_16893":95240,"_5":16788,"_22829":95205,"_2311":95241},[],"Método",{"_2783":56622,"_24069":56608,"_16893":95243,"_5":16788,"_22829":95205,"_2311":95244},[],"Autenticación y condición",{"_2783":56623,"_24069":56608,"_16893":95246,"_5":16788,"_22829":95205,"_2311":42187},[],{"_2783":56624,"_24069":56608,"_16893":95248,"_5":16788,"_22829":95205,"_2311":42190},[],{"_2783":56625,"_24069":56608,"_16893":95250,"_5":16788,"_22829":95205,"_2311":95251},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2783":56626,"_24069":56608,"_16893":95253,"_5":16788,"_22829":95205,"_2311":42196},[],{"_2783":56627,"_24069":56608,"_16893":95255,"_5":16788,"_22829":95205,"_2311":42199},[],{"_2783":56628,"_24069":56608,"_16893":95257,"_5":16788,"_22829":95205,"_2311":95258},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2783":56629,"_24069":56608,"_16893":95260,"_5":16788,"_22829":95205,"_2311":42205},[],{"_2783":56630,"_24069":56608,"_16893":95262,"_5":16788,"_22829":95205,"_2311":42199},[],{"_2783":56631,"_24069":56608,"_16893":95264,"_5":16788,"_22829":95205,"_2311":95265},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2783":56632,"_24069":56608,"_16893":95267,"_5":16788,"_22829":95205,"_2311":42213},[],{"_2783":56633,"_24069":56608,"_16893":95269,"_5":16788,"_22829":95205,"_2311":42199},[],{"_2783":56634,"_24069":56608,"_16893":95271,"_5":16788,"_22829":95205,"_2311":95272},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2783":56635,"_24069":56608,"_16893":95274,"_5":16788,"_22829":95205,"_2311":95275},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2783":56636,"_24069":56608,"_16893":95277,"_5":16788,"_22829":95209,"_2311":95278},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2783":56637,"_24069":56608,"_16893":95280,"_5":16788,"_22829":95209,"_2311":95281},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2783":56638,"_24069":56608,"_16893":95283,"_5":16788,"_22829":95212,"_2311":95284},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2783":56639,"_24069":56608,"_16893":95286,"_5":16788,"_22829":95212,"_2311":95287},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2783":56640,"_24069":56608,"_16893":95289,"_5":16788,"_22829":95215,"_2311":95290},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2783":56641,"_24069":56608,"_16893":95292,"_5":16788,"_22829":95215,"_2311":95293},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2783":56642,"_24069":56608,"_16893":95295,"_5":16788,"_22829":95218,"_2311":95296},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2783":56643,"_24069":56608,"_16893":95298,"_5":16788,"_22829":95218,"_2311":95299},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2783":56644,"_24069":56608,"_16893":95301,"_5":16788,"_22829":95221,"_2311":95302},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2783":56645,"_24069":56608,"_16893":95304,"_5":16788,"_22829":95221,"_2311":95305},[],"Parte",{"_2783":56646,"_24069":56608,"_16893":95307,"_5":16788,"_22829":95221,"_2311":95308},[],"Contenido tras decodificar su Base64",{"_2783":56647,"_24069":56608,"_16893":95310,"_5":16788,"_22829":95221,"_2311":42257},[],{"_2783":56648,"_24069":56608,"_16893":95312,"_5":16788,"_22829":95221,"_2311":95313},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2783":56649,"_24069":56608,"_16893":95315,"_5":16788,"_22829":95221,"_2311":42263},[],{"_2783":56650,"_24069":56608,"_16893":95317,"_5":16788,"_22829":95221,"_2311":95318},[],"PKCS#7 DER con el certificado emitido.",{"_2783":56651,"_24069":56608,"_16893":95320,"_5":16788,"_22829":95221,"_2311":95321},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2783":56652,"_24069":56608,"_16893":95323,"_5":16788,"_22829":95225,"_2311":95324},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2783":56653,"_24069":56608,"_16893":95326,"_5":16788,"_22829":95225,"_2311":95327},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2783":56654,"_24069":56608,"_16893":95329,"_5":16788,"_22829":95225,"_2311":95330},[],"Convierte y comprueba el resultado:",{"_2783":56655,"_24069":56608,"_16893":95332,"_5":16788,"_22829":95225,"_2311":95333},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2783":56656,"_24069":56608,"_16893":95335,"_5":16788,"_22829":95229,"_2311":95336},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2783":56657,"_24069":56608,"_16893":95338,"_5":16788,"_22829":95229,"_2311":95339},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2783":56658,"_24069":56658,"_5":11891,"_2311":94787,"_24384":95341,"_16893":95342,"_22829":56658},[39305,93739,41524,94612,94787],[],{"_2783":56659,"_24069":56658,"_16893":95344,"_5":16788,"_22829":56658,"_2311":95345},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2783":56660,"_24069":56658,"_5":24381,"_16893":95347,"_22829":95348,"_2311":95349},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2783":56661,"_24069":56658,"_5":24381,"_16893":95351,"_22829":95352,"_2311":95353},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2783":56662,"_24069":56658,"_5":24381,"_16893":95355,"_22829":95356,"_2311":95357},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2783":56663,"_24069":56658,"_5":24381,"_16893":95359,"_22829":95360,"_2311":95361},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2783":56664,"_24069":56658,"_16893":95363,"_5":16788,"_22829":56658,"_2311":95364},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2783":56665,"_24069":56658,"_16893":95366,"_5":16788,"_22829":95348,"_2311":95367},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2783":56666,"_24069":56658,"_16893":95369,"_5":16788,"_22829":95348,"_2311":95370},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2783":56667,"_24069":56658,"_16893":95372,"_5":16788,"_22829":95348,"_2311":95373},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2783":56668,"_24069":56658,"_16893":95375,"_5":16788,"_22829":95348,"_2311":95376},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2783":56669,"_24069":56658,"_16893":95378,"_5":16788,"_22829":95348,"_2311":95379},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2783":56670,"_24069":56658,"_16893":95381,"_5":16788,"_22829":95348,"_2311":95382},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2783":56671,"_24069":56658,"_16893":95384,"_5":16788,"_22829":95352,"_2311":95385},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2783":56672,"_24069":56658,"_16893":95387,"_5":16788,"_22829":95352,"_2311":95388},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":56673,"_24069":56658,"_16893":95390,"_5":16788,"_22829":95352,"_2311":95391},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2783":56674,"_24069":56658,"_16893":95393,"_5":16788,"_22829":95352,"_2311":95394},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2783":56675,"_24069":56658,"_16893":95396,"_5":16788,"_22829":95356,"_2311":95397},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":56676,"_24069":56658,"_16893":95399,"_5":16788,"_22829":95356,"_2311":95400},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":56677,"_24069":56658,"_16893":95402,"_5":16788,"_22829":95356,"_2311":95403},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2783":56678,"_24069":56658,"_16893":95405,"_5":16788,"_22829":95356,"_2311":95406},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2783":56679,"_24069":56658,"_16893":95408,"_5":16788,"_22829":95360,"_2311":95409},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2783":56680,"_24069":56658,"_16893":95411,"_5":16788,"_22829":95360,"_2311":95412},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2783":56681,"_24069":56681,"_5":11891,"_2311":95414,"_24384":95415,"_16893":95416,"_22829":56681},"Estrategias de aprovisionamiento",[39305,93739,41524,94612,94787],[],{"_2783":56682,"_24069":56681,"_16893":95418,"_5":16788,"_22829":56681,"_2311":95419},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2783":56683,"_24069":56681,"_5":24381,"_16893":95421,"_22829":95422,"_2311":95423},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2783":56684,"_24069":56681,"_5":24381,"_16893":95425,"_22829":95426,"_2311":95427},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2783":56685,"_24069":56681,"_5":24381,"_16893":95429,"_22829":95430,"_2311":95431},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2783":56686,"_24069":56681,"_5":24381,"_16893":95433,"_22829":95434,"_2311":95435},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2783":56687,"_24069":56681,"_5":24381,"_16893":95437,"_22829":95438,"_2311":95439},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2783":56688,"_24069":56681,"_16893":95441,"_5":16788,"_22829":56681,"_2311":95442},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2783":56689,"_24069":56681,"_16893":95444,"_5":16788,"_22829":95422,"_2311":95445},[],"Recorrido",{"_2783":56690,"_24069":56681,"_16893":95447,"_5":16788,"_22829":95422,"_2311":95448},[],"Cuándo existe el dispositivo",{"_2783":56691,"_24069":56681,"_16893":95450,"_5":16788,"_22829":95422,"_2311":95451},[],"Qué compruebas",{"_2783":56692,"_24069":56681,"_16893":95453,"_5":16788,"_22829":95422,"_2311":95454},[],"Asignación manual",{"_2783":56693,"_24069":56681,"_16893":95456,"_5":16788,"_22829":95422,"_2311":95457},[],"El operador lo crea antes de asociar un certificado.",{"_2783":56694,"_24069":56681,"_16893":95459,"_5":16788,"_22829":95422,"_2311":95460},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2783":56695,"_24069":56681,"_16893":95462,"_5":16788,"_22829":95422,"_2311":95463},[],"EST con `JITP`",{"_2783":56696,"_24069":56681,"_16893":95465,"_5":16788,"_22829":95422,"_2311":95466},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2783":56697,"_24069":56681,"_16893":95468,"_5":16788,"_22829":95422,"_2311":95469},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2783":56698,"_24069":56681,"_16893":95471,"_5":16788,"_22829":95422,"_2311":95472},[],"EST con `PRE_REGISTRATION`",{"_2783":56699,"_24069":56681,"_16893":95474,"_5":16788,"_22829":95422,"_2311":95475},[],"Debe existir antes de `/simpleenroll`.",{"_2783":56700,"_24069":56681,"_16893":95477,"_5":16788,"_22829":95422,"_2311":95478},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2783":56701,"_24069":56681,"_16893":95480,"_5":16788,"_22829":95422,"_2311":95481},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2783":56702,"_24069":56681,"_16893":95483,"_5":16788,"_22829":95422,"_2311":95484},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2783":56703,"_24069":56681,"_16893":95486,"_5":16788,"_22829":95426,"_2311":95487},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2783":56704,"_24069":56681,"_16893":95489,"_5":16788,"_22829":95426,"_2311":95490},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2783":56705,"_24069":56681,"_16893":95492,"_5":16788,"_22829":95426,"_2311":95493},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2783":56706,"_24069":56681,"_16893":95495,"_5":16788,"_22829":95430,"_2311":95496},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2783":56707,"_24069":56681,"_16893":95498,"_5":16788,"_22829":95430,"_2311":95499},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2783":56708,"_24069":56681,"_16893":95501,"_5":16788,"_22829":95430,"_2311":95502},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2783":56709,"_24069":56681,"_16893":95504,"_5":16788,"_22829":95430,"_2311":95505},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2783":56710,"_24069":56681,"_16893":95507,"_5":16788,"_22829":95430,"_2311":95508},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2783":56711,"_24069":56681,"_16893":95510,"_5":16788,"_22829":95430,"_2311":95511},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2783":56712,"_24069":56681,"_16893":95513,"_5":16788,"_22829":95434,"_2311":92797},[],{"_2783":56713,"_24069":56681,"_16893":95515,"_5":16788,"_22829":95434,"_2311":95516},[],"Material que atraviesa EST",{"_2783":56714,"_24069":56681,"_16893":95518,"_5":16788,"_22829":95434,"_2311":95519},[],"Clave generada por el dispositivo",{"_2783":56715,"_24069":56681,"_16893":95521,"_5":16788,"_22829":95434,"_2311":95522},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2783":56716,"_24069":56681,"_16893":95524,"_5":16788,"_22829":95434,"_2311":95525},[],"Clave ya disponible en el dispositivo",{"_2783":56717,"_24069":56681,"_16893":95527,"_5":16788,"_22829":95434,"_2311":95528},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2783":56718,"_24069":56681,"_16893":95530,"_5":16788,"_22829":95434,"_2311":41839},[],{"_2783":56719,"_24069":56681,"_16893":95532,"_5":16788,"_22829":95434,"_2311":95533},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2783":56720,"_24069":56681,"_16893":95535,"_5":16788,"_22829":95434,"_2311":95536},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2783":56721,"_24069":56681,"_16893":95538,"_5":16788,"_22829":95438,"_2311":95539},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2783":56722,"_24069":56722,"_5":11891,"_2311":95541,"_24384":95542,"_16893":95543,"_22829":56722},"Renovación y recuperación",[39305,93739,41524,94612,94787],[],{"_2783":56723,"_24069":56722,"_16893":95545,"_5":16788,"_22829":56722,"_2311":95546},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2783":56724,"_24069":56722,"_5":24381,"_16893":95548,"_22829":95549,"_2311":95550},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2783":56725,"_24069":56722,"_5":24381,"_16893":95552,"_22829":95553,"_2311":95554},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2783":56726,"_24069":56722,"_5":24381,"_16893":95556,"_22829":95557,"_2311":95558},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2783":56727,"_24069":56722,"_5":24381,"_16893":95560,"_22829":95561,"_2311":95562},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2783":56728,"_24069":56722,"_5":24381,"_16893":95564,"_22829":95565,"_2311":95566},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2783":56729,"_24069":56722,"_16893":95568,"_5":16788,"_22829":56722,"_2311":95569},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2783":56730,"_24069":56722,"_16893":95571,"_5":16788,"_22829":95549,"_2311":95572},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2783":56731,"_24069":56722,"_16893":95574,"_5":16788,"_22829":95549,"_2311":95575},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2783":56732,"_24069":56722,"_16893":95577,"_5":16788,"_22829":95549,"_2311":95578},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2783":56733,"_24069":56722,"_16893":95580,"_5":16788,"_22829":95549,"_2311":95581},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2783":56734,"_24069":56722,"_16893":95583,"_5":16788,"_22829":95553,"_2311":95584},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2783":56735,"_24069":56722,"_16893":95586,"_5":16788,"_22829":95553,"_2311":95587},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2783":56736,"_24069":56722,"_16893":95589,"_5":16788,"_22829":95557,"_2311":95590},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2783":56737,"_24069":56722,"_16893":95592,"_5":16788,"_22829":95557,"_2311":95593},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2783":56738,"_24069":56722,"_16893":95595,"_5":16788,"_22829":95557,"_2311":95596},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2783":56739,"_24069":56722,"_16893":95598,"_5":16788,"_22829":95561,"_2311":95599},[],"Situación",{"_2783":56740,"_24069":56722,"_16893":95601,"_5":16788,"_22829":95561,"_2311":95602},[],"Procedimiento",{"_2783":56741,"_24069":56722,"_16893":95604,"_5":16788,"_22829":95561,"_2311":95605},[],"Certificado vigente, fuera de ventana",{"_2783":56742,"_24069":56722,"_16893":95607,"_5":16788,"_22829":95561,"_2311":95608},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2783":56743,"_24069":56722,"_16893":95610,"_5":16788,"_22829":95561,"_2311":95611},[],"Certificado vencido, clave disponible",{"_2783":56744,"_24069":56722,"_16893":95613,"_5":16788,"_22829":95561,"_2311":95614},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2783":56745,"_24069":56722,"_16893":95616,"_5":16788,"_22829":95561,"_2311":95617},[],"Renovación por webhook o `NO_AUTH`",{"_2783":56746,"_24069":56722,"_16893":95619,"_5":16788,"_22829":95561,"_2311":95620},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2783":56747,"_24069":56722,"_16893":95622,"_5":16788,"_22829":95561,"_2311":95623},[],"Clave perdida o inaccesible",{"_2783":56748,"_24069":56722,"_16893":95625,"_5":16788,"_22829":95561,"_2311":95626},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2783":56749,"_24069":56722,"_16893":95628,"_5":16788,"_22829":95561,"_2311":95629},[],"Identidad actual revocada",{"_2783":56750,"_24069":56722,"_16893":95631,"_5":16788,"_22829":95561,"_2311":95632},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2783":56751,"_24069":56722,"_16893":95634,"_5":16788,"_22829":95561,"_2311":95635},[],"Dispositivo sin identidad",{"_2783":56752,"_24069":56722,"_16893":95637,"_5":16788,"_22829":95561,"_2311":95638},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2783":56753,"_24069":56722,"_16893":95640,"_5":16788,"_22829":95561,"_2311":95641},[],"Dispositivo retirado",{"_2783":56754,"_24069":56722,"_16893":95643,"_5":16788,"_22829":95561,"_2311":95644},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2783":56755,"_24069":56722,"_16893":95646,"_5":16788,"_22829":95561,"_2311":95647},[],"Timeout, HTTP 500 o fallo de instalación",{"_2783":56756,"_24069":56722,"_16893":95649,"_5":16788,"_22829":95561,"_2311":95650},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2783":56757,"_24069":56722,"_16893":95652,"_5":16788,"_22829":95565,"_2311":95653},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2783":56758,"_24069":56722,"_16893":95655,"_5":16788,"_22829":95565,"_2311":95656},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2783":56759,"_24069":56759,"_5":11891,"_2311":95658,"_24384":95659,"_16893":95660,"_22829":56759},"Diagnóstico de enrolamiento",[39305,93739,41524,94612,94787],[],{"_2783":56760,"_24069":56759,"_16893":95662,"_5":16788,"_22829":56759,"_2311":95663},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2783":56761,"_24069":56759,"_5":24381,"_16893":95665,"_22829":95666,"_2311":95667},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2783":56762,"_24069":56759,"_5":24381,"_16893":95669,"_22829":95670,"_2311":95671},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2783":56763,"_24069":56759,"_5":24381,"_16893":95673,"_22829":95674,"_2311":95230},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2783":56764,"_24069":56759,"_5":24381,"_16893":95676,"_22829":95677,"_2311":95678},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2783":56765,"_24069":56759,"_16893":95680,"_5":16788,"_22829":56759,"_2311":95681},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2783":56766,"_24069":56759,"_16893":95683,"_5":16788,"_22829":95670,"_2311":95684},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2783":56767,"_24069":56759,"_16893":95686,"_5":16788,"_22829":95670,"_2311":95687},[],"Síntoma o mensaje",{"_2783":56768,"_24069":56759,"_16893":95689,"_5":16788,"_22829":95670,"_2311":95690},[],"Qué revisar",{"_2783":56769,"_24069":56759,"_16893":95692,"_5":16788,"_22829":95670,"_2311":95693},[],"curl rechaza TLS, nombre o emisor",{"_2783":56770,"_24069":56759,"_16893":95695,"_5":16788,"_22829":95670,"_2311":95696},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2783":56771,"_24069":56759,"_16893":95698,"_5":16788,"_22829":95670,"_2311":95699},[],"404 o APS ausente",{"_2783":56772,"_24069":56759,"_16893":95701,"_5":16788,"_22829":95670,"_2311":95702},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2783":56773,"_24069":56759,"_16893":95704,"_5":16788,"_22829":95670,"_2311":95705},[],"400, error de CSR o formato",{"_2783":56774,"_24069":56759,"_16893":95707,"_5":16788,"_22829":95670,"_2311":95708},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2783":56775,"_24069":56759,"_16893":95710,"_5":16788,"_22829":95670,"_2311":95711},[],"Credencial ausente o certificado no válido",{"_2783":56776,"_24069":56759,"_16893":95713,"_5":16788,"_22829":95670,"_2311":95714},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2783":56777,"_24069":56759,"_16893":95716,"_5":16788,"_22829":95670,"_2311":95717},[],"Webhook deniega, expira o responde sin autorización",{"_2783":56778,"_24069":56759,"_16893":95719,"_5":16788,"_22829":95670,"_2311":95720},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2783":56779,"_24069":56759,"_16893":95722,"_5":16788,"_22829":95670,"_2311":42670},[],{"_2783":56780,"_24069":56759,"_16893":95724,"_5":16788,"_22829":95670,"_2311":95725},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2783":56781,"_24069":56759,"_16893":95727,"_5":16788,"_22829":95670,"_2311":42676},[],{"_2783":56782,"_24069":56759,"_16893":95729,"_5":16788,"_22829":95670,"_2311":95730},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2783":56783,"_24069":56759,"_16893":95732,"_5":16788,"_22829":95670,"_2311":95733},[],"DMS propietario distinto",{"_2783":56784,"_24069":56759,"_16893":95735,"_5":16788,"_22829":95670,"_2311":95736},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2783":56785,"_24069":56759,"_16893":95738,"_5":16788,"_22829":95670,"_2311":42688},[],{"_2783":56786,"_24069":56759,"_16893":95740,"_5":16788,"_22829":95670,"_2311":95741},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2783":56787,"_24069":56759,"_16893":95743,"_5":16788,"_22829":95670,"_2311":42694},[],{"_2783":56788,"_24069":56759,"_16893":95745,"_5":16788,"_22829":95670,"_2311":95746},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2783":56789,"_24069":56759,"_16893":95748,"_5":16788,"_22829":95670,"_2311":95749},[],"Certificado actual revocado",{"_2783":56790,"_24069":56759,"_16893":95751,"_5":16788,"_22829":95670,"_2311":95752},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2783":56791,"_24069":56759,"_16893":95754,"_5":16788,"_22829":95670,"_2311":95755},[],"Error de CA, perfil o firma",{"_2783":56792,"_24069":56759,"_16893":95757,"_5":16788,"_22829":95670,"_2311":95758},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2783":56793,"_24069":56759,"_16893":95760,"_5":16788,"_22829":95670,"_2311":95761},[],"HTTP 200 sin conexión del dispositivo",{"_2783":56794,"_24069":56759,"_16893":95763,"_5":16788,"_22829":95670,"_2311":95764},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2783":56795,"_24069":56759,"_16893":95766,"_5":16788,"_22829":95670,"_2311":95767},[],"Timeout o error después de emitir",{"_2783":56796,"_24069":56759,"_16893":95769,"_5":16788,"_22829":95670,"_2311":95770},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2783":56797,"_24069":56759,"_16893":95772,"_5":16788,"_22829":95674,"_2311":95773},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2783":56798,"_24069":56759,"_16893":95775,"_5":16788,"_22829":95674,"_2311":95776},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2783":56799,"_24069":56759,"_16893":95778,"_5":16788,"_22829":95677,"_2311":95779},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2783":56800,"_24069":56759,"_16893":95781,"_5":16788,"_22829":95677,"_2311":95782},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2783":56801,"_24069":56759,"_16893":95784,"_5":16788,"_22829":95677,"_2311":95785},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2783":56802,"_24069":56759,"_16893":95787,"_5":16788,"_22829":95677,"_2311":95788},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2783":56803,"_24069":56759,"_16893":95790,"_5":16788,"_22829":95677,"_2311":95791},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2783":56804,"_24069":56759,"_16893":95793,"_5":16788,"_22829":95677,"_2311":95794},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2783":56805,"_24069":56759,"_16893":95796,"_5":16788,"_22829":95677,"_2311":95797},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2783":56806,"_24069":56806,"_5":11891,"_2311":95799,"_24384":95800,"_16893":95801,"_22829":56806},"Distribución y actualización de confianza",[39305,93739,41524,94612,94787],[],{"_2783":56807,"_24069":56806,"_16893":95803,"_5":16788,"_22829":56806,"_2311":95804},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2783":56808,"_24069":56806,"_5":24381,"_16893":95806,"_22829":95807,"_2311":95808},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2783":56809,"_24069":56806,"_5":24381,"_16893":95810,"_22829":95811,"_2311":95812},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2783":56810,"_24069":56806,"_5":24381,"_16893":95814,"_22829":95815,"_2311":95816},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2783":56811,"_24069":56806,"_5":24381,"_16893":95818,"_22829":95819,"_2311":95820},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2783":56812,"_24069":56806,"_5":24381,"_16893":95822,"_22829":95823,"_2311":95824},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2783":56813,"_24069":56806,"_16893":95826,"_5":16788,"_22829":56806,"_2311":95827},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2783":56814,"_24069":56806,"_16893":95829,"_5":16788,"_22829":95807,"_2311":95830},[],"Relación",{"_2783":56815,"_24069":56806,"_16893":95832,"_5":16788,"_22829":95807,"_2311":95833},[],"Material que prepara el responsable",{"_2783":56816,"_24069":56806,"_16893":95835,"_5":16788,"_22829":95807,"_2311":95836},[],"Dispositivo → servidor EST",{"_2783":56817,"_24069":56806,"_16893":95838,"_5":16788,"_22829":95807,"_2311":95839},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2783":56818,"_24069":56806,"_16893":95841,"_5":16788,"_22829":95807,"_2311":95842},[],"DMS → solicitante",{"_2783":56819,"_24069":56806,"_16893":95844,"_5":16788,"_22829":95807,"_2311":95845},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2783":56820,"_24069":56806,"_16893":95847,"_5":16788,"_22829":95807,"_2311":95848},[],"Consumidor → dispositivo",{"_2783":56821,"_24069":56806,"_16893":95850,"_5":16788,"_22829":95807,"_2311":95851},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2783":56822,"_24069":56806,"_16893":95853,"_5":16788,"_22829":95807,"_2311":95854},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2783":56823,"_24069":56806,"_16893":95856,"_5":16788,"_22829":95811,"_2311":95857},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2783":56824,"_24069":56806,"_16893":95859,"_5":16788,"_22829":95811,"_2311":95860},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2783":56825,"_24069":56806,"_16893":95862,"_5":16788,"_22829":95815,"_2311":95863},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2783":56826,"_24069":56806,"_16893":95865,"_5":16788,"_22829":95815,"_2311":95866},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2783":56827,"_24069":56806,"_16893":95868,"_5":16788,"_22829":95815,"_2311":95869},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2783":56828,"_24069":56806,"_16893":95871,"_5":16788,"_22829":95815,"_2311":95872},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2783":56829,"_24069":56806,"_16893":95874,"_5":16788,"_22829":95815,"_2311":95875},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2783":56830,"_24069":56806,"_16893":95877,"_5":16788,"_22829":95815,"_2311":95878},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2783":56831,"_24069":56806,"_16893":95880,"_5":16788,"_22829":95819,"_2311":95881},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2783":56832,"_24069":56806,"_16893":95883,"_5":16788,"_22829":95819,"_2311":95884},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2783":56833,"_24069":56806,"_16893":95886,"_5":16788,"_22829":95819,"_2311":95887},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2783":56834,"_24069":56806,"_16893":95889,"_5":16788,"_22829":95823,"_2311":95890},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2783":56835,"_24069":56835,"_5":11891,"_2311":42843,"_24384":95892,"_16893":95894,"_22829":56835},[39305,93739,41524,94612,95893],"Integraciones",[],{"_2783":56836,"_24069":56835,"_16893":95896,"_5":16788,"_22829":56835,"_2311":95897},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2783":56837,"_24069":56835,"_5":24381,"_16893":95899,"_22829":95900,"_2311":95901},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2783":56838,"_24069":56835,"_5":24381,"_16893":95903,"_22829":95904,"_2311":95905},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2783":56839,"_24069":56835,"_5":24381,"_16893":95907,"_22829":95908,"_2311":95909},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2783":56840,"_24069":56835,"_5":24381,"_16893":95911,"_22829":95912,"_2311":95913},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2783":56841,"_24069":56835,"_5":24381,"_16893":95915,"_22829":95916,"_2311":95917},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2783":56842,"_24069":56835,"_5":24381,"_16893":95919,"_22829":95920,"_2311":95921},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2783":56843,"_24069":56835,"_5":24381,"_16893":95923,"_22829":95924,"_2311":42877},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2783":56844,"_24069":56835,"_5":24381,"_16893":95926,"_22829":95927,"_2311":42881},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2783":56845,"_24069":56835,"_5":24381,"_16893":95929,"_22829":95930,"_2311":95931},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2783":56846,"_24069":56835,"_5":24381,"_16893":95933,"_22829":95934,"_2311":95935},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2783":56847,"_24069":56835,"_5":24381,"_16893":95937,"_22829":95938,"_2311":95939},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2783":56848,"_24069":56835,"_5":24381,"_16893":95941,"_22829":95942,"_2311":95943},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2783":56849,"_24069":56835,"_5":24381,"_16893":95945,"_22829":95946,"_2311":95947},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2783":56850,"_24069":56835,"_5":24381,"_16893":95949,"_22829":95950,"_2311":95951},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2783":56851,"_24069":56835,"_5":24381,"_16893":95953,"_22829":95954,"_2311":95955},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2783":56852,"_24069":56835,"_5":24381,"_16893":95957,"_22829":95958,"_2311":95959},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2783":56853,"_24069":56835,"_5":24381,"_16893":95961,"_22829":95962,"_2311":95963},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2783":56854,"_24069":56835,"_5":24381,"_16893":95965,"_22829":95966,"_2311":95967},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2783":56855,"_24069":56835,"_5":24381,"_16893":95969,"_22829":95970,"_2311":95971},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2783":56856,"_24069":56835,"_5":24381,"_16893":95973,"_22829":95974,"_2311":95975},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2783":56857,"_24069":56835,"_16893":95977,"_5":16788,"_22829":56835,"_2311":95978},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2783":56858,"_24069":56835,"_16893":95980,"_5":16788,"_22829":56835,"_2311":95981},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2783":56859,"_24069":56835,"_16893":95983,"_5":16788,"_22829":56835,"_2311":95984},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2783":56860,"_24069":56835,"_16893":95986,"_5":16788,"_22829":95900,"_2311":95987},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2783":56861,"_24069":56835,"_16893":95989,"_5":16788,"_22829":95900,"_2311":95990},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2783":56862,"_24069":56835,"_16893":95992,"_5":16788,"_22829":95900,"_2311":95993},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2783":56863,"_24069":56835,"_16893":95995,"_5":16788,"_22829":95900,"_2311":95996},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2783":56864,"_24069":56835,"_16893":95998,"_5":16788,"_22829":95904,"_2311":95999},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2783":56865,"_24069":56835,"_16893":96001,"_5":16788,"_22829":95908,"_2311":96002},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2783":56866,"_24069":56835,"_16893":96004,"_5":16788,"_22829":95908,"_2311":96005},[],"Acción IAM",{"_2783":56867,"_24069":56835,"_16893":96007,"_5":16788,"_22829":95908,"_2311":92803},[],{"_2783":56868,"_24069":56835,"_16893":96009,"_5":16788,"_22829":95908,"_2311":42964},[],{"_2783":56869,"_24069":56835,"_16893":96011,"_5":16788,"_22829":95908,"_2311":96012},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2783":56870,"_24069":56835,"_16893":96014,"_5":16788,"_22829":95908,"_2311":42970},[],{"_2783":56871,"_24069":56835,"_16893":96016,"_5":16788,"_22829":95908,"_2311":96017},[],"Registrar la CA en AWS IoT",{"_2783":56872,"_24069":56835,"_16893":96019,"_5":16788,"_22829":95908,"_2311":42976},[],{"_2783":56873,"_24069":56835,"_16893":96021,"_5":16788,"_22829":95908,"_2311":96022},[],"Consultar el estado del registro de la CA",{"_2783":56874,"_24069":56835,"_16893":96024,"_5":16788,"_22829":95908,"_2311":42982},[],{"_2783":56875,"_24069":56835,"_16893":96026,"_5":16788,"_22829":95908,"_2311":96027},[],"Crear o actualizar Things en IoT Core",{"_2783":56876,"_24069":56835,"_16893":96029,"_5":16788,"_22829":95908,"_2311":42988},[],{"_2783":56877,"_24069":56835,"_16893":96031,"_5":16788,"_22829":95908,"_2311":96032},[],"Aprovisionar Things mediante plantilla",{"_2783":56878,"_24069":56835,"_16893":96034,"_5":16788,"_22829":95908,"_2311":42994},[],{"_2783":56879,"_24069":56835,"_16893":96036,"_5":16788,"_22829":95908,"_2311":96037},[],"Registrar certificados de dispositivo",{"_2783":56880,"_24069":56835,"_16893":96039,"_5":16788,"_22829":95908,"_2311":43000},[],{"_2783":56881,"_24069":56835,"_16893":96041,"_5":16788,"_22829":95908,"_2311":96042},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2783":56882,"_24069":56835,"_16893":96044,"_5":16788,"_22829":95908,"_2311":43006},[],{"_2783":56883,"_24069":56835,"_16893":96046,"_5":16788,"_22829":95908,"_2311":96047},[],"Crear y adjuntar políticas IoT",{"_2783":56884,"_24069":56835,"_16893":96049,"_5":16788,"_22829":95908,"_2311":43012},[],{"_2783":56885,"_24069":56835,"_16893":96051,"_5":16788,"_22829":95908,"_2311":96052},[],"Gestionar grupos de Things",{"_2783":56886,"_24069":56835,"_16893":96054,"_5":16788,"_22829":95908,"_2311":43018},[],{"_2783":56887,"_24069":56835,"_16893":96056,"_5":16788,"_22829":95908,"_2311":96057},[],"Crear plantillas JITP",{"_2783":56888,"_24069":56835,"_16893":96059,"_5":16788,"_22829":95908,"_2311":43024},[],{"_2783":56889,"_24069":56835,"_16893":96061,"_5":16788,"_22829":95908,"_2311":96062},[],"Leer y escribir el Device Shadow",{"_2783":56890,"_24069":56835,"_16893":96064,"_5":16788,"_22829":95908,"_2311":96065},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2783":56891,"_24069":56835,"_16893":96067,"_5":16788,"_22829":95912,"_2311":96068},[],"Parámetro",{"_2783":56892,"_24069":56835,"_16893":96070,"_5":16788,"_22829":95912,"_2311":96071},[],"Tipo",{"_2783":56893,"_24069":56835,"_16893":96073,"_5":16788,"_22829":95912,"_2311":96074},[],"Requerido",{"_2783":56894,"_24069":56835,"_16893":96076,"_5":16788,"_22829":95912,"_2311":96077},[],"Descripción",{"_2783":56895,"_24069":56835,"_16893":96079,"_5":16788,"_22829":95912,"_2311":43045},[],{"_2783":56896,"_24069":56835,"_16893":96081,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56897,"_24069":56835,"_16893":96083,"_5":16788,"_22829":95912,"_2311":96084},[],"Sí",{"_2783":56898,"_24069":56835,"_16893":96086,"_5":16788,"_22829":95912,"_2311":96087},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2783":56899,"_24069":56835,"_16893":96089,"_5":16788,"_22829":95912,"_2311":43056},[],{"_2783":56900,"_24069":56835,"_16893":96091,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56901,"_24069":56835,"_16893":96093,"_5":16788,"_22829":95912,"_2311":96084},[],{"_2783":56902,"_24069":56835,"_16893":96095,"_5":16788,"_22829":95912,"_2311":96096},[],"Región AWS donde opera el conector.",{"_2783":56903,"_24069":56835,"_16893":96098,"_5":16788,"_22829":95912,"_2311":43066},[],{"_2783":56904,"_24069":56835,"_16893":96100,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56905,"_24069":56835,"_16893":96102,"_5":16788,"_22829":95912,"_2311":96084},[],{"_2783":56906,"_24069":56835,"_16893":96104,"_5":16788,"_22829":95912,"_2311":96105},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2783":56907,"_24069":56835,"_16893":96107,"_5":16788,"_22829":95912,"_2311":43076},[],{"_2783":56908,"_24069":56835,"_16893":96109,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56909,"_24069":56835,"_16893":96111,"_5":16788,"_22829":95912,"_2311":96112},[],"Solo con `auth_method=static`",{"_2783":56910,"_24069":56835,"_16893":96114,"_5":16788,"_22829":95912,"_2311":96115},[],"Clave de acceso AWS.",{"_2783":56911,"_24069":56835,"_16893":96117,"_5":16788,"_22829":95912,"_2311":43087},[],{"_2783":56912,"_24069":56835,"_16893":96119,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56913,"_24069":56835,"_16893":96121,"_5":16788,"_22829":95912,"_2311":96112},[],{"_2783":56914,"_24069":56835,"_16893":96123,"_5":16788,"_22829":95912,"_2311":96124},[],"Clave secreta AWS.",{"_2783":56915,"_24069":56835,"_16893":96126,"_5":16788,"_22829":95912,"_2311":43097},[],{"_2783":56916,"_24069":56835,"_16893":96128,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56917,"_24069":56835,"_16893":96130,"_5":16788,"_22829":95912,"_2311":43102},[],{"_2783":56918,"_24069":56835,"_16893":96132,"_5":16788,"_22829":95912,"_2311":96133},[],"Token de sesión (con `auth_method=static`).",{"_2783":56919,"_24069":56835,"_16893":96135,"_5":16788,"_22829":95912,"_2311":43108},[],{"_2783":56920,"_24069":56835,"_16893":96137,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56921,"_24069":56835,"_16893":96139,"_5":16788,"_22829":95912,"_2311":96140},[],"Solo con `auth_method=role`",{"_2783":56922,"_24069":56835,"_16893":96142,"_5":16788,"_22829":95912,"_2311":96143},[],"ARN del rol a asumir.",{"_2783":56923,"_24069":56835,"_16893":96145,"_5":16788,"_22829":95912,"_2311":43119},[],{"_2783":56924,"_24069":56835,"_16893":96147,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56925,"_24069":56835,"_16893":96149,"_5":16788,"_22829":95912,"_2311":43102},[],{"_2783":56926,"_24069":56835,"_16893":96151,"_5":16788,"_22829":95912,"_2311":96152},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2783":56927,"_24069":56835,"_16893":96154,"_5":16788,"_22829":95912,"_2311":43129},[],{"_2783":56928,"_24069":56835,"_16893":96156,"_5":16788,"_22829":95912,"_2311":14212},[],{"_2783":56929,"_24069":56835,"_16893":96158,"_5":16788,"_22829":95912,"_2311":96084},[],{"_2783":56930,"_24069":56835,"_16893":96160,"_5":16788,"_22829":95912,"_2311":96161},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2783":56931,"_24069":56835,"_16893":96163,"_5":16788,"_22829":95912,"_2311":43139},[],{"_2783":56932,"_24069":56835,"_16893":96165,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56933,"_24069":56835,"_16893":96167,"_5":16788,"_22829":95912,"_2311":96084},[],{"_2783":56934,"_24069":56835,"_16893":96169,"_5":16788,"_22829":95912,"_2311":96170},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2783":56935,"_24069":56835,"_16893":96172,"_5":16788,"_22829":95912,"_2311":43149},[],{"_2783":56936,"_24069":56835,"_16893":96174,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56937,"_24069":56835,"_16893":96176,"_5":16788,"_22829":95912,"_2311":96084},[],{"_2783":56938,"_24069":56835,"_16893":96178,"_5":16788,"_22829":95912,"_2311":96179},[],"URL HTTP del Device Manager de Lamassu.",{"_2783":56939,"_24069":56835,"_16893":96181,"_5":16788,"_22829":95912,"_2311":43159},[],{"_2783":56940,"_24069":56835,"_16893":96183,"_5":16788,"_22829":95912,"_2311":20125},[],{"_2783":56941,"_24069":56835,"_16893":96185,"_5":16788,"_22829":95912,"_2311":96084},[],{"_2783":56942,"_24069":56835,"_16893":96187,"_5":16788,"_22829":95912,"_2311":96188},[],"URL HTTP del servicio de CA de Lamassu.",{"_2783":56943,"_24069":56835,"_16893":96190,"_5":16788,"_22829":95916,"_2311":96191},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2783":56944,"_24069":56835,"_16893":96193,"_5":16788,"_22829":95920,"_2311":96194},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2783":56945,"_24069":56835,"_16893":96196,"_5":16788,"_22829":95920,"_2311":96197},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2783":56946,"_24069":56835,"_16893":96199,"_5":16788,"_22829":95924,"_2311":96200},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2783":56947,"_24069":56835,"_16893":96202,"_5":16788,"_22829":95924,"_2311":96203},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2783":56948,"_24069":56835,"_16893":96205,"_5":16788,"_22829":95924,"_2311":96206},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2783":56949,"_24069":56835,"_16893":96208,"_5":16788,"_22829":95924,"_2311":96209},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2783":56950,"_24069":56835,"_16893":96211,"_5":16788,"_22829":95924,"_2311":96212},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2783":56951,"_24069":56835,"_16893":96214,"_5":16788,"_22829":95924,"_2311":96215},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2783":56952,"_24069":56835,"_16893":96217,"_5":16788,"_22829":95927,"_2311":96218},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2783":56953,"_24069":56835,"_16893":96220,"_5":16788,"_22829":95930,"_2311":96221},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2783":56954,"_24069":56835,"_16893":96223,"_5":16788,"_22829":95930,"_2311":96224},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2783":56955,"_24069":56835,"_16893":96226,"_5":16788,"_22829":95934,"_2311":96227},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2783":56956,"_24069":56835,"_16893":96229,"_5":16788,"_22829":95938,"_2311":96230},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2783":56957,"_24069":56835,"_16893":96232,"_5":16788,"_22829":95938,"_2311":96233},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2783":56958,"_24069":56835,"_16893":96235,"_5":16788,"_22829":95938,"_2311":96236},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2783":56959,"_24069":56835,"_16893":96238,"_5":16788,"_22829":95938,"_2311":96239},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2783":56960,"_24069":56835,"_16893":96241,"_5":16788,"_22829":95938,"_2311":96242},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2783":56961,"_24069":56835,"_16893":96244,"_5":16788,"_22829":95938,"_2311":96245},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2783":56962,"_24069":56835,"_16893":96247,"_5":16788,"_22829":95942,"_2311":96248},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2783":56963,"_24069":56835,"_16893":96250,"_5":16788,"_22829":95942,"_2311":96251},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2783":56964,"_24069":56835,"_16893":96253,"_5":16788,"_22829":95942,"_2311":96254},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2783":56965,"_24069":56835,"_16893":96256,"_5":16788,"_22829":95946,"_2311":96257},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2783":56966,"_24069":56835,"_16893":96259,"_5":16788,"_22829":95946,"_2311":96260},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2783":56967,"_24069":56835,"_16893":96262,"_5":16788,"_22829":95946,"_2311":96263},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2783":56968,"_24069":56835,"_16893":96265,"_5":16788,"_22829":95950,"_2311":96266},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2783":56969,"_24069":56835,"_16893":96268,"_5":16788,"_22829":95950,"_2311":96269},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2783":56970,"_24069":56835,"_16893":96271,"_5":16788,"_22829":95950,"_2311":96272},[],"Para que el flujo JITP funcione correctamente:",{"_2783":56971,"_24069":56835,"_16893":96274,"_5":16788,"_22829":95950,"_2311":96275},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2783":56972,"_24069":56835,"_16893":96277,"_5":16788,"_22829":95950,"_2311":96278},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2783":56973,"_24069":56835,"_16893":96280,"_5":16788,"_22829":95950,"_2311":96281},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2783":56974,"_24069":56835,"_16893":96283,"_5":16788,"_22829":95950,"_2311":96284},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2783":56975,"_24069":56835,"_16893":96286,"_5":16788,"_22829":95954,"_2311":96287},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2783":56976,"_24069":56835,"_16893":96289,"_5":16788,"_22829":95954,"_2311":96290},[],"Estado en Lamassu",{"_2783":56977,"_24069":56835,"_16893":96292,"_5":16788,"_22829":95954,"_2311":96293},[],"Razón de revocación",{"_2783":56978,"_24069":56835,"_16893":96295,"_5":16788,"_22829":95954,"_2311":96296},[],"Estado en AWS IoT Core",{"_2783":56979,"_24069":56835,"_16893":96298,"_5":16788,"_22829":95954,"_2311":43280},[],{"_2783":56980,"_24069":56835,"_16893":96300,"_5":16788,"_22829":95954,"_2311":96301},[],"Ninguna",{"_2783":56981,"_24069":56835,"_16893":96303,"_5":16788,"_22829":95954,"_2311":43286},[],{"_2783":56982,"_24069":56835,"_16893":96305,"_5":16788,"_22829":95954,"_2311":43289},[],{"_2783":56983,"_24069":56835,"_16893":96307,"_5":16788,"_22829":95954,"_2311":43292},[],{"_2783":56984,"_24069":56835,"_16893":96309,"_5":16788,"_22829":95954,"_2311":43295},[],{"_2783":56985,"_24069":56835,"_16893":96311,"_5":16788,"_22829":95954,"_2311":43289},[],{"_2783":56986,"_24069":56835,"_16893":96313,"_5":16788,"_22829":95954,"_2311":96314},[],"Cualquier otra razón",{"_2783":56987,"_24069":56835,"_16893":96316,"_5":16788,"_22829":95954,"_2311":43303},[],{"_2783":56988,"_24069":56835,"_16893":96318,"_5":16788,"_22829":95954,"_2311":96319},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2783":56989,"_24069":56835,"_16893":96321,"_5":16788,"_22829":95958,"_2311":96322},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2783":56990,"_24069":56835,"_16893":96324,"_5":16788,"_22829":95958,"_2311":96325},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2783":56991,"_24069":56835,"_16893":96327,"_5":16788,"_22829":95958,"_2311":96328},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2783":56992,"_24069":56835,"_16893":96330,"_5":16788,"_22829":95962,"_2311":96331},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2783":56993,"_24069":56835,"_16893":96333,"_5":16788,"_22829":95962,"_2311":96334},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2783":56994,"_24069":56835,"_16893":96336,"_5":16788,"_22829":95966,"_2311":96337},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2783":56995,"_24069":56835,"_16893":96339,"_5":16788,"_22829":95966,"_2311":96340},[],"Existen dos tipos de acciones:",{"_2783":56996,"_24069":56835,"_16893":96342,"_5":16788,"_22829":95966,"_2311":96343},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2783":56997,"_24069":56835,"_16893":96345,"_5":16788,"_22829":95966,"_2311":96346},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2783":56998,"_24069":56835,"_16893":96348,"_5":16788,"_22829":95966,"_2311":96349},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2783":56999,"_24069":56835,"_16893":96351,"_5":16788,"_22829":95970,"_2311":96352},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2783":57000,"_24069":56835,"_16893":96354,"_5":16788,"_22829":95970,"_2311":96355},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2783":57001,"_24069":56835,"_16893":96357,"_5":16788,"_22829":95970,"_2311":96358},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2783":57002,"_24069":56835,"_16893":96360,"_5":16788,"_22829":95974,"_2311":96361},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2783":57003,"_24069":56835,"_16893":96363,"_5":16788,"_22829":95974,"_2311":96364},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2783":57004,"_24069":56835,"_16893":96366,"_5":16788,"_22829":95974,"_2311":96367},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2783":57005,"_24069":56835,"_16893":96369,"_5":16788,"_22829":95974,"_2311":96370},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2783":57006,"_24069":56835,"_16893":96372,"_5":16788,"_22829":95974,"_2311":96373},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2783":57007,"_24069":56835,"_16893":96375,"_5":16788,"_22829":95974,"_2311":96376},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2783":57008,"_24069":56835,"_16893":96378,"_5":16788,"_22829":95974,"_2311":96379},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2783":57009,"_24069":56835,"_16893":96381,"_5":16788,"_22829":95974,"_2311":96382},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2783":57010,"_24069":56835,"_16893":96384,"_5":16788,"_22829":95974,"_2311":96385},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2783":57011,"_24069":56835,"_16893":96387,"_5":16788,"_22829":95974,"_2311":96388},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2783":57012,"_24069":56835,"_16893":96390,"_5":16788,"_22829":95974,"_2311":96391},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2783":57013,"_24069":56835,"_16893":96393,"_5":16788,"_22829":95974,"_2311":96394},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2783":57014,"_24069":56835,"_16893":96396,"_5":16788,"_22829":95974,"_2311":96397},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2783":57015,"_24069":56835,"_16893":96399,"_5":16788,"_22829":95974,"_2311":96400},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2783":57016,"_24069":56835,"_16893":96402,"_5":16788,"_22829":95974,"_2311":96403},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2783":57017,"_24069":56835,"_16893":96405,"_5":16788,"_22829":95974,"_2311":96406},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2783":57018,"_24069":56835,"_16893":96408,"_5":16788,"_22829":95974,"_2311":96409},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2783":57019,"_24069":56835,"_16893":96411,"_5":16788,"_22829":95974,"_2311":96412},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2783":57020,"_24069":56835,"_16893":96414,"_5":16788,"_22829":95974,"_2311":96415},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":57021,"_24069":56835,"_16893":96417,"_5":16788,"_22829":95974,"_2311":96418},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2783":57022,"_24069":56835,"_16893":96420,"_5":16788,"_22829":95974,"_2311":96421},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2783":57023,"_24069":57023,"_5":11891,"_2311":41524,"_24384":96423,"_16893":96424,"_22829":57023},[39305,93739,41524],[],{"_2783":57024,"_24069":57023,"_16893":96426,"_5":16788,"_22829":57023,"_2311":96427},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2783":57025,"_24069":57023,"_5":24381,"_16893":96429,"_22829":96430,"_2311":96431},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2783":57026,"_24069":57023,"_5":24381,"_16893":96433,"_22829":96434,"_2311":94612},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2783":57027,"_24069":57023,"_5":24381,"_16893":96436,"_22829":96437,"_2311":94787},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2783":57028,"_24069":57023,"_5":24381,"_16893":96439,"_22829":96440,"_2311":95893},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_2783":57029,"_24069":57023,"_5":24381,"_16893":96442,"_22829":96443,"_2311":96444},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2783":57030,"_24069":57023,"_16893":96446,"_5":16788,"_22829":57023,"_2311":96447},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2783":57031,"_24069":57023,"_16893":96449,"_5":16788,"_22829":96430,"_2311":96450},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2783":57032,"_24069":57023,"_16893":96452,"_5":16788,"_22829":96430,"_2311":96453},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2783":57033,"_24069":57023,"_16893":96455,"_5":16788,"_22829":96434,"_2311":96456},[],"Recurso",{"_2783":57034,"_24069":57023,"_16893":96458,"_5":16788,"_22829":96434,"_2311":96459},[],"Qué representa",{"_2783":57035,"_24069":57023,"_16893":96461,"_5":16788,"_22829":96434,"_2311":96462},[],"**Dispositivo**",{"_2783":57036,"_24069":57023,"_16893":96464,"_5":16788,"_22829":96434,"_2311":96465},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2783":57037,"_24069":57023,"_16893":96467,"_5":16788,"_22829":96434,"_2311":96468},[],"**Identidad**",{"_2783":57038,"_24069":57023,"_16893":96470,"_5":16788,"_22829":96434,"_2311":96471},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2783":57039,"_24069":57023,"_16893":96473,"_5":16788,"_22829":96434,"_2311":43461},[],{"_2783":57040,"_24069":57023,"_16893":96475,"_5":16788,"_22829":96434,"_2311":96476},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2783":57041,"_24069":57023,"_16893":96478,"_5":16788,"_22829":96434,"_2311":96479},[],"**Flota**",{"_2783":57042,"_24069":57023,"_16893":96481,"_5":16788,"_22829":96434,"_2311":96482},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2783":57043,"_24069":57023,"_16893":96484,"_5":16788,"_22829":96434,"_2311":96485},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2783":57044,"_24069":57023,"_16893":96487,"_5":16788,"_22829":96434,"_2311":96488},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2783":57045,"_24069":57023,"_16893":96490,"_5":16788,"_22829":96437,"_2311":96491},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2783":57046,"_24069":57023,"_16893":96493,"_5":16788,"_22829":96437,"_2311":96494},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2783":57047,"_24069":57023,"_16893":96496,"_5":16788,"_22829":96437,"_2311":96497},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2783":57048,"_24069":57023,"_16893":96499,"_5":16788,"_22829":96437,"_2311":96500},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2783":57049,"_24069":57023,"_16893":96502,"_5":16788,"_22829":96437,"_2311":96503},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2783":57050,"_24069":57023,"_16893":96505,"_5":16788,"_22829":96437,"_2311":96506},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2783":57051,"_24069":57023,"_16893":96508,"_5":16788,"_22829":96437,"_2311":96509},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":57052,"_24069":57023,"_16893":96511,"_5":16788,"_22829":96437,"_2311":96512},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":57053,"_24069":57023,"_16893":96514,"_5":16788,"_22829":96440,"_2311":96515},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2783":57054,"_24069":57023,"_16893":96517,"_5":16788,"_22829":96440,"_2311":96518},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2783":57055,"_24069":57023,"_16893":96520,"_5":16788,"_22829":96443,"_2311":96521},[],"Participante",{"_2783":57056,"_24069":57023,"_16893":96523,"_5":16788,"_22829":96443,"_2311":96524},[],"Responsabilidad",{"_2783":57057,"_24069":57023,"_16893":96526,"_5":16788,"_22829":96443,"_2311":96527},[],"Administrador PKI",{"_2783":57058,"_24069":57023,"_16893":96529,"_5":16788,"_22829":96443,"_2311":96530},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2783":57059,"_24069":57023,"_16893":96532,"_5":16788,"_22829":96443,"_2311":96533},[],"Administrador del aprovisionamiento",{"_2783":57060,"_24069":57023,"_16893":96535,"_5":16788,"_22829":96443,"_2311":96536},[],"DMS, admisión, autenticación por operación e inventario.",{"_2783":57061,"_24069":57023,"_16893":96538,"_5":16788,"_22829":96443,"_2311":96539},[],"Integrador del dispositivo",{"_2783":57062,"_24069":57023,"_16893":96541,"_5":16788,"_22829":96443,"_2311":96542},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2783":57063,"_24069":57023,"_16893":96544,"_5":16788,"_22829":96443,"_2311":96545},[],"Integrador del consumidor",{"_2783":57064,"_24069":57023,"_16893":96547,"_5":16788,"_22829":96443,"_2311":96548},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2783":57065,"_24069":57023,"_16893":96550,"_5":16788,"_22829":96443,"_2311":96551},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2783":57066,"_24069":57066,"_5":11891,"_2311":96553,"_24384":96554,"_16893":96556,"_22829":57066},"Enrola y conecta tu primer dispositivo",[39305,93739,41524,96555],"Primeros pasos",[],{"_2783":57067,"_24069":57066,"_16893":96558,"_5":16788,"_22829":57066,"_2311":96559},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2783":57068,"_24069":57066,"_5":24381,"_16893":96561,"_22829":96562,"_2311":92440},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2783":57069,"_24069":57066,"_5":24381,"_16893":96564,"_22829":96565,"_2311":96566},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2783":57070,"_24069":57066,"_5":24381,"_16893":96568,"_22829":96569,"_2311":96570},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2783":57071,"_24069":57066,"_5":24381,"_16893":96572,"_22829":96573,"_2311":96574},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2783":57072,"_24069":57066,"_5":24381,"_16893":96576,"_22829":96577,"_2311":96578},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2783":57073,"_24069":57066,"_5":24381,"_16893":96580,"_22829":96581,"_2311":96582},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2783":57074,"_24069":57066,"_5":24381,"_16893":96584,"_22829":96585,"_2311":96586},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2783":57075,"_24069":57066,"_5":24381,"_16893":96588,"_22829":96589,"_2311":96590},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2783":57076,"_24069":57066,"_16893":96592,"_5":16788,"_22829":57066,"_2311":96593},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2783":57077,"_24069":57066,"_16893":96595,"_5":16788,"_22829":96562,"_2311":96596},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2783":57078,"_24069":57066,"_16893":96598,"_5":16788,"_22829":96562,"_2311":96599},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2783":57079,"_24069":57066,"_16893":96601,"_5":16788,"_22829":96562,"_2311":96602},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2783":57080,"_24069":57066,"_16893":96604,"_5":16788,"_22829":96562,"_2311":96605},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2783":57081,"_24069":57066,"_16893":96607,"_5":16788,"_22829":96562,"_2311":96608},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2783":57082,"_24069":57066,"_16893":96610,"_5":16788,"_22829":96565,"_2311":96611},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2783":57083,"_24069":57066,"_16893":96613,"_5":16788,"_22829":96565,"_2311":96614},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2783":57084,"_24069":57066,"_16893":96616,"_5":16788,"_22829":96569,"_2311":96617},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2783":57085,"_24069":57066,"_16893":96619,"_5":16788,"_22829":96569,"_2311":96620},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2783":57086,"_24069":57066,"_16893":96622,"_5":16788,"_22829":96569,"_2311":96623},[],"Ajuste",{"_2783":57087,"_24069":57066,"_16893":96625,"_5":16788,"_22829":96569,"_2311":96626},[],"Valor de evaluación",{"_2783":57088,"_24069":57066,"_16893":96628,"_5":16788,"_22829":96569,"_2311":43617},[],{"_2783":57089,"_24069":57066,"_16893":96630,"_5":16788,"_22829":96569,"_2311":96631},[],"Raíz emisora de `device-root.pem`.",{"_2783":57090,"_24069":57066,"_16893":96633,"_5":16788,"_22829":96569,"_2311":94911},[],{"_2783":57091,"_24069":57066,"_16893":96635,"_5":16788,"_22829":96569,"_2311":96636},[],"Perfil final de 1 hora que acabas de preparar.",{"_2783":57092,"_24069":57066,"_16893":96638,"_5":16788,"_22829":96569,"_2311":43628},[],{"_2783":57093,"_24069":57066,"_16893":96640,"_5":16788,"_22829":96569,"_2311":43631},[],{"_2783":57094,"_24069":57066,"_16893":96642,"_5":16788,"_22829":96569,"_2311":43634},[],{"_2783":57095,"_24069":57066,"_16893":96644,"_5":16788,"_22829":96569,"_2311":96645},[],"Habilitado.",{"_2783":57096,"_24069":57066,"_16893":96647,"_5":16788,"_22829":96569,"_2311":43640},[],{"_2783":57097,"_24069":57066,"_16893":96649,"_5":16788,"_22829":96569,"_2311":96650},[],"Deshabilitado; el ID debe ser nuevo.",{"_2783":57098,"_24069":57066,"_16893":96652,"_5":16788,"_22829":96569,"_2311":96653},[],"Autenticación inicial",{"_2783":57099,"_24069":57066,"_16893":96655,"_5":16788,"_22829":96569,"_2311":96656},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2783":57100,"_24069":57066,"_16893":96658,"_5":16788,"_22829":96569,"_2311":96659},[],"Autenticación de renovación",{"_2783":57101,"_24069":57066,"_16893":96661,"_5":16788,"_22829":96569,"_2311":96662},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2783":57102,"_24069":57066,"_16893":96664,"_5":16788,"_22829":96569,"_2311":43658},[],{"_2783":57103,"_24069":57066,"_16893":96666,"_5":16788,"_22829":96569,"_2311":96667},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2783":57104,"_24069":57066,"_16893":96669,"_5":16788,"_22829":96569,"_2311":43664},[],{"_2783":57105,"_24069":57066,"_16893":96671,"_5":16788,"_22829":96569,"_2311":96672},[],"1 hora.",{"_2783":57106,"_24069":57066,"_16893":96674,"_5":16788,"_22829":96569,"_2311":43670},[],{"_2783":57107,"_24069":57066,"_16893":96676,"_5":16788,"_22829":96569,"_2311":96677},[],"30 minutos / 10 minutos.",{"_2783":57108,"_24069":57066,"_16893":96679,"_5":16788,"_22829":96569,"_2311":43676},[],{"_2783":57109,"_24069":57066,"_16893":96681,"_5":16788,"_22829":96569,"_2311":96682},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2783":57110,"_24069":57066,"_16893":96684,"_5":16788,"_22829":96569,"_2311":41839},[],{"_2783":57111,"_24069":57066,"_16893":96686,"_5":16788,"_22829":96569,"_2311":96687},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2783":57112,"_24069":57066,"_16893":96689,"_5":16788,"_22829":96569,"_2311":43687},[],{"_2783":57113,"_24069":57066,"_16893":96691,"_5":16788,"_22829":96569,"_2311":96692},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2783":57114,"_24069":57066,"_16893":96694,"_5":16788,"_22829":96569,"_2311":96695},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2783":57115,"_24069":57066,"_16893":96697,"_5":16788,"_22829":96573,"_2311":96698},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2783":57116,"_24069":57066,"_16893":96700,"_5":16788,"_22829":96573,"_2311":96701},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2783":57117,"_24069":57066,"_16893":96703,"_5":16788,"_22829":96577,"_2311":96704},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2783":57118,"_24069":57066,"_16893":96706,"_5":16788,"_22829":96577,"_2311":96707},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2783":57119,"_24069":57066,"_16893":96709,"_5":16788,"_22829":96577,"_2311":96710},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2783":57120,"_24069":57066,"_16893":96712,"_5":16788,"_22829":96581,"_2311":96713},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2783":57121,"_24069":57066,"_16893":96715,"_5":16788,"_22829":96581,"_2311":96716},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2783":57122,"_24069":57066,"_16893":96718,"_5":16788,"_22829":96585,"_2311":96719},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2783":57123,"_24069":57066,"_16893":96721,"_5":16788,"_22829":96585,"_2311":96722},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2783":57124,"_24069":57066,"_16893":96724,"_5":16788,"_22829":96585,"_2311":96725},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2783":57125,"_24069":57066,"_16893":96727,"_5":16788,"_22829":96585,"_2311":96728},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2783":57126,"_24069":57066,"_16893":96730,"_5":16788,"_22829":96585,"_2311":96731},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2783":57127,"_24069":57066,"_16893":96733,"_5":16788,"_22829":96589,"_2311":96734},[],"Comprobación",{"_2783":57128,"_24069":57066,"_16893":96736,"_5":16788,"_22829":96589,"_2311":96737},[],"Resultado esperado",{"_2783":57129,"_24069":57066,"_16893":96739,"_5":16788,"_22829":96589,"_2311":96740},[],"Registro",{"_2783":57130,"_24069":57066,"_16893":96742,"_5":16788,"_22829":96589,"_2311":96743},[],"ID creado automáticamente y DMS correcto.",{"_2783":57131,"_24069":57066,"_16893":96745,"_5":16788,"_22829":96589,"_2311":96746},[],"Certificado",{"_2783":57132,"_24069":57066,"_16893":96748,"_5":16788,"_22829":96589,"_2311":96749},[],"CN, perfil, serie y clave verificados.",{"_2783":57133,"_24069":57066,"_16893":96751,"_5":16788,"_22829":96589,"_2311":96752},[],"Inventario",{"_2783":57134,"_24069":57066,"_16893":96754,"_5":16788,"_22829":96589,"_2311":96755},[],"Serie recibida visible como identidad actual y en el historial.",{"_2783":57135,"_24069":57066,"_16893":96757,"_5":16788,"_22829":96589,"_2311":96758},[],"Consumidor",{"_2783":57136,"_24069":57066,"_16893":96760,"_5":16788,"_22829":96589,"_2311":96761},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2783":57137,"_24069":57066,"_16893":96763,"_5":16788,"_22829":96589,"_2311":96764},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2783":57138,"_24069":57066,"_16893":96766,"_5":16788,"_22829":96589,"_2311":96767},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2783":57139,"_24069":57139,"_5":11891,"_2311":94629,"_24384":96769,"_16893":96770,"_22829":57139},[39305,93739,41524,96555],[],{"_2783":57140,"_24069":57139,"_16893":96772,"_5":16788,"_22829":57139,"_2311":96773},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2783":57141,"_24069":57139,"_5":24381,"_16893":96775,"_22829":96776,"_2311":92440},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2783":57142,"_24069":57139,"_5":24381,"_16893":96778,"_22829":96779,"_2311":96780},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2783":57143,"_24069":57139,"_5":24381,"_16893":96782,"_22829":96783,"_2311":96784},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2783":57144,"_24069":57139,"_5":24381,"_16893":96786,"_22829":96787,"_2311":96788},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2783":57145,"_24069":57139,"_5":24381,"_16893":96790,"_22829":96791,"_2311":96792},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2783":57146,"_24069":57139,"_5":24381,"_16893":96794,"_22829":96795,"_2311":96796},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2783":57147,"_24069":57139,"_5":24381,"_16893":96798,"_22829":96799,"_2311":96737},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2783":57148,"_24069":57139,"_5":24381,"_16893":96801,"_22829":96802,"_2311":96803},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2783":57149,"_24069":57139,"_5":24381,"_16893":96805,"_22829":96806,"_2311":96807},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2783":57150,"_24069":57139,"_16893":96809,"_5":16788,"_22829":57139,"_2311":96810},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2783":57151,"_24069":57139,"_16893":96812,"_5":16788,"_22829":57139,"_2311":96813},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2783":57152,"_24069":57139,"_16893":96815,"_5":16788,"_22829":96776,"_2311":96816},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2783":57153,"_24069":57139,"_16893":96818,"_5":16788,"_22829":96776,"_2311":96819},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2783":57154,"_24069":57139,"_16893":96821,"_5":16788,"_22829":96776,"_2311":96822},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2783":57155,"_24069":57139,"_16893":96824,"_5":16788,"_22829":96776,"_2311":96825},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2783":57156,"_24069":57139,"_16893":96827,"_5":16788,"_22829":96779,"_2311":96828},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2783":57157,"_24069":57139,"_16893":96830,"_5":16788,"_22829":96779,"_2311":96831},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2783":57158,"_24069":57139,"_16893":96833,"_5":16788,"_22829":96779,"_2311":96834},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2783":57159,"_24069":57139,"_16893":96836,"_5":16788,"_22829":96779,"_2311":96837},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2783":57160,"_24069":57139,"_16893":96839,"_5":16788,"_22829":96779,"_2311":96840},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2783":57161,"_24069":57139,"_16893":96842,"_5":16788,"_22829":96779,"_2311":96843},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2783":57162,"_24069":57139,"_16893":96845,"_5":16788,"_22829":96779,"_2311":96846},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2783":57163,"_24069":57139,"_16893":96848,"_5":16788,"_22829":96779,"_2311":96849},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2783":57164,"_24069":57139,"_16893":96851,"_5":16788,"_22829":96783,"_2311":96852},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2783":57165,"_24069":57139,"_16893":96854,"_5":16788,"_22829":96783,"_2311":43853},[],{"_2783":57166,"_24069":57139,"_16893":96856,"_5":16788,"_22829":96783,"_2311":96857},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2783":57167,"_24069":57139,"_16893":96859,"_5":16788,"_22829":96783,"_2311":96860},[],"**Icon** y **Tags**: clasificación opcional.",{"_2783":57168,"_24069":57139,"_16893":96862,"_5":16788,"_22829":96783,"_2311":96863},[],"Confirma el registro.",{"_2783":57169,"_24069":57139,"_16893":96865,"_5":16788,"_22829":96787,"_2311":96866},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2783":57170,"_24069":57139,"_16893":96868,"_5":16788,"_22829":96787,"_2311":96869},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2783":57171,"_24069":57139,"_16893":96871,"_5":16788,"_22829":96791,"_2311":96872},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2783":57172,"_24069":57139,"_16893":96874,"_5":16788,"_22829":96791,"_2311":96875},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2783":57173,"_24069":57139,"_16893":96877,"_5":16788,"_22829":96795,"_2311":96878},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2783":57174,"_24069":57139,"_16893":96880,"_5":16788,"_22829":96795,"_2311":96881},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2783":57175,"_24069":57139,"_16893":96883,"_5":16788,"_22829":96799,"_2311":96734},[],{"_2783":57176,"_24069":57139,"_16893":96885,"_5":16788,"_22829":96799,"_2311":96886},[],"Resultado",{"_2783":57177,"_24069":57139,"_16893":96888,"_5":16788,"_22829":96799,"_2311":96889},[],"Dispositivo",{"_2783":57178,"_24069":57139,"_16893":96891,"_5":16788,"_22829":96799,"_2311":96892},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2783":57179,"_24069":57139,"_16893":96894,"_5":16788,"_22829":96799,"_2311":96895},[],"Identidad actual",{"_2783":57180,"_24069":57139,"_16893":96897,"_5":16788,"_22829":96799,"_2311":96898},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2783":57181,"_24069":57139,"_16893":96900,"_5":16788,"_22829":96799,"_2311":96901},[],"Historial",{"_2783":57182,"_24069":57139,"_16893":96903,"_5":16788,"_22829":96799,"_2311":96904},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2783":57183,"_24069":57139,"_16893":96906,"_5":16788,"_22829":96799,"_2311":96907},[],"Clave y certificado",{"_2783":57184,"_24069":57139,"_16893":96909,"_5":16788,"_22829":96799,"_2311":96910},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2783":57185,"_24069":57139,"_16893":96912,"_5":16788,"_22829":96802,"_2311":96913},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2783":57186,"_24069":57139,"_16893":96915,"_5":16788,"_22829":96802,"_2311":96916},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2783":57187,"_24069":57139,"_16893":96918,"_5":16788,"_22829":96802,"_2311":96919},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2783":57188,"_24069":57139,"_16893":96921,"_5":16788,"_22829":96802,"_2311":96922},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2783":57189,"_24069":57139,"_16893":96924,"_5":16788,"_22829":96806,"_2311":96925},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2783":57190,"_24069":57139,"_16893":96927,"_5":16788,"_22829":96806,"_2311":96928},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2783":57191,"_24069":57139,"_16893":96930,"_5":16788,"_22829":96806,"_2311":96931},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2783":57192,"_24069":57192,"_5":11891,"_2311":96933,"_24384":96934,"_16893":96935,"_22829":57192},"Plataforma Lamassu IoT",[39305,93739],[],{"_2783":57193,"_24069":57192,"_16893":96937,"_5":16788,"_22829":57192,"_2311":96938},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2783":57194,"_24069":57192,"_5":24381,"_16893":96940,"_22829":96941,"_2311":96431},[],"/docs/es/platform/overview#empieza-aquí",{"_2783":57195,"_24069":57192,"_5":24381,"_16893":96943,"_22829":96944,"_2311":96945},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2783":57196,"_24069":57192,"_5":24381,"_16893":96947,"_22829":96948,"_2311":96949},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2783":57197,"_24069":57192,"_5":24381,"_16893":96951,"_22829":96952,"_2311":96953},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_2783":57198,"_24069":57192,"_5":24381,"_16893":96955,"_22829":96956,"_2311":96957},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2783":57199,"_24069":57192,"_5":24381,"_16893":96959,"_22829":96960,"_2311":96961},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2783":57200,"_24069":57192,"_5":24381,"_16893":96963,"_22829":96964,"_2311":96965},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2783":57201,"_24069":57192,"_5":24381,"_16893":96967,"_22829":96968,"_2311":96969},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2783":57202,"_24069":57192,"_5":24381,"_16893":96971,"_22829":96972,"_2311":96973},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2783":57203,"_24069":57192,"_5":24381,"_16893":96975,"_22829":96976,"_2311":96977},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2783":57204,"_24069":57192,"_5":24381,"_16893":96979,"_22829":96980,"_2311":96981},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_2783":57205,"_24069":57192,"_16893":96983,"_5":16788,"_22829":57192,"_2311":96984},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2783":57206,"_24069":57192,"_16893":96986,"_5":16788,"_22829":96941,"_2311":96987},[],"Elige el resultado que necesitas obtener:",{"_2783":57207,"_24069":57192,"_16893":96989,"_5":16788,"_22829":96941,"_2311":96990},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":57208,"_24069":57192,"_16893":96992,"_5":16788,"_22829":96941,"_2311":96993},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":57209,"_24069":57192,"_16893":96995,"_5":16788,"_22829":96941,"_2311":96996},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2783":57210,"_24069":57192,"_16893":96998,"_5":16788,"_22829":96944,"_2311":96999},[],"Bloque",{"_2783":57211,"_24069":57192,"_16893":97001,"_5":16788,"_22829":96944,"_2311":97002},[],"Qué gestionas",{"_2783":57212,"_24069":57192,"_16893":97004,"_5":16788,"_22829":96944,"_2311":97005},[],"Punto de entrada",{"_2783":57213,"_24069":57192,"_16893":97007,"_5":16788,"_22829":96944,"_2311":44007},[],{"_2783":57214,"_24069":57192,"_16893":97009,"_5":16788,"_22829":96944,"_2311":97010},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2783":57215,"_24069":57192,"_16893":97012,"_5":16788,"_22829":96944,"_2311":97013},[],"Visión general de PKI",{"_2783":57216,"_24069":57192,"_16893":97015,"_5":16788,"_22829":96944,"_2311":44016},[],{"_2783":57217,"_24069":57192,"_16893":97017,"_5":16788,"_22829":96944,"_2311":97018},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2783":57218,"_24069":57192,"_16893":97020,"_5":16788,"_22829":96944,"_2311":97021},[],"Visión general de IoT Fleets",{"_2783":57219,"_24069":57192,"_16893":97023,"_5":16788,"_22829":96944,"_2311":97024},[],"**Administración**",{"_2783":57220,"_24069":57192,"_16893":97026,"_5":16788,"_22829":96944,"_2311":97027},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2783":57221,"_24069":57192,"_16893":97029,"_5":16788,"_22829":96944,"_2311":93737},[],{"_2783":57222,"_24069":57192,"_16893":97031,"_5":16788,"_22829":96944,"_2311":97032},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2783":57223,"_24069":57192,"_16893":97034,"_5":16788,"_22829":96948,"_2311":97035},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2783":57224,"_24069":57192,"_16893":97037,"_5":16788,"_22829":96948,"_2311":97038},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2783":57225,"_24069":57192,"_16893":97040,"_5":16788,"_22829":96948,"_2311":97041},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2783":57226,"_24069":57192,"_16893":97043,"_5":16788,"_22829":96948,"_2311":97044},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2783":57227,"_24069":57192,"_16893":97046,"_5":16788,"_22829":96948,"_2311":97047},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2783":57228,"_24069":57192,"_16893":97049,"_5":16788,"_22829":96948,"_2311":97050},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2783":57229,"_24069":57192,"_16893":97052,"_5":16788,"_22829":96956,"_2311":97053},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2783":57230,"_24069":57192,"_16893":97055,"_5":16788,"_22829":96960,"_2311":97056},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2783":57231,"_24069":57192,"_16893":97058,"_5":16788,"_22829":96964,"_2311":97059},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2783":57232,"_24069":57192,"_16893":97061,"_5":16788,"_22829":96968,"_2311":97062},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2783":57233,"_24069":57192,"_16893":97064,"_5":16788,"_22829":96972,"_2311":97065},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2783":57234,"_24069":57192,"_16893":97067,"_5":16788,"_22829":96976,"_2311":97068},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2783":57235,"_24069":57192,"_16893":97070,"_5":16788,"_22829":96980,"_2311":96524},[],{"_2783":57236,"_24069":57192,"_16893":97072,"_5":16788,"_22829":96980,"_2311":97073},[],"Qué prepara o comprueba",{"_2783":57237,"_24069":57192,"_16893":97075,"_5":16788,"_22829":96980,"_2311":96527},[],{"_2783":57238,"_24069":57192,"_16893":97077,"_5":16788,"_22829":96980,"_2311":97078},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2783":57239,"_24069":57192,"_16893":97080,"_5":16788,"_22829":96980,"_2311":97081},[],"Administrador de la flota",{"_2783":57240,"_24069":57192,"_16893":97083,"_5":16788,"_22829":96980,"_2311":97084},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2783":57241,"_24069":57192,"_16893":97086,"_5":16788,"_22829":96980,"_2311":96539},[],{"_2783":57242,"_24069":57192,"_16893":97088,"_5":16788,"_22829":96980,"_2311":97089},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2783":57243,"_24069":57192,"_16893":97091,"_5":16788,"_22829":96980,"_2311":96545},[],{"_2783":57244,"_24069":57192,"_16893":97093,"_5":16788,"_22829":96980,"_2311":97094},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2783":57245,"_24069":57192,"_16893":97096,"_5":16788,"_22829":96980,"_2311":97097},[],"Operador de infraestructura",{"_2783":57246,"_24069":57192,"_16893":97099,"_5":16788,"_22829":96980,"_2311":97100},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2783":57247,"_24069":57192,"_16893":97102,"_5":16788,"_22829":96980,"_2311":97103},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2783":57248,"_24069":57248,"_5":11891,"_2311":97105,"_24384":97106,"_16893":97108,"_22829":57248},"Jerarquía y rotación de CAs",[39305,93739,44108,97107],"Claves, autoridades y certificados",[],{"_2783":57249,"_24069":57248,"_16893":97110,"_5":16788,"_22829":57248,"_2311":97111},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2783":57250,"_24069":57248,"_5":24381,"_16893":97113,"_22829":97114,"_2311":97115},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2783":57251,"_24069":57248,"_5":24381,"_16893":97117,"_22829":97118,"_2311":97119},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2783":57252,"_24069":57248,"_5":24381,"_16893":97121,"_22829":97122,"_2311":97123},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2783":57253,"_24069":57248,"_5":24381,"_16893":97125,"_22829":97126,"_2311":97127},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2783":57254,"_24069":57248,"_5":24381,"_16893":97129,"_22829":97130,"_2311":97131},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2783":57255,"_24069":57248,"_5":24381,"_16893":97133,"_22829":97134,"_2311":97135},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2783":57256,"_24069":57248,"_5":24381,"_16893":97137,"_22829":97138,"_2311":97139},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2783":57257,"_24069":57248,"_5":24381,"_16893":97141,"_22829":97142,"_2311":97143},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2783":57258,"_24069":57248,"_5":24381,"_16893":97145,"_22829":97146,"_2311":97147},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2783":57259,"_24069":57248,"_5":24381,"_16893":97149,"_22829":97150,"_2311":97151},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2783":57260,"_24069":57248,"_5":24381,"_16893":97153,"_22829":97154,"_2311":97155},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2783":57261,"_24069":57248,"_5":24381,"_16893":97157,"_22829":97158,"_2311":97159},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2783":57262,"_24069":57248,"_16893":97161,"_5":16788,"_22829":57248,"_2311":97162},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2783":57263,"_24069":57248,"_16893":97164,"_5":16788,"_22829":57248,"_2311":97165},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2783":57264,"_24069":57248,"_16893":97167,"_5":16788,"_22829":97114,"_2311":97168},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2783":57265,"_24069":57248,"_16893":97170,"_5":16788,"_22829":97114,"_2311":97171},[],"entorno, como producción y preproducción;",{"_2783":57266,"_24069":57248,"_16893":97173,"_5":16788,"_22829":97114,"_2311":97174},[],"propietario o equipo operador;",{"_2783":57267,"_24069":57248,"_16893":97176,"_5":16788,"_22829":97114,"_2311":97177},[],"familia de dispositivos o proceso de fabricación;",{"_2783":57268,"_24069":57248,"_16893":97179,"_5":16788,"_22829":97114,"_2311":97180},[],"región o requisito regulatorio;",{"_2783":57269,"_24069":57248,"_16893":97182,"_5":16788,"_22829":97114,"_2311":97183},[],"motor criptográfico o política de clave;",{"_2783":57270,"_24069":57248,"_16893":97185,"_5":16788,"_22829":97114,"_2311":97186},[],"ventana de mantenimiento y ritmo de renovación.",{"_2783":57271,"_24069":57248,"_16893":97188,"_5":16788,"_22829":97114,"_2311":97189},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2783":57272,"_24069":57248,"_16893":97191,"_5":16788,"_22829":97114,"_2311":97192},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2783":57273,"_24069":57248,"_16893":97194,"_5":16788,"_22829":97118,"_2311":97195},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2783":57274,"_24069":57248,"_16893":97197,"_5":16788,"_22829":97118,"_2311":97198},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2783":57275,"_24069":57248,"_16893":97200,"_5":16788,"_22829":97118,"_2311":97201},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2783":57276,"_24069":57248,"_16893":97203,"_5":16788,"_22829":97122,"_2311":97204},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2783":57277,"_24069":57248,"_16893":97206,"_5":16788,"_22829":97122,"_2311":97207},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2783":57278,"_24069":57248,"_16893":97209,"_5":16788,"_22829":97122,"_2311":97210},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2783":57279,"_24069":57248,"_16893":97212,"_5":16788,"_22829":97122,"_2311":97213},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2783":57280,"_24069":57248,"_16893":97215,"_5":16788,"_22829":97130,"_2311":97216},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2783":57281,"_24069":57248,"_16893":97218,"_5":16788,"_22829":97134,"_2311":97219},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2783":57282,"_24069":57248,"_16893":97221,"_5":16788,"_22829":97138,"_2311":97222},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2783":57283,"_24069":57248,"_16893":97224,"_5":16788,"_22829":97142,"_2311":97225},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2783":57284,"_24069":57248,"_16893":97227,"_5":16788,"_22829":97146,"_2311":97228},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2783":57285,"_24069":57248,"_16893":97230,"_5":16788,"_22829":97150,"_2311":97231},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2783":57286,"_24069":57248,"_16893":97233,"_5":16788,"_22829":97154,"_2311":97234},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2783":57287,"_24069":57248,"_16893":97236,"_5":16788,"_22829":97154,"_2311":97237},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2783":57288,"_24069":57248,"_16893":97239,"_5":16788,"_22829":97154,"_2311":97240},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2783":57289,"_24069":57248,"_16893":97242,"_5":16788,"_22829":97154,"_2311":97243},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2783":57290,"_24069":57248,"_16893":97245,"_5":16788,"_22829":97158,"_2311":97246},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2783":57291,"_24069":57248,"_16893":97248,"_5":16788,"_22829":97158,"_2311":97249},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2783":57292,"_24069":57248,"_16893":97251,"_5":16788,"_22829":97158,"_2311":97252},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2783":57293,"_24069":57248,"_16893":97254,"_5":16788,"_22829":97158,"_2311":97255},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2783":57294,"_24069":57248,"_16893":97257,"_5":16788,"_22829":97158,"_2311":97258},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2783":57295,"_24069":57248,"_16893":97260,"_5":16788,"_22829":97158,"_2311":97261},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2783":57296,"_24069":57248,"_16893":97263,"_5":16788,"_22829":97158,"_2311":97264},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2783":57297,"_24069":57297,"_5":11891,"_2311":97266,"_24384":97267,"_16893":97268,"_22829":57297},"Autoridades de certificación",[39305,93739,44108,97107],[],{"_2783":57298,"_24069":57297,"_16893":97270,"_5":16788,"_22829":57297,"_2311":97271},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2783":57299,"_24069":57297,"_5":24381,"_16893":97273,"_22829":97274,"_2311":97275},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2783":57300,"_24069":57297,"_5":24381,"_16893":97277,"_22829":97278,"_2311":97279},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2783":57301,"_24069":57297,"_5":24381,"_16893":97281,"_22829":97282,"_2311":92440},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2783":57302,"_24069":57297,"_5":24381,"_16893":97284,"_22829":97285,"_2311":97286},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2783":57303,"_24069":57297,"_5":24381,"_16893":97288,"_22829":97289,"_2311":97290},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2783":57304,"_24069":57297,"_5":24381,"_16893":97292,"_22829":97293,"_2311":97294},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2783":57305,"_24069":57297,"_5":24381,"_16893":97296,"_22829":97297,"_2311":97298},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2783":57306,"_24069":57297,"_5":24381,"_16893":97300,"_22829":97301,"_2311":97302},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2783":57307,"_24069":57297,"_5":24381,"_16893":97304,"_22829":97305,"_2311":97306},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2783":57308,"_24069":57297,"_5":24381,"_16893":97308,"_22829":97309,"_2311":97310},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2783":57309,"_24069":57297,"_5":24381,"_16893":97312,"_22829":97313,"_2311":97314},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2783":57310,"_24069":57297,"_5":24381,"_16893":97316,"_22829":97317,"_2311":97318},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2783":57311,"_24069":57297,"_5":24381,"_16893":97320,"_22829":97321,"_2311":97322},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2783":57312,"_24069":57297,"_5":24381,"_16893":97324,"_22829":97325,"_2311":97326},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2783":57313,"_24069":57297,"_5":24381,"_16893":97328,"_22829":97329,"_2311":97330},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2783":57314,"_24069":57297,"_5":24381,"_16893":97332,"_22829":97333,"_2311":97334},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2783":57315,"_24069":57297,"_5":24381,"_16893":97336,"_22829":97337,"_2311":97338},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2783":57316,"_24069":57297,"_5":24381,"_16893":97340,"_22829":97341,"_2311":97342},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2783":57317,"_24069":57297,"_5":24381,"_16893":97344,"_22829":97345,"_2311":97346},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2783":57318,"_24069":57297,"_5":24381,"_16893":97348,"_22829":97349,"_2311":97350},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2783":57319,"_24069":57297,"_5":24381,"_16893":97352,"_22829":97353,"_2311":97354},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2783":57320,"_24069":57297,"_5":24381,"_16893":97356,"_22829":97357,"_2311":97358},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2783":57321,"_24069":57297,"_16893":97360,"_5":16788,"_22829":57297,"_2311":97361},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2783":57322,"_24069":57297,"_16893":97363,"_5":16788,"_22829":57297,"_2311":97364},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2783":57323,"_24069":57297,"_16893":97366,"_5":16788,"_22829":57297,"_2311":97367},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2783":57324,"_24069":57297,"_16893":97369,"_5":16788,"_22829":97274,"_2311":97370},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2783":57325,"_24069":57297,"_16893":97372,"_5":16788,"_22829":97274,"_2311":97373},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2783":57326,"_24069":57297,"_16893":97375,"_5":16788,"_22829":97274,"_2311":97376},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2783":57327,"_24069":57297,"_16893":97378,"_5":16788,"_22829":97274,"_2311":97379},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2783":57328,"_24069":57297,"_16893":97381,"_5":16788,"_22829":97274,"_2311":97382},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2783":57329,"_24069":57297,"_16893":97384,"_5":16788,"_22829":97282,"_2311":97385},[],"Decide si la CA será raíz o intermedia.",{"_2783":57330,"_24069":57297,"_16893":97387,"_5":16788,"_22829":97282,"_2311":97388},[],"Elige el motor que custodiará la clave.",{"_2783":57331,"_24069":57297,"_16893":97390,"_5":16788,"_22829":97282,"_2311":97391},[],"Define una validez superior a la de los certificados que emitirá.",{"_2783":57332,"_24069":57297,"_16893":97393,"_5":16788,"_22829":97282,"_2311":97394},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2783":57333,"_24069":57297,"_16893":97396,"_5":16788,"_22829":97285,"_2311":97397},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2783":57334,"_24069":57297,"_16893":97399,"_5":16788,"_22829":97289,"_2311":97400},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2783":57335,"_24069":57297,"_16893":97402,"_5":16788,"_22829":97289,"_2311":97403},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2783":57336,"_24069":57297,"_16893":97405,"_5":16788,"_22829":97293,"_2311":97406},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2783":57337,"_24069":57297,"_16893":97408,"_5":16788,"_22829":97297,"_2311":97409},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2783":57338,"_24069":57297,"_16893":97411,"_5":16788,"_22829":97297,"_2311":97412},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2783":57339,"_24069":57297,"_16893":97414,"_5":16788,"_22829":97297,"_2311":97415},[],"`ST`: estado o provincia.",{"_2783":57340,"_24069":57297,"_16893":97417,"_5":16788,"_22829":97297,"_2311":97418},[],"`L`: localidad.",{"_2783":57341,"_24069":57297,"_16893":97420,"_5":16788,"_22829":97297,"_2311":97421},[],"`O`: organización.",{"_2783":57342,"_24069":57297,"_16893":97423,"_5":16788,"_22829":97297,"_2311":97424},[],"`OU`: unidad organizativa.",{"_2783":57343,"_24069":57297,"_16893":97426,"_5":16788,"_22829":97297,"_2311":97427},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2783":57344,"_24069":57297,"_16893":97429,"_5":16788,"_22829":97301,"_2311":97430},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2783":57345,"_24069":57297,"_16893":97432,"_5":16788,"_22829":97301,"_2311":97433},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2783":57346,"_24069":57297,"_16893":97435,"_5":16788,"_22829":97305,"_2311":97436},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2783":57347,"_24069":57297,"_16893":97438,"_5":16788,"_22829":97305,"_2311":97439},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2783":57348,"_24069":57297,"_16893":97441,"_5":16788,"_22829":97309,"_2311":97442},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2783":57349,"_24069":57297,"_16893":97444,"_5":16788,"_22829":97309,"_2311":97445},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2783":57350,"_24069":57297,"_16893":97447,"_5":16788,"_22829":97313,"_2311":97448},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2783":57351,"_24069":57297,"_16893":97450,"_5":16788,"_22829":97317,"_2311":97451},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2783":57352,"_24069":57297,"_16893":97453,"_5":16788,"_22829":97321,"_2311":97454},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2783":57353,"_24069":57297,"_16893":97456,"_5":16788,"_22829":97325,"_2311":97457},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2783":57354,"_24069":57297,"_16893":97459,"_5":16788,"_22829":97329,"_2311":97460},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2783":57355,"_24069":57297,"_16893":97462,"_5":16788,"_22829":97329,"_2311":97463},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2783":57356,"_24069":57297,"_16893":97465,"_5":16788,"_22829":97333,"_2311":97466},[],"Abre una CA desde el inventario para consultar:",{"_2783":57357,"_24069":57297,"_16893":97468,"_5":16788,"_22829":97333,"_2311":97469},[],"Estado y periodo de validez.",{"_2783":57358,"_24069":57297,"_16893":97471,"_5":16788,"_22829":97333,"_2311":97472},[],"Certificado y cadena en formato PEM.",{"_2783":57359,"_24069":57297,"_16893":97474,"_5":16788,"_22829":97333,"_2311":97475},[],"Número de certificados activos, expirados y revocados.",{"_2783":57360,"_24069":57297,"_16893":97477,"_5":16788,"_22829":97333,"_2311":97478},[],"Certificados emitidos en **Issued Certificates**.",{"_2783":57361,"_24069":57297,"_16893":97480,"_5":16788,"_22829":97333,"_2311":97481},[],"CRL vinculada a la autoridad.",{"_2783":57362,"_24069":57297,"_16893":97483,"_5":16788,"_22829":97333,"_2311":97484},[],"Metadatos y motor criptográfico asociado.",{"_2783":57363,"_24069":57297,"_16893":97486,"_5":16788,"_22829":97333,"_2311":97487},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2783":57364,"_24069":57297,"_16893":97489,"_5":16788,"_22829":97337,"_2311":97490},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2783":57365,"_24069":57297,"_16893":97492,"_5":16788,"_22829":97337,"_2311":97493},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2783":57366,"_24069":57297,"_16893":97495,"_5":16788,"_22829":97337,"_2311":97496},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2783":57367,"_24069":57297,"_16893":97498,"_5":16788,"_22829":97337,"_2311":97499},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2783":57368,"_24069":57297,"_16893":97501,"_5":16788,"_22829":97341,"_2311":97502},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2783":57369,"_24069":57297,"_16893":97504,"_5":16788,"_22829":97345,"_2311":97505},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2783":57370,"_24069":57297,"_16893":97507,"_5":16788,"_22829":97349,"_2311":97508},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2783":57371,"_24069":57297,"_16893":97510,"_5":16788,"_22829":97353,"_2311":97511},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2783":57372,"_24069":57297,"_16893":97513,"_5":16788,"_22829":97357,"_2311":97514},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2783":57373,"_24069":57297,"_16893":97516,"_5":16788,"_22829":97357,"_2311":97517},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2783":57374,"_24069":57374,"_5":11891,"_2311":97519,"_24384":97520,"_16893":97521,"_22829":57374},"Perfiles de certificado",[39305,93739,44108,97107],[],{"_2783":57375,"_24069":57374,"_16893":97523,"_5":16788,"_22829":57374,"_2311":97524},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2783":57376,"_24069":57374,"_5":24381,"_16893":97526,"_22829":97527,"_2311":97528},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2783":57377,"_24069":57374,"_5":24381,"_16893":97530,"_22829":97531,"_2311":97532},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_2783":57378,"_24069":57374,"_5":24381,"_16893":97534,"_22829":97535,"_2311":97536},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2783":57379,"_24069":57374,"_5":24381,"_16893":97538,"_22829":97539,"_2311":97540},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2783":57380,"_24069":57374,"_5":24381,"_16893":97542,"_22829":97543,"_2311":97544},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2783":57381,"_24069":57374,"_5":24381,"_16893":97546,"_22829":97547,"_2311":97548},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2783":57382,"_24069":57374,"_5":24381,"_16893":97550,"_22829":97551,"_2311":97552},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2783":57383,"_24069":57374,"_5":24381,"_16893":97554,"_22829":97555,"_2311":97556},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2783":57384,"_24069":57374,"_5":24381,"_16893":97558,"_22829":97559,"_2311":97560},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2783":57385,"_24069":57374,"_5":24381,"_16893":97562,"_22829":97563,"_2311":97564},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2783":57386,"_24069":57374,"_5":24381,"_16893":97566,"_22829":97567,"_2311":97568},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2783":57387,"_24069":57374,"_5":24381,"_16893":97570,"_22829":97571,"_2311":97572},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2783":57388,"_24069":57374,"_5":24381,"_16893":97574,"_22829":97575,"_2311":97576},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2783":57389,"_24069":57374,"_5":24381,"_16893":97578,"_22829":97579,"_2311":97580},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2783":57390,"_24069":57374,"_5":24381,"_16893":97582,"_22829":97583,"_2311":97584},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2783":57391,"_24069":57374,"_5":24381,"_16893":97586,"_22829":97587,"_2311":97588},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2783":57392,"_24069":57374,"_16893":97590,"_5":16788,"_22829":57374,"_2311":97591},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2783":57393,"_24069":57374,"_16893":97593,"_5":16788,"_22829":57374,"_2311":97594},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2783":57394,"_24069":57374,"_16893":97596,"_5":16788,"_22829":97531,"_2311":97597},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2783":57395,"_24069":57374,"_16893":97599,"_5":16788,"_22829":97531,"_2311":97600},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2783":57396,"_24069":57374,"_16893":97602,"_5":16788,"_22829":97535,"_2311":97603},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2783":57397,"_24069":57374,"_16893":97605,"_5":16788,"_22829":97539,"_2311":97606},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2783":57398,"_24069":57374,"_16893":97608,"_5":16788,"_22829":97539,"_2311":97609},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2783":57399,"_24069":57374,"_16893":97611,"_5":16788,"_22829":97539,"_2311":97612},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2783":57400,"_24069":57374,"_16893":97614,"_5":16788,"_22829":97543,"_2311":97615},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2783":57401,"_24069":57374,"_16893":97617,"_5":16788,"_22829":97547,"_2311":97618},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2783":57402,"_24069":57374,"_16893":97620,"_5":16788,"_22829":97547,"_2311":97621},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2783":57403,"_24069":57374,"_16893":97623,"_5":16788,"_22829":97551,"_2311":97624},[],"La aplicación criptográfica puede:",{"_2783":57404,"_24069":57374,"_16893":97626,"_5":16788,"_22829":97551,"_2311":97627},[],"permitir o bloquear claves RSA;",{"_2783":57405,"_24069":57374,"_16893":97629,"_5":16788,"_22829":97551,"_2311":97630},[],"limitar los tamaños RSA admitidos;",{"_2783":57406,"_24069":57374,"_16893":97632,"_5":16788,"_22829":97551,"_2311":97633},[],"permitir o bloquear claves ECDSA;",{"_2783":57407,"_24069":57374,"_16893":97635,"_5":16788,"_22829":97551,"_2311":97636},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2783":57408,"_24069":57374,"_16893":97638,"_5":16788,"_22829":97551,"_2311":97639},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2783":57409,"_24069":57374,"_16893":97641,"_5":16788,"_22829":97555,"_2311":97642},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2783":57410,"_24069":57374,"_16893":97644,"_5":16788,"_22829":97555,"_2311":93530},[],{"_2783":57411,"_24069":57374,"_16893":97646,"_5":16788,"_22829":97555,"_2311":97647},[],"Primera opción",{"_2783":57412,"_24069":57374,"_16893":97649,"_5":16788,"_22829":97555,"_2311":97650},[],"Segunda opción",{"_2783":57413,"_24069":57374,"_16893":97652,"_5":16788,"_22829":97555,"_2311":97653},[],"Si no hay ninguna",{"_2783":57414,"_24069":57374,"_16893":97655,"_5":16788,"_22829":97555,"_2311":97656},[],"Firma directa con una CA",{"_2783":57415,"_24069":57374,"_16893":97658,"_5":16788,"_22829":97555,"_2311":97659},[],"`issuance_profile` incluido en la solicitud",{"_2783":57416,"_24069":57374,"_16893":97661,"_5":16788,"_22829":97555,"_2311":97662},[],"`issuance_profile_id` de la solicitud",{"_2783":57417,"_24069":57374,"_16893":97664,"_5":16788,"_22829":97555,"_2311":97665},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2783":57418,"_24069":57374,"_16893":97667,"_5":16788,"_22829":97555,"_2311":97668},[],"Emisión mediante DMS",{"_2783":57419,"_24069":57374,"_16893":97670,"_5":16788,"_22829":97555,"_2311":44673},[],{"_2783":57420,"_24069":57374,"_16893":97672,"_5":16788,"_22829":97555,"_2311":97673},[],"`settings.issuance_profile` incluido en el DMS",{"_2783":57421,"_24069":57374,"_16893":97675,"_5":16788,"_22829":97555,"_2311":97676},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2783":57422,"_24069":57374,"_16893":97678,"_5":16788,"_22829":97555,"_2311":97679},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2783":57423,"_24069":57374,"_16893":97681,"_5":16788,"_22829":97555,"_2311":97682},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2783":57424,"_24069":57374,"_16893":97684,"_5":16788,"_22829":97563,"_2311":97685},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2783":57425,"_24069":57374,"_16893":97687,"_5":16788,"_22829":97567,"_2311":97688},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2783":57426,"_24069":57374,"_16893":97690,"_5":16788,"_22829":97571,"_2311":97691},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2783":57427,"_24069":57374,"_16893":97693,"_5":16788,"_22829":97575,"_2311":97694},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2783":57428,"_24069":57374,"_16893":97696,"_5":16788,"_22829":97579,"_2311":97697},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2783":57429,"_24069":57374,"_16893":97699,"_5":16788,"_22829":97579,"_2311":97700},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2783":57430,"_24069":57374,"_16893":97702,"_5":16788,"_22829":97583,"_2311":97703},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2783":57431,"_24069":57374,"_16893":97705,"_5":16788,"_22829":97583,"_2311":97706},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2783":57432,"_24069":57374,"_16893":97708,"_5":16788,"_22829":97583,"_2311":97709},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2783":57433,"_24069":57374,"_16893":97711,"_5":16788,"_22829":97583,"_2311":97712},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2783":57434,"_24069":57374,"_16893":97714,"_5":16788,"_22829":97587,"_2311":97715},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2783":57435,"_24069":57374,"_16893":97717,"_5":16788,"_22829":97587,"_2311":97718},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2783":57436,"_24069":57436,"_5":11891,"_2311":97720,"_24384":97721,"_16893":97723,"_22829":57436},"Validación de certificados",[39305,93739,44108,97722],"Validación",[],{"_2783":57437,"_24069":57436,"_16893":97725,"_5":16788,"_22829":57436,"_2311":97726},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2783":57438,"_24069":57436,"_5":24381,"_16893":97728,"_22829":97729,"_2311":97730},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2783":57439,"_24069":57436,"_5":24381,"_16893":97732,"_22829":97733,"_2311":97734},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2783":57440,"_24069":57436,"_5":24381,"_16893":97736,"_22829":97737,"_2311":97738},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2783":57441,"_24069":57436,"_16893":97740,"_5":16788,"_22829":57436,"_2311":97741},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2783":57442,"_24069":57436,"_16893":97743,"_5":16788,"_22829":97729,"_2311":97744},[],"Verifica estos criterios juntos:",{"_2783":57443,"_24069":57436,"_16893":97746,"_5":16788,"_22829":97729,"_2311":96734},[],{"_2783":57444,"_24069":57436,"_16893":97748,"_5":16788,"_22829":97729,"_2311":97749},[],"Resultado necesario",{"_2783":57445,"_24069":57436,"_16893":97751,"_5":16788,"_22829":97729,"_2311":97752},[],"Cadena y firma",{"_2783":57446,"_24069":57436,"_16893":97754,"_5":16788,"_22829":97729,"_2311":97755},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2783":57447,"_24069":57436,"_16893":97757,"_5":16788,"_22829":97729,"_2311":97758},[],"Fechas",{"_2783":57448,"_24069":57436,"_16893":97760,"_5":16788,"_22829":97729,"_2311":97761},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2783":57449,"_24069":57436,"_16893":97763,"_5":16788,"_22829":97729,"_2311":93443},[],{"_2783":57450,"_24069":57436,"_16893":97765,"_5":16788,"_22829":97729,"_2311":97766},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2783":57451,"_24069":57436,"_16893":97768,"_5":16788,"_22829":97729,"_2311":97769},[],"Uso",{"_2783":57452,"_24069":57436,"_16893":97771,"_5":16788,"_22829":97729,"_2311":97772},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2783":57453,"_24069":57436,"_16893":97774,"_5":16788,"_22829":97729,"_2311":97775},[],"Revocación",{"_2783":57454,"_24069":57436,"_16893":97777,"_5":16788,"_22829":97729,"_2311":97778},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2783":57455,"_24069":57436,"_16893":97780,"_5":16788,"_22829":97729,"_2311":97781},[],"Autorización",{"_2783":57456,"_24069":57436,"_16893":97783,"_5":16788,"_22829":97729,"_2311":97784},[],"La aplicación permite la acción a esa identidad.",{"_2783":57457,"_24069":57436,"_16893":97786,"_5":16788,"_22829":97729,"_2311":97787},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2783":57458,"_24069":57436,"_16893":97789,"_5":16788,"_22829":97733,"_2311":97790},[],"Mecanismo",{"_2783":57459,"_24069":57436,"_16893":97792,"_5":16788,"_22829":97733,"_2311":97793},[],"Cuándo utilizarlo",{"_2783":57460,"_24069":57436,"_16893":97795,"_5":16788,"_22829":97733,"_2311":97796},[],"Qué debes mantener",{"_2783":57461,"_24069":57436,"_16893":97798,"_5":16788,"_22829":97733,"_2311":44801},[],{"_2783":57462,"_24069":57436,"_16893":97800,"_5":16788,"_22829":97733,"_2311":97801},[],"Consulta del estado de un certificado concreto.",{"_2783":57463,"_24069":57436,"_16893":97803,"_5":16788,"_22829":97733,"_2311":97804},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2783":57464,"_24069":57436,"_16893":97806,"_5":16788,"_22829":97733,"_2311":44810},[],{"_2783":57465,"_24069":57436,"_16893":97808,"_5":16788,"_22829":97733,"_2311":97809},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2783":57466,"_24069":57436,"_16893":97811,"_5":16788,"_22829":97733,"_2311":97812},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2783":57467,"_24069":57436,"_16893":97814,"_5":16788,"_22829":97733,"_2311":97815},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2783":57468,"_24069":57436,"_16893":97817,"_5":16788,"_22829":97733,"_2311":97818},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2783":57469,"_24069":57436,"_16893":97820,"_5":16788,"_22829":97737,"_2311":97821},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2783":57470,"_24069":57436,"_16893":97823,"_5":16788,"_22829":97737,"_2311":97824},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2783":57471,"_24069":57436,"_16893":97826,"_5":16788,"_22829":97737,"_2311":97827},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2783":57472,"_24069":57436,"_16893":97829,"_5":16788,"_22829":97737,"_2311":97830},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2783":57473,"_24069":57436,"_16893":97832,"_5":16788,"_22829":97737,"_2311":97833},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2783":57474,"_24069":57436,"_16893":97835,"_5":16788,"_22829":97737,"_2311":97836},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2783":57475,"_24069":57436,"_16893":97838,"_5":16788,"_22829":97737,"_2311":97839},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2783":57476,"_24069":57436,"_16893":97841,"_5":16788,"_22829":97737,"_2311":97842},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57477,"_24069":57436,"_16893":97844,"_5":16788,"_22829":97737,"_2311":97845},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2783":57478,"_24069":57478,"_5":11891,"_2311":97847,"_24384":97848,"_16893":97849,"_22829":57478},"Certificados",[39305,93739,44108,97107],[],{"_2783":57479,"_24069":57478,"_16893":97851,"_5":16788,"_22829":57478,"_2311":97852},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2783":57480,"_24069":57478,"_5":24381,"_16893":97854,"_22829":97855,"_2311":97856},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2783":57481,"_24069":57478,"_5":24381,"_16893":97858,"_22829":97859,"_2311":97860},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2783":57482,"_24069":57478,"_5":24381,"_16893":97862,"_22829":97863,"_2311":97864},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2783":57483,"_24069":57478,"_5":24381,"_16893":97866,"_22829":97867,"_2311":97868},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2783":57484,"_24069":57478,"_5":24381,"_16893":97870,"_22829":97871,"_2311":97872},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2783":57485,"_24069":57478,"_5":24381,"_16893":97874,"_22829":97875,"_2311":97876},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2783":57486,"_24069":57478,"_5":24381,"_16893":97878,"_22829":97879,"_2311":97880},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2783":57487,"_24069":57478,"_5":24381,"_16893":97882,"_22829":97883,"_2311":97884},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2783":57488,"_24069":57478,"_5":24381,"_16893":97886,"_22829":97887,"_2311":97888},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_2783":57489,"_24069":57478,"_16893":97890,"_5":16788,"_22829":57478,"_2311":97891},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2783":57490,"_24069":57478,"_16893":97893,"_5":16788,"_22829":97855,"_2311":97894},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2783":57491,"_24069":57478,"_16893":97896,"_5":16788,"_22829":97855,"_2311":97897},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2783":57492,"_24069":57478,"_16893":97899,"_5":16788,"_22829":97859,"_2311":97900},[],"Descarga el PEM e inspecciónalo:",{"_2783":57493,"_24069":57478,"_16893":97902,"_5":16788,"_22829":97859,"_2311":97903},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2783":57494,"_24069":57478,"_16893":97905,"_5":16788,"_22829":97863,"_2311":97906},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2783":57495,"_24069":57478,"_16893":97908,"_5":16788,"_22829":97863,"_2311":97909},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2783":57496,"_24069":57478,"_16893":97911,"_5":16788,"_22829":97863,"_2311":97912},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2783":57497,"_24069":57478,"_16893":97914,"_5":16788,"_22829":97863,"_2311":97915},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2783":57498,"_24069":57478,"_16893":97917,"_5":16788,"_22829":97863,"_2311":97918},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2783":57499,"_24069":57478,"_16893":97920,"_5":16788,"_22829":97863,"_2311":97921},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2783":57500,"_24069":57478,"_16893":97923,"_5":16788,"_22829":97863,"_2311":97924},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2783":57501,"_24069":57478,"_16893":97926,"_5":16788,"_22829":97867,"_2311":97927},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2783":57502,"_24069":57478,"_16893":97929,"_5":16788,"_22829":97871,"_2311":97930},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2783":57503,"_24069":57478,"_16893":97932,"_5":16788,"_22829":97875,"_2311":97933},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2783":57504,"_24069":57478,"_16893":97935,"_5":16788,"_22829":97879,"_2311":97936},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2783":57505,"_24069":57478,"_16893":97938,"_5":16788,"_22829":97879,"_2311":97939},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2783":57506,"_24069":57478,"_16893":97941,"_5":16788,"_22829":97879,"_2311":97942},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2783":57507,"_24069":57478,"_16893":97944,"_5":16788,"_22829":97883,"_2311":97945},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2783":57508,"_24069":57478,"_16893":97947,"_5":16788,"_22829":97883,"_2311":97948},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2783":57509,"_24069":57478,"_16893":97950,"_5":16788,"_22829":97883,"_2311":97951},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2783":57510,"_24069":57478,"_16893":97953,"_5":16788,"_22829":97887,"_2311":97954},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57511,"_24069":57478,"_16893":97956,"_5":16788,"_22829":97887,"_2311":97957},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2783":57512,"_24069":57512,"_5":11891,"_2311":97959,"_24384":97960,"_16893":97962,"_22829":57512},"Ciclo de vida de un certificado",[39305,93739,44108,97961],"Conceptos",[],{"_2783":57513,"_24069":57512,"_16893":97964,"_5":16788,"_22829":57512,"_2311":97965},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2783":57514,"_24069":57512,"_5":24381,"_16893":97967,"_22829":97968,"_2311":97969},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2783":57515,"_24069":57512,"_5":24381,"_16893":97971,"_22829":97972,"_2311":97973},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2783":57516,"_24069":57512,"_5":24381,"_16893":97975,"_22829":97976,"_2311":97977},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2783":57517,"_24069":57512,"_5":24381,"_16893":97979,"_22829":97980,"_2311":97981},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2783":57518,"_24069":57512,"_5":24381,"_16893":97983,"_22829":97984,"_2311":97985},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2783":57519,"_24069":57512,"_5":24381,"_16893":97987,"_22829":97988,"_2311":97989},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2783":57520,"_24069":57512,"_5":24381,"_16893":97991,"_22829":97992,"_2311":97993},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2783":57521,"_24069":57512,"_5":24381,"_16893":97995,"_22829":97996,"_2311":97997},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2783":57522,"_24069":57512,"_5":24381,"_16893":97999,"_22829":98000,"_2311":98001},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2783":57523,"_24069":57512,"_5":24381,"_16893":98003,"_22829":98004,"_2311":98005},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2783":57524,"_24069":57512,"_16893":98007,"_5":16788,"_22829":57512,"_2311":98008},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2783":57525,"_24069":57512,"_16893":98010,"_5":16788,"_22829":97972,"_2311":98011},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2783":57526,"_24069":57512,"_16893":98013,"_5":16788,"_22829":97976,"_2311":98014},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2783":57527,"_24069":57512,"_16893":98016,"_5":16788,"_22829":97980,"_2311":98017},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2783":57528,"_24069":57512,"_16893":98019,"_5":16788,"_22829":97984,"_2311":98020},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2783":57529,"_24069":57512,"_16893":98022,"_5":16788,"_22829":97988,"_2311":98023},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2783":57530,"_24069":57512,"_16893":98025,"_5":16788,"_22829":97992,"_2311":98026},[],"Lamassu persiste cuatro estados X.509:",{"_2783":57531,"_24069":57512,"_16893":98028,"_5":16788,"_22829":97992,"_2311":98029},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2783":57532,"_24069":57512,"_16893":98031,"_5":16788,"_22829":97992,"_2311":98032},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2783":57533,"_24069":57512,"_16893":98034,"_5":16788,"_22829":97992,"_2311":98035},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2783":57534,"_24069":57512,"_16893":98037,"_5":16788,"_22829":97992,"_2311":98038},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2783":57535,"_24069":57512,"_16893":98040,"_5":16788,"_22829":97992,"_2311":98041},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2783":57536,"_24069":57512,"_16893":98043,"_5":16788,"_22829":97996,"_2311":98044},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2783":57537,"_24069":57512,"_16893":98046,"_5":16788,"_22829":97996,"_2311":98047},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2783":57538,"_24069":57512,"_16893":98049,"_5":16788,"_22829":97996,"_2311":98050},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2783":57539,"_24069":57512,"_16893":98052,"_5":16788,"_22829":98000,"_2311":98053},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2783":57540,"_24069":57512,"_16893":98055,"_5":16788,"_22829":98000,"_2311":98056},[],"Antes de confirmar:",{"_2783":57541,"_24069":57512,"_16893":98058,"_5":16788,"_22829":98000,"_2311":98059},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2783":57542,"_24069":57512,"_16893":98061,"_5":16788,"_22829":98000,"_2311":98062},[],"Distribuye la nueva cadena de confianza.",{"_2783":57543,"_24069":57512,"_16893":98064,"_5":16788,"_22829":98000,"_2311":98065},[],"Reemite las identidades necesarias.",{"_2783":57544,"_24069":57512,"_16893":98067,"_5":16788,"_22829":98000,"_2311":98068},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2783":57545,"_24069":57512,"_16893":98070,"_5":16788,"_22829":98000,"_2311":98071},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2783":57546,"_24069":57512,"_16893":98073,"_5":16788,"_22829":98000,"_2311":98074},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2783":57547,"_24069":57512,"_16893":98076,"_5":16788,"_22829":98004,"_2311":98077},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2783":57548,"_24069":57512,"_16893":98079,"_5":16788,"_22829":98004,"_2311":98080},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2783":57549,"_24069":57512,"_16893":98082,"_5":16788,"_22829":98004,"_2311":98083},[],"Cambios de estado y razones de revocación.",{"_2783":57550,"_24069":57512,"_16893":98085,"_5":16788,"_22829":98004,"_2311":98086},[],"Publicación y vigencia de OCSP y CRLs.",{"_2783":57551,"_24069":57512,"_16893":98088,"_5":16788,"_22829":98004,"_2311":98089},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2783":57552,"_24069":57512,"_16893":98091,"_5":16788,"_22829":98004,"_2311":98092},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2783":57553,"_24069":57553,"_5":11891,"_2311":98094,"_24384":98095,"_16893":98096,"_22829":57553},"Modelo de confianza",[39305,93739,44108,97961],[],{"_2783":57554,"_24069":57553,"_16893":98098,"_5":16788,"_22829":57553,"_2311":98099},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2783":57555,"_24069":57553,"_5":24381,"_16893":98101,"_22829":98102,"_2311":98103},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2783":57556,"_24069":57553,"_5":24381,"_16893":98105,"_22829":98106,"_2311":98107},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2783":57557,"_24069":57553,"_5":24381,"_16893":98109,"_22829":98110,"_2311":98111},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2783":57558,"_24069":57553,"_5":24381,"_16893":98113,"_22829":98114,"_2311":98115},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2783":57559,"_24069":57553,"_5":24381,"_16893":98117,"_22829":98118,"_2311":98119},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2783":57560,"_24069":57553,"_5":24381,"_16893":98121,"_22829":98122,"_2311":98123},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2783":57561,"_24069":57553,"_5":24381,"_16893":98125,"_22829":98126,"_2311":98127},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2783":57562,"_24069":57553,"_5":24381,"_16893":98129,"_22829":98130,"_2311":98131},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2783":57563,"_24069":57553,"_5":24381,"_16893":98133,"_22829":98134,"_2311":98135},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2783":57564,"_24069":57553,"_5":24381,"_16893":98137,"_22829":98138,"_2311":98139},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2783":57565,"_24069":57553,"_16893":98141,"_5":16788,"_22829":57553,"_2311":98142},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2783":57566,"_24069":57553,"_16893":98144,"_5":16788,"_22829":98106,"_2311":98145},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2783":57567,"_24069":57553,"_16893":98147,"_5":16788,"_22829":98110,"_2311":98148},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2783":57568,"_24069":57553,"_16893":98150,"_5":16788,"_22829":98114,"_2311":98151},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2783":57569,"_24069":57553,"_16893":98153,"_5":16788,"_22829":98118,"_2311":98154},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2783":57570,"_24069":57553,"_16893":98156,"_5":16788,"_22829":98122,"_2311":98157},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2783":57571,"_24069":57553,"_16893":98159,"_5":16788,"_22829":98122,"_2311":98160},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2783":57572,"_24069":57553,"_16893":98162,"_5":16788,"_22829":98122,"_2311":98163},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2783":57573,"_24069":57553,"_16893":98165,"_5":16788,"_22829":98122,"_2311":98166},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2783":57574,"_24069":57553,"_16893":98168,"_5":16788,"_22829":98122,"_2311":98169},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2783":57575,"_24069":57553,"_16893":98171,"_5":16788,"_22829":98122,"_2311":98172},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2783":57576,"_24069":57553,"_16893":98174,"_5":16788,"_22829":98126,"_2311":98175},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2783":57577,"_24069":57553,"_16893":98177,"_5":16788,"_22829":98126,"_2311":98178},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2783":57578,"_24069":57553,"_16893":98180,"_5":16788,"_22829":98126,"_2311":98181},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2783":57579,"_24069":57553,"_16893":98183,"_5":16788,"_22829":98126,"_2311":98184},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2783":57580,"_24069":57553,"_16893":98186,"_5":16788,"_22829":98126,"_2311":98187},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2783":57581,"_24069":57553,"_16893":98189,"_5":16788,"_22829":98130,"_2311":98190},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2783":57582,"_24069":57553,"_16893":98192,"_5":16788,"_22829":98130,"_2311":98193},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2783":57583,"_24069":57553,"_16893":98195,"_5":16788,"_22829":98130,"_2311":98196},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2783":57584,"_24069":57553,"_16893":98198,"_5":16788,"_22829":98130,"_2311":98199},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2783":57585,"_24069":57553,"_16893":98201,"_5":16788,"_22829":98130,"_2311":98202},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2783":57586,"_24069":57553,"_16893":98204,"_5":16788,"_22829":98130,"_2311":98205},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2783":57587,"_24069":57553,"_16893":98207,"_5":16788,"_22829":98130,"_2311":98208},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2783":57588,"_24069":57553,"_16893":98210,"_5":16788,"_22829":98134,"_2311":98211},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2783":57589,"_24069":57553,"_16893":98213,"_5":16788,"_22829":98138,"_2311":98214},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2783":57590,"_24069":57553,"_16893":98216,"_5":16788,"_22829":98138,"_2311":98217},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2783":57591,"_24069":57553,"_16893":98219,"_5":16788,"_22829":98138,"_2311":98220},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2783":57592,"_24069":57553,"_16893":98222,"_5":16788,"_22829":98138,"_2311":98223},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2783":57593,"_24069":57553,"_16893":98225,"_5":16788,"_22829":98138,"_2311":98226},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2783":57594,"_24069":57553,"_16893":98228,"_5":16788,"_22829":98138,"_2311":98229},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2783":57595,"_24069":57553,"_16893":98231,"_5":16788,"_22829":98138,"_2311":98232},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2783":57596,"_24069":57596,"_5":11891,"_2311":98234,"_24384":98235,"_16893":98236,"_22829":57596},"Listas de revocación (CRL)",[39305,93739,44108,97722],[],{"_2783":57597,"_24069":57596,"_16893":98238,"_5":16788,"_22829":57596,"_2311":98239},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2783":57598,"_24069":57596,"_5":24381,"_16893":98241,"_22829":98242,"_2311":98243},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2783":57599,"_24069":57596,"_5":24381,"_16893":98245,"_22829":98246,"_2311":98247},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2783":57600,"_24069":57596,"_5":24381,"_16893":98249,"_22829":98250,"_2311":98251},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2783":57601,"_24069":57596,"_5":24381,"_16893":98253,"_22829":98254,"_2311":98255},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2783":57602,"_24069":57596,"_5":24381,"_16893":98257,"_22829":98258,"_2311":98259},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2783":57603,"_24069":57596,"_5":24381,"_16893":98261,"_22829":98262,"_2311":98263},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2783":57604,"_24069":57596,"_5":24381,"_16893":98265,"_22829":98266,"_2311":98267},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_2783":57605,"_24069":57596,"_16893":98269,"_5":16788,"_22829":57596,"_2311":98270},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2783":57606,"_24069":57596,"_16893":98272,"_5":16788,"_22829":98242,"_2311":98273},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2783":57607,"_24069":57596,"_16893":98275,"_5":16788,"_22829":98242,"_2311":98276},[],"Campo de `crl_options`",{"_2783":57608,"_24069":57596,"_16893":98278,"_5":16788,"_22829":98242,"_2311":95052},[],{"_2783":57609,"_24069":57596,"_16893":98280,"_5":16788,"_22829":98242,"_2311":98281},[],"Valor inicial del backend",{"_2783":57610,"_24069":57596,"_16893":98283,"_5":16788,"_22829":98242,"_2311":45288},[],{"_2783":57611,"_24069":57596,"_16893":98285,"_5":16788,"_22829":98242,"_2311":98286},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2783":57612,"_24069":57596,"_16893":98288,"_5":16788,"_22829":98242,"_2311":98289},[],"7 días.",{"_2783":57613,"_24069":57596,"_16893":98291,"_5":16788,"_22829":98242,"_2311":45297},[],{"_2783":57614,"_24069":57596,"_16893":98293,"_5":16788,"_22829":98242,"_2311":98294},[],"Plazo desde la publicación que activa la renovación programada.",{"_2783":57615,"_24069":57596,"_16893":98296,"_5":16788,"_22829":98242,"_2311":98297},[],"6 días y 23 horas.",{"_2783":57616,"_24069":57596,"_16893":98299,"_5":16788,"_22829":98242,"_2311":45306},[],{"_2783":57617,"_24069":57596,"_16893":98301,"_5":16788,"_22829":98242,"_2311":98302},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2783":57618,"_24069":57596,"_16893":98304,"_5":16788,"_22829":98242,"_2311":45312},[],{"_2783":57619,"_24069":57596,"_16893":98306,"_5":16788,"_22829":98242,"_2311":45315},[],{"_2783":57620,"_24069":57596,"_16893":98308,"_5":16788,"_22829":98242,"_2311":98309},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2783":57621,"_24069":57596,"_16893":98311,"_5":16788,"_22829":98242,"_2311":98312},[],"SKI de la CA.",{"_2783":57622,"_24069":57596,"_16893":98314,"_5":16788,"_22829":98242,"_2311":98315},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2783":57623,"_24069":57596,"_16893":98317,"_5":16788,"_22829":98242,"_2311":98318},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2783":57624,"_24069":57596,"_16893":98320,"_5":16788,"_22829":98246,"_2311":98321},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2783":57625,"_24069":57596,"_16893":98323,"_5":16788,"_22829":98246,"_2311":98324},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2783":57626,"_24069":57596,"_16893":98326,"_5":16788,"_22829":98246,"_2311":98327},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2783":57627,"_24069":57596,"_16893":98329,"_5":16788,"_22829":98250,"_2311":98330},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2783":57628,"_24069":57596,"_16893":98332,"_5":16788,"_22829":98250,"_2311":98333},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2783":57629,"_24069":57596,"_16893":98335,"_5":16788,"_22829":98254,"_2311":98336},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2783":57630,"_24069":57596,"_16893":98338,"_5":16788,"_22829":98254,"_2311":98339},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2783":57631,"_24069":57596,"_16893":98341,"_5":16788,"_22829":98254,"_2311":98342},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2783":57632,"_24069":57596,"_16893":98344,"_5":16788,"_22829":98254,"_2311":98345},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2783":57633,"_24069":57596,"_16893":98347,"_5":16788,"_22829":98254,"_2311":98348},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2783":57634,"_24069":57596,"_16893":98350,"_5":16788,"_22829":98258,"_2311":98351},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2783":57635,"_24069":57596,"_16893":98353,"_5":16788,"_22829":98258,"_2311":95241},[],{"_2783":57636,"_24069":57596,"_16893":98355,"_5":16788,"_22829":98258,"_2311":98356},[],"Path relativo",{"_2783":57637,"_24069":57596,"_16893":98358,"_5":16788,"_22829":98258,"_2311":93530},[],{"_2783":57638,"_24069":57596,"_16893":98360,"_5":16788,"_22829":98258,"_2311":45370},[],{"_2783":57639,"_24069":57596,"_16893":98362,"_5":16788,"_22829":98258,"_2311":45373},[],{"_2783":57640,"_24069":57596,"_16893":98364,"_5":16788,"_22829":98258,"_2311":98365},[],"Consultar `crl_options` y `latest_crl`.",{"_2783":57641,"_24069":57596,"_16893":98367,"_5":16788,"_22829":98258,"_2311":45379},[],{"_2783":57642,"_24069":57596,"_16893":98369,"_5":16788,"_22829":98258,"_2311":45373},[],{"_2783":57643,"_24069":57596,"_16893":98371,"_5":16788,"_22829":98258,"_2311":98372},[],"Sustituir la configuración de CRL.",{"_2783":57644,"_24069":57596,"_16893":98374,"_5":16788,"_22829":98258,"_2311":98375},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2783":57645,"_24069":57596,"_16893":98377,"_5":16788,"_22829":98258,"_2311":98378},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2783":57646,"_24069":57596,"_16893":98380,"_5":16788,"_22829":98262,"_2311":98381},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2783":57647,"_24069":57596,"_16893":98383,"_5":16788,"_22829":98266,"_2311":98384},[],"RFC 5280: perfil X.509 y CRL.",{"_2783":57648,"_24069":57596,"_16893":98386,"_5":16788,"_22829":98266,"_2311":45399},[],{"_2783":57649,"_24069":57596,"_16893":98388,"_5":16788,"_22829":98266,"_2311":45402},[],{"_2783":57650,"_24069":57596,"_16893":98390,"_5":16788,"_22829":98266,"_2311":98391},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":57651,"_24069":57596,"_16893":98393,"_5":16788,"_22829":98266,"_2311":98394},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2783":57652,"_24069":57652,"_5":11891,"_2311":98396,"_24384":98397,"_16893":98398,"_22829":57652},"Claves y motores criptográficos",[39305,93739,44108,97107],[],{"_2783":57653,"_24069":57652,"_16893":98400,"_5":16788,"_22829":57652,"_2311":98401},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2783":57654,"_24069":57652,"_5":24381,"_16893":98403,"_22829":98404,"_2311":98405},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2783":57655,"_24069":57652,"_5":24381,"_16893":98407,"_22829":98408,"_2311":98409},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2783":57656,"_24069":57652,"_5":24381,"_16893":98411,"_22829":98412,"_2311":45427},[],"/docs/es/platform/pki/key-management#file-system",{"_2783":57657,"_24069":57652,"_5":24381,"_16893":98414,"_22829":98415,"_2311":45431},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_2783":57658,"_24069":57652,"_5":24381,"_16893":98417,"_22829":98418,"_2311":45435},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_2783":57659,"_24069":57652,"_5":24381,"_16893":98420,"_22829":98421,"_2311":45439},[],"/docs/es/platform/pki/key-management#aws-kms",{"_2783":57660,"_24069":57652,"_5":24381,"_16893":98423,"_22829":98424,"_2311":45443},[],"/docs/es/platform/pki/key-management#pkcs11",{"_2783":57661,"_24069":57652,"_5":24381,"_16893":98426,"_22829":98427,"_2311":45447},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_2783":57662,"_24069":57652,"_5":24381,"_16893":98429,"_22829":98430,"_2311":98431},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2783":57663,"_24069":57652,"_5":24381,"_16893":98433,"_22829":98434,"_2311":98435},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2783":57664,"_24069":57652,"_5":24381,"_16893":98437,"_22829":98438,"_2311":98439},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2783":57665,"_24069":57652,"_5":24381,"_16893":98441,"_22829":98442,"_2311":98443},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2783":57666,"_24069":57652,"_5":24381,"_16893":98445,"_22829":98446,"_2311":98447},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2783":57667,"_24069":57652,"_5":24381,"_16893":98449,"_22829":98450,"_2311":98451},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2783":57668,"_24069":57652,"_5":24381,"_16893":98453,"_22829":98454,"_2311":98455},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2783":57669,"_24069":57652,"_5":24381,"_16893":98457,"_22829":98458,"_2311":45479},[],"/docs/es/platform/pki/key-management#sign",{"_2783":57670,"_24069":57652,"_5":24381,"_16893":98460,"_22829":98461,"_2311":45483},[],"/docs/es/platform/pki/key-management#verify",{"_2783":57671,"_24069":57652,"_5":24381,"_16893":98463,"_22829":98464,"_2311":98465},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2783":57672,"_24069":57652,"_5":24381,"_16893":98467,"_22829":98468,"_2311":98469},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2783":57673,"_24069":57652,"_5":24381,"_16893":98471,"_22829":98472,"_2311":98473},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2783":57674,"_24069":57652,"_16893":98475,"_5":16788,"_22829":57652,"_2311":98476},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2783":57675,"_24069":57652,"_16893":98478,"_5":16788,"_22829":57652,"_2311":98479},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2783":57676,"_24069":57652,"_16893":98481,"_5":16788,"_22829":98404,"_2311":98482},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2783":57677,"_24069":57652,"_16893":98484,"_5":16788,"_22829":98404,"_2311":98485},[],"En la práctica, permite:",{"_2783":57678,"_24069":57652,"_16893":98487,"_5":16788,"_22829":98404,"_2311":98488},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2783":57679,"_24069":57652,"_16893":98490,"_5":16788,"_22829":98404,"_2311":98491},[],"Importar claves creadas externamente.",{"_2783":57680,"_24069":57652,"_16893":98493,"_5":16788,"_22829":98404,"_2311":98494},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2783":57681,"_24069":57652,"_16893":98496,"_5":16788,"_22829":98404,"_2311":98497},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2783":57682,"_24069":57652,"_16893":98499,"_5":16788,"_22829":98408,"_2311":98500},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2783":57683,"_24069":57652,"_16893":98502,"_5":16788,"_22829":98408,"_2311":98503},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2783":57684,"_24069":57652,"_16893":98505,"_5":16788,"_22829":98408,"_2311":98506},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2783":57685,"_24069":57652,"_16893":98508,"_5":16788,"_22829":98412,"_2311":98509},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2783":57686,"_24069":57652,"_16893":98511,"_5":16788,"_22829":98415,"_2311":98512},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2783":57687,"_24069":57652,"_16893":98514,"_5":16788,"_22829":98418,"_2311":98515},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2783":57688,"_24069":57652,"_16893":98517,"_5":16788,"_22829":98421,"_2311":98518},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2783":57689,"_24069":57652,"_16893":98520,"_5":16788,"_22829":98424,"_2311":98521},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2783":57690,"_24069":57652,"_16893":98523,"_5":16788,"_22829":98427,"_2311":98524},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2783":57691,"_24069":57652,"_16893":98526,"_5":16788,"_22829":98427,"_2311":98527},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2783":57692,"_24069":57652,"_16893":98529,"_5":16788,"_22829":98427,"_2311":98530},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2783":57693,"_24069":57652,"_16893":98532,"_5":16788,"_22829":98427,"_2311":98533},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2783":57694,"_24069":57652,"_16893":98535,"_5":16788,"_22829":98430,"_2311":98536},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2783":57695,"_24069":57652,"_16893":98538,"_5":16788,"_22829":98430,"_2311":98539},[],"La tabla incluye los siguientes campos:",{"_2783":57696,"_24069":57652,"_16893":98541,"_5":16788,"_22829":98430,"_2311":98542},[],"**Name**: nombre descriptivo de la clave.",{"_2783":57697,"_24069":57652,"_16893":98544,"_5":16788,"_22829":98430,"_2311":98545},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2783":57698,"_24069":57652,"_16893":98547,"_5":16788,"_22829":98430,"_2311":98548},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2783":57699,"_24069":57652,"_16893":98550,"_5":16788,"_22829":98430,"_2311":98551},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2783":57700,"_24069":57652,"_16893":98553,"_5":16788,"_22829":98430,"_2311":98554},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2783":57701,"_24069":57652,"_16893":98556,"_5":16788,"_22829":98430,"_2311":98557},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2783":57702,"_24069":57652,"_16893":98559,"_5":16788,"_22829":98430,"_2311":98560},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2783":57703,"_24069":57652,"_16893":98562,"_5":16788,"_22829":98430,"_2311":98563},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2783":57704,"_24069":57652,"_16893":98565,"_5":16788,"_22829":98430,"_2311":98566},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2783":57705,"_24069":57652,"_16893":98568,"_5":16788,"_22829":98430,"_2311":98569},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2783":57706,"_24069":57652,"_16893":98571,"_5":16788,"_22829":98430,"_2311":98572},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2783":57707,"_24069":57652,"_16893":98574,"_5":16788,"_22829":98430,"_2311":98575},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2783":57708,"_24069":57652,"_16893":98577,"_5":16788,"_22829":98430,"_2311":98578},[],"**Delete Key** para eliminar la clave del sistema.",{"_2783":57709,"_24069":57652,"_16893":98580,"_5":16788,"_22829":98434,"_2311":98581},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2783":57710,"_24069":57652,"_16893":98583,"_5":16788,"_22829":98438,"_2311":98584},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2783":57711,"_24069":57652,"_16893":98586,"_5":16788,"_22829":98438,"_2311":98587},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2783":57712,"_24069":57652,"_16893":98589,"_5":16788,"_22829":98438,"_2311":98590},[],"**Key Name**: nombre único y descriptivo.",{"_2783":57713,"_24069":57652,"_16893":98592,"_5":16788,"_22829":98438,"_2311":98593},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2783":57714,"_24069":57652,"_16893":98595,"_5":16788,"_22829":98438,"_2311":98596},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2783":57715,"_24069":57652,"_16893":98598,"_5":16788,"_22829":98438,"_2311":98599},[],"**Tags**: metadatos para clasificar la clave.",{"_2783":57716,"_24069":57652,"_16893":98601,"_5":16788,"_22829":98438,"_2311":98602},[],"**Metadata**: información adicional para usos avanzados.",{"_2783":57717,"_24069":57652,"_16893":98604,"_5":16788,"_22829":98442,"_2311":98605},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2783":57718,"_24069":57652,"_16893":98607,"_5":16788,"_22829":98442,"_2311":98608},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2783":57719,"_24069":57652,"_16893":98610,"_5":16788,"_22829":98442,"_2311":98611},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2783":57720,"_24069":57652,"_16893":98613,"_5":16788,"_22829":98442,"_2311":98614},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2783":57721,"_24069":57652,"_16893":98616,"_5":16788,"_22829":98442,"_2311":98617},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2783":57722,"_24069":57652,"_16893":98619,"_5":16788,"_22829":98442,"_2311":98620},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2783":57723,"_24069":57652,"_16893":98622,"_5":16788,"_22829":98442,"_2311":98623},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2783":57724,"_24069":57652,"_16893":98625,"_5":16788,"_22829":98442,"_2311":98626},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2783":57725,"_24069":57652,"_16893":98628,"_5":16788,"_22829":98442,"_2311":98629},[],"**Metadata**: información adicional opcional.",{"_2783":57726,"_24069":57652,"_16893":98631,"_5":16788,"_22829":98442,"_2311":98632},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2783":57727,"_24069":57652,"_16893":98634,"_5":16788,"_22829":98442,"_2311":98635},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2783":57728,"_24069":57652,"_16893":98637,"_5":16788,"_22829":98446,"_2311":98638},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2783":57729,"_24069":57652,"_16893":98640,"_5":16788,"_22829":98450,"_2311":98641},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2783":57730,"_24069":57652,"_16893":98643,"_5":16788,"_22829":98450,"_2311":98644},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2783":57731,"_24069":57652,"_16893":98646,"_5":16788,"_22829":98450,"_2311":98647},[],"**Key Name**: nombre descriptivo.",{"_2783":57732,"_24069":57652,"_16893":98649,"_5":16788,"_22829":98450,"_2311":98650},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2783":57733,"_24069":57652,"_16893":98652,"_5":16788,"_22829":98450,"_2311":98653},[],"**Tags**: etiquetas asociadas.",{"_2783":57734,"_24069":57652,"_16893":98655,"_5":16788,"_22829":98450,"_2311":98656},[],"**Aliases**: nombres alternativos.",{"_2783":57735,"_24069":57652,"_16893":98658,"_5":16788,"_22829":98450,"_2311":98659},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2783":57736,"_24069":57652,"_16893":98661,"_5":16788,"_22829":98450,"_2311":98662},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2783":57737,"_24069":57652,"_16893":98664,"_5":16788,"_22829":98450,"_2311":98665},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2783":57738,"_24069":57652,"_16893":98667,"_5":16788,"_22829":98450,"_2311":98668},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2783":57739,"_24069":57652,"_16893":98670,"_5":16788,"_22829":98454,"_2311":98671},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2783":57740,"_24069":57652,"_16893":98673,"_5":16788,"_22829":98454,"_2311":98674},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2783":57741,"_24069":57652,"_16893":98676,"_5":16788,"_22829":98454,"_2311":98677},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2783":57742,"_24069":57652,"_16893":98679,"_5":16788,"_22829":98458,"_2311":98680},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2783":57743,"_24069":57652,"_16893":98682,"_5":16788,"_22829":98458,"_2311":98683},[],"Campos principales:",{"_2783":57744,"_24069":57652,"_16893":98685,"_5":16788,"_22829":98458,"_2311":98686},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2783":57745,"_24069":57652,"_16893":98688,"_5":16788,"_22829":98458,"_2311":98689},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2783":57746,"_24069":57652,"_16893":98691,"_5":16788,"_22829":98458,"_2311":98692},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2783":57747,"_24069":57652,"_16893":98694,"_5":16788,"_22829":98458,"_2311":98695},[],"**Message**: contenido que se va a firmar.",{"_2783":57748,"_24069":57652,"_16893":98697,"_5":16788,"_22829":98458,"_2311":98698},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2783":57749,"_24069":57652,"_16893":98700,"_5":16788,"_22829":98461,"_2311":98701},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2783":57750,"_24069":57652,"_16893":98703,"_5":16788,"_22829":98461,"_2311":98683},[],{"_2783":57751,"_24069":57652,"_16893":98705,"_5":16788,"_22829":98461,"_2311":98706},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2783":57752,"_24069":57652,"_16893":98708,"_5":16788,"_22829":98461,"_2311":98709},[],"**Message Type**: `Raw` o `Digest`.",{"_2783":57753,"_24069":57652,"_16893":98711,"_5":16788,"_22829":98461,"_2311":98712},[],"**Payload Encoding**: codificación del mensaje.",{"_2783":57754,"_24069":57652,"_16893":98714,"_5":16788,"_22829":98461,"_2311":98715},[],"**Message**: mensaje original o hash.",{"_2783":57755,"_24069":57652,"_16893":98717,"_5":16788,"_22829":98461,"_2311":98718},[],"**Signature**: firma que se desea comprobar.",{"_2783":57756,"_24069":57652,"_16893":98720,"_5":16788,"_22829":98461,"_2311":98721},[],"**Result**: indicador del resultado de la validación.",{"_2783":57757,"_24069":57652,"_16893":98723,"_5":16788,"_22829":98464,"_2311":98724},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2783":57758,"_24069":57652,"_16893":98726,"_5":16788,"_22829":98464,"_2311":98727},[],"Este flujo es útil para:",{"_2783":57759,"_24069":57652,"_16893":98729,"_5":16788,"_22829":98464,"_2311":98730},[],"Solicitar certificados a una CA externa.",{"_2783":57760,"_24069":57652,"_16893":98732,"_5":16788,"_22829":98464,"_2311":98733},[],"Renovar una identidad manteniendo la misma clave.",{"_2783":57761,"_24069":57652,"_16893":98735,"_5":16788,"_22829":98464,"_2311":98736},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2783":57762,"_24069":57652,"_16893":98738,"_5":16788,"_22829":98464,"_2311":98739},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2783":57763,"_24069":57652,"_16893":98741,"_5":16788,"_22829":98464,"_2311":98742},[],"**Organization (O)**: organización o empresa.",{"_2783":57764,"_24069":57652,"_16893":98744,"_5":16788,"_22829":98464,"_2311":98745},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2783":57765,"_24069":57652,"_16893":98747,"_5":16788,"_22829":98464,"_2311":98748},[],"**Country (C)**: código de país de dos letras.",{"_2783":57766,"_24069":57652,"_16893":98750,"_5":16788,"_22829":98464,"_2311":98751},[],"**State / Province (ST)**: estado o provincia.",{"_2783":57767,"_24069":57652,"_16893":98753,"_5":16788,"_22829":98464,"_2311":98754},[],"**Locality (L)**: ciudad o localidad.",{"_2783":57768,"_24069":57652,"_16893":98756,"_5":16788,"_22829":98464,"_2311":98757},[],"**Email Address**: correo de contacto.",{"_2783":57769,"_24069":57652,"_16893":98759,"_5":16788,"_22829":98464,"_2311":98760},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2783":57770,"_24069":57652,"_16893":98762,"_5":16788,"_22829":98464,"_2311":98763},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2783":57771,"_24069":57652,"_16893":98765,"_5":16788,"_22829":98468,"_2311":98766},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2783":57772,"_24069":57652,"_16893":98768,"_5":16788,"_22829":98468,"_2311":45791},[],{"_2783":57773,"_24069":57652,"_16893":98770,"_5":16788,"_22829":98472,"_2311":98771},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2783":57774,"_24069":57774,"_5":11891,"_2311":98773,"_24384":98774,"_16893":98775,"_22829":57774},"Validación online con OCSP",[39305,93739,44108,97722],[],{"_2783":57775,"_24069":57774,"_16893":98777,"_5":16788,"_22829":57774,"_2311":98778},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2783":57776,"_24069":57774,"_5":24381,"_16893":98780,"_22829":98781,"_2311":98782},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2783":57777,"_24069":57774,"_5":24381,"_16893":98784,"_22829":98785,"_2311":98786},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2783":57778,"_24069":57774,"_5":24381,"_16893":98788,"_22829":98789,"_2311":98790},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2783":57779,"_24069":57774,"_5":24381,"_16893":98792,"_22829":98793,"_2311":98794},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2783":57780,"_24069":57774,"_5":24381,"_16893":98796,"_22829":98797,"_2311":98798},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2783":57781,"_24069":57774,"_5":24381,"_16893":98800,"_22829":98801,"_2311":98267},[],"/docs/es/platform/pki/ocsp#referencias",{"_2783":57782,"_24069":57774,"_16893":98803,"_5":16788,"_22829":57774,"_2311":98804},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2783":57783,"_24069":57774,"_16893":98806,"_5":16788,"_22829":98781,"_2311":98807},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2783":57784,"_24069":57774,"_16893":98809,"_5":16788,"_22829":98781,"_2311":98810},[],"Estado del registro",{"_2783":57785,"_24069":57774,"_16893":98812,"_5":16788,"_22829":98781,"_2311":98813},[],"Respuesta firmada",{"_2783":57786,"_24069":57774,"_16893":98815,"_5":16788,"_22829":98781,"_2311":43286},[],{"_2783":57787,"_24069":57774,"_16893":98817,"_5":16788,"_22829":98781,"_2311":45841},[],{"_2783":57788,"_24069":57774,"_16893":98819,"_5":16788,"_22829":98781,"_2311":43303},[],{"_2783":57789,"_24069":57774,"_16893":98821,"_5":16788,"_22829":98781,"_2311":98822},[],"`Revoked`, con razón y fecha de revocación.",{"_2783":57790,"_24069":57774,"_16893":98824,"_5":16788,"_22829":98781,"_2311":98825},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2783":57791,"_24069":57774,"_16893":98827,"_5":16788,"_22829":98781,"_2311":98828},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2783":57792,"_24069":57774,"_16893":98830,"_5":16788,"_22829":98781,"_2311":98831},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2783":57793,"_24069":57774,"_16893":98833,"_5":16788,"_22829":98781,"_2311":98834},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2783":57794,"_24069":57774,"_16893":98836,"_5":16788,"_22829":98781,"_2311":98837},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2783":57795,"_24069":57774,"_16893":98839,"_5":16788,"_22829":98785,"_2311":98840},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2783":57796,"_24069":57774,"_16893":98842,"_5":16788,"_22829":98785,"_2311":98843},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2783":57797,"_24069":57774,"_16893":98845,"_5":16788,"_22829":98789,"_2311":98846},[],"El servicio acepta:",{"_2783":57798,"_24069":57774,"_16893":98848,"_5":16788,"_22829":98789,"_2311":95241},[],{"_2783":57799,"_24069":57774,"_16893":98850,"_5":16788,"_22829":98789,"_2311":98851},[],"Ruta del servicio VA",{"_2783":57800,"_24069":57774,"_16893":98853,"_5":16788,"_22829":98789,"_2311":98854},[],"Formato",{"_2783":57801,"_24069":57774,"_16893":98856,"_5":16788,"_22829":98789,"_2311":45881},[],{"_2783":57802,"_24069":57774,"_16893":98858,"_5":16788,"_22829":98789,"_2311":45884},[],{"_2783":57803,"_24069":57774,"_16893":98860,"_5":16788,"_22829":98789,"_2311":98861},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2783":57804,"_24069":57774,"_16893":98863,"_5":16788,"_22829":98789,"_2311":45370},[],{"_2783":57805,"_24069":57774,"_16893":98865,"_5":16788,"_22829":98789,"_2311":45892},[],{"_2783":57806,"_24069":57774,"_16893":98867,"_5":16788,"_22829":98789,"_2311":98868},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2783":57807,"_24069":57774,"_16893":98870,"_5":16788,"_22829":98789,"_2311":98871},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2783":57808,"_24069":57774,"_16893":98873,"_5":16788,"_22829":98793,"_2311":98874},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2783":57809,"_24069":57774,"_16893":98876,"_5":16788,"_22829":98793,"_2311":98877},[],"Genera la solicitud:",{"_2783":57810,"_24069":57774,"_16893":98879,"_5":16788,"_22829":98793,"_2311":98880},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2783":57811,"_24069":57774,"_16893":98882,"_5":16788,"_22829":98793,"_2311":98883},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2783":57812,"_24069":57774,"_16893":98885,"_5":16788,"_22829":98793,"_2311":98886},[],"Verifica el DER recibido:",{"_2783":57813,"_24069":57774,"_16893":98888,"_5":16788,"_22829":98793,"_2311":98889},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2783":57814,"_24069":57774,"_16893":98891,"_5":16788,"_22829":98797,"_2311":98892},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2783":57815,"_24069":57774,"_16893":98894,"_5":16788,"_22829":98797,"_2311":98895},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2783":57816,"_24069":57774,"_16893":98897,"_5":16788,"_22829":98801,"_2311":45925},[],{"_2783":57817,"_24069":57774,"_16893":98899,"_5":16788,"_22829":98801,"_2311":45928},[],{"_2783":57818,"_24069":57774,"_16893":98901,"_5":16788,"_22829":98801,"_2311":98902},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2783":57819,"_24069":57774,"_16893":98904,"_5":16788,"_22829":98801,"_2311":98394},[],{"_2783":57820,"_24069":57820,"_5":11891,"_2311":44108,"_24384":98906,"_16893":98907,"_22829":57820},[39305,93739,44108],[],{"_2783":57821,"_24069":57820,"_16893":98909,"_5":16788,"_22829":57820,"_2311":98910},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2783":57822,"_24069":57820,"_5":24381,"_16893":98912,"_22829":98913,"_2311":96431},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_2783":57823,"_24069":57820,"_5":24381,"_16893":98915,"_22829":98916,"_2311":98917},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2783":57824,"_24069":57820,"_5":24381,"_16893":98919,"_22829":98920,"_2311":96953},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_2783":57825,"_24069":57820,"_5":24381,"_16893":98922,"_22829":98923,"_2311":96957},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2783":57826,"_24069":57820,"_5":24381,"_16893":98925,"_22829":98926,"_2311":96961},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2783":57827,"_24069":57820,"_5":24381,"_16893":98928,"_22829":98929,"_2311":96965},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_2783":57828,"_24069":57820,"_5":24381,"_16893":98931,"_22829":98932,"_2311":96973},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_2783":57829,"_24069":57820,"_5":24381,"_16893":98934,"_22829":98935,"_2311":98936},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2783":57830,"_24069":57820,"_5":24381,"_16893":98938,"_22829":98939,"_2311":97888},[],"/docs/es/platform/pki/overview#continúa",{"_2783":57831,"_24069":57820,"_16893":98941,"_5":16788,"_22829":57820,"_2311":98942},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2783":57832,"_24069":57820,"_16893":98944,"_5":16788,"_22829":98913,"_2311":98945},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2783":57833,"_24069":57820,"_16893":98947,"_5":16788,"_22829":98913,"_2311":98948},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2783":57834,"_24069":57820,"_16893":98950,"_5":16788,"_22829":98916,"_2311":98951},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2783":57835,"_24069":57820,"_16893":98953,"_5":16788,"_22829":98916,"_2311":98954},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2783":57836,"_24069":57820,"_16893":98956,"_5":16788,"_22829":98916,"_2311":98957},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2783":57837,"_24069":57820,"_16893":98959,"_5":16788,"_22829":98916,"_2311":98960},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2783":57838,"_24069":57820,"_16893":98962,"_5":16788,"_22829":98916,"_2311":98963},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2783":57839,"_24069":57820,"_16893":98965,"_5":16788,"_22829":98923,"_2311":98966},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2783":57840,"_24069":57820,"_16893":98968,"_5":16788,"_22829":98926,"_2311":98969},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2783":57841,"_24069":57820,"_16893":98971,"_5":16788,"_22829":98929,"_2311":98972},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2783":57842,"_24069":57820,"_16893":98974,"_5":16788,"_22829":98932,"_2311":98975},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2783":57843,"_24069":57820,"_16893":98977,"_5":16788,"_22829":98935,"_2311":98978},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2783":57844,"_24069":57820,"_16893":98980,"_5":16788,"_22829":98935,"_2311":98981},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2783":57845,"_24069":57820,"_16893":98983,"_5":16788,"_22829":98935,"_2311":98984},[],"su clave pública corresponda a la clave privada del cliente;",{"_2783":57846,"_24069":57820,"_16893":98986,"_5":16788,"_22829":98935,"_2311":98987},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2783":57847,"_24069":57820,"_16893":98989,"_5":16788,"_22829":98935,"_2311":98990},[],"sus fechas y usos permitan la operación;",{"_2783":57848,"_24069":57820,"_16893":98992,"_5":16788,"_22829":98935,"_2311":98993},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2783":57849,"_24069":57820,"_16893":98995,"_5":16788,"_22829":98935,"_2311":98996},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2783":57850,"_24069":57820,"_16893":98998,"_5":16788,"_22829":98939,"_2311":98999},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":57851,"_24069":57820,"_16893":99001,"_5":16788,"_22829":98939,"_2311":99002},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2783":57852,"_24069":57820,"_16893":99004,"_5":16788,"_22829":98939,"_2311":99005},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2783":57853,"_24069":57853,"_5":11891,"_2311":99007,"_24384":99008,"_16893":99009,"_22829":57853},"Crea tu primera CA",[39305,93739,44108,96555],[],{"_2783":57854,"_24069":57853,"_16893":99011,"_5":16788,"_22829":57853,"_2311":99012},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2783":57855,"_24069":57853,"_5":24381,"_16893":99014,"_22829":99015,"_2311":92440},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2783":57856,"_24069":57853,"_5":24381,"_16893":99017,"_22829":99018,"_2311":99019},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2783":57857,"_24069":57853,"_5":24381,"_16893":99021,"_22829":99022,"_2311":99023},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2783":57858,"_24069":57853,"_5":24381,"_16893":99025,"_22829":99026,"_2311":99027},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2783":57859,"_24069":57853,"_5":24381,"_16893":99029,"_22829":99030,"_2311":99031},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2783":57860,"_24069":57853,"_5":24381,"_16893":99033,"_22829":99034,"_2311":99035},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2783":57861,"_24069":57853,"_5":24381,"_16893":99037,"_22829":99038,"_2311":99039},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2783":57862,"_24069":57853,"_5":24381,"_16893":99041,"_22829":99042,"_2311":96803},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2783":57863,"_24069":57853,"_5":24381,"_16893":99044,"_22829":99045,"_2311":92464},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2783":57864,"_24069":57853,"_16893":99047,"_5":16788,"_22829":57853,"_2311":99048},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2783":57865,"_24069":57853,"_16893":99050,"_5":16788,"_22829":99015,"_2311":99051},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2783":57866,"_24069":57853,"_16893":99053,"_5":16788,"_22829":99015,"_2311":99054},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2783":57867,"_24069":57853,"_16893":99056,"_5":16788,"_22829":99015,"_2311":99057},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2783":57868,"_24069":57853,"_16893":99059,"_5":16788,"_22829":99015,"_2311":99060},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2783":57869,"_24069":57853,"_16893":99062,"_5":16788,"_22829":99018,"_2311":99063},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2783":57870,"_24069":57853,"_16893":99065,"_5":16788,"_22829":99018,"_2311":99066},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2783":57871,"_24069":57853,"_16893":99068,"_5":16788,"_22829":99022,"_2311":99069},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2783":57872,"_24069":57853,"_16893":99071,"_5":16788,"_22829":99022,"_2311":99072},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2783":57873,"_24069":57853,"_16893":99074,"_5":16788,"_22829":99026,"_2311":99075},[],"Selecciona **Root CA** y completa:",{"_2783":57874,"_24069":57853,"_16893":99077,"_5":16788,"_22829":99026,"_2311":46107},[],{"_2783":57875,"_24069":57853,"_16893":99079,"_5":16788,"_22829":99026,"_2311":99080},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2783":57876,"_24069":57853,"_16893":99082,"_5":16788,"_22829":99026,"_2311":99083},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2783":57877,"_24069":57853,"_16893":99085,"_5":16788,"_22829":99026,"_2311":99086},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2783":57878,"_24069":57853,"_16893":99088,"_5":16788,"_22829":99026,"_2311":99089},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2783":57879,"_24069":57853,"_16893":99091,"_5":16788,"_22829":99030,"_2311":99092},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2783":57880,"_24069":57853,"_16893":99094,"_5":16788,"_22829":99034,"_2311":99095},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2783":57881,"_24069":57853,"_16893":99097,"_5":16788,"_22829":99034,"_2311":99098},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2783":57882,"_24069":57853,"_16893":99100,"_5":16788,"_22829":99038,"_2311":99101},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2783":57883,"_24069":57853,"_16893":99103,"_5":16788,"_22829":99038,"_2311":99104},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2783":57884,"_24069":57853,"_16893":99106,"_5":16788,"_22829":99038,"_2311":99107},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2783":57885,"_24069":57853,"_16893":99109,"_5":16788,"_22829":99042,"_2311":99110},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2783":57886,"_24069":57853,"_16893":99112,"_5":16788,"_22829":99042,"_2311":99113},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2783":57887,"_24069":57853,"_16893":99115,"_5":16788,"_22829":99042,"_2311":99116},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2783":57888,"_24069":57853,"_16893":99118,"_5":16788,"_22829":99042,"_2311":99119},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2783":57889,"_24069":57853,"_16893":99121,"_5":16788,"_22829":99045,"_2311":99122},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2783":57890,"_24069":57890,"_5":11891,"_2311":99124,"_24384":99125,"_16893":99126,"_22829":57890},"Emite y verifica un certificado",[39305,93739,44108,96555],[],{"_2783":57891,"_24069":57890,"_16893":99128,"_5":16788,"_22829":57890,"_2311":99129},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2783":57892,"_24069":57890,"_5":24381,"_16893":99131,"_22829":99132,"_2311":92440},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2783":57893,"_24069":57890,"_5":24381,"_16893":99134,"_22829":99135,"_2311":99136},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2783":57894,"_24069":57890,"_5":24381,"_16893":99138,"_22829":99139,"_2311":99140},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2783":57895,"_24069":57890,"_5":24381,"_16893":99142,"_22829":99143,"_2311":99144},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2783":57896,"_24069":57890,"_5":24381,"_16893":99146,"_22829":99147,"_2311":99148},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2783":57897,"_24069":57890,"_5":24381,"_16893":99150,"_22829":99151,"_2311":99152},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2783":57898,"_24069":57890,"_5":24381,"_16893":99154,"_22829":99155,"_2311":99035},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2783":57899,"_24069":57890,"_5":24381,"_16893":99157,"_22829":99158,"_2311":99159},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2783":57900,"_24069":57890,"_5":24381,"_16893":99161,"_22829":99162,"_2311":99163},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2783":57901,"_24069":57890,"_5":24381,"_16893":99165,"_22829":99166,"_2311":99167},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2783":57902,"_24069":57890,"_5":24381,"_16893":99169,"_22829":99170,"_2311":96803},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2783":57903,"_24069":57890,"_5":24381,"_16893":99172,"_22829":99173,"_2311":92464},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2783":57904,"_24069":57890,"_16893":99175,"_5":16788,"_22829":57890,"_2311":99176},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2783":57905,"_24069":57890,"_16893":99178,"_5":16788,"_22829":99132,"_2311":99179},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2783":57906,"_24069":57890,"_16893":99181,"_5":16788,"_22829":99132,"_2311":99182},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2783":57907,"_24069":57890,"_16893":99184,"_5":16788,"_22829":99132,"_2311":99185},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2783":57908,"_24069":57890,"_16893":99187,"_5":16788,"_22829":99132,"_2311":99188},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2783":57909,"_24069":57890,"_16893":99190,"_5":16788,"_22829":99132,"_2311":99191},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2783":57910,"_24069":57890,"_16893":99193,"_5":16788,"_22829":99135,"_2311":99194},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2783":57911,"_24069":57890,"_16893":99196,"_5":16788,"_22829":99139,"_2311":99197},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2783":57912,"_24069":57890,"_16893":99199,"_5":16788,"_22829":99139,"_2311":99200},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2783":57913,"_24069":57890,"_16893":99202,"_5":16788,"_22829":99143,"_2311":99203},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2783":57914,"_24069":57890,"_16893":99205,"_5":16788,"_22829":99143,"_2311":99206},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2783":57915,"_24069":57890,"_16893":99208,"_5":16788,"_22829":99147,"_2311":99209},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2783":57916,"_24069":57890,"_16893":99211,"_5":16788,"_22829":99147,"_2311":99212},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2783":57917,"_24069":57890,"_16893":99214,"_5":16788,"_22829":99151,"_2311":99215},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2783":57918,"_24069":57890,"_16893":99217,"_5":16788,"_22829":99155,"_2311":99218},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2783":57919,"_24069":57890,"_16893":99220,"_5":16788,"_22829":99158,"_2311":99221},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2783":57920,"_24069":57890,"_16893":99223,"_5":16788,"_22829":99162,"_2311":99224},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2783":57921,"_24069":57890,"_16893":99226,"_5":16788,"_22829":99162,"_2311":99227},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2783":57922,"_24069":57890,"_16893":99229,"_5":16788,"_22829":99162,"_2311":99230},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2783":57923,"_24069":57890,"_16893":99232,"_5":16788,"_22829":99166,"_2311":99233},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2783":57924,"_24069":57890,"_16893":99235,"_5":16788,"_22829":99166,"_2311":99236},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2783":57925,"_24069":57890,"_16893":99238,"_5":16788,"_22829":99166,"_2311":99239},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2783":57926,"_24069":57890,"_16893":99241,"_5":16788,"_22829":99170,"_2311":96886},[],{"_2783":57927,"_24069":57890,"_16893":99243,"_5":16788,"_22829":99170,"_2311":95690},[],{"_2783":57928,"_24069":57890,"_16893":99245,"_5":16788,"_22829":99170,"_2311":99246},[],"La CA rechaza la emisión",{"_2783":57929,"_24069":57890,"_16893":99248,"_5":16788,"_22829":99170,"_2311":99249},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2783":57930,"_24069":57890,"_16893":99251,"_5":16788,"_22829":99170,"_2311":99252},[],"Sujeto o usos diferentes",{"_2783":57931,"_24069":57890,"_16893":99254,"_5":16788,"_22829":99170,"_2311":99255},[],"Perfil aplicado y valores solicitados.",{"_2783":57932,"_24069":57890,"_16893":99257,"_5":16788,"_22829":99170,"_2311":99258},[],"No se encuentra el emisor",{"_2783":57933,"_24069":57890,"_16893":99260,"_5":16788,"_22829":99170,"_2311":99261},[],"CA descargada y cadena intermedia necesaria.",{"_2783":57934,"_24069":57890,"_16893":99263,"_5":16788,"_22829":99170,"_2311":99264},[],"Falla la vigencia",{"_2783":57935,"_24069":57890,"_16893":99266,"_5":16788,"_22829":99170,"_2311":99267},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2783":57936,"_24069":57890,"_16893":99269,"_5":16788,"_22829":99170,"_2311":99270},[],"Los resúmenes de clave difieren",{"_2783":57937,"_24069":57890,"_16893":99272,"_5":16788,"_22829":99170,"_2311":99273},[],"Archivos de certificado y clave de la misma emisión.",{"_2783":57938,"_24069":57890,"_16893":99275,"_5":16788,"_22829":99170,"_2311":99276},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2783":57939,"_24069":57890,"_16893":99278,"_5":16788,"_22829":99173,"_2311":99279},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2783":57940,"_24069":57890,"_16893":99281,"_5":16788,"_22829":99173,"_2311":99282},[],"Gestionar certificados para inspección, estado y revocación.",{"_2783":57941,"_24069":57890,"_16893":99284,"_5":16788,"_22829":99173,"_2311":99285},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2783":57942,"_24069":57890,"_16893":99287,"_5":16788,"_22829":99173,"_2311":99288},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2783":57943,"_24069":57890,"_16893":99290,"_5":16788,"_22829":99173,"_2311":99291},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2783":57944,"_24069":57944,"_5":11891,"_2311":99293,"_24384":99294,"_16893":99295,"_22829":57944},"Primeros pasos de PKI",[39305,93739,44108,96555],[],{"_2783":57945,"_24069":57944,"_16893":99297,"_5":16788,"_22829":57944,"_2311":99298},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2783":57946,"_24069":57944,"_5":24381,"_16893":99300,"_22829":99301,"_2311":92440},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2783":57947,"_24069":57944,"_5":24381,"_16893":99303,"_22829":99304,"_2311":99305},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2783":57948,"_24069":57944,"_5":24381,"_16893":99307,"_22829":99308,"_2311":96737},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2783":57949,"_24069":57944,"_5":24381,"_16893":99310,"_22829":99311,"_2311":99312},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2783":57950,"_24069":57944,"_16893":99314,"_5":16788,"_22829":57944,"_2311":99315},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2783":57951,"_24069":57944,"_16893":99317,"_5":16788,"_22829":99301,"_2311":99318},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2783":57952,"_24069":57944,"_16893":99320,"_5":16788,"_22829":99301,"_2311":99321},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2783":57953,"_24069":57944,"_16893":99323,"_5":16788,"_22829":99301,"_2311":99324},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2783":57954,"_24069":57944,"_16893":99326,"_5":16788,"_22829":99301,"_2311":99327},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2783":57955,"_24069":57944,"_16893":99329,"_5":16788,"_22829":99301,"_2311":99330},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2783":57956,"_24069":57944,"_16893":99332,"_5":16788,"_22829":99304,"_2311":99333},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2783":57957,"_24069":57944,"_16893":99335,"_5":16788,"_22829":99304,"_2311":99336},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2783":57958,"_24069":57944,"_16893":99338,"_5":16788,"_22829":99304,"_2311":99339},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2783":57959,"_24069":57944,"_16893":99341,"_5":16788,"_22829":99304,"_2311":99342},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2783":57960,"_24069":57944,"_16893":99344,"_5":16788,"_22829":99308,"_2311":99345},[],"Archivo o recurso",{"_2783":57961,"_24069":57944,"_16893":99347,"_5":16788,"_22829":99308,"_2311":96734},[],{"_2783":57962,"_24069":57944,"_16893":99349,"_5":16788,"_22829":99308,"_2311":99350},[],"CA raíz activa y `ca.pem`",{"_2783":57963,"_24069":57944,"_16893":99352,"_5":16788,"_22829":99308,"_2311":99353},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2783":57964,"_24069":57944,"_16893":99355,"_5":16788,"_22829":99308,"_2311":99356},[],"Certificado final y `device.crt`",{"_2783":57965,"_24069":57944,"_16893":99358,"_5":16788,"_22829":99308,"_2311":99359},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2783":57966,"_24069":57944,"_16893":99361,"_5":16788,"_22829":99308,"_2311":99362},[],"Clave privada `device.key`",{"_2783":57967,"_24069":57944,"_16893":99364,"_5":16788,"_22829":99308,"_2311":99365},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2783":57968,"_24069":57944,"_16893":99367,"_5":16788,"_22829":99308,"_2311":99368},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2783":57969,"_24069":57944,"_16893":99370,"_5":16788,"_22829":99311,"_2311":99371},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2783":57970,"_24069":57944,"_16893":99373,"_5":16788,"_22829":99311,"_2311":99374},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2783":57971,"_24069":57944,"_16893":99376,"_5":16788,"_22829":99311,"_2311":99377},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2783":57972,"_24069":57972,"_5":11891,"_2311":99379,"_24384":99380,"_16893":99382,"_22829":57972},"Resolución de problemas PKI",[39305,93739,44108,99381],"Resolución de problemas",[],{"_2783":57973,"_24069":57972,"_16893":99384,"_5":16788,"_22829":57972,"_2311":99385},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2783":57974,"_24069":57972,"_5":24381,"_16893":99387,"_22829":99388,"_2311":99389},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2783":57975,"_24069":57972,"_5":24381,"_16893":99391,"_22829":99392,"_2311":99393},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2783":57976,"_24069":57972,"_5":24381,"_16893":99395,"_22829":99396,"_2311":99397},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2783":57977,"_24069":57972,"_16893":99399,"_5":16788,"_22829":57972,"_2311":99400},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2783":57978,"_24069":57972,"_16893":99402,"_5":16788,"_22829":57972,"_2311":99403},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2783":57979,"_24069":57972,"_16893":99405,"_5":16788,"_22829":99388,"_2311":96734},[],{"_2783":57980,"_24069":57972,"_16893":99407,"_5":16788,"_22829":99388,"_2311":95690},[],{"_2783":57981,"_24069":57972,"_16893":99409,"_5":16788,"_22829":99388,"_2311":92464},[],{"_2783":57982,"_24069":57972,"_16893":99411,"_5":16788,"_22829":99388,"_2311":46443},[],{"_2783":57983,"_24069":57972,"_16893":99413,"_5":16788,"_22829":99388,"_2311":99414},[],"Existe, está activa y sus fechas son utilizables.",{"_2783":57984,"_24069":57972,"_16893":99416,"_5":16788,"_22829":99388,"_2311":99417},[],"Autoridades.",{"_2783":57985,"_24069":57972,"_16893":99419,"_5":16788,"_22829":99388,"_2311":99420},[],"Clave",{"_2783":57986,"_24069":57972,"_16893":99422,"_5":16788,"_22829":99388,"_2311":99423},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2783":57987,"_24069":57972,"_16893":99425,"_5":16788,"_22829":99388,"_2311":99426},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2783":57988,"_24069":57972,"_16893":99428,"_5":16788,"_22829":99388,"_2311":46461},[],{"_2783":57989,"_24069":57972,"_16893":99430,"_5":16788,"_22829":99388,"_2311":99431},[],"PEM correcto y firma verificable.",{"_2783":57990,"_24069":57972,"_16893":99433,"_5":16788,"_22829":99388,"_2311":46467},[],{"_2783":57991,"_24069":57972,"_16893":99435,"_5":16788,"_22829":99388,"_2311":99436},[],"Perfil",{"_2783":57992,"_24069":57972,"_16893":99438,"_5":16788,"_22829":99388,"_2311":99439},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2783":57993,"_24069":57972,"_16893":99441,"_5":16788,"_22829":99388,"_2311":99442},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2783":57994,"_24069":57972,"_16893":99444,"_5":16788,"_22829":99388,"_2311":96886},[],{"_2783":57995,"_24069":57972,"_16893":99446,"_5":16788,"_22829":99388,"_2311":99447},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2783":57996,"_24069":57972,"_16893":99449,"_5":16788,"_22829":99388,"_2311":99450},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2783":57997,"_24069":57972,"_16893":99452,"_5":16788,"_22829":99388,"_2311":99453},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2783":57998,"_24069":57972,"_16893":99455,"_5":16788,"_22829":99388,"_2311":99456},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2783":57999,"_24069":57972,"_16893":99458,"_5":16788,"_22829":99392,"_2311":99459},[],"Revisa cada frontera por separado:",{"_2783":58000,"_24069":57972,"_16893":99461,"_5":16788,"_22829":99392,"_2311":99462},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2783":58001,"_24069":57972,"_16893":99464,"_5":16788,"_22829":99392,"_2311":99465},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2783":58002,"_24069":57972,"_16893":99467,"_5":16788,"_22829":99392,"_2311":99468},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2783":58003,"_24069":57972,"_16893":99470,"_5":16788,"_22829":99392,"_2311":99471},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2783":58004,"_24069":57972,"_16893":99473,"_5":16788,"_22829":99392,"_2311":99474},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2783":58005,"_24069":57972,"_16893":99476,"_5":16788,"_22829":99392,"_2311":99477},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2783":58006,"_24069":57972,"_16893":99479,"_5":16788,"_22829":99396,"_2311":99480},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2783":58007,"_24069":57972,"_16893":99482,"_5":16788,"_22829":99396,"_2311":99483},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_46521":99485,"_46523":99486,"_46525":99487,"_46527":99488,"_14693":2333,"_55710":2333},"spanish",[2311,24069,5,22829],{"_2311":20125,"_24069":20125,"_5":20125,"_22829":20125},{"_2311":99489,"_24069":101783,"_5":104077,"_22829":106371},{"_3710":99490,"_46531":99491,"_5":20125},{"_11654":3674,"_11974":4834,"_11981":4568,"_23326":9158,"_22912":4476,"_16026":6035,"_11675":11703,"_11682":18390,"_23288":4525,"_23627":18389,"_23637":14778,"_23301":4531,"_27793":5720,"_23648":2453,"_27798":4942,"_27801":24082,"_27804":9094,"_27807":3521,"_27810":3766,"_23949":3713,"_27815":9174,"_27817":2574,"_23985":9182,"_23939":16440,"_27821":12651,"_27824":5122,"_27826":5313,"_23666":2474,"_23944":6113,"_24003":4028,"_27831":4766,"_27833":2751,"_27835":4763,"_27837":5979,"_27839":2631,"_27841":4719,"_27843":20130,"_27845":5568,"_27847":4977,"_23339":5606,"_27850":2609,"_27852":2669,"_23333":3820,"_27855":5488,"_27857":10709,"_27859":3967,"_27862"